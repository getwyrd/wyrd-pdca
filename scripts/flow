#!/usr/bin/env bash
# Run `pdca flow` so the host can't SUSPEND mid-run.
#
# A cycle — a batch, or a high-difficulty bundle on a strong Do model — can run for hours,
# often unattended. A screen *lock* does not pause processes, but an idle SUSPEND does: it
# freezes every process and interrupts the flow (and a terminal/SSH disconnect kills a
# foreground job). This wrapper holds a suspend inhibitor for the flow's whole lifetime and
# releases it automatically at exit, so an idle machine can't pause a long run.
#
#   scripts/flow <id> [<id> …] [flow flags…]      # e.g. scripts/flow 365 364 --lanes 2
#   scripts/flow --rehearse <id>                  # dry-run (stub leaves/gates, no keep-awake needed)
#
# For disconnect resilience, run it detached under a multiplexer:
#   screen -S pdca -dm scripts/flow <ids…>        # reattach: screen -r pdca
#
# The keep-awake *target* belongs in the shared Makefile — proposed upstream at
# eduralph/pdca-harness#244; this instance-owned wrapper is the stopgap until that lands.
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# Resolve the pdca CLI: the installed `pdca`, this project's venv, else the source module.
if command -v pdca >/dev/null 2>&1; then
  run=(pdca)
elif [ -x "$here/.venv/bin/pdca" ]; then
  run=("$here/.venv/bin/pdca")
else
  run=(env "PYTHONPATH=$here/src" python3 -m pdca_harness.cli)
fi

# Inhibit idle/sleep only (never shutdown/handle-*), so a deliberate power-off still works.
if command -v systemd-inhibit >/dev/null 2>&1; then
  exec systemd-inhibit --what=idle:sleep --why="pdca flow" "${run[@]}" flow "$@"
elif command -v caffeinate >/dev/null 2>&1; then   # macOS
  exec caffeinate -s "${run[@]}" flow "$@"
else
  echo "scripts/flow: no systemd-inhibit/caffeinate — running WITHOUT keep-awake; disable" \
       "auto-suspend manually (see eduralph/pdca-harness#244)." >&2
  exec "${run[@]}" flow "$@"
fi
