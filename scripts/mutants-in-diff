#!/usr/bin/env bash
# C5-mutants (advisory, bundle-scoped): surviving mutants on the bundle's diff.
#
# The mechanical counterpart to the review rubric's vacuous-assertion class
# (8 findings: tests that pass without binding the property — getwyrd/wyrd#622
# tracks the GitHub-side gating promotion). Runs `cargo mutants --in-diff` over
# $PDCA_BUNDLE/patch.diff in the same checkout the gates use, so a test the
# builder ships that would not notice its own production change being broken
# surfaces BEFORE publish, as an advisory row the human weighs at sign-off.
#
# Advisory by policy (pdca.toml GATING POLICY): mutation misses are frequently
# pre-existing suite debt adjacent to the diff, not this fix's defect. The
# GitHub-side `mutants-pr` becomes the gating enforcement once its baseline is
# clean (getwyrd/wyrd#622).
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# Same target-resolution chain as engine/xtask.sh.
wyrd_repo="${PDCA_WORKTREE:-"${WYRD_REPO:-"$(cd "$here/../wyrd" 2>/dev/null && pwd || true)"}"}"

if [[ -z "${PDCA_BUNDLE:-}" || ! -f "$PDCA_BUNDLE/patch.diff" ]]; then
  echo "mutants-in-diff: \$PDCA_BUNDLE/patch.diff not found (bundle-scoped row)" >&2
  exit 1
fi
if [[ -z "$wyrd_repo" || ! -f "$wyrd_repo/Cargo.toml" ]]; then
  echo "mutants-in-diff: Wyrd checkout not found (\$PDCA_WORKTREE / \$WYRD_REPO / ../wyrd)" >&2
  exit 1
fi
if ! command -v cargo-mutants >/dev/null 2>&1; then
  echo "mutants-in-diff: cargo-mutants not installed — see [[doctor.checks]] 'cargo-mutants'" >&2
  echo "                 (cargo install cargo-mutants --locked)" >&2
  exit 1
fi

# --cap-lints=true (Act 2026-09-30): Wyrd builds with `warnings = "deny"`, so a mutant
# that stubs a body and leaves a parameter unused fails to compile and is scored
# "unviable" instead of tested. issue_842: 8 caught / 0 missed / 28 unviable without the
# cap, 25 caught / 2 missed / 9 unviable with it — the two hidden survivors were real
# test gaps. issue_775: 16 unviable for the same reason.
cd "$wyrd_repo"
exec cargo mutants --in-diff "$PDCA_BUNDLE/patch.diff" --no-shuffle --cap-lints=true
