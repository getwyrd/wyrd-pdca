#!/usr/bin/env bash
# Resolve THIS project's pdca CLI whatever way the harness was installed, then exec it.
#
# A gate row in pdca.toml is a shell command run from the project root, so a row that
# invokes the harness has to name something that exists in EVERY documented install
# layout — not just the one the author happened to be running. `.venv/bin/wyrd-pdca`
# is not that: a source run (`PYTHONPATH=src python -m pdca_harness.cli`) or a pipx /
# system install has no such file, and the row would exit 127 — a red gate on a
# working harness, on every Check with a patch and then again at publish (PR #184
# review). The console script cannot simply be assumed on PATH either: running
# `.venv/bin/wyrd-pdca` does not put its own directory there.
#
# So resolve, in order of "most certainly THIS project's harness" first:
#
#   1. $PDCA_CLI          — explicit override, wins outright. A command LINE, not just a
#                           path: `PDCA_CLI="python -m pdca_harness.cli"` is a valid value.
#   2. the project venv   — POSIX layout, then the `scripts/install.ps1` Windows one.
#   3. the source tree    — `$here/src`, run as the documented `PYTHONPATH=src python -m
#                           pdca_harness.cli`. AHEAD of PATH deliberately: `$here/src` is
#                           certainly this checkout's code, while a console script on PATH
#                           is a machine-global that may belong to a different one. That
#                           is not hypothetical — a `git worktree` of this repo has no
#                           .venv of its own, and `~/.local/bin/wyrd-pdca` there resolves
#                           to the MAIN checkout's venv, so the gate would silently lint
#                           this bundle with the other tree's harness. The package is
#                           dependency-free (pyproject.toml), so the source run needs
#                           nothing installed.
#   4. wyrd-pdca on PATH  — pipx / system install, for a layout with no venv and no src.
#                           The name is deliberately not `pdca` (pyproject.toml): a bare
#                           `pdca` on this machine is a SIBLING project's install, and
#                           running the wrong harness is worse than not finding one.
#
# `scripts/flow` carries a smaller version of this chain inline; this is the shared one a
# gate row can name (instance-owned, the scripts/flow precedent). $PDCA_PYTHON names the
# interpreter for step 4 on a host whose `python3` predates the required 3.11.
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

if [ -n "${PDCA_CLI:-}" ]; then
  read -r -a run <<<"$PDCA_CLI"
elif [ -x "$here/.venv/bin/wyrd-pdca" ]; then
  run=("$here/.venv/bin/wyrd-pdca")
elif [ -x "$here/.venv/Scripts/wyrd-pdca.exe" ]; then
  run=("$here/.venv/Scripts/wyrd-pdca.exe")
elif [ -f "$here/src/pdca_harness/cli.py" ]; then
  run=(env "PYTHONPATH=$here/src" "${PDCA_PYTHON:-python3}" -m pdca_harness.cli)
elif command -v wyrd-pdca >/dev/null 2>&1; then
  run=(wyrd-pdca)
else
  echo "scripts/pdca: no wyrd-pdca CLI found — no $here/.venv install, no" \
       "$here/src/pdca_harness, none on PATH. Install it (\`make install\` /" \
       "\`pip install -e .\`) or point \$PDCA_CLI at the CLI." >&2
  exit 127
fi

exec "${run[@]}" "$@"
