#!/usr/bin/env python3
"""Triage external (GitHub Codex) PR review findings into the Act loop.

Every finding on a published PR is classified — BUG / CONVENTION / NOISE /
TEST-GAP — keyed to the target rubric's recurring defect classes (wyrd
AGENTS.md § "Review rubric & protocol"), then routed:

  * BUG on a merged PR      -> a ready-to-file tracker issue (auto-filed only
                               with --file-issues; printed otherwise)
  * CONVENTION              -> candidate gate/rubric delta in the triage inbox
                               (process/triage/PR-<n>.md) for the Act beat
  * NOISE                   -> candidate rubric-exclusion line, same inbox
  * every classified finding -> a `codex-pr:<class>` entry in
                               process/act-ledger.json (the same schema the
                               engine's act.py writes), so a class that
                               reappears AFTER its process delta was applied
                               is reported as a RECURRENCE — the signal that
                               the class needs a mechanical gate, not a rubric
                               line.

--seed-rubric arms recurrence detection: rubric-addressed classes seed
`applied` on the rubric date (a later occurrence = the delta did not hold),
while classes discovered after it seed `open` (occurrences accumulate as
evidence a delta is owed). --stats prints churn metrics (findings/round,
rounds/PR, noise counts) — the instrument the 2026-07-21 act-log entry names.

Engine-native home proposed upstream at eduralph/pdca-harness#316; this
instance-owned script is the stopgap (scripts/flow precedent). It deliberately
avoids engine imports — the ledger is read/written in its documented JSON
schema so an engine bump cannot strand it.
"""

import argparse
import json
import re
import subprocess
import sys
from datetime import date
from pathlib import Path

HERE = Path(__file__).resolve().parent.parent
LEDGER = HERE / "process" / "act-ledger.json"
INBOX = HERE / "process" / "triage"
REPO = "getwyrd/wyrd"
BOT = "chatgpt-codex-connector[bot]"
RUBRIC_DATE = "2026-07-21"
TODAY = date.today().isoformat()
# Classes with NO APPLIED DELTA yet — seeded `open`, so occurrences accumulate
# as evidence a delta is owed rather than masquerading as a delta that failed.
# A class belongs here when the rubric text alone does not address it: either
# it was discovered after the rubric, or its real fix is a mechanical gate
# still in flight. Move a key out (and `resolve` it in the ledger) when that
# gate MERGES — only then does a later occurrence mean "the delta did not hold".
NO_APPLIED_DELTA = {
    "enforcement-reach",   # discovered 2026-07-22; no rubric line yet
    "false-red",           # discovered 2026-07-22; no rubric line yet
}
RUBRIC_LOC = "wyrd AGENTS.md § Review rubric & protocol (getwyrd/wyrd#617)"

# Rubric classes -> (category, matchers). First match wins; order = specificity.
CLASSES = [
    ("dco-false-positive", "NOISE", r"signed-off-by|dco\b|sign-?off"),
    ("worktree-gitlink", "CONVENTION", r"gitlink|\.claude/worktrees|gitmodules"),
    ("docs-currency", "CONVENTION",
     r"architecture doc|living architecture|blueprint|runbook|not documented|docs? (?:still|say|omit)"),
    ("workflow-blindspot", "CONVENTION",
     r"path filter|paths-ignore|paths:|diff-filter|\bmatrix\b|trigger(?:s|ed)? on"),
    # Enforcement reach: a gate/lint/scan whose ACTUAL coverage is narrower
    # than its claimed scope, so a violation passes it silently. Named after
    # the #618/#621 series (unlinted target sets, index-vs-worktree snapshot
    # mismatch, vacuously-clean scans). Ordered before dst-coverage: a finding
    # about a lint not reaching the DST crate is this class, not a missing
    # DST test.
    ("false-red", "BUG",
     r"incorrectly rejects?|falsely rejects?|would (?:therefore )?be (?:blocked|rejected)"
     r"|rejects? (?:valid|compliant|policy-compliant)|blocked by the (?:new )?(?:ci )?guard"
     r"|treats? the shebang|valid attribute containing"),
    ("enforcement-reach", "CONVENTION",
     r"(?:never (?:evaluated|run|inspected|checked)|not (?:evaluated|enforced|covered|inspected))"
     r"|excludes? (?:that|the) (?:package|crate)|passes the (?:required )?gate"
     r"|(?:can |could )?report success|reports? success without|vacuous"
     r"|silently (?:passes|green|omits?|skips?|drops?)"
     r"|outside the default|remains green (?:despite|even)"
     # Exemption breadth is the same class seen from the other side: an allow
     # wider than its justification leaves future violations unreviewed.
     r"|disabl\w* the (?:new )?guard|every (?:present and )?future"
     r"|module-wide|blanket|exempts? every|still pass\w* `?cargo"),
    ("dst-coverage", "TEST-GAP",
     r"seeded (?:dst|sim|test|tier)|tier-?0|deterministic sim(?:ulation)?"
     r"|dst (?:regression|coverage|test)|no dst\b|add a (?:seeded )?dst"),
    ("vacuous-assertion", "TEST-GAP",
     r"assert(?:ion)? (?:can|could|still|passes)|vacuous|hollow|without proving|count-based"),
    ("torn-input", "BUG", r"truncat|torn|content-length|chunked|terminal crlf|incomplete (?:body|response)"),
    ("grammar-strictness", "BUG", r"rfc[- ]?\d|weekday|imf-fixdate|asctime|two-digit year|range unit|entity-tag"),
    ("serialization-identity", "BUG",
     r"etag|last-modified|epoch|1970|\bcas\b|byte-for-byte|re-encod|null field|omit(?:ted)? field"),
    # `cap`/`limit`/`budget` only count near a SIZING word — the bare words are
    # far too common in prose ("limit exemptions to…" is not this class).
    ("encoded-caps", "BUG",
     r"escap|encoded (?:size|length)|amplif"
     r"|(?:byte|size|length|payload|body|key|trailer|header|mib|kib)[^.]{0,30}"
     r"\b(?:cap|limit|budget)\b"
     r"|\b(?:cap|limit|budget)\b[^.]{0,30}(?:byte|size|length|payload|body|xml|encoded)"),
    ("clock-lifecycle", "BUG", r"clock|lease.{0,24}expir|systemtime|logical-zero|stamp"),
    ("txn-rollback", "BUG", r"rollback|transaction|txn|commitunknown|commit_unknown|unknown.?result"),
    ("await-bounded", "BUG", r"timeout|hangs?\b|forever|never (?:returns|resolves|aborted)|join!|abort-on-drop|task leak"),
    ("probe-readiness", "BUG", r"health|readiness|liveness|probe|serving|not_serving|drain"),
    ("silent-skip", "BUG",
     r"silently|silent (?:success|failure|skip)|\bignored\b|false success"
     r"|no repair|swallow|skips? (?:it|them|the (?:entry|record|error|failure))"),
]


def classify(text: str) -> tuple[str, str]:
    low = text.lower()
    for key, cat, pat in CLASSES:
        if re.search(pat, low):
            return key, cat
    return "unclassified", "BUG"


def gh_json(path: str) -> list:
    out = subprocess.run(["gh", "api", path, "--paginate"],
                         capture_output=True, text=True, check=True)
    data = json.loads(out.stdout) if out.stdout.strip() else []
    return data if isinstance(data, list) else [data]


def load_ledger() -> list[dict]:
    if not LEDGER.exists():
        return []
    try:
        data = json.loads(LEDGER.read_text(encoding="utf-8"))
        return data if isinstance(data, list) else []
    except (ValueError, OSError):
        return []


def save_ledger(entries: list[dict]) -> None:
    LEDGER.parent.mkdir(parents=True, exist_ok=True)
    LEDGER.write_text(json.dumps(entries, indent=2) + "\n", encoding="utf-8")


def title_of(body: str) -> str:
    """Codex comment bodies open with a severity badge then a bold title."""
    m = re.search(r"\*\*(?:<sub>.*?</sub>\s*)?(?P<t>[^*].*?)\*\*", body, re.DOTALL)
    title = m.group("t").strip() if m else body.strip()
    title = re.sub(r"!\[.*?\]\(.*?\)", "", title)
    title = re.sub(r"</?sub>", "", title).strip()
    return re.sub(r"\s+", " ", title)[:160]


def seed_rubric() -> None:
    """Seed the known classes. Only those the rubric ACTUALLY addresses are
    `applied` (so a later occurrence is a genuine recurrence — the delta did
    not hold); classes discovered after it, with no process delta yet, seed
    `open` so they accumulate as evidence that a delta is owed rather than
    masquerading as a failed one."""
    ledger = load_ledger()
    known = {e.get("signal") for e in ledger}
    added = 0
    for key, cat, _ in CLASSES:
        sig = f"codex-pr:{key}"
        if sig in known:
            continue
        covered = key not in NO_APPLIED_DELTA
        ledger.append({
            "signal": sig,
            "raw": f"[{cat}] external-review class '{key}'"
                   + (" (2026-07 churn analysis, 158 findings)" if covered
                      else " (no applied process delta yet)"),
            "first_seen": RUBRIC_DATE if covered else TODAY,
            "status": "applied" if covered else "open",
            "applied_date": RUBRIC_DATE if covered else None,
            "location": RUBRIC_LOC if covered else "",
        })
        added += 1
    save_ledger(ledger)
    print(f"triage: seeded {added} class ledger entries (idempotent)")


def triage_pr(pr: int, file_issues: bool, today: str) -> None:
    comments = [c for c in gh_json(f"repos/{REPO}/pulls/{pr}/comments")
                if c["user"]["login"] == BOT and not c.get("in_reply_to_id")]
    merged = bool(subprocess.run(
        ["gh", "pr", "view", str(pr), "--repo", REPO, "--json", "mergedAt",
         "--jq", ".mergedAt // empty"],
        capture_output=True, text=True).stdout.strip())

    ledger = load_ledger()
    by_signal = {e.get("signal"): e for e in ledger}
    lines = [f"# Triage — PR #{pr} ({'merged' if merged else 'open'}) — {today}", ""]
    recurrences, issues = [], []

    for c in comments:
        title = title_of(c.get("body", ""))
        key, cat = classify(title + " " + c.get("body", "")[:400])
        sig = f"codex-pr:{key}"
        entry = by_signal.get(sig)
        posted = (c.get("created_at") or today)[:10]
        note = ""
        if entry is None:
            ledger.append({"signal": sig, "raw": f"[{cat}] {title} (PR #{pr})",
                           "first_seen": posted, "status": "open",
                           "applied_date": None, "location": ""})
            by_signal[sig] = ledger[-1]
            note = "NEW class -> ledger(open)"
        elif entry.get("status") == "applied" and (entry.get("applied_date") or "") < posted:
            # A finding POSTED after the class's delta was applied = the delta
            # did not stop the class. Findings that predate the delta are the
            # backlog the delta was born from, not evidence against it.
            recurrences.append((key, title))
            note = f"RECURRENCE after {entry['applied_date']} delta ({entry.get('location', '?')})"
        lines.append(f"- [{cat}] `{key}` {c['path']}: {title}" + (f" — **{note}**" if note else ""))
        if cat == "BUG" and merged:
            issues.append((title, c))
        elif cat == "CONVENTION":
            lines.append(f"  - Act candidate: encode as a gate row or rubric line (class `{key}`).")
        elif cat == "NOISE":
            lines.append("  - Act candidate: rubric-exclusion line / reviewer-instruction tweak.")

    if recurrences:
        lines += ["", "## Recurrences (delta ineffective — candidates for a MECHANICAL gate)", ""]
        lines += [f"- `{k}`: {t}" for k, t in recurrences]
    for title, c in issues:
        cmd = ["gh", "issue", "create", "--repo", REPO,
               "--title", f"review finding on merged PR #{pr}: {title}",
               "--body", f"Surfaced by the PR #{pr} review after merge:\n\n> {title}\n\n"
                         f"Original comment: {c.get('html_url', '')}\n\n"
                         f"Filed by the triage step (process/triage/PR-{pr}.md)."]
        if file_issues:
            res = subprocess.run(cmd, capture_output=True, text=True)
            lines.append(f"\nFiled: {res.stdout.strip() or res.stderr.strip()}")
        else:
            lines.append("\nBUG on merged PR — file with:\n  " +
                         " ".join(f"'{a}'" if " " in a else a for a in cmd))

    save_ledger(ledger)
    INBOX.mkdir(parents=True, exist_ok=True)
    report = INBOX / f"PR-{pr}.md"
    report.write_text("\n".join(lines) + "\n", encoding="utf-8")
    print(f"triage: PR #{pr}: {len(comments)} findings, "
          f"{len(recurrences)} recurrence(s), {len(issues)} merged-PR BUG(s) -> {report}")


def stats(prs: list[int]) -> None:
    print("PR | rounds | findings | findings/round | noise")
    for pr in prs:
        comments = [c for c in gh_json(f"repos/{REPO}/pulls/{pr}/comments")
                    if c["user"]["login"] == BOT and not c.get("in_reply_to_id")]
        reviews = [r for r in gh_json(f"repos/{REPO}/pulls/{pr}/reviews")
                   if r["user"]["login"] == BOT]
        noise = sum(1 for c in comments
                    if classify(c.get("body", ""))[0] == "dco-false-positive")
        rounds = max(len(reviews), 1)
        print(f"{pr} | {rounds} | {len(comments)} | {len(comments) / rounds:.2f} | {noise}")


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("--pr", type=int, action="append", default=[],
                    help="PR number to triage (repeatable)")
    ap.add_argument("--seed-rubric", action="store_true",
                    help="seed the 13 rubric classes as applied-on-rubric-date")
    ap.add_argument("--file-issues", action="store_true",
                    help="actually file tracker issues for merged-PR BUG findings")
    ap.add_argument("--stats", action="store_true",
                    help="print churn metrics for the given --pr list")
    args = ap.parse_args()

    if args.seed_rubric:
        seed_rubric()
    if args.stats:
        stats(args.pr)
        return 0
    today = date.today().isoformat()
    for pr in args.pr:
        triage_pr(pr, args.file_issues, today)
    if not (args.pr or args.seed_rubric):
        print("nothing to do — pass --pr N, --stats, or --seed-rubric", file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main())
