#!/usr/bin/env python3
"""Batched multi-pass rubric review — the pre-PR review that matches the PR review.

Why: analysis of 158 external (GitHub Codex) review findings across ~79 wyrd PRs
showed the reviewer surfaces roughly ONE new, real, pre-existing finding per
re-review round (extreme: 13 rounds / 15 findings on one PR). Serial "retrigger
until clean" therefore converges slowly by design. This script batches that
depth up front: N parallel `codex exec` review passes over the SAME artifact the
PR review will see (the full diff against the base), each armed with the target
repo's standing rubric (AGENTS.md § Review rubric & protocol), unioned and
deduplicated, with rubric-rejected noise classes dropped automatically.

Definition of done (matches the rubric's Reviewer protocol): deterministic gates
green + ONE batched pass whose findings are each fixed or recorded-rejected.
Exit 1 while BUG-class findings remain, so the publish gate blocks the push.

Wired two ways:
  * bundle gate row (pdca.toml [[gates.checks]] tier="T4" scope="bundle"
    cmd="scripts/review-branch --bundle"): reviews $PDCA_BUNDLE/patch.diff
    before `pdca publish` runs its git steps (publish runs every T4 row first).
  * manual pre-commit review for hand-made changes:
        scripts/review-branch --repo ../wyrd --range origin/main...HEAD
    (also `--staged` for the index). This replaces ad-hoc `codex review`
    invocations, so the local review and the PR review share one prompt.

Engine-native home proposed upstream at eduralph/pdca-harness#315 (pre-publish
review stage with the bounded fix loop); the rubric-key half is #314. This
instance-owned wrapper is the stopgap until those land (scripts/flow precedent).
"""

import argparse
import concurrent.futures
import os
import re
import subprocess
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent.parent

# Findings whose class or text matches a rubric-rejected class are dropped from
# the union (AGENTS.md § Reviewer protocol): DCO/sign-off findings from commit
# inspection (every observed instance was a false positive on synthesized
# merge-preview SHAs) and re-raises of tracked-issue deferrals.
NOISE_PATTERNS = [
    re.compile(r"signed-off-by|dco\b|sign-?off", re.IGNORECASE),
    re.compile(r"deferred\s*[—-]\s*tracked in #\d+", re.IGNORECASE),
]

FINDING_RE = re.compile(
    r"^\s*(?:[-*]\s*)?(?P<loc>\S+?:\d+(?:-\d+)?|\S+\.\w+)\s*\|\s*"
    r"(?P<cls>BUG|CONVENTION|NOISE|TEST-GAP)\s*\|\s*(?P<why>.+)$"
)

PROMPT_TEMPLATE = """\
You are one of {n} independent review passes over the same diff; be thorough —
assume the other passes will miss what you skip. Review the unified diff below
as if it were a GitHub pull-request review against the target repository.

Apply the target repository's standing rubric, reproduced here (AGENTS.md
section "Review rubric & protocol"); its hard conventions and recurring defect
classes are checklist items wherever the diff touches their surface, and its
Reviewer protocol binds you — do NOT emit findings in classes it rejects.

--- BEGIN RUBRIC ---
{rubric}
--- END RUBRIC ---

Report ONLY genuine findings in the changed code (no praise, no summary of the
diff, no pre-existing debt the diff does not touch). Output format — one line
per finding, nothing else:

<file>:<line> | <BUG|CONVENTION|NOISE|TEST-GAP> | <one-sentence rationale>

BUG = would misbehave at runtime; CONVENTION = violates a stated repo
convention; TEST-GAP = evidence/tests inadequate; NOISE = only if you must
retract something. If you find nothing, output exactly: NO FINDINGS

--- BEGIN DIFF ---
{diff}
--- END DIFF ---
"""


def resolve_target(explicit: str | None) -> Path:
    """Match engine/xtask.sh: $PDCA_WORKTREE -> $WYRD_REPO -> sibling ../wyrd."""
    for candidate in (
        explicit,
        os.environ.get("PDCA_WORKTREE"),
        os.environ.get("WYRD_REPO"),
        str(HERE.parent / "wyrd"),
    ):
        if candidate and (Path(candidate) / "AGENTS.md").is_file():
            return Path(candidate).resolve()
    sys.exit("review-branch: no target repo with an AGENTS.md found "
             "(tried --repo, $PDCA_WORKTREE, $WYRD_REPO, ../wyrd)")


def load_rubric(target: Path) -> str:
    text = (target / "AGENTS.md").read_text(encoding="utf-8")
    marker = "## Review rubric & protocol"
    if marker not in text:
        # Degrade by shrinking, not by silence: without the rubric the passes
        # still run, they just review on general judgment.
        print(f"review-branch: warning: no '{marker}' section in "
              f"{target / 'AGENTS.md'}; passes run without a rubric", file=sys.stderr)
        return "(target repo declares no standing rubric)"
    return text[text.index(marker):]


def collect_diff(args: argparse.Namespace, target: Path) -> str:
    if args.bundle:
        bundle = os.environ.get("PDCA_BUNDLE")
        if not bundle:
            sys.exit("review-branch: --bundle requires $PDCA_BUNDLE (set by the gate runner)")
        patch = Path(bundle) / "patch.diff"
        if not patch.is_file():
            sys.exit(f"review-branch: {patch} not found")
        return patch.read_text(encoding="utf-8")
    cmd = ["git", "-C", str(target), "diff"]
    cmd += ["--staged"] if args.staged else [args.range]
    out = subprocess.run(cmd, capture_output=True, text=True, check=True)
    return out.stdout


def run_pass(idx: int, prompt: str, timeout: int) -> tuple[int, str]:
    """One codex review pass. Prompt goes over stdin (`codex exec -`) so a
    large diff never hits the argv size limit (pdca-harness#313)."""
    proc = subprocess.run(
        ["codex", "exec", "--sandbox", "read-only", "--skip-git-repo-check", "-"],
        input=prompt, capture_output=True, text=True, timeout=timeout,
    )
    if proc.returncode != 0:
        print(f"review-branch: pass {idx} failed (exit {proc.returncode}):\n"
              f"{proc.stderr.strip()[-2000:]}", file=sys.stderr)
        return idx, ""
    return idx, proc.stdout


def parse_findings(output: str) -> list[dict]:
    findings = []
    for line in output.splitlines():
        m = FINDING_RE.match(line)
        if m:
            findings.append({
                "loc": m.group("loc"), "cls": m.group("cls"),
                "why": m.group("why").strip(),
            })
    return findings


def is_noise(f: dict) -> bool:
    if f["cls"] == "NOISE":
        return True
    return any(p.search(f["why"]) for p in NOISE_PATTERNS)


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    mode = ap.add_mutually_exclusive_group(required=True)
    mode.add_argument("--bundle", action="store_true",
                      help="review $PDCA_BUNDLE/patch.diff (gate-row mode)")
    mode.add_argument("--range", metavar="RANGE",
                      help="review `git diff RANGE` in the target repo "
                           "(e.g. origin/main...HEAD)")
    mode.add_argument("--staged", action="store_true",
                      help="review the target repo's staged diff")
    ap.add_argument("--repo", help="target repo path (default: engine resolution chain)")
    ap.add_argument("--passes", type=int, default=3, metavar="N",
                    help="parallel review passes (default 3)")
    ap.add_argument("--timeout", type=int, default=1800,
                    help="per-pass timeout in seconds (default 1800)")
    ap.add_argument("--out", help="findings report path "
                    "(default: $PDCA_BUNDLE/review-batch.md or ./review-batch.md)")
    args = ap.parse_args()

    target = resolve_target(args.repo)
    rubric = load_rubric(target)
    diff = collect_diff(args, target)
    if not diff.strip():
        print("review-branch: empty diff — nothing to review")
        return 0

    prompt = PROMPT_TEMPLATE.format(n=args.passes, rubric=rubric, diff=diff)
    with concurrent.futures.ThreadPoolExecutor(max_workers=args.passes) as pool:
        results = list(pool.map(
            lambda i: run_pass(i, prompt, args.timeout), range(1, args.passes + 1)))

    completed = [out for _, out in results if out]
    if not completed:
        sys.exit("review-branch: every pass failed — cannot certify the diff")
    if len(completed) < args.passes:
        print(f"review-branch: warning: only {len(completed)}/{args.passes} "
              f"passes completed; the union is thinner than requested", file=sys.stderr)

    # Union + dedup: same location and class = one finding (first rationale wins,
    # extra passes' duplicates counted as corroboration).
    merged: dict[tuple, dict] = {}
    for _, out in results:
        for f in parse_findings(out):
            key = (f["loc"], f["cls"])
            if key in merged:
                merged[key]["votes"] += 1
            else:
                merged[key] = {**f, "votes": 1}

    kept = [f for f in merged.values() if not is_noise(f)]
    dropped = [f for f in merged.values() if is_noise(f)]
    kept.sort(key=lambda f: ({"BUG": 0, "TEST-GAP": 1, "CONVENTION": 2}.get(f["cls"], 3),
                             -f["votes"]))

    out_path = Path(args.out) if args.out else (
        Path(os.environ["PDCA_BUNDLE"]) / "review-batch.md"
        if args.bundle and os.environ.get("PDCA_BUNDLE") else Path("review-batch.md"))
    lines = [f"# Batched review — {len(completed)} passes, union of findings", ""]
    if not kept:
        lines.append("No findings survived the union and noise filter.")
    for f in kept:
        lines.append(f"- [ ] `{f['loc']}` **{f['cls']}** (seen by {f['votes']} pass"
                     f"{'es' if f['votes'] > 1 else ''}): {f['why']}")
    if dropped:
        lines += ["", "## Auto-dropped (rubric-rejected noise classes)", ""]
        lines += [f"- `{f['loc']}` {f['cls']}: {f['why']}" for f in dropped]
    lines += ["", "Triage rule: every unchecked finding must be fixed or rejected "
              "with a recorded reason before publish — not re-reviewed to silence."]
    out_path.write_text("\n".join(lines) + "\n", encoding="utf-8")
    print(f"review-branch: {len(kept)} finding(s) "
          f"({sum(1 for f in kept if f['cls'] == 'BUG')} BUG), "
          f"{len(dropped)} noise-dropped -> {out_path}")

    return 1 if any(f["cls"] == "BUG" for f in kept) else 0


if __name__ == "__main__":
    sys.exit(main())
