#!/usr/bin/env python3
"""Plan intake cap (rule wyrd-pdca-P1, getwyrd/wyrd-pdca#238).

Counts the bundles that are past Plan and not yet signed off — PLANNED, BUILT, CHECKED,
AWAITING_SIGNOFF, ITERATE_DO, ITERATE_PLAN — and reports the room left under the cap:
`room = cap - count`. The cap is a budget, not a gate: every new brief and every child a
split files spends one, so the planner runs this before a batch with `--need <briefs>`
and again after each brief, and the splitter runs it before drafting with
`--need <children>`. When the room is short, Plan-side intake is closed: no new brief,
no `pdca split --accept`, no split or reslicing proposal, until Do and sign-off drain the
backlog. The human reads the same line in the terminal.

Why a script and not a driver knob: the harness has no such knob yet
(eduralph/pdca-harness#544). Until it does, this is the one place the number lives, so the
prompts and the human count the same thing.

The cap is PER TRACK since 2026-10-01 (Act entry of that date). A track is a stream of
work that touches its own code — a milestone run in parallel with the others (`alpha`,
`blackbox`, `m5`, `m6`). A bundle's track is the `- **Track:**` field of its brief; a brief
without one counts toward the default track (`$PDCA_DEFAULT_TRACK`, else `alpha`, which is
what every brief written before the field existed belongs to). `--track NAME` selects the
track whose room is checked; the other tracks' counts are printed for context and never
spend this track's room, so one track's backlog does not freeze the others.

Exit status: 0 when `--need` (default 1) fits in the room, 1 when it does not, 2 when the
driver's status could not be read. The cap is `--cap N`, else `$PDCA_PLANNED_CAP`, else 6,
and applies to each track. `--status-file PATH` reads a saved `pdca status` output instead
of running the driver (tests, and reading another checkout); `--bundle-root PATH` is where
the briefs are read (default `$PDCA_BUNDLE_ROOT`, else `results/` beside this script).
"""
from __future__ import annotations

import argparse
import os
import re
import subprocess
import sys
from collections import OrderedDict
from pathlib import Path

DEFAULT_CAP = 6
DEFAULT_TRACK = "alpha"
# `- **Track:** m5` — the first such line in the brief; bold colon inside or outside.
_TRACK_RE = re.compile(r"^- \*\*Track:?\*\*:?\s*`?([A-Za-z0-9._-]+)`?", re.MULTILINE)
COUNTED = ("PLANNED", "BUILT", "CHECKED", "AWAITING_SIGNOFF", "ITERATE_DO", "ITERATE_PLAN")
HERE = Path(__file__).resolve().parent
EXIT_FITS, EXIT_SHORT, EXIT_UNREADABLE = 0, 1, 2


def read_status(status_file: str | None) -> str:
    """The driver's `pdca status` text, or exit 2 with a diagnostic when it cannot be read."""
    if status_file:
        try:
            return Path(status_file).read_text(encoding="utf-8")
        except OSError as exc:
            sys.stderr.write(f"plan-cap: cannot read status file {status_file}: {exc}\n")
            raise SystemExit(EXIT_UNREADABLE)
    try:
        proc = subprocess.run([str(HERE / "pdca"), "status"], capture_output=True, text=True)
    except OSError as exc:
        sys.stderr.write(f"plan-cap: cannot run {HERE / 'pdca'} status: {exc}\n")
        raise SystemExit(EXIT_UNREADABLE)
    if proc.returncode != 0:
        sys.stderr.write(proc.stderr or f"plan-cap: `pdca status` exited {proc.returncode}\n")
        raise SystemExit(EXIT_UNREADABLE)
    return proc.stdout


def tally(status_text: str) -> "OrderedDict[str, list[str]]":
    """Map each counted state to the bundle ids in it, in `pdca status` order."""
    found: "OrderedDict[str, list[str]]" = OrderedDict((s, []) for s in COUNTED)
    for line in status_text.splitlines():
        parts = line.split()
        if len(parts) < 2 or parts[0] not in found:
            continue
        found[parts[0]].append(parts[1].removeprefix("issue_"))
    return found


def track_of(bundle_root: Path, issue_id: str, default: str) -> str:
    """The track a bundle belongs to: its brief's `Track` field, lower-cased, else
    `default`. An unreadable or missing brief is `default` too — the count must never fail
    on one odd bundle."""
    try:
        text = (bundle_root / f"issue_{issue_id}" / "brief.md").read_text(
            encoding="utf-8", errors="replace")
    except OSError:
        return default
    m = _TRACK_RE.search(text)
    return m.group(1).lower() if m else default


def main(argv: list[str] | None = None) -> int:
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("--cap", type=int, default=None, help=f"cap (default $PDCA_PLANNED_CAP or {DEFAULT_CAP})")
    ap.add_argument("--need", type=int, default=1,
                    help="how many new bundles you are about to add — briefs in a batch, children of a split (default 1)")
    ap.add_argument("--status-file", default=None, help="read a saved `pdca status` output instead of running the driver")
    ap.add_argument("--quiet", action="store_true", help="print the one summary line only")
    ap.add_argument("--track", default=None,
                    help="the track whose room is checked (default $PDCA_DEFAULT_TRACK or "
                         f"{DEFAULT_TRACK}); a brief's `Track` field says which it belongs to")
    ap.add_argument("--bundle-root", default=None,
                    help="where the briefs live (default $PDCA_BUNDLE_ROOT or results/)")
    args = ap.parse_args(argv)
    default_track = os.environ.get("PDCA_DEFAULT_TRACK", DEFAULT_TRACK).strip().lower() or DEFAULT_TRACK
    track = (args.track or default_track).strip().lower()
    bundle_root = Path(args.bundle_root or os.environ.get("PDCA_BUNDLE_ROOT")
                       or HERE.parent / "results")

    cap = args.cap if args.cap is not None else int(os.environ.get("PDCA_PLANNED_CAP", DEFAULT_CAP))
    if cap < 0:
        ap.error("--cap must be >= 0")
    if args.need < 1:
        ap.error("--need must be >= 1")

    everything = tally(read_status(args.status_file))
    others: "OrderedDict[str, int]" = OrderedDict()
    found: "OrderedDict[str, list[str]]" = OrderedDict((s, []) for s in COUNTED)
    for state_name, ids in everything.items():
        for iid in ids:
            t = track_of(bundle_root, iid, default_track)
            if t == track:
                found[state_name].append(iid)
            else:
                others[t] = others.get(t, 0) + 1
    count = sum(len(v) for v in found.values())
    room = max(cap - count, 0)
    fits = args.need <= room
    if fits:
        verdict = f"room for {room}, need {args.need}: Plan intake open"
    else:
        verdict = f"room for {room}, need {args.need}: Plan intake closed"
    print(f"planned {count}/{cap} (cap, track {track}) — {verdict}")
    if not args.quiet:
        for state, ids in found.items():
            if ids:
                print(f"  {state:17} {len(ids):2}  {' '.join(ids)}")
        if others:
            print("  other tracks (their own room): "
                  + ", ".join(f"{t} {n}" for t, n in sorted(others.items())))
        if not fits:
            print(f"  rule wyrd-pdca-P1 (docs/INTEGRATION.md §11): no new brief in track {track},"
                  " no `pdca split --accept`, no split or reslicing proposal until its sign-offs"
                  " make room.")
    return EXIT_FITS if fits else EXIT_SHORT


if __name__ == "__main__":
    raise SystemExit(main())
