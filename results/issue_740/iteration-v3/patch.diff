@@ -0,0 +1,458 @@
+//! `wyrd-validate` — the blackbox S3-surface validator (proposal 0017,
+//! `docs/design/proposals/draft/0017-blackbox-validation-tool.md`).
+//!
+//! This slice (#740) lands only the crate skeleton: the argument surface every later
+//! slice parses (`--endpoint --region --bucket --scenario --duration --workers --seed
+//! --out --run-id --driver-placement`), credential resolution over
+//! `AWS_ACCESS_KEY_ID`/`AWS_SECRET_ACCESS_KEY` falling back to
+//! `WYRD_S3_ACCESS_KEY`/`WYRD_S3_SECRET_KEY`, and a resolved-configuration echo. No S3
+//! call is made here (#741); no scenario/oracle/pool/verdict logic exists yet (#743+).
+//!
+//! **Pure decisions, injected I/O** (proposal 0017 §2, the same convention
+//! `xtask/src/consistency_run_runner.rs:8-12` and `xtask/src/main.rs:1519` follow):
+//! [`resolve_credentials`] takes a lookup CLOSURE rather than reading `std::env`
+//! directly, so the fallback ordering is unit-testable without mutating process-global
+//! state (shared across parallel test threads — a read/write race the injected form
+//! cannot have). Only the thin `main` in `src/main.rs` touches the real environment, and
+//! it does so by handing [`run`] a closure over `std::env::var_os`.
+//!
+//! **Every input surface fails closed, and says which token it refused.** The three
+//! surfaces are the argument vector, the environment, and the record this tool prints
+//! back; each one can misreport a run if it is liberal:
+//!
+//! * arguments — an unrecognised flag, a `--`-prefixed token where a value belongs, an
+//!   empty value, a repeated flag, or an argument that is not valid UTF-8
+//!   ([`utf8_args`], [`ParsedArgs::parse`]);
+//! * environment — half a credential pair, an exported-but-empty name, or a name set to
+//!   bytes that are not valid UTF-8 ([`EnvValue`], [`resolve_credentials`]). "Set to
+//!   something unreadable" is NOT "absent": treating it as absent would silently sign the
+//!   run with the *other* pair's identity;
+//! * output — every operator-supplied value is printed quoted and escaped
+//!   ([`render_config_block`]), so a value carrying a newline or a terminal control
+//!   sequence cannot forge a configuration line that misstates the run.
+//!
+//! **The boundary this crate exists to keep**: `wyrd-validate`'s whole point is
+//! answering "is Wyrd correct" the way an external S3 client does, so it must never link
+//! a `wyrd-*` crate — `xtask::repo_guard::scan_blackbox_dependency_closure` (a workspace
+//! `cargo xtask ci` gate, not a doc comment) enforces that this crate's own `Cargo.toml`
+//! never grows a `[dependencies]` table that violates it.
+//!
+//! The operator-facing description of this surface — the flag table, the credential
+//! precedence, and the enforced boundary — is the living architecture doc,
+//! `docs/design/architecture/05-building-block-view.md` §5.4.
+
+#![forbid(unsafe_code)]
+
+use std::collections::BTreeMap;
+use std::ffi::OsString;
+use std::fmt;
+
+/// The complete CLI surface this slice parses. Order here is the order a missing-flag
+/// error is reported in ([`resolve_config`]) and the order the echoed configuration
+/// block prints in ([`Config::entries`]).
+pub const REQUIRED_FLAGS: &[&str] = &[
+    "endpoint",
+    "region",
+    "bucket",
+    "scenario",
+    "duration",
+    "workers",
+    "seed",
+    "out",
+    "run-id",
+    "driver-placement",
+];
+
+/// `--flag value` pairs only — no positionals, no valueless flags (every flag in
+/// [`REQUIRED_FLAGS`] takes a value). Mirrors the SHAPE of `ParsedArgs`
+/// (`crates/server/src/cli.rs:2495-2532`): a `--flag` walk collecting into a map, and
+/// "a flag needs a value" wording that matches so the two binaries feel like one
+/// product.
+///
+/// Deliberately does **not** mirror `ParsedArgs::parse`'s one silently-accepting
+/// behaviour: an unrecognised `--flag` here is a hard error naming it, not a value
+/// quietly recorded and never read. `wyrd-validate` is a brand-new binary an operator
+/// points at their own cluster; a typo'd flag silently ignored (`--duration 7d`
+/// misspelled) misreports the run it claims to have measured (issue #740 Design /
+/// Plan-review response).
+///
+/// That refusal holds in **both token positions**, which is the whole of it: rejecting
+/// an unknown token only where a flag is expected still lets the typo through one slot
+/// to the left. `--endpoint --totally-bogus …` would otherwise parse as "the endpoint is
+/// the string `--totally-bogus`", exit 0, and echo the typo back as configuration — the
+/// misreported run the strict policy exists to prevent, arrived at by a different route.
+/// So a value slot refuses:
+///
+/// * a `--`-prefixed token ([`ParsedArgs::FLAG_PREFIX`]) — no flag's value legitimately
+///   begins with `--` (endpoints, regions, buckets, paths, ids, counts), whereas a single
+///   `-` can legitimately lead one (a negative `--seed -12345`), so the check is on the
+///   flag prefix itself and not on `-`;
+/// * an empty string — `--endpoint ""` is not a configured endpoint, and echoing one back
+///   as resolved configuration is the same silent misreport.
+///
+/// A flag given **twice** is refused for the third form of the same hazard: `--duration
+/// 30s --duration 30m` silently keeping one of the two would report a run that is not the
+/// one the operator asked for.
+pub struct ParsedArgs {
+    flags: BTreeMap<String, String>,
+}
+
+impl ParsedArgs {
+    /// What makes a token a flag — and, by the same constant, what a value slot refuses:
+    /// a value is rejected *because* it would otherwise read as a flag. One spelling, so
+    /// the two positions cannot drift apart into a hole between them.
+    pub const FLAG_PREFIX: &'static str = "--";
+
+    /// Parse `--flag value` pairs, refusing anything else. See the type docs for why each
+    /// refusal is a refusal rather than a liberal read.
+    pub fn parse(args: &[String]) -> Result<Self, String> {
+        let mut flags = BTreeMap::new();
+        let mut i = 0;
+        while i < args.len() {
+            let Some(name) = args[i].strip_prefix(Self::FLAG_PREFIX) else {
+                return Err(format!(
+                    "unrecognised argument {} — wyrd-validate takes only `--flag value` \
+                     pairs",
+                    quoted(&args[i])
+                ));
+            };
+            if !REQUIRED_FLAGS.contains(&name) {
+                return Err(format!(
+                    "unrecognised flag {} — wyrd-validate accepts only: --{}",
+                    quoted(&args[i]),
+                    REQUIRED_FLAGS.join(", --")
+                ));
+            }
+            let value = args
+                .get(i + 1)
+                .ok_or_else(|| format!("flag `--{name}` needs a value"))?;
+            if value.starts_with(Self::FLAG_PREFIX) {
+                return Err(format!(
+                    "flag `--{name}` needs a value, but the next argument is {} — \
+                     wyrd-validate never consumes a `{}`-prefixed token as a value (a \
+                     mistyped flag would otherwise be swallowed as one)",
+                    quoted(value),
+                    Self::FLAG_PREFIX
+                ));
+            }
+            if value.is_empty() {
+                return Err(format!("flag `--{name}` needs a non-empty value"));
+            }
+            if let Some(previous) = flags.insert(name.to_string(), value.clone()) {
+                return Err(format!(
+                    "flag `--{name}` given more than once ({}, then {}) — \
+                     wyrd-validate refuses rather than silently keeping one",
+                    quoted(&previous),
+                    quoted(value)
+                ));
+            }
+            i += 2;
+        }
+        Ok(Self { flags })
+    }
+
+    /// The value given for `name`, or `None` if the flag was not given.
+    pub fn flag(&self, name: &str) -> Option<&str> {
+        self.flags.get(name).map(String::as_str)
+    }
+}
+
+/// The resolved value of every flag in [`REQUIRED_FLAGS`] — all ten are required in
+/// this slice (no scenario runs with an unset endpoint, region, etc.). Values are kept
+/// as the raw strings the operator typed: parsing them into typed durations/counts is
+/// out of scope here (issue #740 scope) and belongs to the slice that actually consumes
+/// them.
+///
+/// The line between what [`ParsedArgs`] refuses and what this leaves alone is
+/// deliberate: the parser rejects tokens that are not *values at all* (a mistyped flag
+/// swallowed into a value slot, an empty string, a flag repeated), because those are
+/// indistinguishable from configuration once echoed. What a value *means* —
+/// `--workers` as a count, `--duration` as a duration, `--driver-placement` as
+/// `internal`/`external` (proposal 0017 §10) — is validated by the slice that consumes
+/// it, where the accepted set is defined; validating it here would fix a vocabulary this
+/// slice has no consumer for.
+#[derive(Debug, PartialEq, Eq)]
+pub struct Config {
+    pub endpoint: String,
+    pub region: String,
+    pub bucket: String,
+    pub scenario: String,
+    pub duration: String,
+    pub workers: String,
+    pub seed: String,
+    pub out: String,
+    pub run_id: String,
+    pub driver_placement: String,
+}
+
+impl Config {
+    /// Every flag with its resolved value, in [`REQUIRED_FLAGS`] order. This is the ONE
+    /// place a flag is paired with the field that holds it, so the echoed block
+    /// ([`render_config_block`]) cannot drift into reporting nine of the ten: a flag added
+    /// to [`REQUIRED_FLAGS`] and not to this list is caught by
+    /// `crates/validate/tests/cli_surface.rs`'s equality assertion between the two.
+    pub fn entries(&self) -> Vec<(&'static str, &str)> {
+        vec![
+            ("endpoint", self.endpoint.as_str()),
+            ("region", self.region.as_str()),
+            ("bucket", self.bucket.as_str()),
+            ("scenario", self.scenario.as_str()),
+            ("duration", self.duration.as_str()),
+            ("workers", self.workers.as_str()),
+            ("seed", self.seed.as_str()),
+            ("out", self.out.as_str()),
+            ("run-id", self.run_id.as_str()),
+            ("driver-placement", self.driver_placement.as_str()),
+        ]
+    }
+}
+
+/// Every [`REQUIRED_FLAGS`] entry must be present; the first missing one (in
+/// declaration order) is named in the returned error, matching criterion 3's "a
+/// missing required argument exits non-zero with the offending flag named on stderr".
+pub fn resolve_config(parsed: &ParsedArgs) -> Result<Config, String> {
+    fn require(parsed: &ParsedArgs, name: &str) -> Result<String, String> {
+        parsed
+            .flag(name)
+            .map(str::to_string)
+            .ok_or_else(|| format!("missing required flag `--{name}`"))
+    }
+    Ok(Config {
+        endpoint: require(parsed, "endpoint")?,
+        region: require(parsed, "region")?,
+        bucket: require(parsed, "bucket")?,
+        scenario: require(parsed, "scenario")?,
+        duration: require(parsed, "duration")?,
+        workers: require(parsed, "workers")?,
+        seed: require(parsed, "seed")?,
+        out: require(parsed, "out")?,
+        run_id: require(parsed, "run-id")?,
+        driver_placement: require(parsed, "driver-placement")?,
+    })
+}
+
+/// What one environment lookup found — three answers, not two.
+///
+/// [`NotUnicode`](EnvValue::NotUnicode) exists because collapsing it into
+/// [`Absent`](EnvValue::Absent) (what `std::env::var(name).ok()` does) is a silent
+/// identity substitution: an operator whose `AWS_ACCESS_KEY_ID` holds bytes this tool
+/// cannot read would have the run signed with the `WYRD_S3_*` identity instead, and the
+/// echoed configuration would name that second identity as though it had been chosen.
+/// "Set to something unreadable" is an error naming the variable; "not set" is a
+/// fall-through to the next source.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum EnvValue {
+    /// The name is not set in this environment.
+    Absent,
+    /// The name is set, and its value is valid UTF-8 (possibly empty — emptiness is
+    /// judged by [`resolve_credentials`], which refuses it).
+    Present(String),
+    /// The name is set to bytes that are not valid UTF-8. An S3 access key is an ASCII
+    /// string, so this is never a usable credential — and never a reason to fall back.
+    NotUnicode,
+}
+
+/// Where the resolved access-key id came from — printed in the echoed configuration
+/// block so an operator can tell which pair actually took effect.
+#[derive(Debug, PartialEq, Eq)]
+pub enum CredentialSource {
+    /// `AWS_ACCESS_KEY_ID` / `AWS_SECRET_ACCESS_KEY` — what every S3 client and CI
+    /// runner already sets. Tried first, and wins when both pairs are present.
+    Aws,
+    /// `WYRD_S3_ACCESS_KEY` / `WYRD_S3_SECRET_KEY` — the gateway's own names
+    /// (`crates/server/src/cli.rs:2128,2135`), so a developer already running a
+    /// loopback gateway needs no second export.
+    Wyrd,
+}
+
+impl CredentialSource {
+    /// The pair's environment names, as printed in the echoed configuration block.
+    pub fn label(&self) -> &'static str {
+        match self {
+            CredentialSource::Aws => "AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY",
+            CredentialSource::Wyrd => "WYRD_S3_ACCESS_KEY / WYRD_S3_SECRET_KEY",
+        }
+    }
+
+    /// The `(id, secret)` environment names this source reads, in the order
+    /// [`resolve_credentials`] tries the sources.
+    fn names(&self) -> (&'static str, &'static str) {
+        match self {
+            CredentialSource::Aws => ("AWS_ACCESS_KEY_ID", "AWS_SECRET_ACCESS_KEY"),
+            CredentialSource::Wyrd => ("WYRD_S3_ACCESS_KEY", "WYRD_S3_SECRET_KEY"),
+        }
+    }
+}
+
+/// A resolved id/secret pair plus the [`CredentialSource`] it came from. The secret is
+/// carried here (a later slice needs it to sign requests) but [`render_config_block`]
+/// never prints it — only the id and the source are echoed.
+pub struct Credentials {
+    pub access_key_id: String,
+    pub secret_access_key: String,
+    pub source: CredentialSource,
+}
+
+/// Redacting `Debug`, written out rather than derived: a derived one prints the secret,
+/// so a single future `{:?}` — in a log line, an error, a `dbg!` left in — would leak it
+/// past the "never printed" rule [`render_config_block`] keeps. The id and source stay
+/// visible because they are exactly what the echoed block already publishes.
+impl fmt::Debug for Credentials {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.debug_struct("Credentials")
+            .field("access_key_id", &self.access_key_id)
+            .field("secret_access_key", &"<redacted>")
+            .field("source", &self.source)
+            .finish()
+    }
+}
+
+/// One environment read, keeping "set to something unreadable" distinct from "not set"
+/// (see [`EnvValue`]). `Ok(None)` means absent — the only answer that may fall through
+/// to the next credential source.
+fn read_credential(
+    lookup: &mut dyn FnMut(&str) -> EnvValue,
+    name: &str,
+) -> Result<Option<String>, String> {
+    match lookup(name) {
+        EnvValue::Present(value) => Ok(Some(value)),
+        EnvValue::Absent => Ok(None),
+        EnvValue::NotUnicode => Err(format!(
+            "`{name}` is set but is not valid UTF-8 — an S3 access key is an ASCII \
+             string, so wyrd-validate refuses rather than treating the variable as unset \
+             and signing the run with another pair's identity"
+        )),
+    }
+}
+
+/// AWS-shaped names first (what every S3 client and CI runner already sets), falling
+/// back to the gateway's own `WYRD_S3_*` names; when both pairs are fully present AWS
+/// wins. `lookup` is an INJECTED closure, not `std::env::var` read directly here — so
+/// the fallback ordering is exercised without mutating process-global state (proposal
+/// 0017 §2's "pure decisions, injected I/O", mirroring `run_ci_steps(&mut |name|
+/// std::env::var_os(name).is_some(), ...)`, `xtask/src/main.rs:1519`). Only
+/// `src/main.rs`'s `main` passes a closure that touches the real environment.
+///
+/// **Anything other than "absent" stops the search** — the same refusal the parser
+/// applies to a mistyped flag, at the other input surface. An operator who exported
+/// `AWS_ACCESS_KEY_ID` and misspelled the secret's name has stated an intent; quietly
+/// signing the run with the *other* pair's identity instead would attribute the results
+/// to a credential they never chose. An exported-but-EMPTY name is the same case (it is
+/// set, it cannot be used, and the error says which one to fix), and so is a name set to
+/// non-UTF-8 bytes ([`EnvValue::NotUnicode`]).
+pub fn resolve_credentials(
+    lookup: &mut dyn FnMut(&str) -> EnvValue,
+) -> Result<Credentials, String> {
+    for source in [CredentialSource::Aws, CredentialSource::Wyrd] {
+        let (id_name, secret_name) = source.names();
+        let id = read_credential(lookup, id_name)?;
+        let secret = read_credential(lookup, secret_name)?;
+        match (id, secret) {
+            (Some(id), Some(secret)) => {
+                for (name, value) in [(id_name, &id), (secret_name, &secret)] {
+                    if value.is_empty() {
+                        return Err(format!("`{name}` is set but empty — set it, or unset it"));
+                    }
+                }
+                return Ok(Credentials {
+                    access_key_id: id,
+                    secret_access_key: secret,
+                    source,
+                });
+            }
+            (Some(_), None) => {
+                return Err(format!(
+                    "`{id_name}` is set but `{secret_name}` is not — set both, or unset \
+                     `{id_name}` to use another credential pair"
+                ));
+            }
+            (None, Some(_)) => {
+                return Err(format!(
+                    "`{secret_name}` is set but `{id_name}` is not — set both, or unset \
+                     `{secret_name}` to use another credential pair"
+                ));
+            }
+            (None, None) => continue,
+        }
+    }
+    Err(
+        "no credentials found — set AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY, or \
+         WYRD_S3_ACCESS_KEY and WYRD_S3_SECRET_KEY"
+            .to_string(),
+    )
+}
+
+/// One operator-supplied string as a single unambiguous record field: double-quoted,
+/// with quotes, backslashes and every non-printable character escaped
+/// (`str::escape_debug`, so a newline prints as `\n` and a terminal escape as `\u{1b}`).
+///
+/// Escaping is not cosmetic. The echoed block is a record of what this run was
+/// configured with, one field per line; interpolating a raw value lets `--bucket
+/// $'real\n--endpoint http://elsewhere'` print a line that reads exactly like a
+/// resolved `--endpoint`, so the record would misstate the run — and a value carrying a
+/// terminal control sequence could rewrite what an operator sees on their terminal.
+/// Escaping keeps every value fully recoverable (nothing is dropped or replaced) while
+/// making the field boundaries unforgeable; the same helper wraps the values named in
+/// parse errors, since those are printed to the same terminal.
+fn quoted(value: &str) -> String {
+    format!("\"{}\"", value.escape_debug())
+}
+
+/// The resolved-configuration block `wyrd-validate` echoes on success: every
+/// [`REQUIRED_FLAGS`] entry with the value it was given (quoted and escaped by
+/// `quoted`), plus the resolved access-key **id** and its [`CredentialSource`]. The
+/// secret NEVER appears here — criterion 4 asserts its absence by searching the whole
+/// process output for the secret's value.
+pub fn render_config_block(config: &Config, credentials: &Credentials) -> String {
+    let mut block = String::from("resolved configuration:\n");
+    for (flag, value) in config.entries() {
+        block.push_str(&format!("--{flag} {}\n", quoted(value)));
+    }
+    block.push_str(&format!(
+        "credentials: access-key-id={} source={}\n",
+        quoted(&credentials.access_key_id),
+        quoted(credentials.source.label())
+    ));
+    block
+}
+
+/// The raw OS argument vector as UTF-8 strings, refusing an argument this tool cannot
+/// read rather than panicking or transcoding it lossily.
+///
+/// `std::env::args()` **panics** on a non-UTF-8 argument, and a lossy conversion would be
+/// worse than the panic: `--bucket $'\xff'` would resolve to the replacement character
+/// and the echoed block would report a bucket name that was never asked for. The refusal
+/// names the argument's position and shows its lossy form (escaped, like every other
+/// operator-supplied value) so the operator can find the offending token.
+pub fn utf8_args<A: IntoIterator<Item = OsString>>(args: A) -> Result<Vec<String>, String> {
+    args.into_iter()
+        .enumerate()
+        .map(|(index, arg)| {
+            arg.into_string().map_err(|raw| {
+                format!(
+                    "argument {} is not valid UTF-8 (as far as it can be read: {}) — \
+                     wyrd-validate refuses an argument it cannot read rather than \
+                     guessing at it",
+                    index + 1,
+                    quoted(&raw.to_string_lossy())
+                )
+            })
+        })
+        .collect()
+}
+
+/// The whole of `wyrd-validate`'s work in this slice: read the arguments, parse them,
+/// validate presence, resolve credentials, echo. `main` in `src/main.rs` is the thin
+/// wrapper that supplies the real `std::env::args_os()` / `std::env::var_os` and prints
+/// the `Ok`/`Err` result — every decision above is reachable from a test without a
+/// process.
+pub fn run<A: IntoIterator<Item = OsString>>(
+    args: A,
+    lookup: &mut dyn FnMut(&str) -> EnvValue,
+) -> Result<String, String> {
+    let args = utf8_args(args)?;
+    let parsed = ParsedArgs::parse(&args)?;
+    let config = resolve_config(&parsed)?;
+    let credentials = resolve_credentials(lookup)?;
+    Ok(render_config_block(&config, &credentials))
+}
