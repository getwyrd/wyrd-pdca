new file mode 100644
index 0000000..c253d6c
--- /dev/null
+++ b/crates/validate/src/main.rs
@@ -0,0 +1,34 @@
+//! Thin `wyrd-validate` binary over the `wyrd_validate` lib target — the only place that
+//! touches real process state, so every decision in `src/lib.rs` (`run`, `resolve_config`,
+//! `resolve_credentials`, `utf8_args`) stays reachable from a test without a process.
+//!
+//! Both reads are `*_os`: `std::env::args()` panics on a non-UTF-8 argument and
+//! `std::env::var(name).ok()` reports a non-UTF-8 *value* as absent, which would silently
+//! fall back to the other credential pair's identity. The `OsString` forms let
+//! `wyrd_validate` refuse each case by name instead (`EnvValue::NotUnicode`).
+
+#![forbid(unsafe_code)]
+
+use std::process::ExitCode;
+
+use wyrd_validate::EnvValue;
+
+fn main() -> ExitCode {
+    let mut lookup = |name: &str| match std::env::var_os(name) {
+        None => EnvValue::Absent,
+        Some(raw) => match raw.into_string() {
+            Ok(value) => EnvValue::Present(value),
+            Err(_) => EnvValue::NotUnicode,
+        },
+    };
+    match wyrd_validate::run(std::env::args_os().skip(1), &mut lookup) {
+        Ok(block) => {
+            print!("{block}");
+            ExitCode::SUCCESS
+        }
+        Err(message) => {
+            eprintln!("wyrd-validate: {message}");
+            ExitCode::FAILURE
+        }
+    }
+}
