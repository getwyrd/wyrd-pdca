+pub const BLACKBOX_METADATA_ARGS: &[&str] = &[
+    "metadata",
+    "--format-version",
+    "1",
+    "--locked",
+    "--all-features",
+];
+
+/// How `cargo metadata` classifies one dependency edge. `Normal` is the only kind that
+/// ships inside the binary, and therefore the only kind the blackbox closure follows.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+enum DepKind {
+    /// `"kind": null` — an ordinary `[dependencies]` entry (optional or not).
+    Normal,
+    /// `"kind": "dev"` — `[dev-dependencies]`; unconstrained by proposal 0017 §9,
+    /// because what a test harness links never ships.
+    Dev,
+    /// `"kind": "build"` — `[build-dependencies]`; runs at build time, never linked
+    /// into the binary.
+    Build,
+}
+
+/// Classify ONE `kind` field, failing closed on anything it cannot read.
+///
+/// Verified against the real workspace document (`cargo metadata --format-version 1
+/// --locked --all-features`): every `packages[].dependencies[]` entry carries a `kind`
+/// key and every `resolve.nodes[].deps[].dep_kinds[]` entry carries one, holding exactly
+/// `null`, `"dev"` or `"build"`.
+///
+/// So a missing key, a different string, or a non-string value is not a shape cargo
+/// emits — it is a document this guard cannot read, and "cannot read" must never
+/// silently become "not a normal dependency". That inference is what turns a malformed
+/// (or hand-edited, or future-cargo) document into a vacuous pass: the `wyrd-*` edge
+/// stays in the manifest, the guard classifies it as non-normal, and the gate goes green
+/// on a closure it never checked.
+fn dep_kind(kind: Option<&serde_json::Value>, context: &str) -> Result<DepKind, String> {
+    match kind {
+        Some(value) if value.is_null() => Ok(DepKind::Normal),
+        Some(value) => match value.as_str() {
+            Some("dev") => Ok(DepKind::Dev),
+            Some("build") => Ok(DepKind::Build),
+            _ => Err(format!(
+                "blackbox-guard: {context} has an unreadable dependency `kind` ({value}) \
+                 — refusing to classify an edge it cannot read (cargo emits null, \"dev\" \
+                 or \"build\")"
+            )),
+        },
+        None => Err(format!(
+            "blackbox-guard: {context} has no dependency `kind` field — refusing to \
+             classify an edge it cannot read"
+        )),
+    }
+}
+
+/// Does `cargo metadata` report this resolve-graph edge as a NORMAL dependency? True iff
+/// at least one of its `dep_kinds` entries is normal — an edge can carry several (one per
+/// kind/target combination), and a crate that is both a normal and a dev dependency does
+/// ship inside the binary.
+///
+/// EVERY entry is classified, not just entries until the first normal one: an edge whose
+/// `dep_kinds` array is missing, empty, or carries one entry `dep_kind` cannot read is
+/// an `Err`. "We cannot tell what kind this edge is" and "this edge is dev-only" are
+/// different answers, and silently choosing the second would drop the edge — and
+/// everything behind it — out of the closure the guard claims to have checked.
+fn edge_is_normal(edge: &serde_json::Value, context: &str) -> Result<bool, String> {
+    let kinds = edge
+        .get("dep_kinds")
+        .and_then(|k| k.as_array())
+        .ok_or_else(|| {
+            format!(
+                "blackbox-guard: {context} has no `dep_kinds` array — refusing to \
+                 classify an edge it cannot read"
+            )
+        })?;
+    if kinds.is_empty() {
+        return Err(format!(
+            "blackbox-guard: {context} has an empty `dep_kinds` array — refusing to \
+             classify an edge it cannot read"
+        ));
+    }
+    let mut normal = false;
+    for entry in kinds {
+        if dep_kind(entry.get("kind"), context)? == DepKind::Normal {
+            normal = true;
+        }
+    }
+    Ok(normal)
+}
+
+/// The **normal** dependency closure of `package`, transitively and under every
+/// feature — proposal 0017 §9's blackbox property, made mechanical. `metadata_json`
+/// MUST come from `cargo metadata --format-version 1 --locked --all-features` (no
+/// `--no-deps`): the resolve graph is what actually links, and it is
+/// FEATURE-DEPENDENT — an optional normal dependency behind an off-by-default feature
+/// (`crates/metadata-tikv/Cargo.toml:11-30` is the live pattern) is invisible to a
+/// default-feature resolve, which is exactly why `--all-features` is mandatory here
+/// (#740 Design).
+///
+/// Two independent sources are scanned, because the resolve graph alone can still miss
+/// an edge some future feature-resolution subtlety keeps out of it:
+///
+/// 1. **the resolve graph** (`resolve.nodes`), walked breadth-first from `package`'s
+///    node, following only normal (`edge_is_normal`) edges; every reached package whose name
+///    starts with `forbidden_prefix` is a violation, reported with the dependency PATH
+///    that reached it (a one-hop violation an operator can fix by deleting a line reads
+///    very differently from one three crates deep);
+/// 2. **`package`'s own declared dependency list** (`packages[].dependencies`), which
+///    is feature-INDEPENDENT and carries `optional` per entry — the belt to the
+///    graph's braces (#740 Design, Plan-review response). A crate the graph walk already
+///    named is not reported again from here.
+///
+/// Fails CLOSED (`Err`, never a vacuously clean `Ok(vec![])`), mirroring [`scan_roots`]'
+/// "refusing to pass a workspace it cannot see" (`repo_guard.rs:496-510`): an
+/// unparsable document, a `packages` array without `package`, a document with no
+/// `resolve` section, or a `resolve` section whose nodes never mention `package`.
+///
+/// The same refusal applies to every part of the closure the walk cannot read, not only
+/// to its entry point — a package REACHED by a normal edge but carrying no resolve node,
+/// a node with no `deps` array, an edge naming no `pkg`, an edge or declared dependency
+/// whose `kind` is unreadable (`dep_kind`), or a `package` whose declared dependency
+/// list is missing or has a nameless entry. Each of those would otherwise be a silent
+/// skip, and a skip one hop out hides every forbidden crate behind it, which is
+/// indistinguishable (to the gate) from a closure that is clean.
+pub fn scan_blackbox_dependency_closure(
+    metadata_json: &str,
+    package: &str,
+    forbidden_prefix: &str,
+) -> Result<Vec<String>, String> {
+    let meta: serde_json::Value = serde_json::from_str(metadata_json)
+        .map_err(|e| format!("blackbox-guard: cannot parse cargo metadata: {e}"))?;
+    let packages = meta
+        .get("packages")
+        .and_then(|p| p.as_array())
+        .ok_or_else(|| "blackbox-guard: cargo metadata has no `packages` array".to_string())?;
+
+    // Package id -> plain crate name, so a resolve-graph edge (keyed by a
+    // registry/version-qualified id) can be checked against `forbidden_prefix`.
+    let mut name_of: BTreeMap<&str, &str> = BTreeMap::new();
+    for p in packages {
+        if let (Some(id), Some(name)) = (
+            p.get("id").and_then(|v| v.as_str()),
+            p.get("name").and_then(|v| v.as_str()),
+        ) {
+            name_of.insert(id, name);
+        }
+    }
+
+    let mut matching = packages
+        .iter()
+        .filter(|p| p.get("name").and_then(|v| v.as_str()) == Some(package));
+    let pkg_entry = matching.next().ok_or_else(|| {
+        format!(
+            "blackbox-guard: package `{package}` not found in cargo metadata packages \
+             — refusing to pass a closure it cannot see"
+        )
+    })?;
+    // A name can legitimately appear twice in one resolve (two versions, or a registry
+    // crate that happens to share a workspace member's name). Scanning whichever came
+    // first would then audit one closure and clear the other, so the ambiguity is an
+    // error: the guard says which package it must be told about rather than guessing.
+    if matching.next().is_some() {
+        return Err(format!(
+            "blackbox-guard: cargo metadata reports more than one package named \
+             `{package}` — refusing to guess which closure to scan"
+        ));
+    }
+    let package_id = pkg_entry
+        .get("id")
+        .and_then(|v| v.as_str())
+        .ok_or_else(|| format!("blackbox-guard: package `{package}` has no `id`"))?;
+
+    let resolve = meta.get("resolve").ok_or_else(|| {
+        "blackbox-guard: cargo metadata has no `resolve` section — refusing to pass a \
+         closure it cannot see (run `cargo metadata` WITHOUT `--no-deps`)"
+            .to_string()
+    })?;
+    let nodes = resolve
+        .get("nodes")
+        .and_then(|n| n.as_array())
+        .ok_or_else(|| "blackbox-guard: `resolve` has no `nodes` array".to_string())?;
+    let mut node_of: BTreeMap<&str, &serde_json::Value> = BTreeMap::new();
+    for n in nodes {
+        if let Some(id) = n.get("id").and_then(|v| v.as_str()) {
+            node_of.insert(id, n);
+        }
+    }
+    if !node_of.contains_key(package_id) {
+        return Err(format!(
+            "blackbox-guard: package `{package}` does not appear in the resolve graph — \
+             refusing to pass a closure it cannot see"
+        ));
+    }
+
+    // (1) the resolve graph, breadth-first, following only normal edges. `visited` makes
+    // the walk terminate on the cycles a real dependency graph can contain (dev-cycles
+    // between workspace crates are legal) and keeps the reported path the shortest one.
+    let mut violations = Vec::new();
+    let mut named: BTreeSet<&str> = BTreeSet::new();
+    let mut visited: BTreeSet<&str> = BTreeSet::new();
+    visited.insert(package_id);
+    let mut queue: VecDeque<(&str, Vec<&str>)> = VecDeque::new();
+    queue.push_back((package_id, vec![package]));
+    while let Some((id, path)) = queue.pop_front() {
+        let name = name_of.get(id).copied().unwrap_or(id);
+        // Fail CLOSED one hop out, too: a package REACHED by a normal edge whose node the
+        // resolve section never defines is a part of the closure this scan cannot walk, so
+        // skipping it would hide every `forbidden_prefix` crate behind it. Same rule as the
+        // target package's own absence above — "refusing to pass a closure it cannot see".
+        let node = node_of.get(id).ok_or_else(|| {
+            format!(
+                "blackbox-guard: `{name}` is reached from `{package}` but has no node in \
+                 the resolve graph — refusing to pass a closure it cannot see (via {})",
+                path.join(" -> ")
+            )
+        })?;
+        let deps = node.get("deps").and_then(|d| d.as_array()).ok_or_else(|| {
+            format!(
+                "blackbox-guard: the resolve node for `{name}` has no `deps` array — \
+                 refusing to pass a closure it cannot see"
+            )
+        })?;
+        for dep in deps {
+            let Some(target_id) = dep.get("pkg").and_then(|v| v.as_str()) else {
+                return Err(format!(
+                    "blackbox-guard: a dependency edge of `{name}` names no `pkg` — \
+                     refusing to pass a closure it cannot see"
+                ));
+            };
+            let target_name = name_of.get(target_id).copied().unwrap_or(target_id);
+            // Classify BEFORE the `visited` short-circuit: an unreadable edge is an error
+            // whether or not this walk has already reached its target by another path.
+            let normal = edge_is_normal(dep, &format!("the edge `{name}` -> `{target_name}`"))?;
+            if !normal || visited.contains(target_id) {
+                continue;
+            }
+            visited.insert(target_id);
+            let mut next_path = path.clone();
+            next_path.push(target_name);
+            if target_name.starts_with(forbidden_prefix) && named.insert(target_name) {
+                violations.push(format!(
+                    "{package}: normal dependency closure reaches `{target_name}` via {}",
+                    next_path.join(" -> ")
+                ));
+            }
+            queue.push_back((target_id, next_path));
+        }
+    }
+
+    // (2) the package's own declared dependency list — feature-independent belt to the
+    // graph's braces. Absent or unreadable, it is an Err rather than a skipped scan: a
+    // belt nobody can see is not a belt (the same fail-closed rule as the walk above).
+    let declared = pkg_entry
+        .get("dependencies")
+        .and_then(|d| d.as_array())
+        .ok_or_else(|| {
+            format!(
+                "blackbox-guard: package `{package}` has no `dependencies` array — refusing \
+                 to pass a declaration list it cannot see"
+            )
+        })?;
+    for dep in declared {
+        let name = dep.get("name").and_then(|v| v.as_str()).ok_or_else(|| {
+            format!(
+                "blackbox-guard: package `{package}` declares a dependency with no `name` — \
+                 refusing to pass a declaration it cannot read"
+            )
+        })?;
+        if dep_kind(
+            dep.get("kind"),
+            &format!("`{package}`'s declared dependency on `{name}`"),
+        )? != DepKind::Normal
+        {
+            continue;
+        }
+        if name.starts_with(forbidden_prefix) && !named.contains(name) {
+            let optional = dep
+                .get("optional")
+                .and_then(|v| v.as_bool())
+                .unwrap_or(false);
+            violations.push(format!(
+                "{package}: declares a normal dependency on `{name}`{} — not caught by \
+                 the resolve graph walk",
+                if optional { " (optional)" } else { "" }
+            ));
+        }
+    }
+
+    Ok(violations)
+}
+
+/// Shells [`BLACKBOX_METADATA_ARGS`] to `cargo` from the workspace root (see that
+/// constant for why each flag is load-bearing) and hands the JSON to
+/// [`scan_blackbox_dependency_closure`] for every [`BLACKBOX_GUARD_TARGETS`] entry.
+///
+/// Registered in [`HYGIENE_GUARDS`] as DATA (name + callable) rather than a `fn`
+/// private to the binary target — the same reason `xtask::feature_gated_checks` lives
+/// in the lib target (`main.rs:1504-1505`): a guard defined, tested and never CALLED
+/// passes every other assertion in #740 silently, exactly the wiring hazard
+/// `run_ci_steps`' injected `exec` already guards against (`main.rs:1486-1498`).
+pub fn run_blackbox_dependency_guard() -> Result<(), String> {
+    println!(
+        "\n$ xtask blackbox-dependency-guard (proposal 0017 §9: no wyrd-* in a validated \
+         package's normal closure)"
+    );
+    let root = crate::workspace_root();
+    let meta = std::process::Command::new("cargo")
+        .args(BLACKBOX_METADATA_ARGS)
+        .current_dir(&root)
+        .output()
+        .map_err(|e| format!("blackbox-guard: failed to spawn cargo metadata: {e}"))?;
+    if !meta.status.success() {
+        return Err(format!(
+            "blackbox-guard: `cargo metadata` failed with {}:\n{}",
+            meta.status,
+            String::from_utf8_lossy(&meta.stderr)
+        ));
+    }
+    // `cargo metadata`'s stdout is JSON, which is UTF-8 by definition; a lossy read here
+    // could only mangle a document `serde_json` would then refuse — the fail-closed
+    // branch, not a silent pass.
+    let metadata = String::from_utf8_lossy(&meta.stdout);
+    let mut violations = Vec::new();
+    for (package, prefix) in BLACKBOX_GUARD_TARGETS {
+        violations.extend(scan_blackbox_dependency_closure(
+            &metadata, package, prefix,
+        )?);
+    }
+    if violations.is_empty() {
+        println!(
+            "xtask blackbox-dependency-guard: every validated package's normal dependency \
+             closure stays blackbox (proposal 0017 §9)"
+        );
+        Ok(())
+    } else {
+        Err(format!(
+            "proposal 0017 §9 violation — a validator's normal dependency closure must \
+             contain no wyrd-* crate (transitively, under every feature), so its verdict \
+             never tests Wyrd's types against Wyrd's types:\n  {}",
+            violations.join("\n  ")
+        ))
+    }
+}
+
+/// One repo-hygiene check `run_ci` runs, registered as DATA (name + callable) — the
+/// `xtask::feature_gated_checks` pattern (`main.rs:1504-1505`, `xtask/src/lib.rs:81`),
+/// applied to a guard that is not a plain `cargo` invocation.
+///
+/// `run_gitlink_guard` / `run_unsafe_forbid_guard` predate this table and stay
+/// binary-target `fn`s called directly from `run_ci` (`main.rs:1557-1558`) — that
+/// pattern is NOT extended here (#740): a third guard added the same untestable
+/// way would be exactly the wiring hazard this table exists to close (a guard defined,
+/// tested and never called passes every other assertion silently).
+pub struct HygieneGuard {
+    pub name: &'static str,
+    pub run: fn() -> Result<(), String>,
+}
+
+/// The registered hygiene guards, in the order [`run_hygiene_guards`] runs them.
+/// `xtask/tests/blackbox_dependency_guard.rs` asserts the blackbox guard's presence
+/// here — that assertion IS #740's criterion 1: a guard missing from this exact list
+/// never runs, however many of its own planted-metadata cases it passes.
+pub const HYGIENE_GUARDS: &[HygieneGuard] = &[HygieneGuard {
+    name: "blackbox-dependency-guard",
+    run: run_blackbox_dependency_guard,
+}];
+
+/// Run every [`HYGIENE_GUARDS`] entry through the injected `run`, stopping at the first
+/// failure — `run_ci`'s hygiene phase, lifted into the lib target so the WIRING is
+/// exercised by a test and not only the guards themselves.
+///
+/// This is `run_ci_steps`' injected-`exec` idiom (`main.rs:1486-1498`, "so the real
+/// wiring is exercised without spawning cargo") applied to the guards: `run_ci` passes
+/// `|guard| (guard.run)()`, and `xtask/tests/blackbox_dependency_guard.rs` passes a
+/// recording closure. Two failure modes of #740's criterion 1 live in the three lines
+/// below and are therefore covered by that test rather than by hope — a guard that is
+/// registered but never reached, and a guard whose `Err` is discarded instead of
+/// stopping the gate (a violation reported to nobody is a green gate over a broken
+/// invariant). What remains outside a test's reach is one call line in `run_ci` itself,
+/// which no integration test can see into a binary target.
+pub fn run_hygiene_guards(
+    run: &mut dyn FnMut(&HygieneGuard) -> Result<(), String>,
+) -> Result<(), String> {
+    for guard in HYGIENE_GUARDS {
+        run(guard)?;
+    }
+    Ok(())
+}
