+[package]
+name = "wyrd-validate"
+description = "Blackbox S3-surface validator (proposal 0017): a client of Wyrd's S3 wire surface, never a consumer of its internal crates — enforced by xtask::repo_guard's dependency-closure guard, not a doc comment."
+version.workspace = true
+edition.workspace = true
+rust-version.workspace = true
+license.workspace = true
+repository.workspace = true
+publish.workspace = true
+
+# No [dependencies] table: this crate is the one workspace member whose whole point is
+# staying OUTSIDE the `wyrd-*` dependency closure (proposal 0017 §9). Anything added here
+# is exactly what xtask::repo_guard::scan_blackbox_dependency_closure exists to catch —
+# see issue #740's "no new dependency" scope note before adding one. Dev-dependencies are
+# deliberately unconstrained (normal, not total): what a test harness links never ships in
+# the binary.
+
+# Inherit the workspace lint policy (single source of truth in the root
+# Cargo.toml [workspace.lints.*]).
+[lints]
+workspace = true
