+/// `(package, forbidden name prefix)` pairs [`run_blackbox_dependency_guard`] enforces.
+/// Kept as DATA (the [`UNSAFE_FORBID_ALLOWLIST`] style) so a second blackbox tool is a
+/// one-line reviewed diff, not a second copy of the guard (brief #740, open question 2).
+/// One entry today: `wyrd-validate`'s normal dependency closure must contain no
+/// `wyrd-*` crate (proposal 0017 §9, "Normal, not total").
+pub const BLACKBOX_GUARD_TARGETS: &[(&str, &str)] = &[("wyrd-validate", "wyrd-")];
+
+/// Does `cargo metadata` report `edge`'s dep as a NORMAL dependency? `Ok(true)` iff at
+/// least one `dep_kinds[].kind` entry is JSON `null` — verified on the real workspace
+/// against `wyrd-server` -> `aws-sdk-s3`, which reports `[{"kind": "dev", "target":
+/// null}]` (Design). `"dev"` and `"build"` are excluded: only a normal edge can ship
+/// inside the binary.
+///
+/// An edge with **no readable `dep_kinds` array** is an `Err`, not a `false`: "we cannot
+/// tell what kind this edge is" and "this edge is dev-only" are different answers, and
+/// silently choosing the second would drop the edge — and everything behind it — out of
+/// the closure the guard claims to have checked.
+fn edge_is_normal(edge: &serde_json::Value) -> Result<bool, String> {
+    let kinds = edge
+        .get("dep_kinds")
+        .and_then(|k| k.as_array())
+        .ok_or_else(|| {
+            "blackbox-guard: a dependency edge has no `dep_kinds` array — refusing to \
+             classify an edge it cannot read"
+                .to_string()
+        })?;
+    Ok(kinds
+        .iter()
+        .any(|k| k.get("kind").is_some_and(|k| k.is_null())))
+}
