+        let after = fx.meta.value(&fx.mark_key(3, 2)).expect("a vacated mark");
+        if mark == reclaiming {
+            assert_eq!(after, mark, "a reclaiming mark is GC's, and left as it is");
+        } else {
+            assert_eq!(
+                decode_orphan_mark(&after).unwrap(),
+                OrphanMark::legacy(NOW),
