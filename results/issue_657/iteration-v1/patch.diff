+/// Key prefix for the **drain ledger**: one `desired:dserver:<id>` record per D server an
+/// operator has marked draining or decommissioning (proposal 0005 §"Declarative management
+/// hook"; the custodian's `desired_state` module reads and writes it).
+///
+/// Defined here, beside [`orphan_key`], for the reason that key is: two sides spell it. The
+/// custodian writes and reads the records, and the multipart part intent
+/// ([`crate::multipart::upload_part`]) `require_absent`s the record of every server it plans a
+/// fragment on (proposal 0016's drain fence, `0016:353`, `:659`). Core cannot depend on the
+/// custodian (ADR-0010), so this is the one home of the spelling and the custodian uses it: a
+/// fence on one spelling and a drain recorded under another would let a staged fragment land on a
+/// server whose drain is already recorded.
+pub const DESIRED_DSERVER_PREFIX: &[u8] = b"desired:dserver:";
+
+/// Key for one D server's drain record: `desired:dserver:<id>`.
+pub fn desired_dserver_key(dserver: DServerId) -> Vec<u8> {
+    format!("desired:dserver:{dserver}").into_bytes()
+}
+
+/// Parse a [`desired_dserver_key`] back into its D-server id, or `None` if `key` is not one.
+pub fn parse_desired_dserver_key(key: &[u8]) -> Option<DServerId> {
+    std::str::from_utf8(key)
+        .ok()?
+        .strip_prefix("desired:dserver:")?
+        .parse()
+        .ok()
+}
