+            }
+            assert_eq!(rig.releases(&attempt), 1, "{comp:?}: released once");
+            assert_eq!(rig.slots_of(&attempt).await, 0);
+            assert!(
+                rig.obligations().await.is_empty(),
+                "{comp:?}: no retire: key"
+            );
+        })
+        .await;
+    }
+}
