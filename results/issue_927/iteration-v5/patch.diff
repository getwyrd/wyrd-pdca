+/// One batch of this attempt whose outcome the store could not report.
+#[derive(Debug)]
+struct Unsure {
+    outcome: CommitUnknownResult,
+    /// The session the batch required.
+    session: Session,
+    /// Whether it may still land: the store said `may_still_commit`, and no read since has found
+    /// one of its preconditions gone for good.
+    may_land: bool,
+}
+
+/// What one phase knows about its own batches whose outcome the store could not report. Every
+/// such batch deletes the attempt's slot at the bytes it last wrote, so a read finding the slot
+/// still there settles every one that can no longer land.
+#[derive(Debug, Default)]
+struct Doubt(Vec<Unsure>);
+
+impl Doubt {
+    fn observe(&mut self, outcome: &CommitUnknownResult, session: &Session) {
+        self.0.push(Unsure {
+            outcome: outcome.clone(),
+            session: session.clone(),
+            may_land: outcome.may_still_commit,
+        });
+    }
+
+    /// A read found the session at `found`: a batch whose required session has moved can never
+    /// land from now on (an epoch only rises), though it may have landed before. A read that is
+    /// damage settles nothing, since repairing it can let the batch land (`judge_session`).
+    fn session_seen(&mut self, found: Option<&Bytes>) {
+        for unsure in &mut self.0 {
+            if matches!(
+                judge_session(found, &unsure.session),
+                Ok(SessionSeen::Open(_) | SessionSeen::Left(_))
+            ) {
+                unsure.may_land = false;
+            }
+        }
+    }
+
+    /// A read found a precondition every batch in doubt carries gone for good.
+    fn cannot_land(&mut self) {
+        for unsure in &mut self.0 {
+            unsure.may_land = false;
+        }
+    }
+
+    /// A read found the slot still at the bytes every batch in doubt deletes: none of them has
+    /// landed, and one that can no longer land never will.
+    fn slot_held(&mut self) {
+        self.0.retain(|unsure| unsure.may_land);
+    }
+
+    fn any(&self) -> bool {
+        !self.0.is_empty()
+    }
+
+    /// Whether a batch in doubt required exactly the session bytes `found`.
+    fn required(&self, found: Option<&Bytes>) -> bool {
+        self.0
+            .iter()
+            .any(|unsure| found == Some(&unsure.session.bytes))
+    }
+
+    fn end(self, upload_id: &UploadId, batch: DoubtfulBatch, cause: Stop) -> CommitError {
+        let keep = self
+            .0
+            .iter()
+            .find(|unsure| unsure.may_land)
+            .or_else(|| self.0.last());
+        match keep {
+            Some(unsure) => CommitError::InDoubt(Box::new(InDoubt {
+                upload_id: upload_id.clone(),
+                batch,
+                may_still_commit: unsure.may_land,
+                outcome: unsure.outcome.clone(),
+                cause,
+            })),
+            None => stopped(upload_id, cause),
+        }
+    }
+}
+
+/// A commit stopped with nothing in doubt and nothing released.
+fn stopped(upload_id: &UploadId, cause: Stop) -> CommitError {
+    CommitError::Stopped {
+        upload_id: upload_id.clone(),
+        cause,
+        slot_released: false,
+    }
+}
+
+fn lossy(key: &[u8]) -> String {
+    String::from_utf8_lossy(key).into_owned()
+}
+
+/// What a read of the attempt's own slot found.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+enum SlotSeen {
+    /// The bytes this attempt last wrote.
+    Held,
+    /// Absent, or another attempt's slot: this attempt's slot is gone.
+    Gone,
+    /// This attempt's id, under bytes it did not last write.
+    Rewritten,
+}
+
+/// Judge a read of the slot. A stored slot that does not decode is an error (ADR-0045), never
+/// "another attempt's".
+fn judge_slot(found: Option<&Bytes>, attempt: &StagedAttempt) -> Result<SlotSeen, RecordError> {
+    let Some(bytes) = found else {
+        return Ok(SlotSeen::Gone);
+    };
+    if bytes == attempt.slot_bytes() {
+        return Ok(SlotSeen::Held);
+    }
+    let record = decode_slot_record(bytes)?;
+    Ok(if record.attempt_id() == attempt.attempt_id() {
+        SlotSeen::Rewritten
+    } else {
+        SlotSeen::Gone
+    })
+}
+
+/// The `mpu:` bytes a batch of this attempt requires, with the epoch they carry: decoded once,
+/// where the bytes enter the commit (the attempt's own, or a newer `Open` record a read found), so
+/// no batch builder decodes them again.
+#[derive(Debug, Clone)]
+struct Session {
+    bytes: Bytes,
+    epoch: u64,
+}
+
+impl Session {
+    fn of(bytes: &Bytes) -> Result<Self, RecordError> {
+        Ok(Self {
+            bytes: bytes.clone(),
+            epoch: decode_session_record(bytes)?.epoch(),
+        })
+    }
+}
+
+/// What a read of the session found, against the session a batch required. The last two say the
+/// session has moved: the batch can never land from then on.
+#[derive(Debug)]
+enum SessionSeen {
+    /// Those bytes.
+    Same,
+    /// An `Open` session record at a higher epoch.
+    Open(Session),
+    /// Not `Open`, or no record: the answer its state gives.
+    Left(Refusal),
+}
+
+/// Judge a read of the session. A stored record that does not decode is an error (ADR-0045), never
+/// a moved session, and so is an `Open` record that differs from `required` at an epoch no rollback
+/// could have reached: an epoch only rises.
+fn judge_session(found: Option<&Bytes>, required: &Session) -> Result<SessionSeen, RecordError> {
+    let Some(bytes) = found else {
+        return Ok(SessionSeen::Left(Refusal::NoSuchUpload));
+    };
+    if *bytes == required.bytes {
+        return Ok(SessionSeen::Same);
+    }
+    let record = decode_session_record(bytes)?;
+    match upload_part_answer(Some(record.state())) {
+        UploadPartAnswer::Accepted => {
+            if record.epoch() > required.epoch {
+                Ok(SessionSeen::Open(Session {
+                    bytes: bytes.clone(),
+                    epoch: record.epoch(),
+                }))
+            } else {
+                Err(RecordError::SessionEpochNotRisen {
+                    found: record.epoch(),
+                    required: required.epoch,
+                })
+            }
+        }
+        UploadPartAnswer::Refused(refusal) => Ok(SessionSeen::Left(refusal)),
+    }
+}
+
+/// The chunks the session's committed parts hold, its own part number's prior excluded (a
+/// re-upload replaces it): the sum over the bounded `psum:<id>:` range of summaries, never the
+/// chunk lists (`0016:352`).
+async fn staged_elsewhere(
+    store: &impl MetadataStore,
+    attempt: &StagedAttempt,
+) -> Result<u64, Stop> {
+    let mut total = 0u64;
+    for (key, value) in store
+        .scan(&psum_range(attempt.upload_id()))
+        .await
+        .map_err(Stop::Store)?
+    {
+        let (_, part_number) = parse_psum_key(&key).map_err(Stop::Record)?;
+        if part_number == attempt.part_number() {
+            continue;
+        }
+        let summary = decode_part_summary(&value).map_err(Stop::Record)?;
+        total = total.saturating_add(u64::from(summary.chunks));
+    }
+    Ok(total)
+}
+
+/// The part commit's batch (`0016:660`).
+fn commit_batch(
+    attempt: &StagedAttempt,
+    session: &Bytes,
+    required: Option<&Bytes>,
+    record: &PartRecord,
+    retire: Option<&RetireObligation>,
+) -> WriteBatch {
+    let upload_id = attempt.upload_id();
+    let part = part_key(upload_id, attempt.part_number());
+    let mut batch = WriteBatch::new().require(mpu_key(upload_id), session.clone());
+    batch = match required {
+        Some(prior) => batch.require(part.clone(), prior.clone()),
+        None => batch.require_absent(part.clone()),
+    };
+    // The bytes this attempt last wrote, from its own state: never re-read from the key.
+    batch = batch.require(attempt.slot_key().to_vec(), attempt.slot_bytes().clone());
+    if let Some(obligation) = retire {
+        batch = batch.require_absent(obligation.key());
+    }
+    batch = batch
+        .put(part, metadata::encode(record))
+        .put(
+            psum_key(upload_id, attempt.part_number()),
+            metadata::encode(&record.summary()),
+        )
+        .delete(attempt.slot_key().to_vec());
+    for owned in attempt.owned() {
+        batch = batch.delete(owned.key().to_vec());
+    }
+    if let Some(obligation) = retire {
+        batch = batch.put(obligation.key(), metadata::encode(obligation.payload()));
+    }
+    batch
+}
+
+/// The live-session compensation's batch (`0016:673`), under `session`.
+fn compensation_batch(
+    attempt: &StagedAttempt,
+    session: &Bytes,
+    obligation: Option<&RetireObligation>,
+) -> WriteBatch {
+    let mut batch = WriteBatch::new()
+        .require(mpu_key(attempt.upload_id()), session.clone())
+        // The bytes this attempt last wrote, from its own state: never re-read from the key.
+        .require(attempt.slot_key().to_vec(), attempt.slot_bytes().clone());
+    if let Some(obligation) = obligation {
+        batch = batch.require_absent(obligation.key());
+    }
+    batch = batch.delete(attempt.slot_key().to_vec());
+    for owned in attempt.owned() {
+        batch = batch.delete(owned.key().to_vec());
+    }
+    if let Some(obligation) = obligation {
+        batch = batch.put(obligation.key(), metadata::encode(obligation.payload()));
+    }
+    batch
+}
+
+/// **Commit a staged part** (`0016:660`, `:1584-1653`, `:1720-1733`), answering in the landed
+/// vocabulary ([`UploadPartOutcome`], [`Refusal`]). The module doc states the batches, the order of
+/// the reads, the classification and the bounds.
+///
+/// * A part whose staging stopped at the per-part chunk bound
+///   ([`StagedAttempt::chunk_bound_exceeded`]) is refused [`Refusal::EntityTooLarge`], its
+///   `chunks` one past the bound (the body was longer; staging did not read the rest) and its
+///   `limit` the bound, and what it staged is compensated.
+/// * Otherwise the quiesce renewal runs ([`DISPATCH_MARGIN_MILLIS`]); a session it finds no longer
+///   `Open` is [`Refusal::NoSuchUpload`], with nothing more written.
+/// * A part that would take the session's committed chunks past `max_staged_chunks`
+///   ([`super::MAX_STAGED_CHUNKS`] at the shipped profile), counted over the `psum:` summaries of
+///   every other part number, is refused [`Refusal::EntityTooLarge`] (`chunks` the total it would
+///   reach, `limit` the ceiling) and compensated.
+/// * Otherwise one commit batch, sent only with [`DISPATCH_MARGIN_MILLIS`] left on the lease:
+///   [`UploadPartOutcome::Committed`] when it lands, or when a re-read proves this attempt's own
+///   commit landed; a lost commit compensates and answers [`Refusal::OperationAborted`] while the
+///   session is `Open`, and [`Refusal::NoSuchUpload`] once it is not.
+/// * A settled stop under a live session compensates and returns its typed error (the module doc's
+///   *A settled stop compensates*).
+///
+/// `clock` must be the clock the attempt was staged on.
+///
+/// **Not cancel-safe once a commit is sent**: dropping the future can leave a batch that lands
+/// with no answer naming it. The slot and every owned entry it could leave are still in reach of
+/// the reaper's per-session ranges.
+pub async fn commit_part(
+    store: &impl MetadataStore,
+    clock: &impl StageClock,
+    mut attempt: StagedAttempt,
+    max_staged_chunks: u32,
+) -> Result<UploadPartOutcome, CommitError> {
+    let upload_id = attempt.upload_id().clone();
+    let stop = |cause| stopped(&upload_id, cause);
+    let damage = |err| stopped(&upload_id, Stop::Record(err));
+    // The attempt's own chunks, as the obligation its compensation would owe, validated once where
+    // the attempt enters the commit; the session it staged under is decoded the same way, once per
+    // path, below. Staging encoded every chunk with its scheme and decoded those bytes, so neither
+    // is refused in any legal history, and no batch builder validates or decodes them again.
+    let own = OwedChunks::validate(attempt.chunks()).map_err(damage)?;
+    if attempt.chunk_bound_exceeded() {
+        let limit = attempt.chunks().len() as u64;
+        let refusal = Refusal::EntityTooLarge {
+            chunks: limit.saturating_add(1),
+            limit,
+        };
+        let session = Session::of(attempt.session_bytes()).map_err(damage)?;
+        return refuse(store, &attempt, own.as_ref(), session, refusal).await;
+    }
+    let renewed = attempt.renew(store, clock, DISPATCH_MARGIN_MILLIS).await;
+    // The renewal adopts a rollback that landed before it (a newer `Open` epoch, `stage.rs`), so
+    // the bytes it left are what every batch from here on requires.
+    let session = Session::of(attempt.session_bytes()).map_err(damage)?;
+    let lease_expiry_millis = match renewed {
+        Ok(RenewOutcome::Covered {
+            lease_expiry_millis,
+            ..
+        }) => lease_expiry_millis,
+        Ok(RenewOutcome::Refused(refusal)) => return Ok(UploadPartOutcome::Refused(refusal)),
+        Err(error) => {
+            return renewal_stopped(store, &attempt, own.as_ref(), session, error).await;
+        }
+    };
+    // The commit's reads, after the last renewal: no renewal is sent from here on.
+    let total = staged_elsewhere(store, &attempt)
+        .await
+        .map_err(stop)?
+        .saturating_add(attempt.chunks().len() as u64);
+    if total > u64::from(max_staged_chunks) {
+        let refusal = Refusal::EntityTooLarge {
+            chunks: total,
+            limit: u64::from(max_staged_chunks),
+        };
+        return refuse(store, &attempt, own.as_ref(), session, refusal).await;
+    }
+    let part = part_key(&upload_id, attempt.part_number());
+    let required = store
+        .get(&part)
+        .await
+        .map_err(|fault| stop(Stop::Store(fault)))?;
+    let prior = required
+        .as_deref()
+        .map(decode_part_record)
+        .transpose()
+        .map_err(damage)?;
+    // `committed_at_millis` is stamped once, by the clock that owns the attempt's leases, so every
+    // retry of the commit puts the same bytes.
+    let record = PartRecord::commit(
+        attempt.chunks().to_vec(),
+        *attempt.digest(),
+        clock.now_millis(),
+        session.epoch,
+    )
+    .map_err(damage)?;
+    // The prior part's chunks, owed by a re-upload (none for an empty prior).
+    let retire = match &prior {
+        Some(prior) => OwedChunks::validate(prior.chunks())
+            .map_err(damage)?
+            .map(|owed| {
+                RetireObligation::part_chunks(
+                    &upload_id,
+                    session.epoch,
+                    attempt.part_number(),
+                    attempt.attempt_id(),
+                    &owed,
+                )
+            }),
+        None => None,
+    };
+    let batch = commit_batch(
+        &attempt,
+        &session.bytes,
+        required.as_ref(),
+        &record,
+        retire.as_ref(),
+    );
+    let committed = UploadPartOutcome::Committed {
+        part_number: attempt.part_number(),
+        digest: *attempt.digest(),
+    };
+    let session_key = mpu_key(&upload_id);
+    let read = |key: &[u8]| {
+        let key = key.to_vec();
+        async move { store.get(&key).await }
+    };
+    let mut doubt = Doubt::default();
+    let mut rounds = 0u32;
+    // `false` for the one lap that only reads: the last read found the session moved, so no commit
+    // can land and the slot must be read again before the commit is settled.
+    let mut send = true;
+    loop {
+        if send {
+            // Each round's own reading: the reads and the retries before it spent from the lease.
+            let now_millis = clock.now_millis();
+            let halt = if rounds == COMMIT_ROUNDS {
+                Some(Stop::CommitRoundsSpent { rounds })
+            } else if lease_expiry_millis.saturating_sub(now_millis) < DISPATCH_MARGIN_MILLIS {
+                Some(Stop::LeaseShort {
+                    lease_expiry_millis,
+                    now_millis,
+                })
+            } else {
+                None
+            };
+            if let Some(cause) = halt {
+                if doubt.any() {
+                    return Err(doubt.end(&upload_id, DoubtfulBatch::Commit, cause));
+                }
+                return commit_stopped(store, &attempt, own.as_ref(), session, cause).await;
+            }
+            rounds += 1;
+            match store.commit(batch.clone()).await {
+                Ok(CommitOutcome::Committed) => return Ok(committed),
+                Ok(CommitOutcome::Conflict) => {}
+                Err(fault) => match fault.downcast_ref::<CommitUnknownResult>() {
+                    Some(unknown) => doubt.observe(unknown, &session),
+                    // A definite failure of this batch; an earlier batch's doubt still stands.
+                    None => {
+                        return Err(doubt.end(
+                            &upload_id,
+                            DoubtfulBatch::Commit,
+                            Stop::Store(fault),
+                        ))
+                    }
+                },
+            }
+        }
+        // Each read is its own transaction, so each is judged at the instant it was taken. Every
+        // read below is processed in order, and the order is the module doc's.
+        let fault =
+            |doubt: Doubt, fault| doubt.end(&upload_id, DoubtfulBatch::Commit, Stop::Store(fault));
+        let torn =
+            |doubt: Doubt, err| doubt.end(&upload_id, DoubtfulBatch::Commit, Stop::Record(err));
+        let part_now = match read(&part).await {
+            Ok(found) => found,
+            Err(err) => return Err(fault(doubt, err)),
+        };
+        // A moved part key is another writer's record or damage. Only a record that decodes is
+        // another writer's (ADR-0045): damage settles no commit and answers no classification, and
+        // it stops the attempt below, once the own-commit proof has been tried.
+        let mut damaged = None;
+        if part_now != required {
+            match part_now.as_deref().map(decode_part_record).transpose() {
+                // A key the commit required absent now holds a record. A `part:` record is removed
+                // only after the session leaves `Open`, so no commit requiring it absent can land
+                // from here on.
+                Ok(Some(_)) if required.is_none() => doubt.cannot_land(),
+                // Over a prior, a changed record settles nothing, a rival's or a repair's: the
+                // prior's bytes can come back (the module doc's *Settled, not landed*). A prior
+                // that has gone settles nothing either; the arm below judges it by the session.
+                Ok(_) => {}
+                Err(err) => damaged = Some(err),
+            }
+        }
+        let first = match read(&session_key).await {
+            Ok(found) => found,
+            Err(err) => return Err(fault(doubt, err)),
+        };
+        doubt.session_seen(first.as_ref());
+        let slot_found = match read(attempt.slot_key()).await {
+            Ok(found) => found,
+            Err(err) => return Err(fault(doubt, err)),
+        };
+        let slot = match judge_slot(slot_found.as_ref(), &attempt) {
+            Ok(slot) => slot,
+            Err(err) => return Err(torn(doubt, err)),
+        };
+        if slot == SlotSeen::Held {
+            // Only here does a commit in doubt leave the doubt, and only one a read *before* this
+            // one found unable to land. What the session read below finds comes too late.
+            doubt.slot_held();
+        }
+        let last_found = match read(&session_key).await {
+            Ok(found) => found,
+            Err(err) => return Err(fault(doubt, err)),
+        };
+        doubt.session_seen(last_found.as_ref());
+        let last = match judge_session(last_found.as_ref(), &session) {
+            Ok(last) => last,
+            Err(err) => return Err(torn(doubt, err)),
+        };
+        match slot {
+            SlotSeen::Gone => {
+                if matches!(last, SessionSeen::Same) {
+                    // The own-commit proof, checked before anything the part key holds: the slot
+                    // is gone and the session read after it is still `Open@E`. Only this
+                    // attempt's commit removes the slot while the session is `Open@E` and no
+                    // compensation has been sent.
+                    if doubt.any() {
+                        return Ok(committed);
+                    }
+                    return Err(stop(Stop::SlotLost {
+                        key: lossy(attempt.slot_key()),
+                    }));
+                }
+                if doubt.any() {
+                    return Err(doubt.end(&upload_id, DoubtfulBatch::Commit, Stop::SessionMoved));
+                }
+                return match last {
+                    // A teardown took the slot; nothing of this attempt landed.
+                    SessionSeen::Left(refusal) => Ok(UploadPartOutcome::Refused(refusal)),
+                    SessionSeen::Same | SessionSeen::Open(_) => Err(stop(Stop::SlotLost {
+                        key: lossy(attempt.slot_key()),
+                    })),
+                };
+            }
+            SlotSeen::Rewritten => {
+                return Err(doubt.end(
+                    &upload_id,
+                    DoubtfulBatch::Commit,
+                    Stop::SlotLost {
+                        key: lossy(attempt.slot_key()),
+                    },
+                ))
+            }
+            SlotSeen::Held => {
+                if let Some(err) = damaged {
+                    return Err(torn(doubt, err));
+                }
+                // A `part:` record is removed only after the session leaves `Open`, so under the
+                // same session a prior that has gone is damage, not a rival. Under a session that
+                // moved, the row for that session answers.
+                if required.is_some() && part_now.is_none() && matches!(last, SessionSeen::Same) {
+                    let err = RecordError::PartRecordMissing {
+                        part_number: attempt.part_number().get(),
+                    };
+                    return Err(torn(doubt, err));
+                }
+                if doubt.any() {
+                    // A commit of this attempt may still land: never compensate while it may. With
+                    // the session unchanged, retry the same batch, which requires the same slot
+                    // bytes, so at most one of them lands. With the session moved no commit can
+                    // land, but this read of the slot came before that read of the session, so
+                    // the commit may have landed between them: read the slot again, once.
+                    send = matches!(last, SessionSeen::Same) || !send;
+                    continue;
+                }
+                send = true;
+                match last {
+                    SessionSeen::Same if part_now == required => {
+                        // Nothing a read can see explains the conflict.
+                    }
+                    // A same-number rival won, or a repair rewrote the prior: the retryable
+                    // refusal either way, with no retry here against the new record.
+                    SessionSeen::Same => {
+                        let refusal = Refusal::OperationAborted;
+                        return refuse(store, &attempt, own.as_ref(), session, refusal).await;
+                    }
+                    // A Complete fenced and rolled the session back: the reaper does not walk an
+                    // `Open` session, so this attempt compensates under the newer epoch.
+                    SessionSeen::Open(newer) => {
+                        let refusal = Refusal::OperationAborted;
+                        return refuse(store, &attempt, own.as_ref(), newer, refusal).await;
+                    }
+                    // Not `Open` any more: the residue is the reaper's.
+                    SessionSeen::Left(refusal) => return Ok(UploadPartOutcome::Refused(refusal)),
+                }
+            }
+        }
+    }
+}
+
+/// Whether a stopped quiesce renewal leaves the attempt to compensate (the module doc's *A settled
+/// stop compensates*): only a stop with nothing in doubt, whose records the attempt can still show
+/// are its own, under a store that is answering.
+const fn compensates_after(error: &StageError) -> bool {
+    matches!(
+        error,
+        StageError::Stopped {
+            cause: StageStop::CoverShort { .. }
+                | StageStop::RenewalRoundsSpent { .. }
+                | StageStop::LeaseLapsed { .. }
+                | StageStop::InvalidRequest { .. },
+            ..
+        }
+    )
+}
+
+/// The quiesce renewal stopped with `error`: compensate if it says to, under `session` (the bytes
+/// the renewal left), and return `error` either way, reporting whether the slot was released. A
+/// session found fenced meanwhile answers its refusal instead.
+async fn renewal_stopped(
+    store: &impl MetadataStore,
+    attempt: &StagedAttempt,
+    own: Option<&OwedChunks>,
+    session: Session,
+    error: StageError,
+) -> Result<UploadPartOutcome, CommitError> {
+    if !compensates_after(&error) {
+        return Err(CommitError::Renewal {
+            error,
+            slot_released: false,
+        });
+    }
+    match compensate(store, attempt, own, session).await? {
+        Compensated::Released => Err(CommitError::Renewal {
+            error,
+            slot_released: true,
+        }),
+        Compensated::Left(refusal) => Ok(UploadPartOutcome::Refused(refusal)),
+    }
+}
+
+/// The commit stopped for `cause` with nothing in doubt: compensate under `session` and return
+/// `cause`, reporting the slot released. A session found fenced meanwhile answers its refusal
+/// instead.
+async fn commit_stopped(
+    store: &impl MetadataStore,
+    attempt: &StagedAttempt,
+    own: Option<&OwedChunks>,
+    session: Session,
+    cause: Stop,
+) -> Result<UploadPartOutcome, CommitError> {
+    match compensate(store, attempt, own, session).await? {
+        Compensated::Released => Err(CommitError::Stopped {
+            upload_id: attempt.upload_id().clone(),
+            cause,
+            slot_released: true,
+        }),
+        Compensated::Left(refusal) => Ok(UploadPartOutcome::Refused(refusal)),
+    }
+}
+
+/// Refuse the part with `refusal`, once what it staged is compensated under `session`. A session
+/// found fenced meanwhile answers its own refusal instead.
+async fn refuse(
+    store: &impl MetadataStore,
+    attempt: &StagedAttempt,
+    own: Option<&OwedChunks>,
+    session: Session,
+    refusal: Refusal,
+) -> Result<UploadPartOutcome, CommitError> {
+    Ok(UploadPartOutcome::Refused(
+        match compensate(store, attempt, own, session).await? {
+            Compensated::Released => refusal,
+            Compensated::Left(left) => left,
+        },
+    ))
+}
+
+/// What a compensation that ended cleanly came to.
+#[derive(Debug)]
+enum Compensated {
+    /// It landed: the slot is released, the owned entries deleted, the chunks owed.
+    Released,
+    /// The session has left `Open` and no round of it landed, nor can: the answer the state
+    /// gives. Nothing more is written; the residue is the reaper's.
+    Left(Refusal),
+}
+
+/// **The live-session compensation** (`0016:673`, `:1607-1620`): release the slot, delete the
+/// owned entries, and for a non-empty part install one `{chunks}` obligation naming `own`, under
+/// `session`. Called only once the commit is settled as not landed and unable to land later, so
+/// the slot it releases can only be released by one of its own rounds. The clock plays no part.
+async fn compensate(
+    store: &impl MetadataStore,
+    attempt: &StagedAttempt,
+    own: Option<&OwedChunks>,
+    mut session: Session,
+) -> Result<Compensated, CommitError> {
+    let upload_id = attempt.upload_id();
+    let session_key = mpu_key(upload_id);
+    let mut doubt = Doubt::default();
+    // Every obligation a round of this compensation sent: its key and the bytes it puts.
+    let mut sent: Vec<(Vec<u8>, Bytes)> = Vec::new();
+    let mut rounds = 0u32;
+    // `false` for the one lap that only reads, as in `commit_part`.
+    let mut send = true;
+    loop {
+        let end = |doubt: Doubt, cause| doubt.end(upload_id, DoubtfulBatch::Compensation, cause);
+        if send {
+            if rounds == COMPENSATION_ROUNDS {
+                return Err(end(doubt, Stop::CompensationRoundsSpent { rounds }));
+            }
+            rounds += 1;
+            // The attempt's own chunks under the epoch this round requires; none for an empty part.
+            let obligation = own.map(|owed| {
+                RetireObligation::part_chunks(
+                    upload_id,
+                    session.epoch,
+                    attempt.part_number(),
+                    attempt.attempt_id(),
+                    owed,
+                )
+            });
+            if let Some(obligation) = &obligation {
+                let put = (obligation.key(), metadata::encode(obligation.payload()));
+                if !sent.contains(&put) {
+                    sent.push(put);
+                }
+            }
+            match store
+                .commit(compensation_batch(
+                    attempt,
+                    &session.bytes,
+                    obligation.as_ref(),
+                ))
+                .await
+            {
+                Ok(CommitOutcome::Committed) => return Ok(Compensated::Released),
+                Ok(CommitOutcome::Conflict) => {}
+                Err(fault) => match fault.downcast_ref::<CommitUnknownResult>() {
+                    Some(unknown) => doubt.observe(unknown, &session),
+                    None => return Err(end(doubt, Stop::Store(fault))),
+                },
+            }
+        }
+        for (key, bytes) in &sent {
+            match store.get(key).await {
+                Ok(Some(found)) if found == *bytes => return Ok(Compensated::Released),
+                Ok(Some(_)) => {
+                    return Err(end(doubt, Stop::ObligationKeyTaken { key: lossy(key) }))
+                }
+                Ok(None) => {}
+                Err(fault) => return Err(end(doubt, Stop::Store(fault))),
+            }
+        }
+        let slot = match store.get(attempt.slot_key()).await {
+            Ok(found) => match judge_slot(found.as_ref(), attempt) {
+                Ok(slot) => slot,
+                Err(err) => return Err(end(doubt, Stop::Record(err))),
+            },
+            Err(fault) => return Err(end(doubt, Stop::Store(fault))),
+        };
+        if slot == SlotSeen::Held {
+            doubt.slot_held();
+        }
+        let found = match store.get(&session_key).await {
+            Ok(found) => found,
+            Err(fault) => return Err(end(doubt, Stop::Store(fault))),
+        };
+        doubt.session_seen(found.as_ref());
+        let now = match judge_session(found.as_ref(), &session) {
+            Ok(now) => now,
+            Err(err) => return Err(end(doubt, Stop::Record(err))),
+        };
+        match slot {
+            SlotSeen::Gone => {
+                // The slot gone, and the session read after it still the bytes a doubtful round
+                // required: no commit of this attempt is outstanding, so that round landed.
+                if doubt.required(found.as_ref()) {
+                    return Ok(Compensated::Released);
+                }
+                if doubt.any() {
+                    return Err(end(doubt, Stop::SessionMoved));
+                }
+                return match now {
+                    SessionSeen::Left(left) => Ok(Compensated::Left(left)),
+                    SessionSeen::Same | SessionSeen::Open(_) => Err(stopped(
+                        upload_id,
+                        Stop::SlotLost {
+                            key: lossy(attempt.slot_key()),
+                        },
+                    )),
+                };
+            }
+            SlotSeen::Rewritten => {
+                return Err(end(
+                    doubt,
+                    Stop::SlotLost {
+                        key: lossy(attempt.slot_key()),
+                    },
+                ))
+            }
+            SlotSeen::Held => match now {
+                // Retry; a round still in flight requires the same slot bytes, so at most one
+                // lands.
+                SessionSeen::Same => send = true,
+                // The epoch chase: compensate again under the newer `Open` epoch.
+                SessionSeen::Open(newer) => {
+                    session = newer;
+                    send = true;
+                }
+                SessionSeen::Left(left) => {
+                    // No round can land now, but this read of the slot came before that read of
+                    // the session, so one may have landed between them: read the slot again, once.
+                    // This read marked every round unable to land, so if that lap finds the slot
+                    // held, its read empties the doubt and it ends here with nothing in doubt.
+                    if send && doubt.any() {
+                        send = false;
+                    } else {
+                        return Ok(Compensated::Left(left));
+                    }
+                }
+            },
+        }
+    }
+}
+
+/// **`UploadPart`, whole** (#657): reserve a slot, stage the body ([`stage_part`]), then commit
+/// it ([`commit_part`]), on one runtime whose clock owns the attempt's leases. A staging refusal
+/// is answered as it is; a staging error is [`UploadPartError::Stage`] and no commit is
+/// attempted. `max_staged_chunks` is the cumulative ceiling [`commit_part`] checks.
+///
+/// No production path calls this yet (the S3 verb is #669).
+pub async fn upload_part<B>(
+    store: &impl MetadataStore,
+    chunk_store: &impl PlacementChunkStore,
+    runtime: &mut impl StageRuntime,
+    request: &StageRequest<'_>,
+    max_staged_chunks: u32,
+    body: B,
+) -> Result<UploadPartOutcome, UploadPartError>
+where
+    B: Stream<Item = wyrd_traits::Result<Bytes>> + Unpin,
+{
+    match stage_part(store, chunk_store, runtime, request, body).await {
+        Ok(StageOutcome::Staged(attempt)) => {
+            commit_part(store, &*runtime, *attempt, max_staged_chunks)
+                .await
+                .map_err(UploadPartError::Commit)
+        }
+        Ok(StageOutcome::Refused(refusal)) => Ok(UploadPartOutcome::Refused(refusal)),
+        Err(err) => Err(UploadPartError::Stage(err)),
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::multipart::UploadId;
+
+    fn stopped_by(cause: StageStop) -> StageError {
+        StageError::Stopped {
+            upload_id: UploadId::new("0".repeat(32)).unwrap(),
+            cause,
+        }
+    }
+
+    /// The table in the module doc, read row by row. `EntryLost` has its own row here because
+    /// `StagedAttempt::renew` cannot produce it (only a chunk's intent does, `stage.rs`), so no
+    /// store history can drive that row through the renewal; the crate's test file drives the
+    /// others.
+    #[test]
+    fn a_stopped_renewal_compensates_only_on_the_rows_that_say_so() {
+        let key = || "k".to_owned();
+        for (cause, compensates) in [
+            (
+                StageStop::CoverShort {
+                    rounds: 1,
+                    cover_millis: 1,
+                    lease_expiry_millis: 1,
+                    checked_at_millis: 1,
+                },
+                true,
+            ),
+            (StageStop::RenewalRoundsSpent { rounds: 1 }, true),
+            (
+                StageStop::LeaseLapsed {
+                    key: key(),
+                    lease_expiry_millis: 1,
+                    now_millis: 1,
+                },
+                true,
+            ),
+            (StageStop::InvalidRequest { reason: "r" }, true),
+            (StageStop::SlotLost { key: key() }, false),
+            (StageStop::EntryLost { key: key() }, false),
+            (StageStop::Store("fault".into()), false),
+        ] {
+            let error = stopped_by(cause);
+            assert_eq!(compensates_after(&error), compensates, "{error}");
+        }
+    }
+}
