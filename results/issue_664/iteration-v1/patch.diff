+/// landing span, asserting the full invariant set at every point, and then asserts that each of the
+/// three actually occurred: the pass fencing first, the racer landing strictly between the pass's
+/// session read and its own commit (the compare-and-set loss), and the racer landing before the
+/// pass read the session at all. Without it a span that drifted to one side would leave the
+/// campaign green with only part of the race behind it.
+async fn prop_restore_fence_reaches_both_sides_of_the_race() {
+    let mut pass_fenced = false;
+    let mut lost_the_cas = false;
+    let mut already_fenced = false;
+    for delay in 0..=u64::from(FENCE_RACE_SPAN) {
+        let race = restore_fence_under_a_racing_fencer(delay).await;
+        pass_fenced |= race.pass_fenced;
+        lost_the_cas |= race.lost_the_cas;
+        already_fenced |= race.already_fenced;
+    }
