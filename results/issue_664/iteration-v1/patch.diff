+// ---- property 11b: the post-restore FENCE under a racing fencer (#664) ----
+//
+// A restore resurrects `Open` and `Completing` multipart sessions whose staged bytes are gone, and
+// the post-restore pass fences each of them — moving it to `Aborting` at the next epoch and
+// installing its retirement obligations in the SAME commit (D-B, `0016:717-728`; X57 `0016:880`).
+// That is a new WRITE path, and it is the one place in this pass where another actor can be doing
+// the same thing at the same time: a client `AbortMultipartUpload` (#656) fences from exactly the
+// same prior state, under exactly the same token.
+//
+// The per-pass legs in `crates/custodian/tests/staged_drain_restore.rs` pin the fence's shape over
+// doubles that never yield. Here a genuinely concurrent task fences the same session at an instant
+// the run seed picks, over a store whose every read and commit spans a simulated network hop, and
+// what is asserted is what must hold on EVERY schedule:
+//
+//  * the session ends fenced — whoever won — so no schedule leaves it publishable;
+//  * exactly ONE obligation exists under the fenced epoch's token, and it decodes against the key
+//    it sits under, so `require_absent` did its work and neither writer overwrote the other's
+//    payload (`0016:369-373`, outcome (a): a lost payload is data with no deleter);
+//  * the pass's report and the durable fence generation agree — the generation is complete iff the
+//    run needs no human — and a run that needed one completes on a re-run over the settled store,
+//    so the withholding is a withholding rather than a pass that can never certify.
+
+/// The upload the restore resurrects: 32 lowercase-hex characters.
+const FENCE_UPLOAD: &str = "66406640664066406640664066406640";
+/// The object it targets, and the epoch it comes back at.
+const FENCE_OBJECT: &str = "fenced";
+const FENCE_EPOCH: u64 = 1;
+/// An unreferenced fragment on server 2: the pass marks it, which is the positive observable that
+/// the pass ran at all in a schedule where it fenced nothing.
+const FENCE_STRAY: ChunkId = 0x6640;
+/// How far into the run the racing fencer may land, in simulated milliseconds — the same shape as
+/// [`RESTORE_NEMESIS_SPAN`].
+///
+/// Twenty, because the pass reaches its fence commit around 11 ms into the run over this model
+/// (one simulated hop per store read), so the span holds all three schedules with margin on each
+/// side: the racer landing before the pass's session read, strictly between that read and the
+/// fence commit, and after it. The margin is not load-bearing — if a later change moves the
+/// crossing point out of the span, `prop_restore_fence_reaches_both_sides_of_the_race` fails
+/// loudly rather than leaving the campaign green over one regime.
+const FENCE_RACE_SPAN: u32 = 20;
+
+/// A session record for [`FENCE_UPLOAD`] in `state` (its JSON) at `epoch`, spelled as the codec
+/// spells it and checked against it.
+fn fence_session(epoch: u64, state: &str) -> Bytes {
+    let bytes = format!(
+        "{{\"parent\":{ROOT},\"object\":\"{FENCE_OBJECT}\",\"created_at_millis\":100,\
+         \"clock_source\":\"wall\",\"epoch\":{epoch},\"attempts\":1,\"state\":{state}}}"
+    )
+    .into_bytes();
+    decode_session_record(&bytes).expect("the seeded session record decodes");
+    Bytes::from(bytes)
+}
+
+/// Which of the three schedules one run actually landed in — observed at the store and in the
+/// report, never assumed from the delay.
+struct FenceRace {
+    /// The pass fenced the session itself; the racer's commit lost the compare-and-set.
+    pass_fenced: bool,
+    /// The pass read the session as `Open`, the racer fenced it in between, and the pass's own
+    /// commit lost — the window this property exists for.
+    lost_the_cas: bool,
+    /// The racer landed before the pass even read the session, which then found it already
+    /// `Aborting` and had nothing to do.
+    already_fenced: bool,
+}
+
+/// One run of the post-restore pass against a racing fencer landing `delay_millis` into it.
+async fn restore_fence_under_a_racing_fencer(delay_millis: u64) -> FenceRace {
+    let d = servers();
+    let meta = Arc::new(SimTikvMetadataStore::new());
+    let now = 10_000;
+    let upload = UploadId::new(FENCE_UPLOAD).expect("32 lowercase-hex characters");
+    let stray = frag_of(FENCE_STRAY);
+    d[2].put_fragment(stray, Bytes::from_static(b"stray"), None)
+        .await
+        .unwrap();
+
+    // The restored image: an `Open` session that had finished before the backup point, whose
+    // staged bytes are gone. Nothing but a fence stops a client completing over them.
+    let open = fence_session(FENCE_EPOCH, "{\"kind\":\"Open\"}");
+    assert_eq!(
+        meta.commit(WriteBatch::new().put(mpu_key(&upload), open.clone()))
+            .await
+            .unwrap(),
+        CommitOutcome::Committed
+    );
+
+    // The racing fencer — a client `AbortMultipartUpload` (#656) — spelled the way that slice
+    // will, NOT through the pass's own writer: the point is that two independent writers of the
+    // same protocol row cannot both land, and reusing the pass's helper would prove only that the
+    // helper agrees with itself.
+    let aborting = fence_session(FENCE_EPOCH + 1, "{\"kind\":\"Aborting\"}");
+    let token = RetireToken::Session {
+        upload_id: upload.clone(),
+        epoch: FENCE_EPOCH,
+        part: None,
+    };
