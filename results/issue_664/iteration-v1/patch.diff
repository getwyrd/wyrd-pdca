+            encode_retire_obligation(RetireMode::Bytes, &token, &teardown).expect("the teardown");
+        assert_eq!(key, retire_key(RetireMode::Bytes, &token));
+        let (mode, decoded_token, payload) =
+            decode_retire_obligation(&key, &value).expect("its own decode accepts it");
+        assert_eq!((mode, decoded_token), (RetireMode::Bytes, token.clone()));
+        assert!(payload.session() && matches!(payload.parts(), Some(PartScope::All)));
+
+        let segments = RetirePayload::rolled_back_segments(group.clone());
+        let (key, value) = encode_retire_obligation(RetireMode::Records, &token, &segments)
+            .expect("the segment rollback");
+        let (_, _, payload) =
+            decode_retire_obligation(&key, &value).expect("its own decode accepts it");
+        assert_eq!(payload.segments(), Some(&group));
