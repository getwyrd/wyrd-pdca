+    assert_eq!(
+        (fenced.state(), fenced.epoch()),
+        (&SessionState::Aborting {}, FENCE_EPOCH + 1),
+        "the resurrected session is still publishable after the pass (racer landing at \
+         {delay_millis} ms, racer won: {racer_won}): {report:?}"
+    );
+
+    // (2) EXACTLY ONE OBLIGATION FOR THE FENCED EPOCH, AND IT DECODES. Two writers of one row must
+    //     not both land: the second would overwrite the first's payload under one key, and the
+    //     bytes the lost payload named would have no deleter at all (`0016:369-373`).
+    let installed = meta
+        .scan(&retire_session_range(RetireMode::Bytes, &upload))
+        .await
+        .unwrap();
+    assert_eq!(
+        installed.len(),
+        1,
+        "the fenced session owes {} session-scoped byte obligations (racer landing at \
+         {delay_millis} ms): {installed:?}",
+        installed.len()
+    );
+    let (key, value) = &installed[0];
+    assert_eq!(key, &obligation_key);
