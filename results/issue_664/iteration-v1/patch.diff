+/// What the restore fence did over the sessions a restored image resurrected.
+struct Fenced {
+    /// How many were moved to `Aborting` with their obligations installed.
+    fenced: usize,
+    /// Those it could not fence at all, by `mpu:` key ([`RestoreReport::sessions_unfenceable`]).
+    unfenceable: Vec<String>,
+    /// Those it fenced over a teardown it could not show to be complete
+    /// ([`RestoreReport::sessions_fenced_with_residue`]).
+    with_residue: Vec<String>,
+}
+
+/// One resurrected session's fence plan: the obligations its batch will install, and why the
+/// pass could not show them to name every record the attempt wrote, when it could not.
+struct FencePlan {
+    /// The `retire:bytes:s:<id>:<E>` teardown — the session's own staged residue, plus the
+    /// parts it owes (`0016:664-665`).
+    bytes: RetirePayload,
+    /// The `retire:records:s:<id>:<E>` segment rollback, for a `Completing` attempt whose
+    /// `seg:` records need a deleter (`0016:663`, `:665`, X57 `0016:880`).
+    records: Option<RetirePayload>,
+    /// Why the teardown cannot be shown to cover every record the attempt wrote (X57), if it
+    /// cannot — the operator's own sentence, not a flag.
+    residue: Option<String>,
+}
+
+/// **Fence every session the restored image resurrected** (D-B, `0016:717-728`; decision 1.4).
+///
+/// A restore rewinds the `mpu:` namespace with everything else, so an `Open` or `Completing`
+/// session that had already finished is back — and its staged bytes generally are not. Nothing
+/// else stops a client from completing over them: the Complete fence preconditions on `Open@E`
+/// (`0016:660`) and would find exactly that. So each such session is moved to `Aborting` at the
+/// next epoch, and — **in the same batch** — its retirement obligations are installed, because a
+/// session that can no longer publish and whose records have no deleter is the other half of the
+/// same defect (X57, `0016:880`; the #637 v1 finding).
+///
+/// `Aborting` and `Completed` sessions are left alone: neither can publish over restored bytes
+/// (one is already fenced, the other has already published), and re-fencing an `Aborting`
+/// session would install a second obligation under a second epoch for the same records.
+///
+/// **Bounded reads, never a namespace scan** (`0016:890`): the `mpu:` listing is paged through
+/// [`staged_page`], and each `Completing` session's own `part:<id>:` and `seg:<nonce>:<E>:`
+/// ranges through [`walk_staged_range`] — the same bound and the same range-naming failure the
+/// staged class reads under, so no read here grows with the fleet's upload population beyond the
+/// session count admission bounds.
+///
+/// A **store fault** fails the pass; one session's own damage does not. A record that will not
+/// decode, a fence batch that loses its CAS, and a teardown that cannot be minted are each
+/// contained to that session, named, and carried into
+/// [`RestoreReport::sessions_unfenceable`] — the containment this pass applies to an unreadable
+/// committed object, for the same reason (#651: a store with one damaged record must still get
+/// its whole post-restore picture).
+async fn fence_resurrected_sessions(meta: &dyn MetadataStore) -> Result<Fenced> {
+    let mut fenced = Fenced {
+        fenced: 0,
+        unfenceable: Vec::new(),
+        with_residue: Vec::new(),
+    };
+    let mut after: Option<Vec<u8>> = None;
+    loop {
+        let (sessions, next) = staged_page(meta, multipart::MPU_PREFIX, after.as_deref()).await?;
+        for (key, value) in &sessions {
+            fence_one_session(meta, key, value, &mut fenced).await?;
+        }
+        match (next, sessions.into_iter().last()) {
+            (Some(_), Some((last, _))) => after = Some(last),
+            _ => return Ok(fenced),
+        }
+    }
+}
+
+/// Fence one listed session, or name why it could not be fenced.
+async fn fence_one_session(
+    meta: &dyn MetadataStore,
+    key: &[u8],
+    value: &[u8],
+    fenced: &mut Fenced,
+) -> Result<()> {
+    // A session key naming no upload id names no bounded range either, so there is nothing to
+    // enumerate for it and no token to install an obligation under. It is already reported —
+    // the staged read named it in `RestoreReport::unresolvable`, where it withholds every mark
+    // in the fleet and needs a human — so naming it a second time here would report one damaged
+    // record as two.
+    let Ok(upload) = multipart::parse_mpu_key(key) else {
+        return Ok(());
+    };
+    let name = object_name(key);
+    let record = match multipart::decode_session_record(value) {
+        Ok(record) => record,
+        // LEFT BYTE-IDENTICAL (ADR-0045): a record this codec refuses is a record to repair,
+        // never one to rewrite from a guess about what it meant. The pre-nonce `Completing`
+        // shape lands here, and so would any future format this build does not know.
+        Err(fault) => {
+            unfenceable(fenced, name, &fault.to_string());
+            return Ok(());
+        }
+    };
+    let plan = match record.state() {
+        // The `Open` teardown row: `{session, all}` (`0016:2187`). `all` is the instruction to
+        // enumerate the session's own `part:<id>:` range AT DRAIN TIME, and it is legal
+        // precisely because this fence is what freezes that range — so no part committed in the
+        // read-then-fence window can be missing from it, which a list frozen here could be.
+        SessionState::Open {} => FencePlan {
+            bytes: RetirePayload::teardown(Some(PartScope::All)),
+            records: None,
+            residue: None,
+        },
+        // The `Completing`→`Aborting` row: `{session, parts: <set>}` plus `{seg}`
+        // (`0016:665`, `:823`, `:2193`). Its parts are named EXPLICITLY, because the attempt's
+        // `seg:` records have to be checked against them (X57) and an enumerate-later wildcard
+        // is not legal under `retire:records:` at all (`0016:919-921`).
+        SessionState::Completing {
+            publish_target,
+            segments_written,
+            ..
+        } => completing_plan(meta, &upload, publish_target, *segments_written).await?,
+        // Already fenced, or already published: neither can publish over restored bytes.
+        SessionState::Aborting {} | SessionState::Completed { .. } => return Ok(()),
+    };
+
+    // ONE BATCH: the session stops being publishable and its records gain a deleter together,
+    // or neither happens. A fence that landed without its obligations would leave exactly the
+    // residue X57 names, and one that installed obligations without the fence would name a range
+    // a live session can still add to.
+    //
+    // The session CAS is on its **exact current bytes** (`0016:555-558`), and each obligation on
+    // `require_absent` of its own key (`0016:369-373`) — so a racing writer, a second custodian,
+    // or an obligation this epoch already owes loses here rather than overwriting one
+    // obligation's payload with another's.
+    let token = RetireToken::Session {
+        upload_id: upload,
+        epoch: record.epoch(),
+        part: None,
+    };
+    let batch = match fence_batch(key, value, &record, &token, &plan) {
+        Ok(batch) => batch,
+        Err(fault) => {
+            unfenceable(fenced, name, &fault.to_string());
+            return Ok(());
+        }
+    };
+    match meta.commit(batch).await? {
+        CommitOutcome::Committed => {
+            fenced.fenced += 1;
+            emit_fenced(&name, record.epoch(), plan.records.is_some());
+            if let Some(why) = plan.residue {
+                emit_fence_residue(&name, &why);
+                fenced.with_residue.push(name);
+            }
+            Ok(())
+        }
+        CommitOutcome::Conflict => {
+            unfenceable(
+                fenced,
+                name,
+                "the fence's compare-and-set lost: the session record changed under the pass, or \
+                 an obligation for this epoch already exists",
+            );
+            Ok(())
+        }
+    }
+}
+
+/// Build the one batch that fences `record` and installs its obligations.
+///
+/// Split out so every way of failing to MINT it — an epoch that cannot be bumped, a payload its
+/// own decode would refuse — is contained by one caller rather than by each arm. Every
+/// obligation goes through [`multipart::encode_retire_obligation`], which reads the value it
+/// just encoded back through `decode_retire_obligation` against the key it would sit under: a
+/// writer here can therefore never make durable an obligation the drain (#659) would refuse,
+/// which is the one way a fenced session's bytes could end up with a deleter that does not work.
+fn fence_batch(
+    key: &[u8],
+    current: &[u8],
+    record: &multipart::SessionRecord,
+    token: &RetireToken,
+    plan: &FencePlan,
+) -> std::result::Result<WriteBatch, multipart::RecordError> {
+    let (bytes_key, bytes_value) =
+        multipart::encode_retire_obligation(RetireMode::Bytes, token, &plan.bytes)?;
+    let mut batch = WriteBatch::new()
+        .require(key.to_vec(), current.to_vec())
+        .put(key.to_vec(), metadata::encode(&record.fenced_aborting()?))
+        .require_absent(bytes_key.clone())
+        .put(bytes_key, bytes_value);
+    if let Some(records) = &plan.records {
+        let (records_key, records_value) =
+            multipart::encode_retire_obligation(RetireMode::Records, token, records)?;
+        batch = batch
+            .require_absent(records_key.clone())
+            .put(records_key, records_value);
+    }
+    Ok(batch)
+}
+
+/// Record a session this pass could not fence, and name it on the durability seam.
+fn unfenceable(fenced: &mut Fenced, name: String, fault: &str) {
+    emit_unfenceable(&name, fault);
+    fenced.unfenceable.push(name);
+}
+
+/// The teardown a `Completing` attempt's own records support: the explicit part set its
+/// `retire:bytes` obligation names, the segment group its `retire:records` obligation retires,
+/// and whether the two can be shown to account for every record the attempt wrote.
+///
+/// # The X57 check, and why it is not "whatever `part:` keys are present"
+///
+/// A `Completing` attempt's `seg:` records name chunks that its `part:` records also name —
+/// that is why the segment rollback is `retire:records:` and never orphan-marks
+/// (`0016:2347-2350`): the bytes stay protected by the parts. A restore can break that pairing,
+/// by resurrecting an attempt whose `part:` record is missing from the image. The teardown then
+/// names parts that do not cover every chunk the segments do, and the bytes behind the
+/// uncovered chunks have **no named deleter anywhere in the design**.
+///
+/// #637 v1 built the teardown from whatever `part:` keys happened to be present and reported
+/// the leftovers as residue after the fact. This reads both ranges and says so **in the report**
+/// instead: the fence still lands (a session that cannot be fenced is worse than one fenced over
+/// an incomplete teardown), and the session is named in
+/// [`RestoreReport::sessions_fenced_with_residue`], which needs a human.
+async fn completing_plan(
+    meta: &dyn MetadataStore,
+    upload: &UploadId,
+    target: &PublishTarget,
+    segments_written: u32,
+) -> Result<FencePlan> {
+    // The session's own parts, from its bounded `part:<id>:` range. The NUMBER comes from the
+    // key and the chunks from the value, and they fail independently: a key the parser rejects
+    // names a part the obligation cannot list, while a value that will not decode names a part
+    // whose chunks the coverage check below cannot see. Both leave the teardown unprovable, and
+    // both are already named in `RestoreReport::unresolvable` by the staged read.
+    let mut numbers: Vec<PartNumber> = Vec::new();
+    let mut part_chunks: HashSet<ChunkId> = HashSet::new();
+    let mut unreadable_parts = 0_usize;
+    walk_staged_range(meta, &multipart::part_range(upload), |key, value| {
+        match multipart::parse_part_key(key) {
+            Ok((_, number)) => numbers.push(number),
+            Err(_) => unreadable_parts += 1,
+        }
+        match multipart::decode_part_record(value) {
+            Ok(part) => part_chunks.extend(part.chunks().iter().map(|chunk| chunk.id)),
+            Err(_) => unreadable_parts += 1,
+        }
+    })
+    .await?;
+
+    // ...and the attempt's own `seg:` records, from the group the session record NAMES — its
+    // stored nonce paired with its fence epoch (`PublishTarget::segment_group`). This is the
+    // whole reason the nonce is on the record: without it the range is unnameable and these
+    // records have no deleter (the #637 v1 defect).
+    let group = target.segment_group();
+    let mut uncovered: BTreeSet<ChunkId> = BTreeSet::new();
+    let mut unreadable_segments = 0_usize;
+    let mut segments_present = false;
+    walk_staged_range(meta, &metadata::seg_range_prefix(&group), |_key, value| {
+        segments_present = true;
+        match metadata::decode::<SegmentRecord>(value) {
+            Ok(record) => uncovered.extend(
+                record
+                    .chunks()
+                    .iter()
+                    .map(|chunk| chunk.id)
+                    .filter(|chunk| !part_chunks.contains(chunk)),
+            ),
+            Err(_) => unreadable_segments += 1,
+        }
+    })
+    .await?;
+
+    let residue = if unreadable_parts > 0 || unreadable_segments > 0 || !uncovered.is_empty() {
+        Some(format!(
+            "the fence's teardown cannot be shown to name every record this attempt wrote: \
+             {unreadable_parts} part record(s) unreadable, {unreadable_segments} segment \
+             record(s) unreadable, and {} chunk(s) named by a `seg:` record that no surviving \
+             `part:` record holds",
+            uncovered.len()
+        ))
+    } else {
+        None
+    };
+    Ok(FencePlan {
+        bytes: RetirePayload::teardown(PartNumberSet::from_numbers(numbers).map(PartScope::Set)),
+        // Installed whenever the attempt HAS segment records or its cursor says it wrote some —
+        // never on the cursor alone. The cursor is one number in a restored record and the range
+        // is the ground truth; taking either as sufficient means a lying cursor in one direction
+        // cannot leave the records without a deleter, and in the other cannot skip the one
+        // obligation that names them.
+        records: (segments_present || segments_written > 0)
+            .then(|| RetirePayload::rolled_back_segments(group)),
+        residue,
+    })
+}
