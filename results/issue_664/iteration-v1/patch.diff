+        "the pass marked nothing at all (racer landing at {delay_millis} ms): {report:?}"
+    );
+
+    // (4) THE DURABLE GENERATION AGREES WITH THE REPORT, and a withholding is a withholding.
+    let generation = decode_restore_fence(
+        &meta
+            .get(MPUFENCE_KEY)
+            .await
+            .unwrap()
+            .expect("the restore-fence generation record"),
+    )
+    .expect("the generation record decodes");
+    assert_eq!(
+        generation.is_complete(),
+        !report.needs_human(),
+        "the durable fence generation and the report disagree about whether this image is fenced \
+         (racer landing at {delay_millis} ms): {report:?}"
+    );
+    if report.needs_human() {
+        let again = reconcile_after_restore(&ctx, now)
+            .await
+            .expect("the settled store reads whole");
+        assert!(
+            !again.needs_human(),
+            "a re-run over the settled store still cannot certify it: {again:?}"
+        );
