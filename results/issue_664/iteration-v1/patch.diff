+            encode_retire_obligation(RetireMode::Records, &token, &stale),
+            Err(RecordError::RetireSegmentEpochMismatch {
+                key_epoch: EPOCH,
+                segment_epoch: EPOCH + 1,
+            })
+        );
+    }
+}
