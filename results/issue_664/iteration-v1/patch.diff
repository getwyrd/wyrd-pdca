+    let racer = madsim::task::spawn({
+        let meta = Arc::clone(&meta);
+        let open = open.clone();
+        let obligation_key = obligation_key.clone();
+        let mpu = mpu_key(&upload);
+        async move {
+            // Zero means now: see `RESTORE_NEMESIS_SPAN`.
+            if delay_millis > 0 {
+                madsim::time::sleep(Duration::from_millis(delay_millis)).await;
+            }
+            meta.commit(
+                WriteBatch::new()
+                    .require(mpu.clone(), open)
+                    .put(mpu, aborting)
