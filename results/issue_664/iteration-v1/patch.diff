+        );
+    }
+
+    /// The `retire:` writer mints only what its own decode accepts — and **refuses** a
+    /// mode/token pairing the drain would reject, instead of handing back bytes nothing can
+    /// drain.
+    #[test]
+    fn the_retire_writer_is_checked_against_the_key_it_mints() {
+        let upload = UploadId::new("ab".repeat(16)).expect("an upload id");
+        let token = RetireToken::Session {
+            upload_id: upload.clone(),
+            epoch: EPOCH,
+            part: None,
+        };
+        let group = SegmentGroup::new(NONCE, EPOCH).expect("a segment group");
