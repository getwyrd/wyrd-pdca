+            .iter()
+            .map(|n| format!("{n}:1"))
+            .chain(["ZZ".repeat(16), "ab".repeat(15)])
+        {
+            let bytes = completing(&format!(
+                "{{\"parent\":{PARENT},\"name\":\"{OBJECT}\",\"epoch\":{EPOCH},\
+                 \"nonce\":\"{spelling}\"}}"
+            ));
+            let fault = match decode_session_record(&bytes) {
+                Err(fault) => fault,
+                Ok(record) => panic!("{spelling:?} is not a nonce, yet it decoded: {record:?}"),
+            };
+            assert!(
+                matches!(
+                    &fault,
+                    RecordError::MalformedRecordValue { namespace: "mpu:", detail }
+                        if detail.contains("nonce")
+                ),
+                "{spelling:?} must be attributed to the nonce rule: {fault}"
+            );
+        }
+    }
