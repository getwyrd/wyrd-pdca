+                component: "session",
+            })
+        );
+        assert_eq!(
+            encode_retire_obligation(RetireMode::Bytes, &token, &segments),
+            Err(RecordError::RetireModeMismatch {
+                key_mode: RetireMode::Bytes,
+                component: "seg",
+            })
+        );
