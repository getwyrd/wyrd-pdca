+    /// **Leg J, the negation** — the pre-decision shape, a `publish_target` with **no**
+    /// `nonce`, is refused. Without it the restore fence cannot name the attempt's
+    /// `seg:<nonce>:<E>:` records at all, so decoding it into a value with some default nonce
+    /// would hand a fence a key range belonging to nothing (or, worse, to another group).
+    #[test]
+    fn a_completing_session_without_the_nonce_is_refused() {
+        let bytes = completing(&format!(
+            "{{\"parent\":{PARENT},\"name\":\"{OBJECT}\",\"epoch\":{EPOCH}}}"
+        ));
