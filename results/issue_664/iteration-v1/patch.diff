+
+/// The **restore-fence generation** record, the value under [`MPUFENCE_KEY`]: which
+/// post-restore fence pass last ran over this metadata store, and whether it finished.
+///
+/// # What it is for
+///
+/// A restore resurrects `mpu:` sessions whose bytes are gone, and a gateway that served
+/// `CompleteMultipartUpload` against one would publish over them (`0016:717-728`, D-B). The
+/// post-restore pass fences every such session; this record is the durable statement that it
+/// did, so a gateway can refuse multipart verbs until it reads `complete` for the current
+/// generation (`0016:723-728`, `:3017-3021`). **Reading it is #508's**; writing it is
+/// `wyrd_custodian::reconcile_after_restore`'s, and this type is the one shape both share.
+///
+/// # Why a generation and not a flag
+///
+/// A bare "fenced" flag is masked by its own history: a *second* restore, over a store whose
+/// flag a *first* pass had set, reads as already-fenced while its newly resurrected sessions
+/// are unfenced. So each pass takes the next generation and marks it incomplete **before** it
+/// fences anything, and marks that same generation complete only after every write it makes —
+/// which makes a later restore invalidate an earlier completion instead of inheriting it.
+///
+/// [`Self::generation`] is **1-based**: absence means no pass has ever run, so "never fenced"
+/// and "fence generation 0" are not two spellings of one state — the two-spellings hazard this
+/// module refuses everywhere else, here between a present record and an absent one. A stored
+/// `0` is refused at decode ([`RecordError::RestoreFenceGenerationZero`]).
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize)]
+pub struct RestoreFence {
+    generation: u64,
+    complete: bool,
+}
+
+impl RestoreFence {
+    /// The record a starting pass writes: the generation **after** `prior`'s (1 when there is
+    /// no prior record), not complete.
+    ///
+    /// **Checked, never saturating** ([`RecordError::CounterExhausted`]): a generation that
+    /// stopped advancing would let a later restore's pass be masked by an earlier one's
+    /// completion, which is the single thing this record exists to prevent.
+    pub fn next(prior: Option<&Self>) -> Result<Self, RecordError> {
+        let generation = match prior {
+            None => 1,
+            Some(prior) => {
+                prior
+                    .generation
+                    .checked_add(1)
+                    .ok_or(RecordError::CounterExhausted {
+                        counter: "mpufence generation",
+                    })?
+            }
+        };
+        Ok(Self {
+            generation,
+            complete: false,
+        })
+    }
+
+    /// The **same** generation, marked complete — never a new one, so the completion a
+    /// gateway reads always names the pass that earned it.
+    pub const fn completed(&self) -> Self {
+        Self {
+            generation: self.generation,
+            complete: true,
+        }
+    }
+
+    /// Which post-restore fence pass this record describes (1-based).
+    pub const fn generation(&self) -> u64 {
+        self.generation
+    }
+
+    /// Whether that pass finished every write it owed.
+    pub const fn is_complete(&self) -> bool {
+        self.complete
+    }
+}
+
+/// The record's own rule — the one place a [`RestoreFence`] can come into existence from
+/// stored bytes:
+///
+/// * `generation != 0`, so absence is the only spelling of "no pass has ever run".
+impl TryFrom<RestoreFenceWire> for RestoreFence {
+    type Error = RecordError;
+
+    fn try_from(wire: RestoreFenceWire) -> Result<Self, RecordError> {
+        if wire.generation == 0 {
+            return Err(RecordError::RestoreFenceGenerationZero);
+        }
+        Ok(Self {
+            generation: wire.generation,
+            complete: wire.complete,
+        })
+    }
+}
