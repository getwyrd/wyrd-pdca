+        lost_the_cas,
+        "no landing point in 0..={FENCE_RACE_SPAN} ms landed the racing fencer BETWEEN the pass's \
+         session read and its own fence commit — the losing side of the compare-and-set, and the \
+         only schedule in which the pass has to name a session it could not fence, was never \
+         exercised"
+    );
+    assert!(
+        already_fenced,
+        "no landing point in 0..={FENCE_RACE_SPAN} ms landed the racing fencer BEFORE the pass \
+         read the session — the schedule in which the pass finds nothing to fence and must still \
+         certify the image was never exercised"
+    );
+}
