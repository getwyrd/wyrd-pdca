+// ---- property 15: a staged re-place races a session fence (X29, #663) ----
+//
+// Reconstruction repairs a committed part's rotten fragment by a re-place: it pre-marks the
+// destination, writes the rebuilt fragment there, and adopts it in one CAS pinned to the session
+// still being `Open` at its epoch and to the part record's exact bytes (`0016:825`). A Complete, an
+// Abort or the reaper may fence the session — its own CAS, `Open@E` to `Aborting@E+1` — at any
+// instant. Whichever lands first, no fragment may end unreferenced AND unevidenced: the written
+// destination is either adopted by the part record or covered by its pre-mark, which GC then acts
+// on. And the session may never end `Aborting` with its part record naming a fragment that was not
+// written (`0016:888`).
+//
+// The per-leg cases in `crates/custodian/tests/staged_repair.rs` (C) land the fence at one scripted
+// instant. Here the fence is a genuinely concurrent task over the simulated-TiKV model, landing
+// where the seed puts it, and every read, commit and D-server write the pass makes spans simulated
+// time — so the fence lands before the pre-mark, between the pre-mark and the write, between the
+// write and the adoption, or after it. The coverage leg proves all four are reached.
+
+const REPLACE_UPLOAD: &str = "66306630663066306630663066306630";
+const REPLACE_OBJECT: &str = "replace";
+/// The committed part's chunk: `RS(2, 1)` on servers 0, 1, 2 (domains A, B, C).
+const REPLACE_CHUNK: ChunkId = 0x8050;
+/// The fragment the run rots: index 1, on server 1. Server 1 is kept busy, so the rebuild moves to
+/// domain D, server 3.
+const REPLACE_LOST: u16 = 1;
+const REPLACE_NOW: u64 = 10_000;
+/// A D server's request and reply hops around a fragment write, in simulated milliseconds. Two
+/// each, so the write lands strictly between the pre-mark commit and the adoption's decision with
+/// whole milliseconds on both sides, where a fence can land without tying either.
+const REPLACE_WRITE_HOP: u64 = 2;
+/// How far into the run the fence is drawn, in simulated milliseconds. A reconstruction pass here
+/// takes about 16: eight reads (the queue, the session listing, the owned and part ranges, the
+/// inodes, the drain records, the vacated source's mark and the destination's) of a hop each, the
+/// pre-mark commit (two hops), the write (two hops each way) and the adoption (two hops). The
+/// fence is a two-hop commit of its own, so this spans "before the pass lists the session" through
+/// "after the adoption".
+const REPLACE_SPAN: u32 = 20;
+
+fn replace_frag(index: u16) -> FragmentId {
+    FragmentId {
+        chunk: REPLACE_CHUNK,
+        index,
+    }
+}
+
+/// Where the fence landed, relative to the re-place's own steps.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+enum FenceWindow {
+    /// Before the pre-mark committed — or before the pass even listed the session.
+    BeforePreMark,
+    /// After the pre-mark committed and before the destination write landed.
+    PreMarkToWrite,
+    /// After the write landed and before the adoption was answered.
+    WriteToAdoption,
+    /// After the adoption was answered.
+    AfterAdoption,
+}
+
+impl FenceWindow {
+    const ALL: [FenceWindow; 4] = [
+        FenceWindow::BeforePreMark,
+        FenceWindow::PreMarkToWrite,
+        FenceWindow::WriteToAdoption,
+        FenceWindow::AfterAdoption,
+    ];
+}
+
+/// One observation at the store seams, in the order the simulation produced them — each logged
+/// the instant its batch applied or its bytes landed.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+enum ReplaceEvent {
+    /// The re-place's pre-mark batch was answered.
+    PreMark(CommitOutcome),
+    /// The destination write landed on this server.
+    Written(DServerId),
+    /// The re-place's adoption batch was answered.
+    Adoption(CommitOutcome),
+    /// The fence was answered.
+    Fence(CommitOutcome),
+}
+
+type ReplaceLog = Arc<Mutex<Vec<ReplaceEvent>>>;
+
+/// A recording tap over the simulated-TiKV store: every call forwarded, network hops included, and
+/// each of the three batches the run cares about logged when it is answered. Instance state only
+/// (ADR-0035).
+struct ReplaceMeta {
+    inner: SimTikvMetadataStore,
+    log: ReplaceLog,
+    premark: Vec<u8>,
+}
+
+#[async_trait]
+impl MetadataStore for ReplaceMeta {
+    async fn get(&self, key: &[u8]) -> Result<Option<Bytes>> {
+        self.inner.get(key).await
+    }
+
+    async fn scan(&self, prefix: &[u8]) -> Result<Vec<(Vec<u8>, Bytes)>> {
+        self.inner.scan(prefix).await
+    }
+
+    async fn scan_page(
+        &self,
+        prefix: &[u8],
+        after: Option<&[u8]>,
+        limit: usize,
+    ) -> Result<wyrd_traits::ScanPage> {
+        self.inner.scan_page(prefix, after, limit).await
+    }
+
+    async fn commit(&self, batch: WriteBatch) -> Result<CommitOutcome> {
+        let puts = |prefix: &[u8]| batch.puts.iter().any(|(key, _)| key.starts_with(prefix));
+        let event: Option<fn(CommitOutcome) -> ReplaceEvent> = if puts(b"mpu:") {
+            Some(ReplaceEvent::Fence)
+        } else if puts(b"part:") {
+            Some(ReplaceEvent::Adoption)
+        } else if batch.puts.iter().any(|(key, _)| *key == self.premark) {
+            Some(ReplaceEvent::PreMark)
+        } else {
+            None
+        };
+        let outcome = self.inner.commit(batch).await?;
+        if let Some(event) = event {
+            self.log.lock().unwrap().push(event(outcome));
+        }
+        Ok(outcome)
+    }
+}
+
+/// A D server whose writes span a request and a reply hop, logging the instant the bytes land.
+struct ReplaceDServer<'a> {
+    id: DServerId,
+    inner: &'a MemDServer,
+    log: ReplaceLog,
+}
+
+#[async_trait]
+impl ChunkStore for ReplaceDServer<'_> {
+    async fn put_fragment(
+        &self,
+        id: FragmentId,
+        fragment: Bytes,
+        deadline_millis: Option<u64>,
+    ) -> Result<()> {
+        madsim::time::sleep(Duration::from_millis(REPLACE_WRITE_HOP)).await;
+        self.inner
+            .put_fragment(id, fragment, deadline_millis)
+            .await?;
+        self.log
+            .lock()
+            .unwrap()
+            .push(ReplaceEvent::Written(self.id));
+        madsim::time::sleep(Duration::from_millis(REPLACE_WRITE_HOP)).await;
+        Ok(())
+    }
+
+    async fn get_fragment(&self, id: FragmentId) -> Result<Option<Bytes>> {
+        self.inner.get_fragment(id).await
+    }
+
+    async fn list_fragments(&self) -> Result<Vec<FragmentId>> {
+        self.inner.list_fragments().await
+    }
+
+    async fn delete_fragment(&self, id: FragmentId) -> Result<()> {
+        self.inner.delete_fragment(id).await
+    }
+
+    async fn health(&self) -> Result<Health> {
+        Ok(Health::Healthy)
+    }
+}
+
+/// A session record targeting [`REPLACE_OBJECT`] at `epoch` in `state` (its JSON), as the base
+/// decoder spells it and checked against it.
+fn replace_session(epoch: u64, state: &str) -> Bytes {
+    let bytes = format!(
+        "{{\"parent\":{ROOT},\"object\":\"{REPLACE_OBJECT}\",\"created_at_millis\":100,\
+         \"clock_source\":\"wall\",\"epoch\":{epoch},\"attempts\":1,\"state\":{state}}}"
+    )
+    .into_bytes();
+    decode_session_record(&bytes).expect("the seeded session record decodes");
+    Bytes::from(bytes)
+}
+
+/// The committed part record naming `chunk`, as the base decoder spells it and checked against it.
+fn replace_part(chunk: &ChunkRef) -> Bytes {
+    let bytes = format!(
+        "{{\"chunks\":[{}],\"len\":{},\"digest\":\"{}\",\"committed_at_millis\":800,\
+         \"session_epoch\":1}}",
+        String::from_utf8(metadata::encode(chunk).to_vec()).unwrap(),
+        chunk.len,
+        "ef".repeat(32)
+    )
+    .into_bytes();
+    decode_part_record(&bytes).expect("the seeded part record decodes");
+    Bytes::from(bytes)
+}
+
+/// Which window a run's fence landed in, read off the log.
+fn fence_window(events: &[ReplaceEvent]) -> FenceWindow {
+    let at = |wanted: fn(&ReplaceEvent) -> bool| events.iter().position(wanted);
+    let fence = at(|event| *event == ReplaceEvent::Fence(CommitOutcome::Committed))
+        .expect("the fence never landed");
+    let premark = at(|event| *event == ReplaceEvent::PreMark(CommitOutcome::Committed));
+    let written = at(|event| matches!(event, ReplaceEvent::Written(_)));
+    let adoption = at(|event| matches!(event, ReplaceEvent::Adoption(_)));
+    if premark.is_none_or(|premark| fence < premark) {
+        FenceWindow::BeforePreMark
+    } else if written.is_none_or(|written| fence < written) {
+        FenceWindow::PreMarkToWrite
+    } else if adoption.is_none_or(|adoption| fence < adoption) {
+        FenceWindow::WriteToAdoption
+    } else {
+        FenceWindow::AfterAdoption
+    }
+}
+
+/// One run: a reconstruction pass re-places the committed part's rotten fragment while a
+/// concurrent task fences the session `delay_millis` into the run. Asserts the invariants over what
+/// the run left behind, and returns where the fence landed.
+async fn replace_under_a_fence(delay_millis: u64) -> FenceWindow {
+    let d = servers();
+    let log: ReplaceLog = Arc::default();
+    let meta = Arc::new(ReplaceMeta {
+        inner: SimTikvMetadataStore::new(),
+        log: Arc::clone(&log),
+        premark: metadata::orphan_key(3, replace_frag(REPLACE_LOST)),
+    });
+    let upload = UploadId::new(REPLACE_UPLOAD).expect("32 lowercase-hex characters");
+    let session_key = mpu_key(&upload);
+    let part_key = part_key(&upload, PartNumber::new(1).expect("a part number in range"));
+    let open = replace_session(1, "{\"kind\":\"Open\"}");
+    let aborting = replace_session(2, "{\"kind\":\"Aborting\"}");
+    let scheme = EcScheme::ReedSolomon {
+        k: K as u8,
+        m: M as u8,
+    };
+
+    // An `Open` session with one committed part naming the chunk, every fragment on its server.
+    let data = b"a staged part's chunk the custodian re-places under a session fence";
+    let fragments: Vec<Bytes> = wyrd_core::erasure::encode(K, M, data)
+        .unwrap()
+        .iter()
+        .enumerate()
+        .map(|(index, shard)| {
+            write::encode_ec_fragment(REPLACE_CHUNK, index as u16, K as u8, M as u8, shard)
+        })
+        .collect();
+    let original: Vec<DServerId> = vec![0, 1, 2];
+    let chunk = ChunkRef {
+        id: REPLACE_CHUNK,
+        scheme,
+        len: data.len() as u64,
+        placement: original.clone(),
+    };
+    let seeded = meta
+        .commit(
+            WriteBatch::new()
+                .put(session_key.clone(), open.clone())
+                .put(part_key.clone(), replace_part(&chunk)),
+        )
+        .await
+        .unwrap();
+    assert_eq!(seeded, CommitOutcome::Committed);
+    for (index, &server) in original.iter().enumerate() {
+        d[server as usize]
+            .put_fragment(replace_frag(index as u16), fragments[index].clone(), None)
+            .await
+            .unwrap();
+    }
+    // The fragment rots on server 1, and scrub has queued its repair.
+    let mut rotten = fragments[usize::from(REPLACE_LOST)].to_vec();
+    rotten[CORE_HEADER_LEN as usize] ^= 0x01;
+    d[1].put_fragment(replace_frag(REPLACE_LOST), Bytes::from(rotten), None)
+        .await
+        .unwrap();
+    repair::enqueue_repair(&*meta, REPLACE_CHUNK, "scrub")
+        .await
+        .unwrap();
+    // The run starts here: what the fixture wrote above is not the race.
+    log.lock().unwrap().clear();
+
+    let fencer = madsim::task::spawn({
+        let meta = Arc::clone(&meta);
+        let (key, open, aborting) = (session_key.clone(), open.clone(), aborting.clone());
+        async move {
+            // Zero means now: see `RESTORE_NEMESIS_SPAN`.
+            if delay_millis > 0 {
+                madsim::time::sleep(Duration::from_millis(delay_millis)).await;
+            }
+            // The model locks a batch's precondition keys too, so the fence can lose a lock race
+            // to an in-flight pre-mark or adoption pinned to the same session; it retries, as a
+            // Complete or an Abort retries its CAS. Nothing else writes the session, so it lands.
+            for _ in 0..REPLACE_SPAN {
+                let fence = WriteBatch::new()
+                    .require(key.clone(), open.clone())
+                    .put(key.clone(), aborting.clone());
+                if meta.commit(fence).await.unwrap() == CommitOutcome::Committed {
+                    return true;
+                }
+                madsim::time::sleep(Duration::from_millis(1)).await;
+            }
+            false
+        }
+    });
+
+    let coord = MemCoordination::new();
+    let (zone, custodian) = elect(&coord, "zone-staged-replace").await;
+    let disks: Vec<ReplaceDServer<'_>> = d
+        .iter()
+        .enumerate()
+        .map(|(id, inner)| ReplaceDServer {
+            id: id as DServerId,
+            inner,
+            log: Arc::clone(&log),
+        })
+        .collect();
+    let fleet: Vec<(DServerId, &dyn ChunkStore)> = disks
+        .iter()
+        .map(|disk| (disk.id, disk as &dyn ChunkStore))
+        .collect();
+    let mut topology = four_domains();
+    topology.set_utilization(1, 100);
+    let ctx = ReconstructionContext {
+        meta: &*meta,
+        fleet: &fleet,
+        topology: &topology,
+        unreachable: &[],
+    };
+    let outcome =
+        reconcile_step(&zone, &custodian, None, None, Some(&ctx), None, REPLACE_NOW).await;
+    assert!(
+        outcome.is_ok(),
+        "the reconstruction pass failed (fence at {delay_millis} ms): {:?}",
+        outcome.err()
+    );
+    let fenced = fencer.await.expect("the fencer ran to completion");
+    assert!(
+        fenced,
+        "the fence never landed (fence at {delay_millis} ms): {:?}",
+        log.lock().unwrap()
+    );
+    let events = log.lock().unwrap().clone();
+
+    let part = meta.get(&part_key).await.unwrap().expect("the part record");
+    let part = decode_part_record(&part).expect("the part record decodes");
+    let placement = part.chunks()[0].placement.clone();
+    let adopted = events.contains(&ReplaceEvent::Adoption(CommitOutcome::Committed));
+    assert_eq!(
+        adopted,
+        placement != original,
+        "the adoption's answer and the part record disagree (fence at {delay_millis} ms): \
+         {events:?}"
+    );
