+        "the session did not end fenced"
+    );
+
+    // NO FRAGMENT ENDS UNREFERENCED AND UNEVIDENCED: every fragment on every server is named by
+    // the part record, or covered by an `orphan:` mark GC acts on.
+    for (id, disk) in d.iter().enumerate() {
+        let id = id as DServerId;
+        for fragment in disk.list_fragments().await.unwrap() {
+            let referenced = fragment.chunk == REPLACE_CHUNK
+                && placement.get(usize::from(fragment.index)) == Some(&id);
+            let evidenced = meta
+                .get(&metadata::orphan_key(id, fragment))
+                .await
+                .unwrap()
+                .is_some();
