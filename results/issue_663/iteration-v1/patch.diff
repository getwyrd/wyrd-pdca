+    }
+    assert_eq!(fixture.queued().await, vec![CHUNK]);
+    assert!(audit.named(
+        RECONSTRUCTION_AUDIT,
+        "staged-aborted",
+        b"no-usable-destination"
+    ));
+}
+
+/// A destination the topology lists but this pass's fleet view left out is never written to, and
+/// neither is one whose mark cannot be read — that mark is left for a human, byte for byte, and
+/// named. Either way the rebuild goes to the next free domain.
+#[tokio::test]
+async fn a_destination_off_the_fleet_or_with_an_unreadable_mark_is_passed_over() {
+    let lost = frag(CHUNK, LOST);
+
+    let off_fleet = Fixture {
+        off_fleet: Some(DEST),
+        ..Fixture::new()
+    };
+    off_fleet.lose();
+    off_fleet.enqueue(CHUNK).await;
+    assert_eq!(off_fleet.repaired(NOW).await, Reconciled::Changed);
+    assert!(off_fleet.puts(DEST).is_empty());
+    assert_rebuilt(&off_fleet, SPARE);
+    assert_eq!(off_fleet.placement(), vec![0, SPARE, 2]);
+
+    let unreadable = Fixture::new();
+    unreadable.lose();
+    unreadable.enqueue(CHUNK).await;
+    let garbage = Bytes::from_static(b"not a mark");
+    unreadable
+        .meta
+        .seed(orphan_key(DEST, lost), garbage.clone());
+    let (outcome, audit) = unreadable.reconstruct(NOW).await;
+    assert_eq!(outcome.unwrap(), Reconciled::Changed);
+    assert!(unreadable.puts(DEST).is_empty());
+    assert_eq!(unreadable.mark(DEST, lost), Some(garbage));
+    assert_rebuilt(&unreadable, SPARE);
+    assert_eq!(unreadable.placement(), vec![0, SPARE, 2]);
+    assert!(audit.named(
+        RECONSTRUCTION_AUDIT,
+        "unusable-destination",
+        &orphan_key(DEST, lost)
+    ));
+}
+
+// ---- scrub: what it cannot read or trust, it names ----------------------------------------------
+
+/// **(A)** Scrub over committed parts it cannot use: a part record that will not decode and a
+/// session key that names no upload leave it unable to verify what they stage, so it names each and
+/// refuses to certify; a part whose chunk placement is not one D server per fragment is named and
+/// never expanded into a phantom repair. The healthy part's rotten fragment is still queued.
+#[tokio::test]
+async fn a_scrub_names_committed_parts_it_cannot_read_or_trust() {
+    const SHORT: ChunkId = 0x667;
+    let fixture = Fixture::new();
+    fixture.rot();
+    let damaged = part_key(&fixture.upload, part_no(2));
+    fixture.meta.seed(
+        damaged.clone(),
+        Bytes::from_static(b"{\"chunks\":\"not a chunk list\"}"),
+    );
+    let short = part_key(&fixture.upload, part_no(3));
+    fixture
+        .meta
+        .seed(short.clone(), part(&[chunk_ref(SHORT, &[0, 1])], 800));
+    let unnamed = b"mpu:not-an-upload-id".to_vec();
+    fixture.meta.seed(unnamed.clone(), open());
+
+    let (outcome, audit) = fixture.scrub_audited().await;
+    assert_eq!(outcome, Reconciled::Blocked);
+    assert_eq!(fixture.queued().await, vec![CHUNK]);
+    assert!(audit.named(SCRUB_AUDIT, "unresolvable-staged-record", &damaged));
+    assert!(audit.named(SCRUB_AUDIT, "unresolvable-staged-record", &unnamed));
+    assert!(audit.named(SCRUB_AUDIT, "malformed-staged-placement", &short));
+}
+
+/// **(A)** A chunk named both by a committed chunk map — published — and by its part record is
+/// verified once, against the committed map, not once per record.
+#[tokio::test]
+async fn a_scrub_verifies_a_chunk_named_by_both_classes_once() {
+    let fixture = Fixture::new();
+    fixture.rot();
+    let published = InodeRecord {
+        size: DATA.len() as u64,
+        chunk_map: vec![chunk_ref(CHUNK, &PLACEMENT)].into(),
+        state: InodeState::Committed,
+        version: 1,
+        ..Default::default()
+    };
+    let created = metadata::create(&*fixture.meta, PARENT, OBJECT, 7, &published).await;
+    assert_eq!(created.unwrap(), CommitOutcome::Committed);
+
+    let (outcome, audit) = fixture.scrub_audited().await;
+    assert_eq!(outcome, Reconciled::Changed);
+    assert_eq!(fixture.queued().await, vec![CHUNK]);
+    assert_eq!(
+        audit.count(SCRUB_AUDIT, "corruption", &wyrd_traits::chunk_hex(CHUNK)),
+        1,
+        "the rotten fragment was verified more than once"
+    );
+}
