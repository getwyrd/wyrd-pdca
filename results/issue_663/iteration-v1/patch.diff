             prop_gc_staged_handoffs_never_reclaim_the_chunk(&mut rng).await;
             prop_gc_reclaim_intent_never_publishes_over_deleted_bytes(&mut rng).await;
+            prop_staged_replace_never_strands_under_a_fence(&mut rng).await;
         }
     }
 }
diff --git a/crates/custodian/src/reconstruction/staged.rs b/crates/custodian/src/reconstruction/staged.rs
new file mode 100644
index 0000000..e4c28e9
--- /dev/null
+++ b/crates/custodian/src/reconstruction/staged.rs
@@ -0,0 +1,661 @@
+//! Reconstruction's **staged** half (proposal 0016 decision 2's reconstruction row, `0016:825`; its
+//! failure rows `0016:887-889`; the pre-mark and write-deadline rules, `0016:1285-1358`): resolving
+//! a repair obligation for a chunk a multipart upload **stages** — named by a committed part
+//! (`part:`) or by an owned staging entry (`sidx:`), and by no committed chunk map — and repairing
+//! a committed part's chunk by a fenced **re-place**.
+//!
+//! Scrub verifies a committed part's fragments exactly as it verifies a committed map's
+//! (`crate::scrub`) and enqueues the ordinary obligation. Without this module that obligation
+//! found no committed map, was assessed `Drain` and discarded, and the part stayed one fragment
+//! short until it was published — or for good, if it never was. Here it resolves to its part
+//! record, and the chunk is re-placed by the destination-pre-mark rule every move that adopts a
+//! pre-written fragment follows:
+//!
+//! ```text
+//! pre-mark: require(mpu == Open@E) ∧ require(part == prior) ∧ each destination's mark as read
+//!           ──► orphan:<P_new> = { now, event }      (a FRESH stamp, whatever was there before)
+//! write:    put_fragment(P_new, rebuilt shard, deadline = now + W_WRITE)   (refused once past)
+//! adopt:    require(mpu == Open@E) ∧ require(part == prior) ∧ require(orphan:<P_new> == pre-mark)
+//!           ∧ require_absent(desired:dserver:<S_new>) ∧ each vacated source's mark as read
+//!           ──► part: placement P_old → P_new, delete orphan:<P_new>,
+//!               orphan:<P_old> = { now, event }, delete repair:<chunk>
+//! ```
+//!
+//! **No outcome strands a fragment.** Every fragment the re-place writes is, at every instant,
+//! either adopted by the part record or covered by its pre-mark, because the pre-mark is durable
+//! before the write is sent and is deleted only by the batch that adopts the fragment. So:
+//!
+//! - a fence before the pre-mark — a Complete, an Abort or a reaper moving the session out of
+//!   `Open@E`, or a writer replacing the part record — makes the pre-mark batch lose, and nothing
+//!   is written at all;
+//! - a fence after it makes the adoption lose (X29, `0016:888`): the part record is left
+//!   byte-identical, the pre-mark stands over whatever was written so GC reclaims it after grace,
+//!   and the obligation stays queued — a repair blocked by a Complete is retried once the chunk is
+//!   published;
+//! - a drain recorded on the destination after it was chosen makes the adoption lose on
+//!   `require_absent(desired:dserver:<S_new>)` (`0016:885`: the fence that closes an intent's
+//!   placement closes a re-place's destination too), with the same pre-mark standing;
+//! - GC deciding to reclaim the pre-mark — it records `reclaiming` before it deletes anything
+//!   (`crate::gc`, `0016:1312-1336`) — makes the adoption lose on the pre-mark's exact bytes,
+//!   whatever the adoption's latency;
+//! - and the adoption itself is the one batch that removes the obligation, so an obligation goes
+//!   only once the repair is durable.
+//!
+//! **One clock for the move's whole lifecycle.** The pre-mark and the vacated source's mark are
+//! stamped with this pass's clock reading (`now_millis` — in the deployed loop, the wall clock the
+//! role hands every pass), GC ages both on that same clock, and the destination write's
+//! authorization deadline is fixed from that same reading: `now_millis + W_WRITE_MILLIS`. The D
+//! server enforces the deadline on its own clock, within `δ_clock` of this one (`ChunkStore::
+//! put_fragment`, #638). Two consequences carry the pre-mark rules (`0016:1338-1358`):
+//!
+//! - the write is authorized at the pre-mark's own stamp, so the pre-mark's age at authorization
+//!   is zero — below any `W_repoint` — and a pre-mark from an earlier attempt is never used as
+//!   this one's: a destination's existing mark, whatever event wrote it and however young it is,
+//!   is re-stamped fresh under a precondition on its exact bytes, so GC's clock for it restarts
+//!   before the write is sent. No write is ever authorized on a stale pre-mark;
+//! - a worker that stalls after the pre-mark commits — the pause `W_repoint` exists for — only
+//!   delivers an authorization whose deadline is already fixed, and the D server refuses it once
+//!   that deadline passes. So any fragment this re-place writes lands before
+//!   `stamp + W_WRITE_MILLIS` on the acceptor's clock, strictly inside its pre-mark's grace
+//!   ([`W_WRITE_MILLIS`] states the sizing): no fragment is written after its evidence may have
+//!   been reclaimed.
+//!
+//! **What it cannot read, it does not rewrite** (ADR-0045). A session record that will not decode,
+//! or a vacated source whose `orphan:` value is none of the three mark shapes, withholds the whole
+//! repair before anything is written — named NEEDS-HUMAN, the obligation kept, the pass not
+//! certified ([`Assessment::Withheld`]). A destination whose mark will not decode, or is already
+//! `reclaiming`, is never used: another is chosen.
+
+use std::collections::{BTreeSet, HashMap, HashSet};
+
+use wyrd_core::metadata::{
+    self, decode_orphan_mark, encode_orphan_mark, orphan_key, EcScheme, OrphanMark,
+};
+use wyrd_core::multipart::{
+    decode_owned_entry, decode_part_record, decode_session_record, mpu_key, parse_part_key,
+    parse_sidx_key, PartRecord, SessionState,
+};
+use wyrd_core::placement::select_distinct_domains_excluding;
+use wyrd_core::write::encode_ec_fragment;
+use wyrd_core::{erasure, repair};
+use wyrd_traits::{
+    is_write_deadline_expired, BoxError, ChunkId, ChunkStore, CommitOutcome, DServerId, FragmentId,
+    MetadataStore, Result, WriteBatch,
+};
+
+use super::{gather, Assessment, ReconstructionContext, RepairOutcome, RepairPlan, Target};
+use crate::desired_state::desired_key;
+use crate::gc::{object_name, walk_staged, StagedRanges, StagedRecord};
+
+/// `W_write` for a staged re-place's destination write, in milliseconds: how long after its
+/// pre-mark was stamped the write may still take effect (`0016:1478-1479`). The D server refuses it
+/// from `stamp + W_WRITE_MILLIS` on, and the repair is retried by a later pass.
+///
+/// Sized against the deployed orphan grace `G_orphan` — 60 s, the lease TTL the deployed GC pass
+/// derives its window from (`crates/server/src/custodian.rs:114`) — under the strict
+/// `G_orphan > W_repoint + W_write + δ_clock` (`0016:1348`). This re-place authorizes its write at
+/// the pre-mark's own stamp, so none of that budget is spent between pre-mark and authorization,
+/// and 40 s of it is left for the skew between the custodian's clock and a D server's.
+const W_WRITE_MILLIS: u64 = 20_000;
+
+/// This pass's reading of the staged class, for the chunks it owes a repair on. Read BEFORE the
+/// committed namespace (`super::reconcile` says why), through the one session walk every staged
+/// reader shares ([`walk_staged`]).
+#[derive(Default)]
+pub(super) struct StagedReading {
+    /// One entry per committed part this pass owes a repair inside, held once and shared by every
+    /// obligation inside it — an object is held only if a repair is owed inside it.
+    parts: Vec<StagedPart>,
+    /// Each owed chunk a committed part names: the first such part in key order.
+    sites: HashMap<ChunkId, StagedSite>,
+    /// Owed chunks only an owned staging entry names: their part is still streaming.
+    in_flight: HashSet<ChunkId>,
+    /// A staged record this pass could not read at all, so the reading has a hole in it: a chunk
+    /// it owes may be one that record stages. Each is named where it was met.
+    incomplete: bool,
+}
+
+/// One committed part this pass owes a repair inside, as the walk read it: the snapshot every
+/// repair inside it is built from and conditioned on.
+pub(super) struct StagedPart {
+    /// The owning session's key, and its value exactly as the listing read it. Both batches of a
+    /// re-place are pinned to these bytes — `require(mpu == Open@E)` — and every transition
+    /// rewrites them, bumping the epoch, so any fence fails the re-place.
+    session_key: Vec<u8>,
+    session: Vec<u8>,
+    /// The part record's key, and its bytes exactly as read — the adoption's other pin,
+    /// `require(part == prior)`.
+    key: Vec<u8>,
+    prior: Vec<u8>,
+    /// Those bytes, decoded.
+    record: PartRecord,
+}
+
+/// Where an owed chunk sits in [`StagedReading::parts`].
+struct StagedSite {
+    part: usize,
+    /// The chunk's index within that part's own chunk list.
+    index: usize,
+}
+
+/// What a staged [`RepairPlan`] repoints: its part, and the `orphan:` mark this pass read at each
+/// position the move would vacate — one per missing fragment, in the plan's `missing` order. The
+/// adoption is preconditioned on each, so a mark that changes under it fails the CAS rather than
+/// being overwritten.
+pub(super) struct StagedTarget {
+    part: usize,
+    vacated: Vec<SourceMark>,
+}
+
+/// The `orphan:` mark at a position a re-place would vacate, as the assessment read it.
+enum SourceMark {
+    /// No mark: the adoption writes one, under `require_absent`.
+    Absent,
+    /// A legacy or structured mark, stale evidence from another unreference event: re-stamped
+    /// with this move's identity and stamp (`0016:1216-1224`), under a precondition on these
+    /// exact bytes.
+    Stamped(Vec<u8>),
+    /// GC has already recorded its decision to reclaim the position. No writer replaces such a
+    /// mark (`metadata::OrphanMark`), and none needs to: it already evidences the vacated bytes,
+    /// and GC finishes the reclaim once no record names them.
+    Reclaiming,
+}
+
+impl StagedReading {
+    /// Whether any queued chunk resolved to a committed part — the only case a re-place can run.
+    pub(super) fn owes_repairs(&self) -> bool {
+        !self.sites.is_empty()
+    }
+
+    /// Whether a staged record this pass could not read left a hole in the reading.
+    pub(super) fn incomplete(&self) -> bool {
+        self.incomplete
+    }
+
+    /// The part a staged plan repoints.
+    pub(super) fn part(&self, target: &StagedTarget) -> &StagedPart {
+        &self.parts[target.part]
+    }
+
+    /// Contain one staged record this reading could not read: name it for the operator where it
+    /// was met, and record that the reading now has a hole in it.
+    fn contain(&mut self, key: &[u8], fault: &str) {
+        emit_unresolvable_staged(&object_name(key), fault);
+        self.incomplete = true;
+    }
+
+    /// Classify one owned staging entry through the namespace's one decode entry point.
+    fn read_owned(&mut self, owed: &HashSet<ChunkId>, key: &[u8], value: &[u8]) {
+        let chunk = match decode_owned_entry(key, value) {
+            Ok((_part, chunk, _entry)) => chunk,
+            // The value will not decode, but the key still names its chunk: a staged record
+            // names it all the same — one that cannot be trusted, which is no reason to drop the
+            // chunk's obligation.
+            Err(_) => match parse_sidx_key(key) {
+                Ok((_upload, _part, chunk)) => chunk,
+                Err(fault) => return self.contain(key, &fault.to_string()),
+            },
+        };
+        if owed.contains(&chunk) {
+            self.in_flight.insert(chunk);
+        }
+    }
+
+    /// Classify one committed part: its key and value validated as the staged protection class
+    /// validates them (`crate::gc::StagedSet`), and held only if it names a chunk this pass owes.
+    fn read_part(&mut self, owed: &HashSet<ChunkId>, key: &[u8], value: &[u8], session: &[u8]) {
+        let read = parse_part_key(key)
+            .and_then(|(upload, _part)| Ok((upload, decode_part_record(value)?)));
+        let (upload, record) = match read {
+            Ok(read) => read,
+            Err(fault) => return self.contain(key, &fault.to_string()),
+        };
+        let named: Vec<(usize, ChunkId)> = record
+            .chunks()
+            .iter()
+            .enumerate()
+            .filter(|(_, chunk)| owed.contains(&chunk.id) && !self.sites.contains_key(&chunk.id))
+            .map(|(index, chunk)| (index, chunk.id))
+            .collect();
+        if named.is_empty() {
+            return;
+        }
+        self.parts.push(StagedPart {
+            session_key: mpu_key(&upload),
+            session: session.to_vec(),
+            key: key.to_vec(),
+            prior: value.to_vec(),
+            record,
+        });
+        let part = self.parts.len() - 1;
+        for (index, chunk) in named {
+            // The FIRST reference in key order wins, as the committed reading's does.
+            self.sites
+                .entry(chunk)
+                .or_insert(StagedSite { part, index });
+        }
+    }
+}
+
+/// Read this pass's [`StagedReading`] for `queue`: every listed session's owned entries, then its
+/// committed parts, in bounded pages, never one read of a whole namespace (`0016:890`). A record
+/// this pass cannot read is contained and named; a store fault under any read fails the pass.
+pub(super) async fn read(meta: &dyn MetadataStore, queue: &[ChunkId]) -> Result<StagedReading> {
+    let owed: HashSet<ChunkId> = queue.iter().copied().collect();
+    let mut reading = StagedReading::default();
+    walk_staged(meta, StagedRanges::OwnedThenParts, |record| match record {
+        StagedRecord::UnnamedSession { key, fault } => reading.contain(key, &fault),
+        StagedRecord::Owned { key, value } => reading.read_owned(&owed, key, value),
+        StagedRecord::Part {
+            key,
+            value,
+            session,
+        } => reading.read_part(&owed, key, value, session),
+    })
+    .await?;
+    Ok(reading)
+}
+
+/// Assess an owed chunk no committed chunk map names, against the staged class.
+///
+/// A chunk no staged record names either was deleted out from under the obligation: `Drain`,
+/// acted on only over a complete reading of both classes (`super::reconcile`). One only an owned
+/// entry names is still streaming, and one whose session is not `Open` is fenced: both keep
+/// their obligation ([`Assessment::Deferred`]). A committed part's chunk is gathered and verified
+/// exactly as a committed one is, against the scheme its part record carries — its placement held
+/// to the exact length every staged record is born with (`0016:828`), and its rebuild placed
+/// against the topology WITHOUT the servers an operator is draining (`0016:885`).
+pub(super) async fn assess(
+    ctx: &ReconstructionContext<'_>,
+    stores: &HashMap<DServerId, &dyn ChunkStore>,
+    staged: &StagedReading,
+    draining: &BTreeSet<DServerId>,
+    chunk: ChunkId,
+) -> Result<Assessment> {
+    let Some(site) = staged.sites.get(&chunk) else {
+        if staged.in_flight.contains(&chunk) {
+            return Ok(Assessment::Deferred("in-flight"));
+        }
+        return Ok(Assessment::Drain);
+    };
+    let part = &staged.parts[site.part];
+    // Only an `Open` session's part may be repointed: the re-place is fenced exactly like a part
+    // upload, and every other state has already fenced it. The adoption is pinned to these same
+    // bytes, so a session fenced after this read still fails it.
+    match decode_session_record(&part.session) {
+        Ok(session) if matches!(session.state(), SessionState::Open {}) => {}
+        Ok(_) => return Ok(Assessment::Deferred("session-fenced")),
+        Err(fault) => {
+            emit_withheld(&object_name(&part.session_key), &fault.to_string());
+            return Ok(Assessment::Withheld);
+        }
+    }
+    let chunk_ref = &part.record.chunks()[site.index];
+    if chunk_ref.placement.len() != usize::from(chunk_ref.fragment_count()) {
+        return Ok(Assessment::Malformed);
+    }
+    let (k, m) = match chunk_ref.scheme {
+        EcScheme::None => return Ok(Assessment::Unrepairable),
+        EcScheme::ReedSolomon { k, m } => (usize::from(k), usize::from(m)),
+    };
+    let gathered = gather(ctx, stores, chunk, &chunk_ref.placement, chunk_ref.scheme).await?;
+    if let Some(settled) = gathered.settle(k, &ctx.topology.excluding(draining)) {
+        return Ok(settled);
+    }
+    // The mark at each position the move would vacate, read now so that one no writer can parse
+    // withholds the repair before anything is written — pre-mark, fragment or record.
+    let mut vacated = Vec::with_capacity(gathered.missing.len());
+    for &index in &gathered.missing {
+        let key = orphan_key(chunk_ref.placement[index], fragment(chunk, index));
+        vacated.push(match ctx.meta.get(&key).await? {
+            None => SourceMark::Absent,
+            Some(current) => match decode_orphan_mark(&current) {
+                Ok(mark) if mark.is_reclaiming() => SourceMark::Reclaiming,
+                Ok(_) => SourceMark::Stamped(current.to_vec()),
+                Err(fault) => {
+                    emit_withheld(&object_name(&key), &fault.to_string());
+                    return Ok(Assessment::Withheld);
+                }
+            },
+        });
+    }
+    Ok(Assessment::Repairable(Box::new(RepairPlan {
+        target: Target::Staged(StagedTarget {
+            part: site.part,
+            vacated,
+        }),
+        chunk_index: site.index,
+        chunk_id: chunk,
+        k,
+        m,
+        survivors: gathered.survivors,
+        survivor_domains: gathered.survivor_domains,
+        missing: gathered.missing,
+        placement: chunk_ref.placement.clone(),
+        len: chunk_ref.len as usize,
+    })))
+}
+
+/// The mark at a destination position, as the choice of destination read it.
+enum DestinationMark {
+    /// No mark: the pre-mark is written under `require_absent`.
+    Absent,
+    /// A legacy or structured mark: re-stamped fresh, never reused with its old stamp, under a
+    /// precondition on these exact bytes.
+    Stamped(Vec<u8>),
+}
+
+/// Where one rebuilt fragment goes.
+struct Destination<'s> {
+    /// The fragment index it rebuilds — one of the plan's `missing`, in its order.
+    index: usize,
+    dserver: DServerId,
+    store: &'s dyn ChunkStore,
+    mark: DestinationMark,
+}
+
+/// Re-place `plan`'s missing fragment(s) of a committed part's chunk: rebuild, pre-mark each
+/// destination, write, and adopt in one CAS pinned to the session and the part record — the
+/// sequence and its guarantees are this module's own doc.
+///
+/// Returns [`RepairOutcome::Aborted`] when the re-place stopped before it could adopt anything and
+/// may simply be retried — no usable destination, a pre-mark that lost its precondition, a write
+/// refused past its deadline — [`RepairOutcome::Conflict`] when the adoption lost, and
+/// [`RepairOutcome::Refused`] when the repointed part record would cross the value ceiling. A
+/// transient store fault fails the pass, as it does on the committed path; every pre-mark already
+/// written covers whatever landed.
+pub(super) async fn repair(
+    ctx: &ReconstructionContext<'_>,
+    stores: &HashMap<DServerId, &dyn ChunkStore>,
+    part: &StagedPart,
+    draining: &BTreeSet<DServerId>,
+    target: &StagedTarget,
+    plan: &RepairPlan,
+    now_millis: u64,
+) -> Result<RepairOutcome> {
+    let (k, m, chunk) = (plan.k, plan.m, plan.chunk_id);
+
+    // Reconstruct the chunk's logical bytes from any `k` survivors and re-derive every shard
+    // (`erasure::encode` is deterministic, so a rebuilt shard is byte-identical to the original).
+    let data = erasure::reconstruct(k, m, plan.len, &plan.survivors)?;
+    let shards = erasure::encode(k, m, &data)?;
+
+    let Some(destinations) = choose_destinations(ctx, stores, draining, plan).await? else {
+        emit_aborted_reason(chunk, "no-usable-destination");
+        return Ok(RepairOutcome::Aborted);
+    };
+
+    // The part record the adoption would leave behind, judged before anything is written, as the
+    // committed path judges its record (`super::repair_chunk`).
+    let next = repointed_part(part, plan.chunk_index, &destinations)?;
+    if let Some(ceiling) = metadata::flat_value_ceiling_crossed(&next) {
+        return Ok(RepairOutcome::Refused {
+            bytes: next.len(),
+            ceiling,
+        });
+    }
+
+    // PRE-MARK every destination, durably, before any write is sent: from here on a fragment the
+    // re-place writes is covered by evidence GC acts on, whichever way the adoption goes. Fresh —
+    // stamped by this pass's clock under a per-move event, whatever mark was there before — and
+    // pinned to the session and the part record, so a fence that already landed writes nothing.
+    let event = format!("replace:{chunk:x}:{now_millis}");
+    let mark = encode_orphan_mark(&OrphanMark::structured(now_millis, event)?);
+    let mut premark = WriteBatch::new()
+        .require(part.session_key.clone(), part.session.clone())
+        .require(part.key.clone(), part.prior.clone());
+    for dest in &destinations {
+        let key = orphan_key(dest.dserver, fragment(chunk, dest.index));
+        premark = match &dest.mark {
+            DestinationMark::Absent => premark.require_absent(key.clone()),
+            DestinationMark::Stamped(current) => premark.require(key.clone(), current.clone()),
+        }
+        .put(key, mark.clone());
+    }
+    if ctx.meta.commit(premark).await? == CommitOutcome::Conflict {
+        emit_aborted_reason(chunk, "pre-mark-lost");
+        return Ok(RepairOutcome::Aborted);
+    }
+
+    // WRITE each rebuilt fragment, authorized until the deadline fixed at the pre-mark's own
+    // stamp. The D server refuses it past that deadline — with nothing landed, or with its
+    // landing unknown — and either way nothing is adopted: whatever landed is under the pre-mark.
+    let deadline = now_millis.saturating_add(W_WRITE_MILLIS);
+    for dest in &destinations {
+        let bytes = encode_ec_fragment(
+            chunk,
+            dest.index as u16,
+            k as u8,
+            m as u8,
+            &shards[dest.index],
+        );
+        match dest
+            .store
+            .put_fragment(fragment(chunk, dest.index), bytes, Some(deadline))
+            .await
+        {
+            Ok(()) => {}
+            Err(fault) if is_write_deadline_expired(fault.as_ref()) => {
+                emit_aborted_reason(chunk, "write-deadline-expired");
+                return Ok(RepairOutcome::Aborted);
+            }
+            Err(fault) => return Err(fault),
+        }
+    }
+
+    // ADOPT, in ONE CAS: the part record repointed, each pre-mark consumed, each vacated source
+    // orphaned, the obligation drained. It lands only if the session is still `Open` at the epoch
+    // this pass read, the part record is still the one it read, every pre-mark still holds the
+    // exact bytes written above (GC swaps a mark to `reclaiming` before it deletes anything), and
+    // no drain has been recorded on a destination since it was chosen.
+    let mut adopt = WriteBatch::new()
+        .require(part.session_key.clone(), part.session.clone())
+        .require(part.key.clone(), part.prior.clone())
+        .put(part.key.clone(), next)
+        .delete(repair::repair_key(chunk));
+    for dest in &destinations {
+        let key = orphan_key(dest.dserver, fragment(chunk, dest.index));
+        adopt = adopt
+            .require(key.clone(), mark.clone())
+            .delete(key)
+            .require_absent(desired_key(dest.dserver));
+    }
+    for ((dest, source), &index) in destinations.iter().zip(&target.vacated).zip(&plan.missing) {
+        let vacated = plan.placement[index];
+        if dest.dserver == vacated {
+            // Rebuilt in place: the position stays named, so nothing is vacated.
+            continue;
+        }
+        let key = orphan_key(vacated, fragment(chunk, index));
+        adopt = match source {
+            SourceMark::Absent => adopt.require_absent(key.clone()).put(key, mark.clone()),
+            SourceMark::Stamped(current) => adopt
+                .require(key.clone(), current.clone())
+                .put(key, mark.clone()),
+            SourceMark::Reclaiming => adopt,
+        };
+    }
+    Ok(match ctx.meta.commit(adopt).await? {
+        CommitOutcome::Committed => RepairOutcome::Committed,
+        // Lost the race: nothing was adopted and the obligation stays queued. Each written
+        // fragment stays under its pre-mark, which GC reclaims after grace.
+        CommitOutcome::Conflict => RepairOutcome::Conflict,
+    })
+}
+
+/// Choose a destination for each missing fragment: in failure domains distinct from each other and
+/// from the survivors' (the committed path's selector), never on a server an operator is
+/// draining, never outside this pass's fleet view, and never at a position whose `orphan:` mark is
+/// already `reclaiming` or cannot be read. A server ruled out is excluded and the choice is made
+/// again, so it ends once every chosen position is usable or no free domain is left (`None`) —
+/// each round excludes one more server, of finitely many.
+async fn choose_destinations<'s>(
+    ctx: &ReconstructionContext<'_>,
+    stores: &HashMap<DServerId, &'s dyn ChunkStore>,
+    draining: &BTreeSet<DServerId>,
+    plan: &RepairPlan,
+) -> Result<Option<Vec<Destination<'s>>>> {
+    let mut excluded = draining.clone();
+    'choose: loop {
+        let view = ctx.topology.excluding(&excluded);
+        let Ok(servers) = select_distinct_domains_excluding(
+            &view,
+            plan.missing.len() as u16,
+            &plan.survivor_domains,
+        ) else {
+            return Ok(None);
+        };
+        let mut chosen = Vec::with_capacity(servers.len());
+        for (&index, &dserver) in plan.missing.iter().zip(&servers) {
+            let Some(&store) = stores.get(&dserver) else {
+                excluded.insert(dserver);
+                continue 'choose;
+            };
+            let key = orphan_key(dserver, fragment(plan.chunk_id, index));
+            let mark = match ctx.meta.get(&key).await? {
+                None => DestinationMark::Absent,
+                Some(current) => match decode_orphan_mark(&current) {
+                    // GC has recorded its decision to reclaim this position (`0016:1312-1336`):
+                    // a fragment written here could be deleted by the reclaim in progress, and
+                    // no writer replaces a `reclaiming` mark (`metadata::OrphanMark`).
+                    Ok(found) if found.is_reclaiming() => {
+                        emit_unusable_destination(&object_name(&key), "reclaiming", None);
+                        excluded.insert(dserver);
+                        continue 'choose;
+                    }
+                    Ok(_) => DestinationMark::Stamped(current.to_vec()),
+                    // Never overwrite a mark no writer can parse (ADR-0045).
+                    Err(fault) => {
+                        emit_unusable_destination(
+                            &object_name(&key),
+                            "unreadable-mark",
+                            Some(&fault.to_string()),
+                        );
+                        excluded.insert(dserver);
+                        continue 'choose;
+                    }
+                },
+            };
+            chosen.push(Destination {
+                index,
+                dserver,
+                store,
+                mark,
+            });
+        }
+        return Ok(Some(chosen));
+    }
+}
+
+/// The part record the adoption writes: `part.prior` with the chunk at `chunk_index` placed on
+/// `destinations`, and nothing else changed.
+///
+/// A [`PartRecord`] has no writer-side constructor (`crates/core/src/multipart.rs:2492`), so the
+/// new value is derived from the stored bytes themselves: the one decoder accepts exactly the
+/// canonical encoding (`decode_part_record`'s canonical-bytes gate), which spells the chunk list
+/// as `metadata::encode` does, so that list is found in the stored bytes and replaced by the
+/// repointed one, and every other byte is kept. The result is accepted only if the same decoder
+/// reads it back, so this never writes a part record the decoder would refuse.
+fn repointed_part(
+    part: &StagedPart,
+    chunk_index: usize,
+    destinations: &[Destination<'_>],
+) -> Result<Vec<u8>> {
+    let mut chunks = part.record.chunks().to_vec();
+    for dest in destinations {
+        chunks[chunk_index].placement[dest.index] = dest.dserver;
+    }
+    let prior_list = metadata::encode(&part.record.chunks().to_vec());
+    let at = part
+        .prior
+        .windows(prior_list.len())
+        .position(|window| window == &prior_list[..])
+        .ok_or_else(|| {
+            BoxError::from(format!(
+                "the part record {} does not spell its own chunk list",
+                object_name(&part.key)
+            ))
+        })?;
+    let mut next = Vec::with_capacity(part.prior.len() + 20 * destinations.len());
+    next.extend_from_slice(&part.prior[..at]);
+    next.extend_from_slice(&metadata::encode(&chunks));
+    next.extend_from_slice(&part.prior[at + prior_list.len()..]);
+    decode_part_record(&next)?;
+    Ok(next)
+}
+
+fn fragment(chunk: ChunkId, index: usize) -> FragmentId {
+    FragmentId {
+        chunk,
+        index: index as u16,
+    }
+}
+
+/// Emit a staged record reconstruction could **not read** on the durability-plane seam (ADR-0011 /
+/// ADR-0012): its reading of the staged class has a hole, so the pass drains no obligation and
+/// certifies nothing until the record is repaired. The action GC and scrub name the same record
+/// with (`unresolvable-staged-record`), so one query finds every loop blocked on it.
+fn emit_unresolvable_staged(record: &str, fault: &str) {
+    tracing::warn!(monotonic_counter.reconstruction_unresolvable_staged_records = 1_u64);
+    tracing::warn!(
+        target: "wyrd.custodian.reconstruction.audit",
+        action = "unresolvable-staged-record",
+        record = %record,
+        fault = %fault,
+        "reconstruction could not read a staged multipart record; this pass drains NOTHING and certifies NOTHING until it is repaired — operator signal",
+    );
+}
+
+/// Emit a staged repair this pass **may not perform yet** on the same seam — its part is still
+/// streaming (`in-flight`), or its session has been fenced out of `Open` (`session-fenced`). The
+/// obligation stays queued: the repair runs once the part commits, or once the chunk is published.
+pub(super) fn emit_deferred(chunk: ChunkId, reason: &'static str) {
+    tracing::info!(
+        target: "wyrd.custodian.reconstruction.audit",
+        action = "staged-deferred",
+        reason,
+        chunk = %wyrd_traits::chunk_hex(chunk),
+        "reconstruction deferred a staged chunk's repair; the obligation stays queued",
+    );
+}
+
+/// Emit a staged repair **withheld** because a record it would have to rewrite cannot be read —
+/// the session record, or the `orphan:` mark at a position the move would vacate — on the same
+/// seam. NEEDS-HUMAN: nothing was written, the record is left byte for byte as it is, the
+/// obligation stays queued, and the pass does not certify until the record is repaired.
+fn emit_withheld(record: &str, fault: &str) {
+    tracing::warn!(monotonic_counter.reconstruction_withheld_staged_repairs = 1_u64);
+    tracing::warn!(
+        target: "wyrd.custodian.reconstruction.audit",
+        action = "withheld-staged-repair",
+        record = %record,
+        fault = %fault,
+        "reconstruction withheld a staged repair: a record it would have to rewrite cannot be read, and it never overwrites what it cannot parse; NOTHING was written and the obligation stays queued — NEEDS-HUMAN",
+    );
+}
+
+/// Emit why a staged re-place stopped before it could adopt anything (the `reconstruction_aborted`
+/// offset itself is emitted by `super::reconcile`), on the same seam.
+fn emit_aborted_reason(chunk: ChunkId, reason: &'static str) {
+    tracing::info!(
+        target: "wyrd.custodian.reconstruction.audit",
+        action = "staged-aborted",
+        reason,
+        chunk = %wyrd_traits::chunk_hex(chunk),
+        "a staged re-place stopped before adopting anything; every fragment it wrote stays under its pre-mark, and the obligation stays queued",
+    );
+}
+
+/// Emit a destination position a staged re-place ruled out, on the same seam: its mark is already
+/// `reclaiming`, or it cannot be read (then with the codec's reason, NEEDS-HUMAN — the mark is
+/// left in place for a human, as GC leaves one).
+fn emit_unusable_destination(mark: &str, reason: &'static str, fault: Option<&str>) {
+    tracing::warn!(
+        target: "wyrd.custodian.reconstruction.audit",
+        action = "unusable-destination",
+        reason,
+        mark = %mark,
+        fault = fault.unwrap_or(""),
+        "a staged re-place ruled out a destination whose orphan mark it may not overwrite; another is chosen",
+    );
+}
diff --git a/crates/custodian/tests/staged_repair.rs b/crates/custodian/tests/staged_repair.rs
new file mode 100644
index 0000000..768f793
--- /dev/null
+++ b/crates/custodian/tests/staged_repair.rs
@@ -0,0 +1,1675 @@
+//! Issue #663 (637.3) — **staged scrub and repair** (proposal 0016 decision 2's scrub and
+//! reconstruction rows, `docs/design/proposals/draft/0016-multipart-commit-protocol.md:824-825`;
+//! its failure rows `:874-890`; the pre-mark and write-deadline rules, `:1285-1358`).
+//!
+//! A multipart upload's committed parts hold durable bytes for as long as the session stays open.
+//! Scrub must verify them and queue a repair when one rots or goes missing, and reconstruction must
+//! resolve that repair against the part record — rebuild the fragment, re-place it under the
+//! session's fence, and strand nothing on any branch — instead of finding no committed chunk map
+//! and dropping the obligation.
+//!
+//! Every leg drives the production `reconcile_step` over in-memory doubles. No client creates a
+//! session before the S3 verbs, so every staged record is seeded as raw JSON the base decoders
+//! accept (the shapes of `crates/core/tests/multipart_session_records.rs:81-145`) and is
+//! round-tripped through them before a pass reads it. The D-server double **enforces** the write
+//! deadline `put_fragment` carries — a write arriving at or after it is refused with
+//! `WriteDeadlineExpired`, through the seam's own comparison, as the real D server does since #638
+//! — against a clock the test moves; and for every write that arrives it records the `orphan:` mark
+//! the metadata store held for that position at that instant.
+//!
+//! The legs (brief #663):
+//! - **A** scrub queues a repair for a committed part's bit-flipped fragment and for a missing one,
+//!   and queues nothing for a still-streaming (`sidx:`-only) chunk; a part it cannot read or trust
+//!   is named, never guessed at.
+//! - **B** reconstruction re-places a committed part's lost fragment: rebuilt intact and
+//!   scheme-correct on a new D server, the part record repointed there, the pre-mark consumed, the
+//!   vacated source marked for GC — which then reclaims it — and the obligation drained.
+//! - **C** the losing branch strands nothing (X29): a session fence, or a part rewrite, landing
+//!   between the destination write and the adoption.
+//! - **D** the pre-mark and write-deadline rules, one case each: (i) pre-mark durable before the
+//!   write, (ii) an existing mark re-stamped fresh, (iii) a `reclaiming` destination never used,
+//!   (iv) a write refused past its deadline aborts, (v) no write authorized on a stale pre-mark,
+//!   (vi) an unreadable vacated-source mark withholds the move.
+//! - **E** the drain fence on the destination: never chosen, and a drain recorded after it was
+//!   chosen loses the adoption.
+//! - plus the resolution rules that keep an obligation rather than drop it: a still-streaming
+//!   chunk, a fenced session, an unreadable session record, an unreadable staged record elsewhere,
+//!   a chunk that cannot be repaired — and the one that drains it: a chunk already whole.
+//!
+//! Nothing here names a symbol the fix adds: every type, function and string it uses is on the
+//! base already.
+
+#![forbid(unsafe_code)]
+
+use std::collections::{BTreeMap, HashMap};
+use std::fmt::Debug;
+use std::ops::Bound;
+use std::sync::atomic::{AtomicU64, Ordering};
+use std::sync::{Arc, Mutex, Once};
+
+use async_trait::async_trait;
+use bytes::Bytes;
+use tracing::field::{Field, Visit};
+use tracing::instrument::WithSubscriber;
+use tracing_subscriber::layer::Context;
+use tracing_subscriber::prelude::*;
+use wyrd_chunk_format::CORE_HEADER_LEN;
+use wyrd_coordination_mem::MemCoordination;
+use wyrd_core::erasure;
+use wyrd_core::metadata::{
+    self, decode_orphan_mark, orphan_key, ChunkRef, EcScheme, InodeId, InodeRecord, InodeState,
+};
+use wyrd_core::multipart::{
+    decode_owned_entry, decode_part_record, decode_session_record, mpu_key, part_key, sidx_key,
+    OwnedEntry, PartNumber, StagedPlacement, UploadId,
+};
+use wyrd_core::placement::Topology;
+use wyrd_core::repair::{self, header_matches_identity};
+use wyrd_core::write::encode_ec_fragment;
+use wyrd_custodian::desired_state::desired_key;
+use wyrd_custodian::{
+    reconcile_step, set_lifecycle, Custodian, DServerLifecycle, ExpiredPendingPolicy, FencedZone,
+    GcContext, ReconcileError, Reconciled, ReconstructionContext, ScrubContext,
+};
+use wyrd_traits::{
+    BoxError, ChunkId, ChunkStore, CommitOutcome, DServerId, FragmentId, Health, MetadataStore,
+    Result, WriteBatch, WriteDeadlineExpired,
+};
+
+/// The clock every pass runs at, and where the D servers' own clock starts.
+const NOW: u64 = 1_000_000;
+/// The reader-safe grace window the GC passes here run with.
+const GRACE: u64 = 50;
+/// How far a leg moves a clock to put it past any write deadline a re-place could carry.
+const ONE_DAY: u64 = 86_400_000;
+/// The orphan grace the deployed GC pass runs with — the 60 s lease TTL it derives its window from
+/// (`crates/server/src/custodian.rs:114`). A write's authorization deadline must fall strictly
+/// inside the grace of the pre-mark it lands under (`G_orphan > W_write + δ_clock`, `0016:1348`).
+const DEPLOYED_GRACE: u64 = 60_000;
+
+/// The bucket and object the session targets, and its epoch.
+const PARENT: InodeId = 42;
+const OBJECT: &str = "staged/object";
+const EPOCH: u64 = 3;
+
+/// The committed part's chunk: `RS(2, 1)`, three fragments on servers 0, 1, 2.
+const CHUNK: ChunkId = 0x663;
+const RS_2_1: EcScheme = EcScheme::ReedSolomon { k: 2, m: 1 };
+const PLACEMENT: [DServerId; 3] = [0, 1, 2];
+/// The fragment each leg loses — index 1, on server 1.
+const LOST: u16 = 1;
+const SOURCE: DServerId = 1;
+/// Where the rebuild goes: domain D, the least-loaded domain free of a survivor (the source's own
+/// domain, B, is kept busy so the rebuild moves).
+const DEST: DServerId = 3;
+/// The next choice, domain E.
+const SPARE: DServerId = 4;
+/// The chunk's bytes.
+const DATA: &[u8] = b"a committed part's chunk, erasure-coded across three D servers, staged";
+
+// ---- the metadata double ------------------------------------------------------------------------
+
+type CommitHook = Box<dyn FnMut(&Meta, &WriteBatch) + Send>;
+
+/// An in-memory `MetadataStore` over an ordered map, whose commits can run a hook once they have
+/// applied — where a leg lands a concurrent writer BETWEEN two of the pass's own commits.
+#[derive(Default)]
+struct Meta {
+    kv: Mutex<BTreeMap<Vec<u8>, Bytes>>,
+    after_commit: Mutex<Option<CommitHook>>,
+}
+
+impl Meta {
+    fn seed(&self, key: impl Into<Vec<u8>>, value: impl Into<Bytes>) {
+        self.kv.lock().unwrap().insert(key.into(), value.into());
+    }
+
+    fn value(&self, key: &[u8]) -> Option<Bytes> {
+        self.kv.lock().unwrap().get(key).cloned()
+    }
+
+    /// Apply `batch` atomically: every precondition holds, or nothing changes.
+    fn apply(&self, batch: WriteBatch) -> CommitOutcome {
+        let mut kv = self.kv.lock().unwrap();
+        for pre in &batch.preconditions {
+            if kv.get(&pre.key) != pre.expected.as_ref() {
+                return CommitOutcome::Conflict;
+            }
+        }
+        for key in batch.deletes {
+            kv.remove(&key);
+        }
+        for (key, value) in batch.puts {
+            kv.insert(key, value);
+        }
+        CommitOutcome::Committed
+    }
+
+    fn after_commit(&self, hook: impl FnMut(&Meta, &WriteBatch) + Send + 'static) {
+        *self.after_commit.lock().unwrap() = Some(Box::new(hook));
+    }
+}
+
+#[async_trait]
+impl MetadataStore for Meta {
+    async fn get(&self, key: &[u8]) -> Result<Option<Bytes>> {
+        Ok(self.value(key))
+    }
+
+    async fn scan(&self, prefix: &[u8]) -> Result<Vec<(Vec<u8>, Bytes)>> {
+        Ok(self
+            .kv
+            .lock()
+            .unwrap()
+            .range::<[u8], _>((Bound::Included(prefix), Bound::Unbounded))
+            .take_while(|(key, _)| key.starts_with(prefix))
+            .map(|(key, value)| (key.clone(), value.clone()))
+            .collect())
+    }
+
+    async fn scan_page(
+        &self,
+        prefix: &[u8],
+        after: Option<&[u8]>,
+        limit: usize,
+    ) -> Result<wyrd_traits::ScanPage> {
+        wyrd_testkit::test_double_scan_page(self, prefix, after, limit).await
+    }
+
+    async fn commit(&self, batch: WriteBatch) -> Result<CommitOutcome> {
+        let outcome = self.apply(batch.clone());
+        if outcome == CommitOutcome::Committed {
+            let hook = self.after_commit.lock().unwrap().take();
+            if let Some(mut hook) = hook {
+                hook(self, &batch);
+                *self.after_commit.lock().unwrap() = Some(hook);
+            }
+        }
+        Ok(outcome)
+    }
+}
+
+// ---- the D-server double ------------------------------------------------------------------------
+
+/// Where in a `put_fragment` a D-server hook runs.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+enum Stage {
+    /// The write has arrived; nothing is judged or written yet.
+    Arrived,
+    /// The write has landed.
+    Written,
+}
+
+type PutHook = Box<dyn FnMut(Stage) -> Result<()> + Send>;
+
+/// What one `put_fragment` met.
+#[derive(Clone, Debug)]
+struct Put {
+    frag: FragmentId,
+    /// The authorization deadline the write carried.
+    deadline: Option<u64>,
+    /// The `orphan:` value the metadata store held for this position when the write arrived.
+    mark_on_arrival: Option<Bytes>,
+    /// Whether the write took effect.
+    landed: bool,
+}
+
+/// One D server: its fragments, the clock its deadline judgment reads, the writes that reached it,
+/// and an optional hook a leg lands a concurrent writer — or a fault — with.
+struct Disk {
+    id: DServerId,
+    meta: Arc<Meta>,
+    clock: Arc<AtomicU64>,
+    frags: Mutex<HashMap<FragmentId, Bytes>>,
+    puts: Mutex<Vec<Put>>,
+    on_put: Mutex<Option<PutHook>>,
+}
+
+impl Disk {
+    fn hook(&self, stage: Stage) -> Result<()> {
+        let hook = self.on_put.lock().unwrap().take();
+        let Some(mut hook) = hook else {
+            return Ok(());
+        };
+        let result = hook(stage);
+        *self.on_put.lock().unwrap() = Some(hook);
+        result
+    }
+}
+
+#[async_trait]
+impl ChunkStore for Disk {
+    async fn put_fragment(
+        &self,
+        id: FragmentId,
+        fragment: Bytes,
+        deadline_millis: Option<u64>,
+    ) -> Result<()> {
+        let mut put = Put {
+            frag: id,
+            deadline: deadline_millis,
+            mark_on_arrival: self.meta.value(&orphan_key(self.id, id)),
+            landed: false,
+        };
+        if let Err(fault) = self.hook(Stage::Arrived) {
+            self.puts.lock().unwrap().push(put);
+            return Err(fault);
+        }
+        // The acceptor's own judgment, at its publication point, through the seam's one
+        // comparison (`ChunkStore::put_fragment`, #638).
+        if let Some(deadline) = deadline_millis {
+            let now = self.clock.load(Ordering::SeqCst);
+            if let Some(refusal) = WriteDeadlineExpired::if_elapsed(id, deadline, now) {
+                self.puts.lock().unwrap().push(put);
+                return Err(BoxError::from(refusal));
+            }
+        }
+        self.frags.lock().unwrap().insert(id, fragment);
+        put.landed = true;
+        self.puts.lock().unwrap().push(put);
+        self.hook(Stage::Written)
+    }
+
+    async fn get_fragment(&self, id: FragmentId) -> Result<Option<Bytes>> {
+        Ok(self.frags.lock().unwrap().get(&id).cloned())
+    }
+
+    async fn list_fragments(&self) -> Result<Vec<FragmentId>> {
+        Ok(self.frags.lock().unwrap().keys().copied().collect())
+    }
+
+    async fn delete_fragment(&self, id: FragmentId) -> Result<()> {
+        self.frags.lock().unwrap().remove(&id);
+        Ok(())
+    }
+
+    async fn health(&self) -> Result<Health> {
+        Ok(Health::Healthy)
+    }
+}
+
+// ---- the audit seam -----------------------------------------------------------------------------
+
+/// One custodian audit event: its target, and the value of each of its fields.
+type AuditEvent = (String, Vec<String>);
+
+/// Every custodian audit event a pass emitted.
+#[derive(Clone, Default)]
+struct Audit(Arc<Mutex<Vec<AuditEvent>>>);
+
+impl Audit {
+    /// Whether an event on `target` carried `action` and a field naming `record`.
+    fn named(&self, target: &str, action: &str, record: &[u8]) -> bool {
+        let record = String::from_utf8_lossy(record);
+        self.0.lock().unwrap().iter().any(|(at, fields)| {
+            at == target
+                && fields.iter().any(|field| field == action)
+                && fields.iter().any(|field| field.contains(record.as_ref()))
+        })
+    }
+
+    /// How many events on `target` carried `action` and a field naming `record`.
+    fn count(&self, target: &str, action: &str, record: &str) -> usize {
+        self.0
+            .lock()
+            .unwrap()
+            .iter()
+            .filter(|(at, fields)| {
+                at == target
+                    && fields.iter().any(|field| field == action)
+                    && fields.iter().any(|field| field.contains(record))
+            })
+            .count()
+    }
+}
+
+impl<S: tracing::Subscriber> tracing_subscriber::Layer<S> for Audit {
+    fn on_event(&self, event: &tracing::Event<'_>, _ctx: Context<'_, S>) {
+        let target = event.metadata().target();
+        if !target.starts_with("wyrd.custodian.") {
+            return;
+        }
+        let mut fields = Fields(Vec::new());
+        event.record(&mut fields);
+        self.0.lock().unwrap().push((target.to_owned(), fields.0));
+    }
+}
+
+struct Fields(Vec<String>);
+
+impl Visit for Fields {
+    fn record_str(&mut self, _field: &Field, value: &str) {
+        self.0.push(value.to_owned());
+    }
+
+    fn record_debug(&mut self, _field: &Field, value: &dyn Debug) {
+        self.0.push(format!("{value:?}"));
+    }
+}
+
+/// Install a permissive global `tracing` default once, before any audit callsite fires, so no
+/// callsite latches `Interest::never` under the parallel harness and a scoped capture sees every
+/// event (the reason `crates/custodian/tests/reconstruction.rs` does the same).
+fn enable_callsites() {
+    static INIT: Once = Once::new();
+    INIT.call_once(|| {
+        let _ = tracing::subscriber::set_global_default(tracing_subscriber::registry());
+    });
+}
+
+const RECONSTRUCTION_AUDIT: &str = "wyrd.custodian.reconstruction.audit";
+const SCRUB_AUDIT: &str = "wyrd.custodian.scrub.audit";
+
+// ---- the records --------------------------------------------------------------------------------
+
+fn upload(pair: &str) -> UploadId {
+    UploadId::new(pair.repeat(16)).expect("32 lowercase-hex characters")
+}
+
+fn part_no(n: u32) -> PartNumber {
+    PartNumber::new(n).expect("a part number in range")
+}
+
+/// A session record, spelled as the base decoder's own encoding and round-tripped through it.
+fn session(epoch: u64, state_json: &str) -> Bytes {
+    let bytes = format!(
+        "{{\"parent\":{PARENT},\"object\":\"{OBJECT}\",\"created_at_millis\":100,\
+         \"clock_source\":\"wall\",\"epoch\":{epoch},\"attempts\":1,\"state\":{state_json}}}"
+    )
+    .into_bytes();
+    let record = decode_session_record(&bytes)
+        .unwrap_or_else(|fault| panic!("the seeded session must decode: {fault}"));
+    assert_eq!(
+        metadata::encode(&record).as_ref(),
+        bytes.as_slice(),
+        "the seeded session must be the decoder's own spelling"
+    );
+    Bytes::from(bytes)
+}
+
+/// The session `Open` at [`EPOCH`].
+fn open() -> Bytes {
+    session(EPOCH, "{\"kind\":\"Open\"}")
+}
+
+/// The same session fenced for teardown: `Aborting` at the next epoch.
+fn aborting() -> Bytes {
+    session(EPOCH + 1, "{\"kind\":\"Aborting\"}")
+}
+
+/// The same session fenced for Complete: `Completing` at the next epoch.
+fn completing() -> Bytes {
+    session(
+        EPOCH + 1,
+        &format!(
+            "{{\"kind\":\"Completing\",\"fenced_at_millis\":900,\"segments_written\":0,\
+             \"publish_target\":{{\"parent\":{PARENT},\"name\":\"{OBJECT}\",\"epoch\":{}}}}}",
+            EPOCH + 1
+        ),
+    )
+}
+
+fn chunk_ref(id: ChunkId, placement: &[DServerId]) -> ChunkRef {
+    ChunkRef {
+        id,
+        scheme: RS_2_1,
+        len: DATA.len() as u64,
+        placement: placement.to_vec(),
+    }
+}
+
+/// A committed part record naming `chunks`, spelled as the base decoder's own encoding and
+/// round-tripped through it.
+fn part(chunks: &[ChunkRef], committed_at: u64) -> Bytes {
+    let refs: Vec<String> = chunks
+        .iter()
+        .map(|chunk| String::from_utf8(metadata::encode(chunk).to_vec()).unwrap())
+        .collect();
+    let len: u64 = chunks.iter().map(|chunk| chunk.len).sum();
+    let bytes = format!(
+        "{{\"chunks\":[{}],\"len\":{len},\"digest\":\"{}\",\"committed_at_millis\":{committed_at},\
+         \"session_epoch\":{EPOCH}}}",
+        refs.join(","),
+        "ef".repeat(32)
+    )
+    .into_bytes();
+    let record = decode_part_record(&bytes)
+        .unwrap_or_else(|fault| panic!("the seeded part record must decode: {fault}"));
+    assert_eq!(
+        metadata::encode(&record).as_ref(),
+        bytes.as_slice(),
+        "the seeded part record must be the decoder's own spelling"
+    );
+    Bytes::from(bytes)
+}
+
+/// The three fragments of [`DATA`] under `RS(2, 1)`, as the write path encodes them.
+fn fragments(chunk: ChunkId) -> Vec<Bytes> {
+    erasure::encode(2, 1, DATA)
+        .unwrap()
+        .iter()
+        .enumerate()
+        .map(|(index, shard)| encode_ec_fragment(chunk, index as u16, 2, 1, shard))
+        .collect()
+}
+
+/// `bytes` with a single bit flipped in the payload: its checksum no longer matches (the
+/// `corrupt_fragment` idiom, `crates/custodian/tests/scrub.rs:154-160`).
+fn bit_flipped(bytes: &Bytes) -> Bytes {
+    let mut rotten = bytes.to_vec();
+    rotten[CORE_HEADER_LEN as usize] ^= 0x01;
+    Bytes::from(rotten)
+}
+
+fn frag(chunk: ChunkId, index: u16) -> FragmentId {
+    FragmentId { chunk, index }
+}
+
+/// A structured mark, spelled by the shared codec's own grammar.
+fn structured_mark(at: u64, event: &str) -> Bytes {
+    Bytes::from(format!(
+        "{{\"orphaned_at_millis\":{at},\"event\":\"{event}\"}}"
+    ))
+}
+
+// ---- the fixture --------------------------------------------------------------------------------
+
+/// Five D servers in five failure domains, A..E. One `Open` session with one committed part naming
+/// [`CHUNK`] on [`PLACEMENT`], every fragment on its server — nothing lost yet.
+struct Fixture {
+    meta: Arc<Meta>,
+    clock: Arc<AtomicU64>,
+    disks: Vec<Disk>,
+    upload: UploadId,
+    /// The part record exactly as seeded.
+    part: Bytes,
+    /// The chunk's three original fragments.
+    fragments: Vec<Bytes>,
+    /// Only domains A..C: no free domain but the lost fragment's own.
+    tight: bool,
+    /// A server the topology still lists but this pass's fleet view left out.
+    off_fleet: Option<DServerId>,
+}
+
+impl Fixture {
+    fn new() -> Self {
+        let meta = Arc::new(Meta::default());
+        let clock = Arc::new(AtomicU64::new(NOW));
+        let disks = (0..5)
+            .map(|id| Disk {
+                id,
+                meta: Arc::clone(&meta),
+                clock: Arc::clone(&clock),
+                frags: Mutex::default(),
+                puts: Mutex::default(),
+                on_put: Mutex::default(),
+            })
+            .collect();
+        let upload = upload("66");
+        let part = part(&[chunk_ref(CHUNK, &PLACEMENT)], 800);
+        meta.seed(mpu_key(&upload), open());
+        meta.seed(part_key(&upload, part_no(1)), part.clone());
+        let fixture = Self {
+            meta,
+            clock,
+            disks,
+            upload,
+            part,
+            fragments: fragments(CHUNK),
+            tight: false,
+            off_fleet: None,
+        };
+        for (index, &dserver) in PLACEMENT.iter().enumerate() {
+            fixture.place(
+                dserver,
+                frag(CHUNK, index as u16),
+                fixture.fragments[index].clone(),
+            );
+        }
+        fixture
+    }
+
+    /// The fixture over only domains A..C, so the lost fragment can only be rebuilt in place.
+    fn tight() -> Self {
+        Self {
+            tight: true,
+            ..Self::new()
+        }
+    }
+
+    fn place(&self, dserver: DServerId, frag: FragmentId, bytes: Bytes) {
+        self.disks[dserver as usize]
+            .frags
+            .lock()
+            .unwrap()
+            .insert(frag, bytes);
+    }
+
+    fn on_disk(&self, dserver: DServerId, frag: FragmentId) -> Option<Bytes> {
+        self.disks[dserver as usize]
+            .frags
+            .lock()
+            .unwrap()
+            .get(&frag)
+            .cloned()
+    }
+
+    fn remove(&self, dserver: DServerId, frag: FragmentId) {
+        self.disks[dserver as usize]
+            .frags
+            .lock()
+            .unwrap()
+            .remove(&frag);
+    }
+
+    /// Flip one bit of the [`LOST`] fragment on its server.
+    fn rot(&self) {
+        let lost = frag(CHUNK, LOST);
+        let rotten = bit_flipped(&self.on_disk(SOURCE, lost).unwrap());
+        self.place(SOURCE, lost, rotten);
+    }
+
+    /// Delete the [`LOST`] fragment from its server.
+    fn lose(&self) {
+        self.remove(SOURCE, frag(CHUNK, LOST));
+    }
+
+    fn puts(&self, dserver: DServerId) -> Vec<Put> {
+        self.disks[dserver as usize].puts.lock().unwrap().clone()
+    }
+
+    fn all_puts(&self) -> Vec<(DServerId, Put)> {
+        (0..5)
+            .flat_map(|dserver| {
+                self.puts(dserver)
+                    .into_iter()
+                    .map(move |put| (dserver, put))
+            })
+            .collect()
+    }
+
+    fn on_put(&self, dserver: DServerId, hook: impl FnMut(Stage) -> Result<()> + Send + 'static) {
+        *self.disks[dserver as usize].on_put.lock().unwrap() = Some(Box::new(hook));
+    }
+
+    fn part_key(&self) -> Vec<u8> {
+        part_key(&self.upload, part_no(1))
+    }
+
+    fn session_key(&self) -> Vec<u8> {
+        mpu_key(&self.upload)
+    }
+
+    /// The part record the store holds now, decoded, and its chunk's placement.
+    fn placement(&self) -> Vec<DServerId> {
+        let bytes = self.meta.value(&self.part_key()).expect("the part record");
+        let record = decode_part_record(&bytes).expect("the part record decodes");
+        record.chunks()[0].placement.clone()
+    }
+
+    fn mark(&self, dserver: DServerId, frag: FragmentId) -> Option<Bytes> {
+        self.meta.value(&orphan_key(dserver, frag))
+    }
+
+    async fn enqueue(&self, chunk: ChunkId) {
+        repair::enqueue_repair(&*self.meta, chunk, "scrub")
+            .await
+            .unwrap();
+    }
+
+    async fn queued(&self) -> Vec<ChunkId> {
+        repair::queued_repairs(&*self.meta).await.unwrap()
+    }
+
+    fn fleet(&self) -> Vec<(DServerId, &dyn ChunkStore)> {
+        let servers = if self.tight { 3 } else { 5 };
+        self.disks[..servers]
+            .iter()
+            .filter(|disk| Some(disk.id) != self.off_fleet)
+            .map(|disk| (disk.id, disk as &dyn ChunkStore))
+            .collect()
+    }
+
+    /// Domains A..E on servers 0..4 (A..C when `tight`), the source's domain kept busy so the
+    /// rebuild moves to the least-loaded free one when there is one.
+    fn topology(&self) -> Topology {
+        let mut topology = Topology::default();
+        let domains = ["A", "B", "C", "D", "E"];
+        let servers = if self.tight { 3 } else { 5 };
+        for (id, domain) in domains.iter().enumerate().take(servers) {
+            topology.register(id as DServerId, *domain);
+        }
+        topology.set_utilization(SOURCE, 100);
+        topology
+    }
+
+    /// One reconstruction pass at `now`, its audit events captured.
+    async fn reconstruct(
+        &self,
+        now: u64,
+    ) -> (std::result::Result<Reconciled, ReconcileError>, Audit) {
+        enable_callsites();
+        let audit = Audit::default();
+        let (zone, custodian) = elect().await;
+        let fleet = self.fleet();
+        let topology = self.topology();
+        let ctx = ReconstructionContext {
+            meta: &*self.meta,
+            fleet: &fleet,
+            topology: &topology,
+            unreachable: &[],
+        };
+        let outcome = reconcile_step(&zone, &custodian, None, None, Some(&ctx), None, now)
+            .with_subscriber(tracing_subscriber::registry().with(audit.clone()))
+            .await;
+        (outcome, audit)
+    }
+
+    /// One reconstruction pass at `now` that must succeed.
+    async fn repaired(&self, now: u64) -> Reconciled {
+        self.reconstruct(now)
+            .await
+            .0
+            .unwrap_or_else(|fault| panic!("the reconstruction pass failed: {fault}"))
+    }
+
+    async fn scrub(&self) -> Reconciled {
+        self.scrub_audited().await.0
+    }
+
+    /// One scrub pass that must succeed, its audit events captured.
+    async fn scrub_audited(&self) -> (Reconciled, Audit) {
+        enable_callsites();
+        let audit = Audit::default();
+        let (zone, custodian) = elect().await;
+        let fleet = self.fleet();
+        let ctx = ScrubContext {
+            meta: &*self.meta,
+            fleet: &fleet,
+        };
+        let outcome = reconcile_step(&zone, &custodian, None, Some(&ctx), None, None, NOW)
+            .with_subscriber(tracing_subscriber::registry().with(audit.clone()))
+            .await
+            .unwrap_or_else(|fault| panic!("the scrub pass failed: {fault}"));
+        (outcome, audit)
+    }
+
+    async fn gc(&self, now: u64) -> Reconciled {
+        let (zone, custodian) = elect().await;
+        let fleet = self.fleet();
+        let ctx = GcContext {
+            meta: &*self.meta,
+            fleet: &fleet,
+            grace_window_millis: GRACE,
+            expired_pending: ExpiredPendingPolicy::Defer,
+        };
+        reconcile_step(&zone, &custodian, Some(&ctx), None, None, None, now)
+            .await
+            .unwrap_or_else(|fault| panic!("the GC pass failed: {fault}"))
+    }
+}
+
+async fn elect() -> (FencedZone, Custodian) {
+    let coord = MemCoordination::new();
+    let custodian = Custodian::elect(&coord, "zone-staged-repair")
+        .await
+        .expect("leader election over the in-memory coordination seam");
+    let mut zone = FencedZone::new();
+    zone.install(custodian.leadership());
+    (zone, custodian)
+}
+
+/// A pre-mark as a write found it: a structured mark this pass stamped at `now`, not `reclaiming`,
+/// naming an event other than `not_event`.
+fn assert_fresh_premark(found: Option<&Bytes>, now: u64, not_event: Option<&str>, what: &str) {
+    let found = found.unwrap_or_else(|| panic!("{what}: no orphan mark covered the destination"));
+    let mark = decode_orphan_mark(found)
+        .unwrap_or_else(|fault| panic!("{what}: the destination mark does not decode: {fault}"));
+    assert!(
+        !mark.is_reclaiming(),
+        "{what}: the pre-mark is `reclaiming`"
+    );
+    assert_eq!(
+        mark.orphaned_at_millis(),
+        now,
+        "{what}: the pre-mark is not stamped by the pass that wrote it: {found:?}"
+    );
+    let event = mark
+        .event()
+        .unwrap_or_else(|| panic!("{what}: the pre-mark names no event: {found:?}"));
+    assert_ne!(
+        Some(event),
+        not_event,
+        "{what}: the pre-mark kept an earlier event's identity"
+    );
+}
+
+/// The destination fragment is the chunk's own fragment at [`LOST`]: intact, and carrying the
+/// chunk's identity and scheme in its header — rebuilt, not merely present.
+fn assert_rebuilt(fixture: &Fixture, dserver: DServerId) {
+    let lost = frag(CHUNK, LOST);
+    let bytes = fixture
+        .on_disk(dserver, lost)
+        .unwrap_or_else(|| panic!("server {dserver} holds no fragment {lost:?}"));
+    let decoded = wyrd_chunk_format::decode(&bytes)
+        .unwrap_or_else(|fault| panic!("the rebuilt fragment does not decode: {fault}"));
+    assert!(
+        header_matches_identity(&decoded.header, lost, RS_2_1),
+        "the rebuilt fragment's header does not carry the chunk's identity: {:?}",
+        decoded.header
+    );
+    assert_eq!(
+        bytes,
+        fixture.fragments[usize::from(LOST)],
+        "the rebuilt fragment is not the chunk's original fragment, byte for byte"
+    );
+}
+
+// ---- (A) scrub verifies committed-part fragments ------------------------------------------------
+
+/// **(A)** A committed part's fragment carrying a single bit flip results, after one scrub pass, in
+/// a queued repair for its chunk. On the base scrub never reads a part record.
+#[tokio::test]
+async fn a_scrub_queues_repair_for_a_bit_flipped_committed_part_fragment() {
+    let fixture = Fixture::new();
+    fixture.rot();
+    assert_eq!(fixture.scrub().await, Reconciled::Changed);
+    assert_eq!(fixture.queued().await, vec![CHUNK]);
+}
+
+/// **(A)** A committed part's fragment missing from its placed server results in a queued repair.
+#[tokio::test]
+async fn a_scrub_queues_repair_for_a_missing_committed_part_fragment() {
+    let fixture = Fixture::new();
+    fixture.lose();
+    assert_eq!(fixture.scrub().await, Reconciled::Changed);
+    assert_eq!(fixture.queued().await, vec![CHUNK]);
+}
+
+/// **(A)** A still-streaming chunk — named by an owned `sidx:` entry, by no part record — missing a
+/// fragment queues nothing: it is expected to be incomplete, and the scheme to verify it by is the
+/// one its part record will carry (`0016:824`). Beside it, the committed part's bit-flipped
+/// fragment IS queued, so the pass verified staged bytes and chose not to flag this one.
+#[tokio::test]
+async fn a_scrub_queues_nothing_for_a_still_streaming_chunk() {
+    const IN_FLIGHT: ChunkId = 0x664;
+    let fixture = Fixture::new();
+    fixture.rot();
+    let key = sidx_key(&fixture.upload, part_no(2), IN_FLIGHT);
+    let staged = StagedPlacement::new(RS_2_1, PLACEMENT.to_vec()).unwrap();
+    let value =
+        metadata::encode(&OwnedEntry::new(fixture.upload.clone(), NOW * 10, staged).to_pending());
+    decode_owned_entry(&key, &value).expect("the seeded owned entry must decode");
+    fixture.meta.seed(key, value);
+    // Two of its three fragments have landed; the third is still streaming.
+    let streaming = fragments(IN_FLIGHT);
+    fixture.place(0, frag(IN_FLIGHT, 0), streaming[0].clone());
+    fixture.place(2, frag(IN_FLIGHT, 2), streaming[2].clone());
+
+    assert_eq!(fixture.scrub().await, Reconciled::Changed);
+    assert_eq!(
+        fixture.queued().await,
+        vec![CHUNK],
+        "scrub queued the still-streaming chunk, or missed the committed part's rotten fragment"
+    );
+}
+
+/// **(A → B)** End to end: the repair scrub queues for a committed part's rotten fragment is the
+/// one reconstruction resolves and repairs.
+#[tokio::test]
+async fn a_to_b_scrub_then_reconstruction_restore_the_part() {
+    let fixture = Fixture::new();
+    fixture.rot();
+    assert_eq!(fixture.scrub().await, Reconciled::Changed);
+    assert_eq!(fixture.repaired(NOW).await, Reconciled::Changed);
+    assert_rebuilt(&fixture, DEST);
+    assert_eq!(fixture.placement(), vec![0, DEST, 2]);
+    assert!(fixture.queued().await.is_empty());
+    // Scrubbed again, the part is whole: nothing is queued.
+    assert_eq!(fixture.scrub().await, Reconciled::Satisfied);
+    assert!(fixture.queued().await.is_empty());
+}
+
+// ---- (B) reconstruction repairs a staged chunk, the whole protocol ------------------------------
+
+/// **(B)** With a committed part's fragment lost and its repair queued, one reconstruction pass:
+/// the new D server holds the chunk's fragment, intact and scheme-correct; the part record's
+/// placement names that server; the destination's pre-mark is gone; the vacated source carries an
+/// `orphan:` mark GC acts on after grace — and does; the obligation has drained. On the base the
+/// obligation is dropped and nothing is written.
+#[tokio::test]
+async fn b_reconstruction_re_places_a_committed_parts_lost_fragment() {
+    let fixture = Fixture::new();
+    fixture.rot();
+    fixture.enqueue(CHUNK).await;
+
+    assert_eq!(fixture.repaired(NOW).await, Reconciled::Changed);
+
+    assert_rebuilt(&fixture, DEST);
+    assert_eq!(
+        fixture.placement(),
+        vec![0, DEST, 2],
+        "the part record does not name the server the fragment was rebuilt on"
+    );
+    let lost = frag(CHUNK, LOST);
+    assert_eq!(
+        fixture.mark(DEST, lost),
+        None,
+        "the destination's pre-mark was not consumed by the adoption"
+    );
+    let vacated = fixture
+        .mark(SOURCE, lost)
+        .expect("the vacated source carries no orphan mark");
+    let vacated = decode_orphan_mark(&vacated).expect("the vacated source's mark decodes");
+    assert!(!vacated.is_reclaiming());
+    assert_eq!(vacated.orphaned_at_millis(), NOW);
+    assert!(
+        fixture.queued().await.is_empty(),
+        "the obligation did not drain"
+    );
+    // Exactly one write, and it landed.
+    let puts = fixture.all_puts();
+    assert_eq!(puts.len(), 1, "{puts:?}");
+    assert!(puts[0].1.landed);
+
+    // GC acts on the vacated source's mark once its grace has passed, and on nothing the part
+    // names.
+    assert_eq!(fixture.gc(NOW + GRACE).await, Reconciled::Changed);
+    assert_eq!(
+        fixture.on_disk(SOURCE, lost),
+        None,
+        "GC kept the vacated source"
+    );
+    assert_eq!(fixture.mark(SOURCE, lost), None);
+    assert_rebuilt(&fixture, DEST);
+}
+
+/// **(B)** The same, for a fragment missing from its server rather than rotten on it.
+#[tokio::test]
+async fn b_reconstruction_re_places_a_committed_parts_missing_fragment() {
+    let fixture = Fixture::new();
+    fixture.lose();
+    fixture.enqueue(CHUNK).await;
+    assert_eq!(fixture.repaired(NOW).await, Reconciled::Changed);
+    assert_rebuilt(&fixture, DEST);
+    assert_eq!(fixture.placement(), vec![0, DEST, 2]);
+    assert_eq!(fixture.mark(DEST, frag(CHUNK, LOST)), None);
+    assert!(fixture.mark(SOURCE, frag(CHUNK, LOST)).is_some());
+    assert!(fixture.queued().await.is_empty());
+}
+
+/// **(B)** With no free domain but the lost fragment's own, the rebuild goes back to the same
+/// server: the position stays named, its pre-mark is consumed, and nothing is vacated.
+#[tokio::test]
+async fn b_a_fragment_rebuilt_in_place_consumes_its_pre_mark() {
+    let fixture = Fixture::tight();
+    fixture.rot();
+    fixture.enqueue(CHUNK).await;
+    assert_eq!(fixture.repaired(NOW).await, Reconciled::Changed);
+    assert_rebuilt(&fixture, SOURCE);
+    assert_eq!(fixture.placement(), PLACEMENT.to_vec());
+    assert_eq!(fixture.mark(SOURCE, frag(CHUNK, LOST)), None);
+    assert!(fixture.queued().await.is_empty());
+}
