+/// **(D)(v)** No write is authorized on a stale pre-mark (`0016:1338-1346`). A hook advances the
+/// clock a day past the pre-mark between the pre-mark commit and the write: the write's
+/// authorization was fixed at the pre-mark's own stamp, so the D server refuses it and nothing
+/// lands on the stale pre-mark. The next pass restarts from a FRESH pre-mark, and only that write
+/// is taken.
+#[tokio::test]
+async fn d_v_no_write_is_authorized_on_a_stale_pre_mark() {
+    let fixture = Fixture::new();
+    fixture.lose();
+    fixture.enqueue(CHUNK).await;
+    let lost = frag(CHUNK, LOST);
+    let premark = orphan_key(DEST, lost);
+    let clock = Arc::clone(&fixture.clock);
+    fixture.meta.after_commit(move |_meta, batch| {
+        if batch.puts.iter().any(|(key, _)| *key == premark) {
+            clock.fetch_add(ONE_DAY, Ordering::SeqCst);
+        }
+    });
+
+    let stale = fixture.repaired(NOW).await;
+    assert_ne!(stale, Reconciled::Changed);
+    let puts = fixture.puts(DEST);
+    assert_eq!(puts.len(), 1, "{puts:?}");
+    assert!(!puts[0].landed, "a write landed on a pre-mark a day old");
+    assert_eq!(fixture.on_disk(DEST, lost), None);
+    assert_eq!(fixture.queued().await, vec![CHUNK]);
+
+    let later = NOW + ONE_DAY;
+    fixture.meta.after_commit(|_meta, _batch| {});
+    assert_eq!(fixture.repaired(later).await, Reconciled::Changed);
+    let puts = fixture.puts(DEST);
+    assert_eq!(puts.len(), 2, "{puts:?}");
+    assert!(puts[1].landed);
+    assert_fresh_premark(puts[1].mark_on_arrival.as_ref(), later, None, "the retry");
+    assert!(puts[1].deadline.is_some_and(|deadline| deadline > later));
+    assert_rebuilt(&fixture, DEST);
+    assert_eq!(fixture.placement(), vec![0, DEST, 2]);
+    assert!(fixture.queued().await.is_empty());
+}
