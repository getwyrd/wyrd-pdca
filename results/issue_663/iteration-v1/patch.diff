+                referenced || evidenced,
+                "fragment {fragment:?} on server {id} is neither named nor marked (fence at \
+                 {delay_millis} ms): {events:?}"
+            );
+        }
+    }
+    // THE ABORTING SESSION'S PART RECORD NAMES NO FRAGMENT THAT WAS NOT WRITTEN: every position it
+    // names holds its fragment, and one the re-place moved it to holds the intact rebuild.
+    for (index, &server) in placement.iter().enumerate() {
+        let fragment = replace_frag(index as u16);
+        let held = d[server as usize]
+            .get_fragment(fragment)
+            .await
+            .unwrap()
+            .unwrap_or_else(|| {
+                panic!(
+                    "the part record names {fragment:?} on server {server}, which holds nothing \
+                     (fence at {delay_millis} ms): {events:?}"
+                )
+            });
+        if server != original[index] {
+            assert!(
+                repair::fragment_intact(&held, fragment, scheme),
+                "the part record was moved onto a fragment that is not the rebuild (fence at \
+                 {delay_millis} ms): {events:?}"
+            );
+        }
+    }
+    // The obligation goes only with the repair that satisfies it.
+    let queued = repair::queued_repairs(&*meta)
+        .await
+        .unwrap()
+        .contains(&REPLACE_CHUNK);
+    assert_eq!(
+        queued, !adopted,
+        "the obligation outlived the repair, or went without one (fence at {delay_millis} ms): \
+         {events:?}"
+    );
+    fence_window(&events)
+}
+
+/// The campaign leg: the seed picks where the fence lands, so 50 seeds sweep the re-place.
+async fn prop_staged_replace_never_strands_under_a_fence(rng: &mut ChaCha8Rng) {
+    let delay = u64::from(rng.next_u32() % (REPLACE_SPAN + 1));
+    replace_under_a_fence(delay).await;
+}
+
+/// **Every window is genuinely REACHED.** Walks the fence across the whole span, asserting the
+/// invariants at every point, then asserts that the fence landed before the pre-mark in some run,
+/// between the pre-mark and the write in another, between the write and the adoption in another,
+/// and after the adoption in another. Without it, a span that drifted away from the re-place would
+/// leave the campaign green with nothing behind it.
+async fn prop_staged_replace_reaches_every_fence_window() {
+    let mut reached = Vec::new();
+    for delay in 0..=u64::from(REPLACE_SPAN) {
+        let window = replace_under_a_fence(delay).await;
+        if !reached.contains(&window) {
+            reached.push(window);
+        }
+    }
+    for window in FenceWindow::ALL {
+        assert!(
+            reached.contains(&window),
+            "no fence in 0..={REPLACE_SPAN} ms landed {window:?}: reached only {reached:?}"
+        );
+    }
+}
