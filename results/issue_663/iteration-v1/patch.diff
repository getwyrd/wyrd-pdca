+// ---- (C) the losing branch leaves nothing stranded ----------------------------------------------
+
+/// What a lost re-place must leave: no adoption, the part record as it was, the pre-mark standing
+/// over the written fragment, the obligation queued — and GC reclaiming that fragment once the
+/// pre-mark's grace has passed, so it is never stranded.
+async fn assert_lost_cleanly(fixture: &Fixture, part_now: &Bytes, what: &str) {
+    let lost = frag(CHUNK, LOST);
+    assert_eq!(
+        fixture.meta.value(&fixture.part_key()).as_ref(),
+        Some(part_now),
+        "{what}: the part record changed"
+    );
+    assert!(
+        fixture.on_disk(DEST, lost).is_some(),
+        "{what}: the fragment was never written — this leg fenced nothing"
+    );
+    assert_fresh_premark(fixture.mark(DEST, lost).as_ref(), NOW, None, what);
+    assert_eq!(
+        fixture.queued().await,
+        vec![CHUNK],
+        "{what}: the obligation did not stay queued"
+    );
+    fixture.gc(NOW + GRACE).await;
+    assert_eq!(
+        fixture.on_disk(DEST, lost),
+        None,
+        "{what}: GC did not reclaim the written fragment under its pre-mark"
+    );
+    assert_eq!(fixture.mark(DEST, lost), None);
+}
+
+/// **(C, X29 `0016:888`)** The D server's hook fences the session — `Open@E` to `Aborting@E+1` —
+/// after the destination fragment is written and before the adoption CAS. The re-place adopts
+/// nothing, the part record is byte-identical, the pre-mark stands so GC reclaims the written
+/// fragment, and the obligation stays queued.
+#[tokio::test]
+async fn c_a_session_fence_after_the_write_strands_nothing() {
+    let fixture = Fixture::new();
+    fixture.rot();
+    fixture.enqueue(CHUNK).await;
+    let meta = Arc::clone(&fixture.meta);
+    let session_key = fixture.session_key();
+    fixture.on_put(DEST, move |stage| {
+        if stage == Stage::Written {
+            let fence = WriteBatch::new()
+                .require(session_key.clone(), open())
+                .put(session_key.clone(), aborting());
+            assert_eq!(meta.apply(fence), CommitOutcome::Committed);
+        }
+        Ok(())
+    });
+
+    let outcome = fixture.repaired(NOW).await;
+    assert_ne!(
+        outcome,
+        Reconciled::Changed,
+        "a lost re-place reported a repair"
+    );
+    assert_lost_cleanly(&fixture, &fixture.part.clone(), "session fenced").await;
+}
+
+/// **(C)** The same, with the part record rewritten instead of the session fenced:
+/// `require(part == prior)` loses.
+#[tokio::test]
+async fn c_a_part_rewrite_after_the_write_strands_nothing() {
+    let fixture = Fixture::new();
+    fixture.rot();
+    fixture.enqueue(CHUNK).await;
+    let rewritten = part(&[chunk_ref(CHUNK, &PLACEMENT)], 801);
+    let meta = Arc::clone(&fixture.meta);
+    let (key, prior, next) = (fixture.part_key(), fixture.part.clone(), rewritten.clone());
+    fixture.on_put(DEST, move |stage| {
+        if stage == Stage::Written {
+            let rewrite = WriteBatch::new()
+                .require(key.clone(), prior.clone())
+                .put(key.clone(), next.clone());
+            assert_eq!(meta.apply(rewrite), CommitOutcome::Committed);
+        }
+        Ok(())
+    });
+
+    let outcome = fixture.repaired(NOW).await;
+    assert_ne!(
+        outcome,
+        Reconciled::Changed,
+        "a lost re-place reported a repair"
+    );
+    assert_lost_cleanly(&fixture, &rewritten, "part rewritten").await;
+}
