+// ---- a position ruled out rules out that position, not its server --------------------------------
+
+/// A position ruled out leaves its server free to take another of the chunk's lost fragments. An
+/// `RS(2, 2)` chunk on servers 0..3 (domains A..D) loses fragments 2 and 3; domain E is draining,
+/// so C and D — the lost fragments' own servers — are the only free domains; and one of the two
+/// positions the selector's own pick would use carries a stale `reclaiming` mark: fragment 2's on
+/// server 2 (the first pick's), or fragment 3's on server 3 (the second pick's, which makes the
+/// choice move fragment 2 off the server it already holds). Ruling the marked server out whole
+/// would leave one free domain for two fragments, and the repair would stall on every pass. The
+/// servers swap instead — fragment 2 to server 3, fragment 3 to server 2 — and ONE pass rebuilds
+/// both, leaving the `reclaiming` mark untouched.
+#[tokio::test]
+async fn a_ruled_out_position_leaves_its_server_free_for_another_fragment() {
+    const WIDE: ChunkId = 0x66b;
+    const RS_2_2: EcScheme = EcScheme::ReedSolomon { k: 2, m: 2 };
+    for (stale_server, stale_index) in [(2, 2), (3, 3)] {
+        let label = format!("stale mark at fragment {stale_index} on server {stale_server}");
+        let fixture = Fixture::new();
+        let wide = ChunkRef {
+            id: WIDE,
+            scheme: RS_2_2,
+            len: DATA.len() as u64,
+            placement: vec![0, 1, 2, 3],
+        };
+        fixture.meta.seed(
+            part_key(&fixture.upload, part_no(2)),
+            part(std::slice::from_ref(&wide), 800),
+        );
+        let originals = fragments(WIDE, 2, 2);
+        fixture.place(0, frag(WIDE, 0), originals[0].clone());
+        fixture.place(1, frag(WIDE, 1), originals[1].clone());
+        set_lifecycle(&*fixture.meta, SPARE, DServerLifecycle::Draining)
+            .await
+            .unwrap();
+        let stale = orphan_key(stale_server, frag(WIDE, stale_index));
+        let decided = reclaiming_mark();
+        fixture.meta.seed(stale.clone(), decided.clone());
+        fixture.enqueue(WIDE).await;
+
+        let (outcome, audit) = fixture.reconstruct().await;
+        assert_eq!(
+            outcome.unwrap(),
+            Reconciled::Changed,
+            "{label}: one ruled-out position blocked a repair a swap completes"
+        );
+        assert_eq!(fixture.placement_in(2, 0), vec![0, 1, 3, 2], "{label}");
+        assert_rebuilt_as(&fixture, 3, frag(WIDE, 2), RS_2_2, &originals[2]);
+        assert_rebuilt_as(&fixture, 2, frag(WIDE, 3), RS_2_2, &originals[3]);
+        assert_eq!(
+            fixture.mark(stale_server, frag(WIDE, stale_index)),
+            Some(decided)
+        );
+        assert_eq!(
+            fixture.mark(3, frag(WIDE, 2)),
+            None,
+            "{label}: a pre-mark was left"
+        );
+        assert_eq!(
+            fixture.mark(2, frag(WIDE, 3)),
+            None,
+            "{label}: a pre-mark was left"
+        );
+        assert!(fixture.queued().await.is_empty(), "{label}");
+        assert!(
+            audit.named(RECONSTRUCTION_AUDIT, "destination-passed-over", &stale),
+            "{label}"
+        );
+        // The selector's own pick for both fragments held the answer, so the draining server
+        // beyond it was never even considered.
+        assert!(
+            !audit.named(
+                RECONSTRUCTION_AUDIT,
+                "destination-passed-over",
+                b"desired-state"
+            ),
+            "{label}: the choice considered a server the selector's own pick did not need"
+        );
+    }
+}
