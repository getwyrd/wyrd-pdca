+    fixture.enqueue(STREAMING).await;
+    let (outcome, _audit) = fixture.reconstruct().await;
+    assert_eq!(outcome.unwrap(), Reconciled::Satisfied);
+    assert_eq!(
+        fixture.queued().await,
+        vec![STREAMING],
+        "the obligation was dropped"
+    );
