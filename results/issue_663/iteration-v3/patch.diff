+    /// Owed chunks an owned staging entry names: their part is still streaming.
+    in_flight: HashSet<ChunkId>,
+    /// A staged record this pass could not read at all, so the reading has a hole in it: a chunk
+    /// it owes may be one that record stages. Each is named where it was met.
+    incomplete: bool,
+}
+
+/// One committed part this pass owes a repair inside, as the walk read it: the snapshot every
+/// repair inside it is built from and conditioned on.
+struct StagedPart {
+    /// The owning session's key, and its value exactly as the listing read it. Both batches of a
+    /// re-place are pinned to these bytes — `require(mpu == Open@E)` — and every transition
+    /// rewrites them, bumping the epoch, so any fence fails the re-place.
+    session_key: Vec<u8>,
+    session: Vec<u8>,
+    /// The part record's key, and its bytes exactly as read — the adoption's other pin,
+    /// `require(part == prior)`.
+    key: Vec<u8>,
+    prior: Vec<u8>,
+    /// Those bytes, decoded.
+    record: PartRecord,
+}
+
+/// Where an owed chunk sits in [`StagedReading::parts`].
+struct StagedSite {
+    part: usize,
+    /// The chunk's index within that part's own chunk list.
+    index: usize,
+}
+
+/// What a staged [`RepairPlan`] repoints: its part, the `orphan:` mark this pass read at each
+/// position the move would vacate, and the destination its assessment chose for each missing
+/// fragment — both in the plan's `missing` order. Every batch is preconditioned on the marks as
+/// read, so a mark that changes under the re-place fails its CAS rather than being overwritten.
+pub(super) struct StagedTarget<'s> {
+    part: usize,
+    vacated: Vec<SourceMark>,
+    destinations: Vec<Destination<'s>>,
+}
+
+/// The `orphan:` mark at a position a re-place would vacate, as the assessment read it.
+enum SourceMark {
+    /// No mark: the adoption writes one, under `require_absent`.
+    Absent,
+    /// A legacy or structured mark, stale evidence from another unreference event: re-stamped
+    /// with this move's identity and a fresh stamp (`0016:1216-1224`), under a precondition on
+    /// these exact bytes.
+    Stamped(Vec<u8>),
+    /// GC has already recorded its decision to reclaim the position. No writer replaces such a
+    /// mark (`metadata::OrphanMark`), and none needs to: it already evidences the vacated bytes,
+    /// and GC finishes the reclaim once no record names them.
+    Reclaiming,
+}
+
+/// Where one rebuilt fragment goes.
+struct Destination<'s> {
+    /// The fragment index it rebuilds — one of the plan's `missing`, in its order.
+    index: usize,
+    dserver: DServerId,
+    store: &'s dyn ChunkStore,
+    /// The `orphan:` mark at that position, as the choice read it.
+    mark: DestinationMark,
+}
+
+/// The mark at a destination position, as the choice of destination read it.
+#[derive(Clone)]
+enum DestinationMark {
+    /// No mark: the pre-mark is written under `require_absent`.
+    Absent,
+    /// A legacy or structured mark: re-stamped fresh, never reused with its old stamp, under a
+    /// precondition on these exact bytes.
+    Stamped(Vec<u8>),
+}
+
+/// A server the choice of destinations may place a rebuilt fragment on: in this pass's fleet, and
+/// fenced by no desired-state record ([`candidate`]).
+struct Candidate<'s> {
+    dserver: DServerId,
+    domain: FailureDomain,
+    store: &'s dyn ChunkStore,
+}
+
+impl StagedReading {
+    /// Whether a staged record this pass could not read left a hole in the reading.
+    pub(super) fn incomplete(&self) -> bool {
+        self.incomplete
+    }
+
+    /// Contain one staged record this reading could not read: name it for the operator where it
+    /// was met, and record that the reading now has a hole in it.
+    fn contain(&mut self, key: &[u8], fault: &str) {
+        emit_unresolvable_staged(&object_name(key), fault);
+        self.incomplete = true;
+    }
+
+    /// Classify one owned staging entry by its key, the namespace's own parser
+    /// ([`parse_sidx_key`]): all this reading needs is WHICH chunk a still-streaming part stages,
+    /// and the key names it whatever the value holds — an entry whose value will not decode names
+    /// its chunk all the same, which is no reason to drop the chunk's obligation. A key naming no
+    /// chunk hides which one it stages, and leaves the reading incomplete.
+    fn read_owned(&mut self, owed: &HashSet<ChunkId>, key: &[u8]) {
+        match parse_sidx_key(key) {
+            Ok((_upload, _part, chunk)) => {
+                if owed.contains(&chunk) {
+                    self.in_flight.insert(chunk);
+                }
+            }
+            Err(fault) => self.contain(key, &fault.to_string()),
+        }
+    }
+
+    /// Classify one committed part: its key and value validated as the staged protection class
+    /// validates them (`crate::gc::StagedSet`). The part is held — once, on the first chunk that
+    /// needs it — only when it names a chunk this pass owes a repair on and no earlier part in key
+    /// order already does: the FIRST reference wins, as the committed reading's does.
+    fn read_part(&mut self, owed: &HashSet<ChunkId>, key: &[u8], value: &[u8], session: &[u8]) {
+        let read = parse_part_key(key)
+            .and_then(|(upload, _part)| Ok((upload, decode_part_record(value)?)));
+        let (upload, record) = match read {
+            Ok(read) => read,
+            Err(fault) => return self.contain(key, &fault.to_string()),
+        };
+        let mut held = None;
+        for (index, chunk) in record.chunks().iter().enumerate() {
+            if !owed.contains(&chunk.id) {
+                continue;
+            }
+            if let Entry::Vacant(site) = self.sites.entry(chunk.id) {
+                let part = *held.get_or_insert_with(|| {
+                    self.parts.push(StagedPart {
+                        session_key: mpu_key(&upload),
+                        session: session.to_vec(),
+                        key: key.to_vec(),
+                        prior: value.to_vec(),
+                        record: record.clone(),
+                    });
+                    self.parts.len() - 1
+                });
+                site.insert(StagedSite { part, index });
+            }
+        }
+    }
+}
+
+/// Read this pass's [`StagedReading`] for `queue`: every listed session's owned entries, then its
+/// committed parts, in bounded pages, never one read of a whole namespace (`0016:890`). A record
+/// this pass cannot read is contained and named; a store fault under any read fails the pass.
+pub(super) async fn read(meta: &dyn MetadataStore, queue: &[ChunkId]) -> Result<StagedReading> {
+    let owed: HashSet<ChunkId> = queue.iter().copied().collect();
+    let mut reading = StagedReading::default();
+    walk_staged(meta, StagedRanges::OwnedThenParts, |record| match record {
+        StagedRecord::UnnamedSession { key, fault } => reading.contain(key, &fault),
+        StagedRecord::Owned { key, .. } => reading.read_owned(&owed, key),
+        StagedRecord::Part {
+            key,
+            value,
+            session,
+        } => reading.read_part(&owed, key, value, session),
+    })
+    .await?;
+    Ok(reading)
+}
+
+/// Assess an owed chunk no committed chunk map names, against the staged class.
+///
+/// A chunk no staged record names either was deleted out from under the obligation: `Drain`,
+/// acted on only over a complete reading of both classes (`super::reconcile`). One only an owned
+/// entry names is still streaming, and one whose session is not `Open` is fenced: both keep
+/// their obligation ([`Assessment::Deferred`]). A committed part's chunk is gathered and verified
+/// exactly as a committed one is, against the scheme its part record carries — its placement held
+/// to the exact length every staged record is born with (`0016:828`) — and its destinations are
+/// chosen here, before anything is written: one that no usable destination can take is
+/// [`Assessment::Blocked`], off the repairable-backlog gauge like a committed chunk with no free
+/// domain.
+pub(super) async fn assess<'s>(
+    ctx: &ReconstructionContext<'_>,
+    stores: &HashMap<DServerId, &'s dyn ChunkStore>,
+    staged: &StagedReading,
+    chunk: ChunkId,
+) -> Result<Assessment<'s>> {
+    let Some(site) = staged.sites.get(&chunk) else {
+        if staged.in_flight.contains(&chunk) {
+            return Ok(Assessment::Deferred("in-flight"));
+        }
+        return Ok(Assessment::Drain);
+    };
+    let part = &staged.parts[site.part];
+    // Only an `Open` session's part may be repointed: the re-place is fenced exactly like a part
+    // upload, and every other state has already fenced it. Both batches are pinned to these same
+    // bytes, so a session fenced after this read still fails them.
+    match decode_session_record(&part.session) {
+        Ok(session) if matches!(session.state(), SessionState::Open {}) => {}
+        Ok(_) => return Ok(Assessment::Deferred("session-fenced")),
+        Err(fault) => {
+            emit_withheld(&object_name(&part.session_key), &fault.to_string());
+            return Ok(Assessment::Withheld);
+        }
+    }
+    let chunk_ref = &part.record.chunks()[site.index];
+    if chunk_ref.placement.len() != usize::from(chunk_ref.fragment_count()) {
+        return Ok(Assessment::Malformed);
+    }
+    let (k, m) = match chunk_ref.scheme {
+        // A single-copy chunk has no second source to rebuild from: classified exactly as the
+        // committed assessment classifies one (`super::assess`), before any fragment is fetched.
+        EcScheme::None => return Ok(Assessment::Unrepairable),
+        EcScheme::ReedSolomon { k, m } => (usize::from(k), usize::from(m)),
+    };
+    let gathered = gather(ctx, stores, chunk, &chunk_ref.placement, chunk_ref.scheme).await?;
+    if let Some(settled) = gathered.settle(k) {
+        return Ok(settled);
+    }
+    // The mark at each position the move would vacate, read now so that one no writer can parse
+    // withholds the repair before anything is written — pre-mark, fragment or record.
+    let mut vacated = Vec::with_capacity(gathered.missing.len());
+    for &index in &gathered.missing {
+        let key = orphan_key(chunk_ref.placement[index], fragment(chunk, index));
+        vacated.push(match ctx.meta.get(&key).await? {
+            None => SourceMark::Absent,
+            Some(current) => match decode_orphan_mark(&current) {
+                Ok(mark) if mark.is_reclaiming() => SourceMark::Reclaiming,
+                Ok(_) => SourceMark::Stamped(current.to_vec()),
+                Err(fault) => {
+                    emit_withheld(&object_name(&key), &fault.to_string());
+                    return Ok(Assessment::Withheld);
+                }
+            },
+        });
+    }
+    let Some(destinations) = choose_destinations(
+        ctx,
+        stores,
+        chunk,
+        &gathered.missing,
+        &gathered.survivor_domains,
+    )
+    .await?
+    else {
+        return Ok(Assessment::Blocked);
+    };
+    Ok(Assessment::Repairable(Box::new(RepairPlan {
+        target: Target::Staged(StagedTarget {
+            part: site.part,
+            vacated,
+            destinations,
+        }),
+        chunk_index: site.index,
+        chunk_id: chunk,
+        k,
+        m,
+        survivors: gathered.survivors,
+        survivor_domains: gathered.survivor_domains,
+        missing: gathered.missing,
+        placement: chunk_ref.placement.clone(),
+        len: chunk_ref.len as usize,
+    })))
+}
+
+/// The positions a choice of destinations has read: `Some(mark)` for one it may use, `None` for
+/// one it may not.
+type ReadPositions = HashMap<(DServerId, usize), Option<DestinationMark>>;
+
+/// Choose a destination for each `missing` fragment: servers in failure domains distinct from each
+/// other and from `survivor_domains` (the committed path's selector), each at a position it may
+/// take.
+///
+/// **A position is ruled out, not its server.** Whether a server may hold any fragment of this
+/// chunk is one fact ([`candidate`]: in the fleet view, fenced by no desired-state record);
+/// whether it may hold fragment `i` is another ([`position`]: the mark at that position). A mark
+/// that forbids one position leaves the server free to take another of the chunk's missing
+/// fragments, so a chunk missing several fragments is never blocked by one bad position while a
+/// valid assignment exists — the servers may simply swap fragments.
+///
+/// The servers considered start as the selector's own pick for all the missing fragments at once —
+/// the committed path's choice, and the answer whenever its positions are usable — and grow one
+/// server at a time, in the selector's order, only while no assignment exists over them.
+/// [`assign`] finds an assignment over the positions read usable and those not read yet; each
+/// unread position it relies on is then read, and one ruled out sends it round again. Every round
+/// reads a position or considers a server, of finitely many, so the choice ends: every assigned
+/// position read usable, or `None` once no free domain holds a server not yet considered.
+///
+/// Each read's await is bounded as every custodian read is, by the `MetadataStore`
+/// implementation's own network bound (#508/#636); a fault fails the pass before anything is
+/// written.
+async fn choose_destinations<'s>(
+    ctx: &ReconstructionContext<'_>,
+    stores: &HashMap<DServerId, &'s dyn ChunkStore>,
+    chunk: ChunkId,
+    missing: &[usize],
+    survivor_domains: &[FailureDomain],
+) -> Result<Option<Vec<Destination<'s>>>> {
+    // Every server the selector has handed over, and those of them that may take a fragment.
+    let mut considered = BTreeSet::new();
+    let mut candidates: Vec<Candidate<'s>> = Vec::new();
+    let mut positions = ReadPositions::new();
+    loop {
+        let Some(assignment) = assign(missing, &candidates, &positions) else {
+            // Not even with every unread position usable: consider more servers — the selector's
+            // pick for every missing fragment first, then one at a time.
+            let want = if considered.is_empty() {
+                missing.len()
+            } else {
+                1
+            };
+            let view = ctx.topology.excluding(&considered);
+            let Ok(picked) =
+                select_distinct_domains_excluding(&view, want as u16, survivor_domains)
+            else {
+                return Ok(None);
+            };
+            for dserver in picked {
+                considered.insert(dserver);
+                if let Some(usable) = candidate(ctx, stores, chunk, dserver).await? {
+                    candidates.push(usable);
+                }
+            }
+            continue;
+        };
+        let mut chosen = Vec::with_capacity(missing.len());
+        for (&index, &at) in missing.iter().zip(&assignment) {
+            let candidate = &candidates[at];
+            let mark = match positions.entry((candidate.dserver, index)) {
+                Entry::Occupied(read) => read.get().clone(),
+                Entry::Vacant(unread) => unread
+                    .insert(position(ctx, chunk, candidate.dserver, index).await?)
+                    .clone(),
+            };
+            if let Some(mark) = mark {
+                chosen.push(Destination {
+                    index,
+                    dserver: candidate.dserver,
+                    store: candidate.store,
+                    mark,
+                });
+            }
+        }
+        // Complete only if no position read just now ruled itself out; otherwise choose again
+        // without it.
+        if chosen.len() == missing.len() {
+            return Ok(Some(chosen));
+        }
+    }
+}
+
+/// An assignment of each `missing` fragment, by its slot, to one of `candidates`, by its index: in
+/// failure domains distinct from each other, at no position `positions` has ruled out. Slot by
+/// slot, a free domain is taken in the order the candidates were considered — so while every
+/// position is usable, fragment `i` goes to the selector's `i`-th pick, as on the committed path —
+/// and a domain another slot holds is taken only if that slot can move (an augmenting path,
+/// Kuhn's bipartite matching). `None` when no such assignment exists.
+fn assign(
+    missing: &[usize],
+    candidates: &[Candidate<'_>],
+    positions: &ReadPositions,
+) -> Option<Vec<usize>> {
+    let mut held: HashMap<&FailureDomain, (usize, usize)> = HashMap::new();
+    for slot in 0..missing.len() {
+        let mut visited = HashSet::new();
+        if !augment(
+            slot,
+            missing,
+            candidates,
+            positions,
+            &mut held,
+            &mut visited,
+        ) {
+            return None;
+        }
+    }
+    let mut assignment = vec![0; missing.len()];
+    for &(slot, at) in held.values() {
+        assignment[slot] = at;
+    }
+    Some(assignment)
+}
+
+/// Give `slot` a domain: a free one if any candidate offers it, else one whose holder can move to
+/// another (see [`assign`]).
+fn augment<'c>(
+    slot: usize,
+    missing: &[usize],
+    candidates: &'c [Candidate<'_>],
+    positions: &ReadPositions,
+    held: &mut HashMap<&'c FailureDomain, (usize, usize)>,
+    visited: &mut HashSet<&'c FailureDomain>,
+) -> bool {
+    for displace in [false, true] {
+        for (at, candidate) in candidates.iter().enumerate() {
+            let ruled_out = matches!(
+                positions.get(&(candidate.dserver, missing[slot])),
+                Some(None)
+            );
+            let holder = held.get(&candidate.domain).map(|&(holder, _)| holder);
+            if ruled_out || holder.is_some() != displace || !visited.insert(&candidate.domain) {
+                continue;
+            }
+            if holder
+                .is_none_or(|holder| augment(holder, missing, candidates, positions, held, visited))
+            {
+                held.insert(&candidate.domain, (slot, at));
+                return true;
+            }
+        }
+    }
+    false
+}
+
+/// `dserver` as a server a rebuilt fragment of `chunk` may go to, or `None` when it may take none:
+/// outside this pass's fleet view, or fenced by a `desired:dserver:<S>` record — present at all,
+/// whatever its value, the fact both batches pin with `require_absent`. Each is named on the audit
+/// seam.
+async fn candidate<'s>(
+    ctx: &ReconstructionContext<'_>,
+    stores: &HashMap<DServerId, &'s dyn ChunkStore>,
+    chunk: ChunkId,
+    dserver: DServerId,
+) -> Result<Option<Candidate<'s>>> {
+    let (Some(&store), Some(domain)) = (stores.get(&dserver), ctx.topology.domain_of(dserver))
+    else {
+        emit_server_passed_over(chunk, dserver, "outside-fleet");
+        return Ok(None);
+    };
+    if ctx.meta.get(&desired_key(dserver)).await?.is_some() {
+        emit_server_passed_over(chunk, dserver, "desired-state");
+        return Ok(None);
+    }
+    Ok(Some(Candidate {
+        dserver,
+        domain: domain.clone(),
+        store,
+    }))
+}
+
+/// The mark at the position fragment `index` of `chunk` would take on `dserver`, or `None` when
+/// that position may not be used: its mark is already `reclaiming` (a fragment written there could
+/// be deleted by the reclaim in progress, and no writer replaces such a mark), or no writer can
+/// parse it (never overwritten, ADR-0045). Each is named on the audit seam; the server may still
+/// take another fragment.
+async fn position(
+    ctx: &ReconstructionContext<'_>,
+    chunk: ChunkId,
+    dserver: DServerId,
+    index: usize,
+) -> Result<Option<DestinationMark>> {
+    let key = orphan_key(dserver, fragment(chunk, index));
+    Ok(match ctx.meta.get(&key).await? {
+        None => Some(DestinationMark::Absent),
+        Some(current) => match decode_orphan_mark(&current) {
+            Ok(found) if found.is_reclaiming() => {
+                emit_position_passed_over(&object_name(&key), "reclaiming");
+                None
+            }
+            Ok(_) => Some(DestinationMark::Stamped(current.to_vec())),
+            Err(fault) => {
+                emit_unreadable_destination(&object_name(&key), &fault.to_string());
+                None
+            }
+        },
+    })
+}
+
+/// Re-place `plan`'s missing fragment(s) of a committed part's chunk: rebuild, pre-mark each
+/// destination, write, and adopt in one CAS pinned to the session, the part record and each
+/// destination's drain key — the sequence and its guarantees are this module's own doc.
+///
+/// Returns [`RepairOutcome::Aborted`] when the re-place stopped before it could adopt anything and
+/// may simply be retried — a pre-mark that lost its precondition, a write refused past its
+/// deadline or whose landing the D server could not certify — [`RepairOutcome::Conflict`] when the
+/// adoption lost, and [`RepairOutcome::Refused`] when the repointed part record would cross the
+/// value ceiling. A transient store fault fails the pass, as it does on the committed path; every
+/// pre-mark already written covers whatever landed.
+pub(super) async fn repair(
+    ctx: &ReconstructionContext<'_>,
+    staged: &StagedReading,
+    target: &StagedTarget<'_>,
+    plan: &RepairPlan<'_>,
+) -> Result<RepairOutcome> {
+    let part = &staged.parts[target.part];
+    let (k, m, chunk) = (plan.k, plan.m, plan.chunk_id);
+
+    // Reconstruct the chunk's logical bytes from any `k` survivors and re-derive every shard
+    // (`erasure::encode` is deterministic, so a rebuilt shard is byte-identical to the original).
+    let data = erasure::reconstruct(k, m, plan.len, &plan.survivors)?;
+    let shards = erasure::encode(k, m, &data)?;
+
+    // The part record the adoption would leave behind, judged before anything is written, as the
+    // committed path judges its record (`super::repair_chunk`).
+    let next = repointed_part(part, plan.chunk_index, &target.destinations)?;
+    if let Some(ceiling) = metadata::flat_value_ceiling_crossed(&next) {
+        return Ok(RepairOutcome::Refused {
+            bytes: next.len(),
+            ceiling,
+        });
+    }
+
+    // PRE-MARK every destination, durably, before any write is sent: from here on a fragment the
+    // re-place writes is covered by evidence GC acts on, whichever way the adoption goes. Fresh —
+    // stamped from the context's clock as the batch is built, under a per-move event, whatever
+    // mark was there before — and pinned to the session, the part record and each destination's
+    // drain key, so a fence or a drain that already landed writes nothing.
+    let stamp = ctx.clock.now_millis();
+    let event = format!("replace:{chunk:x}:{stamp}");
+    let premark = encode_orphan_mark(&OrphanMark::structured(stamp, event.clone())?);
+    let mut batch = WriteBatch::new()
+        .require(part.session_key.clone(), part.session.clone())
+        .require(part.key.clone(), part.prior.clone());
+    for dest in &target.destinations {
+        let key = orphan_key(dest.dserver, fragment(chunk, dest.index));
+        batch = match &dest.mark {
+            DestinationMark::Absent => batch.require_absent(key.clone()),
+            DestinationMark::Stamped(current) => batch.require(key.clone(), current.clone()),
+        }
+        .put(key, premark.clone())
+        .require_absent(desired_key(dest.dserver));
+    }
+    if ctx.meta.commit(batch).await? == CommitOutcome::Conflict {
+        emit_aborted_reason(chunk, "pre-mark-lost");
+        return Ok(RepairOutcome::Aborted);
+    }
+
+    // WRITE each rebuilt fragment, authorized until the deadline fixed at the pre-mark's own
+    // stamp. The D server refuses it past that deadline — with nothing landed, or unable to say
+    // whether it landed in time — and either way nothing is adopted: whatever landed is under the
+    // pre-mark. What an `Unknown` write that lands after its deadline leaves behind is the
+    // write-deadline model's own residual, shared by every writer that carries a deadline
+    // (`WriteEffect::Unknown`, `crates/traits/src/lib.rs:886-891`), not one this re-place adds.
+    let deadline = stamp.saturating_add(ctx.staged_write_window_millis);
+    for dest in &target.destinations {
+        let bytes = encode_ec_fragment(
+            chunk,
+            dest.index as u16,
+            k as u8,
+            m as u8,
+            &shards[dest.index],
+        );
+        let written = dest
+            .store
+            .put_fragment(fragment(chunk, dest.index), bytes, Some(deadline))
+            .await;
+        if let Err(fault) = written {
+            let Some(refusal) = write_deadline_outcome(fault.as_ref()) else {
+                return Err(fault);
+            };
+            let reason = if refusal.effect.may_have_landed() {
+                "write-landing-unknown"
+            } else {
+                "write-deadline-expired"
+            };
+            emit_aborted_reason(chunk, reason);
+            return Ok(RepairOutcome::Aborted);
+        }
+    }
+
+    // ADOPT, in ONE CAS: the part record repointed, each pre-mark consumed, each vacated source
+    // orphaned, the obligation drained. It lands only if the session is still `Open` at the epoch
+    // this pass read, the part record is still the one it read, every pre-mark still holds the
+    // exact bytes written above (GC swaps a mark to `reclaiming` before it deletes anything), and
+    // no drain has been recorded on a destination since it was chosen. The vacated source's mark is
+    // stamped as the batch is built: that is when its position stops being named.
+    let vacated_mark = encode_orphan_mark(&OrphanMark::structured(ctx.clock.now_millis(), event)?);
+    let mut adopt = WriteBatch::new()
+        .require(part.session_key.clone(), part.session.clone())
+        .require(part.key.clone(), part.prior.clone())
+        .put(part.key.clone(), next)
