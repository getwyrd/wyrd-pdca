+/// A repair whose repointed part record would cross the backend value ceiling is refused before
+/// anything is written — no pre-mark, no fragment, no record — its obligation is kept, and the pass
+/// does not certify: the committed path's refusal, for a part record.
+#[tokio::test]
+async fn a_repointed_part_over_the_value_ceiling_is_refused_and_writes_nothing() {
+    const FILLER: ChunkId = 0x1_0000;
+    let fixture = Fixture::new();
+    // A part record past the ceiling: the owed chunk among enough small ones to cross it.
+    let mut chunks = vec![chunk_ref(CHUNK, &PLACEMENT)];
+    chunks.extend((0..1_400).map(|n| ChunkRef {
+        id: FILLER + n,
+        scheme: RS_2_1,
+        len: 1,
+        placement: PLACEMENT.to_vec(),
+    }));
+    let oversized = part(&chunks, 800);
+    assert!(
+        oversized.len() > metadata::MAX_VALUE_BYTES,
+        "the seeded part record ({} bytes) is not past the ceiling",
+        oversized.len()
+    );
+    fixture.meta.seed(fixture.part_key(), oversized.clone());
+    fixture.lose();
+    fixture.enqueue(CHUNK).await;
+
+    let (outcome, audit) = fixture.reconstruct().await;
+    assert_eq!(outcome.unwrap(), Reconciled::Blocked);
+    assert!(fixture.all_puts().is_empty(), "a refused repair wrote");
+    assert_eq!(fixture.mark(DEST, frag(CHUNK, LOST)), None);
+    assert_eq!(fixture.meta.value(&fixture.part_key()), Some(oversized));
+    assert_eq!(fixture.queued().await, vec![CHUNK]);
+    assert!(audit.named(
+        RECONSTRUCTION_AUDIT,
+        "refused-ceiling",
+        wyrd_traits::chunk_hex(CHUNK).as_bytes()
+    ));
+}
