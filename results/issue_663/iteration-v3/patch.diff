+/// **(B)** With a committed part's fragment lost and its repair queued, one reconstruction pass:
+/// the new D server holds the chunk's fragment, intact and scheme-correct; the part record's
+/// placement names that server; the destination's pre-mark is gone; the vacated source carries an
+/// `orphan:` mark GC acts on once its grace has passed — and not before; the obligation has
+/// drained. On the base the obligation is dropped and nothing is written.
+#[tokio::test]
+async fn b_reconstruction_re_places_a_committed_parts_lost_fragment() {
+    let fixture = Fixture::new();
+    fixture.rot();
+    fixture.enqueue(CHUNK).await;
+
+    assert_eq!(fixture.repaired().await, Reconciled::Changed);
+
+    assert_rebuilt(&fixture, DEST);
+    assert_eq!(
+        fixture.placement(),
+        vec![0, DEST, 2],
+        "the part record does not name the server the fragment was rebuilt on"
+    );
+    // Only the placement moved: every other byte of the record — its length, digest, commit time
+    // and epoch, in the decoder's own spelling — is the one the part was committed with.
+    let repointed = fixture.meta.value(&fixture.part_key()).unwrap();
+    let placed = |servers: [DServerId; 3]| format!("\"placement\":{servers:?}").replace(' ', "");
+    assert_eq!(
+        String::from_utf8(repointed.to_vec())
+            .unwrap()
+            .replace(&placed([0, DEST, 2]), &placed(PLACEMENT)),
+        String::from_utf8(fixture.part.to_vec()).unwrap(),
+        "the adoption rewrote more of the part record than its placement"
+    );
+    let lost = frag(CHUNK, LOST);
