+/// Advance the fixture's clock by `by` the moment the pre-mark for the [`LOST`] fragment on
+/// [`DEST`] commits — between the pre-mark and the write it authorizes.
+fn advance_after_pre_mark(fixture: &Fixture, by: u64) {
+    let premark = orphan_key(DEST, frag(CHUNK, LOST));
+    let clock = fixture.clock.clone();
+    fixture.meta.after_commit(move |_meta, batch| {
+        if batch.puts.iter().any(|(key, _)| *key == premark) {
+            clock.advance(by);
+        }
+    });
+}
