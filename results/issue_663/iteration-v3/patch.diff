+/// A pre-mark as a write found it: a structured mark stamped exactly `at` — the clock's reading
+/// when the pass wrote it — not `reclaiming`, and naming an event other than `not_event`.
+fn assert_premark(found: Option<&Bytes>, at: u64, not_event: Option<&str>, what: &str) {
+    let found = found.unwrap_or_else(|| panic!("{what}: no orphan mark covered the destination"));
+    let mark = decode_orphan_mark(found)
+        .unwrap_or_else(|fault| panic!("{what}: the destination mark does not decode: {fault}"));
+    assert!(
+        !mark.is_reclaiming(),
+        "{what}: the pre-mark is `reclaiming`"
+    );
+    assert_eq!(
+        mark.orphaned_at_millis(),
+        at,
+        "{what}: the mark is not stamped when the pass wrote it: {found:?}"
+    );
+    let event = mark
+        .event()
+        .unwrap_or_else(|| panic!("{what}: the pre-mark names no event: {found:?}"));
+    assert_ne!(
+        Some(event),
+        not_event,
+        "{what}: the pre-mark kept an earlier event's identity"
+    );
+}
