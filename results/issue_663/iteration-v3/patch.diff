+enum LateWrite {
+    /// Nowhere: the write goes straight through.
+    No,
+    /// In the D server's accept queue, past the deadline: refused before it publishes, and nothing
+    /// lands.
+    Queued,
+    /// Publishing, past the deadline: its landing cannot be certified, and its bytes stay.
+    Publishing,
+}
+
+/// What one run of the re-place meets.
