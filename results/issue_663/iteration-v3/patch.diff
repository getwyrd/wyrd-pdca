+/// The fragment `dserver` holds at `frag` is exactly `expected` — the chunk's own fragment,
+/// intact, and carrying the chunk's identity and scheme in its header: rebuilt, not merely present.
+fn assert_rebuilt_as(
+    fixture: &Fixture,
+    dserver: DServerId,
+    frag: FragmentId,
+    scheme: EcScheme,
+    expected: &Bytes,
+) {
+    let bytes = fixture
+        .on_disk(dserver, frag)
+        .unwrap_or_else(|| panic!("server {dserver} holds no fragment {frag:?}"));
+    let decoded = wyrd_chunk_format::decode(&bytes)
+        .unwrap_or_else(|fault| panic!("the rebuilt fragment does not decode: {fault}"));
+    assert!(
+        header_matches_identity(&decoded.header, frag, scheme),
+        "the rebuilt fragment's header does not carry the chunk's identity: {:?}",
+        decoded.header
+    );
+    assert_eq!(
+        &bytes, expected,
+        "the rebuilt fragment is not the chunk's original fragment, byte for byte"
+    );
+}
