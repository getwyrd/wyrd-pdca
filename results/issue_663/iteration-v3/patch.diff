+    /// Before the pre-mark committed — or before the pass even listed the session.
+    BeforePreMark,
+    /// After the pre-mark committed and before the destination write landed.
+    PreMarkToWrite,
+    /// After the write landed and before the adoption was answered.
+    WriteToAdoption,
+    /// After the adoption was answered.
+    AfterAdoption,
+}
+
+impl FenceWindow {
+    const ALL: [FenceWindow; 4] = [
+        FenceWindow::BeforePreMark,
+        FenceWindow::PreMarkToWrite,
+        FenceWindow::WriteToAdoption,
+        FenceWindow::AfterAdoption,
+    ];
+}
+
+/// One observation at the store seams, in the order the simulation produced them — each logged
+/// the instant its batch applied or its bytes landed.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+enum ReplaceEvent {
+    /// The re-place's pre-mark batch was answered.
+    PreMark(CommitOutcome),
+    /// The destination write's bytes landed on this server.
+    Written(DServerId),
+    /// This server refused the destination write on its deadline, with this effect.
+    Refused(DServerId, WriteEffect),
+    /// The re-place's adoption batch was answered.
+    Adoption(CommitOutcome),
+    /// The fence was answered.
+    Fence(CommitOutcome),
+}
+
+type ReplaceLog = Arc<Mutex<Vec<ReplaceEvent>>>;
+
+/// A recording tap over the simulated-TiKV store: every call forwarded, network hops included, and
+/// each of the three batches the run cares about logged when it is answered. Instance state only
+/// (ADR-0035).
+struct ReplaceMeta {
+    inner: SimTikvMetadataStore,
+    log: ReplaceLog,
+    premark: Vec<u8>,
+}
+
+#[async_trait]
+impl MetadataStore for ReplaceMeta {
+    async fn get(&self, key: &[u8]) -> Result<Option<Bytes>> {
+        self.inner.get(key).await
+    }
+
+    async fn scan(&self, prefix: &[u8]) -> Result<Vec<(Vec<u8>, Bytes)>> {
+        self.inner.scan(prefix).await
+    }
+
+    async fn scan_page(
+        &self,
+        prefix: &[u8],
+        after: Option<&[u8]>,
+        limit: usize,
+    ) -> Result<wyrd_traits::ScanPage> {
+        self.inner.scan_page(prefix, after, limit).await
+    }
+
+    async fn commit(&self, batch: WriteBatch) -> Result<CommitOutcome> {
+        let puts = |prefix: &[u8]| batch.puts.iter().any(|(key, _)| key.starts_with(prefix));
+        let event: Option<fn(CommitOutcome) -> ReplaceEvent> = if puts(b"mpu:") {
+            Some(ReplaceEvent::Fence)
+        } else if puts(b"part:") {
+            Some(ReplaceEvent::Adoption)
+        } else if batch.puts.iter().any(|(key, _)| *key == self.premark) {
+            Some(ReplaceEvent::PreMark)
+        } else {
+            None
+        };
+        let outcome = self.inner.commit(batch).await?;
+        if let Some(event) = event {
+            self.log.lock().unwrap().push(event(outcome));
+        }
+        Ok(outcome)
+    }
+}
