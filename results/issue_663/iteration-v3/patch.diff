+    /// When the concurrent fence starts, in simulated milliseconds into the run — or no fence.
+    fence: Option<u64>,
+    /// How long each fragment read takes, in simulated milliseconds.
+    read_stall: u64,
+    /// Where the destination write spends extra time.
+    late: LateWrite,
