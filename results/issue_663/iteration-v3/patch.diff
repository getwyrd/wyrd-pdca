+/// A D server whose calls span simulated time and which ENFORCES a write's authorization deadline
+/// on the run's one clock ([`SystemClock`], simulated), where the real D server judges it (#638):
+/// immediately before it publishes ([`WriteDeadlineExpired::if_elapsed`] — refused, nothing lands)
+/// and once the publication returned ([`WriteDeadlineExpired::if_publication_unverified`] —
+/// `Unknown`, the bytes stay).
+struct ReplaceDServer<'a> {
+    id: DServerId,
+    inner: &'a MemDServer,
+    log: ReplaceLog,
+    faults: ReplaceFaults,
+}
+
+#[async_trait]
+impl ChunkStore for ReplaceDServer<'_> {
+    async fn put_fragment(
+        &self,
+        id: FragmentId,
+        fragment: Bytes,
+        deadline_millis: Option<u64>,
+    ) -> Result<()> {
+        madsim::time::sleep(Duration::from_millis(REPLACE_WRITE_HOP)).await;
+        if self.faults.late == LateWrite::Queued {
+            madsim::time::sleep(Duration::from_millis(REPLACE_LATE)).await;
+        }
+        if let Some(deadline) = deadline_millis {
+            let now = SystemClock.now_millis();
+            if let Some(refusal) = WriteDeadlineExpired::if_elapsed(id, deadline, now) {
+                self.log
+                    .lock()
+                    .unwrap()
+                    .push(ReplaceEvent::Refused(self.id, refusal.effect));
+                return Err(refusal.into());
+            }
+        }
+        self.inner.put_fragment(id, fragment, None).await?;
+        self.log
+            .lock()
+            .unwrap()
+            .push(ReplaceEvent::Written(self.id));
+        if self.faults.late == LateWrite::Publishing {
+            madsim::time::sleep(Duration::from_millis(REPLACE_LATE)).await;
+        }
+        if let Some(deadline) = deadline_millis {
+            let now = SystemClock.now_millis();
+            if let Some(unverified) =
+                WriteDeadlineExpired::if_publication_unverified(id, deadline, now)
+            {
+                self.log
+                    .lock()
+                    .unwrap()
+                    .push(ReplaceEvent::Refused(self.id, unverified.effect));
+                return Err(unverified.into());
+            }
+        }
+        madsim::time::sleep(Duration::from_millis(REPLACE_WRITE_HOP)).await;
+        Ok(())
+    }
+
+    async fn get_fragment(&self, id: FragmentId) -> Result<Option<Bytes>> {
+        if self.faults.read_stall > 0 {
+            madsim::time::sleep(Duration::from_millis(self.faults.read_stall)).await;
+        }
+        self.inner.get_fragment(id).await
+    }
+
+    async fn list_fragments(&self) -> Result<Vec<FragmentId>> {
+        self.inner.list_fragments().await
+    }
+
+    async fn delete_fragment(&self, id: FragmentId) -> Result<()> {
+        self.inner.delete_fragment(id).await
+    }
+
+    async fn health(&self) -> Result<Health> {
+        Ok(Health::Healthy)
+    }
+}
+
+/// A session record targeting [`REPLACE_OBJECT`] at `epoch` in `state` (its JSON), as the base
+/// decoder spells it and checked against it.
+fn replace_session(epoch: u64, state: &str) -> Bytes {
+    let bytes = format!(
+        "{{\"parent\":{ROOT},\"object\":\"{REPLACE_OBJECT}\",\"created_at_millis\":100,\
+         \"clock_source\":\"wall\",\"epoch\":{epoch},\"attempts\":1,\"state\":{state}}}"
+    )
+    .into_bytes();
+    decode_session_record(&bytes).expect("the seeded session record decodes");
+    Bytes::from(bytes)
+}
+
+/// The committed part record naming `chunk`, as the base decoder spells it and checked against it.
+fn replace_part(chunk: &ChunkRef) -> Bytes {
+    let bytes = format!(
+        "{{\"chunks\":[{}],\"len\":{},\"digest\":\"{}\",\"committed_at_millis\":800,\
+         \"session_epoch\":1}}",
+        String::from_utf8(metadata::encode(chunk).to_vec()).unwrap(),
+        chunk.len,
+        "ef".repeat(32)
+    )
+    .into_bytes();
+    decode_part_record(&bytes).expect("the seeded part record decodes");
+    Bytes::from(bytes)
+}
+
+/// Which window a run's fence landed in, read off the log — `None` for a run without a fence.
+fn fence_window(events: &[ReplaceEvent]) -> Option<FenceWindow> {
+    let at = |wanted: fn(&ReplaceEvent) -> bool| events.iter().position(wanted);
+    let fence = at(|event| *event == ReplaceEvent::Fence(CommitOutcome::Committed))?;
+    let premark = at(|event| *event == ReplaceEvent::PreMark(CommitOutcome::Committed));
+    let written = at(|event| matches!(event, ReplaceEvent::Written(_)));
+    let adoption = at(|event| matches!(event, ReplaceEvent::Adoption(_)));
+    Some(if premark.is_none_or(|premark| fence < premark) {
+        FenceWindow::BeforePreMark
+    } else if written.is_none_or(|written| fence < written) {
+        FenceWindow::PreMarkToWrite
+    } else if adoption.is_none_or(|adoption| fence < adoption) {
+        FenceWindow::WriteToAdoption
+    } else {
+        FenceWindow::AfterAdoption
+    })
+}
+
+/// What one run's re-place met and did.
+struct ReplaceRun {
+    /// Where the fence landed, when there was one.
+    window: Option<FenceWindow>,
+    /// The adoption committed: the part record names the rebuilt fragment.
+    adopted: bool,
+    /// How the D server refused the destination write, when it did.
+    refused: Option<WriteEffect>,
+}
+
+/// One run: a reconstruction pass re-places the committed part's rotten fragment under `faults` —
+/// a concurrent task fencing the session, slow reads, a late write. Asserts the invariants over
+/// what the run left behind, and returns what it met.
+async fn replace_under(faults: ReplaceFaults) -> ReplaceRun {
+    let d = servers();
+    let log: ReplaceLog = Arc::default();
+    let meta = Arc::new(ReplaceMeta {
+        inner: SimTikvMetadataStore::new(),
+        log: Arc::clone(&log),
+        premark: metadata::orphan_key(REPLACE_DEST, replace_frag(REPLACE_LOST)),
+    });
+    let upload = UploadId::new(REPLACE_UPLOAD).expect("32 lowercase-hex characters");
+    let session_key = mpu_key(&upload);
+    let part_key = part_key(&upload, PartNumber::new(1).expect("a part number in range"));
+    let open = replace_session(1, "{\"kind\":\"Open\"}");
+    let aborting = replace_session(2, "{\"kind\":\"Aborting\"}");
+    let scheme = EcScheme::ReedSolomon {
+        k: K as u8,
+        m: M as u8,
+    };
+
+    // An `Open` session with one committed part naming the chunk, every fragment on its server.
+    let data = b"a staged part's chunk the custodian re-places under a session fence";
+    let fragments: Vec<Bytes> = wyrd_core::erasure::encode(K, M, data)
+        .unwrap()
+        .iter()
+        .enumerate()
+        .map(|(index, shard)| {
+            write::encode_ec_fragment(REPLACE_CHUNK, index as u16, K as u8, M as u8, shard)
+        })
+        .collect();
+    let original: Vec<DServerId> = vec![0, 1, 2];
+    let chunk = ChunkRef {
+        id: REPLACE_CHUNK,
+        scheme,
+        len: data.len() as u64,
+        placement: original.clone(),
+    };
+    let seeded = meta
+        .commit(
+            WriteBatch::new()
+                .put(session_key.clone(), open.clone())
+                .put(part_key.clone(), replace_part(&chunk)),
+        )
+        .await
+        .unwrap();
+    assert_eq!(seeded, CommitOutcome::Committed);
+    for (index, &server) in original.iter().enumerate() {
+        d[server as usize]
+            .put_fragment(replace_frag(index as u16), fragments[index].clone(), None)
+            .await
+            .unwrap();
+    }
+    // The fragment rots on server 1, and scrub has queued its repair.
+    let mut rotten = fragments[usize::from(REPLACE_LOST)].to_vec();
+    rotten[CORE_HEADER_LEN as usize] ^= 0x01;
+    d[1].put_fragment(replace_frag(REPLACE_LOST), Bytes::from(rotten), None)
+        .await
+        .unwrap();
+    repair::enqueue_repair(&*meta, REPLACE_CHUNK, "scrub")
+        .await
+        .unwrap();
+    // The run starts here: what the fixture wrote above is not the race.
+    log.lock().unwrap().clear();
+
+    let fencer = faults.fence.map(|delay_millis| {
+        let meta = Arc::clone(&meta);
+        let (key, open, aborting) = (session_key.clone(), open.clone(), aborting.clone());
+        madsim::task::spawn(async move {
+            // Zero means now: see `RESTORE_NEMESIS_SPAN`.
+            if delay_millis > 0 {
+                madsim::time::sleep(Duration::from_millis(delay_millis)).await;
+            }
+            // The model locks a batch's precondition keys too, so the fence can lose a lock race
+            // to an in-flight pre-mark or adoption pinned to the same session; it retries, as a
+            // Complete or an Abort retries its CAS. Nothing else writes the session, so it lands.
+            for _ in 0..REPLACE_SPAN {
+                let fence = WriteBatch::new()
+                    .require(key.clone(), open.clone())
+                    .put(key.clone(), aborting.clone());
+                if meta.commit(fence).await.unwrap() == CommitOutcome::Committed {
+                    return true;
+                }
+                madsim::time::sleep(Duration::from_millis(1)).await;
+            }
+            false
+        })
+    });
+
+    let coord = MemCoordination::new();
+    let (zone, custodian) = elect(&coord, "zone-staged-replace").await;
+    let disks: Vec<ReplaceDServer<'_>> = d
+        .iter()
+        .enumerate()
+        .map(|(id, inner)| ReplaceDServer {
+            id: id as DServerId,
+            inner,
+            log: Arc::clone(&log),
+            faults,
+        })
+        .collect();
+    let fleet: Vec<(DServerId, &dyn ChunkStore)> = disks
+        .iter()
+        .map(|disk| (disk.id, disk as &dyn ChunkStore))
+        .collect();
+    let mut topology = four_domains();
+    topology.set_utilization(1, 100);
+    let ctx = ReconstructionContext {
+        meta: &*meta,
+        fleet: &fleet,
+        topology: &topology,
+        unreachable: &[],
+        clock: &SystemClock,
+        staged_write_window_millis: REPLACE_WINDOW,
+    };
+    let now = SystemClock.now_millis();
+    let outcome = reconcile_step(&zone, &custodian, None, None, Some(&ctx), None, now).await;
+    assert!(
+        outcome.is_ok(),
+        "the reconstruction pass failed ({faults:?}): {:?}",
+        outcome.err()
+    );
+    let fenced = match fencer {
+        Some(fencer) => fencer.await.expect("the fencer ran to completion"),
+        None => false,
+    };
+    let events = log.lock().unwrap().clone();
+    assert_eq!(
+        fenced,
+        faults.fence.is_some(),
+        "the fence never landed ({faults:?}): {events:?}"
+    );
+
+    let part = meta.get(&part_key).await.unwrap().expect("the part record");
+    let part = decode_part_record(&part).expect("the part record decodes");
+    let placement = part.chunks()[0].placement.clone();
+    let adopted = events.contains(&ReplaceEvent::Adoption(CommitOutcome::Committed));
+    assert_eq!(
+        adopted,
+        placement != original,
+        "the adoption's answer and the part record disagree ({faults:?}): {events:?}"
+    );
+    let expected_session = if fenced { aborting } else { open };
+    assert_eq!(
+        meta.get(&session_key).await.unwrap(),
+        Some(expected_session),
+        "the session ended in the wrong state ({faults:?}): {events:?}"
+    );
+    let refused = events.iter().find_map(|event| match event {
+        ReplaceEvent::Refused(_, effect) => Some(*effect),
+        _ => None,
+    });
+    assert!(
+        !(adopted && refused.is_some()),
+        "a write the D server refused was adopted ({faults:?}): {events:?}"
+    );
+    if refused == Some(WriteEffect::NotApplied) {
+        assert!(
+            d[REPLACE_DEST as usize]
+                .get_fragment(replace_frag(REPLACE_LOST))
+                .await
+                .unwrap()
+                .is_none(),
+            "a write refused before it published left bytes ({faults:?}): {events:?}"
+        );
+    }
+
+    // NO FRAGMENT ENDS UNREFERENCED AND UNEVIDENCED: every fragment on every server is named by
+    // the part record, or covered by an `orphan:` mark GC acts on.
+    for (id, disk) in d.iter().enumerate() {
+        let id = id as DServerId;
+        for fragment in disk.list_fragments().await.unwrap() {
+            let referenced = fragment.chunk == REPLACE_CHUNK
+                && placement.get(usize::from(fragment.index)) == Some(&id);
+            let evidenced = meta
+                .get(&metadata::orphan_key(id, fragment))
+                .await
+                .unwrap()
+                .is_some();
+            assert!(
+                referenced || evidenced,
+                "fragment {fragment:?} on server {id} is neither named nor marked ({faults:?}): \
+                 {events:?}"
+            );
+        }
+    }
+    // THE PART RECORD NAMES NO FRAGMENT THAT WAS NOT WRITTEN — fenced or not: every position it
+    // names holds its fragment, and one the re-place moved it to holds the intact rebuild.
+    for (index, &server) in placement.iter().enumerate() {
+        let fragment = replace_frag(index as u16);
+        let held = d[server as usize]
+            .get_fragment(fragment)
+            .await
+            .unwrap()
+            .unwrap_or_else(|| {
+                panic!(
+                    "the part record names {fragment:?} on server {server}, which holds nothing \
+                     ({faults:?}): {events:?}"
+                )
+            });
+        if server != original[index] {
+            assert!(
+                repair::fragment_intact(&held, fragment, scheme),
+                "the part record was moved onto a fragment that is not the rebuild ({faults:?}): \
+                 {events:?}"
+            );
+        }
+    }
+    // The obligation goes only with the repair that satisfies it.
+    let queued = repair::queued_repairs(&*meta)
+        .await
+        .unwrap()
+        .contains(&REPLACE_CHUNK);
+    assert_eq!(
+        queued, !adopted,
+        "the obligation outlived the repair, or went without one ({faults:?}): {events:?}"
+    );
+    ReplaceRun {
+        window: fence_window(&events),
+        adopted,
+        refused,
+    }
+}
+
+/// The campaign leg: the seed picks whether and where the fence lands, whether the pass's reads are
+/// slow, and whether the destination write is late — so 50 seeds sweep the re-place's schedule
+/// space and the D server's refusals.
+async fn prop_staged_replace_never_strands(rng: &mut ChaCha8Rng) {
+    let fence = if rng.next_u32().is_multiple_of(4) {
+        None
+    } else {
+        Some(u64::from(rng.next_u32() % (REPLACE_SPAN + 1)))
+    };
+    let read_stall = if rng.next_u32().is_multiple_of(2) {
+        0
+    } else {
+        REPLACE_READ_STALL
+    };
+    let late = match rng.next_u32() % 3 {
+        0 => LateWrite::No,
+        1 => LateWrite::Queued,
+        _ => LateWrite::Publishing,
+    };
+    replace_under(ReplaceFaults {
+        fence,
+        read_stall,
+        late,
+    })
+    .await;
+}
+
+/// **Every window, both refusals and the slow pass are genuinely REACHED.** Walks the fence across
+/// the whole span over a fast pass, asserting the invariants at every point, then asserts that the
+/// fence landed before the pre-mark in some run, between the pre-mark and the write in another,
+/// between the write and the adoption in another, and after the adoption in another. Then a write
+/// held in the D server's queue past its deadline is refused with nothing landed, one whose
+/// publication runs past it is answered `Unknown` with its bytes landed, and neither is adopted.
+/// And a pass that spends more than a whole write window reading before it reaches the pre-mark
+/// still repairs: its stamp — and the deadline fixed from it — date the pre-mark, not the pass.
+/// Without this leg, a span that drifted away from the re-place would leave the campaign green with
+/// nothing behind it.
+async fn prop_staged_replace_reaches_every_window() {
+    let fast = ReplaceFaults {
+        fence: None,
+        read_stall: 0,
+        late: LateWrite::No,
+    };
+    let mut reached = Vec::new();
+    for delay in 0..=u64::from(REPLACE_SPAN) {
+        let run = replace_under(ReplaceFaults {
+            fence: Some(delay),
+            ..fast
+        })
+        .await;
+        let window = run.window.expect("a fenced run has a fence window");
+        if !reached.contains(&window) {
+            reached.push(window);
+        }
+    }
+    for window in FenceWindow::ALL {
+        assert!(
+            reached.contains(&window),
+            "no fence in 0..={REPLACE_SPAN} ms landed {window:?}: reached only {reached:?}"
+        );
+    }
+
+    let queued = replace_under(ReplaceFaults {
+        late: LateWrite::Queued,
+        ..fast
+    })
+    .await;
+    assert_eq!(
+        queued.refused,
+        Some(WriteEffect::NotApplied),
+        "a write queued past its deadline was not refused"
+    );
+    assert!(!queued.adopted);
+    let publishing = replace_under(ReplaceFaults {
+        late: LateWrite::Publishing,
+        ..fast
+    })
+    .await;
+    assert_eq!(
+        publishing.refused,
+        Some(WriteEffect::Unknown),
+        "a publication past its deadline was acknowledged"
+    );
+    assert!(!publishing.adopted);
+
+    let slow = replace_under(ReplaceFaults {
+        read_stall: REPLACE_READ_STALL,
+        ..fast
+    })
+    .await;
+    assert_eq!(
+        slow.refused, None,
+        "a pass slower than a write window authorized its write already expired"
+    );
+    assert!(slow.adopted, "a slow pass never repaired the staged chunk");
+}
+
