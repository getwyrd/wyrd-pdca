+/// An owned entry whose value will not decode still names its chunk through its key: the chunk is
+/// staged, so its obligation is kept rather than drained, and nothing is written.
+#[tokio::test]
+async fn a_damaged_owned_entry_still_holds_its_chunks_obligation() {
+    const STREAMING: ChunkId = 0x66a;
