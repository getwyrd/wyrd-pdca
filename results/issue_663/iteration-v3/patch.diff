+        fixture.mark(DEST, lost),
+        None,
+        "the destination's pre-mark was not consumed by the adoption"
+    );
+    assert_premark(
+        fixture.mark(SOURCE, lost).as_ref(),
+        NOW,
+        None,
+        "the vacated source's mark",
+    );
+    assert!(
+        fixture.queued().await.is_empty(),
+        "the obligation did not drain"
+    );
+    // Exactly one write, and it landed.
+    let puts = fixture.all_puts();
+    assert_eq!(puts.len(), 1, "{puts:?}");
+    assert!(puts[0].1.landed);
+
+    // Inside the vacated source's grace GC keeps it — a reader holding the prior part record may
+    // still read it — and once the grace has passed GC reclaims it, and nothing the part names.
+    fixture.clock.set(NOW + GRACE - 1);
+    fixture.gc().await;
+    assert!(
+        fixture.on_disk(SOURCE, lost).is_some(),
+        "GC reclaimed the vacated source inside its grace"
+    );
+    fixture.clock.set(NOW + ONE_DAY);
+    assert_eq!(fixture.gc().await, Reconciled::Changed);
+    assert_eq!(
+        fixture.on_disk(SOURCE, lost),
+        None,
