+/// **F1**: the unknown outcome's batch was applied before the error. The re-read finds R.
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn f1_an_applied_unknown_outcome_is_adopted_by_the_re_read() {
