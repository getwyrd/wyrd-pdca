+
+    let (status, _) = send(addr, "PUT", path, &headers, &framed).await;
+    assert_eq!(
+        status, 200,
+        "a signed STREAMING-AWS4-HMAC-SHA256-PAYLOAD-TRAILER PUT with valid chunk + \
+         trailer signatures must be accepted (was 403 pre-#505)"
+    );
