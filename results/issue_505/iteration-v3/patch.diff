+        false,
+        path,
+        &host,
+        ChecksumAlgorithm::Crc32,
+        None,
+    );
+    // Declares crc32 but the wire sends crc32c instead.
+    let value = checksum_trailer_value(ChecksumAlgorithm::Crc32c, &object);
