+/// An owned multipart staging entry filed under `pending:` — minted through `wyrd-core`'s public
+/// checked path, from this crate, as the first `sidx:` writer will mint one — carries an expired
+/// lease the expired-lease input would act on if it read the value as an ordinary lease. GC must
+/// classify and skip it instead (ADR-0045 decision 3, fail safe): its byte is kept, its entry is
+/// left in place, and the pass still reclaims the ordinary expired lease beside it. A `?`-abort on
+/// the unreadable value would fail the whole step and leave that ordinary garbage stranded. And
+/// the skip must not be silent: the pass names the entry, once, on the GC audit seam.
+#[tokio::test]
+async fn expired_lease_input_skips_a_misfiled_owned_entry_and_completes_for_the_rest() {
+    // A permissive global default, installed before any callsite this pass fires is first hit, so
+    // none can latch `Interest::never` under the parallel harness and leave the capture empty
+    // (#214; the guard `segmented_map_consumers.rs` documents).
+    let _ = tracing::subscriber::set_global_default(tracing_subscriber::registry());
+    let meta = MemMeta::default();
+    let d0 = MemDServer::default();
+
+    let ordinary: ChunkId = 0xE1;
+    d0.put(frag(ordinary, 0)).await;
+    metadata::put_pending(
+        &meta,
+        ordinary,
+        &PendingEntry {
+            lease_expiry_millis: 100,
+            owner: None,
+            staged: None,
+        },
+    )
+    .await
+    .unwrap();
+
+    let misfiled: ChunkId = 0xE2;
+    d0.put(frag(misfiled, 0)).await;
+    let owner = UploadId::new("a1".repeat(16)).unwrap();
+    let staged = StagedPlacement::new(EcScheme::None, vec![0]).unwrap();
+    let misfiled_value = metadata::encode(&OwnedEntry::new(owner, 100, staged).to_pending());
+    meta.commit(WriteBatch::new().put(metadata::pending_key(misfiled), misfiled_value.clone()))
+        .await
+        .unwrap();
+
+    let coord = MemCoordination::new();
+    let (zone, custodian) = elect(&coord).await;
+    let fleet: [(DServerId, &dyn ChunkStore); 1] = [(0, &d0)];
+    let ctx = GcContext {
+        meta: &meta,
+        fleet: &fleet,
+        grace_window_millis: 50,
+        expired_pending: ExpiredPendingPolicy::Reclaim,
+    };
+
+    // now = 200: past both leases.
+    let audit = Capture::default();
+    let outcome = reconcile_step(&zone, &custodian, Some(&ctx), None, None, None, 200)
+        .with_subscriber(tracing::Dispatch::new(
+            tracing_subscriber::registry().with(
+                tracing_subscriber::fmt::layer()
+                    .json()
+                    .with_writer(audit.clone()),
+            ),
+        ))
+        .await
+        .expect("one unreadable pending entry must not fail the pass");
+    assert_eq!(
+        outcome,
+        Reconciled::Changed,
+        "the ordinary expired lease was reclaimed"
+    );
+    assert!(d0.get_fragment(frag(ordinary, 0)).await.unwrap().is_none());
+    assert!(meta
+        .get(&metadata::pending_key(ordinary))
+        .await
+        .unwrap()
+        .is_none());
+    assert!(
+        d0.get_fragment(frag(misfiled, 0)).await.unwrap().is_some(),
+        "GC reclaimed bytes on a lease it could not read as an ordinary one"
+    );
+    assert_eq!(
+        meta.get(&metadata::pending_key(misfiled)).await.unwrap(),
+        Some(misfiled_value),
+        "the misfiled entry is skipped, never deleted"
+    );
+
+    // Named for an operator: one audit line for the one skipped entry, on the GC audit seam,
+    // carrying the key to repair — and one tick of its counter.
+    let logged = String::from_utf8(audit.0.lock().unwrap().clone()).unwrap();
+    let named: Vec<&str> = logged
+        .lines()
+        .filter(|line| line.contains(r#""action":"unreadable-pending-entry""#))
+        .collect();
+    assert_eq!(
+        named.len(),
+        1,
+        "one audit line per skipped entry. got: {logged}"
+    );
+    assert!(
+        named[0].contains(r#""target":"wyrd.custodian.gc.audit""#),
+        "the skip must be reported on the GC audit seam. got: {logged}"
+    );
+    assert!(
+        named[0].contains(r#""entry":"pending:226""#),
+        "the audit line must name the entry to repair. got: {logged}"
+    );
+    assert_eq!(
+        logged.matches("gc_unreadable_pending_entries").count(),
+        1,
+        "got: {logged}"
+    );
+}
