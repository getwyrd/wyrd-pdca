+++ b/crates/custodian/src/role.rs
@@ -0,0 +1,118 @@
+//! The **runnable custodian role** — the wiring that turns the library durability
+//! plane into a *running process signal* (observability-floor proposal 0010
+//! §"Scope boundary" items 1–2; the keystone slice: item 1 installs the telemetry
+//! handle at role entry, item 2 runs the leader-elected loop through it).
+//!
+//! The M3 custodian shipped the loops (`reconciliation.rs`, `reconstruction.rs`, …)
+//! and the backend-agnostic telemetry seam ([`DurabilityTelemetry`], `telemetry.rs`)
+//! as a **library** (Option A, `reconstruction.rs:66-68`): a running control point
+//! *hands* the loops their inputs, but nothing binds the telemetry handle to the loop,
+//! so the durability metrics a pass emits reach no export surface unless a caller wires
+//! one up by hand. That is precisely the sim-only gap 0010 names: the day-one signal
+//! ("kill a D server → the under-replicated count rises, then returns to zero") is only
+//! ever observed through a bespoke test capture, never the real
+//! [`DurabilityTelemetry::gather_prometheus`] surface a deployment scrapes.
+//!
+//! [`CustodianRole`] closes that gap with the smallest honest wiring: it **owns** a
+//! telemetry handle (item 1) and runs the fenced [`reconcile_step`] control point with
+//! that handle's `tracing` → OpenTelemetry metrics bridge installed as the dispatch for
+//! the pass (item 2), so every durability-plane metric the loops emit lands in *this
+//! role's* provider and is observable through its export surface. It installs the bridge
+//! **scoped** (per pass, via [`WithSubscriber`]) rather than as a global default — the
+//! ADR-0035 rule forbids DST-reachable global mutable state, and the process-global
+//! `set_global_default` install belongs to the binary entry point (the server-crate
+//! slice), not this library seam.
+//!
+//! Deliberately **out of scope of the keystone** (0010's later slices, each its own
+//! bundle): the continuous run loop + leadership lifecycle (campaign, renew, step down),
+//! the `--log-level` / `RUST_LOG` `EnvFilter` + structured-stderr logging layer (item 3),
+//! the `tonic-health` readiness probe (item 7), and the `wyrd custodian` binary wiring in
+//! the `server` crate (item 2's deployment half). This seam is what those slices build on:
+//! they compose their layers onto the same telemetry handle and drive the same
+//! [`CustodianRole::reconcile_pass`].
+
+use tracing::instrument::WithSubscriber;
+use tracing::Dispatch;
+use tracing_subscriber::prelude::*;
+use tracing_subscriber::Registry;
+
+use crate::gc::GcContext;
+use crate::leadership::{Custodian, FencedZone};
+use crate::rebalance::RebalanceContext;
+use crate::reconciliation::{reconcile_step, ReconcileError, Reconciled};
+use crate::reconstruction::ReconstructionContext;
+use crate::scrub::ScrubContext;
+use crate::telemetry::DurabilityTelemetry;
+
+/// A running custodian role: it owns the durability-plane [`DurabilityTelemetry`] handle
+/// and drives the fenced reconciliation loop with that handle's metrics bridge installed,
+/// so the durability metrics a pass emits are captured by this role's provider and
+/// observable through its export surface ([`DurabilityTelemetry::gather_prometheus`] /
+/// OTLP). This is the wiring items 1–2 of proposal 0010 deliver — the library durability
+/// plane made real by a role that installs it at entry and runs the loop *through* it,
+/// rather than leaving the durability signal reachable only from ad-hoc test assembly.
+pub struct CustodianRole {
+    telemetry: DurabilityTelemetry,
+    /// The role's `tracing` dispatch, built **once** at construction over this role's
+    /// telemetry provider, so every pass records into the same instruments (and one
+    /// callsite-interest registration covers the whole role's lifetime). Cheap to clone
+    /// (an `Arc`); installed scoped per pass, never as a global default (ADR-0035).
+    dispatch: Dispatch,
+}
+
+impl CustodianRole {
+    /// Wire a role over `telemetry` — the durability-plane handle installed at role entry
+    /// (item 1). The handle's export surface(s) were chosen by the caller's
+    /// [`ExporterConfig`](crate::telemetry::ExporterConfig) (no backend hardcoded here,
+    /// ADR-0012); this role only routes the loops' emission into it.
+    pub fn new(telemetry: DurabilityTelemetry) -> Self {
+        let dispatch = Dispatch::new(Registry::default().with(telemetry.metrics_layer()));
+        Self {
+            telemetry,
+            dispatch,
+        }
+    }
+
+    /// This role's durability-plane telemetry handle — the read-back / export surface a
+    /// scrape endpoint (item 7, a later slice) exposes, and the in-process
+    /// [`DurabilityTelemetry::gather_prometheus`] the day-one signal is asserted through.
+    pub fn telemetry(&self) -> &DurabilityTelemetry {
+        &self.telemetry
+    }
+
+    /// Run **one** fenced reconciliation pass with this role's telemetry bridge installed
+    /// as the `tracing` dispatch for the pass (item 2). It delegates to the real
+    /// [`reconcile_step`] fenced control point — the *same* code path the M3 property
+    /// campaign drives, never a parallel entry (the anti-#141 guard) — and adds only the
+    /// telemetry wiring, so the durability metrics the loops emit
+    /// (`reconstruction_under_replicated`, queue depth, …) are captured by
+    /// [`Self::telemetry`] and observable through its export surface.
+    ///
+    /// The maintenance inputs select which loops the pass dispatches, exactly as
+    /// [`reconcile_step`] documents. A continuous run loop over this method (plus the
+    /// leadership lifecycle) is the deployment slice's concern, deferred (see the module
+    /// docs).
+    #[allow(clippy::too_many_arguments)]
+    pub async fn reconcile_pass(
+        &self,
+        zone: &FencedZone,
+        custodian: &Custodian,
+        gc: Option<&GcContext<'_>>,
+        scrub: Option<&ScrubContext<'_>>,
+        reconstruction: Option<&ReconstructionContext<'_>>,
+        rebalance: Option<&RebalanceContext<'_>>,
+        now_millis: u64,
+    ) -> Result<Reconciled, ReconcileError> {
+        reconcile_step(
+            zone,
+            custodian,
+            gc,
+            scrub,
+            reconstruction,
+            rebalance,
+            now_millis,
+        )
+        .with_subscriber(self.dispatch.clone())
+        .await
+    }
+}
