+/// Default zone the custodian campaigns for leadership under.
+const DEFAULT_CUSTODIAN_ZONE: &str = "zone-0";
+/// Default reconciliation interval for the custodian run loop.
+const DEFAULT_CUSTODIAN_INTERVAL_SECS: u64 = 30;
+
+/// `wyrd custodian`: the **deployable custodian role** (observability floor, proposal
+/// 0010 §"Scope boundary" item 2; the `wyrd custodian --otlp-endpoint …` bring-up command
+/// the M4 day-one blueprint makes true). It installs the shared telemetry handle at role
+/// entry (item 1), campaigns for single-active leadership over the zone, and runs the
+/// fenced reconciliation loop through that handle — so the durability metrics the loops
+/// emit (the under-replicated count that rises on a loss and returns to zero on repair —
+/// architecture §7.4 day-one step 4) land on the export surface a deployment scrapes,
+/// rather than staying reachable only from a library caller.
+///
+/// The export backend is chosen by [`ExporterConfig`] with **no backend hardcoded**
+/// (ADR-0012): `--otlp-endpoint` pushes to a collector (the production day-one path); the
+/// zero-dependency Prometheus registry is always wired for in-process read-back. When
+/// `--endpoints` name a D-server fleet, the loop runs the **reconstruction** plane over
+/// it (repairing under-replicated chunks and emitting the durability signal); with no
+/// fleet it runs the fenced heartbeat alone.
+///
+/// Like `d-server`, the coordination backend here is the process-local in-memory concrete,
+/// so cross-process single-active election awaits an etcd-backed `Coordination` behind the
+/// same seam (ADR-0006) — a composition swap, not this slice. A `/metrics` scrape endpoint
+/// (`tonic-health`, proposal 0010 item 7) and the `--log-level`/`RUST_LOG` structured-log
+/// layer (item 3) are the follow-on floor slices; this keystone delivers the runnable
+/// process and the durability emission through it.
+fn cmd_custodian(args: &[String]) -> Result<ExitCode, BoxError> {
+    let parsed = ParsedArgs::parse(args)?;
+    let data_dir = parsed.flag("data-dir").unwrap_or(DEFAULT_DATA_DIR);
+    let zone_name = parsed.flag("zone").unwrap_or(DEFAULT_CUSTODIAN_ZONE);
+    let interval = Duration::from_secs(parse_u64_flag(
+        &parsed,
+        "interval-secs",
+        DEFAULT_CUSTODIAN_INTERVAL_SECS,
+    )?);
+    // The export surface: a Prometheus registry is always wired (in-process read-back);
+    // `--otlp-endpoint` additionally pushes to a collector (the production path).
+    let exporter = match parsed.flag("otlp-endpoint") {
+        Some(endpoint) => ExporterConfig::Both {
+            otlp_endpoint: endpoint.to_string(),
+        },
+        None => ExporterConfig::Prometheus,
+    };
+    let endpoints = match parsed.flag("endpoints") {
+        Some(raw) => Some(parse_endpoints(raw)?),
+        None => None,
+    };
+
+    let meta = open_local_meta_redb(data_dir)?;
+    let runtime = tokio_runtime()?;
+    runtime.block_on(async move {
+        // Item 1: install the shared telemetry handle at role entry (the OTLP exporter is
+        // built on this runtime). Item 2: run the leader-elected loop through it.
+        let telemetry = DurabilityTelemetry::new(exporter)?;
+        let service = CustodianService::new(telemetry);
+
+        let coord = MemCoordination::new();
+        let custodian = Custodian::elect(&coord, zone_name).await?;
+        let mut zone = FencedZone::new();
+        zone.install(custodian.leadership());
+        eprintln!(
+            "wyrd custodian: single-active for zone `{zone_name}` (term {}); reconciling every {}s; Ctrl-C to stop",
+            custodian.term(),
+            interval.as_secs(),
+        );
+
+        let shutdown = async {
+            let _ = tokio::signal::ctrl_c().await;
+            eprintln!("wyrd custodian: shutting down");
+        };
+        let clock = wall_clock_millis;
+
+        match endpoints {
+            Some(endpoints) => {
+                // Connect each configured D server as its own addressable ChunkStore so the
+                // reconstruction plane can read *around* a loss, and register one failure
+                // domain per endpoint (the fan-out placement discipline the CLI proves).
+                let mut clients = Vec::with_capacity(endpoints.len());
+                for endpoint in &endpoints {
+                    let client = GrpcChunkStore::connect(endpoint.clone()).await.map_err(|e| {
+                        format!("custodian: cannot connect to D server `{endpoint}`: {e}")
+                    })?;
+                    clients.push(client);
+                }
+                let fleet: Vec<(DServerId, &dyn ChunkStore)> = clients
+                    .iter()
+                    .enumerate()
+                    .map(|(i, c)| (i as DServerId, c as &dyn ChunkStore))
+                    .collect();
+                let mut topology = Topology::default();
+                for i in 0..clients.len() {
+                    topology.register(i as DServerId, format!("domain-{i}"));
+                }
+                let ctx = ReconstructionContext {
+                    meta: &meta,
+                    fleet: &fleet,
+                    topology: &topology,
+                };
+                eprintln!(
+                    "wyrd custodian: reconstruction plane over {} D server(s)",
+                    endpoints.len()
+                );
+                service
+                    .run_until(
+                        &zone, &custodian, None, None, Some(&ctx), None, interval, clock, shutdown,
+                    )
+                    .await?;
+            }
+            None => {
+                eprintln!(
+                    "wyrd custodian: no --endpoints; running the fenced heartbeat (wire --endpoints to run the reconstruction plane)"
+                );
+                service
+                    .run_until(
+                        &zone, &custodian, None, None, None, None, interval, clock, shutdown,
+                    )
+                    .await?;
+            }
+        }
+        Ok::<(), BoxError>(())
+    })?;
+    Ok(ExitCode::SUCCESS)
+}
+
+/// Wall-clock milliseconds since the Unix epoch — the real instant the custodian's
+/// loops stamp their time-to-repair samples with. Monotonic enough for telemetry; a
+/// clock skew never corrupts state (the loops are fenced by leadership, not time).
+fn wall_clock_millis() -> u64 {
+    SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .map(|d| d.as_millis() as u64)
+        .unwrap_or(0)
+}
+
