+            // `tokio::time::timeout`/`tokio::time::sleep` must be CONSTRUCTED inside the
+            // runtime's context (they register with the runtime's timer driver on
+            // creation) — building one as an eager argument to `block_on` panics with "no
+            // reactor running" because it is constructed before `block_on` enters the
+            // runtime. The `async move` block defers construction to poll time, which runs
+            // inside that context.
+            let status = runtime.block_on(async move {
+                loop {
+                    let remaining = deadline.saturating_sub(started.elapsed());
+                    if remaining.is_zero() {
+                        return None;
+                    }
+                    match tokio::time::timeout(remaining, self.db.get_client_status()).await {
+                        Ok(Ok(bytes)) => {
+                            if let Some(status) = client_status(&bytes) {
+                                return Some(status);
+                            }
+                            // Unsettled ("connecting") or unparsable this round: a short
+                            // pause, still bounded by `remaining` above on the next lap.
+                            let pause = STATUS_POLL_INTERVAL
+                                .min(deadline.saturating_sub(started.elapsed()));
+                            if pause.is_zero() {
+                                return None;
+                            }
+                            tokio::time::sleep(pause).await;
+                        }
+                        Ok(Err(_)) | Err(_) => return None,
+                    }
+                }
+            });
+            let elapsed = started.elapsed();
+
+            match preflight::verdict(status.as_ref(), elapsed, deadline) {
+                preflight::Verdict::Ready => Ok(()),
+                other => Err(preflight::message(&other).into()),
+            }
         }
 
