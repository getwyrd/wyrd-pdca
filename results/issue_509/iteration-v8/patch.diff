+/// Parse a `<Delete>` DeleteObjects body into its keys + `Quiet` flag via the strict
+/// [`DeleteScanner`]. Unknown elements (`<VersionId>`, a stray `<Prefix>`, …) are ignored per
+/// the fixed schema, but the document MUST be well-formed XML with exactly one `<Delete>` root
+/// — anything else is [`MalformedXml`], and a rejected body deletes nothing. Keys are captured
+/// entity-unescaped.
+fn parse_delete(body: &str) -> Result<DeleteRequest, MalformedXml> {
+    DeleteScanner::new(body).parse()
+}
