+/// The most keys a single `DeleteObjects` request may name. S3 caps a bulk delete at 1000
+/// objects; a body naming more is refused with `MalformedXML`, never silently truncated to
+/// the first 1000 (which would leave the caller believing keys were deleted that were not).
+const MAX_DELETE_KEYS: usize = 1000;
+
+/// The byte cap on a **buffered** `DeleteObjects` request body. Unlike an object PUT — whose
+/// body streams and is never resident whole (the "stream, don't buffer" invariant) — the
+/// bulk-delete body is small and bounded by construction (≤1000 keys, each an S3 key ≤1024
+/// bytes, plus `<Object><Key>…` framing), so buffering it whole is acceptable here. The cap
+/// makes that bound hold **by construction rather than by trusting the client's declared
+/// `Content-Length`**: a body larger than this is refused as it is read, before it is fully
+/// resident (issue #509 design). 2 MiB leaves generous headroom over the ~1 MiB a full
+/// 1000×1024-byte-key request occupies.
+const MAX_DELETE_BODY_BYTES: usize = 2 * 1024 * 1024;
+
+/// One key's fate in a bulk delete, rendered into the `<DeleteResult>`.
+enum DeleteOutcome {
+    /// The key was removed OR was already absent — S3 delete is idempotent, so both are a
+    /// `<Deleted>` (suppressed under `Quiet`).
+    Deleted(String),
+    /// The per-key delete failed at the gateway; reported as a per-key `<Error>` (code +
+    /// message from the shared [`classify`] mapping) rather than failing the whole request —
+    /// the per-key result contract `aws s3 sync --delete` relies on.
+    Error {
+        key: String,
+        code: &'static str,
+        message: String,
+    },
+}
+
+/// Handle a bulk `DeleteObjects` — `POST /bucket?delete` (issue #509). The single-object
+/// delete path already provides the correct per-key semantics (CAS unlink, orphan grace,
+/// idempotency); this is a wire-level fan-out over it plus XML in/out.
+///
+/// The body is SigV4-signed and small (≤1000 keys), so it is buffered whole under an explicit
+/// byte cap ([`MAX_DELETE_BODY_BYTES`]) and — for a `Signed` payload — verified against the
+/// signed digest exactly as the object PUT path checks its content hash, so a tampered body is
+/// rejected before any key is touched. Keys execute sequentially (correctness first at Alpha;
+/// concurrency is an optimisation the acceptance does not require), and a per-key gateway error
+/// becomes a per-key `<Error>` instead of failing the batch.
+///
+/// `bucket` arrives already percent-decoded (the URL path form the object path decodes); each
+/// key is XML-entity-unescaped out of the body ([`parse_delete`]; the body is not a URL so it is
+/// not percent-decoded), and the two compose onto the M0 flat namespace as `"{bucket}/{key}"` —
+/// byte-identical to the single-object DELETE path's `object_key`.
+async fn bulk_delete<G>(
+    state: &AppState<G>,
+    request_id: RequestId,
+    bucket: &str,
+    payload: sigv4::PayloadHash,
+    body: Body,
+) -> Response
+where
+    G: ObjectGateway,
+{
+    // Buffer the body under the byte cap (de-framing an `aws-chunked` stream if the client
+    // sent one, though a stock SDK sends the small delete body single-shot).
+    let body_bytes = match buffer_capped(&payload, body, MAX_DELETE_BODY_BYTES).await {
+        Ok(bytes) => bytes,
+        Err(BufferError::TooLarge) => {
+            return error_response(
+                request_id,
+                StatusCode::BAD_REQUEST,
+                "MalformedXML",
+                "the DeleteObjects request body exceeds the maximum size",
+            )
+        }
+        Err(BufferError::Read(err)) => return gateway_error_response(request_id, &err),
+    };
+
+    // Verify the buffered body against the signed digest, mirroring the object PUT: a `Signed`
+    // request's `x-amz-content-sha256` is the hex SHA-256 of the whole body. (`Unsigned` /
+    // `Streaming` have nothing to check here — the latter is authenticated per chunk as it is
+    // de-framed above.)
+    if let sigv4::PayloadHash::Signed(expected_hex) = &payload {
+        let actual_hex = crypto::hex(&crypto::sha256(&body_bytes));
+        if !crypto::constant_time_eq(actual_hex.as_bytes(), expected_hex.as_bytes()) {
+            return error_response(
+                request_id,
+                StatusCode::BAD_REQUEST,
+                "XAmzContentSHA256Mismatch",
+                "the delivered body does not match the signed x-amz-content-sha256",
+            );
+        }
+    }
+
+    let Ok(body_str) = std::str::from_utf8(&body_bytes) else {
+        return error_response(
+            request_id,
+            StatusCode::BAD_REQUEST,
+            "MalformedXML",
+            "the DeleteObjects request body is not valid UTF-8",
+        );
+    };
+    let request = match parse_delete(body_str) {
+        Ok(request) => request,
+        Err(_) => {
+            return error_response(
+                request_id,
+                StatusCode::BAD_REQUEST,
+                "MalformedXML",
+                "the XML you provided was not well-formed or did not validate",
+            )
+        }
+    };
+    // S3 bounds a bulk delete at 1..=1000 keys; outside that range is `MalformedXML` (refused,
+    // not truncated). The body byte cap already bounds the parse, so this is a semantic bound.
+    if request.keys.is_empty() || request.keys.len() > MAX_DELETE_KEYS {
+        return error_response(
+            request_id,
+            StatusCode::BAD_REQUEST,
+            "MalformedXML",
+            "a DeleteObjects request must name between 1 and 1000 keys",
+        );
+    }
+
+    let mut outcomes = Vec::with_capacity(request.keys.len());
+    for key in &request.keys {
+        let object_key = format!("{bucket}/{key}");
+        match state.gateway.delete_object(&object_key).await {
+            // Idempotent: `Ok(true)` (removed) and `Ok(false)` (already absent) are both a
+            // `<Deleted>` — S3 delete of a missing key is a success. Mirrors the single-object
+            // DELETE arm (`Method::DELETE => … Ok(_) => …`).
+            Ok(_) => outcomes.push(DeleteOutcome::Deleted(key.clone())),
+            Err(err) => {
+                let (_, code, message) = classify(&err);
+                outcomes.push(DeleteOutcome::Error {
+                    key: key.clone(),
+                    code,
+                    message,
+                });
+            }
+        }
+    }
+    xml_ok_response(render_delete_result(&outcomes, request.quiet))
+}
+
+/// The `200` a successful bulk `DeleteObjects` answers with: the `<DeleteResult>` document,
+/// declared `application/xml` — the same content-type the error bodies use ([`error_response`]).
+/// The `x-amz-request-id` header is stamped by [`handle`] on the way out, as it is for every
+/// response, so it is not set here.
+fn xml_ok_response(body: String) -> Response {
+    Response::builder()
+        .status(StatusCode::OK)
+        .header("content-type", "application/xml")
+        .body(Body::from(body))
+        .expect("static response is always valid")
+}
+
+/// Why buffering a bulk-delete body stopped short of a complete read.
+enum BufferError {
+    /// The body exceeded [`MAX_DELETE_BODY_BYTES`] — refused (400 `MalformedXML`) before it is
+    /// fully resident.
+    TooLarge,
+    /// The transport (or the `aws-chunked` de-framer) yielded an error mid-read.
+    Read(BoxError),
+}
+
+/// Buffer a request body to a `Vec`, refusing once `cap` bytes are exceeded. An `aws-chunked`
+/// streaming body is de-framed ([`streaming::decode`], which authenticates each chunk) so the
+/// buffered bytes are the object payload, not the wire framing; every other payload form is the
+/// raw body. Used only for the small, bounded bulk-delete body — object PUT/GET stay streaming.
+async fn buffer_capped(
+    payload: &sigv4::PayloadHash,
+    body: Body,
+    cap: usize,
+) -> Result<Vec<u8>, BufferError> {
+    let raw = body
+        .into_data_stream()
+        .map(|item| item.map_err(|e| Box::new(e) as BoxError));
+    let mut stream: std::pin::Pin<
+        Box<dyn futures_util::Stream<Item = wyrd_traits::Result<bytes::Bytes>> + Send>,
+    > = match payload {
+        sigv4::PayloadHash::Streaming(ctx) => {
+            Box::pin(streaming::decode(Box::pin(raw), ctx.clone()))
+        }
+        _ => Box::pin(raw),
+    };
+    let mut buf = Vec::new();
+    while let Some(chunk) = stream.next().await {
+        let chunk = chunk.map_err(BufferError::Read)?;
+        if buf.len() + chunk.len() > cap {
+            return Err(BufferError::TooLarge);
+        }
+        buf.extend_from_slice(&chunk);
+    }
+    Ok(buf)
+}
+
+/// Render the `<DeleteResult>` for a bulk delete. Under `quiet` the successful `<Deleted>`
+/// entries are omitted (S3's `Quiet` mode reports only errors); a per-key `<Error>` is always
+/// reported. Every key/code/message is XML-escaped so a key carrying markup cannot break the
+/// document — the same discipline the error body and the listing renderers use.
+fn render_delete_result(outcomes: &[DeleteOutcome], quiet: bool) -> String {
+    let mut xml = String::from(
+        "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\
+         <DeleteResult xmlns=\"http://s3.amazonaws.com/doc/2006-03-01/\">",
+    );
+    for outcome in outcomes {
+        match outcome {
+            DeleteOutcome::Deleted(key) => {
+                if !quiet {
+                    xml.push_str("<Deleted><Key>");
+                    xml.push_str(&xml_escape(key));
+                    xml.push_str("</Key></Deleted>");
+                }
+            }
+            DeleteOutcome::Error { key, code, message } => {
+                xml.push_str("<Error><Key>");
+                xml.push_str(&xml_escape(key));
+                xml.push_str("</Key><Code>");
+                xml.push_str(&xml_escape(code));
+                xml.push_str("</Code><Message>");
+                xml.push_str(&xml_escape(message));
+                xml.push_str("</Message></Error>");
+            }
+        }
+    }
+    xml.push_str("</DeleteResult>");
+    xml
+}
+
+/// A parsed `<Delete>` request body: the object keys to remove and the `Quiet` flag.
+#[derive(Debug, PartialEq, Eq)]
+struct DeleteRequest {
+    keys: Vec<String>,
+    quiet: bool,
+}
+
+/// The `<Delete>` body is not a well-formed XML document of the fixed S3 `DeleteObjects`
+/// schema — mapped by the caller to `400 MalformedXML`. Carries a short static reason for a
+/// server-side diagnosis; the client only ever sees the generic S3 code.
+#[derive(Debug, PartialEq, Eq)]
+struct MalformedXml(&'static str);
+
+/// The deepest element nesting the scanner accepts. The S3 `DeleteObjects` schema is three
+/// deep (`<Delete><Object><Key>`); this generous bound rejects a pathologically nested body
+/// (which the byte cap alone would let build a huge element stack) so a malformed request
+/// cannot amplify into unbounded work. Well past anything a real client sends.
+const MAX_XML_DEPTH: usize = 100;
+
+/// True for an ASCII character that may **start** an XML `Name` in the subset this schema uses:
+/// a letter, `_`, or `:` (a namespace separator). Deliberately narrower than the full XML
+/// `NameStartChar` production — the S3 `DeleteObjects` schema uses only ASCII element names and
+/// the `xmlns` prefix, so anything outside this set at the head of a name is a malformed body,
+/// not a name to salvage.
+fn is_name_start(c: char) -> bool {
+    c.is_ascii_alphabetic() || c == '_' || c == ':'
+}
+
+/// True for a character that may **continue** an XML `Name`: a name-start char, an ASCII digit,
+/// `-`, or `.`.
+fn is_name_char(c: char) -> bool {
+    is_name_start(c) || c.is_ascii_digit() || c == '-' || c == '.'
+}
+
+/// XML `S` (white space): the ONLY four characters that separate tokens (`#x20 #x9 #xD #xA`).
+fn is_xml_ws(c: char) -> bool {
+    matches!(c, ' ' | '\t' | '\r' | '\n')
+}
+
+/// The **local** part of an element/attribute `Name` — any `ns:` namespace prefix stripped, so
+/// `Delete` reads as `Delete` and `s3:Object` as `Object`. A name whose local part is empty
+/// (`foo:`) is [`MalformedXml`].
+fn local_name(name: &str) -> Result<&str, MalformedXml> {
+    let local = name.rsplit_once(':').map_or(name, |(_, local)| local);
+    if local.is_empty() {
+        return Err(MalformedXml("empty local element name"));
+    }
+    Ok(local)
+}
+
+/// One open element on the [`DeleteScanner`] stack: its **raw** `Name` as written (so the end
+/// tag can be required to match it EXACTLY, prefix included — XML forbids `<s3:Object></Object>`),
+/// its namespace-stripped local name (for the `<Key>` / `<Quiet>` semantics), and the character
+/// data accumulated directly inside it.
+struct OpenElement {
+    name: String,
+    local: String,
+    text: String,
+}
+
+/// A strict, single-pass XML **well-formedness** scanner for the fixed S3 `DeleteObjects`
+/// body. The workspace has no XML crate, and adding one is a human-gated dependency decision
+/// (ADR-0003 three-test audit + `deny.toml`), so this is a small in-crate scanner scoped to
+/// exactly this body — but written as a *validating* grammar, not a lenient tokenizer.
+///
+/// **The invariant this type exists to hold:** a body that is not a well-formed XML document of
+/// the schema is [`MalformedXml`] and authorises no deletion. It is validated character by
+/// character against the XML productions and fails **closed** on the first deviation — there is
+/// no "reduce a mangled tag to a plausible one" path (the recurring destructive defect of the
+/// earlier hand tokenizer: `</Key garbage>` reduced to `</Key>`, a duplicate/`<`-bearing
+/// attribute accepted, a second root or trailing junk silently discarded). Every one of those
+/// is a distinct rule below (`ETag` allows only `S? '>'` after the name; `STag` requires each
+/// attribute be `S`-separated with a unique name and a `[^<&]`/valid-`Reference` value; the
+/// document has exactly one root and only `Misc` around it).
+///
+/// It skips the XML declaration, comments (`--` forbidden inside) and processing instructions,
+/// reads a `<![CDATA[…]]>` section as literal text, and rejects a DOCTYPE (DTDs are unsupported —
+/// fail closed) and any structurally broken construct (an unterminated tag/comment/CDATA/
+/// entity, a mismatched or stray end tag, an over-deep nest).
+struct DeleteScanner<'a> {
+    input: &'a str,
+    pos: usize,
+    stack: Vec<OpenElement>,
+    keys: Vec<String>,
+    quiet: bool,
+    /// Whether the single root element has been opened yet. Once the root has opened and
+    /// closed (stack empty again), another element is a **second root** — rejected, not run.
+    root_seen: bool,
+}
+
+impl<'a> DeleteScanner<'a> {
+    fn new(input: &'a str) -> Self {
+        Self {
+            input,
+            pos: 0,
+            stack: Vec::new(),
+            keys: Vec::new(),
+            quiet: false,
+            root_seen: false,
+        }
+    }
+
+    /// The unconsumed tail. Borrows the `'a` input, not `self`, so callers may mutate `self.pos`
+    /// while a slice of it is still in hand.
+    fn rest(&self) -> &'a str {
+        &self.input[self.pos..]
+    }
+
+    fn peek(&self) -> Option<char> {
+        self.rest().chars().next()
+    }
+
+    /// Consume `s` if the tail starts with it; report whether it did.
+    fn eat(&mut self, s: &str) -> bool {
+        if self.rest().starts_with(s) {
+            self.pos += s.len();
+            true
+        } else {
+            false
+        }
+    }
+
+    /// Consume a run of XML white space; return how many bytes were skipped (0 = none). The
+    /// count is load-bearing in a start tag: an attribute MUST be `S`-separated, so a
+    /// zero-length skip before a non-`>` char means something is butted onto a name.
+    fn skip_ws(&mut self) -> usize {
+        let start = self.pos;
+        while let Some(c) = self.peek() {
+            if is_xml_ws(c) {
+                self.pos += c.len_utf8();
+            } else {
+                break;
+            }
+        }
+        self.pos - start
+    }
+
+    /// Consume a leading XML `Name` (ASCII subset) and return it, advancing past it. `Err` when
+    /// the tail does not begin with a `NameStartChar` — an ill-formed name the caller rejects
+    /// rather than reducing arbitrary bytes to a plausible-looking name.
+    fn parse_name(&mut self) -> Result<&'a str, MalformedXml> {
+        let input = self.input;
+        let start = self.pos;
+        let mut first = true;
+        while let Some(c) = input[self.pos..].chars().next() {
+            if first {
+                if !is_name_start(c) {
+                    break;
+                }
+                first = false;
+            } else if !is_name_char(c) {
+                break;
+            }
+            self.pos += c.len_utf8();
+        }
+        if self.pos == start {
+            return Err(MalformedXml("expected an XML name"));
+        }
+        Ok(&input[start..self.pos])
+    }
+
+    /// Parse the whole document, returning the collected keys + `Quiet`. Grammar:
+    /// `document ::= Misc* element Misc*` (an optional XML declaration counts as the first
+    /// `Misc`). Exactly one root; only insignificant white space / comments / PIs may surround
+    /// it — any other content before or after is [`MalformedXml`].
+    fn parse(mut self) -> Result<DeleteRequest, MalformedXml> {
+        while self.pos < self.input.len() {
+            if self.stack.is_empty() {
+                self.step_outside_root()?;
+            } else {
+                self.step_inside_element()?;
+            }
+        }
+        if !self.stack.is_empty() {
+            return Err(MalformedXml("unclosed element"));
+        }
+        if !self.root_seen {
+            return Err(MalformedXml("missing <Delete> root element"));
+        }
+        Ok(DeleteRequest {
+            keys: self.keys,
+            quiet: self.quiet,
+        })
+    }
+
+    /// One step in the prolog/epilog (stack empty): insignificant white space, a comment, a PI /
+    /// the XML declaration, or the ONE root element. Everything else — character data, a second
+    /// root, a DOCTYPE, a stray end tag, a CDATA — is [`MalformedXml`].
+    fn step_outside_root(&mut self) -> Result<(), MalformedXml> {
+        self.skip_ws();
+        if self.pos >= self.input.len() {
+            return Ok(());
+        }
+        if self.peek() != Some('<') {
+            return Err(MalformedXml("character data outside the root element"));
+        }
+        if self.eat("<?") {
+            self.skip_pi()
+        } else if self.eat("<!--") {
+            self.skip_comment()
+        } else if self.rest().starts_with("</") {
+            Err(MalformedXml("end tag with no open element"))
+        } else if self.rest().starts_with("<!") {
+            // A DOCTYPE or a CDATA outside the root: DTDs are unsupported (fail closed) and
+            // CDATA is character data, not permitted outside the root.
+            Err(MalformedXml(
+                "unsupported declaration outside the root element",
+            ))
+        } else {
+            if self.root_seen {
+                return Err(MalformedXml("more than one root element"));
+            }
+            self.root_seen = true;
+            let (name, local, empty) = self.parse_start_tag()?;
+            if local != "Delete" {
+                return Err(MalformedXml("root element is not <Delete>"));
+            }
+            if empty {
+                // A `<Delete/>` root: no children, no keys. Left for the caller's 1..=1000-key
+                // check to refuse.
+                self.close_element(&local, String::new());
+            } else {
+                self.push(name, local)?;
+            }
+            Ok(())
+        }
+    }
+
+    /// One step inside an open element (stack non-empty): character data / a reference, or a
+    /// markup construct (child element, end tag, comment, PI, CDATA).
+    fn step_inside_element(&mut self) -> Result<(), MalformedXml> {
+        match self.peek() {
+            Some('<') => self.step_markup(),
+            Some('&') => {
+                let decoded = self.parse_reference()?;
+                self.stack
+                    .last_mut()
+                    .expect("inside an element")
+                    .text
+                    .push(decoded);
+                Ok(())
+            }
+            Some(_) => {
+                // A run of plain character data up to the next `<` or `&`.
+                let input = self.input;
+                let start = self.pos;
+                while let Some(c) = input[self.pos..].chars().next() {
+                    if c == '<' || c == '&' {
+                        break;
+                    }
+                    self.pos += c.len_utf8();
+                }
+                let run = &input[start..self.pos];
+                // `]]>` may not appear literally in character data (XML §2.4).
+                if run.contains("]]>") {
+                    return Err(MalformedXml("']]>' not allowed in character data"));
+                }
+                self.stack
+                    .last_mut()
+                    .expect("inside an element")
+                    .text
+                    .push_str(run);
+                Ok(())
+            }
+            None => Err(MalformedXml("unclosed element")),
+        }
+    }
+
+    /// Dispatch a `<…` markup construct encountered inside an element.
+    fn step_markup(&mut self) -> Result<(), MalformedXml> {
+        if self.eat("<?") {
+            self.skip_pi()
+        } else if self.eat("<!--") {
+            self.skip_comment()
+        } else if self.eat("<![CDATA[") {
+            self.parse_cdata()
+        } else if self.rest().starts_with("<!") {
+            Err(MalformedXml(
+                "unsupported '<!' declaration inside an element",
+            ))
+        } else if self.rest().starts_with("</") {
+            self.parse_end_tag()
+        } else {
+            let (name, local, empty) = self.parse_start_tag()?;
+            if empty {
+                self.close_element(&local, String::new());
+                Ok(())
+            } else {
+                self.push(name, local)
+            }
+        }
+    }
+
+    /// Push a newly opened element, enforcing the depth bound.
+    fn push(&mut self, name: String, local: String) -> Result<(), MalformedXml> {
+        if self.stack.len() >= MAX_XML_DEPTH {
+            return Err(MalformedXml("element nesting too deep"));
+        }
+        self.stack.push(OpenElement {
+            name,
+            local,
+            text: String::new(),
+        });
+        Ok(())
+    }
+
+    /// Parse a start tag `'<' Name (S Attribute)* S? '>'` or an empty-element tag
+    /// `'<' Name (S Attribute)* S? '/>'`, the cursor at the opening `<`. Returns
+    /// `(raw_name, local_name, is_empty_element)` — the RAW name so the caller can require the
+    /// end tag to match it exactly (prefix included). Enforces: no white space between `<` and
+    /// the name; each attribute is `S`-separated, has a unique name (Unique Att Spec), an `=`,
+    /// and a quoted `AttValue` free of a raw `<` and with `&` only starting a valid `Reference`.
+    /// Junk after the name (`<Delete garbage>`) is rejected, never reduced away.
+    fn parse_start_tag(&mut self) -> Result<(String, String, bool), MalformedXml> {
+        // Consume the '<' (the caller has already ruled out `</`, `<?`, `<!` forms).
+        self.pos += 1;
+        let name = self.parse_name()?;
+        // Reject an empty local part (`foo:`) now; keep the RAW name for exact end-tag matching.
+        let local = local_name(name)?.to_string();
+        let mut seen: Vec<&'a str> = Vec::new();
+        loop {
+            let ws = self.skip_ws();
+            match self.peek() {
+                Some('>') => {
+                    self.pos += 1;
+                    return Ok((name.to_string(), local, false));
+                }
+                Some('/') => {
+                    self.pos += 1;
+                    if self.peek() == Some('>') {
+                        self.pos += 1;
+                        return Ok((name.to_string(), local, true));
+                    }
+                    return Err(MalformedXml("expected '/>' to close an empty-element tag"));
+                }
+                None => return Err(MalformedXml("unterminated start tag")),
+                Some(_) => {
+                    // An attribute must be white-space-separated from the name / prior value; a
+                    // zero-length skip means junk is butted on (`<Delete=…>`, `<Object x>`'s
+                    // missing `=` is caught below).
+                    if ws == 0 {
+                        return Err(MalformedXml("attribute not separated by white space"));
+                    }
+                    let attr = self.parse_name()?;
+                    if seen.contains(&attr) {
+                        return Err(MalformedXml("duplicate attribute name (Unique Att Spec)"));
+                    }
+                    seen.push(attr);
+                    self.skip_ws();
+                    if !self.eat("=") {
+                        return Err(MalformedXml("attribute missing '='"));
+                    }
+                    self.skip_ws();
+                    self.parse_att_value()?;
+                }
+            }
+        }
+    }
+
+    /// Parse and DISCARD an `AttValue` (the schema carries no meaningful attributes), validating
+    /// its syntax: a `"`/`'` delimiter, then `([^<&delim] | Reference)*`, then the matching
+    /// delimiter. A raw `<`, a bare/`unknown` `&` (a `&` not starting a valid `Reference`), or an
+    /// unterminated value is [`MalformedXml`].
+    fn parse_att_value(&mut self) -> Result<(), MalformedXml> {
+        let quote = match self.peek() {
+            Some(c @ ('"' | '\'')) => c,
+            _ => return Err(MalformedXml("attribute value must be quoted")),
+        };
+        self.pos += quote.len_utf8();
+        loop {
+            match self.peek() {
+                None => return Err(MalformedXml("unterminated attribute value")),
+                Some(c) if c == quote => {
+                    self.pos += c.len_utf8();
+                    return Ok(());
+                }
+                Some('<') => return Err(MalformedXml("'<' not allowed in an attribute value")),
+                Some('&') => {
+                    self.parse_reference()?;
+                }
+                Some(c) => self.pos += c.len_utf8(),
+            }
+        }
+    }
+
+    /// Parse an end tag `'</' Name S? '>'`, the cursor at `</`. Per the XML `ETag` production
+    /// ONLY white space may follow the name — `</Key garbage>` is [`MalformedXml`], never a
+    /// lenient `</Key>`. The name must match the innermost open element's RAW name **exactly**
+    /// (prefix included): `<s3:Object></Object>` is a well-formedness violation, not a match on
+    /// the shared local part.
+    fn parse_end_tag(&mut self) -> Result<(), MalformedXml> {
+        self.pos += 2; // consume '</'
+        let name = self.parse_name()?;
+        self.skip_ws();
+        if !self.eat(">") {
+            return Err(MalformedXml("junk after end-tag name"));
+        }
+        let frame = self
+            .stack
+            .pop()
+            .ok_or(MalformedXml("end tag with no open element"))?;
+        if frame.name != name {
+            return Err(MalformedXml("end tag does not match the open element"));
+        }
+        self.close_element(&frame.local, frame.text);
+        Ok(())
+    }
+
+    /// Apply an element's close: a `<Key>` directly inside `<Object>` contributes its text as an
+    /// object key; a `<Quiet>` directly inside `<Delete>` sets the flag; every other element is
+    /// an ignored unknown (its text discarded). Called AFTER the element is off the stack, so
+    /// `self.stack.last()` is the parent context.
+    fn close_element(&mut self, local: &str, text: String) {
+        match self.stack.last().map(|f| f.local.as_str()) {
+            Some("Object") if local == "Key" => self.keys.push(text),
+            Some("Delete") if local == "Quiet" => {
+                self.quiet = matches!(text.trim(), "true" | "1");
+            }
+            _ => {}
+        }
+    }
+
+    /// Skip a processing instruction / XML declaration, the cursor just past `<?`.
+    fn skip_pi(&mut self) -> Result<(), MalformedXml> {
+        match self.rest().find("?>") {
+            Some(i) => {
+                self.pos += i + 2;
+                Ok(())
+            }
+            None => Err(MalformedXml("unterminated processing instruction")),
+        }
+    }
+
+    /// Skip a comment, the cursor just past `<!--`. A comment body may not contain `--`; the
+    /// first `--` must be the `-->` terminator (XML §2.5).
+    fn skip_comment(&mut self) -> Result<(), MalformedXml> {
+        let rest = self.rest();
+        match rest.find("--") {
+            Some(i) => {
+                if rest[i + 2..].starts_with('>') {
+                    self.pos += i + 3;
+                    Ok(())
+                } else {
+                    Err(MalformedXml("'--' not allowed inside a comment"))
+                }
+            }
+            None => Err(MalformedXml("unterminated comment")),
+        }
+    }
+
+    /// Read a `<![CDATA[ … ]]>` section as literal text into the current element, the cursor
+    /// just past `<![CDATA[`.
+    fn parse_cdata(&mut self) -> Result<(), MalformedXml> {
+        let rest = self.rest();
+        match rest.find("]]>") {
+            Some(i) => {
+                let literal = &rest[..i];
+                self.stack
+                    .last_mut()
+                    .expect("CDATA only appears inside an element")
+                    .text
+                    .push_str(literal);
+                self.pos += i + 3;
+                Ok(())
+            }
+            None => Err(MalformedXml("unterminated CDATA section")),
+        }
+    }
+
+    /// Parse a `Reference` at the cursor's `&`, returning the decoded character. Handles the five
+    /// predefined entities (`&amp; &lt; &gt; &quot; &apos;`) and numeric character references
+    /// (`&#38;`, `&#x26;`). A bare `&`, an unterminated reference, an unknown entity, or an
+    /// out-of-range code point is [`MalformedXml`] — the parser rejects a malformed body, it does
+    /// not pass a stray `&` through.
+    fn parse_reference(&mut self) -> Result<char, MalformedXml> {
+        self.pos += 1; // consume '&'
+        if self.eat("#") {
+            let hex = self.eat("x") || self.eat("X");
+            let radix = if hex { 16 } else { 10 };
+            let input = self.input;
+            let start = self.pos;
+            while let Some(c) = input[self.pos..].chars().next() {
+                if c == ';' {
+                    break;
+                }
+                if c.to_digit(radix).is_none() {
+                    return Err(MalformedXml("bad character reference"));
+                }
+                self.pos += c.len_utf8();
+            }
+            let digits = &input[start..self.pos];
+            if !self.eat(";") {
+                return Err(MalformedXml("unterminated character reference"));
+            }
+            if digits.is_empty() {
+                return Err(MalformedXml("empty character reference"));
+            }
+            let code = u32::from_str_radix(digits, radix)
+                .map_err(|_| MalformedXml("bad character reference"))?;
+            char::from_u32(code).ok_or(MalformedXml("character reference out of range"))
+        } else {
+            let name = self.parse_name()?;
+            if !self.eat(";") {
+                return Err(MalformedXml("unterminated entity reference"));
+            }
+            match name {
+                "amp" => Ok('&'),
+                "lt" => Ok('<'),
+                "gt" => Ok('>'),
+                "quot" => Ok('"'),
+                "apos" => Ok('\''),
+                _ => Err(MalformedXml("unknown entity reference")),
+            }
+        }
+    }
+}
