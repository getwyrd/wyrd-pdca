+/// The most keys a single `DeleteObjects` request may name. S3 caps a bulk delete at 1000
+/// objects; a body naming more is refused with `MalformedXML`, never silently truncated to
+/// the first 1000 (which would leave the caller believing keys were deleted that were not).
+const MAX_DELETE_KEYS: usize = 1000;
+
+/// The byte cap on a **buffered** `DeleteObjects` request body. Unlike an object PUT — whose
+/// body streams and is never resident whole (the "stream, don't buffer" invariant) — the
+/// bulk-delete body is small and bounded by construction (≤1000 keys, each an S3 key ≤1024
+/// bytes, plus `<Object><Key>…` framing), so buffering it whole is acceptable here. The cap
+/// makes that bound hold **by construction rather than by trusting the client's declared
+/// `Content-Length`**: a body larger than this is refused as it is read, before it is fully
+/// resident (issue #509 design — "enforce an explicit byte cap so the bound is by
+/// construction, not by trust"). 2 MiB leaves generous headroom over the ~1 MiB a full
+/// 1000×1024-byte-key request occupies.
+const MAX_DELETE_BODY_BYTES: usize = 2 * 1024 * 1024;
+
+/// One key's fate in a bulk delete, rendered into the `<DeleteResult>`.
+enum DeleteOutcome {
+    /// The key was removed OR was already absent — S3 delete is idempotent, so both are a
+    /// `<Deleted>` (suppressed under `Quiet`).
+    Deleted(String),
+    /// The per-key delete failed at the gateway; reported as a per-key `<Error>` (code +
+    /// message from the shared [`classify`] mapping) rather than failing the whole request —
+    /// the per-key result contract `aws s3 sync --delete` relies on.
+    Error {
+        key: String,
+        code: &'static str,
+        message: String,
+    },
+}
+
+/// Handle a bulk `DeleteObjects` — `POST /bucket?delete` (issue #509). The single-object
+/// delete path already provides the correct per-key semantics (CAS unlink, orphan grace,
+/// idempotency); this is a wire-level fan-out over it plus XML in/out.
+///
+/// The body is SigV4-signed and small (≤1000 keys), so it is buffered whole under an explicit
+/// byte cap ([`MAX_DELETE_BODY_BYTES`]) and — for a `Signed` payload — verified against the
+/// signed digest exactly as the object PUT path checks its content hash, so a tampered body is
+/// rejected before any key is touched. Keys execute sequentially (correctness first at Alpha;
+/// concurrency is an optimisation the acceptance does not require), and a per-key gateway error
+/// becomes a per-key `<Error>` instead of failing the batch.
+///
+/// `bucket` arrives already percent-decoded (the URL path form the object path decodes); each
+/// key is XML-entity-unescaped out of the body ([`xml_unescape`], the body is not a URL so it is
+/// not percent-decoded), and the two compose onto the M0 flat namespace as `"{bucket}/{key}"` —
+/// byte-identical to the single-object DELETE path's `object_key`.
+async fn bulk_delete<G>(
+    state: &AppState<G>,
+    request_id: RequestId,
+    bucket: &str,
+    payload: sigv4::PayloadHash,
+    body: Body,
+) -> Response
+where
+    G: ObjectGateway,
+{
+    // Buffer the body under the byte cap (de-framing an `aws-chunked` stream if the client
+    // sent one, though a stock SDK sends the small delete body single-shot).
+    let body_bytes = match buffer_capped(&payload, body, MAX_DELETE_BODY_BYTES).await {
+        Ok(bytes) => bytes,
+        Err(BufferError::TooLarge) => {
+            return error_response(
+                request_id,
+                StatusCode::BAD_REQUEST,
+                "MalformedXML",
+                "the DeleteObjects request body exceeds the maximum size",
+            )
+        }
+        Err(BufferError::Read(err)) => return gateway_error_response(request_id, &err),
+    };
+
+    // Verify the buffered body against the signed digest, mirroring the object PUT: a `Signed`
+    // request's `x-amz-content-sha256` is the hex SHA-256 of the whole body. (`Unsigned` /
+    // `Streaming` have nothing to check here — the latter is authenticated per chunk as it is
+    // de-framed above.)
+    if let sigv4::PayloadHash::Signed(expected_hex) = &payload {
+        let actual_hex = crypto::hex(&crypto::sha256(&body_bytes));
+        if !crypto::constant_time_eq(actual_hex.as_bytes(), expected_hex.as_bytes()) {
+            return error_response(
+                request_id,
+                StatusCode::BAD_REQUEST,
+                "XAmzContentSHA256Mismatch",
+                "the delivered body does not match the signed x-amz-content-sha256",
+            );
+        }
+    }
+
+    let Ok(body_str) = std::str::from_utf8(&body_bytes) else {
+        return error_response(
+            request_id,
+            StatusCode::BAD_REQUEST,
+            "MalformedXML",
+            "the DeleteObjects request body is not valid UTF-8",
+        );
+    };
+    let request = match parse_delete(body_str) {
+        Ok(request) => request,
+        Err(_) => {
+            return error_response(
+                request_id,
+                StatusCode::BAD_REQUEST,
+                "MalformedXML",
+                "the XML you provided was not well-formed or did not validate",
+            )
+        }
+    };
+    // S3 bounds a bulk delete at 1..=1000 keys; outside that range is `MalformedXML` (refused,
+    // not truncated). The body byte cap already bounds the parse, so this is a semantic bound.
+    if request.keys.is_empty() || request.keys.len() > MAX_DELETE_KEYS {
+        return error_response(
+            request_id,
+            StatusCode::BAD_REQUEST,
+            "MalformedXML",
+            "a DeleteObjects request must name between 1 and 1000 keys",
+        );
+    }
+
+    let mut outcomes = Vec::with_capacity(request.keys.len());
+    for key in &request.keys {
+        let object_key = format!("{bucket}/{key}");
+        match state.gateway.delete_object(&object_key).await {
+            // Idempotent: `Ok(true)` (removed) and `Ok(false)` (already absent) are both a
+            // `<Deleted>` — S3 delete of a missing key is a success.
+            Ok(_) => outcomes.push(DeleteOutcome::Deleted(key.clone())),
+            Err(err) => {
+                let (_, code, message) = classify(&err);
+                outcomes.push(DeleteOutcome::Error {
+                    key: key.clone(),
+                    code,
+                    message,
+                });
+            }
+        }
+    }
+    list_response(render_delete_result(&outcomes, request.quiet))
+}
+
+/// Why buffering a bulk-delete body stopped short of a complete read.
+enum BufferError {
+    /// The body exceeded [`MAX_DELETE_BODY_BYTES`] — refused (400 `MalformedXML`) before it is
+    /// fully resident.
+    TooLarge,
+    /// The transport (or the `aws-chunked` de-framer) yielded an error mid-read.
+    Read(BoxError),
+}
+
+/// Buffer a request body to a `Vec`, refusing once `cap` bytes are exceeded. An `aws-chunked`
+/// streaming body is de-framed ([`streaming::decode`], which authenticates each chunk) so the
+/// buffered bytes are the object payload, not the wire framing; every other payload form is the
+/// raw body. Used only for the small, bounded bulk-delete body — object PUT/GET stay streaming.
+async fn buffer_capped(
+    payload: &sigv4::PayloadHash,
+    body: Body,
+    cap: usize,
+) -> Result<Vec<u8>, BufferError> {
+    let raw = body
+        .into_data_stream()
+        .map(|item| item.map_err(|e| Box::new(e) as BoxError));
+    let mut stream: std::pin::Pin<
+        Box<dyn futures_util::Stream<Item = wyrd_traits::Result<bytes::Bytes>> + Send>,
+    > = match payload {
+        sigv4::PayloadHash::Streaming(ctx) => {
+            Box::pin(streaming::decode(Box::pin(raw), ctx.clone()))
+        }
+        _ => Box::pin(raw),
+    };
+    let mut buf = Vec::new();
+    while let Some(chunk) = stream.next().await {
+        let chunk = chunk.map_err(BufferError::Read)?;
+        if buf.len() + chunk.len() > cap {
+            return Err(BufferError::TooLarge);
+        }
+        buf.extend_from_slice(&chunk);
+    }
+    Ok(buf)
+}
+
+/// Render the `<DeleteResult>` for a bulk delete. Under `quiet` the successful `<Deleted>`
+/// entries are omitted (S3's `Quiet` mode reports only errors); a per-key `<Error>` is always
+/// reported. Every key/code/message is XML-escaped so a key carrying markup cannot break the
+/// document — the same discipline the error body and the listing renderers use.
+fn render_delete_result(outcomes: &[DeleteOutcome], quiet: bool) -> String {
+    let mut xml = String::from(
+        "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\
+         <DeleteResult xmlns=\"http://s3.amazonaws.com/doc/2006-03-01/\">",
+    );
+    for outcome in outcomes {
+        match outcome {
+            DeleteOutcome::Deleted(key) => {
+                if !quiet {
+                    xml.push_str("<Deleted><Key>");
+                    xml.push_str(&xml_escape(key));
+                    xml.push_str("</Key></Deleted>");
+                }
+            }
+            DeleteOutcome::Error { key, code, message } => {
+                xml.push_str("<Error><Key>");
+                xml.push_str(&xml_escape(key));
+                xml.push_str("</Key><Code>");
+                xml.push_str(&xml_escape(code));
+                xml.push_str("</Code><Message>");
+                xml.push_str(&xml_escape(message));
+                xml.push_str("</Message></Error>");
+            }
+        }
+    }
+    xml.push_str("</DeleteResult>");
+    xml
+}
+
+/// A parsed `<Delete>` request body: the object keys to remove and the `Quiet` flag.
+#[derive(Debug, PartialEq, Eq)]
+struct DeleteRequest {
+    keys: Vec<String>,
+    quiet: bool,
+}
+
+/// The `<Delete>` body did not match the fixed S3 `DeleteObjects` schema — mapped by the caller
+/// to `400 MalformedXML`. Carries a short static reason for a server-side diagnosis; the client
+/// only ever sees the generic S3 code.
+#[derive(Debug, PartialEq, Eq)]
+struct MalformedXml(&'static str);
+
+/// One lexical event from [`tokenize_xml`].
+enum XmlEvent {
+    /// A start tag's local element name (attributes discarded).
+    Open(String),
+    /// An end tag's local element name.
+    Close(String),
+    /// Character data between tags, already entity-unescaped.
+    Text(String),
+}
+
+/// The **local** element name of a start/end tag's inner text: the first whitespace-delimited
+/// token with any `ns:` namespace prefix stripped, so `<Delete xmlns="…">` reads as `Delete`
+/// and `<s3:Object>` as `Object`.
+fn local_name(tag: &str) -> &str {
+    let name = tag.split_whitespace().next().unwrap_or("");
+    match name.rsplit_once(':') {
+        Some((_, local)) => local,
+        None => name,
+    }
+}
+
+/// Tokenise the fixed `<Delete>` schema into [`XmlEvent`]s — a minimal, in-crate scanner scoped
+/// to exactly this body (the workspace has no XML crate, and adding one is a human-gated
+/// dependency decision: ADR-0003 three-test audit + `deny.toml`). It skips the XML declaration,
+/// comments and DOCTYPE, treats a `<![CDATA[…]]>` section as literal text, and reports a
+/// structurally broken document (an unterminated tag/comment/entity) as [`MalformedXml`] rather
+/// than guessing. Attribute values are discarded; a `>` inside an attribute value is not part of
+/// the S3 schema and is out of scope (stated in build-notes).
+fn tokenize_xml(input: &str) -> Result<Vec<XmlEvent>, MalformedXml> {
+    let mut events = Vec::new();
+    let mut rest = input;
+    while !rest.is_empty() {
+        if !rest.starts_with('<') {
+            // A run of character data up to the next tag (or end of input).
+            let end = rest.find('<').unwrap_or(rest.len());
+            events.push(XmlEvent::Text(xml_unescape(&rest[..end])?));
+            rest = &rest[end..];
+            continue;
+        }
+        if let Some(after) = rest.strip_prefix("<?") {
+            let end = after
+                .find("?>")
+                .ok_or(MalformedXml("unterminated processing instruction"))?;
+            rest = &after[end + 2..];
+        } else if let Some(after) = rest.strip_prefix("<!--") {
+            let end = after
+                .find("-->")
+                .ok_or(MalformedXml("unterminated comment"))?;
+            rest = &after[end + 3..];
+        } else if let Some(after) = rest.strip_prefix("<![CDATA[") {
+            let end = after
+                .find("]]>")
+                .ok_or(MalformedXml("unterminated CDATA"))?;
+            events.push(XmlEvent::Text(after[..end].to_string()));
+            rest = &after[end + 3..];
+        } else if let Some(after) = rest.strip_prefix("<!") {
+            let end = after
+                .find('>')
+                .ok_or(MalformedXml("unterminated declaration"))?;
+            rest = &after[end + 1..];
+        } else {
+            let after = &rest[1..];
+            let end = after.find('>').ok_or(MalformedXml("unterminated tag"))?;
+            let tag = after[..end].trim();
+            rest = &after[end + 1..];
+            if let Some(name) = tag.strip_prefix('/') {
+                let name = local_name(name);
+                if name.is_empty() {
+                    return Err(MalformedXml("empty end tag"));
+                }
+                events.push(XmlEvent::Close(name.to_string()));
+            } else if let Some(name) = tag.strip_suffix('/') {
+                let name = local_name(name);
+                if name.is_empty() {
+                    return Err(MalformedXml("empty self-closing tag"));
+                }
+                events.push(XmlEvent::Open(name.to_string()));
+                events.push(XmlEvent::Close(name.to_string()));
+            } else {
+                let name = local_name(tag);
+                if name.is_empty() {
+                    return Err(MalformedXml("empty start tag"));
+                }
+                events.push(XmlEvent::Open(name.to_string()));
+            }
+        }
+    }
+    Ok(events)
+}
+
+/// Unescape the five XML predefined entities plus numeric character references (`&#38;`,
+/// `&#x26;`) so an entity-escaped key (`a&amp;b`) reads back as the stored key (`a&b`). An
+/// unterminated (`&amp`) or unrecognised entity is a [`MalformedXml`] error rather than being
+/// passed through literally — the parser rejects a malformed body, it does not repair it.
+fn xml_unescape(s: &str) -> Result<String, MalformedXml> {
+    if !s.contains('&') {
+        return Ok(s.to_string());
+    }
+    let mut out = String::with_capacity(s.len());
+    let mut rest = s;
+    while let Some(amp) = rest.find('&') {
+        out.push_str(&rest[..amp]);
+        let after = &rest[amp + 1..];
+        let semi = after.find(';').ok_or(MalformedXml("unterminated entity"))?;
+        let entity = &after[..semi];
+        let decoded = match entity {
+            "amp" => '&',
+            "lt" => '<',
+            "gt" => '>',
+            "quot" => '"',
+            "apos" => '\'',
+            _ => {
+                if let Some(hex) = entity
+                    .strip_prefix("#x")
+                    .or_else(|| entity.strip_prefix("#X"))
+                {
+                    let code = u32::from_str_radix(hex, 16)
+                        .map_err(|_| MalformedXml("bad numeric entity"))?;
+                    char::from_u32(code).ok_or(MalformedXml("bad code point"))?
+                } else if let Some(dec) = entity.strip_prefix('#') {
+                    let code = dec
+                        .parse::<u32>()
+                        .map_err(|_| MalformedXml("bad numeric entity"))?;
+                    char::from_u32(code).ok_or(MalformedXml("bad code point"))?
+                } else {
+                    return Err(MalformedXml("unknown entity"));
+                }
+            }
+        };
+        out.push(decoded);
+        rest = &after[semi + 1..];
+    }
+    out.push_str(rest);
+    Ok(out)
+}
+
+/// Parse a `<Delete>` DeleteObjects body: the `<Object><Key>…</Key></Object>` list and the
+/// optional `<Quiet>` flag. Unknown elements (`<VersionId>`, a stray `<Prefix>`, …) are ignored
+/// per the fixed schema; the root MUST be `<Delete>` and every tag MUST be balanced, else the
+/// body is [`MalformedXml`]. Keys are captured entity-unescaped (via [`tokenize_xml`]).
+fn parse_delete(body: &str) -> Result<DeleteRequest, MalformedXml> {
+    let mut keys = Vec::new();
+    let mut quiet = false;
+    // Each open element on the stack carries its accumulated text so a `<Key>`'s content is
+    // read at its close, scoped to that element (a `<Key>` holds only text in this schema).
+    let mut stack: Vec<(String, String)> = Vec::new();
+    let mut root_seen = false;
+    for event in tokenize_xml(body)? {
+        match event {
+            XmlEvent::Open(name) => {
+                if stack.is_empty() {
+                    if name != "Delete" {
+                        return Err(MalformedXml("root element is not <Delete>"));
+                    }
+                    root_seen = true;
+                }
+                stack.push((name, String::new()));
+            }
+            XmlEvent::Text(text) => {
+                if let Some((_, buf)) = stack.last_mut() {
+                    buf.push_str(&text);
+                }
+            }
+            XmlEvent::Close(name) => {
+                let (open_name, text) = stack.pop().ok_or(MalformedXml("unmatched close tag"))?;
+                if open_name != name {
+                    return Err(MalformedXml("mismatched close tag"));
+                }
+                match (stack.last().map(|(n, _)| n.as_str()), name.as_str()) {
+                    (Some("Object"), "Key") => keys.push(text),
+                    (Some("Delete"), "Quiet") => quiet = matches!(text.trim(), "true" | "1"),
+                    _ => {}
+                }
+            }
+        }
+    }
+    if !stack.is_empty() {
+        return Err(MalformedXml("unclosed element"));
+    }
+    if !root_seen {
+        return Err(MalformedXml("missing <Delete> root element"));
+    }
+    Ok(DeleteRequest { keys, quiet })
+}
