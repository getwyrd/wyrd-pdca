+/// Whether `query` carries a bare `name` parameter — e.g. the `delete` subresource on
+/// `POST /bucket?delete` (with or without a `=`, and alongside benign params like
+/// `x-id=DeleteObjects`). The key is percent-DECODED before matching, so a percent-encoded
+/// spelling cannot dodge the match — the same discipline the bucket route's subresource fence
+/// uses ([`unsupported_subresource_decoded`]), which this check must agree with because it runs
+/// just before it (issue #509).
+fn has_query_key(query: &str, name: &str) -> bool {
+    query
+        .split('&')
+        .filter(|p| !p.is_empty())
+        .map(|p| p.split_once('=').map(|(k, _)| k).unwrap_or(p))
+        .any(|k| percent_decode_utf8(k) == name)
+}
