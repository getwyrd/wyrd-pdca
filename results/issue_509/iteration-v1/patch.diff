+/// A malformed `<Delete>` body (not XML at all) answers `400 MalformedXML` — a stock SDK
+/// never sends this, so it is hand-signed and sent raw (mirrors
+/// `s3_http_wire.rs`'s hand-built-request tests).
+#[tokio::test]
+async fn bulk_delete_malformed_xml_body_is_refused() {
+    let (addr, _dir) = start_gateway().await;
+    let body = b"this is not XML at all";
+    let headers = signed_headers("POST", "/wyrd-bucket", "delete", &addr.to_string(), body);
+    let (status, response_body) = send(addr, "POST", "/wyrd-bucket?delete", &headers, body).await;
+
+    assert_eq!(
+        status, 400,
+        "a malformed Delete body must be refused, not accepted"
+    );
+    let xml = String::from_utf8_lossy(&response_body);
+    assert!(
+        xml.contains("<Code>MalformedXML</Code>"),
+        "expected the MalformedXML S3 error code, got: {xml}"
+    );
+}
