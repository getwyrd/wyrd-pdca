+/// A request naming more than 1000 keys is refused (AWS's own documented DeleteObjects
+/// cap) rather than silently accepted or run partially.
+#[tokio::test]
+async fn bulk_delete_more_than_1000_keys_is_refused() {
+    let (addr, _dir) = start_gateway().await;
+    let client = sdk_client(addr);
+    let bucket = "wyrd-bucket";
+
+    let mut builder = Delete::builder();
+    for i in 0..1001 {
+        builder = builder.objects(
+            ObjectIdentifier::builder()
+                .key(format!("over-limit/{i}"))
+                .build()
+                .expect("key"),
+        );
+    }
+    let delete = builder.build().expect("at least one object");
+
+    let err = client
+        .delete_objects()
+        .bucket(bucket)
+        .delete(delete)
+        .send()
+        .await
+        .expect_err("a Delete request naming more than 1000 keys must be refused");
+    assert_eq!(
+        err.into_service_error().meta().code(),
+        Some("MalformedXML"),
+        "expected a 400-class MalformedXML refusal for the over-limit request"
+    );
+}
