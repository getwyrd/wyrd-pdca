+/// An entity-escaped key (an ampersand, which S3 XML-escapes as `&amp;`) deletes the RIGHT
+/// object — the SDK escapes it building the request; the gateway must un-escape it back
+/// the same way before composing the store key.
+#[tokio::test]
+async fn bulk_delete_entity_escaped_key_deletes_the_right_object() {
+    let (addr, _dir) = start_gateway().await;
+    let client = sdk_client(addr);
+    let bucket = "wyrd-bucket";
+    let key = "a&b.txt";
+
+    client
+        .put_object()
+        .bucket(bucket)
+        .key(key)
+        .body(ByteStream::from(b"ampersand payload".to_vec()))
+        .send()
+        .await
+        .expect("PUT of an ampersand key must succeed");
+
+    let delete = Delete::builder()
+        .objects(ObjectIdentifier::builder().key(key).build().expect("key"))
+        .build()
+        .expect("at least one object");
+
+    let output = client
+        .delete_objects()
+        .bucket(bucket)
+        .delete(delete)
+        .send()
+        .await
+        .expect("DeleteObjects naming an ampersand key must be accepted");
+
+    assert!(output.errors().is_empty());
+    assert_eq!(
+        output
+            .deleted()
+            .iter()
+            .filter_map(|d| d.key())
+            .collect::<Vec<_>>(),
+        vec![key],
+        "the entity-escaped key must round-trip to the exact requested key"
+    );
+
+    let got = client.get_object().bucket(bucket).key(key).send().await;
+    assert!(
+        got.is_err(),
+        "the ampersand-keyed object must actually be gone, proving the RIGHT object was hit"
+    );
+}
