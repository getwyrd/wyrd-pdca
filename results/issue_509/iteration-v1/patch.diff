+/// `Quiet=true` omits every `<Deleted>` entry from the result (no per-key errors either,
+/// since nothing here fails) — while still actually deleting the object.
+#[tokio::test]
+async fn bulk_delete_quiet_omits_deleted_entries() {
+    let (addr, _dir) = start_gateway().await;
+    let client = sdk_client(addr);
+    let bucket = "wyrd-bucket";
+    let key = "quiet/object";
+
+    client
+        .put_object()
+        .bucket(bucket)
+        .key(key)
+        .body(ByteStream::from(b"payload".to_vec()))
+        .send()
+        .await
+        .expect("PUT must succeed");
+
+    let delete = Delete::builder()
+        .objects(ObjectIdentifier::builder().key(key).build().expect("key"))
+        .quiet(true)
+        .build()
+        .expect("at least one object");
+
+    let output = client
+        .delete_objects()
+        .bucket(bucket)
+        .delete(delete)
+        .send()
+        .await
+        .expect("a Quiet DeleteObjects must still be accepted");
+
+    assert!(
+        output.deleted().is_empty(),
+        "Quiet=true must omit every <Deleted> entry"
+    );
+    assert!(output.errors().is_empty());
+
+    let got = client.get_object().bucket(bucket).key(key).send().await;
+    assert!(
+        got.is_err(),
+        "the object must actually be gone even though Quiet suppressed the <Deleted> echo"
+    );
+}
