+/// A bulk delete naming several PRESENT keys and one ABSENT key answers `200` with every
+/// requested key named exactly once, `<Deleted>` for both classes (S3 delete is
+/// idempotent) — and a follow-up GET of a deleted key is `404 NoSuchKey`.
+#[tokio::test]
+async fn bulk_delete_removes_present_and_absent_keys_reporting_each_once() {
+    let (addr, _dir) = start_gateway().await;
+    let client = sdk_client(addr);
+    let bucket = "wyrd-bucket";
+
+    for key in ["a/one", "a/two"] {
+        client
+            .put_object()
+            .bucket(bucket)
+            .key(key)
+            .body(ByteStream::from(b"payload".to_vec()))
+            .send()
+            .await
+            .expect("PUT must succeed");
+    }
+
+    let delete = Delete::builder()
+        .objects(
+            ObjectIdentifier::builder()
+                .key("a/one")
+                .build()
+                .expect("key"),
+        )
+        .objects(
+            ObjectIdentifier::builder()
+                .key("a/two")
+                .build()
+                .expect("key"),
+        )
+        .objects(
+            ObjectIdentifier::builder()
+                .key("a/never-existed")
+                .build()
+                .expect("key"),
+        )
+        .build()
+        .expect("at least one object");
+
+    let output = client
+        .delete_objects()
+        .bucket(bucket)
+        .delete(delete)
+        .send()
+        .await
+        .expect("a stock aws-sdk-s3 DeleteObjects must be accepted by the gateway");
+
+    assert!(output.errors().is_empty(), "no per-key errors expected");
+    let mut deleted: Vec<&str> = output
+        .deleted()
+        .iter()
+        .map(|d| d.key().expect("Deleted must carry a Key"))
+        .collect();
+    deleted.sort_unstable();
+    assert_eq!(
+        deleted,
+        vec!["a/never-existed", "a/one", "a/two"],
+        "each requested key must be named exactly once, present or absent alike \
+         (delete is idempotent)"
+    );
+
+    for key in ["a/one", "a/two"] {
+        let got = client.get_object().bucket(bucket).key(key).send().await;
+        let err = got.expect_err("a GET of a bulk-deleted key must 404, not return stale bytes");
+        assert_eq!(
+            err.into_service_error().meta().code(),
+            Some("NoSuchKey"),
+            "key {key} must read back NoSuchKey after the bulk delete"
+        );
+    }
+}
