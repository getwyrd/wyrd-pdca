+/// AWS's own documented `DeleteObjects` limits (brief §Scope): at most this many
+/// `<Object>` entries per request, and the whole XML body bounded by this many bytes.
+/// Both bounds are enforced by construction (never by trust) before the body is parsed.
+const DELETE_OBJECTS_MAX_KEYS: usize = 1000;
+const DELETE_OBJECTS_MAX_BODY_BYTES: usize = 2 * 1024 * 1024;
+
+/// One parsed `<Delete>` request body: the ordered keys to remove, and whether `Quiet`
+/// asked the result to omit `<Deleted>` entries (issue #509).
+struct DeleteRequest {
+    keys: Vec<String>,
+    quiet: bool,
+}
+
+/// One node of a minimal parsed XML tree — either an element (name + children) or a text
+/// run (already entity-unescaped, [`xml_unescape`]). Scoped to exactly the tiny fixed
+/// `<Delete>` schema this slice needs (Design: the workspace carries no XML crate, and
+/// adding one is a human-gated ADR-0003 dependency/license decision) — not a general-
+/// purpose XML library, but general enough to skip an unknown child element (a future
+/// `<VersionId>`, say) correctly even when it nests, rather than special-casing every
+/// element name the parser walks past.
+enum XmlNode {
+    Element {
+        name: String,
+        children: Vec<XmlNode>,
+    },
+    Text(String),
+}
+
+/// A cursor over the input for [`XmlNode`] parsing. Byte-offset indexing is safe here
+/// (never splits a multi-byte UTF-8 sequence): every cut point is found by searching for
+/// an ASCII structural byte (`<`, `>`, `/`, `=`, a quote), and no continuation byte of a
+/// multi-byte UTF-8 sequence is ever equal to an ASCII byte.
+struct XmlParser<'a> {
+    input: &'a str,
+    pos: usize,
+}
+
+impl<'a> XmlParser<'a> {
+    fn new(input: &'a str) -> Self {
+        Self { input, pos: 0 }
+    }
+
+    fn rest(&self) -> &'a str {
+        &self.input[self.pos..]
+    }
+
+    fn skip_ws(&mut self) {
+        let trimmed = self.rest().trim_start();
+        self.pos = self.input.len() - trimmed.len();
+    }
+
+    /// Skip any run of whitespace, `<?...?>` processing instructions (the `<?xml
+    /// version="1.0"?>` prolog a real client sends), and `<!--...-->` comments preceding
+    /// the next element.
+    fn skip_misc(&mut self) {
+        loop {
+            self.skip_ws();
+            if self.rest().starts_with("<?") {
+                match self.rest().find("?>") {
+                    Some(end) => self.pos += end + 2,
+                    None => self.pos = self.input.len(),
+                }
+                continue;
+            }
+            if self.rest().starts_with("<!--") {
+                match self.rest().find("-->") {
+                    Some(end) => self.pos += end + 3,
+                    None => self.pos = self.input.len(),
+                }
+                continue;
+            }
+            break;
+        }
+    }
+
+    /// Parse exactly one element starting at the current position (after [`skip_misc`]).
+    /// `None` on any structural violation — mismatched/unterminated tags, a name-less tag —
+    /// which the caller answers as S3's `MalformedXML` (never a partial/best-effort read).
+    fn parse_element(&mut self) -> Option<XmlNode> {
+        if !self.rest().starts_with('<') {
+            return None;
+        }
+        self.pos += 1;
+        let name_len = self
+            .rest()
+            .find(|c: char| c.is_whitespace() || c == '/' || c == '>')?;
+        if name_len == 0 {
+            return None;
+        }
+        let name = self.rest()[..name_len].to_string();
+        self.pos += name_len;
+        let self_closing = self.skip_attributes()?;
+        if self_closing {
+            return Some(XmlNode::Element {
+                name,
+                children: Vec::new(),
+            });
+        }
+        let mut children = Vec::new();
+        loop {
+            self.skip_misc();
+            if self.rest().starts_with("</") {
+                let close_len = self.rest()[2..].find('>')?;
+                let close_name = self.rest()[2..2 + close_len].trim();
+                if close_name != name {
+                    return None;
+                }
+                self.pos += 2 + close_len + 1;
+                break;
+            }
+            if self.rest().is_empty() {
+                return None;
+            }
+            if self.rest().starts_with('<') {
+                children.push(self.parse_element()?);
+            } else {
+                let text_len = self.rest().find('<').unwrap_or(self.rest().len());
+                let text = xml_unescape(&self.rest()[..text_len]);
+                self.pos += text_len;
+                if !text.is_empty() {
+                    children.push(XmlNode::Text(text));
+                }
+            }
+        }
+        Some(XmlNode::Element { name, children })
+    }
+
+    /// Consume an open tag's attribute list up to its terminating `>`, honouring quoted
+    /// attribute values (so a `>` or `/` inside one does not end the tag early). Returns
+    /// whether the tag was self-closing (`/>`); `None` on malformed attribute syntax.
+    fn skip_attributes(&mut self) -> Option<bool> {
+        loop {
+            self.skip_ws();
+            let c = self.rest().chars().next()?;
+            match c {
+                '/' => {
+                    self.pos += 1;
+                    if !self.rest().starts_with('>') {
+                        return None;
+                    }
+                    self.pos += 1;
+                    return Some(true);
+                }
+                '>' => {
+                    self.pos += 1;
+                    return Some(false);
+                }
+                _ => {
+                    let name_len = self
+                        .rest()
+                        .find(|c: char| c.is_whitespace() || c == '=' || c == '/' || c == '>')?;
+                    if name_len == 0 {
+                        return None;
+                    }
+                    self.pos += name_len;
+                    self.skip_ws();
+                    if self.rest().starts_with('=') {
+                        self.pos += 1;
+                        self.skip_ws();
+                        let quote = self.rest().chars().next()?;
+                        if quote != '"' && quote != '\'' {
+                            return None;
+                        }
+                        self.pos += 1;
+                        let val_len = self.rest().find(quote)?;
+                        self.pos += val_len + 1;
+                    }
+                }
+            }
+        }
+    }
+}
+
+/// Un-escape the five predefined XML entities in text content — the exact inverse of
+/// [`xml_escape`] — so a `<Key>` carrying `&amp;` (S3's XML-escaped literal `&`) decodes
+/// to the real key rather than the escaped text (brief success criterion: an
+/// entity-escaped key deletes the right object). An unrecognised `&...;` run is copied
+/// verbatim rather than rejected — a permissive read, matching a real XML parser, over one
+/// unknown entity the caller did not invent maliciously.
+fn xml_unescape(s: &str) -> String {
+    let mut out = String::with_capacity(s.len());
+    let bytes = s.as_bytes();
+    let mut i = 0;
+    while i < bytes.len() {
+        if bytes[i] == b'&' {
+            if let Some(end) = s[i..].find(';') {
+                let entity = &s[i + 1..i + end];
+                let replacement = match entity {
+                    "amp" => Some('&'),
+                    "lt" => Some('<'),
+                    "gt" => Some('>'),
+                    "quot" => Some('"'),
+                    "apos" => Some('\''),
+                    _ => None,
+                };
+                if let Some(c) = replacement {
+                    out.push(c);
+                    i += end + 1;
+                    continue;
+                }
+            }
+        }
+        let ch = s[i..]
+            .chars()
+            .next()
+            .expect("i is a char boundary within s");
+        out.push(ch);
+        i += ch.len_utf8();
+    }
+    out
+}
+
+/// Parse a `<Delete>` XML body ([`DeleteRequest`]): the root must be `<Delete>`; each
+/// `<Object>` child must carry a `<Key>` (an `<Object>` with no `<Key>`, or any structural
+/// violation, is malformed); an optional top-level `<Quiet>true</Quiet>` sets `quiet`.
+/// Unknown child elements — inside `<Delete>` or inside an `<Object>` (e.g. a future
+/// `<VersionId>`) — are ignored, not rejected. `None` on any malformed input; the caller
+/// answers S3's `MalformedXML`, never a partial/best-effort read.
+fn parse_delete_request(body: &[u8]) -> Option<DeleteRequest> {
+    let text = std::str::from_utf8(body).ok()?;
+    let mut parser = XmlParser::new(text);
+    parser.skip_misc();
+    let root = parser.parse_element()?;
+    parser.skip_ws();
+    if !parser.rest().is_empty() {
+        return None; // trailing content after the root element closed
+    }
+    let XmlNode::Element { name, children } = root else {
+        return None;
+    };
+    if name != "Delete" {
+        return None;
+    }
+    let mut keys = Vec::new();
+    let mut quiet = false;
+    for child in children {
+        let XmlNode::Element { name, children } = child else {
+            continue; // stray top-level text is ignored
+        };
+        match name.as_str() {
+            "Object" => {
+                let key = children.into_iter().find_map(|c| match c {
+                    XmlNode::Element { name, children } if name == "Key" => {
+                        children.into_iter().find_map(|c| match c {
+                            XmlNode::Text(t) => Some(t),
+                            _ => None,
+                        })
+                    }
+                    _ => None,
+                })?;
+                keys.push(key);
+            }
+            "Quiet" => {
+                let text = children.into_iter().find_map(|c| match c {
+                    XmlNode::Text(t) => Some(t),
+                    _ => None,
+                });
+                quiet = text.as_deref() == Some("true");
+            }
+            _ => {} // unknown top-level element: ignored
+        }
+    }
+    Some(DeleteRequest { keys, quiet })
+}
+
+/// Buffer a byte stream into memory, capped at `cap` bytes: `Err` (rather than a silent
+/// truncation) if the stream would exceed it, or if the stream itself errors. The ONLY
+/// request body this wire layer buffers whole rather than streams (module docs "stream,
+/// don't buffer") — justified by Design: the DeleteObjects body is SigV4-signed as a
+/// single unit (not a per-chunk streaming signature) and AWS bounds it at ≤1000 keys /
+/// ≤2 MiB, so buffering it is a bounded, deliberate exception, not an unbounded one.
+async fn buffer_bounded<S>(mut stream: S, cap: usize) -> Result<Vec<u8>, BoxError>
+where
+    S: futures_util::Stream<Item = wyrd_traits::Result<bytes::Bytes>> + Unpin,
+{
+    let mut buf = Vec::new();
+    while let Some(chunk) = stream.next().await {
+        let chunk = chunk?;
+        if buf.len() + chunk.len() > cap {
+            return Err("the request body exceeds the DeleteObjects size limit".into());
+        }
+        buf.extend_from_slice(&chunk);
+    }
+    Ok(buf)
+}
+
+/// `POST /bucket?delete` — S3's bulk DeleteObjects (issue #509). Buffers the (bounded)
+/// body, checks it against the SigV4-signed payload hash exactly as the PUT path does
+/// post-stream (`sigv4::PayloadHash::Signed`), parses the `<Delete>` request, deletes each
+/// named key via the existing single-object seam ([`ObjectGateway::delete_object`] —
+/// already idempotent: `Ok(_)` for both a removed and an already-absent key, so S3's
+/// "delete is idempotent" contract holds here for free), and renders the per-key
+/// `<DeleteResult>` — `<Deleted>` on success (omitted under `Quiet`), `<Error>` (code +
+/// message, via the seam's own [`classify`]) on a per-key gateway fault. A malformed body,
+/// an over-count, or an over-size body all answer once, for the whole request, before any
+/// key is touched — never a partial run against an unparsed request.
+async fn delete_objects<G>(
+    state: &AppState<G>,
+    request_id: RequestId,
+    bucket: &str,
+    body: Body,
+    payload: sigv4::PayloadHash,
+) -> Response
+where
+    G: ObjectGateway,
+{
+    let raw = Box::pin(
+        body.into_data_stream()
+            .map(|item| item.map_err(|e| Box::new(e) as BoxError)),
+    );
+    let buffered = match &payload {
+        // A stock-SDK streaming-signature body (unexpected for this small, non-streamed
+        // op, but handled rather than mishandled if a client ever sends one): de-frame
+        // with the SAME decoder the PUT path uses, then buffer the decoded bytes.
+        sigv4::PayloadHash::Streaming(ctx) => {
+            buffer_bounded(
+                streaming::decode(raw, ctx.clone()),
+                DELETE_OBJECTS_MAX_BODY_BYTES,
+            )
+            .await
+        }
+        sigv4::PayloadHash::Signed(_) | sigv4::PayloadHash::Unsigned => {
+            buffer_bounded(raw, DELETE_OBJECTS_MAX_BODY_BYTES).await
+        }
+    };
+    let buffered = match buffered {
+        Ok(bytes) => bytes,
+        Err(_) => {
+            return error_response(
+                request_id,
+                StatusCode::BAD_REQUEST,
+                "MalformedXML",
+                "the request body could not be read or exceeds the DeleteObjects size limit",
+            )
+        }
+    };
+
+    // A single-shot signed body: verify the buffered bytes against the signed digest
+    // BEFORE trusting a single byte of it — the same discipline the PUT path applies
+    // post-stream (`sigv4::PayloadHash::Signed`, `lib.rs` PUT arm), just applied to a
+    // buffered body instead of a streamed one.
+    if let sigv4::PayloadHash::Signed(hex) = &payload {
+        let digest = crate::crypto::hex(&crate::crypto::sha256(&buffered));
+        if !crate::crypto::constant_time_eq(digest.as_bytes(), hex.as_bytes()) {
+            return error_response(
+                request_id,
+                StatusCode::BAD_REQUEST,
+                "XAmzContentSHA256Mismatch",
+                "the delivered body does not match the signed x-amz-content-sha256",
+            );
+        }
+    }
+
+    let Some(parsed) = parse_delete_request(&buffered) else {
+        return error_response(
+            request_id,
+            StatusCode::BAD_REQUEST,
+            "MalformedXML",
+            "the request body could not be parsed as a <Delete> request",
+        );
+    };
+    if parsed.keys.is_empty() {
+        return error_response(
+            request_id,
+            StatusCode::BAD_REQUEST,
+            "MalformedXML",
+            "a Delete request must name at least one object",
+        );
+    }
+    if parsed.keys.len() > DELETE_OBJECTS_MAX_KEYS {
+        return error_response(
+            request_id,
+            StatusCode::BAD_REQUEST,
+            "MalformedXML",
+            "a Delete request may name at most 1000 objects",
+        );
+    }
+
+    let mut out = String::with_capacity(256 + parsed.keys.len() * 96);
+    out.push_str(
+        "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\
+         <DeleteResult xmlns=\"http://s3.amazonaws.com/doc/2006-03-01/\">",
+    );
+    for key in &parsed.keys {
+        let object_key = format!("{bucket}/{key}");
+        match state.gateway.delete_object(&object_key).await {
+            // Idempotent: `Ok(_)` covers both a removed key and an already-absent one — S3
+            // reports BOTH as `<Deleted>` (brief success criterion: absent keys delete
+            // as a no-op success, never a per-key error).
+            Ok(_) => {
+                if !parsed.quiet {
+                    out.push_str("<Deleted><Key>");
+                    out.push_str(&xml_escape(key));
+                    out.push_str("</Key></Deleted>");
+                }
+            }
+            Err(err) => {
+                let (_, code, message) = classify(&err);
+                out.push_str("<Error><Key>");
+                out.push_str(&xml_escape(key));
+                out.push_str("</Key><Code>");
+                out.push_str(&xml_escape(code));
+                out.push_str("</Code><Message>");
+                out.push_str(&xml_escape(&message));
+                out.push_str("</Message></Error>");
+            }
+        }
+    }
+    out.push_str("</DeleteResult>");
+
+    Response::builder()
+        .status(StatusCode::OK)
+        .header("content-type", "application/xml")
+        .header("content-length", out.len().to_string())
+        .body(Body::from(out))
+        .expect("static response is always valid")
+}
