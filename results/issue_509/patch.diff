+/// A parsed, validated bulk-delete request: the requested object keys (literal, already
+/// XML-entity-decoded once by the parser) and whether the client asked for a `Quiet` result.
+struct DeleteRequest {
+    keys: Vec<String>,
+    quiet: bool,
+}
