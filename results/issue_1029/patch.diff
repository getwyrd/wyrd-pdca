+/// **(X2) run (b)** ([`replay`]): A's commit held, the replay after A returned.
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn x2_b_replay_after_a_held_commit_never_lands_it_twice() {
+    replay(&[Replay::Held]).await;
+}
