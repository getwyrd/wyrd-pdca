+        let attempt = rig.stage(1, &body(CHUNK, 220)).await;
+        let fault = rig.fail_reads_from_now(part_key(&rig.upload, part(1)));
+        rig.store.script(
+            Kind::Commit,
+            vec![Act::conflict(), Act::hold().after(fault)],
