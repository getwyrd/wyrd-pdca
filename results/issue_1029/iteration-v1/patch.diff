+/// When the prior's bytes come back in
+/// [`b_a_held_reupload_survives_a_repair_that_moves_the_prior_away_and_back`].
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+enum Restored {
+    /// At the end of the first re-read, before the next round, which then lands itself.
+    BeforeRetry,
+    /// Right after the next round conflicted, and the held batch lands with it.
+    WithRelease,
+    /// After the attempt returned in doubt, and the held batch lands then.
+    AfterReturn,
+}
+
+/// **(B) A held re-upload while a repair moves the prior away and back** (staged reconstruction,
+/// `0016:671`). A re-upload over a non-empty prior is held. A batch in the re-place adoption's exact
+/// shape moves one of the prior's fragments to another server, at each gap of the first re-read in
+/// turn, so the part key no longer holds what the held commit requires; a later re-place moves it
+/// back, so the prior's exact bytes return and the held commit can land. In every run: no
+/// compensation while the commit may land, never `OperationAborted`, the answer `Committed` or the
+/// in-doubt error keeping the flag, and at the end the attempt's own part durable, the prior's
+/// chunks owed, and the slot released exactly once. Were a compensation ever sent, the wrapper
+/// makes the race real: it moves the prior back, lands the held commit, and answers the
+/// compensation unknown.
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn b_a_held_reupload_survives_a_repair_that_moves_the_prior_away_and_back() {
+    for restored in [
+        Restored::BeforeRetry,
+        Restored::WithRelease,
+        Restored::AfterReturn,
+    ] {
+        for away_at in 0..=4usize {
+            within(async {
+                let at = format!("{restored:?}, moved away at gap {away_at}");
+                let mut rig = Rig::new().await;
+                let prior = rig.committed(1, &body(2 * CHUNK, 210)).await;
+                let placement = &prior.chunks()[0].placement;
+                let first = placement[0];
+                let spare = (0..SERVERS)
+                    .find(|id| !placement.contains(id))
+                    .expect("a server outside the chunk's placement");
+                let attempt = rig.stage(1, &body(CHUNK, 211)).await;
+                let mut gaps = vec![(away_at, vec![repoint(&rig, 1, 0, spare)])];
+                let mut later = None;
+                let (plan, then) = match restored {
+                    Restored::BeforeRetry => {
+                        gaps.push((4, vec![repoint(&rig, 1, 0, first)]));
+                        (vec![], Some(Act::pass()))
+                    }
+                    Restored::WithRelease => (
+                        vec![Act::conflict()
+                            .after(repoint(&rig, 1, 0, first))
+                            .after(rig.land_held(CommitOutcome::Committed))],
+                        Some(Act::conflict()),
+                    ),
+                    Restored::AfterReturn => {
+                        later = Some(repoint(&rig, 1, 0, first));
+                        (vec![], Some(Act::conflict()))
+                    }
+                };
+                let held = Act::hold().after_all(rig.at_gaps(&attempt, gaps));
+                rig.store.script(
+                    Kind::Commit,
+                    std::iter::once(held).chain(plan).collect(),
+                    then,
+                );
+                rig.store.script(
+                    Kind::Compensation,
+                    vec![Act::unknown(false, true)
+                        .before(repoint(&rig, 1, 0, first))
+                        .before(rig.land_held(CommitOutcome::Committed))],
+                    None,
+                );
+                let outcome = rig.commit(attempt.clone()).await;
+                assert_eq!(
+                    rig.log.commits(Kind::Compensation).len(),
+                    0,
+                    "{at}: no compensation while the commit may land"
+                );
+                if restored == Restored::AfterReturn {
+                    let doubt = in_doubt(outcome);
+                    assert_eq!(doubt.batch, DoubtfulBatch::Commit, "{at}");
+                    assert!(doubt.may_still_commit, "{at}: the doubt is kept");
+                    assert!(
+                        matches!(doubt.cause, Stop::CommitRoundsSpent { rounds: 4 }),
+                        "{at}: {:?}",
+                        doubt.cause
+                    );
+                    assert_eq!(
+                        rig.slots_of(&attempt).await,
+                        1,
+                        "{at}: covered by the doubt"
+                    );
+                    rig.run(later.take().into_iter().collect()).await;
+                } else {
+                    committed_as(&outcome, &attempt);
+                    assert_eq!(rig.log.commits(Kind::Commit).len(), 2, "{at}");
+                }
+                if rig.store.held_count() > 0 {
+                    // After `BeforeRetry` the next round landed, so the held batch finds the slot
+                    // gone; after `AfterReturn` the held batch is the one that lands.
+                    let expected = if restored == Restored::BeforeRetry {
+                        CommitOutcome::Conflict
+                    } else {
+                        CommitOutcome::Committed
+                    };
+                    assert_eq!(rig.store.release_held().await, expected, "{at}");
+                }
+                assert!(is_own(&rig.part(1).await.unwrap().0, &attempt), "{at}");
+                assert_eq!(
+                    rig.part_obligations().await,
+                    vec![(token_of(&attempt, 0), chunk_ids(prior.chunks()))],
+                    "{at}: the prior's chunks are owed"
+                );
+                assert_eq!(rig.releases(&attempt), 1, "{at}: released once");
+                assert_eq!(rig.slots_of(&attempt).await, 0, "{at}");
+                assert_eq!(rig.owned_of(&attempt).await, 0, "{at}");
+                rig.assert_every_fragment_named().await;
+            })
+            .await;
+        }
+    }
+}
