+/// The stored bytes of part `n`.
+async fn part_bytes(rig: &Rig, n: u32) -> Bytes {
+    rig.inner
+        .get(&part_key(&rig.upload, part(n)))
+        .await
+        .unwrap()
+        .expect("the part is committed")
+}
