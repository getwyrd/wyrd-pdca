+/// and a same-number rival lands. The rival's record does not show the held commit can never land,
+/// since a repair can write the prior's exact bytes back (the next leg), so the attempt keeps the
+/// doubt: no compensation, the in-doubt error keeping the flag, never `OperationAborted`. Were a
+/// compensation ever sent, the wrapper makes that history real: it restores the prior's bytes,
+/// lands the held commit, and answers the compensation unknown. The held batch, released over the
+/// rival's record, conflicts.
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn b_a_held_reupload_over_a_non_empty_prior_that_loses_to_a_rival_keeps_the_doubt() {
+    within(async {
+        let mut rig = Rig::new().await;
+        let prior = rig.committed(1, &body(2 * CHUNK, 207)).await;
+        assert!(!prior.is_empty());
+        let restore = rig.plant(part_key(&rig.upload, part(1)), part_bytes(&rig, 1).await);
+        let attempt = rig.stage(1, &body(CHUNK, 208)).await;
+        let rival = rig.stage(1, &body(CHUNK, 209)).await;
+        rig.store.script(
+            Kind::Commit,
+            vec![Act::hold().after(rig.rival(rival.clone()))],
+            Some(Act::conflict()),
+        );
+        rig.store.script(
+            Kind::Compensation,
+            vec![Act::unknown(false, true)
+                .before(restore)
+                .before(rig.land_held(CommitOutcome::Committed))],
+            None,
+        );
+        let doubt = in_doubt(rig.commit(attempt.clone()).await);
+        assert_eq!(doubt.batch, DoubtfulBatch::Commit);
+        assert!(doubt.may_still_commit, "the doubt is kept");
+        assert!(
+            matches!(doubt.cause, Stop::CommitRoundsSpent { rounds: 4 }),
+            "{:?}",
+            doubt.cause
+        );
+        assert_eq!(
+            rig.log.commits(Kind::Compensation).len(),
+            0,
+            "no compensation while the commit can still land"
+        );
+        assert_eq!(rig.slots_of(&attempt).await, 1, "covered by the doubt");
+        assert_eq!(rig.store.release_held().await, CommitOutcome::Conflict);
+        assert_eq!(rig.releases(&attempt), 0, "nothing of this attempt landed");
+        assert!(is_own(&rig.part(1).await.unwrap().0, &rival));
+    })
+    .await;
+}
