+/// The value `batch` puts at `key`.
+fn put_at(batch: &WriteBatch, key: &[u8]) -> Option<Bytes> {
+    batch
+        .puts
+        .iter()
+        .find(|(put, _)| put == key)
+        .map(|(_, value)| value.clone())
+}
