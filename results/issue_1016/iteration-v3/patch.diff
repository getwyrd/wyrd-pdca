+
+/// **A flag only a fleet uses is refused with no `--endpoints`.** The role with no fleet runs the
+/// reaper alone for good, so `--gc-expired-pending` (GC runs only over a fleet), `--ids` and
+/// `--failure-domains` would each be read and dropped. Each is refused, non-zero, naming the flag,
+/// before the store is touched.
+#[test]
+fn no_endpoints_role_refuses_a_flag_only_a_fleet_uses() {
+    let store = Store::new();
+    seed_leg_a(&store, wall_now());
+    let before = store.snapshot();
+
+    for extra in [
+        &["--gc-expired-pending"][..],
+        &["--ids", "1"][..],
+        &["--failure-domains", "domain-1"][..],
+    ] {
+        let run = run_role(role(store.data_dir(), extra), None);
+        let refusal = format!("{} needs --endpoints", extra[0]);
+        assert!(
+            run.exited.is_some_and(|status| !status.success()),
+            "{extra:?} with no --endpoints is refused, non-zero ({:?}):\n{}",
+            run.exited,
+            run.stderr
+        );
+        assert!(
+            run.stderr.contains(&refusal),
+            "the refusal says `{refusal}`:\n{}",
+            run.stderr
+        );
+        assert_eq!(run.passes, 0, "{extra:?}: no reaper pass:\n{}", run.stderr);
+        assert_eq!(
+            store.snapshot(),
+            before,
+            "{extra:?}: the store is as seeded:\n{}",
+            run.stderr
+        );
+    }
+}
+
+/// **`--interval-secs 0` is refused wherever the role loops, and taken by a one-shot.** At 0 the
+/// role would run pass after pass with no pause, so both looping shapes — no `--endpoints`, and an
+/// `--endpoints` fleet — are refused before the store is touched. The reaper one-shot never waits,
+/// so it takes 0 and runs its pass.
+#[test]
+fn a_zero_interval_is_refused_wherever_the_role_loops() {
+    const REFUSAL: &str = "--interval-secs must be at least 1";
+    let store = Store::new();
+    seed_leg_a(&store, wall_now());
+    let before = store.snapshot();
+
+    for command in [
+        role_every(store.data_dir(), "0", &[]),
+        role_every(
+            store.data_dir(),
+            "0",
+            &[
+                "--endpoints",
+                UNREACHABLE,
+                "--ids",
+                "1",
+                "--failure-domains",
+                "domain-1",
+                "--connect-timeout-secs",
+                "1",
+            ],
+        ),
+    ] {
+        let run = run_role(command, None);
+        assert!(
+            run.exited.is_some_and(|status| !status.success()),
+            "refused, non-zero ({:?}):\n{}",
+            run.exited,
+            run.stderr
+        );
+        assert!(
+            run.stderr.contains(REFUSAL),
+            "the refusal says `{REFUSAL}`:\n{}",
+            run.stderr
+        );
+        assert_eq!(run.passes, 0, "no reaper pass:\n{}", run.stderr);
+        assert_eq!(store.snapshot(), before, "the store is as seeded");
+    }
+
+    let run = run_role(custodian(store.data_dir(), "0", &[ONE_SHOT_FLAG]), None);
+    assert!(
+        !run.stderr.contains(REFUSAL),
+        "the one-shot takes --interval-secs 0:\n{}",
+        run.stderr
+    );
+    assert!(
+        run.exited.is_some_and(|status| status.success()),
+        "and runs its pass ({:?}):\n{}",
+        run.exited,
+        run.stderr
+    );
+    assert_eq!(run.passes, 1, "one pass:\n{}", run.stderr);
+}
+
+/// **The usage text says what the role does with no fleet.** `wyrd` with no command prints the
+/// usage and exits 2. Its custodian paragraph says that with no `--endpoints` the role runs the
+/// multipart reaper alone until Ctrl-C over a store that must exist, which flags it refuses
+/// there, that when none of the `--endpoints` is reachable it runs one reaper pass — none under
+/// `--reconcile-after-restore` — and then fails, and that a looping role needs an interval of at
+/// least a second.
+#[test]
+fn usage_says_what_the_role_does_with_no_fleet() {
+    let run = run_role(Command::new(WYRD), None);
+
+    assert_eq!(
+        run.exited.and_then(|status| status.code()),
+        Some(2),
+        "{}",
+        run.stderr
+    );
+    for said in [
+        "it then runs the multipart reaper alone, every --interval-secs, until Ctrl-C,",
+        "over a metadata store that must already exist (on redb it creates none). It is",
+        "refused with --ids, --failure-domains or --gc-expired-pending, which only a fleet",
+        "uses. If none of the --endpoints is reachable at startup, the role runs one",
+        "reaper pass (none under --reconcile-after-restore) and then fails, non-zero, as",
+        "before. --interval-secs must be at least 1 unless the run is a one-shot.",
+    ] {
+        assert!(
+            run.stderr.contains(said),
+            "the usage says `{said}`:\n{}",
+            run.stderr
+        );
+    }
+}
