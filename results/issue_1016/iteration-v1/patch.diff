+/// Open the metadata store the cluster wrote to and run the custodian's **no-fleet loop** over it
+/// (#625, [`CustodianService::run_reaper_until`]): the multipart reaper every `interval` until
+/// `shutdown`. The backend dispatch of the two deployed shapes that have no fleet — no
+/// `--endpoints`, and the one pass before the empty-fleet startup failure — mirroring
+/// [`run_reconstruction_over_backend`], whose store open it shares: the role's own store, opened
+/// (and on redb created) as the fleet role opens it.
+#[allow(clippy::too_many_arguments)]
+pub async fn run_reaper_over_backend<Fut, Clock>(
+    backend: MetadataBackend,
+    data_dir: &str,
+    service: &CustodianService,
+    zone: &FencedZone,
+    custodian: &Custodian,
+    interval: Duration,
+    clock: Clock,
+    shutdown: Fut,
+) -> Result<(), BoxError>
+where
+    Fut: Future<Output = ()>,
+    Clock: FnMut() -> u64 + Send,
+{
+    match backend {
+        MetadataBackend::Redb => {
+            let meta = open_local_meta_redb(data_dir)?;
+            service
+                .run_reaper_until(zone, custodian, &meta, interval, clock, shutdown)
+                .await?;
+        }
+        #[cfg(feature = "tikv")]
+        MetadataBackend::Tikv => {
+            let meta = open_tikv_meta().await?;
+            service
+                .run_reaper_until(zone, custodian, &meta, interval, clock, shutdown)
+                .await?;
+        }
+        #[cfg(feature = "fdb")]
+        MetadataBackend::Fdb => {
+            let meta = open_fdb_meta().await?;
+            service
+                .run_reaper_until(zone, custodian, &meta, interval, clock, shutdown)
+                .await?;
+        }
+    }
+    Ok(())
+}
