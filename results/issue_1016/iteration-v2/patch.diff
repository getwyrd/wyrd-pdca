+/// A networked metadata store's open for the no-endpoints role, bounded by
+/// [`NO_FLEET_REAPER_PASS_BOUND`] (#625): a backend that never answers fails the role — non-zero,
+/// so a supervisor restarts it — rather than leaving it up with no pass ever run.
+#[cfg(any(feature = "tikv", feature = "fdb"))]
+async fn open_within_no_fleet_bound<T>(
+    open: impl Future<Output = Result<T, BoxError>>,
+) -> Result<T, BoxError> {
+    match tokio::time::timeout(NO_FLEET_REAPER_PASS_BOUND, open).await {
+        Ok(opened) => opened,
+        Err(_) => Err(format!(
+            "wyrd custodian: the metadata store did not open within {}s; the multipart reaper \
+             cannot run without it",
+            NO_FLEET_REAPER_PASS_BOUND.as_secs()
+        )
+        .into()),
+    }
+}
