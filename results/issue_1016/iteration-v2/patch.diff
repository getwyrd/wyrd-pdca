+/// Open the metadata store the cluster wrote to and run **one** multipart reaper pass over it
+/// (#625, [`CustodianService::reap_abandoned_uploads_once`]): the pass the ordinary role runs
+/// before it fails on a fleet none of whose servers was reachable at startup. The store is opened
+/// as the role opens it (on redb, [`open_local_meta_redb`]), not as the operator one-shot does:
+/// this pass reports nothing about the store, and the one-shot's refusal of a missing store
+/// names a flag this command was not given. The caller bounds the pass, its open included.
+pub async fn run_reaper_pass_over_backend<Clock>(
+    backend: MetadataBackend,
+    data_dir: &str,
+    service: &CustodianService,
+    zone: &FencedZone,
+    custodian: &Custodian,
+    clock: Clock,
+) -> Result<Reconciled, BoxError>
+where
+    Clock: FnMut() -> u64 + Send,
+{
+    let outcome = match backend {
+        MetadataBackend::Redb => {
+            let meta = open_local_meta_redb(data_dir)?;
+            service
+                .reap_abandoned_uploads_once(zone, custodian, &meta, clock)
+                .await?
+        }
+        #[cfg(feature = "tikv")]
+        MetadataBackend::Tikv => {
+            let meta = open_tikv_meta().await?;
+            service
+                .reap_abandoned_uploads_once(zone, custodian, &meta, clock)
+                .await?
+        }
+        #[cfg(feature = "fdb")]
+        MetadataBackend::Fdb => {
+            let meta = open_fdb_meta().await?;
+            service
+                .reap_abandoned_uploads_once(zone, custodian, &meta, clock)
+                .await?
+        }
+    };
+    Ok(outcome)
+}
