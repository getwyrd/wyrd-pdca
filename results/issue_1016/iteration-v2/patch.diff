+/// Open the metadata store the cluster wrote to and run the custodian's **no-fleet loop** over it
+/// (#625, [`CustodianService::run_reaper_until`]): the multipart reaper every `interval` until
+/// `shutdown`, for the role started with no `--endpoints`. The backend dispatch mirrors
+/// [`run_reconstruction_over_backend`] and opens the store as the fleet role opens it (on redb,
+/// [`open_local_meta_redb`]). A networked store's open is bounded by
+/// [`NO_FLEET_REAPER_PASS_BOUND`] (`open_within_no_fleet_bound`, compiled with that backend).
+#[allow(clippy::too_many_arguments)]
+pub async fn run_reaper_over_backend<Fut, Clock>(
+    backend: MetadataBackend,
+    data_dir: &str,
+    service: &CustodianService,
+    zone: &FencedZone,
+    custodian: &Custodian,
+    interval: Duration,
+    clock: Clock,
+    shutdown: Fut,
+) -> Result<(), BoxError>
+where
+    Fut: Future<Output = ()>,
+    Clock: FnMut() -> u64 + Send,
+{
+    match backend {
+        MetadataBackend::Redb => {
+            let meta = open_local_meta_redb(data_dir)?;
+            service
+                .run_reaper_until(zone, custodian, &meta, interval, clock, shutdown)
+                .await?;
+        }
+        #[cfg(feature = "tikv")]
+        MetadataBackend::Tikv => {
+            let meta = open_within_no_fleet_bound(open_tikv_meta()).await?;
+            service
+                .run_reaper_until(zone, custodian, &meta, interval, clock, shutdown)
+                .await?;
+        }
+        #[cfg(feature = "fdb")]
+        MetadataBackend::Fdb => {
+            let meta = open_within_no_fleet_bound(open_fdb_meta()).await?;
+            service
+                .run_reaper_until(zone, custodian, &meta, interval, clock, shutdown)
+                .await?;
+        }
+    }
+    Ok(())
+}
