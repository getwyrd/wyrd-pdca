+/// Which worst-case batch shape [`calibrate_batch_ops`] times.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum CalibrationBatch {
+    /// (i) **Operation-bound**: `ops / 2` distinct keys, each `require_absent` and put with a
+    /// small value — `ops` sequential operations whose bytes are negligible.
+    OperationBound,
+    /// (ii) **Byte-bound**: the same operation count, its puts carrying `bytes` in total, the
+    /// preconditions split between `require_absent` (half the keys) and an exact-value guard on a
+    /// key seeded before the run (the other half).
+    ByteBound,
+}
+
+/// What one timed commit of [`calibrate_batch_ops`] measured.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct BatchTiming {
+    /// The batch shape.
+    pub batch: CalibrationBatch,
+    /// Which run, from 0.
+    pub run: usize,
+    /// Operations the batch carried: every precondition and every mutation.
+    pub ops: usize,
+    /// Bytes the batch carried: every key, every put value and every expected value.
+    pub bytes: u64,
+    /// The commit's wall time.
+    pub elapsed: std::time::Duration,
+}
+
+/// **The `B_ops` calibration experiment** (proposal 0016, `0016:621-648`, `:1475`, `:2907-2910`;
+/// #625): time the two worst-case batches the operation budget must fit — [`CalibrationBatch`] —
+/// `runs` times each against the store `make_store` hands back, and assert each commits and that
+/// the slowest of each shape is within `bound`.
+///
+/// Every value comes from the caller, never a literal here: `ops` is `MAX_BATCH_OPS`, `bytes`
+/// `MAX_BATCH_BYTES` and `bound` `MAX_BATCH_OPS × SLOWEST_OP_MILLIS`, all `wyrd-core`'s, so this
+/// crate keeps its trait-only dependency rule (ADR-0016). It is **not** part of [`run_all`]: it
+/// measures a backend's latency rather than pinning a trait clause, so only the networked backends'
+/// gated conformance targets call it, off the Check gate (`cargo xtask fdb-conformance`,
+/// `cargo xtask tikv-conformance`).
+///
+/// Each run gets a fresh store from `make_store(tag)` (the tag names the shape and the run), so
+/// every key is new to the backend and the `require_absent` preconditions hold. Every
+/// measurement is printed as it is taken, so a run that fails its bound still reports every
+/// figure before it; the timings are returned in the order taken.
+///
+/// Wall time is read from [`std::time::Instant`], the monotonic clock: it times a commit and
+/// decides no lifecycle, so it owns no correctness clock (`clippy.toml`).
+pub async fn calibrate_batch_ops<S, F, Fut>(
+    mut make_store: F,
+    ops: usize,
+    bytes: u64,
+    bound: std::time::Duration,
+    runs: usize,
+) -> Vec<BatchTiming>
+where
+    S: MetadataStore,
+    F: FnMut(String) -> Fut,
+    Fut: core::future::Future<Output = S>,
+{
+    assert!(
+        ops >= 4 && ops.is_multiple_of(2),
+        "an even operation count of at least 4"
+    );
+    assert!(runs >= 1, "at least one run");
+    let keys = ops / 2;
+    let mut timings = Vec::with_capacity(2 * runs);
+    for batch in [
+        CalibrationBatch::OperationBound,
+        CalibrationBatch::ByteBound,
+    ] {
+        let mut slowest = std::time::Duration::ZERO;
+        for run in 0..runs {
+            let store = make_store(format!("calibrate-{batch:?}-{run}")).await;
+            let (built, carried) = calibration_batch(&store, batch, keys, bytes).await;
+            let started = std::time::Instant::now();
+            let outcome = store.commit(built).await;
+            let elapsed = started.elapsed();
+            let timing = BatchTiming {
+                batch,
+                run,
+                ops,
+                bytes: carried,
+                elapsed,
+            };
+            println!(
+                "B_ops calibration: {batch:?} run {run}: {ops} operations, {carried} bytes, \
+                 committed in {} ms",
+                elapsed.as_millis()
+            );
+            assert!(
+                matches!(outcome, Ok(CommitOutcome::Committed)),
+                "the {batch:?} batch of run {run} commits: {outcome:?}"
+            );
+            slowest = slowest.max(elapsed);
+            timings.push(timing);
+        }
+        println!(
+            "B_ops calibration: {batch:?}: slowest of {runs} runs {} ms against the bound {} ms",
+            slowest.as_millis(),
+            bound.as_millis()
+        );
+        assert!(
+            slowest <= bound,
+            "the slowest {batch:?} batch took {} ms, past MAX_BATCH_OPS × SLOWEST_OP_MILLIS = \
+             {} ms",
+            slowest.as_millis(),
+            bound.as_millis()
+        );
+    }
+    timings
+}
+
+/// Build one [`CalibrationBatch`] of `keys` keys over `store` — seeding the exact-value guards'
+/// keys first for the byte-bound shape — and the bytes it carries.
+async fn calibration_batch(
+    store: &impl MetadataStore,
+    batch: CalibrationBatch,
+    keys: usize,
+    bytes: u64,
+) -> (WriteBatch, u64) {
+    let key = |i: usize| format!("calibrate/{i:06}").into_bytes();
+    let seeded = Bytes::from_static(b"seeded");
+    let mut built = WriteBatch::new();
+    let mut carried: u64 = 0;
+    match batch {
+        CalibrationBatch::OperationBound => {
+            let value = Bytes::from_static(b"v");
+            for i in 0..keys {
+                let k = key(i);
+                carried += 2 * k.len() as u64 + value.len() as u64;
+                built = built.require_absent(k.clone()).put(k, value.clone());
+            }
+        }
+        CalibrationBatch::ByteBound => {
+            let guarded = keys / 2;
+            let mut seed = WriteBatch::new();
+            for i in 0..guarded {
+                seed = seed.put(key(i), seeded.clone());
+            }
+            let landed = store.commit(seed).await;
+            assert!(
+                matches!(landed, Ok(CommitOutcome::Committed)),
+                "the guarded keys are seeded: {landed:?}"
+            );
+            // Every key twice (its precondition and its put) and every expected value, then the
+            // puts' values share what is left of `bytes` evenly.
+            let overhead: u64 = (0..keys).map(|i| 2 * key(i).len() as u64).sum::<u64>()
+                + guarded as u64 * seeded.len() as u64;
+            let each = bytes.saturating_sub(overhead) / keys as u64;
+            let value = Bytes::from(vec![0x5a_u8; each as usize]);
+            for i in 0..keys {
+                let k = key(i);
+                built = if i < guarded {
+                    built.require(k.clone(), seeded.clone())
+                } else {
+                    built.require_absent(k.clone())
+                };
+                built = built.put(k, value.clone());
+            }
+            carried = overhead + each * keys as u64;
+        }
+    }
+    (built, carried)
+}
+
+/// The calibration's batches, built over an in-memory store: each carries exactly the operation
+/// count it is asked for, the byte-bound one spends its byte budget without crossing it, and both
+/// commit. Latency is the networked backends' to measure; this pins the shapes they are timed on.
+#[cfg(test)]
+mod calibration_tests {
+    use super::{calibrate_batch_ops, calibration_batch, CalibrationBatch};
+    use bytes::Bytes;
+    use std::collections::BTreeMap;
+    use std::sync::Mutex;
+    use wyrd_traits::{CommitOutcome, MetadataStore, Result, ScanPage, WriteBatch};
+
+    #[derive(Default)]
+    struct Mem(Mutex<BTreeMap<Vec<u8>, Bytes>>);
+
+    #[async_trait::async_trait]
+    impl MetadataStore for Mem {
+        async fn get(&self, key: &[u8]) -> Result<Option<Bytes>> {
+            Ok(self.0.lock().unwrap().get(key).cloned())
+        }
+
+        async fn scan(&self, prefix: &[u8]) -> Result<Vec<(Vec<u8>, Bytes)>> {
+            let kv = self.0.lock().unwrap();
+            Ok(kv
+                .iter()
+                .filter(|(k, _)| k.starts_with(prefix))
+                .map(|(k, v)| (k.clone(), v.clone()))
+                .collect())
+        }
+
+        async fn scan_page(
+            &self,
+            prefix: &[u8],
+            after: Option<&[u8]>,
+            limit: usize,
+        ) -> Result<ScanPage> {
+            wyrd_testkit::test_double_scan_page(self, prefix, after, limit).await
+        }
+
+        async fn commit(&self, batch: WriteBatch) -> Result<CommitOutcome> {
+            let mut kv = self.0.lock().unwrap();
+            for pre in &batch.preconditions {
+                if kv.get(&pre.key).cloned() != pre.expected {
+                    return Ok(CommitOutcome::Conflict);
+                }
+            }
+            for (k, v) in batch.puts {
+                kv.insert(k, v);
+            }
+            for k in batch.deletes {
+                kv.remove(&k);
+            }
+            Ok(CommitOutcome::Committed)
+        }
+    }
+
+    /// The shipped budget's shape, spelled here only for this pin: the backends' targets take
+    /// the real values from `wyrd-core`.
+    const OPS: usize = 500;
+    const BYTES: u64 = 5_000_000;
+
+    #[test]
+    fn each_batch_carries_its_operations_and_fits_its_bytes() {
+        pollster::block_on(async {
+            for batch in [
+                CalibrationBatch::OperationBound,
+                CalibrationBatch::ByteBound,
+            ] {
+                let store = Mem::default();
+                let (built, carried) = calibration_batch(&store, batch, OPS / 2, BYTES).await;
+                let ops = built.preconditions.len() + built.puts.len() + built.deletes.len();
+                assert_eq!(ops, OPS, "{batch:?}");
+                let counted: u64 = built
+                    .preconditions
+                    .iter()
+                    .map(|pre| pre.key.len() + pre.expected.as_ref().map_or(0, Bytes::len))
+                    .chain(built.puts.iter().map(|(k, v)| k.len() + v.len()))
+                    .sum::<usize>() as u64;
+                assert_eq!(counted, carried, "{batch:?}: the bytes it reports");
+                assert!(carried <= BYTES, "{batch:?}: {carried} bytes");
+                if batch == CalibrationBatch::ByteBound {
+                    assert!(
+                        carried > BYTES - OPS as u64,
+                        "spends its byte budget: {carried}"
+                    );
+                    let guarded = built.preconditions.iter().filter(|p| p.expected.is_some());
+                    assert_eq!(guarded.count(), OPS / 4, "half the keys guarded on a value");
+                }
+                assert_eq!(store.commit(built).await.unwrap(), CommitOutcome::Committed);
+            }
+            let timings = calibrate_batch_ops(
+                |_| async { Mem::default() },
+                OPS,
+                BYTES,
+                std::time::Duration::from_secs(60),
+                5,
+            )
+            .await;
+            assert_eq!(timings.len(), 10, "five runs of each shape");
+        });
+    }
+}
