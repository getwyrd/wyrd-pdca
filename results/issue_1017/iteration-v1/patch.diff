+             \"state\":{{\"kind\":\"Completing\",\"fenced_at_millis\":{fenced},\
+             \"segments_written\":1,\"publish_target\":{{\"parent\":42,\"name\":\"bucket/{id}\",\
+             \"epoch\":1}}}}}}"
+        );
+        let group = metadata::SegmentGroup::new(id.as_str(), 1).unwrap();
+        let segment = metadata::SegmentRecord::new(vec![chunk.clone()], 0).unwrap();
+        let mut records = vec![(mpu_key(id), canonical!(SessionRecord, json))];
+        records.extend(committed(id, 1, chunk, created));
+        records.push((
+            metadata::seg_key(&group, 0).unwrap(),
+            metadata::encode(&segment),
+        ));
+        records
+    }
+
+    /// **A crash at each step of the reaper's own `Completing` transitions** (`0016:1920-1930`,
+    /// `:2197-2198`), converging with the count at its true value. For each exit — the
+    /// `W_completing` rollback and the over-age edge, each installing `retire:records:{seg:<g>:1}`
+    /// in its fence — and for every commit a clean run of the step makes, a step crashes at that
+    /// commit, its batch landed or not (drawn from the seed). Clean steps then run until the store
+    /// converges, and it converges to the one end state the exit has with no crash: the rollback
+    /// to `Open@2`, its part kept and its segment drained, the count unchanged; the over-age edge
+    /// to nothing left of the session but its marks, the count lowered by exactly one. A session
+    /// beside it, kept throughout, holds the other slot.
+    pub(super) async fn prop_crash_at_each_step_of_the_completing_exits(rng: &mut ChaCha8Rng) {
+        let (t0, _) = ages(rng);
+        let policy = ReaperPolicy::default();
+        let clock = ManualClock::new(t0);
+        for over_age in [false, true] {
+            let id = upload(if over_age { 0x96 } else { 0x95 });
+            let kept = upload(0x97);
+            let part_chunk = chunk(if over_age { 0x96_0001 } else { 0x95_0001 }, [1, 2, 3]);
+            let created = if over_age {
+                t0 - policy.w_session_millis - draw(rng, 1, DAY)
+            } else {
+                t0 - DAY
+            };
+            let fenced = t0 - policy.w_completing_millis - draw(rng, 1, HOUR);
+            let mut records = vec![ledger(2), open_session(&kept, t0 - HOUR)];
+            records.extend(completing_with_a_segment(&id, created, fenced, &part_chunk));
+            let group = metadata::SegmentGroup::new(id.as_str(), 1).unwrap();
+            let seeded = || async {
+                let meta = MemMeta::default();
+                assert_eq!(
+                    meta.commit(batch_of(records.clone())).await.unwrap(),
+                    CommitOutcome::Committed
+                );
+                meta
+            };
+            // How many commits a clean step makes: each is a crash point.
+            let counting = CrashAt {
+                inner: seeded().await,
+                at: usize::MAX,
+                lands: false,
+                commits: std::sync::atomic::AtomicUsize::new(0),
+            };
+            step(&counting, &clock).await;
+            let commits = counting.commits.load(Ordering::SeqCst);
+            assert!(commits >= 1, "the step fences: at least one commit");
+            for at in 1..=commits {
+                let lands = draw(rng, 0, 2) == 0;
+                let context = format!("over_age {over_age}, crash at commit {at}, lands {lands}");
+                let crashing = CrashAt {
+                    inner: seeded().await,
+                    at,
+                    lands,
+                    commits: std::sync::atomic::AtomicUsize::new(0),
+                };
+                step(&crashing, &clock).await;
+                let meta = crashing.inner;
+                for _ in 0..6 {
+                    reap(&meta, &clock).await;
+                }
+                assert!(
+                    meta.scan(&metadata::seg_range_prefix(&group))
+                        .await
+                        .unwrap()
+                        .is_empty(),
+                    "the attempt's segment is drained — {context}"
+                );
+                assert!(owes_nothing(&meta, &id).await, "nothing owed — {context}");
+                assert!(stored(&meta, &mpu_key(&kept)).is_some(), "kept — {context}");
+                if over_age {
+                    assert!(
+                        stored(&meta, &mpu_key(&id)).is_none(),
+                        "torn down — {context}"
+                    );
+                    assert!(
+                        stored(&meta, &part_key(&id, part(1))).is_none(),
+                        "its part's records deleted — {context}"
+                    );
+                    for (i, &dserver) in part_chunk.placement.iter().enumerate() {
+                        let frag = FragmentId {
+                            chunk: part_chunk.id,
+                            index: i as u16,
+                        };
+                        assert!(
+                            stored(&meta, &metadata::orphan_key(dserver, frag)).is_some(),
+                            "a mark on server {dserver}, {frag:?} — {context}"
+                        );
+                    }
+                    assert_eq!(counted(&meta), 1, "one slot released, once — {context}");
+                } else {
+                    let session =
+                        decode_session_record(&stored(&meta, &mpu_key(&id)).unwrap()).unwrap();
+                    assert_eq!(session.state(), &SessionState::Open {}, "{context}");
+                    assert_eq!(session.epoch(), 2, "one rollback, at E+1 — {context}");
+                    assert!(
+                        stored(&meta, &part_key(&id, part(1))).is_some(),
+                        "the part survives — {context}"
+                    );
+                    assert!(
+                        !any_marked(&meta, &part_chunk).await,
+                        "the part's bytes are never marked — {context}"
+                    );
+                    assert_eq!(counted(&meta), 2, "the count is unchanged — {context}");
+                }
+            }
+        }
+    }
 }
 
