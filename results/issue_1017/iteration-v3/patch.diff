+        counted,
+        "its slot still counted"
+    );
+    assert_eq!(
+        retry().await,
+        CompleteOutcome::AlreadyCompleted(publication.clone())
+    );
+
+    rig.clock.advance(W_TOMBSTONE_MILLIS);
+    for round in 0..2 {
+        let outcome = rig.reap().await.expect("no pass fails");
+        assert_ne!(outcome, Reconciled::Blocked, "round {round}");
+    }
