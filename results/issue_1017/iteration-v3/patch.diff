+        for _ in 0..3 {
+            reap(&meta.inner, &clock).await;
+        }
+        assert!(
+            !any_marked(&meta.inner, &part_chunk).await,
+            "no fragment of the published part is marked"
+        );
+    }
+
+    /// A [`MemMeta`] whose process **crashes** at its `at`-th commit, counting from 1: that
+    /// commit's batch lands first (`lands`, its answer lost with the process) or does not, and
+    /// from then on **every** read and every commit fails — the process is gone, so nothing the
+    /// step would have done after the crash point reaches the store. Each commit that goes
+    /// through is followed by a snapshot of the store, so a run with no crash (`at` past its last
+    /// commit) records the state after each of its commits: the boundary a crash at each leaves.
+    struct CrashAt {
+        inner: MemMeta,
+        at: usize,
+        lands: bool,
+        commits: std::sync::atomic::AtomicUsize,
+        crashed: AtomicBool,
+        after: Mutex<Vec<BTreeMap<Vec<u8>, Bytes>>>,
+    }
+
+    impl CrashAt {
+        fn new(inner: MemMeta, at: usize, lands: bool) -> Self {
+            Self {
+                inner,
+                at,
+                lands,
+                commits: std::sync::atomic::AtomicUsize::new(0),
+                crashed: AtomicBool::new(false),
+                after: Mutex::new(Vec::new()),
+            }
+        }
+
+        /// Fail every I/O once the process has crashed.
+        fn alive(&self) -> Result<()> {
+            if self.crashed.load(Ordering::SeqCst) {
+                return Err(BoxError::from(
+                    "the process crashed: no I/O after the crash point",
+                ));
+            }
+            Ok(())
+        }
+    }
+
+    #[async_trait]
+    impl MetadataStore for CrashAt {
+        async fn get(&self, key: &[u8]) -> Result<Option<Bytes>> {
+            self.alive()?;
+            self.inner.get(key).await
+        }
+
+        async fn scan(&self, prefix: &[u8]) -> Result<Vec<(Vec<u8>, Bytes)>> {
+            self.alive()?;
+            self.inner.scan(prefix).await
+        }
+
+        async fn scan_page(
+            &self,
+            prefix: &[u8],
+            after: Option<&[u8]>,
+            limit: usize,
+        ) -> Result<wyrd_traits::ScanPage> {
+            self.alive()?;
+            self.inner.scan_page(prefix, after, limit).await
+        }
+
+        async fn commit(&self, batch: WriteBatch) -> Result<CommitOutcome> {
+            self.alive()?;
+            let n = self.commits.fetch_add(1, Ordering::SeqCst) + 1;
+            if n == self.at {
+                if self.lands {
+                    self.inner.commit(batch).await?;
+                }
+                self.crashed.store(true, Ordering::SeqCst);
+                return Err(BoxError::from("an injected process crash at this commit"));
+            }
+            let outcome = self.inner.commit(batch).await?;
+            self.after.lock().unwrap().push(snapshot(&self.inner));
+            Ok(outcome)
+        }
+    }
+
+    /// One step over `meta` that may fail: the reaper, then the retirement leg record-only.
+    async fn step(meta: &dyn MetadataStore, clock: &ManualClock) {
+        let coord = MemCoordination::new();
+        let (zone, custodian) = elect(&coord, "zone-reaper-crash").await;
+        let policy = ReaperPolicy::default();
+        let reaper = ReaperContext {
+            meta,
+            clock,
+            clock_source: WALL_CLOCK_SOURCE,
+            policy: &policy,
+        };
+        let now = wyrd_testkit::Clock::now_millis(clock);
+        // A crashed step fails or holds; the store is what the crash left, either way.
+        let _ = reconcile_step(
+            &zone,
+            &custodian,
+            None,
+            None,
+            None,
+            None,
+            Some(&reaper),
+            now,
+        )
+        .await;
+    }
+
+    /// A `Completing@1` session of `id` created at `created`, fenced at `fenced`, that has written
+    /// one segment over `chunk` — with part 1 committed over the same chunk, the segment's
+    /// source: its session record, its part, and its segment.
+    fn completing_with_a_segment(
+        id: &UploadId,
+        created: u64,
+        fenced: u64,
+        chunk: &ChunkRef,
+    ) -> Vec<(Vec<u8>, Bytes)> {
+        let json = format!(
+            "{{\"parent\":42,\"object\":\"bucket/{id}\",\"created_at_millis\":{created},\
+             \"clock_source\":\"wall\",\"segment_nonce\":\"{id}\",\"epoch\":1,\"attempts\":1,\
+             \"state\":{{\"kind\":\"Completing\",\"fenced_at_millis\":{fenced},\
+             \"segments_written\":1,\"publish_target\":{{\"parent\":42,\"name\":\"bucket/{id}\",\
+             \"epoch\":1}}}}}}"
+        );
+        let group = metadata::SegmentGroup::new(id.as_str(), 1).unwrap();
+        let segment = metadata::SegmentRecord::new(vec![chunk.clone()], 0).unwrap();
+        let mut records = vec![(mpu_key(id), canonical!(SessionRecord, json))];
+        records.extend(committed(id, 1, chunk, created));
+        records.push((
+            metadata::seg_key(&group, 0).unwrap(),
+            metadata::encode(&segment),
+        ));
+        records
+    }
+
+    /// A wall-clocked `Completed@2` session of `id`, its flip landed at `completed`.
+    fn completed_session(id: &UploadId, completed: u64) -> (Vec<u8>, Bytes) {
+        let json = format!(
+            "{{\"parent\":42,\"object\":\"bucket/{id}\",\"created_at_millis\":{},\
+             \"clock_source\":\"wall\",\"segment_nonce\":\"{id}\",\"epoch\":2,\"attempts\":1,\
+             \"state\":{{\"kind\":\"Completed\",\"completion\":{{\"inode\":7,\"version\":1,\
+             \"etag\":\"{}-1\",\"completed_at_millis\":{completed},\
+             \"complete_fingerprint\":\"{}\"}}}}}}",
+            completed - HOUR,
+            "ab".repeat(32),
+            "cd".repeat(32)
+        );
+        (mpu_key(id), canonical!(SessionRecord, json))
+    }
+
+    /// The reaper's exits a crash row drives through every commit of its step.
+    #[derive(Debug, Clone, Copy, PartialEq, Eq)]
+    enum Exit {
+        /// A stale `Completing` session rolled back to `Open@2`, owing its attempt's segments.
+        Rollback,
+        /// An over-age `Completing` session sent straight to `Aborting@2`, owing its bytes and its
+        /// attempt's segments, then torn down.
+        OverAge,
+        /// A `Completed` session past `W_tombstone`, with a crashed part's residue, walked and
+        /// deleted.
+        Tombstone,
+    }
+
+    /// **A crash at each step of the reaper's own exits** (`0016:1920-1930`, `:2197-2198`,
+    /// `:2211-2215`), converging with the count at its true value. For each exit — the
+    /// `W_completing` rollback and the over-age edge, each installing `retire:records:{seg:<g>:1}`
+    /// in its fence, and tombstone expiry, whose terminal delete releases the slot — and for every
+    /// commit a clean run of the step makes, the process crashes at that commit, its batch landed
+    /// or not (drawn from the seed), and does no I/O after it.
+    ///
+    /// **At the crash boundary** the store is exactly what the clean run held after the commits
+    /// before the crash point (and the crashing one, when it landed) — nothing after the crash
+    /// reached it — and two invariants hold there: the `mpuctl` count equals the session records
+    /// present (a slot is released only with its record), and the rolled-back attempt's segments
+    /// always have an owner — the session still `Completing@1`, or the `retire:records:`
+    /// obligation the fence installed with it. **After restart** clean steps converge to the one end
+    /// state the exit has with no crash: the rollback to `Open@2`, its part kept and its segment
+    /// drained, the count unchanged; the over-age edge to nothing left of the session but its
+    /// marks, the count lowered by exactly one; tombstone expiry to the record gone, its residue
+    /// marked, the count lowered by exactly one, and a tombstone published exactly `W_tombstone`
+    /// ago kept byte for byte. A session beside them, kept throughout, holds another slot.
+    pub(super) async fn prop_crash_at_each_step_of_the_reapers_exits(rng: &mut ChaCha8Rng) {
+        let (t0, _) = ages(rng);
+        let policy = ReaperPolicy::default();
+        let window = wyrd_custodian::reaper::W_TOMBSTONE_MILLIS;
+        let clock = ManualClock::new(t0);
+        for exit in [Exit::Rollback, Exit::OverAge, Exit::Tombstone] {
+            let n = match exit {
+                Exit::Rollback => 0x95,
+                Exit::OverAge => 0x96,
+                Exit::Tombstone => 0x98,
+            };
+            let (id, kept, inside) = (upload(n), upload(0x97), upload(0x99));
+            let part_chunk = chunk(ChunkId::from(n) << 16 | 1, [1, 2, 3]);
+            let group = metadata::SegmentGroup::new(id.as_str(), 1).unwrap();
+            let mut records = vec![open_session(&kept, t0 - HOUR)];
+            match exit {
+                Exit::Rollback | Exit::OverAge => {
+                    let created = if exit == Exit::OverAge {
+                        t0 - policy.w_session_millis - draw(rng, 1, DAY)
+                    } else {
+                        t0 - DAY
+                    };
+                    let fenced = t0 - policy.w_completing_millis - draw(rng, 1, HOUR);
+                    records.push(ledger(2));
+                    records.extend(completing_with_a_segment(&id, created, fenced, &part_chunk));
+                }
+                Exit::Tombstone => {
+                    let completed = t0 - window - draw(rng, 1, HOUR);
+                    records.push(ledger(3));
+                    records.push(completed_session(&id, completed));
+                    records.push(owned(&id, 2, &part_chunk, completed - HOUR));
+                    records.push(completed_session(&inside, t0 - window));
+                }
+            }
+            let seeded = || async {
+                let meta = MemMeta::default();
+                assert_eq!(
+                    meta.commit(batch_of(records.clone())).await.unwrap(),
+                    CommitOutcome::Committed
+                );
+                meta
+            };
+            // A clean step: how many commits it makes — each a crash point — and the store after
+            // each, the boundary a crash there leaves.
+            let clean = CrashAt::new(seeded().await, usize::MAX, false);
+            let mut boundaries = vec![snapshot(&clean.inner)];
+            step(&clean, &clock).await;
+            boundaries.extend(clean.after.into_inner().unwrap());
+            let commits = boundaries.len() - 1;
+            assert!(
+                commits >= if exit == Exit::Rollback { 1 } else { 2 },
+                "{exit:?}: the step commits its exit and at least one drain step: {commits}"
+            );
+            let inside_before = stored(&clean.inner, &mpu_key(&inside));
+            for at in 1..=commits {
+                let lands = draw(rng, 0, 2) == 0;
+                let context = format!("{exit:?}, crash at commit {at} of {commits}, lands {lands}");
+                let crashing = CrashAt::new(seeded().await, at, lands);
+                step(&crashing, &clock).await;
+                let meta = crashing.inner;
+
+                // The crash boundary.
+                let left = snapshot(&meta);
+                assert!(
+                    left == boundaries[at - 1 + usize::from(lands)],
+                    "the store is exactly what the commits before the crash left — {context}"
+                );
+                let sessions = left
+                    .keys()
+                    .filter(|key| key.starts_with(MPU_PREFIX))
+                    .count();
+                assert_eq!(
+                    counted(&meta),
+                    sessions as u64,
+                    "the count is the records present: a slot goes only with its record — \
+                     {context}"
+                );
+                if exit != Exit::Tombstone {
+                    let segments = !meta
+                        .scan(&metadata::seg_range_prefix(&group))
+                        .await
+                        .unwrap()
+                        .is_empty();
+                    let attempt_owns = stored(&meta, &mpu_key(&id)).is_some_and(|value| {
+                        let session = decode_session_record(&value).unwrap();
+                        session.epoch() == 1
+                            && matches!(session.state(), SessionState::Completing { .. })
+                    });
+                    let owed = !meta
+                        .scan(&retire_session_range(RetireMode::Records, &id))
+                        .await
+                        .unwrap()
+                        .is_empty();
+                    assert!(
+                        !segments || attempt_owns || owed,
+                        "the attempt's segments have an owner at every boundary — {context}"
+                    );
+                }
+
+                // Restart: clean steps converge.
+                for _ in 0..6 {
+                    reap(&meta, &clock).await;
+                }
+                assert!(owes_nothing(&meta, &id).await, "nothing owed — {context}");
+                assert!(stored(&meta, &mpu_key(&kept)).is_some(), "kept — {context}");
+                match exit {
+                    Exit::Rollback => {
+                        let session =
+                            decode_session_record(&stored(&meta, &mpu_key(&id)).unwrap()).unwrap();
+                        assert_eq!(session.state(), &SessionState::Open {}, "{context}");
+                        assert_eq!(session.epoch(), 2, "one rollback, at E+1 — {context}");
+                        assert!(
+                            stored(&meta, &part_key(&id, part(1))).is_some(),
+                            "the part survives — {context}"
+                        );
+                        assert!(
+                            !any_marked(&meta, &part_chunk).await,
+                            "the part's bytes are never marked — {context}"
+                        );
+                        assert_eq!(counted(&meta), 2, "the count is unchanged — {context}");
+                    }
+                    Exit::OverAge | Exit::Tombstone => {
+                        assert!(
+                            stored(&meta, &mpu_key(&id)).is_none(),
+                            "torn down — {context}"
+                        );
+                        assert!(
+                            meta.scan(&sidx_range(&id)).await.unwrap().is_empty()
+                                && meta.scan(&part_range(&id)).await.unwrap().is_empty(),
+                            "its staged records deleted — {context}"
+                        );
+                        for (i, &dserver) in part_chunk.placement.iter().enumerate() {
+                            let frag = FragmentId {
+                                chunk: part_chunk.id,
+                                index: i as u16,
+                            };
+                            assert!(
+                                stored(&meta, &metadata::orphan_key(dserver, frag)).is_some(),
+                                "a mark on server {dserver}, {frag:?} — {context}"
+                            );
+                        }
+                        let slots = if exit == Exit::Tombstone { 2 } else { 1 };
+                        assert_eq!(counted(&meta), slots, "one slot released, once — {context}");
+                    }
+                }
+                if exit == Exit::Rollback || exit == Exit::OverAge {
+                    assert!(
+                        meta.scan(&metadata::seg_range_prefix(&group))
+                            .await
+                            .unwrap()
+                            .is_empty(),
+                        "the attempt's segment is drained — {context}"
+                    );
+                } else {
+                    assert_eq!(
+                        stored(&meta, &mpu_key(&inside)),
+                        inside_before,
+                        "a tombstone exactly W_tombstone old is kept — {context}"
+                    );
+                }
+            }
+        }
+    }
 }
 
