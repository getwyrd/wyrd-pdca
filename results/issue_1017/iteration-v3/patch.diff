+/// **(D, `Completed`, a slow Complete)** (#625, slice 625.3) A Complete whose work behind its fence
+/// outlasts the whole tombstone window — the clock moves `W_tombstone` and one millisecond on while
+/// it reads its part — is stamped at its flip, so the window starts at its publication. Passes with
+/// the multipart reaper beside them on the same clock, the deployed shape (`Tombstone::Window`):
+/// straight after the Complete they drain its obligation and keep the record — the tombstone —
+/// with its slot counted, and an identical retry answers `AlreadyCompleted`; so does every pass
+/// exactly `W_tombstone` after the publication. One millisecond later a pass deletes the record,
+/// the count goes down by exactly one, and the retry answers `NoSuchUpload`.
+#[tokio::test]
+async fn d_a_slow_completes_tombstone_lasts_the_whole_window_after_its_publication() {
+    let rig = Rig::new(3).await;
+    let object = format!("{BUCKET}/d-slow");
+    let id = rig.session(5, &object).await;
+    let parts: Vec<(u32, Vec<ChunkRef>)> = vec![(1, vec![chunk(5_100, RS21, vec![0, 1, 2])])];
+    rig.plant_parts(&id, &parts).await;
+    let requested_at = rig.clock.now_millis();
+    *rig.store.stall.lock().unwrap() = Some((
+        part_key(&id, part(1)),
+        rig.clock.clone(),
+        W_TOMBSTONE_MILLIS + 1,
+    ));
+
+    let first = rig.complete_on_clock(&id, &object, &[1], 42).await;
+
+    let CompleteOutcome::Published(publication) = first else {
+        panic!("{first:?}");
+    };
+    let published_at = rig.clock.now_millis();
+    assert_eq!(
+        published_at,
+        requested_at + W_TOMBSTONE_MILLIS + 1,
+        "the Complete spent the whole window, and more, before its flip"
+    );
+    assert_eq!(
+        publication.completed_at_millis, published_at,
+        "stamped at its publication"
+    );
+    let counted = rig.sessions_counted().await;
+    let retry = || rig.complete(&id, &object, &[1], 43);
+
+    for round in 0..4 {
+        let outcome = rig.reap().await.expect("no pass fails");
+        assert_ne!(outcome, Reconciled::Blocked, "round {round}");
+    }
