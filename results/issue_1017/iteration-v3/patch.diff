+            Budget::shipped().max_sessions()
+        );
+        let meta = MemMeta::default();
+        let batch = sessions.into_iter().fold(
+            WriteBatch::new().put(MPUCTL_KEY.to_vec(), canonical!(AdmissionRecord, ledger)),
+            |batch, (key, value)| batch.put(key, value),
+        );
