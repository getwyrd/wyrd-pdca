+        "{{\"kind\":\"Completed\",\"completion\":{{\"inode\":7,\"version\":1,\"etag\":\"{}-1\",\
+         \"completed_at_millis\":{completed},\"complete_fingerprint\":\"{}\"}}}}",
+        "ab".repeat(32),
+        "cd".repeat(32)
+    );
+    session_in(id, completed - HOUR, clock, 2, 1, &state)
+}
+
+/// Whether `id` owes something under `mode` in `store`.
+fn owes(store: &Store, mode: RetireMode, id: &UploadId) -> bool {
+    let owed = retire_session_range(mode, id);
+    store.snapshot().keys().any(|key| key.starts_with(&owed))
+}
+
+/// The `mpuctl` count `store` holds.
+fn counted(store: &Store) -> u64 {
+    decode_admission_record(&store.value(MPUCTL_KEY).expect("the ledger"))
+        .expect("the ledger decodes")
+        .count()
+}
+
+/// Whether some line of `log` carries both `what` and `id`.
+fn names(log: &str, what: &str, id: &UploadId) -> bool {
+    let id = id.to_string();
+    log.lines()
+        .any(|line| line.contains(what) && line.contains(&id))
+}
+
+/// **The `Completing` arms judge at their boundaries, and from the fence instant.** Over
+/// wall-clocked `Completing@1` sessions one piece of evidence apart:
+///
+/// * the residency ceiling fences one created a millisecond past `W_session` straight to
+///   `Aborting@2`, owing both its bytes and its attempt's segments, and keeps one created exactly
+///   `W_session` ago (its fence moments old);
+/// * the rollback moves one fenced a millisecond past `W_completing` to `Open@2`, owing only its
+///   attempt's segments, its attempt still charged, and keeps one fenced exactly `W_completing`
+///   ago;
+/// * one fenced moments ago is kept though it and its one part are twenty days old: `W_completing`
+///   is measured from `fenced_at_millis`, never from part progress (F16; the falsification row
+///   `0016:1027`) — the case a reaper that rolls back on sight would fail;
+/// * one both over-age and stale goes to `Aborting@2`, never rolled back first (`0016:1920-1930`).
+///
+/// The pass's tallies count each arm, a rollback among its fences, and the pass is `Changed`.
+#[tokio::test]
+async fn the_completing_arms_judge_at_their_boundaries() {
+    let local = profile(1_500);
+    let fresh = T - 5_000;
+    let (ceiling_at, ceiling_past) = (&upload(0xa0), &upload(0xa1));
+    let (rollback_at, rollback_past) = (&upload(0xa2), &upload(0xa3));
+    let (old_parts, both) = (&upload(0xa4), &upload(0xa5));
+    let store = Store::seeded([
+        ledger(6, &local),
+        completing(ceiling_at, T - W_SESSION_MILLIS, fresh),
+        completing(ceiling_past, T - W_SESSION_MILLIS - 1, fresh),
+        completing(rollback_at, T - DAY, T - W_COMPLETING_MILLIS),
+        completing(rollback_past, T - DAY, T - W_COMPLETING_MILLIS - 1),
+        completing(old_parts, T - 20 * DAY, fresh),
+        psum(old_parts, 1, T - 20 * DAY),
+        completing(both, T - W_SESSION_MILLIS - 1, T - W_COMPLETING_MILLIS - 1),
+    ]);
+    let before = store.snapshot();
+
+    let (pass, log) = judge(&store, &policy(local)).await;
+
+    let pass = pass.expect("the profile matches");
+    assert_eq!(
+        pass,
+        Pass {
+            fenced_idle: 0,
+            fenced_ceiling: 0,
+            fenced_completing_ceiling: 2,
+            rolled_back: 1,
+            lost: 0,
+            unknown: 0,
+            held: 0,
+            foreign: 0,
+            kept: 3,
+            whole: true,
+        }
+    );
+    assert_eq!(pass.fenced(), 3, "a rollback is a fence too");
+    assert_eq!(pass.outcome(), Reconciled::Changed);
+    for id in [ceiling_at, rollback_at, old_parts] {
+        assert_eq!(
+            store.value(&mpu_key(id)),
+            before.get(&mpu_key(id)).cloned(),
+            "{id} is kept byte for byte"
+        );
+        for mode in RetireMode::ALL {
+            assert!(!owes(&store, mode, id), "{id} owes nothing");
+        }
+    }
+    for id in [ceiling_past, both] {
+        let session = decode_session_record(&store.value(&mpu_key(id)).unwrap()).unwrap();
+        assert_eq!(session.state(), &SessionState::Aborting {}, "{id}");
+        assert_eq!(session.epoch(), 2, "{id}: one fence, at E+1");
+        assert!(owes(&store, RetireMode::Bytes, id), "{id} owes its bytes");
+        assert!(
+            owes(&store, RetireMode::Records, id),
+            "{id} owes its attempt's segments"
+        );
+    }
+    let rolled = decode_session_record(&store.value(&mpu_key(rollback_past)).unwrap()).unwrap();
+    assert_eq!(rolled.state(), &SessionState::Open {}, "rolled back");
+    assert_eq!(rolled.epoch(), 2, "at E+1");
+    assert_eq!(rolled.attempts(), 1, "the attempt stays charged");
+    assert!(owes(&store, RetireMode::Records, rollback_past));
+    assert!(
+        !owes(&store, RetireMode::Bytes, rollback_past),
+        "a rollback owes no bytes: the session is Open again"
+    );
+    assert_eq!(
+        log.matches("arm=\"completing-residency-ceiling\"").count(),
+        2,
+        "{log}"
+    );
+    assert_eq!(
+        log.matches("arm=\"completing-rollback\"").count(),
+        1,
+        "{log}"
+    );
+}
+
+/// **The tombstone window, judged at its boundary on the reaper's clock — and its stamp
+/// guarded.** Through the step the operator one-shot runs, at `T`, over `Completed` sessions with
+/// nothing owed and no residue:
+///
+/// * one published exactly `W_tombstone` ago keeps its record; one a millisecond earlier is
+///   deleted, the count lowered by exactly one;
+/// * one stamped under another clock, published a day ago, keeps its record, and the pass holds
+///   it for its clock;
+/// * one published `δ_clock` ahead of the clock keeps its record unheld; one a millisecond further
+///   ahead keeps it too and is held, named for its stamp — it would otherwise be kept for as long
+///   as the stamp stays ahead, unseen.
+#[tokio::test]
+async fn the_tombstone_window_is_judged_at_its_boundary_and_its_stamp_guarded() {
+    let local = profile(1_500);
+    let edge = T + DELTA_CLOCK_MILLIS;
+    let (at, past, foreign) = (upload(0xb0), upload(0xb1), upload(0xb2));
+    let (ahead_at, ahead_past) = (upload(0xb3), upload(0xb4));
+    let store = Store::seeded([
+        ledger(5, &local),
+        completed_at(&at, WALL_CLOCK_SOURCE, T - W_TOMBSTONE_MILLIS),
+        completed_at(&past, WALL_CLOCK_SOURCE, T - W_TOMBSTONE_MILLIS - 1),
+        completed_at(&foreign, "logical", T - DAY),
+        completed_at(&ahead_at, WALL_CLOCK_SOURCE, edge),
+        completed_at(&ahead_past, WALL_CLOCK_SOURCE, edge + 1),
+    ]);
+    let before = store.snapshot();
+    let clock = ManualClock::new(T);
+
+    for _ in 0..3 {
+        let (outcome, log) =
+            step_logged_as(&store, &clock, WALL_CLOCK_SOURCE, &policy(local)).await;
+        assert_eq!(outcome, Reconciled::Blocked, "two sessions are held: {log}");
+        assert!(names(&log, "foreign-clock", &foreign), "{log}");
+        assert!(names(&log, "stamp-ahead-of-clock", &ahead_past), "{log}");
+        assert!(!names(&log, "stamp-ahead-of-clock", &ahead_at), "{log}");
+        assert!(!names(&log, "reaper-session-held", &at), "{log}");
+    }
+
+    assert!(
+        store.value(&mpu_key(&past)).is_none(),
+        "a millisecond past the window: deleted"
+    );
+    assert_eq!(counted(&store), 4, "exactly one slot released");
+    for id in [&at, &foreign, &ahead_at, &ahead_past] {
+        assert_eq!(
+            store.value(&mpu_key(id)),
+            before.get(&mpu_key(id)).cloned(),
+            "{id} keeps its record byte for byte"
+        );
+    }
+}
+
+/// **The tombstone window is judged under the context's clock identity, both ways** — the policy
+/// names no clock of its own. A step whose reaper reads a logical clock, under the default policy:
+/// a wall-stamped tombstone published a day ago is foreign there — held by the pass, its record
+/// and slot kept — and a tombstone stamped under the context's own clock a day ago is past the
+/// window and deleted, the count lowered by exactly one. (A policy that fixed `wall` would delete
+/// the first and keep the second.)
+#[tokio::test]
+async fn a_logical_context_expires_its_own_tombstones_and_holds_wall_ones_as_foreign() {
+    let local = profile(1_500);
+    let (wall, own) = (upload(0xc0), upload(0xc1));
+    let store = Store::seeded([
+        ledger(2, &local),
+        completed_at(&wall, WALL_CLOCK_SOURCE, T - DAY),
+        completed_at(&own, "logical", T - DAY),
+    ]);
+    let wall_before = store.value(&mpu_key(&wall));
+    let clock = ManualClock::new(T);
+
+    for _ in 0..3 {
+        let (outcome, log) = step_logged_as(&store, &clock, "logical", &policy(local)).await;
+        assert_eq!(
+            outcome,
+            Reconciled::Blocked,
+            "the wall tombstone is held: {log}"
+        );
+        assert!(names(&log, "foreign-clock", &wall), "{log}");
+        assert!(!names(&log, "foreign-clock", &own), "{log}");
+    }
+
+    assert_eq!(
+        store.value(&mpu_key(&wall)),
+        wall_before,
+        "the wall tombstone is foreign to this context: kept"
+    );
+    assert!(
+        store.value(&mpu_key(&own)).is_none(),
+        "its own tombstone, past the window, is deleted"
+    );
+    assert_eq!(counted(&store), 1, "exactly one slot released");
+}
+
+/// **A tombstone window no clock is named to judge refuses to certify, and says so; a `Retain`
+/// input judges no stamp.** A step that hands the retirement leg a `Window` with no reaper beside
+/// it — a library caller's shape; the deployed loop always passes its reaper — keeps a `Completed`
+/// record a day past any window, emits `tombstone-window-unjudged` and answers `Blocked`; the
+/// same store under a record-only step, whose reaper names the clock, deletes it and emits no such
+/// signal. Under a policy whose tombstone input is `Retain`, a `Completed` session stamped far
+/// ahead of the clock is not held: no window reads that stamp.
+#[tokio::test]
+async fn a_window_with_no_reaper_clock_is_unjudged_and_a_retain_input_reads_no_stamp() {
+    let local = profile(1_500);
+    let id = upload(0xc8);
+    let seeded = || {
+        Store::seeded([
+            ledger(1, &local),
+            completed_at(&id, WALL_CLOCK_SOURCE, T - DAY),
+        ])
+    };
+    let clock = ManualClock::new(T);
+    let coord = wyrd_coordination_mem::MemCoordination::new();
+    let leader = crate::Custodian::elect(&coord, "zone-reaper")
+        .await
+        .unwrap();
+    let mut zone = crate::FencedZone::new();
+    zone.install(leader.leadership());
+    let topology = wyrd_core::placement::Topology::default();
+
+    // No reaper: the reconstruction input alone carries the window.
+    let store = seeded();
+    let before = store.snapshot();
+    let ctx = crate::ReconstructionContext {
+        meta: &store,
+        fleet: &[],
+        topology: &topology,
+        unreachable: &[],
+        clock: &clock,
+        staged_write_window_millis: crate::gc::W_WRITE_MILLIS,
+        operator_fleet_size: 0,
+        tombstone: policy(local).tombstone(),
+    };
+    let capture = Capture::default();
+    let subscriber = tracing_subscriber::registry().with(
+        tracing_subscriber::fmt::layer()
+            .with_ansi(false)
+            .with_writer(capture.clone()),
+    );
+    let guard = tracing::subscriber::set_default(subscriber);
+    let outcome =
+        crate::reconcile_step(&zone, &leader, None, None, Some(&ctx), None, None, T).await;
+    drop(guard);
+    let log = String::from_utf8(capture.0.lock().unwrap().clone()).unwrap();
+    assert_eq!(
+        outcome.expect("the step runs"),
+        Reconciled::Blocked,
+        "{log}"
+    );
+    assert!(log.contains("tombstone-window-unjudged"), "{log}");
+    assert_eq!(store.snapshot(), before, "the record and its slot are kept");
+
+    // With its reaper, the same window is judged: deleted, and no such signal.
+    let store = seeded();
+    let (outcome, log) = step_logged_as(&store, &clock, WALL_CLOCK_SOURCE, &policy(local)).await;
+    assert_ne!(outcome, Reconciled::Blocked, "{log}");
+    assert!(!log.contains("tombstone-window-unjudged"), "{log}");
+    assert!(store.value(&mpu_key(&id)).is_none(), "judged and deleted");
+    assert_eq!(counted(&store), 0);
+
+    // A `Retain` input: a publication stamped a day ahead is read by nothing, so nothing holds it.
+    let ahead = upload(0xc9);
+    let store = Store::seeded([
+        ledger(1, &local),
+        completed_at(&ahead, WALL_CLOCK_SOURCE, T + DAY),
+    ]);
+    let retain = ReaperPolicy {
+        tombstone: Tombstone::Retain,
+        ..policy(local)
+    };
+    let (pass, log) = judge(&store, &retain).await;
+    let pass = pass.expect("the profile matches");
+    assert_eq!(pass.held, 0, "{log}");
+    assert!(!log.contains("stamp-ahead-of-clock"), "{log}");
+}
