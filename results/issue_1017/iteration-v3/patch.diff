+    let tombstone = |id: &UploadId, source: &str| {
+        let session = format!(
+            "{{\"parent\":42,\"object\":\"bucket/{id}\",\"created_at_millis\":{},\
+             \"clock_source\":\"{source}\",\"segment_nonce\":\"{id}\",\"epoch\":2,\
+             \"attempts\":1,\"state\":{{\"kind\":\"Completed\",\"completion\":{{\"inode\":7,\
+             \"version\":1,\"etag\":\"{}-1\",\"completed_at_millis\":{},\
+             \"complete_fingerprint\":\"{}\"}}}}}}",
+            T0 - 2 * DAY,
+            "ab".repeat(32),
+            T0 - DAY,
+            "cd".repeat(32)
+        );
+        (mpu_key(id), canonical!(SessionRecord, session))
+    };
+    let seeded = |count: u64, sessions: Vec<(Vec<u8>, Bytes)>| async move {
+        let profile = String::from_utf8(metadata::encode(&Budget::shipped()).to_vec()).unwrap();
+        let ledger = format!(
