+/// contribution handed in once the segment phase is done, so the root carries that later stamp, not
+/// the one the publication was checked with. That flip is checked as step 1 checks the
+/// publication's own: one whose contribution does not move the fence is refused after the segment
+/// phase, with no flip sent, the segments in place and the fence where the phase left it.
+#[test]
+fn g_a_flip_built_after_the_segment_phase_carries_its_stamp_and_is_checked_again() {
+    let big = chunks(BIG, 1);
+    let checked = meta(1);
+    let stamped = meta(2);
+
+    let store = Recorder::new();
+    let publication = fresh(8, "big", EPOCH, &big, &checked);
+    let ready = segments_done(&store, &publication);
+    let phase = store.batches();
+    assert!(
+        !phase.is_empty() && phase.iter().all(touches_seg),
+        "segment batches only"
+    );
+    assert_eq!(root_of(&store, 8), None, "no flip yet");
+    let outcome = pollster::block_on(ready.flip(&store, &stamped, flip_move(SEGMENTS)));
+    assert_eq!(outcome.unwrap(), CommitOutcome::Committed);
+    let batches = store.batches();
+    assert_eq!(
+        batches.len(),
+        phase.len() + 1,
+        "the segment batches, then the flip"
+    );
+    assert!(puts_key(&batches[phase.len()], &inode_key(8)) && store.get(FLIP_MARK).is_some());
+    assert_eq!(
+        root_of(&store, 8).unwrap().modified,
+        Some(2),
+        "the stamp handed in after the segment phase"
+    );
+    assert_eq!(resolved(&store, 8), big);
+
+    let store = Recorder::new();
+    let ready = segments_done(&store, &publication);
+    let sent = store.batches().len();
+    let unmoved = WriteBatch::new()
+        .require(FENCE, cursor(SEGMENTS))
+        .put(FLIP_MARK, Bytes::from_static(b"flipped"));
+    let err = refusal(pollster::block_on(ready.flip(&store, &stamped, unmoved)));
+    assert_eq!(err, PublicationError::FenceNotMoved);
+    assert_eq!(store.batches().len(), sent, "no flip sent");
+    assert_eq!(root_of(&store, 8), None);
+    assert_eq!(
+        store.get(FENCE),
+        Some(cursor(SEGMENTS)),
+        "where the phase left it"
+    );
+}
