+    /// A `ChunkRef` of `len` bytes — the shape the overflow arithmetic below reads.
+    fn chunk_of_len(id: ChunkId, len: u64) -> ChunkRef {
+        ChunkRef {
+            id,
+            scheme: EcScheme::None,
+            len,
+            placement: vec![],
