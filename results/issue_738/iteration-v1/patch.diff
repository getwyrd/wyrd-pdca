new file mode 100644
index 0000000..fe4c306
--- /dev/null
+++ b/crates/server/tests/s3_chunk_size_flag.rs
@@ -0,0 +1,318 @@
+//! `wyrd s3 --chunk-size N` is honoured end to end (#738), driven through the BUILT `wyrd`
+//! binary — not `serve_s3_role` — so the test references no symbol the fix adds and the
+//! pre-fix tree compiles it and fails on the assertion. Pre-fix, `ParsedArgs::parse` records
+//! an unknown `--chunk-size` and nobody reads it, so the role starts, ignores the flag, and
+//! chunks at the 1 MiB default.
+//!
+//! * With `--chunk-size N`, one object of `4N` bytes PUT through the role lands as exactly
+//!   four chunk directories under `<data-dir>/chunks` (`FsChunkStore` files each chunk as a
+//!   `<32-hex>` directory of `<index>.frag` fragments).
+//! * With NO `--chunk-size`, the identical object lands as the chunk count 1 MiB implies —
+//!   absence selects the shared `DEFAULT_CHUNK_SIZE`, unchanged from today.
+//! * `0` and `1073741825` (one past the inclusive 1 GiB ceiling) exit non-zero, naming the
+//!   flag, without the role ever printing its listen line; `1` and `1073741824` start.
+//!
+//! Every child is killed by a drop guard on every exit path (the role blocks forever), and
+//! every wait is bounded, so a pre-fix binary that wrongly starts is a red, never a hang.
+
+#![forbid(unsafe_code)]
+
+use std::io::{BufRead, BufReader, Read, Write};
+use std::net::{SocketAddr, TcpStream};
+use std::path::Path;
+use std::process::{Child, Command, ExitStatus, Stdio};
+use std::sync::mpsc::{self, Receiver, RecvTimeoutError};
+use std::time::{Duration, Instant};
+
+use wyrd_gateway_s3::sigv4::{format_amz_date, sign, Credentials};
+
+const WYRD: &str = env!("CARGO_BIN_EXE_wyrd");
+const ACCESS_KEY: &str = "AKIAIOSFODNN7EXAMPLE";
+const SECRET_KEY: &str = "wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY";
+const REGION: &str = "us-east-1";
+/// The role's line reporting `listener.local_addr()` — parsed for the ephemeral port.
+const SERVING: &str = "wyrd s3: serving S3-compatible HTTP on ";
+/// Bound on every wait: role start-up, role exit, and the HTTP exchange.
+const WAIT: Duration = Duration::from_secs(60);
+/// The default chunk size the role must select when `--chunk-size` is absent.
+const ONE_MIB: usize = 1 << 20;
+/// The non-default chunk size under test: `4 * N` = 2 MiB, so the default case is itself
+/// multi-chunk (2 chunks) and the flag case is 4 — both counts are discriminating.
+const N: usize = 512 * 1024;
+
+/// A running `wyrd s3` child. Dropping it kills and reaps the process, so no exit path —
+/// a failed assertion included — leaves a server running.
+struct Role {
+    child: Child,
+    stderr: Receiver<String>,
+    seen: Vec<String>,
+}
+
+impl Drop for Role {
+    fn drop(&mut self) {
+        let _ = self.child.kill();
+        let _ = self.child.wait();
+    }
+}
+
+/// How a spawned role resolved: it started serving, or it exited first.
+enum Outcome {
+    Serving(SocketAddr),
+    Exited(ExitStatus),
+}
+
+fn spawn_role(data_dir: &Path, chunk_size: Option<&str>) -> Role {
+    let mut args = vec![
+        "s3".to_string(),
+        "--s3-listen".to_string(),
+        "127.0.0.1:0".to_string(),
+        "--data-dir".to_string(),
+        data_dir.to_str().expect("utf-8 path").to_string(),
+        "--region".to_string(),
+        REGION.to_string(),
+        "--access-key".to_string(),
+        ACCESS_KEY.to_string(),
+        "--secret-key".to_string(),
+        SECRET_KEY.to_string(),
+    ];
+    if let Some(value) = chunk_size {
+        args.push("--chunk-size".to_string());
+        args.push(value.to_string());
+    }
+    let mut child = Command::new(WYRD)
+        .args(&args)
+        .stdin(Stdio::null())
+        .stdout(Stdio::null())
+        .stderr(Stdio::piped())
+        .spawn()
+        .expect("spawn the wyrd binary");
+    let pipe = child.stderr.take().expect("piped stderr");
+    let (tx, rx) = mpsc::channel();
+    // Drain stderr for the child's whole life so it never blocks on a full pipe.
+    std::thread::spawn(move || {
+        for line in BufReader::new(pipe).lines() {
+            let Ok(line) = line else { break };
+            if tx.send(line).is_err() {
+                break;
+            }
+        }
+    });
+    Role {
+        child,
+        stderr: rx,
+        seen: Vec::new(),
+    }
+}
+
+impl Role {
+    /// Wait (bounded) until the role prints its listen line or exits.
+    fn outcome(&mut self) -> Outcome {
+        let deadline = Instant::now() + WAIT;
+        loop {
+            let left = deadline.saturating_duration_since(Instant::now());
+            assert!(
+                !left.is_zero(),
+                "wyrd s3 neither served nor exited within {WAIT:?}; stderr: {:?}",
+                self.seen
+            );
+            match self
+                .stderr
+                .recv_timeout(left.min(Duration::from_millis(100)))
+            {
+                Ok(line) => {
+                    if let Some(rest) = line.strip_prefix(SERVING) {
+                        let addr = rest
+                            .split_whitespace()
+                            .next()
+                            .expect("address after the listen line")
+                            .parse()
+                            .expect("listen line carries a socket address");
+                        self.seen.push(line);
+                        return Outcome::Serving(addr);
+                    }
+                    self.seen.push(line);
+                }
+                Err(RecvTimeoutError::Timeout) => {}
+                // stderr closed: the child is exiting; reap it below.
+                Err(RecvTimeoutError::Disconnected) => {
+                    let status = self.wait_exit(deadline);
+                    return Outcome::Exited(status);
+                }
+            }
+            if let Some(status) = self.child.try_wait().expect("poll child") {
+                // Collect what it printed before exiting.
+                while let Ok(line) = self.stderr.recv_timeout(Duration::from_millis(200)) {
+                    self.seen.push(line);
+                }
+                return Outcome::Exited(status);
+            }
+        }
+    }
+
+    fn wait_exit(&mut self, deadline: Instant) -> ExitStatus {
+        loop {
+            if let Some(status) = self.child.try_wait().expect("poll child") {
+                return status;
+            }
+            assert!(
+                Instant::now() < deadline,
+                "wyrd s3 closed stderr but did not exit"
+            );
+            std::thread::sleep(Duration::from_millis(20));
+        }
+    }
+
+    fn serving(&mut self) -> SocketAddr {
+        match self.outcome() {
+            Outcome::Serving(addr) => addr,
+            Outcome::Exited(status) => panic!(
+                "wyrd s3 exited ({status}) instead of serving; stderr: {:?}",
+                self.seen
+            ),
+        }
+    }
+}
+
+/// One SigV4-signed PUT over a fresh loopback connection; returns the HTTP status.
+fn signed_put(addr: SocketAddr, path: &str, body: &[u8]) -> u16 {
+    let host = addr.to_string();
+    let creds = Credentials {
+        access_key_id: ACCESS_KEY.to_string(),
+        secret_access_key: SECRET_KEY.to_string(),
+    };
+    // wall-clock exempt (test): the SigV4 request date must sit inside the live role's
+    // freshness window, which that role judges against its own wall clock.
+    #[allow(clippy::disallowed_methods)]
+    let amz_date = format_amz_date(std::time::SystemTime::now());
+    let signed = sign(
+        "PUT", path, "", &host, &amz_date, body, &creds, REGION, "s3",
+    );
+    let head = format!(
+        "PUT {path} HTTP/1.1\r\nhost: {host}\r\nauthorization: {}\r\nx-amz-date: {}\r\n\
+         x-amz-content-sha256: {}\r\ncontent-length: {}\r\nconnection: close\r\n\r\n",
+        signed.authorization,
+        signed.amz_date,
+        signed.content_sha256,
+        body.len()
+    );
+    let mut stream = TcpStream::connect_timeout(&addr, WAIT).expect("connect");
+    stream.set_read_timeout(Some(WAIT)).expect("read timeout");
+    stream.set_write_timeout(Some(WAIT)).expect("write timeout");
+    stream.write_all(head.as_bytes()).expect("write head");
+    stream.write_all(body).expect("write body");
+    stream.flush().expect("flush");
+    let mut raw = Vec::new();
+    stream.read_to_end(&mut raw).expect("read response");
+    let text = String::from_utf8_lossy(&raw);
+    text.split_whitespace()
+        .nth(1)
+        .and_then(|code| code.parse().ok())
+        .unwrap_or_else(|| panic!("malformed HTTP response: {text:?}"))
+}
+
+/// The number of chunks `FsChunkStore` holds under `<data-dir>/chunks`: directories named
+/// by a 32-hex chunk id, each holding at least one `<index>.frag`.
+fn chunk_count(data_dir: &Path) -> usize {
+    let root = data_dir.join("chunks");
+    std::fs::read_dir(&root)
+        .expect("chunk store root exists")
+        .map(|e| e.expect("dir entry"))
+        .filter(|e| {
+            let name = e.file_name();
+            let name = name.to_string_lossy();
+            e.path().is_dir() && name.len() == 32 && name.chars().all(|c| c.is_ascii_hexdigit())
+        })
+        .inspect(|e| {
+            let frags = std::fs::read_dir(e.path())
+                .expect("chunk dir")
+                .filter(|f| {
+                    f.as_ref()
+                        .expect("fragment entry")
+                        .file_name()
+                        .to_string_lossy()
+                        .ends_with(".frag")
+                })
+                .count();
+            assert!(frags > 0, "chunk dir {:?} holds no fragments", e.path());
+        })
+        .count()
+}
+
+/// PUT one `4N`-byte object through a role started with `chunk_size`; return the chunk count.
+fn chunks_for_one_put(chunk_size: Option<&str>) -> usize {
+    let work = tempfile::tempdir().expect("temp dir");
+    let mut role = spawn_role(work.path(), chunk_size);
+    let addr = role.serving();
+    let object: Vec<u8> = (0..4 * N).map(|i| (i % 251) as u8).collect();
+    let status = signed_put(addr, "/wyrd-bucket/chunk-size-object", &object);
+    assert_eq!(
+        status, 200,
+        "signed PUT through the role; stderr: {:?}",
+        role.seen
+    );
+    let count = chunk_count(work.path());
+    drop(role);
+    count
+}
+
+#[test]
+fn chunk_size_flag_sets_the_on_disk_chunk_count_and_absence_keeps_the_default() {
+    let with_flag = chunks_for_one_put(Some(&N.to_string()));
+    assert_eq!(
+        with_flag,
+        4,
+        "`--chunk-size {N}` must split a {}-byte object into 4 chunks",
+        4 * N
+    );
+
+    let default = chunks_for_one_put(None);
+    assert_eq!(
+        default,
+        (4 * N).div_ceil(ONE_MIB),
+        "no `--chunk-size` must chunk at the 1 MiB default, unchanged from today"
+    );
+}
+
+/// Assert `value` is refused: the role exits non-zero, names the flag, and never serves.
+fn assert_refused(value: &str) {
+    let work = tempfile::tempdir().expect("temp dir");
+    let mut role = spawn_role(work.path(), Some(value));
+    match role.outcome() {
+        Outcome::Serving(addr) => panic!(
+            "`--chunk-size {value}` must be refused before binding, but the role serves on \
+             {addr}; stderr: {:?}",
+            role.seen
+        ),
+        Outcome::Exited(status) => {
+            assert!(
+                !status.success(),
+                "`--chunk-size {value}` must exit non-zero"
+            );
+            assert!(
+                role.seen.iter().any(|l| l.contains("--chunk-size")),
+                "`--chunk-size {value}` refusal must name the flag; stderr: {:?}",
+                role.seen
+            );
+        }
+    }
+}
+
+/// Assert `value` is accepted: the role starts and prints its listen line. Never PUTs, so
+/// no chunk-sized buffer is ever allocated.
+fn assert_accepted(value: &str) {
+    let work = tempfile::tempdir().expect("temp dir");
+    let mut role = spawn_role(work.path(), Some(value));
+    role.serving();
+}
+
+#[test]
+fn chunk_size_zero_is_refused_and_one_is_accepted() {
+    assert_refused("0");
+    assert_accepted("1");
+}
+
+#[test]
+fn chunk_size_ceiling_is_one_gib_inclusive() {
+    assert_accepted("1073741824");
+    assert_refused("1073741825");
+}
