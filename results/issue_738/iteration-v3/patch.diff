+/// One SigV4-signed request over a fresh loopback connection; returns `(status, body)`.
+/// The response's framing is checked strictly ([`parse_response`]), so a torn or
+/// malformed response fails here rather than reaching an assertion as a short body.
+fn signed_request(addr: SocketAddr, method: &str, path: &str, body: &[u8]) -> (u16, Vec<u8>) {
+    let host = addr.to_string();
+    let creds = Credentials {
+        access_key_id: ACCESS_KEY.to_string(),
+        secret_access_key: SECRET_KEY.to_string(),
+    };
+    // wall-clock exempt (test): the SigV4 request date must sit inside the live role's
+    // freshness window, which that role judges against its own wall clock.
+    #[allow(clippy::disallowed_methods)]
+    let amz_date = format_amz_date(std::time::SystemTime::now());
+    let signed = sign(
+        method, path, "", &host, &amz_date, body, &creds, REGION, "s3",
+    );
+    let head = format!(
+        "{method} {path} HTTP/1.1\r\nhost: {host}\r\nauthorization: {}\r\nx-amz-date: {}\r\n\
+         x-amz-content-sha256: {}\r\ncontent-length: {}\r\nconnection: close\r\n\r\n",
+        signed.authorization,
+        signed.amz_date,
+        signed.content_sha256,
+        body.len()
+    );
+    let mut stream = TcpStream::connect_timeout(&addr, WAIT).expect("connect");
+    stream.set_read_timeout(Some(WAIT)).expect("read timeout");
+    stream.set_write_timeout(Some(WAIT)).expect("write timeout");
+    stream.write_all(head.as_bytes()).expect("write head");
+    stream.write_all(body).expect("write body");
+    stream.flush().expect("flush");
+    let mut raw = Vec::new();
+    stream.read_to_end(&mut raw).expect("read response");
+    parse_response(&raw).unwrap_or_else(|e| {
+        panic!(
+            "{method} {path}: malformed HTTP response ({e}); first bytes: {:?}",
+            String::from_utf8_lossy(&raw[..raw.len().min(512)])
+        )
+    })
+}
+
+/// Parse one complete HTTP/1.1 response, read to EOF (every request sends `connection:
+/// close`), into `(status, body)`. Strict, because the PUT-status and GET-equality
+/// assertions are only as good as the body they are handed: the status line must be
+/// `HTTP/1.1 <3 digits> …`, and the body must be framed by exactly ONE of
+/// `content-length` (digits only, followed by exactly that many bytes — no fewer, no
+/// more) or `transfer-encoding: chunked` ([`dechunk`]). An unframed body is refused as
+/// well: its truncation could not be told apart from its end.
+fn parse_response(raw: &[u8]) -> Result<(u16, Vec<u8>), String> {
+    let split = find(raw, b"\r\n\r\n").ok_or("no end of the header section")?;
+    let head = std::str::from_utf8(&raw[..split]).map_err(|_| "header section is not UTF-8")?;
+    let rest = &raw[split + 4..];
+    let mut lines = head.split("\r\n");
+
+    let status_line = lines.next().unwrap_or_default();
+    let code = status_line
+        .strip_prefix("HTTP/1.1 ")
+        .filter(|s| s.len() >= 4 && s.as_bytes()[3] == b' ')
+        .map(|s| &s[..3])
+        .filter(|c| c.bytes().all(|b| b.is_ascii_digit()))
+        .ok_or_else(|| format!("malformed status line {status_line:?}"))?;
+    let status: u16 = code.parse().map_err(|e| format!("status code: {e}"))?;
+
+    let mut content_length: Option<usize> = None;
+    let mut chunked = false;
+    for line in lines {
+        let (name, value) = line
+            .split_once(':')
+            .filter(|(name, _)| !name.is_empty() && !name.contains([' ', '\t']))
+            .ok_or_else(|| format!("malformed header line {line:?}"))?;
+        let value = value.trim_matches([' ', '\t']);
+        if name.eq_ignore_ascii_case("content-length") {
+            if value.is_empty() || !value.bytes().all(|b| b.is_ascii_digit()) {
+                return Err(format!("malformed content-length {value:?}"));
+            }
+            let n = value.parse().map_err(|e| format!("content-length: {e}"))?;
+            if content_length.replace(n).is_some() {
+                return Err("duplicate content-length".to_string());
+            }
+        } else if name.eq_ignore_ascii_case("transfer-encoding") {
+            if !value.eq_ignore_ascii_case("chunked") || chunked {
+                return Err(format!("unsupported transfer-encoding {value:?}"));
+            }
+            chunked = true;
+        }
+    }
+
+    let body = match (content_length, chunked) {
+        (Some(n), false) if rest.len() == n => rest.to_vec(),
+        (Some(n), false) => {
+            return Err(format!(
+                "declared content-length {n}, but {} body bytes arrived",
+                rest.len()
+            ))
+        }
+        (None, true) => dechunk(rest)?,
+        (Some(_), true) => return Err("both content-length and chunked framing".to_string()),
+        (None, false) => return Err("no content-length or chunked framing".to_string()),
+    };
+    Ok((status, body))
+}
+
+/// De-frame an HTTP/1.1 chunked body (RFC 9112 §7.1): `<hex-size>[;ext]\r\n<data>\r\n`
+/// repeated, then `0\r\n`, an optional trailer section and the final `\r\n`, with nothing
+/// after it. Every delimiter is checked — a size that is not plain hex, a truncated chunk,
+/// chunk data not followed by CRLF, an unterminated trailer section, or bytes after the
+/// end are each an error, never a shortened body.
+fn dechunk(mut raw: &[u8]) -> Result<Vec<u8>, String> {
+    let mut out = Vec::new();
+    loop {
+        let (line, after) = split_line(raw).ok_or("chunk-size line has no CRLF")?;
+        let digits = line.iter().take_while(|b| b.is_ascii_hexdigit()).count();
+        // Only an extension (after optional whitespace) may follow the size.
+        let ext = line[digits..].iter().find(|b| **b != b' ' && **b != b'\t');
+        if digits == 0 || ext.is_some_and(|b| *b != b';') {
+            return Err(format!(
+                "malformed chunk-size line {:?}",
+                String::from_utf8_lossy(line)
+            ));
+        }
+        let hex = std::str::from_utf8(&line[..digits]).map_err(|e| e.to_string())?;
+        let size = usize::from_str_radix(hex, 16).map_err(|e| format!("chunk size: {e}"))?;
+        raw = after;
+        if size == 0 {
+            // The trailer section: field lines up to the empty line that ends the message.
+            loop {
+                let (line, after) = split_line(raw).ok_or("trailer section is not terminated")?;
+                raw = after;
+                if line.is_empty() {
+                    break;
+                }
+                if !line.contains(&b':') {
+                    return Err(format!(
+                        "malformed trailer line {:?}",
+                        String::from_utf8_lossy(line)
+                    ));
+                }
+            }
+            if !raw.is_empty() {
+                return Err(format!("{} bytes after the last chunk", raw.len()));
+            }
+            return Ok(out);
+        }
+        let data = raw
+            .get(..size)
+            .ok_or_else(|| format!("chunk of {size} bytes truncated at {}", raw.len()))?;
+        out.extend_from_slice(data);
+        raw = raw[size..]
+            .strip_prefix(b"\r\n")
+            .ok_or("chunk data is not followed by CRLF")?;
+    }
+}
+
+/// Split off one CRLF-terminated line: `(line, rest after the CRLF)`.
+fn split_line(raw: &[u8]) -> Option<(&[u8], &[u8])> {
+    let eol = find(raw, b"\r\n")?;
+    Some((&raw[..eol], &raw[eol + 2..]))
+}
+
+fn find(haystack: &[u8], needle: &[u8]) -> Option<usize> {
+    haystack.windows(needle.len()).position(|w| w == needle)
+}
+
+/// The number of chunks an `FsChunkStore` rooted at `root` holds: directories named by a
+/// 32-hex chunk id, each holding at least one `<index>.frag`.
+fn chunk_count(root: &Path) -> usize {
+    std::fs::read_dir(root)
+        .expect("chunk store root exists")
+        .map(|e| e.expect("dir entry"))
+        .filter(|e| {
+            let name = e.file_name();
+            let name = name.to_string_lossy();
+            e.path().is_dir() && name.len() == 32 && name.chars().all(|c| c.is_ascii_hexdigit())
+        })
+        .inspect(|e| {
+            let frags = std::fs::read_dir(e.path())
+                .expect("chunk dir")
+                .filter(|f| {
+                    f.as_ref()
+                        .expect("fragment entry")
+                        .file_name()
+                        .to_string_lossy()
+                        .ends_with(".frag")
+                })
+                .count();
+            assert!(frags > 0, "chunk dir {:?} holds no fragments", e.path());
+        })
+        .count()
+}
+
+/// A deterministic, non-repeating-per-chunk payload of `len` bytes.
+fn object(len: usize) -> Vec<u8> {
+    (0..len).map(|i| (i % 251) as u8).collect()
+}
+
+/// PUT one `4N`-byte object through a single-node role started with `chunk_size`; return
+/// the chunk count under `<data-dir>/chunks`.
+fn chunks_for_one_put(chunk_size: Option<&str>) -> usize {
+    let work = tempfile::tempdir().expect("temp dir");
+    let mut role = spawn_role(work.path(), chunk_size, None);
+    let addr = role.serving();
+    let (status, body) = signed_request(
+        addr,
+        "PUT",
+        "/wyrd-bucket/chunk-size-object",
+        &object(4 * N),
+    );
+    assert_eq!(
+        status,
+        200,
+        "signed PUT through the role: {}; stderr: {:?}",
+        String::from_utf8_lossy(&body),
+        role.seen
+    );
+    let count = chunk_count(&work.path().join("chunks"));
+    drop(role);
+    count
+}
+
+#[test]
+fn chunk_size_flag_sets_the_on_disk_chunk_count_and_absence_keeps_the_default() {
+    let with_flag = chunks_for_one_put(Some(&N.to_string()));
+    assert_eq!(
+        with_flag,
+        4,
+        "`--chunk-size {N}` must split a {}-byte object into 4 chunks",
+        4 * N
+    );
+
+    let default = chunks_for_one_put(None);
+    assert_eq!(
+        default,
+        (4 * N).div_ceil(ONE_MIB),
+        "no `--chunk-size` must chunk at the 1 MiB default, unchanged from today"
+    );
+}
+
+/// Assert `value` is refused: the role exits non-zero, names the flag, and never serves.
+fn assert_refused(value: &str) {
+    let work = tempfile::tempdir().expect("temp dir");
+    let mut role = spawn_role(work.path(), Some(value), None);
+    match role.outcome() {
+        Outcome::Serving(addr) => panic!(
+            "`--chunk-size {value}` must be refused before binding, but the role serves on \
+             {addr}; stderr: {:?}",
+            role.seen
+        ),
+        Outcome::Exited(status) => {
+            assert!(
+                !status.success(),
+                "`--chunk-size {value}` must exit non-zero"
+            );
+            assert!(
+                role.seen.iter().any(|l| l.contains("--chunk-size")),
+                "`--chunk-size {value}` refusal must name the flag; stderr: {:?}",
+                role.seen
+            );
+        }
+    }
+}
+
+/// Assert `value` is accepted: the role starts and prints its listen line. Never PUTs, so
+/// no chunk-sized buffer is ever allocated.
+fn assert_accepted(value: &str) {
+    let work = tempfile::tempdir().expect("temp dir");
+    let mut role = spawn_role(work.path(), Some(value), None);
+    role.serving();
+}
+
+#[test]
+fn chunk_size_zero_is_refused_and_one_is_accepted() {
+    assert_refused("0");
+    assert_accepted("1");
+}
+
+#[test]
+fn chunk_size_ceiling_is_one_gib_inclusive() {
+    assert_accepted("1073741824");
+    assert_refused("1073741825");
+}
+
+/// The operator-facing usage text lists the flag on the `wyrd s3` line (`wyrd` with no
+/// command prints it and exits 2).
+#[test]
+fn s3_usage_line_lists_chunk_size() {
+    let out = Command::new(WYRD)
+        .stdin(Stdio::null())
+        .output()
+        .expect("run the wyrd binary");
+    assert_eq!(
+        out.status.code(),
+        Some(2),
+        "bare `wyrd` prints usage, exit 2"
+    );
+    let usage = String::from_utf8_lossy(&out.stderr);
+    let s3 = usage
+        .lines()
+        .find(|l| l.trim_start().starts_with("wyrd s3 "))
+        .unwrap_or_else(|| panic!("usage has a `wyrd s3` line: {usage}"));
+    assert!(
+        s3.contains("[--chunk-size N]"),
+        "the `wyrd s3` usage line must list `[--chunk-size N]`: {s3}"
+    );
+}
+
+/// Not a plain decimal integer: a unit suffix, and a leading `+` that `usize::from_str`
+/// alone would accept.
+#[test]
+fn chunk_size_non_numeric_and_signed_values_are_refused() {
+    assert_refused("1MiB");
+    assert_refused("+1");
+}
+
+/// The cluster composition carries an accepted chunk size whose fragments exceed tonic's
+/// 4 MiB default message limit: the PUT lands as ONE chunk on the D server (the flag is
+/// honoured over `--endpoints` too) and the GET reassembles it byte-identical (the gateway's
+/// client decodes the large fragments the D server returns).
+#[test]
+fn a_chunk_past_the_4_mib_grpc_default_round_trips_through_a_d_server() {
+    let dserver_root = tempfile::tempdir().expect("D server temp dir");
+    let dserver = DServerHost::start(dserver_root.path());
+    let work = tempfile::tempdir().expect("gateway temp dir");
+    let mut role = spawn_role(
+        work.path(),
+        Some(&BIG_CHUNK.to_string()),
+        Some(&dserver.endpoint),
+    );
+    let addr = role.serving();
+    let path = "/wyrd-bucket/big-chunk-object";
+    let payload = object(BIG_CHUNK);
+
+    let (status, body) = signed_request(addr, "PUT", path, &payload);
+    assert_eq!(
+        status,
+        200,
+        "PUT of one {BIG_CHUNK}-byte chunk over gRPC: {}; stderr: {:?}",
+        String::from_utf8_lossy(&body),
+        role.seen
+    );
+    assert_eq!(
+        chunk_count(dserver_root.path()),
+        1,
+        "`--chunk-size {BIG_CHUNK}` must store a {BIG_CHUNK}-byte object as ONE chunk on the \
+         D server"
+    );
+
+    let (status, got) = signed_request(addr, "GET", path, &[]);
+    assert_eq!(
+        status,
+        200,
+        "GET of the {BIG_CHUNK}-byte chunk over gRPC: {}; stderr: {:?}",
+        String::from_utf8_lossy(&got[..got.len().min(512)]),
+        role.seen
+    );
+    assert!(
+        got == payload,
+        "GET returned {} bytes that differ from the {} bytes PUT",
+        got.len(),
+        payload.len()
+    );
+    drop(role);
+    drop(dserver);
+}
+
+/// The response parser the wire assertions above rely on accepts every framing the role
+/// sends: a `content-length` body (including an empty one) and a chunked body, with chunk
+/// extensions and a trailer section.
+#[test]
+fn response_parser_accepts_well_framed_responses() {
+    let ok = |raw: &str| parse_response(raw.as_bytes());
+    assert_eq!(
+        ok("HTTP/1.1 200 OK\r\ncontent-length: 3\r\n\r\nabc"),
+        Ok((200, b"abc".to_vec()))
+    );
+    assert_eq!(
+        ok("HTTP/1.1 200 OK\r\nContent-Length: 0\r\netag: \"x\"\r\n\r\n"),
+        Ok((200, Vec::new()))
+    );
+    assert_eq!(
+        ok(
+            "HTTP/1.1 403 Forbidden\r\ntransfer-encoding: chunked\r\n\r\n\
+            3\r\nabc\r\n2;name=value\r\nde\r\n0\r\n\r\n"
+        ),
+        Ok((403, b"abcde".to_vec()))
+    );
+    assert_eq!(
+        ok("HTTP/1.1 200 OK\r\nTransfer-Encoding: Chunked\r\n\r\n\
+            A\r\n0123456789\r\n0\r\nx-trailer: v\r\n\r\n"),
+        Ok((200, b"0123456789".to_vec()))
+    );
+}
+
+/// ...and refuses every torn, truncated or malformed one — so a short or garbled response
+/// fails the wire legs loudly instead of reaching their assertions as a plausible body.
+#[test]
+fn response_parser_refuses_torn_or_malformed_framing() {
+    const CHUNKED: &str = "HTTP/1.1 200 OK\r\ntransfer-encoding: chunked\r\n\r\n";
+    const SIZED: &str = "HTTP/1.1 200 OK\r\ncontent-length: 4\r\n\r\n";
+    for (why, raw) in [
+        (
+            "no end of headers",
+            "HTTP/1.1 200 OK\r\ncontent-length: 0\r\n".to_string(),
+        ),
+        (
+            "HTTP/1.0 status line",
+            "HTTP/1.0 200 OK\r\ncontent-length: 0\r\n\r\n".into(),
+        ),
+        (
+            "two-digit status",
+            "HTTP/1.1 20 OK\r\ncontent-length: 0\r\n\r\n".into(),
+        ),
+        (
+            "header without a colon",
+            "HTTP/1.1 200 OK\r\nbogus\r\n\r\n".into(),
+        ),
+        ("unframed body", "HTTP/1.1 200 OK\r\n\r\nabc".into()),
+        ("truncated sized body", format!("{SIZED}abc")),
+        ("bytes past content-length", format!("{SIZED}abcde")),
+        (
+            "signed content-length",
+            "HTTP/1.1 200 OK\r\ncontent-length: +3\r\n\r\nabc".into(),
+        ),
+        (
+            "duplicate content-length",
+            "HTTP/1.1 200 OK\r\ncontent-length: 1\r\ncontent-length: 1\r\n\r\na".into(),
+        ),
+        (
+            "both framings",
+            "HTTP/1.1 200 OK\r\ncontent-length: 5\r\ntransfer-encoding: chunked\r\n\r\n0\r\n\r\n"
+                .into(),
+        ),
+        (
+            "non-chunked transfer-encoding",
+            "HTTP/1.1 200 OK\r\ntransfer-encoding: gzip\r\n\r\n".into(),
+        ),
+        (
+            "chunk data not followed by CRLF",
+            format!("{CHUNKED}1\r\naxx0\r\n\r\n"),
+        ),
+        (
+            "bad delimiters and no terminator",
+            format!("{CHUNKED}1\r\naxx0\r\n"),
+        ),
+        ("no final CRLF", format!("{CHUNKED}1\r\na\r\n0\r\n")),
+        ("no last chunk", format!("{CHUNKED}1\r\na\r\n")),
+        ("truncated chunk", format!("{CHUNKED}5\r\nab")),
+        (
+            "signed chunk size",
+            format!("{CHUNKED}+1\r\na\r\n0\r\n\r\n"),
+        ),
+        (
+            "non-hex chunk size",
+            format!("{CHUNKED}1g\r\na\r\n0\r\n\r\n"),
+        ),
+        ("empty chunk size", format!("{CHUNKED}\r\n\r\n")),
+        (
+            "unterminated trailer",
+            format!("{CHUNKED}0\r\nx-trailer: v\r\n"),
+        ),
+        (
+            "trailer line without a colon",
+            format!("{CHUNKED}0\r\nbogus\r\n\r\n"),
+        ),
+        (
+            "bytes after the last chunk",
+            format!("{CHUNKED}0\r\n\r\nextra"),
+        ),
+    ] {
+        assert!(
+            parse_response(raw.as_bytes()).is_err(),
+            "{why}: {raw:?} must be refused, got {:?}",
+            parse_response(raw.as_bytes())
+        );
+    }
+}
