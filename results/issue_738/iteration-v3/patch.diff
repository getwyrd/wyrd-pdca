+/// A running `wyrd s3` child. Dropping it kills and reaps the process, so no exit path —
+/// a failed assertion included — leaves a server running.
+struct Role {
+    child: Child,
+    stderr: Receiver<String>,
+    seen: Vec<String>,
+}
+
+impl Drop for Role {
+    fn drop(&mut self) {
+        let _ = self.child.kill();
+        let _ = self.child.wait();
+    }
+}
+
+/// How a spawned role resolved: it started serving, or it exited first.
+enum Outcome {
+    Serving(SocketAddr),
+    Exited(ExitStatus),
+}
+
+fn spawn_role(data_dir: &Path, chunk_size: Option<&str>, endpoints: Option<&str>) -> Role {
+    let mut args = vec![
+        "s3".to_string(),
+        "--s3-listen".to_string(),
+        "127.0.0.1:0".to_string(),
+        "--data-dir".to_string(),
+        data_dir.to_str().expect("utf-8 path").to_string(),
+        "--region".to_string(),
+        REGION.to_string(),
+        "--access-key".to_string(),
+        ACCESS_KEY.to_string(),
+        "--secret-key".to_string(),
+        SECRET_KEY.to_string(),
+        // Pinned, not inherited: the role honours `WYRD_METADATA_BACKEND` /
+        // `WYRD_COORDINATION_BACKEND` when these are absent.
+        "--metadata-backend".to_string(),
+        "redb".to_string(),
+        "--coordination-backend".to_string(),
+        "mem".to_string(),
+    ];
+    if let Some(value) = chunk_size {
+        args.push("--chunk-size".to_string());
+        args.push(value.to_string());
+    }
+    if let Some(list) = endpoints {
+        args.push("--endpoints".to_string());
+        args.push(list.to_string());
+    }
+    let mut child = Command::new(WYRD)
+        .args(&args)
+        .stdin(Stdio::null())
+        .stdout(Stdio::null())
+        .stderr(Stdio::piped())
+        .spawn()
+        .expect("spawn the wyrd binary");
+    let pipe = child.stderr.take().expect("piped stderr");
+    let (tx, rx) = mpsc::channel();
+    // Drain stderr for the child's whole life so it never blocks on a full pipe.
+    std::thread::spawn(move || {
+        for line in BufReader::new(pipe).lines() {
+            let Ok(line) = line else { break };
+            if tx.send(line).is_err() {
+                break;
+            }
+        }
+    });
+    Role {
+        child,
+        stderr: rx,
+        seen: Vec::new(),
+    }
+}
+
+impl Role {
+    /// Wait (bounded) until the role prints its listen line or exits.
+    fn outcome(&mut self) -> Outcome {
+        let deadline = Instant::now() + WAIT;
+        loop {
+            let left = deadline.saturating_duration_since(Instant::now());
+            assert!(
+                !left.is_zero(),
+                "wyrd s3 neither served nor exited within {WAIT:?}; stderr: {:?}",
+                self.seen
+            );
+            match self
+                .stderr
+                .recv_timeout(left.min(Duration::from_millis(100)))
+            {
+                Ok(line) => {
+                    if let Some(rest) = line.strip_prefix(SERVING) {
+                        let addr = rest
+                            .split_whitespace()
+                            .next()
+                            .expect("address after the listen line")
+                            .parse()
+                            .expect("listen line carries a socket address");
+                        self.seen.push(line);
+                        return Outcome::Serving(addr);
+                    }
+                    self.seen.push(line);
+                }
+                Err(RecvTimeoutError::Timeout) => {}
+                // stderr closed: the child is exiting; reap it below.
+                Err(RecvTimeoutError::Disconnected) => {
+                    let status = self.wait_exit(deadline);
+                    return Outcome::Exited(status);
+                }
+            }
+            if let Some(status) = self.child.try_wait().expect("poll child") {
+                // Collect what it printed before exiting.
+                while let Ok(line) = self.stderr.recv_timeout(Duration::from_millis(200)) {
+                    self.seen.push(line);
+                }
+                return Outcome::Exited(status);
+            }
+        }
+    }
+
+    fn wait_exit(&mut self, deadline: Instant) -> ExitStatus {
+        loop {
+            if let Some(status) = self.child.try_wait().expect("poll child") {
+                return status;
+            }
+            assert!(
+                Instant::now() < deadline,
+                "wyrd s3 closed stderr but did not exit"
+            );
+            std::thread::sleep(Duration::from_millis(20));
+        }
+    }
+
+    fn serving(&mut self) -> SocketAddr {
+        match self.outcome() {
+            Outcome::Serving(addr) => addr,
+            Outcome::Exited(status) => panic!(
+                "wyrd s3 exited ({status}) instead of serving; stderr: {:?}",
+                self.seen
+            ),
+        }
+    }
+}
