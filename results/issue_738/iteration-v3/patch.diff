+/// Resolve the `wyrd s3` role's `--chunk-size`: absent selects the single shared
+/// [`DEFAULT_CHUNK_SIZE`]; a present value must be a plain decimal integer (digits only)
+/// in `1..=`[`MAX_CHUNK_SIZE`]. Anything else is REFUSED with the flag named, rather than
+/// handed to [`Gateway::with_chunk_size`], whose `.max(1)` floor would silently turn `0`
+/// into a one-byte chunk size (#738). Parsed as `cmd_put` parses its own `--chunk-size`,
+/// plus the sign and zero/ceiling refusals.
+fn parse_s3_chunk_size(raw: Option<&str>) -> Result<usize, String> {
+    let Some(s) = raw else {
+        return Ok(DEFAULT_CHUNK_SIZE);
+    };
+    // Digits only: `usize::from_str` alone would also accept a leading `+`.
+    let chunk_size: usize = match s.parse() {
+        Ok(n) if s.bytes().all(|b| b.is_ascii_digit()) => n,
+        _ => return Err(format!("s3: invalid --chunk-size `{s}`")),
+    };
+    if chunk_size == 0 || chunk_size > MAX_CHUNK_SIZE {
+        return Err(format!(
+            "s3: --chunk-size `{s}` is out of range; it must be 1..={MAX_CHUNK_SIZE} bytes"
+        ));
+    }
+    Ok(chunk_size)
+}
