+/// Issue #738 — one fragment travels as one message, so a fragment past tonic's 4 MiB
+/// default message size must still cross the wire in BOTH directions: the D server
+/// decodes it on put (`ChunkStoreService::into_server`) and the client decodes it on get
+/// (`GrpcChunkStore::new`). 6 MiB is one RS(6,3) fragment of a 36 MiB chunk, well inside
+/// the `wyrd s3 --chunk-size` range; with either side left at the default this fails with
+/// `OUT_OF_RANGE` ("decoded message length too large").
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn a_fragment_past_the_4_mib_grpc_default_round_trips() {
+    let (client, _dir, server) = connected().await;
+
+    let id = fid(0x738_0000_0000_0000_0000_0000_0000_0001, 4);
+    let payload: Vec<u8> = (0..(6u32 << 20)).map(|i| (i % 251) as u8).collect();
+    let frag = fragment(id, &payload);
+    assert!(
+        frag.len() > 4 << 20,
+        "the fragment must exceed tonic's 4 MiB default"
+    );
+
+    bounded(
+        "a put of a 6 MiB fragment",
+        client.put_fragment(id, frag.clone(), None),
+    )
+    .await
+    .expect("the D server must accept a fragment past the 4 MiB default");
+    let got = bounded("its read-back", client.get_fragment(id))
+        .await
+        .expect("the client must decode a fragment past the 4 MiB default")
+        .expect("the fragment was stored");
+    assert!(
+        got == frag,
+        "the fragment must round-trip byte-identical: got {} bytes, sent {}",
+        got.len(),
+        frag.len()
+    );
+
+    server.abort();
+}
