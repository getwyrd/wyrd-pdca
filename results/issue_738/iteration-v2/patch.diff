+fn spawn_role(data_dir: &Path, chunk_size: Option<&str>, endpoints: Option<&str>) -> Role {
+    let mut args = vec![
+        "s3".to_string(),
+        "--s3-listen".to_string(),
+        "127.0.0.1:0".to_string(),
+        "--data-dir".to_string(),
+        data_dir.to_str().expect("utf-8 path").to_string(),
+        "--region".to_string(),
+        REGION.to_string(),
+        "--access-key".to_string(),
+        ACCESS_KEY.to_string(),
+        "--secret-key".to_string(),
+        SECRET_KEY.to_string(),
+        // Pinned, not inherited: the role honours `WYRD_METADATA_BACKEND` /
+        // `WYRD_COORDINATION_BACKEND` when these are absent.
+        "--metadata-backend".to_string(),
+        "redb".to_string(),
+        "--coordination-backend".to_string(),
+        "mem".to_string(),
+    ];
+    if let Some(value) = chunk_size {
+        args.push("--chunk-size".to_string());
+        args.push(value.to_string());
+    }
+    if let Some(list) = endpoints {
+        args.push("--endpoints".to_string());
+        args.push(list.to_string());
+    }
+    let mut child = Command::new(WYRD)
+        .args(&args)
+        .stdin(Stdio::null())
+        .stdout(Stdio::null())
+        .stderr(Stdio::piped())
+        .spawn()
+        .expect("spawn the wyrd binary");
+    let pipe = child.stderr.take().expect("piped stderr");
+    let (tx, rx) = mpsc::channel();
+    // Drain stderr for the child's whole life so it never blocks on a full pipe.
+    std::thread::spawn(move || {
+        for line in BufReader::new(pipe).lines() {
+            let Ok(line) = line else { break };
+            if tx.send(line).is_err() {
+                break;
+            }
+        }
+    });
+    Role {
+        child,
+        stderr: rx,
+        seen: Vec::new(),
+    }
+}
+
+impl Role {
+    /// Wait (bounded) until the role prints its listen line or exits.
+    fn outcome(&mut self) -> Outcome {
+        let deadline = Instant::now() + WAIT;
+        loop {
+            let left = deadline.saturating_duration_since(Instant::now());
+            assert!(
+                !left.is_zero(),
+                "wyrd s3 neither served nor exited within {WAIT:?}; stderr: {:?}",
+                self.seen
+            );
+            match self
+                .stderr
+                .recv_timeout(left.min(Duration::from_millis(100)))
+            {
+                Ok(line) => {
+                    if let Some(rest) = line.strip_prefix(SERVING) {
+                        let addr = rest
+                            .split_whitespace()
+                            .next()
+                            .expect("address after the listen line")
+                            .parse()
+                            .expect("listen line carries a socket address");
+                        self.seen.push(line);
+                        return Outcome::Serving(addr);
+                    }
+                    self.seen.push(line);
+                }
+                Err(RecvTimeoutError::Timeout) => {}
+                // stderr closed: the child is exiting; reap it below.
+                Err(RecvTimeoutError::Disconnected) => {
+                    let status = self.wait_exit(deadline);
+                    return Outcome::Exited(status);
+                }
+            }
+            if let Some(status) = self.child.try_wait().expect("poll child") {
+                // Collect what it printed before exiting.
+                while let Ok(line) = self.stderr.recv_timeout(Duration::from_millis(200)) {
+                    self.seen.push(line);
+                }
+                return Outcome::Exited(status);
+            }
+        }
+    }
+
+    fn wait_exit(&mut self, deadline: Instant) -> ExitStatus {
+        loop {
+            if let Some(status) = self.child.try_wait().expect("poll child") {
+                return status;
+            }
+            assert!(
+                Instant::now() < deadline,
+                "wyrd s3 closed stderr but did not exit"
+            );
+            std::thread::sleep(Duration::from_millis(20));
+        }
+    }
+
+    fn serving(&mut self) -> SocketAddr {
+        match self.outcome() {
+            Outcome::Serving(addr) => addr,
+            Outcome::Exited(status) => panic!(
+                "wyrd s3 exited ({status}) instead of serving; stderr: {:?}",
+                self.seen
+            ),
+        }
+    }
+}
+
+/// A production D server — `DServer::serve`, the gRPC `ChunkStore` host the `d-server`
+/// role runs — over a local `FsChunkStore`, on an ephemeral loopback port inside this test
+/// process. Dropping it signals shutdown and bounds the runtime's teardown.
+struct DServerHost {
+    runtime: Option<tokio::runtime::Runtime>,
+    stop: Option<tokio::sync::oneshot::Sender<()>>,
+    endpoint: String,
+}
+
+impl DServerHost {
+    fn start(root: &Path) -> Self {
+        let runtime = tokio::runtime::Builder::new_multi_thread()
+            .enable_all()
+            .build()
+            .expect("tokio runtime");
+        let (stop, stopped) = tokio::sync::oneshot::channel::<()>();
+        let endpoint = runtime.block_on(async {
+            let store = FsChunkStore::open(root).expect("open the D server's chunk store");
+            let server = DServer::bind(store, "127.0.0.1:0".parse().expect("loopback"))
+                .await
+                .expect("bind the D server");
+            let endpoint = server.endpoint().to_string();
+            let coord = Arc::new(MemCoordination::new());
+            let lease = server
+                .register(&*coord, DSERVER_GROUP, Duration::from_secs(3600))
+                .await
+                .expect("register the D server");
+            tokio::spawn(
+                server.serve(coord, lease, Duration::from_secs(3600), async move {
+                    let _ = stopped.await;
+                }),
+            );
+            endpoint
+        });
+        Self {
+            runtime: Some(runtime),
+            stop: Some(stop),
+            endpoint,
+        }
+    }
+}
+
+impl Drop for DServerHost {
+    fn drop(&mut self) {
+        if let Some(stop) = self.stop.take() {
+            let _ = stop.send(());
+        }
+        if let Some(runtime) = self.runtime.take() {
+            runtime.shutdown_timeout(Duration::from_secs(10));
+        }
+    }
+}
+
+/// One SigV4-signed request over a fresh loopback connection; returns `(status, body)`.
+fn signed_request(addr: SocketAddr, method: &str, path: &str, body: &[u8]) -> (u16, Vec<u8>) {
+    let host = addr.to_string();
+    let creds = Credentials {
+        access_key_id: ACCESS_KEY.to_string(),
+        secret_access_key: SECRET_KEY.to_string(),
+    };
+    // wall-clock exempt (test): the SigV4 request date must sit inside the live role's
+    // freshness window, which that role judges against its own wall clock.
+    #[allow(clippy::disallowed_methods)]
+    let amz_date = format_amz_date(std::time::SystemTime::now());
+    let signed = sign(
+        method, path, "", &host, &amz_date, body, &creds, REGION, "s3",
+    );
+    let head = format!(
+        "{method} {path} HTTP/1.1\r\nhost: {host}\r\nauthorization: {}\r\nx-amz-date: {}\r\n\
+         x-amz-content-sha256: {}\r\ncontent-length: {}\r\nconnection: close\r\n\r\n",
+        signed.authorization,
+        signed.amz_date,
+        signed.content_sha256,
+        body.len()
+    );
+    let mut stream = TcpStream::connect_timeout(&addr, WAIT).expect("connect");
+    stream.set_read_timeout(Some(WAIT)).expect("read timeout");
+    stream.set_write_timeout(Some(WAIT)).expect("write timeout");
+    stream.write_all(head.as_bytes()).expect("write head");
+    stream.write_all(body).expect("write body");
+    stream.flush().expect("flush");
+    let mut raw = Vec::new();
+    stream.read_to_end(&mut raw).expect("read response");
+    let split = raw
+        .windows(4)
+        .position(|w| w == b"\r\n\r\n")
+        .unwrap_or_else(|| panic!("no header terminator: {:?}", String::from_utf8_lossy(&raw)));
+    let head = String::from_utf8_lossy(&raw[..split]).to_ascii_lowercase();
+    let status = head
+        .split_whitespace()
+        .nth(1)
+        .and_then(|code| code.parse().ok())
+        .unwrap_or_else(|| panic!("malformed HTTP response: {head:?}"));
+    // A streaming GET declares `Content-Length`, so with `connection: close` its body is the
+    // bytes up to EOF; an error document may arrive chunked and is de-framed.
+    let body = &raw[split + 4..];
+    let body = if head.contains("transfer-encoding: chunked") {
+        dechunk(body)
+    } else {
+        body.to_vec()
+    };
+    (status, body)
+}
+
+/// De-frame an HTTP/1.1 chunked body (`<hex-size>\r\n<bytes>\r\n … 0\r\n\r\n`).
+fn dechunk(mut raw: &[u8]) -> Vec<u8> {
+    let mut out = Vec::new();
+    loop {
+        let eol = raw
+            .windows(2)
+            .position(|w| w == b"\r\n")
+            .expect("chunk-size line");
+        let field = String::from_utf8_lossy(&raw[..eol]);
+        let size = usize::from_str_radix(field.split(';').next().unwrap_or("").trim(), 16)
+            .expect("hex chunk size");
+        raw = &raw[eol + 2..];
+        if size == 0 {
+            return out;
+        }
+        out.extend_from_slice(raw.get(..size).expect("whole chunk"));
+        raw = raw.get(size + 2..).expect("chunk CRLF");
+    }
+}
+
+/// The number of chunks an `FsChunkStore` rooted at `root` holds: directories named by a
+/// 32-hex chunk id, each holding at least one `<index>.frag`.
+fn chunk_count(root: &Path) -> usize {
+    std::fs::read_dir(root)
+        .expect("chunk store root exists")
+        .map(|e| e.expect("dir entry"))
+        .filter(|e| {
+            let name = e.file_name();
+            let name = name.to_string_lossy();
+            e.path().is_dir() && name.len() == 32 && name.chars().all(|c| c.is_ascii_hexdigit())
+        })
+        .inspect(|e| {
+            let frags = std::fs::read_dir(e.path())
+                .expect("chunk dir")
+                .filter(|f| {
+                    f.as_ref()
+                        .expect("fragment entry")
+                        .file_name()
+                        .to_string_lossy()
+                        .ends_with(".frag")
+                })
+                .count();
+            assert!(frags > 0, "chunk dir {:?} holds no fragments", e.path());
+        })
+        .count()
+}
+
+/// A deterministic, non-repeating-per-chunk payload of `len` bytes.
+fn object(len: usize) -> Vec<u8> {
+    (0..len).map(|i| (i % 251) as u8).collect()
+}
+
+/// PUT one `4N`-byte object through a single-node role started with `chunk_size`; return
+/// the chunk count under `<data-dir>/chunks`.
+fn chunks_for_one_put(chunk_size: Option<&str>) -> usize {
+    let work = tempfile::tempdir().expect("temp dir");
+    let mut role = spawn_role(work.path(), chunk_size, None);
+    let addr = role.serving();
+    let (status, body) = signed_request(
+        addr,
+        "PUT",
+        "/wyrd-bucket/chunk-size-object",
+        &object(4 * N),
+    );
+    assert_eq!(
+        status,
+        200,
+        "signed PUT through the role: {}; stderr: {:?}",
+        String::from_utf8_lossy(&body),
+        role.seen
+    );
+    let count = chunk_count(&work.path().join("chunks"));
+    drop(role);
+    count
+}
+
+#[test]
+fn chunk_size_flag_sets_the_on_disk_chunk_count_and_absence_keeps_the_default() {
+    let with_flag = chunks_for_one_put(Some(&N.to_string()));
+    assert_eq!(
+        with_flag,
+        4,
+        "`--chunk-size {N}` must split a {}-byte object into 4 chunks",
+        4 * N
+    );
+
+    let default = chunks_for_one_put(None);
+    assert_eq!(
+        default,
+        (4 * N).div_ceil(ONE_MIB),
+        "no `--chunk-size` must chunk at the 1 MiB default, unchanged from today"
+    );
+}
+
+/// Assert `value` is refused: the role exits non-zero, names the flag, and never serves.
+fn assert_refused(value: &str) {
+    let work = tempfile::tempdir().expect("temp dir");
+    let mut role = spawn_role(work.path(), Some(value), None);
+    match role.outcome() {
+        Outcome::Serving(addr) => panic!(
+            "`--chunk-size {value}` must be refused before binding, but the role serves on \
+             {addr}; stderr: {:?}",
+            role.seen
+        ),
+        Outcome::Exited(status) => {
+            assert!(
+                !status.success(),
+                "`--chunk-size {value}` must exit non-zero"
+            );
+            assert!(
+                role.seen.iter().any(|l| l.contains("--chunk-size")),
+                "`--chunk-size {value}` refusal must name the flag; stderr: {:?}",
+                role.seen
+            );
+        }
+    }
+}
+
+/// Assert `value` is accepted: the role starts and prints its listen line. Never PUTs, so
+/// no chunk-sized buffer is ever allocated.
+fn assert_accepted(value: &str) {
+    let work = tempfile::tempdir().expect("temp dir");
+    let mut role = spawn_role(work.path(), Some(value), None);
+    role.serving();
+}
+
+#[test]
+fn chunk_size_zero_is_refused_and_one_is_accepted() {
+    assert_refused("0");
+    assert_accepted("1");
+}
+
+#[test]
+fn chunk_size_ceiling_is_one_gib_inclusive() {
+    assert_accepted("1073741824");
+    assert_refused("1073741825");
+}
+
+/// The operator-facing usage text lists the flag on the `wyrd s3` line (`wyrd` with no
+/// command prints it and exits 2).
+#[test]
+fn s3_usage_line_lists_chunk_size() {
+    let out = Command::new(WYRD)
+        .stdin(Stdio::null())
+        .output()
+        .expect("run the wyrd binary");
+    assert_eq!(
+        out.status.code(),
+        Some(2),
+        "bare `wyrd` prints usage, exit 2"
+    );
+    let usage = String::from_utf8_lossy(&out.stderr);
+    let s3 = usage
+        .lines()
+        .find(|l| l.trim_start().starts_with("wyrd s3 "))
+        .unwrap_or_else(|| panic!("usage has a `wyrd s3` line: {usage}"));
+    assert!(
+        s3.contains("[--chunk-size N]"),
+        "the `wyrd s3` usage line must list `[--chunk-size N]`: {s3}"
+    );
+}
+
+/// Not a plain decimal integer: a unit suffix, and a leading `+` that `usize::from_str`
+/// alone would accept.
+#[test]
+fn chunk_size_non_numeric_and_signed_values_are_refused() {
+    assert_refused("1MiB");
+    assert_refused("+1");
+}
+
+/// The cluster composition carries an accepted chunk size whose fragments exceed tonic's
+/// 4 MiB default message limit: the PUT lands as ONE chunk on the D server (the flag is
+/// honoured over `--endpoints` too) and the GET reassembles it byte-identical (the gateway's
+/// client decodes the large fragments the D server returns).
+#[test]
+fn a_chunk_past_the_4_mib_grpc_default_round_trips_through_a_d_server() {
+    let dserver_root = tempfile::tempdir().expect("D server temp dir");
+    let dserver = DServerHost::start(dserver_root.path());
+    let work = tempfile::tempdir().expect("gateway temp dir");
+    let mut role = spawn_role(
+        work.path(),
+        Some(&BIG_CHUNK.to_string()),
+        Some(&dserver.endpoint),
+    );
+    let addr = role.serving();
+    let path = "/wyrd-bucket/big-chunk-object";
+    let payload = object(BIG_CHUNK);
+
+    let (status, body) = signed_request(addr, "PUT", path, &payload);
+    assert_eq!(
+        status,
+        200,
+        "PUT of one {BIG_CHUNK}-byte chunk over gRPC: {}; stderr: {:?}",
+        String::from_utf8_lossy(&body),
+        role.seen
+    );
+    assert_eq!(
+        chunk_count(dserver_root.path()),
+        1,
+        "`--chunk-size {BIG_CHUNK}` must store a {BIG_CHUNK}-byte object as ONE chunk on the \
+         D server"
+    );
+
+    let (status, got) = signed_request(addr, "GET", path, &[]);
+    assert_eq!(
+        status,
+        200,
+        "GET of the {BIG_CHUNK}-byte chunk over gRPC: {}; stderr: {:?}",
+        String::from_utf8_lossy(&got[..got.len().min(512)]),
+        role.seen
+    );
+    assert!(
+        got == payload,
+        "GET returned {} bytes that differ from the {} bytes PUT",
+        got.len(),
+        payload.len()
+    );
+    drop(role);
+    drop(dserver);
+}
