+use wyrd_server::dserver::{DServer, DSERVER_GROUP};
+
+const WYRD: &str = env!("CARGO_BIN_EXE_wyrd");
+const ACCESS_KEY: &str = "AKIAIOSFODNN7EXAMPLE";
+const SECRET_KEY: &str = "wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY";
