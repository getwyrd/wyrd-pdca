+    let start = match page_start(ORPHAN_PREFIX, cursor) {
+        PageStart::Prefix => SpanStart::Prefix,
+        PageStart::After(after) => SpanStart::After(after.to_vec()),
+        PageStart::PastPrefix => SpanStart::PastPrefix,
+    };
