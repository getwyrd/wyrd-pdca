+// ---- property 12: the orphan-ledger walk loses every race to a concurrent refresh (#661) ----
+//
+// GC reads the `orphan:` ledger one window at a time and deletes marks two ways: after it
+// reclaims the bytes a mark covered, and as a sweep of a mark whose position holds no fragment
+// once it is past the late-write deadline (proposal 0016, `0016:1359-1404`). Both deletes act on
+// a value GC read earlier in the pass, and a mark can be written again in between — a new
+// orphaning of the same position. Deleting that newer mark would erase evidence GC never
+// judged, so each delete must require the exact value that was judged.
+//
+// Here the refresh is a genuinely concurrent task whose landing point comes from the run seed,
+// the store is the simulated-TiKV model (every read and commit a network hop), and its page cap
+// is lowered so the walk reads its window over several pages — the base's single `scan` of the
+// same ledger would fail. The assertions hold on every schedule; the coverage leg proves the
+// schedule that can break them — a refresh landing between GC's read of a mark and its delete —
+// is actually reached.
+
+/// Fragment-less marks on server 1, exactly `D` old: swept.
+const WALK_SWEEP: [ChunkId; 3] = [0x6610, 0x6611, 0x6612];
+/// Unreferenced fragments on server 2 under marks exactly as old as the grace: reclaimed.
+const WALK_RECLAIM: [ChunkId; 3] = [0x6620, 0x6621, 0x6622];
+/// A fragment-less mark on server 1, one millisecond younger than `D`: kept.
+const WALK_YOUNG: ChunkId = 0x6630;
+/// A referenced fragment on server 0 under a long-lapsed mark: kept.
+const WALK_HELD: ChunkId = 0x6640;
+/// A fragment on server 3 whose chunk's pending lease has EXPIRED but whose mark is still in its
+/// grace: kept — a mark outranks a lease.
+const WALK_GUARDED: ChunkId = 0x6650;
+/// The inode that references [`WALK_HELD`].
+const WALK_HELD_INODE: InodeId = 3;
+/// How far past the pass's start the refresh's landing point is drawn from, in simulated ms. One
+/// `network_hop` is 1 ms; a pass over this ledger at the smallest page cap takes about 25 hops,
+/// so the span covers "before the pass reads the ledger", "between its read and its delete", and
+/// "after the whole pass" — and the coverage leg proves the middle one is reached.
+const WALK_NEMESIS_SPAN: u32 = 32;
+
+/// A tap over the simulated-TiKV store: every call forwarded unchanged (network hops included),
+/// and each guarded ledger delete — a commit deleting an `orphan:` key under a precondition —
+/// that LOST recorded, so the coverage leg can tell a run where the refresh raced the delete from
+/// one where it did not. Instance state only (ADR-0035).
+struct WalkTap {
+    inner: SimTikvMetadataStore,
+    lost_deletes: Mutex<usize>,
+}
+
+#[async_trait]
+impl MetadataStore for WalkTap {
+    async fn get(&self, key: &[u8]) -> Result<Option<Bytes>> {
+        self.inner.get(key).await
+    }
+
+    async fn scan(&self, prefix: &[u8]) -> Result<Vec<(Vec<u8>, Bytes)>> {
+        self.inner.scan(prefix).await
+    }
+
+    async fn scan_page(
+        &self,
+        prefix: &[u8],
+        after: Option<&[u8]>,
+        limit: usize,
+    ) -> Result<wyrd_traits::ScanPage> {
+        self.inner.scan_page(prefix, after, limit).await
+    }
+
+    async fn commit(&self, batch: WriteBatch) -> Result<CommitOutcome> {
+        let guarded_ledger_delete = !batch.preconditions.is_empty()
+            && batch
+                .deletes
+                .iter()
+                .any(|key| key.starts_with(metadata::ORPHAN_PREFIX));
+        let outcome = self.inner.commit(batch).await?;
+        if guarded_ledger_delete && outcome == CommitOutcome::Conflict {
+            *self.lost_deletes.lock().unwrap() += 1;
+        }
+        Ok(outcome)
+    }
+}
+
+/// One GC pass over a small paged ledger while a concurrent task re-stamps one sweep target and
+/// one reclaim target, landing `delay_millis` into the pass; the store's page cap is `page_cap`.
+/// Asserts the invariant set over what the store holds afterwards, and returns whether a guarded
+/// delete lost a race in this run.
+async fn gc_walk_under_a_concurrent_refresh(delay_millis: u64, page_cap: usize) -> bool {
+    let d = servers();
+    let meta = Arc::new(WalkTap {
+        inner: SimTikvMetadataStore::new().with_scan_cap(page_cap),
+        lost_deletes: Mutex::new(0),
+    });
+    let now: u64 = 1_000_000;
+    // The grace exceeds the late-write deadline, as the deployment requires (`G_orphan > D`).
+    let grace = 3 * LATE_WRITE_DEADLINE_MILLIS;
+    let swept_at = now - LATE_WRITE_DEADLINE_MILLIS;
+    let reclaimed_at = now - grace;
+
+    for chunk in WALK_SWEEP {
+        mark_orphaned(&*meta, 1, frag_of(chunk), swept_at)
+            .await
+            .unwrap();
+    }
+    mark_orphaned(&*meta, 1, frag_of(WALK_YOUNG), swept_at + 1)
+        .await
+        .unwrap();
+    for chunk in WALK_RECLAIM {
+        d[2].put_fragment(frag_of(chunk), Bytes::from_static(b"old"), None)
+            .await
+            .unwrap();
+        mark_orphaned(&*meta, 2, frag_of(chunk), reclaimed_at)
+            .await
+            .unwrap();
+    }
+    d[0].put_fragment(frag_of(WALK_HELD), Bytes::from_static(b"held"), None)
+        .await
+        .unwrap();
+    assert_eq!(
+        metadata::create(
+            &*meta,
+            ROOT,
+            "walk-held",
+            WALK_HELD_INODE,
+            &flat_committed(WALK_HELD, 0)
+        )
+        .await
+        .unwrap(),
+        CommitOutcome::Committed
+    );
+    mark_orphaned(&*meta, 0, frag_of(WALK_HELD), 0)
+        .await
+        .unwrap();
+    d[3].put_fragment(frag_of(WALK_GUARDED), Bytes::from_static(b"guarded"), None)
+        .await
+        .unwrap();
+    metadata::put_pending(
+        &*meta,
+        WALK_GUARDED,
+        &PendingEntry {
+            lease_expiry_millis: now - 1,
+            owner: None,
+            staged: None,
+        },
+    )
+    .await
+    .unwrap();
+    mark_orphaned(&*meta, 3, frag_of(WALK_GUARDED), now)
+        .await
+        .unwrap();
+
+    // The concurrent writer: a new orphaning of two positions GC is about to delete marks at.
+    let refreshed = [(1, frag_of(WALK_SWEEP[0])), (2, frag_of(WALK_RECLAIM[0]))];
+    let fresh = now.to_string().into_bytes();
+    let writer = madsim::task::spawn({
+        let meta = Arc::clone(&meta);
+        let fresh = fresh.clone();
+        async move {
+            madsim::time::sleep(Duration::from_millis(delay_millis)).await;
+            for (dserver, frag) in refreshed {
+                let key = metadata::orphan_key(dserver, frag);
+                // A blind re-stamp. The simulated store reports a blind batch that lost a lock
+                // race as `Err`, never as a silent `Conflict`, so retry until it lands: this run
+                // is about what GC does to a refresh that DID land.
+                loop {
+                    match meta
+                        .commit(WriteBatch::new().put(key.clone(), fresh.clone()))
+                        .await
+                    {
+                        Ok(CommitOutcome::Committed) => break,
+                        Ok(CommitOutcome::Conflict) => {
+                            unreachable!("a batch with no precondition never conflicts")
+                        }
+                        Err(_) => madsim::time::sleep(Duration::from_millis(1)).await,
+                    }
+                }
+            }
+        }
+    });
+
+    let coord = MemCoordination::new();
+    let (zone, custodian) = elect(&coord, "zone-gc-walk").await;
+    let fleet: [(DServerId, &dyn ChunkStore); 4] = [(0, &d[0]), (1, &d[1]), (2, &d[2]), (3, &d[3])];
+    let ctx = GcContext {
+        meta: &*meta,
+        fleet: &fleet,
+        grace_window_millis: grace,
+        expired_pending: ExpiredPendingPolicy::Reclaim,
+    };
+    reconcile_step(&zone, &custodian, Some(&ctx), None, None, None, now)
+        .await
+        .unwrap_or_else(|err| {
+            panic!("the walk over a paged ledger must not fail (cap {page_cap}): {err}")
+        });
+    writer
+        .await
+        .expect("the concurrent writer ran to completion");
+
+    let schedule = format!("refresh landing at {delay_millis} ms, page cap {page_cap}");
+    let mark = |dserver: DServerId, chunk: ChunkId| {
+        let meta = Arc::clone(&meta);
+        async move {
+            meta.get(&metadata::orphan_key(dserver, frag_of(chunk)))
+                .await
+                .unwrap()
+        }
+    };
+
+    // (1) A REFRESHED MARK IS NEVER DELETED BY A PASS THAT JUDGED ITS OLDER VALUE. Whatever the
+    //     schedule — refreshed before the walk read it (then young / in grace, and kept), between
+    //     the read and the delete (the delete required the old value, and lost), or after the
+    //     delete (the refresh wrote it anew) — the writer's stamp is what the ledger holds.
+    for (dserver, frag) in refreshed {
+        assert_eq!(
+            mark(dserver, frag.chunk).await.as_deref(),
+            Some(fresh.as_slice()),
+            "the refreshed mark at ({dserver}, {frag:?}) was deleted or overwritten — GC erased \
+             evidence it never judged ({schedule})"
+        );
+    }
+
+    // (2) What must survive every schedule: a referenced fragment, a fragment-less mark younger
+    //     than D, and a fragment whose in-grace mark outranks its chunk's expired lease.
+    assert!(
+        d[0].get_fragment(frag_of(WALK_HELD))
+            .await
+            .unwrap()
+            .is_some()
+            && mark(0, WALK_HELD).await.is_some(),
+        "a referenced fragment, and the mark at its listed position, are never removed \
+         ({schedule})"
+    );
+    assert_eq!(
+        mark(1, WALK_YOUNG).await.as_deref(),
+        Some((swept_at + 1).to_string().as_bytes()),
+        "a fragment-less mark younger than the late-write deadline is kept ({schedule})"
+    );
+    assert!(
+        d[3].get_fragment(frag_of(WALK_GUARDED))
+            .await
+            .unwrap()
+            .is_some(),
+        "an in-grace mark outranks an expired pending lease ({schedule})"
+    );
+
+    // (3) POSITIVE OBSERVABLE — the targets no one refreshed were swept and reclaimed. Without
+    //     it every "kept" above would pass on a pass that did nothing.
+    for &chunk in &WALK_SWEEP[1..] {
+        assert!(
+            mark(1, chunk).await.is_none(),
+            "fragment-less mark {chunk:#x}, exactly D old and listed empty by this pass, was not \
+             swept ({schedule})"
+        );
+    }
+    for &chunk in &WALK_RECLAIM[1..] {
+        assert!(
+            d[2].get_fragment(frag_of(chunk)).await.unwrap().is_none()
+                && mark(2, chunk).await.is_none(),
+            "fragment {chunk:#x}, past its grace, was not reclaimed and its mark retired \
+             ({schedule})"
+        );
+    }
+
+    let lost = *meta.lost_deletes.lock().unwrap() > 0;
+    lost
+}
+
+/// The campaign leg: the seed picks where the refresh lands and how small the store's pages are.
+async fn prop_gc_walk_loses_every_race_to_a_refresh(rng: &mut ChaCha8Rng) {
+    let delay = u64::from(rng.next_u32() % (WALK_NEMESIS_SPAN + 1));
+    let page_cap = 1 + (rng.next_u32() % 4) as usize;
+    gc_walk_under_a_concurrent_refresh(delay, page_cap).await;
+}
+
+/// **The race this property exists for is genuinely REACHED.** Walks the refresh's whole landing
+/// span at the smallest and a larger page cap — asserting the invariant set at every point — and
+/// then asserts that some landing point made a guarded delete LOSE (the refresh fell between the
+/// walk's read of a mark and its delete) and some did not (it landed before the read or after
+/// the pass).
+async fn prop_gc_walk_reaches_the_race() {
+    let mut raced = Vec::new();
+    let mut clear = Vec::new();
+    for page_cap in [1, 3] {
+        for delay in 0..=u64::from(WALK_NEMESIS_SPAN) {
+            if gc_walk_under_a_concurrent_refresh(delay, page_cap).await {
+                raced.push((page_cap, delay));
+            } else {
+                clear.push((page_cap, delay));
+            }
+        }
+    }
+    assert!(
+        !raced.is_empty(),
+        "no landing point in 0..={WALK_NEMESIS_SPAN} ms fell between the walk's read of a mark \
+         and its delete, so the race the guarded delete exists for was never run"
+    );
+    assert!(
+        !clear.is_empty(),
+        "every landing point in 0..={WALK_NEMESIS_SPAN} ms raced the delete — the span no longer \
+         reaches past the pass, so the sweep is stuck in one regime"
+    );
+}
+
