+enum Mark {
+    /// The bare-decimal instant [`mark_orphaned`] writes, with the exact bytes it was read as —
+    /// what a delete of this mark requires the key to still hold.
+    Stamped {
+        /// When the position became orphaned, on the orphaning operation's clock.
+        at: u64,
+        /// The value's bytes, exactly as read.
+        raw: Vec<u8>,
+    },
+    /// A value that does not read as that instant. Never reclaimed on, never swept and never
+    /// rewritten: the richer value shapes are a later slice's (#662), and a mark this code
+    /// cannot read is not evidence it may act on in either direction.
+    Unreadable,
+}
