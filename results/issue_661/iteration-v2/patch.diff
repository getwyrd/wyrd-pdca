+//! Issue #661 — the `orphan:` ledger is readable at every size, and every mark has a deleter
+//! (proposal 0016, `docs/design/proposals/draft/0016-multipart-commit-protocol.md:1359-1404`).
+//!
+//! Two defects over one ledger. GC (`gc::reconcile`) and the post-restore pass
+//! (`restore::reconcile_after_restore`) each read `orphan:` with ONE `scan`, which fails whole
+//! past its cap — so a ledger past the cap takes both down on every run from then on, including
+//! the GC pass that is supposed to shrink it. And GC consumed a mark only while iterating a
+//! `list_fragments()` result, so a mark whose position holds no fragment was never deleted.
+//!
+//! # The double
+//!
+//! [`LedgerMeta`] is shaped like a real backend configured with a lowered cap
+//! (`crates/metadata-redb/tests/scan.rs`'s `with_scan_cap`): its `scan` refuses more than
+//! [`LOWERED_CAP`] results with the seam's own [`ScanCapExceeded`], and its `scan_page` is
+//! implemented directly over its ordered map with the seam's page helpers — never through
+//! `wyrd_testkit::test_double_scan_page`, which pages over `scan` and would inherit the cap.
+//! Its pages are bounded by the same cap a real backend's are, so one GC pass needs many
+//! pages to read its budget. It counts the `orphan:` entries each pass receives, records any
+//! `scan` over `orphan:`, logs every commit (how many `orphan:` writes it carried, and whether
+//! it landed), and can land a concurrent write just before the commit that would overwrite it.
+//!
+//! # The literals
+//!
+//! [`B`], [`D`] and [`BATCH`] are the values `gc.rs` derives, written out: this file must build
+//! against the tree with the production change reverted, where none of them exists, and a
+//! budget that silently shrank must fail here rather than pass against a copy of itself.
+
+#![forbid(unsafe_code)]
+
+use std::collections::{BTreeMap, HashMap};
+use std::ops::Bound;
+use std::sync::{Arc, Mutex};
+
+use async_trait::async_trait;
+use bytes::Bytes;
+use tracing::instrument::WithSubscriber;
+use tracing_subscriber::prelude::*;
+use wyrd_coordination_mem::MemCoordination;
+use wyrd_core::metadata::{self, orphan_key, PendingEntry, ORPHAN_PREFIX};
+use wyrd_custodian::{
+    reconcile_after_restore, reconcile_step, Custodian, ExpiredPendingPolicy, FencedZone,
+    GcContext, ReconcileError, Reconciled, RestoreReport,
+};
+use wyrd_traits::{
+    page_cursor, page_limit, page_start, ChunkId, ChunkStore, CommitOutcome, DServerId, FragmentId,
+    Health, MetadataStore, PageStart, Result, ScanCapExceeded, ScanPage, WriteBatch,
+};
+
+/// The per-pass budget `B` — `gc::ORPHAN_WALK_BUDGET`, `SCAN_CAP / 16`.
+const B: usize = 65_536;
+
+/// The late-write deadline `D` — `gc::LATE_WRITE_DEADLINE_MILLIS`: `W_repoint` 5 s + `W_write`
+/// 10 s + `δ_clock` 1 s.
+const D: u64 = 16_000;
+
+/// Writes per commit of the GC walk — `gc::LEDGER_WRITE_BATCH` — and per commit of restore's
+/// marks (`restore::MARK_BATCH`).
+const BATCH: usize = 1_000;
+
+/// The double's cap on one `scan` and on one `scan_page` page. Below `B`, so a pass reads its
+/// budget over many pages, and `B` is not a multiple of it, so the last page of a window is a
+/// short request.
+const LOWERED_CAP: usize = 1_000;
+
+/// The pass clock the tests run at, unless one says otherwise.
+const NOW: u64 = 10_000_000;
+
+/// A reader-safe grace window long enough that nothing stamped at [`NOW`] leaves it.
+const GRACE: u64 = 60_000;
+
+// ---- the metadata double ----------------------------------------------------------------------
+
+/// One commit the double saw.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+struct Commit {
+    /// Puts and deletes of `orphan:` keys it carried.
+    orphan_writes: usize,
+    /// Whether it landed.
+    outcome: CommitOutcome,
+}
+
+#[derive(Default)]
+struct Tap {
+    /// `orphan:` entries `scan_page` has returned since the last [`LedgerMeta::received`].
+    orphan_entries: usize,
+    /// `scan` calls whose result could include an `orphan:` key.
+    orphan_scans: usize,
+    /// Every commit, in order.
+    commits: Vec<Commit>,
+    /// A concurrent writer: just before the next commit that writes `key`, `key` is set to the
+    /// value. One-shot.
+    interpose: Option<(Vec<u8>, Bytes)>,
+    /// Whether that writer has landed.
+    interposed: bool,
+}
+
+/// See the module docs.
+#[derive(Default)]
+struct LedgerMeta {
+    kv: Mutex<BTreeMap<Vec<u8>, Bytes>>,
+    tap: Mutex<Tap>,
+}
+
+impl LedgerMeta {
+    /// Put `records` straight into the store, outside any commit the tests count.
+    fn seed(&self, records: impl IntoIterator<Item = (Vec<u8>, Vec<u8>)>) {
+        let mut kv = self.kv.lock().unwrap();
+        for (key, value) in records {
+            kv.insert(key, Bytes::from(value));
+        }
+    }
+
+    fn value(&self, key: &[u8]) -> Option<Bytes> {
+        self.kv.lock().unwrap().get(key).cloned()
+    }
+
+    /// How many `orphan:` records the store holds.
+    fn ledger_len(&self) -> usize {
+        self.kv
+            .lock()
+            .unwrap()
+            .keys()
+            .filter(|key| key.starts_with(ORPHAN_PREFIX))
+            .count()
+    }
+
+    /// The `orphan:` entries `scan_page` returned since the last call — one pass's read.
+    fn received(&self) -> usize {
+        std::mem::take(&mut self.tap.lock().unwrap().orphan_entries)
+    }
+
+    fn orphan_scans(&self) -> usize {
+        self.tap.lock().unwrap().orphan_scans
+    }
+
+    /// The commits since the last call.
+    fn commits(&self) -> Vec<Commit> {
+        std::mem::take(&mut self.tap.lock().unwrap().commits)
+    }
+
+    /// Land `value` under `key` just before the next commit that writes `key` — a concurrent
+    /// writer refreshing the record after the pass read it and before its write lands.
+    fn interpose(&self, key: Vec<u8>, value: &[u8]) {
+        self.tap.lock().unwrap().interpose = Some((key, Bytes::copy_from_slice(value)));
+    }
+
+    fn interposed(&self) -> bool {
+        self.tap.lock().unwrap().interposed
+    }
+}
+
+/// Whether a read under `prefix` could return an `orphan:` key.
+fn reaches_ledger(prefix: &[u8]) -> bool {
+    prefix.starts_with(ORPHAN_PREFIX) || ORPHAN_PREFIX.starts_with(prefix)
+}
+
+#[async_trait]
+impl MetadataStore for LedgerMeta {
+    async fn get(&self, key: &[u8]) -> Result<Option<Bytes>> {
+        Ok(self.value(key))
+    }
+
+    async fn scan(&self, prefix: &[u8]) -> Result<Vec<(Vec<u8>, Bytes)>> {
+        if reaches_ledger(prefix) {
+            self.tap.lock().unwrap().orphan_scans += 1;
+        }
+        let hits: Vec<(Vec<u8>, Bytes)> = self
+            .kv
+            .lock()
+            .unwrap()
+            .range(prefix.to_vec()..)
+            .take_while(|(key, _)| key.starts_with(prefix))
+            .map(|(key, value)| (key.clone(), value.clone()))
+            .collect();
+        // Complete or refused — never a truncated `Vec` (`MetadataStore` clause 5), with the
+        // seam's own error type, as a real backend past its cap answers.
+        if hits.len() > LOWERED_CAP {
+            return Err(Box::new(ScanCapExceeded {
+                cap: LOWERED_CAP,
+                prefix: prefix.to_vec(),
+            }));
+        }
+        Ok(hits)
+    }
+
+    async fn scan_page(
+        &self,
+        prefix: &[u8],
+        after: Option<&[u8]>,
+        limit: usize,
+    ) -> Result<ScanPage> {
+        // The seam's shared decisions, as every backend makes them: the page bound (clamped to
+        // this store's cap), where the page starts, and when it is terminal.
+        let limit = page_limit(limit, LOWERED_CAP, prefix)?;
+        let lower = match page_start(prefix, after) {
+            PageStart::Prefix => Bound::Included(prefix.to_vec()),
+            PageStart::After(cursor) => Bound::Excluded(cursor.to_vec()),
+            PageStart::PastPrefix => return Ok((Vec::new(), None)),
+        };
+        let items: Vec<(Vec<u8>, Bytes)> = self
+            .kv
+            .lock()
+            .unwrap()
+            .range((lower, Bound::Unbounded))
+            .take_while(|(key, _)| key.starts_with(prefix))
+            .take(limit)
+            .map(|(key, value)| (key.clone(), value.clone()))
+            .collect();
+        if reaches_ledger(prefix) {
+            self.tap.lock().unwrap().orphan_entries += items
+                .iter()
+                .filter(|(key, _)| key.starts_with(ORPHAN_PREFIX))
+                .count();
+        }
+        let next = page_cursor(&items, limit);
+        Ok((items, next))
+    }
+
+    async fn commit(&self, batch: WriteBatch) -> Result<CommitOutcome> {
+        let mut kv = self.kv.lock().unwrap();
+        let mut tap = self.tap.lock().unwrap();
+        let writes = |key: &Vec<u8>| {
+            batch.deletes.iter().any(|k| k == key) || batch.puts.iter().any(|(k, _)| k == key)
+        };
+        if tap.interpose.as_ref().is_some_and(|(key, _)| writes(key)) {
+            let (key, value) = tap.interpose.take().unwrap();
+            kv.insert(key, value);
+            tap.interposed = true;
+        }
+        let orphan_writes = batch
+            .deletes
+            .iter()
+            .filter(|key| key.starts_with(ORPHAN_PREFIX))
+            .count()
+            + batch
+                .puts
+                .iter()
+                .filter(|(key, _)| key.starts_with(ORPHAN_PREFIX))
+                .count();
+        let holds = batch
+            .preconditions
+            .iter()
+            .all(|pre| kv.get(&pre.key) == pre.expected.as_ref());
+        let outcome = if holds {
+            for key in batch.deletes {
+                kv.remove(&key);
+            }
+            for (key, value) in batch.puts {
+                kv.insert(key, value);
+            }
+            CommitOutcome::Committed
+        } else {
+            CommitOutcome::Conflict
+        };
+        tap.commits.push(Commit {
+            orphan_writes,
+            outcome,
+        });
+        Ok(outcome)
+    }
+}
+
+// ---- the D-server double ----------------------------------------------------------------------
+
+#[derive(Default)]
+struct MemDServer {
+    frags: Mutex<HashMap<FragmentId, Bytes>>,
+}
+
+impl MemDServer {
+    fn put(&self, frag: FragmentId) {
+        self.frags
+            .lock()
+            .unwrap()
+            .insert(frag, Bytes::from_static(b"bytes"));
+    }
+
+    fn holds(&self, frag: FragmentId) -> bool {
+        self.frags.lock().unwrap().contains_key(&frag)
+    }
+
+    fn count(&self) -> usize {
+        self.frags.lock().unwrap().len()
+    }
+}
+
+#[async_trait]
+impl ChunkStore for MemDServer {
+    async fn put_fragment(
+        &self,
+        id: FragmentId,
+        fragment: Bytes,
+        _deadline_millis: Option<u64>,
+    ) -> Result<()> {
+        self.frags.lock().unwrap().insert(id, fragment);
+        Ok(())
+    }
+
+    async fn get_fragment(&self, id: FragmentId) -> Result<Option<Bytes>> {
+        Ok(self.frags.lock().unwrap().get(&id).cloned())
+    }
+
+    async fn list_fragments(&self) -> Result<Vec<FragmentId>> {
+        Ok(self.frags.lock().unwrap().keys().copied().collect())
+    }
+
+    async fn delete_fragment(&self, id: FragmentId) -> Result<()> {
+        self.frags.lock().unwrap().remove(&id);
+        Ok(())
+    }
+
+    async fn health(&self) -> Result<Health> {
+        Ok(Health::Healthy)
+    }
+}
+
+// ---- helpers ----------------------------------------------------------------------------------
+
+fn frag(chunk: ChunkId) -> FragmentId {
+    FragmentId { chunk, index: 0 }
+}
+
+fn stamp(at: u64) -> Vec<u8> {
+    at.to_string().into_bytes()
+}
+
+/// `count` marks under `dserver`, chunk ids `first..first + count`, each stamped `at`, with the
+/// fragment itself on `store` when one is given.
+fn seed_marks(
+    meta: &LedgerMeta,
+    store: Option<&MemDServer>,
+    dserver: DServerId,
+    first: u64,
+    count: usize,
+    at: u64,
+) {
+    meta.seed((first..first + count as u64).map(|chunk| {
+        let frag = frag(ChunkId::from(chunk));
+        if let Some(store) = store {
+            store.put(frag);
+        }
+        (orphan_key(dserver, frag), stamp(at))
+    }));
+}
+
+/// A pending lease on `chunk` that expired just before [`NOW`].
+async fn expired_lease(meta: &LedgerMeta, chunk: ChunkId) {
+    metadata::put_pending(
+        meta,
+        chunk,
+        &PendingEntry {
+            lease_expiry_millis: NOW - 1,
+            owner: None,
+            staged: None,
+        },
+    )
+    .await
+    .unwrap();
+    meta.commits();
+}
+
+/// One GC pass through the real fenced control point, over a context built FRESH for the pass,
+/// exactly as the deployed loop builds one (`crates/server/src/custodian.rs:601-607`).
+async fn gc_pass(
+    meta: &LedgerMeta,
+    fleet: &[(DServerId, &dyn ChunkStore)],
+    grace_window_millis: u64,
+    expired_pending: ExpiredPendingPolicy,
+    now: u64,
+) -> std::result::Result<Reconciled, ReconcileError> {
+    // A permissive global default before any pass runs, so no audit callsite can latch
+    // `Interest::never` under the parallel harness and leave a later capture empty (#214, as
+    // `tests/gc.rs` guards it). Installing it again is a no-op.
+    let _ = tracing::subscriber::set_global_default(tracing_subscriber::registry());
+    let coord = MemCoordination::new();
+    let custodian = Custodian::elect(&coord, "zone-gc-ledger-walk")
+        .await
+        .unwrap();
+    let mut zone = FencedZone::new();
+    zone.install(custodian.leadership());
+    let ctx = GcContext {
+        meta,
+        fleet,
+        grace_window_millis,
+        expired_pending,
+    };
+    reconcile_step(&zone, &custodian, Some(&ctx), None, None, None, now).await
+}
+
+/// Collects what a `tracing` subscriber writes, so a test reads back the audit lines the pass
+/// actually emitted — the pattern `tests/gc.rs` uses.
+#[derive(Clone, Default)]
+struct Capture(Arc<Mutex<Vec<u8>>>);
+
+impl std::io::Write for Capture {
+    fn write(&mut self, buf: &[u8]) -> std::io::Result<usize> {
+        self.0.lock().unwrap().extend_from_slice(buf);
+        Ok(buf.len())
+    }
+
+    fn flush(&mut self) -> std::io::Result<()> {
+        Ok(())
+    }
+}
+
+impl<'w> tracing_subscriber::fmt::MakeWriter<'w> for Capture {
+    type Writer = Self;
+    fn make_writer(&'w self) -> Self::Writer {
+        self.clone()
+    }
+}
+
+/// [`gc_pass`], with the audit lines it emitted.
+async fn audited_gc_pass(
+    meta: &LedgerMeta,
+    fleet: &[(DServerId, &dyn ChunkStore)],
+    grace_window_millis: u64,
+    expired_pending: ExpiredPendingPolicy,
+    now: u64,
+) -> (std::result::Result<Reconciled, ReconcileError>, String) {
+    let audit = Capture::default();
+    let outcome = gc_pass(meta, fleet, grace_window_millis, expired_pending, now)
+        .with_subscriber(tracing::Dispatch::new(
+            tracing_subscriber::registry().with(
+                tracing_subscriber::fmt::layer()
+                    .json()
+                    .with_writer(audit.clone()),
+            ),
+        ))
+        .await;
+    let logged = String::from_utf8(audit.0.lock().unwrap().clone()).unwrap();
+    (outcome, logged)
+}
+
+/// The sizes of the commits that wrote `orphan:` keys, in order.
+fn ledger_commit_sizes(commits: &[Commit]) -> Vec<usize> {
+    commits
+        .iter()
+        .filter(|commit| commit.orphan_writes > 0)
+        .map(|commit| commit.orphan_writes)
+        .collect()
+}
+
+/// `writes` split into commits of at most [`BATCH`]: every one full but the last.
+fn batched(writes: usize) -> Vec<usize> {
+    let mut sizes = vec![BATCH; writes / BATCH];
+    if !writes.is_multiple_of(BATCH) {
+        sizes.push(writes % BATCH);
+    }
+    sizes
+}
+
+// ---- (A) GC survives a ledger past the cap ----------------------------------------------------
+
+/// **(A)** A ledger larger than the store's cap, every mark actionable (fragment present,
+/// unreferenced, past grace): the pass returns `Ok` and reclaims all of it. On the base it
+/// returns `Err(ReconcileError::Store)` — the `?` on `orphan_leases`'s single `scan`.
+#[tokio::test]
+async fn a_gc_pass_survives_an_orphan_ledger_past_the_cap() {
+    let meta = LedgerMeta::default();
+    let d0 = MemDServer::default();
+    let population = 3 * LOWERED_CAP + 7;
+    seed_marks(&meta, Some(&d0), 0, 0, population, 0);
+    let fleet: [(DServerId, &dyn ChunkStore); 1] = [(0, &d0)];
+
+    let outcome = gc_pass(&meta, &fleet, GRACE, ExpiredPendingPolicy::Defer, NOW).await;
+
+    assert!(
+        matches!(outcome, Ok(Reconciled::Changed)),
+        "a GC pass over an orphan ledger of {population} marks — past the store's cap of \
+         {LOWERED_CAP} — must succeed and reclaim, not fail on the ledger's size: {outcome:?}"
+    );
+    assert_eq!(d0.count(), 0, "every actionable fragment is reclaimed");
+    assert_eq!(meta.ledger_len(), 0, "every consumed mark is retired");
+    assert_eq!(
+        meta.orphan_scans(),
+        0,
+        "the ledger is never read with `scan`"
+    );
+}
+
+// ---- (B) one pass reads a bounded, pinned amount ----------------------------------------------
+
+/// **(B)** No pass receives more than `B` `orphan:` entries, a pass with at least `B` left
+/// receives exactly `B`, and a population of `2B + 7` drains in exactly ⌈P / B⌉ = 3 passes. Each
+/// pass commits its mark deletes [`BATCH`] at a time — never one pass-sized transaction — and
+/// the ledger is never read with `scan`.
+#[tokio::test]
+async fn one_pass_receives_exactly_the_budget_and_the_ledger_drains_in_ceil_p_over_b_passes() {
+    let meta = LedgerMeta::default();
+    let d0 = MemDServer::default();
+    let population = 2 * B + 7;
+    seed_marks(&meta, Some(&d0), 0, 0, population, 0);
+    let fleet: [(DServerId, &dyn ChunkStore); 1] = [(0, &d0)];
+
+    let mut left = population;
+    for pass in 1..=population.div_ceil(B) {
+        meta.received();
+        meta.commits();
+        let outcome = gc_pass(&meta, &fleet, GRACE, ExpiredPendingPolicy::Defer, NOW).await;
+        assert!(
+            matches!(outcome, Ok(Reconciled::Changed)),
+            "pass {pass}: {outcome:?}"
+        );
+
+        let read = meta.received();
+        assert!(
+            read <= B,
+            "pass {pass} received {read} entries, past B = {B}"
+        );
+        assert_eq!(
+            read,
+            left.min(B),
+            "pass {pass}: with {left} entries left a pass receives exactly min(left, B) — an \
+             under-read stalls the walk as surely as an over-read breaks the bound"
+        );
+        left -= read;
+        assert_eq!(
+            meta.ledger_len(),
+            left,
+            "pass {pass} retires exactly the marks it read, so the ledger drains in ⌈P / B⌉ \
+             passes and not fewer"
+        );
+        assert_eq!(
+            d0.count(),
+            left,
+            "pass {pass} reclaims exactly what it read"
+        );
+
+        let commits = meta.commits();
+        assert_eq!(
+            ledger_commit_sizes(&commits),
+            batched(read),
+            "pass {pass} commits its {read} mark deletes in batches of at most {BATCH}"
+        );
+        assert!(
+            commits
+                .iter()
+                .all(|commit| commit.outcome == CommitOutcome::Committed),
+            "pass {pass}: nothing moved under the pass, so every commit lands: {commits:?}"
+        );
+    }
+    assert_eq!(left, 0, "the population drains in ⌈P / B⌉ passes");
+    assert_eq!(
+        meta.orphan_scans(),
+        0,
+        "the ledger is never read with `scan`"
+    );
+
+    // A drained ledger: the next pass reads it whole, finds nothing, and certifies it.
+    let outcome = gc_pass(&meta, &fleet, GRACE, ExpiredPendingPolicy::Defer, NOW).await;
+    assert!(
+        matches!(outcome, Ok(Reconciled::Satisfied)),
+        "a pass that read the whole (empty) ledger and did nothing is satisfied: {outcome:?}"
+    );
+}
+
+// ---- (C) the tail does not starve -------------------------------------------------------------
+
+/// **(C)** `B + 1` marks still inside their grace sort first; five actionable marks follow. With
+/// a fresh `GcContext` every pass, the tail is reclaimed within ⌈(head + tail) / B⌉ + 1 passes
+/// and no head fragment is touched. A walk that restarted at the first window every pass would
+/// never get past the head.
+#[tokio::test]
+async fn the_actionable_tail_is_reached_behind_a_retention_safe_head() {
+    let meta = LedgerMeta::default();
+    let (d1, d2) = (MemDServer::default(), MemDServer::default());
+    let (head, tail) = (B + 1, 5);
+    // `orphan:1:…` sorts before `orphan:2:…`: the head first, in grace at `NOW`...
+    seed_marks(&meta, Some(&d1), 1, 0, head, NOW);
+    // ...then the tail, long past grace.
+    seed_marks(&meta, Some(&d2), 2, 0, tail, 0);
+    let fleet: [(DServerId, &dyn ChunkStore); 2] = [(1, &d1), (2, &d2)];
+
+    let bound = (head + tail).div_ceil(B) + 1;
+    let mut passes = 0;
+    while d2.count() > 0 && passes < bound {
+        passes += 1;
+        let outcome = gc_pass(&meta, &fleet, GRACE, ExpiredPendingPolicy::Defer, NOW).await;
+        assert!(outcome.is_ok(), "pass {passes}: {outcome:?}");
+        if passes == 1 {
+            assert_eq!(
+                outcome.unwrap(),
+                Reconciled::Changed,
+                "the first pass read one window of a larger ledger and reclaimed nothing — a \
+                 partial reading is never certified `Satisfied`"
+            );
+        }
+    }
+
+    assert_eq!(
+        d2.count(),
+        0,
+        "every tail fragment is reclaimed within {bound} passes"
+    );
+    assert_eq!(d1.count(), head, "no head fragment is touched");
+    for chunk in 0..head as u64 {
+        assert_eq!(
+            meta.value(&orphan_key(1, frag(ChunkId::from(chunk)))),
+            Some(Bytes::from(stamp(NOW))),
+            "head mark {chunk} is left exactly as it was"
+        );
+    }
+    assert_eq!(
+        meta.orphan_scans(),
+        0,
+        "the ledger is never read with `scan`"
+    );
+}
+
+// ---- (D) a mark with no fragment is swept, and only when that is safe --------------------------
+
+/// The fixture for (D): a mark at position `(5, chunk 1)` stamped `T0`, over a fleet of server
+/// 5 alone, with a grace window no test reaches.
+const T0: u64 = 1_000_000;
+const LONG_GRACE: u64 = 100 * D;
+
+fn d_position() -> Vec<u8> {
+    orphan_key(5, frag(1))
+}
+
+/// **(D)(i)** A mark at a position no listed server reports, aged exactly `D`, with the listing
+/// taken at `T0 + D`: deleted. On the base it survives every pass — nothing ever visits it.
+#[tokio::test]
+async fn d1_a_fragment_less_mark_aged_exactly_d_is_swept() {
+    let meta = LedgerMeta::default();
+    let d5 = MemDServer::default();
+    meta.seed([(d_position(), stamp(T0))]);
+    let fleet: [(DServerId, &dyn ChunkStore); 1] = [(5, &d5)];
+
+    let outcome = gc_pass(
+        &meta,
+        &fleet,
+        LONG_GRACE,
+        ExpiredPendingPolicy::Defer,
+        T0 + D,
+    )
+    .await;
+
+    assert!(
+        meta.value(&d_position()).is_none(),
+        "a mark whose position this pass listed empty, aged exactly D, is swept"
+    );
+    assert!(
+        matches!(outcome, Ok(Reconciled::Changed)),
+        "a sweep changed the ledger: {outcome:?}"
+    );
+}
+
+/// **(D)(ii)** The same mark aged `D − 1` ms survives — a pre-mark may still be inside its
+/// budget.
+#[tokio::test]
+async fn d2_a_fragment_less_mark_aged_d_minus_one_survives() {
+    let meta = LedgerMeta::default();
+    let d5 = MemDServer::default();
+    meta.seed([(d_position(), stamp(T0))]);
+    let fleet: [(DServerId, &dyn ChunkStore); 1] = [(5, &d5)];
+
+    let outcome = gc_pass(
+        &meta,
+        &fleet,
+        LONG_GRACE,
+        ExpiredPendingPolicy::Defer,
+        T0 + D - 1,
+    )
+    .await;
+
+    assert_eq!(
+        meta.value(&d_position()),
+        Some(Bytes::from(stamp(T0))),
+        "a fragment-less mark aged D - 1 ms survives, untouched"
+    );
+    assert!(
+        matches!(outcome, Ok(Reconciled::Satisfied)),
+        "the pass read the whole ledger and had nothing to do: {outcome:?}"
+    );
+}
+
+/// **(D)(iii)** A mark whose D server is not in the pass's fleet is never swept, however old:
+/// its absence was never observed.
+#[tokio::test]
+async fn d3_a_mark_whose_server_is_not_in_the_fleet_is_never_swept() {
+    let meta = LedgerMeta::default();
+    let d5 = MemDServer::default();
+    let elsewhere = orphan_key(99, frag(1));
+    meta.seed([(elsewhere.clone(), stamp(T0))]);
+    let fleet: [(DServerId, &dyn ChunkStore); 1] = [(5, &d5)];
+
+    let (outcome, logged) = audited_gc_pass(
+        &meta,
+        &fleet,
+        LONG_GRACE,
+        ExpiredPendingPolicy::Defer,
+        T0 + 100 * D,
+    )
+    .await;
+    outcome.unwrap();
+
+    assert_eq!(
+        meta.value(&elsewhere),
+        Some(Bytes::from(stamp(T0))),
+        "a mark on a server outside the fleet is never swept"
+    );
+    let named: Vec<&str> = logged
+        .lines()
+        .filter(|line| line.contains(r#""action":"off-fleet-orphan-marks""#))
+        .collect();
+    assert!(
+        named.len() == 1 && named[0].contains("99: 1"),
+        "the skipped mark is named on the audit seam, under its server: {logged}"
+    );
+}
+
+/// **(D)(iv)** A mark whose position IS listed is never swept, even long past `D`: it is left
+/// to the ordinary grace judgement, which here has not elapsed.
+#[tokio::test]
+async fn d4_a_mark_whose_position_is_listed_is_never_swept() {
+    let meta = LedgerMeta::default();
+    let d5 = MemDServer::default();
+    d5.put(frag(1));
+    meta.seed([(d_position(), stamp(T0))]);
+    let fleet: [(DServerId, &dyn ChunkStore); 1] = [(5, &d5)];
+
+    gc_pass(
+        &meta,
+        &fleet,
+        LONG_GRACE,
+        ExpiredPendingPolicy::Defer,
+        T0 + D + 5_000,
+    )
+    .await
+    .unwrap();
+
+    assert!(d5.holds(frag(1)), "the listed fragment is untouched");
+    assert_eq!(
+        meta.value(&d_position()),
+        Some(Bytes::from(stamp(T0))),
+        "a mark at a listed position is not swept as fragment-less"
+    );
+}
+
+/// **(D)(v)** A listing from an earlier pass never licenses a sweep (X96, `0016:2625`). Pass 1
+/// runs with the mark aged `D − 1` (it survives, as (ii)); a fragment then lands in the
+/// position; pass 2 runs with the mark aged `D`, still inside grace. The mark survives: only a
+/// pass's OWN listing may show the position empty, and pass 2's shows it occupied.
+#[tokio::test]
+async fn d5_a_listing_from_an_earlier_pass_never_licenses_a_sweep() {
+    let meta = LedgerMeta::default();
+    let d5 = MemDServer::default();
+    meta.seed([(d_position(), stamp(T0))]);
+    let fleet: [(DServerId, &dyn ChunkStore); 1] = [(5, &d5)];
+
+    gc_pass(
+        &meta,
+        &fleet,
+        LONG_GRACE,
+        ExpiredPendingPolicy::Defer,
+        T0 + D - 1,
+    )
+    .await
+    .unwrap();
+    assert!(
+        meta.value(&d_position()).is_some(),
+        "pass 1: aged D - 1, the mark survives"
+    );
+
+    // The write the mark covers lands between the passes.
+    d5.put(frag(1));
+
+    gc_pass(
+        &meta,
+        &fleet,
+        LONG_GRACE,
+        ExpiredPendingPolicy::Defer,
+        T0 + D,
+    )
+    .await
+    .unwrap();
+    assert!(d5.holds(frag(1)), "the fragment that landed survives");
+    assert_eq!(
+        meta.value(&d_position()),
+        Some(Bytes::from(stamp(T0))),
+        "pass 2 listed the position occupied, so its mark survives"
+    );
+}
+
+// ---- (F) restore survives the ledger and never re-stamps a mark it did not read ----------------
+
+/// **(F)** A ledger past the cap and past `B`: `B + LOWERED_CAP + 1` marks with no fragment
+/// behind them (server 1) sort ahead of three pre-marked, unreferenced fragments on server 2 —
+/// the last of which is the ledger's last key — each stamped long before the pass's clock. The
+/// post-restore pass returns `Ok`, counts all three `already_marked`, leaves every one's bytes
+/// exactly as they were, and still marks the one genuine stray. On the base, `restore.rs:308`'s
+/// `scan` returns `Err`.
+#[tokio::test]
+async fn restore_sees_every_mark_whatever_its_page_and_never_restamps_one() {
+    let meta = LedgerMeta::default();
+    let (d1, d2) = (MemDServer::default(), MemDServer::default());
+    seed_marks(&meta, None, 1, 0, B + LOWERED_CAP + 1, 0);
+    let old = 5;
+    let marked: Vec<FragmentId> = (7_000_001..=7_000_003).map(frag).collect();
+    for &frag in &marked {
+        d2.put(frag);
+        meta.seed([(orphan_key(2, frag), stamp(old))]);
+    }
+    let stray = frag(8_000_001);
+    d2.put(stray);
+    let fleet: [(DServerId, &dyn ChunkStore); 2] = [(1, &d1), (2, &d2)];
+    let ctx = GcContext {
+        meta: &meta,
+        fleet: &fleet,
+        grace_window_millis: GRACE,
+        expired_pending: ExpiredPendingPolicy::Defer,
+    };
+    meta.received();
+
+    let report: RestoreReport = reconcile_after_restore(&ctx, NOW)
+        .await
+        .expect("the post-restore pass must survive an orphan ledger past the cap");
+
+    assert_eq!(
+        report.already_marked,
+        marked.len(),
+        "every pre-marked fragment is found marked, on whichever page its mark sits: {report:?}"
+    );
+    for frag in &marked {
+        assert_eq!(
+            meta.value(&orphan_key(2, *frag)),
+            Some(Bytes::from(stamp(old))),
+            "a mark the pass found is left byte-for-byte as it was — re-stamping restarts its \
+             grace clock"
+        );
+    }
+    assert_eq!(report.stranded_marked, 1, "{report:?}");
+    assert_eq!(
+        meta.value(&orphan_key(2, stray)),
+        Some(Bytes::from(stamp(NOW))),
+        "the genuine stray is marked at the pass's clock"
+    );
+    assert_eq!(
+        meta.orphan_scans(),
+        0,
+        "the ledger is never read with `scan`"
+    );
+    assert_eq!(
+        meta.received(),
+        0,
+        "restore asks each candidate's own key; it does not page through the ledger"
+    );
+}
+
+// ---- a mark outside the window outranks an expired pending lease ------------------------------
+
+/// The window's silence is an observation only inside the range it read. `B - 2` marks on a
+/// server outside the fleet fill the first window with `T0` and `T1`, the first two keys under
+/// server 2, as its last two keys; `T2` sorts after them. All three are unreferenced fragments
+/// under an EXPIRED pending lease AND a mark still inside its grace, and the mark wins wherever it
+/// sits: pass 1 reads T0's and T1's marks in its window and must read T2's key directly; pass 2
+/// starts strictly after T1, so it must read T1's key (the cursor itself) and T0's key (behind
+/// the cursor) directly. A control fragment `G` under an expired lease and no mark at all is
+/// reclaimed on the lease, and its lease retired. Once the grace has run out all three are
+/// reclaimed on their marks — T2's through a direct read.
+#[tokio::test]
+async fn an_unread_mark_on_another_page_outranks_an_expired_pending_lease() {
+    let meta = LedgerMeta::default();
+    let d2 = MemDServer::default();
+    // Server 1 is not in the fleet: these marks are never swept, and never listed.
+    seed_marks(&meta, None, 1, 0, B - 2, 0);
+    // `orphan:2:1000000:0` < `orphan:2:1500000:0` < `orphan:2:2000000:0`.
+    let marked = [frag(1_000_000), frag(1_500_000), frag(2_000_000)];
+    let g = frag(3_000_000);
+    for frag in marked.into_iter().chain([g]) {
+        d2.put(frag);
+        expired_lease(&meta, frag.chunk).await;
+    }
+    meta.seed(marked.iter().map(|&frag| (orphan_key(2, frag), stamp(NOW))));
+    let fleet: [(DServerId, &dyn ChunkStore); 1] = [(2, &d2)];
+
+    for pass in 1..=2 {
+        let outcome = gc_pass(&meta, &fleet, GRACE, ExpiredPendingPolicy::Reclaim, NOW).await;
+        assert!(outcome.is_ok(), "pass {pass}: {outcome:?}");
+        for frag in marked {
+            assert!(
+                d2.holds(frag),
+                "pass {pass}: {frag:?}'s mark is inside its grace, so the fragment is kept \
+                 whichever window the mark sits in — the expired lease never outranks it"
+            );
+        }
+        assert!(
+            !d2.holds(g),
+            "pass {pass}: a fragment with no mark anywhere is reclaimed on its expired lease"
+        );
+        assert!(
+            meta.value(&metadata::pending_key(g.chunk)).is_none(),
+            "pass {pass}: the lease it was reclaimed on is retired"
+        );
+    }
+
+    // The grace runs out: all three are reclaimed on their marks. Pass 3 starts a new lap, so T2
+    // is outside its window again and its mark is read directly.
+    gc_pass(
+        &meta,
+        &fleet,
+        GRACE,
+        ExpiredPendingPolicy::Reclaim,
+        NOW + GRACE,
+    )
+    .await
+    .unwrap();
+    for frag in marked {
+        assert!(!d2.holds(frag), "past its grace, {frag:?} is reclaimed");
+        assert!(
+            meta.value(&orphan_key(2, frag)).is_none(),
+            "the mark {frag:?} was reclaimed on is retired"
+        );
+    }
+}
+
+/// A fleet that names one server twice is still one server. Each listing of it must see the marks
+/// the window read for it — so a fragment whose mark is inside its grace is kept under an expired
+/// lease on the second listing too — and its fragment-less mark is swept once.
+#[tokio::test]
+async fn a_server_the_fleet_names_twice_is_still_one_server() {
+    let meta = LedgerMeta::default();
+    let d5 = MemDServer::default();
+    let (guarded, empty) = (frag(1), frag(2));
+    d5.put(guarded);
+    expired_lease(&meta, guarded.chunk).await;
+    meta.seed([
+        (orphan_key(5, guarded), stamp(NOW)),
+        (orphan_key(5, empty), stamp(0)),
+    ]);
+    let fleet: [(DServerId, &dyn ChunkStore); 2] = [(5, &d5), (5, &d5)];
+
+    gc_pass(&meta, &fleet, GRACE, ExpiredPendingPolicy::Reclaim, NOW)
+        .await
+        .unwrap();
+
+    assert!(
+        d5.holds(guarded),
+        "a mark inside its grace outranks the expired lease on every listing of its server"
+    );
+    assert!(
+        meta.value(&orphan_key(5, empty)).is_none(),
+        "the fragment-less mark is swept"
+    );
+    assert_eq!(
+        meta.commits()
+            .iter()
+            .filter(|commit| commit.orphan_writes > 0)
+            .count(),
+        1,
+        "one commit retires it — the server is swept once, not once per mention"
+    );
+}
+
+// ---- a delete loses to a mark refreshed after the pass read it --------------------------------
+
+/// Two fragment-less marks, both past `D`. Between the pass's read and its delete, a concurrent
+/// writer refreshes one of them. The refreshed mark survives with its new stamp — the delete
+/// required the value the pass judged — while the other is swept all the same.
+#[tokio::test]
+async fn a_sweep_loses_to_a_mark_refreshed_after_the_pass_read_it() {
+    let meta = LedgerMeta::default();
+    let d5 = MemDServer::default();
+    let (refreshed, other) = (orphan_key(5, frag(1)), orphan_key(5, frag(2)));
+    meta.seed([(refreshed.clone(), stamp(T0)), (other.clone(), stamp(T0))]);
+    let fresh = stamp(T0 + D + 7);
+    meta.interpose(refreshed.clone(), &fresh);
+    let fleet: [(DServerId, &dyn ChunkStore); 1] = [(5, &d5)];
+
+    gc_pass(
+        &meta,
+        &fleet,
+        LONG_GRACE,
+        ExpiredPendingPolicy::Defer,
+        T0 + D,
+    )
+    .await
+    .unwrap();
+
+    assert!(meta.value(&other).is_none(), "the untouched mark is swept");
+    assert!(
+        meta.interposed(),
+        "the pass read the mark, judged it, and went to delete it"
+    );
+    assert_eq!(
+        meta.value(&refreshed),
+        Some(Bytes::from(fresh)),
+        "a mark refreshed after the pass read it keeps its new stamp: the delete lost"
+    );
+}
+
+/// A pass that reclaimed bytes has changed the store even when the only sweep beside the reclaim
+/// loses its race: the reclaim's mark delete and the sweep share a batch, the batch conflicts, the
+/// reclaim's delete lands on its own retry and the sweep's does not — and the pass still answers
+/// `Changed`.
+#[tokio::test]
+async fn a_pass_that_reclaimed_is_changed_even_when_its_sweep_loses() {
+    let meta = LedgerMeta::default();
+    let d5 = MemDServer::default();
+    let (reclaimed, swept) = (frag(1), frag(2));
+    d5.put(reclaimed);
+    meta.seed([
+        (orphan_key(5, reclaimed), stamp(0)),
+        (orphan_key(5, swept), stamp(0)),
+    ]);
+    let fresh = stamp(NOW + 1);
+    meta.interpose(orphan_key(5, swept), &fresh);
+    let fleet: [(DServerId, &dyn ChunkStore); 1] = [(5, &d5)];
+
+    let outcome = gc_pass(&meta, &fleet, GRACE, ExpiredPendingPolicy::Defer, NOW).await;
+
+    assert!(
+        !d5.holds(reclaimed),
+        "the fragment past its grace is reclaimed"
+    );
+    assert!(
+        meta.value(&orphan_key(5, reclaimed)).is_none(),
+        "its mark is retired on the per-write retry after the batch conflicted"
+    );
+    assert!(meta.interposed(), "the sweep's delete met the refresh");
+    assert_eq!(
+        meta.value(&orphan_key(5, swept)),
+        Some(Bytes::from(fresh)),
+        "the refreshed mark survives"
+    );
+    assert!(
+        matches!(outcome, Ok(Reconciled::Changed)),
+        "bytes were reclaimed, so the pass changed the store: {outcome:?}"
+    );
+}
+
+/// A reclaim retires only the mark it judged. The fragment is past grace and reclaimed; a
+/// concurrent writer refreshes its mark before the pass's delete of it lands. The bytes are gone,
+/// and the new mark — new evidence for the position — stays.
+#[tokio::test]
+async fn a_reclaim_retires_only_the_mark_it_judged() {
+    let meta = LedgerMeta::default();
+    let d5 = MemDServer::default();
+    d5.put(frag(1));
+    let key = orphan_key(5, frag(1));
+    meta.seed([(key.clone(), stamp(0))]);
+    let fresh = stamp(NOW + 1);
+    meta.interpose(key.clone(), &fresh);
+    let fleet: [(DServerId, &dyn ChunkStore); 1] = [(5, &d5)];
+
+    gc_pass(&meta, &fleet, GRACE, ExpiredPendingPolicy::Defer, NOW)
+        .await
+        .unwrap();
+
+    assert!(
+        !d5.holds(frag(1)),
+        "the fragment past its grace is reclaimed"
+    );
+    assert!(
+        meta.interposed(),
+        "the pass went to retire the mark it judged"
+    );
+    assert_eq!(
+        meta.value(&key),
+        Some(Bytes::from(fresh)),
+        "the refreshed mark is not the one the pass judged, so it is not retired"
+    );
+}
+
+// ---- the walk's position is never moved over another pass's --------------------------------
+
+/// The walk's position — `gc:orphan-cursor`, the persisted record
+/// `docs/design/architecture/06-runtime-view.md` §6.7 describes — is moved only from the value the
+/// pass started with. Here another pass moves it between this pass's read of it and its update:
+/// this pass's update loses, the other pass's position stands (a stale pass never rewinds a
+/// newer one), and the loss is named on the GC audit seam rather than passing silently.
+#[tokio::test]
+async fn a_pass_never_moves_a_cursor_another_pass_moved() {
+    let meta = LedgerMeta::default();
+    // More than one window of marks on a server outside the fleet: the pass reads a full window
+    // and must move the cursor past it, and acts on none of them.
+    seed_marks(&meta, None, 9, 0, B + 10, 0);
+    let cursor = b"gc:orphan-cursor".to_vec();
+    let theirs = orphan_key(9, frag(7));
+    meta.interpose(cursor.clone(), &theirs);
+    let d5 = MemDServer::default();
+    let fleet: [(DServerId, &dyn ChunkStore); 1] = [(5, &d5)];
+
+    let (outcome, logged) =
+        audited_gc_pass(&meta, &fleet, GRACE, ExpiredPendingPolicy::Defer, NOW).await;
+
+    assert!(
+        outcome.is_ok(),
+        "a pass over a ledger larger than one window must succeed: {outcome:?}"
+    );
+    assert!(
+        meta.interposed(),
+        "the pass read one window of a larger ledger and went to move its cursor past it"
+    );
+    assert_eq!(
+        meta.value(&cursor),
+        Some(Bytes::from(theirs)),
+        "the position another pass wrote in the meantime stands"
+    );
+    assert!(
+        logged.contains(r#""action":"orphan-walk-cursor-moved""#),
+        "the lost update is named on the audit seam: {logged}"
+    );
+}
+
+// ---- a mark this slice cannot read is never acted on ------------------------------------------
+
+/// A value that does not read as a decimal instant: never reclaimed on — even under an expired
+/// pending lease, which would otherwise reclaim an unmarked fragment — never swept, never
+/// rewritten.
+#[tokio::test]
+async fn an_unreadable_mark_is_never_reclaimed_on_swept_or_rewritten() {
+    let meta = LedgerMeta::default();
+    let d5 = MemDServer::default();
+    let (listed, empty) = (frag(1), frag(2));
+    d5.put(listed);
+    expired_lease(&meta, listed.chunk).await;
+    let unreadable = b"a later slice's value".to_vec();
+    meta.seed([
+        (orphan_key(5, listed), unreadable.clone()),
+        (orphan_key(5, empty), unreadable.clone()),
+    ]);
+    let fleet: [(DServerId, &dyn ChunkStore); 1] = [(5, &d5)];
+
+    gc_pass(
+        &meta,
+        &fleet,
+        GRACE,
+        ExpiredPendingPolicy::Reclaim,
+        NOW + 100 * D,
+    )
+    .await
+    .unwrap();
+
+    assert!(
+        d5.holds(listed),
+        "a fragment under a mark GC cannot read is kept"
+    );
+    for frag in [listed, empty] {
+        assert_eq!(
+            meta.value(&orphan_key(5, frag)),
+            Some(Bytes::from(unreadable.clone())),
+            "an unreadable mark is left exactly as it is"
+        );
+    }
+}
+
+// ---- restore commits in bounded batches and never overwrites a mark written meanwhile ----------
+
+/// 2,500 strays: the post-restore pass marks them [`BATCH`] at a time. A concurrent writer marks
+/// one of them between the pass's read and its commit: that record is kept exactly as written
+/// and counted as already marked, and the rest of its batch still lands.
+#[tokio::test]
+async fn restore_marks_in_bounded_batches_and_never_overwrites_a_mark_written_meanwhile() {
+    let meta = LedgerMeta::default();
+    let d0 = MemDServer::default();
+    let strays = 2_500;
+    for chunk in 0..strays {
+        d0.put(frag(chunk));
+    }
+    let raced = orphan_key(0, frag(7));
+    meta.interpose(raced.clone(), b"77");
+    let fleet: [(DServerId, &dyn ChunkStore); 1] = [(0, &d0)];
+    let ctx = GcContext {
+        meta: &meta,
+        fleet: &fleet,
+        grace_window_millis: GRACE,
+        expired_pending: ExpiredPendingPolicy::Defer,
+    };
+
+    let report = reconcile_after_restore(&ctx, NOW).await.unwrap();
+
+    assert!(
+        meta.interposed(),
+        "the concurrent mark landed before the pass's commit"
+    );
+    assert_eq!(
+        meta.value(&raced),
+        Some(Bytes::from_static(b"77")),
+        "a mark written after the pass looked is never overwritten"
+    );
+    assert_eq!(report.already_marked, 1, "{report:?}");
+    assert_eq!(report.stranded_marked, strays as usize - 1, "{report:?}");
+    assert_eq!(
+        meta.ledger_len(),
+        strays as usize,
+        "every stray carries a mark"
+    );
+
+    let commits = meta.commits();
+    let whole: Vec<usize> = ledger_commit_sizes(&commits)
+        .into_iter()
+        .filter(|&size| size > 1)
+        .collect();
+    assert_eq!(
+        whole,
+        batched(strays as usize),
+        "marks are committed at most {BATCH} to a transaction: {commits:?}"
+    );
+}
