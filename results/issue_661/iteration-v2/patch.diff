+    match std::str::from_utf8(value).ok().and_then(|s| s.parse().ok()) {
+        Some(at) => Mark::Stamped {
+            at,
+            raw: value.to_vec(),
+        },
+        None => {
+            emit_unreadable_mark(key);
+            Mark::Unreadable
