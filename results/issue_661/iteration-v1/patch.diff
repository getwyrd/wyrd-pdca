+// ---- the D-server double (a fresh copy for this file — a separate test binary can't
+// import `gc.rs` tests' private `MemDServer`) -------------------------------------
+
+#[derive(Default)]
+struct MemDServer {
+    frags: Mutex<HashMap<FragmentId, Bytes>>,
+}
+
+impl MemDServer {
+    fn put(&self, frag: FragmentId) {
+        self.frags
+            .lock()
+            .unwrap()
+            .insert(frag, Bytes::from_static(b"bytes"));
+    }
+
+    fn remaining(&self) -> usize {
+        self.frags.lock().unwrap().len()
+    }
+}
+
+#[async_trait]
+impl ChunkStore for MemDServer {
+    async fn put_fragment(
+        &self,
+        id: FragmentId,
+        fragment: Bytes,
+        _deadline_millis: Option<u64>,
+    ) -> Result<()> {
+        self.frags.lock().unwrap().insert(id, fragment);
+        Ok(())
+    }
+
+    async fn get_fragment(&self, id: FragmentId) -> Result<Option<Bytes>> {
+        Ok(self.frags.lock().unwrap().get(&id).cloned())
+    }
+
+    async fn list_fragments(&self) -> Result<Vec<FragmentId>> {
+        Ok(self.frags.lock().unwrap().keys().copied().collect())
+    }
+
+    async fn delete_fragment(&self, id: FragmentId) -> Result<()> {
+        self.frags.lock().unwrap().remove(&id);
+        Ok(())
+    }
+
+    async fn health(&self) -> Result<Health> {
+        Ok(Health::Healthy)
+    }
+}
+
+// ---- helpers --------------------------------------------------------------------
+
+fn frag(chunk: ChunkId, index: u16) -> FragmentId {
+    FragmentId { chunk, index }
+}
+
+async fn elect(coord: &MemCoordination) -> (FencedZone, Custodian) {
+    let leader = Custodian::elect(coord, "zone-gc-ledger-walk")
+        .await
+        .unwrap();
+    let mut zone = FencedZone::new();
+    zone.install(leader.leadership());
+    (zone, leader)
+}
+
+/// Seed `count` actionable `orphan:` marks under `dserver`, each with a real fragment
+/// on `store`, chunk ids `start..start+count`, all stamped `orphaned_at`.
+async fn seed_marks(
+    meta: &PagedMeta,
+    store: &MemDServer,
+    dserver: DServerId,
+    start: u64,
+    count: usize,
+    orphaned_at: u64,
+) {
+    let mut batch = WriteBatch::new();
+    for i in 0..count {
+        let frag_id = frag((start + i as u64) as ChunkId, 0);
+        store.put(frag_id);
+        batch = batch.put(
+            orphan_key(dserver, frag_id),
+            orphaned_at.to_string().into_bytes(),
+        );
+    }
+    assert_eq!(meta.commit(batch).await.unwrap(), CommitOutcome::Committed);
+}
