+
+    async fn scan(&self, prefix: &[u8]) -> Result<Vec<(Vec<u8>, Bytes)>> {
+        if prefix == ORPHAN_PREFIX {
+            *self.orphan_scan_calls.lock().unwrap() += 1;
+        }
+        let kv = self.kv.lock().unwrap();
+        let hits: Vec<(Vec<u8>, Bytes)> = kv
+            .range(prefix.to_vec()..)
+            .take_while(|(k, _)| k.starts_with(prefix))
+            .map(|(k, v)| (k.clone(), v.clone()))
+            .collect();
+        if hits.len() > LOWERED_CAP {
+            return Err(Box::new(wyrd_traits::ScanCapExceeded {
+                cap: LOWERED_CAP,
+                prefix: prefix.to_vec(),
+            }));
+        }
+        Ok(hits)
+    }
+
+    async fn scan_page(
+        &self,
+        prefix: &[u8],
+        after: Option<&[u8]>,
+        limit: usize,
+    ) -> Result<ScanPage> {
+        // The shared page-bound helper (`crates/traits/src/lib.rs:414-424`): this double
+        // has no structural cap of its own on `scan_page` (only `scan`, above, is
+        // capped — a page NEVER fails with `ScanCapExceeded`, by contract), so its own
+        // effective cap is unbounded.
+        let limit = wyrd_traits::page_limit(limit, usize::MAX, prefix)?;
+        let (lo, hi): (Bound<Vec<u8>>, Bound<Vec<u8>>) =
+            match wyrd_traits::page_start(prefix, after) {
+                wyrd_traits::PageStart::Prefix => {
+                    (Bound::Included(prefix.to_vec()), Bound::Unbounded)
+                }
+                wyrd_traits::PageStart::After(cursor) => {
+                    (Bound::Excluded(cursor.to_vec()), Bound::Unbounded)
+                }
+                wyrd_traits::PageStart::PastPrefix => {
+                    if prefix == ORPHAN_PREFIX {
+                        self.orphan_page_sizes.lock().unwrap().push(0);
+                    }
+                    return Ok((Vec::new(), None));
+                }
+            };
+        let kv = self.kv.lock().unwrap();
+        let items: Vec<(Vec<u8>, Bytes)> = kv
+            .range((lo, hi))
+            .take_while(|(k, _)| k.starts_with(prefix))
+            .take(limit)
+            .map(|(k, v)| (k.clone(), v.clone()))
+            .collect();
+        if prefix == ORPHAN_PREFIX {
+            self.orphan_page_sizes.lock().unwrap().push(items.len());
+        }
+        let next = wyrd_traits::page_cursor(&items, limit);
+        Ok((items, next))
+    }
+
+    async fn commit(&self, batch: WriteBatch) -> Result<CommitOutcome> {
+        let mut kv = self.kv.lock().unwrap();
+        for pre in &batch.preconditions {
+            if kv.get(&pre.key).cloned() != pre.expected {
+                return Ok(CommitOutcome::Conflict);
+            }
+        }
+        for (k, v) in batch.puts {
+            kv.insert(k, v);
+        }
+        for k in batch.deletes {
+            kv.remove(&k);
+        }
+        Ok(CommitOutcome::Committed)
+    }
+}
