+// ---- leg F: restore survives the same ledger, and never re-stamps an unread mark --
+
+/// **(F) Restore survives the same ledger, and never re-stamps a mark it did not
+/// read.** `B` filler `orphan:` records (pure ledger noise: no matching on-disk
+/// fragment anywhere, so restore's decision loop never looks at them) push a small
+/// group of PRE-MARKED, unreferenced, physically-present fragments onto a page AFTER
+/// the walk's first `B`-sized page (sorting after every filler key: dserver 1 sorts
+/// after dserver 0). Every pre-marked fragment must be counted `already_marked`, with
+/// its stamp UNCHANGED — never re-stamped, never treated as newly stranded. On the
+/// base, `restore.rs:308`'s single `scan` returns `Err` past the lowered cap — the red.
+#[tokio::test]
+async fn restore_survives_the_ledger_and_never_re_stamps_an_unread_mark() {
+    let meta = PagedMeta::new();
+    let d1 = MemDServer::default();
+
+    // B filler orphan: records under dserver 0 — no on-disk fragment anywhere for any
+    // of them, so restore's fleet walk (which drives every decision) never looks at
+    // them; they exist purely to push the group below past the walk's first page.
+    let mut batch = WriteBatch::new();
+    for i in 0..B {
+        batch = batch.put(orphan_key(0, frag(i as ChunkId, 0)), b"0".to_vec());
+    }
+    assert_eq!(meta.commit(batch).await.unwrap(), CommitOutcome::Committed);
+
+    // K pre-marked, unreferenced, physically-present fragments on dserver 1 — sorting
+    // after every dserver-0 key, so at least one sits on the page AFTER the first B.
+    const K: usize = 3;
+    let stamp = b"5".to_vec();
+    let mut pre_marked = Vec::new();
+    let mut batch = WriteBatch::new();
+    for i in 0..K {
+        let frag_id = frag((B + i) as ChunkId, 0);
+        d1.put(frag_id);
+        batch = batch.put(orphan_key(1, frag_id), stamp.clone());
+        pre_marked.push(frag_id);
+    }
+    assert_eq!(meta.commit(batch).await.unwrap(), CommitOutcome::Committed);
+
+    let fleet: [(DServerId, &dyn ChunkStore); 1] = [(1, &d1)];
+    let ctx = GcContext {
+        meta: &meta,
+        fleet: &fleet,
+        grace_window_millis: 0,
+        expired_pending: ExpiredPendingPolicy::Defer,
+    };
+
+    let report = reconcile_after_restore(&ctx, 1_000_000)
+        .await
+        .expect("restore must survive an orphan: ledger past the cap");
+
+    assert_eq!(
+        report.already_marked, K,
+        "every pre-marked fragment must be re-read, on whichever page it sits"
+    );
+    assert_eq!(
+        report.stranded_marked, 0,
+        "an already-marked fragment must never be counted as newly stranded"
+    );
+    for frag_id in &pre_marked {
+        assert_eq!(
+            meta.get(&orphan_key(1, *frag_id)).await.unwrap(),
+            Some(Bytes::from(stamp.clone())),
+            "an already-marked fragment's grace stamp must be left EXACTLY as it was — \
+             re-stamping would reset its grace clock"
+        );
+    }
+    assert_eq!(
+        *meta.orphan_scan_calls.lock().unwrap(),
+        0,
+        "restore must never call `scan` on the orphan: prefix"
+    );
+}
