+// ---- leg A: GC survives a ledger past the cap ------------------------------------
+
+/// **(A) GC survives a ledger past the cap.** An `orphan:` population larger than the
+/// (lowered) cap, every mark actionable (fragment present, unreferenced, past grace):
+/// `reconcile_step` returns `Ok`. On the base, `orphan_leases`'s single `scan` errors
+/// past `LOWERED_CAP` and the `?` at `gc.rs:177` turns it into
+/// `Err(ReconcileError::Store)` — the red.
+#[tokio::test]
+async fn gc_survives_a_ledger_past_the_cap() {
+    let meta = PagedMeta::new();
+    let d0 = MemDServer::default();
+    let population = LOWERED_CAP + 5;
+    seed_marks(&meta, &d0, 0, 0, population, 0).await;
+
+    let coord = MemCoordination::new();
+    let (zone, custodian) = elect(&coord).await;
+    let fleet: [(DServerId, &dyn ChunkStore); 1] = [(0, &d0)];
+    let ctx = GcContext {
+        meta: &meta,
+        fleet: &fleet,
+        grace_window_millis: 0,
+        expired_pending: ExpiredPendingPolicy::Reclaim,
+    };
+
+    let outcome = reconcile_step(&zone, &custodian, Some(&ctx), None, None, None, 1_000_000).await;
+    assert!(
+        outcome.is_ok(),
+        "GC must survive an orphan: ledger past the cap: {outcome:?}"
+    );
+    assert_eq!(
+        *meta.orphan_scan_calls.lock().unwrap(),
+        0,
+        "no `scan` of the orphan: prefix may happen anywhere in the step"
+    );
+}
+
+// ---- leg B: one pass reads a bounded, pinned amount ------------------------------
+
+/// **(B) One pass reads a bounded, pinned amount.** No pass receives more than `B`
+/// `orphan:` entries; a pass with at least `B` remaining receives EXACTLY `B`
+/// (pinning against a silent under-read too); the population (`B + 100`, chosen so it
+/// exceeds `B` — "or this leg cannot bite") drains in exactly `⌈P / B⌉ = 2` passes, not
+/// fewer. No `scan` of the `orphan:` prefix happens anywhere in the step.
+#[tokio::test]
+async fn one_pass_reads_a_bounded_pinned_amount() {
+    let meta = PagedMeta::new();
+    let d0 = MemDServer::default();
+    let population = B + 100;
+    seed_marks(&meta, &d0, 0, 0, population, 0).await;
+
+    let coord = MemCoordination::new();
+    let (zone, custodian) = elect(&coord).await;
+    let fleet: [(DServerId, &dyn ChunkStore); 1] = [(0, &d0)];
+    let ctx = GcContext {
+        meta: &meta,
+        fleet: &fleet,
+        grace_window_millis: 0,
+        expired_pending: ExpiredPendingPolicy::Reclaim,
+    };
+
+    // Pass 1: >= B entries remain -> this pass receives EXACTLY B.
+    reconcile_step(&zone, &custodian, Some(&ctx), None, None, None, 1_000_000)
+        .await
+        .unwrap();
+    {
+        let sizes = meta.orphan_page_sizes.lock().unwrap();
+        assert_eq!(sizes.len(), 1, "one scan_page call to orphan: per pass");
+        assert_eq!(sizes[0], B, "a pass with >= B remaining reads EXACTLY B");
+    }
+    assert_eq!(
+        d0.remaining(),
+        population - B,
+        "pass 1 reclaims exactly the B fragments its page named"
+    );
+
+    // Pass 2: the remainder (100 < B) drains, not fewer, not more passes.
+    reconcile_step(&zone, &custodian, Some(&ctx), None, None, None, 2_000_000)
+        .await
+        .unwrap();
+    {
+        let sizes = meta.orphan_page_sizes.lock().unwrap();
+        assert_eq!(sizes.len(), 2);
+        assert_eq!(
+            sizes[1],
+            population - B,
+            "the short remainder page carries the whole tail"
+        );
+    }
+    assert_eq!(
+        d0.remaining(),
+        0,
+        "the whole population drains in ceil(P / B) = 2 passes, not fewer"
+    );
+    assert_eq!(*meta.orphan_scan_calls.lock().unwrap(), 0);
+}
+
+// ---- leg C: the tail does not starve ---------------------------------------------
+
+/// **(C) The tail does not starve.** A retention-safe head (`B + 1` marks, still
+/// inside their grace window, sorted first in key order by D-server id) followed by an
+/// actionable tail (3 marks, on a later-sorting D-server). Every tail fragment is
+/// reclaimed within `⌈(head + tail) / B⌉ + 1` passes, with a FRESH `GcContext` each
+/// pass, and no head fragment is ever touched. An implementation that restarted at the
+/// first page every pass would never advance past the head and would fail this.
+#[tokio::test]
+async fn the_tail_does_not_starve_behind_a_retention_safe_head() {
+    let meta = PagedMeta::new();
+    let d_head = MemDServer::default();
+    let d_tail = MemDServer::default();
+    let head = B + 1;
+    let tail = 3usize;
+    let grace = 100u64;
+    let now = 1_000_000u64;
+
+    // Head: dserver 0 (sorts first: "orphan:0:..." < "orphan:1:..." lexically at the
+    // first differing byte), orphaned_at == now, so it is inside its grace window on
+    // EVERY pass below (all use the same `now`).
+    seed_marks(&meta, &d_head, 0, 0, head, now).await;
+    // Tail: dserver 1 (sorts after every dserver-0 key), orphaned long ago -> actionable.
+    seed_marks(&meta, &d_tail, 1, 0, tail, 0).await;
+
+    let coord = MemCoordination::new();
+    let (zone, custodian) = elect(&coord).await;
+    let fleet: [(DServerId, &dyn ChunkStore); 2] = [(0, &d_head), (1, &d_tail)];
+
+    let bound = (head + tail).div_ceil(B) + 1;
+    for _ in 0..bound {
+        // A FRESH GcContext every pass, exactly as the deployed loop rebuilds one
+        // (`crates/server/src/custodian.rs:601-607`).
+        let ctx = GcContext {
+            meta: &meta,
+            fleet: &fleet,
+            grace_window_millis: grace,
+            expired_pending: ExpiredPendingPolicy::Reclaim,
+        };
+        reconcile_step(&zone, &custodian, Some(&ctx), None, None, None, now)
+            .await
+            .unwrap();
+        if d_tail.remaining() == 0 {
+            break;
+        }
+    }
+
+    assert_eq!(
+        d_tail.remaining(),
+        0,
+        "every tail fragment reclaimed within ceil((head+tail)/B) + 1 passes"
+    );
+    assert_eq!(d_head.remaining(), head, "no head fragment is ever touched");
+    assert_eq!(*meta.orphan_scan_calls.lock().unwrap(), 0);
+}
