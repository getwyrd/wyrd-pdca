+//! Issue #661 (child 1/4 of #637's split) — the `orphan:` ledger's paged walk
+//! (proposal 0016 `:1359-1404`).
+//!
+//! Two defects, both over the SAME ledger and SAME single `scan`
+//! (`orphan_leases`, base `crates/custodian/src/gc.rs:522-538`, called at `:177`;
+//! `crates/custodian/src/restore.rs:308`):
+//!
+//! 1. `scan` fails whole past `SCAN_CAP` (`wyrd_traits::SCAN_CAP`, "no partial `Vec`"),
+//!    so a ledger past the cap takes GC down on every pass from then on — and the
+//!    post-restore pass that would shrink it can never start either. Self-sealing.
+//! 2. A mark whose position holds no fragment is never visited: GC only ever consumes
+//!    an `orphan:` key while iterating an ACTUAL `list_fragments()` result. Repeated
+//!    partial uploads grow the ledger toward the same cap forever.
+//!
+//! This file proves the fix's success criterion, legs A-F (leg G, `cargo xtask ci`, is
+//! the whole-tree gate; leg E — `D` strictly inside the DEPLOYED grace window — lives
+//! in `crates/server/src/custodian.rs`'s own unit tests, since the constant it compares
+//! against, `GC_GRACE_WINDOW_MILLIS`, is private to that crate; see this bundle's
+//! `build-notes.md`).
+//!
+//! # The double
+//!
+//! [`PagedMeta`] is a from-scratch `MetadataStore` double (not a copy of `gc.rs` tests'
+//! `MemMeta`, per this bundle's brief): its `scan` enforces a LOWERED cap
+//! (`LOWERED_CAP`, shaped after `crates/metadata-redb/tests/scan.rs:9-11`) so the
+//! fail-loud arm is reachable without writing `SCAN_CAP` (2^20) keys, and its
+//! `scan_page` is implemented DIRECTLY over its own `BTreeMap` (never
+//! `wyrd_testkit::test_double_scan_page`, which pages over `scan` and would inherit
+//! the lowered cap right back) using the same shared page helpers
+//! (`wyrd_traits::{page_start, page_limit, page_is_full, page_cursor}`) a real backend
+//! uses. It records every `scan` call against the `orphan:` prefix (must stay at 0
+//! throughout every leg but F's whole-ledger read, which is `scan_page`-only too) and
+//! the size of every `orphan:` `scan_page` result, in call order — what proves leg B's
+//! per-pass bound directly.
+//!
+//! # The budget and deadline literals
+//!
+//! `B` and `D` below are hard-coded to the exact values `gc.rs` derives
+//! (`ORPHAN_PAGE_BUDGET` / `LATE_WRITE_DEADLINE_MILLIS`) — literals, not imports: this
+//! file must still COMPILE with the production change reverted (the base RED leg), and
+//! neither constant exists there (`gc.rs:522-538`'s base is a single `scan`, no
+//! budget). Per this bundle's Falsifiability note, every budget constant this slice
+//! adds appears here as a literal the test hard-codes, so a silently-shrunk budget in
+//! `gc.rs` would fail this file's own B-leg assertions rather than passing vacuously
+//! against an imported copy of itself.
+
+#![forbid(unsafe_code)]
+
+use std::collections::{BTreeMap, HashMap};
+use std::ops::Bound;
+use std::sync::Mutex;
+
+use async_trait::async_trait;
+use bytes::Bytes;
+use wyrd_coordination_mem::MemCoordination;
+use wyrd_core::metadata::{orphan_key, ORPHAN_PREFIX};
+use wyrd_custodian::{
+    reconcile_after_restore, reconcile_step, Custodian, ExpiredPendingPolicy, FencedZone, GcContext,
+};
+use wyrd_traits::{
+    ChunkId, ChunkStore, CommitOutcome, DServerId, FragmentId, Health, MetadataStore, Result,
+    ScanPage, WriteBatch,
+};
+
+/// Mirrors `wyrd_custodian::gc::ORPHAN_PAGE_BUDGET` — the literal, per this file's own
+/// module docs above (Falsifiability: the base RED leg must still compile, and the
+/// symbol does not exist there).
+const B: usize = 65_536;
+
+/// Mirrors `wyrd_custodian::gc::LATE_WRITE_DEADLINE_MILLIS` — same reason.
+const D: u64 = 16_000;
+
+/// The metadata double's own scan cap — LOWERED so the fail-loud arm is reachable
+/// without writing `SCAN_CAP` (2^20) keys, exactly as `metadata-redb/tests/scan.rs`'s
+/// `LOWERED_CAP = 8` does for the same reason.
+const LOWERED_CAP: usize = 8;
+
+// ---- the metadata double ------------------------------------------------------
+
+/// A from-scratch `MetadataStore` double: `scan` fails loud past [`LOWERED_CAP`]
+/// (never a partial `Vec`); `scan_page` is a DIRECT implementation over the same
+/// `BTreeMap`, escaping that cap exactly as a real backend's `scan_page` must
+/// (`crates/traits/src/lib.rs:1430-1437`'s contract) — never delegated to
+/// `wyrd_testkit::test_double_scan_page`, which pages over `scan` and would inherit
+/// the lowered cap right back, defeating every leg below.
+#[derive(Default)]
+struct PagedMeta {
+    kv: Mutex<BTreeMap<Vec<u8>, Bytes>>,
+    /// How many `orphan:`-prefixed `scan_page` results this double has returned, in
+    /// call order, each entry the page's item count — what leg B's per-pass bound is
+    /// checked against directly.
+    orphan_page_sizes: Mutex<Vec<usize>>,
+    /// How many times `scan` (never `scan_page`) was called with the `orphan:`
+    /// prefix. Every leg below asserts this stays 0 throughout (`0016:1392-1404`:
+    /// "orphan: therefore joins retire: as a namespace never read by a single scan").
+    orphan_scan_calls: Mutex<usize>,
+}
+
+impl PagedMeta {
+    fn new() -> Self {
+        Self::default()
+    }
+
+    async fn put_raw(&self, key: Vec<u8>, value: impl Into<Bytes>) {
+        self.commit(WriteBatch::new().put(key, value.into()))
+            .await
+            .unwrap();
+    }
+}
+
+#[async_trait]
+impl MetadataStore for PagedMeta {
+    async fn get(&self, key: &[u8]) -> Result<Option<Bytes>> {
+        Ok(self.kv.lock().unwrap().get(key).cloned())
