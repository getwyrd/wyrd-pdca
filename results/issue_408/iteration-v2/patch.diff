+//! **The live checked-consistency run under a #407 nemesis leg** (#408, slice 5 of #329;
+//! ADR-0041 "nemesis first, then the checked artifact"). Hosts the production server + S3
+//! gateway on a loopback listener — the composition `s3_http_wire.rs`'s `start_gateway` and
+//! #405's `consistency_observable.rs` test already mirror — backed by the real
+//! `FdbMetadataStore` pointed at the live `deploy/fdb-multi-replica` cluster
+//! (`crates/server/src/cli.rs:122,141`, `crates/server/Cargo.toml:31`). It drives the #406
+//! checked register + directory workload (`consistency_observable::ObservableS3Client`,
+//! `consistency_workload::{MultiProcessHistory, DirectoryHistory}`) through concurrent clients,
+//! injects a #407 nemesis leg mid-window via `wyrd_metadata_fault_conformance::nemesis::drive_leg`
+//! — consumed **as-is**, never reopening its lifecycle logic (the brief's Ordering note) — and
+//! writes the Elle-EDN histories plus a machine-readable **run summary** under
+//! `$WYRD_CONSISTENCY_OUTPUT_DIR` (`target/consistency-run/` by default): the seam
+//! `xtask::consistency_run` (Design §2) derives the non-vacuity gate / elle-cli verdict / report
+//! from, entirely off this file.
+//!
+//! # The #407 typed materialization evidence — carried, not asserted (T2)
+//!
+//! The run summary carries the leg's OWN [`MaterializationEvidence`]
+//! (`kind()`/`materialized()`/`diagnosis()`), sampled by [`NemesisLeg::confirm_materialized`]
+//! **inside the fault window** (the `drive_leg` workload closure, where the fault is still
+//! active). `drive_leg` has already gated materialization before entering the closure, so this
+//! second sample returns fast; it exists to record *what the leg observed* — which fault, on
+//! which target, how it provably bit — into `run-summary.json` and the report, instead of a
+//! hard-coded `nemesis_materialized = true` boolean (the iteration-1 defect). The `confirm_*`
+//! call is read-only (a survivor `status json` reachability probe / a `docker inspect` /
+//! a container clock read), so re-sampling it does not perturb the fault or the workload.
+//!
+//! **Off-Check by construction.** `#[ignore]`d, `fdb`-feature-gated, and env-gated: absent
+//! `WYRD_FDB_CLUSTER_FILE` it skips cleanly (mirrors
+//! `crates/metadata-fdb/tests/tier1_metadata_nemesis.rs`'s clean-skip shape), so `cargo xtask ci`
+//! stays green with no FDB, no Docker, no JVM (the test-graph constraint: this file is compiled
+//! only under `--features fdb`, never in the default build graph the named xtask orchestration
+//! test's crate lives in). Launched only by `WYRD_TIER1=1 cargo xtask consistency-run`
+//! (`xtask/src/consistency_run_runner.rs`), which resolves the fault topology, exports every
+//! env var this file reads, and derives the verdict/report from the summary + elle-cli output —
+//! this file never shells `java` (ADR-0041's own MUST).
+
+/// The FDB cluster file, or `None` when FDB is not configured (clean-skip gate — mirrors
+/// `tier1_metadata_nemesis.rs::cluster_file`).
+fn cluster_file() -> Option<String> {
+    match std::env::var("WYRD_FDB_CLUSTER_FILE") {
+        Ok(raw) if !raw.trim().is_empty() => Some(raw.trim().to_string()),
+        _ => None,
+    }
+}
+
+#[test]
+#[ignore = "privileged #408: live 3-process FDB cluster + a #407 nemesis leg (cargo xtask consistency-run)"]
+fn consistency_run_fdb() {
+    let Some(cluster_file) = cluster_file() else {
+        eprintln!(
+            "wyrd-server: WYRD_FDB_CLUSTER_FILE not set — skipping the #408 checked consistency \
+             run."
+        );
+        return;
+    };
+    run(cluster_file);
+}
+
+/// Without `--features fdb` the crate cannot link `libfdb_c`, so the live body is compiled out;
+/// this stub keeps the test binary building under the default `cargo xtask ci` gate and skips
+/// loudly if a cluster file is somehow set (mirrors `tier1_metadata_nemesis.rs`'s
+/// `skip_without_fdb`).
+#[cfg(not(feature = "fdb"))]
+fn run(cluster_file: String) {
+    let _ = cluster_file;
+    eprintln!(
+        "wyrd-server: WYRD_FDB_CLUSTER_FILE is set but the crate was built without `--features \
+         fdb` — skipping the #408 checked consistency run. Run via `cargo xtask consistency-run`."
+    );
+}
+
+#[cfg(feature = "fdb")]
+fn run(cluster_file: String) {
+    use std::net::SocketAddr;
+    use std::path::PathBuf;
+    use std::sync::Arc;
+
+    use wyrd_chunkstore_fs::FsChunkStore;
+    use wyrd_coordination_mem::MemCoordination;
+    use wyrd_gateway_s3::sigv4::Credentials;
+    use wyrd_gateway_s3::{S3Config, S3Gateway};
+    use wyrd_metadata_fault_conformance::nemesis::{ClockSkewLeg, PartitionLeg, ProcessPauseLeg};
+    use wyrd_metadata_fdb::FdbMetadataStore;
+    use wyrd_server::Gateway;
+
+    const ACCESS_KEY: &str = "AKIAIOSFODNN7EXAMPLE";
+    const SECRET_KEY: &str = "wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY";
+
+    type Backend = Gateway<FdbMetadataStore, FsChunkStore, MemCoordination>;
+
+    fn required_env(name: &str) -> String {
+        std::env::var(name).unwrap_or_else(|_| {
+            panic!("{name} must be set by the runner (cargo xtask consistency-run)")
+        })
+    }
+
+    let leg_kind = std::env::var("WYRD_CONSISTENCY_NEMESIS")
+        .unwrap_or_else(|_| "network-partition".to_string());
+    let target_addr = required_env("WYRD_CONSISTENCY_TARGET_ADDR");
+    let target_ip = required_env("WYRD_CONSISTENCY_TARGET_IP");
+    let target_service = required_env("WYRD_CONSISTENCY_TARGET_SERVICE");
+    let target_container = required_env("WYRD_CONSISTENCY_TARGET_CONTAINER");
+    let survivor_container = required_env("WYRD_CONSISTENCY_SURVIVOR_CONTAINER");
+    let iptables_image = std::env::var("WYRD_CONSISTENCY_IPTABLES_IMAGE")
+        .unwrap_or_else(|_| "wyrd-iptables:local".to_string());
+    let compose_file = required_env("WYRD_CONSISTENCY_COMPOSE_FILE");
+    let faketime_override = required_env("WYRD_CONSISTENCY_FAKETIME_OVERRIDE");
+    let output_dir = PathBuf::from(required_env("WYRD_CONSISTENCY_OUTPUT_DIR"));
+    std::fs::create_dir_all(&output_dir).expect("create the consistency-run output dir");
+
+    // How the report names the node the fault hit (service + container + address) — the "which
+    // target" half of the typed evidence.
+    let target_desc = format!("{target_service} ({target_container} @ {target_addr})");
+
+    let runtime = tokio::runtime::Builder::new_multi_thread()
+        .enable_all()
+        .build()
+        .expect("tokio runtime");
+
+    // ── Bring-up: the production server + S3 gateway on loopback, backed by the real
+    // FdbMetadataStore (the `s3_http_wire.rs` / #405 composition, over the live cluster). The
+    // spawned `serve` task keeps running on `runtime` across the later `block_on` calls below —
+    // including the one made WHILE the nemesis fault is active.
+    let addr: SocketAddr = runtime.block_on(async {
+        let dir = tempfile::tempdir().expect("temp dir");
+        let prefix = format!("wyrd-consistency-run/{}/", std::process::id()).into_bytes();
+        let store = FdbMetadataStore::open(&cluster_file)
+            .expect("open the FoundationDB metadata store")
+            .with_prefix(prefix);
+        let gateway: Arc<Backend> = Arc::new(Gateway::new(
+            store,
+            FsChunkStore::open(dir.path()).expect("fs store"),
+            MemCoordination::new(),
+        ));
+        let config = S3Config::new(vec![Credentials {
+            access_key_id: ACCESS_KEY.to_string(),
+            secret_access_key: SECRET_KEY.to_string(),
+        }]);
+        let listener = tokio::net::TcpListener::bind("127.0.0.1:0")
+            .await
+            .expect("bind");
+        let addr = listener.local_addr().expect("addr");
+        let server = S3Gateway::new(Arc::clone(&gateway), config);
+        tokio::spawn(async move {
+            server.serve(listener).await.expect("serve");
+        });
+        // The chunk-store tempdir must outlive the whole scenario process; a short-lived,
+        // opt-in, single-shot process leaking one tempdir is the same trade `s3_http_wire.rs`
+        // makes by RETURNING its `TempDir` guard to the caller — here there is no caller to
+        // hold it, so it is deliberately forgotten rather than dropped mid-run.
+        std::mem::forget(dir);
+        addr
+    });
+
+    // Drive one leg end-to-end via `drive_leg` (consumed as-is), sampling the leg's OWN typed
+    // materialization evidence INSIDE the fault window (T2) so the run summary carries what the
+    // leg observed — not a hard-coded boolean. The `drive_with_evidence` module-level helper
+    // does the sampling.
+    let (nemesis, register, directory) = match leg_kind.as_str() {
+        "network-partition" | "partition" => {
+            let leg = PartitionLeg::new(
+                target_addr,
+                target_ip,
+                target_container,
+                survivor_container,
+                iptables_image,
+            );
+            drive_with_evidence(&leg, &runtime, addr, &target_desc)
+        }
+        "clock-skew" => {
+            let floor_secs = std::env::var("WYRD_CONSISTENCY_SKEW_FLOOR_SECS")
+                .ok()
+                .and_then(|v| v.parse::<u64>().ok())
+                .unwrap_or(60);
+            let leg = ClockSkewLeg::new(
+                compose_file,
+                faketime_override,
+                target_service,
+                target_container,
+                survivor_container,
+                floor_secs,
+            );
+            drive_with_evidence(&leg, &runtime, addr, &target_desc)
+        }
+        "process-pause" => {
+            let leg = ProcessPauseLeg::new(target_addr, target_container, survivor_container);
+            drive_with_evidence(&leg, &runtime, addr, &target_desc)
+        }
+        other => panic!(
+            "unknown WYRD_CONSISTENCY_NEMESIS leg `{other}` (expected `network-partition` \
+             [default], `clock-skew`, or `process-pause`)"
+        ),
+    };
+
+    let genuinely_concurrent = register.is_genuinely_concurrent();
+    let register_ops = register.ops().len();
+    let directory_ops = directory.ops().len();
+
+    std::fs::write(
+        output_dir.join("register-history.edn"),
+        register.to_elle_edn(),
+    )
+    .expect("write register-history.edn");
+    std::fs::write(
+        output_dir.join("directory-history.edn"),
+        directory.to_elle_edn(),
+    )
+    .expect("write directory-history.edn");
+
+    let workload_description =
+        "register overwrite PUT/GET (2 processes: writer, reader) + directory create/delete/\
+         probe (2 processes: creator/deleter, prober), over the S3 wire against the live FDB \
+         cluster";
+    // Build the run summary with `serde_json` so the nested typed-evidence object is emitted with
+    // the exact field names `xtask::consistency_run::{RunSummary, NemesisEvidence}` deserialize —
+    // the Design §2 seam. The evidence's `materialized`/`diagnosis` are the leg's own, so the
+    // xtask-side non-vacuity gate reads a real oracle verdict, never a boolean asserted here.
+    let summary = serde_json::json!({
+        "workload": workload_description,
+        "nemesis": {
+            "kind": nemesis.kind,
+            "target": nemesis.target,
+            "materialized": nemesis.materialized,
+            "diagnosis": nemesis.diagnosis,
+        },
+        "genuinely_concurrent": genuinely_concurrent,
+        "register_ops": register_ops,
+        "directory_ops": directory_ops,
+    });
+    std::fs::write(
+        output_dir.join("run-summary.json"),
+        serde_json::to_string_pretty(&summary).expect("serialize run summary"),
+    )
+    .expect("write run-summary.json");
+
+    assert!(
+        nemesis.materialized,
+        "the leg's typed evidence must attest a materialized fault by the time the workload ran — \
+         drive_leg gated it, but the run summary now records the leg's OWN verdict: {}",
+        nemesis.diagnosis
+    );
+    assert!(
+        genuinely_concurrent,
+        "the checked register workload produced NO genuinely concurrent (#406 INV-2) overlap — \
+         the run summary would be vacuous and the runner's non-vacuity gate would refuse a \
+         verdict; register ops recorded: {register_ops}"
+    );
+    assert!(
+        register_ops > 0 && directory_ops > 0,
+        "both the register and directory histories must be non-empty (register: {register_ops}, \
+         directory: {directory_ops})"
+    );
+}
+
+/// A leg-agnostic snapshot of the #407 typed materialization evidence, built from any
+/// [`MaterializationEvidence`] (`kind`/`materialized`/`diagnosis`) plus the target it hit — the
+/// shape serialized into `run-summary.json`'s `nemesis` object and deserialized by
+/// `xtask::consistency_run::NemesisEvidence`.
+#[cfg(feature = "fdb")]
+struct NemesisEvidenceRecord {
+    kind: String,
+    target: String,
+    materialized: bool,
+    diagnosis: String,
+}
+
+#[cfg(feature = "fdb")]
+impl NemesisEvidenceRecord {
+    fn from_evidence<E>(evidence: &E, target: &str) -> Self
+    where
+        E: wyrd_metadata_fault_conformance::nemesis::MaterializationEvidence,
+    {
+        Self {
+            kind: evidence.kind().as_str().to_string(),
+            target: target.to_string(),
+            materialized: evidence.materialized(),
+            diagnosis: evidence.diagnosis(),
+        }
+    }
+}
+
+/// Drive one nemesis leg end-to-end via `drive_leg` (consumed as-is, never reopening its
+/// lifecycle logic), capturing the leg's OWN typed materialization evidence INSIDE the fault
+/// window (T2). `drive_leg` gates materialization before it enters this closure, so the
+/// `confirm_materialized` re-sample here returns fast; it is a read-only survivor/inspect/clock
+/// probe, so re-sampling perturbs neither the fault nor the workload. Returns the typed evidence
+/// record alongside the merged register + directory histories.
+#[cfg(feature = "fdb")]
+fn drive_with_evidence<L>(
+    leg: &L,
+    runtime: &tokio::runtime::Runtime,
+    addr: std::net::SocketAddr,
+    target_desc: &str,
+) -> (
+    NemesisEvidenceRecord,
+    wyrd_server::consistency_workload::MultiProcessHistory,
+    wyrd_server::consistency_workload::DirectoryHistory,
+)
+where
+    L: wyrd_metadata_fault_conformance::nemesis::NemesisLeg,
+{
+    use wyrd_metadata_fault_conformance::nemesis::{drive_leg, NemesisLeg};
+    drive_leg(leg, || {
+        let evidence = <L as NemesisLeg>::confirm_materialized(leg).expect(
+            "re-sample the nemesis materialization evidence inside the fault window (the leg \
+             already gated materialization, so this returns fast)",
+        );
+        let record = NemesisEvidenceRecord::from_evidence(&evidence, target_desc);
+        let (register, directory) = runtime.block_on(drive_checked_workload(addr));
+        (record, register, directory)
+    })
+    .expect("nemesis leg must materialize, drive the checked workload, and heal completely")
+}
+
+/// Drive the #406 checked register + directory workload over the real S3 wire and return the
+/// merged, real-time-ordered histories — called from INSIDE the nemesis fault window (the
+/// `drive_leg` workload closure), so every op genuinely races the fault.
+#[cfg(feature = "fdb")]
+async fn drive_checked_workload(
+    addr: std::net::SocketAddr,
+) -> (
+    wyrd_server::consistency_workload::MultiProcessHistory,
+    wyrd_server::consistency_workload::DirectoryHistory,
+) {
+    use wyrd_gateway_s3::sigv4::Credentials;
+    use wyrd_server::consistency_observable::{ObservableS3Client, OpKind};
+    use wyrd_server::consistency_workload::{
+        DirOpKind, DirRecord, DirectoryHistory, MultiProcessHistory,
+    };
+
+    const ACCESS_KEY: &str = "AKIAIOSFODNN7EXAMPLE";
+    const SECRET_KEY: &str = "wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY";
+    const REGION: &str = "us-east-1";
+    const BUCKET: &str = "wyrd-consistency-run";
+    const ROUNDS: u64 = 60;
+
+    fn client(addr: std::net::SocketAddr) -> ObservableS3Client {
+        let creds = Credentials {
+            access_key_id: ACCESS_KEY.to_string(),
+            secret_access_key: SECRET_KEY.to_string(),
+        };
+        ObservableS3Client::new(addr, BUCKET, creds, REGION)
+    }
+
+    // ── Register model: process 0 the sole writer overwriting a shared key, process 1 a
+    // concurrent reader — the SAME positive-witness shape #406's own
+    // `concurrent_workload_records_a_nonvacuous_genuinely_concurrent_history` test proves
+    // produces a real-time-overlapping same-key read↔write pair across distinct processes
+    // (INV-2), driven here against the LIVE cluster instead of the in-memory redb backend.
+    let register_barrier = std::sync::Arc::new(tokio::sync::Barrier::new(2));
+    let writer = {
+        let mut c = client(addr);
+        let barrier = register_barrier.clone();
+        tokio::spawn(async move {
+            barrier.wait().await;
+            for v in 1..=ROUNDS {
+                let _ = c.put("checked-register", v).await;
+            }
+            c.into_history()
+        })
+    };
+    let reader = {
+        let mut c = client(addr);
+        let barrier = register_barrier.clone();
+        tokio::spawn(async move {
+            barrier.wait().await;
+            for _ in 0..ROUNDS {
+                let _ = c.get("checked-register").await;
+            }
+            c.into_history()
+        })
+    };
+    let register_histories = vec![
+        writer.await.expect("writer task"),
+        reader.await.expect("reader task"),
+    ];
+    let register = MultiProcessHistory::merge(&register_histories);
+
+    // ── Directory-as-set model: process 0 creates then deletes members, process 1 probes them
+    // concurrently. Over this S3 floor, create=PUT / delete=DELETE / membership=GET-probe ARE
+    // the wire calls `ObservableS3Client::put/delete/get` already drives
+    // (`consistency_workload.rs:18-20`) — so the SAME real wire round trips are reinterpreted
+    // as directory ops below, rather than adding new production wire-calling code.
+    let dir_barrier = std::sync::Arc::new(tokio::sync::Barrier::new(2));
+    let mutator = {
+        let mut c = client(addr);
+        let barrier = dir_barrier.clone();
+        tokio::spawn(async move {
+            barrier.wait().await;
+            for i in 0..ROUNDS {
+                let member = format!("dir/member-{i}");
+                let _ = c.put(&member, 1).await; // create
+                let _ = c.delete(&member).await; // delete
+            }
+            c.into_history()
+        })
+    };
+    let prober = {
+        let mut c = client(addr);
+        let barrier = dir_barrier.clone();
+        tokio::spawn(async move {
+            barrier.wait().await;
+            for i in 0..ROUNDS {
+                let member = format!("dir/member-{i}");
+                let _ = c.get(&member).await; // membership probe
+            }
+            c.into_history()
+        })
+    };
+    let mutator_history = mutator.await.expect("mutator task");
+    let prober_history = prober.await.expect("prober task");
+
+    let mut dir_records: Vec<DirRecord> = Vec::new();
+    for (process, history) in [mutator_history, prober_history].iter().enumerate() {
+        for op in history.ops() {
+            let op_kind = match op.kind {
+                OpKind::Put => DirOpKind::Create,
+                OpKind::Delete => DirOpKind::Delete,
+                OpKind::Get => DirOpKind::Probe,
+            };
+            dir_records.push(DirRecord {
+                process,
+                op: op_kind,
+                member: op.key.clone(),
+                status: op.status,
+                start: op.start,
+                end: op.end,
+            });
+        }
+    }
+    dir_records.sort_by(|a, b| a.start.cmp(&b.start).then(a.end.cmp(&b.end)));
+    let directory = DirectoryHistory::from_records(dir_records);
+
+    (register, directory)
+}
