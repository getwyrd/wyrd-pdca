+/// Sorted and de-duplicated so the bytes are stable and the set carries each element once.
+fn edn_int_set(ids: &[u64]) -> String {
+    let mut sorted: Vec<u64> = ids.to_vec();
+    sorted.sort_unstable();
+    sorted.dedup();
+    let joined = sorted
+        .iter()
+        .map(u64::to_string)
+        .collect::<Vec<_>>()
+        .join(" ");
+    format!("#{{{joined}}}")
