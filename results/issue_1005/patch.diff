+    let (r, n508) = (Expected::Required, unsupported(508, 501, NIMPL));
+    let invalid = unsupported(511, 400, DeclaredCode::Code("InvalidRequest"));
+    let mut want: Vec<(Operation, Expected)> = vec![
+        (PutObject, r),
+        (GetObject, r),
+        (GetObjectRanged, r),
+        (GetObjectIfNoneMatchHit, r),
