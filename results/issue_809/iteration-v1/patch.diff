+/// Check again the attempt an **already-fenced** session's fence ended, if it ended one: "already
+/// `Aborting`" never means "nothing to report" — skipping such a session would drop, on the very
+/// next run, a finding the fence made on this one.
+///
+/// A fence from `Completing@E` to `Aborting@E+1` installed `retire:records:s:<id>:<E>`, naming the
+/// attempt's segment group, and no other way into `Aborting@E+1` files a records obligation under
+/// that token (a rollback files one at the epoch it rolls back from, and leaves the session
+/// `Open`). So for a session at `Aborting@E'`, the records obligation at `E' - 1` — one keyed read,
+/// never a range read of `retire:` — names the one attempt this check applies to, and it is
+/// checked exactly as the fence checked it ([`read_attempt`]). A session named on an earlier run is
+/// named again, for as long as that obligation stands. An obligation there that will not decode
+/// cannot be checked, and is named too.
+///
+/// deferred: #659 — this reads the session's part records, which the fence's other obligation
+/// (`retire:bytes:{session, parts}`) deletes once it has marked their bytes. The drain that does so
+/// does not exist yet; once it does, a run landing after it deleted part records but before the
+/// segment records are gone would find segment chunks no part holds any more. Ordering the two
+/// drains, or checking the drain's progress here, is that slice's to settle.
+async fn recheck_ended_attempt(
+    meta: &dyn MetadataStore,
+    upload: &UploadId,
+    record: &SessionRecord,
+    session: &str,
+) -> Result<SessionFence> {
+    let Some(ended) = record.epoch().checked_sub(1) else {
+        return Ok(SessionFence::UNTOUCHED);
+    };
+    let token = RetireToken::Session {
+        upload_id: upload.clone(),
+        epoch: ended,
+        part: None,
+    };
+    let key = retire_key(RetireMode::Records, &token);
+    let Some(value) = meta.get(&key).await? else {
+        return Ok(SessionFence::UNTOUCHED);
+    };
+    let attempt = match decode_retire_obligation(&key, &value) {
+        Ok((_, _, payload)) => match payload.segments() {
+            Some(group) => group.clone(),
+            None => return Ok(SessionFence::UNTOUCHED),
+        },
+        Err(fault) => {
+            emit_session_unsettled(
+                session,
+                &format!(
+                    "the obligation {} retiring its ended attempt's segment records will not \
+                     decode, so the attempt cannot be checked: {fault}",
+                    object_name(&key)
+                ),
+            );
+            return Ok(SessionFence::UNSETTLED);
+        }
+    };
+    match read_attempt(meta, upload, &attempt).await?.doubt() {
+        Some(why) => {
+            emit_session_unsettled(session, &why);
+            Ok(SessionFence::UNSETTLED)
+        }
+        None => Ok(SessionFence::UNTOUCHED),
     }
 }
 
