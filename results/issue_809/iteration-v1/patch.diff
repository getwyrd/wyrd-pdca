+/// Read the records of the attempt `attempt` names — the session's part range, then that
+/// segment group's range — each in bounded pages ([`walk_staged_range`]), never one `scan`
+/// (`0016:890`: `part:` is at most `MAX_PARTS_PER_SESSION` records, `seg:` at most
+/// `MAX_ROOT_SEGMENTS`).
+///
+/// A record that cannot be read is noted, not raised: what it would have said is unknown, so it is
+/// a human's (ADR-0045 decision 3). A key under the segment range is checked against the group it
+/// was read for rather than trusted to the store's prefix handling, as the resolver does
+/// (`metadata::read_group_range`). A store fault propagates.
+async fn read_attempt(
+    meta: &dyn MetadataStore,
+    upload: &UploadId,
+    attempt: &SegmentGroup,
+) -> Result<Attempt> {
+    let mut read = Attempt::default();
+    walk_staged_range(meta, &part_range(upload), |key, value| {
+        match parse_part_key(key) {
+            Ok((_, number)) => {
+                read.parts.insert(number);
+            }
+            Err(fault) => {
+                read.unreadable.push(format!(
+                    "the part record {} has a key no obligation can name: {fault}",
+                    object_name(key)
+                ));
+                return;
+            }
+        }
+        match decode_part_record(value) {
+            Ok(part) => read
+                .part_chunks
+                .extend(part.chunks().iter().map(|chunk| chunk.id)),
+            Err(fault) => read.unreadable.push(format!(
+                "the part record {} will not decode, so the chunks it holds are unknown: {fault}",
+                object_name(key)
+            )),
+        }
+    })
+    .await?;
+    walk_staged_range(meta, &metadata::seg_range_prefix(attempt), |key, value| {
+        let ours = matches!(
+            metadata::parse_seg_key(key),
+            Ok((nonce, epoch, _)) if nonce == *attempt.nonce() && epoch == attempt.epoch()
+        );
+        if !ours {
+            read.unreadable.push(format!(
+                "the key {} under the attempt's segment range is not one of its segment records",
+                object_name(key)
+            ));
+            return;
+        }
+        match metadata::decode::<SegmentRecord>(value) {
+            Ok(segment) => read
+                .segment_chunks
+                .extend(segment.chunks().iter().map(|chunk| chunk.id)),
+            Err(fault) => read.unreadable.push(format!(
+                "the segment record {} will not decode, so whether its chunks are the parts' \
+                 cannot be told: {fault}",
+                object_name(key)
+            )),
+        }
+    })
+    .await?;
+    Ok(read)
+}
