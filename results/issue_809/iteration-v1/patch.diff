+/// What the fence did over every listed session, and what it could not settle.
+#[derive(Default)]
+struct Fence {
+    /// Sessions whose fence batch committed on this run.
+    fenced: usize,
+    /// The `mpu:` keys of the sessions a human has to look at
+    /// ([`RestoreReport::sessions_unsettled`]).
+    unsettled: BTreeSet<Vec<u8>>,
+}
+
+/// What the fence made of one session: whether this run fenced it, and whether it needs a human.
+/// The two are independent — an ended attempt whose records the fence cannot account for is both.
+#[derive(Clone, Copy)]
+struct SessionFence {
+    fenced: bool,
+    unsettled: bool,
+}
+
+impl SessionFence {
+    /// Nothing to do: published, or fenced before with nothing left unaccounted for.
+    const UNTOUCHED: Self = Self {
+        fenced: false,
+        unsettled: false,
+    };
+    /// Fenced on this run, every record it wrote accounted for.
+    const FENCED: Self = Self {
+        fenced: true,
+        unsettled: false,
+    };
+    /// Not fenced on this run, and a human's to look at.
+    const UNSETTLED: Self = Self {
+        fenced: false,
+        unsettled: true,
+    };
+}
+
+/// **The restore fence** (`0016:717-728`, D-B; the restore row of decision 2's table, `:823`): list
+/// every session under `mpu:` and settle each one ([`fence_session`]).
+///
+/// The listing is read in bounded pages through the staged reader's own page read
+/// ([`staged_page`]) — never one `scan` of the namespace (`0016:890`) — and each session is settled
+/// before the next page is read, so what one session costs is its own records, never the fleet's.
+/// A key naming no upload is passed over: it names no token a fence could be filed under, and the
+/// staged read names it in [`RestoreReport::unresolvable`] ([`attribute_staged`]), where it
+/// withholds every mark.
+///
+/// Every read and commit the fence makes is bounded as every other custodian store call is, by
+/// the `MetadataStore` implementation's own network bound (#508/#636); one that fails, fails the
+/// pass.
+async fn fence_sessions(meta: &dyn MetadataStore) -> Result<Fence> {
+    let mut fence = Fence::default();
+    let mut after: Option<Vec<u8>> = None;
+    loop {
+        let (sessions, next) = staged_page(meta, MPU_PREFIX, after.as_deref()).await?;
+        for (key, value) in &sessions {
+            let Ok(upload) = parse_mpu_key(key) else {
+                continue;
+            };
+            let settled = fence_session(meta, &upload, key, value).await?;
+            fence.fenced += usize::from(settled.fenced);
+            if settled.unsettled {
+                fence.unsettled.insert(key.clone());
+            }
+        }
+        match (next, sessions.into_iter().last()) {
+            (Some(_), Some((last, _))) => after = Some(last),
+            _ => return Ok(fence),
+        }
+    }
+}
+
+/// Settle one listed session. Every outcome is named on the audit seam the moment it is known,
+/// ahead of the next store read.
+///
+/// - **`Open@E`** → `Aborting@E+1`, with `retire:bytes:{session, all}`
+///   ([`RetirePayload::open_teardown`]).
+/// - **`Completing@E`** → `Aborting@E+1`, with `retire:bytes:{session, parts}` **and**
+///   `retire:records:{seg}` naming the attempt's segment group
+///   ([`RetirePayload::completing_teardown`]) — X57 (`0016:880`): fenced as if it were `Open`, the
+///   segment records its attempt wrote would have no deleter anywhere. The group comes from the
+///   record's own publish target; the parts from the session's part range ([`read_attempt`]).
+/// - **`Aborting`** is fenced already and is not fenced again — but the attempt its fence ended,
+///   if it ended one, is checked again ([`recheck_ended_attempt`]).
+/// - **`Completed`** published; there is nothing to fence.
+/// - A value that **will not decode** says nothing the pass may act on — not even which state it
+///   is in — so the record is left byte-identical (ADR-0045 decision 3) and the session is named.
+///   A `Completing` record from before its segment-group nonce was stored is one: the fence could
+///   not name the segment records it would have to retire.
+async fn fence_session(
+    meta: &dyn MetadataStore,
+    upload: &UploadId,
+    key: &[u8],
+    value: &[u8],
+) -> Result<SessionFence> {
+    let session = object_name(key);
+    let record = match decode_session_record(value) {
+        Ok(record) => record,
+        Err(fault) => {
+            emit_session_unsettled(
+                &session,
+                &format!(
+                    "the session record will not decode, so it was left as it is, not fenced: \
+                     {fault}"
+                ),
+            );
+            return Ok(SessionFence::UNSETTLED);
+        }
+    };
+    match record.state() {
+        SessionState::Open {} => {
+            let obligation = RetirePayload::open_teardown(upload, record.epoch());
+            commit_fence(meta, key, value, &record, &[obligation], &session).await
         }
+        SessionState::Completing { publish_target, .. } => {
+            let attempt = publish_target.segment_group();
+            let read = read_attempt(meta, upload, &attempt).await?;
+            let doubt = read.doubt();
+            if let Some(why) = &doubt {
+                emit_session_unsettled(&session, why);
+            }
+            let obligations = RetirePayload::completing_teardown(upload, &attempt, read.part_set());
+            let settled = commit_fence(meta, key, value, &record, &obligations, &session).await?;
+            Ok(SessionFence {
+                unsettled: settled.unsettled || doubt.is_some(),
+                ..settled
+            })
+        }
+        SessionState::Aborting {} => recheck_ended_attempt(meta, upload, &record, &session).await,
+        SessionState::Completed { .. } => Ok(SessionFence::UNTOUCHED),
+    }
+}
+
+/// Commit one session's fence as **one** batch: `require` the session record's exact bytes as
+/// read and `require_absent` every obligation's key (`0016:659-673` — every row that installs an
+/// obligation carries it: a token is minted once, so an obligation already under it is not this
+/// fence's to overwrite), then put the fenced record and every obligation. One batch, so no
+/// interleaving or crash leaves a session fenced without the deleters its teardown owes, or an
+/// obligation installed for a session still able to publish.
+///
+/// `Conflict` wrote nothing: the session changed since this pass read it, or an obligation already
+/// sits under the fence's token. The session is not fenced, and it is named. An `Err` — a store
+/// fault, or a commit whose outcome is unknown — fails the pass rather than being read as a clean
+/// conflict, since the batch may have landed; the next run reads the session again, and its
+/// `require` makes a replay a `Conflict`.
+async fn commit_fence(
+    meta: &dyn MetadataStore,
+    key: &[u8],
+    prior: &[u8],
+    record: &SessionRecord,
+    obligations: &[(Vec<u8>, RetirePayload)],
+    session: &str,
+) -> Result<SessionFence> {
+    let Some(fenced) = record.fence_to_aborting() else {
+        emit_session_unsettled(
+            session,
+            &format!(
+                "its epoch {} has no successor to fence it to, so it was left as it is",
+                record.epoch()
+            ),
+        );
+        return Ok(SessionFence::UNSETTLED);
+    };
+    let mut batch = WriteBatch::new().require(key.to_vec(), prior.to_vec());
+    for (obligation, _) in obligations {
+        batch = batch.require_absent(obligation.clone());
+    }
+    batch = batch.put(key.to_vec(), metadata::encode(&fenced));
+    for (obligation, payload) in obligations {
+        batch = batch.put(obligation.clone(), metadata::encode(payload));
+    }
+    match meta.commit(batch).await? {
+        CommitOutcome::Committed => {
+            emit_session_fenced(session, record.epoch(), fenced.epoch(), obligations);
+            Ok(SessionFence::FENCED)
+        }
+        CommitOutcome::Conflict => {
+            emit_session_unsettled(
+                session,
+                "the fence lost its compare-and-set and wrote nothing: the session record changed \
+                 since this pass read it, or an obligation already sits under the fence's key",
+            );
+            Ok(SessionFence::UNSETTLED)
+        }
+    }
+}
