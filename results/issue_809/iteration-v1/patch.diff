+/// An ended `Completing` attempt's own records, as the fence reads them: the session's parts —
+/// the set its bytes obligation names, and the chunks they hold — and the chunks the attempt's
+/// segment records name.
+#[derive(Default)]
+struct Attempt {
+    /// The part numbers of the session's part records whose key parses.
+    parts: BTreeSet<PartNumber>,
+    /// Every chunk a part record that decodes holds.
+    part_chunks: HashSet<ChunkId>,
+    /// Every chunk a segment record of the attempt names.
+    segment_chunks: BTreeSet<ChunkId>,
+    /// The records that could not be read, and why, in the order they were met.
+    unreadable: Vec<String>,
+}
+
+impl Attempt {
+    /// The part set the bytes obligation names, or `None` for a session holding no part.
+    fn part_set(&self) -> Option<PartNumberSet> {
+        PartNumberSet::from_numbers(self.parts.iter().copied())
+    }
+
+    /// Why the teardown's obligations would not account for everything the attempt wrote, if they
+    /// would not: a record they cannot name or that cannot be read, or a segment record naming a
+    /// chunk no part record holds. The records obligation deletes segment records **without**
+    /// marking — their chunks are meant to be the parts', which the bytes obligation marks — so
+    /// such a chunk's fragments would be left with nothing naming them and nothing to reclaim them.
+    fn doubt(&self) -> Option<String> {
+        let strays: Vec<String> = self
+            .segment_chunks
+            .iter()
+            .filter(|chunk| !self.part_chunks.contains(chunk))
+            .map(|&chunk| wyrd_traits::chunk_hex(chunk))
+            .collect();
+        let mut reasons = self.unreadable.clone();
+        if !strays.is_empty() {
+            reasons.push(format!(
+                "its segment records name chunk(s) {} that none of its part records holds, so \
+                 neither of the fence's obligations accounts for their fragments",
+                strays.join(", ")
+            ));
+        }
+        (!reasons.is_empty()).then(|| reasons.join("; "))
+    }
+}
