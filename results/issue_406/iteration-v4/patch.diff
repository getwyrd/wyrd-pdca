+    }
+
+    fn reg(kind: OpKind, key: &str, version: Option<u64>, status: u16, s: u64, e: u64) -> OpRecord {
+        OpRecord {
+            kind,
+            key: key.to_string(),
+            version,
+            status,
+            start: at(s),
+            end: at(e),
+        }
+    }
+
+    #[test]
+    fn verdict_dispatch_defaults_to_the_off_check_job() {
+        assert_eq!(
+            verdict_dispatch(false),
+            VerdictDispatch::OffCheckJob {
+                job: ELLE_VERDICT_OFF_CHECK_JOB
+            }
+        );
+        assert_eq!(
+            verdict_dispatch(true),
+            VerdictDispatch::InGateShellOut {
+                env_var: ELLE_IN_GATE_SHELLOUT_VAR
+            }
+        );
+    }
+
+    #[test]
+    fn overlap_and_climb_witnesses_hold_for_a_concurrent_history() {
+        let history = MultiProcessHistory::from_process_ops(vec![
+            ProcessOp {
+                process: 0,
+                record: reg(OpKind::Put, "k", Some(1), 200, 0, 10),
+            },
+            ProcessOp {
+                process: 1,
+                record: reg(OpKind::Get, "k", Some(1), 200, 5, 15),
+            },
+            ProcessOp {
+                process: 0,
+                record: reg(OpKind::Put, "k", Some(2), 200, 20, 30),
+            },
+        ]);
+        assert!(history.is_genuinely_concurrent());
+        assert!(history.version_climbs_for_key("k"));
+        assert!(history.per_process_reads_monotone());
+    }
+}
