+#[test]
+fn only_the_deprecated_var_reaches_the_in_gate_shellout_route() {
+    // The in-gate shell-out is representable but NEVER the default — only the explicitly-set
+    // deprecated var selects it (and the runner then hard-errors rather than shelling a JVM).
+    assert!(
+        matches!(
+            verdict_dispatch(true),
+            VerdictDispatch::InGateShellOut { env_var }
+                if env_var == ELLE_IN_GATE_SHELLOUT_VAR
+        ),
+        "only the deprecated WYRD_ELLE_IN_GATE_CMD var may reach the removed in-gate route"
+    );
+}
+
+// ─── (a) Wire-driven concurrent workload: non-vacuous, genuinely concurrent history ─────
+
+/// Start the S3 gateway on an ephemeral loopback port (mirrors
+/// `consistency_observable.rs::start_gateway` / `s3_http_wire.rs::start_gateway`). The
+/// gateway serves connections concurrently (`S3Gateway::serve` → `axum::serve`), so ≥2
+/// concurrent clients genuinely produce overlapping real-time spans.
+async fn start_gateway() -> (SocketAddr, tempfile::TempDir) {
+    let dir = tempfile::tempdir().expect("temp dir");
+    let gateway: Arc<Backend> = Arc::new(Gateway::new(
+        RedbMetadataStore::in_memory().expect("redb"),
+        FsChunkStore::open(dir.path()).expect("fs store"),
+        MemCoordination::new(),
+    ));
+    let config = S3Config::new(vec![Credentials {
+        access_key_id: ACCESS_KEY.to_string(),
+        secret_access_key: SECRET_KEY.to_string(),
+    }]);
+    let listener = TcpListener::bind("127.0.0.1:0").await.expect("bind");
+    let addr = listener.local_addr().expect("addr");
+    let server = S3Gateway::new(Arc::clone(&gateway), config);
+    tokio::spawn(async move {
+        server.serve(listener).await.expect("serve");
+    });
+    (addr, dir)
+}
+
+fn creds() -> Credentials {
+    Credentials {
+        access_key_id: ACCESS_KEY.to_string(),
+        secret_access_key: SECRET_KEY.to_string(),
+    }
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn concurrent_workload_produces_a_nonvacuous_genuinely_concurrent_history() {
+    let (addr, _dir) = start_gateway().await;
+    let key = "register-object";
+
+    // One writer (process 0) overwrites the shared key with climbing versions 1..=24 while
+    // two readers (processes 1,2) concurrently GET it — real overlapping spans across
+    // distinct processes over the real S3 HTTP wire.
+    let history = run_concurrent_register_workload(addr, BUCKET, creds(), REGION, key, 2, 24)
+        .await
+        .expect("concurrent register workload");
+
+    // Non-vacuous and every op well-formed.
+    assert!(
+        history.well_formed(),
+        "the merged multi-process history must be non-vacuous and every span well-formed"
+    );
+
+    // ≥2 distinct process ids (the writer + ≥1 reader).
+    let processes = history.processes();
+    assert!(
+        processes.len() >= 2 && processes.contains(&0),
+        "the history must merge ≥2 distinct process ids incl. the writer: {processes:?}"
+    );
+
+    // Genuinely concurrent: ≥2 real-time-overlapping spans across distinct process ids.
+    assert!(
+        history.overlapping_pairs_across_processes() >= 1,
+        "the concurrent workload must produce ≥2 real-time-overlapping spans across distinct \
+         processes (found none — the history is not genuinely concurrent)"
+    );
+
+    // The register version climbs across overwrites of the shared key…
+    assert!(
+        history.version_climbs_for_key(key),
+        "the register version must climb across the writer's overwrites of the shared key"
+    );
+
+    // …and every process's OWN per-key reads observe a monotone version sequence (no
+    // stale/torn read) — the sound, local session invariant. The GLOBAL cross-process
+    // register verdict is Elle's, off-Check, over the SAME serialized history; the in-gate
+    // slice deliberately does not decide it (that is the rejected v1–v3 in-gate vehicle).
+    assert!(
+        history.per_process_reads_monotone(),
+        "each session's per-key reads must observe a monotone version sequence (no stale/torn \
+         read)"
+    );
+
+    // The produced history serializes to the Elle EDN form (well-shaped, tagged with
+    // :process). Byte-exactness is asserted on the crafted golden above (wire times vary).
+    let edn = to_elle_edn(&history);
+    assert!(
+        edn.starts_with('[') && edn.ends_with(']'),
+        "the serialized history must be an EDN operation-history vector"
+    );
+    assert!(
+        edn.contains(":process ") && edn.contains(":type :invoke") && edn.contains(":type :ok"),
+        "the serialized history must carry :process-tagged :invoke/:ok events"
+    );
+}
+
+// ─── (d) Wire-driven directory-as-set recording ────────────────────────────────────────
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn directory_workload_records_and_serializes_a_set_history() {
+    let (addr, _dir) = start_gateway().await;
+    let prefix = "dir/";
+
+    // Create two members, probe each present, then delete the first and probe it absent.
+    let history = run_directory_workload(addr, BUCKET, creds(), REGION, prefix, &["alpha", "beta"])
+        .await
+        .expect("directory workload");
+
+    assert!(
+        history.well_formed(),
+        "the directory-as-set history must be non-vacuous and every span well-formed"
+    );
+
+    // Membership is observed by GET-probe: `alpha` was created, probed present, then deleted
+    // and probed absent; `beta` was created and probed present.
+    let saw_add = |m: &str| {
+        history
+            .ops()
+            .iter()
+            .any(|op| op.kind == DirKind::Add && op.member == m)
+    };
+    let saw_present = |m: &str| {
+        history
+            .ops()
+            .iter()
+            .any(|op| op.kind == DirKind::Contains && op.member == m && op.present == Some(true))
+    };
+    assert!(saw_add("alpha") && saw_add("beta"), "both creates recorded");
+    assert!(
+        saw_present("alpha") && saw_present("beta"),
+        "a membership probe must observe each created member present (200)"
+    );
+    assert!(
+        history
+            .ops()
+            .iter()
+            .any(|op| op.kind == DirKind::Remove && op.member == "alpha"),
+        "the delete of alpha must be recorded as a set remove"
+    );
+    assert!(
+        history.ops().iter().any(|op| op.kind == DirKind::Contains
+            && op.member == "alpha"
+            && op.present == Some(false)),
+        "a membership probe after the delete must observe alpha absent (404)"
+    );
+
+    // …and it serializes to the set op form.
+    let edn = directory_to_elle_edn(&history);
+    assert!(
+        edn.starts_with('[') && edn.contains(":f :add") && edn.contains(":f :contains?"),
+        "the directory history must serialize to the checker's set op form: {edn}"
+    );
+}
