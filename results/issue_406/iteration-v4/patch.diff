+// ─── (b) The Elle-EDN serializer: byte-exact golden (register) ──────────────────────────
+
+#[test]
+fn register_history_serializes_byte_exact_to_elle_edn() {
+    // A crafted, genuinely concurrent 2-process register history with controlled real-time
+    // spans (so the relative `:time` offsets are exact) covering every op-kind mapping:
+    // a write (:ok), a read (:ok, reads the committed version), a *failed* write (:fail, a
+    // 5xx), and a delete (:ok). The golden is written out independently below — a wrong
+    // field name, op-kind mapping, ordering, or `:time` origin makes this RED.
+    let history = MultiProcessHistory::from_process_ops(vec![
+        ProcessOp {
+            process: 0,
+            record: reg(OpKind::Put, "k", Some(1), 200, 0, 5),
+        },
+        ProcessOp {
+            process: 1,
+            record: reg(OpKind::Get, "k", Some(1), 200, 3, 8),
+        },
+        ProcessOp {
+            process: 0,
+            record: reg(OpKind::Put, "k", Some(2), 500, 10, 12),
+        },
+        ProcessOp {
+            process: 1,
+            record: reg(OpKind::Delete, "k", None, 204, 14, 15),
+        },
+    ]);
+
+    let expected = [
+        "[{:process 0, :type :invoke, :f :write, :value 1, :time 0}",
+        "{:process 1, :type :invoke, :f :read, :value nil, :time 3}",
+        "{:process 0, :type :ok, :f :write, :value 1, :time 5}",
+        "{:process 1, :type :ok, :f :read, :value 1, :time 8}",
+        "{:process 0, :type :invoke, :f :write, :value 2, :time 10}",
+        "{:process 0, :type :fail, :f :write, :value 2, :time 12}",
+        "{:process 1, :type :invoke, :f :delete, :value nil, :time 14}",
+        "{:process 1, :type :ok, :f :delete, :value nil, :time 15}]",
+    ]
+    .join("\n ");
+
+    assert_eq!(
+        to_elle_edn(&history),
+        expected,
+        "the register history must serialize byte-exact to the Elle EDN operation-history \
+         form (:process / :type ∈ {{:invoke,:ok,:fail}} / :f / :value / :time)"
+    );
+}
+
+// ─── (d) The directory-as-set history: byte-exact golden (set op form) ──────────────────
+
+#[test]
+fn directory_history_serializes_byte_exact_to_set_op_form() {
+    // A crafted directory-as-set history: create (add) a member, probe it present, remove it
+    // (delete), probe it absent — driven by 2 processes with controlled spans. A membership
+    // probe's completion value is a `[member present?]` pair. Independent golden below.
+    let history = DirectoryHistory::from_dir_ops(vec![
+        DirOp {
+            process: 0,
+            kind: DirKind::Add,
+            member: "a".to_string(),
+            present: None,
+            start: at(0),
+            end: at(4),
+        },
+        DirOp {
+            process: 1,
+            kind: DirKind::Contains,
+            member: "a".to_string(),
+            present: Some(true),
+            start: at(2),
+            end: at(6),
+        },
+        DirOp {
+            process: 0,
+            kind: DirKind::Remove,
+            member: "a".to_string(),
+            present: None,
+            start: at(8),
+            end: at(10),
+        },
+        DirOp {
+            process: 1,
+            kind: DirKind::Contains,
+            member: "a".to_string(),
+            present: Some(false),
+            start: at(12),
+            end: at(14),
+        },
+    ]);
+
+    let expected = [
+        "[{:process 0, :type :invoke, :f :add, :value \"a\", :time 0}",
+        "{:process 1, :type :invoke, :f :contains?, :value \"a\", :time 2}",
+        "{:process 0, :type :ok, :f :add, :value \"a\", :time 4}",
+        "{:process 1, :type :ok, :f :contains?, :value [\"a\" true], :time 6}",
+        "{:process 0, :type :invoke, :f :remove, :value \"a\", :time 8}",
+        "{:process 0, :type :ok, :f :remove, :value \"a\", :time 10}",
+        "{:process 1, :type :invoke, :f :contains?, :value \"a\", :time 12}",
+        "{:process 1, :type :ok, :f :contains?, :value [\"a\" false], :time 14}]",
+    ]
+    .join("\n ");
+
+    assert_eq!(
+        directory_to_elle_edn(&history),
+        expected,
+        "the directory-as-set history must serialize byte-exact to the checker's set op form \
+         (:add / :remove / :contains? with a [member present?] read value)"
+    );
+}
