+//! The #329 consistency-checker **workload + serializer** slice (ADR-0041 decision 1–3,
+//! #406, slice 3), built on top of the merged #405 networked observable
+//! ([`crate::consistency_observable`]). This module does exactly what ADR-0041 §Decision
+//! grants the Rust slice — **produce a genuinely concurrent, non-vacuous history over the
+//! real wire and serialize it in the recognized checker's (Elle) format**, plus only the
+//! *sound, local* checks that are cheap to get right — and **nothing more**. It deliberately
+//! does **not** re-implement a global register/namespace-linearizability *verdict*: per
+//! ADR-0041/ADR-0016 that verdict is Elle's, and Elle (JVM/Clojure) runs **only off-Check**.
+//! The seam that routes the verdict there is [`verdict_dispatch`].
+//!
+//! What it provides:
+//!
+//! * a **concurrent register workload** ([`run_concurrent_register_workload`]) that drives
+//!   ≥2 [`ObservableS3Client`]s as concurrent tasks against one shared key over the real S3
+//!   HTTP wire, producing genuinely real-time-overlapping spans across distinct processes;
+//! * a **multi-process history** ([`MultiProcessHistory`]) that merges the per-client
+//!   [`History`]s into one real-time-ordered log, tagging each op with its `:process`;
+//! * an **Elle-EDN serializer** ([`to_elle_edn`]) that emits that history in the recognized
+//!   checker's operation-history format (`:process` / `:type` ∈ `{:invoke,:ok,:fail}` /
+//!   `:f` / `:value` / `:time`);
+//! * the **session** read-your-writes ([`session_read_your_writes`]) + monotonic-read
+//!   ([`session_monotonic_reads`]) checks (ADR-0015 guarantee 3), as *sound, local*
+//!   invariants over a single-session history;
+//! * a **directory-as-set** history ([`DirectoryHistory`]) — create=PUT / delete=DELETE /
+//!   membership=GET-probe under a prefix (no rename, no wire `LIST`; ADR-0041 decision 2) —
+//!   and its serializer to the checker's set op form ([`directory_to_elle_edn`]); and
+//! * the **verdict-dispatch** seam ([`VerdictDispatch`] / [`verdict_dispatch`]) — a pure
+//!   routing value that sends the Elle verdict to the privileged off-Check job, mirroring
+//!   the `xtask::metadata_faults` "deferred ≠ unbuilt" precedent.
+
+use std::collections::BTreeSet;
+use std::net::SocketAddr;
+use std::sync::atomic::{AtomicBool, Ordering};
+use std::sync::Arc;
+use std::time::SystemTime;
+
+use wyrd_gateway_s3::sigv4::Credentials;
+
+use crate::consistency_observable::{History, ObservableS3Client, OpKind, OpRecord};
+
+/// A process id tagging one client's ops in a merged multi-process history — the `:process`
+/// a register/set linearizability checker uses to know which client issued the op.
+pub type ProcessId = u64;
+
+// ─── Multi-process history (merge + `:process` tagging + concurrency witnesses) ────────
+
+/// One op tagged with the process (client) that issued it. Reuses the #405 [`OpRecord`]
+/// verbatim — the multi-process history is exactly the per-client histories, merged.
+#[derive(Debug, Clone)]
+pub struct ProcessOp {
+    /// The process (client) that issued the op.
+    pub process: ProcessId,
+    /// The recorded op (op kind, key, observed version, wire status, real-time span).
+    pub record: OpRecord,
+}
+
+/// The merged, real-time-ordered multi-process history a concurrent register workload
+/// produces: every client's [`History`] folded into one log, ordered by real-time start,
+/// each op carrying its `:process`. This is the non-vacuous, genuinely-concurrent history
+/// #406 requires (ADR-0041 decision 1) and the input [`to_elle_edn`] serializes.
+#[derive(Debug, Default, Clone)]
+pub struct MultiProcessHistory {
+    ops: Vec<ProcessOp>,
+}
+
+impl MultiProcessHistory {
+    /// Merge per-client `(process, history)` pairs into one real-time-ordered log. Ops are
+    /// ordered by their measured start time (ties broken by process) — the merged real-time
+    /// order a checker places ops in.
+    pub fn merge(labeled: Vec<(ProcessId, History)>) -> Self {
+        let mut ops: Vec<ProcessOp> = Vec::new();
+        for (process, history) in labeled {
+            for record in history.ops() {
+                ops.push(ProcessOp {
+                    process,
+                    record: record.clone(),
+                });
+            }
+        }
+        Self::from_process_ops(ops)
+    }
+
+    /// Build from already-tagged ops (sorting them into real-time start order). The
+    /// socket-free construction seam the crafted-history serializer regressions use.
+    pub fn from_process_ops(mut ops: Vec<ProcessOp>) -> Self {
+        ops.sort_by(|a, b| {
+            a.record
+                .start
+                .cmp(&b.record.start)
+                .then(a.process.cmp(&b.process))
+        });
+        Self { ops }
+    }
+
+    /// The merged ops, in real-time (start) order.
+    pub fn ops(&self) -> &[ProcessOp] {
+        &self.ops
+    }
+
+    /// The distinct process ids that appear in the history.
+    pub fn processes(&self) -> BTreeSet<ProcessId> {
+        self.ops.iter().map(|op| op.process).collect()
+    }
+
+    /// Non-vacuous **and** every op well-formed: at least one op, and none with a reversed
+    /// or missing real-time span. A checker fed an empty or malformed history proves nothing.
+    pub fn well_formed(&self) -> bool {
+        !self.ops.is_empty() && self.ops.iter().all(|op| op.record.well_formed())
+    }
+
+    /// The number of real-time-overlapping op pairs drawn from **distinct** processes. A
+    /// genuinely concurrent history has ≥1 such pair (i.e. ≥2 overlapping spans across
+    /// distinct process ids); a sequential single-client history has none. Two spans overlap
+    /// iff `a.start < b.end && b.start < a.end`.
+    pub fn overlapping_pairs_across_processes(&self) -> usize {
+        let mut pairs = 0;
+        for (i, a) in self.ops.iter().enumerate() {
+            for b in &self.ops[i + 1..] {
+                if a.process != b.process && spans_overlap(&a.record, &b.record) {
+                    pairs += 1;
+                }
+            }
+        }
+        pairs
+    }
+
+    /// Whether the history is genuinely concurrent: ≥2 real-time-overlapping spans across
+    /// distinct process ids (ADR-0041 decision 1 — a non-vacuous, concurrent history).
+    pub fn is_genuinely_concurrent(&self) -> bool {
+        self.overlapping_pairs_across_processes() >= 1
+    }
+
+    /// The versions written by PUTs of `key`, in merged real-time order.
+    pub fn put_versions_for_key(&self, key: &str) -> Vec<u64> {
+        self.ops
+            .iter()
+            .filter(|op| op.record.kind == OpKind::Put && op.record.key == key)
+            .filter_map(|op| op.record.version)
+            .collect()
+    }
+
+    /// Whether the register version **climbs** across overwrites of `key`: ≥2 PUTs whose
+    /// written versions are strictly increasing in real-time order (ADR-0041 decision 1 — an
+    /// overwrite is a new inode version bumped at the commit point).
+    pub fn version_climbs_for_key(&self, key: &str) -> bool {
+        let versions = self.put_versions_for_key(key);
+        versions.len() >= 2 && versions.windows(2).all(|w| w[1] > w[0])
+    }
+
+    /// Every process's OWN reads observe a monotone version sequence per key — the **sound,
+    /// local** monotonic-read guarantee (ADR-0015 guarantee 3), checked per session (a single
+    /// client's ops are sequential, so its own read order *is* real-time order and this holds
+    /// soundly). It reuses [`session_monotonic_reads`] over each process's sub-history.
+    ///
+    /// It deliberately does **not** decide monotonicity across the *merged* multi-process
+    /// history: a PUT's version becomes visible only at its commit (its span *end*), not its
+    /// start, so a start-ordered global sequence would flag a concurrent read that legitimately
+    /// observed the older value — and a global cross-process register decision is exactly the
+    /// linearizability **verdict** ADR-0041 reserves for Elle, off-Check. In-gate we assert only
+    /// the sound per-session invariant; Elle owns the global verdict over the SAME history.
+    pub fn per_process_reads_monotone(&self) -> bool {
+        self.processes().into_iter().all(|process| {
+            let session = History::from_ops(
+                self.ops
+                    .iter()
+                    .filter(|op| op.process == process)
+                    .map(|op| op.record.clone())
+                    .collect(),
+            );
+            session_monotonic_reads(&session)
+        })
+    }
+}
+
+/// Two ops overlap in real time iff each begins before the other ends.
+fn spans_overlap(a: &OpRecord, b: &OpRecord) -> bool {
+    a.start < b.end && b.start < a.end
+}
+
+// ─── Elle-EDN serialization (a stable, well-shaped operation history) ──────────────────
+
+/// An EDN scalar/compound value the serializer emits for `:value`.
+enum EdnValue {
+    Nil,
+    Int(u64),
+    Bool(bool),
+    Str(String),
+    Vector(Vec<EdnValue>),
+}
+
+impl EdnValue {
+    fn render(&self) -> String {
+        match self {
+            EdnValue::Nil => "nil".to_string(),
+            EdnValue::Int(n) => n.to_string(),
+            EdnValue::Bool(b) => b.to_string(),
+            EdnValue::Str(s) => render_edn_string(s),
+            EdnValue::Vector(items) => {
+                let inner: Vec<String> = items.iter().map(EdnValue::render).collect();
+                format!("[{}]", inner.join(" "))
+            }
+        }
+    }
+}
+
+/// Render an EDN string literal: double-quoted, with `\` and `"` escaped (EDN string syntax,
+/// not Rust `Debug`, so the bytes are the checker's — stable regardless of the Rust version).
+fn render_edn_string(s: &str) -> String {
+    let escaped = s.replace('\\', "\\\\").replace('"', "\\\"");
+    format!("\"{escaped}\"")
+}
+
+/// One Elle operation-history event (an `:invoke` or a completion `:ok`/`:fail`), rendered
+/// as a map with the fields ADR-0041/§Success-criterion (b) names, in that order.
+struct EdnEvent {
+    process: ProcessId,
+    etype: &'static str,
+    f: &'static str,
+    value: EdnValue,
+    time: u128,
+}
+
+impl EdnEvent {
+    fn render(&self) -> String {
+        format!(
+            "{{:process {}, :type :{}, :f :{}, :value {}, :time {}}}",
+            self.process,
+            self.etype,
+            self.f,
+            self.value.render(),
+            self.time
+        )
+    }
+}
+
+/// Render a stream of events as an EDN vector of maps, one map per line — the recognizable
+/// Jepsen/Elle operation-history layout (`[` then each op, newline + one-space indented).
+fn render_edn_vector(events: &[EdnEvent]) -> String {
+    let mut out = String::from("[");
+    for (i, event) in events.iter().enumerate() {
+        if i > 0 {
+            out.push_str("\n ");
+        }
+        out.push_str(&event.render());
+    }
+    out.push(']');
+    out
+}
+
+/// The earliest start time across a set of ops — the history's `t0`, so `:time` is a
+/// relative nanosecond offset (the Jepsen convention) rather than a wall-clock absolute.
+fn history_origin<'a>(records: impl Iterator<Item = &'a OpRecord>) -> Option<SystemTime> {
+    records.map(|r| r.start).min()
+}
+
+/// Nanoseconds of `t` since the history origin `t0` (0 if `t` precedes `t0`, which
+/// well-formed histories never do).
+fn relative_nanos(t: SystemTime, t0: SystemTime) -> u128 {
+    t.duration_since(t0).unwrap_or_default().as_nanos()
+}
+
+/// The `:f` a register op maps to.
+fn register_f(kind: OpKind) -> &'static str {
+    match kind {
+        OpKind::Put => "write",
+        OpKind::Get => "read",
+        OpKind::Delete => "delete",
+    }
+}
+
+/// The completion `:type` a register op's wire status maps to: a delivered 2xx (and a GET's
+/// 404, a legitimate *absent* read) is `:ok`; anything else (a 5xx, a refused write) is
+/// `:fail`.
+fn register_completion_type(kind: OpKind, status: u16) -> &'static str {
+    let ok = match kind {
+        OpKind::Get => matches!(status, 200 | 404),
+        OpKind::Put => status == 200,
+        OpKind::Delete => matches!(status, 200 | 204),
+    };
+    if ok {
+        "ok"
+    } else {
+        "fail"
+    }
+}
+
+/// The `:value` a register op carries at `:invoke` — the write's value is known up front; a
+/// read's is not (it is `nil` until the completion fills it), and a delete carries none.
+fn register_invoke_value(rec: &OpRecord) -> EdnValue {
+    match rec.kind {
+        OpKind::Put => rec.version.map_or(EdnValue::Nil, EdnValue::Int),
+        OpKind::Get | OpKind::Delete => EdnValue::Nil,
+    }
+}
+
+/// The `:value` a register op carries at completion — the write's written value, the read's
+/// observed value (`nil` for an absent key), or `nil` for a delete.
+fn register_complete_value(rec: &OpRecord) -> EdnValue {
+    match rec.kind {
+        OpKind::Put | OpKind::Get => rec.version.map_or(EdnValue::Nil, EdnValue::Int),
+        OpKind::Delete => EdnValue::Nil,
+    }
+}
+
+/// Serialize a multi-process register history to the recognized checker's (Elle) EDN
+/// operation-history format: a vector of `:invoke`/`:ok`/`:fail` maps, one op split into its
+/// invoke (at its start time) and its completion (at its end time), ordered by real time and
+/// each tagged with its `:process`. This is a **stable, well-shaped** serializer — the golden
+/// regression asserts its bytes; real-Elle-parser acceptance is the deferred off-Check leg
+/// (see the module docs and the brief's Scope note).
+pub fn to_elle_edn(history: &MultiProcessHistory) -> String {
+    let Some(t0) = history_origin(history.ops.iter().map(|op| &op.record)) else {
+        return "[]".to_string();
+    };
+
+    // Assign each op a stable per-process sequence index (its order within its own process,
+    // which — because a client's ops are sequential — is also its real-time order there).
+    // Sorting events by `(time, process, seq, phase)` keeps each process's invoke→completion
+    // nesting valid while ordering the whole stream by real time.
+    let mut seq_in_process: std::collections::HashMap<ProcessId, u64> =
+        std::collections::HashMap::new();
+
+    struct Keyed {
+        time: u128,
+        process: ProcessId,
+        seq: u64,
+        phase: u8,
+        event: EdnEvent,
+    }
+    let mut keyed: Vec<Keyed> = Vec::new();
+
+    for op in &history.ops {
+        let seq = seq_in_process.entry(op.process).or_insert(0);
+        let this_seq = *seq;
+        *seq += 1;
+        let rec = &op.record;
+        let f = register_f(rec.kind);
+
+        keyed.push(Keyed {
+            time: relative_nanos(rec.start, t0),
+            process: op.process,
+            seq: this_seq,
+            phase: 0,
+            event: EdnEvent {
+                process: op.process,
+                etype: "invoke",
+                f,
+                value: register_invoke_value(rec),
+                time: relative_nanos(rec.start, t0),
+            },
+        });
+        keyed.push(Keyed {
+            time: relative_nanos(rec.end, t0),
+            process: op.process,
+            seq: this_seq,
+            phase: 1,
+            event: EdnEvent {
+                process: op.process,
+                etype: register_completion_type(rec.kind, rec.status),
+                f,
+                value: register_complete_value(rec),
+                time: relative_nanos(rec.end, t0),
+            },
+        });
+    }
+
+    keyed.sort_by(|a, b| {
+        a.time
+            .cmp(&b.time)
+            .then(a.process.cmp(&b.process))
+            .then(a.seq.cmp(&b.seq))
+            .then(a.phase.cmp(&b.phase))
+    });
+
+    let events: Vec<EdnEvent> = keyed.into_iter().map(|k| k.event).collect();
+    render_edn_vector(&events)
+}
+
+// ─── Session checks (read-your-writes + monotonic reads, ADR-0015 guarantee 3) ─────────
+
+/// **Read-your-writes** over a single session (ADR-0015 guarantee 3): once the session has
+/// written version `w` to a key, every later read of that key by the same session must
+/// observe a version `>= w` — never a stale earlier value, and never *absent* after its own
+/// write. A session's own delete clears that obligation (it then reads its own delete). A
+/// crafted history that reads back a version older than the session's own last write (or
+/// `None` after it) is **rejected** (`false`).
+pub fn session_read_your_writes(session: &History) -> bool {
+    use std::collections::HashMap;
+    let mut last_write: HashMap<&str, u64> = HashMap::new();
+    for op in session.ops() {
+        match op.kind {
+            OpKind::Put => {
+                if let Some(v) = op.version {
+                    last_write.insert(op.key.as_str(), v);
+                }
+            }
+            OpKind::Get => {
+                if let Some(&w) = last_write.get(op.key.as_str()) {
+                    match op.version {
+                        Some(r) if r >= w => {}
+                        _ => return false,
+                    }
+                }
+            }
+            OpKind::Delete => {
+                last_write.remove(op.key.as_str());
+            }
+        }
+    }
+    true
+}
+
+/// **Monotonic reads** over a single session (ADR-0015 guarantee 3): successive reads of a
+/// key by the same session never observe an *older* version than one the session already
+/// read for that key. A crafted history whose reads regress is **rejected** (`false`).
+pub fn session_monotonic_reads(session: &History) -> bool {
+    use std::collections::HashMap;
+    let mut last_read: HashMap<&str, u64> = HashMap::new();
+    for op in session.ops() {
+        if op.kind == OpKind::Get {
+            if let Some(v) = op.version {
+                match last_read.get(op.key.as_str()) {
+                    Some(&prev) if v < prev => return false,
+                    _ => {
+                        last_read.insert(op.key.as_str(), v);
+                    }
+                }
+            }
+        }
+    }
+    true
+}
+
+// ─── Directory-as-set history (ADR-0041 decision 2: create/delete/membership) ──────────
+
+/// A directory (namespace) operation, modelled as a **set** mutation/observation under a
+/// prefix — create appends a member (PUT), delete removes it (DELETE), a membership probe
+/// observes whether a member is present (GET → 200 present / 404 absent). No rename and no
+/// wire `LIST` (the S3 floor is PUT/GET/DELETE only, `crates/gateway-s3/src/lib.rs:40`).
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum DirKind {
+    /// create=PUT — appends the member to the directory set.
+    Add,
+    /// delete=DELETE — removes the member from the set.
+    Remove,
+    /// membership=GET-probe — observes whether the member is present.
+    Contains,
+}
+
+/// One directory-as-set op, with the member it targets, the membership result (for a
+/// [`DirKind::Contains`] probe: `Some(present)`; otherwise `None`), and its real-time span.
+#[derive(Debug, Clone)]
+pub struct DirOp {
+    /// The process (client) that issued the op.
+    pub process: ProcessId,
+    /// Which set operation this records.
+    pub kind: DirKind,
+    /// The member (the object key with the directory prefix stripped).
+    pub member: String,
+    /// For a membership probe: whether the member was present (`200` → `true`, `404` →
+    /// `false`). `None` for add/remove.
+    pub present: Option<bool>,
+    /// Wall-clock time observed just before the op began.
+    pub start: SystemTime,
+    /// Wall-clock time observed just after the op completed.
+    pub end: SystemTime,
+}
+
+/// A recorded directory-as-set history under a prefix — the namespace analogue of
+/// [`MultiProcessHistory`], serialized to the checker's set op form ([`directory_to_elle_edn`]).
+#[derive(Debug, Default, Clone)]
+pub struct DirectoryHistory {
+    ops: Vec<DirOp>,
+}
+
+impl DirectoryHistory {
+    /// Build from already-recorded set ops (sorting them into real-time start order).
+    pub fn from_dir_ops(mut ops: Vec<DirOp>) -> Self {
+        ops.sort_by(|a, b| a.start.cmp(&b.start).then(a.process.cmp(&b.process)));
+        Self { ops }
+    }
+
+    /// Project a register history under `prefix` into a directory-as-set history: PUT → add,
+    /// DELETE → remove, GET → a membership probe (`200` present / anything else absent). The
+    /// member is the object key with `prefix` stripped. Ops whose key is not under `prefix`
+    /// are ignored. This is how a wire-driven namespace workload is recorded as a set history.
+    pub fn from_register_history(prefix: &str, history: &MultiProcessHistory) -> Self {
+        let mut ops = Vec::new();
+        for op in history.ops() {
+            let rec = &op.record;
+            let Some(member) = rec.key.strip_prefix(prefix) else {
+                continue;
+            };
+            let (kind, present) = match rec.kind {
+                OpKind::Put => (DirKind::Add, None),
+                OpKind::Delete => (DirKind::Remove, None),
+                OpKind::Get => (DirKind::Contains, Some(rec.status == 200)),
+            };
+            ops.push(DirOp {
+                process: op.process,
+                kind,
+                member: member.to_string(),
+                present,
+                start: rec.start,
+                end: rec.end,
+            });
+        }
+        Self::from_dir_ops(ops)
+    }
+
+    /// The recorded set ops, in real-time (start) order.
+    pub fn ops(&self) -> &[DirOp] {
+        &self.ops
+    }
+
+    /// Non-vacuous **and** every op well-formed (a sane `start <= end` span).
+    pub fn well_formed(&self) -> bool {
+        !self.ops.is_empty() && self.ops.iter().all(|op| op.end >= op.start)
+    }
+}
+
+/// The `:f` a directory op maps to (set op form): add/remove members, probe membership.
+fn directory_f(kind: DirKind) -> &'static str {
+    match kind {
+        DirKind::Add => "add",
+        DirKind::Remove => "remove",
+        DirKind::Contains => "contains?",
+    }
+}
+
+/// Serialize a directory-as-set history to the recognized checker's EDN set op form — the
+/// namespace analogue of [`to_elle_edn`]. A membership probe's completion `:value` is a
+/// `[member present?]` pair; add/remove carry the member. Same stable, well-shaped layout,
+/// asserted byte-exact by the golden regression.
+pub fn directory_to_elle_edn(history: &DirectoryHistory) -> String {
+    let Some(t0) = history.ops.iter().map(|op| op.start).min() else {
+        return "[]".to_string();
+    };
+
+    struct Keyed {
+        time: u128,
+        process: ProcessId,
+        seq: u64,
+        phase: u8,
+        event: EdnEvent,
+    }
+    let mut seq_in_process: std::collections::HashMap<ProcessId, u64> =
+        std::collections::HashMap::new();
+    let mut keyed: Vec<Keyed> = Vec::new();
+
+    for op in &history.ops {
+        let seq = seq_in_process.entry(op.process).or_insert(0);
+        let this_seq = *seq;
+        *seq += 1;
+        let f = directory_f(op.kind);
+
+        // The member being added/removed/probed is known at invoke; a probe's boolean result
+        // is filled at completion as `[member present?]`.
+        let invoke_value = EdnValue::Str(op.member.clone());
+        let complete_value = match op.kind {
+            DirKind::Contains => EdnValue::Vector(vec![
+                EdnValue::Str(op.member.clone()),
+                EdnValue::Bool(op.present.unwrap_or(false)),
+            ]),
+            DirKind::Add | DirKind::Remove => EdnValue::Str(op.member.clone()),
+        };
+
+        keyed.push(Keyed {
+            time: relative_nanos(op.start, t0),
+            process: op.process,
+            seq: this_seq,
+            phase: 0,
+            event: EdnEvent {
+                process: op.process,
+                etype: "invoke",
+                f,
+                value: invoke_value,
+                time: relative_nanos(op.start, t0),
+            },
+        });
+        keyed.push(Keyed {
+            time: relative_nanos(op.end, t0),
+            process: op.process,
+            seq: this_seq,
+            phase: 1,
+            event: EdnEvent {
+                process: op.process,
+                etype: "ok",
+                f,
+                value: complete_value,
+                time: relative_nanos(op.end, t0),
+            },
+        });
+    }
+
+    keyed.sort_by(|a, b| {
+        a.time
+            .cmp(&b.time)
+            .then(a.process.cmp(&b.process))
+            .then(a.seq.cmp(&b.seq))
+            .then(a.phase.cmp(&b.phase))
+    });
+
+    let events: Vec<EdnEvent> = keyed.into_iter().map(|k| k.event).collect();
+    render_edn_vector(&events)
+}
+
+// ─── Verdict-dispatch seam (mirrors xtask::metadata_faults; ADR-0041/ADR-0016) ─────────
+
+/// The privileged off-Check job that runs the Elle linearizability verdict over the
+/// serialized EDN history. Elle is JVM/Clojure, so — per ADR-0041/ADR-0016 — it runs **only**
+/// here, never in `cargo xtask ci`.
+pub const ELLE_VERDICT_OFF_CHECK_JOB: &str = "consistency-elle-verdict";
+
+/// A deprecated in-gate JVM/Clojure shell-out env var. There is **no** in-gate Elle run; this
+/// is representable only so the routing decision stays testable — selecting it is a hard error
+/// downstream, never a shell-out into the merge gate (the same shape
+/// `xtask::metadata_faults::METADATA_TIER1_LEGACY_CMD_VAR` keeps for its removed legacy leg).
+pub const ELLE_IN_GATE_SHELLOUT_VAR: &str = "WYRD_ELLE_IN_GATE_CMD";
+
+/// Where the Elle linearizability verdict routes. Modelling the route as a value with BOTH
+/// alternatives representable is the non-tautological bar (§Success-criterion e, mirroring
+/// `xtask::metadata_faults::MetadataTierDispatch`): a Check-time unit test binds to
+/// [`verdict_dispatch`], and a regression that re-points the default route at an in-gate JVM
+/// shell-out flips that test **red behaviourally**.
+#[derive(Debug, PartialEq, Eq)]
+pub enum VerdictDispatch {
+    /// Route the verdict to the privileged off-Check job over the serialized EDN history
+    /// (JVM/Clojure runs there, never in `cargo xtask ci`).
+    OffCheckJob {
+        /// The off-Check job name.
+        job: &'static str,
+    },
+    /// The rejected in-gate JVM shell-out — representable but never selected for the default
+    /// inputs; the runner turns it into a hard error.
+    InGateShellOut {
+        /// The deprecated env var that would name the in-gate command.
+        env_var: &'static str,
+    },
+}
+
+/// Decide where the Elle verdict routes. Pure — decided solely from
+/// `in_gate_shellout_configured` (whether the deprecated [`ELLE_IN_GATE_SHELLOUT_VAR`] is
+/// set) — so the dispatch test binds to it with no privileged environment. The default
+/// (var unset) is always the privileged off-Check job (ADR-0041/ADR-0016): the merge gate
+/// stays pure-Rust and never shells a JVM.
+#[must_use]
+pub fn verdict_dispatch(in_gate_shellout_configured: bool) -> VerdictDispatch {
+    if in_gate_shellout_configured {
+        VerdictDispatch::InGateShellOut {
+            env_var: ELLE_IN_GATE_SHELLOUT_VAR,
+        }
+    } else {
+        VerdictDispatch::OffCheckJob {
+            job: ELLE_VERDICT_OFF_CHECK_JOB,
+        }
+    }
+}
+
+// ─── Wire-driven workloads (leg (a) concurrent register; leg (d) directory recording) ──
+
+/// Drive a **concurrent register workload** over the real S3 HTTP wire: one *writer* client
+/// (process `0`) overwrites the shared `key` with strictly-climbing versions `1..=overwrites`
+/// (each committing before the next issues, so the register value only ever climbs), while
+/// `readers` *reader* clients (processes `1..=readers`) concurrently GET the same key until
+/// the writer finishes. Because the sole writer only climbs, every reader observes a
+/// **monotone** version sequence; because the readers run throughout the writer's overwrites,
+/// their read spans **overlap** the writer's write spans in real time across distinct
+/// processes — the genuine concurrency ADR-0041 decision 1 requires.
+///
+/// Returns the merged [`MultiProcessHistory`]. Binds no listener itself — the caller passes
+/// the address of an already-serving gateway (mirrors `s3_http_wire.rs::start_gateway`).
+pub async fn run_concurrent_register_workload(
+    addr: SocketAddr,
+    bucket: &str,
+    creds: Credentials,
+    region: &str,
+    key: &str,
+    readers: usize,
+    overwrites: u64,
+) -> std::io::Result<MultiProcessHistory> {
+    let done = Arc::new(AtomicBool::new(false));
+    // A generous safety cap so a reader can never spin forever if the writer fails before
+    // signalling done (the join below would surface the writer's error either way).
+    let reader_cap: u64 = overwrites.saturating_mul(64).saturating_add(1024);
+
+    let mut reader_handles = Vec::new();
+    for r in 0..readers {
+        let process = (r + 1) as ProcessId;
+        let bucket = bucket.to_string();
+        let creds = creds.clone();
+        let region = region.to_string();
+        let key = key.to_string();
+        let done = Arc::clone(&done);
+        reader_handles.push(tokio::spawn(async move {
+            let mut client = ObservableS3Client::new(addr, bucket, creds, region);
+            let mut issued: u64 = 0;
+            loop {
+                client.get(&key).await?;
+                issued += 1;
+                if done.load(Ordering::SeqCst) || issued >= reader_cap {
+                    break;
+                }
+            }
+            Ok::<(ProcessId, History), std::io::Error>((process, client.into_history()))
+        }));
+    }
+
+    let writer = {
+        let bucket = bucket.to_string();
+        let creds = creds.clone();
+        let region = region.to_string();
+        let key = key.to_string();
+        let done = Arc::clone(&done);
+        tokio::spawn(async move {
+            let mut client = ObservableS3Client::new(addr, bucket, creds, region);
+            for version in 1..=overwrites {
+                client.put(&key, version).await?;
+                client.get(&key).await?;
+            }
+            done.store(true, Ordering::SeqCst);
+            Ok::<(ProcessId, History), std::io::Error>((0, client.into_history()))
+        })
+    };
+
+    let mut labeled = Vec::new();
+    let (writer_process, writer_history) = writer.await.expect("writer task panicked")?;
+    labeled.push((writer_process, writer_history));
+    for handle in reader_handles {
+        let (process, history) = handle.await.expect("reader task panicked")?;
+        labeled.push((process, history));
+    }
+    Ok(MultiProcessHistory::merge(labeled))
+}
+
+/// Drive a **directory-as-set workload** over the real S3 HTTP wire with one client (process
+/// `0`): for each member, create it (PUT) then probe it present (GET → 200); then remove the
+/// first member (DELETE) and probe it absent (GET → 404). Records the run and projects it to
+/// a [`DirectoryHistory`] under `prefix` — the namespace history ADR-0041 decision 2 models.
+pub async fn run_directory_workload(
+    addr: SocketAddr,
+    bucket: &str,
+    creds: Credentials,
+    region: &str,
+    prefix: &str,
+    members: &[&str],
+) -> std::io::Result<DirectoryHistory> {
+    let mut client = ObservableS3Client::new(addr, bucket, creds, region);
+    for member in members {
+        let key = format!("{prefix}{member}");
+        client.put(&key, 1).await?;
+        client.get(&key).await?;
+    }
+    if let Some(first) = members.first() {
+        let key = format!("{prefix}{first}");
+        client.delete(&key).await?;
+        client.get(&key).await?;
+    }
+    let merged = MultiProcessHistory::merge(vec![(0, client.into_history())]);
+    Ok(DirectoryHistory::from_register_history(prefix, &merged))
+}
+
