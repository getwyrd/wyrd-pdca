+// ─── (a) Concurrency witness: a read↔read overlap is NOT genuine concurrency ─────────────
+
+#[test]
+fn concurrency_witness_requires_a_read_write_overlap_not_read_read() {
+    // Two concurrent reads across distinct processes place no ordering constraint on each
+    // other — vacuous for register linearizability. A checker fed such a history is not
+    // exercising concurrency at all. The witness MUST reject it as "genuinely concurrent",
+    // even though a raw span-overlap counter sees the overlap.
+    let read_read_only = MultiProcessHistory::from_process_ops(vec![
+        ProcessOp {
+            process: 1,
+            record: reg(OpKind::Get, "k", Some(1), 200, 0, 10),
+        },
+        ProcessOp {
+            process: 2,
+            record: reg(OpKind::Get, "k", Some(1), 200, 5, 15),
+        },
+        // A write that does NOT overlap either read (starts after both end).
+        ProcessOp {
+            process: 0,
+            record: reg(OpKind::Put, "k", Some(2), 200, 20, 30),
+        },
+    ]);
+    assert!(
+        read_read_only.overlapping_pairs_across_processes() >= 1,
+        "the raw span-overlap counter should see the read↔read overlap"
+    );
+    assert_eq!(
+        read_read_only.read_write_overlapping_pairs_across_processes(),
+        0,
+        "there is no read↔write overlap in a read↔read-only history"
+    );
+    assert!(
+        !read_read_only.is_genuinely_concurrent(),
+        "a read↔read-only overlap must NOT count as genuine concurrency (vacuous for a \
+         register checker)"
+    );
+
+    // A read overlapping a write across distinct processes IS genuine concurrency.
+    let read_over_write = MultiProcessHistory::from_process_ops(vec![
+        ProcessOp {
+            process: 0,
+            record: reg(OpKind::Put, "k", Some(1), 200, 0, 10),
+        },
+        ProcessOp {
+            process: 1,
+            record: reg(OpKind::Get, "k", Some(1), 200, 5, 15),
+        },
+    ]);
+    assert!(
+        read_over_write.read_write_overlapping_pairs_across_processes() >= 1
+            && read_over_write.is_genuinely_concurrent(),
+        "a read span overlapping a write span across distinct processes IS genuine concurrency"
+    );
+}
