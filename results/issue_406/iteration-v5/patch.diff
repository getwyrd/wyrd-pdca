+#[test]
+fn verdict_dispatch_routes_the_elle_verdict_to_the_off_check_job() {
+    // The default (no in-gate shell-out var set): the verdict MUST route to the privileged
+    // off-Check job, never an in-gate JVM/Clojure shell-out. Reverting the dispatch so the
+    // default input returns the in-gate shell-out — re-pointing Elle into `cargo xtask ci` —
+    // hits the panic arm. Each assertion uses an independent expectation, not the literal the
+    // function returns.
+    match verdict_dispatch(false) {
