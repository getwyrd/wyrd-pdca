+// ─── (d) Wire-driven directory-as-set recording ────────────────────────────────────────
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn directory_workload_records_and_serializes_a_set_history() {
+    let (addr, _dir) = start_gateway().await;
+    let prefix = "dir/";
+
+    // Create two members, probe each present, then delete the first and probe it absent.
+    let history = run_directory_workload(addr, BUCKET, creds(), REGION, prefix, &["alpha", "beta"])
+        .await
+        .expect("directory workload");
+
+    assert!(
+        history.well_formed(),
+        "the directory-as-set history must be non-vacuous and every span well-formed"
+    );
+
+    // Membership is observed by GET-probe: `alpha` was created, probed present, then deleted
+    // and probed absent; `beta` was created and probed present.
+    let saw_add = |m: &str| {
+        history
+            .ops()
+            .iter()
+            .any(|op| op.kind == DirKind::Add && op.member == m)
+    };
+    let saw_present = |m: &str| {
+        history
+            .ops()
+            .iter()
+            .any(|op| op.kind == DirKind::Contains && op.member == m && op.present() == Some(true))
+    };
+    assert!(saw_add("alpha") && saw_add("beta"), "both creates recorded");
+    assert!(
+        saw_present("alpha") && saw_present("beta"),
+        "a membership probe must observe each created member present (200)"
+    );
+    assert!(
+        history
+            .ops()
+            .iter()
+            .any(|op| op.kind == DirKind::Remove && op.member == "alpha"),
+        "the delete of alpha must be recorded as a set remove"
+    );
+    assert!(
+        history.ops().iter().any(|op| op.kind == DirKind::Contains
+            && op.member == "alpha"
+            && op.present() == Some(false)),
+        "a membership probe after the delete must observe alpha absent (404)"
+    );
+
+    // …and it serializes to the set op form.
+    let edn = directory_to_elle_edn(&history);
+    assert!(
+        edn.starts_with('[') && edn.contains(":f :add") && edn.contains(":f :contains?"),
+        "the directory history must serialize to the checker's set op form: {edn}"
+    );
+}
