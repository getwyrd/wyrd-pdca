+// ─── Socket-free crafted-history helpers ───────────────────────────────────────────────
+
+fn at(nanos: u64) -> SystemTime {
+    UNIX_EPOCH + Duration::from_nanos(nanos)
+}
+
+fn reg(
+    kind: OpKind,
+    key: &str,
+    version: Option<u64>,
+    status: u16,
+    start: u64,
+    end: u64,
+) -> OpRecord {
+    OpRecord {
+        kind,
+        key: key.to_string(),
+        version,
+        status,
+        start: at(start),
+        end: at(end),
+    }
+}
