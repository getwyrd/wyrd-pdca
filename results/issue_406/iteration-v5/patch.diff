+#[test]
+fn reused_per_key_monotonicity_rejects_a_version_regression() {
+    // The #405 per-key monotonicity check, reused over a crafted history: a GET observing an
+    // older version than a committed one is a stale/torn read → rejected.
+    let regressing = History::from_ops(vec![
+        reg(OpKind::Put, "k", Some(2), 200, 0, 1),
+        reg(OpKind::Get, "k", Some(1), 200, 2, 3),
+    ]);
+    assert!(
+        !regressing.versions_monotone_per_key(),
+        "a GET observing a version older than one already committed must be rejected"
+    );
+
+    let monotone = History::from_ops(vec![
+        reg(OpKind::Put, "k", Some(1), 200, 0, 1),
+        reg(OpKind::Get, "k", Some(1), 200, 2, 3),
+        reg(OpKind::Put, "k", Some(2), 200, 4, 5),
+    ]);
+    assert!(
+        monotone.versions_monotone_per_key(),
+        "a non-regressing per-key version sequence must be accepted"
+    );
+}
