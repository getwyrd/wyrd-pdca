+#[test]
+fn directory_history_serializes_byte_exact_to_set_op_form() {
+    // A crafted directory-as-set history: create (add) a member, probe it present, remove it
+    // (delete), probe it absent, then a *failed* probe of another member (a 5xx — the probe
+    // observed nothing → :info with just the member, NOT a fabricated definitely-absent
+    // `[member false]`). Driven by 2 processes with controlled spans. Independent golden below.
+    let history = DirectoryHistory::from_dir_ops(vec![
+        DirOp {
+            process: 0,
+            kind: DirKind::Add,
+            member: "a".to_string(),
+            status: 200,
+            start: at(0),
+            end: at(4),
+        },
+        DirOp {
+            process: 1,
+            kind: DirKind::Contains,
+            member: "a".to_string(),
+            status: 200,
+            start: at(2),
+            end: at(6),
+        },
+        DirOp {
+            process: 0,
+            kind: DirKind::Remove,
+            member: "a".to_string(),
+            status: 204,
+            start: at(8),
+            end: at(10),
+        },
+        DirOp {
+            process: 1,
+            kind: DirKind::Contains,
+            member: "a".to_string(),
+            status: 404,
+            start: at(12),
+            end: at(14),
+        },
+        DirOp {
+            process: 1,
+            kind: DirKind::Contains,
+            member: "b".to_string(),
+            status: 503,
+            start: at(16),
+            end: at(18),
+        },
+    ]);
+
+    let expected = [
+        "[{:process 0, :type :invoke, :f :add, :value \"a\", :time 0}",
+        "{:process 1, :type :invoke, :f :contains?, :value \"a\", :time 2}",
+        "{:process 0, :type :ok, :f :add, :value \"a\", :time 4}",
+        "{:process 1, :type :ok, :f :contains?, :value [\"a\" true], :time 6}",
+        "{:process 0, :type :invoke, :f :remove, :value \"a\", :time 8}",
+        "{:process 0, :type :ok, :f :remove, :value \"a\", :time 10}",
+        "{:process 1, :type :invoke, :f :contains?, :value \"a\", :time 12}",
+        "{:process 1, :type :ok, :f :contains?, :value [\"a\" false], :time 14}",
+        "{:process 1, :type :invoke, :f :contains?, :value \"b\", :time 16}",
+        "{:process 1, :type :info, :f :contains?, :value \"b\", :time 18}]",
+    ]
+    .join("\n ");
+
+    assert_eq!(
+        directory_to_elle_edn(&history),
+        expected,
+        "the directory-as-set history must serialize byte-exact to the checker's set op form \
+         (:add / :remove / :contains? with a [member present?] read value), with a failed 5xx \
+         probe mapped to :info (not a fabricated definitely-absent)"
+    );
+}
