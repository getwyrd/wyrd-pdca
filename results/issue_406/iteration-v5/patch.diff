+// ─── (c) Session checks: reject a violation, accept a valid history ─────────────────────
+
+#[test]
+fn session_read_your_writes_rejects_a_stale_own_read_and_accepts_a_fresh_one() {
+    // Violation: the session writes v2, then reads back the stale v1 — read-your-writes broken.
+    let violating = History::from_ops(vec![
+        reg(OpKind::Put, "k", Some(2), 200, 0, 1),
+        reg(OpKind::Get, "k", Some(1), 200, 2, 3),
+    ]);
+    assert!(
+        !session_read_your_writes(&violating),
+        "a read of an OLDER version than the session's own last write must be rejected"
+    );
+
+    // Valid: the session writes v2, then reads back v2 (its own write).
+    let valid = History::from_ops(vec![
+        reg(OpKind::Put, "k", Some(2), 200, 0, 1),
+        reg(OpKind::Get, "k", Some(2), 200, 2, 3),
+    ]);
+    assert!(
+        session_read_your_writes(&valid),
+        "a read that reflects the session's own write (or newer) must be accepted"
+    );
+}
+
+#[test]
+fn session_read_your_writes_rejects_a_read_after_the_sessions_own_delete() {
+    // The delete branch is load-bearing: after the session deletes a key, a later read must
+    // observe it ABSENT (read your own delete). A read that resurrects the deleted value is a
+    // RYW violation — the previously-untested branch that just cleared the obligation.
+    let resurrected_after_delete = History::from_ops(vec![
+        reg(OpKind::Put, "k", Some(5), 200, 0, 1),
+        reg(OpKind::Delete, "k", None, 204, 2, 3),
+        reg(OpKind::Get, "k", Some(5), 200, 4, 5),
+    ]);
+    assert!(
+        !session_read_your_writes(&resurrected_after_delete),
+        "a read that resurrects a value after the session's own delete must be rejected"
+    );
+
+    // Valid: after the delete, the session reads the key absent (404 → version None).
+    let reads_own_delete = History::from_ops(vec![
+        reg(OpKind::Put, "k", Some(5), 200, 0, 1),
+        reg(OpKind::Delete, "k", None, 204, 2, 3),
+        reg(OpKind::Get, "k", None, 404, 4, 5),
+    ]);
+    assert!(
+        session_read_your_writes(&reads_own_delete),
+        "a read that observes the session's own delete (absent) must be accepted"
+    );
+}
+
+#[test]
+fn session_monotonic_reads_rejects_a_regression_and_accepts_a_monotone_run() {
+    // Violation: read v2 then read v1 — a monotonic-read regression within one session.
+    let violating = History::from_ops(vec![
+        reg(OpKind::Get, "k", Some(2), 200, 0, 1),
+        reg(OpKind::Get, "k", Some(1), 200, 2, 3),
+    ]);
+    assert!(
+        !session_monotonic_reads(&violating),
+        "a read that observes an OLDER version than a previous read must be rejected"
+    );
+
+    // Valid: read v1 then read v2 — non-decreasing.
+    let valid = History::from_ops(vec![
+        reg(OpKind::Get, "k", Some(1), 200, 0, 1),
+        reg(OpKind::Get, "k", Some(2), 200, 2, 3),
+    ]);
+    assert!(
+        session_monotonic_reads(&valid),
+        "a non-decreasing sequence of reads must be accepted"
+    );
+}
