+//! Consistency-checker substrate for Wyrd's **mutable metadata register** (ADR-0041;
+//! ADR-0015 the contract checked).
+//!
+//! ADR-0041 settles the substrate for #329's externally-recognizable consistency artifact:
+//! model the **metadata commit-point register** — the inode `version` bumped under the
+//! commit CAS (`crates/core/src/write.rs:271` `commit_overwrite`), the directory `dirent`
+//! set, and the reserved `meta:version` high-water mark — **never** the immutable
+//! chunk/fragment path (which yields only vacuous histories). This module is the pure-Rust
+//! realization of that decision: three checker model families over a **recorded history**,
+//! a history recorder, a checker-compatible serialization, and the seam to the off-Check
+//! verdict leg.
+//!
+//! # What is exercised at Check vs deferred off-Check
+//!
+//! The models, the session checks, the recorder, and the serialization are pure Rust and
+//! run under the base toolchain inside `cargo xtask ci`. The **live Elle/JVM verdict** over
+//! the serialized history is a privileged **off-Check** job (ADR-0016/ADR-0041 keep
+//! JVM/Clojure out of the unprivileged merge gate); [`verdict_dispatch`] models that routing
+//! decision as a pure value, unit-checkable at Check, exactly as
+//! `xtask/src/metadata_faults.rs`'s `metadata_tier_dispatch` does for the deferred live
+//! partition leg — the "deferred ≠ unbuilt" bar.
+//!
+//! # The three models (ADR-0041 §Decision)
+//!
+//! 1. **A file is a read-write register** ([`check_register`]) — the primary, load-bearing
+//!    model. A key is an object path / inode; a write is an overwriting PUT that bumps the
+//!    inode `version` under the commit-point CAS; a read returns the current version and
+//!    value. Checked for linearizability of the commit point (guarantee 2): read-after-commit
+//!    with no torn or stale read, exactly-one-writer-wins, and no version regression.
+//! 2. **A directory is a list-append / set** ([`check_list_append`]) — the secondary model.
+//!    Create appends a name, delete removes it, rename moves it; a list returns the entry
+//!    set. Checked for namespace linearizability (guarantee 1): no lost create, no
+//!    resurrected delete.
+//! 3. **Sessions carry read-your-writes and monotonic reads** ([`check_read_your_writes`],
+//!    [`check_monotonic_reads`]) over the register and the `meta:version` high-water mark
+//!    (guarantee 3).
+//!
+//! # A checker, not a rubber stamp — provenance is gated on *committed* writes
+//!
+//! Every clause that admits a read's observed value keys it to what the commit point
+//! **actually produced**: a value only a `Fail` write attempted (a lost CAS — "definitely
+//! did not take effect") was never at the commit point, so a read that returns it is a torn
+//! read, and every committed `(key, version)` is produced by exactly one write. Both the
+//! register value-provenance domain and the namespace add/remove sets are therefore built
+//! from `ok` events only (`if !c.ok { continue }`) — a checker whose whole value is its
+//! correctness must not admit a value no committed write ever wrote (issue #406 finding).
+//!
+//! # History representation
+//!
+//! A history is a flat, index-ordered list of operations, each split into an **invoke** and
+//! a terminal **ok**/**fail** event (the Elle/Knossos op lifecycle). The monotone [`Index`]
+//! is the **real-time proxy**: a lower index was recorded strictly earlier, so
+//! `a.t_complete < b.t_invoke` means `a` completed before `b` began (they do not overlap),
+//! which is the real-time order linearizability is defined against. A per-process invoke →
+//! complete stack pairs the events (a process issues its ops sequentially, so it has at most
+//! one in-flight op).
+
+use std::collections::BTreeMap;
+use std::collections::BTreeSet;
+use std::fmt;
+
+/// Global recording order — a real-time proxy. Monotone across the whole history: a strictly
+/// lower `index` was recorded strictly earlier in wall-clock terms.
+pub type Index = u64;
+
+/// A logical process / session id. Read-your-writes and monotonic reads are scoped per
+/// process (ADR-0015 guarantee 3).
+pub type Process = u32;
+
+/// The reserved global version-fence key (ADR-0015; `wyrd_core::metadata::VERSION_KEY` =
+/// `b"meta:version"`). Modeled as a register key so the session monotonic-read check covers
+/// the high-water mark uniformly with the per-inode register.
+pub const META_VERSION_KEY: &str = "meta:version";
+
+/// The Elle model the off-Check verdict runs the serialized register history through.
+pub const ELLE_RW_REGISTER: &str = "elle.rw-register";
+
+/// The Elle model the off-Check verdict runs the serialized namespace history through.
+pub const ELLE_LIST_APPEND: &str = "elle.list-append";
+
+/// The op lifecycle: an operation is `Invoke`d, then terminates `Ok` (observed result) or
+/// `Fail` (rejected — e.g. a commit that lost its CAS).
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Kind {
+    /// The operation began.
+    Invoke,
+    /// The operation completed with an observed result.
+    Ok,
+    /// The operation was rejected (definitely did not take effect).
+    Fail,
+}
+
+// ─── Read-write register model (ADR-0041 §Decision 1; ADR-0015 guarantee 2) ───────────
+
+/// A register operation function: an overwriting write or a read.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum RegF {
+    /// An overwriting PUT that bumps the inode `version` at the commit point.
+    Write,
+    /// A GET returning the current `(value, version)`.
+    Read,
+}
+
+/// One event in the register history (an invoke or a terminal event of a write/read).
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct RegOp {
+    /// Recording order (real-time proxy).
+    pub index: Index,
+    /// The process/session that issued the op.
+    pub process: Process,
+    /// Invoke / ok / fail.
+    pub kind: Kind,
+    /// Write or read.
+    pub f: RegF,
+    /// The register key (object path / inode, or [`META_VERSION_KEY`]).
+    pub key: String,
+    /// Write: the value written (`Some` on invoke and ok). Read: the value read (`Some` on an
+    /// ok that observed a value, `None` on invoke or an absent-key ok).
+    pub value: Option<u64>,
+    /// The commit-point version. A read-ok carries the version it observed; a write-ok
+    /// carries the writer's **own** commit version when it is still observable (else `None`).
+    pub version: Option<u64>,
+}
+
+impl RegOp {
+    /// A write invoke: `process` is about to overwrite `key` with `value`.
+    #[must_use]
+    pub fn write_invoke(index: Index, process: Process, key: &str, value: u64) -> Self {
+        Self {
+            index,
+            process,
+            kind: Kind::Invoke,
+            f: RegF::Write,
+            key: key.to_string(),
+            value: Some(value),
+            version: None,
+        }
+    }
+
+    /// A write ok: the overwrite committed `value`, producing commit `version` (when the
+    /// writer could still observe its own value as current; else `None`).
+    #[must_use]
+    pub fn write_ok(
+        index: Index,
+        process: Process,
+        key: &str,
+        value: u64,
+        version: Option<u64>,
+    ) -> Self {
+        Self {
+            index,
+            process,
+            kind: Kind::Ok,
+            f: RegF::Write,
+            key: key.to_string(),
+            value: Some(value),
+            version,
+        }
+    }
+
+    /// A write fail: the overwrite lost its commit CAS to a concurrent winner — it
+    /// **definitely did not take effect**, so its value was never at the commit point.
+    #[must_use]
+    pub fn write_fail(index: Index, process: Process, key: &str, value: u64) -> Self {
+        Self {
+            index,
+            process,
+            kind: Kind::Fail,
+            f: RegF::Write,
+            key: key.to_string(),
+            value: Some(value),
+            version: None,
+        }
+    }
+
+    /// A read invoke: `process` is about to read `key`.
+    #[must_use]
+    pub fn read_invoke(index: Index, process: Process, key: &str) -> Self {
+        Self {
+            index,
+            process,
+            kind: Kind::Invoke,
+            f: RegF::Read,
+            key: key.to_string(),
+            value: None,
+            version: None,
+        }
+    }
+
+    /// A read ok: `process` observed `value` at commit `version`.
+    #[must_use]
+    pub fn read_ok(index: Index, process: Process, key: &str, value: u64, version: u64) -> Self {
+        Self {
+            index,
+            process,
+            kind: Kind::Ok,
+            f: RegF::Read,
+            key: key.to_string(),
+            value: Some(value),
+            version: Some(version),
+        }
+    }
+
+    /// A read ok that found the key absent.
+    #[must_use]
+    pub fn read_absent(index: Index, process: Process, key: &str) -> Self {
+        Self {
+            index,
+            process,
+            kind: Kind::Ok,
+            f: RegF::Read,
+            key: key.to_string(),
+            value: None,
+            version: None,
+        }
+    }
+}
+
+/// The kind of register-linearizability violation found.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum RegViolationKind {
+    /// A read returned a `(value, version)` the commit point never produced — a torn read, a
+    /// value no committed write wrote (e.g. a failed write's value), or two reads that
+    /// disagree on the value at one version.
+    TornRead,
+    /// A read (or write observation) saw a strictly older version than one already observed to
+    /// have completed earlier in real time — a stale read / version regression.
+    VersionRegression,
+    /// Two distinct writes both won the same commit-point version (a double-commit), whether
+    /// they wrote the same or different values.
+    TwoWinners,
+    /// The history is malformed (an unmatched invoke/complete).
+    Malformed,
+}
+
+/// A register-linearizability violation: the failing clause plus a human-readable detail.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct RegisterViolation {
+    /// Which ADR-0015 guarantee-2 clause failed.
+    pub kind: RegViolationKind,
+    /// A human-readable description naming the offending ops.
+    pub detail: String,
+}
+
+impl fmt::Display for RegisterViolation {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        write!(f, "register {:?}: {}", self.kind, self.detail)
+    }
+}
+
+/// A completed register operation with its real-time interval `[t_invoke, t_complete]`.
+struct RegCompleted {
+    f: RegF,
+    key: String,
+    value: Option<u64>,
+    version: Option<u64>,
+    ok: bool,
+    t_invoke: Index,
+    t_complete: Index,
+}
+
+fn pair_register(ops: &[RegOp]) -> Result<Vec<RegCompleted>, RegisterViolation> {
+    let mut sorted: Vec<&RegOp> = ops.iter().collect();
+    sorted.sort_by_key(|o| o.index);
+    let mut open: BTreeMap<Process, &RegOp> = BTreeMap::new();
+    let mut done = Vec::new();
+    for op in sorted {
+        match op.kind {
+            Kind::Invoke => {
+                if open.insert(op.process, op).is_some() {
+                    return Err(RegisterViolation {
+                        kind: RegViolationKind::Malformed,
+                        detail: format!("process {} invoked twice without completing", op.process),
+                    });
+                }
+            }
+            Kind::Ok | Kind::Fail => {
+                let Some(inv) = open.remove(&op.process) else {
+                    return Err(RegisterViolation {
+                        kind: RegViolationKind::Malformed,
+                        detail: format!("process {} completed with no open invoke", op.process),
+                    });
+                };
+                done.push(RegCompleted {
+                    f: op.f,
+                    key: op.key.clone(),
+                    // A write carries its value on both events; a read carries it on ok.
+                    value: op.value.or(inv.value),
+                    version: op.version,
+                    ok: matches!(op.kind, Kind::Ok),
+                    t_invoke: inv.index,
+                    t_complete: op.index,
+                });
+            }
+        }
+    }
+    Ok(done)
+}
+
+/// Check a register history for **linearizability of the commit point** (ADR-0015 guarantee
+/// 2, ADR-0041 §Decision 1): read-after-commit with no torn or stale read,
+/// exactly-one-writer-wins, and no version regression.
+///
+/// The check exploits the inode `version` as the commit point's linearization index — "the
+/// commit point totally orders its versions" (ADR-0041) — so it runs in polynomial time
+/// rather than searching linearizations:
+///
+/// * **No torn read / version→value is a function.** Every committed version maps to exactly
+///   one value; two reads (or a read and a committing write) that report different values at
+///   the same version is a torn read.
+/// * **Value provenance.** A read may only return a value some **committed** write actually
+///   wrote — a value only a failed write attempted was never at the commit point.
+/// * **No stale read / no version regression.** If observation `a` completed (in real time)
+///   before observation `b` began, `b`'s version must be `>= a`'s — a later observation may
+///   never see an older commit point.
+/// * **Exactly-one-writer-wins.** No two committed writes may report the same `(key, version)`.
+///
+/// # Errors
+/// Returns the failing clause as a [`RegisterViolation`].
+pub fn check_register(ops: &[RegOp]) -> Result<(), RegisterViolation> {
+    let done = pair_register(ops)?;
+
+    // The set of values a COMMITTED write actually wrote, per key (the provenance domain). A
+    // read may only return a value some committed write wrote; a value only a FAILED write
+    // attempted was never at the commit point (`Kind::Fail` = "definitely did not take
+    // effect"), so reading it is a torn read. Gate on `c.ok` — the same committed-only filter
+    // Pass 1 below and the namespace model (`if !c.ok { continue }`) already apply.
+    let mut written: BTreeMap<&str, BTreeSet<u64>> = BTreeMap::new();
+    for c in &done {
+        if c.f == RegF::Write && c.ok {
+            if let Some(v) = c.value {
+                written.entry(c.key.as_str()).or_default().insert(v);
+            }
+        }
+    }
+
+    // Pass 1 — exactly-one-writer-wins: each committed `(key, version)` is produced by
+    // EXACTLY one write. Two committed writes reporting the same `(key, version)` are two
+    // winners at one commit point, whether they wrote different OR identical values (a
+    // same-value double-commit is still two winners — count occurrences, not distinct
+    // values). Checked before the torn-read pass so a genuine double-commit surfaces as
+    // `TwoWinners` rather than as its downstream torn-read symptom.
+    let mut winners: BTreeMap<(&str, u64), Vec<u64>> = BTreeMap::new();
+    for c in &done {
+        if c.f == RegF::Write && c.ok {
+            if let (Some(val), Some(ver)) = (c.value, c.version) {
+                let vals = winners.entry((c.key.as_str(), ver)).or_default();
+                vals.push(val);
+                if vals.len() > 1 {
+                    return Err(RegisterViolation {
+                        kind: RegViolationKind::TwoWinners,
+                        detail: format!(
+                            "version {ver} of {:?} was won by {} distinct writes (values {vals:?})",
+                            c.key,
+                            vals.len(),
+                        ),
+                    });
+                }
+            }
+        }
+    }
+
+    // Pass 2 — no torn read: version -> value is a function, and a read may only return a
+    // value some committed write wrote. Seed the map from committing writes, then check every
+    // read.
+    let mut version_value: BTreeMap<(&str, u64), u64> = BTreeMap::new();
+    for c in &done {
+        if c.f == RegF::Write && c.ok {
+            if let (Some(val), Some(ver)) = (c.value, c.version) {
+                version_value.insert((c.key.as_str(), ver), val);
+            }
+        }
+    }
+    for c in &done {
+        if c.f == RegF::Read && c.ok {
+            let (Some(val), Some(ver)) = (c.value, c.version) else {
+                continue; // an absent-key read observes nothing
+            };
+            if !written
+                .get(c.key.as_str())
+                .is_some_and(|s| s.contains(&val))
+            {
+                return Err(RegisterViolation {
+                    kind: RegViolationKind::TornRead,
+                    detail: format!(
+                        "read of {:?} returned value {val} at version {ver} that no committed write ever wrote",
+                        c.key
+                    ),
+                });
+            }
+            match version_value.get(&(c.key.as_str(), ver)) {
+                Some(prev) if *prev != val => {
+                    return Err(RegisterViolation {
+                        kind: RegViolationKind::TornRead,
+                        detail: format!(
+                            "version {ver} of {:?} observed with two values ({prev} and {val})",
+                            c.key
+                        ),
+                    });
+                }
+                Some(_) => {}
+                None => {
+                    version_value.insert((c.key.as_str(), ver), val);
+                }
+            }
+        }
+    }
+
+    // Pass 3 — no stale read / no version regression: per key, a later (non-overlapping) observation
+    // must see a version >= an earlier one. Observations are reads and committing writes that
+    // carry a version.
+    let mut obs_by_key: BTreeMap<&str, Vec<(&RegCompleted, u64)>> = BTreeMap::new();
+    for c in &done {
+        if !c.ok {
+            continue;
+        }
+        if let Some(ver) = c.version {
+            if c.value.is_some() {
+                obs_by_key.entry(c.key.as_str()).or_default().push((c, ver));
+            }
+        }
+    }
+    for (key, obs) in &obs_by_key {
+        for (a, va) in obs {
+            for (b, vb) in obs {
+                // `a` completed strictly before `b` began (they do not overlap in real time).
+                if a.t_complete < b.t_invoke && vb < va {
+                    return Err(RegisterViolation {
+                        kind: RegViolationKind::VersionRegression,
+                        detail: format!(
+                            "{key:?}: an observation of version {va} completed before an observation of the older version {vb} began"
+                        ),
+                    });
+                }
+            }
+        }
+    }
+
+    Ok(())
+}
+
+// ─── Session checks (ADR-0041 §Decision 3; ADR-0015 guarantee 3) ──────────────────────
+
+/// A per-session (read-your-writes / monotonic-read) violation.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct SessionViolation {
+    /// A human-readable description naming the offending session and versions.
+    pub detail: String,
+}
+
+impl fmt::Display for SessionViolation {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        write!(f, "session: {}", self.detail)
+    }
+}
+
+/// Check **read-your-writes** (ADR-0015 guarantee 3): within a session, once it has written
+/// a version of a key, every later read of that key by the same session must observe a
+/// version `>=` its own write. Applies to register keys and [`META_VERSION_KEY`] alike.
+///
+/// # Errors
+/// Returns a [`SessionViolation`] naming the session and versions.
+pub fn check_read_your_writes(ops: &[RegOp]) -> Result<(), SessionViolation> {
+    let mut sorted: Vec<&RegOp> = ops.iter().collect();
+    sorted.sort_by_key(|o| o.index);
+    // (process, key) -> the max version this session has itself written.
+    let mut own: BTreeMap<(Process, &str), u64> = BTreeMap::new();
+    for op in sorted {
+        match (op.f, op.kind) {
+            (RegF::Write, Kind::Ok) => {
+                if let Some(ver) = op.version {
+                    let e = own.entry((op.process, op.key.as_str())).or_insert(0);
+                    *e = (*e).max(ver);
+                }
+            }
+            (RegF::Read, Kind::Ok) => {
+                if let (Some(ver), Some(&floor)) =
+                    (op.version, own.get(&(op.process, op.key.as_str())))
+                {
+                    if ver < floor {
+                        return Err(SessionViolation {
+                            detail: format!(
+                                "process {} wrote version {floor} of {:?} but later read the older version {ver}",
+                                op.process, op.key
+                            ),
+                        });
+                    }
+                }
+            }
+            _ => {}
+        }
+    }
+    Ok(())
+}
+
+/// Check **monotonic reads** (ADR-0015 guarantee 3): within a session, successive reads of a
+/// key never go backwards in version. Applies to register keys and [`META_VERSION_KEY`].
+///
+/// # Errors
+/// Returns a [`SessionViolation`] naming the session and versions.
+pub fn check_monotonic_reads(ops: &[RegOp]) -> Result<(), SessionViolation> {
+    let mut sorted: Vec<&RegOp> = ops.iter().collect();
+    sorted.sort_by_key(|o| o.index);
+    let mut last: BTreeMap<(Process, &str), u64> = BTreeMap::new();
+    for op in sorted {
+        if op.f == RegF::Read && op.kind == Kind::Ok {
+            if let Some(ver) = op.version {
+                let e = last.entry((op.process, op.key.as_str())).or_insert(0);
+                if ver < *e {
+                    return Err(SessionViolation {
+                        detail: format!(
+                            "process {} read version {} of {:?} after already reading the newer version {}",
+                            op.process, ver, op.key, *e
+                        ),
+                    });
+                }
+                *e = ver;
+            }
+        }
+    }
+    Ok(())
+}
+
+// ─── List-append / set model (ADR-0041 §Decision 2; ADR-0015 guarantee 1) ─────────────
+
+/// A namespace operation function.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum NsF {
+    /// Bind a new name in the directory (an S3 PUT of a fresh key).
+    Create,
+    /// Unbind a name (an S3 DELETE).
+    Delete,
+    /// Move a name binding (a single dirent mutation): removes the source, adds the
+    /// destination.
+    Rename,
+    /// Read the directory's entry set.
+    List,
+}
+
+/// One event in the namespace history.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct NsOp {
+    /// Recording order (real-time proxy).
+    pub index: Index,
+    /// The process/session that issued the op.
+    pub process: Process,
+    /// Invoke / ok / fail.
+    pub kind: Kind,
+    /// Create / delete / rename / list.
+    pub f: NsF,
+    /// Create / delete: the name. Rename: the source name.
+    pub name: String,
+    /// Rename: the destination name.
+    pub to: Option<String>,
+    /// List-ok: the returned entry set.
+    pub entries: Option<Vec<String>>,
+}
+
+impl NsOp {
+    fn simple(index: Index, process: Process, kind: Kind, f: NsF, name: &str) -> Self {
+        Self {
+            index,
+            process,
+            kind,
+            f,
+            name: name.to_string(),
+            to: None,
+            entries: None,
+        }
+    }
+
+    /// A create invoke.
+    #[must_use]
+    pub fn create_invoke(index: Index, process: Process, name: &str) -> Self {
+        Self::simple(index, process, Kind::Invoke, NsF::Create, name)
+    }
+    /// A create ok (the name was bound).
+    #[must_use]
+    pub fn create_ok(index: Index, process: Process, name: &str) -> Self {
+        Self::simple(index, process, Kind::Ok, NsF::Create, name)
+    }
+    /// A create fail (the name was already bound / lost a CAS).
+    #[must_use]
+    pub fn create_fail(index: Index, process: Process, name: &str) -> Self {
+        Self::simple(index, process, Kind::Fail, NsF::Create, name)
+    }
+    /// A delete invoke.
+    #[must_use]
+    pub fn delete_invoke(index: Index, process: Process, name: &str) -> Self {
+        Self::simple(index, process, Kind::Invoke, NsF::Delete, name)
+    }
+    /// A delete ok (the name was unbound).
+    #[must_use]
+    pub fn delete_ok(index: Index, process: Process, name: &str) -> Self {
+        Self::simple(index, process, Kind::Ok, NsF::Delete, name)
+    }
+    /// A rename invoke (`from` -> `to`).
+    #[must_use]
+    pub fn rename_invoke(index: Index, process: Process, from: &str, to: &str) -> Self {
+        Self {
+            to: Some(to.to_string()),
+            ..Self::simple(index, process, Kind::Invoke, NsF::Rename, from)
+        }
+    }
+    /// A rename ok (`from` -> `to`).
+    #[must_use]
+    pub fn rename_ok(index: Index, process: Process, from: &str, to: &str) -> Self {
+        Self {
+            to: Some(to.to_string()),
+            ..Self::simple(index, process, Kind::Ok, NsF::Rename, from)
+        }
+    }
+    /// A list invoke.
+    #[must_use]
+    pub fn list_invoke(index: Index, process: Process) -> Self {
+        Self::simple(index, process, Kind::Invoke, NsF::List, "")
+    }
+    /// A list ok returning `entries`.
+    #[must_use]
+    pub fn list_ok(index: Index, process: Process, entries: Vec<String>) -> Self {
+        Self {
+            entries: Some(entries),
+            ..Self::simple(index, process, Kind::Ok, NsF::List, "")
+        }
+    }
+}
+
+/// The kind of namespace-linearizability violation found.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum NsViolationKind {
+    /// A name whose create (or rename destination) completed and was not removed is absent
+    /// from a later list.
+    LostCreate,
+    /// A deleted (or renamed-away) name reappears in a later list without an intervening
+    /// re-create.
+    ResurrectedDelete,
+    /// The history is malformed (an unmatched invoke/complete).
+    Malformed,
+}
+
+/// A namespace-linearizability violation.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct NamespaceViolation {
+    /// Which ADR-0015 guarantee-1 clause failed.
+    pub kind: NsViolationKind,
+    /// A human-readable description.
+    pub detail: String,
+}
+
+impl fmt::Display for NamespaceViolation {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        write!(f, "namespace {:?}: {}", self.kind, self.detail)
+    }
+}
+
+struct NsCompleted {
+    f: NsF,
+    name: String,
+    to: Option<String>,
+    entries: Option<Vec<String>>,
+    ok: bool,
+    t_invoke: Index,
+    t_complete: Index,
+}
+
+fn pair_namespace(ops: &[NsOp]) -> Result<Vec<NsCompleted>, NamespaceViolation> {
+    let mut sorted: Vec<&NsOp> = ops.iter().collect();
+    sorted.sort_by_key(|o| o.index);
+    let mut open: BTreeMap<Process, &NsOp> = BTreeMap::new();
+    let mut done = Vec::new();
+    for op in sorted {
+        match op.kind {
+            Kind::Invoke => {
+                if open.insert(op.process, op).is_some() {
+                    return Err(NamespaceViolation {
+                        kind: NsViolationKind::Malformed,
+                        detail: format!("process {} invoked twice without completing", op.process),
+                    });
+                }
+            }
+            Kind::Ok | Kind::Fail => {
+                let Some(inv) = open.remove(&op.process) else {
+                    return Err(NamespaceViolation {
+                        kind: NsViolationKind::Malformed,
+                        detail: format!("process {} completed with no open invoke", op.process),
+                    });
+                };
+                done.push(NsCompleted {
+                    f: op.f,
+                    name: op.name.clone(),
+                    to: op.to.clone().or_else(|| inv.to.clone()),
+                    entries: op.entries.clone(),
+                    ok: matches!(op.kind, Kind::Ok),
+                    t_invoke: inv.index,
+                    t_complete: op.index,
+                });
+            }
+        }
+    }
+    Ok(done)
+}
+
+/// Check a namespace history for **namespace linearizability** (ADR-0015 guarantee 1,
+/// ADR-0041 §Decision 2): no lost create and no resurrected delete.
+///
+/// The check is conservative over real-time intervals, so it never rejects a genuinely
+/// linearizable history: an "add" or "remove" of a name is only *asserted* when it is
+/// **definite** — completed before the list began (add) / began before the list ended
+/// (remove) — and a name that is only *possibly* mutated during a list is excused. A rename
+/// contributes both a remove of its source and an add of its destination.
+///
+/// * **No lost create.** If an add of `x` completed before a list began and no remove of `x`
+///   even began before the list ended, `x` must be in the list.
+/// * **No resurrected delete.** If a delete of `x` completed before a list began and no
+///   re-create of `x` began after that delete and before the list ended, `x` must be absent;
+///   and any name present in a list must have some create that began before the list ended.
+///
+/// # Errors
+/// Returns the failing clause as a [`NamespaceViolation`].
+pub fn check_list_append(ops: &[NsOp]) -> Result<(), NamespaceViolation> {
+    let done = pair_namespace(ops)?;
+
+    // Adds and removes of a name, with their real-time intervals. Built from `ok` events only
+    // — a failed create/delete/rename never mutated the namespace.
+    struct Ev {
+        t_invoke: Index,
+        t_complete: Index,
+    }
+    let mut adds: BTreeMap<String, Vec<Ev>> = BTreeMap::new();
+    let mut removes: BTreeMap<String, Vec<Ev>> = BTreeMap::new();
+    for c in &done {
+        if !c.ok {
+            continue;
+        }
+        match c.f {
+            NsF::Create => adds.entry(c.name.clone()).or_default().push(Ev {
+                t_invoke: c.t_invoke,
+                t_complete: c.t_complete,
+            }),
+            NsF::Delete => removes.entry(c.name.clone()).or_default().push(Ev {
+                t_invoke: c.t_invoke,
+                t_complete: c.t_complete,
+            }),
+            NsF::Rename => {
+                removes.entry(c.name.clone()).or_default().push(Ev {
+                    t_invoke: c.t_invoke,
+                    t_complete: c.t_complete,
+                });
+                if let Some(to) = &c.to {
+                    adds.entry(to.clone()).or_default().push(Ev {
+                        t_invoke: c.t_invoke,
+                        t_complete: c.t_complete,
+                    });
+                }
+            }
+            NsF::List => {}
+        }
+    }
+
+    for c in &done {
+        if c.f != NsF::List || !c.ok {
+            continue;
+        }
+        let Some(entries) = &c.entries else { continue };
+        let present: BTreeSet<&str> = entries.iter().map(String::as_str).collect();
+        let (ls, le) = (c.t_invoke, c.t_complete);
+
+        // No lost create: a definitely-added, not-possibly-removed name must be present.
+        for (name, name_adds) in &adds {
+            let definitely_added = name_adds.iter().any(|a| a.t_complete < ls);
+            if !definitely_added {
+                continue;
+            }
+            let possibly_removed = removes
+                .get(name)
+                .is_some_and(|rs| rs.iter().any(|r| r.t_invoke < le));
+            if !possibly_removed && !present.contains(name.as_str()) {
+                return Err(NamespaceViolation {
+                    kind: NsViolationKind::LostCreate,
+                    detail: format!(
+                        "name {name:?} was created and not removed, but a later list omitted it"
+                    ),
+                });
+            }
+        }
+
+        // No resurrected delete: a present name must have some plausible create, and a
+        // definitely-deleted name with no re-create must be absent.
+        for name in &present {
+            let plausibly_created = adds
+                .get(*name)
+                .is_some_and(|as_| as_.iter().any(|a| a.t_invoke < le));
+            if !plausibly_created {
+                return Err(NamespaceViolation {
+                    kind: NsViolationKind::ResurrectedDelete,
+                    detail: format!("a list returned name {name:?} that was never created"),
+                });
+            }
+            if let Some(rs) = removes.get(*name) {
+                for r in rs {
+                    if r.t_complete >= ls {
+                        continue; // not definitely deleted before the list began
+                    }
+                    let recreated = adds.get(*name).is_some_and(|as_| {
+                        as_.iter()
+                            .any(|a| a.t_invoke > r.t_complete && a.t_invoke < le)
+                    });
+                    if !recreated {
+                        return Err(NamespaceViolation {
+                            kind: NsViolationKind::ResurrectedDelete,
+                            detail: format!(
+                                "name {name:?} was deleted but reappeared in a later list without a re-create"
+                            ),
+                        });
+                    }
+                }
+            }
+        }
+    }
+
+    Ok(())
+}
+
+// ─── Concurrency witnesses (the non-vacuous-history bar, Success criterion (d)) ────────
+
+/// The maximum number of register operations that were **in flight simultaneously** — the
+/// concurrency depth of the recorded history. `>= 2` means the history genuinely contains
+/// overlapping ops (not a serial log), which is what makes a linearizability history
+/// non-vacuous (ADR-0041 §Context: the #250 vacuous-history mistake).
+#[must_use]
+pub fn max_register_concurrency(ops: &[RegOp]) -> usize {
+    let mut events: Vec<(Index, i32)> = Vec::new();
+    for op in ops {
+        match op.kind {
+            Kind::Invoke => events.push((op.index, 1)),
+            Kind::Ok | Kind::Fail => events.push((op.index, -1)),
+        }
+    }
+    events.sort_by_key(|e| e.0);
+    let mut cur = 0i32;
+    let mut peak = 0i32;
+    for (_, delta) in events {
+        cur += delta;
+        peak = peak.max(cur);
+    }
+    usize::try_from(peak.max(0)).unwrap_or(0)
+}
+
+/// The largest register version any read observed — `>= 2` proves at least one real overwrite
+/// bumped the inode `version` past its `commit_create` value of 1 (ADR-0041 §Decision 1).
+#[must_use]
+pub fn max_observed_version(ops: &[RegOp]) -> u64 {
+    ops.iter()
+        .filter(|o| o.f == RegF::Read && o.kind == Kind::Ok)
+        .filter_map(|o| o.version)
+        .max()
+        .unwrap_or(0)
+}
+
+// ─── History recorder ─────────────────────────────────────────────────────────────────
+
+/// Accumulates a register history and a namespace history from a running workload, in a
+/// single monotone recording order. A concurrent workload shares one recorder behind a mutex;
+/// each `record_*` call is a short critical section, so the recording order is the real-time
+/// interleaving of the ops (a real-time proxy for the models). Reusable by both the in-process
+/// driver here and a wire-driven driver later (#405).
+#[derive(Debug, Default)]
+pub struct HistoryRecorder {
+    seq: Index,
+    /// The recorded register (rw-register) events.
+    pub register: Vec<RegOp>,
+    /// The recorded namespace (list-append/set) events.
+    pub namespace: Vec<NsOp>,
+}
+
+impl HistoryRecorder {
+    /// A fresh, empty recorder.
+    #[must_use]
+    pub fn new() -> Self {
+        Self::default()
+    }
+
+    fn next(&mut self) -> Index {
+        let i = self.seq;
+        self.seq += 1;
+        i
+    }
+
+    /// Record a register write invoke; returns nothing — invoke/complete pair by process.
+    pub fn write_invoke(&mut self, process: Process, key: &str, value: u64) {
+        let i = self.next();
+        self.register
+            .push(RegOp::write_invoke(i, process, key, value));
+    }
+    /// Record a register write ok (committed `value` at commit `version` when observable).
+    pub fn write_ok(&mut self, process: Process, key: &str, value: u64, version: Option<u64>) {
+        let i = self.next();
+        self.register
+            .push(RegOp::write_ok(i, process, key, value, version));
+    }
+    /// Record a register write fail (lost the commit CAS — definitely did not take effect).
+    pub fn write_fail(&mut self, process: Process, key: &str, value: u64) {
+        let i = self.next();
+        self.register
+            .push(RegOp::write_fail(i, process, key, value));
+    }
+    /// Record a register read invoke.
+    pub fn read_invoke(&mut self, process: Process, key: &str) {
+        let i = self.next();
+        self.register.push(RegOp::read_invoke(i, process, key));
+    }
+    /// Record a register read ok.
+    pub fn read_ok(&mut self, process: Process, key: &str, value: u64, version: u64) {
+        let i = self.next();
+        self.register
+            .push(RegOp::read_ok(i, process, key, value, version));
+    }
+    /// Record a register read that found the key absent.
+    pub fn read_absent(&mut self, process: Process, key: &str) {
+        let i = self.next();
+        self.register.push(RegOp::read_absent(i, process, key));
+    }
+
+    /// Record a namespace create invoke.
+    pub fn create_invoke(&mut self, process: Process, name: &str) {
+        let i = self.next();
+        self.namespace.push(NsOp::create_invoke(i, process, name));
+    }
+    /// Record a namespace create ok.
+    pub fn create_ok(&mut self, process: Process, name: &str) {
+        let i = self.next();
+        self.namespace.push(NsOp::create_ok(i, process, name));
+    }
+    /// Record a namespace create fail.
+    pub fn create_fail(&mut self, process: Process, name: &str) {
+        let i = self.next();
+        self.namespace.push(NsOp::create_fail(i, process, name));
+    }
+    /// Record a namespace delete invoke.
+    pub fn delete_invoke(&mut self, process: Process, name: &str) {
+        let i = self.next();
+        self.namespace.push(NsOp::delete_invoke(i, process, name));
+    }
+    /// Record a namespace delete ok.
+    pub fn delete_ok(&mut self, process: Process, name: &str) {
+        let i = self.next();
+        self.namespace.push(NsOp::delete_ok(i, process, name));
+    }
+    /// Record a namespace rename invoke (`from` -> `to`).
+    pub fn rename_invoke(&mut self, process: Process, from: &str, to: &str) {
+        let i = self.next();
+        self.namespace
+            .push(NsOp::rename_invoke(i, process, from, to));
+    }
+    /// Record a namespace rename ok (`from` -> `to`).
+    pub fn rename_ok(&mut self, process: Process, from: &str, to: &str) {
+        let i = self.next();
+        self.namespace.push(NsOp::rename_ok(i, process, from, to));
+    }
+    /// Record a namespace list invoke.
+    pub fn list_invoke(&mut self, process: Process) {
+        let i = self.next();
+        self.namespace.push(NsOp::list_invoke(i, process));
+    }
+    /// Record a namespace list ok returning `entries`.
+    pub fn list_ok(&mut self, process: Process, entries: Vec<String>) {
+        let i = self.next();
+        self.namespace.push(NsOp::list_ok(i, process, entries));
+    }
+}
+
+// ─── Checker-compatible serialization (Elle op-map EDN) ───────────────────────────────
+
+fn kind_edn(kind: Kind) -> &'static str {
+    match kind {
+        Kind::Invoke => ":invoke",
+        Kind::Ok => ":ok",
+        Kind::Fail => ":fail",
+    }
+}
+
+fn edn_value(v: Option<u64>) -> String {
+    v.map_or_else(|| "nil".to_string(), |x| x.to_string())
+}
+
+/// Serialize the register history to the **Elle `rw-register` op-map EDN** the off-Check
+/// verdict consumes (ADR-0041: encode/serialize in Rust, run the JVM verdict off-Check).
+/// Each op is `{:index i, :process p, :type t, :f :txn, :value [[:w|:r key val]]}` — the
+/// recognized `elle.rw-register` transactional shape.
+#[must_use]
+pub fn register_to_edn(ops: &[RegOp]) -> String {
+    let mut sorted: Vec<&RegOp> = ops.iter().collect();
+    sorted.sort_by_key(|o| o.index);
+    let mut out = String::from("[\n");
+    for op in sorted {
+        let mop = match op.f {
+            RegF::Write => format!("[:w {:?} {}]", op.key, edn_value(op.value)),
+            RegF::Read => format!("[:r {:?} {}]", op.key, edn_value(op.value)),
+        };
+        out.push_str(&format!(
+            " {{:index {}, :process {}, :type {}, :f :txn, :value [{}]}}\n",
+            op.index,
+            op.process,
+            kind_edn(op.kind),
+            mop
+        ));
+    }
+    out.push(']');
+    out
+}
+
+/// Serialize the namespace history to **Elle `list-append` op-map EDN**. Create/rename append
+/// to a per-directory list, delete removes, and list reads it back.
+#[must_use]
+pub fn namespace_to_edn(ops: &[NsOp]) -> String {
+    let mut sorted: Vec<&NsOp> = ops.iter().collect();
+    sorted.sort_by_key(|o| o.index);
+    let mut out = String::from("[\n");
+    for op in sorted {
+        let mop = match op.f {
+            NsF::Create => format!("[:append :dir {:?}]", op.name),
+            NsF::Delete => format!("[:delete :dir {:?}]", op.name),
+            NsF::Rename => format!(
+                "[:rename :dir {:?} {:?}]",
+                op.name,
+                op.to.clone().unwrap_or_default()
+            ),
+            NsF::List => {
+                let items = op
+                    .entries
+                    .as_ref()
+                    .map(|e| {
+                        e.iter()
+                            .map(|n| format!("{n:?}"))
+                            .collect::<Vec<_>>()
+                            .join(" ")
+                    })
+                    .unwrap_or_default();
+                format!("[:r :dir [{items}]]")
+            }
+        };
+        out.push_str(&format!(
+            " {{:index {}, :process {}, :type {}, :f :txn, :value [{}]}}\n",
+            op.index,
+            op.process,
+            kind_edn(op.kind),
+            mop
+        ));
+    }
+    out.push(']');
+    out
+}
+
+// ─── Off-Check verdict seam (ADR-0041/ADR-0016: JVM verdict is off-Check) ──────────────
+
+/// Where the consistency **verdict** runs. Mirrors `xtask/src/metadata_faults.rs`'s
+/// `MetadataTierDispatch`: the pure Rust models run at Check on every history; the live
+/// Elle/JVM verdict over the same serialized history is representable but routed to a
+/// **privileged off-Check job** only — it MUST NOT enter `cargo xtask ci` (ADR-0016).
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum VerdictLeg {
+    /// The pure-Rust model checkers ([`check_register`] / [`check_list_append`] / the session
+    /// checks) — always run at Check, no JVM.
+    InProcessModels,
+    /// The recognized off-Check checker over the serialized EDN history (deferred; ADR-0041).
+    OffCheckElle {
+        /// The Elle model name (e.g. [`ELLE_RW_REGISTER`]).
+        checker: &'static str,
+    },
+}
+
+/// Decide where the verdict routes. Pure — decided solely from whether a privileged JVM
+/// checker environment is configured — so this is unit-checkable inside the unprivileged
+/// `cargo xtask ci` gate. The default (no JVM) is always the in-process Rust models; the
+/// off-Check Elle leg is selected only in the privileged job, keeping JVM/Clojure out of the
+/// merge gate (ADR-0016/ADR-0041).
+#[must_use]
+pub fn verdict_dispatch(jvm_checker_available: bool) -> VerdictLeg {
+    if jvm_checker_available {
+        VerdictLeg::OffCheckElle {
+            checker: ELLE_RW_REGISTER,
+        }
+    } else {
+        VerdictLeg::InProcessModels
+    }
+}
