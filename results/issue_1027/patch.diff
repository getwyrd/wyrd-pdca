+    let (planted, found) = match damage {
+        "same epoch" => (same_epoch_other_bytes(&live), 2),
+        _ => (original, 0),
+    };
+    let plant = rig.plant(mpu_key(&rig.upload), planted);
+    (rig, attempt, plant, found)
+}
