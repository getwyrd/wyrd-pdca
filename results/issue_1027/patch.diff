+        rig.store.after_scan(vec![Step::Advance(lapse)]);
+        let cause = stopped(rig.commit(attempt.clone()).await, true);
+        assert!(matches!(cause, Stop::LeaseShort { .. }), "{cause:?}");
+        assert_eq!(rig.log.commits(Kind::Commit).len(), 0);
