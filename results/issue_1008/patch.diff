+                Some(record) if Some(&record.summary()) == summary => {
+                    chunks.extend_from_slice(record.chunks());
+                }
+                _ => {
+                    return Err(Stop::PartDisagrees {
+                        part_number: *part_number,
+                    })
+                }
+            }
+        }
