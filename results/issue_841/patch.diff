+    use super::*;
+
+    fn session(state: &str, epoch: u64) -> SessionRecord {
+        let json = format!(
+            "{{\"parent\":42,\"object\":\"o\",\"created_at_millis\":100,\"clock_source\":\"wall\",\
+             \"segment_nonce\":\"0123456789abcdef0123456789abcdef\",\"epoch\":{epoch},\
+             \"attempts\":1,\"state\":{state}}}"
