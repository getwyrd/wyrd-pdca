+++ b/crates/coordination-etcd/Cargo.toml
@@ -0,0 +1,66 @@
+[package]
+name = "wyrd-coordination-etcd"
+description = "etcd-backed Coordination (ADR-0006): the networked SECOND implementation of the L5 `Coordination` trait — leased service discovery, single-leader election with fencing tokens, mutually-exclusive fenced locks, and revisioned config — behind the byte-for-byte-unchanged trait, selected by `server` composition (ADR-0008/0016). The mirror of `metadata-tikv` for `MetadataStore` (proposal 0015 §\"Deployment prerequisite\", #365)."
+version.workspace = true
+edition.workspace = true
+rust-version.workspace = true
+license.workspace = true
+repository.workspace = true
+publish.workspace = true
+
+[features]
+# OFF by default. The real `etcd-client` tree REGENERATES its etcd protobufs at
+# build time (it needs a system `protoc`) and dials a live etcd, so the default
+# `cargo xtask ci` on a laptop/worktree never compiles it and stays green — the
+# `metadata-tikv` posture (the ADR-0003 three-test audit + `deny.toml` allowlist
+# review for the etcd client is a NEEDS-HUMAN; INTEGRATION §4). The store itself is
+# ALSO compiled under `--cfg madsim`, where `etcd-client` ALIASES to
+# `madsim-etcd-client` (no protoc, no live etcd), so its distributed correctness is
+# proven DETERMINISTICALLY by the `dst` tier (`crates/dst/tests/coordination.rs`),
+# not resting on a manual real-etcd invocation. `cargo xtask etcd-conformance`
+# turns this feature on and drives the shared suite against a throwaway `deploy/` etcd.
+default = []
+etcd = ["dep:etcd-client", "dep:tokio"]
+
+[dependencies]
+wyrd-traits.workspace = true
+async-trait.workspace = true
+bytes.workspace = true
+# The real etcd client + a real reactor to host its keep-alive — optional, pulled
+# in ONLY by the `etcd` feature (ADR-0016: a concrete backend depends on `traits` +
+# its own backend client + runtime, never on `core` or a sibling concrete).
+etcd-client = { workspace = true, optional = true }
+tokio = { workspace = true, optional = true }
+
+# Under `--cfg madsim` the store compiles against the etcd SIMULATOR, aliased to
+# the same `etcd_client` path so ONE code path serves real etcd and the simulator.
+# `madsim-tokio` provides the spawn/time/sync surface the keep-alive uses, on the
+# deterministic simulated runtime (ADR-0009) — the same aliasing `dst`/`proto` use
+# for `tonic` -> `madsim-tonic`.
+# The rename-alias is specified inline (a member can't rename an inherited
+# workspace dep), exactly as `dst`/`proto` specify `madsim-tonic` inline.
+[target.'cfg(madsim)'.dependencies]
+etcd-client = { package = "madsim-etcd-client", version = "0.6.0" }
+tokio = { package = "madsim-tokio", version = "0.2.30", features = [
+    "rt",
+    "time",
+    "sync",
+    "macros",
+] }
+
+[dev-dependencies]
+# The shared trait-contract suite (the same one `coordination-mem` drives). Under
+# `--cfg madsim` it is driven against real store code over the simulator; with
+# `--features etcd` against a real etcd (endpoint-gated).
+wyrd-coordination-conformance.workspace = true
+
+# `etcd-client` / `tokio` are used only under the `etcd` feature (and the madsim
+# alias); keep cargo-machete quiet on the default (feature-off, non-madsim) scan,
+# where the optional deps look unreferenced.
+[package.metadata.cargo-machete]
+ignored = ["etcd-client", "tokio"]
+
+# Inherit the workspace lint policy (single source of truth in the root
+# Cargo.toml [workspace.lints.*]).
+[lints]
+workspace = true
diff --git a/crates/coordination-etcd/src/fencing.rs b/crates/coordination-etcd/src/fencing.rs
new file mode 100644
index 0000000..030f2db
--- /dev/null
+++ b/crates/coordination-etcd/src/fencing.rs
@@ -0,0 +1,37 @@
+//! Pure fencing-token derivation. No etcd dependency, so it is unit-tested on
+//! every build.
+//!
+//! etcd's mvcc **revision** is a single cluster-global counter, bumped on every
+//! write across the whole keyspace. So the revision at which a leader's candidate
+//! key was created, and the revision a lock's acquiring txn committed at, are both
+//! drawn from that one rising source — any later grant fences any earlier one,
+//! regardless of which kind it is (the [`FencingToken`] contract; the custodian's
+//! single-active guard depends on it, M3.3/#141).
+
+use wyrd_traits::FencingToken;
+
+/// Map an etcd revision to a [`FencingToken`]. A real commit revision is always a
+/// positive `i64`; a non-positive value (spec-impossible, e.g. an empty header)
+/// floors at 0 rather than wrapping through the `as u64` cast.
+pub fn token_from_revision(revision: i64) -> FencingToken {
+    revision.max(0) as FencingToken
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn tokens_track_the_revision_monotonically() {
+        assert!(token_from_revision(2) > token_from_revision(1));
+        assert!(token_from_revision(1_000_000) > token_from_revision(999_999));
+        assert_eq!(token_from_revision(7), 7);
+    }
+
+    #[test]
+    fn a_non_positive_revision_floors_at_zero_not_wraps() {
+        assert_eq!(token_from_revision(0), 0);
+        assert_eq!(token_from_revision(-1), 0, "must not wrap to u64::MAX");
+        assert_eq!(token_from_revision(i64::MIN), 0);
+    }
+}
diff --git a/crates/coordination-etcd/src/hold.rs b/crates/coordination-etcd/src/hold.rs
new file mode 100644
index 0000000..9faf39d
--- /dev/null
+++ b/crates/coordination-etcd/src/hold.rs
@@ -0,0 +1,38 @@
+//! Pure keep-alive cadence. No etcd dependency, so it is unit-tested on every
+//! build.
+//!
+//! A leadership/lock lease is granted for `ttl` seconds and renewed by a
+//! background task at [`keepalive_interval`] — a third of the TTL, so two
+//! consecutive missed renewals still leave headroom before the lease lapses (the
+//! etcd-recipe cadence). Floored at one second so a tiny TTL never spins the
+//! renewer into a busy loop.
+
+use std::time::Duration;
+
+/// The renewal cadence for a lease of `ttl_secs`: `ttl/3`, floored at 1s.
+pub fn keepalive_interval(ttl_secs: i64) -> Duration {
+    let ttl = ttl_secs.max(1);
+    Duration::from_secs((ttl / 3).max(1) as u64)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn renews_at_a_third_of_the_ttl_with_headroom() {
+        assert_eq!(keepalive_interval(6), Duration::from_secs(2));
+        assert_eq!(keepalive_interval(30), Duration::from_secs(10));
+        // Two missed renewals (2 * ttl/3) still precede expiry (ttl).
+        let ttl = 9;
+        assert!(keepalive_interval(ttl).as_secs() * 2 < ttl as u64);
+    }
+
+    #[test]
+    fn a_tiny_or_bogus_ttl_is_floored_at_one_second() {
+        assert_eq!(keepalive_interval(1), Duration::from_secs(1));
+        assert_eq!(keepalive_interval(2), Duration::from_secs(1));
+        assert_eq!(keepalive_interval(0), Duration::from_secs(1));
+        assert_eq!(keepalive_interval(-5), Duration::from_secs(1));
+    }
+}
diff --git a/crates/coordination-etcd/src/keyspace.rs b/crates/coordination-etcd/src/keyspace.rs
new file mode 100644
index 0000000..704c868
--- /dev/null
+++ b/crates/coordination-etcd/src/keyspace.rs
@@ -0,0 +1,104 @@
+//! Pure etcd key-layout for the coordination backend. No etcd dependency, so it
+//! is unit-tested on every build (including the default feature-off `ci`).
+//!
+//! Every key is placed under a per-instance `ns` (namespace) prefix so several
+//! coordinators can share one etcd cluster without colliding — the shared
+//! contract suite drives a fresh namespace per clause, exactly as the TiKV suite
+//! scopes a fresh keyspace per clause. Within a namespace the four concerns get
+//! disjoint sub-prefixes so a registration can never be mistaken for a lock, an
+//! election, or a config value.
+
+/// Registrations (leased service discovery).
+const REG: &str = "reg/";
+/// Distributed locks.
+const LOCK: &str = "lock/";
+/// Leader-election groups.
+const ELECT: &str = "elect/";
+/// Zone-wide config.
+const CONFIG: &str = "cfg/";
+
+/// The member key a single registration under `key` (with lease `lease_id`)
+/// occupies. The lease id disambiguates several members of the same discovery
+/// key; the trailing separator on [`registration_prefix`] keeps `svc/d` from
+/// matching `svc/deep`.
+pub fn registration_member(ns: &str, key: &str, lease_id: i64) -> String {
+    format!("{ns}{REG}{key}/{lease_id:016x}")
+}
+
+/// The prefix that discovers every member registered under `key`.
+pub fn registration_prefix(ns: &str, key: &str) -> String {
+    format!("{ns}{REG}{key}/")
+}
+
+/// The single key a distributed lock on `key` occupies.
+pub fn lock_key(ns: &str, key: &str) -> String {
+    format!("{ns}{LOCK}{key}")
+}
+
+/// The election name to campaign under for leadership of `key`.
+pub fn election_name(ns: &str, key: &str) -> String {
+    format!("{ns}{ELECT}{key}")
+}
+
+/// The key a config value for `key` occupies.
+pub fn config_key(ns: &str, key: &str) -> String {
+    format!("{ns}{CONFIG}{key}")
+}
+
+/// The prefix spanning all config keys (used to read the cluster revision that
+/// backs `config_revision`).
+pub fn config_prefix(ns: &str) -> String {
+    format!("{ns}{CONFIG}")
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn concerns_live_under_disjoint_prefixes() {
+        let ns = "wyrd/coord/A/";
+        let reg = registration_member(ns, "svc/d", 1);
+        let lock = lock_key(ns, "svc/d");
+        let elect = election_name(ns, "svc/d");
+        let cfg = config_key(ns, "svc/d");
+        // No concern's key is a prefix of another concern's key — a registration
+        // can never be read as a lock/election/config and vice versa.
+        for (a, b) in [(&reg, &lock), (&reg, &elect), (&reg, &cfg), (&lock, &elect)] {
+            assert!(
+                !a.starts_with(b.as_str()) && !b.starts_with(a.as_str()),
+                "{a} vs {b}"
+            );
+        }
+    }
+
+    #[test]
+    fn discovery_prefix_isolates_sibling_keys() {
+        let ns = "N/";
+        // `svc/d`'s members must not be discovered under `svc/deep`.
+        let member = registration_member(ns, "svc/d", 42);
+        assert!(member.starts_with(&registration_prefix(ns, "svc/d")));
+        assert!(!member.starts_with(&registration_prefix(ns, "svc/deep")));
+        assert!(!member.starts_with(&registration_prefix(ns, "svc/other")));
+    }
+
+    #[test]
+    fn namespaces_do_not_collide() {
+        assert_ne!(
+            registration_member("A/", "k", 1),
+            registration_member("B/", "k", 1)
+        );
+        assert!(lock_key("A/", "k").starts_with("A/"));
+        assert_eq!(config_prefix("A/"), "A/cfg/");
+        assert!(config_key("A/", "zone").starts_with(&config_prefix("A/")));
+    }
+
+    #[test]
+    fn member_key_is_stable_and_lease_scoped() {
+        assert_eq!(
+            registration_member("", "svc", 255),
+            "reg/svc/00000000000000ff"
+        );
+        assert_eq!(registration_prefix("", "svc"), "reg/svc/");
+    }
+}
