+++ b/crates/coordination-conformance/Cargo.toml
@@ -0,0 +1,30 @@
+[package]
+name = "wyrd-coordination-conformance"
+description = "The SHARED Coordination trait-contract suite: trait-generic assertions (register→discover, unique/rising leases, election-fenced, locks-mutually-exclusive-and-fenced, globally-monotonic fencing tokens) that EVERY Coordination backend passes — coordination-mem (process-local) and coordination-etcd (networked). One suite pins the trait for both, the ADR-0006 two-implementation discipline (mirror of wyrd-metadata-conformance for MetadataStore)."
+version.workspace = true
+edition.workspace = true
+rust-version.workspace = true
+license.workspace = true
+repository.workspace = true
+publish.workspace = true
+
+[dependencies]
+# The suite is written against the `Coordination` *trait* surface only (never a
+# concrete backend, ADR-0016) — so it lifts the assertions that seeded in
+# `coordination-mem/tests/conformance.rs` into one place both backends drive.
+wyrd-traits.workspace = true
+bytes.workspace = true
+
+[dev-dependencies]
+# The non-vacuity demonstration (`tests/demonstrated_red.rs`) drives the suite
+# against a deliberately-broken in-process stub to prove the assertions actually
+# bite — the headless mirror of "RED against a non-implementing stub". pollster
+# drives the async surface with no runtime, so it runs on any machine; async-trait
+# implements the trait on the stub; bytes builds its registration values.
+pollster.workspace = true
+async-trait.workspace = true
+
+# Inherit the workspace lint policy (single source of truth in the root
+# Cargo.toml [workspace.lints.*]).
+[lints]
+workspace = true
diff --git a/crates/coordination-conformance/src/lib.rs b/crates/coordination-conformance/src/lib.rs
new file mode 100644
index 0000000..4c3fe2b
--- /dev/null
+++ b/crates/coordination-conformance/src/lib.rs
@@ -0,0 +1,147 @@
+//! The **shared** `Coordination` trait-contract suite.
+//!
+//! These assertions are written against the [`Coordination`](wyrd_traits::Coordination)
+//! *trait* surface (helpers over `&impl Coordination`, ADR-0016), so **one** suite
+//! pins the contract for **every** implementation instead of each backend forking
+//! its own copy — the discipline that "a trait's semantics are pinned by its second
+//! real implementation plus a shared contract suite" (ADR-0006; the mirror of
+//! `wyrd-metadata-conformance` for `MetadataStore`, whose TiKV second impl proved
+//! the pattern). They were lifted verbatim out of
+//! `crates/coordination-mem/tests/conformance.rs`, whose own header noted they
+//! "lift to a shared suite when a second backend (etcd) arrives" — that arrival is
+//! this crate.
+//!
+//! Each function takes `&impl Coordination` and asserts one contract clause. A
+//! backend's test target supplies a **fresh, isolated coordinator per clause** (so
+//! the clauses never collide on keys) and drives them under whatever executor that
+//! backend needs — `pollster::block_on` for the synchronous in-memory backend, a
+//! `tokio` runtime for the networked etcd backend.
+//!
+//! Only the **trait-generic** clauses live here: lease *expiry under a `ManualClock`*
+//! and the *exact* config-revision counts are `coordination-mem`-specific (they
+//! depend on an injected clock and a single-process counter), so they stay in that
+//! backend's own tests. What is shared is exactly the contract etcd must also honour:
+//! register→discover, unique/rising leases, election granted-and-fenced, locks
+//! mutually-exclusive-and-fenced, and globally-monotonic fencing tokens.
+
+#![forbid(unsafe_code)]
+
+use std::time::Duration;
+
+use bytes::Bytes;
+use wyrd_traits::Coordination;
+
+/// Build an opaque registration/config value from a string.
+fn b(s: &str) -> Bytes {
+    Bytes::from(s.to_owned())
+}
+
+/// A lease long enough that nothing expires during a fast test — the shared suite
+/// never relies on real-time expiry (that is the backend-specific tests' job), so a
+/// generous TTL keeps the networked run robust against clock skew.
+pub const LONG: Duration = Duration::from_secs(3600);
+
+/// `register` then `discover`: an unknown key discovers nobody; both registered
+/// members surface; registrations are isolated by key.
+pub async fn contract_register_then_discover(c: &impl Coordination) {
+    assert!(
+        c.discover("svc/d").await.unwrap().is_empty(),
+        "an unknown key discovers nobody"
+    );
+
+    c.register("svc/d", b("node-a"), LONG).await.unwrap();
+    c.register("svc/d", b("node-b"), LONG).await.unwrap();
+
+    let mut found = c.discover("svc/d").await.unwrap();
+    found.sort();
+    assert_eq!(
+        found,
+        vec![b("node-a"), b("node-b")],
+        "both members surface"
+    );
+
+    // Registrations are isolated by key.
+    assert!(c.discover("svc/other").await.unwrap().is_empty());
+}
+
+/// Each registration gets a distinct, rising lease id.
+pub async fn contract_leases_are_unique_and_rising(c: &impl Coordination) {
+    let first = c.register("k", b("v1"), LONG).await.unwrap();
+    let second = c.register("k", b("v2"), LONG).await.unwrap();
+    assert!(
+        second.id > first.id,
+        "each registration gets a distinct, rising lease id"
+    );
+}
+
+/// Leadership is granted and each term fences the last with a rising token.
+pub async fn contract_election_is_always_granted_and_fenced(c: &impl Coordination) {
+    let first = c.elect_leader("custodian").await.unwrap();
+    let second = c.elect_leader("custodian").await.unwrap();
+    assert!(
+        second.token > first.token,
+        "leadership is granted, and each term fences the last"
+    );
+}
+
+/// Locks are mutually exclusive (try-acquire) and re-acquiring fences the prior
+/// holder; distinct keys do not contend.
+pub async fn contract_locks_are_mutually_exclusive_and_fenced(c: &impl Coordination) {
+    let first = c
+        .lock("inode/7")
+        .await
+        .unwrap()
+        .expect("a free lock is granted");
+    assert!(
+        c.lock("inode/7").await.unwrap().is_none(),
+        "a held lock refuses contenders"
+    );
+
+    c.unlock(first).await.unwrap();
+    let second = c
+        .lock("inode/7")
+        .await
+        .unwrap()
+        .expect("the lock is grantable again after release");
+    assert!(
+        second.token > first.token,
+        "re-acquiring fences the prior holder"
+    );
+
+    // Distinct keys do not contend.
+    assert!(c.lock("inode/8").await.unwrap().is_some());
+}
+
+/// Leadership and locks draw from one monotonic fencing source, so any later grant
+/// fences any earlier one regardless of which kind it is.
+pub async fn contract_fencing_tokens_rise_across_locks_and_elections(c: &impl Coordination) {
+    let a = c.lock("x").await.unwrap().unwrap().token;
+    let bee = c.elect_leader("y").await.unwrap().token;
+    let d = c.lock("z").await.unwrap().unwrap().token;
+    assert!(
+        a < bee && bee < d,
+        "tokens are globally monotonic: {a} {bee} {d}"
+    );
+}
+
+/// Drive **every** contract in this suite against a fresh coordinator per clause.
+///
+/// A backend runs the whole contract by calling this ONE function, so there is no
+/// per-driver list to drift out of sync: a new `contract_*` added here is picked up
+/// by **both** backends automatically. `make_coord(tag)` yields a fresh, isolated
+/// coordinator for each clause — `coordination-mem` hands back a new
+/// `MemCoordination`, `coordination-etcd` a connection scoped to a per-`tag`
+/// keyspace against one shared etcd cluster — the fresh-coordinator-per-clause
+/// isolation every clause assumes (so the clauses never collide on keys).
+pub async fn run_all<C, F, Fut>(mut make_coord: F)
+where
+    C: Coordination,
+    F: FnMut(&'static str) -> Fut,
+    Fut: core::future::Future<Output = C>,
+{
+    contract_register_then_discover(&make_coord("register_then_discover").await).await;
+    contract_leases_are_unique_and_rising(&make_coord("leases_unique_rising").await).await;
+    contract_election_is_always_granted_and_fenced(&make_coord("election_fenced").await).await;
+    contract_locks_are_mutually_exclusive_and_fenced(&make_coord("locks_fenced").await).await;
+    contract_fencing_tokens_rise_across_locks_and_elections(&make_coord("tokens_rise").await).await;
+}
diff --git a/crates/coordination-conformance/tests/demonstrated_red.rs b/crates/coordination-conformance/tests/demonstrated_red.rs
new file mode 100644
index 0000000..569d731
--- /dev/null
+++ b/crates/coordination-conformance/tests/demonstrated_red.rs
@@ -0,0 +1,131 @@
+//! Non-vacuity: the shared `Coordination` suite **catches a non-implementing /
+//! broken backend**.
+//!
+//! The brief's flippable regression is "the trait-generic contract assertions go
+//! GREEN against real etcd, and they are RED against a non-implementing stub." The
+//! GREEN half is inherently networked (it needs a real etcd; see
+//! `crates/coordination-etcd/tests/conformance.rs`, endpoint-gated and validated at
+//! sign-off). This test pins the **RED half headlessly**: it drives each shared
+//! clause against a deliberately-broken in-process stub and asserts the clause
+//! **fails** (panics on its assertion). Without this, a suite that silently passed a
+//! stub would give false confidence — exactly the "green test that does not exercise
+//! the contract" failure mode.
+//!
+//! Every clause here is driven through the *same* production suite functions
+//! `coordination-mem` and `coordination-etcd` run, so this proves those exact
+//! assertions bite — not a copy.
+
+use std::panic::AssertUnwindSafe;
+use std::time::Duration;
+
+use async_trait::async_trait;
+use bytes::Bytes;
+use pollster::block_on;
+use wyrd_coordination_conformance as suite;
+use wyrd_traits::{Coordination, FencingToken, Leadership, Lease, LockGuard, Result};
+
+/// A backend that implements the trait's *shape* but honours **none** of its
+/// contract: it discovers nobody, hands out a constant lease id and a constant
+/// fencing token, and never actually holds a lock. Every shared clause must reject
+/// it.
+struct BrokenCoordination;
+
+#[async_trait]
+impl Coordination for BrokenCoordination {
+    async fn register(&self, _key: &str, _value: Bytes, _ttl: Duration) -> Result<Lease> {
+        // Constant lease id — violates "unique and rising".
+        Ok(Lease { id: 1 })
+    }
+    async fn renew(&self, _lease: Lease) -> Result<()> {
+        Ok(())
+    }
+    async fn revoke(&self, _lease: Lease) -> Result<()> {
+        Ok(())
+    }
+    async fn discover(&self, _key: &str) -> Result<Vec<Bytes>> {
+        // Discovers nobody — violates register→discover.
+        Ok(Vec::new())
+    }
+    async fn elect_leader(&self, _key: &str) -> Result<Leadership> {
+        // Constant token — violates "each term fences the last".
+        Ok(Leadership {
+            token: 1 as FencingToken,
+        })
+    }
+    async fn lock(&self, _key: &str) -> Result<Option<LockGuard>> {
+        // Always "acquires" with a constant token — violates mutual exclusion and
+        // fencing (a held key is never refused; a re-acquire never rises).
+        Ok(Some(LockGuard {
+            token: 1 as FencingToken,
+        }))
+    }
+    async fn unlock(&self, _guard: LockGuard) -> Result<()> {
+        Ok(())
+    }
+    async fn set_config(&self, _key: &str, _value: Bytes) -> Result<()> {
+        Ok(())
+    }
+    async fn get_config(&self, _key: &str) -> Result<Option<Bytes>> {
+        Ok(None)
+    }
+    async fn config_revision(&self) -> Result<u64> {
+        Ok(0)
+    }
+}
+
+/// Assert that running `clause` against the broken stub panics (the contract bites).
+fn rejects(clause: impl FnOnce() + std::panic::UnwindSafe) {
+    let prior = std::panic::take_hook();
+    std::panic::set_hook(Box::new(|_| {})); // silence the expected assertion panic
+    let outcome = std::panic::catch_unwind(clause);
+    std::panic::set_hook(prior);
+    assert!(
+        outcome.is_err(),
+        "the shared clause must REJECT a non-implementing backend (it did not panic)"
+    );
+}
+
+#[test]
+fn register_then_discover_rejects_a_backend_that_discovers_nobody() {
+    rejects(|| {
+        block_on(AssertUnwindSafe(suite::contract_register_then_discover(
+            &BrokenCoordination,
+        )));
+    });
+}
+
+#[test]
+fn leases_rejects_a_backend_with_a_constant_lease_id() {
+    rejects(|| {
+        block_on(AssertUnwindSafe(
+            suite::contract_leases_are_unique_and_rising(&BrokenCoordination),
+        ));
+    });
+}
+
+#[test]
+fn election_rejects_a_backend_with_a_constant_token() {
+    rejects(|| {
+        block_on(AssertUnwindSafe(
+            suite::contract_election_is_always_granted_and_fenced(&BrokenCoordination),
+        ));
+    });
+}
+
+#[test]
+fn locks_reject_a_backend_that_never_holds() {
+    rejects(|| {
+        block_on(AssertUnwindSafe(
+            suite::contract_locks_are_mutually_exclusive_and_fenced(&BrokenCoordination),
+        ));
+    });
+}
+
+#[test]
+fn fencing_rejects_a_backend_with_non_monotonic_tokens() {
+    rejects(|| {
+        block_on(AssertUnwindSafe(
+            suite::contract_fencing_tokens_rise_across_locks_and_elections(&BrokenCoordination),
+        ));
+    });
+}
