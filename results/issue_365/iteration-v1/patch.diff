new file mode 100644
index 0000000..579973c
--- /dev/null
+++ b/crates/coordination-etcd/tests/conformance.rs
@@ -0,0 +1,75 @@
+//! Drives the **shared** `Coordination` trait-contract suite
+//! (`wyrd-coordination-conformance`) — the identical assertions `coordination-mem`
+//! passes — against a real [`EtcdCoordination`], so **one** suite pins the trait for
+//! **both** backends (ADR-0006's two-implementation pin; the mirror of TiKV against
+//! `MetadataStore`'s shared suite).
+//!
+//! The run is **endpoint-gated**: with no `WYRD_ETCD_ENDPOINTS` set (a laptop or a
+//! PDCA worktree with no etcd) it **skips cleanly** so `cargo xtask ci` stays green;
+//! a dedicated `xtask etcd-conformance` job brings up a throwaway etcd, sets the
+//! endpoint, rebuilds with `--features etcd`, and runs it for real. That real-etcd
+//! GREEN is the networked half of the flippable regression — it is validated at Check
+//! sign-off (a NEEDS-HUMAN: no headless runner can stand up a real etcd), while the
+//! RED half (the suite rejecting a non-implementing backend) is pinned headlessly in
+//! `wyrd-coordination-conformance`'s `tests/demonstrated_red.rs`.
+
+/// The etcd client endpoints, or `None` when etcd is not configured.
+fn etcd_endpoints() -> Option<Vec<String>> {
+    match std::env::var("WYRD_ETCD_ENDPOINTS") {
+        Ok(raw) if !raw.trim().is_empty() => Some(
+            raw.split(',')
+                .map(|e| e.trim().to_string())
+                .filter(|e| !e.is_empty())
+                .collect(),
+        ),
+        _ => None,
+    }
+}
+
+#[test]
+fn trait_contract_against_etcd() {
+    let Some(endpoints) = etcd_endpoints() else {
+        eprintln!(
+            "wyrd-coordination-etcd: WYRD_ETCD_ENDPOINTS not set — skipping the etcd \
+             conformance run (clean skip; the gate stays green without an etcd)."
+        );
+        return;
+    };
+    run(endpoints);
+}
+
+#[cfg(feature = "etcd")]
+fn run(endpoints: Vec<String>) {
+    use wyrd_coordination_conformance as conformance;
+    use wyrd_coordination_etcd::EtcdCoordination;
+
+    let runtime = tokio::runtime::Builder::new_current_thread()
+        .enable_all()
+        .build()
+        .expect("tokio runtime");
+
+    // The whole shared contract via the single `run_all` runner, so etcd drives the
+    // identical clause set `coordination-mem` does with no per-driver list to drift.
+    // `make_coord(tag)` hands each clause a connection scoped to a fresh, isolated
+    // per-`tag` keyspace against the one shared cluster (the pid keeps concurrent CI
+    // runs from colliding).
+    runtime.block_on(conformance::run_all(|tag| {
+        let endpoints = endpoints.clone();
+        let namespace = format!("wyrd-conformance/{}/{tag}/", std::process::id()).into_bytes();
+        async move {
+            EtcdCoordination::connect(endpoints)
+                .await
+                .expect("connect to etcd")
+                .with_namespace(namespace)
+        }
+    }));
+}
+
+#[cfg(not(feature = "etcd"))]
+fn run(endpoints: Vec<String>) {
+    let _ = endpoints;
+    eprintln!(
+        "wyrd-coordination-etcd: WYRD_ETCD_ENDPOINTS is set but the crate was built without \
+         `--features etcd` — skipping. Run it via `cargo xtask etcd-conformance`."
+    );
+}
