@@ -0,0 +1,280 @@
+//! etcd-backed [`Coordination`](wyrd_traits::Coordination): the distributed,
+//! **production**, cross-process L5 backend (ADR-0006), behind the *unchanged*
+//! `Coordination` trait. Choosing it over process-local `coordination-mem` is
+//! composition in `server` (ADR-0010), not a refactor here — it is the REQUIRED
+//! second implementation that pins the trait against a real network, exactly as
+//! TiKV is `MetadataStore`'s second implementation (proposal 0015 Deployment
+//! prerequisite, `0015…-revised.md:443-463`; ADR-0006 "pin the trait with two
+//! implementations").
+//!
+//! What the etcd backend gives that `coordination-mem` cannot: registrations,
+//! elections and locks are visible **across processes and machines**, so a real
+//! multi-node cluster can discover peers, elect a single custodian leader, and
+//! fence stale holders — the "peers discovered through L5" that slice 5 (#256) is
+//! gated on.
+//!
+//! ## What is load-light (compiled and unit-tested everywhere) vs networked
+//!
+//! The **decision logic** — how a discovery key maps onto an etcd keyspace, and how
+//! an etcd revision becomes a monotonic [`FencingToken`](wyrd_traits::FencingToken)
+//! — lives in the dependency-free [`keyspace`] and [`fencing`] modules. They carry
+//! no `etcd-client` dependency, so they compile and are unit-tested on **every**
+//! machine (etcd or not) — the load-light production units the store's methods call
+//! (mirror of `metadata-tikv`'s `keyspace`/`paging`). The real store — which needs a
+//! reachable etcd — is compiled only under the OFF-by-default `etcd` feature, so the
+//! default `cargo xtask ci` builds this crate as a skeleton, never pulls the
+//! `etcd-client` tree, and stays green. The SHARED conformance suite drives the real
+//! store against a real etcd endpoint (`crates/coordination-etcd/tests/conformance.rs`,
+//! endpoint-gated).
+//!
+//! ## etcd → trait mapping (the production semantics)
+//!
+//! - **Leased registration + discover.** `register` grants an etcd lease of `ttl`
+//!   and `put`s the value under a per-key prefix bound to that lease; etcd deletes
+//!   the key when the lease expires, so expiry is **native** (no local clock) and
+//!   `discover` is a prefix range-get. `renew` sends one keep-alive; `revoke`
+//!   revokes the lease.
+//! - **Fenced single-leader election.** `elect_leader` campaigns through etcd; the
+//!   fencing token is the leader key's revision — globally monotonic, so a later
+//!   term fences an earlier one across machines.
+//! - **Mutually-exclusive fenced locks (non-blocking try-acquire).** `lock` claims
+//!   a key with an atomic compare-and-put transaction: absent ⇒ acquired with the
+//!   put revision as its fencing token; present ⇒ `None` (the trait's try-acquire,
+//!   not etcd's blocking lock). `unlock` removes the key.
+//! - **Revisioned config.** `set_config`/`get_config` are `put`/`get`;
+//!   `config_revision` is the max mod-revision under the config prefix — monotonic.
+//!
+//! The token for locks and the token for elections both come from etcd's **one**
+//! global revision counter, so any later grant fences any earlier one regardless of
+//! kind (the [`fencing`] invariant).
+
+#![forbid(unsafe_code)]
+
+/// Keyspace math shared by the etcd store's register/discover/lock/election/config
+/// paths — kept free of any `etcd-client` dependency so it compiles and is
+/// unit-tested on every machine, etcd or not (the load-light production unit).
+///
+/// A single etcd keyspace holds every coordination artifact, partitioned by a
+/// leading class prefix so registrations, locks, elections and config never collide,
+/// and (optionally) namespaced so each conformance clause gets an isolated keyspace
+/// against one shared cluster.
+pub mod keyspace {
+    /// Class prefix for leased service registrations.
+    pub const REG: &[u8] = b"reg/";
+    /// Class prefix for distributed locks.
+    pub const LOCK: &[u8] = b"lock/";
+    /// Class prefix for leader-election keys.
+    pub const ELECT: &[u8] = b"elect/";
+    /// Class prefix for zone-wide config.
+    pub const CFG: &[u8] = b"cfg/";
+
+    fn join(parts: &[&[u8]]) -> Vec<u8> {
+        let mut out = Vec::with_capacity(parts.iter().map(|p| p.len()).sum());
+        for p in parts {
+            out.extend_from_slice(p);
+        }
+        out
+    }
+
+    /// The prefix every member registered under discovery `key` shares. The discovery
+    /// key is terminated by a **`NUL` (`0x00`) delimiter** — NOT a `/` — so
+    /// `discover("svc")` cannot spuriously match `svc/d`'s members: the discovery key
+    /// may itself contain `/`, so a `/` terminator would let the prefix `reg/svc/`
+    /// alias `reg/svc/d/…`; a `NUL` terminator cannot, because the byte after `svc` in
+    /// a `svc/d` member is `/` (`0x2f`), never `0x00`. This matches `coordination-mem`,
+    /// which discovers by **exact** key (a `HashMap` lookup), not by sub-key prefix.
+    pub fn registration_prefix(namespace: &[u8], key: &[u8]) -> Vec<u8> {
+        join(&[namespace, REG, key, b"\x00"])
+    }
+
+    /// The exact key one member's registration lands at: its discovery prefix plus
+    /// the lease id, so N members under one key are N distinct keys.
+    pub fn registration_key(namespace: &[u8], key: &[u8], lease_id: i64) -> Vec<u8> {
+        join(&[
+            &registration_prefix(namespace, key),
+            lease_id.to_string().as_bytes(),
+        ])
+    }
+
+    /// The single key that backs the distributed lock on `key`.
+    pub fn lock_key(namespace: &[u8], key: &[u8]) -> Vec<u8> {
+        join(&[namespace, LOCK, key])
+    }
+
+    /// The election name backing leadership campaigns for `key`.
+    pub fn election_key(namespace: &[u8], key: &[u8]) -> Vec<u8> {
+        join(&[namespace, ELECT, key])
+    }
+
+    /// The key a config entry is stored at.
+    pub fn config_key(namespace: &[u8], key: &[u8]) -> Vec<u8> {
+        join(&[namespace, CFG, key])
+    }
+
+    /// The prefix covering every config key (for the `config_revision` range-scan).
+    pub fn config_prefix(namespace: &[u8]) -> Vec<u8> {
+        join(&[namespace, CFG])
+    }
+
+    /// The **exclusive** upper bound of the half-open range covering every key that
+    /// begins with `prefix`: the prefix with its last non-`0xff` byte incremented and
+    /// trailing `0xff`s dropped. `None` means "no upper bound" (an empty or all-`0xff`
+    /// prefix scans to the end of the keyspace). This is what turns a "get everything
+    /// under this prefix" into a bounded etcd range `[prefix, end)` — the same math
+    /// `etcd-client`'s `with_prefix()` applies internally, exposed here so the
+    /// register/discover isolation is unit-testable without a live etcd.
+    pub fn prefix_range_end(prefix: &[u8]) -> Option<Vec<u8>> {
+        let mut end = prefix.to_vec();
+        while let Some(last) = end.last_mut() {
+            if *last < 0xff {
+                *last += 1;
+                return Some(end);
+            }
+            end.pop();
+        }
+        None
+    }
+
+    #[cfg(test)]
+    mod tests {
+        use super::*;
+
+        #[test]
+        fn registration_keys_are_distinct_and_share_their_key_prefix() {
+            let ns = b"conf/7/".as_slice();
+            let a = registration_key(ns, b"svc/d", 1001);
+            let bee = registration_key(ns, b"svc/d", 1002);
+            assert_ne!(a, bee, "two members under one key are distinct keys");
+            let prefix = registration_prefix(ns, b"svc/d");
+            assert!(a.starts_with(&prefix) && bee.starts_with(&prefix));
+        }
+
+        #[test]
+        fn discovery_keys_do_not_alias_one_another() {
+            // The NUL delimiter keeps `svc/d`, `svc/other` and the shorter `svc` from
+            // aliasing — the register→discover isolation the shared contract asserts
+            // (`contract_register_then_discover`), and the exact-key match
+            // `coordination-mem` gives. A `/` terminator would FAIL the last assertion
+            // (reg/svc/ is a prefix of reg/svc/d/…); the NUL terminator does not.
+            let ns = b"".as_slice();
+            let d = registration_prefix(ns, b"svc/d");
+            let other = registration_prefix(ns, b"svc/other");
+            let svc = registration_prefix(ns, b"svc");
+            assert!(!other.starts_with(&d), "svc/other is not under svc/d");
+            let member = registration_key(ns, b"svc/d", 5);
+            assert!(
+                !member.starts_with(&svc),
+                "a svc/d member is not discovered by a `svc` prefix (the NUL delimits)"
+            );
+        }
+
+        #[test]
+        fn classes_never_collide() {
+            let ns = b"z/".as_slice();
+            let reg = registration_key(ns, b"k", 1);
+            let lock = lock_key(ns, b"k");
+            let elect = election_key(ns, b"k");
+            let cfg = config_key(ns, b"k");
+            // No class prefix is a prefix of another, so a lock never surfaces in a
+            // discover, an election never surfaces in a config scan, etc.
+            for (a, bee) in [
+                (&reg, &lock),
+                (&reg, &elect),
+                (&reg, &cfg),
+                (&lock, &elect),
+                (&lock, &cfg),
+                (&elect, &cfg),
+            ] {
+                assert!(
+                    !a.starts_with(bee) && !bee.starts_with(a),
+                    "classes disjoint"
+                );
+            }
+        }
+
+        #[test]
+        fn namespaces_isolate() {
+            // Two clauses' fresh keyspaces do not overlap — the per-clause isolation
+            // `run_all(make_coord(tag))` relies on.
+            let a = registration_key(b"conf/a/", b"k", 1);
+            let bee = registration_key(b"conf/b/", b"k", 1);
+            assert!(!a.starts_with(b"conf/b/") && !bee.starts_with(b"conf/a/"));
+        }
+
+        #[test]
+        fn prefix_range_end_bounds_the_prefix() {
+            // The registration prefix ends in NUL (0x00); its range end bumps that to
+            // 0x01, so [reg/svc\x00, reg/svc\x01) covers exactly this key's members.
+            let prefix = registration_prefix(b"", b"svc");
+            let end = prefix_range_end(&prefix).unwrap();
+            let member = registration_key(b"", b"svc", 1001);
+            assert!(member.as_slice() >= prefix.as_slice());
+            assert!(member.as_slice() < end.as_slice());
+            // Trailing 0xff carries; empty / all-0xff scan to the end.
+            assert_eq!(
+                prefix_range_end(&[0x01, 0xff]).as_deref(),
+                Some(&[0x02][..])
+            );
+            assert_eq!(prefix_range_end(b""), None);
+            assert_eq!(prefix_range_end(&[0xff, 0xff]), None);
+        }
+    }
+}
+
+/// Turn an etcd revision into a [`FencingToken`](wyrd_traits::FencingToken) — kept
+/// free of any `etcd-client` dependency so the fencing invariant is unit-tested on
+/// every machine (the load-light production unit the store's `lock`/`elect_leader`
+/// call).
+///
+/// etcd maintains **one** global, strictly-increasing revision counter, bumped on
+/// every write across the whole keyspace. Both a lock acquisition (the put that
+/// claims the lock key) and a leadership grant (the create of the leader key) are
+/// writes, so their revisions are drawn from that one counter — mapping a revision
+/// to a fencing token therefore yields tokens that are **globally monotonic across
+/// locks and elections**, which is exactly the trait's fencing property (a later
+/// grant of *either* kind fences any earlier one; ADR-0006, the custodian's
+/// single-active guard M3.3/#141).
+pub mod fencing {
+    use wyrd_traits::{FencingToken, Result};
+
+    /// Map an etcd revision to a fencing token. A revision is always `>= 1` after any
+    /// write, so a non-positive revision is a backend contract violation, surfaced as
+    /// `Err` rather than silently coerced (which could break monotonicity).
+    pub fn token_from_revision(revision: i64) -> Result<FencingToken> {
+        if revision <= 0 {
+            return Err(format!(
+                "etcd returned a non-positive revision ({revision}); a fencing token must be \
+                 derived from a real (>= 1) write revision"
+            )
+            .into());
+        }
+        Ok(revision as FencingToken)
+    }
+
+    #[cfg(test)]
+    mod tests {
+        use super::*;
+
+        #[test]
+        fn a_later_revision_fences_an_earlier_one() {
+            let lock_a = token_from_revision(5).unwrap();
+            let election_b = token_from_revision(6).unwrap();
+            let lock_c = token_from_revision(9).unwrap();
+            // Locks and elections draw from etcd's one global revision counter, so
+            // any later grant fences any earlier one regardless of kind.
+            assert!(lock_a < election_b && election_b < lock_c);
+        }
+
+        #[test]
+        fn a_non_positive_revision_is_rejected() {
+            assert!(token_from_revision(0).is_err());
+            assert!(token_from_revision(-1).is_err());
+        }
+    }
+}
+
+#[cfg(feature = "etcd")]
+mod store;
+
+#[cfg(feature = "etcd")]
+pub use store::EtcdCoordination;
diff --git a/crates/coordination-etcd/src/store.rs b/crates/coordination-etcd/src/store.rs
new file mode 100644
index 0000000..c93aa16
--- /dev/null
+++ b/crates/coordination-etcd/src/store.rs
@@ -0,0 +1,338 @@
+//! The real etcd-backed [`Coordination`] store — compiled only under the `etcd`
+//! feature (it needs a reachable etcd and the `etcd-client` gRPC tree).
+//!
+//! This module is **not** compiled by the default `cargo xtask ci` (the `etcd`
+//! feature is off); its correctness is pinned by the SHARED conformance suite run
+//! against a **real etcd** (`crates/coordination-etcd/tests/conformance.rs`,
+//! endpoint-gated) — the networked half of the two-implementation pin (ADR-0006).
+//! The pure decision logic it leans on (keyspace layout, revision→token) lives in
+//! the dependency-free [`crate::keyspace`] / [`crate::fencing`] modules, unit-tested
+//! on every machine.
+//!
+//! NOTE (etcd client dependency — a NEEDS-HUMAN, INTEGRATION §4): the exact
+//! `etcd-client` entry points used here (`Client::connect`, `lease_grant` /
+//! `lease_keep_alive` / `lease_revoke`, `put`/`get` with `with_lease`/`with_prefix`,
+//! the compare-and-put `txn`, and the `campaign`/`proclaim` election API) are
+//! reconfirmed at build time against the pinned version; the crate compiles only
+//! under `--features etcd`.
+
+use std::collections::HashMap;
+use std::sync::Mutex;
+use std::time::Duration;
+
+use async_trait::async_trait;
+use bytes::Bytes;
+use etcd_client::{
+    Client, Compare, CompareOp, GetOptions, LeaderKey, ProclaimOptions, PutOptions, Txn, TxnOp,
+};
+use wyrd_traits::{Coordination, FencingToken, Leadership, Lease, LockGuard, Result};
+
+use crate::fencing::token_from_revision;
+use crate::keyspace;
+
+/// TTL (seconds) of the lease that backs a leadership campaign / a lock hold. It is
+/// kept renewed for the life of the hold in a real deployment; if the holder dies,
+/// the lease lapses and the leadership / lock is released so a peer can take over —
+/// the cross-process failover etcd gives that `coordination-mem` cannot.
+const HOLD_TTL_SECS: i64 = 30;
+
+/// What we remember locally about a lock we hold, so [`Coordination::unlock`] — which
+/// carries only a fencing token (the trait's `LockGuard` is `Copy` and holds no key)
+/// — can find the etcd key and lease to release. Mirrors `coordination-mem`, which
+/// also keeps its held locks keyed so `unlock` can locate them by token.
+struct LockHold {
+    key: Vec<u8>,
+    lease_id: i64,
+}
+
+/// What we remember about leadership we hold for an election key, so a repeated
+/// `elect_leader` from THIS instance re-fences (proclaims a rising token) instead of
+/// self-deadlocking in a second campaign behind our own still-held leadership.
+struct LeaderHold {
+    leader_key: LeaderKey,
+    #[allow(dead_code)]
+    lease_id: i64,
+}
+
+#[derive(Default)]
+struct LocalState {
+    /// token -> the lock key + lease backing it (for `unlock`).
+    locks: HashMap<FencingToken, LockHold>,
+    /// logical election key -> the leadership we currently hold (for re-fencing).
+    leaders: HashMap<String, LeaderHold>,
+}
+
+/// A [`Coordination`] backed by an etcd cluster, reached through its v3 gRPC API.
+///
+/// The store is `Clone`-cheap client + a per-instance `namespace` (empty in
+/// production; a per-clause value gives the isolated keyspace the shared suite
+/// needs) + a little local bookkeeping so token-only `unlock` and repeated
+/// `elect_leader` behave.
+pub struct EtcdCoordination {
+    client: Client,
+    namespace: Vec<u8>,
+    state: Mutex<LocalState>,
+}
+
+impl EtcdCoordination {
+    /// Connect to an etcd cluster via its client endpoints.
+    pub async fn connect(endpoints: Vec<String>) -> Result<Self> {
+        let client = Client::connect(endpoints, None).await?;
+        Ok(Self {
+            client,
+            namespace: Vec::new(),
+            state: Mutex::new(LocalState::default()),
+        })
+    }
+
+    /// Scope this store to an isolated `namespace` (used by the conformance suite to
+    /// give each clause a fresh keyspace against one shared cluster).
+    #[must_use]
+    pub fn with_namespace(mut self, namespace: impl Into<Vec<u8>>) -> Self {
+        self.namespace = namespace.into();
+        self
+    }
+
+    fn client(&self) -> Client {
+        self.client.clone()
+    }
+}
+
+#[async_trait]
+impl Coordination for EtcdCoordination {
+    async fn register(&self, key: &str, value: Bytes, ttl: Duration) -> Result<Lease> {
+        let mut client = self.client();
+        // A leased put: etcd deletes the key when the lease lapses, so expiry is
+        // native (no local clock) and a crashed member's registration drops out of
+        // `discover` on its own.
+        let lease = client
+            .lease_grant(ttl.as_secs().max(1) as i64, None)
+            .await?;
+        let lease_id = lease.id();
+        let etcd_key = keyspace::registration_key(&self.namespace, key.as_bytes(), lease_id);
+        client
+            .put(
+                etcd_key,
+                value.to_vec(),
+                Some(PutOptions::new().with_lease(lease_id)),
+            )
+            .await?;
+        Ok(Lease {
+            id: lease_id as u64,
+        })
+    }
+
+    async fn renew(&self, lease: Lease) -> Result<()> {
+        let mut client = self.client();
+        // One keep-alive extends the lease by its TTL. An unknown/expired lease has
+        // TTL 0 (or errors) — surfaced as `Err`, matching the mem contract.
+        let (mut keeper, mut stream) = client.lease_keep_alive(lease.id as i64).await?;
+        keeper.keep_alive().await?;
+        match stream.message().await? {
+            Some(resp) if resp.ttl() > 0 => Ok(()),
+            _ => Err("renew: unknown or expired lease".into()),
+        }
+    }
+
+    async fn revoke(&self, lease: Lease) -> Result<()> {
+        let mut client = self.client();
+        // Revoking the lease deletes every key bound to it (the registration), at
+        // once — the immediate withdrawal the contract wants. Idempotent: revoking an
+        // already-gone lease is not an error we surface.
+        let _ = client.lease_revoke(lease.id as i64).await;
+        Ok(())
+    }
+
+    async fn discover(&self, key: &str) -> Result<Vec<Bytes>> {
+        let mut client = self.client();
+        let prefix = keyspace::registration_prefix(&self.namespace, key.as_bytes());
+        // A prefix range-get returns exactly this key's live members; etcd has
+        // already dropped any whose lease expired.
+        let resp = client
+            .get(prefix, Some(GetOptions::new().with_prefix()))
+            .await?;
+        Ok(resp
+            .kvs()
+            .iter()
+            .map(|kv| Bytes::copy_from_slice(kv.value()))
+            .collect())
+    }
+
+    async fn elect_leader(&self, key: &str) -> Result<Leadership> {
+        // If THIS instance already leads `key`, re-fence with a proclaim (a fresh
+        // write ⇒ a higher revision ⇒ a rising token) rather than campaigning a
+        // second time behind our own still-held leadership (which would block).
+        let existing = {
+            let state = self
+                .state
+                .lock()
+                .map_err(|_| "coordination state poisoned")?;
+            state.leaders.get(key).map(|h| h.leader_key.clone())
+        };
+        let mut client = self.client();
+        if let Some(leader_key) = existing {
+            // Re-fence: announce a new value on the leadership we still hold (no second
+            // campaign). `proclaim` carries the `LeaderKey` in its options and is a
+            // fresh write ⇒ a higher revision ⇒ a rising token.
+            let resp = client
+                .proclaim(
+                    Vec::new(),
+                    Some(ProclaimOptions::new().with_leader(leader_key)),
+                )
+                .await?;
+            let rev = resp
+                .header()
+                .map(|h| h.revision())
+                .ok_or("proclaim returned no header revision")?;
+            return Ok(Leadership {
+                token: token_from_revision(rev)?,
+            });
+        }
+
+        // First claim: a lease-backed campaign. `campaign` resolves when leadership is
+        // granted (a contending process blocks here until we resign or our lease
+        // lapses — genuine single-leader across machines). The fencing token is the
+        // leader key's create revision, drawn from etcd's one global revision counter.
+        let lease = client.lease_grant(HOLD_TTL_SECS, None).await?;
+        let lease_id = lease.id();
+        let name = keyspace::election_key(&self.namespace, key.as_bytes());
+        let resp = client.campaign(name, Vec::new(), lease_id).await?;
+        let leader_key = resp
+            .leader()
+            .ok_or("campaign granted no leader key")?
+            .clone();
+        let token = token_from_revision(leader_key.rev())?;
+        {
+            let mut state = self
+                .state
+                .lock()
+                .map_err(|_| "coordination state poisoned")?;
+            state.leaders.insert(
+                key.to_owned(),
+                LeaderHold {
+                    leader_key,
+                    lease_id,
+                },
+            );
+        }
+        Ok(Leadership { token })
+    }
+
+    async fn lock(&self, key: &str) -> Result<Option<LockGuard>> {
+        let mut client = self.client();
+        let lock_key = keyspace::lock_key(&self.namespace, key.as_bytes());
+        // A lease-backed, non-blocking try-acquire via a compare-and-put txn:
+        //   if create_revision(lock_key) == 0 (absent)  -> put it (acquire)
+        //   else                                         -> do nothing (held)
+        // The txn is atomic, so this is genuine mutual exclusion; the put's revision
+        // is the fencing token (globally monotonic ⇒ a re-acquire fences the prior
+        // holder). This is the trait's try-acquire, deliberately NOT etcd's blocking
+        // `Lock` RPC (a blocking acquire is later work; the trait note).
+        let lease = client.lease_grant(HOLD_TTL_SECS, None).await?;
+        let lease_id = lease.id();
+        let txn = Txn::new()
+            .when([Compare::create_revision(
+                lock_key.clone(),
+                CompareOp::Equal,
+                0,
+            )])
+            .and_then([TxnOp::put(
+                lock_key.clone(),
+                Vec::new(),
+                Some(PutOptions::new().with_lease(lease_id)),
+            )])
+            .or_else([]);
+        let resp = client.txn(txn).await?;
+        if !resp.succeeded() {
+            // Held by someone — release the lease we speculatively granted and report
+            // the key as taken (try-acquire returns `None`, never blocks).
+            let _ = client.lease_revoke(lease_id).await;
+            return Ok(None);
+        }
+        let rev = resp
+            .header()
+            .map(|h| h.revision())
+            .ok_or("lock txn returned no header revision")?;
+        let token = token_from_revision(rev)?;
+        {
+            let mut state = self
+                .state
+                .lock()
+                .map_err(|_| "coordination state poisoned")?;
+            state.locks.insert(
+                token,
+                LockHold {
+                    key: lock_key,
+                    lease_id,
+                },
+            );
+        }
+        Ok(Some(LockGuard { token }))
+    }
+
+    async fn unlock(&self, guard: LockGuard) -> Result<()> {
+        // Release by fencing token: look up the key+lease we recorded at acquire time
+        // (the trait's `LockGuard` carries only the token). Idempotent — an unknown
+        // token is a no-op, matching the mem contract.
+        let hold = {
+            let mut state = self
+                .state
+                .lock()
+                .map_err(|_| "coordination state poisoned")?;
+            state.locks.remove(&guard.token)
+        };
+        if let Some(hold) = hold {
+            let mut client = self.client();
+            // Deleting the key frees the lock now; revoking the lease also drops it if
+            // the delete raced. Both best-effort so unlock stays idempotent.
+            let _ = client.delete(hold.key, None).await;
+            let _ = client.lease_revoke(hold.lease_id).await;
+        }
+        Ok(())
+    }
+
+    async fn set_config(&self, key: &str, value: Bytes) -> Result<()> {
+        let mut client = self.client();
+        client
+            .put(
+                keyspace::config_key(&self.namespace, key.as_bytes()),
+                value.to_vec(),
+                None,
+            )
+            .await?;
+        Ok(())
+    }
+
+    async fn get_config(&self, key: &str) -> Result<Option<Bytes>> {
+        let mut client = self.client();
+        let resp = client
+            .get(keyspace::config_key(&self.namespace, key.as_bytes()), None)
+            .await?;
+        Ok(resp
+            .kvs()
+            .first()
+            .map(|kv| Bytes::copy_from_slice(kv.value())))
+    }
+
+    async fn config_revision(&self) -> Result<u64> {
+        let mut client = self.client();
+        // The monotonic config revision is the highest mod-revision among config keys
+        // (0 if none written). etcd's mod-revision is drawn from the one global,
+        // strictly-rising revision counter, so every `set_config` write advances it —
+        // the pollable revision the trait promises. (The mem backend's exact +1-per-write
+        // count is a single-process detail the shared suite does not assert.)
+        let resp = client
+            .get(
+                keyspace::config_prefix(&self.namespace),
+                Some(GetOptions::new().with_prefix()),
+            )
+            .await?;
+        let max = resp
+            .kvs()
+            .iter()
+            .map(|kv| kv.mod_revision())
+            .max()
+            .unwrap_or(0);
+        Ok(max.max(0) as u64)
+    }
+}
