+[package]
+name = "wyrd-coordination-etcd"
+description = "etcd-backed Coordination: the distributed, cross-process L5 backend (ADR-0006) — leased/expiring service discovery, single-leader election with fencing, mutually-exclusive fenced locks, and revisioned config — behind the UNCHANGED Coordination trait. The REQUIRED second implementation that pins the trait alongside coordination-mem (mirror of TiKV as MetadataStore's second impl). Wired in by `server`; the real backend is compiled only under the OFF-by-default `etcd` feature."
+version.workspace = true
+edition.workspace = true
+rust-version.workspace = true
+license.workspace = true
+repository.workspace = true
+publish.workspace = true
+
+[features]
+# OFF by default. The real backend pulls in the `etcd-client` tree (a new external
+# gRPC dependency) whose ADR-0003 three-test audit + `deny.toml` allowlist review is
+# a NEEDS-HUMAN (INTEGRATION §4), and driving it needs a reachable etcd. Keeping it
+# off by default means the workspace `cargo xtask ci` on a machine with no etcd
+# compiles this crate as a skeleton (the load-light `keyspace`/`fencing` modules and
+# their unit tests only), never touches the `etcd-client` tree, and stays green —
+# while a dedicated `xtask etcd-conformance` job (companion, out of this crate's
+# scope) turns the feature on and drives the SHARED suite against a real etcd.
+default = []
+etcd = ["dep:etcd-client", "dep:tokio", "dep:async-trait", "dep:bytes"]
+
+[dependencies]
+wyrd-traits.workspace = true
+# All backend deps are optional and pulled in only by the `etcd` feature (ADR-0016:
+# a concrete backend depends on `traits` + its own backend client + runtime, never
+# on `core` or a sibling concrete). The `keyspace`/`fencing` modules are pure std —
+# they carry no dependency, so they compile and unit-test on every machine.
+etcd-client = { workspace = true, optional = true }
+tokio = { workspace = true, optional = true }
+async-trait = { workspace = true, optional = true }
+bytes = { workspace = true, optional = true }
+
+[dev-dependencies]
+# The conformance test drives the SHARED trait-contract suite (the same one
+# coordination-mem drives) against a real etcd when `--features etcd` is on and an
+# endpoint is configured; it skips cleanly otherwise so the default gate stays green.
+wyrd-coordination-conformance.workspace = true
+
+# `etcd-client` (+ runtime/async-trait/bytes) are used only under the `etcd`
+# feature; keep cargo-machete quiet on the default (feature-off) scan, where the
+# optional deps look unreferenced (mirror of metadata-tikv/Cargo.toml).
+[package.metadata.cargo-machete]
+ignored = ["etcd-client", "tokio", "async-trait", "bytes"]
+
+# Inherit the workspace lint policy (single source of truth in the root
+# Cargo.toml [workspace.lints.*]).
+[lints]
+workspace = true
