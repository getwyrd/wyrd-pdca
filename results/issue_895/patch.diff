+//! `AbortMultipartUpload`'s **teardown fence**, and the one builder of the fence batch that every
+//! writer of the `Open → Aborting` edge commits (#895, slice 3b of #636).
+//!
+//! [`abort_session`] moves an `Open@E` session to `Aborting@E+1` and installs its retirement
+//! obligation in the **same** batch (proposal 0016's *Abort / reap fence* row, `0016:665`), and
+//! answers every other state as decision 3's table does (`0016:977`, [`super::abort_answer`]):
+//!
+//! | State read | Answer | Written |
+//! |---|---|---|
+//! | `Open@E` | [`AbortOutcome::Fenced`] | the [`fence_batch`]: `require(mpu:<id> == bytes read)`, `require_absent(retire:bytes:s:<id>:<E>)`; put the session at `Aborting@E+1`, put its `{session, all}` obligation ([`SessionRecord::open_teardown`]) |
+//! | `Aborting` | [`AbortOutcome::AlreadyAborting`] | nothing |
+//! | `Completing` | [`Refusal::OperationAborted`] | nothing |
+//! | `Completed`, or no record | [`Refusal::NoSuchUpload`] | nothing |
+//!
+//! A client Abort carries no slot preconditions (`0016:665`). The fence never touches `mpuctl`: a
+//! fenced session still holds its staged bytes and its `mpu:` record, so it stays counted until
+//! the terminal delete, the one place the count goes down (#659).
+//!
+//! # One batch builder, two writers
+//!
+//! [`fence_batch`] is the only place the teardown fence's [`WriteBatch`] is built. The client
+//! Abort here and the post-restore session fence (`crates/custodian/src/restore.rs`,
+//! `fence_session`) both commit what it builds, so the two writers of the `Open → Aborting` edge
+//! cannot drift apart in their preconditions or their puts.
+//!
+//! Production calls no client Abort yet: the S3 verb that will is #668, under 0016's rule that
+//! the reaper and operator abort ship in the same release (`0016:236-268`). The restore fence is
+//! the one production caller of [`fence_batch`].
+//!
+//! # Runtime-free (ADR-0009)
+//!
+//! Core reads no clock, draws no randomness and never sleeps here. The fence stamps no time: the
+//! `Aborting` record carries the session's own `created_at_millis` and `clock_source` unchanged,
+//! and a round that lost is retried at once, with no backoff to wait out.
+
+use std::fmt;
+use std::slice;
+
+use bytes::Bytes;
+use wyrd_traits::{BoxError, CommitOutcome, CommitUnknownResult, MetadataStore, WriteBatch};
+
+use super::{
+    abort_answer, decode_session_record, mpu_key, AbortAnswer, AbortOutcome, RecordError, Refusal,
+    RetireObligation, SessionRecord, UploadId, MAX_COMPLETE_ATTEMPTS,
+};
+use crate::metadata;
+
+/// How many fence commits one [`abort_session`] makes at most: [`MAX_COMPLETE_ATTEMPTS`] `+ 1`.
+///
+/// A session goes back to `Open` only when a Complete fence is released, and it spends at most
+/// [`MAX_COMPLETE_ATTEMPTS`] Complete fences, so a session that keeps moving to a later `Open@E'`
+/// under the Abort can cost it at most that many rounds. The one more is the round that fences.
+/// A round is also spent by a conflict no re-read explains (on TiKV, a lock another writer held,
+/// with nothing moved) and by a commit whose outcome the store could not report; those share
+/// the same budget. It is sized from the shipped value of that knob, and it bounds the work one
+/// Abort does, not its correctness: an Abort that spends it ends with an error that says whether
+/// a fence of it may still land, never with a wrong answer.
+pub const ABORT_ROUNDS: u32 = MAX_COMPLETE_ATTEMPTS + 1;
+
+/// **The teardown fence's batch** (`0016:665`), the one builder of it: given the session's
+/// `mpu:` key, the exact bytes read there, the session as the fence leaves it and the obligations
+/// the fence installs, it
+///
+/// 1. `require`s `session_key` to hold exactly `read`;
+/// 2. `require_absent`s every obligation's key (`0016:369-373`), in the order given;
+/// 3. puts `session` at `session_key`;
+/// 4. puts every obligation's payload under its key, in the order given.
+///
+/// It takes a list because the restore fence also fences `Completing` sessions, whose teardown
+/// installs two obligations ([`SessionRecord::completing_teardown`]); the client Abort passes the
+/// one [`SessionRecord::open_teardown`] mints.
+///
+/// It writes only obligations that [`super::decode_retire_obligation`] accepts at the key they go
+/// under. That is a property of the type: a [`RetireObligation`] is minted only by the teardown
+/// rows, whose key and payload come from one constructor and are pinned to decode against each
+/// other, so a caller cannot hand this builder a payload under a key it chose.
+pub fn fence_batch(
+    session_key: &[u8],
+    read: &[u8],
+    session: &SessionRecord,
+    obligations: &[RetireObligation],
+) -> WriteBatch {
+    let keys: Vec<Vec<u8>> = obligations.iter().map(RetireObligation::key).collect();
+    let mut batch = WriteBatch::new().require(session_key.to_vec(), read.to_vec());
+    for key in &keys {
+        batch = batch.require_absent(key.clone());
+    }
+    batch = batch.put(session_key.to_vec(), metadata::encode(session));
+    for (obligation, key) in obligations.iter().zip(keys) {
+        batch = batch.put(key, metadata::encode(obligation.payload()));
+    }
+    batch
+}
+
+/// An Abort that ended with neither an answer nor a refusal.
+///
+/// # Error class
+///
+/// [`wyrd_traits::classify`] reads [`Self::InDoubt`] as
+/// [`ErrorClass::Indeterminate`](wyrd_traits::ErrorClass::Indeterminate), whatever stopped the
+/// Abort: its [`source`](std::error::Error::source) is the store's own [`CommitUnknownResult`].
+/// [`Self::Stopped`] keeps its cause's class: a [`Stop::Store`] wrapping a
+/// [`TransientFault`](wyrd_traits::TransientFault) is transient, because nothing is in doubt.
+#[derive(Debug)]
+pub enum AbortError {
+    /// A fence batch of this Abort may have landed, or may still land, and the Abort stopped
+    /// before a read could say which. Never "nothing was written".
+    InDoubt(Box<InDoubt>),
+    /// The Abort stopped, and no fence batch of it is in doubt: none landed, and none can land
+    /// later.
+    Stopped {
+        /// The upload the Abort was for.
+        upload_id: UploadId,
+        /// What stopped it.
+        cause: Stop,
+    },
+}
+
+/// What an [`AbortError::InDoubt`] reports.
+#[derive(Debug)]
+pub struct InDoubt {
+    /// The upload whose fence is in doubt.
+    pub upload_id: UploadId,
+    /// Whether a fence batch of this Abort may still be applied **after** it returned
+    /// ([`CommitUnknownResult::may_still_commit`]). Once a fence of this Abort said so, only a read
+    /// that found the session moved clears it, so later outcomes, failed reads and store faults
+    /// leave it `true`.
+    pub may_still_commit: bool,
+    /// The store's report of the unknown outcome that keeps the doubt: the first that said
+    /// `may_still_commit`, or else the latest one no successful read has settled. It is the
+    /// error's [`source`](std::error::Error::source).
+    pub outcome: CommitUnknownResult,
+    /// What stopped the Abort before it could settle the doubt.
+    pub cause: Stop,
+}
+
+/// What stopped an Abort ([`AbortError::Stopped`], [`InDoubt::cause`]).
+#[derive(Debug)]
+pub enum Stop {
+    /// All [`ABORT_ROUNDS`] fence commits were made and the session was still `Open`.
+    RoundsSpent {
+        /// Fence commits made.
+        rounds: u32,
+    },
+    /// The fence's obligation key is already present while the session is still exactly the
+    /// bytes the fence read: two reads of the session, one on each side of the key's read, found
+    /// it unchanged. A token is minted once (`0016:358-373`), so this is damage a retry cannot
+    /// settle.
+    ObligationKeyTaken {
+        /// The `retire:` key, as UTF-8 (lossy).
+        key: String,
+    },
+    /// The session is `Open` at the last epoch, so no fence can bump it (`0016:704-708`).
+    EpochExhausted,
+    /// The stored `mpu:` value is not a valid session record (ADR-0045).
+    Record(RecordError),
+    /// A store operation failed.
+    Store(BoxError),
+}
+
+impl fmt::Display for AbortError {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            Self::InDoubt(doubt) => write!(
+                f,
+                "multipart abort: upload {} is in doubt: a fence batch of this abort {}; re-read \
+                 the session to learn whether it is Aborting ({})",
+                doubt.upload_id,
+                if doubt.may_still_commit {
+                    "may still be applied"
+                } else {
+                    "may have been applied"
+                },
+                doubt.cause,
+            ),
+            Self::Stopped { upload_id, cause } => write!(
+                f,
+                "multipart abort: upload {upload_id}: {cause}; no fence batch of this abort is in \
+                 doubt (none landed, and none can land later)"
+            ),
+        }
+    }
+}
+
+impl fmt::Display for Stop {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            Self::RoundsSpent { rounds } => write!(
+                f,
+                "all {rounds} fence rounds were spent and the session is still Open"
+            ),
+            Self::ObligationKeyTaken { key } => write!(
+                f,
+                "the obligation key {key} is already taken while the session is unchanged; this \
+                 is damage a retry cannot settle"
+            ),
+            Self::EpochExhausted => {
+                f.write_str("the session is Open at the last epoch, so no fence can bump it")
+            }
+            Self::Record(torn) => write!(f, "the stored session record is invalid: {torn}"),
+            Self::Store(fault) => write!(f, "store fault: {fault}"),
+        }
+    }
+}
+
+impl std::error::Error for AbortError {
+    fn source(&self) -> Option<&(dyn std::error::Error + 'static)> {
+        match self {
+            // The unknown outcome, never the stop cause: `classify` stops at the first seam type
+            // on the chain, and a doubtful Abort must read `Indeterminate` even when a transient
+            // fault is what stopped it.
+            Self::InDoubt(doubt) => Some(&doubt.outcome),
+            Self::Stopped { cause, .. } => match cause {
+                Stop::Record(torn) => Some(torn),
+                Stop::Store(fault) => Some(fault.as_ref()),
+                Stop::RoundsSpent { .. }
+                | Stop::ObligationKeyTaken { .. }
+                | Stop::EpochExhausted => None,
+            },
+        }
+    }
+}
+
+/// **`AbortMultipartUpload`**: fence the session `upload_id` names (`0016:665`), answering in the
+/// landed vocabulary ([`AbortOutcome`], [`Refusal`]) per decision 3's table (`0016:977`). No
+/// production path calls this yet (#668 will).
+///
+/// # The fence
+///
+/// Read `mpu:<id>`. An `Open@E` session is fenced by one commit of [`fence_batch`]: the session
+/// at `Aborting@E+1` and its `retire:bytes:s:<id>:<E>` obligation `{session, all}`, under
+/// `require` on the exact bytes read and `require_absent` on the obligation key. `{session, all}`
+/// rather than a part list, because a list can outgrow the value ceiling for a sparse session and
+/// `all` is sound: no part commits outside `Open` (`0016:712-717`). Every other state is
+/// answered from the table and nothing is written.
+///
+/// # A commit that did not say `Committed`
+///
+/// The Abort runs at most [`ABORT_ROUNDS`] fence commits, and after each one reads the session
+/// again and answers from what it finds, the last round's read included:
+///
+/// * **`Conflict`, session moved**: answer from the new state. A rival Abort that won leaves
+///   `Aborting`, which answers [`AbortOutcome::AlreadyAborting`]; two racing Aborts never get a
+///   `409`. A session at a later `Open@E'` is fenced again, at `E'`.
+/// * **`Conflict`, session unchanged**: read the obligation key. Absent, the conflict is one no
+///   read explains (TiKV answers `Conflict` when its locking read meets another writer's lock,
+///   with nothing moved), so the Abort spends a round and tries again. Present, it reads the
+///   session once more before naming anything: a rival fence that landed between the two reads
+///   moved the session in the same batch that wrote the key, so a moved session is answered from
+///   its new state. Only a session **still** exactly the bytes this round read makes the key
+///   damage, [`Stop::ObligationKeyTaken`].
+/// * **[`CommitUnknownResult`]**: never read as `Conflict`. The next read answers it: a session
+///   found exactly as a fence of this Abort leaves it is [`AbortOutcome::Fenced`].
+///
+/// # Two kinds of doubt, both kept
+///
+/// * **May still land** (`may_still_commit: true`): kept while the session is unchanged, across
+///   later out-of-flight unknowns, failed reads, store faults and unexplained conflicts. Only a
+///   read that finds the session moved clears it: every fence requires the exact bytes it read,
+///   and the epoch only rises, so a fence of bytes that are gone can never land.
+/// * **Out of flight, outcome not read** (`may_still_commit: false`): the batch cannot land
+///   later, but may already have landed. One successful read of `mpu:<id>` settles it.
+///
+/// When the rounds run out or a fault ends the Abort, it returns [`AbortError::InDoubt`] with the
+/// first outcome that said `may_still_commit` if a fence of it may still land; else, if one of
+/// its unknown outcomes was never settled by a read, [`AbortError::InDoubt`] with that outcome;
+/// only otherwise [`AbortError::Stopped`]. There is no settling read before it returns: a fence
+/// that lands after the Abort returned cannot be found by a look taken before, so the Abort
+/// returns the doubt instead.
+///
+/// # Termination
+///
+/// At most [`ABORT_ROUNDS`] commits, each followed by at most three reads, after one first read.
+/// Each store call is bounded by the store's own contract (every operation terminates,
+/// `crates/traits/src/lib.rs`, "Operational envelope").
+///
+/// **Not cancel-safe once a commit is sent.** Dropping the future after that can leave a fence
+/// that lands with no answer naming it. The fence still installs its obligation in the same
+/// batch, so the session stays in reach of the drain, but the caller is told nothing. Bound an
+/// Abort through the store's own deadlines, never by dropping the future: a commit the store
+/// abandons at its deadline comes back as a [`CommitUnknownResult`], which this function reports.
+pub async fn abort_session(
+    store: &impl MetadataStore,
+    upload_id: &UploadId,
+) -> Result<AbortOutcome, AbortError> {
+    let session_key = mpu_key(upload_id);
+    let mut doubt = Doubt::default();
+    let mut rounds = 0u32;
+    let mut found = match store.get(&session_key).await {
+        Ok(found) => found,
+        Err(fault) => return Err(doubt.end(upload_id, Stop::Store(fault))),
+    };
+    loop {
+        // `found` is always the result of a read that succeeded.
+        if doubt.landed(found.as_ref()) {
+            return Ok(AbortOutcome::Fenced);
+        }
+        doubt.settle(found.as_ref());
+        let Some(read) = found else {
+            return Ok(AbortOutcome::Refused(Refusal::NoSuchUpload));
+        };
+        let record = match decode_session_record(&read) {
+            Ok(record) => record,
+            Err(torn) => return Err(doubt.end(upload_id, Stop::Record(torn))),
+        };
+        match abort_answer(Some(record.state())) {
+            AbortAnswer::Fences => {}
+            AbortAnswer::AlreadyAborting => return Ok(AbortOutcome::AlreadyAborting),
+            AbortAnswer::Refused(refusal) => return Ok(AbortOutcome::Refused(refusal)),
+        }
+        let Some(teardown) = record.open_teardown(upload_id) else {
+            return Err(doubt.end(upload_id, Stop::EpochExhausted));
+        };
+        if rounds == ABORT_ROUNDS {
+            return Err(doubt.end(upload_id, Stop::RoundsSpent { rounds }));
+        }
+        rounds += 1;
+        let obligation = teardown.obligation();
+        let obligation_key = obligation.key();
+        let batch = fence_batch(
+            &session_key,
+            &read,
+            teardown.session(),
+            slice::from_ref(obligation),
+        );
+        found = match store.commit(batch).await {
+            Ok(CommitOutcome::Committed) => return Ok(AbortOutcome::Fenced),
+            Ok(CommitOutcome::Conflict) => {
+                match lost(store, &session_key, &read, &obligation_key).await {
+                    Ok(Lost::Moved(now)) => now,
+                    // Spend the round; the session is still `read`.
+                    Ok(Lost::Unexplained) => Some(read),
+                    Ok(Lost::Taken) => {
+                        let key = String::from_utf8_lossy(&obligation_key).into_owned();
+                        return Err(doubt.end(upload_id, Stop::ObligationKeyTaken { key }));
+                    }
+                    Err(fault) => return Err(doubt.end(upload_id, Stop::Store(fault))),
+                }
+            }
+            Err(fault) => {
+                let Some(unknown) = fault.downcast_ref::<CommitUnknownResult>() else {
+                    // A definite failure of this batch; an earlier batch's doubt still stands.
+                    return Err(doubt.end(upload_id, Stop::Store(fault)));
+                };
+                doubt.observe(unknown, &read, metadata::encode(teardown.session()));
+                match store.get(&session_key).await {
+                    Ok(found) => found,
+                    Err(fault) => return Err(doubt.end(upload_id, Stop::Store(fault))),
+                }
+            }
+        };
+    }
+}
+
+/// What a fence commit that answered `Conflict` lost to ([`lost`]).
+enum Lost {
+    /// The session is no longer the bytes the round read: this is what a read found there.
+    Moved(Option<Bytes>),
+    /// The session is unchanged and the obligation key absent: nothing a read can see explains
+    /// the conflict.
+    Unexplained,
+    /// The obligation key is present, and the session was unchanged on both sides of that read.
+    Taken,
+}
+
+/// Classify a fence commit that answered `Conflict`, from what the store holds, never by
+/// inference: the session first; if unchanged, the obligation key; if that is present, the
+/// session again, since every fence puts its session and its obligation in one batch and each
+/// read is its own transaction, so a rival fence can land between the first two reads.
+async fn lost(
+    store: &impl MetadataStore,
+    session_key: &[u8],
+    read: &Bytes,
+    obligation_key: &[u8],
+) -> Result<Lost, BoxError> {
+    let now = store.get(session_key).await?;
+    if now.as_ref() != Some(read) {
+        return Ok(Lost::Moved(now));
+    }
+    if store.get(obligation_key).await?.is_none() {
+        return Ok(Lost::Unexplained);
+    }
+    let now = store.get(session_key).await?;
+    if now.as_ref() != Some(read) {
+        return Ok(Lost::Moved(now));
+    }
+    Ok(Lost::Taken)
+}
+
+/// What this Abort knows about its own fence commits whose outcome the store could not report.
+#[derive(Debug, Default)]
+struct Doubt {
+    /// The session record each such fence puts: `Aborting@E+1` for the `Open@E` it required.
+    /// Finding one of these at `mpu:<id>` is finding that fence landed.
+    puts: Vec<Bytes>,
+    /// **Held**: the first outcome that said `may_still_commit`, with the session bytes its batch
+    /// requires. Kept, never replaced by a later outcome; only a read that finds the session no
+    /// longer those bytes clears it.
+    held: Option<(CommitUnknownResult, Bytes)>,
+    /// **Unsettled**: the latest out-of-flight outcome no successful read has followed yet.
+    unsettled: Option<CommitUnknownResult>,
+}
+
+impl Doubt {
+    fn observe(&mut self, outcome: &CommitUnknownResult, required: &Bytes, puts: Bytes) {
+        self.puts.push(puts);
+        if !outcome.may_still_commit {
+            self.unsettled = Some(outcome.clone());
+        } else if self.held.is_none() {
+            self.held = Some((outcome.clone(), required.clone()));
+        }
+    }
+
+    /// Whether a read that found `found` found a fence of this Abort landed.
+    fn landed(&self, found: Option<&Bytes>) -> bool {
+        found.is_some_and(|found| self.puts.contains(found))
+    }
+
+    /// A successful read of `mpu:<id>` that found `found`, and not a fence of this Abort: no
+    /// out-of-flight fence of it landed, and a held fence whose required bytes are gone can never
+    /// land.
+    fn settle(&mut self, found: Option<&Bytes>) {
+        self.unsettled = None;
+        if self
+            .held
+            .as_ref()
+            .is_some_and(|(_, required)| found != Some(required))
+        {
+            self.held = None;
+        }
+    }
+
+    /// The error an Abort stopped by `cause` ends with: in doubt while a fence of it may still
+    /// land or was never settled, else stopped.
+    fn end(self, upload_id: &UploadId, cause: Stop) -> AbortError {
+        let upload_id = upload_id.clone();
+        match self.held.map(|(outcome, _)| outcome).or(self.unsettled) {
+            Some(outcome) => AbortError::InDoubt(Box::new(InDoubt {
+                upload_id,
+                may_still_commit: outcome.may_still_commit,
+                outcome,
+                cause,
+            })),
+            None => AbortError::Stopped { upload_id, cause },
+        }
+    }
+}
diff --git a/crates/core/tests/multipart_abort.rs b/crates/core/tests/multipart_abort.rs
new file mode 100644
index 0000000..f8acaa8
--- /dev/null
+++ b/crates/core/tests/multipart_abort.rs
@@ -0,0 +1,1373 @@
+//! Issue #895 — `AbortMultipartUpload`'s **teardown fence**,
+//! `wyrd_core::multipart::abort::abort_session`, and the one fence batch builder it shares with
+//! the post-restore fence (`wyrd_core::multipart::abort::fence_batch`), driven over a real store
+//! (`RedbMetadataStore::in_memory()`) on a multi-thread tokio runtime (proposal 0016's
+//! *Abort / reap fence* row, `0016:665`, and decision 3's Abort row, `0016:977`).
+//!
+//! Every `Open` session here is made by Create (`create_session`, #894), so it is counted by
+//! `mpuctl`; a `Completing` or `Completed` session, or the same session moved to a later epoch,
+//! is that session's record overwritten with canonical bytes the decoder accepts.
+//!
+//! * **(D)** Abort per decision 3: `Open@E` is fenced to `Aborting@E+1` with its `{session, all}`
+//!   obligation in the same batch; a second Abort, and the loser of two forced to race, answer
+//!   `AlreadyAborting`; `Completing` is refused `OperationAborted` writing nothing; `Completed`
+//!   and an absent record answer `NoSuchUpload`; the last round's re-read is answered like any
+//!   other; a plain store fault with nothing in doubt is returned as that fault. Beside those: a
+//!   session moved to a later `Open` epoch is fenced there, and an `Open` session at the last
+//!   epoch or a torn record is a typed error writing nothing.
+//! * **(E)** Abort never moves `mpuctl`: every leg asserts the count is unchanged, a `Completed`
+//!   tombstone included.
+//! * **(H)** a lost commit is classified from what the store holds: a wrapper answers
+//!   `Ok(Conflict)` without applying anything, as TiKV does when its locking read meets another
+//!   writer's lock (`crates/metadata-tikv/src/lib.rs:1388-1393`), and places a rival fence between
+//!   two of the Abort's reads.
+//! * **(I)** the doubt of a fence that may still land is kept until a read finds the session
+//!   moved, and a read that does find it moved clears it; **(I2)** an out-of-flight outcome no
+//!   read settled stays unknown, and one a read did settle is not kept.
+//! * **(J)** the shared builder puts restore's preconditions and records in restore's order.
+//!
+//! The wrappers keep their state in struct fields, never in a `static` (ADR-0035).
+
+#![forbid(unsafe_code)]
+
+use std::collections::VecDeque;
+use std::future::Future;
+use std::sync::atomic::{AtomicUsize, Ordering};
+use std::sync::{Arc, Mutex};
+use std::time::Duration;
+
+use async_trait::async_trait;
+use bytes::Bytes;
+use wyrd_core::metadata::{self, InodeId, SegmentGroup, SegmentNonce};
+use wyrd_core::multipart::abort::{
+    abort_session, fence_batch, AbortError, InDoubt, Stop, ABORT_ROUNDS,
+};
+use wyrd_core::multipart::create::{create_session, CreateRequest, CreateRuntime};
+use wyrd_core::multipart::{
+    decode_admission_record, decode_retire_obligation, decode_session_record, mpu_key, retire_key,
+    AbortOutcome, Budget, CreateOutcome, PartScope, Refusal, RetireMode, RetireToken, SessionState,
+    UploadId, MAX_COMPLETE_ATTEMPTS, MPUCTL_KEY, MPU_PREFIX, RETIRE_BYTES_PREFIX,
+    RETIRE_RECORDS_PREFIX,
+};
+use wyrd_metadata_redb::RedbMetadataStore;
+use wyrd_traits::{
+    classify, BoxError, CommitOutcome, CommitUnknownResult, ErrorClass, MetadataStore,
+    Precondition, Result as StoreResult, ScanPage, TransientFault, WriteBatch,
+};
+
+// ─────────────────────────────── fixtures ───────────────────────────────
+
+const BUCKET: &str = "photos";
+/// The root inode every Alpha object dirent lives under, as `<bucket>/<key>` (ADR-0046).
+const ROOT: InodeId = 0;
+const CLOCK: &str = "wall";
+const CREATED_AT: u64 = 1_000;
+const MARKER: &[u8] = br#"{"name":"photos","created_at_millis":1}"#;
+/// No leg may hang the suite: a schedule that never settles fails here instead.
+const LEG_TIMEOUT: Duration = Duration::from_secs(120);
+/// More commits than any Abort may make. An Abort past it never stops committing.
+const RUNAWAY_COMMITS: usize = 100;
+
+async fn within<T>(leg: impl Future<Output = T>) -> T {
+    tokio::time::timeout(LEG_TIMEOUT, leg)
+        .await
+        .expect("the leg settled in time")
+}
+
+/// A profile admitting `n` sessions: every per-session cap at 1, so `U_ref` is 2.
+fn profile_of(n: u64) -> Budget {
+    let json = format!(
+        "{{\"w_ref\":{},\"max_part_chunks\":1,\"max_parts_per_session\":1,\
+         \"max_inflight_parts\":1,\"max_staged_chunks\":1}}",
+        2 * n
+    );
+    let profile: Budget = metadata::decode(json.as_bytes()).expect("a legal profile");
+    assert_eq!(profile.max_sessions(), n);
+    profile
+}
+
+/// Identity number `n`: upload id `n` and a nonce derived from it, both 32 lowercase hex.
+fn identity(n: u128) -> (UploadId, SegmentNonce) {
+    (
+        UploadId::new(format!("{n:032x}")).unwrap(),
+        SegmentNonce::new(format!("{:032x}", n ^ 0x5a5a_5a5a)).unwrap(),
+    )
+}
+
+/// The runtime Create needs: one fixed identity, no jitter, no wait.
+struct Fixed(Option<(UploadId, SegmentNonce)>);
+
+impl CreateRuntime for Fixed {
+    fn mint(&mut self) -> (UploadId, SegmentNonce) {
+        self.0.take().expect("one identity per create")
+    }
+
+    fn jitter(&mut self) -> u64 {
+        0
+    }
+
+    fn wait(&mut self, _millis: u64) -> impl Future<Output = ()> + Send {
+        std::future::ready(())
+    }
+}
+
+async fn store_with_bucket() -> RedbMetadataStore {
+    let store = RedbMetadataStore::in_memory().unwrap();
+    store
+        .commit(WriteBatch::new().put(metadata::bucket_key(BUCKET), MARKER))
+        .await
+        .unwrap();
+    store
+}
+
+/// Create session `n` through Create (#894): `Open@0`, counted by `mpuctl`. Returns its id and
+/// the exact bytes Create stored.
+async fn open_session(store: &impl MetadataStore, n: u128) -> (UploadId, Bytes) {
+    let object = format!("{BUCKET}/object-{n}");
+    let request = CreateRequest {
+        bucket: BUCKET,
+        parent: ROOT,
+        object: &object,
+        content_type: None,
+        created_at_millis: CREATED_AT,
+        clock_source: CLOCK,
+    };
+    let outcome = create_session(
+        store,
+        &profile_of(8),
+        &request,
+        &mut Fixed(Some(identity(n))),
+    )
+    .await
+    .expect("the create ran");
+    let CreateOutcome::Created { upload_id } = outcome else {
+        panic!("expected Created, got {outcome:?}");
+    };
+    let bytes = store.get(&mpu_key(&upload_id)).await.unwrap().unwrap();
+    let record = decode_session_record(&bytes).unwrap();
+    assert!(matches!(record.state(), SessionState::Open {}));
+    assert_eq!(record.epoch(), 0);
+    (upload_id, bytes)
+}
+
+/// `mpuctl.count()`.
+async fn count(store: &impl MetadataStore) -> u64 {
+    let bytes = store.get(MPUCTL_KEY).await.unwrap().expect("a ledger");
+    decode_admission_record(&bytes).expect("a ledger").count()
+}
+
+/// Every record in the store, in key order.
+async fn snapshot(store: &impl MetadataStore) -> Vec<(Vec<u8>, Bytes)> {
+    let mut all = store.scan(b"").await.unwrap();
+    all.sort();
+    all
+}
+
+/// Every `retire:` key in the store.
+async fn obligations(store: &impl MetadataStore) -> Vec<Vec<u8>> {
+    let mut keys = Vec::new();
+    for prefix in [RETIRE_BYTES_PREFIX, RETIRE_RECORDS_PREFIX] {
+        keys.extend(
+            store
+                .scan(prefix)
+                .await
+                .unwrap()
+                .into_iter()
+                .map(|(k, _)| k),
+        );
+    }
+    keys.sort();
+    keys
+}
+
+/// The JSON spelling of a string, escapes included — the encoder's own.
+fn json_string(text: &str) -> String {
+    String::from_utf8(metadata::encode(&text).to_vec()).unwrap()
+}
+
+/// `open`'s session at `epoch` and `attempts` in `state` (a JSON state object), in the codec's
+/// canonical spelling — checked by decoding it and re-encoding it.
+fn session_bytes(open: &Bytes, epoch: u64, attempts: u32, state: &str) -> Bytes {
+    let record = decode_session_record(open).unwrap();
+    let bytes = format!(
+        "{{\"parent\":{},\"object\":{},\"created_at_millis\":{},\"clock_source\":{},\
+         \"segment_nonce\":\"{}\",\"epoch\":{epoch},\"attempts\":{attempts},\"state\":{state}}}",
+        record.parent(),
+        json_string(record.object()),
+        record.created_at_millis(),
+        json_string(record.clock_source()),
+        record.segment_nonce(),
+    );
+    let decoded = decode_session_record(bytes.as_bytes()).expect("a canonical session");
+    assert_eq!(metadata::encode(&decoded), bytes.as_bytes());
+    Bytes::from(bytes)
+}
+
+/// `open`'s session fenced by a Complete at epoch 1: `Completing@1`, one attempt spent.
+fn completing(open: &Bytes) -> Bytes {
+    let record = decode_session_record(open).unwrap();
+    let state = format!(
+        "{{\"kind\":\"Completing\",\"fenced_at_millis\":2000,\"segments_written\":0,\
+         \"publish_target\":{{\"parent\":{},\"name\":{},\"epoch\":1}}}}",
+        record.parent(),
+        json_string(record.object()),
+    );
+    session_bytes(open, 1, 1, &state)
+}
+
+/// `open`'s session published: a `Completed` tombstone at epoch 2.
+fn completed(open: &Bytes) -> Bytes {
+    let state = format!(
+        "{{\"kind\":\"Completed\",\"completion\":{{\"inode\":7,\"version\":1,\"etag\":\
+         \"{}-1\",\"completed_at_millis\":3000,\"complete_fingerprint\":\"{}\"}}}}",
+        "ab".repeat(32),
+        "cd".repeat(32)
+    );
+    session_bytes(open, 2, 1, &state)
+}
+
+/// Overwrite `id`'s session record with `bytes`.
+async fn plant(store: &impl MetadataStore, id: &UploadId, bytes: Bytes) {
+    let put = WriteBatch::new().put(mpu_key(id), bytes);
+    assert_eq!(store.commit(put).await.unwrap(), CommitOutcome::Committed);
+}
+
+/// The `retire:bytes:s:<id>:<epoch>` key — the `{session, all}` obligation's (`0016:2187`).
+fn obligation_key(id: &UploadId, epoch: u64) -> Vec<u8> {
+    let token = RetireToken::Session {
+        upload_id: id.clone(),
+        epoch,
+        part: None,
+    };
+    retire_key(RetireMode::Bytes, &token)
+}
+
+/// **(D)** The store holds `id`'s `Open@E` session (`open`) fenced: `Aborting@E+1`, exactly as
+/// `SessionRecord::open_teardown` leaves it, and `retire:bytes:s:<id>:<E>` holding exactly the
+/// `{session, all}` obligation it mints — decoding against its own key — and no other `retire:`
+/// key.
+async fn assert_fenced(store: &impl MetadataStore, id: &UploadId, open: &Bytes) {
+    let opened = decode_session_record(open).unwrap();
+    let epoch = opened.epoch();
+    let teardown = opened.open_teardown(id).expect("Open@E has a teardown");
+    let stored = store.get(&mpu_key(id)).await.unwrap().expect("the session");
+    let record = decode_session_record(&stored).expect("a valid session");
+    assert!(
+        matches!(record.state(), SessionState::Aborting {}),
+        "{id}: the fence leaves the session Aborting"
+    );
+    assert_eq!(record.epoch(), epoch + 1, "{id}: Aborting@E+1");
+    assert_eq!(stored, metadata::encode(teardown.session()));
+    let key = obligation_key(id, epoch);
+    assert_eq!(teardown.obligation().key(), key);
+    let value = store.get(&key).await.unwrap().expect("the obligation");
+    assert_eq!(value, metadata::encode(teardown.obligation().payload()));
+    let (mode, token, payload) = decode_retire_obligation(&key, &value).expect("it decodes");
+    assert_eq!(mode, RetireMode::Bytes);
+    assert_eq!(
+        token,
+        RetireToken::Session {
+            upload_id: id.clone(),
+            epoch,
+            part: None,
+        }
+    );
+    assert!(payload.session() && payload.parts() == Some(&PartScope::All));
+    assert_eq!(
+        obligations(store).await,
+        vec![key],
+        "one obligation, no other"
+    );
+}
+
+/// `id`'s `Open@0` session is still exactly `open`, and no obligation exists.
+async fn assert_still_open(store: &impl MetadataStore, id: &UploadId, open: &Bytes) {
+    assert_eq!(store.get(&mpu_key(id)).await.unwrap().as_ref(), Some(open));
+    assert!(obligations(store).await.is_empty(), "no obligation");
+}
+
+/// The fence batch [`fence_batch`] builds for `id`'s `open` session.
+fn expected_fence(id: &UploadId, open: &Bytes) -> WriteBatch {
+    let teardown = decode_session_record(open)
+        .unwrap()
+        .open_teardown(id)
+        .unwrap();
+    fence_batch(
+        &mpu_key(id),
+        open,
+        teardown.session(),
+        std::slice::from_ref(teardown.obligation()),
+    )
+}
+
+fn unknown(may_still_commit: bool) -> BoxError {
+    BoxError::from(CommitUnknownResult {
+        backend: "test wrapper",
+        code: None,
+        detail: "the wrapper withheld the outcome".to_owned(),
+        may_still_commit,
+    })
+}
+
+/// What a scripted plain fault says.
+const FAULT: &str = "the test wrapper's store failed";
+
+fn fault(transient: bool) -> BoxError {
+    if transient {
+        BoxError::from(TransientFault::new(FAULT))
+    } else {
+        BoxError::from(FAULT)
+    }
+}
+
+/// An Abort that ended in doubt: `InDoubt` naming `id`, with `may_still_commit` as given;
+/// [`classify`] reads it as `Indeterminate` (never transient), whatever stopped the Abort; its
+/// source is the store's own `CommitUnknownResult`; and its `Display` names the upload id.
+fn in_doubt(
+    outcome: Result<AbortOutcome, AbortError>,
+    id: &UploadId,
+    may_still_commit: bool,
+) -> Box<InDoubt> {
+    let err = match outcome {
+        Err(err @ AbortError::InDoubt(_)) => err,
+        other => panic!("expected InDoubt naming {id}, got {other:?}"),
+    };
+    assert_eq!(
+        classify(&err),
+        ErrorClass::Indeterminate,
+        "an Abort in doubt reads as indeterminate, whatever stopped it: {err}"
+    );
+    let source = std::error::Error::source(&err)
+        .and_then(|source| source.downcast_ref::<CommitUnknownResult>())
+        .expect("the source is the store's unknown outcome");
+    assert_eq!(source.may_still_commit, may_still_commit);
+    let text = err.to_string();
+    assert!(text.contains(id.as_str()), "it names the upload id: {text}");
+    assert!(text.contains("in doubt"), "{text}");
+    let AbortError::InDoubt(doubt) = err else {
+        unreachable!()
+    };
+    assert_eq!(&doubt.upload_id, id);
+    assert_eq!(doubt.may_still_commit, may_still_commit);
+    doubt
+}
+
+/// An Abort that ended with nothing in doubt, stopped by the scripted transient commit fault:
+/// `Stopped` naming `id`, by [`Stop::Store`] wrapping that fault, and [`classify`] reads it as
+/// `Transient` — never `Indeterminate`, which a kept doubt would make it.
+fn stopped_by_a_transient_fault(outcome: Result<AbortOutcome, AbortError>, id: &UploadId) {
+    let err = match outcome {
+        Err(err @ AbortError::Stopped { .. }) => err,
+        other => panic!("expected Stopped with nothing in doubt, got {other:?}"),
+    };
+    assert_eq!(
+        classify(&err),
+        ErrorClass::Transient,
+        "nothing is in doubt, so the fault keeps its class: {err}"
+    );
+    let AbortError::Stopped { upload_id, cause } = err else {
+        unreachable!()
+    };
+    assert_eq!(&upload_id, id);
+    assert!(
+        matches!(&cause, Stop::Store(fault) if fault.is::<TransientFault>()),
+        "{cause:?}"
+    );
+}
+
+// ──────────────────────────── the scripted wrapper ────────────────────────────
+
+/// What [`Scripted`] does with the Abort's next commit.
+#[derive(Debug, Clone)]
+enum OnCommit {
+    /// Delegate unchanged.
+    Pass,
+    /// Answer `Ok(Conflict)` without applying the batch or changing any record, as TiKV does when
+    /// a locking read meets another writer's lock.
+    ConflictUnmoved,
+    /// Answer a plain store error (not an unknown outcome), unapplied.
+    Fail { transient: bool },
+    /// Apply the batch or not, then answer `CommitUnknownResult { may_still_commit }`.
+    Unknown {
+        applied: bool,
+        may_still_commit: bool,
+    },
+    /// Keep the batch unapplied and answer `CommitUnknownResult { may_still_commit: true }`; it
+    /// lands when the test releases it.
+    Hold,
+    /// As [`Self::Hold`], and before answering, overwrite the session with these bytes (a
+    /// Complete fence moving it on).
+    HoldThenMove(Bytes),
+    /// Overwrite the session with these bytes first (a Complete fence and its release moving it
+    /// to a later `Open` epoch); then delegate, so the batch conflicts for real.
+    MoveFirst(Bytes),
+    /// A real rival Abort of the same session runs on the inner store first; then delegate.
+    RivalFirst,
+}
+
+#[derive(Default)]
+struct ScriptState {
+    plan: VecDeque<OnCommit>,
+    /// What every commit past `plan` does (`Pass` when unset).
+    then: Option<OnCommit>,
+    /// Once the Abort under test has made this many commits, every read of an `mpu:` key fails
+    /// with a plain fault.
+    fail_session_reads_after: Option<usize>,
+    /// On the Abort's first read of a `retire:` key, a real rival Abort of this upload runs on
+    /// the inner store first.
+    rival_on_obligation_read: Option<UploadId>,
+    /// What the rival Abort answered.
+    rival: Option<String>,
+    held: Option<WriteBatch>,
+    /// Every batch the Abort under test committed through this wrapper.
+    commits: Vec<WriteBatch>,
+}
+
+/// A store wrapper that acts on the Abort's commits, and some of its reads, as scripted. Rival
+/// Aborts it starts run directly on the inner store, so only the Abort under test is scripted.
+struct Scripted {
+    inner: RedbMetadataStore,
+    state: Mutex<ScriptState>,
+}
+
+impl Scripted {
+    async fn new() -> Self {
+        Self {
+            inner: store_with_bucket().await,
+            state: Mutex::new(ScriptState::default()),
+        }
+    }
+
+    fn script(&self, plan: Vec<OnCommit>, then: Option<OnCommit>) {
+        let mut state = self.state();
+        state.plan = plan.into();
+        state.then = then;
+    }
+
+    fn state(&self) -> std::sync::MutexGuard<'_, ScriptState> {
+        self.state.lock().unwrap()
+    }
+
+    fn commits(&self) -> Vec<WriteBatch> {
+        self.state().commits.clone()
+    }
+
+    /// Run a real rival Abort of `id` on the inner store, and record its answer.
+    async fn rival(&self, id: &UploadId) {
+        let outcome = abort_session(&self.inner, id).await;
+        assert!(
+            matches!(outcome, Ok(AbortOutcome::Fenced)),
+            "the rival fences: {outcome:?}"
+        );
+        self.state().rival = Some(format!("{outcome:?}"));
+    }
+
+    /// Apply the held batch now; what it met.
+    async fn release_held(&self) -> CommitOutcome {
+        let held = self.state().held.take().expect("a batch is held");
+        self.inner.commit(held).await.unwrap()
+    }
+}
+
+/// The upload id a fence batch's session put names.
+fn upload_of(batch: &WriteBatch) -> UploadId {
+    let key = batch
+        .puts
+        .iter()
+        .map(|(key, _)| key)
+        .find(|key| key.starts_with(MPU_PREFIX))
+        .expect("a fence puts its session");
+    wyrd_core::multipart::parse_mpu_key(key).unwrap()
+}
+
+#[async_trait]
+impl MetadataStore for Scripted {
+    async fn get(&self, key: &[u8]) -> StoreResult<Option<Bytes>> {
+        let (fails, rival) = {
+            let mut state = self.state();
+            let fails = key.starts_with(MPU_PREFIX)
+                && state
+                    .fail_session_reads_after
+                    .is_some_and(|after| state.commits.len() >= after);
+            let rival = if key.starts_with(RETIRE_BYTES_PREFIX) {
+                state.rival_on_obligation_read.take()
+            } else {
+                None
+            };
+            (fails, rival)
+        };
+        if fails {
+            return Err(fault(false));
+        }
+        if let Some(id) = rival {
+            self.rival(&id).await;
+        }
+        self.inner.get(key).await
+    }
+
+    async fn scan(&self, prefix: &[u8]) -> StoreResult<Vec<(Vec<u8>, Bytes)>> {
+        self.inner.scan(prefix).await
+    }
+
+    async fn scan_page(
+        &self,
+        prefix: &[u8],
+        after: Option<&[u8]>,
+        limit: usize,
+    ) -> StoreResult<ScanPage> {
+        self.inner.scan_page(prefix, after, limit).await
+    }
+
+    async fn commit(&self, batch: WriteBatch) -> StoreResult<CommitOutcome> {
+        let (act, made) = {
+            let mut state = self.state();
+            state.commits.push(batch.clone());
+            let act = state.plan.pop_front().or_else(|| state.then.clone());
+            (act.unwrap_or(OnCommit::Pass), state.commits.len())
+        };
+        assert!(
+            made <= RUNAWAY_COMMITS,
+            "the abort never stopped committing ({made} commits)"
+        );
+        match act {
+            OnCommit::Pass => self.inner.commit(batch).await,
+            OnCommit::ConflictUnmoved => {
+                // A real store yields here; so must this one, or no timeout could fire.
+                tokio::task::yield_now().await;
+                Ok(CommitOutcome::Conflict)
+            }
+            OnCommit::Fail { transient } => Err(fault(transient)),
+            OnCommit::Unknown {
+                applied,
+                may_still_commit,
+            } => {
+                if applied {
+                    assert_eq!(self.inner.commit(batch).await?, CommitOutcome::Committed);
+                }
+                Err(unknown(may_still_commit))
+            }
+            OnCommit::Hold => {
+                self.state().held = Some(batch);
+                Err(unknown(true))
+            }
+            OnCommit::HoldThenMove(bytes) => {
+                let id = upload_of(&batch);
+                self.state().held = Some(batch);
+                plant(&self.inner, &id, bytes).await;
+                Err(unknown(true))
+            }
+            OnCommit::MoveFirst(bytes) => {
+                plant(&self.inner, &upload_of(&batch), bytes).await;
+                self.inner.commit(batch).await
+            }
+            OnCommit::RivalFirst => {
+                self.rival(&upload_of(&batch)).await;
+                self.inner.commit(batch).await
+            }
+        }
+    }
+}
