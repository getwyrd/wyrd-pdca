index 0000000..915fc9c
--- /dev/null
+++ b/crates/validate/src/client.rs
@@ -0,0 +1,474 @@
+//! The S3 client every `wyrd-validate` request goes through (proposal 0017 §2: `client.rs`,
+//! **I/O only**).
+//!
+//! One `aws-sdk-s3` client, configured the way any S3-compatible endpoint is reached and the
+//! way Wyrd's own SDK interop tests reach the gateway (`crates/server/tests/
+//! s3_gateway_cluster.rs:100-115`): the `--endpoint` URL, the `--region`, static SigV4
+//! credentials (there is no anonymous path), path-style addressing, a plain-HTTP connector.
+//!
+//! **Retries and stalled-stream protection are off.** An SDK that silently retries turns an
+//! availability failure into a latency number and loses the event this tool exists to record;
+//! a retry policy, if one is wanted, belongs to the scenario layer, where it can be counted.
+//!
+//! **Every wait is bounded** (proposal 0017 §7, and the repo rule "every await on external
+//! work is bounded"): a connect deadline, an operation deadline (request sent → response head
+//! received; for a PUT that includes the upload), and a body-idle deadline on each read of a
+//! GET body. All three are measured on the tokio runtime clock that drives the request (the
+//! SDK's connect timer sleeps on the same runtime); each bounds one call and nothing else, so
+//! no lifecycle spans two clocks.
+//!
+//! **Objects stream in both directions; neither path holds an object whole.** A PUT body is a
+//! caller-supplied stream, polled only as the connection asks for more ([`S3Client::put_object`]);
+//! a GET body is handed back unread and pulled a piece at a time ([`ObjectBody::next_chunk`]).
+//! This is the client half of the invariant the gateway already holds
+//! (`crates/gateway-s3/src/lib.rs:12-17`).
+//!
+//! **Only what arrived is reported.** A failed call is described from the response the server
+//! sent — its status, its request-id header, its body — and the SDK's reading of that body is
+//! believed only where it is a reading of bytes that arrived. See [`S3Error`]. Every request
+//! id, on a receipt or an error, is read from the response header by the SDK's one reader
+//! (`aws_sdk_s3::operation::RequestId`): `x-amz-request-id`, the header S3 and the Wyrd gateway
+//! send — or `x-amzn-requestid`, which that reader prefers if a server sends it as well.
+//!
+//! **Transport limit:** plain HTTP only. A TLS client waits on the rustls crypto-provider
+//! licence decision (`crates/gateway-s3/src/lib.rs:50-57`), so this layer cannot yet reach a
+//! TLS-terminated endpoint directly.
+
+use std::error::Error as StdError;
+use std::future::Future;
+use std::pin::Pin;
+use std::sync::{Arc, OnceLock};
+use std::task::{Context, Poll};
+use std::time::Duration;
+
+use aws_sdk_s3::config::http::HttpResponse;
+use aws_sdk_s3::config::retry::RetryConfig;
+use aws_sdk_s3::config::timeout::TimeoutConfig;
+use aws_sdk_s3::config::{Credentials as SdkCredentials, Region, StalledStreamProtectionConfig};
+use aws_sdk_s3::error::{DisplayErrorContext, ErrorMetadata, ProvideErrorMetadata, SdkError};
+use aws_sdk_s3::operation::RequestId;
+use aws_sdk_s3::primitives::ByteStream;
+use aws_smithy_xml::decode::Document;
+use bytes::Bytes;
+use futures_util::{Stream, StreamExt};
+use http_body::{Body, Frame};
+
+use crate::access_keys::Credentials;
+use crate::error::{ErrorCode, Phase, S3Error, ServiceError};
+use crate::ResolvedConfig;
+
+/// The deadlines every call is held to. See the module docs.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct ClientOptions {
+    /// How long opening a connection may take.
+    pub connect_timeout: Duration,
+    /// How long one call may take from sending the request to receiving the response head.
+    /// For a PUT this covers the whole upload, so size it to the largest object sent.
+    pub operation_timeout: Duration,
+    /// How long a GET body may go without delivering its next piece.
+    pub body_idle_timeout: Duration,
+}
+
+impl Default for ClientOptions {
+    fn default() -> Self {
+        Self {
+            connect_timeout: Duration::from_secs(10),
+            operation_timeout: Duration::from_secs(300),
+            body_idle_timeout: Duration::from_secs(60),
+        }
+    }
+}
+
+/// What the server said about a call that succeeded.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Receipt {
+    /// The request id the server stamped (`x-amz-request-id`; see the module docs), when it
+    /// sent one.
+    pub request_id: Option<String>,
+    /// The `ETag` the server returned, when it returned one.
+    pub e_tag: Option<String>,
+}
+
+/// The S3 client. Cheap to clone; clones share one connection pool.
+#[derive(Debug, Clone)]
+pub struct S3Client {
+    inner: aws_sdk_s3::Client,
+    options: ClientOptions,
+}
+
+impl S3Client {
+    /// A client for `endpoint` (an `http://host:port` URL) in `region`, signing with
+    /// `credentials`.
+    pub fn new(
+        endpoint: &str,
+        region: &str,
+        credentials: &Credentials,
+        options: ClientOptions,
+    ) -> Self {
+        let http_client = aws_smithy_http_client::Builder::new().build_http();
+        let config = aws_sdk_s3::Config::builder()
+            .behavior_version_latest()
+            .region(Region::new(region.to_string()))
+            .endpoint_url(endpoint)
+            .credentials_provider(SdkCredentials::new(
+                credentials.access_key_id(),
+                credentials.secret_access_key(),
+                None,
+                None,
+                "wyrd-validate",
+            ))
+            .http_client(http_client)
+            .force_path_style(true)
+            .retry_config(RetryConfig::disabled())
+            .stalled_stream_protection(StalledStreamProtectionConfig::disabled())
+            .timeout_config(
+                TimeoutConfig::builder()
+                    .connect_timeout(options.connect_timeout)
+                    .build(),
+            )
+            .build();
+        Self {
+            inner: aws_sdk_s3::Client::from_conf(config),
+            options,
+        }
+    }
+
+    /// A client for the `--endpoint` and `--region` of a resolved configuration.
+    pub fn from_config(config: &ResolvedConfig, options: ClientOptions) -> Self {
+        Self::new(
+            &config.args.endpoint,
+            &config.args.region,
+            &config.credentials,
+            options,
+        )
+    }
+
+    /// PUT `body` as `bucket`/`key`. The body is exactly `content_length` bytes, declared as
+    /// the request's `Content-Length`; it is polled only as the connection asks for more, so
+    /// it is never held whole. A body that ends short of `content_length`, runs past it, or
+    /// yields an error fails the PUT with [`S3Error::Body`] — it is never sent as a different
+    /// object.
+    pub async fn put_object<S, E>(
+        &self,
+        bucket: &str,
+        key: &str,
+        content_length: u64,
+        body: S,
+    ) -> Result<Receipt, S3Error>
+    where
+        S: Stream<Item = Result<Bytes, E>> + Send + Sync + 'static,
+        E: Into<Box<dyn StdError + Send + Sync>> + 'static,
+    {
+        let declared = i64::try_from(content_length).map_err(|_| S3Error::Request {
+            detail: format!("content length {content_length} does not fit an S3 Content-Length"),
+        })?;
+        let fault = Arc::new(OnceLock::new());
+        let body = SizedBody {
+            stream: Box::pin(body.map(|item| item.map_err(Into::into))),
+            remaining: content_length,
+            fault: Arc::clone(&fault),
+        };
+        let sent = self
+            .bounded(
+                self.inner
+                    .put_object()
+                    .bucket(bucket)
+                    .key(key)
+                    .content_length(declared)
+                    .body(ByteStream::from_body_1_x(body))
+                    .send(),
+            )
+            .await;
+        // A body fault is the cause of whatever the SDK then reports; name it. No response
+        // to this PUT was read, so there is no request id to carry.
+        if let Some(detail) = fault.get() {
+            return Err(S3Error::Body {
+                request_id: None,
+                detail: detail.clone(),
+            });
+        }
+        let output = sent?.map_err(|e| self.describe(e))?;
+        Ok(Receipt {
+            request_id: output.request_id().map(str::to_string),
+            e_tag: output.e_tag().map(str::to_string),
+        })
+    }
+
+    /// GET `bucket`/`key`. Returns once the response head arrives; the body is not read until
+    /// the caller pulls it with [`ObjectBody::next_chunk`].
+    ///
+    /// A response that declares no `Content-Length` is refused as [`S3Error::Body`]: S3
+    /// GetObject always declares one, and without it a body cut short by a closed connection
+    /// cannot be told from a whole, shorter object.
+    pub async fn get_object(&self, bucket: &str, key: &str) -> Result<ObjectBody, S3Error> {
+        let output = self
+            .bounded(self.inner.get_object().bucket(bucket).key(key).send())
+            .await?
+            .map_err(|e| self.describe(e))?;
+        let receipt = Receipt {
+            request_id: output.request_id().map(str::to_string),
+            e_tag: output.e_tag().map(str::to_string),
+        };
+        let content_length = match output.content_length() {
+            None => {
+                return Err(S3Error::Body {
+                    request_id: receipt.request_id,
+                    detail: "the response declared no Content-Length, so a body cut short \
+                             could not be told from a whole one"
+                        .to_string(),
+                })
+            }
+            Some(n) => u64::try_from(n).map_err(|_| S3Error::Body {
+                request_id: receipt.request_id.clone(),
+                detail: format!("the response declared a negative Content-Length ({n})"),
+            })?,
+        };
+        Ok(ObjectBody {
+            receipt,
+            content_length,
+            received: 0,
+            body: output.body,
+            body_idle_timeout: self.options.body_idle_timeout,
+        })
+    }
+
+    /// DELETE `bucket`/`key`.
+    pub async fn delete_object(&self, bucket: &str, key: &str) -> Result<Receipt, S3Error> {
+        let output = self
+            .bounded(self.inner.delete_object().bucket(bucket).key(key).send())
+            .await?
+            .map_err(|e| self.describe(e))?;
+        Ok(Receipt {
+            request_id: output.request_id().map(str::to_string),
+            e_tag: None,
+        })
+    }
+
+    /// Hold `call` to the operation deadline. Dropping the call on expiry cancels the request.
+    async fn bounded<T>(&self, call: impl Future<Output = T>) -> Result<T, S3Error> {
+        tokio::time::timeout(self.options.operation_timeout, call)
+            .await
+            .map_err(|_| S3Error::Timeout {
+                phase: Phase::Operation,
+                limit: self.options.operation_timeout,
+            })
+    }
+
+    /// The SDK's error, as facts. A request id always comes from the response's own header,
+    /// read by the SDK's reader — the one [`Receipt`]s use too — never from a message string.
+    fn describe<E>(&self, err: SdkError<E, HttpResponse>) -> S3Error
+    where
+        E: ProvideErrorMetadata + StdError + Send + Sync + 'static,
+    {
+        let detail = DisplayErrorContext(&err).to_string();
+        match &err {
+            SdkError::ServiceError(context) => service_error(context.raw(), context.err(), detail),
+            // The response arrived but its body could not be read (cut short, or the
+            // connection broke while reading it).
+            SdkError::ResponseError(context) => S3Error::Unreadable {
+                status: context.raw().status().as_u16(),
+                request_id: context.raw().request_id().map(str::to_string),
+                detail,
+            },
+            // The connector's only deadline is the connect one (no read timeout is set), so a
+            // dispatch timeout is the connect phase expiring.
+            SdkError::DispatchFailure(failure) if failure.is_timeout() => S3Error::Timeout {
+                phase: Phase::Connect,
+                limit: self.options.connect_timeout,
+            },
+            SdkError::ConstructionFailure(_) => S3Error::Request { detail },
+            // Every other dispatch failure (an endpoint that does not resolve to a URL; a
+            // connection refused, reset, or closed before the response head) — and any kind
+            // `SdkError` (non-exhaustive) adds later — means no response was read.
+            // `TimeoutError` cannot arise: it is the SDK's own operation and attempt timeouts,
+            // and none is configured (the operation deadline is `bounded`'s).
+            _ => S3Error::Transport { detail },
+        }
+    }
+}
+
+/// An operation's error response, as facts. The SDK's reading of the response is believed only
+/// where it is a reading of bytes that arrived:
+///
+/// * a **success status** here means the SDK could not read a success response (a header that
+///   fails its grammar). The body has already been handed to the SDK's deserializer, so what is
+///   left to report is the status, the request id and the SDK's diagnostic — `Unreadable`;
+/// * an **empty body** is `NoBody`, checked before the SDK's code: for an empty 404 the SDK
+///   fills in the code `NotFound` itself (aws-sdk-s3 `protocol_serde.rs`,
+///   `parse_http_error_metadata`), which the server never sent;
+/// * a body that is not an S3 error document — not XML, or XML whose root is not `<Error>`
+///   (an HTML error page from a proxy) — is `Unreadable`. The SDK's S3 error reader takes a
+///   `<Code>` from under any root and tolerates unclosed HTML tags, so its reading alone would
+///   call such a page an error response with no code;
+/// * a **`<Code>`** the SDK read from an `<Error>` document is the server's;
+/// * an `<Error>` document the SDK read with no `<Code>` in it is `NoCodeInBody` — the SDK
+///   hands such a reading back as the error's source, an [`ErrorMetadata`];
+/// * anything else — an `<Error>` document the SDK failed partway through reading — is
+///   `Unreadable`, with the SDK's diagnostic kept.
+fn service_error<E>(raw: &HttpResponse, err: &E, detail: String) -> S3Error
+where
+    E: ProvideErrorMetadata + StdError + 'static,
+{
+    let status = raw.status();
+    let request_id = raw.request_id().map(str::to_string);
+    let unreadable = |request_id, detail| S3Error::Unreadable {
+        status: status.as_u16(),
+        request_id,
+        detail,
+    };
+    if status.is_success() {
+        return unreadable(request_id, detail);
+    }
+    let body = raw.body().bytes();
+    let (code, message) = if body.is_some_and(<[u8]>::is_empty) {
+        (ErrorCode::NoBody, None)
+    } else if !body.is_some_and(is_error_document) {
+        return unreadable(request_id, detail);
+    } else if let Some(code) = err.meta().code() {
+        (ErrorCode::Code(code.to_string()), err.meta().message())
+    } else if let Some(read) = err.source().and_then(|s| s.downcast_ref::<ErrorMetadata>()) {
+        (ErrorCode::NoCodeInBody, read.message())
+    } else {
+        return unreadable(request_id, detail);
+    };
+    S3Error::Service(ServiceError {
+        status: status.as_u16(),
+        code,
+        message: message.map(str::to_string),
+        request_id,
+    })
+}
+
+/// Whether `body` is an S3 error document: XML whose root element is `<Error>`. The same test
+/// the SDK's own `body_is_error` makes (aws-sdk-s3 `rest_xml_unwrapped_errors.rs`), with the
+/// SDK's XML reader; its S3 error parser does not make it.
+fn is_error_document(body: &[u8]) -> bool {
+    Document::try_from(body)
+        .and_then(|mut doc| {
+            doc.root_element()
+                .map(|root| root.start_el().matches("Error"))
+        })
+        .unwrap_or(false)
+}
+
+/// The body of a GET, unread. Pull it a piece at a time with [`ObjectBody::next_chunk`].
+#[derive(Debug)]
+pub struct ObjectBody {
+    receipt: Receipt,
+    content_length: u64,
+    /// Body bytes handed to the caller so far, checked against `content_length`.
+    received: u64,
+    body: ByteStream,
+    body_idle_timeout: Duration,
+}
+
+impl ObjectBody {
+    /// The request id and `ETag` of the GET.
+    pub fn receipt(&self) -> &Receipt {
+        &self.receipt
+    }
+
+    /// The `Content-Length` the server declared.
+    pub fn content_length(&self) -> u64 {
+        self.content_length
+    }
+
+    /// The next piece of the body, as soon as the connection delivers it; `Ok(None)` at the
+    /// end. Each wait is held to the body-idle deadline. A body that breaks off, ends short of
+    /// the declared `Content-Length`, or runs past it is [`S3Error::Body`], never a shorter or
+    /// longer object:
+    ///
+    /// * a body that ends short is reported by the layers below — hyper for a
+    ///   `Content-Length`-framed body, and the SDK's own check for every GET (aws-smithy-runtime
+    ///   `content_length_enforcement.rs`, on by default), which also covers framing that
+    ///   disagrees with the declared length — and surfaces here as their error;
+    /// * a body that runs past the declared length is refused HERE, on the piece that crosses
+    ///   it: the SDK's check only fires at the end, after the excess would already have been
+    ///   handed over.
+    pub async fn next_chunk(&mut self) -> Result<Option<Bytes>, S3Error> {
+        let next = tokio::time::timeout(self.body_idle_timeout, self.body.next())
+            .await
+            .map_err(|_| S3Error::Timeout {
+                phase: Phase::BodyIdle,
+                limit: self.body_idle_timeout,
+            })?;
+        let declared = self.content_length;
+        match next {
+            None => Ok(None),
+            Some(Ok(bytes)) => {
+                self.received += bytes.len() as u64;
+                if self.received > declared {
+                    return Err(self.body_error(format!(
+                        "the body ran past its declared {declared} bytes (at least {})",
+                        self.received
+                    )));
+                }
+                Ok(Some(bytes))
+            }
+            Some(Err(e)) => Err(self.body_error(DisplayErrorContext(&e).to_string())),
+        }
+    }
+
+    fn body_error(&self, detail: String) -> S3Error {
+        S3Error::Body {
+            request_id: self.receipt.request_id.clone(),
+            detail,
+        }
+    }
+}
+
+type BoxError = Box<dyn StdError + Send + Sync>;
+type BoxStream = Pin<Box<dyn Stream<Item = Result<Bytes, BoxError>> + Send + Sync>>;
+
+/// A PUT body over a caller's stream. The stream is polled only when the connection asks for
+/// the next frame. A stream that ends short of the declared length or runs past it is an
+/// error, never a different object; the first fault is recorded in `fault` so the PUT reports
+/// it as [`S3Error::Body`].
+///
+/// The declared length reaches the wire as the request's `Content-Length`, which the SDK frames
+/// the upload from (aws-sdk-s3 `aws_chunked.rs`, `modify_before_signing`); this body does not
+/// advertise a size hint of its own, so there is one declared length, not two.
+struct SizedBody {
+    stream: BoxStream,
+    remaining: u64,
+    fault: Arc<OnceLock<String>>,
+}
+
+impl SizedBody {
+    fn fail(&self, detail: String) -> Poll<Option<Result<Frame<Bytes>, BoxError>>> {
+        let _ = self.fault.set(detail.clone());
+        Poll::Ready(Some(Err(detail.into())))
+    }
+}
+
+impl Body for SizedBody {
+    type Data = Bytes;
+    type Error = BoxError;
+
+    fn poll_frame(
+        self: Pin<&mut Self>,
+        cx: &mut Context<'_>,
+    ) -> Poll<Option<Result<Frame<Bytes>, BoxError>>> {
+        let this = self.get_mut();
+        match this.stream.poll_next_unpin(cx) {
+            Poll::Pending => Poll::Pending,
+            Poll::Ready(Some(Ok(bytes))) => {
+                let len = bytes.len() as u64;
+                if len > this.remaining {
+                    return this.fail(format!(
+                        "the body source produced {} bytes past its declared length",
+                        len - this.remaining
+                    ));
+                }
+                this.remaining -= len;
+                Poll::Ready(Some(Ok(Frame::data(bytes))))
+            }
+            Poll::Ready(Some(Err(e))) => this.fail(format!("the body source failed: {e}")),
+            Poll::Ready(None) if this.remaining > 0 => this.fail(format!(
+                "the body source ended {} bytes short of its declared length",
+                this.remaining
+            )),
+            Poll::Ready(None) => Poll::Ready(None),
+        }
+    }
+}
