index 0000000..fd95924
--- /dev/null
+++ b/crates/validate/src/error.rs
@@ -0,0 +1,142 @@
+//! The typed error every S3 call in `wyrd-validate` returns.
+//!
+//! The tool's job is to say *what it expected and what it got* (proposal 0017 §6–§7), so a
+//! failure is handed to the layers above as facts — the HTTP status, the S3 `<Code>`, the
+//! `<Message>`, the `x-amz-request-id` — never as a formatted string to be substring-matched.
+//! Each variant names *where* the failure happened, so "the server answered with something we
+//! could not read" is never folded into "we never reached the server". A fact is only ever one
+//! that arrived on the wire: where the SDK fills in a value the server never sent (it names an
+//! empty 404 `NotFound`), that value is not reported. What a status and a `Code` *mean* for a
+//! capability-matrix row is decided elsewhere (the pure layer, #743); this module only carries
+//! the facts.
+
+use std::fmt;
+use std::time::Duration;
+
+/// The response header carrying the server's request id. The name is the AWS one; the Wyrd
+/// gateway stamps it on every response (`crates/gateway-s3/src/request_id.rs:37-39`).
+pub const REQUEST_ID_HEADER: &str = "x-amz-request-id";
+
+/// Why an S3 call failed.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum S3Error {
+    /// The endpoint answered with an S3 error response: a non-success status with an empty
+    /// body or an S3 `<Error>` document.
+    Service(ServiceError),
+    /// A response arrived, but it could not be read as an S3 response: a success status the
+    /// SDK failed to read (a header that fails its grammar), an error body that is not an S3
+    /// `<Error>` document (an HTML page) or that the SDK failed to read, or an error body cut
+    /// short. The server WAS reached: the status and request id are what it sent, and `detail`
+    /// is the SDK's account of what it could not read.
+    Unreadable {
+        status: u16,
+        request_id: Option<String>,
+        detail: String,
+    },
+    /// No response was received: the endpoint could not be resolved (an `--endpoint` that is
+    /// not a URL) or connected to, or the connection broke before the response arrived.
+    Transport { detail: String },
+    /// A deadline expired before the call finished.
+    Timeout { phase: Phase, limit: Duration },
+    /// The SDK refused to build the request from the call's input (an empty key, a length an
+    /// S3 `Content-Length` cannot carry). It was never sent.
+    Request { detail: String },
+    /// An object body failed, or could not be trusted: the PUT body source failed or did not
+    /// produce its declared length; or a GET response declared no `Content-Length`, broke
+    /// mid-body, or delivered a body that does not match the length it declared. For a GET,
+    /// `request_id` is the one its response carried.
+    Body {
+        request_id: Option<String>,
+        detail: String,
+    },
+}
+
+/// An S3 error response, as facts.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct ServiceError {
+    /// The HTTP status of the response.
+    pub status: u16,
+    /// The `<Code>` of the error body, or which of "no code" / "no body" it was.
+    pub code: ErrorCode,
+    /// The `<Message>` of the error body, when it has one.
+    pub message: Option<String>,
+    /// The request id the server stamped (`x-amz-request-id`; see the `client` module docs),
+    /// when it sent one.
+    pub request_id: Option<String>,
+}
+
+/// What the error body said its `<Code>` was. "No `<Code>` in a body" and "no body at all" are
+/// kept apart: a capability row that expects a coded refusal must be able to tell a bare status
+/// from a body it did not recognise.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum ErrorCode {
+    /// The error body carried this `<Code>`.
+    Code(String),
+    /// The error body was XML, but held no `<Code>`.
+    NoCodeInBody,
+    /// The error response had no body: a bare status.
+    NoBody,
+}
+
+/// Which deadline expired.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum Phase {
+    /// Opening the connection.
+    Connect,
+    /// From sending the request to receiving the response head (for a PUT this includes
+    /// uploading the body).
+    Operation,
+    /// Waiting for the next piece of a GET body.
+    BodyIdle,
+}
+
+impl fmt::Display for Phase {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.write_str(match self {
+            Self::Connect => "connect",
+            Self::Operation => "operation",
+            Self::BodyIdle => "body idle",
+        })
+    }
+}
+
+impl fmt::Display for S3Error {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        let id = |id: &Option<String>| id.clone().unwrap_or_else(|| "none".to_string());
+        match self {
+            Self::Service(e) => {
+                write!(f, "S3 error: status {}", e.status)?;
+                match &e.code {
+                    ErrorCode::Code(code) => write!(f, ", code {code}")?,
+                    ErrorCode::NoCodeInBody => f.write_str(", no <Code> in the error body")?,
+                    ErrorCode::NoBody => f.write_str(", no error body")?,
+                }
+                if let Some(message) = &e.message {
+                    write!(f, ", message {message:?}")?;
+                }
+                write!(f, ", request id {}", id(&e.request_id))
+            }
+            Self::Unreadable {
+                status,
+                request_id,
+                detail,
+            } => write!(
+                f,
+                "unreadable S3 response: status {status}, request id {}: {detail}",
+                id(request_id)
+            ),
+            Self::Transport { detail } => write!(f, "no response from the endpoint: {detail}"),
+            Self::Timeout { phase, limit } => {
+                write!(f, "{phase} deadline of {limit:?} expired")
+            }
+            Self::Request { detail } => write!(f, "the request could not be built: {detail}"),
+            Self::Body { request_id, detail } => write!(
+                f,
+                "object body failed or could not be trusted (request id {}): {detail}",
+                id(request_id)
+            ),
+        }
+    }
+}
+
+impl std::error::Error for S3Error {}
