+#[test]
+fn the_answer_table_is_total_over_the_verb_x_state_product() {
+    // A helper that enumerates the product and fails if a cell is unanswered: adding a
+    // `Verb` or a `SessionState` variant widens this product, so a new state or verb cannot
+    // be added without answering its cells here.
+    let table = decision3_table();
+    let states: Vec<Option<SessionState>> = std::iter::once(None)
+        .chain(SessionState::ALL.into_iter().map(Some))
+        .collect();
+    assert_eq!(states.len(), 5);
+    assert_eq!(Verb::ALL.len(), 5);
+    assert_eq!(
+        table.len(),
+        Verb::ALL.len() * states.len(),
+        "the table does not name exactly the verb x state product"
+    );
+    for verb in Verb::ALL {
+        for state in &states {
+            let cell = table
+                .iter()
+                .find(|(v, s, _)| *v == verb && s == state)
+                .unwrap_or_else(|| panic!("decision 3 cell ({verb:?}, {state:?}) is unanswered"));
+            // Each cell is answered by the per-verb function too, so the union entry point
+            // and the functions the later slices call cannot drift apart.
+            let record = state.map(session);
+            let per_verb = match verb {
+                Verb::UploadPart => Answer::UploadPart(upload_part_answer(*state)),
+                Verb::CompleteMultipartUpload => {
+                    Answer::Complete(complete_answer(record.as_ref(), &recorded_fingerprint()))
+                }
+                Verb::AbortMultipartUpload => Answer::Abort(abort_answer(*state)),
+                Verb::ListParts => Answer::ListParts(list_parts_answer(*state)),
+                Verb::ListMultipartUploads => Answer::ListUploads(list_uploads_answer(*state)),
+            };
+            assert_eq!(per_verb, cell.2, "({verb:?}, {state:?}) disagrees per verb");
+        }
+    }
+}
