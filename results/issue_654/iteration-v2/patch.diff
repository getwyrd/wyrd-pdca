+    // constructors produce, so the disjointness test is about the real key space.
+    assert!(metadata::inode_key(1).starts_with(b"inode:"));
+    assert!(metadata::dirent_key(1, "x").starts_with(b"dirent:"));
+    assert!(metadata::pending_key(1).starts_with(b"pending:"));
+    assert!(metadata::bucket_key("b").starts_with(b"bucket:"));
