+#[test]
+fn a_retirement_obligation_is_validated_against_its_own_key() {
+    let token = RetireToken::Session {
+        upload_id: upload_a(),
+        epoch: 3,
+        part: None,
+    };
+    let bytes_key = retire_key(RetireMode::Bytes, &token);
+    let records_key = retire_key(RetireMode::Records, &token);
+    let session_payload = encode_record(&RetirePayload::Session {});
+    let records_payload = encode_record(&RetirePayload::Records {
+        parts: Some(PartNumberSet::from_numbers([part(1), part(2)])),
+        segments: None,
+    });
+
+    assert_eq!(
+        decode_retire_obligation(&bytes_key, &session_payload).unwrap(),
+        (token.clone(), RetirePayload::Session {})
+    );
+    assert!(decode_retire_obligation(&records_key, &records_payload).is_ok());
+
+    // The mode lives in the KEY: a record payload under `retire:bytes:` would orphan-mark
+    // bytes a live object still names; a byte payload under `retire:records:` would delete
+    // the only records naming durable bytes with no evidence written.
+    assert!(decode_retire_obligation(&bytes_key, &records_payload).is_err());
+    assert!(decode_retire_obligation(&records_key, &session_payload).is_err());
+    // An unknown mode is an error, never a default.
+    assert!(matches!(
+        parse_retire_mode(b"retire:maybe:s:x:1"),
+        Err(RecordError::UnknownRetireMode { .. })
+    ));
+    assert!(parse_retire_mode(b"retire:").is_err());
+    assert!(decode_retire_obligation(b"retire:maybe:s:x:1", &session_payload).is_err());
+
+    // An obligation that owes nothing is a producer bug, and admitting it would let that bug
+    // look like completed work — while one that DOES name work is actionable and decodes.
+    for empty in [
+        encode_record(&RetirePayload::Chunks { chunks: Vec::new() }),
+        encode_record(&RetirePayload::Parts {
+            parts: PartNumberSet::default(),
+        }),
+    ] {
+        assert!(decode_retire_obligation(&bytes_key, &empty).is_err());
+    }
+    for owed in [
+        encode_record(&RetirePayload::Chunks {
+            chunks: vec![chunk_ref(1, 10)],
+        }),
+        encode_record(&RetirePayload::Parts {
+            parts: PartNumberSet::from_numbers([part(1)]),
+        }),
+    ] {
+        assert!(
+            decode_retire_obligation(&bytes_key, &owed).is_ok(),
+            "an obligation that names real work was refused"
+        );
+    }
+    let nothing_named = encode_record(&RetirePayload::Records {
+        parts: None,
+        segments: None,
+    });
+    assert!(decode_retire_obligation(&records_key, &nothing_named).is_err());
+    let empty_parts = encode_record(&RetirePayload::Records {
+        parts: Some(PartNumberSet::default()),
+        segments: None,
+    });
+    assert!(decode_retire_obligation(&records_key, &empty_parts).is_err());
+    // A generation names EITHER a flat chunk list or a `seg:` generation, never both: a
+    // drain that picked one arm would evidence half the payload and then delete it. Either
+    // one ALONE is the ordinary case and must decode.
+    let generation = |chunks: Vec<ChunkRef>, segments: Option<SegmentGroup>| {
+        encode_record(&RetirePayload::Generation {
+            inode: 5,
+            version: 2,
+            chunks,
+            segments,
+        })
+    };
+    assert!(decode_retire_obligation(
+        &bytes_key,
+        &generation(
+            vec![chunk_ref(1, 10)],
+            Some(SegmentGroup::new(NONCE, 3).unwrap())
+        )
+    )
+    .is_err());
+    assert!(
+        decode_retire_obligation(&bytes_key, &generation(vec![chunk_ref(1, 10)], None)).is_ok()
+    );
+    assert!(decode_retire_obligation(
+        &bytes_key,
+        &generation(Vec::new(), Some(SegmentGroup::new(NONCE, 3).unwrap()))
+    )
+    .is_ok());
+    // Each payload knows the one mode it may live under.
+    assert_eq!(RetirePayload::Session {}.mode(), RetireMode::Bytes);
+    assert_eq!(
+        RetirePayload::Records {
+            parts: None,
+            segments: None
+        }
+        .mode(),
+        RetireMode::Records
+    );
+    assert_eq!(RetireMode::Bytes.prefix(), RETIRE_BYTES_PREFIX);
+    assert_eq!(RetireMode::Records.prefix(), RETIRE_RECORDS_PREFIX);
+}
