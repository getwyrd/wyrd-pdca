+#[test]
+fn an_admission_record_whose_limit_disagrees_with_its_profile_is_rejected_at_decode() {
+    // The carried-forward MUST-FIX. `max_sessions` is DERIVED (`floor(W_ref / U_ref)`,
+    // clamped), so a stored limit that disagrees with its own profile is a torn or
+    // rolled-back value. Admission enforces the STORED limit — deliberately, so the fleet
+    // agrees on one number — which is exactly why the stored number may not be free: every
+    // host would trust it, and `sum(U_ref) <= W_ref` would be exceeded on hosts that never
+    // observe the overrun.
+    let profile = budget();
+    assert_eq!(profile.u_ref(), 18);
+    assert_eq!(profile.max_sessions(), 100);
+
+    let ledger = |max_sessions: u64| {
+        json!({
+            "count": 3,
+            "max_sessions": max_sessions,
+            "profile": {
+                "w_ref": 1_800, "max_part_chunks": 3, "max_parts_per_session": 4,
+                "max_inflight_parts": 2, "max_staged_chunks": 8
+            }
+        })
+        .to_string()
+    };
+
+    assert_eq!(
+        decode_admission_record(ledger(100).as_bytes()).unwrap(),
+        AdmissionRecord::new(3, profile)
+    );
+
+    // A hand-authored torn value: the same profile, a larger stored limit.
+    let error = decode_admission_record(ledger(4_000).as_bytes()).unwrap_err();
+    assert!(
+        format!("{error}").contains("derived, never chosen"),
+        "the torn mpuctl was accepted or rejected for the wrong reason: {error}"
+    );
+    // ... and a SMALLER one is refused too: the relation is equality, not a ceiling.
+    assert!(decode_admission_record(ledger(99).as_bytes()).is_err());
+    assert!(decode_admission_record(ledger(0).as_bytes()).is_err());
+}
