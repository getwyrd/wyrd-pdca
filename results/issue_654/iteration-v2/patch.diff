+#[test]
+fn an_owned_staging_entry_carries_both_of_its_fields_or_neither() {
+    let owned = owned_entry();
+    let stored = encode_record(&owned.to_pending());
+    assert_eq!(decode_owned_entry(&stored).unwrap(), owned);
+
+    // Exactly one of the two fields is a torn record: a reader would have to guess whether
+    // the entry is owned, and an owned entry read as ordinary is one a global sweep reaps.
+    let owner_only = json!({ "lease_expiry_millis": 500, "owner": ID_A });
+    assert!(decode_owned_entry(owner_only.to_string().as_bytes()).is_err());
+    let staged_only = json!({
+        "lease_expiry_millis": 500,
+        "staged": { "scheme": "None", "placement": [7] }
+    });
+    assert!(decode_owned_entry(staged_only.to_string().as_bytes()).is_err());
+    // An ordinary `pending:` entry is not an owned one — it is refused by this decoder
+    // rather than silently answering "unowned".
+    let ordinary = json!({ "lease_expiry_millis": 500 });
+    assert!(decode_owned_entry(ordinary.to_string().as_bytes()).is_err());
+    assert!(OwnedEntry::from_pending(&PendingEntry {
+        lease_expiry_millis: 500,
+        owner: None,
+        staged: None,
+    })
+    .is_err());
+    // A malformed owner token would name a per-session range nothing could derive — and it
+    // is refused by `PendingEntry`'s own decode, so no reader ever holds one.
+    let bad_owner = json!({
+        "lease_expiry_millis": 500, "owner": "nope",
+        "staged": { "scheme": "None", "placement": [7] }
+    });
+    assert!(decode_owned_entry(bad_owner.to_string().as_bytes()).is_err());
+    assert!(serde_json::from_str::<PendingEntry>(&bad_owner.to_string()).is_err());
+    // The placement's LENGTH is deliberately contextual, not structural (ADR-0045,
+    // `AGENTS.md:146-149`): a length-mismatched staged placement decodes, so the fleet can
+    // quarantine it instead of aborting the whole reconcile step.
+    let short_placement = json!({
+        "lease_expiry_millis": 500, "owner": ID_A,
+        "staged": { "scheme": { "ReedSolomon": { "k": 4, "m": 2 } }, "placement": [1] }
+    });
+    assert!(decode_owned_entry(short_placement.to_string().as_bytes()).is_ok());
+}
