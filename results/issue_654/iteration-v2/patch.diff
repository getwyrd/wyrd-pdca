--- /dev/null
+++ b/crates/core/tests/multipart_records.rs
@@ -0,0 +1,1796 @@
+//! The multipart record family, its key grammar, its answer table and its two digests —
+//! **pure** tests over values (issue #654, proposal 0016).
+//!
+//! No store, no async runtime, no fixture beyond literals: every symbol under test is a pure
+//! function or a `serde` codec, so each leg below is a statement about the *vocabulary* the
+//! later multipart slices (#655-#660) write, read and answer in.
+//!
+//! The six legs, in the order the issue states them:
+//!
+//! 1. key grammars round-trip, and every non-canonical spelling is rejected at decode;
+//! 2. no record prefix is a prefix of another;
+//! 3. every record's decode validates, and `decode -> encode` is the identity on a legacy
+//!    `pending:` value;
+//! 4. every reachable decision-3 cell is answered by a pure function with a typed outcome;
+//! 5. `multipart_etag` matches an independent oracle;
+//! 6. `complete_fingerprint` tells an identical retry from a different assembly.
+
+#![forbid(unsafe_code)]
+
+use serde_json::json;
+use sha2::{Digest as _, Sha256};
+
+use wyrd_core::metadata::{self, ChunkRef, EcScheme, PendingEntry, SegmentGroup};
+use wyrd_core::multipart::{
+    self, abort_answer, answer, complete_answer, complete_fingerprint, decode_admission_record,
+    decode_owned_entry, decode_part, decode_part_summary, decode_retire_obligation, decode_session,
+    decode_slot, encode_record, hex_lower, is_token, list_parts_answer, list_uploads_answer,
+    mpu_key, multipart_etag, parse_mpu_key, parse_part_key, parse_psum_key, parse_retire_key,
+    parse_retire_mode, parse_sidx_key, parse_slot_key, part_key, part_range, psum_key, psum_range,
+    retire_key, retire_session_range, sidx_key, sidx_range, slot_key, slot_range,
+    upload_part_answer, AbortAnswer, AdmissionRecord, Answer, AttemptId, Budget, CompleteAnswer,
+    Completion, Digest, ListPartsAnswer, ListUploadsAnswer, MultipartEtag, OwnedEntry, PartNumber,
+    PartNumberSet, PartRecord, PartSummary, Publication, PublishTarget, RecordError, Refusal,
+    RetireMode, RetirePayload, RetireToken, SessionRecord, SessionState, SlotIndex, SlotRecord,
+    StagedPlacement, UploadId, UploadPartAnswer, Verb, MAX_PART_NUMBER, MAX_SLOT_INDEX, MPUCTL_KEY,
+    MPU_PREFIX, PART_NUMBER_WIDTH, PART_PREFIX, PSUM_PREFIX, RETIRE_BYTES_PREFIX,
+    RETIRE_RECORDS_PREFIX, SIDX_PREFIX, SLOT_INDEX_WIDTH, SLOT_PREFIX, TOKEN_HEX_LEN,
+};
+
+// ---------------------------------------------------------------------------
+// Literals — two distinct 128-bit tokens and a digest generator.
+// ---------------------------------------------------------------------------
+
+const ID_A: &str = "0123456789abcdef0123456789abcdef";
+const ID_B: &str = "fedcba9876543210fedcba9876543210";
+const NONCE: &str = "00112233445566778899aabbccddeeff";
+
+fn upload_a() -> UploadId {
+    UploadId::new(ID_A).expect("a 32-character lowercase-hex token is an upload id")
+}
+
+fn upload_b() -> UploadId {
+    UploadId::new(ID_B).expect("a 32-character lowercase-hex token is an upload id")
+}
+
+fn attempt() -> AttemptId {
+    AttemptId::new(ID_B).expect("a 32-character lowercase-hex token is an attempt id")
+}
+
+fn part(n: u32) -> PartNumber {
+    PartNumber::new(n).expect("a part number inside the key space")
+}
+
+/// A distinct, reproducible digest per label — the *content* is irrelevant, only that two
+/// labels never collide.
+fn digest_of(label: &str) -> Digest {
+    Digest::of(label.as_bytes())
+}
+
+fn chunk_ref(id: u128, len: u64) -> ChunkRef {
+    ChunkRef {
+        id,
+        scheme: EcScheme::None,
+        len,
+        placement: vec![7],
+    }
+}
+
+// ===========================================================================
+// Leg 1 — the key grammar round-trips, and non-canonical spellings are REJECTED
+// ===========================================================================
+
+#[test]
+fn every_keyed_record_round_trips_through_its_parser() {
+    let a = upload_a();
+
+    assert_eq!(
+        mpu_key(&a),
+        b"mpu:0123456789abcdef0123456789abcdef".to_vec()
+    );
+    assert_eq!(parse_mpu_key(&mpu_key(&a)).unwrap(), a);
+
+    for index in [0u32, 1, 42, MAX_SLOT_INDEX] {
+        let index = SlotIndex::new(index).unwrap();
+        let key = slot_key(&a, index);
+        assert_eq!(parse_slot_key(&key).unwrap(), (a.clone(), index));
+        // Zero-padded to the fixed width, so the key sorts by index (see the order test).
+        assert!(
+            key.ends_with(format!("{:0width$}", index.get(), width = SLOT_INDEX_WIDTH).as_bytes())
+        );
+        assert!(key.starts_with(&slot_range(&a)));
+    }
+
+    for number in [1u32, 7, 10_000, MAX_PART_NUMBER] {
+        let number = part(number);
+        let padded = format!("{:0width$}", number.get(), width = PART_NUMBER_WIDTH);
+        let part_key = part_key(&a, number);
+        assert_eq!(parse_part_key(&part_key).unwrap(), (a.clone(), number));
+        assert!(part_key.starts_with(&part_range(&a)));
+        assert!(part_key.ends_with(padded.as_bytes()));
+
+        let psum_key = psum_key(&a, number);
+        assert_eq!(parse_psum_key(&psum_key).unwrap(), (a.clone(), number));
+        assert!(psum_key.starts_with(&psum_range(&a)));
+        assert!(psum_key.ends_with(padded.as_bytes()));
+
+        for chunk in [0u128, 7, u128::from(u64::MAX) + 1] {
+            let key = sidx_key(&a, number, chunk);
+            assert_eq!(parse_sidx_key(&key).unwrap(), (a.clone(), number, chunk));
+            assert!(key.starts_with(&sidx_range(&a)));
+        }
+    }
+
+    for mode in RetireMode::ALL {
+        for token in [
+            RetireToken::Session {
+                upload_id: a.clone(),
+                epoch: 0,
+                part: None,
+            },
+            RetireToken::Session {
+                upload_id: a.clone(),
+                epoch: 9,
+                part: None,
+            },
+            RetireToken::Session {
+                upload_id: a.clone(),
+                epoch: 3,
+                part: Some((part(4), attempt())),
+            },
+            RetireToken::Generation {
+                inode: 12,
+                version: 34,
+            },
+        ] {
+            let key = retire_key(mode, &token);
+            assert_eq!(parse_retire_key(&key).unwrap(), (mode, token.clone()));
+            assert_eq!(parse_retire_mode(&key).unwrap(), mode);
+            if matches!(token, RetireToken::Session { .. }) {
+                assert!(key.starts_with(&retire_session_range(mode, &a)));
+                assert!(!key.starts_with(&retire_session_range(mode, &upload_b())));
+            }
+        }
+    }
+}
+
+#[test]
+fn a_fixed_width_field_accepts_exactly_one_spelling_of_one_record() {
+    // Every spelling below denotes "part 7" (or "slot 7") to a permissive `from_str`, and
+    // each MUST be refused: two spellings of one record defeat a `require_absent` guard and
+    // hide a record from a bounded range scan (C-1).
+    for body in [
+        "7",       // short
+        "07",      // short
+        "0007",    // short by one
+        "0000007", // over-wide
+        "+0007",   // a `+` sign `u32::from_str` would accept
+        "-0007",   // a `-` sign
+        " 0007",   // leading space
+        "0007 ",   // trailing space
+        "000_7",   // non-decimal body
+        "0x007",   // non-decimal body
+        "abcde",   // non-decimal body
+        "",        // empty
+    ] {
+        let part_spelling = format!("part:{ID_A}:{body}");
+        assert!(
+            parse_part_key(part_spelling.as_bytes()).is_err(),
+            "part: key accepted the non-canonical part-number spelling {body:?}"
+        );
+        let psum_spelling = format!("psum:{ID_A}:{body}");
+        assert!(
+            parse_psum_key(psum_spelling.as_bytes()).is_err(),
+            "psum: key accepted the non-canonical part-number spelling {body:?}"
+        );
+        let sidx_spelling = format!("sidx:{ID_A}:{body}:12");
+        assert!(
+            parse_sidx_key(sidx_spelling.as_bytes()).is_err(),
+            "sidx: key accepted the non-canonical part-number spelling {body:?}"
+        );
+    }
+
+    for body in [
+        "7", "07", "000007 ", "0000007", "+00007", "-00007", "abcdef", "",
+    ] {
+        let spelling = format!("slot:{ID_A}:{body}");
+        assert!(
+            parse_slot_key(spelling.as_bytes()).is_err(),
+            "slot: key accepted the non-canonical index spelling {body:?}"
+        );
+    }
+
+    // The canonical spelling of the same records DOES parse — so the rejections above are
+    // about the spelling, not about a parser that refuses everything.
+    assert_eq!(
+        parse_part_key(format!("part:{ID_A}:00007").as_bytes()).unwrap(),
+        (upload_a(), part(7))
+    );
+    assert_eq!(
+        parse_slot_key(format!("slot:{ID_A}:000007").as_bytes()).unwrap(),
+        (upload_a(), SlotIndex::new(7).unwrap())
+    );
+    assert_eq!(
+        parse_sidx_key(format!("sidx:{ID_A}:00007:12").as_bytes()).unwrap(),
+        (upload_a(), part(7), 12)
+    );
+}
+
+#[test]
+fn a_variable_width_field_accepts_exactly_one_spelling_too() {
+    // The `sidx:` chunk id and the `retire:` epoch/version are NOT zero-padded, so their
+    // canonicality rule is "no leading zero unless the value is zero".
+    for chunk in ["007", "+7", "-7", "0x7", "7 ", "", "1e3"] {
+        let key = format!("sidx:{ID_A}:00007:{chunk}");
+        assert!(
+            parse_sidx_key(key.as_bytes()).is_err(),
+            "sidx: key accepted the non-canonical chunk id {chunk:?}"
+        );
+    }
+    // ... and a single `0` IS canonical: epoch 0 is a real epoch, chunk 0 a real chunk id.
+    assert_eq!(
+        parse_sidx_key(format!("sidx:{ID_A}:00007:0").as_bytes()).unwrap(),
+        (upload_a(), part(7), 0)
+    );
+    assert_eq!(
+        parse_retire_key(format!("retire:bytes:s:{ID_A}:0").as_bytes()).unwrap(),
+        (
+            RetireMode::Bytes,
+            RetireToken::Session {
+                upload_id: upload_a(),
+                epoch: 0,
+                part: None
+            }
+        )
+    );
+    for epoch in ["00", "007", "+7", "-1", ""] {
+        let key = format!("retire:bytes:s:{ID_A}:{epoch}");
+        assert!(
+            parse_retire_key(key.as_bytes()).is_err(),
+            "retire: key accepted the non-canonical epoch {epoch:?}"
+        );
+    }
+    // The per-part suffix's own components are checked the same way.
+    assert!(parse_retire_key(format!("retire:bytes:s:{ID_A}:1:04:{ID_B}").as_bytes()).is_err());
+    assert!(parse_retire_key(format!("retire:bytes:s:{ID_A}:1:0:{ID_B}").as_bytes()).is_err());
+    assert!(parse_retire_key(format!("retire:bytes:s:{ID_A}:1:100000:{ID_B}").as_bytes()).is_err());
+    assert!(parse_retire_key(format!("retire:bytes:s:{ID_A}:1:4:nope").as_bytes()).is_err());
+    assert!(parse_retire_key(format!("retire:bytes:s:{ID_A}:1:4:{ID_B}").as_bytes()).is_ok());
+    // A generation token's inode and version are canonical decimals too.
+    assert!(parse_retire_key(b"retire:bytes:g:012:3").is_err());
+    assert!(parse_retire_key(b"retire:bytes:g:12:03").is_err());
+    assert!(parse_retire_key(b"retire:bytes:g:12:3").is_ok());
+}
+
+#[test]
+fn a_malformed_key_is_a_typed_error_never_a_value() {
+    let cases: Vec<(&str, Vec<u8>)> = vec![
+        // An empty upload id would make every per-session range the whole namespace.
+        ("empty upload id", b"mpu:".to_vec()),
+        ("empty upload id", b"part::00007".to_vec()),
+        ("empty upload id", b"slot::000007".to_vec()),
+        // An id embedding the separator would name another session's range.
+        (
+            "separator in the upload id",
+            format!("part:{ID_A}:{ID_B}:00007").into_bytes(),
+        ),
+        (
+            "separator in the upload id",
+            format!("mpu:{ID_A}:x").into_bytes(),
+        ),
+        // Truncated keys.
+        ("truncated", format!("part:{ID_A}").into_bytes()),
+        ("truncated", format!("slot:{ID_A}").into_bytes()),
+        ("truncated", format!("sidx:{ID_A}:00007").into_bytes()),
+        ("truncated", b"retire:bytes:".to_vec()),
+        // A trailing component: one record MUST NOT be addressable by a longer key.
+        (
+            "trailing component",
+            format!("mpu:{ID_A}:extra").into_bytes(),
+        ),
+        (
+            "trailing component",
+            format!("part:{ID_A}:00007:extra").into_bytes(),
+        ),
+        (
+            "trailing component",
+            format!("slot:{ID_A}:000007:extra").into_bytes(),
+        ),
+        (
+            "trailing component",
+            format!("retire:bytes:s:{ID_A}:1:extra").into_bytes(),
+        ),
+        // A short/long/uppercase token is not a token.
+        ("short token", format!("mpu:{}", &ID_A[..31]).into_bytes()),
+        ("long token", format!("mpu:{ID_A}0").into_bytes()),
+        (
+            "uppercase token",
+            format!("mpu:{}", ID_A.to_uppercase()).into_bytes(),
+        ),
+        // A wrong prefix must never parse as this record class.
+        ("wrong prefix", format!("psum:{ID_A}:00007").into_bytes()),
+        ("wrong prefix", b"mpuctl".to_vec()),
+    ];
+    for (why, key) in cases {
+        let parsed: Result<(), RecordError> = if key.starts_with(PART_PREFIX) {
+            parse_part_key(&key).map(|_| ())
+        } else if key.starts_with(SLOT_PREFIX) {
+            parse_slot_key(&key).map(|_| ())
+        } else if key.starts_with(SIDX_PREFIX) {
+            parse_sidx_key(&key).map(|_| ())
+        } else if key.starts_with(b"retire:") {
+            parse_retire_key(&key).map(|_| ())
+        } else {
+            parse_mpu_key(&key).map(|_| ())
+        };
+        assert!(
+            parsed.is_err(),
+            "{why}: {:?} parsed as a valid key",
+            String::from_utf8_lossy(&key)
+        );
+    }
+
+    // A key whose bytes are not UTF-8 fails closed rather than panicking or lossily
+    // "repairing" itself into a neighbouring record.
+    let mut not_utf8 = format!("part:{ID_A}:0000").into_bytes();
+    not_utf8.push(0xff);
+    assert!(matches!(
+        parse_part_key(&not_utf8),
+        Err(RecordError::MalformedKey { .. })
+    ));
+    let mut not_utf8_mpu = b"mpu:".to_vec();
+    not_utf8_mpu.extend_from_slice(&[0xff; 32]);
+    assert!(parse_mpu_key(&not_utf8_mpu).is_err());
+    let mut not_utf8_retire = b"retire:bytes:s:".to_vec();
+    not_utf8_retire.extend_from_slice(&[0xff; 32]);
+    assert!(parse_retire_key(&not_utf8_retire).is_err());
+}
+
+#[test]
+fn byte_lexicographic_key_order_equals_numeric_order() {
+    // The property the zero-padding exists for (`metadata.rs:270-273`): a bounded range read
+    // returns slots and parts in numeric order, so a cursor-keyed drain resumes where it
+    // stopped instead of skipping records.
+    let a = upload_a();
+
+    let mut slot_keys: Vec<Vec<u8>> = [0u32, 1, 2, 9, 10, 99, 100, 999, 1_000, MAX_SLOT_INDEX]
+        .into_iter()
+        .map(|i| slot_key(&a, SlotIndex::new(i).unwrap()))
+        .collect();
+    let numeric = slot_keys.clone();
+    slot_keys.sort();
+    assert_eq!(slot_keys, numeric, "slot: keys do not sort by index");
+
+    let mut part_keys: Vec<Vec<u8>> = [1u32, 2, 9, 10, 99, 100, 9_999, 10_000, MAX_PART_NUMBER]
+        .into_iter()
+        .map(|n| part_key(&a, part(n)))
+        .collect();
+    let numeric = part_keys.clone();
+    part_keys.sort();
+    assert_eq!(part_keys, numeric, "part: keys do not sort by part number");
+
+    // Un-padded, `10` would sort before `9` — the exact defect the width forbids.
+    assert!(b"part:x:00009".to_vec() < b"part:x:00010".to_vec());
+    assert!(b"part:x:9".to_vec() > b"part:x:10".to_vec());
+}
