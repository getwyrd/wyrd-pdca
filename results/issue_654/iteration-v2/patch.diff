+#[test]
+fn the_profile_derivations_are_pure_arithmetic_over_the_stored_tuple() {
+    // Both branches of `U_ref = min(raw, ceiling)` are exercised, so a swapped comparison or
+    // a swapped operator cannot pass.
+    // raw = (4 + 2) * 3 = 18; ceiling = 8 + 2*2*3 = 20  ->  raw binds
+    assert_eq!(Budget::new(1_800, 3, 4, 2, 8).unwrap().u_ref(), 18);
+    // raw = (400 + 2) * 3 = 1206; ceiling = 8 + 2*2*3 = 20  ->  ceiling binds
+    assert_eq!(Budget::new(1_800, 3, 400, 2, 8).unwrap().u_ref(), 20);
+    // W_ref / U_ref, floored.
+    assert_eq!(Budget::new(1_800, 3, 4, 2, 8).unwrap().max_sessions(), 100);
+    assert_eq!(Budget::new(1_799, 3, 4, 2, 8).unwrap().max_sessions(), 99);
+    assert_eq!(Budget::new(17, 3, 4, 2, 8).unwrap().max_sessions(), 0);
+
+    // The SCAN_CAP/2 clamp: a large W_ref with small parts would otherwise exceed the one
+    // `scan("mpu:")` the reaper issues.
+    let clamp = (wyrd_traits::SCAN_CAP / 2) as u64;
+    let unclamped = Budget::new(u64::MAX, 1, 1, 1, 1).unwrap();
+    assert_eq!(unclamped.u_ref(), 2);
+    assert_eq!(unclamped.max_sessions(), clamp);
+    // Exactly at the clamp is the clamp; one below is itself.
+    assert_eq!(
+        Budget::new(2 * clamp, 1, 1, 1, 1).unwrap().max_sessions(),
+        clamp
+    );
+    assert_eq!(
+        Budget::new(2 * (clamp - 1), 1, 1, 1, 1)
+            .unwrap()
+            .max_sessions(),
+        clamp - 1
+    );
+
+    // Saturating, never wrapping. `(2^32 + 2^32) x 2^32` exceeds `u64`, so unchecked
+    // arithmetic over these DECODED fields would panic in a checked build and wrap in a
+    // release one — deriving a per-session footprint smaller than the truth and admitting
+    // past the memory the reconcile pass is sized for. Saturation charges the whole budget
+    // to one session instead, which is the fail-closed direction.
+    let huge = Budget::new(u64::MAX, u32::MAX, u32::MAX, u32::MAX, u32::MAX).unwrap();
+    assert_eq!(huge.u_ref(), u64::MAX);
+    assert_eq!(huge.max_sessions(), 1);
+    let huge_but_short = Budget::new(u64::MAX - 1, u32::MAX, u32::MAX, u32::MAX, u32::MAX).unwrap();
+    assert_eq!(huge_but_short.max_sessions(), 0);
+    // ... and the same arithmetic runs at DECODE, over bytes no writer in this crate
+    // produced, so it must not panic there either.
+    let untrusted = json!({
+        "count": 0,
+        "max_sessions": 1,
+        "profile": {
+            "w_ref": u64::MAX, "max_part_chunks": u32::MAX, "max_parts_per_session": u32::MAX,
+            "max_inflight_parts": u32::MAX, "max_staged_chunks": u32::MAX
+        }
+    });
+    assert_eq!(
+        decode_admission_record(untrusted.to_string().as_bytes())
+            .unwrap()
+            .max_sessions,
+        1
+    );
+
+    // A zero component is refused at construction AND at decode: no configuration admits a
+    // session under it, and `W_ref / 0` is not a limit.
+    for tuple in [
+        (0u64, 3u32, 4u32, 2u32, 8u32),
+        (1_800, 0, 4, 2, 8),
+        (1_800, 3, 0, 2, 8),
+        (1_800, 3, 4, 0, 8),
+        (1_800, 3, 4, 2, 0),
+    ] {
+        assert!(Budget::new(tuple.0, tuple.1, tuple.2, tuple.3, tuple.4).is_err());
+        let value = json!({
+            "w_ref": tuple.0, "max_part_chunks": tuple.1, "max_parts_per_session": tuple.2,
+            "max_inflight_parts": tuple.3, "max_staged_chunks": tuple.4
+        });
+        assert!(serde_json::from_str::<Budget>(&value.to_string()).is_err());
+    }
+
+    // The accessors report the stored tuple.
+    let profile = budget();
+    assert_eq!(
+        (
+            profile.w_ref(),
+            profile.max_part_chunks(),
+            profile.max_parts_per_session(),
+            profile.max_inflight_parts(),
+            profile.max_staged_chunks()
+        ),
+        (1_800, 3, 4, 2, 8)
+    );
+}
