+#[test]
+fn scanning_the_session_prefix_never_returns_the_admission_singleton() {
+    // The near-miss the issue names: spelling the prefix `mpu` rather than `mpu:` sweeps the
+    // fleet admission ledger into every per-session scan — and a session iteration that
+    // decoded `mpuctl` as a session would fail closed on every pass.
+    assert!(!MPUCTL_KEY.starts_with(MPU_PREFIX));
+    assert!(!mpu_key(&upload_a()).starts_with(MPUCTL_KEY));
