+#[test]
+fn a_part_number_set_is_canonical_or_it_is_not_a_set() {
+    let set = PartNumberSet::from_numbers([part(1), part(2), part(3), part(9), part(10)]);
+    assert_eq!(set.len(), 5);
+    assert!(!set.is_empty());
+    assert!(set.contains(part(3)));
+    assert!(!set.contains(part(4)));
+    assert_eq!(set.iter().collect::<Vec<_>>(), vec![1, 2, 3, 9, 10]);
+    assert_eq!(set.first_at_or_after(1), Some(1));
+    assert_eq!(set.first_at_or_after(4), Some(9));
+    assert_eq!(set.first_at_or_after(10), Some(10));
+    assert_eq!(set.first_at_or_after(11), None);
+    // Coalesced: [1,3] and [9,10] — the "every staged part was published" case is a few
+    // bytes rather than 10,000 numbers.
+    assert_eq!(
+        String::from_utf8(encode_record(&set)).unwrap(),
+        "[[1,3],[9,10]]"
+    );
+    assert_eq!(PartNumberSet::default().len(), 0);
+    assert!(PartNumberSet::default().is_empty());
+    assert_eq!(PartNumberSet::default().first_at_or_after(1), None);
+
+    // Every non-canonical spelling is refused at decode: a reversed run underflows `len`, an
+    // unordered one makes a drain cursor skip members, and a number past the key grammar
+    // names a `part:` record no parser can read back.
+    for bad in [
+        "[[3,1]]",        // reversed
+        "[[1,3],[2,4]]",  // overlapping
+        "[[1,3],[4,5]]",  // adjacent (a second spelling of [[1,5]])
+        "[[9,10],[1,3]]", // descending
+        "[[0,3]]",        // part 0 is not a part
+        "[[1,100000]]",   // past the five-digit key space
+        "[[100000,100001]]",
+    ] {
+        assert!(
+            serde_json::from_str::<PartNumberSet>(bad).is_err(),
+            "the non-canonical part-number set {bad} decoded"
+        );
+    }
+    assert!(serde_json::from_str::<PartNumberSet>("[[1,3],[5,6]]").is_ok());
+    assert!(serde_json::from_str::<PartNumberSet>("[]").is_ok());
+}
