+#[test]
+fn a_slot_a_part_and_a_summary_are_validated_at_decode() {
+    // A lease that expired before the slot was claimed cannot be stamped under one clock.
+    let slot = |reserved: u64, expiry: u64| {
+        json!({
+            "part_number": 4, "attempt_id": ID_B,
+            "reserved_at_millis": reserved, "lease_expiry_millis": expiry
+        })
+    };
+    assert!(decode_slot(slot(100, 99).to_string().as_bytes()).is_err());
+    assert!(decode_slot(slot(100, 100).to_string().as_bytes()).is_ok());
+    assert!(decode_slot(slot(100, 101).to_string().as_bytes()).is_ok());
+    // The part number and the attempt id are validated by their own types.
+    for (field, bad) in [
+        ("part_number", json!(0)),
+        ("part_number", json!(MAX_PART_NUMBER + 1)),
+        ("attempt_id", json!("nope")),
+        ("attempt_id", json!(ID_B.to_uppercase())),
+    ] {
+        let mut value = slot(100, 100);
+        value
+            .as_object_mut()
+            .unwrap()
+            .insert(field.to_string(), bad);
+        assert!(
+            decode_slot(value.to_string().as_bytes()).is_err(),
+            "a slot decoded with an invalid `{field}`"
+        );
+    }
+
+    // `len` and the chunk list state the SAME fact: Complete sums `len` into the published
+    // size, the read path sums the chunks it reads. A record whose halves disagree would
+    // publish an object whose declared size is not the number of bytes a reader can get.
+    let part_value = |len: u64, chunk_lens: &[u64]| {
+        json!({
+            "chunks": chunk_lens.iter().enumerate().map(|(i, l)| json!({
+                "id": i + 1, "scheme": "None", "len": l, "placement": [7]
+            })).collect::<Vec<_>>(),
+            "len": len,
+            "digest": digest_of("p").to_hex(),
+            "committed_at_millis": 1,
+            "session_epoch": 7
+        })
+    };
+    assert!(decode_part(part_value(150, &[100, 50]).to_string().as_bytes()).is_ok());
+    assert!(decode_part(part_value(151, &[100, 50]).to_string().as_bytes()).is_err());
+    assert!(decode_part(part_value(149, &[100, 50]).to_string().as_bytes()).is_err());
+    // A wrapped sum is the same defect with a forged agreement: `u64::MAX + 1 == 0`.
+    let overflow = part_value(0, &[u64::MAX, 1]);
+    let error = decode_part(overflow.to_string().as_bytes()).unwrap_err();
+    assert!(format!("{error}").contains("overflow"), "{error}");
+    // A digest that is not 64 lowercase-hex characters is not a digest.
+    for bad in [
+        json!("deadbeef"),
+        json!(digest_of("p").to_hex().to_uppercase()),
+        json!(format!("{}0", digest_of("p").to_hex())),
+    ] {
+        let mut value = part_value(150, &[100, 50]);
+        value
+            .as_object_mut()
+            .unwrap()
+            .insert("digest".to_string(), bad);
+        assert!(decode_part(value.to_string().as_bytes()).is_err());
+    }
+
+    // A summary claiming bytes under no chunks contradicts the `part:` record written beside
+    // it in one batch — and the summary is what the staged-chunk check reads INSTEAD of the
+    // part, so nothing else would re-check it.
+    let summary = |chunks: u32, len: u64| {
+        json!({
+            "chunks": chunks, "len": len,
+            "digest": digest_of("p").to_hex(), "committed_at_millis": 1
+        })
+    };
+    assert!(decode_part_summary(summary(2, 150).to_string().as_bytes()).is_ok());
+    assert!(decode_part_summary(summary(0, 0).to_string().as_bytes()).is_ok());
+    assert!(decode_part_summary(summary(0, 150).to_string().as_bytes()).is_err());
+    assert!(decode_part_summary(summary(2, 0).to_string().as_bytes()).is_err());
+    let mut bad_digest = summary(2, 150);
+    bad_digest
+        .as_object_mut()
+        .unwrap()
+        .insert("digest".to_string(), json!("deadbeef"));
+    assert!(decode_part_summary(bad_digest.to_string().as_bytes()).is_err());
+}
