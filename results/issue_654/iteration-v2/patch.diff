+#[test]
+fn a_component_outside_its_format_bound_is_refused_by_its_type() {
+    assert!(matches!(
+        PartNumber::new(0),
+        Err(RecordError::PartNumberOutOfRange { part_number: 0 })
+    ));
+    assert_eq!(
+        PartNumber::new(MAX_PART_NUMBER).unwrap().get(),
+        MAX_PART_NUMBER
+    );
+    assert!(matches!(
+        PartNumber::new(MAX_PART_NUMBER + 1),
+        Err(RecordError::PartNumberOutOfRange { .. })
+    ));
+    assert_eq!(MAX_PART_NUMBER, 99_999, "five digits address [1, 99_999]");
+
+    // Index 0 IS a slot: the key space is the cap, so it starts at zero.
+    assert_eq!(SlotIndex::new(0).unwrap().get(), 0);
+    assert_eq!(
+        SlotIndex::new(MAX_SLOT_INDEX).unwrap().get(),
+        MAX_SLOT_INDEX
+    );
+    assert!(matches!(
+        SlotIndex::new(MAX_SLOT_INDEX + 1),
+        Err(RecordError::SlotIndexOutOfRange { .. })
+    ));
+    assert_eq!(MAX_SLOT_INDEX, 999_999, "six digits address [0, 999_999]");
+
+    assert!(is_token(ID_A));
+    assert_eq!(TOKEN_HEX_LEN, 32);
+    // A validated token reports the id it validated — every per-session range is derived
+    // from this string, so a constructor that kept a different one would name another
+    // session's records.
+    assert_eq!(upload_a().as_str(), ID_A);
+    assert_eq!(upload_a().to_string(), ID_A);
+    assert_eq!(attempt().as_str(), ID_B);
+    assert_eq!(attempt().to_string(), ID_B);
+    assert_ne!(upload_a(), upload_b());
+    for not_a_token in [
+        String::new(),
+        ID_A[..31].to_string(),
+        format!("{ID_A}0"),
+        ID_A.to_uppercase(),
+        format!("{}:{}", &ID_A[..16], &ID_A[17..]),
+        format!("{}g{}", &ID_A[..16], &ID_A[17..]),
+    ] {
+        assert!(!is_token(&not_a_token), "{not_a_token:?} parsed as a token");
+        assert!(UploadId::new(not_a_token.clone()).is_err());
+        assert!(AttemptId::new(not_a_token).is_err());
+    }
+}
