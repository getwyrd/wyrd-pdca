+// ===========================================================================
+// Leg 4 — every reachable decision-3 cell, answered with a typed outcome
+// ===========================================================================
+
+fn recorded_publication() -> Publication {
+    Publication::of(
+        session(SessionState::Completed)
+            .completion
+            .as_ref()
+            .unwrap(),
+    )
+}
+
+/// The fingerprint the `Completed` fixture recorded — an identical retry names these parts.
+fn recorded_fingerprint() -> Digest {
+    complete_fingerprint(&[(part(1), digest_of("one"))]).unwrap()
+}
+
+/// The 25 cells of `0016:969-978`, spelled out. `None` is "the record is absent".
+fn decision3_table() -> Vec<(Verb, Option<SessionState>, Answer)> {
+    use SessionState::{Aborting, Completed, Completing, Open};
+    let no_such = || Refusal::NoSuchUpload;
+    vec![
+        // UploadPart — accepted only while Open; a part accepted after the fence would be
+        // invisible to the publication that already read the set.
+        (
+            Verb::UploadPart,
+            Some(Open),
+            Answer::UploadPart(UploadPartAnswer::Accepted),
+        ),
+        (
+            Verb::UploadPart,
+            Some(Completing),
+            Answer::UploadPart(UploadPartAnswer::Refused(no_such())),
+        ),
+        (
+            Verb::UploadPart,
+            Some(Aborting),
+            Answer::UploadPart(UploadPartAnswer::Refused(no_such())),
+        ),
+        (
+            Verb::UploadPart,
+            Some(Completed),
+            Answer::UploadPart(UploadPartAnswer::Refused(no_such())),
+        ),
+        (
+            Verb::UploadPart,
+            None,
+            Answer::UploadPart(UploadPartAnswer::Refused(no_such())),
+        ),
+        // Complete — fences from Open; a different fence already owns publication while
+        // Completing; the tombstone cell is conditional (both branches asserted below).
+        (
+            Verb::CompleteMultipartUpload,
+            Some(Open),
+            Answer::Complete(CompleteAnswer::Fences),
+        ),
+        (
+            Verb::CompleteMultipartUpload,
+            Some(Completing),
+            Answer::Complete(CompleteAnswer::Refused(Refusal::OperationAborted)),
+        ),
+        (
+            Verb::CompleteMultipartUpload,
+            Some(Aborting),
+            Answer::Complete(CompleteAnswer::Refused(no_such())),
+        ),
+        (
+            Verb::CompleteMultipartUpload,
+            Some(Completed),
+            Answer::Complete(CompleteAnswer::AlreadyCompleted(Box::new(
+                recorded_publication(),
+            ))),
+        ),
+        (
+            Verb::CompleteMultipartUpload,
+            None,
+            Answer::Complete(CompleteAnswer::Refused(no_such())),
+        ),
+        // Abort — the fence commit IS the response; idempotent while already Aborting.
+        (
+            Verb::AbortMultipartUpload,
+            Some(Open),
+            Answer::Abort(AbortAnswer::Fences),
+        ),
+        (
+            Verb::AbortMultipartUpload,
+            Some(Completing),
+            Answer::Abort(AbortAnswer::Refused(Refusal::OperationAborted)),
+        ),
+        (
+            Verb::AbortMultipartUpload,
+            Some(Aborting),
+            Answer::Abort(AbortAnswer::AlreadyAborting),
+        ),
+        (
+            Verb::AbortMultipartUpload,
+            Some(Completed),
+            Answer::Abort(AbortAnswer::Refused(no_such())),
+        ),
+        (
+            Verb::AbortMultipartUpload,
+            None,
+            Answer::Abort(AbortAnswer::Refused(no_such())),
+        ),
+        // ListParts — the growing set, then the frozen one, then nothing.
+        (
+            Verb::ListParts,
+            Some(Open),
+            Answer::ListParts(ListPartsAnswer::OpenSet),
+        ),
+        (
+            Verb::ListParts,
+            Some(Completing),
+            Answer::ListParts(ListPartsAnswer::FrozenSet),
+        ),
+        (
+            Verb::ListParts,
+            Some(Aborting),
+            Answer::ListParts(ListPartsAnswer::Refused(no_such())),
+        ),
+        (
+            Verb::ListParts,
+            Some(Completed),
+            Answer::ListParts(ListPartsAnswer::Refused(no_such())),
+        ),
+        (
+            Verb::ListParts,
+            None,
+            Answer::ListParts(ListPartsAnswer::Refused(no_such())),
+        ),
+        // ListMultipartUploads — in progress is listed; tearing down or torn down is not.
+        (
+            Verb::ListMultipartUploads,
+            Some(Open),
+            Answer::ListUploads(ListUploadsAnswer::Listed),
+        ),
+        (
+            Verb::ListMultipartUploads,
+            Some(Completing),
+            Answer::ListUploads(ListUploadsAnswer::Listed),
+        ),
+        (
+            Verb::ListMultipartUploads,
+            Some(Aborting),
+            Answer::ListUploads(ListUploadsAnswer::NotListed),
+        ),
+        (
+            Verb::ListMultipartUploads,
+            Some(Completed),
+            Answer::ListUploads(ListUploadsAnswer::NotListed),
+        ),
+        (
+            Verb::ListMultipartUploads,
+            None,
+            Answer::ListUploads(ListUploadsAnswer::NotListed),
+        ),
+    ]
+}
