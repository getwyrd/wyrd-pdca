+#[test]
+fn an_owned_staging_entry_is_not_reachable_from_a_pending_scan() {
+    // The disjointness of `sidx:` from `pending:` is the ONLY thing keeping the global
+    // expiry sweep and the restore pass from reaping live owned staging entries
+    // (`0016:475-491`), and it is what lets restore keep today's `pending:` bound.
+    let owned = sidx_key(&upload_a(), part(1), 42);
+    assert!(!owned.starts_with(b"pending:"));
+    assert!(!metadata::pending_key(42).starts_with(SIDX_PREFIX));
+    // Nor does one session's range reach another's.
+    assert!(!owned.starts_with(&sidx_range(&upload_b())));
+    assert!(owned.starts_with(&sidx_range(&upload_a())));
