+#[test]
+fn a_tombstone_answers_an_identical_retry_and_only_an_identical_retry() {
+    // The cell 0016 spends most words on. A client that reuses the upload id with a
+    // DIFFERENT part list must not be told ITS assembly succeeded while the store holds the
+    // earlier one — a silent wrong answer, worse than any error (`0016:898-908`).
+    let tombstone = session(SessionState::Completed);
+    let recorded = recorded_fingerprint();
+
+    match complete_answer(Some(&tombstone), &recorded) {
+        CompleteAnswer::AlreadyCompleted(publication) => {
+            assert_eq!(*publication, recorded_publication());
+            assert_eq!(
+                publication.etag,
+                multipart_etag(&[(part(1), digest_of("one"))]).unwrap(),
+                "the retry is answered with the RECORDED etag"
+            );
+        }
+        other => panic!("an identical retry was answered {other:?}"),
+    }
+
+    // A different assembly under the same id: a different digest ...
+    let different_body = complete_fingerprint(&[(part(1), digest_of("two"))]).unwrap();
+    assert_eq!(
+        complete_answer(Some(&tombstone), &different_body),
+        CompleteAnswer::Refused(Refusal::NoSuchUpload)
+    );
+    // ... and the same digest under a different part number.
+    let different_numbering = complete_fingerprint(&[(part(2), digest_of("one"))]).unwrap();
+    assert_eq!(
+        complete_answer(Some(&tombstone), &different_numbering),
+        CompleteAnswer::Refused(Refusal::NoSuchUpload)
+    );
+    // ... and one more part than the recorded assembly named.
+    let superset =
+        complete_fingerprint(&[(part(1), digest_of("one")), (part(2), digest_of("two"))]).unwrap();
+    assert_eq!(
+        complete_answer(Some(&tombstone), &superset),
+        CompleteAnswer::Refused(Refusal::NoSuchUpload)
+    );
+    // The union entry point routes the same condition.
+    assert_eq!(
+        answer(
+            Verb::CompleteMultipartUpload,
+            Some(&tombstone),
+            Some(&different_body)
+        ),
+        Answer::Complete(CompleteAnswer::Refused(Refusal::NoSuchUpload))
+    );
+    // A Complete that named no parts at all cannot match any recorded fingerprint.
+    assert_eq!(
+        answer(Verb::CompleteMultipartUpload, Some(&tombstone), None),
+        Answer::Complete(CompleteAnswer::Refused(Refusal::NoSuchUpload))
+    );
+    assert_eq!(
+        answer(
+            Verb::CompleteMultipartUpload,
+            Some(&session(SessionState::Open)),
+            None
+        ),
+        Answer::Complete(CompleteAnswer::Fences)
+    );
+    assert_eq!(
+        answer(
+            Verb::CompleteMultipartUpload,
+            Some(&session(SessionState::Completing)),
+            None
+        ),
+        Answer::Complete(CompleteAnswer::Refused(Refusal::OperationAborted))
+    );
+    assert_eq!(
+        answer(Verb::CompleteMultipartUpload, None, None),
+        Answer::Complete(CompleteAnswer::Refused(Refusal::NoSuchUpload))
+    );
+}
