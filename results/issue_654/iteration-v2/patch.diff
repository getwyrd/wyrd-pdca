+/// quoted literally because `core` must not depend on `custodian` (ADR-0010's direction).
+fn all_prefixes() -> Vec<(&'static str, Vec<u8>)> {
+    vec![
+        ("mpuctl", MPUCTL_KEY.to_vec()),
+        ("mpu:", MPU_PREFIX.to_vec()),
+        ("slot:", SLOT_PREFIX.to_vec()),
+        ("part:", PART_PREFIX.to_vec()),
+        ("psum:", PSUM_PREFIX.to_vec()),
+        ("sidx:", SIDX_PREFIX.to_vec()),
+        ("retire:bytes:", RETIRE_BYTES_PREFIX.to_vec()),
+        ("retire:records:", RETIRE_RECORDS_PREFIX.to_vec()),
+        ("inode:", b"inode:".to_vec()),
+        ("dirent:", b"dirent:".to_vec()),
+        ("pending:", b"pending:".to_vec()),
+        ("bucket:", b"bucket:".to_vec()),
+        ("orphan:", metadata::ORPHAN_PREFIX.to_vec()),
+        ("seg:", metadata::SEG_PREFIX.to_vec()),
+        ("seggrp:", metadata::SEGGRP_PREFIX.to_vec()),
+        ("desired:dserver:", b"desired:dserver:".to_vec()),
+        ("meta:version", metadata::VERSION_KEY.to_vec()),
+    ]
