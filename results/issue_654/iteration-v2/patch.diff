+
+fn budget() -> Budget {
+    // A legal, deliberately small profile: `U_ref = min((4+2)*3, 8+2*2*3) = min(18, 20) = 18`.
+    Budget::new(1_800, 3, 4, 2, 8).unwrap()
+}
+
+fn session(state: SessionState) -> SessionRecord {
+    let epoch = 7;
+    SessionRecord {
+        bucket: "bucket".to_string(),
+        parent: 1,
+        object: "object".to_string(),
+        content_type: Some("text/plain".to_string()),
+        created_at_millis: 1_000,
+        clock_source: "logical".to_string(),
+        state,
+        epoch,
+        attempts: 1,
+        group_nonce: metadata::SegmentNonce::new(NONCE).unwrap(),
+        fenced_at_millis: matches!(state, SessionState::Completing).then_some(2_000),
+        segments_written: matches!(state, SessionState::Completing).then_some(3),
+        publish_target: matches!(state, SessionState::Completing).then(|| PublishTarget {
+            parent: 1,
+            name: "object".to_string(),
+            fence_epoch: epoch,
+        }),
+        completion: matches!(state, SessionState::Completed).then(|| Completion {
+            inode: 5,
+            version: 2,
+            etag: multipart_etag(&[(part(1), digest_of("one"))]).unwrap(),
+            completed_at_millis: 4_000,
+            complete_fingerprint: complete_fingerprint(&[(part(1), digest_of("one"))]).unwrap(),
+        }),
+    }
+}
+
+fn owned_entry() -> OwnedEntry {
+    OwnedEntry {
+        owner: upload_a(),
+        lease_expiry_millis: 500,
+        staged: StagedPlacement {
+            scheme: EcScheme::ReedSolomon { k: 4, m: 2 },
+            placement: vec![1, 2, 3, 4, 5, 6],
+        },
+    }
+}
+
+fn round_trips<T>(record: &T) -> T
+where
+    T: serde::Serialize + serde::de::DeserializeOwned + PartialEq + std::fmt::Debug,
+{
+    let bytes = encode_record(record);
+    let decoded: T = serde_json::from_slice(&bytes).expect("a record this crate encoded decodes");
+    assert_eq!(&decoded, record, "encode -> decode is not the identity");
+    assert_eq!(
+        encode_record(&decoded),
+        bytes,
+        "decode -> encode is not byte-identical"
+    );
+    decoded
+}
