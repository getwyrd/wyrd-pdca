+#[test]
+fn a_session_value_its_state_forbids_is_rejected_at_decode() {
+    let completing = encode_record(&session(SessionState::Completing));
+    let mut value: serde_json::Value = serde_json::from_slice(&completing).unwrap();
+
+    // Every `Completing`-only field is REQUIRED there ...
+    for field in ["fenced_at_millis", "segments_written", "publish_target"] {
+        let mut missing = value.clone();
+        missing.as_object_mut().unwrap().remove(field);
+        let error = decode_session(missing.to_string().as_bytes()).unwrap_err();
+        assert!(
+            format!("{error}").contains(field),
+            "a Completing session decoded without `{field}`: {error}"
+        );
+    }
+    // ... and FORBIDDEN on an Open one: half of a state's meaning is in its fields.
+    for field in ["fenced_at_millis", "segments_written", "publish_target"] {
+        let mut open: serde_json::Value =
+            serde_json::from_slice(&encode_record(&session(SessionState::Open))).unwrap();
+        open.as_object_mut()
+            .unwrap()
+            .insert(field.to_string(), value[field].clone());
+        assert!(
+            decode_session(open.to_string().as_bytes()).is_err(),
+            "an Open session decoded carrying the Completing-only `{field}`"
+        );
+    }
+    // A `Completed` session must carry its completion; an `Open` one must not.
+    let mut completed: serde_json::Value =
+        serde_json::from_slice(&encode_record(&session(SessionState::Completed))).unwrap();
+    let completion = completed["completion"].clone();
+    completed.as_object_mut().unwrap().remove("completion");
+    assert!(decode_session(completed.to_string().as_bytes()).is_err());
+    let mut open: serde_json::Value =
+        serde_json::from_slice(&encode_record(&session(SessionState::Open))).unwrap();
+    open.as_object_mut()
+        .unwrap()
+        .insert("completion".to_string(), completion);
+    assert!(decode_session(open.to_string().as_bytes()).is_err());
+
+    // The fence epoch in `publish_target` IS the session's own epoch: the attempt's `seg:`
+    // records are keyed by it, so a mismatch would resume a completer against another
+    // attempt's segment generation.
+    value["publish_target"]["fence_epoch"] = json!(6);
+    let error = decode_session(value.to_string().as_bytes()).unwrap_err();
+    assert!(format!("{error}").contains("fence epoch"), "{error}");
+
+    // A structurally impossible identity is refused, not carried.
+    for (field, bad) in [
+        ("group_nonce", json!("not-a-nonce")),
+        ("group_nonce", json!(NONCE.to_uppercase())),
+        ("clock_source", json!("")),
+        ("bucket", json!("")),
+        ("object", json!("")),
+    ] {
+        let mut open: serde_json::Value =
+            serde_json::from_slice(&encode_record(&session(SessionState::Open))).unwrap();
+        open.as_object_mut().unwrap().insert(field.to_string(), bad);
+        assert!(
+            decode_session(open.to_string().as_bytes()).is_err(),
+            "a session decoded with an invalid `{field}`"
+        );
+    }
+
+    // A completion carries a well-formed ETag and fingerprint or it is not a completion.
+    for (field, bad) in [
+        ("etag", json!("deadbeef-1")),
+        ("etag", json!(digest_of("x").to_hex())),
+        ("complete_fingerprint", json!("deadbeef")),
+    ] {
+        let mut tombstone: serde_json::Value =
+            serde_json::from_slice(&encode_record(&session(SessionState::Completed))).unwrap();
+        tombstone["completion"]
+            .as_object_mut()
+            .unwrap()
+            .insert(field.to_string(), bad);
+        assert!(
+            decode_session(tombstone.to_string().as_bytes()).is_err(),
+            "a tombstone decoded with an invalid `{field}`"
+        );
+    }
+}
