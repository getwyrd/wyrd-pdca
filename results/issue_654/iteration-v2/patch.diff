+#[test]
+fn the_answers_are_typed_outcomes_the_later_slices_share() {
+    // The vocabulary #656-#659 answer with: every refusal is a value, never "an error" and
+    // never an HTTP status (the S3 mapping is #508's).
+    let refusal = Refusal::SlowDown {
+        pressure: multipart::Backpressure::SessionCap {
+            count: 100,
+            max_sessions: 100,
+        },
+    };
+    assert_eq!(
+        multipart::CreateOutcome::Refused(refusal.clone()),
+        multipart::CreateOutcome::Refused(refusal.clone())
+    );
+    assert_ne!(
+        multipart::CreateOutcome::Refused(refusal),
+        multipart::CreateOutcome::Created {
+            upload_id: upload_a()
+        }
+    );
+    assert_ne!(
+        multipart::ReserveOutcome::Reserved {
+            index: SlotIndex::new(0).unwrap(),
+            attempt_id: attempt(),
+        },
+        multipart::ReserveOutcome::Refused(Refusal::SlowDown {
+            pressure: multipart::Backpressure::InflightParts {
+                max_inflight_parts: 2
+            }
+        })
+    );
+    assert_ne!(
+        multipart::UploadPartOutcome::Committed {
+            part_number: part(1),
+            digest: digest_of("one"),
+        },
+        multipart::UploadPartOutcome::Refused(Refusal::InvalidPart {
+            part_number: part(1),
+            reason: multipart::InvalidPart::DigestMismatch,
+        })
+    );
+    let publication = Box::new(recorded_publication());
+    assert_ne!(
+        multipart::CompleteOutcome::Published(publication.clone()),
+        multipart::CompleteOutcome::AlreadyCompleted(publication)
+    );
+    assert_ne!(
+        multipart::AbortOutcome::Fenced,
+        multipart::AbortOutcome::AlreadyAborting
+    );
+    // A profile skew is a fail-closed refusal carrying BOTH tuples, so an operator can see
+    // which host disagrees with the ledger.
+    assert_ne!(
+        Refusal::ProfileSkew {
+            local: Box::new(budget()),
+            ledger: Box::new(Budget::new(1_800, 3, 400, 2, 8).unwrap()),
+        },
+        Refusal::ProfileSkew {
+            local: Box::new(budget()),
+            ledger: Box::new(budget()),
+        }
+    );
+    assert_ne!(
+        Refusal::EntityTooLarge {
+            chunks: 10,
+            limit: 9
+        },
+        Refusal::CompleteAttemptsExhausted
+    );
+    assert_ne!(Refusal::NoSuchBucket, Refusal::NoSuchUpload);
+}
+
+// ===========================================================================
+// Leg 5 — `multipart_etag`, proved against an independent oracle
+// ===========================================================================
+
+/// The oracle, computed here from the spec text rather than from the implementation:
+/// `lowercase_hex( SHA-256( d_1 || d_2 || ... || d_N ) ) + "-" + N`, over the RAW 32 digest
+/// bytes in ascending part-number order.
+fn etag_oracle(mut named: Vec<(u32, Digest)>) -> String {
+    named.sort_by_key(|(number, _)| *number);
+    let mut hasher = Sha256::new();
+    for (_, digest) in &named {
+        hasher.update(digest.as_bytes());
+    }
+    let composed: [u8; 32] = hasher.finalize().into();
+    format!("{}-{}", hex_lower(&composed), named.len())
+}
+
+#[test]
+fn the_multipart_etag_is_the_settled_composition() {
+    let one = digest_of("one");
+    let two = digest_of("two");
+    let three = digest_of("three");
+
+    // N = 1.
+    assert_eq!(
+        multipart_etag(&[(part(1), one)]).unwrap().to_string(),
+        etag_oracle(vec![(1, one)])
+    );
+
+    // N = 3, and the `-N` suffix is the NAMED count.
+    let named = vec![(part(1), one), (part(2), two), (part(7), three)];
+    let etag = multipart_etag(&named).unwrap();
+    assert_eq!(
+        etag.to_string(),
+        etag_oracle(vec![(1, one), (2, two), (7, three)])
+    );
+    assert_eq!(etag.parts(), 3);
+    assert!(etag.to_string().ends_with("-3"));
+
+    // Ascending part-number order is enforced HERE, not delegated to the caller: the same
+    // assembly listed in any order publishes the same object.
+    let shuffled = vec![(part(7), three), (part(1), one), (part(2), two)];
+    assert_ne!(shuffled, named, "the shuffled case must actually reorder");
+    assert_eq!(multipart_etag(&shuffled).unwrap(), etag);
+    // ... and it really is ASCENDING order, not "whatever the caller handed us": the
+    // descending concatenation of the same digests is a different value.
+    let mut descending = Sha256::new();
+    for digest in [three, two, one] {
+        descending.update(digest.as_bytes());
+    }
+    let descending: [u8; 32] = descending.finalize().into();
+    assert_ne!(
+        etag.to_string(),
+        format!("{}-3", hex_lower(&descending)),
+        "the composition is not order-sensitive at all"
+    );
+
+    // A STRICT SUBSET of the staged parts is a different object.
+    let subset = multipart_etag(&[(part(1), one), (part(2), two)]).unwrap();
+    assert_ne!(subset, etag);
+    assert_eq!(subset.parts(), 2);
+
+    // HEX TEXT concatenation is a different value from RAW BYTE concatenation, so a
+    // hex-vs-raw slip cannot pass this leg.
+    let mut hex_hasher = Sha256::new();
+    for digest in [one, two, three] {
+        hex_hasher.update(digest.to_hex().as_bytes());
+    }
+    let hex_composed: [u8; 32] = hex_hasher.finalize().into();
+    assert_ne!(
+        etag.to_string(),
+        format!("{}-3", hex_lower(&hex_composed)),
+        "the ETag concatenates hex TEXT, not the raw digest bytes"
+    );
+
+    // Part numbers are NOT mixed into the ETag — that is the fingerprint's job — so the same
+    // bodies under different numbers give the same ETag ...
+    let renumbered = multipart_etag(&[(part(3), one), (part(4), two), (part(9), three)]).unwrap();
+    assert_eq!(renumbered, etag);
+    // ... which is exactly why Complete's idempotence is keyed on the fingerprint (leg 6).
+
+    // An assembly of nothing, or one naming a part twice, is an error rather than an ETag
+    // that depends on which duplicate survived.
+    assert!(matches!(
+        multipart_etag(&[]),
+        Err(RecordError::NoPartsNamed)
+    ));
+    assert!(matches!(
+        multipart_etag(&[(part(1), one), (part(1), two)]),
+        Err(RecordError::DuplicatePart { part_number: 1 })
+    ));
+}
+
+#[test]
+fn a_composed_etag_parses_back_and_a_malformed_one_does_not() {
+    let etag = multipart_etag(&[(part(1), digest_of("one")), (part(2), digest_of("two"))]).unwrap();
+    let text = etag.to_string();
+    assert_eq!(MultipartEtag::parse(&text).unwrap(), etag);
+    assert_eq!(MultipartEtag::parse(&text).unwrap().parts(), 2);
+    assert_eq!(
+        MultipartEtag::parse(&text).unwrap().composed().to_hex(),
+        text.split('-').next().unwrap()
+    );
+    for bad in [
+        String::new(),
+        "deadbeef-1".to_string(),
+        format!("{}-0", digest_of("x").to_hex()),
+        format!("{}-01", digest_of("x").to_hex()),
+        format!("{}-+1", digest_of("x").to_hex()),
+        digest_of("x").to_hex(),
+        format!("{}-x", digest_of("x").to_hex()),
+        digest_of("x").to_hex().to_uppercase(),
+    ] {
+        assert!(
+            MultipartEtag::parse(&bad).is_err(),
+            "the malformed etag {bad:?} parsed"
+        );
+    }
+}
+
+#[test]
+fn a_digest_is_exactly_64_lowercase_hex_characters() {
+    // `Digest` is what makes "the raw 32 bytes" a type rather than a convention, so these
+    // rejections are what keep a short or uppercase digest out of every composition.
+    let digest =
+        Digest::from_hex("1f00ff0102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d")
+            .unwrap();
+    assert_eq!(digest.as_bytes()[0], 0x1f, "hi*16 + lo, not hi + lo");
+    assert_eq!(digest.as_bytes()[1], 0x00);
+    assert_eq!(digest.as_bytes()[2], 0xff);
+    assert_eq!(digest.as_bytes()[3], 0x01);
+    assert_eq!(
+        digest.to_hex(),
+        "1f00ff0102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d"
+    );
+    assert_eq!(hex_lower(&[0x00, 0x0f, 0xf0, 0xff]), "000ff0ff");
+    assert_eq!(Digest::from_bytes(*digest.as_bytes()), digest);
+
+    let sixty_four = digest.to_hex();
+    for bad in [
+        String::new(),
+        sixty_four[..63].to_string(),
+        format!("{sixty_four}0"),
+        sixty_four.to_uppercase(),
+        format!("{}Ff{}", &sixty_four[..2], &sixty_four[4..]),
+        format!("{}g0{}", &sixty_four[..2], &sixty_four[4..]),
+        format!("{}0g{}", &sixty_four[..2], &sixty_four[4..]),
+        format!("{} 0{}", &sixty_four[..2], &sixty_four[4..]),
+    ] {
+        assert!(
+            Digest::from_hex(&bad).is_err(),
+            "{bad:?} parsed as a SHA-256 digest"
+        );
+    }
+    // The digest of known content is SHA-256's, not some other function's (FIPS-180-4's
+    // published `abc` vector).
+    assert_eq!(
+        Digest::of(b"abc").to_hex(),
+        "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"
+    );
+}
+
+// ===========================================================================
+// Leg 6 — `complete_fingerprint` tells an identical retry from a different assembly
+// ===========================================================================
+
+/// The oracle: the pair count, then each `(part_number, digest)` in ascending part-number
+/// order, both fixed width.
+fn fingerprint_oracle(mut named: Vec<(u32, Digest)>) -> Digest {
+    named.sort_by_key(|(number, _)| *number);
+    let mut hasher = Sha256::new();
+    hasher.update((named.len() as u64).to_be_bytes());
+    for (number, digest) in &named {
+        hasher.update(number.to_be_bytes());
+        hasher.update(digest.as_bytes());
+    }
+    Digest::from_bytes(hasher.finalize().into())
+}
+
+#[test]
+fn the_complete_fingerprint_distinguishes_a_retry_from_a_different_assembly() {
+    let one = digest_of("one");
+    let two = digest_of("two");
+    let three = digest_of("three");
+    let named = vec![(part(1), one), (part(2), two), (part(3), three)];
+
+    // It is the settled function, not merely self-consistent.
+    let fingerprint = complete_fingerprint(&named).unwrap();
+    assert_eq!(
+        fingerprint,
+        fingerprint_oracle(vec![(1, one), (2, two), (3, three)])
+    );
+
+    // Identical lists agree.
+    assert_eq!(complete_fingerprint(&named).unwrap(), fingerprint);
+
+    // One digest changed disagrees — this is what stops a client being told its assembly
+    // succeeded while the store holds an earlier one.
+    let changed = vec![
+        (part(1), one),
+        (part(2), digest_of("two-prime")),
+        (part(3), three),
+    ];
+    assert_ne!(complete_fingerprint(&changed).unwrap(), fingerprint);
+
+    // The SAME digests under DIFFERENT part numbers disagree: the numbers are mixed in,
+    // which is exactly what the ETag does not do (leg 5). This pair is the whole reason the
+    // fingerprint exists — the two assemblies are indistinguishable to the ETag, so a
+    // tombstone keyed on the ETag would answer the second one with the first one's success.
+    let renumbered = vec![(part(1), one), (part(2), two), (part(4), three)];
+    assert_ne!(complete_fingerprint(&renumbered).unwrap(), fingerprint);
+    assert_eq!(
+        multipart_etag(&renumbered).unwrap(),
+        multipart_etag(&named).unwrap(),
+        "the renumbering is invisible to the ETag, which is why the fingerprint exists"
+    );
+    // Swapping which digest belongs to which part number is a different assembly too.
+    let swapped = vec![(part(1), two), (part(2), one), (part(3), three)];
+    assert_ne!(complete_fingerprint(&swapped).unwrap(), fingerprint);
+
+    // A REORDERED list of the same pairs agrees, because the canonical order is pinned:
+    // part-number ASCENDING, applied inside the function. A client that lists its parts in a
+    // different order is retrying the same assembly and must get the same answer.
+    let reordered = vec![(part(3), three), (part(1), one), (part(2), two)];
+    assert_ne!(
+        reordered, named,
+        "the reordered case must actually reorder the input"
+    );
+    assert_eq!(complete_fingerprint(&reordered).unwrap(), fingerprint);
+    // And ascending really is the canonical order: hashing the caller's descending order
+    // would give a different value.
+    let mut descending = Sha256::new();
+    descending.update(3u64.to_be_bytes());
+    for (number, digest) in [(3u32, three), (2, two), (1, one)] {
+        descending.update(number.to_be_bytes());
+        descending.update(digest.as_bytes());
+    }
+    assert_ne!(
+        Digest::from_bytes(descending.finalize().into()),
+        fingerprint,
+        "the encoding is not order-sensitive at all"
+    );
+
+    // A strict subset disagrees.
+    let subset = vec![(part(1), one), (part(2), two)];
+    assert_ne!(complete_fingerprint(&subset).unwrap(), fingerprint);
+
+    // An empty list, or one naming a part twice, is an error rather than a fingerprint.
+    assert!(matches!(
+        complete_fingerprint(&[]),
+        Err(RecordError::NoPartsNamed)
+    ));
+    assert!(matches!(
+        complete_fingerprint(&[(part(1), one), (part(1), two)]),
+        Err(RecordError::DuplicatePart { part_number: 1 })
+    ));
+}
+
+#[test]
+fn the_fingerprint_and_the_etag_are_different_functions_of_the_same_input() {
+    // They must not be interchangeable: the ETag ignores part numbers (so two numberings of
+    // the same bodies collide in it) and the fingerprint does not. Storing one where the
+    // other belongs would make a tombstone answer a different assembly with success.
+    let named = vec![(part(1), digest_of("one")), (part(2), digest_of("two"))];
+    let etag = multipart_etag(&named).unwrap();
+    let fingerprint = complete_fingerprint(&named).unwrap();
+    assert_ne!(etag.composed(), fingerprint);
+    assert_ne!(etag.to_string(), fingerprint.to_hex());
+}
