+fn every_verb_x_state_cell_is_answered_with_its_typed_outcome() {
+    for (verb, state, expected) in decision3_table() {
+        let record = state.map(session);
+        let got = answer(verb, record.as_ref(), Some(&recorded_fingerprint()));
+        assert_eq!(got, expected, "decision 3 cell ({verb:?}, {state:?})");
