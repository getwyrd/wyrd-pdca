+#[test]
+fn no_record_prefix_is_a_prefix_of_another() {
+    let prefixes = all_prefixes();
+    assert_eq!(prefixes.len(), 17);
+    for (name, prefix) in &prefixes {
+        for (other_name, other) in &prefixes {
+            if name == other_name {
+                continue;
+            }
+            assert!(
+                !prefix.starts_with(other),
+                "scan({other_name:?}) would return {name:?} records"
+            );
+        }
+    }
+}
