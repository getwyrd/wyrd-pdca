+//! The **multipart commit protocol**'s record family and state machine — the pure
+//! vocabulary underneath `CompleteMultipartUpload` (proposal 0016,
+//! `docs/design/proposals/draft/0016-multipart-commit-protocol.md`).
+//!
+//! This is slice 1 of 7 of issue #636's re-split (issue #654). It is deliberately **pure**:
+//! no [`wyrd_traits::MetadataStore`] call, no `WriteBatch`, no `async fn`. After this module
+//! a reader can name every record the protocol writes (`0016` §1, `:333-527`), parse every
+//! key it uses, decide what any verb answers in any state (`0016` decision 3, `:894-1037`),
+//! and compute an object's multipart ETag (`0016:3064-3070`) — all without a store. The
+//! store round trips (admission, staging, Complete, retirement) are five later, separately
+//! reviewed slices (#656-#660); the S3 verbs/XML/status mapping is #508's.
+//!
+//! # The records (`0016` §1)
+//!
+//! | Key | What it is |
+//! |---|---|
+//! | `mpuctl` | the fleet **admission ledger** — `{count, max_sessions, profile}`, CAS'd whole |
+//! | `mpu:<id>` | one **session**: target, state, epoch, attempts, publication |
+//! | `slot:<id>:<k>` | one **in-flight part slot**; the key space *is* the per-session cap |
+//! | `part:<id>:<n>` | a **committed part**: its chunk list, length and digest |
+//! | `psum:<id>:<n>` | that part's **summary** (no chunk list) |
+//! | `sidx:<id>:<n>:<chunk>` | one **owned staging entry** — a [`crate::metadata::PendingEntry`] with `owner` **and** `staged`, under a prefix **disjoint from `pending:`** |
+//! | `retire:bytes:<token>` | a **retirement obligation**: bytes to orphan-mark, then the naming records to delete |
+//! | `retire:records:<token>` | records to delete whose bytes something else protects |
+//!
+//! Every prefix here is disjoint from every other and from `inode:` / `dirent:` / `pending:`
+//! / `bucket:` / `orphan:` / `seg:` / `seggrp:` / `desired:dserver:`, and none is a prefix of
+//! another, so no `scan` returns a neighbour's records (`0016:333-356`).
+//!
+//! # Structural validity is a type, not a convention (ADR-0045)
+//!
+//! Every component a key or a record is built from arrives here as a **validated type** —
+//! [`UploadId`], [`AttemptId`], [`PartNumber`], [`SlotIndex`], [`Digest`] — mirroring
+//! [`crate::metadata::SegmentNonce`], whose doc records why (`metadata.rs:714-733`): parsing
+//! the rule into the type is what makes an unvalidated value *unrepresentable* rather than
+//! merely unlikely. Two consequences this module leans on:
+//!
+//! * every key constructor is **total and infallible** — it cannot mint a key its own parser
+//!   would reject, the property `seg_key` states at `metadata.rs:1219-1233`;
+//! * `parse(key(x)) == x` for every keyed record class, and a **non-canonical** spelling of
+//!   the same record (`slot:<id>:7`, `slot:<id>:0000007`, `slot:<id>:+7`) parses as **no**
+//!   record at all. Two spellings of one record would defeat a `require_absent` guard and
+//!   hide a record from a bounded range scan — residue nothing enumerates and therefore
+//!   nothing reclaims (C-1, `docs/principles.md:109`,`:137`).
+//!
+//! # What this slice does NOT define (§ Scope boundaries, settled at Plan)
+//!
+//! * **Capacity knobs.** [`Budget`] is the profile **tuple's shape** and its two pure
+//!   derivations ([`Budget::u_ref`], [`Budget::max_sessions`]); the deployment's concrete
+//!   values (`W_ref`, `MAX_PART_CHUNKS`, …) are #655's, mirroring the format/capacity split
+//!   `SEG_INDEX_WIDTH`/`MAX_SEGMENT_INDEX` vs `MAX_ROOT_SEGMENTS` already draws in
+//!   [`crate::metadata`] (`metadata.rs:270-322`).
+//! * **Capacity enforcement at decode.** A record past a *capacity* ceiling (as opposed to
+//!   past its *format*'s addressable key space) still decodes — decoding enforces only the
+//!   compile-time format bound, never a live knob, mirroring `MAX_ROOT_SEGMENTS`'s NOT being
+//!   a decode invariant (`metadata.rs:305-318`; `0016:390-402`). A `part:` record with more
+//!   chunks than a future `MAX_PART_CHUNKS` decodes; the cap is enforced where the work is
+//!   admitted.
+//! * **Every store round trip.** Admission, staging, Complete, retirement drain, terminal
+//!   delete: #656-#659. This module hands back typed values; it never reaches for a store.
+//!
+//! `sha2` is added to `crates/core` for [`multipart_etag`] / [`complete_fingerprint`]. It is
+//! not a new dependency decision: `sha2 = "0.11"` is already a workspace dependency
+//! (`Cargo.toml:147`), already used by `gateway-s3`/`server`, and already inside the
+//! `deny.toml` allowlist — so ADR-0003's three-test audit is not re-opened.
+
+use std::collections::BTreeMap;
+use std::fmt;
+
+use serde::de::Error as DeError;
+use serde::{Deserialize, Deserializer, Serialize};
+use sha2::{Digest as _, Sha256};
+use wyrd_traits::{ChunkId, DServerId};
+
+use crate::metadata::{self, ChunkRef, EcScheme, InodeId, PendingEntry, SegmentGroup};
+
+// ===========================================================================
+// 1. Errors — every structural violation is a typed error, never a value
+//    (ADR-0045; `0016:390-414`)
+// ===========================================================================
+
+/// A structural violation of a multipart key or record — never a silently-corrected
+/// default (ADR-0045, parse-don't-validate; `0016:390-414`).
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum RecordError {
+    /// A key whose prefix, field count or field syntax does not parse — including a key
+    /// whose bytes are not UTF-8, a truncated key and one with a trailing component.
+    MalformedKey {
+        /// The namespace expected.
+        namespace: &'static str,
+        /// The key as UTF-8 (lossy), for the operator signal.
+        key: String,
+    },
+    /// A token component (upload id, attempt id) that is not exactly [`TOKEN_HEX_LEN`]
+    /// lowercase-hex characters.
+    TokenNotHex {
+        /// The rejected token.
+        token: String,
+    },
+    /// A part number outside `[1, MAX_PART_NUMBER]` — the **format** bound the fixed-width
+    /// key grammar can spell, never a live capacity knob.
+    PartNumberOutOfRange {
+        /// The number found.
+        part_number: u64,
+    },
+    /// A slot index outside `[0, MAX_SLOT_INDEX]` — the **format** bound.
+    SlotIndexOutOfRange {
+        /// The index found.
+        index: u64,
+    },
+    /// A `retire:` key whose mode component is neither `bytes` nor `records`
+    /// (`0016:434-440`).
+    UnknownRetireMode {
+        /// The mode as read.
+        mode: String,
+    },
+    /// A digest that is not 64 **lowercase**-hex characters (a SHA-256, ADR-0047).
+    DigestNotHex {
+        /// The rejected text.
+        digest: String,
+    },
+    /// A named-part list that names one part number twice — an assembly no Complete can
+    /// mean, and one whose ETag would otherwise depend on which duplicate a sort kept.
+    DuplicatePart {
+        /// The number named twice.
+        part_number: u32,
+    },
+    /// A named-part list with no parts: an object assembled from nothing.
+    NoPartsNamed,
+    /// A record whose fields contradict each other or the state they claim.
+    Structural {
+        /// The record class.
+        record: &'static str,
+        /// What was wrong.
+        reason: String,
+    },
+}
+
+impl fmt::Display for RecordError {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            Self::MalformedKey { namespace, key } => write!(f, "malformed {namespace} key {key:?}"),
+            Self::TokenNotHex { token } => write!(
+                f,
+                "{token:?} is not {TOKEN_HEX_LEN} lowercase-hex characters (a 128-bit token)"
+            ),
+            Self::PartNumberOutOfRange { part_number } => write!(
+                f,
+                "part number {part_number} is outside the format bound [1, {MAX_PART_NUMBER}]"
+            ),
+            Self::SlotIndexOutOfRange { index } => write!(
+                f,
+                "slot index {index} is outside the format bound [0, {MAX_SLOT_INDEX}]"
+            ),
+            Self::UnknownRetireMode { mode } => write!(
+                f,
+                "retire: key mode {mode:?} is neither `bytes` nor `records`"
+            ),
+            Self::DigestNotHex { digest } => write!(
+                f,
+                "{digest:?} is not 64 lowercase-hex characters (a SHA-256 digest)"
+            ),
+            Self::DuplicatePart { part_number } => {
+                write!(f, "part number {part_number} is named twice")
+            }
+            Self::NoPartsNamed => write!(f, "the named-part list is empty"),
+            Self::Structural { record, reason } => write!(f, "invalid {record} record: {reason}"),
+        }
+    }
+}
+
+impl std::error::Error for RecordError {}
+
+fn malformed_key(namespace: &'static str, key: &[u8]) -> RecordError {
+    RecordError::MalformedKey {
+        namespace,
+        key: String::from_utf8_lossy(key).into_owned(),
+    }
+}
+
+fn structural(record: &'static str, reason: impl Into<String>) -> RecordError {
+    RecordError::Structural {
+        record,
+        reason: reason.into(),
+    }
+}
+
+/// Decode one record class's stored JSON, turning a serde failure — including every
+/// validating-decode rejection below — into a typed [`RecordError`].
+fn decode_record<T: serde::de::DeserializeOwned>(
+    record: &'static str,
+    bytes: &[u8],
+) -> Result<T, RecordError> {
+    serde_json::from_slice(bytes).map_err(|error| structural(record, error.to_string()))
+}
+
+/// Encode a multipart record to its stored bytes, the same infallible JSON encoding every
+/// record in [`crate::metadata`] uses (`metadata.rs:1534-1540`).
+pub fn encode_record<T: Serialize>(record: &T) -> Vec<u8> {
+    serde_json::to_vec(record).expect("multipart record serialization is infallible")
+}
+
+// ===========================================================================
+// 2. The validated components every key and record is built from
+// ===========================================================================
+
+/// A 128-bit token's canonical textual length: 32 lowercase-hex characters
+/// (`0016:493-497`). Taken from [`crate::metadata::SEG_NONCE_HEX_LEN`] rather than
+/// restated, since an upload id, an attempt id and a segment-group nonce are the same
+/// 128-bit-token shape minted the same way.
+pub const TOKEN_HEX_LEN: usize = metadata::SEG_NONCE_HEX_LEN;
+
+/// Whether `token` is a well-formed 128-bit token: exactly [`TOKEN_HEX_LEN`] lowercase-hex
+/// characters (`0016:493-497`). Rejects an empty string, a short or long token, uppercase
+/// hex, and — because `:` is never a hex digit — a token that embeds the key separator.
+pub fn is_token(token: &str) -> bool {
+    token.len() == TOKEN_HEX_LEN
+        && token
+            .bytes()
+            .all(|b| b.is_ascii_digit() || (b'a'..=b'f').contains(&b))
+}
+
+fn require_token(token: String) -> Result<String, RecordError> {
+    if is_token(&token) {
+        Ok(token)
+    } else {
+        Err(RecordError::TokenNotHex { token })
+    }
+}
+
+/// An **upload id**: the 128-bit token a gateway mints for one session, rendered as 32
+/// lowercase hex characters (`0016:493-497`).
+///
+/// A validated type rather than a `String` for the reason
+/// [`crate::metadata::SegmentNonce`] is (`metadata.rs:714-733`): it is the component every
+/// per-session **range** is derived from (`slot:<id>:`, `part:<id>:`, `sidx:<id>:`), so an
+/// id carrying the key separator would name another session's live range, and an empty one
+/// would name every session's.
+#[derive(Debug, Clone, PartialEq, Eq, PartialOrd, Ord, Hash, Serialize)]
+#[serde(transparent)]
+pub struct UploadId(String);
+
+impl UploadId {
+    /// The validating constructor — the only way to obtain one.
+    pub fn new(id: impl Into<String>) -> Result<Self, RecordError> {
+        require_token(id.into()).map(Self)
+    }
+
+    /// The id as its 32 hex characters.
+    pub fn as_str(&self) -> &str {
+        &self.0
+    }
+}
+
+impl fmt::Display for UploadId {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.write_str(&self.0)
+    }
+}
+
+impl<'de> Deserialize<'de> for UploadId {
+    fn deserialize<D: Deserializer<'de>>(deserializer: D) -> Result<Self, D::Error> {
+        Self::new(String::deserialize(deserializer)?).map_err(DeError::custom)
+    }
+}
+
+/// An **attempt id**: the 128-bit token one `UploadPart` attempt stamps into the `slot:`
+/// record it reserved, so an ambiguous reserve is settled by re-reading rather than by
+/// re-reserving a different index (`0016:349`). Same grammar as [`UploadId`].
+#[derive(Debug, Clone, PartialEq, Eq, PartialOrd, Ord, Hash, Serialize)]
+#[serde(transparent)]
+pub struct AttemptId(String);
+
+impl AttemptId {
+    /// The validating constructor — the only way to obtain one.
+    pub fn new(id: impl Into<String>) -> Result<Self, RecordError> {
+        require_token(id.into()).map(Self)
+    }
+
+    /// The id as its 32 hex characters.
+    pub fn as_str(&self) -> &str {
+        &self.0
+    }
+}
+
+impl fmt::Display for AttemptId {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.write_str(&self.0)
+    }
+}
+
+impl<'de> Deserialize<'de> for AttemptId {
+    fn deserialize<D: Deserializer<'de>>(deserializer: D) -> Result<Self, D::Error> {
+        Self::new(String::deserialize(deserializer)?).map_err(DeError::custom)
+    }
+}
+
+/// The decimal width a part number is zero-padded to in `part:` / `psum:` / `sidx:` keys, so
+/// the key's byte-lexicographic order equals part-number order — the property
+/// `metadata.rs:270-273` states for `SEG_INDEX_WIDTH`, mirrored for this slice's key space.
+///
+/// **Five digits, deliberately.** S3's part-number maximum is 10,000, so five digits leave a
+/// full order of magnitude of headroom while keeping every per-session key short. Widening
+/// it later is a stored-format change with a migration, exactly as `SEG_INDEX_WIDTH`'s doc
+/// records, so the headroom is bought now rather than borrowed.
+pub const PART_NUMBER_WIDTH: usize = 5;
+
+/// The largest part number the `part:`/`psum:`/`sidx:` key grammar can address — the whole
+/// key space [`PART_NUMBER_WIDTH`] opens, `99_999`.
+///
+/// A **format** bound (a constant of the encoding), never the live `MAX_PARTS_PER_SESSION`
+/// knob (#655's), which is enforced where a part is *admitted*. Mirrors
+/// [`crate::metadata::MAX_SEGMENT_INDEX`] and its reasoning (`metadata.rs:275-286`).
+pub const MAX_PART_NUMBER: u32 = 10u32.pow(PART_NUMBER_WIDTH as u32) - 1;
+
+/// A **part number**: `[1, MAX_PART_NUMBER]`, the range the fixed-width key grammar can both
+/// render and parse back. Zero is not a part (S3 numbers parts from 1) and a number past the
+/// key space would name a `part:` record no parser could read.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, PartialOrd, Ord, Hash, Serialize)]
+#[serde(transparent)]
+pub struct PartNumber(u32);
+
+impl PartNumber {
+    /// The validating constructor — the only way to obtain one.
+    pub fn new(part_number: u32) -> Result<Self, RecordError> {
+        if part_number == 0 || part_number > MAX_PART_NUMBER {
+            return Err(RecordError::PartNumberOutOfRange {
+                part_number: u64::from(part_number),
+            });
+        }
+        Ok(Self(part_number))
+    }
+
+    /// The number.
+    pub const fn get(self) -> u32 {
+        self.0
+    }
+}
+
+impl fmt::Display for PartNumber {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        write!(f, "{}", self.0)
+    }
+}
+
+impl<'de> Deserialize<'de> for PartNumber {
+    fn deserialize<D: Deserializer<'de>>(deserializer: D) -> Result<Self, D::Error> {
+        Self::new(u32::deserialize(deserializer)?).map_err(DeError::custom)
+    }
+}
+
+/// The decimal width a `slot:` key's index is zero-padded to, so byte-lexicographic key
+/// order equals index order (`metadata.rs:270-273`'s rule, mirrored).
+pub const SLOT_INDEX_WIDTH: usize = 6;
+
+/// The largest index the `slot:` key grammar can address — the whole key space
+/// [`SLOT_INDEX_WIDTH`] opens, `999_999`. A **format** bound: the live `MAX_INFLIGHT_PARTS`
+/// (#655's) is enforced at *reservation*, never at decode, because 0016 permits lowering it
+/// while live sessions still hold indices above the new cap (`0016:390-402`) — and a record
+/// that stopped decoding the moment a knob dropped could no longer be renewed, committed or
+/// torn down.
+pub const MAX_SLOT_INDEX: u32 = 10u32.pow(SLOT_INDEX_WIDTH as u32) - 1;
+
+/// An **in-flight slot index**: `[0, MAX_SLOT_INDEX]`. Index 0 is a real slot (the key space
+/// *is* the per-session cap, `0016:349`), so only the upper bound rejects.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, PartialOrd, Ord, Hash, Serialize)]
+#[serde(transparent)]
+pub struct SlotIndex(u32);
+
+impl SlotIndex {
+    /// The validating constructor — the only way to obtain one.
+    pub fn new(index: u32) -> Result<Self, RecordError> {
+        if index > MAX_SLOT_INDEX {
+            return Err(RecordError::SlotIndexOutOfRange {
+                index: u64::from(index),
+            });
+        }
+        Ok(Self(index))
+    }
+
+    /// The index.
+    pub const fn get(self) -> u32 {
+        self.0
+    }
+}
+
+impl fmt::Display for SlotIndex {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        write!(f, "{}", self.0)
+    }
+}
+
+impl<'de> Deserialize<'de> for SlotIndex {
+    fn deserialize<D: Deserializer<'de>>(deserializer: D) -> Result<Self, D::Error> {
+        Self::new(u32::deserialize(deserializer)?).map_err(DeError::custom)
+    }
+}
+
+/// A SHA-256 digest, stored as 64 **lowercase**-hex characters.
+///
+/// The basis ADR-0047 settled for Wyrd's opaque change token
+/// (`docs/design/adr/0047-object-metadata-model.md:73-89`) — **never MD5**. A validated type
+/// because a digest's *shape* is structural: [`multipart_etag`] concatenates raw digest
+/// bytes, so a short or uppercase digest is not a value any composition could use.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, PartialOrd, Ord, Hash)]
+pub struct Digest([u8; 32]);
+
+impl Digest {
+    /// The SHA-256 of `data`.
+    pub fn of(data: &[u8]) -> Self {
+        let mut hasher = Sha256::new();
+        hasher.update(data);
+        Self(hasher.finalize().into())
+    }
+
+    /// A digest from its 32 raw bytes.
+    pub const fn from_bytes(bytes: [u8; 32]) -> Self {
+        Self(bytes)
+    }
+
+    /// The validating parser: exactly 64 lowercase-hex characters. Rejects uppercase hex
+    /// (a second spelling of one digest), any other length, and any non-hex byte.
+    pub fn from_hex(text: &str) -> Result<Self, RecordError> {
+        let not_hex = || RecordError::DigestNotHex {
+            digest: text.to_string(),
+        };
+        let raw = text.as_bytes();
+        if raw.len() != 64 {
+            return Err(not_hex());
+        }
+        let mut out = [0u8; 32];
+        for (i, slot) in out.iter_mut().enumerate() {
+            let hi = lowercase_hex_digit(raw[2 * i]).ok_or_else(not_hex)?;
+            let lo = lowercase_hex_digit(raw[2 * i + 1]).ok_or_else(not_hex)?;
+            *slot = hi * 16 + lo;
+        }
+        Ok(Self(out))
+    }
+
+    /// The 32 raw digest bytes — what [`multipart_etag`] concatenates.
+    pub const fn as_bytes(&self) -> &[u8; 32] {
+        &self.0
+    }
+
+    /// The canonical lowercase-hex rendering.
+    pub fn to_hex(&self) -> String {
+        hex_lower(&self.0)
+    }
+}
+
+fn lowercase_hex_digit(byte: u8) -> Option<u8> {
+    match byte {
+        b'0'..=b'9' => Some(byte - b'0'),
+        b'a'..=b'f' => Some(byte - b'a' + 10),
+        _ => None,
+    }
+}
+
+impl fmt::Display for Digest {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.write_str(&self.to_hex())
+    }
+}
+
+impl Serialize for Digest {
+    fn serialize<S: serde::Serializer>(&self, serializer: S) -> Result<S::Ok, S::Error> {
+        serializer.serialize_str(&self.to_hex())
+    }
+}
+
+impl<'de> Deserialize<'de> for Digest {
+    fn deserialize<D: Deserializer<'de>>(deserializer: D) -> Result<Self, D::Error> {
+        Self::from_hex(&String::deserialize(deserializer)?).map_err(DeError::custom)
+    }
+}
+
+/// Bytes as lowercase hex — the rendering ADR-0047 settled for the change token, matching
+/// the wrapper style `crates/gateway-s3/src/crypto.rs:21-60` carries for this workspace's
+/// other SHA-256 usage.
+pub fn hex_lower(bytes: &[u8]) -> String {
+    let mut out = String::with_capacity(bytes.len() * 2);
+    for byte in bytes {
+        out.push(char::from_digit(u32::from(byte >> 4), 16).unwrap_or('0'));
+        out.push(char::from_digit(u32::from(byte & 0x0f), 16).unwrap_or('0'));
+    }
+    out
+}
+
+// ===========================================================================
+// 3. Keys and their canonical parsers
+// ===========================================================================
+
+/// The singleton admission-ledger key (`0016:348`). Never deleted; an absent record reads
+/// as `{count: 0}` (a later slice's concern — this module states only the record shape).
+pub const MPUCTL_KEY: &[u8] = b"mpuctl";
+
+/// Key prefix for session records. The trailing `:` is what keeps this **disjoint from**
+/// [`MPUCTL_KEY`] — `"mpuctl".starts_with("mpu:")` is `false` because `mpuctl`'s 4th byte is
+/// `c`, not `:` — so `scan(MPU_PREFIX)` can never return the admission singleton
+/// (`0016:342-344`).
+pub const MPU_PREFIX: &[u8] = b"mpu:";
+/// Key prefix for in-flight part slots.
+pub const SLOT_PREFIX: &[u8] = b"slot:";
+/// Key prefix for committed part records.
+pub const PART_PREFIX: &[u8] = b"part:";
+/// Key prefix for committed part summaries.
+pub const PSUM_PREFIX: &[u8] = b"psum:";
+/// Key prefix for owned staging entries — **disjoint from `pending:`**, which is the whole
+/// point of the class: no global `scan("pending:")` (the restore pass, the expiry sweep)
+/// ever enumerates an owned entry (`0016:475-491`).
+pub const SIDX_PREFIX: &[u8] = b"sidx:";
+/// Key prefix for byte-mode retirement obligations: orphan-mark, then delete the naming
+/// records (`0016:355`).
+pub const RETIRE_BYTES_PREFIX: &[u8] = b"retire:bytes:";
+/// Key prefix for record-mode retirement obligations: delete records only — never
+/// orphan-mark (`0016:356`).
+pub const RETIRE_RECORDS_PREFIX: &[u8] = b"retire:records:";
+
+/// A **fixed-width** `width`-digit decimal: exactly `width` ASCII digits — no `+`/`-` sign,
+/// no short spelling, no over-wide one. This is the rule the zero-padded key fields are
+/// checked against, and it is what makes byte-lexicographic key order equal numeric order
+/// (`metadata.rs:270-273`). `u32::from_str` alone would accept `+7`, `7` and `0000007` as
+/// three spellings of one record.
+fn fixed_width_u32(text: &str, width: usize) -> Option<u32> {
+    if text.len() != width || !text.bytes().all(|b| b.is_ascii_digit()) {
+        return None;
+    }
+    text.parse().ok()
+}
+
+/// A `u128`/`u64` in **canonical** decimal: ASCII digits only (no sign), and no leading zero
+/// unless the value *is* `0` — the rule `parse_seg_key` applies to its own un-padded epoch
+/// (`metadata.rs:1305-1315`), reused for every variable-width decimal this module parses (a
+/// chunk id, an epoch, a version).
+fn canonical_decimal<T: std::str::FromStr>(text: &str) -> Option<T> {
+    if text.is_empty() || !text.bytes().all(|b| b.is_ascii_digit()) {
+        return None;
+    }
+    if text.len() > 1 && text.starts_with('0') {
+        return None;
+    }
+    text.parse().ok()
+}
+
+/// Split `key` into exactly `fields` `:`-separated components after `prefix`, failing closed
+/// on a non-UTF-8 key, a missing prefix, or the wrong field count (a truncated key, or one
+/// with a trailing component) — the shape every keyed-record parser below shares.
+fn split_key<'a>(
+    key: &'a [u8],
+    prefix: &str,
+    namespace: &'static str,
+    fields: usize,
+) -> Result<Vec<&'a str>, RecordError> {
+    let text = std::str::from_utf8(key).map_err(|_| malformed_key(namespace, key))?;
+    let rest = text
+        .strip_prefix(prefix)
+        .ok_or_else(|| malformed_key(namespace, key))?;
+    let parts: Vec<&str> = rest.splitn(fields, ':').collect();
+    if parts.len() != fields {
+        return Err(malformed_key(namespace, key));
+    }
+    Ok(parts)
+}
+
+/// Key for a session record: `mpu:<upload-id>`.
+pub fn mpu_key(upload_id: &UploadId) -> Vec<u8> {
+    format!("mpu:{upload_id}").into_bytes()
+}
+
+/// Parse an [`mpu_key`] back into its upload id.
+pub fn parse_mpu_key(key: &[u8]) -> Result<UploadId, RecordError> {
+    let fields = split_key(key, "mpu:", "mpu:", 1)?;
+    UploadId::new(fields[0])
+}
+
+/// Key for one in-flight part slot: `slot:<upload-id>:<index>`, zero-padded to
+/// [`SLOT_INDEX_WIDTH`].
+pub fn slot_key(upload_id: &UploadId, index: SlotIndex) -> Vec<u8> {
+    format!(
+        "slot:{upload_id}:{:0width$}",
+        index.get(),
+        width = SLOT_INDEX_WIDTH
+    )
+    .into_bytes()
+}
+
+/// The bounded per-session slot range: `slot:<upload-id>:` (`0016:349`).
+pub fn slot_range(upload_id: &UploadId) -> Vec<u8> {
+    format!("slot:{upload_id}:").into_bytes()
+}
+
+/// Parse a [`slot_key`] back into `(upload_id, index)`, rejecting every non-canonical
+/// spelling of one slot.
+pub fn parse_slot_key(key: &[u8]) -> Result<(UploadId, SlotIndex), RecordError> {
+    let fields = split_key(key, "slot:", "slot:", 2)?;
+    let index =
+        fixed_width_u32(fields[1], SLOT_INDEX_WIDTH).ok_or_else(|| malformed_key("slot:", key))?;
+    Ok((UploadId::new(fields[0])?, SlotIndex::new(index)?))
+}
+
+fn part_scoped_key(prefix: &str, upload_id: &UploadId, part_number: PartNumber) -> Vec<u8> {
+    format!(
+        "{prefix}{upload_id}:{:0width$}",
+        part_number.get(),
+        width = PART_NUMBER_WIDTH
+    )
+    .into_bytes()
+}
+
+fn parse_part_scoped_key(
+    key: &[u8],
+    prefix: &'static str,
+    namespace: &'static str,
+) -> Result<(UploadId, PartNumber), RecordError> {
+    let fields = split_key(key, prefix, namespace, 2)?;
+    let part_number = fixed_width_u32(fields[1], PART_NUMBER_WIDTH)
+        .ok_or_else(|| malformed_key(namespace, key))?;
+    Ok((UploadId::new(fields[0])?, PartNumber::new(part_number)?))
+}
+
+/// Key for a committed part: `part:<upload-id>:<part-number>`, zero-padded to
+/// [`PART_NUMBER_WIDTH`] so a range read is in part-number order.
+pub fn part_key(upload_id: &UploadId, part_number: PartNumber) -> Vec<u8> {
+    part_scoped_key("part:", upload_id, part_number)
+}
+
+/// The bounded per-session part range: `part:<upload-id>:`.
+pub fn part_range(upload_id: &UploadId) -> Vec<u8> {
+    format!("part:{upload_id}:").into_bytes()
+}
+
+/// Parse a [`part_key`] back into `(upload_id, part_number)`.
+pub fn parse_part_key(key: &[u8]) -> Result<(UploadId, PartNumber), RecordError> {
+    parse_part_scoped_key(key, "part:", "part:")
+}
+
+/// Key for a committed part's summary: `psum:<upload-id>:<part-number>`.
+pub fn psum_key(upload_id: &UploadId, part_number: PartNumber) -> Vec<u8> {
+    part_scoped_key("psum:", upload_id, part_number)
+}
+
+/// The bounded per-session summary range: `psum:<upload-id>:`.
+pub fn psum_range(upload_id: &UploadId) -> Vec<u8> {
+    format!("psum:{upload_id}:").into_bytes()
+}
+
+/// Parse a [`psum_key`] back into `(upload_id, part_number)`.
+pub fn parse_psum_key(key: &[u8]) -> Result<(UploadId, PartNumber), RecordError> {
+    parse_part_scoped_key(key, "psum:", "psum:")
+}
+
+/// Key for one **owned staging entry**: `sidx:<upload-id>:<part-number>:<chunk-id>`. The
+/// `<part-number>` component is what lets a reclaimer attribute residue to the part attempt
+/// that staged it (`0016:353`).
+pub fn sidx_key(upload_id: &UploadId, part_number: PartNumber, chunk: ChunkId) -> Vec<u8> {
+    format!(
+        "sidx:{upload_id}:{:0width$}:{chunk}",
+        part_number.get(),
+        width = PART_NUMBER_WIDTH
+    )
+    .into_bytes()
+}
+
+/// The bounded per-session owned range: `sidx:<upload-id>:` — the **only** way any pass
+/// reads owned entries; there is no global scan of them anywhere (`0016:475-491`).
+pub fn sidx_range(upload_id: &UploadId) -> Vec<u8> {
+    format!("sidx:{upload_id}:").into_bytes()
+}
+
+/// Parse a [`sidx_key`] back into `(upload_id, part_number, chunk_id)`. The chunk-id
+/// component is **canonical** decimal, not fixed-width — `7` and `007` must never both
+/// parse, the same canonicality rule the padded fields enforce by width instead.
+pub fn parse_sidx_key(key: &[u8]) -> Result<(UploadId, PartNumber, ChunkId), RecordError> {
+    let fields = split_key(key, "sidx:", "sidx:", 3)?;
+    let part_number =
+        fixed_width_u32(fields[1], PART_NUMBER_WIDTH).ok_or_else(|| malformed_key("sidx:", key))?;
+    let chunk: ChunkId = canonical_decimal(fields[2]).ok_or_else(|| malformed_key("sidx:", key))?;
+    Ok((
+        UploadId::new(fields[0])?,
+        PartNumber::new(part_number)?,
+        chunk,
+    ))
+}
+
+// ===========================================================================
+// 4. The `retire:` token grammar (`0016:358-380`)
+// ===========================================================================
+
+/// Which of the two retirement modes an obligation is in — read from the **key**, never a
+/// field: a boolean misread once is silent data loss, a malformed key prefix is an error at
+/// decode (`0016:434-440`).
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum RetireMode {
+    /// Orphan-mark the bytes, then delete the records that named them.
+    Bytes,
+    /// Delete records only — **never** orphan-mark.
+    Records,
+}
+
+impl RetireMode {
+    /// Every mode, for a total dispatch.
+    pub const ALL: [Self; 2] = [Self::Bytes, Self::Records];
+
+    /// The key prefix this mode lives under.
+    pub const fn prefix(self) -> &'static [u8] {
+        match self {
+            Self::Bytes => RETIRE_BYTES_PREFIX,
+            Self::Records => RETIRE_RECORDS_PREFIX,
+        }
+    }
+}
+
+/// Parse the mode out of a `retire:` key, failing closed on any other spelling — the
+/// boundary the mode-in-the-key argument rests on (`0016:434-440`).
+pub fn parse_retire_mode(key: &[u8]) -> Result<RetireMode, RecordError> {
+    if key.starts_with(RETIRE_BYTES_PREFIX) {
+        Ok(RetireMode::Bytes)
+    } else if key.starts_with(RETIRE_RECORDS_PREFIX) {
+        Ok(RetireMode::Records)
+    } else {
+        let text = String::from_utf8_lossy(key);
+        Err(RecordError::UnknownRetireMode {
+            mode: text
+                .strip_prefix("retire:")
+                .unwrap_or(&text)
+                .split(':')
+                .next()
+                .unwrap_or_default()
+                .to_string(),
+        })
+    }
+}
+
+/// A retirement token, whose grammar makes reuse impossible (`0016:358-380`): every
+/// component is minted once — an epoch is bumped by every fence, a `(part, attempt)` pair
+/// belongs to one `UploadPart`, an `(inode, version)` pair is produced by exactly one
+/// publication. Installation is `require_absent(retire:<mode>:<token>)`, so a collision is a
+/// `Conflict` the installer classifies, never a silent overwrite that would replace one
+/// obligation's payload with another's and permanently lose the reclamation evidence.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum RetireToken {
+    /// A **session-scoped** obligation: `s:<upload-id>:<epoch>` — the whole-session teardown
+    /// an epoch's fence installs — or, with the optional suffix,
+    /// `s:<upload-id>:<epoch>:<part-number>:<attempt-id>` for a **per-part** obligation (a
+    /// re-uploaded part's superseded chunks, a losing writer's compensation).
+    Session {
+        /// The owning session's upload id.
+        upload_id: UploadId,
+        /// The epoch whose fence installed the obligation.
+        epoch: u64,
+        /// The part attempt, for a per-part obligation.
+        part: Option<(PartNumber, AttemptId)>,
+    },
+    /// A **superseded or deleted generation**: `g:<inode-id>:<version>`.
+    Generation {
+        /// The inode.
+        inode: InodeId,
+        /// Its version.
+        version: u64,
+    },
+}
+
+impl fmt::Display for RetireToken {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            Self::Session {
+                upload_id,
+                epoch,
+                part: None,
+            } => write!(f, "s:{upload_id}:{epoch}"),
+            Self::Session {
+                upload_id,
+                epoch,
+                part: Some((part_number, attempt_id)),
+            } => write!(f, "s:{upload_id}:{epoch}:{part_number}:{attempt_id}"),
+            Self::Generation { inode, version } => write!(f, "g:{inode}:{version}"),
+        }
+    }
+}
+
+/// Key for a retirement obligation: `retire:<mode>:<token>`.
+pub fn retire_key(mode: RetireMode, token: &RetireToken) -> Vec<u8> {
+    let mut key = mode.prefix().to_vec();
+    key.extend_from_slice(token.to_string().as_bytes());
+    key
+}
+
+/// The bounded session-scoped obligation range for one mode: `retire:<mode>:s:<upload-id>:`.
+/// A session's terminal delete gate is two of these emptiness reads, never a walk of the
+/// whole `retire:` namespace, which is deliberately not cardinality-bounded
+/// (`0016:374-380`).
+pub fn retire_session_range(mode: RetireMode, upload_id: &UploadId) -> Vec<u8> {
+    let mut key = mode.prefix().to_vec();
+    key.extend_from_slice(format!("s:{upload_id}:").as_bytes());
+    key
+}
+
+/// Parse a [`retire_key`] back into `(mode, token)`, failing closed on any other spelling: a
+/// truncated token, a trailing component, a non-canonical epoch/version/part-number (a `+`
+/// sign or a leading zero), or a malformed upload/attempt id.
+pub fn parse_retire_key(key: &[u8]) -> Result<(RetireMode, RetireToken), RecordError> {
+    let mode = parse_retire_mode(key)?;
+    let text = std::str::from_utf8(key).map_err(|_| malformed_key("retire:", key))?;
+    let rest = &text[mode.prefix().len()..];
+    let fields: Vec<&str> = rest.split(':').collect();
+    let malformed = || malformed_key("retire:", key);
+    let token = match fields.as_slice() {
+        ["s", upload_id, epoch] => RetireToken::Session {
+            upload_id: UploadId::new(*upload_id)?,
+            epoch: canonical_decimal(epoch).ok_or_else(malformed)?,
+            part: None,
+        },
+        ["s", upload_id, epoch, part_number, attempt_id] => RetireToken::Session {
+            upload_id: UploadId::new(*upload_id)?,
+            epoch: canonical_decimal(epoch).ok_or_else(malformed)?,
+            part: Some((
+                PartNumber::new(canonical_decimal(part_number).ok_or_else(malformed)?)?,
+                AttemptId::new(*attempt_id)?,
+            )),
+        },
+        ["g", inode, version] => RetireToken::Generation {
+            inode: canonical_decimal(inode).ok_or_else(malformed)?,
+            version: canonical_decimal(version).ok_or_else(malformed)?,
+        },
+        _ => return Err(malformed()),
+    };
+    Ok((mode, token))
+}
+
+// ===========================================================================
+// 5. The admission ledger — `mpuctl` (`0016:348`)
+// ===========================================================================
+
+/// The budget **profile** tuple `mpuctl` stores and every admitter/custodian compares whole
+/// (`0016:348`,`:1462-1480`). This slice owns the **shape** and the two pure derivations
+/// below (§ Scope boundary 3); the deployment's own values are #655's — mirroring the
+/// format/capacity split `metadata.rs:270-322` already draws.
+///
+/// The fields are private behind [`Budget::new`] because the derivations are safety
+/// arithmetic: a tuple with a zero component derives a `U_ref` of zero, and `MAX_SESSIONS`
+/// would then be a division by zero rather than a limit. No legal configuration has one, so
+/// it is refused at construction and at decode, and every `Budget` in existence therefore
+/// derives a defined limit.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize)]
+pub struct Budget {
+    w_ref: u64,
+    max_part_chunks: u32,
+    max_parts_per_session: u32,
+    max_inflight_parts: u32,
+    max_staged_chunks: u32,
+}
+
+impl Budget {
+    /// The validating constructor — every component must be non-zero.
+    pub fn new(
+        w_ref: u64,
+        max_part_chunks: u32,
+        max_parts_per_session: u32,
+        max_inflight_parts: u32,
+        max_staged_chunks: u32,
+    ) -> Result<Self, RecordError> {
+        let zero = [
+            (w_ref == 0, "w_ref"),
+            (max_part_chunks == 0, "max_part_chunks"),
+            (max_parts_per_session == 0, "max_parts_per_session"),
+            (max_inflight_parts == 0, "max_inflight_parts"),
+            (max_staged_chunks == 0, "max_staged_chunks"),
+        ];
+        for (is_zero, field) in zero {
+            if is_zero {
+                return Err(structural(
+                    "mpuctl profile",
+                    format!("`{field}` is zero: no configuration admits a session under it"),
+                ));
+            }
+        }
+        Ok(Self {
+            w_ref,
+            max_part_chunks,
+            max_parts_per_session,
+            max_inflight_parts,
+            max_staged_chunks,
+        })
+    }
+
+    /// The reconcile pass's staged-reference memory budget, in chunk-refs (`W_ref`).
+    pub const fn w_ref(&self) -> u64 {
+        self.w_ref
+    }
+
+    /// The per-`part:`-record chunk ceiling (`MAX_PART_CHUNKS`).
+    pub const fn max_part_chunks(&self) -> u32 {
+        self.max_part_chunks
+    }
+
+    /// The per-session part-number space (`MAX_PARTS_PER_SESSION`).
+    pub const fn max_parts_per_session(&self) -> u32 {
+        self.max_parts_per_session
+    }
+
+    /// The per-session in-flight cap (`MAX_INFLIGHT_PARTS`).
+    pub const fn max_inflight_parts(&self) -> u32 {
+        self.max_inflight_parts
+    }
+
+    /// The per-session committed-staging ceiling (`MAX_STAGED_CHUNKS`).
+    pub const fn max_staged_chunks(&self) -> u32 {
+        self.max_staged_chunks
+    }
+
+    /// `U_ref` — the worst-case **per-session** staged-reference footprint, in chunk-refs
+    /// (`0016:1469`), pure arithmetic over the stored tuple (§ Scope boundary 3):
+    ///
+    /// ```text
+    /// U_ref = min( (MAX_PARTS_PER_SESSION + MAX_INFLIGHT_PARTS) x MAX_PART_CHUNKS,
+    ///              MAX_STAGED_CHUNKS + 2 x MAX_INFLIGHT_PARTS x MAX_PART_CHUNKS )
+    /// ```
+    ///
+    /// The first term is the raw part-number space; the second is the **enforced** staged
+    /// ceiling plus the bounded commit overshoot plus the in-flight owned entries — each
+    /// committed part charged its **full** `MAX_PART_CHUNKS` (charging a part as one record
+    /// under-bounds the footprint by up to `MAX_PART_CHUNKS`x, the iteration-4 defect 0016
+    /// fixed).
+    ///
+    /// **Saturating, never wrapping**: the operands are decoded `u32`s, so both products can
+    /// exceed `u64` (`(2^32 + 2^32) × 2^32 = 2^65`). Unchecked arithmetic here would panic in
+    /// a checked build and wrap in a release one, deriving a *small* `U_ref` from an enormous
+    /// profile and admitting sessions far past the memory the reconcile pass is sized for.
+    /// Saturation charges the whole budget to one session instead — the fail-closed
+    /// direction (C-1).
+    pub fn u_ref(&self) -> u64 {
+        let part_chunks = u64::from(self.max_part_chunks);
+        let inflight = u64::from(self.max_inflight_parts);
+        let raw = u64::from(self.max_parts_per_session)
+            .saturating_add(inflight)
+            .saturating_mul(part_chunks);
+        let ceiling = u64::from(self.max_staged_chunks)
+            .saturating_add(2u64.saturating_mul(inflight).saturating_mul(part_chunks));
+        raw.min(ceiling)
+    }
+
+    /// `MAX_SESSIONS` — the admission limit, `min(floor(W_ref / U_ref), SCAN_CAP/2)`,
+    /// **derived, never chosen** (`0016:1470`). The `SCAN_CAP/2` clamp is what keeps a legal
+    /// pairing (a large `W_ref` with small parts) from exceeding the reaper's one
+    /// `scan("mpu:")`; [`wyrd_traits::SCAN_CAP`] is a pre-existing store-seam constant, not a
+    /// multipart deployment knob, so consulting it here is still pure arithmetic over values
+    /// already fixed.
+    ///
+    /// [`Budget::new`] refuses a zero component, so `u_ref()` is at least 2 and the division
+    /// is total.
+    pub fn max_sessions(&self) -> u64 {
+        let quotient = self.w_ref / self.u_ref();
+        quotient.min((wyrd_traits::SCAN_CAP / 2) as u64)
+    }
+}
+
+#[derive(Deserialize)]
+struct BudgetWire {
+    w_ref: u64,
+    max_part_chunks: u32,
+    max_parts_per_session: u32,
+    max_inflight_parts: u32,
+    max_staged_chunks: u32,
+}
+
+impl<'de> Deserialize<'de> for Budget {
+    fn deserialize<D: Deserializer<'de>>(deserializer: D) -> Result<Self, D::Error> {
+        let wire = BudgetWire::deserialize(deserializer)?;
+        Budget::new(
+            wire.w_ref,
+            wire.max_part_chunks,
+            wire.max_parts_per_session,
+            wire.max_inflight_parts,
+            wire.max_staged_chunks,
+        )
+        .map_err(DeError::custom)
+    }
+}
+
+/// The singleton **admission ledger** record, `mpuctl` (`0016:348`): one record, three
+/// fields, CAS'd **whole**, so the count and the limit it was checked against can never be
+/// read apart.
+///
+/// **`max_sessions` is checked against the profile at decode**, because it is *derived*
+/// ([`Budget::max_sessions`], `0016:1470`) and never independently chosen. Admission
+/// enforces the **stored** limit — deliberately, so every admitter in the fleet agrees on
+/// one number — which is exactly why the stored number may not be free: a torn or
+/// rolled-back `mpuctl` naming a larger `max_sessions` than its own profile derives would be
+/// trusted by every host, and `Σ_sessions(U_ref) ≤ W_ref` (the bound the whole reconcile pass
+/// is sized for) would be exceeded on hosts that never observe the overrun. The relation
+/// between the two fields is a structural invariant of this record class, so it surfaces as
+/// an error at decode rather than as an admitted value (ADR-0045; the defect #636's
+/// sign-off recorded).
+#[derive(Debug, Clone, PartialEq, Eq, Serialize)]
+pub struct AdmissionRecord {
+    /// How many `mpu:` records exist, in any state (tombstones included).
+    pub count: u64,
+    /// The governing limit those increments were admitted against.
+    pub max_sessions: u64,
+    /// The budget tuple that establishes `max_sessions`.
+    pub profile: Budget,
+}
+
+impl AdmissionRecord {
+    /// The ledger a first Create initializes on a fresh or upgraded store: one session, the
+    /// limit its own profile derives (`0016:348`).
+    pub fn new(count: u64, profile: Budget) -> Self {
+        Self {
+            count,
+            max_sessions: profile.max_sessions(),
+            profile,
+        }
+    }
+}
+
+#[derive(Deserialize)]
+struct AdmissionRecordWire {
+    count: u64,
+    max_sessions: u64,
+    profile: Budget,
+}
+
+impl<'de> Deserialize<'de> for AdmissionRecord {
+    fn deserialize<D: Deserializer<'de>>(deserializer: D) -> Result<Self, D::Error> {
+        let wire = AdmissionRecordWire::deserialize(deserializer)?;
+        let derived = wire.profile.max_sessions();
+        if wire.max_sessions != derived {
+            return Err(DeError::custom(format!(
+                "mpuctl records max_sessions={} but its own profile derives {derived} \
+                 (U_ref={}, W_ref={}): the stored limit is derived, never chosen",
+                wire.max_sessions,
+                wire.profile.u_ref(),
+                wire.profile.w_ref(),
+            )));
+        }
+        Ok(Self {
+            count: wire.count,
+            max_sessions: wire.max_sessions,
+            profile: wire.profile,
+        })
+    }
+}
+
+/// Decode the `mpuctl` singleton, with its relational invariant enforced.
+pub fn decode_admission_record(bytes: &[u8]) -> Result<AdmissionRecord, RecordError> {
+    decode_record("mpuctl", bytes)
+}
+
+// ===========================================================================
+// 6. The session record — `mpu:<upload-id>` (`0016:350`, §2's state machine)
+// ===========================================================================
+
+/// A session's lifecycle state (`0016:528-553`).
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash, Serialize, Deserialize)]
+pub enum SessionState {
+    /// Accepting parts.
+    Open,
+    /// Fenced by a Complete that owns publication.
+    Completing,
+    /// Fenced for teardown; its `retire:bytes:{session}` obligation is installed.
+    Aborting,
+    /// Published. A **tombstone** that still answers an identical retry, still holds an
+    /// `mpu:` record, and is therefore still counted by the admission counter
+    /// (`0016:964-968`).
+    Completed,
+}
+
+impl SessionState {
+    /// Every state a session record can be in. Adding a variant without extending this
+    /// widens the verb x state product the answer table is asserted total over, so a new
+    /// state cannot be added silently.
+    pub const ALL: [Self; 4] = [
+        Self::Open,
+        Self::Completing,
+        Self::Aborting,
+        Self::Completed,
+    ];
+}
+
+/// The dirent identity a `Completing` session publishes to, plus the fence epoch that owns
+/// the attempt (`0016:350`).
+///
+/// **The key, never a frozen inode id**: an inode id is minted per create, so a concurrent
+/// delete-and-recreate of the same object name rebinds it to a *different* inode, and a flip
+/// that reused a frozen id would recreate an unlinked inode and CAS a dirent that now names
+/// another one. Each flip attempt therefore re-resolves the dirent.
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+pub struct PublishTarget {
+    /// The parent inode the object name lives under.
+    pub parent: InodeId,
+    /// The object name.
+    pub name: String,
+    /// The `Completing` fence epoch, so a resumed completer writes the same deterministic
+    /// segment-group range (`0016:940-949`).
+    pub fence_epoch: u64,
+}
+
+/// What a `Completed` session recorded (`0016:350`).
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+pub struct Completion {
+    /// The published inode.
+    pub inode: InodeId,
+    /// The published version — `prior.version + 1` recomputed from the re-read prior at the
+    /// winning flip, never a fence-frozen number (`0016:925-932`).
+    pub version: u64,
+    /// The composed ETag ([`multipart_etag`]), validated against its grammar at decode.
+    pub etag: MultipartEtag,
+    /// The publication instant.
+    pub completed_at_millis: u64,
+    /// A digest over the **ordered** `(part_number, digest)` list the winning Complete named
+    /// ([`complete_fingerprint`]) — the request identity the `Completed` tombstone answers a
+    /// retry on (`0016:898-908`).
+    pub complete_fingerprint: Digest,
+}
+
+/// One multipart upload session — the record every transition compare-and-sets on its
+/// **exact bytes** (`0016:350`,`:555-566`).
+#[derive(Debug, Clone, PartialEq, Eq, Serialize)]
+pub struct SessionRecord {
+    /// The target bucket.
+    pub bucket: String,
+    /// The parent inode the object name lives under.
+    pub parent: InodeId,
+    /// The object name.
+    pub object: String,
+    /// The declared content type, stamped at publication (ADR-0047).
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub content_type: Option<String>,
+    /// When the session was initiated — the instant `W_session` is measured from (#625).
+    pub created_at_millis: u64,
+    /// Which clock produced every session-scoped stamp — *one clock per correctness
+    /// lifecycle* (ADR-0009, `AGENTS.md:131-142`). Recorded here as a field; the clock guard
+    /// that reads it is #625's.
+    pub clock_source: String,
+    /// The lifecycle state.
+    pub state: SessionState,
+    /// A monotone counter bumped by every fence, so two successive states are textually
+    /// distinct even when nothing else changes.
+    pub epoch: u64,
+    /// Complete fences spent so far (capped at a later slice's `MAX_COMPLETE_ATTEMPTS`).
+    pub attempts: u32,
+    /// The **segment-group nonce**, minted with the session and deliberately independent of
+    /// its upload id, because the `seg:` records it keys outlive the `mpu:` tombstone that
+    /// would otherwise be their only reuse guard (`0016:499-527`). Validated at decode by
+    /// [`crate::metadata::SegmentNonce`]'s own constructor, so a stored session can never
+    /// name a segment range it could not address.
+    pub group_nonce: metadata::SegmentNonce,
+    /// When the session fenced into `Completing` — the instant `W_completing` is measured
+    /// from. `Completing`-only.
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub fenced_at_millis: Option<u64>,
+    /// The segment-write cursor of the current attempt. `Completing`-only.
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub segments_written: Option<u32>,
+    /// The dirent identity and fence epoch of the current attempt. `Completing`-only.
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub publish_target: Option<PublishTarget>,
+    /// What the winning flip recorded. `Completed`-only.
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub completion: Option<Completion>,
+}
+
+#[derive(Deserialize)]
+struct SessionRecordWire {
+    bucket: String,
+    parent: InodeId,
+    object: String,
+    #[serde(default)]
+    content_type: Option<String>,
+    created_at_millis: u64,
+    clock_source: String,
+    state: SessionState,
+    epoch: u64,
+    attempts: u32,
+    group_nonce: String,
+    #[serde(default)]
+    fenced_at_millis: Option<u64>,
+    #[serde(default)]
+    segments_written: Option<u32>,
+    #[serde(default)]
+    publish_target: Option<PublishTarget>,
+    #[serde(default)]
+    completion: Option<Completion>,
+}
+
+/// **Validating decode** (ADR-0045). Half of a state's meaning is in the fields the state
+/// carries, so a session value carrying a field its state forbids — a `Completing`-only
+/// `fenced_at_millis` on an `Open` session — or missing one its state requires is a record
+/// no writer in this protocol can produce, and admitting it as a *value* would let a
+/// consumer act on a session it does not actually understand (`0016:404-408`).
+///
+/// Three further structural rules, each a record whose halves would otherwise contradict:
+/// a session must name the target it publishes to (`bucket`/`object` non-empty); it must
+/// name the clock its stamps came from (`clock_source` non-empty, ADR-0009); and a
+/// `Completing` session's `publish_target.fence_epoch` must be **its own** epoch, since the
+/// segment records of the attempt are keyed by that epoch (`0016:940-949`) — a mismatch
+/// would resume a completer against another attempt's segment generation.
+impl<'de> Deserialize<'de> for SessionRecord {
+    fn deserialize<D: Deserializer<'de>>(deserializer: D) -> Result<Self, D::Error> {
+        let wire = SessionRecordWire::deserialize(deserializer)?;
+        let group_nonce = metadata::SegmentNonce::new(wire.group_nonce).map_err(DeError::custom)?;
+        let (fenced, cursor, target, completion) = (
+            wire.fenced_at_millis.is_some(),
+            wire.segments_written.is_some(),
+            wire.publish_target.is_some(),
+            wire.completion.is_some(),
+        );
+        let required: &[(bool, &'static str)] = match wire.state {
+            SessionState::Completing => &[
+                (fenced, "fenced_at_millis"),
+                (cursor, "segments_written"),
+                (target, "publish_target"),
+            ],
+            SessionState::Completed => &[(completion, "completion")],
+            SessionState::Open | SessionState::Aborting => &[],
+        };
+        for (present, field) in required {
+            if !present {
+                return Err(DeError::custom(format!(
+                    "session in {:?} must carry the field `{field}`",
+                    wire.state
+                )));
+            }
+        }
+        let forbidden: &[(bool, &'static str)] = match wire.state {
+            // A fence release and a teardown fence both drop every `Completing`-only field,
+            // so an `Open`/`Aborting` record is identical in shape to a freshly created one.
+            SessionState::Open | SessionState::Aborting => &[
+                (fenced, "fenced_at_millis"),
+                (cursor, "segments_written"),
+                (target, "publish_target"),
+                (completion, "completion"),
+            ],
+            SessionState::Completing => &[(completion, "completion")],
+            SessionState::Completed => &[
+                (fenced, "fenced_at_millis"),
+                (cursor, "segments_written"),
+                (target, "publish_target"),
+            ],
+        };
+        for (present, field) in forbidden {
+            if *present {
+                return Err(DeError::custom(format!(
+                    "session in {:?} may not carry the field `{field}`",
+                    wire.state
+                )));
+            }
+        }
+        for (text, field) in [
+            (&wire.bucket, "bucket"),
+            (&wire.object, "object"),
+            (&wire.clock_source, "clock_source"),
+        ] {
+            if text.is_empty() {
+                return Err(DeError::custom(format!("session `{field}` is empty")));
+            }
+        }
+        if let Some(target) = &wire.publish_target {
+            if target.fence_epoch != wire.epoch {
+                return Err(DeError::custom(format!(
+                    "session at epoch {} carries a publish_target fenced at epoch {}: \
+                     the attempt's `seg:` records are keyed by the fence epoch",
+                    wire.epoch, target.fence_epoch
+                )));
+            }
+            if target.name.is_empty() {
+                return Err(DeError::custom("publish_target `name` is empty"));
+            }
+        }
+        Ok(Self {
+            bucket: wire.bucket,
+            parent: wire.parent,
+            object: wire.object,
+            content_type: wire.content_type,
+            created_at_millis: wire.created_at_millis,
+            clock_source: wire.clock_source,
+            state: wire.state,
+            epoch: wire.epoch,
+            attempts: wire.attempts,
+            group_nonce,
+            fenced_at_millis: wire.fenced_at_millis,
+            segments_written: wire.segments_written,
+            publish_target: wire.publish_target,
+            completion: wire.completion,
+        })
+    }
+}
+
+/// Decode an `mpu:<upload-id>` session record, with its state's field invariants enforced.
+pub fn decode_session(bytes: &[u8]) -> Result<SessionRecord, RecordError> {
+    decode_record("mpu:", bytes)
+}
+
+// ===========================================================================
+// 7. The slot, part and summary records (`0016:349-352`)
+// ===========================================================================
+
+/// One **in-flight part slot** — `slot:<upload-id>:<index>` (`0016:349`). The stamp records
+/// when the slot was claimed, so a request is observably alive from the instant it reserves,
+/// before it has written a byte; the lease is renewed in flight by the same half-TTL loop
+/// that renews the owned `sidx:` leases.
+#[derive(Debug, Clone, PartialEq, Eq, Serialize)]
+pub struct SlotRecord {
+    /// The part number this attempt is uploading.
+    pub part_number: PartNumber,
+    /// A per-attempt token, so an ambiguous reserve is settled by re-reading rather than by
+    /// re-reserving a different index.
+    pub attempt_id: AttemptId,
+    /// When the slot was claimed.
+    pub reserved_at_millis: u64,
+    /// The slot's liveness lease.
+    pub lease_expiry_millis: u64,
+}
+
+#[derive(Deserialize)]
+struct SlotRecordWire {
+    part_number: PartNumber,
+    attempt_id: AttemptId,
+    reserved_at_millis: u64,
+    lease_expiry_millis: u64,
+}
+
+/// **Validating decode**: the part number and attempt id are validated by their own types,
+/// and a lease that expired *before* the slot was claimed is refused — under one clock
+/// (ADR-0009) no reserve can stamp one, and admitting it would present a slot that was born
+/// reapable as ordinary residue.
+impl<'de> Deserialize<'de> for SlotRecord {
+    fn deserialize<D: Deserializer<'de>>(deserializer: D) -> Result<Self, D::Error> {
+        let wire = SlotRecordWire::deserialize(deserializer)?;
+        if wire.lease_expiry_millis < wire.reserved_at_millis {
+            return Err(DeError::custom(format!(
+                "slot lease expires at {} but was reserved at {}",
+                wire.lease_expiry_millis, wire.reserved_at_millis
+            )));
+        }
+        Ok(Self {
+            part_number: wire.part_number,
+            attempt_id: wire.attempt_id,
+            reserved_at_millis: wire.reserved_at_millis,
+            lease_expiry_millis: wire.lease_expiry_millis,
+        })
+    }
+}
+
+/// Decode a `slot:<upload-id>:<index>` reservation.
+pub fn decode_slot(bytes: &[u8]) -> Result<SlotRecord, RecordError> {
+    decode_record("slot:", bytes)
+}
+
+/// A committed part — `part:<upload-id>:<part-number>` (`0016:351`).
+#[derive(Debug, Clone, PartialEq, Eq, Serialize)]
+pub struct PartRecord {
+    /// The part's chunk list, in object order.
+    pub chunks: Vec<ChunkRef>,
+    /// The part's length in bytes.
+    pub len: u64,
+    /// The part's content digest.
+    pub digest: Digest,
+    /// When the part committed.
+    pub committed_at_millis: u64,
+    /// The session epoch the commit was fenced on.
+    pub session_epoch: u64,
+}
+
+#[derive(Deserialize)]
+struct PartRecordWire {
+    chunks: Vec<ChunkRef>,
+    len: u64,
+    digest: Digest,
+    committed_at_millis: u64,
+    session_epoch: u64,
+}
+
+/// **Validating decode**: `len` is checked against the chunk list's own span, **checked**
+/// (never wrapped, mirroring `metadata.rs`'s `checked_chunk_bytes`, `:1180-1190`). The two
+/// state the *same* fact — Complete sums `len` into the published `size`, the read path sums
+/// the chunks it actually reads — so a record whose halves disagree would publish an object
+/// whose declared size is not the number of bytes a reader can get: a silent wrong answer at
+/// `HeadObject`/`GetObject`. A wrapped sum is the same defect with a forged agreement.
+impl<'de> Deserialize<'de> for PartRecord {
+    fn deserialize<D: Deserializer<'de>>(deserializer: D) -> Result<Self, D::Error> {
+        let wire = PartRecordWire::deserialize(deserializer)?;
+        let span = wire
+            .chunks
+            .iter()
+            .try_fold(0u64, |total, chunk| total.checked_add(chunk.len))
+            .ok_or_else(|| {
+                DeError::custom(format!(
+                    "part record's {} chunk length(s) overflow u64",
+                    wire.chunks.len()
+                ))
+            })?;
+        if span != wire.len {
+            return Err(DeError::custom(format!(
+                "part record declares len={} but its {} chunk(s) span {span} B",
+                wire.len,
+                wire.chunks.len()
+            )));
+        }
+        Ok(Self {
+            chunks: wire.chunks,
+            len: wire.len,
+            digest: wire.digest,
+            committed_at_millis: wire.committed_at_millis,
+            session_epoch: wire.session_epoch,
+        })
+    }
+}
+
+/// Decode a `part:<upload-id>:<part-number>` record.
+pub fn decode_part(bytes: &[u8]) -> Result<PartRecord, RecordError> {
+    decode_record("part:", bytes)
+}
+
+/// A committed part's **summary** — `psum:<upload-id>:<part-number>`, written in the same
+/// batch as the `part:` record it summarizes (`0016:352`). Everything about a part except
+/// its chunk list, so the cumulative staged-chunk check and `ListParts` read tens of bytes
+/// per part instead of the fat lists.
+#[derive(Debug, Clone, PartialEq, Eq, Serialize)]
+pub struct PartSummary {
+    /// How many chunks the part holds.
+    pub chunks: u32,
+    /// The part's length in bytes.
+    pub len: u64,
+    /// The part's content digest.
+    pub digest: Digest,
+    /// When the part committed.
+    pub committed_at_millis: u64,
+}
+
+#[derive(Deserialize)]
+struct PartSummaryWire {
+    chunks: u32,
+    len: u64,
+    digest: Digest,
+    committed_at_millis: u64,
+}
+
+/// **Validating decode**: the digest's shape is validated by [`Digest`], and a summary
+/// claiming bytes under no chunks (or chunks under no bytes) contradicts the `part:` record
+/// it was written beside in one batch. The summary is what the cumulative staged-chunk check
+/// and `ListParts` read *instead of* the part, so a self-contradicting one is a wrong answer
+/// nothing else re-checks.
+impl<'de> Deserialize<'de> for PartSummary {
+    fn deserialize<D: Deserializer<'de>>(deserializer: D) -> Result<Self, D::Error> {
+        let wire = PartSummaryWire::deserialize(deserializer)?;
+        if (wire.chunks == 0) != (wire.len == 0) {
+            return Err(DeError::custom(format!(
+                "part summary declares {} chunk(s) spanning {} B",
+                wire.chunks, wire.len
+            )));
+        }
+        Ok(Self {
+            chunks: wire.chunks,
+            len: wire.len,
+            digest: wire.digest,
+            committed_at_millis: wire.committed_at_millis,
+        })
+    }
+}
+
+/// Decode a `psum:<upload-id>:<part-number>` summary.
+pub fn decode_part_summary(bytes: &[u8]) -> Result<PartSummary, RecordError> {
+    decode_record("psum:", bytes)
+}
+
+// ===========================================================================
+// 8. The owned staging entry — `sidx:<id>:<part>:<chunk>` (`0016:442-491`)
+// ===========================================================================
+
+/// A chunk's **planned** EC placement, carried only on an **owned** `sidx:` entry
+/// ([`crate::metadata::PendingEntry::staged`], `0016:442-491`).
+///
+/// The same `(scheme, per-fragment D-server vector)` a committed [`ChunkRef`] carries,
+/// written at *intent* time — before any fragment reaches a D server — so a record-only
+/// reaper can compute the entry's `orphan:<dserver>:<chunk>:<index>` keys and a drain can
+/// count its fragments as held on a specific server without a live write plan in hand
+/// (`0016:459-473`).
+///
+/// **`placement`'s length is deliberately not checked here.** A placement whose length
+/// disagrees with its scheme's fragment count is a *contextual* check, and the standing
+/// convention puts contextual checks on the other side of the decode boundary (ADR-0045;
+/// `AGENTS.md:146-149` names placement length as **the** example): such a chunk is
+/// quarantined by GC's safety gate and attributed by the drain, which is strictly better
+/// than an error that aborts the whole reconcile step (`0016:502-517`).
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+pub struct StagedPlacement {
+    /// How the chunk is fragmented.
+    pub scheme: EcScheme,
+    /// The stable D-server id planned to hold each fragment, by fragment index.
+    pub placement: Vec<DServerId>,
+}
+
+/// The value under a `sidx:` key, with its two owned fields **present by type** rather than
+/// by convention (`0016:442-491`).
+///
+/// 0016 makes that value *be* a [`PendingEntry`] rather than a parallel type, so the same
+/// half-TTL renewal loop and the same `require(re-encode(prior))` lease guards serve an
+/// owned entry and an ordinary one (`crates/core/src/write.rs:474-500`,
+/// `metadata.rs:748-758`). `owner`/`staged` are therefore `Option`s on that shared record —
+/// and this type is where the pairing is *enforced*: an entry carrying exactly one of them
+/// is structurally impossible (no writer produces one), and admitting it as a value would
+/// leave a reader to guess whether an entry is owned. `pending:` and `sidx:` values are told
+/// apart by which decoder they go through, and this one refuses everything but an owned
+/// entry.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct OwnedEntry {
+    /// The owning session.
+    pub owner: UploadId,
+    /// When the lease expires (logical milliseconds).
+    pub lease_expiry_millis: u64,
+    /// The chunk's planned EC placement.
+    pub staged: StagedPlacement,
+}
+
+impl OwnedEntry {
+    /// The shared-record form this entry is stored as — the value a `sidx:` put writes and
+    /// the half-TTL renewal loop re-encodes.
+    pub fn to_pending(&self) -> PendingEntry {
+        PendingEntry {
+            lease_expiry_millis: self.lease_expiry_millis,
+            owner: Some(self.owner.clone()),
+            staged: Some(self.staged.clone()),
+        }
+    }
+
+    /// The validating view of a decoded [`PendingEntry`]: an owned entry carries **both**
+    /// optional fields, an ordinary `pending:` entry carries **neither**, and one of each is
+    /// a torn record refused rather than trusted.
+    pub fn from_pending(entry: &PendingEntry) -> Result<Self, RecordError> {
+        match (&entry.owner, &entry.staged) {
+            (Some(owner), Some(staged)) => Ok(Self {
+                owner: owner.clone(),
+                lease_expiry_millis: entry.lease_expiry_millis,
+                staged: staged.clone(),
+            }),
+            (None, None) => Err(structural(
+                "sidx:",
+                "an ordinary `pending:` entry (no owner, no staged placement) \
+                 is not an owned staging entry",
+            )),
+            (Some(_), None) => Err(structural(
+                "sidx:",
+                "an owned entry names an owner but no staged placement",
+            )),
+            (None, Some(_)) => Err(structural(
+                "sidx:",
+                "an owned entry carries a staged placement but no owner",
+            )),
+        }
+    }
+}
+
+/// Decode a `sidx:<upload-id>:<part-number>:<chunk-id>` owned staging entry.
+pub fn decode_owned_entry(bytes: &[u8]) -> Result<OwnedEntry, RecordError> {
+    OwnedEntry::from_pending(&decode_record::<PendingEntry>("sidx:", bytes)?)
+}
+
+// ===========================================================================
+// 9. Retirement obligation payloads (`0016:355-388`)
+// ===========================================================================
+
+/// A **range-encoded** part-number set (`0016:382-388`), so the common "every staged part
+/// was published" case is a few bytes and the worst case — 10,000 alternating numbers —
+/// still fits inside one value.
+///
+/// The encoding is **canonical and validated at decode**: coalesced, strictly ascending,
+/// non-adjacent runs of in-range part numbers. A derived `Deserialize` would admit reversed,
+/// overlapping and out-of-range runs, and each is a live defect rather than an aesthetic
+/// one — a reversed run underflows [`Self::len`], an unordered one makes
+/// [`Self::first_at_or_after`] (a drain cursor's "resume here" query) skip members, and a
+/// number past the key grammar names a `part:` record no parser can read back. A malformed
+/// obligation would then be *deleted* having reclaimed none of the parts it names.
+#[derive(Debug, Clone, Default, PartialEq, Eq, Serialize)]
+#[serde(transparent)]
+pub struct PartNumberSet(Vec<(u32, u32)>);
+
+impl PartNumberSet {
+    /// Build the set from any iterator of part numbers, coalescing contiguous runs.
+    pub fn from_numbers(numbers: impl IntoIterator<Item = PartNumber>) -> Self {
+        let sorted: std::collections::BTreeSet<u32> =
+            numbers.into_iter().map(PartNumber::get).collect();
+        let mut runs: Vec<(u32, u32)> = Vec::new();
+        for n in sorted {
+            match runs.last_mut() {
+                Some(last) if last.1 + 1 == n => last.1 = n,
+                _ => runs.push((n, n)),
+            }
+        }
+        Self(runs)
+    }
+
+    /// The validating constructor every decode routes through.
+    pub fn from_runs(runs: Vec<(u32, u32)>) -> Result<Self, RecordError> {
+        let mut previous_hi: Option<u32> = None;
+        for &(lo, hi) in &runs {
+            PartNumber::new(lo)?;
+            PartNumber::new(hi)?;
+            if lo > hi {
+                return Err(structural(
+                    "part-number set",
+                    format!("run [{lo}, {hi}] is reversed"),
+                ));
+            }
+            if let Some(previous) = previous_hi {
+                if lo <= previous + 1 {
+                    return Err(structural(
+                        "part-number set",
+                        format!(
+                            "run [{lo}, {hi}] overlaps or abuts the run ending at {previous}: \
+                             the encoding is coalesced, strictly ascending runs"
+                        ),
+                    ));
+                }
+            }
+            previous_hi = Some(hi);
+        }
+        Ok(Self(runs))
+    }
+
+    /// Whether the set names no part.
+    pub fn is_empty(&self) -> bool {
+        self.0.is_empty()
+    }
+
+    /// How many part numbers the set holds.
+    pub fn len(&self) -> u64 {
+        self.0
+            .iter()
+            .map(|(lo, hi)| u64::from(*hi) - u64::from(*lo) + 1)
+            .sum()
+    }
+
+    /// Whether `part_number` is in the set.
+    pub fn contains(&self, part_number: PartNumber) -> bool {
+        let n = part_number.get();
+        self.0.iter().any(|(lo, hi)| *lo <= n && n <= *hi)
+    }
+
+    /// Every part number in the set, ascending.
+    pub fn iter(&self) -> impl Iterator<Item = u32> + '_ {
+        self.0.iter().flat_map(|(lo, hi)| *lo..=*hi)
+    }
+
+    /// The smallest member `>= from` — a drain cursor's "resume here" query.
+    pub fn first_at_or_after(&self, from: u32) -> Option<u32> {
+        self.0
+            .iter()
+            .find(|(_, hi)| *hi >= from)
+            .map(|(lo, _)| (*lo).max(from))
+    }
+}
+
+impl<'de> Deserialize<'de> for PartNumberSet {
+    fn deserialize<D: Deserializer<'de>>(deserializer: D) -> Result<Self, D::Error> {
+        Self::from_runs(Vec::<(u32, u32)>::deserialize(deserializer)?).map_err(DeError::custom)
+    }
+}
+
+/// What one retirement obligation owes (`0016:355-356`). The **mode lives in the key**, not
+/// in a field, so a payload and its key's mode are cross-checked at decode rather than
+/// trusted ([`decode_retire_obligation`]).
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+pub enum RetirePayload {
+    /// `retire:bytes:` — a session teardown: orphan-mark every part the session still
+    /// holds, then delete the `part:`/`psum:` pairs that name them.
+    ///
+    /// **It carries no part list, deliberately.** A list frozen by the aborting caller is
+    /// read *before* its fence lands, so a part commit that wins the read-then-fence window
+    /// would be absent from it and its records would survive every teardown batch. The fence
+    /// makes the session's own `part:<id>:` range immutable, so the drain enumerates it **at
+    /// drain time** from the bounded range and is complete by construction, while the fence
+    /// batch stays O(1).
+    Session {},
+    /// `retire:bytes:` — the staged parts a Complete did **not** name, frozen under the
+    /// fence that already holds the part set immutable. One obligation that marks *then*
+    /// deletes, so no cross-obligation ordering can get it wrong (`0016:909-928`).
+    Parts {
+        /// The unnamed staged parts.
+        parts: PartNumberSet,
+    },
+    /// `retire:bytes:` — a specific chunk list with no naming record left: a losing writer's
+    /// compensation, or a post-staging local refusal.
+    Chunks {
+        /// The chunks to orphan-mark.
+        chunks: Vec<ChunkRef>,
+    },
+    /// `retire:bytes:` — a superseded or deleted object generation.
+    Generation {
+        /// The inode the generation belonged to.
+        inode: InodeId,
+        /// Its version.
+        version: u64,
+        /// Its flat chunk list, when it had one.
+        #[serde(default, skip_serializing_if = "Vec::is_empty")]
+        chunks: Vec<ChunkRef>,
+        /// Its `seg:` generation, when it was segmented — resolved page-wise at drain time,
+        /// never frozen here.
+        #[serde(default, skip_serializing_if = "Option::is_none")]
+        segments: Option<SegmentGroup>,
+    },
+    /// `retire:records:` — records to delete whose bytes are protected by something else:
+    /// the **published** parts (never the unnamed ones, `0016:909-928`), and/or one
+    /// rolled-back attempt's dangling segments.
+    Records {
+        /// The published parts whose records the publication superseded.
+        #[serde(default, skip_serializing_if = "Option::is_none")]
+        parts: Option<PartNumberSet>,
+        /// One attempt's dangling `seg:` generation.
+        #[serde(default, skip_serializing_if = "Option::is_none")]
+        segments: Option<SegmentGroup>,
+    },
+}
+
+impl RetirePayload {
+    /// The mode this payload may live under — the cross-check that makes "the mode lives in
+    /// the key" a checked boundary rather than a convention (`0016:434-440`). A `Records`
+    /// payload under `retire:bytes:` would orphan-mark bytes a live object still names; a
+    /// byte payload under `retire:records:` would delete the only records naming durable
+    /// bytes, with no evidence written.
+    pub const fn mode(&self) -> RetireMode {
+        match self {
+            Self::Records { .. } => RetireMode::Records,
+            Self::Session {}
+            | Self::Parts { .. }
+            | Self::Chunks { .. }
+            | Self::Generation { .. } => RetireMode::Bytes,
+        }
+    }
+
+    /// The **structural** rules a payload must satisfy to be actionable at all, checked at
+    /// decode rather than discovered as a drain that owes nothing:
+    ///
+    /// * a `Generation` naming **both** an inline chunk list and a `seg:` generation — the
+    ///   two are alternatives, and a drain that picked one arm would evidence half the
+    ///   payload and then delete the obligation;
+    /// * an **empty** `Chunks`, `Parts` or `Records` payload — an obligation that owes
+    ///   nothing is a producer bug, and admitting it lets that bug look like completed work.
+    fn validate(&self) -> Result<(), RecordError> {
+        let invalid = |reason: &str| Err(structural("retire:", reason.to_string()));
+        match self {
+            Self::Session {} => Ok(()),
+            Self::Chunks { chunks } if chunks.is_empty() => {
+                invalid("a retire:bytes:{chunks} obligation names no chunks")
+            }
+            Self::Chunks { .. } => Ok(()),
+            Self::Parts { parts } if parts.is_empty() => {
+                invalid("a retire:bytes:{parts} obligation names no parts")
+            }
+            Self::Parts { .. } => Ok(()),
+            Self::Generation {
+                chunks, segments, ..
+            } => {
+                if !chunks.is_empty() && segments.is_some() {
+                    return invalid(
+                        "a generation obligation names either a flat chunk list or a seg: \
+                         generation, never both",
+                    );
+                }
+                Ok(())
+            }
+            Self::Records { parts, segments } => {
+                if parts.is_none() && segments.is_none() {
+                    return invalid(
+                        "a retire:records: obligation names neither parts nor segments",
+                    );
+                }
+                if parts.as_ref().is_some_and(PartNumberSet::is_empty) {
+                    return invalid("a retire:records: obligation names an empty part set");
+                }
+                Ok(())
+            }
+        }
+    }
+}
+
+/// Decode a retirement obligation from **both halves of the record** — its key and its
+/// value — returning the token the key names and the payload the value carries.
+///
+/// The mode cross-check is the point: `retire:bytes:` orphan-marks fragments and
+/// `retire:records:` must never orphan anything, so a payload found under the wrong prefix
+/// is an error at decode, never a default the drain would act on (`0016:434-440`).
+pub fn decode_retire_obligation(
+    key: &[u8],
+    value: &[u8],
+) -> Result<(RetireToken, RetirePayload), RecordError> {
+    let (mode, token) = parse_retire_key(key)?;
+    let payload: RetirePayload = decode_record("retire:", value)?;
+    payload.validate()?;
+    if payload.mode() != mode {
+        return Err(structural(
+            "retire:",
+            format!(
+                "a {:?}-mode payload is stored under the {:?} prefix",
+                payload.mode(),
+                mode
+            ),
+        ));
+    }
+    Ok((token, payload))
+}
+
+// ===========================================================================
+// 10. The ETag composition and the Complete request-identity fingerprint
+//     (ADR-0047; `0016:898-908`,`:3064-3070`)
+// ===========================================================================
+
+/// The parts a Complete named, in the **canonical** order both digests below are defined
+/// over: **ascending part number**, each number named once.
+///
+/// One definition, used by [`multipart_etag`] **and** [`complete_fingerprint`], so the ETag
+/// an object is published with and the fingerprint its tombstone answers a retry on can
+/// never disagree about what "the parts the client named" means. Sorting *here* rather than
+/// trusting the caller is what makes both functions pure functions of the **set** of named
+/// parts: a client that lists the same assembly in a different order gets the same object
+/// and the same idempotent answer, and a client that names one part twice gets an error
+/// instead of an ETag that depends on which duplicate survived.
+fn canonical_named_parts(
+    named: &[(PartNumber, Digest)],
+) -> Result<Vec<(u32, Digest)>, RecordError> {
+    if named.is_empty() {
+        return Err(RecordError::NoPartsNamed);
+    }
+    let mut ordered: BTreeMap<u32, Digest> = BTreeMap::new();
+    for (part_number, digest) in named {
+        if ordered.insert(part_number.get(), *digest).is_some() {
+            return Err(RecordError::DuplicatePart {
+                part_number: part_number.get(),
+            });
+        }
+    }
+    Ok(ordered.into_iter().collect())
+}
+
+/// A composed **multipart ETag**: `<64 lowercase hex>-<N>`, a validated type so a stored
+/// [`Completion`] can never carry a spelling a client comparison would treat as a different
+/// object.
+#[derive(Debug, Clone, PartialEq, Eq, Hash)]
+pub struct MultipartEtag {
+    composed: Digest,
+    parts: u32,
+}
+
+impl MultipartEtag {
+    /// The validating parser — the inverse of [`fmt::Display`]: 64 lowercase-hex characters,
+    /// a `-`, then the **canonical** decimal part count (no `+`, no leading zero, non-zero).
+    pub fn parse(text: &str) -> Result<Self, RecordError> {
+        let malformed = || RecordError::DigestNotHex {
+            digest: text.to_string(),
+        };
+        let (hex, count) = text.rsplit_once('-').ok_or_else(malformed)?;
+        let parts: u32 = canonical_decimal(count).ok_or_else(malformed)?;
+        if parts == 0 {
+            return Err(RecordError::NoPartsNamed);
+        }
+        Ok(Self {
+            composed: Digest::from_hex(hex)?,
+            parts,
+        })
+    }
+
+    /// The SHA-256 over the concatenated raw part digests.
+    pub const fn composed(&self) -> Digest {
+        self.composed
+    }
+
+    /// How many parts the object was assembled from — the `-N` suffix.
+    pub const fn parts(&self) -> u32 {
+        self.parts
+    }
+}
+
+impl fmt::Display for MultipartEtag {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        write!(f, "{}-{}", self.composed, self.parts)
+    }
+}
+
+impl Serialize for MultipartEtag {
+    fn serialize<S: serde::Serializer>(&self, serializer: S) -> Result<S::Ok, S::Error> {
+        serializer.serialize_str(&self.to_string())
+    }
+}
+
+impl<'de> Deserialize<'de> for MultipartEtag {
+    fn deserialize<D: Deserializer<'de>>(deserializer: D) -> Result<Self, D::Error> {
+        Self::parse(&String::deserialize(deserializer)?).map_err(DeError::custom)
+    }
+}
+
+/// The **multipart ETag** — the composition this slice settles on top of ADR-0047's basis,
+/// which closed the digest algorithm and deferred only the composition
+/// (`docs/design/adr/0047-object-metadata-model.md:73-89`,`:112`; `0016:3064-3070`):
+///
+/// ```text
+/// etag = lowercase_hex( SHA-256( d_1 || d_2 || ... || d_N ) ) + "-" + N
+/// ```
+///
+/// where `d_i` is the **raw 32 binary digest bytes** — never their hex text, no separators,
+/// no part numbers mixed in — of the *i*-th part in **ascending part-number order over
+/// exactly the parts the caller named**, and `N` is that count. The ordering is applied
+/// *here* ([`canonical_named_parts`]), not delegated to the caller, so no caller can publish
+/// an object whose ETag depends on the order it happened to list.
+///
+/// **Never MD5.** S3's own multipart ETag is an MD5-of-MD5s; Wyrd's change token is
+/// SHA-256-based (ADR-0047 rejected re-opening the dependency wall for a legacy equality S3
+/// itself does not guarantee), and the value is opaque to clients — compared for equality
+/// only — so the composition follows the basis rather than the wire folklore.
+pub fn multipart_etag(named: &[(PartNumber, Digest)]) -> Result<MultipartEtag, RecordError> {
+    let ordered = canonical_named_parts(named)?;
+    let mut hasher = Sha256::new();
+    for (_, digest) in &ordered {
+        hasher.update(digest.as_bytes());
+    }
+    Ok(MultipartEtag {
+        composed: Digest::from_bytes(hasher.finalize().into()),
+        parts: ordered.len() as u32,
+    })
+}
+
+/// The **request identity** a `Completed` tombstone answers a retry on — a digest over the
+/// ordered `(part_number, digest)` pairs the winning Complete named (`0016:898-908`).
+///
+/// Separate from [`multipart_etag`], deliberately: the ETag is a function of the digests
+/// alone, so two different part *numberings* of the same bodies would collide in it. The
+/// fingerprint mixes the numbers in, so a client that reuses an upload id with a **different
+/// assembly** is answered `NoSuchUpload` — the honest answer — rather than being told *its*
+/// assembly succeeded while the store holds an earlier one, a silent wrong answer that is
+/// worse than any error.
+///
+/// Both fields are fixed width (4 bytes of part number, 32 of digest) and the pair count is
+/// hashed first, so the encoding is injective: no crafted input can impersonate a different
+/// part list.
+pub fn complete_fingerprint(named: &[(PartNumber, Digest)]) -> Result<Digest, RecordError> {
+    let ordered = canonical_named_parts(named)?;
+    let mut hasher = Sha256::new();
+    hasher.update((ordered.len() as u64).to_be_bytes());
+    for (part_number, digest) in &ordered {
+        hasher.update(part_number.to_be_bytes());
+        hasher.update(digest.as_bytes());
+    }
+    Ok(Digest::from_bytes(hasher.finalize().into()))
+}
+
+// ===========================================================================
+// 11. Typed refusals — every non-success answer is a value, never "an error"
+//     (`0016:969-978`; the S3 status/XML mapping is #508's)
+// ===========================================================================
+
+/// Why a part a Complete named is invalid (`0016:993-999`).
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum InvalidPart {
+    /// The named part has no `part:` record — never committed, or superseded.
+    Absent,
+    /// The named part's recorded digest is not the one the client named.
+    DigestMismatch,
+    /// The named parts are not in strictly ascending part-number order.
+    OutOfOrder,
+}
+
+/// Which ceiling produced a backpressure refusal — designed behaviour, not a failure
+/// (`0016:129-136`).
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum Backpressure {
+    /// The fleet admission ledger is at its stored `max_sessions`.
+    SessionCap {
+        /// The live session count the ledger records.
+        count: u64,
+        /// The limit **the ledger** was checked against — never a local derivation.
+        max_sessions: u64,
+    },
+    /// Every `MAX_INFLIGHT_PARTS` slot index of this session is taken — by live parts, or by
+    /// the residue of parts that crashed mid-stream and never released their slot, which is
+    /// deliberately *counted* rather than invisible (`0016:349`, F11a).
+    InflightParts {
+        /// The size of the session's slot key space.
+        max_inflight_parts: u32,
+    },
+    /// The create lost the serialized admission CAS this many times.
+    AdmissionContention {
+        /// Attempts spent.
+        attempts: u32,
+    },
+}
+
+/// A **typed** protocol answer other than success. #508 maps each to its S3 status and error
+/// code; this slice pins the answers and names no status code.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum Refusal {
+    /// No session can serve this request: the upload id is unknown, the session is aborting,
+    /// or it already completed a **different** assembly.
+    NoSuchUpload,
+    /// The target bucket has no `bucket:` record (ADR-0046 §4).
+    NoSuchBucket,
+    /// The session is fenced into `Completing` by a publisher that still owns it. There is
+    /// **no** client path that resumes a `Completing` session (`0016:980-986`).
+    OperationAborted,
+    /// The named part list does not match the frozen part set. The fence is **released**
+    /// before this is answered, so a client typo never wedges a session (`0016:993-999`).
+    InvalidPart {
+        /// The offending part number.
+        part_number: PartNumber,
+        /// What was wrong with it.
+        reason: InvalidPart,
+    },
+    /// A part, or the session's cumulative staged chunks, is past a ceiling the protocol
+    /// enforces by **refusal** rather than by an over-envelope commit. The session stays
+    /// usable and abortable, and anything already staged is compensated.
+    EntityTooLarge {
+        /// The chunk count the request would have installed.
+        chunks: u64,
+        /// The ceiling it crossed.
+        limit: u64,
+    },
+    /// Designed backpressure.
+    SlowDown {
+        /// Which ceiling engaged.
+        pressure: Backpressure,
+    },
+    /// This process's [`Budget`] disagrees with the one stored in `mpuctl`, so it **refuses
+    /// to admit and alarms** rather than silently deferring to either value — a fail-closed
+    /// configuration-skew signal, since equal quotients can hide unequal footprints
+    /// (`0016:348`).
+    ProfileSkew {
+        /// What this process derives from its own configuration.
+        local: Box<Budget>,
+        /// What the ledger records.
+        ledger: Box<Budget>,
+    },
+    /// The session has spent all `MAX_COMPLETE_ATTEMPTS` fences; its only exit is Abort
+    /// (`0016:1477`).
+    CompleteAttemptsExhausted,
+}
+
+/// What a winning (or recorded) publication established.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Publication {
+    /// The inode the object key resolves to.
+    pub inode: InodeId,
+    /// The version the flip recorded — `prior.version + 1` computed from the **re-read**
+    /// prior at that attempt, never a fence-frozen number (`0016:925-932`).
+    pub version: u64,
+    /// The composed multipart ETag.
+    pub etag: MultipartEtag,
+    /// The publication instant.
+    pub completed_at_millis: u64,
+}
+
+impl Publication {
+    /// The publication a `Completed` tombstone recorded.
+    pub fn of(completion: &Completion) -> Self {
+        Self {
+            inode: completion.inode,
+            version: completion.version,
+            etag: completion.etag.clone(),
+            completed_at_millis: completion.completed_at_millis,
+        }
+    }
+}
+
+/// What `CreateMultipartUpload` answered (#656).
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum CreateOutcome {
+    /// A session record and its `seggrp:` reservation are durable and the admission counter
+    /// has been incremented exactly once.
+    Created {
+        /// The session's id.
+        upload_id: UploadId,
+    },
+    /// A typed refusal.
+    Refused(Refusal),
+}
+
+/// What a slot reservation answered (#657).
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum ReserveOutcome {
+    /// An in-flight slot index is held by this attempt.
+    Reserved {
+        /// The index claimed.
+        index: SlotIndex,
+        /// The attempt holding it.
+        attempt_id: AttemptId,
+    },
+    /// A typed refusal.
+    Refused(Refusal),
+}
+
+/// What `UploadPart` answered (#657).
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum UploadPartOutcome {
+    /// The part is durable: its `part:` + `psum:` records exist, its slot is released and
+    /// its owned `sidx:` entries are gone — all in one batch.
+    Committed {
+        /// The part number.
+        part_number: PartNumber,
+        /// Its content digest.
+        digest: Digest,
+    },
+    /// A typed refusal. Anything this attempt staged has been **compensated** whenever the
+    /// session was still live enough to own the cleanup.
+    Refused(Refusal),
+}
+
+/// What `CompleteMultipartUpload` answered (#658).
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum CompleteOutcome {
+    /// The object is published: this call's flip won.
+    Published(Box<Publication>),
+    /// A `Completed` tombstone answered an **identical** retry inside its window, with the
+    /// **recorded** ETag (`0016:898-908`).
+    AlreadyCompleted(Box<Publication>),
+    /// A typed refusal; nothing was published and the session is not left fenced.
+    Refused(Refusal),
+}
+
+/// What `AbortMultipartUpload` answered (#656).
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum AbortOutcome {
+    /// The fence landed: the session is `Aborting` and its teardown obligation is durable.
+    /// **This is the response** — byte reclamation is the drain's, asynchronously, so a
+    /// 10,000-part teardown never rides inside one request (`0016:1000-1003`).
+    Fenced,
+    /// The session was already `Aborting` — idempotent success.
+    AlreadyAborting,
+    /// A typed refusal.
+    Refused(Refusal),
+}
+
+// ===========================================================================
+// 12. Decision 3 — the verb x state answer table, as total pure functions
+//     (`0016:894-1037`, the table at `0016:969-978`)
+// ===========================================================================
+
+/// The five multipart verbs decision 3 answers (`0016:969-978`).
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
+pub enum Verb {
+    /// Stage one part's bytes against an `Open` session.
+    UploadPart,
+    /// Fence and assemble the named parts into the published object.
+    CompleteMultipartUpload,
+    /// Fence for teardown without publishing.
+    AbortMultipartUpload,
+    /// List the parts staged (or frozen) under one session.
+    ListParts,
+    /// List the fleet's in-progress sessions.
+    ListMultipartUploads,
+}
+
+impl Verb {
+    /// Every verb the table answers. Adding one without extending this widens the product
+    /// the answer table is asserted total over, so a new verb cannot be added silently.
+    pub const ALL: [Self; 5] = [
+        Self::UploadPart,
+        Self::CompleteMultipartUpload,
+        Self::AbortMultipartUpload,
+        Self::ListParts,
+        Self::ListMultipartUploads,
+    ];
+}
+
+/// What `UploadPart` answers in a state (`0016:971`).
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum UploadPartAnswer {
+    /// The session is `Open`: the part is accepted.
+    Accepted,
+    /// A typed refusal.
+    Refused(Refusal),
+}
+
+/// What `CompleteMultipartUpload` answers in a state (`0016:972`).
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum CompleteAnswer {
+    /// The session is `Open`: this call may fence and publish.
+    Fences,
+    /// A `Completed` tombstone whose recorded `complete_fingerprint` **matches** the
+    /// request's: the identical retry is answered with the **recorded** publication
+    /// (`0016:898-908`).
+    AlreadyCompleted(Box<Publication>),
+    /// A typed refusal.
+    Refused(Refusal),
+}
+
+/// What `AbortMultipartUpload` answers in a state (`0016:973`).
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum AbortAnswer {
+    /// The session is `Open`: the fence commit **is** the response.
+    Fences,
+    /// The session is already `Aborting`: idempotent success.
+    AlreadyAborting,
+    /// A typed refusal.
+    Refused(Refusal),
+}
+
+/// What `ListParts` answers in a state (`0016:974`).
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum ListPartsAnswer {
+    /// The session is `Open`: the still-growing part set.
+    OpenSet,
+    /// The session is `Completing`: the frozen part set the fence read.
+    FrozenSet,
+    /// A typed refusal.
+    Refused(Refusal),
+}
+
+/// Whether `ListMultipartUploads` lists this session (`0016:975`).
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum ListUploadsAnswer {
+    /// In progress: listed.
+    Listed,
+    /// Tearing down or torn down: not listed.
+    NotListed,
+}
+
+/// One cell of decision 3's table, so the whole verb x state product can be enumerated
+/// through a single entry point ([`answer`]) and asserted **total**.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum Answer {
+    /// `UploadPart`'s answer.
+    UploadPart(UploadPartAnswer),
+    /// `CompleteMultipartUpload`'s answer.
+    Complete(CompleteAnswer),
+    /// `AbortMultipartUpload`'s answer.
+    Abort(AbortAnswer),
+    /// `ListParts`' answer.
+    ListParts(ListPartsAnswer),
+    /// `ListMultipartUploads`' answer.
+    ListUploads(ListUploadsAnswer),
+}
+
+/// What `UploadPart` answers against `state` (`None` = the record is absent).
+///
+/// A part accepted after the fence would be invisible to the publication that already read
+/// the set — a silently lost part — so every state but `Open` refuses (`0016:1029`).
+pub fn upload_part_answer(state: Option<SessionState>) -> UploadPartAnswer {
+    match state {
+        Some(SessionState::Open) => UploadPartAnswer::Accepted,
+        Some(SessionState::Completing | SessionState::Aborting | SessionState::Completed)
+        | None => UploadPartAnswer::Refused(Refusal::NoSuchUpload),
+    }
+}
+
+/// What `CompleteMultipartUpload` answers against `session` (`None` = the record is absent),
+/// for a request whose named parts fingerprint to `request_fingerprint`.
+///
+/// The tombstone cell is the one 0016 spends most words on, and the **only** cell with a
+/// condition: within its window a `Completed` session answers the recorded publication when
+/// the request's [`complete_fingerprint`] matches the recorded one, and `NoSuchUpload` when
+/// it does not — the honest answer, since the upload id is consumed and no session exists
+/// that could publish the assembly being asked for. It must be idempotence keyed on
+/// **request identity**, not on the upload id alone (`0016:898-908`).
+///
+/// The match is computed here from the stored record rather than accepted as a caller's
+/// boolean, so no caller can turn a different assembly into an identical retry.
+pub fn complete_answer(
+    session: Option<&SessionRecord>,
+    request_fingerprint: &Digest,
+) -> CompleteAnswer {
+    let Some(session) = session else {
+        return CompleteAnswer::Refused(Refusal::NoSuchUpload);
+    };
+    match session.state {
+        SessionState::Open => CompleteAnswer::Fences,
+        SessionState::Completing => CompleteAnswer::Refused(Refusal::OperationAborted),
+        SessionState::Aborting => CompleteAnswer::Refused(Refusal::NoSuchUpload),
+        SessionState::Completed => match &session.completion {
+            Some(completion) if completion.complete_fingerprint == *request_fingerprint => {
+                CompleteAnswer::AlreadyCompleted(Box::new(Publication::of(completion)))
+            }
+            // A `Completed` session without a completion cannot decode (§6), so the arm is
+            // reachable only for a hand-built value; it refuses rather than assuming a match.
+            _ => CompleteAnswer::Refused(Refusal::NoSuchUpload),
+        },
+    }
+}
+
+/// What `AbortMultipartUpload` answers against `state` (`None` = the record is absent).
+///
+/// `Completing` is `409` for **every** client verb including this one: an Abort that could
+/// preempt a live publisher would race the flip it is fencing against (`0016:980-986`).
+pub fn abort_answer(state: Option<SessionState>) -> AbortAnswer {
+    match state {
+        Some(SessionState::Open) => AbortAnswer::Fences,
+        Some(SessionState::Completing) => AbortAnswer::Refused(Refusal::OperationAborted),
+        Some(SessionState::Aborting) => AbortAnswer::AlreadyAborting,
+        Some(SessionState::Completed) | None => AbortAnswer::Refused(Refusal::NoSuchUpload),
+    }
+}
+
+/// What `ListParts` answers against `state` (`None` = the record is absent).
+pub fn list_parts_answer(state: Option<SessionState>) -> ListPartsAnswer {
+    match state {
+        Some(SessionState::Open) => ListPartsAnswer::OpenSet,
+        Some(SessionState::Completing) => ListPartsAnswer::FrozenSet,
+        Some(SessionState::Aborting | SessionState::Completed) | None => {
+            ListPartsAnswer::Refused(Refusal::NoSuchUpload)
+        }
+    }
+}
+
+/// Whether `ListMultipartUploads` lists a session in `state` (`None` = the record is
+/// absent). A session the reaper fenced at `W_session` is `Aborting`, so it drops out of the
+/// listing — the S3-visible signal that the upload expired.
+pub fn list_uploads_answer(state: Option<SessionState>) -> ListUploadsAnswer {
+    match state {
+        Some(SessionState::Open | SessionState::Completing) => ListUploadsAnswer::Listed,
+        Some(SessionState::Aborting | SessionState::Completed) | None => {
+            ListUploadsAnswer::NotListed
+        }
+    }
+}
+
+/// Decision 3's answer table (`0016:969-978`) as **one total pure function** over the 5-verb
+/// x 5-state product — `Open`/`Completing`/`Aborting`/`Completed`/absent.
+///
+/// `request_fingerprint` is consulted **only** for the one conditional cell
+/// (`CompleteMultipartUpload` against a `Completed` tombstone) and ignored everywhere else,
+/// so the function can be called uniformly over the whole product; an absent one cannot
+/// match any recorded fingerprint, which is the honest answer for a Complete that named no
+/// parts at all.
+///
+/// Every match below is exhaustive, so answering a new (verb, state) cell is a compile-time
+/// obligation rather than a silent gap; [`Verb::ALL`] and [`SessionState::ALL`] make the
+/// same obligation visible to the table test.
+pub fn answer(
+    verb: Verb,
+    session: Option<&SessionRecord>,
+    request_fingerprint: Option<&Digest>,
+) -> Answer {
+    let state = session.map(|session| session.state);
+    match verb {
+        Verb::UploadPart => Answer::UploadPart(upload_part_answer(state)),
+        Verb::CompleteMultipartUpload => Answer::Complete(match request_fingerprint {
+            Some(fingerprint) => complete_answer(session, fingerprint),
+            None => match state {
+                Some(SessionState::Open) => CompleteAnswer::Fences,
+                Some(SessionState::Completing) => {
+                    CompleteAnswer::Refused(Refusal::OperationAborted)
+                }
+                Some(SessionState::Aborting | SessionState::Completed) | None => {
+                    CompleteAnswer::Refused(Refusal::NoSuchUpload)
+                }
+            },
+        }),
+        Verb::AbortMultipartUpload => Answer::Abort(abort_answer(state)),
+        Verb::ListParts => Answer::ListParts(list_parts_answer(state)),
+        Verb::ListMultipartUploads => Answer::ListUploads(list_uploads_answer(state)),
+    }
+}
