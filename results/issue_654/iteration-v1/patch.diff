+        (RetireMode::Bytes, &session),
+        (RetireMode::Bytes, &session_with_part),
+        (RetireMode::Bytes, &generation),
+        (RetireMode::Records, &session),
+        (RetireMode::Records, &session_with_part),
+        (RetireMode::Records, &generation),
+    ] {
+        let key = retire_key(mode, token);
+        let (parsed_mode, parsed_token) = parse_retire_key(&key).unwrap();
+        assert_eq!(parsed_mode, mode);
+        assert_eq!(&parsed_token, token);
+    }
