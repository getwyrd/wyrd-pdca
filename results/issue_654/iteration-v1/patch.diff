index 0000000..4b57767
--- /dev/null
+++ b/crates/core/src/multipart.rs
@@ -0,0 +1,1158 @@
+//! The **multipart commit protocol**'s record family and state machine — the pure
+//! vocabulary underneath `CompleteMultipartUpload` (proposal 0016,
+//! `docs/design/proposals/draft/0016-multipart-commit-protocol.md`).
+//!
+//! This is slice 1 of 7 of issue #636's re-split (issue #654). It is deliberately **pure**:
+//! no [`wyrd_traits::MetadataStore`] call, no `WriteBatch`, no `async fn`. After this module
+//! a reader can name every record the protocol writes (`0016` §1, `:333-527`), parse every
+//! key it uses, decide what any verb answers in any state (`0016` decision 3, `:894-1037`),
+//! and compute an object's multipart ETag (`0016:3064-3070`) — all without a store. The
+//! store round trips (admission, staging, Complete, retirement) are five later, separately
+//! reviewed slices (#656-#660); the S3 verbs/XML/status mapping is #508's.
+//!
+//! # The records (`0016` §1)
+//!
+//! | Key | What it is |
+//! |---|---|
+//! | `mpuctl` | the fleet **admission ledger** — `{count, max_sessions, profile}`, CAS'd whole |
+//! | `mpu:<id>` | one **session**: target, state, epoch, attempts, publication |
+//! | `slot:<id>:<k>` | one **in-flight part slot**; the key space *is* the per-session cap |
+//! | `part:<id>:<n>` | a **committed part**: its chunk list, length and digest |
+//! | `psum:<id>:<n>` | that part's **summary** (no chunk list) |
+//! | `sidx:<id>:<n>:<chunk>` | one **owned staging entry** — a [`crate::metadata::PendingEntry`] with `owner` **and** `staged`, under a prefix **disjoint from `pending:`** |
+//! | `retire:bytes:<token>` | a **retirement obligation**: bytes to orphan-mark, then the naming records to delete |
+//! | `retire:records:<token>` | records to delete whose bytes something else protects |
+//!
+//! Every prefix here is disjoint from every other and from `inode:` / `dirent:` / `pending:`
+//! / `bucket:` / `orphan:` / `seg:` / `seggrp:` / `desired:dserver:`, and none is a prefix of
+//! another, so no `scan` returns a neighbour's records (`0016:333-356`).
+//!
+//! # What this slice does NOT define (§ Scope boundaries, settled at Plan)
+//!
+//! * **Capacity knobs.** [`Budget`] is the profile **tuple's shape** and its two pure
+//!   derivations ([`Budget::u_ref`], [`Budget::max_sessions`]); the deployment's concrete
+//!   values (`W_ref`, `MAX_PART_CHUNKS`, …) are #655's, mirroring the format/capacity split
+//!   `SEG_INDEX_WIDTH`/`MAX_SEGMENT_INDEX` vs `MAX_ROOT_SEGMENTS` already draws in
+//!   [`crate::metadata`] (`metadata.rs:270-322`).
+//! * **The retirement obligation's payload.** This slice owns the `retire:bytes:` /
+//!   `retire:records:` **key grammar** ([`RetireMode`], [`RetireToken`], [`retire_key`],
+//!   [`parse_retire_key`]) — the record CLASS and its addressing — because leg 2's
+//!   disjointness property and leg 1's canonical-key property need it. The obligation's JSON
+//!   **payload** (which parts/chunks/segments it names) is retirement-drain machinery
+//!   (#659); it is not in the Salvage citation list this brief hands Do (`brief.md`
+//!   "Peer callsites Do MAY open") and is left there deliberately — see `build-notes.md`.
+//! * **Capacity enforcement at decode.** A record past a *capacity* ceiling (as opposed to
+//!   past its *format*'s addressable key space) still decodes — decoding enforces only the
+//!   compile-time format bound, never a live knob, mirroring `MAX_ROOT_SEGMENTS`'s NOT being
+//!   a decode invariant (`metadata.rs:312-321`; `0016:390-402`).
+//!
+//! `sha2` is added to `crates/core` for [`multipart_etag`] / [`complete_fingerprint`]. It is
+//! not a new dependency decision: `sha2 = "0.11"` is already a workspace dependency
+//! (`Cargo.toml:147`), already used by `gateway-s3`/`server`, and already inside the
+//! `deny.toml` allowlist — so ADR-0003's three-test audit is not re-opened.
+
+use serde::de::Error as DeError;
+use serde::{Deserialize, Deserializer, Serialize};
+use sha2::{Digest, Sha256};
+
+use crate::metadata::{self, ChunkRef, EcScheme, InodeId};
+
+// ===========================================================================
+// 0. The staged placement — the extra shape `sidx:` needs on `PendingEntry`
+// ===========================================================================
+
+/// A chunk's **planned** EC placement, carried only on an **owned** `sidx:` entry
+/// (`crate::metadata::PendingEntry::staged`, `0016:442-491`).
+///
+/// The same `(scheme, per-fragment D-server vector)` a committed [`ChunkRef`] carries. It is
+/// written into `staged` **at intent time** (before any fragment reaches a D server) so a
+/// record-only reaper can compute the entry's `orphan:<dserver>:<chunk>:<index>` keys without
+/// a live write plan in hand (`0016:459-473`, the iteration-4 finding). Defined here, not in
+/// `crate::metadata`, because that file's only allowance this slice is the two `PendingEntry`
+/// fields themselves (`brief.md` § Scope) — `PendingEntry::staged` names this type by its
+/// full path.
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+pub struct StagedPlacement {
+    /// How the chunk is fragmented.
+    pub scheme: EcScheme,
+    /// The stable D-server id planned to hold each fragment, by fragment index.
+    pub placement: Vec<wyrd_traits::DServerId>,
+}
+
+// ===========================================================================
+// 1. Keys and their canonical parsers — structural validity at decode, never defaulted
+//    (ADR-0045; `0016:390-414`)
+// ===========================================================================
+
+/// The singleton admission-ledger key (`0016:348`). Never deleted; an absent record reads
+/// as `{count: 0}` (a later slice's concern — this module states only the record shape).
+pub const MPUCTL_KEY: &[u8] = b"mpuctl";
+
+/// Key prefix for session records. The trailing `:` is what keeps this **disjoint from
+/// [`MPUCTL_KEY`]** — `"mpuctl".starts_with(MPU_PREFIX)` is `false` because `mpuctl`'s 4th
+/// byte is `c`, not `:` — so `scan(MPU_PREFIX)` can never return the admission singleton
+/// (`0016:342-344`, the leg-2 near-miss the brief names by name).
+pub const MPU_PREFIX: &[u8] = b"mpu:";
+/// Key prefix for in-flight part slots.
+pub const SLOT_PREFIX: &[u8] = b"slot:";
+/// Key prefix for committed part records.
+pub const PART_PREFIX: &[u8] = b"part:";
+/// Key prefix for committed part summaries.
+pub const PSUM_PREFIX: &[u8] = b"psum:";
+/// Key prefix for owned staging entries — **disjoint from `pending:`**, which is the whole
+/// point of the class (`0016:1529-1536`, `:475-491`).
+pub const SIDX_PREFIX: &[u8] = b"sidx:";
+/// Key prefix for byte-mode retirement obligations: orphan-mark, then delete the naming
+/// records (`0016:355`).
+pub const RETIRE_BYTES_PREFIX: &[u8] = b"retire:bytes:";
+/// Key prefix for record-mode retirement obligations: delete records only — never
+/// orphan-mark (`0016:356`).
+pub const RETIRE_RECORDS_PREFIX: &[u8] = b"retire:records:";
+
+/// The decimal width a `slot:` key's index is zero-padded to, so byte-lexicographic key
+/// order equals index order — the precedent `metadata.rs:270-273` states for
+/// `SEG_INDEX_WIDTH`, mirrored here for this slice's own key space (§ Scope boundary 1).
+pub const SLOT_INDEX_WIDTH: usize = 6;
+
+/// One past the largest index the `slot:` key grammar can address — a **format** bound
+/// (a compile-time constant of the encoding), never the live `MAX_INFLIGHT_PARTS` knob
+/// (`0016:390-402`; that knob is #655's and is enforced where a slot is *reserved*, not at
+/// decode).
+pub const SLOT_INDEX_FORMAT_MAX: u32 = 1_000_000;
+
+/// The decimal width a part number is zero-padded to in `part:` / `psum:` / `sidx:` keys, so
+/// a range read returns parts in part-number order.
+pub const PART_NUMBER_WIDTH: usize = 5;
+
+/// One past the largest part number the fixed-width grammar can spell — the **format**
+/// maximum (`0016:390-402`), not S3's live `MAX_PARTS_PER_SESSION` (#655's).
+pub const PART_NUMBER_FORMAT_MAX: u32 = 100_000;
+
+/// A 128-bit random token's canonical textual length: lowercase hex (`0016:493-497`).
+/// Reused from [`crate::metadata::SEG_NONCE_HEX_LEN`] rather than restated, since an
+/// upload id, an attempt id and a segment-group nonce are all the same 128-bit-token shape.
+const TOKEN_HEX_LEN: usize = metadata::SEG_NONCE_HEX_LEN;
+
+/// A structural violation of a multipart **key** — every variant an error, never a
+/// silently-corrected default (ADR-0045; `0016:390-414`).
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum RecordError {
+    /// A key whose prefix, field count or field syntax does not parse — including a key
+    /// whose bytes are not UTF-8.
+    MalformedKey {
+        /// The namespace expected.
+        namespace: &'static str,
+        /// The key as UTF-8 (lossy), for the operator signal.
+        key: String,
+    },
+    /// A token component (upload id, attempt id, segment-group nonce) that is not exactly
+    /// [`TOKEN_HEX_LEN`] lowercase-hex characters.
+    TokenNotHex {
+        /// The rejected token.
+        token: String,
+    },
+    /// A `slot:` index outside `[0, SLOT_INDEX_FORMAT_MAX)` — unreachable from a
+    /// well-formed [`SLOT_INDEX_WIDTH`]-digit spelling (kept as a defensive named case,
+    /// mirroring `metadata.rs`'s `ChunkMapError::SegmentIndexUnaddressable`).
+    SlotIndexOutOfRange {
+        /// The index found.
+        index: u64,
+    },
+    /// A `part:`/`psum:`/`sidx:` part number outside `[1, PART_NUMBER_FORMAT_MAX)`.
+    PartNumberOutOfRange {
+        /// The number found.
+        part_number: u64,
+    },
+    /// A `retire:` key whose mode component is neither `bytes` nor `records`
+    /// (`0016:434-440`).
+    UnknownRetireMode {
+        /// The mode as read.
+        mode: String,
+    },
+}
+
+impl std::fmt::Display for RecordError {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        match self {
+            Self::MalformedKey { namespace, key } => {
+                write!(f, "malformed {namespace} key {key:?}")
+            }
+            Self::TokenNotHex { token } => write!(
+                f,
+                "{token:?} is not {TOKEN_HEX_LEN} lowercase-hex characters (a 128-bit token)"
+            ),
+            Self::SlotIndexOutOfRange { index } => write!(
+                f,
+                "slot index {index} is outside the format bound [0, {SLOT_INDEX_FORMAT_MAX})"
+            ),
+            Self::PartNumberOutOfRange { part_number } => write!(
+                f,
+                "part number {part_number} is outside the format bound [1, {PART_NUMBER_FORMAT_MAX})"
+            ),
+            Self::UnknownRetireMode { mode } => write!(
+                f,
+                "retire: key mode {mode:?} is neither `bytes` nor `records`"
+            ),
+        }
+    }
+}
+
+impl std::error::Error for RecordError {}
+
+fn malformed_key(namespace: &'static str, key: &[u8]) -> RecordError {
+    RecordError::MalformedKey {
+        namespace,
+        key: String::from_utf8_lossy(key).into_owned(),
+    }
+}
+
+/// Whether `token` is a well-formed 128-bit token: exactly [`TOKEN_HEX_LEN`] lowercase-hex
+/// characters (`0016:493-497`). Rejects an empty string, a short/long token, uppercase hex,
+/// and — because `:` is never a hex digit — a token that embeds the key separator.
+pub fn is_token(token: &str) -> bool {
+    token.len() == TOKEN_HEX_LEN
+        && token
+            .bytes()
+            .all(|b| b.is_ascii_digit() || (b'a'..=b'f').contains(&b))
+}
+
+fn require_token(token: &str) -> Result<(), RecordError> {
+    if is_token(token) {
+        Ok(())
+    } else {
+        Err(RecordError::TokenNotHex {
+            token: token.to_string(),
+        })
+    }
+}
+
+/// A `u64` in **canonical** decimal: ASCII digits only (no `+` sign), and no leading zero
+/// unless the value *is* `0` — mirroring `crate::metadata`'s own (private)
+/// `parse_canonical_u64` (`metadata.rs:1308-1318`), the precedent `parse_seg_key` uses for
+/// its own un-padded `<epoch>` component. Generic so the same rule serves every
+/// **variable-width** decimal field a retire token names (`epoch`, `version`, the per-part
+/// `<part-number>`, none of which are zero-padded — only the `slot:`/`part:`/`psum:`/`sidx:`
+/// key fields are, via [`fixed_width_u32`]).
+fn canonical_decimal<T: std::str::FromStr>(text: &str) -> Option<T> {
+    if text.is_empty() || !text.bytes().all(|b| b.is_ascii_digit()) {
+        return None;
+    }
+    if text.len() > 1 && text.starts_with('0') {
+        return None;
+    }
+    text.parse().ok()
+}
+
+/// A **fixed-width** `width`-digit decimal: exactly `width` ASCII digits, no `+` sign, no
+/// short or over-wide spelling. This — not [`canonical_decimal`] — is the rule
+/// `slot:`/`part:`/`psum:`/`sidx:` index/number fields are checked against, because those
+/// fields are zero-padded so byte-lexicographic key order equals numeric order
+/// (`metadata.rs:270-273`'s rule for `SEG_INDEX_WIDTH`, restated for this slice's own
+/// fixed-width fields).
+fn fixed_width_u32(text: &str, width: usize) -> Option<u32> {
+    if text.len() != width || !text.bytes().all(|b| b.is_ascii_digit()) {
+        return None;
+    }
+    text.parse().ok()
+}
+
+/// Split a `prefix<...>` key into exactly `fields` `:`-separated components, failing closed
+/// on a non-UTF-8 key, a missing prefix, or a wrong field count (a truncated or
+/// over-long/trailing-component key) — the shape every keyed-record parser below shares.
+fn split_key<'a>(
+    key: &'a [u8],
+    prefix: &str,
+    namespace: &'static str,
+    fields: usize,
+) -> Result<Vec<&'a str>, RecordError> {
+    let text = std::str::from_utf8(key).map_err(|_| malformed_key(namespace, key))?;
+    let rest = text
+        .strip_prefix(prefix)
+        .ok_or_else(|| malformed_key(namespace, key))?;
+    let parts: Vec<&str> = rest.splitn(fields, ':').collect();
+    if parts.len() != fields {
+        return Err(malformed_key(namespace, key));
+    }
+    Ok(parts)
+}
+
+/// Key for a session record: `mpu:<upload-id>`.
+pub fn mpu_key(upload_id: &str) -> Vec<u8> {
+    format!("mpu:{upload_id}").into_bytes()
+}
+
+/// Parse an [`mpu_key`] back into its upload id.
+pub fn parse_mpu_key(key: &[u8]) -> Result<String, RecordError> {
+    let fields = split_key(key, "mpu:", "mpu:", 1)?;
+    require_token(fields[0])?;
+    Ok(fields[0].to_string())
+}
+
+/// Key for one in-flight part slot: `slot:<upload-id>:<index>`, zero-padded to
+/// [`SLOT_INDEX_WIDTH`].
+pub fn slot_key(upload_id: &str, index: u32) -> Vec<u8> {
+    format!("slot:{upload_id}:{index:0width$}", width = SLOT_INDEX_WIDTH).into_bytes()
+}
+
+/// The bounded per-session slot range: `slot:<upload-id>:`.
+pub fn slot_range(upload_id: &str) -> Vec<u8> {
+    format!("slot:{upload_id}:").into_bytes()
+}
+
+/// Parse a [`slot_key`] back into `(upload_id, index)`, rejecting a non-fixed-width or
+/// out-of-**format**-range index (`0016:404-406`).
+pub fn parse_slot_key(key: &[u8]) -> Result<(String, u32), RecordError> {
+    let fields = split_key(key, "slot:", "slot:", 2)?;
+    let index =
+        fixed_width_u32(fields[1], SLOT_INDEX_WIDTH).ok_or_else(|| malformed_key("slot:", key))?;
+    if index >= SLOT_INDEX_FORMAT_MAX {
+        return Err(RecordError::SlotIndexOutOfRange {
+            index: u64::from(index),
+        });
+    }
+    require_token(fields[0])?;
+    Ok((fields[0].to_string(), index))
+}
+
+fn parse_part_scoped_key(
+    key: &[u8],
+    prefix: &'static str,
+    namespace: &'static str,
+) -> Result<(String, u32), RecordError> {
+    let fields = split_key(key, prefix, namespace, 2)?;
+    let part_number = fixed_width_u32(fields[1], PART_NUMBER_WIDTH)
+        .ok_or_else(|| malformed_key(namespace, key))?;
+    if part_number == 0 || part_number >= PART_NUMBER_FORMAT_MAX {
+        return Err(RecordError::PartNumberOutOfRange {
+            part_number: u64::from(part_number),
+        });
+    }
+    require_token(fields[0])?;
+    Ok((fields[0].to_string(), part_number))
+}
+
+/// Key for a committed part: `part:<upload-id>:<part-number>`, zero-padded to
+/// [`PART_NUMBER_WIDTH`] so a range read is in part-number order.
+pub fn part_key(upload_id: &str, part_number: u32) -> Vec<u8> {
+    format!(
+        "part:{upload_id}:{part_number:0width$}",
+        width = PART_NUMBER_WIDTH
+    )
+    .into_bytes()
+}
+
+/// The bounded per-session part range: `part:<upload-id>:`.
+pub fn part_range(upload_id: &str) -> Vec<u8> {
+    format!("part:{upload_id}:").into_bytes()
+}
+
+/// Parse a [`part_key`] back into `(upload_id, part_number)`.
+pub fn parse_part_key(key: &[u8]) -> Result<(String, u32), RecordError> {
+    parse_part_scoped_key(key, "part:", "part:")
+}
+
+/// Key for a committed part's summary: `psum:<upload-id>:<part-number>`.
+pub fn psum_key(upload_id: &str, part_number: u32) -> Vec<u8> {
+    format!(
+        "psum:{upload_id}:{part_number:0width$}",
+        width = PART_NUMBER_WIDTH
+    )
+    .into_bytes()
+}
+
+/// The bounded per-session summary range: `psum:<upload-id>:`.
+pub fn psum_range(upload_id: &str) -> Vec<u8> {
+    format!("psum:{upload_id}:").into_bytes()
+}
+
+/// Parse a [`psum_key`] back into `(upload_id, part_number)`.
+pub fn parse_psum_key(key: &[u8]) -> Result<(String, u32), RecordError> {
+    parse_part_scoped_key(key, "psum:", "psum:")
+}
+
+/// Key for one **owned staging entry**: `sidx:<upload-id>:<part-number>:<chunk-id>`. The
+/// `<part-number>` component is what lets a reclaimer attribute residue to the part attempt
+/// that staged it (`0016:353`).
+pub fn sidx_key(upload_id: &str, part_number: u32, chunk: wyrd_traits::ChunkId) -> Vec<u8> {
+    format!(
+        "sidx:{upload_id}:{part_number:0width$}:{chunk}",
+        width = PART_NUMBER_WIDTH
+    )
+    .into_bytes()
+}
+
+/// The bounded per-session owned range: `sidx:<upload-id>:` — the **only** way any pass
+/// reads owned entries; there is no global scan of them anywhere (`0016:1529-1536`).
+pub fn sidx_range(upload_id: &str) -> Vec<u8> {
+    format!("sidx:{upload_id}:").into_bytes()
+}
+
+/// Parse a [`sidx_key`] back into `(upload_id, part_number, chunk_id)`. The chunk-id
+/// component is **canonical** decimal ([`canonical_decimal`]), not fixed-width — two
+/// spellings of one chunk id (`7` and `007`) must never both parse, the same canonicality
+/// rule the fixed-width fields enforce by padding instead.
+pub fn parse_sidx_key(key: &[u8]) -> Result<(String, u32, wyrd_traits::ChunkId), RecordError> {
+    let fields = split_key(key, "sidx:", "sidx:", 3)?;
+    let part_number =
+        fixed_width_u32(fields[1], PART_NUMBER_WIDTH).ok_or_else(|| malformed_key("sidx:", key))?;
+    if part_number == 0 || part_number >= PART_NUMBER_FORMAT_MAX {
+        return Err(RecordError::PartNumberOutOfRange {
+            part_number: u64::from(part_number),
+        });
+    }
+    let chunk: wyrd_traits::ChunkId =
+        canonical_decimal(fields[2]).ok_or_else(|| malformed_key("sidx:", key))?;
+    require_token(fields[0])?;
+    Ok((fields[0].to_string(), part_number, chunk))
+}
+
+// ===========================================================================
+// 2. The `retire:` token grammar (`0016:358-380`)
+// ===========================================================================
+
+/// Which of the two retirement modes an obligation is in — read from the **key**, never a
+/// field: a boolean misread once is silent data loss, a malformed key prefix is an error at
+/// decode (`0016:434-440`).
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum RetireMode {
+    /// Orphan-mark the bytes, then delete the records that named them.
+    Bytes,
+    /// Delete records only — **never** orphan-mark.
+    Records,
+}
+
+impl RetireMode {
+    /// The key prefix this mode lives under.
+    pub fn prefix(self) -> &'static [u8] {
+        match self {
+            Self::Bytes => RETIRE_BYTES_PREFIX,
+            Self::Records => RETIRE_RECORDS_PREFIX,
+        }
+    }
+}
+
+/// Parse the mode out of a `retire:` key, failing closed on any other spelling — the
+/// boundary the mode-in-the-key argument rests on (`0016:434-440`).
+pub fn parse_retire_mode(key: &[u8]) -> Result<RetireMode, RecordError> {
+    if key.starts_with(RETIRE_BYTES_PREFIX) {
+        Ok(RetireMode::Bytes)
+    } else if key.starts_with(RETIRE_RECORDS_PREFIX) {
+        Ok(RetireMode::Records)
+    } else {
+        let text = String::from_utf8_lossy(key);
+        Err(RecordError::UnknownRetireMode {
+            mode: text
+                .strip_prefix("retire:")
+                .unwrap_or(&text)
+                .split(':')
+                .next()
+                .unwrap_or_default()
+                .to_string(),
+        })
+    }
+}
+
+/// A retirement token, whose grammar makes reuse impossible (`0016:358-380`): every
+/// component is minted once (an epoch is bumped by every fence, a `(part, attempt)` pair
+/// belongs to one `UploadPart`, an `(inode, version)` pair is produced by exactly one
+/// publication).
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum RetireToken {
+    /// A **session-scoped** obligation: `s:<upload-id>:<epoch>` — the whole-session teardown
+    /// obligation an epoch's fence installs — or, with the optional suffix,
+    /// `s:<upload-id>:<epoch>:<part-number>:<attempt-id>` for a **per-part** obligation (a
+    /// re-uploaded part's superseded chunks, a losing writer's compensation).
+    Session {
+        /// The owning session's upload id.
+        upload_id: String,
+        /// The epoch whose fence installed the obligation.
+        epoch: u64,
+        /// The part attempt, for a per-part obligation.
+        part: Option<(u32, String)>,
+    },
+    /// A **superseded or deleted generation**: `g:<inode-id>:<version>`.
+    Generation {
+        /// The inode.
+        inode: InodeId,
+        /// The version.
+        version: u64,
+    },
+}
+
+impl std::fmt::Display for RetireToken {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        match self {
+            Self::Session {
+                upload_id,
+                epoch,
+                part: None,
+            } => write!(f, "s:{upload_id}:{epoch}"),
+            Self::Session {
+                upload_id,
+                epoch,
+                part: Some((part_number, attempt_id)),
+            } => write!(f, "s:{upload_id}:{epoch}:{part_number}:{attempt_id}"),
+            Self::Generation { inode, version } => write!(f, "g:{inode}:{version}"),
+        }
+    }
+}
+
+/// Key for a retirement obligation: `retire:<mode>:<token>`.
+pub fn retire_key(mode: RetireMode, token: &RetireToken) -> Vec<u8> {
+    let mut key = mode.prefix().to_vec();
+    key.extend_from_slice(token.to_string().as_bytes());
+    key
+}
+
+/// The bounded session-scoped obligation range for one mode: `retire:<mode>:s:<upload-id>:`.
+/// A session's terminal delete gate is two of these emptiness reads, never a walk of the
+/// whole `retire:` namespace (`0016:374-380`).
+pub fn retire_session_range(mode: RetireMode, upload_id: &str) -> Vec<u8> {
+    let mut key = mode.prefix().to_vec();
+    key.extend_from_slice(format!("s:{upload_id}:").as_bytes());
+    key
+}
+
+/// Parse a [`retire_key`] back into `(mode, token)`, failing closed on any other spelling:
+/// a truncated token, a trailing component, a non-canonical epoch/version/part-number
+/// (a `+` sign or a leading zero), or a malformed upload/attempt id.
+pub fn parse_retire_key(key: &[u8]) -> Result<(RetireMode, RetireToken), RecordError> {
+    let mode = parse_retire_mode(key)?;
+    let text = std::str::from_utf8(key).map_err(|_| malformed_key("retire:", key))?;
+    let rest = &text[mode.prefix().len()..];
+    let fields: Vec<&str> = rest.split(':').collect();
+    let token = match fields.as_slice() {
+        ["s", upload_id, epoch] => {
+            require_token(upload_id)?;
+            let epoch = canonical_decimal(epoch).ok_or_else(|| malformed_key("retire:", key))?;
+            RetireToken::Session {
+                upload_id: (*upload_id).to_string(),
+                epoch,
+                part: None,
+            }
+        }
+        ["s", upload_id, epoch, part_number, attempt_id] => {
+            require_token(upload_id)?;
+            let epoch = canonical_decimal(epoch).ok_or_else(|| malformed_key("retire:", key))?;
+            let part_number: u32 =
+                canonical_decimal(part_number).ok_or_else(|| malformed_key("retire:", key))?;
+            if part_number == 0 || part_number >= PART_NUMBER_FORMAT_MAX {
+                return Err(RecordError::PartNumberOutOfRange {
+                    part_number: u64::from(part_number),
+                });
+            }
+            require_token(attempt_id)?;
+            RetireToken::Session {
+                upload_id: (*upload_id).to_string(),
+                epoch,
+                part: Some((part_number, (*attempt_id).to_string())),
+            }
+        }
+        ["g", inode, version] => {
+            let inode: InodeId =
+                canonical_decimal(inode).ok_or_else(|| malformed_key("retire:", key))?;
+            let version: u64 =
+                canonical_decimal(version).ok_or_else(|| malformed_key("retire:", key))?;
+            RetireToken::Generation { inode, version }
+        }
+        _ => return Err(malformed_key("retire:", key)),
+    };
+    Ok((mode, token))
+}
+
+// ===========================================================================
+// 3. The admission ledger — `mpuctl` (`0016:348`)
+// ===========================================================================
+
+/// The budget **profile** tuple `mpuctl` stores and every admitter/custodian compares whole
+/// (`0016:348`,`:1462-1480`). This slice owns the **shape** and the two pure derivations
+/// below (§ Scope boundary 3, `brief.md`); the deployment's own values are #655's — mirroring
+/// the format/capacity split `metadata.rs:270-322` already draws.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]
+pub struct Budget {
+    /// The reconcile pass's staged-reference memory budget, in chunk-refs (`W_ref`).
+    pub w_ref: u64,
+    /// The per-`part:`-record chunk ceiling (`MAX_PART_CHUNKS`).
+    pub max_part_chunks: u32,
+    /// The per-session part-number space (`MAX_PARTS_PER_SESSION`).
+    pub max_parts_per_session: u32,
+    /// The per-session in-flight cap (`MAX_INFLIGHT_PARTS`).
+    pub max_inflight_parts: u32,
+    /// The per-session committed-staging ceiling (`MAX_STAGED_CHUNKS`).
+    pub max_staged_chunks: u32,
+}
+
+impl Budget {
+    /// `U_ref` — the worst-case **per-session** staged-reference footprint, in chunk-refs
+    /// (`0016:1469`), pure arithmetic over the stored tuple (§ Scope boundary 3):
+    ///
+    /// ```text
+    /// U_ref = min( (MAX_PARTS_PER_SESSION + MAX_INFLIGHT_PARTS) x MAX_PART_CHUNKS,
+    ///              MAX_STAGED_CHUNKS + 2 x MAX_INFLIGHT_PARTS x MAX_PART_CHUNKS )
+    /// ```
+    ///
+    /// The first term is the raw part-number space; the second is the **enforced** staged
+    /// ceiling plus the bounded commit overshoot plus the in-flight owned entries — each
+    /// committed part charged its **full** `MAX_PART_CHUNKS` (charging a part as one record
+    /// under-bounds the footprint by up to `MAX_PART_CHUNKS`x, the iteration-4 defect 0016
+    /// fixed).
+    pub const fn u_ref(&self) -> u64 {
+        let part_chunks = self.max_part_chunks as u64;
+        let inflight = self.max_inflight_parts as u64;
+        let raw = (self.max_parts_per_session as u64 + inflight) * part_chunks;
+        let ceiling = self.max_staged_chunks as u64 + 2 * inflight * part_chunks;
+        if raw < ceiling {
+            raw
+        } else {
+            ceiling
+        }
+    }
+
+    /// `MAX_SESSIONS` — the admission limit, `min(floor(W_ref / U_ref), SCAN_CAP/2)`,
+    /// **derived, never chosen** (`0016:1470`). The `SCAN_CAP/2` clamp is what keeps a legal
+    /// pairing (a large `W_ref`, small parts) from exceeding the reaper's one
+    /// `scan("mpu:")`; `wyrd_traits::SCAN_CAP` is a pre-existing store-seam constant, not a
+    /// multipart-deployment knob, so consulting it here is still pure arithmetic over
+    /// values already fixed, not a value #655 chooses.
+    pub const fn max_sessions(&self) -> u64 {
+        let u_ref = self.u_ref();
+        match self.w_ref.checked_div(u_ref) {
+            Some(quotient) => {
+                let clamp = (wyrd_traits::SCAN_CAP / 2) as u64;
+                if quotient < clamp {
+                    quotient
+                } else {
+                    clamp
+                }
+            }
+            None => 0,
+        }
+    }
+}
+
+/// The singleton **admission ledger** record, `mpuctl` (`0016:348`). One record, three
+/// fields, CAS'd **whole**, so the count and the limit it was checked against can never be
+/// read apart.
+#[derive(Debug, Clone, PartialEq, Eq, Serialize)]
+pub struct AdmissionRecord {
+    /// How many `mpu:` records exist, in any state (tombstones included).
+    pub count: u64,
+    /// The governing limit those increments were admitted against.
+    pub max_sessions: u64,
+    /// The budget tuple that establishes `max_sessions`.
+    pub profile: Budget,
+}
+
+/// **The carried-forward MUST-FIX (`brief.md` § Success criterion leg 3, `results/issue_636`
+/// review):** `max_sessions` is *derived* (`Budget::max_sessions`), never independently
+/// chosen, so a decoded record whose stored `max_sessions` disagrees with what its own
+/// `profile` derives is **rejected at decode**, not trusted. #636's shipped defect let
+/// admission trust an inconsistent stored limit, so an oversized torn value could violate
+/// the `W_ref` bound every reconcile pass is sized for; this relation is what closes that
+/// hole (ADR-0045, parse-don't-validate).
+impl<'de> Deserialize<'de> for AdmissionRecord {
+    fn deserialize<D: Deserializer<'de>>(deserializer: D) -> std::result::Result<Self, D::Error> {
+        #[derive(Deserialize)]
+        struct Raw {
+            count: u64,
+            max_sessions: u64,
+            profile: Budget,
+        }
+        let raw = Raw::deserialize(deserializer)?;
+        let derived = raw.profile.max_sessions();
+        if raw.max_sessions != derived {
+            return Err(DeError::custom(format!(
+                "mpuctl records max_sessions={} but its own profile derives {derived} \
+                 (U_ref={}, W_ref={}): the stored limit is derived, never chosen",
+                raw.max_sessions,
+                raw.profile.u_ref(),
+                raw.profile.w_ref,
+            )));
+        }
+        Ok(Self {
+            count: raw.count,
+            max_sessions: raw.max_sessions,
+            profile: raw.profile,
+        })
+    }
+}
+
+// ===========================================================================
+// 4. The session record — `mpu:<upload-id>` (`0016:350`, §2's state machine)
+// ===========================================================================
+
+/// A session's lifecycle state (`0016:528-553`).
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]
+pub enum SessionState {
+    /// Accepting parts.
+    Open,
+    /// Fenced by a Complete that owns publication.
+    Completing,
+    /// Fenced for teardown; its `retire:bytes:{session}` obligation is installed.
+    Aborting,
+    /// Published. A **tombstone** that still answers an identical retry, still holds an
+    /// `mpu:` record, and is therefore still counted by the admission counter
+    /// (`0016:964-968`).
+    Completed,
+}
+
+/// The dirent identity a `Completing` session publishes to, plus the fence epoch that owns
+/// the attempt (`0016:350`). **The key, never a frozen inode id** — a concurrent
+/// delete-and-recreate of the same object name rebinds it to a different inode, so a flip
+/// re-resolves the dirent at every attempt rather than addressing a frozen id (`0016:350`).
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+pub struct PublishTarget {
+    /// The parent inode the object name lives under.
+    pub parent: InodeId,
+    /// The object name.
+    pub name: String,
+    /// The `Completing` fence epoch, so a resumed completer writes the same deterministic
+    /// segment-group range.
+    pub fence_epoch: u64,
+}
+
+/// What a `Completed` session recorded (`0016:350`).
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+pub struct Completion {
+    /// The published inode.
+    pub inode: InodeId,
+    /// The published version — `prior.version + 1` recomputed from the re-read prior at the
+    /// winning flip, never a fence-frozen number (`0016:925-932`).
+    pub version: u64,
+    /// The composed ETag ([`multipart_etag`]).
+    pub etag: String,
+    /// The publication instant.
+    pub completed_at_millis: u64,
+    /// A digest over the **ordered** `(part_number, digest)` list the winning Complete named
+    /// ([`complete_fingerprint`]) — the request-identity check the `Completed` tombstone
+    /// answers a retry on (`0016:898-908`).
+    pub complete_fingerprint: String,
+}
+
+/// One multipart upload session — the record every transition compare-and-sets on its
+/// **exact bytes** (`0016:350`,`:555-566`).
+#[derive(Debug, Clone, PartialEq, Eq, Serialize)]
+pub struct SessionRecord {
+    /// The target bucket.
+    pub bucket: String,
+    /// The parent inode the object name lives under.
+    pub parent: InodeId,
+    /// The object name.
+    pub object: String,
+    /// The declared content type, stamped at publication (ADR-0047).
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub content_type: Option<String>,
+    /// When the session was initiated — the instant `W_session` is measured from (#625).
+    pub created_at_millis: u64,
+    /// Which clock produced every session-scoped stamp — *one clock per correctness
+    /// lifecycle* (`AGENTS.md:131-142`).
+    pub clock_source: String,
+    /// The lifecycle state.
+    pub state: SessionState,
+    /// A monotone counter bumped by every fence, so two successive states are textually
+    /// distinct even when nothing else changes.
+    pub epoch: u64,
+    /// Complete fences spent so far (capped at a later slice's `MAX_COMPLETE_ATTEMPTS`).
+    pub attempts: u32,
+    /// The **segment-group nonce**, minted with the session and independent of its id
+    /// because the `seg:` records it keys outlive the `mpu:` tombstone that would otherwise
+    /// be their only reuse guard (`0016:499-527`).
+    pub group_nonce: String,
+    /// When the session fenced into `Completing` — the instant `W_completing` is measured
+    /// from. `Completing`-only.
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub fenced_at_millis: Option<u64>,
+    /// The segment-write cursor of the current attempt. `Completing`-only.
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub segments_written: Option<u32>,
+    /// The dirent identity and fence epoch of the current attempt. `Completing`-only.
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub publish_target: Option<PublishTarget>,
+    /// What the winning flip recorded. `Completed`-only.
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub completion: Option<Completion>,
+}
+
+/// **Validating decode** (ADR-0045): a session value carrying a field its state forbids (a
+/// `Completing`-only `fenced_at_millis` on an `Open` session), or missing one its state
+/// requires, is a record no writer in this protocol can produce — half of a state's meaning
+/// is in those fields, so admitting the record as a *value* would let a consumer act on a
+/// session it does not actually understand (`0016:404-408`).
+impl<'de> Deserialize<'de> for SessionRecord {
+    fn deserialize<D: Deserializer<'de>>(deserializer: D) -> std::result::Result<Self, D::Error> {
+        #[derive(Deserialize)]
+        struct Raw {
+            bucket: String,
+            parent: InodeId,
+            object: String,
+            #[serde(default)]
+            content_type: Option<String>,
+            created_at_millis: u64,
+            clock_source: String,
+            state: SessionState,
+            epoch: u64,
+            attempts: u32,
+            group_nonce: String,
+            #[serde(default)]
+            fenced_at_millis: Option<u64>,
+            #[serde(default)]
+            segments_written: Option<u32>,
+            #[serde(default)]
+            publish_target: Option<PublishTarget>,
+            #[serde(default)]
+            completion: Option<Completion>,
+        }
+        let raw = Raw::deserialize(deserializer)?;
+        let (fenced, cursor, target, completion) = (
+            raw.fenced_at_millis.is_some(),
+            raw.segments_written.is_some(),
+            raw.publish_target.is_some(),
+            raw.completion.is_some(),
+        );
+        let required: &[(bool, &'static str)] = match raw.state {
+            SessionState::Completing => &[
+                (fenced, "fenced_at_millis"),
+                (cursor, "segments_written"),
+                (target, "publish_target"),
+            ],
+            SessionState::Completed => &[(completion, "completion")],
+            SessionState::Open | SessionState::Aborting => &[],
+        };
+        for (present, field) in required {
+            if !present {
+                return Err(DeError::custom(format!(
+                    "session in {:?} must carry the field `{field}`",
+                    raw.state
+                )));
+            }
+        }
+        let forbidden: &[(bool, &'static str)] = match raw.state {
+            // A release and a teardown fence both drop every `Completing`-only field, so an
+            // `Open`/`Aborting` record is byte-identical in shape to a freshly created one.
+            SessionState::Open | SessionState::Aborting => &[
+                (fenced, "fenced_at_millis"),
+                (cursor, "segments_written"),
+                (target, "publish_target"),
+                (completion, "completion"),
+            ],
+            SessionState::Completing => &[(completion, "completion")],
+            SessionState::Completed => &[
+                (fenced, "fenced_at_millis"),
+                (cursor, "segments_written"),
+                (target, "publish_target"),
+            ],
+        };
+        for (present, field) in forbidden {
+            if *present {
+                return Err(DeError::custom(format!(
+                    "session in {:?} may not carry the field `{field}`",
+                    raw.state
+                )));
+            }
+        }
+        Ok(Self {
+            bucket: raw.bucket,
+            parent: raw.parent,
+            object: raw.object,
+            content_type: raw.content_type,
+            created_at_millis: raw.created_at_millis,
+            clock_source: raw.clock_source,
+            state: raw.state,
+            epoch: raw.epoch,
+            attempts: raw.attempts,
+            group_nonce: raw.group_nonce,
+            fenced_at_millis: raw.fenced_at_millis,
+            segments_written: raw.segments_written,
+            publish_target: raw.publish_target,
+            completion: raw.completion,
+        })
+    }
+}
+
+// ===========================================================================
+// 5. The slot, part and summary records (`0016:349-352`)
+// ===========================================================================
+
+/// One **in-flight part slot** — `slot:<upload-id>:<index>` (`0016:349`). The stamp records
+/// when the slot was claimed, so a request is observably alive from the instant it reserves,
+/// before it has written a byte.
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+pub struct SlotRecord {
+    /// The part number this attempt is uploading.
+    pub part_number: u32,
+    /// A per-attempt token, so an ambiguous reserve is settled by re-reading rather than by
+    /// re-reserving a different index.
+    pub attempt_id: String,
+    /// When the slot was claimed.
+    pub reserved_at_millis: u64,
+    /// The slot's liveness lease.
+    pub lease_expiry_millis: u64,
+}
+
+/// A committed part — `part:<upload-id>:<part-number>` (`0016:351`).
+#[derive(Debug, Clone, PartialEq, Eq, Serialize)]
+pub struct PartRecord {
+    /// The part's chunk list, in object order.
+    pub chunks: Vec<ChunkRef>,
+    /// The part's length in bytes.
+    pub len: u64,
+    /// The part's content digest, lowercase hex SHA-256.
+    pub digest: String,
+    /// When the part committed.
+    pub committed_at_millis: u64,
+    /// The session epoch the commit was fenced on.
+    pub session_epoch: u64,
+}
+
+/// **Validating decode**: `len` is checked against the chunk list's own span. The two state
+/// the *same* fact — Complete sums `len` into the published `size`, the read path sums the
+/// chunks it actually reads — so a record whose halves disagree would publish an object whose
+/// declared size is not the number of bytes a reader can get: a silent wrong answer at
+/// `HeadObject`/`GetObject`. Structural, so it is an error at decode (ADR-0045).
+impl<'de> Deserialize<'de> for PartRecord {
+    fn deserialize<D: Deserializer<'de>>(deserializer: D) -> std::result::Result<Self, D::Error> {
+        #[derive(Deserialize)]
+        struct Raw {
+            chunks: Vec<ChunkRef>,
+            len: u64,
+            digest: String,
+            committed_at_millis: u64,
+            session_epoch: u64,
+        }
+        let raw = Raw::deserialize(deserializer)?;
+        let span: u64 = raw.chunks.iter().map(|chunk| chunk.len).sum();
+        if span != raw.len {
+            return Err(DeError::custom(format!(
+                "part record declares len={} but its {} chunk(s) span {span} B",
+                raw.len,
+                raw.chunks.len()
+            )));
+        }
+        Ok(Self {
+            chunks: raw.chunks,
+            len: raw.len,
+            digest: raw.digest,
+            committed_at_millis: raw.committed_at_millis,
+            session_epoch: raw.session_epoch,
+        })
+    }
+}
+
+/// A committed part's **summary** — `psum:<upload-id>:<part-number>`, written in the same
+/// batch as the `part:` record it summarizes (`0016:352`). Everything about a part except
+/// its chunk list, so the cumulative staged-chunk check and `ListParts` read tens of bytes
+/// per part instead of the fat lists.
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+pub struct PartSummary {
+    /// How many chunks the part holds.
+    pub chunks: u32,
+    /// The part's length in bytes.
+    pub len: u64,
+    /// The part's content digest.
+    pub digest: String,
+    /// When the part committed.
+    pub committed_at_millis: u64,
+}
+
+// ===========================================================================
+// 6. The ETag composition and the Complete request-identity fingerprint
+//    (success criterion legs 5-6; ADR-0047; `0016:3064-3070`)
+// ===========================================================================
+
+/// A 32-byte SHA-256 digest rendered as lowercase hex — matches the wrapper style
+/// `crates/gateway-s3/src/crypto.rs:21-60` already carries for this crate family's SHA-256
+/// usage.
+pub fn hex_lower(bytes: &[u8]) -> String {
+    let mut out = String::with_capacity(bytes.len() * 2);
+    for byte in bytes {
+        out.push(char::from_digit(u32::from(byte >> 4), 16).unwrap_or('0'));
+        out.push(char::from_digit(u32::from(byte & 0x0f), 16).unwrap_or('0'));
+    }
+    out
+}
+
+/// Parse a 64-character **lowercase**-hex SHA-256 digest back to its 32 raw bytes; rejects
+/// uppercase (non-canonical) hex.
+pub fn parse_digest(hex: &str) -> Option<[u8; 32]> {
+    if hex.len() != 64 {
+        return None;
+    }
+    let mut out = [0u8; 32];
+    let raw = hex.as_bytes();
+    for (i, slot) in out.iter_mut().enumerate() {
+        if raw[2 * i].is_ascii_uppercase() || raw[2 * i + 1].is_ascii_uppercase() {
+            return None;
+        }
+        let hi = (raw[2 * i] as char).to_digit(16)?;
+        let lo = (raw[2 * i + 1] as char).to_digit(16)?;
+        *slot = (hi * 16 + lo) as u8;
+    }
+    Some(out)
+}
+
+/// The SHA-256 digest of `data` — the basis ADR-0047 settled for the change token
+/// (`docs/design/adr/0047-object-metadata-model.md:73-89`).
+pub fn digest(data: &[u8]) -> [u8; 32] {
+    let mut hasher = Sha256::new();
+    hasher.update(data);
+    hasher.finalize().into()
+}
+
+/// The **multipart ETag** — the composition this slice settles on top of ADR-0047's basis,
+/// which closed the digest algorithm and explicitly deferred only the composition
+/// (`docs/design/adr/0047-object-metadata-model.md:112`; `0016:3064-3070`):
+///
+/// ```text
+/// etag = lowercase_hex( SHA-256( d_1 || d_2 || ... || d_N ) ) + "-" + N
+/// ```
+///
+/// where `d_i` is the **raw 32 binary digest bytes** — never their hex text, no separators,
+/// no part numbers mixed in — of the *i*-th part in **ascending part-number order over
+/// exactly the parts the caller named**, and `N` is that count.
+///
+/// **Never MD5.** S3's own multipart ETag is an MD5-of-MD5s; Wyrd's change token is
+/// SHA-256-based (ADR-0047), and the value is opaque to clients (compared for equality
+/// only), so the composition is free to follow the basis rather than the wire folklore. What
+/// must not vary is that it is a **pure function of the part records' recorded digests and
+/// their order**, so a retry recomputes the same value from the same records.
+pub fn multipart_etag(digests: &[[u8; 32]]) -> String {
+    let mut hasher = Sha256::new();
+    for part in digests {
+        hasher.update(part);
+    }
+    let composed: [u8; 32] = hasher.finalize().into();
+    format!("{}-{}", hex_lower(&composed), digests.len())
+}
+
+/// The **request identity** a `Completed` tombstone answers a retry on — a digest over the
+/// *ordered* `(part_number, digest)` pairs the winning Complete named (`0016:898-908`).
+///
+/// Separate from [`multipart_etag`], deliberately: the ETag is a function of the digests
+/// alone, so two different part *numberings* of the same bodies would collide in it. The
+/// fingerprint mixes the numbers in, so a client that reuses an upload id with a *different*
+/// assembly gets `NoSuchUpload` — the honest answer — rather than being told *its* assembly
+/// succeeded while the store holds an earlier one (`0016:906-908`).
+///
+/// **Length-prefixed, not delimited**, because the digests it mixes in are the *client's*
+/// unvalidated strings, hashed before any digest is checked against a `part:` record: a
+/// delimiter-framed hash lets one crafted digest impersonate a different part list —
+/// `[(1, "A"), (2, "B")]` and `[(1, "A\n2:B")]` would hash identically under `"{n}:{d}\n"`
+/// framing. With each field's byte length hashed ahead of it the encoding is injective for
+/// every input, validated or not.
+pub fn complete_fingerprint(named: &[(u32, String)]) -> String {
+    let mut hasher = Sha256::new();
+    hasher.update((named.len() as u64).to_be_bytes());
+    for (part_number, part_digest) in named {
+        hasher.update(part_number.to_be_bytes());
+        hasher.update((part_digest.len() as u64).to_be_bytes());
+        hasher.update(part_digest.as_bytes());
+    }
+    let out: [u8; 32] = hasher.finalize().into();
+    hex_lower(&out)
+}
+
+// ===========================================================================
+// 7. Decision 3 — the verb x state answer table, as a total, pure function
+//    (`0016:894-1037`, the failure-mode table at `0016:1019-1034`)
+// ===========================================================================
+
+/// The five multipart verbs decision 3 answers (`0016:969-978`). The S3 status/XML mapping
+/// for each [`VerbAnswer`] is #508's; this slice pins the **typed** answer only.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum Verb {
+    /// Stage one part's bytes against an `Open` session.
+    UploadPart,
+    /// Fence and assemble the named parts into the published object.
+    CompleteMultipartUpload,
+    /// Fence for teardown without publishing.
+    AbortMultipartUpload,
+    /// List the parts staged (or frozen) under one session.
+    ListParts,
+    /// List the fleet's in-progress sessions.
+    ListMultipartUploads,
+}
+
+/// A **typed** answer to one (verb, state) cell of decision 3's table — never "an error",
+/// never an HTTP status (`0016:969-978`). #508 maps each variant to its S3 wire spelling.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum VerbAnswer {
+    /// `UploadPart` against `Open`: the part is accepted.
+    PartAccepted,
+    /// `CompleteMultipartUpload` against `Open`: fences and publishes.
+    CompleteFences,
+    /// `CompleteMultipartUpload` against a `Completed` tombstone whose
+    /// `complete_fingerprint` **matches** the recorded one: an identical retry answers
+    /// success with the recorded ETag (`0016:898-908`).
+    CompleteIdenticalRetry,
+    /// `AbortMultipartUpload` against `Open`: fences immediately — the response IS the
+    /// fence commit (`0016:1000-1003`, F9).
+    AbortFences,
+    /// `AbortMultipartUpload` against `Aborting`: idempotent — already fencing.
+    AbortAlreadyAborting,
+    /// `ListParts` against `Open`: the still-mutable, still-growing part set.
+    ListPartsOpenSet,
+    /// `ListParts` against `Completing`: the frozen part set the fence read.
+    ListPartsFrozenSet,
+    /// `ListMultipartUploads`: this session is listed.
+    Listed,
+    /// `ListMultipartUploads`: this session is not listed.
+    NotListed,
+    /// `CompleteMultipartUpload` / `AbortMultipartUpload` against `Completing`: a *different*
+    /// fence already owns publication; no client path resumes a `Completing` session
+    /// (`0016:980-986`).
+    OperationAborted,
+    /// No session can answer this request: the id is unknown, the session is in a state this
+    /// verb refuses, or — `CompleteMultipartUpload` against `Completed` only — the request's
+    /// `complete_fingerprint` does not match the recorded one, i.e. a *different* assembly
+    /// under a consumed id (the honest answer, `0016:906-908`).
+    NoSuchUpload,
+}
+
+/// Decision 3's answer table (`0016:969-978`), as a **total**, pure function over the 5-verb
+/// x 5-state product — `Open`/`Completing`/`Aborting`/`Completed`/`None` (record absent).
+/// `fingerprint_matches` is consulted **only** for the one conditional cell —
+/// `CompleteMultipartUpload` against a `Completed` tombstone (`0016:898-908`) — and ignored
+/// everywhere else, so the function can be called uniformly over the whole product.
+///
+/// The match below is **exhaustive**: adding a `Verb` or `SessionState` variant without
+/// answering its new cells here is a compile error, not a silent gap — the "later state or
+/// verb cannot be added silently" property the success criterion asks for.
+pub fn decision3_answer(
+    verb: Verb,
+    state: Option<SessionState>,
+    fingerprint_matches: bool,
+) -> VerbAnswer {
+    use SessionState::{Aborting, Completed, Completing, Open};
+    use Verb::{
+        AbortMultipartUpload, CompleteMultipartUpload, ListMultipartUploads, ListParts, UploadPart,
+    };
+    match (verb, state) {
+        (UploadPart, Some(Open)) => VerbAnswer::PartAccepted,
+        (UploadPart, Some(Completing) | Some(Aborting) | Some(Completed) | None) => {
+            VerbAnswer::NoSuchUpload
+        }
+
+        (CompleteMultipartUpload, Some(Open)) => VerbAnswer::CompleteFences,
+        (CompleteMultipartUpload, Some(Completing)) => VerbAnswer::OperationAborted,
+        (CompleteMultipartUpload, Some(Aborting) | None) => VerbAnswer::NoSuchUpload,
+        (CompleteMultipartUpload, Some(Completed)) => {
+            if fingerprint_matches {
+                VerbAnswer::CompleteIdenticalRetry
+            } else {
+                VerbAnswer::NoSuchUpload
+            }
+        }
+
+        (AbortMultipartUpload, Some(Open)) => VerbAnswer::AbortFences,
+        (AbortMultipartUpload, Some(Completing)) => VerbAnswer::OperationAborted,
+        (AbortMultipartUpload, Some(Aborting)) => VerbAnswer::AbortAlreadyAborting,
+        (AbortMultipartUpload, Some(Completed) | None) => VerbAnswer::NoSuchUpload,
+
+        (ListParts, Some(Open)) => VerbAnswer::ListPartsOpenSet,
+        (ListParts, Some(Completing)) => VerbAnswer::ListPartsFrozenSet,
+        (ListParts, Some(Aborting) | Some(Completed) | None) => VerbAnswer::NoSuchUpload,
+
+        (ListMultipartUploads, Some(Open) | Some(Completing)) => VerbAnswer::Listed,
+        (ListMultipartUploads, Some(Aborting) | Some(Completed) | None) => VerbAnswer::NotListed,
+    }
+}
