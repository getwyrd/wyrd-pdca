+//! Issue #654, slice 1/7 of #636's re-split: the multipart commit protocol's **record
+//! family and state machine**, proven pure — no store, no async runtime, no fixture
+//! beyond literals (proposal 0016, `docs/design/proposals/draft/0016-multipart-commit-protocol.md`).
+//!
+//! Six legs, matching `results/issue_654/brief.md` § Success criterion exactly:
+//!   1. key grammar round-trips; non-canonical spellings are rejected at decode.
+//!   2. no prefix is a prefix of another.
+//!   3. every decode is validating; `encode -> decode` is the identity on a legacy value.
+//!   4. every verb x state cell of decision 3 is answered by a typed, total function.
+//!   5. `multipart_etag` against an independent oracle.
+//!   6. `complete_fingerprint` distinguishes an identical retry from a different assembly.
+//!
+//! This is a **born-at-tier** slice (brief.md § Falsifiability): every symbol here is
+//! introduced by this patch, so there is no pre-existing failing assertion to flip. RED on
+//! `origin/main` is therefore a **compile failure** (nothing named below exists), reported
+//! `UNVERIFIABLE` by `C4-verify`'s RED leg — declared and expected. The five negation
+//! demonstrations `build-notes.md` records (each production symbol temporarily broken, this
+//! discriminator re-run, the failure captured, then reverted) are what stands in for a
+//! behavioural red, per #636's round-3 sign-off finding.
+
+#![forbid(unsafe_code)]
+
+use wyrd_core::metadata::{self, PendingEntry};
+use wyrd_core::multipart::{
+    self, complete_fingerprint, decision3_answer, digest, hex_lower, is_token, mpu_key,
+    multipart_etag, parse_digest, parse_mpu_key, parse_part_key, parse_psum_key, parse_retire_key,
+    parse_retire_mode, parse_sidx_key, parse_slot_key, part_key, psum_key, retire_key, sidx_key,
+    slot_key, AdmissionRecord, Budget, Completion, PartRecord, PartSummary, PublishTarget,
+    RecordError, RetireMode, RetireToken, SessionRecord, SessionState, SlotRecord, StagedPlacement,
+    Verb, VerbAnswer,
+};
+use wyrd_traits::{ChunkId, DServerId};
+
+/// A well-formed 32-lowercase-hex 128-bit token (an upload id, an attempt id, or a
+/// segment-group nonce all share this shape, `0016:493-497`).
+const UPLOAD_ID: &str = "0123456789abcdef0123456789abcdef";
+const ATTEMPT_ID: &str = "fedcba9876543210fedcba9876543210";
+const OTHER_UPLOAD_ID: &str = "11111111111111111111111111111111";
+
+// ===========================================================================
+// Leg 1 — key grammar round-trips, and non-canonical spellings are REJECTED at decode.
+// ===========================================================================
+
+#[test]
+fn mpu_key_round_trips_and_rejects_noncanonical_spellings() {
+    assert_eq!(parse_mpu_key(&mpu_key(UPLOAD_ID)).unwrap(), UPLOAD_ID);
+
+    // Empty upload id.
+    assert!(parse_mpu_key(b"mpu:").is_err());
+    // Upload id containing the key separator `:`.
+    assert!(parse_mpu_key(format!("mpu:{UPLOAD_ID}:{UPLOAD_ID}").as_bytes()).is_err());
+    // Truncated key (no prefix match at all).
+    assert!(parse_mpu_key(b"mpu").is_err());
+    // A key whose bytes are not UTF-8.
+    assert!(parse_mpu_key(&[b'm', b'p', b'u', b':', 0xff, 0xfe]).is_err());
+    // Wrong namespace entirely.
+    assert!(parse_mpu_key(b"slot:x:000000").is_err());
+}
+
+#[test]
+fn slot_key_round_trips_and_rejects_noncanonical_spellings() {
+    for index in [0u32, 1, 41, 999_999] {
+        let key = slot_key(UPLOAD_ID, index);
+        assert_eq!(
+            parse_slot_key(&key).unwrap(),
+            (UPLOAD_ID.to_string(), index)
+        );
+    }
+
+    let malformed: Vec<String> = vec![
+        // A short, un-padded index where the width is fixed (6 digits).
+        format!("slot:{UPLOAD_ID}:7"),
+        // An over-wide index (7 digits, width is 6).
+        format!("slot:{UPLOAD_ID}:0000007"),
+        // A `+` sign.
+        format!("slot:{UPLOAD_ID}:+00007"),
+        // A non-decimal body.
+        format!("slot:{UPLOAD_ID}:00a007"),
+        // An empty upload id.
+        "slot::000007".to_string(),
+        // An upload id containing the separator (splits the field, corrupting the index).
+        format!("slot:{UPLOAD_ID}:{UPLOAD_ID}:000007"),
+        // A truncated key (no index at all).
+        format!("slot:{UPLOAD_ID}"),
+        // A key with a trailing component.
+        format!("slot:{UPLOAD_ID}:000007:extra"),
+    ];
+    for key in &malformed {
+        assert!(
+            parse_slot_key(key.as_bytes()).is_err(),
+            "must reject {key:?}"
+        );
+    }
+    // A key whose bytes are not UTF-8.
+    assert!(parse_slot_key(&[b's', b'l', b'o', b't', b':', 0xff]).is_err());
+
+    // Two spellings of one slot must never both parse: `7` (unpadded) and `000007`
+    // (canonical) must not both be accepted as the same index.
+    assert!(parse_slot_key(format!("slot:{UPLOAD_ID}:7").as_bytes()).is_err());
+    assert_eq!(
+        parse_slot_key(format!("slot:{UPLOAD_ID}:000007").as_bytes())
+            .unwrap()
+            .1,
+        7
+    );
+}
+
+#[test]
+fn part_and_psum_keys_round_trip_and_reject_noncanonical_spellings() {
+    for part_number in [1u32, 41, 99_999] {
+        let pk = part_key(UPLOAD_ID, part_number);
+        assert_eq!(
+            parse_part_key(&pk).unwrap(),
+            (UPLOAD_ID.to_string(), part_number)
+        );
+        let sk = psum_key(UPLOAD_ID, part_number);
+        assert_eq!(
+            parse_psum_key(&sk).unwrap(),
+            (UPLOAD_ID.to_string(), part_number)
+        );
+    }
+
+    let malformed: Vec<String> = vec![
+        format!("part:{UPLOAD_ID}:7"),       // short, width fixed at 5
+        format!("part:{UPLOAD_ID}:0000007"), // over-wide
+        format!("part:{UPLOAD_ID}:+0007"),   // `+` sign
+        format!("part:{UPLOAD_ID}:0000a"),   // non-decimal
+        format!("part:{UPLOAD_ID}:00000"),   // part number 0 (parts start at 1)
+        "part::00001".to_string(),           // empty upload id
+        format!("part:{UPLOAD_ID}:{UPLOAD_ID}:00001"), // id has a `:`
+        format!("part:{UPLOAD_ID}"),         // truncated
+        format!("part:{UPLOAD_ID}:00001:extra"), // trailing component
+    ];
+    for key in &malformed {
+        assert!(
+            parse_part_key(key.as_bytes()).is_err(),
+            "must reject {key:?}"
+        );
+    }
+    assert!(parse_part_key(&[b'p', b'a', b'r', b't', b':', 0xff]).is_err());
+    assert!(parse_psum_key(&[b'p', b's', b'u', b'm', b':', 0xff]).is_err());
+}
+
+#[test]
+fn sidx_key_round_trips_and_rejects_noncanonical_spellings() {
+    let chunk: ChunkId = 7;
+    let key = sidx_key(UPLOAD_ID, 41, chunk);
+    assert_eq!(
+        parse_sidx_key(&key).unwrap(),
+        (UPLOAD_ID.to_string(), 41, chunk)
+    );
+
+    let malformed: Vec<String> = vec![
+        // Non-canonical chunk-id spellings: two must never both parse.
+        format!("sidx:{UPLOAD_ID}:00041:+7"),
+        format!("sidx:{UPLOAD_ID}:00041:007"),
+        format!("sidx:{UPLOAD_ID}:00041:7a"),
+        // A short/over-wide part number (width fixed at 5).
+        format!("sidx:{UPLOAD_ID}:7:7"),
+        format!("sidx:{UPLOAD_ID}:0000041:7"),
+        // Empty upload id.
+        "sidx::00041:7".to_string(),
+        // Upload id containing `:`.
+        format!("sidx:{UPLOAD_ID}:{UPLOAD_ID}:00041:7"),
+        // Truncated.
+        format!("sidx:{UPLOAD_ID}:00041"),
+        // Trailing component.
+        format!("sidx:{UPLOAD_ID}:00041:7:extra"),
+    ];
+    for key in &malformed {
+        assert!(
+            parse_sidx_key(key.as_bytes()).is_err(),
+            "must reject {key:?}"
+        );
+    }
+    assert!(parse_sidx_key(&[b's', b'i', b'd', b'x', b':', 0xff]).is_err());
+
+    // `7` and `007` must never both parse as the same chunk id.
+    assert_eq!(
+        parse_sidx_key(format!("sidx:{UPLOAD_ID}:00041:7").as_bytes())
+            .unwrap()
+            .2,
+        7
+    );
