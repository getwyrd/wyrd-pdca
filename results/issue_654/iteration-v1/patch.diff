+    };
+    let bytes = metadata::encode(&placement);
+    let decoded: StagedPlacement = metadata::decode(&bytes).unwrap();
+    assert_eq!(decoded, placement);
+}
+
+/// `Completion`/`PublishTarget` are plain, round-tripping record fragments too — exercised
+/// directly since `session_record_round_trips_and_validates_state_field_rules` only builds
+/// them inline.
+#[test]
+fn completion_and_publish_target_round_trip() {
+    let completion = Completion {
+        inode: 1,
+        version: 2,
+        etag: "deadbeef-1".to_string(),
+        completed_at_millis: 3,
+        complete_fingerprint: hex_lower(&digest(b"fp")),
+    };
+    let decoded: Completion = metadata::decode(&metadata::encode(&completion)).unwrap();
+    assert_eq!(decoded, completion);
+
+    let target = PublishTarget {
+        parent: 1,
+        name: "k".to_string(),
+        fence_epoch: 2,
+    };
+    let decoded: PublishTarget = metadata::decode(&metadata::encode(&target)).unwrap();
+    assert_eq!(decoded, target);
+}
