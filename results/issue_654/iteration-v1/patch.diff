+// ===========================================================================
+// Leg 5 — `multipart_etag` is the settled pure function, proved against an independent
+// oracle.
+// ===========================================================================
+
+fn oracle_etag(raw_digests_in_order: &[[u8; 32]]) -> String {
+    // The test computes the expected value itself, independent of `multipart_etag`'s own
+    // implementation: SHA-256 of the raw digest bytes concatenated, in the given order,
+    // lowercase-hex + "-" + count.
+    use sha2::{Digest as _, Sha256};
+    let mut hasher = Sha256::new();
+    for d in raw_digests_in_order {
+        hasher.update(d);
+    }
+    let out: [u8; 32] = hasher.finalize().into();
+    let hex: String = out.iter().map(|b| format!("{b:02x}")).collect();
+    format!("{hex}-{}", raw_digests_in_order.len())
+}
+
+#[test]
+fn multipart_etag_matches_independent_oracle_and_discriminates() {
+    let d1 = digest(b"part one");
+    let d2 = digest(b"part two");
+    let d3 = digest(b"part three");
+
+    // N = 1.
+    assert_eq!(multipart_etag(&[d1]), oracle_etag(&[d1]));
+
+    // Ascending order is enforced even when the caller supplies part numbers out of order:
+    // the function takes digests already in ascending part-number order, so a caller that
+    // sorts by part number before calling gets the ascending-order result regardless of the
+    // order parts were staged in.
+    let ascending = [d1, d2, d3];
+    assert_eq!(multipart_etag(&ascending), oracle_etag(&ascending));
+    let reordered = [d3, d1, d2];
+    assert_ne!(
+        multipart_etag(&ascending),
+        multipart_etag(&reordered),
+        "the composition is order-sensitive: a caller that fails to sort by part number \
+         before calling gets a different (wrong) ETag"
+    );
+
+    // A strict subset of the staged parts gives a different value from the full set.
+    let subset = [d1, d3];
+    assert_ne!(multipart_etag(&ascending), multipart_etag(&subset));
+
+    // Hex-text concatenation must give a DIFFERENT value from raw-byte concatenation — the
+    // negation leg 5 names: a hex-vs-raw slip must be observable.
+    let mut hex_hasher_input = Vec::new();
+    for d in &ascending {
+        hex_hasher_input.extend_from_slice(hex_lower(d).as_bytes());
+    }
+    let hex_text_digest = digest(&hex_hasher_input);
+    let hex_text_etag = format!("{}-{}", hex_lower(&hex_text_digest), ascending.len());
+    assert_ne!(
+        multipart_etag(&ascending),
+        hex_text_etag,
+        "raw-digest-byte composition must differ from hex-text composition"
+    );
+
+    // The `-N` suffix is the NAMED count, not e.g. a byte length or an unrelated number.
+    assert!(multipart_etag(&ascending).ends_with("-3"));
+    assert!(multipart_etag(&subset).ends_with("-2"));
+    assert!(multipart_etag(&[d1]).ends_with("-1"));
+}
