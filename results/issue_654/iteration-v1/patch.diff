+#[test]
+fn no_prefix_is_a_prefix_of_another() {
+    // The seven this slice adds, plus `mpuctl` itself (an exact singleton key, not a
+    // prefix pattern, but the one the leg-2 near-miss below is about), plus every
+    // pre-existing namespace the brief names.
+    let prefixes: &[(&str, &[u8])] = &[
+        ("mpu:", multipart::MPU_PREFIX),
+        ("slot:", multipart::SLOT_PREFIX),
+        ("part:", multipart::PART_PREFIX),
+        ("psum:", multipart::PSUM_PREFIX),
+        ("sidx:", multipart::SIDX_PREFIX),
+        ("retire:bytes:", multipart::RETIRE_BYTES_PREFIX),
+        ("retire:records:", multipart::RETIRE_RECORDS_PREFIX),
+        ("inode:", b"inode:"),
+        ("dirent:", b"dirent:"),
+        ("pending:", b"pending:"),
+        ("bucket:", b"bucket:"),
+        ("orphan:", b"orphan:"),
+        ("seg:", b"seg:"),
+        ("seggrp:", b"seggrp:"),
+        ("desired:dserver:", b"desired:dserver:"),
+    ];
+    for (name_a, a) in prefixes {
+        for (name_b, b) in prefixes {
+            if name_a == name_b {
+                continue;
+            }
+            assert!(
+                !a.starts_with(b) && !b.starts_with(a),
+                "{name_a:?} and {name_b:?} are not disjoint prefixes"
+            );
+        }
+    }
+
+    // The named near-misses, spelled out explicitly: `scan("mpu:")` must not return the
+    // `mpuctl` singleton (the separator is what keeps them disjoint).
+    assert!(!multipart::MPUCTL_KEY.starts_with(multipart::MPU_PREFIX));
+    // `sidx:` must not be reachable from a `scan("pending:")` — the whole point of the
+    // disjoint owned-staging class (`0016:475-491`).
+    assert!(!multipart::SIDX_PREFIX.starts_with(b"pending:" as &[u8]));
+    assert!(!b"pending:".starts_with(multipart::SIDX_PREFIX));
+}
