+#[test]
+fn decision3_table_is_total_and_matches_0016() {
+    use SessionState::{Aborting, Completed, Completing, Open};
+    use Verb::{
+        AbortMultipartUpload, CompleteMultipartUpload, ListMultipartUploads, ListParts, UploadPart,
+    };
+    use VerbAnswer::*;
+
+    // The 5x5 product, exactly as `0016:969-978` tables it. `fingerprint_matches` is
+    // irrelevant to every cell but one, so `true` here and the dedicated conditional test
+    // below cover both branches (leg 4's "the two [branches]... get both branches").
+    let cells: &[(Verb, Option<SessionState>, VerbAnswer)] = &[
+        (UploadPart, Some(Open), PartAccepted),
+        (UploadPart, Some(Completing), NoSuchUpload),
+        (UploadPart, Some(Aborting), NoSuchUpload),
+        (UploadPart, Some(Completed), NoSuchUpload),
+        (UploadPart, None, NoSuchUpload),
+        (CompleteMultipartUpload, Some(Open), CompleteFences),
+        (CompleteMultipartUpload, Some(Completing), OperationAborted),
+        (CompleteMultipartUpload, Some(Aborting), NoSuchUpload),
+        (
+            CompleteMultipartUpload,
+            Some(Completed),
+            CompleteIdenticalRetry,
+        ),
+        (CompleteMultipartUpload, None, NoSuchUpload),
+        (AbortMultipartUpload, Some(Open), AbortFences),
+        (AbortMultipartUpload, Some(Completing), OperationAborted),
+        (AbortMultipartUpload, Some(Aborting), AbortAlreadyAborting),
+        (AbortMultipartUpload, Some(Completed), NoSuchUpload),
+        (AbortMultipartUpload, None, NoSuchUpload),
+        (ListParts, Some(Open), ListPartsOpenSet),
+        (ListParts, Some(Completing), ListPartsFrozenSet),
+        (ListParts, Some(Aborting), NoSuchUpload),
+        (ListParts, Some(Completed), NoSuchUpload),
+        (ListParts, None, NoSuchUpload),
+        (ListMultipartUploads, Some(Open), Listed),
+        (ListMultipartUploads, Some(Completing), Listed),
+        (ListMultipartUploads, Some(Aborting), NotListed),
+        (ListMultipartUploads, Some(Completed), NotListed),
+        (ListMultipartUploads, None, NotListed),
+    ];
+    assert_eq!(cells.len(), 25, "the table must be the full 5x5 product");
+    for (verb, state, expected) in cells {
+        let answer = decision3_answer(*verb, *state, true);
+        assert_eq!(
+            answer, *expected,
+            "cell ({verb:?}, {state:?}) answered {answer:?}, expected {expected:?}"
+        );
+    }
+}
