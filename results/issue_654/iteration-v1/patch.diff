+// ===========================================================================
+// Leg 6 — `complete_fingerprint` distinguishes an identical retry from a different
+// assembly.
+// ===========================================================================
+
+#[test]
+fn complete_fingerprint_distinguishes_identical_retry_from_different_assembly() {
+    let d1 = hex_lower(&digest(b"one"));
+    let d2 = hex_lower(&digest(b"two"));
+    let d3 = hex_lower(&digest(b"three"));
+
+    let original = vec![(1u32, d1.clone()), (2, d2.clone()), (3, d3.clone())];
+
+    // Identical lists agree.
+    assert_eq!(
+        complete_fingerprint(&original),
+        complete_fingerprint(&original.clone())
+    );
+
+    // A list with one digest changed disagrees.
+    let changed_digest = vec![
+        (1, d1.clone()),
+        (2, hex_lower(&digest(b"TWO'"))),
+        (3, d3.clone()),
+    ];
+    assert_ne!(
+        complete_fingerprint(&original),
+        complete_fingerprint(&changed_digest)
+    );
+
+    // The same digests under different part numbers disagrees.
+    let changed_numbers = vec![(1, d1.clone()), (4, d2.clone()), (3, d3.clone())];
+    assert_ne!(
+        complete_fingerprint(&original),
+        complete_fingerprint(&changed_numbers)
+    );
+
+    // A reordered list of the same pairs agrees iff the canonical order is part-number
+    // ascending (pin which): the ORIGINAL is already ascending (1, 2, 3); a physically
+    // reordered vector holding the SAME pairs in the SAME (ascending) logical order must
+    // still agree (order of construction does not matter, only the sequence hashed).
+    let same_order_rebuilt = vec![(1, d1.clone()), (2, d2.clone()), (3, d3.clone())];
+    assert_eq!(
+        complete_fingerprint(&original),
+        complete_fingerprint(&same_order_rebuilt)
+    );
+    // A vector holding the pairs in DESCENDING order is a different sequence and disagrees
+    // — pinning that ascending part-number order is the canonical one, not just "some fixed
+    // order the caller chose".
+    let descending = vec![(3, d3.clone()), (2, d2.clone()), (1, d1.clone())];
+    assert_ne!(
+        complete_fingerprint(&original),
+        complete_fingerprint(&descending)
+    );
+
+    // A strict subset disagrees.
+    let subset = vec![(1, d1.clone()), (2, d2.clone())];
+    assert_ne!(
+        complete_fingerprint(&original),
+        complete_fingerprint(&subset)
+    );
+}
