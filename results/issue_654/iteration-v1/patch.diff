+/// The carried-forward MUST-FIX: a decoded `mpuctl` whose `max_sessions` disagrees with what
+/// its own `profile` derives is rejected, not trusted (#636's shipped defect).
+#[test]
+fn admission_record_rejects_a_torn_max_sessions() {
+    let profile = Budget {
+        w_ref: 1_000,
+        max_part_chunks: 10,
+        max_parts_per_session: 100,
+        max_inflight_parts: 4,
+        max_staged_chunks: 50,
+    };
+    // u_ref = min((100+4)*10, 50 + 2*4*10) = min(1040, 130) = 130
+    // max_sessions = floor(1000 / 130) = 7
+    assert_eq!(profile.u_ref(), 130);
+    assert_eq!(profile.max_sessions(), 7);
+
+    let valid = AdmissionRecord {
+        count: 1,
+        max_sessions: 7,
+        profile,
+    };
+    let bytes = metadata::encode(&valid);
+    let decoded: AdmissionRecord = metadata::decode(&bytes).expect("a consistent record decodes");
+    assert_eq!(decoded, valid);
+
+    // A hand-authored TORN value: the ledger's stored bytes disagree with its own profile.
+    let torn = br#"{"count":1,"max_sessions":999,"profile":{"w_ref":1000,"max_part_chunks":10,"max_parts_per_session":100,"max_inflight_parts":4,"max_staged_chunks":50}}"#;
+    let result: Result<AdmissionRecord, _> = metadata::decode(torn);
+    assert!(
+        result.is_err(),
+        "a torn mpuctl (max_sessions=999, but its own profile derives 7) must be REJECTED at \
+         decode, not trusted"
+    );
