+    assert_eq!(
+        parse_retire_mode(b"retire:bytes:s:x:1").unwrap(),
+        RetireMode::Bytes
+    );
+    assert_eq!(
+        parse_retire_mode(b"retire:records:s:x:1").unwrap(),
+        RetireMode::Records
+    );
+    // Neither `bytes` nor `records`.
+    assert!(parse_retire_mode(b"retire:frobbed:s:x:1").is_err());
+
+    let malformed: Vec<String> = vec![
+        // `+` sign on the epoch.
+        format!("retire:bytes:s:{UPLOAD_ID}:+3"),
+        // Over-wide / non-canonical leading-zero epoch.
+        format!("retire:bytes:s:{UPLOAD_ID}:03"),
+        // Non-decimal epoch.
+        format!("retire:bytes:s:{UPLOAD_ID}:3a"),
+        // Empty upload id.
+        "retire:bytes:s::3".to_string(),
+        // Upload id containing the separator.
+        format!("retire:bytes:s:{UPLOAD_ID}:{UPLOAD_ID}:3"),
+        // Truncated (no epoch at all).
+        format!("retire:bytes:s:{UPLOAD_ID}"),
+        // A trailing component that fits neither the 3-field nor 5-field session shape.
+        format!("retire:bytes:s:{UPLOAD_ID}:3:extra"),
+        // Generation with a non-canonical version.
+        "retire:bytes:g:9:007".to_string(),
+    ];
+    for key in &malformed {
