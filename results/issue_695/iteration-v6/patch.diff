@@ -0,0 +1,473 @@
+//! Issue #695 (child 1 of 3 of the #681 split, 0016 decision 7(e)): **backfill reads every
+//! committed object through the ONE resolver every consumer shares, contains per object what it
+//! cannot read, declines — rather than aborts or silently mutates — the work it does not own,
+//! reports the placement gauge from that same single reading, and refuses to certify a pass that
+//! answered over less than the committed store.**
+//!
+//! On `origin/main` it read the chunk map inline out of the record at two sites
+//! (`backfill.rs:98-101`, `:180-183`), so ONE segmented object returned `Err` for the WHOLE
+//! store and the drain gauge was never published at all. GC (#650) and restore (#651) already
+//! read through `metadata::resolve_chunk_map` and contain per object; backfill is the last of the
+//! four custodian loops to do so. Every leg drives the real public entry over in-memory trait
+//! doubles and asserts **positive** observables — a record actually filled, bytes actually
+//! unchanged, a name actually on the audit seam — never "no error was raised", which a pass that
+//! did nothing also produces.
+//!
+//! **No leg names a symbol this patch introduces:** the red leg reverts `backfill.rs` and keeps
+//! this file, so naming a new variant/field/helper would make the tree fail to COMPILE and score
+//! a missing symbol as a red. `Reconciled::Blocked` is on the base already
+//! (`reconciliation.rs:44`); the added vocabulary is asserted as the strings the seam publishes.
+
+#![forbid(unsafe_code)]
+
+use std::collections::{BTreeMap, BTreeSet};
+use std::sync::{Arc, Mutex, Once};
+
+use async_trait::async_trait;
+use bytes::Bytes;
+use tracing::instrument::WithSubscriber;
+use tracing_subscriber::prelude::*;
+use wyrd_core::metadata::{
+    self, ChunkMap, ChunkRef, EcScheme, InodeId, InodeRecord, InodeState, SegmentGroup,
+    SegmentRecord, SegmentRef, SegmentedMap,
+};
+use wyrd_custodian::backfill::{reconcile, BackfillContext};
+use wyrd_custodian::Reconciled;
+use wyrd_traits::{ChunkId, CommitOutcome, DServerId, MetadataStore, Result, WriteBatch};
+
+/// The injected fault's exact text, so leg 5 proves THIS error came back rather than any error.
+const STORE_FAULT: &str = "simulated store fault: root re-read unreachable";
+
+/// The ONE metadata double. `BTreeMap`-backed so key order is a fixture *property*: the damaged
+/// records sort FIRST, so "the healthy record was still filled" can never pass merely because the
+/// healthy one was handled before the walk met a blocker. Every prefix read is logged — including
+/// a `seg:` range read, since `scan_page` pages over this same `scan` (leg 4) — and `get` can
+/// fail with a plain, non-`ChunkMapError` fault: a backend outage under the resolver, as opposed
+/// to an anomaly the resolver itself describes and a pass recovers by downcast (leg 5).
+#[derive(Default)]
+struct MemMeta {
+    kv: Mutex<BTreeMap<Vec<u8>, Bytes>>,
+    reads: Mutex<Vec<Vec<u8>>>,
+    fail_get: bool,
+}
+
+impl MemMeta {
+    /// How many reads of the namespace under `prefix` this store answered.
+    fn reads(&self, prefix: &[u8]) -> usize {
+        let seen = self.reads.lock().unwrap();
+        seen.iter().filter(|p| p.starts_with(prefix)).count()
+    }
+}
+
+#[async_trait]
+impl MetadataStore for MemMeta {
+    async fn get(&self, key: &[u8]) -> Result<Option<Bytes>> {
+        if self.fail_get {
+            return Err(Box::new(std::io::Error::other(STORE_FAULT)));
+        }
+        Ok(self.kv.lock().unwrap().get(key).cloned())
+    }
+
+    async fn scan(&self, prefix: &[u8]) -> Result<Vec<(Vec<u8>, Bytes)>> {
+        self.reads.lock().unwrap().push(prefix.to_vec());
+        let kv = self.kv.lock().unwrap();
+        let rows = kv.iter().filter(|(k, _)| k.starts_with(prefix));
+        Ok(rows.map(|(k, v)| (k.clone(), v.clone())).collect())
+    }
+
+    // The required paginated read (#634): a test double needs *a* body, not a backend's — the
+    // dev-only testkit helper pages over this store's own `scan`
+    // (`crates/custodian/tests/segmented_map_consumers.rs:109-116`).
+    async fn scan_page(
+        &self,
+        prefix: &[u8],
+        after: Option<&[u8]>,
+        limit: usize,
+    ) -> Result<wyrd_traits::ScanPage> {
+        wyrd_testkit::test_double_scan_page(self, prefix, after, limit).await
+    }
+
+    async fn commit(&self, batch: WriteBatch) -> Result<CommitOutcome> {
+        let mut kv = self.kv.lock().unwrap();
+        for pre in &batch.preconditions {
+            if kv.get(&pre.key).cloned() != pre.expected {
+                return Ok(CommitOutcome::Conflict);
+            }
+        }
+        for (k, v) in batch.puts {
+            kv.insert(k, v);
+        }
+        for k in batch.deletes {
+            kv.remove(&k);
+        }
+        Ok(CommitOutcome::Committed)
+    }
+}
+
+// ---- the shared fixture: ONE seeding helper, ONE audit-capture helper ----
+
+/// Every fixture chunk is `ReedSolomon{k:2,m:1}` — `fragment_count() == 3`, so a FULL placement
+/// is `[0,1,2]` and the identity fill is visibly full-length, not a single element.
+const FULL: [DServerId; 3] = [0, 1, 2];
+const CHUNK_LEN: u64 = 5;
+const EPOCH: u64 = 7;
+
+/// `inode:1` / `inode:2` sort before `inode:9`, so the damaged records are met FIRST.
+const DAMAGED: InodeId = 1;
+const UNDECODABLE: InodeId = 2;
+const SEGMENTED: InodeId = 3;
+const FLAT: InodeId = 9;
+
+/// What to seed under one committed inode key: a flat record with one chunk per placement (`[]`
+/// is the pre-M3 empty placement to fill); a segmented root naming one `seg:` record per
+/// placement of which only the first `written` are written (a smaller `written` is a segment the
+/// root's own table names, on a generation it still names, that never got written); or bytes that
+/// will not `metadata::decode` at all.
+enum Shape<'a> {
+    Flat(&'a [Vec<DServerId>]),
+    Segmented(&'a [Vec<DServerId>], usize),
+    Undecodable,
+}
+
+/// Each segmented object's own `seg:` group, from its inode id so a leg can rebuild the key.
+fn group(inode: InodeId) -> SegmentGroup {
+    SegmentGroup::new(format!("{inode:032x}"), EPOCH).unwrap()
+}
+
+fn chunk(inode: InodeId, index: usize, placement: &[DServerId]) -> ChunkRef {
+    ChunkRef {
+        id: ChunkId::from(inode) << 8 | index as ChunkId,
+        scheme: EcScheme::ReedSolomon { k: 2, m: 1 },
+        len: CHUNK_LEN,
+        placement: placement.to_vec(),
+    }
+}
+
+async fn commit(meta: &MemMeta, batch: WriteBatch) {
+    assert_eq!(meta.commit(batch).await.unwrap(), CommitOutcome::Committed);
+}
+
+async fn stored(meta: &MemMeta, key: &[u8]) -> Bytes {
+    meta.get(key).await.unwrap().expect("row present")
+}
+
+/// THE seeding helper: one committed object of `shape` at `inode`. Raw `WriteBatch` puts — no
+/// producer of segmented maps exists yet (#653 owns the committer) — but through the real
+/// validating constructors, so a fixture typo cannot silently change WHICH rule a leg exercises.
+/// A damaged shape asserts it is damaged the way its leg needs, so no leg can pass because the
+/// fault it was built around quietly stopped being one.
+async fn seed(meta: &MemMeta, inode: InodeId, shape: Shape<'_>) {
+    let root_key = metadata::inode_key(inode);
+    let (chunk_map, chunks, unreadable) = match shape {
+        Shape::Undecodable => {
+            let bytes = Bytes::from_static(b"{\"not\":\"an inode record\"");
+            let decoded = metadata::decode::<InodeRecord>(&bytes);
+            assert!(decoded.is_err(), "fixture: these bytes must not decode");
+            return commit(meta, WriteBatch::new().put(root_key, bytes)).await;
+        }
+        Shape::Flat(placements) => {
+            let chunks = placements.iter().enumerate();
+            let chunks: Vec<ChunkRef> = chunks.map(|(i, p)| chunk(inode, i, p)).collect();
+            (ChunkMap::from(chunks), placements.len(), false)
+        }
+        Shape::Segmented(placements, written) => {
+            let group = group(inode);
+            for (index, placement) in placements.iter().enumerate().take(written) {
+                let offset = index as u64 * CHUNK_LEN;
+                let seg = SegmentRecord::new(vec![chunk(inode, index, placement)], offset).unwrap();
+                let key = metadata::seg_key(&group, index as u32).unwrap();
+                commit(meta, WriteBatch::new().put(key, metadata::encode(&seg))).await;
+            }
+            let table = (0..placements.len() as u32)
+                .map(|index| SegmentRef {
+                    index,
+                    byte_offset: u64::from(index) * CHUNK_LEN,
+                    byte_len: CHUNK_LEN,
+                })
+                .collect();
+            let map = SegmentedMap::new(group, table).unwrap();
+            let unreadable = written < placements.len();
+            (ChunkMap::Segmented(map), placements.len(), unreadable)
+        }
+    };
+    let root = InodeRecord {
+        // The record's own decode invariant: the declared size is the span its map covers.
+        size: chunks as u64 * CHUNK_LEN,
+        chunk_map,
+        state: InodeState::Committed,
+        version: 1,
+        ..Default::default()
+    };
+    let bytes = metadata::encode(&root);
+    commit(meta, WriteBatch::new().put(root_key.clone(), bytes)).await;
+    if unreadable {
+        // Through `decode` FIRST: this object's fault must be the RESOLVE, on a root whose own
+        // bytes are fine. Without that, a seeding slip (a `size` disagreeing with the segment
+        // table, say) would make it a second undecodable record and leave the resolver-refusal
+        // arm unexercised while the leg still passed.
+        let root: InodeRecord = metadata::decode(&stored(meta, &root_key).await)
+            .expect("fixture: the damaged ROOT must decode — its fault is the resolve");
+        let resolved = metadata::resolve_chunk_map(meta, &root_key, &root).await;
+        assert!(resolved.is_err(), "fixture: its map must fail to resolve");
+    }
+}
+
+/// THE audit-capture helper: every field the durability seam published, `name=value;` per event.
+#[derive(Clone, Default)]
+struct Audit(Arc<Mutex<String>>);
+
+impl<S: tracing::Subscriber> tracing_subscriber::Layer<S> for Audit {
+    fn on_event(&self, event: &tracing::Event<'_>, _: tracing_subscriber::layer::Context<'_, S>) {
+        let mut fields = self.0.lock().unwrap();
+        event.record(
+            &mut |field: &tracing::field::Field, value: &dyn std::fmt::Debug| {
+                fields.push_str(&format!("{field}={value:?};"));
+            },
+        );
+    }
+}
+
+/// One pass over `meta`: its outcome, and what it told the operator. A permissive global default
+/// is installed **once** first, so the audit/metric callsites never latch `Interest::never` under
+/// the parallel harness and leave a sibling leg's capture empty (issue #214; the same guard as
+/// `segmented_map_consumers.rs:317-332`).
+async fn run_pass(meta: &MemMeta) -> (Result<Reconciled>, String) {
+    static INIT: Once = Once::new();
+    INIT.call_once(|| {
+        let _ = tracing::subscriber::set_global_default(tracing_subscriber::registry());
+    });
+    let audit = Audit::default();
+    let dispatch = tracing::Dispatch::new(tracing_subscriber::registry().with(audit.clone()));
+    let outcome = reconcile(&BackfillContext { meta })
+        .with_subscriber(dispatch)
+        .await;
+    let logged = audit.0.lock().unwrap().clone();
+    (outcome, logged)
+}
+
+/// Assert the trail carries `needle` exactly `want` times — one counter tick, one action line.
+fn assert_hits(logged: &str, needle: &str, want: usize, why: &str) {
+    assert_eq!(logged.matches(needle).count(), want, "{why}\n{logged}");
+}
+
+/// The last value a numeric field carried — a gauge is a sample, not a tally.
+fn gauge(logged: &str, name: &str) -> Option<u64> {
+    logged
+        .split(&format!("{name}="))
+        .skip(1)
+        .filter_map(|rest| rest.split(';').next()?.parse().ok())
+        .last()
+}
+
+/// Every DISTINCT record NAME the trail attributed, read back rather than assumed: what makes an
+/// attribution usable is that two damaged records arrive under two names (`gc::object_name`,
+/// `gc.rs:470-480`, escapes rather than replaces).
+fn attributed(logged: &str) -> BTreeSet<String> {
+    logged
+        .split("inode=")
+        .skip(1)
+        .filter_map(|rest| rest.split(';').next())
+        .filter(|name| name.starts_with("inode:"))
+        .map(str::to_owned)
+        .collect()
+}
+
+/// The committed placement `inode`'s first chunk carries in the store now.
+async fn placement(meta: &MemMeta, inode: InodeId) -> Vec<DServerId> {
+    let bytes = stored(meta, &metadata::inode_key(inode)).await;
+    let record: InodeRecord = metadata::decode(&bytes).expect("a filled record still decodes");
+    record.chunk_map.as_flat().unwrap()[0].placement.clone()
+}
+
+/// What the base's SECOND reading of the namespace reported: the empty placements over every
+/// committed flat record, counted straight off the store after the pass. The oracle leg 4 holds
+/// the gauge against, so folding that count into the fill walk cannot quietly change the number
+/// an operator watches drain.
+fn base_style_remaining(meta: &MemMeta) -> u64 {
+    let kv = meta.kv.lock().unwrap();
+    kv.values()
+        .filter_map(|value| metadata::decode::<InodeRecord>(value).ok())
+        .filter(|record| record.state == InodeState::Committed)
+        .flat_map(|record| record.chunk_map.as_flat().unwrap_or_default().to_vec())
+        .filter(|chunk| chunk.placement.is_empty())
+        .count() as u64
+}
+
+// ---- (1) a healthy segmented object is ordinary: it ends nothing and blocks nothing ----
+
+#[tokio::test]
+async fn a_healthy_segmented_object_no_longer_ends_the_pass_and_blocks_nothing() {
+    let meta = MemMeta::default();
+    seed(&meta, SEGMENTED, Shape::Segmented(&[FULL.to_vec()], 1)).await;
+    seed(&meta, FLAT, Shape::Flat(&[vec![]])).await;
+
+    let (outcome, logged) = run_pass(&meta).await;
+    let outcome = outcome.expect("ONE segmented object must not end the fill for the store");
+
+    let filled = placement(&meta, FLAT).await;
+    assert_eq!(
+        filled, FULL,
+        "the flat record IS filled, full-length identity"
+    );
+    assert_eq!(
+        outcome,
+        Reconciled::Changed,
+        "a segmented object the pass READ that needs no fill is healthy: it withholds no \
+         certification, or every store holding a multipart object is blocked forever\n{logged}"
+    );
+}
+
+// ---- (2) a fill this pass may not perform is declined, not aborted and not written ----
+
+#[tokio::test]
+async fn a_fill_this_pass_may_not_perform_is_declined_not_mutated_and_does_not_certify() {
+    let meta = MemMeta::default();
+    seed(&meta, SEGMENTED, Shape::Segmented(&[vec![]], 1)).await;
+    let root_key = metadata::inode_key(SEGMENTED);
+    let seg_key = metadata::seg_key(&group(SEGMENTED), 0).unwrap();
+    let before = (
+        stored(&meta, &root_key).await,
+        stored(&meta, &seg_key).await,
+    );
+
+    let (outcome, logged) = run_pass(&meta).await;
+
+    assert_eq!(
+        outcome.expect("a declined fill is not a failed pass"),
+        Reconciled::Blocked,
+        "the pass declined work it was asked to do: it must NOT certify the drain\n{logged}"
+    );
+    // Byte-identical, root (its `version` with it) and `seg:` record alike: the segmented write
+    // path is #682's, so a decline writes NOTHING at all.
+    let after = (
+        stored(&meta, &root_key).await,
+        stored(&meta, &seg_key).await,
+    );
+    assert_eq!(after, before, "a decline leaves the object byte-identical");
+    let apart = "the decline is named on the seam, and told APART from an unreadable record: this \
+                 object was READ perfectly well, so the operator waits for #682 rather than \
+                 repairing a record nothing is wrong with";
+    assert_hits(&logged, "action=\"declined-segmented\";", 1, apart);
+    assert_hits(&logged, "action=\"unresolvable-chunk-map\";", 0, apart);
+    let counter = "monotonic_counter.backfill_declined_records=1;";
+    assert_hits(&logged, counter, 1, "the decline is counted");
+    assert_eq!(
+        gauge(&logged, "gauge.backfill_placement_remaining"),
+        Some(1),
+        "the declined placement is still OWED: only a committed fill takes one off the \
+         operator's drain signal\n{logged}"
+    );
+    assert_eq!(
+        gauge(&logged, "gauge.backfill_placement_incomplete"),
+        Some(1),
+        "published beside it: the objects this pass could not stand that number behind"
+    );
+}
+
+// ---- (3) an unreadable object is named, contained, and certifies nothing ----
+
+#[tokio::test]
+async fn an_unreadable_committed_object_is_named_the_walk_continues_and_nothing_certifies() {
+    let meta = MemMeta::default();
+    // Both damaged records sort BEFORE the healthy one in the `BTreeMap` the walk reads: (a) a
+    // root naming a segment whose `seg:` record was never written, (b) one whose own bytes will
+    // not decode. `seed` asserts each is damaged in exactly that way.
+    let two_segments = [FULL.to_vec(), FULL.to_vec()];
+    seed(&meta, DAMAGED, Shape::Segmented(&two_segments, 1)).await;
+    seed(&meta, UNDECODABLE, Shape::Undecodable).await;
+    seed(&meta, FLAT, Shape::Flat(&[vec![]])).await;
+
+    let (outcome, logged) = run_pass(&meta).await;
+    let outcome = outcome.expect("a record this pass cannot read must not end the walk");
+
+    assert_eq!(
+        placement(&meta, FLAT).await,
+        FULL,
+        "containment is PER OBJECT: the healthy record met after both damaged ones is still \
+         filled\n{logged}"
+    );
+    assert_eq!(
+        outcome,
+        Reconciled::Blocked,
+        "a pass that answered over less than the committed store certifies nothing — an operator \
+         reading `Satisfied` is being told the store converged\n{logged}"
+    );
+    assert_eq!(
+        attributed(&logged),
+        BTreeSet::from([format!("inode:{DAMAGED}"), format!("inode:{UNDECODABLE}")]),
+        "BOTH are NAMED by their own `inode:` key: a refusal an operator cannot attribute is a \
+         stall with no way out\n{logged}"
+    );
+    let each = "each is counted once, under the same action gc and restore already publish";
+    assert_hits(
+        &logged,
+        "monotonic_counter.backfill_unresolvable_records=1;",
+        2,
+        each,
+    );
+}
+
+// ---- (4) one reading of the namespace per pass, and the same gauge off it ----
+
+#[tokio::test]
+async fn one_reading_of_the_namespace_per_pass() {
+    let meta = MemMeta::default();
+    seed(&meta, DAMAGED, Shape::Flat(&[vec![]])).await;
+    seed(&meta, FLAT, Shape::Flat(&[FULL.to_vec()])).await;
+
+    let (outcome, logged) = run_pass(&meta).await;
+    let outcome = outcome.expect("an ordinary flat store fills uncontested");
+    assert_eq!(outcome, Reconciled::Changed, "{logged}");
+    assert_eq!(
+        meta.reads(b"inode:"),
+        1,
+        "ONE reading of the committed namespace per pass: the population is counted in the walk \
+         that fills, not by a second scan that re-reads — and, over segmented objects, \
+         re-resolves — everything the first already held"
+    );
+    assert_eq!(
+        gauge(&logged, "gauge.backfill_placement_remaining"),
+        Some(base_style_remaining(&meta)),
+        "and the number an operator watches is unchanged by that: it still reports the empty \
+         placements a reading of the store finds after the pass\n{logged}"
+    );
+
+    // …and over a store of S segmented objects, at most S bounded `seg:` range reads.
+    let segmented = MemMeta::default();
+    for inode in [DAMAGED, SEGMENTED] {
+        seed(&segmented, inode, Shape::Segmented(&[FULL.to_vec()], 1)).await;
+    }
+    let (outcome, _logged) = run_pass(&segmented).await;
+    outcome.expect("a store of segmented objects resolves");
+    let ranges = segmented.reads(b"seg:");
+    assert_eq!(
+        segmented.reads(b"inode:"),
+        1,
+        "one namespace reading here too"
+    );
+    assert!(
+        ranges <= 2,
+        "at most ONE `seg:` range read per object; got {ranges}"
+    );
+}
+
+// ---- (5) the over-containment guard: a store fault is not one object's map ----
+
+#[tokio::test]
+async fn a_fault_that_is_not_one_objects_map_still_ends_the_pass() {
+    let meta = MemMeta {
+        fail_get: true,
+        ..Default::default()
+    };
+    seed(&meta, SEGMENTED, Shape::Segmented(&[FULL.to_vec()], 1)).await;
+
+    let (outcome, _logged) = run_pass(&meta).await;
+    let err = outcome.expect_err(
+        "a store failing underneath the resolver is not one object's chunk map: a walk that \
+         cannot read the store has no answer for ANY object, so it must not be contained",
+    );
+    assert!(
+        err.to_string().contains(STORE_FAULT),
+        "and THAT fault must be what came back, not a chunk-map verdict wearing its place: {err}"
+    );
+}
