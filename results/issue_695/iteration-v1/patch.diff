+#[derive(Default)]
+struct Refusals {
+    /// Committed objects this pass could not read at all.
+    unaccounted: usize,
+    /// Records whose fill it read and may not perform.
+    declined: usize,
+    /// Records whose fill lost its version-conditional commit: read, but superseded before it
+    /// landed.
+    superseded: usize,
+}
+
