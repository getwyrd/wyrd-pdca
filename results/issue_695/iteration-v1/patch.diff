--- /dev/null
+++ b/crates/custodian/tests/segmented_map_backfill.rs
@@ -0,0 +1,431 @@
+//! Issue #695 (child 1 of 3 of the #681 split, 0016 decision 7(e)): backfill resolves every
+//! committed object the way every other consumer already resolves one, contains per object what
+//! it cannot read, and declines — rather than aborts or silently mutates — the work it does not
+//! own.
+//!
+//! On the base `backfill::reconcile` reads the chunk map inline
+//! (`record.chunk_map.as_flat().ok_or(SegmentedMapUnsupported)?`), so ONE segmented committed
+//! object — or one record that will not `decode` — stops the fill scan for the WHOLE store.
+//!
+//! Seven legs, over ONE shared fixture (one metadata double, one seeding helper, one audit
+//! capture). No assertion names a symbol this patch introduces (no new variant, field, helper or
+//! `pub fn`): the red leg reverts production, so referencing one would fail to COMPILE instead of
+//! failing an assertion. `Reconciled::Blocked` already exists on the base (`reconciliation.rs:44`).
+//!
+//! 1. segmented no longer ends the pass, flat work still happens
+//! 2. a segmented record is declined, not mutated, non-certifying
+//! 3. an unreadable object is named, the walk continues
+//! 4. Rule A — never write to a generation the pass did not scan
+//! 5. Rule C — read/write/name a record under its own key
+//! 6. one resolving reading of the namespace per pass
+//! 7. NOT base-red — a non-map fault still ends the pass (over-containment guard)
+
+#![forbid(unsafe_code)]
+
+use std::collections::BTreeMap;
+use std::sync::{Arc, Mutex};
+
+use async_trait::async_trait;
+use bytes::Bytes;
+use tracing::instrument::WithSubscriber;
+use tracing_subscriber::prelude::*;
+use wyrd_core::metadata::{
+    self, ChunkMap, ChunkRef, EcScheme, InodeRecord, InodeState, SegmentGroup, SegmentRecord,
+    SegmentRef, SegmentedMap,
+};
+use wyrd_custodian::backfill::{reconcile, BackfillContext};
+use wyrd_custodian::reconciliation::Reconciled;
+use wyrd_traits::{
+    ChunkId, CommitOutcome, DServerId, MetadataStore, Precondition, Result, ScanPage, WriteBatch,
+};
+
+const STORE_FAULT: &str = "simulated store fault: root re-read unreachable";
+
+/// The one metadata double every leg drives: the counters leg 6 reads, the `get` fault leg 7
+/// injects, and (leg 4) a per-key `scan` override that can disagree with `get` — a generation
+/// that changed under the scan, without a second real writer. `BTreeMap`, so `scan` answers in
+/// key order and an earlier-keyed damaged/segmented record is met FIRST (leg 3).
+#[derive(Default)]
+struct MemMeta {
+    kv: Mutex<BTreeMap<Vec<u8>, Bytes>>,
+    inode_scans: Mutex<usize>,
+    seg_scans: Mutex<usize>,
+    failing_gets: Mutex<bool>,
+    stale_scan: Mutex<Option<(Vec<u8>, Bytes)>>,
+}
+
+impl MemMeta {
+    fn get_raw(&self, key: &[u8]) -> Option<Bytes> {
+        self.kv.lock().unwrap().get(key).cloned()
+    }
+}
+
+#[async_trait]
+impl MetadataStore for MemMeta {
+    #[rustfmt::skip]
+    async fn get(&self, key: &[u8]) -> Result<Option<Bytes>> {
+        if *self.failing_gets.lock().unwrap() { return Err(Box::new(std::io::Error::other(STORE_FAULT))); }
+        Ok(self.get_raw(key))
+    }
+
+    #[rustfmt::skip]
+    async fn scan(&self, prefix: &[u8]) -> Result<Vec<(Vec<u8>, Bytes)>> {
+        if prefix.starts_with(b"inode:") { *self.inode_scans.lock().unwrap() += 1; }
+        let stale = self.stale_scan.lock().unwrap().clone();
+        let kv = self.kv.lock().unwrap();
+        let sub = |k: &Vec<u8>, v: &Bytes| match &stale {
+            Some((sk, sv)) if sk == k => sv.clone(),
+            _ => v.clone(),
+        };
+        Ok(kv.iter().filter(|(k, _)| k.starts_with(prefix)).map(|(k, v)| (k.clone(), sub(k, v))).collect())
+    }
+
+    #[rustfmt::skip]
+    async fn scan_page(&self, prefix: &[u8], after: Option<&[u8]>, limit: usize) -> Result<ScanPage> {
+        if prefix.starts_with(b"seg:") { *self.seg_scans.lock().unwrap() += 1; }
+        wyrd_testkit::test_double_scan_page(self, prefix, after, limit).await
+    }
+
+    #[rustfmt::skip]
+    async fn commit(&self, batch: WriteBatch) -> Result<CommitOutcome> {
+        let mut kv = self.kv.lock().unwrap();
+        let lost = |p: &Precondition| kv.get(&p.key).cloned() != p.expected;
+        if batch.preconditions.iter().any(lost) { return Ok(CommitOutcome::Conflict); }
+        kv.extend(batch.puts);
+        for key in batch.deletes { kv.remove(&key); }
+        Ok(CommitOutcome::Committed)
+    }
+}
+
+// ---- audit capture (in-tree pattern, `segmented_map_restore.rs:219-271`) ----
+
+#[derive(Clone, Default)]
+struct Capture(Arc<Mutex<Vec<u8>>>);
+
+impl Capture {
+    fn contents(&self) -> String {
+        String::from_utf8(self.0.lock().unwrap().clone()).unwrap()
+    }
+}
+
+impl std::io::Write for Capture {
+    fn write(&mut self, buf: &[u8]) -> std::io::Result<usize> {
+        self.0.lock().unwrap().extend_from_slice(buf);
+        Ok(buf.len())
+    }
+    fn flush(&mut self) -> std::io::Result<()> {
+        Ok(())
+    }
+}
+
+/// A permissive global default, installed ONCE, so the audit callsites never latch
+/// `Interest::never` under the parallel harness (#214).
+fn enable_audit_callsites() {
+    use std::sync::Once;
+    static INIT: Once = Once::new();
+    INIT.call_once(|| {
+        let _ = tracing::subscriber::set_global_default(tracing_subscriber::registry());
+    });
+}
+
+fn capturing_dispatch(capture: Capture) -> tracing::Dispatch {
+    let json = tracing_subscriber::fmt::layer()
+        .json()
+        .with_writer(move || capture.clone());
+    tracing::Dispatch::new(tracing_subscriber::registry().with(json))
+}
+
+// ---- fixture: raw-record `seg:`/root seeding (no committer lands here; #653's) ----
+
+const CHUNK_LEN: u64 = 5;
+
+#[rustfmt::skip]
+fn flat_ref(id: ChunkId, placement: Vec<DServerId>) -> ChunkRef {
+    ChunkRef { id, scheme: EcScheme::None, len: CHUNK_LEN, placement }
+}
+
+/// One segment's table entry: index `i`, spanning `[i * CHUNK_LEN, (i + 1) * CHUNK_LEN)`.
+#[rustfmt::skip]
+fn seg_ref(index: u32) -> SegmentRef {
+    SegmentRef { index, byte_offset: index as u64 * CHUNK_LEN, byte_len: CHUNK_LEN }
+}
+
+/// A chunk with an EMPTY committed placement — the pre-M3 shape this pass fills.
+fn fillable(id: ChunkId) -> ChunkRef {
+    flat_ref(id, Vec::new())
+}
+
+/// A segment-group nonce (32 lowercase hex chars, `0016:354`) distinguished by `tag`.
+fn nonce(tag: u8) -> String {
+    format!("{:032x}", tag as u128)
+}
+
+async fn put(store: &MemMeta, key: &[u8], value: Bytes) {
+    let batch = WriteBatch::new().put(key.to_vec(), value);
+    let done = store.commit(batch).await.unwrap();
+    assert_eq!(done, CommitOutcome::Committed, "seed");
+}
+
+/// Build a committed record — the one struct literal every root (healthy or manufactured) goes
+/// through, so a scanned/live/stale generation are all built the same way.
+#[rustfmt::skip]
+fn make_record(size: u64, chunk_map: ChunkMap, version: u64) -> InodeRecord {
+    InodeRecord { size, chunk_map, state: InodeState::Committed, version, ..Default::default() }
+}
+
+async fn commit_root(store: &MemMeta, key: &[u8], size: u64, chunk_map: ChunkMap) {
+    let bytes = metadata::encode(&make_record(size, chunk_map, 1));
+    put(store, key, bytes).await;
+}
+
+/// Plant one committed **flat** object.
+async fn seed_flat(store: &MemMeta, key: &[u8], chunks: Vec<ChunkRef>) {
+    let size = chunks.len() as u64 * CHUNK_LEN;
+    commit_root(store, key, size, chunks.into()).await;
+}
+
+/// Plant one committed **segmented** object naming `chunks.len()` segments (one chunk each), of
+/// which only the first `written` `seg:` records are written — a smaller `written` is the real
+/// gap the containment legs exist for (`SegmentAbsent`, surfaced by `resolve_chunk_map`).
+async fn seed_seg(
+    store: &MemMeta,
+    key: &[u8],
+    nonce: &str,
+    epoch: u64,
+    written: usize,
+    chunks: &[(ChunkId, Vec<DServerId>)],
+) {
+    let group = SegmentGroup::new(nonce, epoch).unwrap();
+    let mut table = Vec::new();
+    for (index, (id, placement)) in chunks.iter().enumerate() {
+        table.push(seg_ref(index as u32));
+        if index < written {
+            let refs = vec![flat_ref(*id, placement.clone())];
+            let record = SegmentRecord::new(refs, index as u64 * CHUNK_LEN).unwrap();
+            let at = metadata::seg_key(&group, index as u32).unwrap();
+            put(store, &at, metadata::encode(&record)).await;
+        }
+    }
+    let map = ChunkMap::Segmented(SegmentedMap::new(group, table).unwrap());
+    let size = chunks.len() as u64 * CHUNK_LEN;
+    commit_root(store, key, size, map).await;
+}
+
+async fn backfill(store: &MemMeta) -> Result<Reconciled> {
+    reconcile(&BackfillContext { meta: store }).await
+}
+
+async fn backfill_audited(store: &MemMeta) -> (Result<Reconciled>, String) {
+    let capture = Capture::default();
+    let dispatch = capturing_dispatch(capture.clone());
+    let outcome = async { backfill(store).await }
+        .with_subscriber(dispatch)
+        .await;
+    (outcome, capture.contents())
+}
+
+async fn record_of(store: &MemMeta, key: &[u8]) -> InodeRecord {
+    metadata::decode(&store.get_raw(key).expect("record present")).unwrap()
+}
+
+async fn placement_of(store: &MemMeta, key: &[u8]) -> Vec<DServerId> {
+    record_of(store, key).await.chunk_map.as_flat().unwrap()[0]
+        .placement
+        .clone()
+}
+
+/// Leg 1: a healthy segmented object (nothing owed) beside a fillable flat record — `reconcile`
+/// must return `Ok` (today `Err`) and the flat record must actually be filled.
+#[tokio::test]
+async fn a_segmented_object_no_longer_ends_the_pass_and_the_flat_work_still_happens() {
+    let store = MemMeta::default();
+    seed_seg(&store, b"inode:9", &nonce(1), 7, 1, &[(0xA1, vec![0])]).await;
+    seed_flat(&store, b"inode:1", vec![fillable(0xB1)]).await;
+
+    let outcome = backfill(&store)
+        .await
+        .expect("a segmented object must not end the pass");
+    assert!(
+        outcome == Reconciled::Changed && placement_of(&store, b"inode:1").await == vec![0],
+        "nothing was declined/unaccounted and the flat record's empty placement was filled: {outcome:?}"
+    );
+}
+
+/// Leg 2: a segmented record carrying a fillable placement must be left byte-identical, the
+/// decline must carry a stated reason on the audit seam and be counted, and the pass must not
+/// certify.
+#[tokio::test]
+async fn a_segmented_record_is_declined_not_mutated_and_the_pass_does_not_certify() {
+    enable_audit_callsites();
+    let store = MemMeta::default();
+    seed_seg(&store, b"inode:9", &nonce(2), 7, 1, &[(0xA2, Vec::new())]).await;
+    let group = SegmentGroup::new(nonce(2), 7).unwrap();
+    let seg_key = metadata::seg_key(&group, 0).unwrap();
+    let seg_before = store.get_raw(&seg_key);
+    let version_before = record_of(&store, b"inode:9").await.version;
+
+    let (outcome, logged) = backfill_audited(&store).await;
+    assert_eq!(
+        outcome.unwrap(),
+        Reconciled::Blocked,
+        "a decline must not certify"
+    );
+    let version_after = record_of(&store, b"inode:9").await.version;
+    assert!(
+        store.get_raw(&seg_key) == seg_before && version_after == version_before,
+        "a decline leaves the record byte-identical"
+    );
+    assert!(
+        logged.contains(r#""action":"declined""#)
+            && logged.contains(r#""reason":"segmented-chunk-map""#)
+            && logged.contains(r#""monotonic_counter.backfill_declined_records":1"#),
+        "a decline must state why it stopped and be counted: {logged}"
+    );
+}
+
+/// Leg 3: two damaged shapes — a root naming an UNWRITTEN `seg:` record, and a record whose own
+/// bytes will not `decode` — seeded FIRST in key order beside a fillable flat record. The walk
+/// must survive both, name both, still fill the healthy record, and never certify.
+#[tokio::test]
+async fn an_unreadable_committed_object_is_named_and_the_walk_continues() {
+    enable_audit_callsites();
+    let store = MemMeta::default();
+    const DAMAGED_SEG: &[u8] = b"inode:00";
+    const DAMAGED_RECORD: &[u8] = b"inode:01";
+    const HEALTHY: &[u8] = b"inode:02";
+
+    seed_seg(&store, DAMAGED_SEG, &nonce(3), 3, 0, &[(0xA3, vec![0])]).await;
+    put(&store, DAMAGED_RECORD, Bytes::from_static(b"not a record")).await;
+    seed_flat(&store, HEALTHY, vec![fillable(0xB3)]).await;
+
+    // Fixture: (a) really fails to resolve.
+    let root = record_of(&store, DAMAGED_SEG).await;
+    let bad = metadata::resolve_chunk_map(&store, DAMAGED_SEG, &root).await;
+    assert!(
+        bad.is_err(),
+        "fixture: the unwritten segment must genuinely fail to resolve"
+    );
+
+    let (outcome, logged) = backfill_audited(&store).await;
+    assert!(
+        outcome.unwrap() == Reconciled::Blocked && placement_of(&store, HEALTHY).await == vec![0],
+        "an incomplete reading never certifies, but the healthy record is still filled"
+    );
+    // Both keys are plain ASCII, so `gc::object_name`'s escaping is the identity here.
+    for damaged in [DAMAGED_SEG, DAMAGED_RECORD] {
+        let name = std::str::from_utf8(damaged).unwrap();
+        assert!(
+            logged.contains(&format!(r#""inode":"{name}""#)),
+            "must name {name} on the audit seam: {logged}"
+        );
+    }
+}
+
+/// Leg 4 (Rule A): a double whose `scan` answers a STALE segmented root while `get` answers a
+/// LIVE flat root carrying a fillable placement — a resolve that restarts mid-pass. The pass must
+/// write nothing, leave the live record's version unchanged, and answer `Blocked`.
+#[tokio::test]
+async fn a_pass_never_writes_to_a_generation_it_did_not_scan() {
+    let store = MemMeta::default();
+    const KEY: &[u8] = b"inode:5";
+    let live = make_record(CHUNK_LEN, vec![fillable(0xC1)].into(), 5);
+    put(&store, KEY, metadata::encode(&live)).await;
+
+    // The STALE snapshot the scan will answer with: a segmented root naming ONE segment whose
+    // `seg:` record was never written under THIS group, so its resolve falls back to re-reading
+    // the (now-live, now-flat) root.
+    let group = SegmentGroup::new(nonce(4), 1).unwrap();
+    let map = ChunkMap::Segmented(SegmentedMap::new(group, vec![seg_ref(0)]).unwrap());
+    let stale = make_record(CHUNK_LEN, map, 3);
+    *store.stale_scan.lock().unwrap() = Some((KEY.to_vec(), metadata::encode(&stale)));
+
+    // Fixture: the resolve genuinely restarts through to the LIVE generation.
+    let resolved = metadata::resolve_chunk_map(&store, KEY, &stale)
+        .await
+        .expect("fixture: the stale snapshot restarts")
+        .expect("fixture: the live root is committed");
+    assert_eq!(
+        resolved.record.version, 5,
+        "fixture: resolve answers the live generation"
+    );
+
+    let outcome = backfill(&store)
+        .await
+        .expect("a changed-under-scan object must not error");
+    let unchanged = store.get_raw(KEY).unwrap() == metadata::encode(&live);
+    assert!(
+        outcome == Reconciled::Blocked && unchanged && record_of(&store, KEY).await.version == 5,
+        "acting on the restarted resolve here would be Rule A's violation: {outcome:?}"
+    );
+}
+
+/// Leg 5 (Rule C): a committed, fillable record under `inode:007` beside `inode:7` (both parse to
+/// the SAME id) — `inode:7` must be byte-unchanged, `inode:007` is either filled in place or left
+/// untouched, and the pass must not answer `Satisfied` if it left work undone.
+#[tokio::test]
+async fn a_record_is_read_written_and_named_under_the_key_the_store_gave_it() {
+    let store = MemMeta::default();
+    const CANON: &[u8] = b"inode:7";
+    const PADDED: &[u8] = b"inode:007";
+    seed_flat(&store, CANON, vec![flat_ref(0xD1, vec![0])]).await;
+    seed_flat(&store, PADDED, vec![fillable(0xD2)]).await;
+    let canon_before = store.get_raw(CANON).unwrap();
+
+    let outcome = backfill(&store).await.expect("must not error");
+    assert_eq!(
+        store.get_raw(CANON).unwrap(),
+        canon_before,
+        "inode:7 byte-unchanged"
+    );
+
+    if placement_of(&store, PADDED).await == vec![0] {
+        assert_eq!(
+            outcome,
+            Reconciled::Changed,
+            "the fill landed, nothing else owed"
+        );
+    } else {
+        assert_ne!(
+            outcome,
+            Reconciled::Satisfied,
+            "left undone, never Satisfied"
+        );
+    }
+}
+
+/// Leg 6: S healthy segmented objects beside a fillable flat one — the pass must read `inode:`
+/// ONCE and spend at most one bounded `seg:` range read per segmented object.
+#[tokio::test]
+async fn one_resolving_reading_of_the_namespace_per_pass() {
+    const S: usize = 3;
+    let store = MemMeta::default();
+    for i in 0..S {
+        let key = format!("inode:9{i}").into_bytes();
+        let chunks = &[(0xE0 + i as ChunkId, vec![0])];
+        seed_seg(&store, &key, &nonce(10 + i as u8), 1, 1, chunks).await;
+    }
+    seed_flat(&store, b"inode:99", vec![fillable(0xF0)]).await;
+
+    let outcome = backfill(&store).await.expect("must not error");
+    let seg_reads = *store.seg_scans.lock().unwrap();
+    assert!(
+        outcome == Reconciled::Changed && *store.inode_scans.lock().unwrap() == 1 && seg_reads <= S,
+        "the namespace is read ONCE and at most one `seg:` read per object: {seg_reads}"
+    );
+}
+
+/// Leg 7 (NOT base-red — the over-containment guard, passes before and after): a `get` fault
+/// under the resolve of an otherwise-healthy segmented object must propagate, never be absorbed
+/// as that object's own containment.
+#[tokio::test]
+async fn a_fault_that_is_not_one_objects_map_still_ends_the_pass() {
+    let store = MemMeta::default();
+    seed_seg(&store, b"inode:9", &nonce(5), 1, 1, &[(0xA5, vec![0])]).await;
+    *store.failing_gets.lock().unwrap() = true;
+
+    let outcome = backfill(&store).await;
+    assert!(
+        outcome.is_err(),
+        "a store fault under the resolve must propagate"
+    );
+}
