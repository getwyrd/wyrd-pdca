+//! Issue #695 (child 1 of 3 of the #681 split, proposal 0016 decision 7(e)): **backfill resolves
+//! every committed object the way every other consumer already resolves one**, contains per object
+//! what it cannot read, and declines — rather than aborts or silently mutates — the work it does
+//! not own.
+//!
+//! On the base `backfill::reconcile` reads the chunk map inline
+//! (`record.chunk_map.as_flat().ok_or(SegmentedMapUnsupported)?`, `backfill.rs:99` and `:181`), so
+//! ONE segmented committed object — or one record that will not `decode` — stops the fill scan for
+//! the WHOLE store.
+//!
+//! Eight legs over ONE shared fixture (one metadata double, one seeding helper, one audit
+//! capture). No assertion names a symbol this patch introduces: the red leg reverts production, so
+//! referencing a new variant/field/helper would fail to COMPILE rather than fail an assertion.
+//! `Reconciled::Blocked` already exists on the base (`crates/custodian/src/reconciliation.rs:44`);
+//! the new instruments and audit actions are matched as STRINGS, which compile either way.
+//!
+//! 1. a segmented object no longer ends the pass, and the flat work still happens
+//! 2. a segmented record is declined, not mutated, and the pass does not certify
+//! 3. an unreadable committed object is named, the walk continues, nothing certifies
+//! 4. Rule A — the pass never writes to, nor certifies over, a generation it did not scan
+//! 5. Rule C — a record is read, written and named under exactly the key the store gave it
+//! 6. one resolving reading of the namespace per pass
+//! 7. NOT base-red — a fault that is not one object's map still ends the pass (the
+//!    over-containment guard: without it, containing everything would pass every other leg)
+//! 8. a lost CAS keeps its empty placements ON the published population and carries its caveat
+
+#![forbid(unsafe_code)]
+
+use std::collections::BTreeMap;
+use std::sync::{Arc, Mutex, Once};
+
+use async_trait::async_trait;
+use bytes::Bytes;
+use tracing::instrument::WithSubscriber;
+use tracing_subscriber::prelude::*;
+use wyrd_core::metadata::{
+    self, ChunkMap, ChunkRef, EcScheme, InodeRecord, InodeState, SegmentGroup, SegmentRecord,
+    SegmentRef, SegmentedMap,
+};
+use wyrd_custodian::backfill::{reconcile, BackfillContext};
+use wyrd_custodian::reconciliation::Reconciled;
+use wyrd_traits::{
+    ChunkId, CommitOutcome, DServerId, MetadataStore, Precondition, Result, ScanPage, WriteBatch,
+};
+
+/// The ONE metadata double every leg drives: the counters leg 6 reads, the `get` fault leg 7
+/// injects, and a per-key `scan` override answering a generation `get` no longer holds — a record
+/// that changed under the scan, without a second real writer (legs 4 and 8).
+///
+/// `BTreeMap`, not the `HashMap` the sibling doubles use: `scan` then answers in key order, so "the
+/// damaged record is met FIRST" is a property of the fixture rather than luck
+/// (`crates/custodian/tests/segmented_map_consumers.rs:78-87`).
+#[derive(Default)]
+struct MemMeta {
+    kv: Mutex<BTreeMap<Vec<u8>, Bytes>>,
+    inode_scans: Mutex<usize>,
+    seg_reads: Mutex<usize>,
+    failing_gets: Mutex<bool>,
+    stale_scan: Mutex<Option<(Vec<u8>, Bytes)>>,
+}
+
+#[async_trait]
+impl MetadataStore for MemMeta {
+    #[rustfmt::skip]
+    async fn get(&self, key: &[u8]) -> Result<Option<Bytes>> {
+        if *self.failing_gets.lock().unwrap() { return Err(Box::new(std::io::Error::other("simulated store fault"))); }
+        Ok(raw(self, key))
+    }
+
+    #[rustfmt::skip]
+    async fn scan(&self, prefix: &[u8]) -> Result<Vec<(Vec<u8>, Bytes)>> {
+        if prefix.starts_with(b"inode:") { *self.inode_scans.lock().unwrap() += 1; }
+        let stale = self.stale_scan.lock().unwrap().clone();
+        let kv = self.kv.lock().unwrap();
+        let answer = |k: &Vec<u8>, v: &Bytes| match &stale {
+            Some((stale_key, stale_value)) if stale_key == k => stale_value.clone(),
+            _ => v.clone(),
+        };
+        Ok(kv.iter().filter(|(k, _)| k.starts_with(prefix)).map(|(k, v)| (k.clone(), answer(k, v))).collect())
+    }
+
+    // The required paginated read (#634): a test double needs *a* body, not a backend's — the
+    // dev-only testkit helper pages over this store's own `scan`
+    // (`segmented_map_consumers.rs:109-116`).
+    #[rustfmt::skip]
+    async fn scan_page(&self, prefix: &[u8], after: Option<&[u8]>, limit: usize) -> Result<ScanPage> {
+        if prefix.starts_with(b"seg:") { *self.seg_reads.lock().unwrap() += 1; }
+        wyrd_testkit::test_double_scan_page(self, prefix, after, limit).await
+    }
+
+    #[rustfmt::skip]
+    async fn commit(&self, batch: WriteBatch) -> Result<CommitOutcome> {
+        let mut kv = self.kv.lock().unwrap();
+        let lost = |pre: &Precondition| kv.get(&pre.key).cloned() != pre.expected;
+        if batch.preconditions.iter().any(lost) { return Ok(CommitOutcome::Conflict); }
+        kv.extend(batch.puts);
+        for key in batch.deletes { kv.remove(&key); }
+        Ok(CommitOutcome::Committed)
+    }
+}
+
+// ---- audit capture (the in-tree pattern, `segmented_map_restore.rs:219-271`) ----
+
+#[derive(Clone, Default)]
+struct Capture(Arc<Mutex<Vec<u8>>>);
+
+impl std::io::Write for Capture {
+    fn write(&mut self, buf: &[u8]) -> std::io::Result<usize> {
+        self.0.lock().unwrap().extend_from_slice(buf);
+        Ok(buf.len())
+    }
+
+    #[rustfmt::skip]
+    fn flush(&mut self) -> std::io::Result<()> { Ok(()) }
+}
+
+// ---- fixture: raw-record `seg:`/root seeding (no committer lands here; that is #653's) ----
+
+const CHUNK_LEN: u64 = 5;
+
+/// A chunk with the given committed placement. `EcScheme::None`, so `fragment_count()` is 1 and the
+/// explicit identity vector this pass materializes is exactly `[0]`.
+#[rustfmt::skip]
+fn chunk(id: ChunkId, placement: Vec<DServerId>) -> ChunkRef {
+    ChunkRef { id, scheme: EcScheme::None, len: CHUNK_LEN, placement }
+}
+
+/// A chunk with an EMPTY committed placement — the pre-M3 shape this pass exists to fill.
+fn fillable(id: ChunkId) -> ChunkRef {
+    chunk(id, Vec::new())
+}
+
+/// A segment group distinguished by `tag`, whose nonce is 32 lowercase hex chars (`0016:354`).
+fn group(tag: u8, epoch: u64) -> SegmentGroup {
+    SegmentGroup::new(format!("{tag:032x}"), epoch).unwrap()
+}
+
+/// Build one committed generation over `chunks`: FLAT when `seg` is `None`, else a SEGMENTED root
+/// naming one segment per chunk, index `i` spanning `[i * CHUNK_LEN, (i + 1) * CHUNK_LEN)`. The one
+/// struct literal every generation — planted, live or stale — goes through, so no leg compares two
+/// records that were built differently.
+#[rustfmt::skip]
+fn root(chunks: &[ChunkRef], version: u64, seg: Option<(u8, u64)>) -> InodeRecord {
+    let chunk_map = match seg {
+        None => chunks.to_vec().into(),
+        Some((tag, epoch)) => {
+            let table = (0..chunks.len() as u32)
+                .map(|index| SegmentRef { index, byte_offset: index as u64 * CHUNK_LEN, byte_len: CHUNK_LEN })
+                .collect();
+            ChunkMap::Segmented(SegmentedMap::new(group(tag, epoch), table).unwrap())
+        }
+    };
+    let size = chunks.len() as u64 * CHUNK_LEN;
+    InodeRecord { size, chunk_map, state: InodeState::Committed, version, ..Default::default() }
+}
+
+/// The ONE seeding helper: plant one committed object (at generation 1) at `key` over `chunks`.
+/// `seg` is `Some((nonce tag, epoch, segments actually WRITTEN))` for a segmented object — a
+/// `written` below `chunks.len()` is the real gap the containment legs exist for, a segment the
+/// root's own table names, on a generation it still names, that genuinely never got written
+/// (`ChunkMapError::SegmentAbsent`, as surfaced by `resolve_chunk_map`) — or `None` for a flat one.
+/// The seeding shape copied from `segmented_map_restore.rs:387-410`.
+async fn seed(store: &MemMeta, key: &[u8], chunks: &[ChunkRef], seg: Option<(u8, u64, usize)>) {
+    if let Some((tag, epoch, written)) = seg {
+        for (index, held) in chunks.iter().enumerate().take(written) {
+            let at = metadata::seg_key(&group(tag, epoch), index as u32).unwrap();
+            let record = SegmentRecord::new(vec![held.clone()], index as u64 * CHUNK_LEN).unwrap();
+            put(store, &at, metadata::encode(&record)).await;
+        }
+    }
+    let planted = root(chunks, 1, seg.map(|(tag, epoch, _)| (tag, epoch)));
+    put(store, key, metadata::encode(&planted)).await;
+}
+
+async fn put(store: &MemMeta, key: &[u8], value: Bytes) {
+    let batch = WriteBatch::new().put(key.to_vec(), value);
+    assert_eq!(store.commit(batch).await.unwrap(), CommitOutcome::Committed);
+}
+
+/// The bytes the store actually HOLDS under `key` — read past the `scan` override and past the
+/// injected `get` fault, which is what a "byte-identical" leg must be judged on.
+fn raw(store: &MemMeta, key: &[u8]) -> Option<Bytes> {
+    store.kv.lock().unwrap().get(key).cloned()
+}
+
+fn placement_of(store: &MemMeta, key: &[u8]) -> Vec<DServerId> {
+    let record: InodeRecord = metadata::decode(&raw(store, key).expect("record present")).unwrap();
+    record.chunk_map.as_flat().unwrap()[0].placement.clone()
+}
+
+/// The ONE entry point every leg runs a pass through: its outcome, plus the durability seam's JSON
+/// audit trail for that pass.
+#[rustfmt::skip]
+async fn backfill(store: &MemMeta) -> (Result<Reconciled>, String) {
+    // A permissive global default, installed ONCE: `tracing` caches each callsite's interest in
+    // process-global state the first time it is hit, so a sibling test in this binary that fired an
+    // audit callsite with no subscriber installed would otherwise latch `Interest::never` for the
+    // whole process and leave every capture below empty (issue #214).
+    static INIT: Once = Once::new();
+    INIT.call_once(|| { let _ = tracing::subscriber::set_global_default(tracing_subscriber::registry()); });
+    let capture = Capture::default();
+    let sink = capture.clone();
+    let json = tracing_subscriber::fmt::layer().json().with_writer(move || sink.clone());
+    let dispatch = tracing::Dispatch::new(tracing_subscriber::registry().with(json));
+    let outcome = reconcile(&BackfillContext { meta: store }).with_subscriber(dispatch).await;
+    let logged = String::from_utf8(capture.0.lock().unwrap().clone()).unwrap();
+    (outcome, logged)
+}
+
+/// The two numbers this pass published: the empty-placement population REMAINING, and the caveat
+/// beside it — how many committed objects it could not stand that number behind. Sliced out of the
+/// audit trail by instrument NAME, as strings, so a leg compiles on the base (where the caveat
+/// instrument does not exist) and fails as an assertion rather than as a build error; `""` is "no
+/// such instrument on the seam".
+#[rustfmt::skip]
+fn published(logged: &str) -> (&str, &str) {
+    let field = |name: &str| logged
+        .split_once(&format!(r#""gauge.{name}":"#))
+        .map_or("", |(_, rest)| rest.split([',', '}']).next().unwrap_or(""));
+    (field("backfill_placement_remaining"), field("backfill_placement_incomplete"))
+}
+
+/// **Leg 1** — a healthy segmented object (nothing owed) beside a fillable flat record: `reconcile`
+/// must return `Ok` (today `Err`), the flat record must actually be filled, and the pass must
+/// publish a drained population over a reading with no hole in it.
+#[tokio::test]
+async fn a_segmented_object_no_longer_ends_the_pass_and_the_flat_work_still_happens() {
+    let store = MemMeta::default();
+    seed(&store, b"inode:9", &[chunk(0xA1, vec![0])], Some((1, 7, 1))).await;
+    seed(&store, b"inode:1", &[fillable(0xB1)], None).await;
+
+    let (outcome, logged) = backfill(&store).await;
+    let outcome = outcome.expect("a segmented object must not end the pass");
+    assert!(
+        outcome == Reconciled::Changed
+            && placement_of(&store, b"inode:1") == vec![0]
+            && published(&logged) == ("0", "0"),
+        "the flat record fills beside the segmented one, over a drained complete reading: {logged}"
+    );
+}
+
+/// **Leg 2** — a segmented record carrying a fillable placement is left byte-identical, the decline
+/// carries a stated reason on the audit seam and is counted, its chunks stay ON the published
+/// population, and the pass does not certify.
+#[tokio::test]
+async fn a_segmented_record_is_declined_not_mutated_and_the_pass_does_not_certify() {
+    let store = MemMeta::default();
+    const KEY: &[u8] = b"inode:9";
+    seed(&store, KEY, &[fillable(0xA2)], Some((2, 7, 1))).await;
+    let seg_key = metadata::seg_key(&group(2, 7), 0).unwrap();
+    let before = (raw(&store, &seg_key), raw(&store, KEY));
+
+    let (outcome, logged) = backfill(&store).await;
+    assert_eq!(
+        outcome.unwrap(),
+        Reconciled::Blocked,
+        "a declined fill must not certify a drain it did not complete: {logged}"
+    );
+    assert_eq!(
+        (raw(&store, &seg_key), raw(&store, KEY)),
+        before,
+        "a decline writes NOTHING AT ALL: both records stay byte-identical"
+    );
+    assert!(
+        logged.contains(r#""action":"declined""#)
+            && logged.contains(r#""reason":"segmented-chunk-map""#)
+            && logged.contains(r#""monotonic_counter.backfill_declined_records":1"#)
+            && published(&logged) == ("1", "1"),
+        "a decline states why it stopped, is counted, and stays population: {logged}"
+    );
+}
+
+/// **Leg 3** — two damaged shapes seeded FIRST in key order over the `BTreeMap`-backed store: a
+/// committed root naming a `seg:` record that was never written, and a committed record whose own
+/// bytes will not `decode`. The walk must survive both, name both by their `inode:` key, still fill
+/// the healthy record beyond them, and never certify.
+#[tokio::test]
+async fn an_unreadable_committed_object_is_named_and_the_walk_continues() {
+    let store = MemMeta::default();
+    const DAMAGED_SEG: &[u8] = b"inode:00";
+    const DAMAGED_RECORD: &[u8] = b"inode:01";
+    const HEALTHY: &[u8] = b"inode:02";
+    let damaged = [chunk(0xA3, vec![0])];
+    seed(&store, DAMAGED_SEG, &damaged, Some((3, 3, 0))).await;
+    put(&store, DAMAGED_RECORD, Bytes::from_static(b"not a record")).await;
+    seed(&store, HEALTHY, &[fillable(0xB3)], None).await;
+    // Fixture: the unwritten segment really does make the resolve fail, so no leg can pass because
+    // the fault it was built around silently stopped being one.
+    let unreadable = root(&damaged, 1, Some((3, 3)));
+    assert!(
+        metadata::resolve_chunk_map(&store, DAMAGED_SEG, &unreadable)
+            .await
+            .is_err(),
+        "fixture: the seeded root's map must genuinely fail to resolve"
+    );
+
+    let (outcome, logged) = backfill(&store).await;
+    let outcome = outcome.expect("one damaged object must not end the walk");
+    // Both keys are printable ASCII, so `gc::object_name`'s escaping is the identity here
+    // (`crates/custodian/src/gc.rs:470-480`).
+    let named = |key: &[u8]| {
+        let name = std::str::from_utf8(key).unwrap();
+        logged.contains(&format!(r#""inode":"{name}""#))
+    };
+    assert!(
+        outcome == Reconciled::Blocked
+            && placement_of(&store, HEALTHY) == vec![0]
+            && named(DAMAGED_SEG)
+            && named(DAMAGED_RECORD),
+        "an incomplete reading never certifies, the healthy record beyond both blockers is still \
+         filled, and each record to repair is NAMED: {logged}"
+    );
+}
+
+/// **Leg 4 (Rule A)** — a double whose `scan` answers a STALE segmented root while `get` answers the
+/// live generation: the resolve restarts onto a generation this pass never scanned. Over every
+/// successor shape — one carrying a fillable placement, one already filled (an EMPTY successor
+/// worklist), and one with no live committed generation at all — the pass must write nothing, leave
+/// the live record byte-identical, and answer `Blocked`. `Satisfied` here certifies a store the
+/// pass never read.
+#[tokio::test]
+async fn a_pass_never_writes_to_a_generation_it_did_not_scan() {
+    const KEY: &[u8] = b"inode:5";
+    let pending = InodeRecord {
+        state: InodeState::Pending,
+        ..root(&[fillable(0xC3)], 5, None)
+    };
+    let filled = root(&[chunk(0xC2, vec![0])], 5, None);
+    let successors = [
+        ("a fillable successor", root(&[fillable(0xC1)], 5, None)),
+        ("an already-filled one", filled),
+        ("no live committed generation", pending),
+    ];
+    for (successor, live) in successors {
+        let store = MemMeta::default();
+        put(&store, KEY, metadata::encode(&live)).await;
+        // The STALE snapshot the scan answers with: a committed segmented root naming one segment
+        // whose `seg:` record was never written under THIS group, so resolving it re-reads the
+        // root, finds it moved on, and restarts onto whatever is live (`metadata.rs:2338-2339`).
+        let stale = root(&[fillable(0xC0)], 3, Some((4, 1)));
+        *store.stale_scan.lock().unwrap() = Some((KEY.to_vec(), metadata::encode(&stale)));
+        let restarted = metadata::resolve_chunk_map(&store, KEY, &stale)
+            .await
+            .expect("fixture: a superseded snapshot restarts rather than failing");
+        assert!(
+            !matches!(&restarted, Some(answer) if *answer.record == stale),
+            "fixture ({successor}): the resolve must not answer the scanned generation"
+        );
+
+        let (outcome, logged) = backfill(&store).await;
+        let outcome = outcome.expect("an object that changed under the scan must not end the pass");
+        assert!(
+            outcome == Reconciled::Blocked && raw(&store, KEY) == Some(metadata::encode(&live)),
+            "{successor}: nothing is written to, nor certified over, an unscanned one: {logged}"
+        );
+    }
+}
+
+/// **Leg 5 (Rule C)** — a committed, fillable record under `inode:007` beside `inode:7`: both keys
+/// parse to the same id, so a pass that re-derives its CAS key from the parse reads one record and
+/// writes another. `inode:7` must be byte-unchanged, and the pass must not answer `Satisfied` while
+/// `inode:007`'s fill is still owed.
+#[tokio::test]
+async fn a_record_is_read_written_and_named_under_the_key_the_store_gave_it() {
+    let store = MemMeta::default();
+    const CANONICAL: &[u8] = b"inode:7";
+    const PADDED: &[u8] = b"inode:007";
+    seed(&store, CANONICAL, &[chunk(0xD1, vec![0])], None).await;
+    seed(&store, PADDED, &[fillable(0xD2)], None).await;
+    let canonical_before = raw(&store, CANONICAL);
+
+    let (outcome, logged) = backfill(&store).await;
+    let outcome = outcome.expect("must not error");
+    let settled = if placement_of(&store, PADDED) == vec![0] {
+        outcome == Reconciled::Changed && published(&logged).0 == "0"
+    } else {
+        outcome != Reconciled::Satisfied
+    };
+    assert!(
+        raw(&store, CANONICAL) == canonical_before && settled,
+        "the record no work was owed on is byte-unchanged, and the padded key is either filled \
+         under ITSELF or left owed — never certified away: {logged}"
+    );
+}
+
+/// **Leg 6** — on a store of S segmented objects the pass costs at most one bounded `seg:` range
+/// read per object and exactly ONE `inode:` scan, gauge included: the remaining-placement number
+/// must be counted in the walk that filled, never by a second resolving reading of the namespace.
+#[tokio::test]
+async fn one_resolving_reading_of_the_namespace_per_pass() {
+    const S: usize = 3;
+    let store = MemMeta::default();
+    for tag in 0..S {
+        let key = format!("inode:9{tag}").into_bytes();
+        let held = [chunk(0xE0 + tag as ChunkId, vec![0])];
+        seed(&store, &key, &held, Some((10 + tag as u8, 1, 1))).await;
+    }
+    seed(&store, b"inode:99", &[fillable(0xF0)], None).await;
+
+    let (outcome, logged) = backfill(&store).await;
+    let outcome = outcome.expect("must not error");
+    let inode_scans = *store.inode_scans.lock().unwrap();
+    let seg_reads = *store.seg_reads.lock().unwrap();
+    assert!(
+        outcome == Reconciled::Changed && inode_scans == 1 && seg_reads <= S,
+        "every object read and the flat one filled, in ONE reading of the namespace \
+         ({inode_scans}), at most one `seg:` read per object ({seg_reads} for {S}): {logged}"
+    );
+}
+
+/// **Leg 7** (NOT base-red — the over-containment guard, green before and after): a `get` fault
+/// under the resolve of an otherwise-healthy segmented object is not that object's own fault, so it
+/// must end the pass rather than be absorbed as containment. Without this leg, containing
+/// everything would pass every other leg here.
+#[tokio::test]
+async fn a_fault_that_is_not_one_objects_map_still_ends_the_pass() {
+    let store = MemMeta::default();
+    seed(&store, b"inode:9", &[chunk(0xA5, vec![0])], Some((5, 1, 1))).await;
+    *store.failing_gets.lock().unwrap() = true;
+
+    let (outcome, _) = backfill(&store).await;
+    assert!(
+        outcome.is_err(),
+        "a store fault under the resolve is not one object's map: it must propagate"
+    );
+}
+
+/// **Leg 8** — a fill that loses its version-conditional commit. The winner may have filled those
+/// placements or left them exactly as they were, and this pass cannot tell which: they must STAY on
+/// the published population (a drain-to-zero watch reading zero here would license #363's fallback
+/// removal over work still owed) and the object must join the reading's caveat, named on the audit
+/// seam under the store's own key.
+#[tokio::test]
+async fn a_lost_cas_keeps_its_population_and_says_the_reading_is_incomplete() {
+    let store = MemMeta::default();
+    const KEY: &[u8] = b"inode:5";
+    // The live generation the CAS meets: what a racing writer left behind — version bumped, its
+    // placement still EMPTY (`crates/custodian/tests/backfill.rs:297-310`).
+    let live = root(&[fillable(0xF1)], 5, None);
+    put(&store, KEY, metadata::encode(&live)).await;
+    let scanned = root(&[fillable(0xF1)], 4, None);
+    *store.stale_scan.lock().unwrap() = Some((KEY.to_vec(), metadata::encode(&scanned)));
+
+    let (outcome, logged) = backfill(&store).await;
+    let outcome = outcome.expect("a lost race must not end the pass");
+    assert!(
+        outcome == Reconciled::Satisfied && raw(&store, KEY) == Some(metadata::encode(&live)),
+        "losing the second fence is ordinary: the pass answers over what it did, and never \
+         clobbers the winner: {logged}"
+    );
+    assert!(
+        published(&logged) == ("1", "1")
+            && logged.contains(r#""action":"conflict""#)
+            && logged.contains(r#""inode":"inode:5""#)
+            && logged.contains(r#""monotonic_counter.backfill_conflict":1"#),
+        "the empties it could not settle stay ON the population, over a reading whose hole is \
+         counted, named under the key the store gave it: {logged}"
+    );
+}
