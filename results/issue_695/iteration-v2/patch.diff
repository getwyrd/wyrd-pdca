+/// generation that is no longer live, so the reading has a hole in it either way.
+#[derive(Default)]
+struct Refusals {
+    /// Committed objects this pass could not read at all.
+    unaccounted: usize,
+    /// Records whose fill it read and may not perform.
+    declined: usize,
+    /// Records whose generation stopped being the live one before it could be read (Rule A):
+    /// resolved from a restart, or with no live committed generation left at all.
+    changed_under_scan: usize,
+    /// Records whose fill lost its version-conditional commit: read and attempted, superseded
+    /// before it landed.
+    superseded: usize,
+}
