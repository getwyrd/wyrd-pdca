+    /// Whether the pass must refuse to certify: it read less than the committed namespace, or
+    /// declined work it read. A lost CAS is deliberately not one of these — see [`Refusals`].
+    fn refuses_to_certify(&self) -> bool {
+        self.unaccounted + self.declined + self.changed_under_scan > 0
