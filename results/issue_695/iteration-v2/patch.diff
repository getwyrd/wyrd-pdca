+    /// NAME one object whose fill a racing writer beat, and count it as a hole in the READING —
+    /// not as work refused.
+    fn superseded(&mut self, key: &[u8]) {
+        emit_conflict(&crate::gc::object_name(key));
+        self.superseded += 1;
+    }
