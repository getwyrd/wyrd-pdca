+impl Refusals {
+    /// NAME one object this pass could not account for on the audit seam, and count it — emitted
+    /// where the object is READ, before the fills that follow it (`gc.rs:159-166`), so a later
+    /// store fault cannot cost the operator the name of the record to repair.
+    fn cannot_account_for(&mut self, action: &'static str, key: &[u8], fault: &dyn Display) {
+        emit_unaccounted(action, &crate::gc::object_name(key), fault);
+        self.unaccounted += 1;
+    }
+
+    /// NAME one object whose fill this pass declined — the reason, and how many chunks it left
+    /// carrying an empty placement — and count it. ONCE per object (Rule D): a line per chunk
+    /// floods the seam an operator reads.
+    fn declined(&mut self, key: &[u8], reason: &'static str, chunks: usize) {
+        emit_declined(&crate::gc::object_name(key), reason, chunks);
+        self.declined += 1;
+    }
+
+    /// NAME one object that moved out from under the scan before this pass could read it, and
+    /// count it. Not a repair signal: an overwrite or a delete racing a maintenance pass is
+    /// ordinary, and the next pass reads whatever replaced it.
+    fn changed_under_scan(&mut self, key: &[u8], reason: &'static str) {
+        emit_changed_under_scan(&crate::gc::object_name(key), reason);
+        self.changed_under_scan += 1;
+    }
