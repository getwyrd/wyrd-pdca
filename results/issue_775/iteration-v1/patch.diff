+/// One repo-hygiene guard `cargo xtask ci` runs before the cargo steps.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum CiGuard {
+    /// (1) no stray gitlinks or tracked agent worktrees (#616).
+    Gitlink,
+    /// (2) `#![forbid(unsafe_code)]` in every crate root (#616).
+    UnsafeForbid,
+    /// (3) the blackbox validator's normal closure holds no Wyrd crate (#775).
+    BlackboxClosure,
+}
+
+/// The guards `cargo xtask ci` runs, in order, via [`run_ci_guards`].
+///
+/// Data in the lib target, not a sequence of calls in `main.rs`, so a test can
+/// see which guards the gate actually runs: a guard that is defined and tested
+/// but never called would otherwise pass every test (the same reason
+/// [`crate::feature_gated_checks`] lives here).
+pub const CI_GUARDS: &[CiGuard] = &[
+    CiGuard::Gitlink,
+    CiGuard::UnsafeForbid,
+    CiGuard::BlackboxClosure,
+];
+
+/// Run every guard in [`CI_GUARDS`] through `exec`, stopping at the first
+/// failure. `run_ci` passes a closure that prints [`CiGuard::step`] and calls
+/// [`CiGuard::run`]; a test passes a recording closure.
+pub fn run_ci_guards(exec: &mut dyn FnMut(CiGuard) -> Result<(), String>) -> Result<(), String> {
+    for guard in CI_GUARDS {
+        exec(*guard)?;
+    }
+    Ok(())
+}
+
+impl CiGuard {
+    /// The step banner `cargo xtask ci` prints before running the guard.
+    pub fn step(self) -> [&'static str; 3] {
+        match self {
+            CiGuard::Gitlink => ["xtask", "gitlink-guard", "(#616 no stray gitlinks)"],
+            CiGuard::UnsafeForbid => [
+                "xtask",
+                "unsafe-guard",
+                "(#616 forbid(unsafe_code) in crate roots)",
+            ],
+            CiGuard::BlackboxClosure => [
+                "xtask",
+                "blackbox-guard",
+                "(#775 wyrd-validate links no wyrd-* crate)",
+            ],
+        }
+    }
+
+    /// Run the guard against the workspace at `root`.
+    pub fn run(self, root: &Path) -> Result<(), String> {
+        match self {
+            CiGuard::Gitlink => run_gitlink_guard(root),
+            CiGuard::UnsafeForbid => run_unsafe_forbid_guard(root),
+            CiGuard::BlackboxClosure => run_blackbox_guard(root),
+        }
+    }
+}
+
+/// #616: no stray gitlinks in the index. Four PRs (#594, #595, #597, #600)
+/// accidentally committed `.claude/worktrees/*` gitlink entries (mode 160000,
+/// no `.gitmodules` declaration), which break fresh clones and had to be
+/// caught by review each time — the "found twice becomes a gate" rule. Runs
+/// the SAME scan `xtask/tests/repo_hygiene_guards.rs` drives over planted
+/// index listings ([`scan_gitlinks`]) — one guard, two call sites.
+fn run_gitlink_guard(root: &Path) -> Result<(), String> {
+    // `-z`: NUL-delimited raw paths — the newline form C-quotes non-ASCII
+    // paths under the default `core.quotePath`, which would let a quoted
+    // `.claude/worktrees/…` entry dodge the prefix check.
+    let output = Command::new("git")
+        .args(["ls-files", "-s", "-z"])
+        .current_dir(root)
+        .output()
+        .map_err(|e| format!("gitlink-guard: failed to spawn git: {e}"))?;
+    if !output.status.success() {
+        return Err(format!(
+            "gitlink-guard: `git ls-files -s -z` failed with {}:\n{}",
+            output.status,
+            String::from_utf8_lossy(&output.stderr)
+        ));
+    }
+    let ls_files = String::from_utf8_lossy(&output.stdout);
+    // Declared submodule paths via `git config -z` so git itself decodes any
+    // quoted/escaped values — no ad-hoc .gitmodules parsing here. Read the
+    // INDEX blob (`--blob :.gitmodules`), not the working-tree file, so the
+    // declarations come from the same snapshot as `git ls-files -s` and an
+    // unstaged edit cannot legitimize a staged gitlink.
+    let declared = if index_has(&ls_files, ".gitmodules") {
+        let cfg = Command::new("git")
+            .args([
+                "config",
+                "-z",
+                "--blob",
+                ":.gitmodules",
+                "--get-regexp",
+                r"^submodule\..*\.(path|url)$",
+            ])
+            .current_dir(root)
+            .output()
+            .map_err(|e| format!("gitlink-guard: failed to spawn git config: {e}"))?;
+        // Exit 1 with empty output = no matches (a .gitmodules with no path
+        // entries); anything else non-zero — e.g. a malformed .gitmodules —
+        // is a real failure the guard must surface, not an empty declared list.
+        let no_matches = cfg.status.code() == Some(1) && cfg.stdout.is_empty();
+        if !cfg.status.success() && !no_matches {
+            return Err(format!(
+                "gitlink-guard: `git config -f .gitmodules` failed with {}:\n{}",
+                cfg.status,
+                String::from_utf8_lossy(&cfg.stderr)
+            ));
+        }
+        gitmodules_config_paths(&String::from_utf8_lossy(&cfg.stdout))
+    } else {
+        Vec::new()
+    };
+    let violations = scan_gitlinks(&ls_files, &declared);
+    if violations.is_empty() {
+        println!("xtask gitlink-guard: no stray gitlinks or tracked agent worktrees (#616)");
+        Ok(())
+    } else {
+        Err(format!(
+            "stray tracked entries (#616) — remove them from the index (`git rm --cached \
+             <path>`); real submodules need a .gitmodules declaration:\n  {}",
+            violations.join("\n  ")
+        ))
+    }
+}
+
+/// #616: every crate root under `crates/` carries `#![forbid(unsafe_code)]`
+/// (`metadata-fdb` holds the sole FFI-motivated `deny` exception — see
+/// [`UNSAFE_FORBID_ALLOWLIST`]). The convention held by habit until the two
+/// newest crates shipped without the attribute; this makes it load-bearing.
+/// Same scan the fixture test drives.
+fn run_unsafe_forbid_guard(root: &Path) -> Result<(), String> {
+    // Authoritative target list from cargo itself: manifest `path` overrides
+    // and unconventional layouts cannot hide a root from the scan (#616).
+    let meta = Command::new("cargo")
+        .args(["metadata", "--no-deps", "--format-version", "1"])
+        .current_dir(root)
+        .output()
+        .map_err(|e| format!("unsafe-guard: failed to spawn cargo metadata: {e}"))?;
+    if !meta.status.success() {
+        return Err(format!(
+            "unsafe-guard: `cargo metadata` failed with {}:\n{}",
+            meta.status,
+            String::from_utf8_lossy(&meta.stderr)
+        ));
+    }
+    let metadata = String::from_utf8_lossy(&meta.stdout);
+    let roots = target_src_paths(&metadata)?;
+    let mut violations = scan_roots(&roots, root)?;
+    // A crate under `crates/` that is missing from `[workspace] members` never
+    // reaches metadata, so the scan above would pass over it silently.
+    violations.extend(unregistered_manifests(&metadata, &root.join("crates"))?);
+    if violations.is_empty() {
+        println!("xtask unsafe-guard: every crate root forbids unsafe code (#616)");
+        Ok(())
+    } else {
+        Err(format!(
+            "crate roots missing the unsafe-code attribute (#616) — add \
+             `#![forbid(unsafe_code)]` after the crate-level docs (or record an audited \
+             exception in UNSAFE_FORBID_ALLOWLIST with a stated reason):\n  {}",
+            violations.join("\n  ")
+        ))
+    }
+}
+
+/// Run `cargo` with [`BLACKBOX_METADATA_ARGS`] in `root` and return its JSON.
+/// The input [`CiGuard::BlackboxClosure`] scans, exposed so the real-workspace
+/// test reads exactly what the gate reads.
+pub fn blackbox_metadata(root: &Path) -> Result<String, String> {
+    let meta = Command::new("cargo")
+        .args(BLACKBOX_METADATA_ARGS)
+        .current_dir(root)
+        .output()
+        .map_err(|e| format!("blackbox-guard: failed to spawn cargo metadata: {e}"))?;
+    if !meta.status.success() {
+        return Err(format!(
+            "blackbox-guard: `cargo {}` failed with {}:\n{}",
+            BLACKBOX_METADATA_ARGS.join(" "),
+            meta.status,
+            String::from_utf8_lossy(&meta.stderr)
+        ));
+    }
+    String::from_utf8(meta.stdout)
+        .map_err(|e| format!("blackbox-guard: cargo metadata is not UTF-8: {e}"))
+}
+
+/// #775: the blackbox validator links no Wyrd crate (proposal 0017 §9), over
+/// the real workspace's metadata.
+fn run_blackbox_guard(root: &Path) -> Result<(), String> {
+    blackbox_guard_verdict(&blackbox_metadata(root)?)
+}
+
+/// The blackbox guard's verdict over one `cargo metadata` document: `Ok` when
+/// [`scan_blackbox_closure`] finds nothing, otherwise an `Err` listing each
+/// violation (or the scan's own fail-closed error). `cargo xtask ci` reaches
+/// it through [`CiGuard::BlackboxClosure`]; `cargo xtask blackbox-guard
+/// <file>` runs it over a planted document, which is how the tests drive it.
+pub fn blackbox_guard_verdict(metadata_json: &str) -> Result<(), String> {
+    let violations = scan_blackbox_closure(metadata_json)?;
+    if violations.is_empty() {
+        println!(
+            "xtask blackbox-guard: {BLACKBOX_PACKAGE}'s normal dependency closure holds no \
+             {WYRD_CRATE_PREFIX}* crate (#775)"
+        );
+        Ok(())
+    } else {
+        Err(format!(
+            "the blackbox validator reaches a Wyrd crate (#775, proposal 0017 §9) — its \
+             verdict would test Wyrd against Wyrd's own types. Only dev-dependencies may \
+             name a {WYRD_CRATE_PREFIX}* crate:\n  {}",
+            violations.join("\n  ")
+        ))
+    }
+}
diff --git a/xtask/tests/blackbox_dependency_guard.rs b/xtask/tests/blackbox_dependency_guard.rs
new file mode 100644
index 0000000..445d78a
--- /dev/null
+++ b/xtask/tests/blackbox_dependency_guard.rs
@@ -0,0 +1,385 @@
+//! #775 blackbox dependency-closure guard: the flippable regressions for the
+//! third repo-hygiene invariant `cargo xtask ci` runs — `wyrd-validate`'s
+//! normal dependency closure holds no `wyrd-*` crate (proposal 0017 §9).
+//!
+//! Three things are pinned here:
+//!
+//! 1. the guard is in the set `run_ci` executes: `cargo xtask repo-guards`
+//!    runs the same `run_repo_guards` step `run_ci` calls (the list is
+//!    `xtask::repo_guard::CI_GUARDS`), and its output must show the blackbox
+//!    guard running and passing — a guard that is defined and tested but never
+//!    called would pass everything else in this file;
+//! 2. the scan is red on planted `cargo metadata` documents — a direct normal
+//!    edge, an optional off-by-default edge, a transitive edge — green on a dev
+//!    edge, and green over the real workspace;
+//! 3. the scan fails closed on a document it cannot fully see.
+//!
+//! Every case drives the real `xtask` binary (`cargo xtask blackbox-guard
+//! <file>` runs the production `scan_blackbox_closure` over a planted
+//! document), so nothing here re-implements the guard. The documents are
+//! synthetic so the red cases never require committing the accident the guard
+//! exists to prevent.
+
+#![forbid(unsafe_code)]
+
+use std::path::{Path, PathBuf};
+use std::process::{Command, Output};
+
+use serde_json::{json, Value};
+
+/// The workspace root (`<root>/xtask` is this crate's manifest dir).
+fn workspace_root() -> PathBuf {
+    Path::new(env!("CARGO_MANIFEST_DIR"))
+        .parent()
+        .expect("xtask crate is nested under the workspace root")
+        .to_path_buf()
+}
+
+/// Run the real `xtask` binary with `args` from the workspace root.
+fn xtask(args: &[&str]) -> Output {
+    Command::new(env!("CARGO_BIN_EXE_xtask"))
+        .args(args)
+        .current_dir(workspace_root())
+        .output()
+        .expect("failed to spawn the xtask binary")
+}
+
+/// What `cargo xtask blackbox-guard <doc>` said about a planted document.
+struct Verdict {
+    passed: bool,
+    /// One entry per reported violation line.
+    violations: Vec<String>,
+    /// Everything the binary printed, for assertion messages.
+    output: String,
+}
+
+/// Plant `doc` in a file (under cargo's per-test scratch dir) and run the
+/// guard over it. `tag` keeps concurrent tests' files apart.
+fn scan(tag: &str, doc: &str) -> Verdict {
+    let file = Path::new(env!("CARGO_TARGET_TMPDIR"))
+        .join(format!("blackbox-guard-{tag}-{}.json", std::process::id()));
+    std::fs::write(&file, doc).expect("plant the metadata document");
+    let out = xtask(&["blackbox-guard", file.to_str().expect("utf-8 path")]);
+    std::fs::remove_file(&file).ok();
+    let output = format!(
+        "{}{}",
+        String::from_utf8_lossy(&out.stdout),
+        String::from_utf8_lossy(&out.stderr)
+    );
+    let violations = output
+        .lines()
+        .filter(|l| l.contains("must not link Wyrd crate"))
+        .map(str::to_string)
+        .collect();
+    Verdict {
+        passed: out.status.success(),
+        violations,
+        output,
+    }
+}
+
+// ─── planted `cargo metadata` documents ──────────────────────────────────────
+
+const VALIDATE: &str = "path+file:///ws/crates/validate#wyrd-validate@0.0.0";
+const CORE: &str = "path+file:///ws/crates/core#wyrd-core@0.0.0";
+const MIDDLE: &str = "registry+https://github.com/rust-lang/crates.io-index#middle@1.0.0";
+const LEAF: &str = "registry+https://github.com/rust-lang/crates.io-index#leaf@1.0.0";
+
+/// A package record as `cargo metadata` emits it.
+fn package(id: &str, name: &str, dependencies: Value) -> Value {
+    json!({ "id": id, "name": name, "version": "0.0.0", "dependencies": dependencies })
+}
+
+/// A declared dependency entry (`packages[].dependencies[]`).
+fn declared(name: &str, kind: Option<&str>, optional: bool) -> Value {
+    json!({ "name": name, "kind": kind, "optional": optional, "rename": null, "target": null })
+}
+
+/// A resolve node with its outgoing edges, each `(pkg, kind)`. The edge's
+/// `name` is the extern-crate name, which a rename can change — it is set to
+/// junk so a scan that read names from edges instead of package records
+/// would miss every violation below.
+fn node(id: &str, edges: &[(&str, Option<&str>)]) -> Value {
+    let deps: Vec<Value> = edges
+        .iter()
+        .map(|(pkg, kind)| {
+            json!({
+                "name": "renamed",
+                "pkg": pkg,
+                "dep_kinds": [{ "kind": kind, "target": null }]
+            })
+        })
+        .collect();
+    json!({ "id": id, "deps": deps, "features": [] })
+}
+
+fn document(packages: Vec<Value>, nodes: Vec<Value>) -> Value {
+    json!({
+        "packages": packages,
+        "workspace_members": [VALIDATE, CORE],
+        "resolve": { "nodes": nodes, "root": null },
+        "version": 1
+    })
+}
+
+/// `wyrd-validate` with one DIRECT edge to `wyrd-core` of the given kind,
+/// present both in the manifest and in the resolve graph.
+fn direct_edge(kind: Option<&str>) -> Value {
+    document(
+        vec![
+            package(
+                VALIDATE,
+                "wyrd-validate",
+                json!([declared("wyrd-core", kind, false)]),
+            ),
+            package(CORE, "wyrd-core", json!([])),
+        ],
+        vec![node(VALIDATE, &[(CORE, kind)]), node(CORE, &[])],
+    )
+}
+
+// ─── (1) the guard runs inside `cargo xtask ci` ──────────────────────────────
+
+#[test]
+fn the_ci_guard_step_runs_the_blackbox_guard_and_it_passes() {
+    let out = xtask(&["repo-guards"]);
+    let stdout = String::from_utf8_lossy(&out.stdout);
+    let stderr = String::from_utf8_lossy(&out.stderr);
+    assert!(
+        out.status.success(),
+        "the repo-guard step must pass on the real tree:\n{stdout}\n{stderr}"
+    );
+    // The two #616 guards keep running, and the blackbox guard runs after them.
+    let at = |needle: &str| {
+        stdout
+            .find(needle)
+            .unwrap_or_else(|| panic!("`{needle}` missing from the guard step:\n{stdout}"))
+    };
+    let gitlink = at("$ xtask gitlink-guard");
+    let unsafe_forbid = at("$ xtask unsafe-guard");
+    let blackbox = at("$ xtask blackbox-guard");
+    assert!(
+        gitlink < unsafe_forbid && unsafe_forbid < blackbox,
+        "{stdout}"
+    );
+    assert!(
+        stdout.contains("xtask blackbox-guard: wyrd-validate's normal dependency closure holds no"),
+        "the blackbox guard ran to a clean verdict:\n{stdout}"
+    );
+}
+
+#[test]
+fn the_real_workspace_has_no_violation() {
+    // No argument: the guard runs `cargo metadata --locked --all-features`
+    // itself, exactly as the `ci` step does.
+    let out = xtask(&["blackbox-guard"]);
+    assert!(
+        out.status.success(),
+        "{}{}",
+        String::from_utf8_lossy(&out.stdout),
+        String::from_utf8_lossy(&out.stderr)
+    );
+}
+
+// ─── (2) the scan is flippable ───────────────────────────────────────────────
+
+#[test]
+fn a_normal_dependency_on_a_wyrd_crate_is_one_violation_naming_it() {
+    let v = scan("direct-normal", &direct_edge(None).to_string());
+    assert!(!v.passed, "{}", v.output);
+    assert_eq!(v.violations.len(), 1, "{}", v.output);
+    assert!(v.violations[0].contains("`wyrd-core`"), "{}", v.output);
+    assert!(
+        v.violations[0].contains("manifest") && v.violations[0].contains("dependency graph"),
+        "both checks fired and the wording says so: {}",
+        v.output
+    );
+}
+
+#[test]
+fn a_dev_dependency_on_a_wyrd_crate_is_allowed() {
+    let v = scan("direct-dev", &direct_edge(Some("dev")).to_string());
+    assert!(v.passed, "{}", v.output);
+    assert!(v.violations.is_empty(), "{}", v.output);
+}
+
+#[test]
+fn an_optional_off_by_default_wyrd_dependency_is_a_violation() {
+    // The declaration is optional and its feature is off, so a default-feature
+    // resolve graph has no edge to it: only the manifest check can see it.
+    let doc = document(
+        vec![
+            package(
+                VALIDATE,
+                "wyrd-validate",
+                json!([declared("wyrd-core", None, true)]),
+            ),
+            package(CORE, "wyrd-core", json!([])),
+        ],
+        vec![node(VALIDATE, &[]), node(CORE, &[])],
+    );
+    let v = scan("optional", &doc.to_string());
+    assert!(!v.passed, "{}", v.output);
+    assert_eq!(v.violations.len(), 1, "{}", v.output);
+    assert!(
+        v.violations[0].contains("`wyrd-core`")
+            && v.violations[0].contains("optional")
+            && v.violations[0].contains("manifest"),
+        "{}",
+        v.output
+    );
+}
+
+#[test]
+fn a_transitive_wyrd_dependency_is_a_violation_naming_the_path() {
+    // wyrd-validate -> middle -> leaf -> wyrd-core; the manifest names only
+    // `middle`, so only the graph walk can find it.
+    let doc = document(
+        vec![
+            package(
+                VALIDATE,
+                "wyrd-validate",
+                json!([declared("middle", None, false)]),
+            ),
+            package(MIDDLE, "middle", json!([])),
+            package(LEAF, "leaf", json!([])),
+            package(CORE, "wyrd-core", json!([])),
+        ],
+        vec![
+            node(VALIDATE, &[(MIDDLE, None)]),
+            node(MIDDLE, &[(LEAF, None)]),
+            node(LEAF, &[(CORE, None)]),
+            node(CORE, &[]),
+        ],
+    );
+    let v = scan("transitive", &doc.to_string());
+    assert!(!v.passed, "{}", v.output);
+    assert_eq!(v.violations.len(), 1, "{}", v.output);
+    assert!(
+        v.violations[0].contains("wyrd-validate -> middle -> leaf -> wyrd-core"),
+        "the violation names the path: {}",
+        v.output
+    );
+}
+
+#[test]
+fn a_wyrd_crate_behind_a_dev_edge_further_down_is_not_followed() {
+    // A third-party crate's own dev-dependency never links into our binary.
+    let doc = document(
+        vec![
+            package(
+                VALIDATE,
+                "wyrd-validate",
+                json!([declared("middle", None, false)]),
+            ),
+            package(MIDDLE, "middle", json!([])),
+            package(CORE, "wyrd-core", json!([])),
+        ],
+        vec![
+            node(VALIDATE, &[(MIDDLE, None)]),
+            node(MIDDLE, &[(CORE, Some("dev"))]),
+            node(CORE, &[]),
+        ],
+    );
+    let v = scan("deep-dev", &doc.to_string());
+    assert!(v.passed, "{}", v.output);
+}
+
+// ─── (3) the scan fails closed ───────────────────────────────────────────────
+
+/// The guard must refuse the document with its own fail-closed error — not
+/// pass it, and not report it as an ordinary violation.
+fn assert_refused(tag: &str, doc: &str, why: &str) {
+    let v = scan(tag, doc);
+    assert!(!v.passed, "{why}: must not pass:\n{}", v.output);
+    assert!(
+        v.violations.is_empty() && v.output.contains("xtask: blackbox-guard: "),
+        "{why}: must fail with the guard's own error:\n{}",
+        v.output
+    );
+}
+
+#[test]
+fn an_unparsable_document_is_refused() {
+    assert_refused("unparsable", "{ not json", "unparsable document");
+}
+
+#[test]
+fn a_document_without_a_resolve_graph_is_refused() {
+    // What `cargo metadata --no-deps` produces: `resolve` is null.
+    let mut doc = direct_edge(None);
+    doc["resolve"] = Value::Null;
+    assert_refused("resolve-null", &doc.to_string(), "resolve is null");
+    doc.as_object_mut().unwrap().remove("resolve");
+    assert_refused("resolve-absent", &doc.to_string(), "resolve is absent");
+}
+
+#[test]
+fn a_missing_blackbox_package_is_refused() {
+    // E.g. `crates/validate` dropped from `[workspace] members`: removing the
+    // subject must not make the guard pass.
+    let doc = document(
+        vec![package(CORE, "wyrd-core", json!([]))],
+        vec![node(CORE, &[])],
+    );
+    assert_refused("no-subject", &doc.to_string(), "no wyrd-validate package");
+}
+
+#[test]
+fn a_blackbox_package_in_no_resolve_node_is_refused() {
+    let doc = document(
+        vec![
+            package(VALIDATE, "wyrd-validate", json!([])),
+            package(CORE, "wyrd-core", json!([])),
+        ],
+        vec![node(CORE, &[])],
+    );
+    assert_refused("subject-no-node", &doc.to_string(), "package in no node");
+}
+
+#[test]
+fn a_reached_package_in_no_resolve_node_is_refused() {
+    let doc = document(
+        vec![
+            package(
+                VALIDATE,
+                "wyrd-validate",
+                json!([declared("middle", None, false)]),
+            ),
+            package(MIDDLE, "middle", json!([])),
+        ],
+        vec![node(VALIDATE, &[(MIDDLE, None)])],
+    );
+    assert_refused(
+        "reached-no-node",
+        &doc.to_string(),
+        "reached package, no node",
+    );
+}
+
+#[test]
+fn a_reached_package_record_without_a_name_is_refused() {
+    // Without the name the prefix check cannot run; reading a name out of the
+    // opaque id instead is exactly the fallback that lets it miss.
+    let mut doc = direct_edge(None);
+    doc["packages"][1].as_object_mut().unwrap().remove("name");
+    assert_refused("no-name", &doc.to_string(), "reached record without a name");
+}
+
+#[test]
+fn a_reached_package_record_without_an_id_is_refused() {
+    let mut doc = direct_edge(None);
+    doc["packages"][1].as_object_mut().unwrap().remove("id");
+    assert_refused("no-id", &doc.to_string(), "reached record without an id");
+}
+
+#[test]
+fn an_edge_without_dep_kinds_is_refused() {
+    // Cannot tell a normal edge from a dev edge, so it must not be skipped.
+    let mut doc = direct_edge(None);
+    doc["resolve"]["nodes"][0]["deps"][0]
+        .as_object_mut()
+        .unwrap()
+        .remove("dep_kinds");
+    assert_refused("no-dep-kinds", &doc.to_string(), "edge without dep_kinds");
+}
diff --git a/xtask/tests/repo_hygiene_guards.rs b/xtask/tests/repo_hygiene_guards.rs
index b57803b..a00f0ed 100644
--- a/xtask/tests/repo_hygiene_guards.rs
+++ b/xtask/tests/repo_hygiene_guards.rs
@@ -1,6 +1,6 @@
 //! #616 repo-hygiene guards: the flippable regressions for the two scans
-//! `cargo xtask ci` runs via `run_gitlink_guard` / `run_unsafe_forbid_guard`
