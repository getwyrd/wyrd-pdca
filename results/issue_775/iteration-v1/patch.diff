+/// The package whose normal dependency closure must hold no Wyrd crate
+/// (proposal 0017 §9).
+pub const BLACKBOX_PACKAGE: &str = "wyrd-validate";
+
+/// The package-name prefix every Wyrd workspace crate carries.
+pub const WYRD_CRATE_PREFIX: &str = "wyrd-";
+
+/// The `cargo` arguments the blackbox guard runs to get its input.
+///
+/// NOT `--no-deps` (the unsafe guard's form): that omits the `resolve` graph
+/// this guard walks. `--locked`, so the audit can never rewrite the
+/// `Cargo.lock` it audits. `--all-features`, because the resolve graph depends
+/// on features: an optional dependency behind an off-by-default feature (the
+/// `crates/metadata-tikv/Cargo.toml` pattern) is absent from a default-feature
+/// graph. Resolving is all it does — nothing is compiled, so it needs neither
+/// the TiKV nor the FoundationDB toolchain.
+pub const BLACKBOX_METADATA_ARGS: &[&str] = &[
+    "metadata",
+    "--format-version",
+    "1",
+    "--locked",
+    "--all-features",
+];
+
+/// What the blackbox scan found about one offending crate. Both checks can
+/// fire for the same crate (a direct normal dependency is both declared and
+/// in the graph); they are merged so each crate is reported once.
+#[derive(Default)]
+struct BlackboxFinding {
+    /// Declared as a normal dependency in the manifest; `true` when optional.
+    declared_optional: Option<bool>,
+    /// The shortest normal-edge path from the blackbox package to the crate.
+    path: Option<Vec<String>>,
+}
+
+/// Is a `kind` field from `cargo metadata` a NORMAL edge? `null` is normal,
+/// `"dev"` and `"build"` are not (neither links into the shipped binary).
+/// A missing field or an unknown kind is an error: the guard does not guess.
+fn is_normal_kind(kind: Option<&serde_json::Value>, what: &str) -> Result<bool, String> {
+    match kind {
+        Some(serde_json::Value::Null) => Ok(true),
+        Some(serde_json::Value::String(k)) if k == "dev" || k == "build" => Ok(false),
+        Some(other) => Err(format!(
+            "blackbox-guard: {what} has an unknown dependency kind {other} — refusing to \
+             guess whether it links into the binary"
+        )),
+        None => Err(format!(
+            "blackbox-guard: {what} has no `kind` field — refusing to guess whether it \
+             links into the binary"
+        )),
+    }
+}
+
+/// Scan `cargo metadata` output (run with [`BLACKBOX_METADATA_ARGS`]) for
+/// Wyrd crates that [`BLACKBOX_PACKAGE`] could link, returning one violation
+/// per offending crate (empty ⇒ clean).
+///
+/// Two checks, reported under the same invariant:
+///
+/// * **the graph** — follow only normal (`kind: null`) edges of
+///   `resolve.nodes`, transitively from the blackbox package, and report every
+///   reached package whose name starts with [`WYRD_CRATE_PREFIX`], with the
+///   path that reaches it;
+/// * **the manifest** — the package's declared `dependencies`, which do not
+///   depend on features: any normal `wyrd-*` entry, optional or not.
+///
+/// Fails CLOSED, like [`scan_roots`]: a document it cannot parse, a missing
+/// `resolve` section, a blackbox package that is absent or appears in no
+/// resolve node, an edge to a package with no node, or a package record with
+/// no decodable `id` or `name` is `Err`, never a clean pass. Names come from
+/// the package records, never from parsing an id: an id is opaque (a path
+/// package's id need not contain its name), so reading the name out of it
+/// could let the prefix check miss.
+pub fn scan_blackbox_closure(metadata_json: &str) -> Result<Vec<String>, String> {
+    let meta: serde_json::Value = serde_json::from_str(metadata_json)
+        .map_err(|e| format!("blackbox-guard: cannot parse cargo metadata: {e}"))?;
+    let packages = meta
+        .get("packages")
+        .and_then(|p| p.as_array())
+        .ok_or_else(|| "blackbox-guard: cargo metadata has no `packages` array".to_string())?;
+
+    // Every package record's identity, decoded strictly.
+    let mut name_of: BTreeMap<&str, &str> = BTreeMap::new();
+    let mut subject = None;
+    for package in packages {
+        let id = package
+            .get("id")
+            .and_then(|i| i.as_str())
+            .ok_or_else(|| "blackbox-guard: a package record has no decodable `id`".to_string())?;
+        let name = package
+            .get("name")
+            .and_then(|n| n.as_str())
+            .ok_or_else(|| {
+                format!("blackbox-guard: package record `{id}` has no decodable `name`")
+            })?;
+        name_of.insert(id, name);
+        if name == BLACKBOX_PACKAGE {
+            if subject.is_some() {
+                return Err(format!(
+                    "blackbox-guard: cargo metadata reports more than one `{BLACKBOX_PACKAGE}` \
+                     package — cannot tell which one ships"
+                ));
+            }
+            subject = Some((id, package));
+        }
+    }
+    let Some((subject_id, subject)) = subject else {
+        return Err(format!(
+            "blackbox-guard: cargo metadata has no `{BLACKBOX_PACKAGE}` package — refusing to \
+             pass a guard whose subject it cannot see (is `crates/validate` still a \
+             [workspace] member?)"
+        ));
+    };
+
+    let mut findings: BTreeMap<String, BlackboxFinding> = BTreeMap::new();
+
+    // (a) The manifest: declared normal dependencies, optional ones included.
+    let declared = subject
+        .get("dependencies")
+        .and_then(|d| d.as_array())
+        .ok_or_else(|| {
+            format!("blackbox-guard: `{BLACKBOX_PACKAGE}` has no `dependencies` array")
+        })?;
+    for dep in declared {
+        let name = dep.get("name").and_then(|n| n.as_str()).ok_or_else(|| {
+            format!("blackbox-guard: a declared dependency of `{BLACKBOX_PACKAGE}` has no name")
+        })?;
+        let what = format!("declared dependency `{name}` of `{BLACKBOX_PACKAGE}`");
+        if is_normal_kind(dep.get("kind"), &what)? && name.starts_with(WYRD_CRATE_PREFIX) {
+            let optional = dep
+                .get("optional")
+                .and_then(|o| o.as_bool())
+                .unwrap_or(false);
+            findings
+                .entry(name.to_string())
+                .or_default()
+                .declared_optional = Some(optional);
+        }
+    }
+
+    // (b) The graph: normal edges only, transitively.
+    let nodes = meta
+        .get("resolve")
+        .and_then(|r| r.get("nodes"))
+        .and_then(|n| n.as_array())
+        .ok_or_else(|| {
+            "blackbox-guard: cargo metadata has no `resolve.nodes` graph (was it run with \
+             --no-deps?)"
+                .to_string()
+        })?;
+    let mut node_of: BTreeMap<&str, &serde_json::Value> = BTreeMap::new();
+    for node in nodes {
+        let id = node
+            .get("id")
+            .and_then(|i| i.as_str())
+            .ok_or_else(|| "blackbox-guard: a resolve node has no decodable `id`".to_string())?;
+        node_of.insert(id, node);
+    }
+    if !node_of.contains_key(subject_id) {
+        return Err(format!(
+            "blackbox-guard: `{BLACKBOX_PACKAGE}` appears in no resolve node — refusing to \
+             pass a closure it cannot see"
+        ));
+    }
+
+    let mut seen: BTreeSet<&str> = BTreeSet::from([subject_id]);
+    let mut queue: VecDeque<(&str, Vec<String>)> =
+        VecDeque::from([(subject_id, vec![BLACKBOX_PACKAGE.to_string()])]);
+    while let Some((id, path)) = queue.pop_front() {
+        let node = node_of.get(id).ok_or_else(|| {
+            format!("blackbox-guard: package `{id}` is reached but appears in no resolve node")
+        })?;
+        let deps = node
+            .get("deps")
+            .and_then(|d| d.as_array())
+            .ok_or_else(|| format!("blackbox-guard: resolve node `{id}` has no `deps` array"))?;
+        for dep in deps {
+            let pkg = dep.get("pkg").and_then(|p| p.as_str()).ok_or_else(|| {
+                format!("blackbox-guard: an edge of resolve node `{id}` has no `pkg`")
+            })?;
+            let kinds = dep
+                .get("dep_kinds")
+                .and_then(|k| k.as_array())
+                .ok_or_else(|| {
+                    format!(
+                        "blackbox-guard: edge `{id}` -> `{pkg}` has no `dep_kinds` (cargo too \
+                         old?) — cannot tell normal from dev edges"
+                    )
+                })?;
+            let mut normal = false;
+            for kind in kinds {
+                normal |= is_normal_kind(kind.get("kind"), &format!("edge `{id}` -> `{pkg}`"))?;
+            }
+            if !normal || !seen.insert(pkg) {
+                continue;
+            }
+            let name = name_of.get(pkg).ok_or_else(|| {
+                format!("blackbox-guard: edge `{id}` -> `{pkg}` reaches a package with no record")
+            })?;
+            let mut next = path.clone();
+            next.push((*name).to_string());
+            if name.starts_with(WYRD_CRATE_PREFIX) {
+                findings.entry((*name).to_string()).or_default().path = Some(next.clone());
+            }
+            queue.push_back((pkg, next));
+        }
+    }
+
+    Ok(findings
+        .into_iter()
+        .map(|(name, finding)| {
+            let mut how = Vec::new();
+            if let Some(optional) = finding.declared_optional {
+                how.push(format!(
+                    "declared as a normal{} dependency in its manifest",
+                    if optional { " optional" } else { "" }
+                ));
+            }
+            if let Some(path) = finding.path {
+                how.push(format!(
+                    "reached through the normal dependency graph (all features): {}",
+                    path.join(" -> ")
+                ));
+            }
+            format!(
+                "{BLACKBOX_PACKAGE} must not link Wyrd crate `{name}`: {}",
+                how.join("; ")
+            )
+        })
+        .collect())
+}
