+/// How many audit events classify their subject under `action` — "once per object, never
+/// once per chunk" is a COUNT, so it is counted.
+fn lines_with(logged: &str, action: &str) -> usize {
+    logged.matches(&format!(r#""action":"{action}""#)).count()
+}
+
+// ONE fixture, raw-record `seg:` + root seeding (this slice lands no producer of segmented
+// maps; #653 owns the real staged-publication committer): the D server the operator marks
+// draining and the one healthy domain an evacuation off it can land in — the smallest
+// topology that can still move a fragment; one chunk's worth of object bytes, whose length
+// the `seg:` byte spans and every `ChunkRef::len` agree on; and a segment-group nonce (32
+// lowercase hex characters, `0016:354`) per seeded object, so nothing about one object sits
+// inside another's bounded `seg:` range.
+const DRAINING: DServerId = 0;
+const TARGET: DServerId = 1;
+const PAYLOAD: &[u8] = b"drain me";
+const CHUNK_LEN: u64 = PAYLOAD.len() as u64;
+const NONCE: &str = "0123456789abcdef0123456789abcdef";
+const OTHER: &str = "fedcba9876543210fedcba9876543210";
+
+/// The fleet as [`RebalanceContext`] takes it (one `ChunkStore` double per topology server),
+/// and what one pass answered beside the audit stream it emitted.
+type Fleet<'a> = [(DServerId, &'a dyn ChunkStore); 2];
+type Pass = (std::result::Result<Reconciled, String>, String);
+
+fn doubles() -> (MemMeta, MemDServer, MemDServer) {
+    Default::default()
+}
+
+fn frag(chunk: ChunkId) -> FragmentId {
+    FragmentId { chunk, index: 0 }
+}
+
+fn store<'a>(fleet: &Fleet<'a>, at: DServerId) -> &'a dyn ChunkStore {
+    fleet.iter().find(|(id, _)| *id == at).expect("in fleet").1
+}
+
+async fn holds(fleet: &Fleet<'_>, at: DServerId, chunk: ChunkId) -> bool {
+    let held = store(fleet, at).get_fragment(frag(chunk)).await;
+    held.unwrap().is_some()
+}
+
+/// Every fixture chunk is ONE fragment (`EcScheme::None`: k = 1, the lone fragment IS the data)
+/// on exactly one D server — the smallest WELL-FORMED placement there is (length 1 ==
+/// `fragment_count()`), so no leg's answer can be explained by a malformed one.
+fn chunk_ref(chunk: ChunkId, at: DServerId) -> ChunkRef {
+    ChunkRef {
+        id: chunk,
+        scheme: EcScheme::None,
+        len: CHUNK_LEN,
+        placement: vec![at],
+    }
+}
+
+async fn commit(meta: &MemMeta, batch: WriteBatch) {
+    assert_eq!(meta.commit(batch).await.unwrap(), CommitOutcome::Committed);
+}
+
+/// Seed one committed object at `inode` owning `chunks` — `(chunk id, the D server its
+/// single fragment sits on)` — each fragment put on its server as REAL, checksummed bytes
+/// minted by the production encoder, so an evacuation this pass DOES perform passes the same
+/// `repair::fragment_intact` verify it passes in production.
+///
+/// `nonce` picks the shape: `None` is the ordinary **flat** map; `Some((nonce, written))` the
+/// `seg:`-backed **segmented** one, of which only the first `written` segment records are
+/// actually written — `written < chunks.len()` is the genuinely unreadable root, a segment
+/// the root's own table names that never got written (`ChunkMapError::SegmentAbsent`). Built
+/// through the real validating constructors, so a fixture typo cannot silently change WHICH
+/// rule a leg exercises; the seeding is a raw `WriteBatch` put, never a publish path.
+async fn seed(
+    meta: &MemMeta,
+    fleet: &Fleet<'_>,
+    inode: InodeId,
+    nonce: Option<(&str, usize)>,
+    chunks: &[(ChunkId, DServerId)],
+) {
+    for &(chunk, at) in chunks {
+        let plan = plan_write(PAYLOAD, PAYLOAD.len(), EcScheme::None, || chunk).unwrap();
+        let bytes = plan.chunks[0].fragments[0].1.clone();
+        let put = store(fleet, at).put_fragment(frag(chunk), bytes);
+        put.await.unwrap();
+    }
+    let chunk_map = match nonce {
+        None => ChunkMap::Flat(chunks.iter().map(|&(c, at)| chunk_ref(c, at)).collect()),
+        Some((nonce, written)) => {
+            let group = SegmentGroup::new(nonce, 7).unwrap();
+            for (index, &(chunk, at)) in chunks.iter().take(written).enumerate() {
+                let byte_offset = index as u64 * CHUNK_LEN;
+                let one = vec![chunk_ref(chunk, at)];
+                let seg = encode(&SegmentRecord::new(one, byte_offset).unwrap());
+                let key = seg_key(&group, index as u32).unwrap();
+                commit(meta, WriteBatch::new().put(key, seg)).await;
+            }
+            let table = (0..chunks.len() as u32).map(|index| SegmentRef {
+                index,
+                byte_offset: u64::from(index) * CHUNK_LEN,
+                byte_len: CHUNK_LEN,
+            });
+            ChunkMap::Segmented(SegmentedMap::new(group, table.collect()).unwrap())
+        }
+    };
+    let root = InodeRecord {
+        size: chunks.len() as u64 * CHUNK_LEN,
+        chunk_map,
+        state: InodeState::Committed,
+        version: 1,
+        ..Default::default()
+    };
+    commit(meta, WriteBatch::new().put(inode_key(inode), encode(&root))).await;
+}
+
+async fn read_root(meta: &MemMeta, inode: InodeId) -> InodeRecord {
+    let bytes = meta.get(&inode_key(inode)).await.unwrap();
+    decode(&bytes.expect("the seeded root is present")).unwrap()
+}
+
+/// Where the record at `inode` now places its first chunk's fragment — the placement record
+/// readers follow, which is what an evacuation actually moves.
+async fn placed_at(meta: &MemMeta, inode: InodeId) -> DServerId {
+    let root = read_root(meta, inode).await;
+    root.chunk_map.as_flat().expect("a flat map")[0].placement[0]
+}
+
+/// Mark [`DRAINING`] draining and drive ONE pass through the REAL fenced control point: elect
+/// a custodian, install its term, dispatch `reconcile_step` with a `RebalanceContext` over a
+/// two-domain topology, and capture the audit seam. The `Once` stops `tracing` latching an
+/// audit callsite's `Interest` process-globally as *never* on its first hit with no subscriber
+/// installed, which would leave the capture empty in whichever leg the harness schedules
+/// second (wyrd #214) — a silently vacuous assertion in the legs that read the stream.
+///
+/// The error is flattened to its rendered TEXT, never to a bool: a helper that folded `Err`
+/// into "did not certify" would let a tree where the pass aborts outright — this slice's own
+/// defect — pass legs 1 and 4.
+async fn run(meta: &MemMeta, fleet: &Fleet<'_>) -> Pass {
+    static INIT: Once = Once::new();
+    INIT.call_once(|| _ = tracing::subscriber::set_global_default(tracing_subscriber::registry()));
+    set_lifecycle(meta, DRAINING, Draining).await.unwrap();
+    let mut topology = Topology::default();
+    topology.register(DRAINING, "A").register(TARGET, "B");
+    let ctx = RebalanceContext {
+        meta,
+        fleet,
+        topology: &topology,
+    };
+    let coordination = MemCoordination::new();
+    let leader = Custodian::elect(&coordination, "zone-696").await.unwrap();
+    let mut zone = FencedZone::new();
+    zone.install(leader.leadership());
+    let capture = Capture::default();
+    let audit = capture.clone();
+    let json = tracing_subscriber::fmt().json();
+    let subscriber = json.with_writer(move || audit.clone()).finish();
+    let outcome = reconcile_step(&zone, &leader, None, None, None, Some(&ctx), 500)
+        .with_subscriber(tracing::Dispatch::new(subscriber))
+        .await;
+    let logged = String::from_utf8(capture.0.lock().unwrap().clone()).unwrap();
+    (outcome.map_err(|err| err.to_string()), logged)
+}
+
+/// Leg 1 — a segmented object no longer ends the pass, and the flat work in the same store
+/// still happens. That object is healthy and holds NOTHING on the draining server, so it owes
+/// no evacuation and withholds nothing: the answer is `Changed`, not `Blocked`, and the flat
+/// chunk beside it is repointed off the drain with its bytes at the new home. Base-red:
+/// `plan_evacuations` `?`s out on the segmented record (`rebalance.rs:158-164`), so the pass
+/// is an `Err` and the flat fragment never moves.
+#[tokio::test]
+async fn a_segmented_object_no_longer_ends_the_pass_and_the_flat_work_still_happens() {
+    let (meta, d0, d1) = doubles();
+    let fleet: Fleet = [(DRAINING, &d0), (TARGET, &d1)];
+    let segmented = [(0x5E01, TARGET), (0x5E02, TARGET)];
+    seed(&meta, &fleet, 1, Some((NONCE, 2)), &segmented).await;
+    seed(&meta, &fleet, 2, None, &[(0xF1A7, DRAINING)]).await;
+
+    let (outcome, _) = run(&meta, &fleet).await;
+    assert_eq!(outcome, Ok(Reconciled::Changed), "flat work happens");
+    assert_eq!(placed_at(&meta, 2).await, TARGET, "repointed off the drain");
+    assert!(holds(&fleet, TARGET, 0xF1A7).await, "bytes at the new home");
+}
+
+/// Leg 2 — a segmented object that owes an evacuation is refused ONCE, mutates nothing, and
+/// the pass does not certify: three chunks, two on the draining server, so both fragments stay
+/// put, every `seg:` record and the root's version stay byte-identical (the segmented write
+/// path is #682's, and a refusal writes nothing at all), and the refusal is attributed per
+/// OBJECT — one audit line, never one per chunk, which would flood the seam an operator reads
+/// the blocker off. Base-red: the pass is an `Err`, so there is no answer, no line, no name.
+#[tokio::test]
+async fn a_segmented_object_that_owes_an_evacuation_is_refused_once_and_mutates_nothing() {
+    let (meta, d0, d1) = doubles();
+    let fleet: Fleet = [(DRAINING, &d0), (TARGET, &d1)];
+    let chunks = [(0x5E11, DRAINING), (0x5E12, DRAINING), (0x5E13, TARGET)];
+    seed(&meta, &fleet, 1, Some((NONCE, chunks.len())), &chunks).await;
+    let segments_before = meta.scan(b"seg:").await.unwrap();
+
+    let (outcome, logged) = run(&meta, &fleet).await;
+    assert_eq!(outcome, Ok(Reconciled::Blocked), "a refusal cannot certify");
+    assert!(holds(&fleet, DRAINING, 0x5E11).await, "fragment 1 stays");
+    assert!(holds(&fleet, DRAINING, 0x5E12).await, "fragment 2 stays");
+    let segments_after = meta.scan(b"seg:").await.unwrap();
+    assert_eq!(segments_after, segments_before, "`seg:` bytes identical");
+    assert_eq!(read_root(&meta, 1).await.version, 1, "root untouched");
+    let orphans = meta.scan(b"orphan:").await.unwrap();
+    assert!(orphans.is_empty(), "a refusal writes nothing at all");
+
+    assert_eq!(lines_with(&logged, "refused-segmented"), 1, "{logged}");
+    assert!(logged.contains(r#""inode":"inode:1""#), "{logged}");
+    assert!(
+        logged.contains(r#""reason":"segmented-chunk-map""#),
+        "{logged}"
+    );
+    let counted = r#""monotonic_counter.rebalance_refused_records":1"#;
+    assert!(
+        logged.contains(counted),
+        "the refusal counts itself: {logged}"
+    );
+}
+
+/// Leg 3 — an unreadable committed object is named, the walk continues, and nothing certifies.
+/// Both damaged shapes are seeded FIRST in key order over the `BTreeMap`-backed store, so "the
+/// walk continued" is a fixture property: `inode:1` is a committed root naming a segment that
+/// was never written (asserted genuinely unresolvable below), `inode:2` a committed record
+/// whose own bytes will not `decode`, and the healthy flat object sits behind both at
+/// `inode:3` — still evacuated, while the answer stays `Blocked` and both blockers are named
+/// by their `inode:` key (`gc::object_name`'s shape). Base-red: either damaged record `?`s the
+/// pass out (`decode(&value)?`, the segmented arm) before the healthy object is reached.
+#[tokio::test]
+async fn unreadable_objects_are_named_the_walk_continues_and_nothing_certifies() {
+    let (meta, d0, d1) = doubles();
+    let fleet: Fleet = [(DRAINING, &d0), (TARGET, &d1)];
+    let absent = [(0x5E21, TARGET), (0x5E22, TARGET)];
+    seed(&meta, &fleet, 1, Some((OTHER, 1)), &absent).await;
+    let junk = Bytes::from_static(b"not a record");
+    commit(&meta, WriteBatch::new().put(inode_key(2), junk)).await;
+    seed(&meta, &fleet, 3, None, &[(0xF1B8, DRAINING)]).await;
+
+    let root = read_root(&meta, 1).await;
+    let resolve = resolve_chunk_map(&meta, &inode_key(1), &root).await;
+    assert!(resolve.is_err(), "fixture: the root must not resolve");
+
+    let (outcome, logged) = run(&meta, &fleet).await;
+    assert_eq!(outcome, Ok(Reconciled::Blocked), "an unread object blocks");
+    assert_eq!(placed_at(&meta, 3).await, TARGET, "the healthy one drained");
+    assert!(holds(&fleet, TARGET, 0xF1B8).await, "its bytes moved too");
+
+    assert_eq!(lines_with(&logged, "unresolvable-chunk-map"), 2, "{logged}");
+    assert!(logged.contains(r#""inode":"inode:1""#), "{logged}");
+    assert!(logged.contains(r#""inode":"inode:2""#), "{logged}");
+    let counted = r#""monotonic_counter.rebalance_unresolvable_records":1"#;
+    assert!(logged.contains(counted), "each is counted: {logged}");
+}
+
+/// Leg 4 — REQUIRED, for a specific reason: at #681 v7 an adversary replaced the
+/// over-containment guard's body with a no-op and every OTHER leg plus the whole
+/// `wyrd-custodian` suite still passed, while the pass flipped `Satisfied` → `Blocked` over
+/// exactly this store — no decommission would ever certify on a store holding a multipart
+/// object, this slice's own defect in mirror image. A **genuinely healthy** segmented object —
+/// every `seg:` record present and resolvable, every placement well-formed, both asserted
+/// below so nothing ELSE here could explain a withheld answer — that holds NOTHING on the
+/// draining server owes no evacuation, so it must not cost the drain its certification. Every
+/// flat evacuation here is already complete, so `Satisfied` is the store's answer. Base-red:
+/// the segmented record `?`s the pass out, so the answer is `Err`.
+#[tokio::test]
+async fn a_healthy_segmented_object_holding_nothing_still_certifies_the_drain() {
+    let (meta, d0, d1) = doubles();
+    let fleet: Fleet = [(DRAINING, &d0), (TARGET, &d1)];
+    let chunks = [(0x5E31, TARGET), (0x5E32, TARGET), (0x5E33, TARGET)];
+    seed(&meta, &fleet, 1, Some((NONCE, chunks.len())), &chunks).await;
+    seed(&meta, &fleet, 2, None, &[(0xF1C9, TARGET)]).await;
+
+    let root = read_root(&meta, 1).await;
+    let resolved = resolve_chunk_map(&meta, &inode_key(1), &root)
+        .await
+        .expect("fixture: the healthy root must resolve")
+        .expect("fixture: it must have a live committed generation");
+    assert_eq!(resolved.chunks.len(), chunks.len(), "every segment read");
+    let sound = resolved
+        .chunks
+        .iter()
+        .all(|c| c.checked_fragments().is_ok());
+    assert!(sound, "fixture: every placement must be well-formed");
+
+    let (outcome, _) = run(&meta, &fleet).await;
+    assert_eq!(outcome, Ok(Reconciled::Satisfied), "no evacuation is owed");
+}
+
+/// Leg 5 — a fault that is not one object's map still ends the pass. The metadata double fails
+/// every `get` with a plain, non-`ChunkMapError` error: a backend outage underneath the
+/// resolver, which is not this object's fault and is not folded into "this object is
+/// unreadable". Without that rule, containing EVERY error would pass legs 1–4. Base-red: the
+/// pass does fail, but on its own `SegmentedMapUnsupported` before the resolver is reached —
+/// a different fault, so the injected one never comes back.
+#[tokio::test]
+async fn a_store_fault_under_the_resolver_still_ends_the_pass() {
+    let (meta, d0, d1) = doubles();
+    let fleet: Fleet = [(DRAINING, &d0), (TARGET, &d1)];
+    seed(&meta, &fleet, 1, Some((NONCE, 1)), &[(0x5E41, DRAINING)]).await;
+    *meta.failing.lock().unwrap() = true;
+
+    let (outcome, _) = run(&meta, &fleet).await;
+    let err = outcome.expect_err("a store fault ends the whole pass");
+    assert!(err.contains(STORE_FAULT), "THE injected fault: {err}");
+}
