+//! Issue #696 (child 2 of 3 of the #681 split): **the maintenance pass that executes a drain
+//! reads every committed object through the resolver every other consumer already shares,
+//! contains per object what it cannot read, and refuses — rather than aborts or silently
+//! discards — the evacuation it does not own.**
+//!
+//! On `origin/main` rebalance reads the chunk map inline out of the inode record
+//! (`rebalance.rs:158-164` ends the whole evacuation scan; `:255-261` the binding commit), so
+//! ONE segmented object — or one committed record that will not `decode` — turns the entire
+//! pass into an `Err`: no server anywhere in the store drains once a single multipart object
+//! exists, while the drain surface answers a bare `Pending` for a wait that nothing exits
+//! (`desired_state.rs:206-211`). GC (#650) and restore (#651) already read this namespace
+//! contained and attributed; rebalance is the third of the four loops to.
+//!
+//! Every leg drives the REAL fenced control point — `reconcile_step` over an elected
+//! `Custodian` + `FencedZone`, since `rebalance::reconcile` is `pub(crate)` and no test-only
+//! entry exists; only the `MetadataStore` / `ChunkStore` backends are doubles. No assertion
+//! names a symbol this patch INTRODUCES: the production file is reverted under the per-fix
+//! red leg, so such a reference would make that leg fail to COMPILE and degrade the red from
+//! "the behaviour was wrong" to "a symbol is missing".
+
+#![forbid(unsafe_code)]
+
+use std::collections::{BTreeMap, HashMap};
+use std::sync::{Arc, Mutex, Once};
+
+use async_trait::async_trait;
+use bytes::Bytes;
+use tracing::instrument::WithSubscriber;
+use wyrd_coordination_mem::MemCoordination;
+use wyrd_core::metadata::{
+    decode, encode, inode_key, resolve_chunk_map, seg_key, ChunkMap, ChunkRef, EcScheme, InodeId,
+    InodeRecord, InodeState, SegmentGroup, SegmentRecord, SegmentRef, SegmentedMap,
+};
+use wyrd_core::placement::Topology;
+use wyrd_core::write::plan_write;
+use wyrd_custodian::desired_state::{set_lifecycle, DServerLifecycle::Draining};
+use wyrd_custodian::{reconcile_step, Custodian, FencedZone, RebalanceContext, Reconciled};
+use wyrd_traits::{
+    ChunkId, ChunkStore, CommitOutcome, DServerId, FragmentId, Health, MetadataStore, Result,
+    ScanPage, WriteBatch,
+};
+
+/// A trivial in-memory metadata store (the loop is proven over the trait seams, so every
+/// backend is one of these), `BTreeMap`-backed so `scan` answers in KEY ORDER: a
+/// blocker seeded at `inode:1` is then always the one the walk meets FIRST — a fixture
+/// property rather than luck, without which "the healthy object was still evacuated" could
+/// pass on an implementation that abandons the walk at its first blocker.
+#[derive(Default)]
+struct MemMeta {
+    kv: Mutex<BTreeMap<Vec<u8>, Bytes>>,
+    /// Once armed, every `get` fails with a plain, NON-`ChunkMapError` fault: a backend outage
+    /// underneath the resolver, which is no single object's map (leg 5). Only the resolver reads
+    /// this store BY KEY — desired state, the committed namespace and the commit all use `scan`.
+    failing: Mutex<bool>,
+}
+
+#[async_trait]
+impl MetadataStore for MemMeta {
+    async fn get(&self, key: &[u8]) -> Result<Option<Bytes>> {
+        if *self.failing.lock().unwrap() {
+            return Err(Box::new(std::io::Error::other(STORE_FAULT)));
+        }
+        Ok(self.kv.lock().unwrap().get(key).cloned())
+    }
+
+    async fn scan(&self, prefix: &[u8]) -> Result<Vec<(Vec<u8>, Bytes)>> {
+        let kv = self.kv.lock().unwrap();
+        let hits = kv.iter().filter(|(key, _)| key.starts_with(prefix));
+        Ok(hits.map(|(k, v)| (k.clone(), v.clone())).collect())
+    }
+
+    // The required paginated read (#634): a test double needs *a* body, not a backend's —
+    // the dev-only testkit helper pages over this store's own `scan`.
+    async fn scan_page(&self, p: &[u8], after: Option<&[u8]>, n: usize) -> Result<ScanPage> {
+        wyrd_testkit::test_double_scan_page(self, p, after, n).await
+    }
+
+    async fn commit(&self, batch: WriteBatch) -> Result<CommitOutcome> {
+        let mut kv = self.kv.lock().unwrap();
+        if (batch.preconditions.iter()).any(|p| kv.get(&p.key).cloned() != p.expected) {
+            return Ok(CommitOutcome::Conflict);
+        }
+        kv.extend(batch.puts);
+        for key in batch.deletes {
+            kv.remove(&key);
+        }
+        Ok(CommitOutcome::Committed)
+    }
+}
+
+/// The injected fault's exact text, so leg 5 proves THIS fault came back rather than
+/// accepting any error at all — a pre-fix tree fails the same read differently.
+const STORE_FAULT: &str = "simulated store fault: metadata backend unreachable";
+
+/// One D server's fragment bytes — a deliberately dumb `ChunkStore`.
+#[derive(Default)]
+struct MemDServer(Mutex<HashMap<FragmentId, Bytes>>);
+
+#[async_trait]
+impl ChunkStore for MemDServer {
+    async fn put_fragment(&self, id: FragmentId, fragment: Bytes) -> Result<()> {
+        self.0.lock().unwrap().insert(id, fragment);
+        Ok(())
+    }
+
+    async fn get_fragment(&self, id: FragmentId) -> Result<Option<Bytes>> {
+        Ok(self.0.lock().unwrap().get(&id).cloned())
+    }
+
+    async fn list_fragments(&self) -> Result<Vec<FragmentId>> {
+        Ok(self.0.lock().unwrap().keys().copied().collect())
+    }
+
+    async fn delete_fragment(&self, id: FragmentId) -> Result<()> {
+        self.0.lock().unwrap().remove(&id);
+        Ok(())
+    }
+
+    async fn health(&self) -> Result<Health> {
+        Ok(Health::Healthy)
+    }
+}
+
+/// A `MakeWriter` collecting what the pass emitted, so legs 2 and 3 assert on the record the
+/// audit seam actually carries rather than assume one exists (`segmented_map_restore.rs:221`).
+#[derive(Clone, Default)]
+struct Capture(Arc<Mutex<Vec<u8>>>);
+
+impl std::io::Write for Capture {
+    fn write(&mut self, buf: &[u8]) -> std::io::Result<usize> {
+        self.0.lock().unwrap().extend_from_slice(buf);
+        Ok(buf.len())
+    }
+
+    fn flush(&mut self) -> std::io::Result<()> {
+        Ok(())
+    }
+}
