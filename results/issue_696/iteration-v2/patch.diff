+/// (`EcScheme::None` has exactly one fragment) is the malformed shape
+/// `ChunkRef::checked_fragments` refuses to expand (ADR-0040 decision 4) — leg 6's chunk.
+fn chunk_ref(id: ChunkId, placement: Vec<DServerId>) -> ChunkRef {
+    ChunkRef {
+        id,
+        scheme: EcScheme::None,
+        len: CHUNK_LEN,
+        placement,
+    }
+}
+
+/// A committed root record of `size` bytes over `map` — every seeded object's shape.
+fn committed(size: u64, map: ChunkMap) -> InodeRecord {
+    InodeRecord {
+        size,
+        chunk_map: map,
+        state: InodeState::Committed,
+        version: 1,
+        ..Default::default()
+    }
+}
+
+/// A committed **segmented** root naming `n` one-chunk segments of the group.
+fn segmented_root(n: u32) -> InodeRecord {
+    let segments = (0..n)
+        .map(|index| SegmentRef {
+            index,
+            byte_offset: u64::from(index) * CHUNK_LEN,
+            byte_len: CHUNK_LEN,
+        })
+        .collect();
+    let map = SegmentedMap::new(group(), segments).unwrap();
+    committed(u64::from(n) * CHUNK_LEN, ChunkMap::Segmented(map))
+}
+
+async fn commit(meta: &MemMeta, batch: WriteBatch) {
+    assert_eq!(meta.commit(batch).await.unwrap(), CommitOutcome::Committed);
+}
+
+/// The value under `key`, as the store holds it — byte-identity is asserted on this.
+async fn stored(meta: &MemMeta, key: &[u8]) -> Bytes {
+    meta.get(key).await.unwrap().unwrap()
+}
+
+/// The one chunk's committed placement, and the record's version, under `key`.
+async fn placement_at(meta: &MemMeta, key: &[u8]) -> (Vec<DServerId>, u64) {
+    let root: InodeRecord = decode(&stored(meta, key).await).unwrap();
+    (
+        root.chunk_map.as_flat().unwrap()[0].placement.clone(),
+        root.version,
+    )
+}
+
+/// Seed a committed segmented root at `key` naming one segment per `(chunk, placement)`, but
+/// WRITE only the first `written` of their `seg:` records — `written < len` is
+/// `ChunkMapError::SegmentAbsent`'s real gap (`segmented_map_restore.rs:387-410`'s shape,
+/// through the same validating constructors, so a fixture typo cannot silently change which
+/// rule a leg exercises).
+async fn seed_segmented(
+    meta: &MemMeta,
+    key: &[u8],
+    chunks: &[(ChunkId, Vec<DServerId>)],
+    written: usize,
+) {
+    for (index, (chunk, placement)) in chunks.iter().enumerate().take(written) {
+        let one = vec![chunk_ref(*chunk, placement.clone())];
+        let record = SegmentRecord::new(one, index as u64 * CHUNK_LEN).unwrap();
+        let segment = seg_key(&group(), index as u32).unwrap();
+        commit(meta, WriteBatch::new().put(segment, encode(&record))).await;
+    }
+    let root = encode(&segmented_root(chunks.len() as u32));
+    commit(meta, WriteBatch::new().put(key.to_vec(), root)).await;
+}
+
+/// Write a real, checksummed chunk onto `d` and commit a FLAT root naming it under `key` —
+/// the smallest object `evacuate_chunk` can genuinely move (`repair::fragment_intact` needs
+/// real bytes). `plan_write`'s identity route places its single fragment on [`DRAINING`].
+async fn write_flat_on(meta: &MemMeta, d: &MemDServer, key: &[u8], chunk: ChunkId) {
+    let plan = plan_write(b"evacuate me", 11, EcScheme::None, || chunk).unwrap();
+    write_fragments(d, &plan).await.unwrap();
+    let root = encode(&committed(11, plan.chunk_refs().into()));
+    commit(meta, WriteBatch::new().put(key.to_vec(), root)).await;
+}
+
+/// Mark [`DRAINING`] draining and drive ONE `reconcile_step` — the real fenced control point
+/// (`leadership.rs:31`, `:69`; the fence shape is `segmented_map_consumers.rs:406-410`).
+async fn run(meta: &MemMeta, fleet: &[(DServerId, &dyn ChunkStore)]) -> Pass {
+    static INIT: Once = Once::new(); // audit callsites must never latch `Interest::never` (#214)
+    INIT.call_once(|| {
+        let _ = tracing::subscriber::set_global_default(tracing_subscriber::registry());
+    });
+    set_lifecycle(meta, DRAINING, Draining).await.unwrap();
+    let mut topology = Topology::default();
+    topology.register(DRAINING, "A").register(TARGET, "B");
+    let ctx = RebalanceContext {
+        meta,
+        fleet,
+        topology: &topology,
+    };
+    let coordination = MemCoordination::new();
+    let leader = Custodian::elect(&coordination, "zone-696").await.unwrap();
+    let mut zone = FencedZone::new();
+    zone.install(leader.leadership());
+    let capture = Capture::default();
+    let audit = capture.clone();
+    let json = tracing_subscriber::fmt().json();
+    let subscriber = json.with_writer(move || audit.clone()).finish();
+    let outcome = reconcile_step(&zone, &leader, None, None, None, Some(&ctx), 500)
+        .with_subscriber(tracing::Dispatch::new(subscriber))
+        .await;
+    let log = String::from_utf8(capture.0.lock().unwrap().clone()).unwrap();
+    (outcome, log)
+}
+
+// ---- leg 1: a segmented object no longer ends the pass ----
+
+#[tokio::test]
+async fn a_segmented_object_no_longer_stops_the_flat_evacuation_beside_it() {
+    let meta = MemMeta::default();
+    let (d0, d1) = (MemDServer::default(), MemDServer::default());
+    // A healthy segmented object holding nothing on the draining server, beside a flat chunk
+    // whose fragment IS on it.
+    seed_segmented(&meta, b"inode:1", &[(0xA1, vec![TARGET])], 1).await;
+    write_flat_on(&meta, &d0, b"inode:2", 0xB1).await;
+
+    let (outcome, _) = run(&meta, &[(DRAINING, &d0), (TARGET, &d1)]).await;
+    let outcome = outcome.expect("BASE-RED: one segmented object may not `Err` the whole pass");
+    // The flat fragment beside the segmented object is still evacuated — its record repointed
+    // exactly once, the bytes really copied to their new home.
+    let moved = d1.get_fragment(frag(0xB1, 0)).await.unwrap().is_some();
+    let after = placement_at(&meta, b"inode:2").await;
+    let evacuated = (Reconciled::Changed, (vec![TARGET], 2), true);
+    assert_eq!((outcome, after, moved), evacuated);
+}
+
+// ---- leg 2: a `seg:`-resident fragment stays put, refused, and does not certify ----
+
+#[tokio::test]
+async fn a_fragment_in_a_seg_record_stays_put_refused_and_does_not_certify() {
+    let meta = MemMeta::default();
+    let d0 = MemDServer::default();
+    // A refused chunk is never read by the evacuation, so it needs no genuine bytes.
+    let dummy = Bytes::from_static(b"x");
+    d0.put_fragment(frag(0xA1, 0), dummy).await.unwrap();
+    seed_segmented(&meta, b"inode:1", &[(0xA1, vec![DRAINING])], 1).await;
+    let seg = seg_key(&group(), 0).unwrap();
+    let root = b"inode:1".as_slice();
+    let before = (stored(&meta, root).await, stored(&meta, &seg).await);
+
+    let (outcome, log) = run(&meta, &[(DRAINING, &d0)]).await;
+    let outcome = outcome.expect("BASE-RED: a segmented map may not `Err` the pass");
+    // The fragment STAYS on the draining server; root and `seg:` record are byte-identical (a
+    // refusal writes nothing at all, Rule B); the drain is NOT certified.
+    let after = (stored(&meta, root).await, stored(&meta, &seg).await);
+    let held = d0.get_fragment(frag(0xA1, 0)).await.unwrap().is_some();
+    let refused = (Reconciled::Blocked, before, true);
+    assert_eq!((outcome, after, held), refused);
+    assert!(named(&log, "refused", "inode:1"), "named: {log}");
+    let reason = r#""reason":"segmented-chunk-map""#;
+    let counter = "monotonic_counter.rebalance_evacuation_refused";
+    assert!(log.contains(reason), "with a stated reason: {log}");
+    assert!(log.contains(counter), "counted on the seam: {log}");
+}
+
+// ---- leg 3 (+ Rule C): a damaged object is named, the walk continues, nothing certifies ----
+
+#[tokio::test]
+async fn an_unreadable_object_is_named_the_walk_continues_and_nothing_certifies() {
+    let meta = MemMeta::default();
+    let (d0, d1) = (MemDServer::default(), MemDServer::default());
+    // FIRST in key order: (a) a committed root naming a `SegmentRef` whose `seg:` record was
+    // never written, and (b) a committed record whose own bytes will not decode.
+    seed_segmented(&meta, b"inode:001", &[(0xA1, vec![DRAINING])], 0).await;
+    let damaged: InodeRecord = decode(&stored(&meta, b"inode:001").await).unwrap();
+    let resolve = resolve_chunk_map(&meta, b"inode:001", &damaged).await;
+    assert!(resolve.is_err(), "fixture: (a) really is unresolvable");
+    let garbage = Bytes::from_static(b"not a record");
+    commit(&meta, WriteBatch::new().put(b"inode:002".to_vec(), garbage)).await;
+    // Rule C: `"inode:007"` parses to the same `InodeId` as `"inode:7"`, so a pass that
+    // re-derived the key from a parsed id would read one record and CAS the other.
+    write_flat_on(&meta, &d0, b"inode:007", 0xC1).await;
+    let flat = vec![chunk_ref(0xC2, vec![TARGET])].into();
+    let bystander = encode(&committed(CHUNK_LEN, flat));
+    let put = WriteBatch::new().put(inode_key(7), bystander.clone());
+    commit(&meta, put).await;
+
+    let (outcome, log) = run(&meta, &[(DRAINING, &d0), (TARGET, &d1)]).await;
+    let outcome = outcome.expect("BASE-RED: a damaged object may not `Err` the whole pass");
+    // The healthy fragment is STILL evacuated — exactly once, under the key the store gave it
+    // (Rule C: `inode:7` stays byte-unchanged) — while the damaged pair, met first, withholds
+    // the drain's certification.
+    let evacuated = placement_at(&meta, b"inode:007").await;
+    let after7 = stored(&meta, &inode_key(7)).await;
+    let contained = (Reconciled::Blocked, (vec![TARGET], 2), bystander);
+    assert_eq!((outcome, evacuated, after7), contained);
+    let unresolvable = "unresolvable-chunk-map";
+    for object in ["inode:001", "inode:002"] {
+        assert!(named(&log, unresolvable, object), "named: {log}");
+    }
+}
+
+// ---- leg 4: Rule A — the pass never acts on a generation it did not read ----
+
+#[tokio::test]
+async fn rule_a_the_pass_never_acts_on_a_generation_it_did_not_read() {
+    // `scan` answers a STALE segmented generation while `get` — the resolver's own settle
+    // re-read — answers the LIVE flat root, whose fragment really is on the draining server.
+    // The resolve therefore RESTARTS onto a generation this pass never scanned
+    // (`metadata.rs:2629`), whose chunk list may not be mixed with the scanned record's.
+    let stale = (b"inode:1".to_vec(), encode(&segmented_root(1)));
+    let meta = MemMeta {
+        stale_scan: Mutex::new(Some(stale)),
+        ..Default::default()
+    };
+    let (d0, d1) = (MemDServer::default(), MemDServer::default());
+    write_flat_on(&meta, &d0, b"inode:1", 0xD1).await;
+    let live = stored(&meta, b"inode:1").await;
+
+    let (outcome, log) = run(&meta, &[(DRAINING, &d0), (TARGET, &d1)]).await;
+    let outcome = outcome.expect("BASE-RED: a stale-vs-live generation may not `Err` the pass");
+    // Nothing is moved off a generation this pass did not read, the live record is
+    // byte-unchanged (its `version` never moved), and the drain is NOT certified.
+    let copied = d1.get_fragment(frag(0xD1, 0)).await.unwrap().is_some();
+    let after = stored(&meta, b"inode:1").await;
+    let untouched = (Reconciled::Blocked, live, false);
+    assert_eq!((outcome, after, copied), untouched);
+    let unresolvable = "unresolvable-chunk-map";
+    assert!(named(&log, unresolvable, "inode:1"), "named: {log}");
+    // Nor REPORTED from it: a refusal counted over the restarted generation's chunk list would
+    // tell the operator about fragments this pass never scanned.
+    assert_eq!(lines(&log, "refused"), 0, "{log}");
+}
+
+// ---- leg 5: the containment guard is not over-broad ----
+
+#[tokio::test]
+async fn a_healthy_segmented_object_holding_nothing_draining_still_certifies_the_drain() {
+    let meta = MemMeta::default();
+    let (d0, d1) = (MemDServer::default(), MemDServer::default());
+    seed_segmented(&meta, b"inode:1", &[(0xE1, vec![TARGET])], 1).await;
+    write_flat_on(&meta, &d0, b"inode:2", 0xE2).await;
+
+    let (first, _) = run(&meta, &[(DRAINING, &d0), (TARGET, &d1)]).await;
+    let first = first.expect("BASE-RED: one segmented object may not `Err` the whole pass");
+    assert_eq!(first, Reconciled::Changed, "pass 1 evacuates");
+    // REQUIRED: with every flat evacuation complete, a healthy segmented object holding NOTHING
+    // on the draining server may not cost the drain its certification — otherwise no
+    // decommission ever certifies over a store holding a multipart object, which is this
+    // slice's own defect in mirror image (`results/issue_681/iteration-v7`).
+    let (second, log) = run(&meta, &[(DRAINING, &d0), (TARGET, &d1)]).await;
+    let answered = (second.unwrap(), lines(&log, "refused"));
+    assert_eq!(answered, (Reconciled::Satisfied, 0), "{log}");
+}
+
+// ---- leg 6: Rule D — one refusal per OBJECT, accounting for what it leaves behind ----
+
+#[tokio::test]
+async fn rule_d_one_refusal_per_object_accounting_for_what_it_leaves_behind() {
+    let meta = MemMeta::default();
+    // Three chunks of ONE object: two fragments on the draining server, plus one whose
+    // committed placement cannot even be classified (non-empty, wrong length for its scheme) —
+    // that one may hold fragments there too and nothing can show it does not.
+    let chunks = [
+        (0xF1, vec![DRAINING]),
+        (0xF2, vec![DRAINING]),
+        (0xF3, vec![TARGET, DRAINING]),
+    ];
+    seed_segmented(&meta, b"inode:1", &chunks, 3).await;
+
+    let (outcome, log) = run(&meta, &[]).await;
+    let outcome = outcome.expect("BASE-RED: a segmented map may not `Err` the pass");
+    // ONE refusal for the OBJECT — never one per chunk or per fragment — beside the
+    // unclassifiable chunk's own NEEDS-HUMAN signal.
+    let counted = (lines(&log, "refused"), lines(&log, "needs-human"));
+    assert_eq!((outcome, counted), (Reconciled::Blocked, (1, 1)), "{log}");
+    // And it accounts for what it leaves behind: the fragments it can SEE on the draining
+    // server, plus the chunk whose placement it could not classify — which is exactly what
+    // makes that first count a floor rather than an exact tally.
+    assert!(log.contains(r#""fragments":2"#), "fragments: {log}");
+    assert!(log.contains(r#""unclassified":1"#), "unclassified: {log}");
+}
+
+// ---- leg 7: a fault that is not one object's map still ends the pass ----
+
+#[tokio::test]
+async fn a_fault_that_is_not_one_objects_map_still_ends_the_pass() {
+    let meta = MemMeta {
+        failing_get: Mutex::new(Some(b"inode:1".to_vec())),
+        ..Default::default()
+    };
+    seed_segmented(&meta, b"inode:1", &[(0xA9, vec![TARGET])], 1).await;
+
+    // NOT base-red — this binds the containment against over-breadth: a store fault under the
+    // resolver's settle re-read is not one object's own, and must still end the pass.
+    let (outcome, _) = run(&meta, &[]).await;
+    let store_fault = matches!(outcome, Err(ReconcileError::Store(_)));
+    assert!(store_fault, "got {outcome:?}");
+}
