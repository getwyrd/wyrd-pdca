+// ---- ONE fixture ----
+
+const CHUNK_LEN: u64 = 5;
+const DRAINING: DServerId = 0;
+const TARGET: DServerId = 1;
+const NONCE: &str = "0123456789abcdef0123456789abcdef";
+
+/// What one `reconcile_step` answered, and the audit stream it emitted.
+type Pass = (std::result::Result<Reconciled, ReconcileError>, String);
+
+fn frag(chunk: ChunkId, index: u16) -> FragmentId {
+    FragmentId { chunk, index }
+}
+
+fn group() -> SegmentGroup {
+    SegmentGroup::new(NONCE, 1).unwrap()
+}
+
