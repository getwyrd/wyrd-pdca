+//! Issue #696 (child 2 of 3 of the #681 split, proposal 0016 decision 7(e)): rebalance
+//! resolves every committed object the way every other consumer already resolves one,
+//! contains per object what it cannot read, and refuses — rather than aborts or silently
+//! discards — the evacuation it does not own.
+//!
+//! On the base, `rebalance.rs` `?`-s out on `ChunkMapError::SegmentedMapUnsupported` at both
+//! of its chunk-map reads, so ONE segmented object anywhere stops every drain in the store:
+//! no server can be decommissioned once a single multipart object exists.
+//!
+//! Every leg drives the REAL fenced control point
+//! [`reconcile_step`](wyrd_custodian::reconcile_step) over one shared `MemMeta` double, never
+//! an internal helper, and no assertion names a symbol this patch introduces: the red leg
+//! reverts `rebalance.rs`, so a new symbol would fail to COMPILE rather than fail an
+//! assertion. Legs 5 and 7 bind the containment against over-breadth.
+
+#![forbid(unsafe_code)]
+
+use std::collections::{BTreeMap, HashMap};
+use std::sync::{Arc, Mutex, Once};
+
+use async_trait::async_trait;
+use bytes::Bytes;
+use tracing::instrument::WithSubscriber;
+use wyrd_coordination_mem::MemCoordination;
+use wyrd_core::metadata::{
+    decode, encode, inode_key, resolve_chunk_map, seg_key, ChunkMap, ChunkRef, EcScheme,
+    InodeRecord, InodeState, SegmentGroup, SegmentRecord, SegmentRef, SegmentedMap,
+};
+use wyrd_core::placement::Topology;
+use wyrd_core::write::{plan_write, write_fragments};
+use wyrd_custodian::desired_state::{set_lifecycle, DServerLifecycle::Draining};
+use wyrd_custodian::{
+    reconcile_step, Custodian, FencedZone, RebalanceContext, ReconcileError, Reconciled,
+};
+use wyrd_traits::{
+    ChunkId, ChunkStore, CommitOutcome, DServerId, FragmentId, Health, MetadataStore,
+    PlacementChunkStore, Result, ScanPage, WriteBatch,
+};
+
+// ---- ONE metadata double, shared by every leg ----
+
+/// `BTreeMap`, not a `HashMap`: `scan` answers in the store's own key order, so "the damaged
+/// record is met FIRST" is a fixture property rather than luck.
+#[derive(Default)]
+struct MemMeta {
+    kv: Mutex<BTreeMap<Vec<u8>, Bytes>>,
+    /// Leg 4 (Rule A): the STALE bytes `scan` answers for this key, while `get` — the
+    /// resolver's own settle re-read — answers the LIVE ones.
+    stale_scan: Mutex<Option<(Vec<u8>, Bytes)>>,
+    /// Leg 7: the key whose `get` fails with a plain, NON-`ChunkMapError` store fault.
+    failing_get: Mutex<Option<Vec<u8>>>,
+}
+
+#[async_trait]
+impl MetadataStore for MemMeta {
+    async fn get(&self, key: &[u8]) -> Result<Option<Bytes>> {
+        if self.failing_get.lock().unwrap().as_deref() == Some(key) {
+            return Err(Box::new(std::io::Error::other("simulated store fault")));
+        }
+        Ok(self.kv.lock().unwrap().get(key).cloned())
+    }
+
+    async fn scan(&self, prefix: &[u8]) -> Result<Vec<(Vec<u8>, Bytes)>> {
+        let kv = self.kv.lock().unwrap();
+        let stale = self.stale_scan.lock().unwrap();
+        let rows = kv.iter().filter(|(key, _)| key.starts_with(prefix));
+        Ok(rows
+            .map(|(key, value)| match stale.as_ref() {
+                Some((stale_key, bytes)) if stale_key == key => (key.clone(), bytes.clone()),
+                _ => (key.clone(), value.clone()),
+            })
+            .collect())
+    }
+
+    // The required paginated read (#634): the dev-only testkit helper pages over this store's
+    // own `scan`, as the sibling doubles do (`segmented_map_consumers.rs:109-116`).
+    async fn scan_page(&self, p: &[u8], after: Option<&[u8]>, n: usize) -> Result<ScanPage> {
+        wyrd_testkit::test_double_scan_page(self, p, after, n).await
+    }
+
+    async fn commit(&self, batch: WriteBatch) -> Result<CommitOutcome> {
+        let mut kv = self.kv.lock().unwrap();
+        let stale = |p: &wyrd_traits::Precondition| kv.get(&p.key).cloned() != p.expected;
+        if batch.preconditions.iter().any(stale) {
+            return Ok(CommitOutcome::Conflict);
+        }
+        kv.extend(batch.puts);
+        for key in batch.deletes {
+            kv.remove(&key);
+        }
+        Ok(CommitOutcome::Committed)
+    }
+}
+
+/// One D server's fragment bytes.
+#[derive(Default)]
+struct MemDServer {
+    frags: Mutex<HashMap<FragmentId, Bytes>>,
+}
+
+#[async_trait]
+impl ChunkStore for MemDServer {
+    async fn put_fragment(&self, id: FragmentId, fragment: Bytes) -> Result<()> {
+        self.frags.lock().unwrap().insert(id, fragment);
+        Ok(())
+    }
+
+    async fn get_fragment(&self, id: FragmentId) -> Result<Option<Bytes>> {
+        Ok(self.frags.lock().unwrap().get(&id).cloned())
+    }
+
+    async fn list_fragments(&self) -> Result<Vec<FragmentId>> {
+        Ok(self.frags.lock().unwrap().keys().copied().collect())
+    }
+
+    async fn delete_fragment(&self, id: FragmentId) -> Result<()> {
+        self.frags.lock().unwrap().remove(&id);
+        Ok(())
+    }
+
+    async fn health(&self) -> Result<Health> {
+        Ok(Health::Healthy)
+    }
+}
+
+impl PlacementChunkStore for MemDServer {}
+
+// ---- ONE audit capture, shared by every leg that reads the durability seam ----
+
+#[derive(Clone, Default)]
+struct Capture(Arc<Mutex<Vec<u8>>>);
+
+impl std::io::Write for Capture {
+    fn write(&mut self, buf: &[u8]) -> std::io::Result<usize> {
+        self.0.lock().unwrap().extend_from_slice(buf);
+        Ok(buf.len())
+    }
+
+    fn flush(&mut self) -> std::io::Result<()> {
+        Ok(())
+    }
+}
