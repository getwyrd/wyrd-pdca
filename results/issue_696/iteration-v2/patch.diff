+/// How many audit events the pass emitted under `action` — Rule D is counted on this.
+fn lines(log: &str, action: &str) -> usize {
+    log.matches(&format!(r#""action":"{action}""#)).count()
+}
+
+/// Whether ONE audit event names `object` under `action` (`gc::object_name`'s shape).
+fn named(log: &str, action: &str, object: &str) -> bool {
+    let act = format!(r#""action":"{action}""#);
+    let obj = format!(r#""inode":"{object}""#);
+    log.lines().any(|l| l.contains(&act) && l.contains(&obj))
+}
