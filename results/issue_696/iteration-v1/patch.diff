+/// Emit an **unaccounted committed object** on the durability-plane seam: this scan could
+/// not read that object's record, resolve its chunk map, or trust the generation the
+/// resolve answered from (Rule A) — so it cannot say whether the object holds fragments
+/// on a draining server, and the drain is NOT satisfied until it is repaired. Named as GC
+/// names one ([`crate::gc::object_name`]).
+fn emit_unaccounted(object: &str, fault: &dyn Display) {
+    tracing::warn!(monotonic_counter.rebalance_unaccounted_records = 1_u64);
+    tracing::warn!(
+        target: "wyrd.custodian.rebalance.audit",
+        action = "unresolvable-chunk-map",
+        inode = %object,
+        fault = %fault,
+        "rebalance could not account for a committed object's chunk map; it cannot see whether that object holds fragments on a draining server, so the drain is NOT satisfied — operator signal",
+    );
+}
+
+/// Emit a **refused evacuation** — **once per object** (Rule D), never once per chunk.
+/// NOTHING is written, `fragments` fragments STAY on the draining server and the pass
