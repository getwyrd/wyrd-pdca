+// ---- leg 5: the containment guard is not over-broad ----
+
+#[tokio::test]
+async fn a_healthy_segmented_object_holding_nothing_draining_costs_the_drain_nothing() {
+    let meta = MemMeta::default();
+    // Healthy, resolvable, its fragment on a NON-draining server — nothing else to evacuate.
+    seed_segmented(&meta, b"inode:1", NONCE_A, &[(0xE1, 1)], 1).await;
+
+    let fleet: [(DServerId, &dyn ChunkStore); 0] = [];
+    let (outcome, _) = run(&meta, &fleet).await;
+    assert_eq!(
+        outcome.unwrap(),
+        Reconciled::Satisfied,
+        "REQUIRED: a segmented object holding NOTHING on the draining server must not cost \
+         the drain its certification — the over-containment a guard that only LOOKS bound \
+         can hide (`results/issue_681/iteration-v7`)"
+    );
+}
