+// ---- leg 4: Rule A — the pass never writes to a generation it did not read ----
+
+#[tokio::test]
+async fn rule_a_the_pass_never_writes_to_a_generation_it_did_not_read() {
+    let (d0, d1) = (MemDServer::default(), MemDServer::default());
+    // LIVE: a flat root on the draining server. STALE: what `scan` answers instead — a
+    // segmented root this pass's snapshot read, superseded before the resolver re-reads it.
+    let live = flat_record(0xD1, DRAINING, 5);
+    let stale = segmented_record(NONCE_B, 9, 1, 3);
+    let meta = MemMeta::default().stale_scan_of(b"inode:1".to_vec(), encode(&stale));
+    commit(
+        &meta,
+        WriteBatch::new().put(b"inode:1".to_vec(), encode(&live)),
+    )
+    .await;
+
+    let fleet: [(DServerId, &dyn ChunkStore); 2] = [(0, &d0), (1, &d1)];
+    let (outcome, _) = run(&meta, &fleet).await;
+    assert_eq!(
+        outcome.expect("BASE-RED: a stale-vs-live generation mismatch must not `Err`"),
+        Reconciled::Blocked,
+        "a resolve restarted onto a generation this scan did not read may not certify"
+    );
+    assert_eq!(
+        meta.get(b"inode:1").await.unwrap().unwrap(),
+        encode(&live),
+        "unwritten"
+    );
+    assert!(
+        d0.get_fragment(frag(0xD1, 0)).await.unwrap().is_none(),
+        "nothing copied"
+    );
+}
