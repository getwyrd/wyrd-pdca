+// ---- leg 3 (+ Rule C): unreadable objects are named, the walk continues, nothing certifies ----
+
+#[tokio::test]
+async fn an_unreadable_object_is_named_the_walk_continues_and_nothing_certifies() {
+    let meta = MemMeta::default();
+    let (d0, d1) = (MemDServer::default(), MemDServer::default());
+
+    // (a) FIRST in key order: a root naming a `SegmentRef` whose `seg:` record was never
+    // written. (b) a committed record whose own bytes will not decode.
+    seed_segmented(&meta, b"inode:1", NONCE_A, &[(0xA1, 2)], 0).await;
+    let root: InodeRecord = read(&meta, b"inode:1").await;
+    assert!(
+        resolve_chunk_map(&meta, b"inode:1", &root).await.is_err(),
+        "fixture: unreadable"
+    );
+    let garbage = WriteBatch::new().put(b"inode:2".to_vec(), Bytes::from_static(b"not a record"));
+    commit(&meta, garbage).await;
+    // Rule C: `"inode:007"` parses to the same id as `"inode:7"` — never re-derived.
+    write_flat_on(&meta, &d0, b"inode:007", 0xC1).await;
+    let bystander = flat_record(0xC2, TARGET, 1);
+    commit(
+        &meta,
+        WriteBatch::new().put(inode_key(7), encode(&bystander)),
+    )
+    .await;
+    let bystander_before = meta.get(&inode_key(7)).await.unwrap().unwrap();
+
+    let fleet: [(DServerId, &dyn ChunkStore); 2] = [(0, &d0), (1, &d1)];
+    let (outcome, log) = run(&meta, &fleet).await;
+    assert_eq!(
+        outcome.expect("BASE-RED: a damaged object must not `Err` the whole pass"),
+        Reconciled::Blocked,
+        "an unreadable committed object withholds certification"
+    );
+    let after007 = read(&meta, b"inode:007").await;
+    assert_eq!(
+        (
+            after007.chunk_map.as_flat().unwrap()[0].placement.clone(),
+            after007.version
+        ),
+        (vec![TARGET], 2),
+        "evacuated exactly once, under its OWN key `inode:007`"
+    );
+    assert_eq!(
+        meta.get(&inode_key(7)).await.unwrap().unwrap(),
+        bystander_before,
+        "Rule C: `inode:7` is never touched — `inode:007` is never reinterpreted into it"
+    );
+    for object in ["inode:1", "inode:2"] {
+        assert!(
+            logged(&log, "unresolvable-chunk-map", object),
+            "both damaged objects are named on the audit seam: {log}"
+        );
+    }
+}
