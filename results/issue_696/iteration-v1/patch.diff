+//! Issue #696 (child 2 of 3 of the #681 split, 0016 decision 7(e)): rebalance resolves every
+//! committed object the way every other consumer already resolves one, contains per object
+//! what it cannot read, and refuses — rather than aborts or silently discards — the
+//! evacuation it does not own.
+//!
+//! On the base, `rebalance.rs` `?`-s out on `ChunkMapError::SegmentedMapUnsupported`: one
+//! segmented object anywhere stops every drain. Drives the real fenced control point
+//! [`reconcile_step`](wyrd_custodian::reconcile_step) over ONE shared `MemMeta` double.
+//!
+//! No assertion names a symbol this patch introduces: the red leg reverts `rebalance.rs`, so
+//! a new symbol would fail to COMPILE, not fail the assertion. `Reconciled::Blocked` already
+//! exists on the base (#650). Legs 1-4 and 6 are base-red; 5 and 7 bind over-containment.
+
+#![forbid(unsafe_code)]
+
+use std::collections::{BTreeMap, HashMap};
+use std::sync::{Arc, Mutex};
+
+use async_trait::async_trait;
+use bytes::Bytes;
+use tracing::instrument::WithSubscriber;
+use tracing_subscriber::prelude::*;
+use wyrd_coordination_mem::MemCoordination;
+use wyrd_core::metadata::{
+    decode, encode, inode_key, resolve_chunk_map, seg_key, ChunkMap, ChunkRef, EcScheme,
+    InodeRecord, InodeState, SegmentGroup, SegmentRecord, SegmentRef, SegmentedMap,
+};
+use wyrd_core::placement::Topology;
+use wyrd_core::write::{plan_write, write_fragments};
+use wyrd_custodian::desired_state::{set_lifecycle, DServerLifecycle};
+use wyrd_custodian::{
+    reconcile_step, Custodian, FencedZone, RebalanceContext, ReconcileError, Reconciled,
+};
+use wyrd_traits::{
+    ChunkId, ChunkStore, CommitOutcome, DServerId, FragmentId, Health, MetadataStore,
+    PlacementChunkStore, Result, WriteBatch,
+};
+
+// ---- ONE metadata double, shared by every leg ----
+
+/// `BTreeMap`: `scan` answers in key order, so a damaged/refused object sorts first.
+#[derive(Default)]
+struct MemMeta {
+    kv: Mutex<BTreeMap<Vec<u8>, Bytes>>,
+    /// Leg 4: the STALE bytes `scan` answers for this key, while `get` answers LIVE ones.
+    stale_scan: Mutex<Option<(Vec<u8>, Bytes)>>,
+    /// Leg 7: the key whose `get` fails with a plain (non-`ChunkMapError`) fault.
+    failing_get: Mutex<Option<Vec<u8>>>,
+}
+
+impl MemMeta {
+    fn stale_scan_of(self, key: Vec<u8>, stale: Bytes) -> Self {
+        *self.stale_scan.lock().unwrap() = Some((key, stale));
+        self
+    }
+
+    fn fail_get(self, key: Vec<u8>) -> Self {
+        *self.failing_get.lock().unwrap() = Some(key);
+        self
+    }
+}
+
+const STORE_FAULT: &str = "simulated store fault";
+
+#[async_trait]
+impl MetadataStore for MemMeta {
+    async fn get(&self, key: &[u8]) -> Result<Option<Bytes>> {
+        if self.failing_get.lock().unwrap().as_deref() == Some(key) {
+            return Err(Box::new(std::io::Error::other(STORE_FAULT)));
+        }
+        Ok(self.kv.lock().unwrap().get(key).cloned())
+    }
+
+    async fn scan(&self, prefix: &[u8]) -> Result<Vec<(Vec<u8>, Bytes)>> {
+        let mut rows: Vec<(Vec<u8>, Bytes)> = self
+            .kv
+            .lock()
+            .unwrap()
+            .iter()
+            .filter(|(k, _)| k.starts_with(prefix))
+            .map(|(k, v)| (k.clone(), v.clone()))
+            .collect();
+        if let Some((sk, stale)) = self.stale_scan.lock().unwrap().as_ref() {
+            for (_, v) in rows.iter_mut().filter(|(k, _)| k == sk) {
+                *v = stale.clone();
+            }
+        }
+        Ok(rows)
+    }
+
+    async fn scan_page(
+        &self,
+        prefix: &[u8],
+        after: Option<&[u8]>,
+        limit: usize,
+    ) -> Result<wyrd_traits::ScanPage> {
+        wyrd_testkit::test_double_scan_page(self, prefix, after, limit).await
+    }
+
+    async fn commit(&self, batch: WriteBatch) -> Result<CommitOutcome> {
+        let mut kv = self.kv.lock().unwrap();
+        for pre in &batch.preconditions {
+            if kv.get(&pre.key).cloned() != pre.expected {
+                return Ok(CommitOutcome::Conflict);
+            }
+        }
+        for (k, v) in batch.puts {
+            kv.insert(k, v);
+        }
+        for k in batch.deletes {
+            kv.remove(&k);
+        }
+        Ok(CommitOutcome::Committed)
+    }
+}
+
+/// One D server's fragment bytes.
+#[derive(Default)]
+struct MemDServer {
+    frags: Mutex<HashMap<FragmentId, Bytes>>,
+}
+
+#[async_trait]
+impl ChunkStore for MemDServer {
+    async fn put_fragment(&self, id: FragmentId, fragment: Bytes) -> Result<()> {
+        self.frags.lock().unwrap().insert(id, fragment);
+        Ok(())
+    }
+
+    async fn get_fragment(&self, id: FragmentId) -> Result<Option<Bytes>> {
+        Ok(self.frags.lock().unwrap().get(&id).cloned())
+    }
+
+    async fn list_fragments(&self) -> Result<Vec<FragmentId>> {
+        Ok(self.frags.lock().unwrap().keys().copied().collect())
+    }
+
+    async fn delete_fragment(&self, id: FragmentId) -> Result<()> {
+        self.frags.lock().unwrap().remove(&id);
+        Ok(())
+    }
+
+    async fn health(&self) -> Result<Health> {
+        Ok(Health::Healthy)
+    }
+}
+
+impl PlacementChunkStore for MemDServer {}
+
+// ---- audit capture ----
+#[derive(Clone, Default)]
+struct Capture(Arc<Mutex<Vec<u8>>>);
+
+impl std::io::Write for Capture {
+    fn write(&mut self, buf: &[u8]) -> std::io::Result<usize> {
+        self.0.lock().unwrap().extend_from_slice(buf);
+        Ok(buf.len())
+    }
+
+    fn flush(&mut self) -> std::io::Result<()> {
+        Ok(())
+    }
+}
+
+impl<'w> tracing_subscriber::fmt::MakeWriter<'w> for Capture {
+    type Writer = Self;
+    fn make_writer(&'w self) -> Self::Writer {
+        self.clone()
+    }
+}
+
+/// Whether the audit trail carries this `action`/`inode` pair (legs 2, 3, 6).
+fn logged(capture: &str, action: &str, object: &str) -> bool {
+    capture.contains(&format!(r#""action":"{action}""#))
+        && capture.contains(&format!(r#""inode":"{object}""#))
+}
+
+// ---- fixture helpers ----
+const CHUNK_LEN: u64 = 5;
+/// `plan_write`'s default identity placement for a single-fragment chunk.
+const DRAINING: DServerId = 0;
+const TARGET: DServerId = 1;
+const NONCE_A: &str = "0123456789abcdef0123456789abcdef";
+const NONCE_B: &str = "fedcba9876543210fedcba9876543210";
+
+fn frag(chunk: ChunkId, index: u16) -> FragmentId {
+    FragmentId { chunk, index }
+}
+
+fn group(nonce: &str, epoch: u64) -> SegmentGroup {
+    SegmentGroup::new(nonce, epoch).unwrap()
+}
+
+/// A committed flat, one-chunk record with no real on-disk fragment behind it (legs 3, 4).
+fn flat_record(chunk: ChunkId, dserver: DServerId, version: u64) -> InodeRecord {
+    let chunk_ref = ChunkRef {
+        id: chunk,
+        scheme: EcScheme::None,
+        len: CHUNK_LEN,
+        placement: vec![dserver],
+    };
+    InodeRecord {
+        size: CHUNK_LEN,
+        chunk_map: vec![chunk_ref].into(),
+        state: InodeState::Committed,
+        version,
+        ..Default::default()
+    }
+}
+
+/// A committed segmented record naming `n` one-chunk segments, no `seg:` records behind it.
+fn segmented_record(nonce: &str, epoch: u64, n: u32, version: u64) -> InodeRecord {
+    let segs = (0..n)
+        .map(|i| SegmentRef {
+            index: i,
+            byte_offset: u64::from(i) * CHUNK_LEN,
+            byte_len: CHUNK_LEN,
+        })
+        .collect();
+    let map = SegmentedMap::new(group(nonce, epoch), segs).unwrap();
+    InodeRecord {
+        size: u64::from(n) * CHUNK_LEN,
+        chunk_map: ChunkMap::Segmented(map),
+        state: InodeState::Committed,
+        version,
+        ..Default::default()
+    }
+}
+
+async fn commit(meta: &MemMeta, batch: WriteBatch) {
+    assert_eq!(meta.commit(batch).await.unwrap(), CommitOutcome::Committed);
+}
+
+async fn read(meta: &MemMeta, key: &[u8]) -> InodeRecord {
+    decode(&meta.get(key).await.unwrap().unwrap()).unwrap()
+}
+
+/// Mark [`DRAINING`] draining and drive `reconcile_step`, returning its audit trail too.
+async fn run(
+    meta: &MemMeta,
+    fleet: &[(DServerId, &dyn ChunkStore)],
+) -> (std::result::Result<Reconciled, ReconcileError>, String) {
+    use std::sync::Once;
+    static INIT: Once = Once::new(); // audit callsites must never latch `Interest::never` (#214)
+    INIT.call_once(|| {
+        let _ = tracing::subscriber::set_global_default(tracing_subscriber::registry());
+    });
+    set_lifecycle(meta, DRAINING, DServerLifecycle::Draining)
+        .await
+        .unwrap();
+    let mut topo = Topology::default();
+    topo.register(DRAINING, "A").register(TARGET, "B");
+    let ctx = RebalanceContext {
+        meta,
+        fleet,
+        topology: &topo,
+    };
+    let leader = Custodian::elect(&MemCoordination::new(), "zone-696")
+        .await
+        .unwrap();
+    let mut zone = FencedZone::new();
+    zone.install(leader.leadership());
+    let capture = Capture::default();
+    let dispatch = tracing::Dispatch::new(
+        tracing_subscriber::registry().with(
+            tracing_subscriber::fmt::layer()
+                .json()
+                .with_writer(capture.clone()),
+        ),
+    );
+    let outcome = reconcile_step(&zone, &leader, None, None, None, Some(&ctx), 500)
+        .with_subscriber(dispatch)
+        .await;
+    let logged = String::from_utf8(capture.0.lock().unwrap().clone()).unwrap();
+    (outcome, logged)
+}
+
+/// Write a real, checksummed chunk onto `d` and commit a flat root naming it under `key` —
+/// the smallest object `evacuate_chunk` can genuinely move (`fragment_intact` needs real bytes).
+async fn write_flat_on(meta: &MemMeta, d: &MemDServer, key: &[u8], chunk: ChunkId) {
+    let plan = plan_write(b"evacuate me", 11, EcScheme::None, || chunk).unwrap();
+    write_fragments(d, &plan).await.unwrap();
+    let root = InodeRecord {
+        size: 11,
+        chunk_map: plan.chunk_refs().into(),
+        state: InodeState::Committed,
+        version: 1,
+        ..Default::default()
+    };
+    commit(meta, WriteBatch::new().put(key.to_vec(), encode(&root))).await;
+}
+
+/// Seed a segmented root at `key` naming `chunks.len()` one-chunk segments, writing only the
+/// first `written` of their `seg:` records (`written < len` is `SegmentAbsent`'s real gap).
+async fn seed_segmented(
+    meta: &MemMeta,
+    key: &[u8],
+    nonce: &str,
+    chunks: &[(ChunkId, DServerId)],
+    written: usize,
+) {
+    for (index, &(chunk_id, dserver)) in chunks.iter().enumerate() {
+        if index < written {
+            let chunk_ref = ChunkRef {
+                id: chunk_id,
+                scheme: EcScheme::None,
+                len: CHUNK_LEN,
+                placement: vec![dserver],
+            };
+            let record = SegmentRecord::new(vec![chunk_ref], index as u64 * CHUNK_LEN).unwrap();
+            let sk = seg_key(&group(nonce, 1), index as u32).unwrap();
+            commit(meta, WriteBatch::new().put(sk, encode(&record))).await;
+        }
+    }
+    let root = segmented_record(nonce, 1, chunks.len() as u32, 1);
+    commit(meta, WriteBatch::new().put(key.to_vec(), encode(&root))).await;
+}
+
+// ---- leg 1: a segmented object no longer stops the flat work beside it ----
+
+#[tokio::test]
+async fn a_segmented_object_no_longer_stops_the_flat_evacuation_beside_it() {
+    let meta = MemMeta::default();
+    let (d0, d1, d2) = (
+        MemDServer::default(),
+        MemDServer::default(),
+        MemDServer::default(),
+    );
+    // A healthy segmented object holding nothing on the draining server, beside a flat
+    // chunk with a fragment ON the draining server.
+    seed_segmented(&meta, b"inode:1", NONCE_A, &[(0xA1, 2)], 1).await;
+    write_flat_on(&meta, &d0, b"inode:2", 0xB1).await;
+
+    let fleet: [(DServerId, &dyn ChunkStore); 3] = [(0, &d0), (1, &d1), (2, &d2)];
+    let (outcome, _) = run(&meta, &fleet).await;
+    assert_eq!(
+        outcome.expect("BASE-RED: a segmented object anywhere must not `Err` the pass"),
+        Reconciled::Changed,
+        "the flat fragment beside the segmented object is still evacuated"
+    );
+    let after = read(&meta, b"inode:2").await;
+    assert_eq!(
+        after.chunk_map.as_flat().unwrap()[0].placement,
+        vec![TARGET]
+    );
+    assert!(d1.get_fragment(frag(0xB1, 0)).await.unwrap().is_some());
+}
+
+// ---- leg 2: a segmented fragment stays put, refused, and the drain does not certify ----
+
+#[tokio::test]
+async fn a_fragment_in_a_seg_record_stays_put_refused_and_does_not_certify() {
+    let meta = MemMeta::default();
+    let d0 = MemDServer::default();
+    // A refused chunk is never read by `evacuate_chunk` — no genuine bytes needed.
+    d0.put_fragment(frag(0xA1, 0), Bytes::from_static(b"x"))
+        .await
+        .unwrap();
+    seed_segmented(&meta, b"inode:1", NONCE_A, &[(0xA1, 0)], 1).await;
+    let root_before = meta.get(b"inode:1").await.unwrap().unwrap();
+    let sk = seg_key(&group(NONCE_A, 1), 0).unwrap();
+    let seg_before = meta.get(&sk).await.unwrap().unwrap();
+
+    let fleet: [(DServerId, &dyn ChunkStore); 1] = [(0, &d0)];
+    let (outcome, log) = run(&meta, &fleet).await;
+    assert_eq!(
+        outcome.unwrap(),
+        Reconciled::Blocked,
+        "BASE-RED: a fragment held only by a segmented map may not certify the drain"
+    );
+    assert!(
+        d0.get_fragment(frag(0xA1, 0)).await.unwrap().is_some(),
+        "stays put (Rule B)"
+    );
+    assert_eq!(
+        meta.get(b"inode:1").await.unwrap().unwrap(),
+        root_before,
+        "root unwritten"
+    );
+    assert_eq!(
+        meta.get(&sk).await.unwrap().unwrap(),
+        seg_before,
+        "seg: record unwritten"
+    );
+    assert!(
+        logged(&log, "refused", "inode:1"),
+        "refusal names the object: {log}"
+    );
+    assert!(
+        log.contains("monotonic_counter.rebalance_evacuation_refused"),
+        "counted: {log}"
+    );
+}
