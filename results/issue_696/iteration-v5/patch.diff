+// ---- leg 4: Rule A — the pass never acts on a generation it did not read ----
+
+#[tokio::test]
+async fn rule_a_the_pass_never_acts_on_a_generation_it_did_not_read() {
+    // `scan` answers a STALE segmented generation while `get` — the resolver's own settle
+    // re-read — answers the LIVE flat root, whose fragment really is on the draining server.
+    // The resolve therefore RESTARTS onto a generation this pass never scanned
+    // (`metadata.rs:2629`), whose chunk list may not be mixed with the scanned record's.
+    let stale = (b"inode:1".to_vec(), encode(&segmented_root(1)));
+    let meta = MemMeta {
+        stale_scan: Mutex::new(Some(stale)),
+        ..Default::default()
+    };
+    let (d0, d1) = (MemDServer::default(), MemDServer::default());
+    write_flat_on(&meta, &d0, b"inode:1", 0xD1).await;
+    let live = stored(&meta, b"inode:1").await;
+
+    let (outcome, log) = run(&meta, &[(DRAINING, &d0), (TARGET, &d1)]).await;
+    let outcome = outcome.expect("BASE-RED: a stale-vs-live generation may not `Err` the pass");
+    // Nothing is moved off a generation this pass did not read, the live record is
+    // byte-unchanged (its `version` never moved), and the drain is NOT certified.
+    let copied = d1.get_fragment(frag(0xD1, 0)).await.unwrap().is_some();
+    let after = stored(&meta, b"inode:1").await;
+    let untouched = (Reconciled::Blocked, live, false);
+    assert_eq!((outcome, after, copied), untouched);
+    let unresolvable = "unresolvable-chunk-map";
+    assert!(named(&log, unresolvable, "inode:1"), "named: {log}");
+    // Nor REPORTED from it: a refusal counted over the restarted generation's chunk list would
+    // tell the operator about fragments this pass never scanned.
+    assert_eq!(lines(&log, "refused"), 0, "{log}");
+}
