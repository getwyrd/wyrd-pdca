+    // own `scan`, as the sibling doubles do (`segmented_map_consumers.rs:109-116`).
+    async fn scan_page(&self, p: &[u8], after: Option<&[u8]>, n: usize) -> Result<ScanPage> {
+        wyrd_testkit::test_double_scan_page(self, p, after, n).await
+    }
+
+    async fn commit(&self, batch: WriteBatch) -> Result<CommitOutcome> {
+        let mut kv = self.kv.lock().unwrap();
+        let stale = |p: &wyrd_traits::Precondition| kv.get(&p.key).cloned() != p.expected;
+        if batch.preconditions.iter().any(stale) {
+            return Ok(CommitOutcome::Conflict);
+        }
+        kv.extend(batch.puts);
+        for key in batch.deletes {
+            kv.remove(&key);
+        }
+        Ok(CommitOutcome::Committed)
+    }
+}
+
+/// One D server's fragment bytes.
+#[derive(Default)]
+struct MemDServer {
+    frags: Mutex<HashMap<FragmentId, Bytes>>,
+}
+
+#[async_trait]
+impl ChunkStore for MemDServer {
+    async fn put_fragment(&self, id: FragmentId, fragment: Bytes) -> Result<()> {
+        self.frags.lock().unwrap().insert(id, fragment);
+        Ok(())
+    }
+
+    async fn get_fragment(&self, id: FragmentId) -> Result<Option<Bytes>> {
+        Ok(self.frags.lock().unwrap().get(&id).cloned())
+    }
+
+    async fn list_fragments(&self) -> Result<Vec<FragmentId>> {
+        Ok(self.frags.lock().unwrap().keys().copied().collect())
+    }
+
+    async fn delete_fragment(&self, id: FragmentId) -> Result<()> {
+        self.frags.lock().unwrap().remove(&id);
+        Ok(())
+    }
+
+    async fn health(&self) -> Result<Health> {
+        Ok(Health::Healthy)
+    }
+}
