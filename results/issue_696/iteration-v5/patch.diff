+// ---- leg 5: the containment guard is not over-broad ----
+
+#[tokio::test]
+async fn a_healthy_segmented_object_holding_nothing_evacuable_still_certifies_the_drain() {
+    let meta = MemMeta::default();
+    let (d0, d1) = (MemDServer::default(), MemDServer::default());
+    // A GENUINELY HEALTHY segmented object: both `seg:` records written, both placements
+    // well-formed for the scheme, and NOTHING of it on the draining server — nothing damaged,
+    // malformed or unreadable anywhere in this store. So the only thing that can cost this
+    // drain its certification is a containment that refuses a segmented object for BEING
+    // segmented. (Isolating that is the leg's whole point: an unclassifiable placement in the
+    // fixture would answer `fragments == 0` for its own reason — ADR-0040 decision 4 — and
+    // the leg would pass with the guard under test removed. Leg 6 covers that shape.)
+    let chunks = [(0xE1, vec![TARGET]), (0xE2, vec![TARGET])];
+    seed_segmented(&meta, b"inode:1", &chunks, 2).await;
+    write_flat_on(&meta, &d0, b"inode:2", 0xE3).await;
+
+    let fleet: [(DServerId, &dyn ChunkStore); 2] = [(DRAINING, &d0), (TARGET, &d1)];
+    let first = run(&meta, &fleet).await.0.expect("BASE-RED: must ANSWER");
+    assert_eq!(first, Reconciled::Changed);
+    // REQUIRED: with every flat evacuation complete, a healthy segmented object holding NOTHING
+    // on the draining server may not cost the drain its certification — otherwise no
+    // decommission ever certifies over a store holding a multipart object, which is this
+    // slice's own defect in mirror image (`results/issue_681/iteration-v7`). Asserted on the
+    // ANSWER, so an `Err` fails exactly as a wrong `Reconciled` does: a pass that gives no
+    // answer has not certified either, and tolerating one would make the leg vacuous in both
+    // directions — a regression that re-aborted over exactly this store would pass in silence.
+    let (second, log) = run(&meta, &fleet).await;
+    let answer = second.expect("BASE-RED: must ANSWER");
+    assert_eq!(answer, Reconciled::Satisfied, "{log}");
+    // The seam half of the same guard, and the half an over-broad containment trips on
+    // first: nothing in this store may be refused at all.
+    assert_eq!(lines(&log, "refused"), 0, "{log}");
+}
