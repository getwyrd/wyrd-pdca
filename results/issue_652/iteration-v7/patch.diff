+/// What one `inode:` row's **value** is to [`high_water_marks`] — an attribution, and nothing
+/// else: the row's id comes from its *key*, so the value is read only to tell an operator
+/// which records are damaged.
+#[derive(Debug, PartialEq, Eq)]
+enum InodeValueReading {
+    /// The record decodes. Nothing is owed to anyone.
+    Readable,
+    /// Past [`MAX_VALUE_BYTES`] — neither decoded nor retained.
+    OverCeiling { bytes: usize },
+    /// Within the ceiling, but the decoder refused it.
+    Undecodable { detail: String },
