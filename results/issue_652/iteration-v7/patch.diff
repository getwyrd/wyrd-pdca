+/// damaged value as a *number* is not one of the legal answers.
+#[derive(Debug, PartialEq, Eq)]
+pub(crate) enum PersistedInodeCounter {
+    /// No counter is stored. A fresh store has none, and neither does one an older
+    /// single-process gateway wrote from an in-memory counter — both mean "the next id is 1".
+    Absent,
+    /// A counter this allocator can hand out from and compare a floor against.
+    Readable(u64),
+    /// Stored, and **not** the canonical decimal `u64` every writer of this key produces —
+    /// including the near-misses `u64::from_str` would have accepted (`+1`, `01`).
+    Damaged {
+        /// Why it did not read — the operator repairing it works from this.
+        detail: String,
+    },
+}
+
+/// Read the persisted counter's stored bytes, resolving damage into a *value* rather than an
+/// `Err`, so each caller can spend it as its own contract requires (see
+/// [`PersistedInodeCounter`]).
+///
+/// Separated from both callers so the reading is a unit a test can stand on directly: the
+/// difference between "absent" and "damaged" is one gateway's startup, and no end-to-end
+/// assertion over a store distinguishes a counter that read as `1` from one that was never
+/// there.
+///
+/// **The grammar is canonical decimal, not `u64::from_str`.** `from_str` accepts `+1` and `01`
+/// as the value `1`, and this record is the one number the allocator hands out ids *from*: a
+/// spelling no writer of this key produces (it writes `u64::to_string`,
+/// [`alloc_inode`]) read leniently as a **smaller** number than the store's own `inode:` keys
+/// prove is a re-mint of ids that are still live — the failure `Gateway::recover` exists to
+/// prevent, and the repo's standing rule against `from_str` sign and digit-width laxity in a
+/// hand-rolled grammar (`AGENTS.md`, *Grammar strictness*). Read canonically it is *damage*,
+/// which both callers answer safely. The grammar itself is
+/// [`wyrd_core::metadata::parse_canonical_u64`] — the store's one canonical-decimal reader,
+/// shared rather than re-derived here, and the same one `inode:` **keys** are read under
+/// (`wyrd_core::metadata::parse_inode_key`).
+pub(crate) fn read_persisted_inode_counter(stored: Option<&[u8]>) -> PersistedInodeCounter {
+    let Some(bytes) = stored else {
+        return PersistedInodeCounter::Absent;
+    };
+    let text = match std::str::from_utf8(bytes) {
+        Ok(text) => text,
+        Err(err) => {
+            return PersistedInodeCounter::Damaged {
+                detail: format!("not UTF-8: {err}"),
+            }
+        }
+    };
+    match parse_canonical_u64(text) {
