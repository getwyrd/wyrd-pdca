+/// between `>` and `>=` here is one conforming record's attribution, which no end-to-end
+/// assertion over a store distinguishes.
+fn read_inode_value(value: &[u8]) -> InodeValueReading {
+    if value.len() > MAX_VALUE_BYTES {
+        return InodeValueReading::OverCeiling { bytes: value.len() };
+    }
+    match decode::<InodeRecord>(value) {
+        Ok(_) => InodeValueReading::Readable,
+        Err(err) => InodeValueReading::Undecodable {
+            detail: err.to_string(),
+        },
