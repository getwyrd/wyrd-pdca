+        String::from_utf8(self.0.lock().unwrap().clone()).unwrap()
+    }
+}
+
+impl io::Write for Capture {
+    fn write(&mut self, buf: &[u8]) -> io::Result<usize> {
+        self.0.lock().unwrap().extend_from_slice(buf);
+        Ok(buf.len())
+    }
+    fn flush(&mut self) -> io::Result<()> {
+        Ok(())
+    }
+}
+
+impl<'w> tracing_subscriber::fmt::MakeWriter<'w> for Capture {
+    type Writer = Self;
+    fn make_writer(&'w self) -> Self::Writer {
+        self.clone()
+    }
+}
+
+/// A [`MetadataStore`] whose [`scan`](MetadataStore::scan) always refuses exactly as a backend
+/// past `SCAN_CAP` does, while every other method — crucially
+/// [`scan_page`](MetadataStore::scan_page) — forwards unchanged to a real store.
+///
+/// This is what makes "recovery reads in bounded pages" *observable*: over this store the only
+/// way `Gateway::recover()` can answer `Ok(())` at all is by never calling `scan`.
+struct ScanRefusingStore {
+    inner: RedbMetadataStore,
+}
+
+#[async_trait]
+impl MetadataStore for ScanRefusingStore {
+    async fn get(&self, key: &[u8]) -> Result<Option<Bytes>> {
+        self.inner.get(key).await
+    }
+
+    async fn scan(&self, prefix: &[u8]) -> Result<Vec<(Vec<u8>, Bytes)>> {
+        Err(Box::new(ScanCapExceeded {
+            cap: SCAN_CAP,
+            prefix: prefix.to_vec(),
+        }))
+    }
+
+    async fn scan_page(
+        &self,
+        prefix: &[u8],
+        after: Option<&[u8]>,
+        limit: usize,
+    ) -> Result<ScanPage> {
+        self.inner.scan_page(prefix, after, limit).await
+    }
+
+    async fn commit(&self, batch: WriteBatch) -> Result<CommitOutcome> {
+        self.inner.commit(batch).await
+    }
+}
+
+/// A [`MetadataStore`] on which every **guarded** write to `meta:next_inode` loses: a peer that
+/// wins the race on the counter every single time. Reads forward to a real store, so recovery's
+/// walk sees a genuine namespace and derives a genuine floor — only that one write never lands.
+///
+/// Faithful to the seam rather than blanket-refusing: `Conflict` is what a backend answers when
+/// a **precondition** fails (`crates/traits/src/lib.rs:1194-1210`), so a batch carrying no
+/// precondition on this key is forwarded to the real store and answers whatever redb answers.
+///
+/// This is the shape of a *permanently contended* counter, and it is the only fixture in which
+/// "the seed retries until it wins" and "the seed reaches a result" differ: over a store where
+/// the peer eventually stops, an unbounded retry is indistinguishable from a bounded one.
+struct ConflictingCounterStore {
+    inner: RedbMetadataStore,
+    /// Every guarded counter write this store refused — the *bound* is asserted on this, not
+    /// merely inferred from the call returning at all.
+    refused: Arc<AtomicUsize>,
+}
+
+#[async_trait]
+impl MetadataStore for ConflictingCounterStore {
+    async fn get(&self, key: &[u8]) -> Result<Option<Bytes>> {
+        self.inner.get(key).await
+    }
+
+    async fn scan(&self, prefix: &[u8]) -> Result<Vec<(Vec<u8>, Bytes)>> {
+        self.inner.scan(prefix).await
+    }
+
+    async fn scan_page(
+        &self,
+        prefix: &[u8],
+        after: Option<&[u8]>,
+        limit: usize,
+    ) -> Result<ScanPage> {
+        self.inner.scan_page(prefix, after, limit).await
+    }
+
+    async fn commit(&self, batch: WriteBatch) -> Result<CommitOutcome> {
+        if batch
+            .preconditions
+            .iter()
+            .any(|guard| guard.key == NEXT_INODE_KEY)
+        {
+            self.refused.fetch_add(1, Ordering::SeqCst);
+            return Ok(CommitOutcome::Conflict);
+        }
+        self.inner.commit(batch).await
+    }
+}
+
+/// A [`MetadataStore`] that pages in **twos** and, once the recovery walk's cursor has moved
+/// past its first page of `inode:`, commits rows **behind** that cursor — the concurrent legacy
+/// writer of a rolling upgrade, reproduced against a real backend.
+///
+/// Both halves are faithful to the seam rather than convenient:
+///
+/// * **Paging in twos** is a *conforming* backend, not a rigged one. A page is bounded by
+///   `min(limit, the store's effective cap)` and may be shorter than the caller asked for
+///   (`crates/traits/src/lib.rs:1069-1073`); `next` still marks the last row returned, so the
+///   walk resumes correctly. It only makes a five-row namespace take the several pages a
+///   production-sized one takes against `RECOVERY_PAGE` (128).
+/// * **The insert is genuinely behind the cursor.** `scan_page` promises no snapshot: "keys
+///   inserted before the cursor after it passed … may be missed", and "no snapshot isolation is
+///   required of any backend" (`crates/traits/src/lib.rs:1058-1066`). The rows go in *after*
+///   the inner store has already answered the page, so the returned page is untouched and the
+///   next page — which starts strictly after the cursor — cannot contain them either.
+///
+/// The peer writes once the walk has taken its **first** read of `inode:`, by either seam: a
+/// page (what recovery does) or a whole `scan` (what it did before #652, and what a store double
+/// must not quietly excuse). Behind a page cursor that is a missed key; after a `scan`'s cut it
+/// is simply a later write. Both leave recovery handing the allocator a floor below a live id,
+/// which is the state the allocator has to survive.
+struct WriterBehindCursorStore {
+    inner: RedbMetadataStore,
+    /// The rows the peer commits mid-walk: an object's own `inode:`/`dirent:` records, lifted
+    /// out of this same store so they are exactly what a peer's PUT would have written.
+    behind: Mutex<Option<Rows>>,
+    /// Reads of `inode:` served so far — the peer writes once, after the first.
+    reads: AtomicUsize,
+}
+
+impl WriterBehindCursorStore {
+    /// Commit the peer's rows, once, after the walk's first read of `inode:`.
+    async fn peer_writes_once(&self, prefix: &[u8]) -> Result<()> {
+        if prefix != b"inode:" || self.reads.fetch_add(1, Ordering::SeqCst) != 0 {
+            return Ok(());
+        }
+        let rows = self.behind.lock().expect("peer rows").take();
+        if let Some(rows) = rows {
+            let batch = rows
+                .into_iter()
+                .fold(WriteBatch::new(), |batch, (key, value)| {
+                    batch.put(key, value)
+                });
+            assert_eq!(
+                self.inner.commit(batch).await?,
+                CommitOutcome::Committed,
+                "the peer's mid-walk commit must land, or this fixture proves nothing",
+            );
+        }
+        Ok(())
+    }
+}
+
+#[async_trait]
+impl MetadataStore for WriterBehindCursorStore {
+    async fn get(&self, key: &[u8]) -> Result<Option<Bytes>> {
+        self.inner.get(key).await
+    }
+
+    async fn scan(&self, prefix: &[u8]) -> Result<Vec<(Vec<u8>, Bytes)>> {
+        let rows = self.inner.scan(prefix).await?;
+        self.peer_writes_once(prefix).await?;
+        Ok(rows)
+    }
+
+    async fn scan_page(
+        &self,
+        prefix: &[u8],
+        after: Option<&[u8]>,
+        limit: usize,
+    ) -> Result<ScanPage> {
+        let page = self.inner.scan_page(prefix, after, limit.min(2)).await?;
+        self.peer_writes_once(prefix).await?;
+        Ok(page)
+    }
+
+    async fn commit(&self, batch: WriteBatch) -> Result<CommitOutcome> {
+        self.inner.commit(batch).await
+    }
+}
+
+/// Run `body` against a gateway over this store, and **drop it before returning**: redb holds a
+/// file lock, so nothing else (including [`persisted_next_inode`]) can open the store while a
+/// gateway is alive over it. Each block is one gateway lifetime, which is also the shape the
+/// property under test cares about — a restart.
+fn with_gateway<T>(db: &Path, frags: &Path, body: impl FnOnce(&Backend) -> T) -> T {
+    let gateway = Gateway::new(
+        RedbMetadataStore::open(db).expect("redb"),
+        FsChunkStore::open(frags).expect("fs chunk store"),
+        MemCoordination::new(),
+    );
+    body(&gateway)
+}
+
+/// [`with_gateway`], but the metadata seam is the [`ScanRefusingStore`] double.
+fn with_scan_refusing_gateway<T>(
+    db: &Path,
+    frags: &Path,
+    body: impl FnOnce(&Gateway<ScanRefusingStore, FsChunkStore, MemCoordination>) -> T,
+) -> T {
+    let gateway = Gateway::new(
+        ScanRefusingStore {
+            inner: RedbMetadataStore::open(db).expect("redb"),
+        },
+        FsChunkStore::open(frags).expect("fs chunk store"),
+        MemCoordination::new(),
+    );
+    body(&gateway)
+}
+
+/// The persisted allocator counter's **stored bytes**, or `None` when the store carries no
+/// counter yet. Raw rather than parsed wherever a test's subject is a *damaged* counter: what
+/// such a test has to distinguish is "left exactly as stored" from "rewritten", and a helper
+/// that parses turns the second into a panic inside the helper rather than a failure at the
+/// assertion that means it.
+fn persisted_next_inode_raw(db: &Path) -> Option<Vec<u8>> {
+    let meta = RedbMetadataStore::open(db).expect("redb reopen to read the counter");
+    let raw = pollster::block_on(meta.get(NEXT_INODE_KEY)).expect("get meta:next_inode")?;
+    Some(raw.to_vec())
+}
+
+/// The persisted allocator counter, or `None` when the store carries no counter yet.
+fn persisted_next_inode(db: &Path) -> Option<u64> {
+    let raw = persisted_next_inode_raw(db)?;
+    Some(
+        std::str::from_utf8(&raw)
+            .expect("the counter is decimal text")
+            .parse()
+            .expect("the counter is a u64"),
+    )
+}
+
+/// Write raw bytes under an exact metadata key — the one artificial step these tests need, since
+/// a healthy gateway never writes a record it could not read back.
+fn put_raw(db: &Path, key: Vec<u8>, value: &[u8]) {
+    let meta = RedbMetadataStore::open(db).expect("redb reopen to seed a raw record");
+    assert_eq!(
+        pollster::block_on(meta.commit(WriteBatch::new().put(key, Bytes::copy_from_slice(value))))
+            .expect("commit the raw record"),
+        CommitOutcome::Committed,
+    );
+}
+
+/// Run `body` with the log stream captured, so what it attributed can be asserted rather than
+/// trusted. JSON, so the assertions below bind the **structured** target and fields.
+fn capturing<T>(body: impl FnOnce() -> T) -> (T, String) {
+    let capture = Capture::default();
+    let dispatch = dispatch(
+        &LogConfig::new(Some("warn"), Some("json")).expect("log config"),
+        capture.clone(),
+        tracing_subscriber::layer::Identity::new(),
+    );
+    let outcome = tracing::dispatcher::with_default(&dispatch, body);
+    (outcome, capture.contents())
+}
+
+/// [`capturing`] around the call under test in most of this file: `recover()`.
+fn recover_capturing<M, C, Co>(gateway: &Gateway<M, C, Co>) -> (Result<()>, String)
+where
+    M: MetadataStore,
+    C: wyrd_traits::PlacementChunkStore,
+    Co: wyrd_traits::Coordination,
+{
+    capturing(|| pollster::block_on(gateway.recover()))
+}
+
+/// Store an object through the production **cluster** path — the one that derives its chunk ids
+/// from the inode id it is handed (`cli::chunk_id_minter`) and writes the fragments before the
+/// metadata commit. Composed over the same redb + fs backends as the gateway, so what differs
+/// from [`with_gateway`] is the *path*, not the store.
+fn cluster_put(db: &Path, frags: &Path, key: &str, data: &[u8], chunk: usize) -> CommitOutcome {
+    let meta = RedbMetadataStore::open(db).expect("redb reopen for the cluster path");
+    let chunks = FsChunkStore::open(frags).expect("fs chunk store");
+    pollster::block_on(cluster_store_put(
+        &meta,
+        &chunks,
+        key,
+        data,
+        chunk,
+        DEFAULT_DURABILITY,
+    ))
+    .expect("the cluster PUT must reach a result")
+}
+
+/// Every `(key, value)` in the store. Used to lift out *exactly* the rows one PUT wrote, so a
+/// fixture that replays a peer's commit replays the bytes a peer's commit really produces
+/// rather than a hand-built approximation of them.
+fn all_rows(db: &Path) -> Rows {
+    let meta = RedbMetadataStore::open(db).expect("redb reopen to read the whole store");
+    pollster::block_on(meta.scan(b"")).expect("scan the whole store")
+}
+
+/// Remove `keys` from the store — the second half of lifting a committed object's records out
+/// of it (its fragments stay on the chunk store, exactly as they would before the peer's
+/// metadata commit lands).
+fn delete_rows(db: &Path, keys: impl IntoIterator<Item = Vec<u8>>) {
+    let meta = RedbMetadataStore::open(db).expect("redb reopen to lift rows out");
+    let batch = keys
+        .into_iter()
+        .fold(WriteBatch::new(), |batch, key| batch.delete(key));
+    assert_eq!(
+        pollster::block_on(meta.commit(batch)).expect("lift the rows out"),
+        CommitOutcome::Committed,
+    );
+}
+
+/// Whether `log` holds one line that is **on the audit target** and names both `action` and the
+/// offending `key`. All three on the SAME line: a target on one line and a key on another is not
+/// an attribution of that record.
+fn attributed(log: &str, action: &str, key: &str) -> bool {
+    log.lines().any(|line| {
+        line.contains(&format!("\"target\":\"{RECOVERY_AUDIT}\""))
+            && line.contains(&format!("\"action\":\"{action}\""))
+            && line.contains(&format!("\"key\":\"{key}\""))
+    })
+}
+
+// --- criterion 1: total over damage ------------------------------------------------------
+
+/// **Total over damaged records, and the damage neither lowers nor invents the floor.**
+///
+/// A healthy committed object shares its store with rows recovery cannot read: a value that does
+/// not decode, a value past the per-record ceiling, and four keys the `inode:` grammar refuses —
+/// including the three `u64::from_str` would have accepted (`inode:+7`, `inode:007`,
+/// `inode:+18446744073709551615`). `recover()` must still be `Ok(())`, the healthy object must
+/// still read back byte-identically, the allocator must be seeded strictly above the damaged
+/// records' **key** ids (a key is readable even when the value beside it is not) and **not**
+/// above ids only a malformed key spells, each damaged row must be attributed on the audit seam,
+/// and the next new-key PUT must commit.
+///
+/// The `inode:+18446744073709551615` row is the sharp one: read leniently it contributes
+/// `u64::MAX`, seeding the allocator at the ceiling of the id space — after which every new-key
+/// PUT fails closed for want of a free id. One stray key would cost the store its writes, so
+/// "lenient on keys is the safe direction" is false and this fixture is what says so.
+///
+/// Pre-fix RED: `high_water_marks` decoded every value with `decode(&value)?`
+/// (`crates/core/src/metadata.rs:2081` pre-fix), so the undecodable row makes the whole call
+/// `Err`, `recover()` propagates it, and the first assertion fails.
+#[test]
+fn recover_is_total_over_damaged_inode_records_and_attributes_each() {
+    // Ids: the healthy object takes 1; the damaged rows deliberately sit ABOVE it, so the floor
+    // asserted below can only come from a damaged record's key.
+    const UNDECODABLE: u64 = 50;
+    const OVER_CEILING: u64 = 60;
+    const UNPARSABLE_KEY: &[u8] = b"inode:not-a-number";
+    /// Keys `u64::from_str` accepts and this store's grammar must not: two second spellings and
+    /// one that would seed the allocator at the ceiling of the id space.
+    const NON_CANONICAL_KEYS: [&[u8]; 3] =
+        [b"inode:+7", b"inode:007", b"inode:+18446744073709551615"];
+
+    let dir = tempfile::tempdir().expect("temp dir");
+    let db = dir.path().join("meta.redb");
+    let frags = dir.path().join("frags");
+
+    with_gateway(&db, &frags, |g| {
+        pollster::block_on(g.put_object("bucket/healthy", b"still readable"))
+            .expect("PUT the healthy object");
+    });
+    put_raw(&db, inode_key(UNDECODABLE), b"not json at all");
+    put_raw(
+        &db,
+        inode_key(OVER_CEILING),
+        &vec![b'x'; MAX_VALUE_BYTES + 1],
+    );
+    put_raw(&db, UNPARSABLE_KEY.to_vec(), b"{}");
+    for key in NON_CANONICAL_KEYS {
+        put_raw(&db, key.to_vec(), b"{}");
+    }
+
+    let log = with_gateway(&db, &frags, |g| {
+        let (outcome, log) = recover_capturing(g);
+        outcome.expect(
+            "recover() must be Ok(()) over a store holding records it cannot read — an Err here \
+             costs every healthy object its availability (issue #652 criterion 1)",
+        );
+        assert_eq!(
+            pollster::block_on(g.get_object("bucket/healthy"))
+                .expect("get the healthy object")
+                .as_deref(),
+            Some(&b"still readable"[..]),
+            "the healthy object must survive recovery over a damaged store, byte-identical",
+        );
+        log
+    });
+
+    // The floor is the largest inode id any CANONICAL key names (60), plus one — so the
+    // undecodable and over-ceiling rows both contributed their ids, and the four malformed keys
+    // contributed none. Exact, not `>`: a walk that stopped at the first damaged row, one that
+    // folded an unparsable key in as garbage, and one that read `inode:+18446744073709551615`
+    // leniently (answering `u64::MAX`) all fail here.
+    assert_eq!(
+        persisted_next_inode(&db),
+        Some(OVER_CEILING + 1),
+        "the allocator must resume strictly above every inode id a canonical KEY names, however \
+         unreadable the value beside it is — and never above an id only a malformed key spells",
+    );
+
+    assert!(
+        attributed(&log, "inode-record-undecodable", "inode:50"),
+        "an undecodable record must be attributed on {RECOVERY_AUDIT}, not silently skipped — \
+         captured log: {log}",
+    );
+    assert!(
+        attributed(&log, "inode-record-over-ceiling", "inode:60"),
+        "a record past the value ceiling must be attributed on {RECOVERY_AUDIT} (and not decoded) \
+         — captured log: {log}",
+    );
+    for key in std::iter::once(UNPARSABLE_KEY).chain(NON_CANONICAL_KEYS) {
+        let key = String::from_utf8(key.to_vec()).expect("the fixture keys are text");
+        assert!(
+            attributed(&log, "inode-key-unparsable", &key),
+            "a key the `inode:` grammar refuses must be attributed on {RECOVERY_AUDIT}: an \
+             unattributed skip is the silent success a recovery may never give ({key}) — \
+             captured log: {log}",
+        );
+    }
+
+    // And the gateway is genuinely usable afterwards: the next new-key PUT commits under an inode
+    // id above every damaged record's.
+    with_gateway(&db, &frags, |g| {
+        pollster::block_on(g.put_object("bucket/after-recovery", b"new object")).expect(
+            "a new-key PUT after recovery must commit, minting an inode id above the damaged \
+             records' key ids",
+        );
+        assert_eq!(
+            pollster::block_on(g.get_object("bucket/after-recovery"))
+                .expect("get the new object")
+                .as_deref(),
+            Some(&b"new object"[..]),
+        );
+    });
+    assert_eq!(
+        persisted_next_inode(&db),
+        Some(OVER_CEILING + 2),
+        "the new object took exactly the id recovery reserved for it",
+    );
+}
+
+// --- criterion 1, the third record: the persisted allocator itself -------------------------
+
+/// **Total over a damaged `meta:next_inode` — which is attributed and left exactly as stored.**
+///
+/// Recovery's second step seeds the walk's mark onto the persisted allocator
+/// (`crates/server/src/cli.rs:seed_next_inode_floor`, from `crates/server/src/lib.rs:146`). A
+/// walk that steps over damaged `inode:` rows and then hands its mark to a seed that `?`s on a
+/// damaged counter leaves the gateway exactly as dead as before, for exactly the same reason —
+/// so the counter must not end recovery.
+///
+/// What it must **not** do instead is rewrite the record from the walk's floor. That floor is
+/// proven above every *committed* `inode:` id and nothing more, while the counter's true value
+/// also stands above every id that was **handed out** and is not committed under an `inode:` key
+/// — an id a concurrent gateway is mid-PUT with, or one whose object was deleted while its
+/// fragments are still deadlined under an `orphan:` grace record. The cluster path derives an
+/// object's chunk ids from its inode id, so re-minting either kind writes a live object's chunk
+/// ids. Recovery therefore gives the *other* legal answer to a record it cannot read: fail
+/// closed **for that record**. The gateway starts, every committed object stays readable and
+/// overwritable, and only a new-key allocation refuses until an operator repairs the counter.
+///
+/// Pre-fix RED: `seed_next_inode_floor` read the counter with
+/// `std::str::from_utf8(bytes)?.parse()?` (`crates/server/src/cli.rs:1696` pre-fix), so the
+/// damaged counter makes `recover()` `Err` and the first assertion fails.
+#[test]
+fn recover_is_total_over_a_damaged_next_inode_counter_and_leaves_it_for_repair() {
+    // Not UTF-8 at all — the harsher of the two damage classes (the decimal-grammar half is
+    // pinned as a unit in `cli::tests`, where a store cannot hide the difference).
+    const DAMAGED_COUNTER: &[u8] = b"\xff\xfe not a number";
+
+    let dir = tempfile::tempdir().expect("temp dir");
+    let db = dir.path().join("meta.redb");
+    let frags = dir.path().join("frags");
+
+    with_gateway(&db, &frags, |g| {
+        pollster::block_on(g.put_object("bucket/a", b"first")).expect("PUT A");
+        pollster::block_on(g.put_object("bucket/b", b"second")).expect("PUT B");
+    });
+    // Corrupt the allocator in place. Every `inode:` record stays healthy: this test is about
+    // the counter alone, so it cannot pass on the strength of the walk's own totality.
+    put_raw(&db, NEXT_INODE_KEY.to_vec(), DAMAGED_COUNTER);
+
+    let log = with_gateway(&db, &frags, |g| {
+        let (outcome, log) = recover_capturing(g);
+        outcome.expect(
+            "recover() must be Ok(()) over a damaged `meta:next_inode`: the allocator is one \
+             record, and a recovery that refuses over it costs every healthy object its \
+             availability just as surely as a damaged inode record does (issue #652)",
+        );
+        for (key, want) in [("bucket/a", &b"first"[..]), ("bucket/b", &b"second"[..])] {
+            assert_eq!(
+                pollster::block_on(g.get_object(key))
+                    .expect("get the healthy object")
+                    .as_deref(),
+                Some(want),
+                "the healthy objects must survive a damaged allocator, byte-identical",
+            );
+        }
+        log
+    });
+
+    assert_eq!(
+        persisted_next_inode_raw(&db).as_deref(),
+        Some(DAMAGED_COUNTER),
+        "the damaged counter must be left EXACTLY as stored: the floor the `inode:` keys prove \
+         (3) is above every committed id and says nothing about the ids this counter may already \
+         have handed out — for an object still being written by a peer, or one deleted while its \
+         fragments are still deadlined under an `orphan:` grace record — so writing it here \
+         would re-mint a live id, not repair anything",
+    );
+    assert!(
+        attributed(&log, "next-inode-counter-undecodable", "meta:next_inode"),
+        "a damaged allocator must be attributed on {RECOVERY_AUDIT} — leaving it unattributed is \
+         precisely the silent skip a recovery may never give, and the attribution IS the repair \
+         obligation an operator works from — captured log: {log}",
+    );
+
+    // The blast radius is one operation, and this is the half that has to keep working: reads
+    // and OVERWRITES never allocate, so they are unaffected by an unreadable counter.
+    with_gateway(&db, &frags, |g| {
+        pollster::block_on(g.put_object("bucket/a", b"overwritten")).expect(
+            "an overwrite reuses the object's inode and never allocates, so a damaged counter \
+             must not touch it",
+        );
+        assert_eq!(
+            pollster::block_on(g.get_object("bucket/a"))
+                .expect("get A")
+                .as_deref(),
+            Some(&b"overwritten"[..]),
+        );
+
+        // And the half that must refuse: a NEW key needs an id, and there is no readable number
+        // to hand one out from.
+        let refused = pollster::block_on(g.put_object("bucket/c", b"third"));
+        let message = refused
+            .expect_err(
+                "a new-key PUT over a damaged allocator must fail CLOSED: handing out an id \
+                 derived from anything but the counter risks one that is still in use",
+            )
+            .to_string();
+        assert!(
+            message.contains("meta:next_inode"),
+            "the refusal must name the record an operator has to repair, not fail anonymously: \
+             {message}",
+        );
+        assert_eq!(
+            pollster::block_on(g.get_object("bucket/b"))
+                .expect("get B")
+                .as_deref(),
+            Some(&b"second"[..]),
+            "and nothing the refused PUT did touched another object",
+        );
+    });
+
+    assert_eq!(
+        persisted_next_inode_raw(&db).as_deref(),
+        Some(DAMAGED_COUNTER),
+        "the refusal leaves the record for the operator too — a PUT that 'repaired' the counter \
+         on its way past would re-mint exactly the ids the seed refused to",
+    );
+}
+
+// --- criterion 2: total over size --------------------------------------------------------
+
+/// **Total over a store too large to `scan`, and the mark is the whole namespace's.**
+///
+/// Over a store whose `scan` refuses with `ScanCapExceeded` while `scan_page` works, `recover()`
+/// must still be `Ok(())` and must seed the same floor a healthy store would — i.e. it reads its
+/// namespaces in bounded pages, never through `scan`.
+///
+/// The fixture is built so a walk that *pages* is the only one that can answer correctly: it
+/// holds more `inode:` rows than one page (`RECOVERY_PAGE`, 128 —
+/// `crates/core/src/metadata.rs:2095`), the numerically largest id lives beyond the first page,
+/// and the byte-lexicographically **last** row (`inode:99`) is deliberately not the largest id,
+/// so a walk that kept "the last id it saw" instead of the maximum answers 100 rather than 251.
+///
+/// Pre-fix RED: `high_water_marks` read `inode:` (and `pending:`/`orphan:`) with `store.scan`
+/// (`crates/core/src/metadata.rs:2077,2094,2105` pre-fix), so every one of those calls returns
+/// `Err(ScanCapExceeded)` here and `recover()` propagates it.
+#[test]
+fn recover_is_total_over_a_store_whose_scan_refuses_and_pages_the_whole_namespace() {
+    // Spread over three pages of 128 rows, with the maximum id on the last page.
+    const FIRST: u64 = 100;
+    const LAST: u64 = 250;
+    // Byte-lexicographically after `inode:250`, numerically far below it.
+    const BYTE_LAST_BUT_SMALL: u64 = 99;
+
+    let dir = tempfile::tempdir().expect("temp dir");
+    let db = dir.path().join("meta.redb");
+    let frags = dir.path().join("frags");
+
+    // Sanity: the double really refuses, independently of the scenario below — otherwise this
+    // test could pass without ever exercising `scan_page`.
+    let sanity = ScanRefusingStore {
+        inner: RedbMetadataStore::in_memory().expect("redb in-memory"),
+    };
+    assert!(
+        pollster::block_on(MetadataStore::scan(&sanity, b"inode:")).is_err(),
+        "the store double's scan() must refuse, or this test never binds the paging property",
+    );
+
+    // The legacy shape `recover` exists for (mirrors `s3_http_wire.rs:677-697`): committed objects
+    // under `inode:`, no persisted `meta:next_inode` — so recovery is load-bearing for the PUT
+    // below rather than a no-op the test would pass without.
+    with_gateway(&db, &frags, |g| {
+        pollster::block_on(g.put_object("bucket/a", b"first")).expect("PUT A");
+    });
+    let record = {
+        let meta = RedbMetadataStore::open(&db).expect("redb reopen to read the seed record");
+        pollster::block_on(meta.get(&inode_key(1)))
+            .expect("get the committed record")
+            .expect("the PUT wrote inode:1")
+    };
+    // Healthy, decodable rows: this test is about SIZE, not damage — the two criteria stay
+    // independent.
+    {
+        let meta = RedbMetadataStore::open(&db).expect("redb reopen to widen the namespace");
+        let mut batch = WriteBatch::new();
+        for id in (FIRST..=LAST).chain(std::iter::once(BYTE_LAST_BUT_SMALL)) {
+            batch = batch.put(inode_key(id), record.clone());
+        }
+        assert_eq!(
+            pollster::block_on(meta.commit(batch)).expect("commit the wide namespace"),
+            CommitOutcome::Committed,
+        );
+        assert_eq!(
+            pollster::block_on(meta.commit(WriteBatch::new().delete(NEXT_INODE_KEY.to_vec())))
+                .expect("strip meta:next_inode to model a legacy store"),
+            CommitOutcome::Committed,
+        );
+    }
+
+    with_scan_refusing_gateway(&db, &frags, |g| {
+        pollster::block_on(g.recover()).expect(
+            "recover() must be Ok(()) even though scan() refuses on every call (issue #652 \
+             criterion 2): the walk must read its namespaces in bounded pages via scan_page",
+        );
+    });
+
+    assert_eq!(
+        persisted_next_inode(&db),
+        Some(LAST + 1),
+        "the mark must be the maximum over the WHOLE namespace: a walk that stopped after one \
+         page would answer 227, and one that kept the last row it saw would answer 100",
+    );
+
+    with_scan_refusing_gateway(&db, &frags, |g| {
+        pollster::block_on(g.put_object("bucket/b", b"second")).expect(
+            "after recovery over the scan-refusing store, a new-key PUT must commit without \
+             colliding with a legacy inode",
+        );
+        assert_eq!(
+            pollster::block_on(g.get_object("bucket/a"))
+                .expect("get A")
+                .as_deref(),
+            Some(&b"first"[..]),
+            "the legacy object survives, byte-identical",
+        );
+        assert_eq!(
+            pollster::block_on(g.get_object("bucket/b"))
+                .expect("get B")
+                .as_deref(),
+            Some(&b"second"[..]),
+            "the new object is stored under a fresh, non-colliding inode",
+        );
+    });
+}
+
+// --- recovery always REACHES a result -----------------------------------------------------
+
+/// **A permanently contended counter ends recovery with a result, never with a spin.**
+///
+/// The seed's compare-and-set retried `CommitOutcome::Conflict` forever
+/// (`crates/server/src/cli.rs:1707-1710` pre-fix). Over a counter another writer wins every
+/// time, `Gateway::recover` therefore never returns — and a startup step that never returns is
+/// the same lost availability as one that refuses, reached by not answering at all
+/// (`AGENTS.md`, *Await discipline*). It must give up, fail closed, and leave nothing rewound.
+///
+/// The recovery runs on its own thread with a wall-clock guard rather than inline, so a
+/// regression to the unbounded loop **fails this test** instead of hanging the whole test binary
+/// (and with it every gate that runs it).
+///
+/// Pre-fix RED: `seed_next_inode_floor`'s `loop` has no attempt bound, so nothing is ever sent
+/// on the channel and the guard below fires.
+#[test]
+fn recovery_reaches_a_result_over_a_permanently_conflicting_counter() {
+    /// Long enough that a slow host never trips it, short enough that the red leg is a test
+    /// failure rather than a stalled suite. The bounded loop answers in microseconds.
+    const REACH_A_RESULT_WITHIN: Duration = Duration::from_secs(15);
+    /// The production bound is `SEED_FLOOR_ATTEMPTS` (8, `crates/server/src/cli.rs`), which is
+    /// crate-private; what this target can bind is that the loop retried at all and that its
+    /// attempts are a small constant rather than a function of contention.
+    const PLAUSIBLE_ATTEMPTS: std::ops::RangeInclusive<usize> = 2..=64;
+
+    let dir = tempfile::tempdir().expect("temp dir");
+    let db = dir.path().join("meta.redb");
+    let frags = dir.path().join("frags");
+
+    // The legacy shape again: committed objects, no counter — so the seed has real work to do
+    // (an already-satisfied floor would return before ever committing) and the walk's own floor
+    // is genuine.
+    with_gateway(&db, &frags, |g| {
+        pollster::block_on(g.put_object("bucket/a", b"first")).expect("PUT A");
+        pollster::block_on(g.put_object("bucket/b", b"second")).expect("PUT B");
+    });
+    {
+        let meta = RedbMetadataStore::open(&db).expect("redb reopen to strip the counter");
+        assert_eq!(
+            pollster::block_on(meta.commit(WriteBatch::new().delete(NEXT_INODE_KEY.to_vec())))
+                .expect("strip meta:next_inode to model a legacy store"),
+            CommitOutcome::Committed,
+        );
+    }
+
+    let refused = Arc::new(AtomicUsize::new(0));
+    let (tx, rx) = std::sync::mpsc::channel();
+    let (db_path, frags_path): (PathBuf, PathBuf) = (db.clone(), frags.clone());
+    let counted = Arc::clone(&refused);
+    let recovering = std::thread::spawn(move || {
+        let gateway = Gateway::new(
+            ConflictingCounterStore {
+                inner: RedbMetadataStore::open(&db_path).expect("redb"),
+                refused: counted,
+            },
+            FsChunkStore::open(&frags_path).expect("fs chunk store"),
+            MemCoordination::new(),
+        );
+        let outcome = pollster::block_on(gateway.recover()).map_err(|err| err.to_string());
+        let _ = tx.send(outcome);
+    });
+
+    let outcome = rx.recv_timeout(REACH_A_RESULT_WITHIN).unwrap_or_else(|_| {
+        panic!(
+            "Gateway::recover() must reach a result within {REACH_A_RESULT_WITHIN:?} over a \
+             counter whose compare-and-set always loses: an unbounded retry leaves the gateway \
+             starting forever, which costs every healthy object its availability exactly as a \
+             refusal does (issue #652). Conflicts served so far: {}",
+            refused.load(Ordering::SeqCst),
+        )
+    });
+    let message = outcome.expect_err(
+        "and the result must be an Err: nothing was written, so reporting success would tell the \
+         composition root the allocator is seeded when it is not",
+    );
+    assert!(
+        message.contains("conflict"),
+        "the refusal must say the counter is contended, so an operator retries the startup \
+         rather than hunting a corrupt record: {message}",
+    );
+    let attempts = refused.load(Ordering::SeqCst);
+    assert!(
+        PLAUSIBLE_ATTEMPTS.contains(&attempts),
+        "the seed must retry (a single attempt would fail an ordinary burst of allocations) and \
+         must retry a bounded number of times — {attempts} attempts is outside {:?}",
+        PLAUSIBLE_ATTEMPTS,
+    );
+    recovering
+        .join()
+        .expect("the recovery thread must not panic");
+
+    // Nothing was rewound or half-written: the store still has no counter at all.
+    assert_eq!(
+        persisted_next_inode_raw(&db),
+        None,
+        "a seed that gave up must leave the counter exactly as it found it",
+    );
+}
+
+// --- the floor is never a wrap -----------------------------------------------------------
+
+/// **An exhausted id space fails the next allocation closed — it never wraps the allocator.**
+///
+/// Totality means a damaged `inode:18446744073709551615` record no longer stops startup; its id
+/// is real (it is the record's key, canonically spelled) and must therefore be the floor. The
+/// counter names the id to hand out *and* reserves its successor, so at the ceiling there is no
+/// successor: allocation must refuse rather than roll the persisted counter to the reserved id 0
+/// and back over ids that are still live.
+///
+/// Pre-fix RED: `recover()` is `Err` over the undecodable record, so this never reaches the
+/// allocation at all. With recovery total but `alloc_inode` unfixed (`id + 1`,
+/// `crates/server/src/cli.rs:1662` pre-fix), the PUT panics on overflow in a checked build —
+/// which is also a failure, and the point: neither answer is "the gateway keeps working".
+#[test]
+fn an_exhausted_inode_space_fails_the_next_put_closed_rather_than_wrapping_the_allocator() {
+    let dir = tempfile::tempdir().expect("temp dir");
+    let db = dir.path().join("meta.redb");
+    let frags = dir.path().join("frags");
+
+    with_gateway(&db, &frags, |g| {
+        pollster::block_on(g.put_object("bucket/healthy", b"still readable"))
+            .expect("PUT the healthy object");
+    });
+    put_raw(&db, inode_key(u64::MAX), b"not json at all");
+
+    with_gateway(&db, &frags, |g| {
+        let (outcome, _log) = recover_capturing(g);
+        outcome.expect("recover() must be Ok(()) over the damaged ceiling record (criterion 1)");
+    });
+    assert_eq!(
+        persisted_next_inode(&db),
+        Some(u64::MAX),
+        "the floor saturates at the ceiling of the id space — it is never rolled over",
+    );
+
+    with_gateway(&db, &frags, |g| {
+        let refused = pollster::block_on(g.put_object("bucket/impossible", b"no id left"));
+        assert!(
+            refused.is_err(),
+            "with the id space exhausted the PUT must fail closed, not wrap the allocator onto \
+             ids that are still live",
+        );
+        assert_eq!(
+            pollster::block_on(g.get_object("bucket/healthy"))
+                .expect("get the healthy object")
+                .as_deref(),
+            Some(&b"still readable"[..]),
+            "every committed object stays readable: an exhausted allocator is one PUT's failure, \
+             not the fleet's",
+        );
+    });
+    assert_eq!(
+        persisted_next_inode(&db),
+        Some(u64::MAX),
+        "and the refusal must leave the persisted allocator where it was — a counter rolled to \
+         the reserved id 0 would re-mint every id in the store",
+    );
+}
+
+// --- the floor is a starting point, and a low one is never a re-mint ----------------------
+
+/// **An `inode:` record a peer commits behind the walk's cursor is never re-minted.**
+///
+/// The walk pages the `inode:` namespace, and `scan_page` promises no snapshot: a key inserted
+/// *before* the cursor after it passed may be missed, and "no snapshot isolation is required of
+/// any backend" (`crates/traits/src/lib.rs:1058-1066`). Inode keys are decimal text, so key
+/// order is not id order — `inode:10` sorts before `inode:2` — and a legacy peer still
+/// allocating from its own in-memory counter during a rolling upgrade therefore writes *behind*
+/// the cursor as a matter of course. Recovery then seeds the persisted allocator **below a live
+/// id**, and no re-walk fixes it: that peer never reads this counter, so it keeps allocating
+/// after any walk ends.
+///
+/// What must hold is the property the floor exists for, not the floor: the allocator must never
+/// hand out an id an `inode:` record already holds. `cli::alloc_inode` guards each id with
+/// `require_absent(inode:<id>)` in the very commit that reserves it, so the store decides
+/// "free" atomically and a low floor costs a compare-and-set instead of a live object.
+///
+/// The fixture makes the miss real rather than assumed: five committed objects (ids 1–5), a
+/// sixth object at id 10 whose own records are lifted out and re-committed by the store double
+/// *after* the walk's first page, and no `meta:next_inode` — the legacy shape recovery exists
+/// for. The floor is asserted to be 6, i.e. the walk genuinely missed the peer's row, and the
+/// PUTs that follow have to climb over it.
+///
+/// Pre-fix RED: `alloc_inode` reserved the counter's id with no guard on the id itself
+/// (`crates/server/src/cli.rs:1802-1806` pre-fix), so the fifth PUT is handed inode 10 — the
+/// live object's — and `metadata::create`'s own `require_absent(inode:10)`
+/// (`crates/core/src/metadata.rs:1571-1573`) turns it into a `Conflict`: the PUT fails. On the
+/// cluster path the same id would already have overwritten that object's fragments, since
+/// `chunk_id_minter` derives the chunk ids from the inode id and the fragments are written
+/// before the metadata commit that catches the collision.
+#[test]
+fn an_inode_record_committed_behind_the_walk_cursor_is_never_re_minted() {
+    /// The peer's inode id: numerically above every other id in the store, and
+    /// byte-lexicographically **below** the cursor the walk's first page ends on (`inode:2`).
+    const PEER_ID: u64 = 10;
+    const PEER_BYTES: &[u8] = b"the peer's object";
+    /// Enough new-key PUTs after recovery to walk the seeded floor (6) up to the peer's id.
+    const PUTS_AFTER_RECOVERY: u64 = 5;
+
+    let dir = tempfile::tempdir().expect("temp dir");
+    let db = dir.path().join("meta.redb");
+    let frags = dir.path().join("frags");
+
+    // Five committed objects — ids 1..=5, so the walk's own maximum is 5.
+    with_gateway(&db, &frags, |g| {
+        for n in 1..=5 {
+            pollster::block_on(g.put_object(&format!("bucket/o{n}"), b"committed"))
+                .expect("PUT the pre-existing objects");
+        }
+    });
+
+    // The peer's object, written by the production path so its records are the real thing:
+    // force the allocator to PEER_ID, PUT, then lift the rows that PUT added back out. Its
+    // fragments stay on the chunk store — what has not happened yet is the metadata commit.
+    put_raw(&db, NEXT_INODE_KEY.to_vec(), PEER_ID.to_string().as_bytes());
+    let before: BTreeSet<Vec<u8>> = all_rows(&db).into_iter().map(|(key, _)| key).collect();
+    with_gateway(&db, &frags, |g| {
+        pollster::block_on(g.put_object("bucket/peer", PEER_BYTES)).expect("PUT the peer's object");
+    });
+    let peer_rows: Rows = all_rows(&db)
+        .into_iter()
+        .filter(|(key, _)| !before.contains(key))
+        .collect();
+    let peer_record = peer_rows
+        .iter()
+        .find(|(key, _)| key == &inode_key(PEER_ID))
+        .map(|(_, value)| value.clone())
+        .expect("the peer's PUT wrote inode:10");
+    delete_rows(&db, peer_rows.iter().map(|(key, _)| key.clone()));
+    // ... and the legacy shape recovery exists for: no persisted counter at all.
+    delete_rows(&db, std::iter::once(NEXT_INODE_KEY.to_vec()));
+
+    // Recovery, with the peer committing behind the cursor mid-walk.
+    let gateway = Gateway::new(
+        WriterBehindCursorStore {
+            inner: RedbMetadataStore::open(&db).expect("redb"),
+            behind: Mutex::new(Some(peer_rows)),
+            reads: AtomicUsize::new(0),
+        },
+        FsChunkStore::open(&frags).expect("fs chunk store"),
+        MemCoordination::new(),
+    );
+    pollster::block_on(gateway.recover()).expect("recover() must be Ok(()) over a written store");
+    drop(gateway);
+
+    // The fault is IN the fixture, not curated out of it: the walk really did miss the peer's
+    // row, so the seeded floor really is below a live id. Without this the assertions below
+    // would pass over a store where nothing was ever at risk.
+    assert_eq!(
+        persisted_next_inode(&db),
+        Some(6),
+        "the fixture must reproduce the miss: a floor of 11 would mean the peer's row was seen \
+         after all and this test binds nothing",
+    );
+    assert!(
+        pollster::block_on(async {
+            RedbMetadataStore::open(&db)
+                .expect("redb")
+                .get(&inode_key(PEER_ID))
+                .await
+        })
+        .expect("get the peer's record")
+        .is_some(),
+        "the peer's record must be committed and live when the allocations below run",
+    );
+
+    // Now climb: the fifth PUT is handed the peer's id by the counter and must not take it.
+    let (_, log) = capturing(|| {
+        with_gateway(&db, &frags, |g| {
+            for n in 0..PUTS_AFTER_RECOVERY {
+                pollster::block_on(g.put_object(&format!("bucket/after{n}"), b"new object"))
+                    .expect(
+                    "every new-key PUT after recovery must commit: an id a live `inode:` record \
+                     already holds must be stepped past, never handed out (issue #652)",
+                );
+            }
+        });
+    });
+
+    assert_eq!(
+        persisted_next_inode(&db),
+        Some(PEER_ID + 2),
+        "the allocator handed out 6,7,8,9 and then stepped over the peer's id to 11 — a counter \
+         at 11 would mean it handed out the peer's id itself",
+    );
+    assert!(
+        attributed(&log, "next-inode-counter-on-live-id", "meta:next_inode"),
+        "standing on a live id is the operator's signal that the startup floor was seeded below \
+         one; stepping past it in silence is the silent skip a recovery path may never do — \
+         captured log: {log}",
+    );
+
+    // The peer's object is untouched and still readable through the production read path.
+    with_gateway(&db, &frags, |g| {
+        assert_eq!(
+            pollster::block_on(g.get_object("bucket/peer"))
+                .expect("get the peer's object")
+                .as_deref(),
+            Some(PEER_BYTES),
+            "the object whose id the allocator was handed must still read back byte-identically",
+        );
+    });
+    assert_eq!(
+        pollster::block_on(async {
+            RedbMetadataStore::open(&db)
+                .expect("redb")
+                .get(&inode_key(PEER_ID))
+                .await
+        })
+        .expect("get the peer's record"),
+        Some(peer_record),
+        "and its inode record must be the peer's own bytes — not a later object's",
+    );
+}
+
+/// **And the id it does not re-mint is a live object's fragments, not just a conflict.**
+///
+/// The test above binds the property through the gateway path, where a re-minted inode costs
+/// the PUT (`metadata::create` is `require_absent` on the inode key) and nothing else — gateway
+/// chunk ids are coordination-free and share nothing with the object that already holds the id
+/// (ADR-0019, `crates/server/src/lib.rs:251-263`). The **cluster** path is where the same
+/// re-mint is C-1 data loss: it derives the chunk ids *from* the inode id — `(inode << 64) |
+/// seq`, `cli::chunk_id_minter` (`crates/server/src/cli.rs:1959-1966`) — and writes the
+/// fragments **before** the metadata commit that would catch the collision
+/// (`cli::cluster_store_put`, `crates/server/src/cli.rs:1849-1870`). An id handed out while an
+/// `inode:` record still holds it therefore overwrites that object's fragments on the shared
+/// chunk store, and the failed commit afterwards restores nothing.
+///
+/// The counter is placed on the live id directly here: *how* a floor ends up below a live id is
+/// the test above (a peer committing behind the paged walk's cursor), and repeating that
+/// machinery would only make the same point twice.
+///
+/// Pre-fix RED: `alloc_inode` hands out inode 10, `chunk_id_minter(10)` re-derives the peer's
+/// own chunk ids, and the peer's object no longer reads back — the read either serves the new
+/// object's bytes or fails its fragment checksums.
+#[test]
+fn a_re_minted_inode_id_would_overwrite_the_live_objects_fragments_on_the_cluster_path() {
+    const PEER_ID: u64 = 10;
+    const PEER_BYTES: &[u8] = b"the peer object's bytes, which must survive";
+    const NEW_BYTES: &[u8] = b"a different object entirely, written much later on";
+    /// Small enough that both objects span several chunks, so a re-mint collides on more than
+    /// the first fragment.
+    const CHUNK: usize = 16;
+
+    let dir = tempfile::tempdir().expect("temp dir");
+    let db = dir.path().join("meta.redb");
+    let frags = dir.path().join("frags");
+
+    // The peer's object, stored through the production cluster path so its chunk ids really are
+    // the ones that path derives from inode 10.
+    put_raw(&db, NEXT_INODE_KEY.to_vec(), PEER_ID.to_string().as_bytes());
+    assert_eq!(
+        cluster_put(&db, &frags, "bucket/peer", PEER_BYTES, CHUNK),
+        CommitOutcome::Committed,
+        "the peer's object must commit, or there is no live id to protect",
+    );
+
+    // The under-seeded floor: the allocator stands on an id a live record already holds.
+    put_raw(&db, NEXT_INODE_KEY.to_vec(), PEER_ID.to_string().as_bytes());
+
+    // Held rather than asserted here: the *data* is the finding, and a commit outcome asserted
+    // first would report the collision instead of the loss it causes.
+    let outcome = cluster_put(&db, &frags, "bucket/new", NEW_BYTES, CHUNK);
+
+    with_gateway(&db, &frags, |g| {
+        let served = pollster::block_on(g.get_object("bucket/peer"));
+        match &served {
+            Ok(Some(bytes)) => assert_eq!(
+                bytes.as_slice(),
+                PEER_BYTES,
+                "the peer's object must read back byte-identically",
+            ),
+            other => panic!(
+                "the peer's object must still read back byte-identically: a re-minted inode id \
+                 makes the cluster path derive that object's OWN chunk ids and overwrite its \
+                 fragments before any commit can catch it (issue #652, C-1) — got {other:?}",
+            ),
+        }
+        assert_eq!(
+            pollster::block_on(g.get_object("bucket/new"))
+                .expect("get the new object")
+                .as_deref(),
+            Some(NEW_BYTES),
+            "and the new object is stored under its own, non-colliding chunk ids",
+        );
+    });
+    assert_eq!(
+        outcome,
