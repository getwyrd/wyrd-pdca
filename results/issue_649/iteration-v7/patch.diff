+/// Resolve a committed inode's chunk map to its ordered chunk list — the one call
+/// every consumer of `.chunk_map` makes (proposal 0016 decision 7(e), `0016:2393-2415`).
+///
+/// A flat map resolves to a borrow of the record and reads nothing. A segmented map
+/// reads the bounded range `seg:<nonce>:<epoch>:` ([`read_group_range`]) and nothing
+/// else. `root_key` is the inode's own key ([`inode_key`]): the resolver needs the
+/// root's *identity*, not just its decoded value, so an absent or malformed segment can
+/// be settled by re-reading it (decision 7(h)) — an API taking only a store and an
+/// already-decoded record could not tell a concurrent retirement from corruption.
+pub async fn resolve_chunk_map<'a>(
+    store: &dyn MetadataStore,
+    root_key: &[u8],
+    record: &'a InodeRecord,
+) -> Result<MapResolution<'a>> {
+    let map = match &record.chunk_map {
+        ChunkMap::Flat(chunks) => return Ok(MapResolution::Resolved(Cow::Borrowed(chunks))),
+        ChunkMap::Segmented(map) => map,
+    };
+    let Some(segments) = read_segments(store, root_key, map).await? else {
+        return Ok(MapResolution::Retired);
+    };
+    let mut chunks = Vec::new();
+    for (_index, record) in segments {
+        chunks.extend(record.into_chunks());
+    }
+    Ok(MapResolution::Resolved(Cow::Owned(chunks)))
+}
+
+/// How many times [`resolve_live_chunk_map`] / [`resolve_current_chunk_map`] re-read
+/// the root before giving up. Each iteration means the generation just read was
+/// retired *again* under it; past this many restarts the honest answer is a typed
+/// error, never "this object owns no bytes" (decision 7(h)).
+pub const MAX_RESOLVE_RESTARTS: usize = 3;
+
+/// A chunk map resolved against the root the store holds **now**.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct CurrentChunkMap {
+    /// The live root the chunks were resolved from.
+    pub record: InodeRecord,
+    /// That generation's ordered chunk list.
+    pub chunks: Vec<ChunkRef>,
+}
+
+/// Resolve the chunk map of the root the store holds **now**, reading the root itself
+/// — for a caller whose own record may already be stale (a maintenance pass's scan
+/// snapshot, or a read restarting after [`resolve_chunk_map`] answered
+/// [`MapResolution::Retired`]).
+///
+/// `Ok(None)` means there is no **live committed generation**: the root is absent
+/// (deleted) or not `Committed` — the same condition every consumer already treats as
+/// "no such object". A generation retired mid-resolve is retried up to
+/// [`MAX_RESOLVE_RESTARTS`] times, then fails closed.
+pub async fn resolve_current_chunk_map(
+    store: &dyn MetadataStore,
+    root_key: &[u8],
+) -> Result<Option<CurrentChunkMap>> {
+    for _ in 0..MAX_RESOLVE_RESTARTS {
+        let Some(bytes) = store.get(root_key).await? else {
+            return Ok(None);
+        };
+        let record: InodeRecord = decode(&bytes)?;
+        if record.state != InodeState::Committed {
+            return Ok(None);
+        }
+        if let MapResolution::Resolved(chunks) = resolve_chunk_map(store, root_key, &record).await?
+        {
+            let chunks = chunks.into_owned();
+            return Ok(Some(CurrentChunkMap { record, chunks }));
+        }
+    }
+    Err(ChunkMapError::MapResolutionUnstable {
+        attempts: MAX_RESOLVE_RESTARTS,
+    }
+    .into())
+}
+
+/// A chunk map resolved against the **live** root: the caller's own snapshot if it was
+/// still current, or the generation that replaced it.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct LiveChunkMap<'a> {
+    /// The root the chunks came from when the caller's own `record` was superseded
+    /// mid-resolve. `None` when `record` is still the live generation, in which case
+    /// `chunks` borrows from it.
+    pub restarted: Option<InodeRecord>,
+    /// The object's ordered chunk list.
+    pub chunks: Cow<'a, [ChunkRef]>,
+}
+
+/// Resolve a caller's own committed snapshot to its chunk list, restarting onto the
+/// live root if that generation was retired mid-resolve (decision 7(h)) — the entry
+/// for a consumer that just read the root itself ([`read_object`](crate::read::read_object),
+/// the gateway's streaming and ranged reads). A caller working from an older scan
+/// snapshot instead uses [`resolve_current_chunk_map`], which re-reads the root even on
+/// a clean resolve.
+///
+/// Answering "no chunks" for a retired resolution is the data loss decision 7(h) exists
+/// to prevent: a live object would then be missing from a maintenance pass's reference
+/// set, or a reader would 404 an object that never stopped existing. `Ok(None)` carries
+/// the same meaning as in [`resolve_current_chunk_map`]: no live committed generation.
+pub async fn resolve_live_chunk_map<'a>(
+    store: &dyn MetadataStore,
+    root_key: &[u8],
+    record: &'a InodeRecord,
+) -> Result<Option<LiveChunkMap<'a>>> {
+    if let MapResolution::Resolved(chunks) = resolve_chunk_map(store, root_key, record).await? {
+        return Ok(Some(LiveChunkMap {
+            restarted: None,
+            chunks,
+        }));
+    }
+    let Some(current) = resolve_current_chunk_map(store, root_key).await? else {
+        return Ok(None);
+    };
+    Ok(Some(LiveChunkMap {
+        restarted: Some(current.record),
+        chunks: Cow::Owned(current.chunks),
+    }))
+}
