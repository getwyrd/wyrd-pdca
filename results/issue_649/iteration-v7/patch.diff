diff --git a/crates/core/tests/segmented_map_resolution.rs b/crates/core/tests/segmented_map_resolution.rs
new file mode 100644
index 0000000..2ec5a88
--- /dev/null
+++ b/crates/core/tests/segmented_map_resolution.rs
@@ -0,0 +1,1067 @@
+//! The shared chunk-map resolver (issue #649, proposal 0016 decision 7(e)/(h)), proved
+//! through the **base-visible** whole-object read entries — [`read_object`] /
+//! [`read_path`] — over a segmented object seeded as raw `seg:` records plus a segmented
+//! root, **never via a committer** (this slice ships no producer): a genuine flat write
+//! (real fragments, via `wyrd_core::write`) reshaped into the segmented spelling by a raw
+//! `WriteBatch`, so `.chunk_map` is segmented before a single read touches it.
+//!
+//! RED on this slice's base (with `crates/core/src/metadata.rs`/`read.rs` reverted and
+//! `crates/custodian/src/resolve.rs` removed): a segmented root still **decodes** (#648's
+//! contribution) but every read here fails resolving it — assertion failures, not compile
+//! failures, because every imported symbol is base-visible from #648.
+//!
+//! Nothing this patch adds (`resolve_chunk_map`, `MapResolution`, the new `ChunkMapError`
+//! variants, …) is imported: criteria (2)-(3) are observed through the read path plus the
+//! instrumented store double below, never by naming the resolver.
+
+#![forbid(unsafe_code)]
+
+use std::collections::VecDeque;
+use std::sync::Mutex;
+
+use async_trait::async_trait;
+use bytes::Bytes;
+use wyrd_chunkstore_fs::FsChunkStore;
+use wyrd_core::metadata::{
+    encode, inode_key, seg_key, seg_range_prefix, ChunkMap, ChunkMapError, ChunkRef, EcScheme,
+    InodeRecord, InodeState, SegmentGroup, SegmentRecord, SegmentRef, SegmentedMap,
+    MAX_ROOT_SEGMENTS, MAX_VALUE_BYTES, SEG_PREFIX,
+};
+use wyrd_core::read::{read_object, read_path};
+use wyrd_core::write;
+use wyrd_metadata_redb::RedbMetadataStore;
+use wyrd_traits::{BoxError, CommitOutcome, MetadataStore, Result, ScanPage, WriteBatch};
+
+const ROOT: u64 = 0;
+const NOW: u64 = 1_000;
+const TTL: u64 = 5_000;
+const CHUNK: usize = 4;
+/// A 32-lowercase-hex nonce, exactly [`wyrd_core::metadata::SEG_NONCE_HEX_LEN`] chars.
+const NONCE: &str = "0123456789abcdef0123456789abcdef";
+/// A second, distinct nonce — a group that must never be touched resolving the first.
+const OTHER_NONCE: &str = "fedcba9876543210fedcba9876543210";
+
+/// Assert `err` is a **typed, resolved** refusal — never the base's blanket "nothing can
+/// resolve a segmented map yet" ([`ChunkMapError::SegmentedMapUnsupported`], the ONLY
+/// error `.chunk_map` sites raised before this patch). That variant is base-visible
+/// (#648) and named here deliberately: without this check a "the read must fail"
+/// assertion would pass equally well pre-fix (every segmented map is refused,
+/// unconditionally) and post-fix (this ONE anomaly is refused, resolved), which is not a
+/// fix-discriminating assertion. The variant an anomaly actually raises is not named —
+/// nothing this patch adds is imported — so the discriminator is "resolved AND typed AND
+/// not the blanket refusal". It also separates a refusal made **by the resolver** from
+/// one a later stage makes on its behalf: a downstream size check
+/// (`ReadError::SizeMismatch`) is not a `ChunkMapError` and fails this assertion, so a
+/// resolution that leaked an under-described map to the byte layer cannot pass as "fails
+/// closed".
+fn assert_fails_closed(case: &str, read: Result<Option<Vec<u8>>>) {
+    match read {
+        Err(err) => assert_resolved_typed_refusal(case, err),
+        Ok(read) => panic!("{case}: must fail closed; the read answered {read:?}"),
+    }
+}
+
+fn assert_resolved_typed_refusal(case: &str, err: BoxError) {
+    let typed = err.downcast_ref::<ChunkMapError>().unwrap_or_else(|| {
+        panic!("{case}: a resolve failure must surface as a typed ChunkMapError, got: {err}")
+    });
+    assert!(
+        !matches!(typed, ChunkMapError::SegmentedMapUnsupported { .. }),
+        "{case}: must be refused by the NEW resolver's own typed anomaly, not the base's \
+         blanket 'this build cannot yet resolve a segmented map' refusal: {err}"
+    );
+}
+
+fn backends() -> (RedbMetadataStore, FsChunkStore, tempfile::TempDir) {
+    let meta = RedbMetadataStore::in_memory().expect("in-memory redb");
+    let dir = tempfile::tempdir().expect("temp dir");
+    let chunks = FsChunkStore::open(dir.path()).expect("fs chunk store");
+    (meta, chunks, dir)
+}
+
+fn ids_from(base: u128) -> impl FnMut() -> u128 {
+    let mut n = base;
+    move || {
+        n += 1;
+        n
+    }
+}
+
+/// `n` deterministic bytes from `base` — two payloads built with different `base` values
+/// never share a byte, so *which* generation answered a read is decidable from the bytes.
+fn payload(n: u32, base: u32) -> Vec<u8> {
+    (0..n).map(|i| ((i + base) % 251) as u8).collect()
+}
+
+/// Plan, fan out and commit a genuine **flat** object at `inode_id`/`name` — real
+/// fragments on disk, via the ordinary single-shot write path, exactly as every
+/// pre-existing flat object is built. Returns the plan so its `chunk_refs()`/`size` are
+/// in hand without reading the record back.
+async fn write_flat(
+    meta: &RedbMetadataStore,
+    chunks: &FsChunkStore,
+    inode_id: u64,
+    name: &str,
+    data: &[u8],
+    id_base: u128,
+) -> write::WritePlan {
+    let mut next = ids_from(id_base);
+    let plan = write::plan_write(data, CHUNK, EcScheme::None, &mut next).expect("plan");
+    write::intent(meta, &plan, NOW + TTL).await.expect("intent");
+    write::write_fragments(chunks, &plan)
+        .await
+        .expect("fan out");
+    let outcome = write::commit_create(meta, ROOT, name, inode_id, &plan, NOW)
+        .await
+        .expect("commit");
+    assert_eq!(outcome, CommitOutcome::Committed);
+    write::release(meta, &plan).await.expect("release");
+    plan
+}
+
+/// The **correct** `n`-segment spelling of `plan`: the root's segment table and the
+/// records that satisfy it. Every bent fixture below starts from this and changes exactly
+/// ONE thing, so what a case differs by *is* the property it binds.
+fn split(plan: &write::WritePlan, n: usize) -> (Vec<SegmentRef>, Vec<SegmentRecord>) {
+    let chunks = plan.chunk_refs();
+    assert!(n >= 2 && n <= chunks.len(), "fixture needs a real split");
+    let (mut refs, mut records, mut offset) = (Vec::new(), Vec::new(), 0u64);
+    for (index, part) in chunks.chunks(chunks.len().div_ceil(n)).enumerate() {
+        let record = SegmentRecord::new(part.to_vec(), offset).expect("segment record");
+        refs.push(sref(index as u32, offset, record.byte_len()));
+        offset += record.byte_len();
+        records.push(record);
+    }
+    (refs, records)
+}
+
+fn sref(index: u32, byte_offset: u64, byte_len: u64) -> SegmentRef {
+    SegmentRef {
+        index,
+        byte_offset,
+        byte_len,
+    }
+}
+
+/// One raw `seg:` row: the canonical key for `index` and the encoded record.
+fn row(group: &SegmentGroup, index: u32, record: &SegmentRecord) -> (Vec<u8>, Bytes) {
+    (
+        seg_key(group, index).expect("addressable index"),
+        encode(record),
+    )
+}
+
+/// A key under a group's own range that the `seg:` grammar refuses — six non-digit
+/// characters where the zero-padded index belongs. Any writer can leave one, so a
+/// resolver meets it as an ordinary range anomaly, not as an impossibility.
+fn malformed_row(group: &SegmentGroup) -> (Vec<u8>, Bytes) {
+    let mut key = seg_range_prefix(group);
+    key.extend_from_slice(b"abcdef");
+    (key, Bytes::from_static(b"{}"))
+}
+
+/// Put one raw key/value straight into the store — a row no root names.
+async fn seed_row(meta: &RedbMetadataStore, key: Vec<u8>, value: Bytes) {
+    let outcome = meta.commit(WriteBatch::new().put(key, value)).await;
+    assert_eq!(outcome.expect("seed a row"), CommitOutcome::Committed);
+}
+
+/// A committed root's encoded bytes — the only inode shape any fixture here publishes.
+fn committed_root(size: u64, chunk_map: ChunkMap, version: u64) -> Bytes {
+    encode(&InodeRecord {
+        size,
+        chunk_map,
+        state: InodeState::Committed,
+        version,
+        ..Default::default()
+    })
+}
+
+/// The raw batch publishing a segmented root at `inode_id` over `refs`, plus **exactly**
+/// the `rows` given — raw keys and values, never a committer, so a fixture can omit a
+/// named segment, corrupt one, key one to another group, or leave one the table does not
+/// name. The root's `size` is the table's own span, so the object's size is never the
+/// thing under test.
+fn root_batch(
+    inode_id: u64,
+    group: &SegmentGroup,
+    refs: Vec<SegmentRef>,
+    rows: Rows,
+    version: u64,
+) -> WriteBatch {
+    let table = SegmentedMap::new(group.clone(), refs).expect("segment table");
+    let root = committed_root(table.span(), ChunkMap::Segmented(table), version);
+    let mut batch = WriteBatch::new().put(inode_key(inode_id), root);
+    for (key, value) in rows {
+        batch = batch.put(key, value);
+    }
+    batch
+}
+
+/// Commit [`root_batch`] — the seeding form every fixture below starts from.
+async fn seed(
+    meta: &RedbMetadataStore,
+    inode_id: u64,
+    group: &SegmentGroup,
+    refs: Vec<SegmentRef>,
+    rows: Rows,
+) {
+    let batch = root_batch(inode_id, group, refs, rows, 1);
+    let outcome = meta.commit(batch).await.expect("seed the segmented root");
+    assert_eq!(outcome, CommitOutcome::Committed);
+}
+
+/// Publish `plan`'s chunks at `inode_id` as a **correct** `n`-segment generation of
+/// `group`: the root's table and every record that satisfies it.
+async fn seed_segmented(
+    meta: &RedbMetadataStore,
+    inode_id: u64,
+    plan: &write::WritePlan,
+    group: &SegmentGroup,
+    n: usize,
+) {
+    let (refs, records) = split(plan, n);
+    let rows = rows_of(group, &records);
+    seed(meta, inode_id, group, refs, rows).await;
+}
+
+fn rows_of(group: &SegmentGroup, records: &[SegmentRecord]) -> Rows {
+    records
+        .iter()
+        .enumerate()
+        .map(|(index, record)| row(group, index as u32, record))
+        .collect()
+}
+
+/// A pending mutation publishing a **complete** further segmented generation of
+/// `inode_id`: a new epoch of [`NONCE`], `plan`'s own chunks, and the `seg:` rows that
+/// satisfy the table — all in ONE batch, exactly as a publisher must (the root moves
+/// last, `0016:2452-2462`). Every generation resolves perfectly on its own and carries
+/// the SAME bytes as the one it replaced, so nothing about the data can explain a
+/// refusal: the only thing that changes across them is the generation the root names.
+fn segmented_generation(inode_id: u64, plan: &write::WritePlan, epoch: u64) -> WriteBatch {
+    let (refs, records) = split(plan, 2);
+    let group = SegmentGroup::new(NONCE, epoch).expect("group");
+    root_batch(inode_id, &group, refs, rows_of(&group, &records), epoch)
+}
+
+/// A brand-new **flat** generation for `inode_id` — fragments already on disk, root not
+/// yet published — and the batch that publishes it. The pending batch is what a
+/// mid-resolve double applies, modelling the overwrite the resolve-retry rule is about.
+async fn pending_flat(
+    chunks: &FsChunkStore,
+    inode_id: u64,
+    data: &[u8],
+    id_base: u128,
+) -> WriteBatch {
+    let mut next = ids_from(id_base);
+    let plan = write::plan_write(data, CHUNK, EcScheme::None, &mut next).expect("plan");
+    write::write_fragments(chunks, &plan)
+        .await
+        .expect("fan out");
+    let root = committed_root(plan.size, plan.chunk_refs().into(), 2);
+    WriteBatch::new().put(inode_key(inode_id), root)
+}
+
+// ---------------------------------------------------------------------------
+// (1) Byte-identical reads.
+// ---------------------------------------------------------------------------
+
+#[tokio::test]
+async fn segmented_object_reads_byte_identical_to_the_flat_equivalent() {
+    let (meta, chunks, _dir) = backends();
+    let data = payload(48, 0);
+
+    let plan = write_flat(&meta, &chunks, 1, "segmented", &data, 0x100).await;
+    seed_segmented(&meta, 1, &plan, &SegmentGroup::new(NONCE, 1).unwrap(), 2).await;
+    // The byte-for-byte control: the SAME payload, published and left flat.
+    write_flat(&meta, &chunks, 2, "flat", &data, 0x200).await;
+
+    let segmented = read_object(&meta, &chunks, 1).await.unwrap();
+    let flat = read_object(&meta, &chunks, 2).await.unwrap();
+    assert_eq!(segmented.as_deref(), Some(&data[..]), "the source data");
+    assert_eq!(segmented, flat, "segmented and flat agree byte-for-byte");
+    // `read_path` (the name-resolving entry) agrees too.
+    let by_name = read_path(&meta, &chunks, ROOT, "segmented").await.unwrap();
+    assert_eq!(by_name, Some(data), "read_path resolves the same bytes");
+}
+
+// ---------------------------------------------------------------------------
+// (2) The resolver is bounded — an instrumented double records every key/prefix.
+// ---------------------------------------------------------------------------
+
+/// When a [`Quirk::Supersede`] double applies its pending mutation — the two windows a
+/// resolve can be retired in (`0016:2452-2462`: the root always moves first).
+enum When {
+    /// The moment the FIRST root read returns: the reader holds the old root, the store
+    /// already holds the new one. This is the only window a resolve refused *before* any
+    /// range read ever has, so it is how an over-ceiling root's retirement arm is reached.
+    RootRead,
+    /// At the FIRST `seg:` page: the root moves on (or is deleted) while this resolve is
+    /// in flight.
+    Page,
+}
+
+/// What the double does to the group's **own range read** — the moment every
+/// resolve-retry arm turns on.
+enum Quirk {
+    /// Nothing: a faithful pass-through that only records.
+    None,
+    /// Apply a pending mutation at [`When`].
+    Supersede(When, Mutex<Option<WriteBatch>>),
+    /// Retire the reader's generation **again on every restart**: the first page of each
+    /// distinct `seg:` range publishes the next complete generation from the queue, so a
+    /// resolve that restarts onto the live root finds THAT generation retired under it
+    /// too — an object republished faster than any reader can resolve it, the only
+    /// interleaving that reaches the reader's restart budget at all.
+    ///
+    /// Retiring once per *range* rather than per *page* keeps the fixture independent of
+    /// how many pages a group takes, and the queue is finite: when it runs dry the store
+    /// falls quiet, so the same fixture resolves — which is what separates "the race"
+    /// from "records this store could not read".
+    SupersedeEachGeneration {
+        /// One further generation per resolve attempt the reader may make.
+        pending: Mutex<VecDeque<WriteBatch>>,
+        /// The `seg:` ranges already retired on, so one generation is retired once
+        /// however many pages its range takes.
+        opened: Mutex<Vec<Vec<u8>>>,
+    },
+    /// Splice one extra row into the page — a row keyed to another generation.
+    Smuggle(Vec<u8>, Bytes),
+    /// Hand the page back in REVERSED order, violating the paging contract's
+    /// byte-lexicographic order clause.
+    Reverse,
+    /// Serve at most this many rows per `seg:` page, whatever limit was asked for — a
+    /// store whose own effective page cap is below the resolver's request, which
+    /// `scan_page` explicitly permits (`items.len() <= min(limit, the store's effective
+    /// cap)`, `crates/traits/src/lib.rs:1069-1071`). The truncated page carries the
+    /// contract's cursor: `Some(last key returned)` (clause 3, `:1054-1056`).
+    PageCap(usize),
+}
+
+/// How many `seg:` pages [`Quirk::PageCap`] serves before it refuses. A resolver that
+/// dropped the continuation cursor and re-anchored each page at the prefix would page
+/// forever; this makes that a loud failure instead of a hang.
+const PAGE_WALK_GUARD: usize = 16;
+
+/// How many root `get`s one clean segmented resolve is allowed to cost, whatever the
+/// root's table names: the read's own root read, plus the ONE re-read that settles
+/// whether the generation just resolved is still the live one. Pinned as a constant, and
+/// asserted on both a two-segment object and a 512-segment one read over three pages,
+/// because "every get is the root" alone would still let a resolver re-ask the root once
+/// per segment (or per page) — work the record sets, not the reader.
+const CLEAN_RESOLVE_ROOT_GETS: usize = 2;
+
+/// What a read costs whose object is retired under **every** restart: the reader's first
+/// resolve plus its whole restart budget, each attempt costing exactly
+/// [`CLEAN_RESOLVE_ROOT_GETS`] root reads. A **literal**, deliberately, and not a formula
+/// over a constant this patch exports: the restart budget is the reader's own policy —
+/// the record's churn may not buy more re-reads — so pinning the number here is what
+/// turns a widened, narrowed, or removed budget into a failure instead of a silently
+/// rescaled expectation.
+const EXHAUSTED_RESOLVE_ROOT_GETS: usize = 8;
+
+/// How many further generations the churn double queues: one per resolve attempt the
+/// reader is allowed. The queue runs dry **immediately** after the last one, so a reader
+/// whose budget were wider would resolve the next generation cleanly and answer `Ok` —
+/// which is how [`a_generation_retired_under_every_restart_fails_closed_and_terminates`]
+/// binds the budget from above as well as below.
+const CHURN_GENERATIONS: usize = EXHAUSTED_RESOLVE_ROOT_GETS / CLEAN_RESOLVE_ROOT_GETS;
+
+/// The one [`MetadataStore`] double these tests observe the resolver through: a **real**
+/// redb backend, every access recorded — each `get` key, each unpaged `scan` prefix, each
+/// `scan_page` prefix with the cursor it was anchored after and its page limit — and at
+/// most one [`Quirk`] applied to the `seg:` range read. Nothing else is intercepted: the
+/// resolver under test is always the production one, reached only through
+/// `read_object`/`read_path`.
+///
+/// Recording all three channels is the point: a resolver that reached another
+/// generation's records by a direct `get`, or that walked the whole `seg:` namespace with
+/// one unpaged `scan`, would be invisible to a double that only watched paged prefixes.
+struct Probe {
+    inner: RedbMetadataStore,
+    quirk: Quirk,
+    gets: Mutex<Vec<Vec<u8>>>,
+    scans: Mutex<Vec<Vec<u8>>>,
+    /// Every paged read: its prefix, the cursor it was anchored after, and its limit. The
+    /// cursor is recorded because a group wider than one page is resolved *only* by
+    /// carrying it forward — the walk is as much part of the bound as the prefix is.
+    pages: Mutex<Vec<Page>>,
+}
+
+/// One recorded `scan_page` call: `(prefix, after, limit)`.
+type Page = (Vec<u8>, Option<Vec<u8>>, usize);
+
+impl Probe {
+    fn new(inner: RedbMetadataStore, quirk: Quirk) -> Self {
+        Self {
+            inner,
+            quirk,
+            gets: Mutex::new(Vec::new()),
+            scans: Mutex::new(Vec::new()),
+            pages: Mutex::new(Vec::new()),
+        }
+    }
+
+    /// A double that applies `pending` at `when` — the mid-resolve retirement race.
+    fn superseding(inner: RedbMetadataStore, when: When, pending: WriteBatch) -> Self {
+        Self::new(inner, Quirk::Supersede(when, Mutex::new(Some(pending))))
+    }
+
+    /// A double that retires the reader's generation at every new `seg:` range it opens
+    /// ([`Quirk::SupersedeEachGeneration`]).
+    fn superseding_each_generation(
+        inner: RedbMetadataStore,
+        pending: impl IntoIterator<Item = WriteBatch>,
+    ) -> Self {
+        Self::new(
+            inner,
+            Quirk::SupersedeEachGeneration {
+                pending: Mutex::new(pending.into_iter().collect()),
+                opened: Mutex::new(Vec::new()),
+            },
+        )
+    }
+
+    /// Assert the whole recorded **`get` channel** of the read just driven: every key
+    /// this store was asked for *by key* is `inode_id`'s own root, and there was at least
+    /// one. Hands back how many, so a caller can also pin that the count is set by the
+    /// READER and not by the root's table.
+    ///
+    /// A whitelist, not a blacklist, and that is the whole point of it. Criterion (2) is
+    /// "the root **plus only** the range `seg:<nonce>:<epoch>:`", so any *other* metadata
+    /// key a resolve consults — a sibling object's root, a directory entry, an index, a
+    /// probe of a neighbouring inode — is out of budget even though it is not a `seg:`
+    /// key and touches no second group. Forbidding only [`SEG_PREFIX`] gets would let
+    /// every one of those through unseen.
+    fn assert_gets_only_the_root_of(&self, inode_id: u64) -> usize {
+        let root = inode_key(inode_id);
+        let gets = self.gets.lock().unwrap();
+        assert!(!gets.is_empty(), "a read must read that object's own root");
+        let stray = gets.iter().find(|key| **key != root);
+        let stray = stray.map(|key| String::from_utf8_lossy(key));
+        assert!(stray.is_none(), "a resolve also fetched {stray:?}");
+        gets.len()
+    }
+
+    /// [`Self::assert_gets_only_the_root_of`], pinning the count too: the reader's own
+    /// constant, never a function of how many segments the root's table names.
+    fn assert_root_gets(&self, inode_id: u64, expected: usize) {
+        let gets = self.assert_gets_only_the_root_of(inode_id);
+        assert_eq!(gets, expected, "the root-read count is the READER's");
+    }
+
+    /// Assert no unpaged `scan` was taken: it is complete-or-fail-loud at `SCAN_CAP`
+    /// (`crates/traits/src/lib.rs:286`), so a damaged range would cost the caller the
+    /// whole namespace or the whole call.
+    fn assert_never_scanned_unpaged(&self) {
+        let scans = self.scans.lock().unwrap();
+        assert!(scans.is_empty(), "an unpaged scan was taken: {scans:?}");
+    }
+
+    /// Assert the resolve spent **no** range read at all — the shape a root refused on
+    /// its own claim must have, whether that refusal is a fault or a retirement.
+    fn assert_no_range_read(&self) {
+        let pages = self.pages.lock().unwrap();
+        assert!(pages.is_empty(), "a range was read anyway: {pages:?}");
+    }
+
+    /// Every key or prefix this store was asked about, in one list — the whole access
+    /// footprint of a read, whichever channel it went through. A resolver that reached
+    /// another generation by a direct `get`, or with one unpaged `scan`, is visible here
+    /// even though neither is a paged prefix.
+    fn footprint(&self) -> Vec<Vec<u8>> {
+        let pages = self.pages.lock().unwrap();
+        let mut all = self.gets.lock().unwrap().clone();
+        all.extend(self.scans.lock().unwrap().iter().cloned());
+        all.extend(pages.iter().map(|(prefix, _, _)| prefix.clone()));
+        all
+    }
+
+    /// The cursor each recorded page was anchored after, in order — the walk itself.
+    fn page_cursors(&self) -> Vec<Option<Vec<u8>>> {
+        let pages = self.pages.lock().unwrap();
+        pages.iter().map(|(_, after, _)| after.clone()).collect()
+    }
+
+    async fn apply(&self, batch: WriteBatch) {
+        assert_eq!(
+            self.inner.commit(batch).await.unwrap(),
+            CommitOutcome::Committed
+        );
+    }
+}
+
+#[async_trait]
+impl MetadataStore for Probe {
+    async fn get(&self, key: &[u8]) -> Result<Option<Bytes>> {
+        self.gets.lock().unwrap().push(key.to_vec());
+        let value = self.inner.get(key).await;
+        // Taken out of the mutex BEFORE the await: the guard never crosses it. The read
+        // already has the OLD bytes in hand when the overwrite lands, which is exactly the
+        // reader's window. It fires on the first `get` of any key, which for every read
+        // entry driven here is the object's own root.
+        let pending = match &self.quirk {
+            Quirk::Supersede(When::RootRead, pending) => pending.lock().unwrap().take(),
+            _ => None,
+        };
+        if let Some(batch) = pending {
+            self.apply(batch).await;
+        }
+        value
+    }
+
+    async fn scan(&self, prefix: &[u8]) -> Result<Vec<(Vec<u8>, Bytes)>> {
+        self.scans.lock().unwrap().push(prefix.to_vec());
+        self.inner.scan(prefix).await
+    }
+
+    async fn scan_page(
+        &self,
+        prefix: &[u8],
+        after: Option<&[u8]>,
+        limit: usize,
+    ) -> Result<ScanPage> {
+        let taken = {
+            let mut pages = self.pages.lock().unwrap();
+            pages.push((prefix.to_vec(), after.map(<[u8]>::to_vec), limit));
+            pages.len()
+        };
+        // Taken out of the mutex BEFORE the await: the guard never crosses it.
+        let pending = match &self.quirk {
+            Quirk::Supersede(When::Page, pending) if prefix.starts_with(SEG_PREFIX) => {
+                pending.lock().unwrap().take()
+            }
+            Quirk::SupersedeEachGeneration { pending, opened }
+                if prefix.starts_with(SEG_PREFIX) =>
+            {
+                let mut opened = opened.lock().unwrap();
+                if opened.iter().any(|seen| seen == prefix) {
+                    // A later page of a range already retired on: one generation is
+                    // retired exactly once, whatever its walk costs.
+                    None
+                } else {
+                    opened.push(prefix.to_vec());
+                    pending.lock().unwrap().pop_front()
+                }
+            }
+            _ => None,
+        };
+        if let Some(batch) = pending {
+            self.apply(batch).await;
+        }
+        let (mut items, mut next) = self.inner.scan_page(prefix, after, limit).await?;
+        if prefix.starts_with(SEG_PREFIX) {
+            match &self.quirk {
+                Quirk::Smuggle(key, value) => items.push((key.clone(), value.clone())),
+                Quirk::Reverse => items.reverse(),
+                Quirk::PageCap(cap) => {
+                    if taken > PAGE_WALK_GUARD {
+                        return Err(format!(
+                            "{taken} pages over one group's range: the walk is not \
+                             advancing on the cursor it was handed"
+                        )
+                        .into());
+                    }
+                    if items.len() > *cap {
+                        items.truncate(*cap);
+                        // Clause 3: `Some(last key returned)` while more may remain.
+                        next = items.last().map(|(key, _)| key.clone());
+                    }
+                }
+                _ => {}
+            }
+        }
+        Ok((items, next))
+    }
+
+    async fn commit(&self, batch: WriteBatch) -> Result<CommitOutcome> {
+        self.inner.commit(batch).await
+    }
+}
+
+#[tokio::test]
+async fn resolver_touches_only_its_own_group_range() {
+    let (redb, chunks, _dir) = backends();
+    let data = payload(40, 0);
+    let plan = write_flat(&redb, &chunks, 1, "obj", &data, 0x300).await;
+    let group = SegmentGroup::new(NONCE, 5).unwrap();
+    const NAMED: usize = 2;
+    seed_segmented(&redb, 1, &plan, &group, NAMED).await;
+
+    // A second group: a different nonce, AND the same nonce at a different epoch — an
+    // older, not-yet-reclaimed generation of the same object. Neither is named by any live
+    // root; the resolver must never read either.
+    let decoys = [
+        SegmentGroup::new(OTHER_NONCE, 5).unwrap(),
+        SegmentGroup::new(NONCE, 4).unwrap(),
+    ];
+    let stray = SegmentRecord::new(vec![plan.chunk_refs()[0].clone()], 0).unwrap();
+    for decoy in &decoys {
+        let (key, value) = row(decoy, 0, &stray);
+        seed_row(&redb, key, value).await;
+    }
+
+    let store = Probe::new(redb, Quirk::None);
+    let got = read_object(&store, &chunks, 1).await.unwrap();
+    assert_eq!(got.as_deref(), Some(&data[..]), "the live object reads");
+
+    // (a) The range read: its own group's prefix, and a page no wider than the root's OWN
+    // claim — the record may not set the budget spent on its behalf.
+    let own_prefix = seg_range_prefix(&group);
+    let pages = store.pages.lock().unwrap().clone();
+    assert!(!pages.is_empty(), "a resolve must read its own range");
+    for (prefix, _after, limit) in &pages {
+        // Never a second nonce, and never the same nonce at another epoch.
+        assert_eq!(prefix, &own_prefix, "paged outside its own group's range");
+        assert!(
+            *limit <= NAMED + 1,
+            "a page wider than the root's own claim"
+        );
+    }
+
+    // (b) No unpaged `scan` at all, and (c) the `get` channel bounded POSITIVELY: this
+    // object's own root, nothing else, and no more often than the reader's own constant.
+    // That covers the segment records (the paged range is the only door onto `seg:`) *and*
+    // every other metadata key a resolve might consult on the side — a sibling root, a
+    // directory entry, an index — which a "no `seg:` gets" check would wave through.
+    store.assert_never_scanned_unpaged();
+    store.assert_root_gets(1, CLEAN_RESOLVE_ROOT_GETS);
+
+    // (d) And nothing — get, scan, or page — intersects either decoy group's range.
+    for probe in store.footprint() {
+        for range in decoys.iter().map(seg_range_prefix) {
+            assert!(
+                !probe.starts_with(&range[..]) && !range.starts_with(&probe[..]),
+                "a group no live root names was read: {}",
+                String::from_utf8_lossy(&probe)
+            );
+        }
+    }
+}
