+/// The result of resolving one committed inode's chunk map against a **snapshot** of
+/// its root (proposal 0016 decision 7(e)).
+///
+/// `Resolved` costs no read for a flat map (its chunks ARE the record) and one bounded
+/// range read for a segmented one ([`resolve_chunk_map`]). `Retired` is the other half
+/// of the resolve-retry rule (`0016:2452-2471`, decision 7(h)): the snapshot's own
+/// generation was superseded or deleted while its `seg:` range disagreed with what the
+/// snapshot named — dropped as a stale resolution rather than answered as a torn or
+/// empty map. [`resolve_live_chunk_map`] / [`resolve_current_chunk_map`] are what a
+/// caller restarts through; nothing here ever hands back a partial chunk list.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum MapResolution<'a> {
+    /// The object's ordered chunk list — borrowed for a flat map, assembled for a
+    /// segmented one.
+    Resolved(Cow<'a, [ChunkRef]>),
+    /// The snapshot's generation was concurrently retired; the caller restarts
+    /// ([`resolve_live_chunk_map`] / [`resolve_current_chunk_map`]).
+    Retired,
+}
+
+/// Whether the **current** root still names `group` — the re-read the resolve-retry
+/// rule turns on (`0016:2463-2471`). An absent root (the object was deleted) answers
+/// `false`: the generation is being reclaimed either way.
+async fn root_still_names(
+    store: &dyn MetadataStore,
+    root_key: &[u8],
+    group: &SegmentGroup,
+) -> Result<bool> {
+    let Some(bytes) = store.get(root_key).await? else {
+        return Ok(false);
+    };
+    let current: InodeRecord = decode(&bytes)?;
+    Ok(current.chunk_map.segmented().map(SegmentedMap::group) == Some(group))
+}
+
+/// The resolve-retry rule's arbiter (`0016:2463-2471`, decision 7(h)): given an anomaly
+/// in a group's `seg:` range, decide whether it is a **concurrent retirement** (the
+/// root moved on or is gone — `Ok(None)`, the caller restarts) or an **invariant
+/// violation** on a generation the root still names (`Err(fault())`, fail closed, never
+/// a torn map).
+///
+/// Every anomaly [`read_segments`] can meet — a table naming more segments than the
+/// reader's ceiling allows, a row the root does not name, a key the group's own grammar
+/// refuses, a value past the per-record ceiling, one the root names that is absent, one
+/// that will not decode, one whose extent disagrees with the root — goes through here
+/// rather than
+/// being judged where it was noticed: they share the same benign cause (the generation
+/// the caller holds was retired — its records mid-deletion, or its root never a live one
+/// at all), and deciding any of them locally would turn an ordinary overwrite into a
+/// fault for a reader racing it. That is why
+/// [`read_group_range`] hands back a [`GroupRange::Anomaly`] instead of raising one:
+/// there is exactly ONE place in this module that answers "retired, or corrupt?".
+async fn retired_or(
+    store: &dyn MetadataStore,
+    root_key: &[u8],
+    group: &SegmentGroup,
+    fault: impl FnOnce() -> ChunkMapError,
+) -> Result<Option<BTreeMap<u32, SegmentRecord>>> {
+    if root_still_names(store, root_key, group).await? {
+        // The root still names THIS generation, and either its own table is past the
+        // reader's ceiling or its range does not hold exactly what that table says it
+        // does. A live generation neither loses a segment nor grows one, so this is
+        // corruption or a protocol violation — fail closed.
+        return Err(fault().into());
+    }
+    // The root moved on (a different group, back to a flat map, or gone): superseded.
+    Ok(None)
+}
+
+/// One page-worth outcome of walking a segment group's own range.
+enum GroupRange {
+    /// Every row under the range, keyed by its **parsed** index — none past `accounted`.
+    Rows(BTreeMap<u32, (Vec<u8>, Bytes)>),
+    /// The range cannot be answered as the root's table describes it: the root's own
+    /// claim is past the reader's ceiling (refused before the first page is asked for),
+    /// or the range holds a row that table cannot account for — an index past
+    /// `accounted`, a key that is not a well-formed key of **this** group, or a value
+    /// past the per-record ceiling no backend would have stored. Carried
+    /// back as a *described* anomaly rather than raised here, so [`read_segments`]
+    /// settles it through the one resolve-retry arbiter ([`retired_or`]) exactly like
+    /// every other anomaly — a half-drained or torn retired generation is where every
+    /// one of these shapes appears, and refusing any of them where it was noticed would
+    /// turn an ordinary overwrite into a fault for the reader racing it
+    /// (`0016:2463-2471`).
+    Anomaly(ChunkMapError),
+}
+
+/// Read one segment group's own range, `seg:<nonce>:<epoch>:`, in bounded pages — the
+/// single place anything in this module reads a group's `seg:` records
+/// (`0016:2463-2469`; never a global `seg:` scan, never another group's or another
+/// epoch's).
+///
+/// [`MetadataStore::scan`] is complete-or-fail-loud at `SCAN_CAP`
+/// (`crates/traits/src/lib.rs:286`): a damaged or half-retired generation whose range
+/// holds more records than any root names would either buffer all of them or fail the
+/// whole call with a STORE error, which per-object containment cannot catch — one
+/// damaged object would then end a fleet-wide maintenance pass. So the range is read
+/// with [`MetadataStore::scan_page`] (`crates/traits/src/lib.rs:1105`, #634/PR #645)
+/// one page wider than the caller's own claim (`accounted`): a complete generation
+/// still arrives in one round trip, and a range holding more than that is *seen*, at
+/// the first excess row, without the rest being read.
+///
+/// `accounted` is refused above [`MAX_ROOT_SEGMENTS`] **before** the first page is
+/// asked for: it is the root's own claim, so a table past the ceiling would otherwise
+/// authorise a read past the object's own budget (`0016:2432-2440`). That refusal is
+/// *described* like every other anomaly, not raised here: an over-ceiling table is one
+/// more shape a reader can meet on a generation that was retired under it, and deciding
+/// it locally would answer [`ChunkMapError::TooManySegments`] for an object whose live
+/// generation resolves perfectly — a hard read failure on healthy data, the arm decision
+/// 7(h) exists to prevent. Settling it costs one **root** `get` ([`retired_or`]) and
+/// never a range read, so the budget rule stands.
+///
+/// The row count is only half of what a range can cost a reader: a row's own **value** is
+/// refused above [`MAX_VALUE_BYTES`], before it is kept and therefore before anything
+/// decodes it ([`ChunkMapError::SegmentValueOverCeiling`]). The two ceilings together are
+/// what makes the resolve's memory the reader's number — at most
+/// `MAX_ROOT_SEGMENTS × MAX_VALUE_BYTES` — rather than the record's. What one *page* the
+/// store has already materialised costs is the store's own budget, not something this
+/// resolver can bound after the fact: [`MetadataStore::scan_page`] is bounded in rows,
+/// never in bytes (`crates/traits/src/lib.rs:1067-1074`).
+///
+/// Rows are collected into a [`BTreeMap`] keyed by their **parsed** index — never the
+/// order a page returned them in: the paging contract states byte-lexicographic key
+/// order (`crates/traits/src/lib.rs:1044`), but the fixed-width key is a
+/// debuggability property, not a licence for this resolver to lean on it.
+///
+/// Anything the range holds that the root's table cannot account for is **described**
+/// ([`GroupRange::Anomaly`]), never raised: only [`read_segments`] knows whether the
+/// root still names this generation, which is what decides fault-versus-retirement.
+async fn read_group_range(
+    store: &dyn MetadataStore,
+    group: &SegmentGroup,
+    accounted: usize,
+) -> Result<GroupRange> {
+    if accounted > MAX_ROOT_SEGMENTS {
+        // Refused BEFORE the first page: a record may not set the work spent on its
+        // behalf. Described, not raised — `read_segments` asks the one question that
+        // separates a corrupt live root from a snapshot the store has already moved off.
+        return Ok(GroupRange::Anomaly(ChunkMapError::TooManySegments {
+            segments: accounted,
+        }));
+    }
+    let prefix = seg_range_prefix(group);
+    let mut rows: BTreeMap<u32, (Vec<u8>, Bytes)> = BTreeMap::new();
+    let mut after: Option<Vec<u8>> = None;
+    loop {
+        let (page, next) = store
+            .scan_page(&prefix, after.as_deref(), accounted.saturating_add(1))
+            .await?;
+        for (key, value) in page {
+            // A key under the range that this module's own grammar cannot parse is an
+            // anomaly of the range, NOT a verdict: `Ok(Anomaly)`, so the retire-versus-
+            // corruption call is made once, by `read_segments`, for every shape alike.
+            // Propagating it here instead would answer "corrupt" for a generation the
+            // root has already moved off — the one arm decision 7(h) exists to prevent.
+            let (nonce, epoch, index) = match parse_seg_key(&key) {
+                Ok(parsed) => parsed,
+                Err(malformed) => return Ok(GroupRange::Anomaly(malformed)),
+            };
+            // The range prefix already pins both, so a mismatch here means the store
+            // answered with a row outside the prefix it was asked for: the resolver
+            // pins the group itself rather than trusting a backend's prefix handling,
+            // or another epoch's segment could be spliced into this generation's map.
+            if nonce != *group.nonce() || epoch != group.epoch() {
+                return Ok(GroupRange::Anomaly(ChunkMapError::SegmentKeyMalformed {
+                    key: String::from_utf8_lossy(&key).into_owned(),
+                }));
+            }
+            // Checked BEFORE the row is kept, so the range's size can never become the
+            // caller's memory cost: the walk stops at the first excess row rather than
+            // reading (or even seeing) the rest of the range.
+            if usize::try_from(index).unwrap_or(usize::MAX) >= accounted {
+                return Ok(GroupRange::Anomaly(ChunkMapError::SegmentUnknown {
+                    nonce: group.nonce().to_string(),
+                    epoch: group.epoch(),
+                    index,
+                }));
+            }
+            // The other half of the same bound, and checked at the same point for the same
+            // reason: `accounted` bounds how MANY rows this walk keeps, and without a
+            // per-row ceiling the size of each one is still the record's to choose — one
+            // row could spend the reader's whole heap, and a decode of it several times
+            // that. `MAX_VALUE_BYTES` is what the tightest backend in play would have
+            // refused to store at all (`crates/traits/src/lib.rs:994-997`) and twice the
+            // `V / 2` a publishable segment value is bounded by (`0016:1467`), so nothing
+            // a conforming publication wrote is refused here — while what the two ceilings
+            // together let one resolve hold is `MAX_ROOT_SEGMENTS × MAX_VALUE_BYTES`, a
+            // number this reader sets. Described, not raised: an oversized row is one more
+            // shape a retired generation can show a reader, so `read_segments` settles it
+            // through the same arbiter as every other anomaly.
+            if value.len() > MAX_VALUE_BYTES {
+                return Ok(GroupRange::Anomaly(
+                    ChunkMapError::SegmentValueOverCeiling {
+                        index,
+                        bytes: value.len(),
+                        ceiling: MAX_VALUE_BYTES,
+                    },
+                ));
+            }
+            rows.insert(index, (key, value));
+        }
+        // Clause 3 of the paging contract: `next` is `None` only when the prefix is
+        // exhausted, and the cursor is exclusive, so the walk strictly advances.
+        match next {
+            Some(cursor) => after = Some(cursor),
+            None => return Ok(GroupRange::Rows(rows)),
+        }
+    }
+}
+
+/// Decode one `seg:` value into its [`SegmentRecord`], attributing any failure —
+/// structural or plain-unparsable bytes alike — to this one segment's index via
+/// [`ChunkMapError::SegmentRecordUndecodable`], so [`retired_or`] has one typed anomaly
+/// to arbitrate regardless of *why* the record could not be read.
+///
+/// The bytes handed here are already inside [`MAX_VALUE_BYTES`] — [`read_group_range`]
+/// refuses a larger row before it is kept — so what this decode may allocate is bounded
+/// by the reader's own ceiling and not by the record it is parsing.
+fn decode_segment_record(
+    index: u32,
+    value: &[u8],
+) -> std::result::Result<SegmentRecord, ChunkMapError> {
+    decode::<SegmentRecord>(value).map_err(|err| {
+        let detail = match err.downcast::<ChunkMapError>() {
+            Ok(typed) => typed.to_string(),
+            Err(err) => err.to_string(),
+        };
+        ChunkMapError::SegmentRecordUndecodable { index, detail }
+    })
+}
+
+/// Read a segmented map's segments through the bounded per-group range
+/// ([`read_group_range`]), settling every anomaly it can show — a table past the resolve
+/// ceiling, an unnamed row, one past the per-record value ceiling, an absent one, one
+/// that will not decode, one whose extent disagrees with the root's table — through the
+/// single resolve-retry arbiter
+/// ([`retired_or`]) rather than a bare refusal at whichever check noticed it first.
+/// `Ok(None)` is the retired arm.
+async fn read_segments(
+    store: &dyn MetadataStore,
+    root_key: &[u8],
+    map: &SegmentedMap,
