diff --git a/crates/server/tests/segmented_object_read.rs b/crates/server/tests/segmented_object_read.rs
new file mode 100644
index 0000000..270834d
--- /dev/null
+++ b/crates/server/tests/segmented_object_read.rs
@@ -0,0 +1,363 @@
+//! The gateway's whole-object and ranged GET over a **segmented** object (issue #649,
+//! proposal 0016 decision 7(e)/(h)) — through the base-visible [`ObjectGateway`] trait
+//! (its streaming and ranged entries are trait methods, not inherent `pub fn`s,
+//! `crates/server/src/lib.rs:314`,`:343` — the import idiom already used at
+//! `crates/server/tests/s3_http_wire.rs:44` and `crates/server/tests/e2e.rs:85`).
+//!
+//! Every object here is seeded as raw `seg:` records plus a segmented root — a genuine
+//! flat write (real fragments, via `wyrd_core::write`) reshaped by a raw `WriteBatch`,
+//! **never via a committer** (this slice ships no producer) — because `Gateway`'s
+//! fields are private to its own crate, so an external integration test seeds through
+//! its own store handle *before* handing it to `Gateway::new`, not through the gateway.
+//!
+//! This is also where issue #647's co-located gateway tests over a segmented map now
+//! live (moved per this slice's brief: a co-located `#[cfg(test)]` module cannot earn a
+//! per-fix RED here, since an added *test target* — this file — is C4-verify's
+//! discriminator, not an existing one).
+//!
+//! RED on `origin/main`: `get_object_streaming`/`get_object_range` still take the
+//! record's `.chunk_map` directly (`:360`,`:446`) and fail closed with
+//! `SegmentedMapUnsupported` for every segmented object — every test here fails as an
+//! assertion, and both this file and its doubles compile because every imported symbol
+//! is base-visible from #648.
+
+#![forbid(unsafe_code)]
+
+use std::sync::{Arc, Mutex};
+
+use async_trait::async_trait;
+use bytes::Bytes;
+use futures_util::StreamExt;
+use wyrd_chunkstore_fs::FsChunkStore;
+use wyrd_coordination_mem::MemCoordination;
+use wyrd_core::metadata::{
+    encode, inode_key, seg_key, ChunkMap, EcScheme, InodeRecord, InodeState, SegmentGroup,
+    SegmentRecord, SegmentRef, SegmentedMap,
+};
+use wyrd_core::write;
+use wyrd_gateway_core::{ByteRange, ObjectGateway, ObjectStream, RangeOutcome};
+use wyrd_metadata_redb::RedbMetadataStore;
+use wyrd_server::Gateway;
+use wyrd_traits::{CommitOutcome, MetadataStore, Result, ScanPage, WriteBatch};
+
+const ROOT: u64 = 0;
+const NOW: u64 = 1_000;
+const TTL: u64 = 5_000;
+const CHUNK: usize = 4;
+const NONCE: &str = "0123456789abcdef0123456789abcdef";
+
+fn ids_from(base: u128) -> impl FnMut() -> u128 {
+    let mut n = base;
+    move || {
+        n += 1;
+        n
+    }
+}
+
+/// Plan, fan out and commit a genuine **flat** object — real fragments on disk, via
+/// the ordinary single-shot write path. Returns the plan so `chunk_refs()`/`size` are
+/// in hand without reading the record back.
+async fn write_flat(
+    meta: &RedbMetadataStore,
+    chunks: &FsChunkStore,
+    inode_id: u64,
+    name: &str,
+    data: &[u8],
+    id_base: u128,
+) -> write::WritePlan {
+    let mut next = ids_from(id_base);
+    let plan = write::plan_write(data, CHUNK, EcScheme::None, &mut next).expect("plan");
+    write::intent(meta, &plan, NOW + TTL).await.expect("intent");
+    write::write_fragments(chunks, &plan)
+        .await
+        .expect("fan out");
+    assert_eq!(
+        write::commit_create(meta, ROOT, name, inode_id, &plan, NOW)
+            .await
+            .expect("commit"),
+        CommitOutcome::Committed
+    );
+    write::release(meta, &plan).await.expect("release");
+    plan
+}
+
+/// The framing metadata (ADR-0047) the **old**, segmented generation carries. Every
+/// field differs from [`NEW`]'s, so a response that mixed one generation's headers with
+/// the other's bytes is visible in the assertion rather than plausible.
+const OLD: (&str, &str, u64) = ("etag-of-the-segmented-generation", "text/old", 111);
+/// The framing metadata the **new**, live generation carries — and its size differs
+/// too ([`NEW_LEN`] vs the 32-byte segmented fixture), so a stale `Content-Length` is
+/// as detectable as a stale ETag.
+const NEW: (&str, &str, u64) = ("etag-of-the-live-generation", "text/new", 222);
+const OLD_LEN: usize = 32;
+const NEW_LEN: usize = 40;
+
+/// Overwrite `inode_id`'s root with the **segmented** spelling of `plan`'s chunks,
+/// split into `n` segments keyed by `group` — a raw `WriteBatch`, never a committer.
+/// The root carries [`OLD`]'s metadata, so the framing of a read served from THIS
+/// generation is distinguishable from one served after a restart.
+async fn reshape_into_segments(
+    meta: &RedbMetadataStore,
+    inode_id: u64,
+    plan: &write::WritePlan,
+    group: &SegmentGroup,
+    n: usize,
+) {
+    let chunks = plan.chunk_refs();
+    assert!(n >= 2 && n <= chunks.len(), "fixture needs a real split");
+    let mut refs = Vec::new();
+    let mut offset = 0u64;
+    let mut batch = WriteBatch::new();
+    for (index, part) in chunks.chunks(chunks.len().div_ceil(n)).enumerate() {
+        let record = SegmentRecord::new(part.to_vec(), offset).expect("segment record");
+        refs.push(sref(index as u32, offset, record.byte_len()));
+        offset += record.byte_len();
+        let key = seg_key(group, index as u32).expect("addressable index");
+        batch = batch.put(key, encode(&record));
+    }
+    let table = SegmentedMap::new(group.clone(), refs).expect("segment table");
+    let root = InodeRecord {
+        size: plan.size,
+        chunk_map: ChunkMap::Segmented(table),
+        state: InodeState::Committed,
+        version: 1,
+        etag: Some(OLD.0.to_owned()),
+        content_type: Some(OLD.1.to_owned()),
+        modified: Some(OLD.2),
+    };
+    batch = batch.put(inode_key(inode_id), encode(&root));
+    assert_eq!(
+        meta.commit(batch).await.expect("seed the segmented root"),
+        CommitOutcome::Committed
+    );
+}
+
+fn sref(index: u32, byte_offset: u64, byte_len: u64) -> SegmentRef {
+    SegmentRef {
+        index,
+        byte_offset,
+        byte_len,
+    }
+}
+
+async fn drain(mut stream: ObjectStream) -> Vec<u8> {
+    let mut out = Vec::new();
+    while let Some(piece) = stream.next().await {
+        out.extend_from_slice(&piece.expect("chunk read"));
+    }
+    out
+}
+
+fn backends() -> (RedbMetadataStore, FsChunkStore, tempfile::TempDir) {
+    let meta = RedbMetadataStore::in_memory().expect("in-memory redb");
+    let dir = tempfile::tempdir().expect("temp dir");
+    let chunks = FsChunkStore::open(dir.path()).expect("fs chunk store");
+    (meta, chunks, dir)
+}
+
+// ---------------------------------------------------------------------------
+// (1) Byte-identical reads — whole object, and a range spanning a segment boundary.
+// ---------------------------------------------------------------------------
+
+/// Both criterion-(1) entries on ONE segmented fixture: the whole-object stream, and a
+/// range that **straddles a segment boundary** — the case a consumer reading only the
+/// root's table, or only the first segment record, cannot serve. Two segments of 24 bytes
+/// each (12 chunks of 4 bytes, split 6/6), so `[20, 30)` spans the seam.
+#[tokio::test]
+async fn a_segmented_object_reads_byte_identical_whole_and_across_a_segment_boundary() {
+    let (meta, chunks, _dir) = backends();
+    let data: Vec<u8> = (0..48u32).map(|i| (i % 251) as u8).collect();
+    let plan = write_flat(&meta, &chunks, 1, "obj", &data, 0x100).await;
+    let group = SegmentGroup::new(NONCE, 1).unwrap();
+    reshape_into_segments(&meta, 1, &plan, &group, 2).await;
+    let gateway =
+        Arc::new(Gateway::new(meta, chunks, MemCoordination::new()).with_chunk_size(CHUNK));
+
+    let read = Arc::clone(&gateway)
+        .get_object_streaming("obj")
+        .await
+        .unwrap()
+        .expect("the segmented object is committed");
+    assert_eq!(read.size, data.len() as u64);
+    // A segmented object's own framing rides out with it exactly as a flat one's does.
+    assert_eq!(read.etag.as_deref(), Some(OLD.0));
+    assert_eq!(read.content_type.as_deref(), Some(OLD.1));
+    assert_eq!(read.modified, Some(OLD.2));
+    assert_eq!(drain(read.stream).await, data);
+
+    let range_read = Arc::clone(&gateway)
+        .get_object_range("obj", ByteRange::FromTo(20, 29))
+        .await
+        .unwrap()
+        .expect("the segmented object is committed");
+    let RangeOutcome::Satisfiable {
+        offset,
+        len,
+        stream,
+    } = range_read.outcome
+    else {
+        panic!("a 10-byte range inside a 48-byte object must be satisfiable");
+    };
+    assert_eq!((offset, len), (20, 10));
+    assert_eq!(drain(stream).await, &data[20..30]);
+}
+
+// ---------------------------------------------------------------------------
+// (3) The resolve-retry rule through the gateway: an overwrite mid-resolve is not a
+//     deletion — both call sites restart onto the live generation.
+// ---------------------------------------------------------------------------
+
+/// A double that, the FIRST time it is asked to page a `seg:` range, applies a
+/// pending mutation — the exact race the resolve-retry rule exists for: the root
+/// moves in the window between the gateway's initial root read and its `seg:` range
+/// read (`0016:2452-2462`, the root always moves first).
+struct SupersedeMidResolve {
+    inner: RedbMetadataStore,
+    pending: Mutex<Option<WriteBatch>>,
+}
+
+#[async_trait]
+impl MetadataStore for SupersedeMidResolve {
+    async fn get(&self, key: &[u8]) -> Result<Option<Bytes>> {
+        self.inner.get(key).await
+    }
+
+    async fn scan(&self, prefix: &[u8]) -> Result<Vec<(Vec<u8>, Bytes)>> {
+        self.inner.scan(prefix).await
+    }
+
+    async fn scan_page(
+        &self,
+        prefix: &[u8],
+        after: Option<&[u8]>,
+        limit: usize,
+    ) -> Result<ScanPage> {
+        if prefix.starts_with(b"seg:") {
+            let pending = self.pending.lock().unwrap().take();
+            if let Some(batch) = pending {
+                assert_eq!(
+                    self.inner.commit(batch).await.unwrap(),
+                    CommitOutcome::Committed
+                );
+            }
+        }
+        self.inner.scan_page(prefix, after, limit).await
+    }
+
+    async fn commit(&self, batch: WriteBatch) -> Result<CommitOutcome> {
+        self.inner.commit(batch).await
+    }
+}
+
+/// Build the "the root moved on while we resolved" fixture: a committed segmented
+/// object at inode 1, plus a pending flip (not yet applied) that overwrites it with a
+/// brand-new flat generation whose fragments are already on disk.
+///
+/// The new generation differs from the segmented one in **every** framed field — its
+/// length ([`NEW_LEN`] vs [`OLD_LEN`]), its ETag, its content type and its
+/// modification time — because a restart that served the new bytes under the old
+/// generation's framing (a stale `Content-Length`, ETag, `Content-Type` or
+/// `Last-Modified`) is exactly the tear these tests exist to catch, and a fixture whose
+/// two generations agree on those fields cannot see it.
+async fn superseded_double(
+    meta: RedbMetadataStore,
+    chunks: &FsChunkStore,
+) -> (SupersedeMidResolve, Vec<u8>) {
+    let new_data: Vec<u8> = (0..NEW_LEN).map(|i| (100 + i) as u8).collect();
+    let mut next = ids_from(0x900);
+    let new_plan = write::plan_write(&new_data, CHUNK, EcScheme::None, &mut next).unwrap();
+    write::write_fragments(chunks, &new_plan).await.unwrap();
+    let new_root = InodeRecord {
+        size: new_plan.size,
+        chunk_map: new_plan.chunk_refs().into(),
+        state: InodeState::Committed,
+        version: 2,
+        etag: Some(NEW.0.to_owned()),
+        content_type: Some(NEW.1.to_owned()),
+        modified: Some(NEW.2),
+    };
+    let flip = WriteBatch::new().put(inode_key(1), encode(&new_root));
+    (
+        SupersedeMidResolve {
+            inner: meta,
+            pending: Mutex::new(Some(flip)),
+        },
+        new_data,
+    )
+}
+
+/// Seed the segmented generation at inode 1 and hand back a gateway whose store retires
+/// it mid-resolve, plus the live generation's bytes.
+async fn superseded_gateway(
+    id_base: u128,
+) -> (
+    Arc<Gateway<SupersedeMidResolve, FsChunkStore, MemCoordination>>,
+    Vec<u8>,
+    tempfile::TempDir,
+) {
+    let (meta, chunks, dir) = backends();
+    let old_data: Vec<u8> = (0..OLD_LEN).map(|i| i as u8).collect();
+    let old_plan = write_flat(&meta, &chunks, 1, "obj", &old_data, id_base).await;
+    let group = SegmentGroup::new(NONCE, 1).unwrap();
+    reshape_into_segments(&meta, 1, &old_plan, &group, 2).await;
+    let (double, new_data) = superseded_double(meta, &chunks).await;
+    let gateway =
+        Arc::new(Gateway::new(double, chunks, MemCoordination::new()).with_chunk_size(CHUNK));
+    (gateway, new_data, dir)
+}
+
+#[tokio::test]
+async fn get_object_streaming_restarts_onto_the_live_generation_when_the_root_moves_mid_resolve() {
+    let (gateway, new_data, _dir) = superseded_gateway(0x800).await;
+    let read = Arc::clone(&gateway)
+        .get_object_streaming("obj")
+        .await
+        .unwrap()
+        .expect("an overwrite is not a deletion — NoSuchKey would be wrong here");
+    // The whole response describes ONE generation: the framing the wire layer turns
+    // into `Content-Length`/`ETag`/`Content-Type`/`Last-Modified` comes from the
+    // generation the bytes came from, never from the superseded root this read began
+    // with (whose every field differs — see `superseded_double`).
+    assert_eq!(read.size, new_data.len() as u64);
+    assert_eq!(read.etag.as_deref(), Some(NEW.0));
+    assert_eq!(read.content_type.as_deref(), Some(NEW.1));
+    assert_eq!(read.modified, Some(NEW.2));
+    assert_eq!(
+        drain(read.stream).await,
+        new_data,
+        "a root retired mid-resolve must restart against the LIVE generation, not the \
+         one this read started with"
+    );
+}
+
+#[tokio::test]
+async fn get_object_range_restarts_onto_the_live_generation_when_the_root_moves_mid_resolve() {
+    let (gateway, new_data, _dir) = superseded_gateway(0x810).await;
+    // The ranged entry is its OWN `.chunk_map` consumer (`crates/server/src/lib.rs:446`)
+    // — prove IT restarts too, not only the streaming entry. The span asked for lies
+    // ENTIRELY past the superseded generation's last byte: served from the old root's
+    // size it is a 416, so a satisfiable answer here is only possible if the 416
+    // boundary, the framing and the bytes all come from the live generation.
+    let range_read = Arc::clone(&gateway)
+        .get_object_range("obj", ByteRange::FromTo(OLD_LEN as u64, NEW_LEN as u64 - 1))
+        .await
+        .unwrap()
+        .expect("an overwrite is not a deletion");
+    assert_eq!(range_read.meta.size, new_data.len() as u64);
+    assert_eq!(range_read.meta.etag.as_deref(), Some(NEW.0));
+    assert_eq!(range_read.meta.content_type.as_deref(), Some(NEW.1));
+    assert_eq!(range_read.meta.modified, Some(NEW.2));
+    let RangeOutcome::Satisfiable {
+        offset,
+        len,
+        stream,
+    } = range_read.outcome
+    else {
+        panic!(
+            "a span inside the LIVE generation must be satisfiable, not a 416 from the \
+                superseded one's size"
+        );
+    };
+    assert_eq!((offset, len), (OLD_LEN as u64, (NEW_LEN - OLD_LEN) as u64));
+    assert_eq!(drain(stream).await, &new_data[OLD_LEN..]);
+}
