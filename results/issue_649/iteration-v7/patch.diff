+        let Some(record) = found.get(&segment.index) else {
+            return retired_or(store, root_key, group, || ChunkMapError::SegmentAbsent {
+                nonce: group.nonce().to_string(),
+                epoch: group.epoch(),
+                index: segment.index,
+            })
+            .await;
+        };
+        if record.byte_offset() != segment.byte_offset || record.byte_len() != segment.byte_len {
+            let root = (segment.byte_offset, segment.byte_len);
+            let seg_extent = (record.byte_offset(), record.byte_len());
+            let index = segment.index;
+            return retired_or(store, root_key, group, || {
+                ChunkMapError::SegmentBoundsMismatch {
+                    index,
+                    root,
+                    segment: seg_extent,
+                }
+            })
