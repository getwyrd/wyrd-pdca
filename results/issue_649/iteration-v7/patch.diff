+/// Seed a decodable root naming ONE MORE segment than the resolver may ever spend a read
+/// on (`MAX_ROOT_SEGMENTS` is a resolve-time ceiling, not a decode invariant, so the
+/// record exists) — and no `seg:` records for it at all.
+async fn seed_over_ceiling_root(meta: &RedbMetadataStore, inode_id: u64, group: &SegmentGroup) {
+    let refs = (0..(MAX_ROOT_SEGMENTS + 1) as u32)
+        .map(|i| sref(i, i as u64, 1))
+        .collect();
+    seed(meta, inode_id, group, refs, Vec::new()).await;
+}
+
+/// **A LIVE root over the ceiling fails closed, unread.** The root the store holds is the
+/// one the reader met, so this is the object's own fault: refused before a single row of
+/// its range is asked for, and without fetching anything but this object's own root by
+/// any other route — not a segment record, and not some other key consulted to decide it.
+#[tokio::test]
+async fn a_root_over_the_segment_ceiling_is_refused_before_any_range_read() {
+    let (redb, chunks, _dir) = backends();
+    seed_over_ceiling_root(&redb, 1, &SegmentGroup::new(NONCE, 1).unwrap()).await;
+
+    let store = Probe::new(redb, Quirk::None);
+    assert_fails_closed("over the ceiling", read_object(&store, &chunks, 1).await);
+    // Refused BEFORE any range read is performed, and by no other route either.
+    store.assert_no_range_read();
+    store.assert_never_scanned_unpaged();
+    store.assert_gets_only_the_root_of(1);
+}
+
+/// **An over-ceiling root the store has already moved off is a RETIRED generation, not a
+/// fault.** The ceiling still refuses before any range read — but *which answer* that
+/// refusal becomes is the resolve-retry rule's call, exactly as it is for an absent or
+/// unparsable row. The reader here holds a snapshot whose root was overwritten the instant
+/// after it read it (the only window a resolve refused before its first page ever has), so
+/// the live generation is what it must read. Answering `TooManySegments` where the ceiling
+/// is noticed instead fails a perfectly healthy object over bytes nothing points at any
+/// more — a permanent read failure invented out of an ordinary overwrite, which is exactly
+/// what C-1 forbids.
+#[tokio::test]
+async fn an_over_ceiling_root_superseded_mid_read_restarts_onto_the_live_generation() {
+    let (redb, chunks, _dir) = backends();
+    seed_over_ceiling_root(&redb, 1, &SegmentGroup::new(NONCE, 1).unwrap()).await;
+
+    let new_data = payload(36, 170);
+    let flip = pending_flat(&chunks, 1, &new_data, 0x640).await;
+    let store = Probe::superseding(redb, When::RootRead, flip);
+    let got = read_object(&store, &chunks, 1).await.unwrap();
+    assert_eq!(got, Some(new_data), "must restart onto the live generation");
+    // …and the retired table must still authorise no range read whatsoever. The restart
+    // is onto the SAME object's root — settling "retired or corrupt?" and re-resolving
+    // may not reach for any other metadata key.
+    store.assert_no_range_read();
+    store.assert_gets_only_the_root_of(1);
+}
+
+/// **Exactly [`MAX_ROOT_SEGMENTS`] is inside the ceiling — and it is read by PAGING.**
+/// Two properties on one fixture, because they are the same walk:
+///
+/// * the boundary the refusal above must not swallow — the most segments this deployment
+///   allows still resolves, all 512 records, byte-identical bytes back. A ceiling that
+///   refused *at* its own limit would strand every object written right up to it, the
+///   permanent-unreadability failure mode C-1 forbids; and
+/// * a group wider than one page. `scan_page` clamps a page to the store's own effective
+///   cap whatever limit was asked for (`crates/traits/src/lib.rs:1069-1071`), so a real
+///   backend hands the ceiling-sized group back in pieces. The store here caps at 200
+///   rows: 512 segments is then a three-page walk, each page anchored strictly after the
+///   last key of the one before (clause 2/3, `crates/traits/src/lib.rs:1046-1056`). A
+///   resolver that stopped at the first short page would answer a torn map; one that
+///   re-anchored at the prefix would never terminate.
+#[tokio::test]
+async fn a_root_at_exactly_the_segment_ceiling_resolves_across_paged_reads() {
+    let (meta, chunks, _dir) = backends();
+    // One chunk per segment, so the root names exactly MAX_ROOT_SEGMENTS of them.
+    let data = payload((MAX_ROOT_SEGMENTS * CHUNK) as u32, 7);
+    let plan = write_flat(&meta, &chunks, 1, "obj", &data, 0x1000).await;
+    assert_eq!(plan.chunk_refs().len(), MAX_ROOT_SEGMENTS);
+    let group = SegmentGroup::new(NONCE, 1).unwrap();
+    seed_segmented(&meta, 1, &plan, &group, MAX_ROOT_SEGMENTS).await;
+
+    const PAGE_CAP: usize = 200;
+    let store = Probe::new(meta, Quirk::PageCap(PAGE_CAP));
+    let got = read_object(&store, &chunks, 1).await.unwrap();
+    assert_eq!(got, Some(data), "a root AT the ceiling is inside it");
+    // …and it got there by carrying the cursor, not by one lucky page: 512 rows at 200 a
+    // page is a three-page walk, each anchored strictly after the last key of the one
+    // before.
+    let walk = vec![
+        None,
+        Some(seg_key(&group, PAGE_CAP as u32 - 1).unwrap()),
+        Some(seg_key(&group, 2 * PAGE_CAP as u32 - 1).unwrap()),
+    ];
+    assert_eq!(store.page_cursors(), walk, "the cursor was not carried");
+    // …and the root was read exactly as often as it is for a TWO-segment object: the
+    // widest table this deployment allows, walked over three pages, buys no extra root
+    // read. A resolver re-asking the root per segment or per page — still only ever the
+    // right key — would spend 512 (or 3) reads here and 2 in the small fixture.
+    store.assert_root_gets(1, CLEAN_RESOLVE_ROOT_GETS);
+}
+
+/// A segment record over the per-record **value** ceiling, and correct in every other
+/// respect: real chunks of this object's own, repeated until the encoded value crosses
+/// [`MAX_VALUE_BYTES`]. Nothing else about it is bent — its key is canonical, it decodes,
+/// and the table below names its extent exactly — so without a ceiling this record resolves
+/// and the object reads back whole. That is what makes the refusal it must draw the
+/// **resolver's own** decision rather than a side effect of a bent extent or unparsable
+/// bytes.
+fn over_ceiling_record(chunk: &ChunkRef, byte_offset: u64) -> SegmentRecord {
+    let record = |chunks: Vec<ChunkRef>| SegmentRecord::new(chunks, byte_offset).expect("record");
+    let mut chunks = vec![chunk.clone()];
+    while encode(&record(chunks.clone())).len() <= MAX_VALUE_BYTES {
+        chunks.resize(chunks.len() * 2, chunk.clone());
+    }
+    record(chunks)
+}
+
+/// Seed `inode_id` as a two-segment generation of `group` whose FIRST segment's record is
+/// over the value ceiling ([`over_ceiling_record`]) and whose second is the rest of `plan`'s
+/// chunks. The oversized row comes first so a reader that stops at it has been shown nothing
+/// else, and both extents agree with the table, so the value's size is the only thing wrong
+/// with the generation.
+async fn seed_over_ceiling_value(
+    meta: &RedbMetadataStore,
+    inode_id: u64,
+    plan: &write::WritePlan,
+    group: &SegmentGroup,
+) {
+    let all = plan.chunk_refs();
+    let fat = over_ceiling_record(&all[0], 0);
+    let tail = SegmentRecord::new(all[1..].to_vec(), fat.byte_len()).expect("record");
+    let refs = vec![
+        sref(0, 0, fat.byte_len()),
+        sref(1, fat.byte_len(), tail.byte_len()),
+    ];
+    seed(meta, inode_id, group, refs, rows_of(group, &[fat, tail])).await;
+}
+
+/// **A segment record past the value ceiling is refused, and the rest of its range is never
+/// read.** [`MAX_ROOT_SEGMENTS`] bounds how *many* records a root may make a reader hold; on
+/// its own it leaves the other factor — how *large* each one is — the record's to choose, so
+/// one row could spend the reader's whole heap (and a decode of it several times that) and
+/// end every **other** object's read along with it. That is a store-wide availability loss
+/// where C-1 allows only a refusal scoped to the object that failed.
+///
+/// The store here serves one row per page, so *which* rows the resolver was shown is
+/// visible: it stops at the offending row rather than walking the range out. Without the
+/// ceiling this exact fixture resolves and reads back — the record is real, decodable and
+/// exactly the extent the root names — so the refusal is not an artefact of the fixture.
+#[tokio::test]
+async fn a_segment_record_over_the_value_ceiling_is_refused_before_the_rest_of_the_range() {
+    let (redb, chunks, _dir) = backends();
+    let data = payload((2 * CHUNK) as u32, 0);
+    let plan = write_flat(&redb, &chunks, 1, "obj", &data, 0x800).await;
+    let group = SegmentGroup::new(NONCE, 1).unwrap();
+    seed_over_ceiling_value(&redb, 1, &plan, &group).await;
+
+    let store = Probe::new(redb, Quirk::PageCap(1));
+    assert_fails_closed(
+        "a value over the ceiling",
+        read_object(&store, &chunks, 1).await,
+    );
+    // One page: the walk stopped at the oversized row rather than reading the row behind
+    // it, so what the whole range costs is bounded by where the reader stops.
+    assert_eq!(store.page_cursors(), vec![None], "the range was walked out");
+    store.assert_never_scanned_unpaged();
+    store.assert_gets_only_the_root_of(1);
+}
+
+/// **…and on a generation the root has already moved off, the same row restarts the read
+/// instead of failing it.** The ceiling refusal is *described*, not raised where it is
+/// noticed: it goes through the one resolve-retry arbiter like every other anomaly. Deciding
+/// it locally would answer "over the ceiling" for an object whose live generation is
+/// perfectly fine — a permanent read failure invented out of an ordinary overwrite, which is
+/// what C-1 forbids.
+#[tokio::test]
+async fn an_over_ceiling_value_in_a_retired_generation_restarts_onto_the_live_one() {
+    let (redb, chunks, _dir) = backends();
+    let data = payload((2 * CHUNK) as u32, 0);
+    let plan = write_flat(&redb, &chunks, 1, "obj", &data, 0x820).await;
+    seed_over_ceiling_value(&redb, 1, &plan, &SegmentGroup::new(NONCE, 1).unwrap()).await;
+
+    let new_data = payload(36, 190);
+    let flip = pending_flat(&chunks, 1, &new_data, 0x860).await;
+    let store = Probe::superseding(redb, When::Page, flip);
+    let got = read_object(&store, &chunks, 1).await.unwrap();
+    assert_eq!(got, Some(new_data), "must restart onto the live generation");
+    store.assert_gets_only_the_root_of(1);
+}
+
+// ---------------------------------------------------------------------------
+// (3) The resolver is total and never tears.
+// ---------------------------------------------------------------------------
+
+/// How a fixture bends the **correct** two-segment spelling of an object: it takes the
+/// root's table and the records that satisfy it, and hands back the table and the raw
+/// `seg:` rows to seed instead. Exactly ONE thing differs per case, so what the case
+/// differs by *is* the property it binds.
+type Bend = fn(&SegmentGroup, Vec<SegmentRef>, &[SegmentRecord]) -> (Vec<SegmentRef>, Rows);
+type Rows = Vec<(Vec<u8>, Bytes)>;
+
+/// Every anomaly a group's range can show while **the root still names that generation**.
+/// A live generation neither loses a segment nor grows one, so each of these is an
+/// invariant violation, and the answer is a typed refusal for this ONE object — never a
+/// torn map, never a partial chunk list, never "this object owns no bytes".
+const FAIL_CLOSED: &[(&str, Bend)] = &[
+    // Segment 1 is deliberately never written.
+    ("a named segment is absent", |group, refs, records| {
+        (refs, vec![row(group, 0, &records[0])])
+    }),
+    ("a named segment will not decode", |group, refs, records| {
+        let key = seg_key(group, 1).unwrap();
+        let garbage = (key, Bytes::from_static(b"not a segment record"));
+        (refs, vec![row(group, 0, &records[0]), garbage])
+    }),
+    // The root names ONLY segment 0, so the record at index 1 is a row its table does not
+    // account for.
+    (
+        "a row the root's table does not name",
+        |group, refs, recs| (refs[..1].to_vec(), rows_of(group, recs)),
+    ),
+    // ONE extent coordinate disagrees — the offset. Segment 1 holds exactly the right
+    // chunks; only its recorded *start* is a byte off. A resolver that refused a mismatch
+    // merely when BOTH coordinates disagreed would hand this map back as if the two
+    // descriptions agreed — the quiet misdescription this case exists to catch.
+    (
+        "a segment starts a byte off the table",
+        |group, refs, recs| {
+            let start = recs[1].byte_offset() + 1;
+            let shifted = SegmentRecord::new(recs[1].chunks().to_vec(), start).unwrap();
+            assert_eq!(shifted.byte_len(), refs[1].byte_len, "the LENGTH agrees");
+            (refs, vec![row(group, 0, &recs[0]), row(group, 1, &shifted)])
+        },
+    ),
+    // …and the other coordinate alone: the root claims one byte more than the record it
+    // names actually carries, same start. The refusal must be the **resolver's** typed
+    // one, not a later size check downstream — a map the resolver passed on as agreeing is
+    // already the under-approximation C-1 forbids, whoever notices it afterwards.
+    (
+        "the table claims a byte too many",
+        |group, mut refs, recs| {
+            refs[1].byte_len += 1;
+            assert_eq!(refs[1].byte_offset, recs[1].byte_offset(), "OFFSET agrees");
+            (refs, rows_of(group, recs))
+        },
+    ),
+    (
+        "a key the `seg:` grammar refuses",
+        |group, refs, records| {
+            let mut rows = rows_of(group, records);
+            rows.push(malformed_row(group));
+            (refs, rows)
+        },
+    ),
+];
+
+#[tokio::test]
+async fn every_anomaly_on_a_generation_the_root_still_names_fails_closed() {
+    for (case, bend) in FAIL_CLOSED {
+        let (meta, chunks, _dir) = backends();
+        let plan = write_flat(&meta, &chunks, 1, "obj", &payload(32, 0), 0x400).await;
+        let group = SegmentGroup::new(NONCE, 1).unwrap();
+        let (refs, records) = split(&plan, 2);
+        let (refs, rows) = bend(&group, refs, &records);
+        seed(&meta, 1, &group, refs, rows).await;
+
+        assert_fails_closed(case, read_object(&meta, &chunks, 1).await);
+    }
+}
+
+/// **A row from another epoch is never spliced into this generation's map.** The resolver
+/// pins the group by parsing every key it consumes — it does not trust the prefix it asked
+/// for to be the prefix it got back. Were it to trust it, the retired generation's segment
+/// 0 here (same extents, *different* chunks) would silently take the live segment 0's
+/// place: an object reading back half someone else's bytes, with every length and offset
+/// still agreeing.
+#[tokio::test]
+async fn a_row_from_another_epoch_is_never_spliced_into_this_generation() {
+    let (redb, chunks, _dir) = backends();
+    let plan = write_flat(&redb, &chunks, 1, "obj", &payload(32, 0), 0x440).await;
+    let group = SegmentGroup::new(NONCE, 1).unwrap();
+    seed_segmented(&redb, 1, &plan, &group, 2).await;
+
+    // A retired generation of the SAME group (one epoch back) whose segment 0 covers the
+    // same byte extent with different chunks — same size payload, other bytes.
+    let retired = write_flat(&redb, &chunks, 2, "retired", &payload(32, 111), 0x445).await;
+    let (_, records) = split(&plan, 2);
+    let (_, other_records) = split(&retired, 2);
+    assert_eq!(other_records[0].byte_len(), records[0].byte_len());
+    let older = SegmentGroup::new(NONCE, 0).unwrap();
+    let (key, value) = row(&older, 0, &other_records[0]);
+    let store = Probe::new(redb, Quirk::Smuggle(key, value));
+
+    assert_fails_closed(
+        "a row from another epoch",
+        read_object(&store, &chunks, 1).await,
+    );
+    // Refusing it is a question about THIS root, answered by reading THIS root — the other
+    // epoch's own record is never fetched to compare against.
+    store.assert_gets_only_the_root_of(1);
+}
+
+/// The resolve-retry rule's **benign** arm, in every shape a reader meets it: the root
+/// moved on (or is gone) while this resolve was in flight (`0016:2452-2471`). Each case
+/// seeds the SAME correct two-segment generation and differs only in what the store does
+/// under the reader — and each must answer ONE whole generation: never a torn map, never
+/// a partial chunk list, and never "this object owns no bytes" for an object that exists.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+enum Retired {
+    /// The root is overwritten by a fresh flat generation ⇒ the read answers ITS bytes.
+    /// The stale-but-complete shape: every segment the reader named is still there, so
+    /// only the root re-check after a *complete* range read can notice the retirement.
+    Overwritten,
+    /// …and the drain has already reclaimed segment 1 of the retired generation — the
+    /// literal "a segment absent" shape of the rule's first arm, where the map the reader
+    /// began can no longer be completed at all.
+    OverwrittenAndDrained,
+    /// …and the retired generation's range still holds an unparsable `seg:` key. Judging
+    /// that where it is noticed — instead of asking whether the root still names this
+    /// generation — answers "corrupt" for an object that is merely being overwritten.
+    OverwrittenWithAMalformedRow,
+    /// The root is deleted ⇒ the read answers no-such-key: never an error, and never a
+    /// zero-length "empty object".
+    Deleted,
+}
+
+#[tokio::test]
+async fn a_generation_retired_mid_resolve_answers_the_live_one_whole() {
+    use Retired::*;
+    for case in [
+        Overwritten,
+        OverwrittenAndDrained,
+        OverwrittenWithAMalformedRow,
+        Deleted,
+    ] {
+        let (redb, chunks, _dir) = backends();
+        let plan = write_flat(&redb, &chunks, 1, "obj", &payload(32, 0), 0x500).await;
+        let group = SegmentGroup::new(NONCE, 1).unwrap();
+        let (refs, records) = split(&plan, 2);
+        let mut rows = rows_of(&group, &records);
+        if case == OverwrittenWithAMalformedRow {
+            rows.push(malformed_row(&group));
+        }
+        seed(&redb, 1, &group, refs, rows).await;
+
+        // What the store does the moment this resolve reaches the group's range.
+        let new_data = payload(32, 200);
+        let mut flip = match case {
+            Deleted => WriteBatch::new().delete(inode_key(1)),
+            _ => pending_flat(&chunks, 1, &new_data, 0x600).await,
+        };
+        if case == OverwrittenAndDrained {
+            flip = flip.delete(seg_key(&group, 1).unwrap());
+        }
+        let expected = (case != Deleted).then_some(new_data);
+
+        let store = Probe::superseding(redb, When::Page, flip);
+        let got = read_object(&store, &chunks, 1).await.unwrap();
+        assert_eq!(got, expected, "{case:?}: must answer the live generation");
+        // Settling "retired or corrupt?" and re-resolving reach for no other key.
+        store.assert_gets_only_the_root_of(1);
+    }
+}
+
+/// **A generation retired under EVERY restart fails closed — bounded, and never "this
+/// object owns no bytes".** The interleaving the restart budget exists for: an object
+/// republished — whole, and resolvable at every instant — faster than a reader can resolve
+/// it, so each snapshot the read takes is retired before its own re-check settles it. The
+/// single-flip races above all end in a restart that *succeeds*; none of them reaches what
+/// happens when restarting stops helping. Three properties in one fixture:
+///
+///  * The read **terminates**. A resolver that simply restarted while the root kept moving
+///    would spin here forever, hanging the suite rather than failing it.
+///  * It fails **closed**, with a resolved typed refusal — not `Ok(None)` (a 404 for an
+///    object that exists whole in every generation, the data-losing answer decision 7(h)
+///    forbids), and not a torn or empty chunk list.
+///  * The budget is the **reader's**: the churn outlasts the read — a generation is retired
+///    under every attempt the reader makes — and the whole read still costs exactly
+///    [`EXHAUSTED_RESOLVE_ROOT_GETS`] root reads.
+///
+/// The control at the end is what separates "the race" from "broken data": with the queue
+/// dry, the SAME store, the SAME object and the SAME `seg:` records read back
+/// byte-identical to the flat payload.
+#[tokio::test]
+async fn a_generation_retired_under_every_restart_fails_closed_and_terminates() {
+    let (redb, chunks, _dir) = backends();
+    let data = payload(32, 0);
+    let plan = write_flat(&redb, &chunks, 1, "obj", &data, 0x540).await;
+    // Generation 1 is what the read starts from; every queued generation republishes the
+    // same chunks under a new epoch.
+    seed_segmented(&redb, 1, &plan, &SegmentGroup::new(NONCE, 1).unwrap(), 2).await;
+    let churn = (2..)
+        .take(CHURN_GENERATIONS)
+        .map(|epoch| segmented_generation(1, &plan, epoch));
+
+    let store = Probe::superseding_each_generation(redb, churn);
+    assert_fails_closed(
+        "retired under every restart",
+        read_object(&store, &chunks, 1).await,
+    );
+    // The restart budget belongs to the READER: a root that keeps moving may not buy
+    // itself more re-reads, and giving up is bounded work, not a spin.
+    store.assert_root_gets(1, EXHAUSTED_RESOLVE_ROOT_GETS);
+
+    // The control. Nothing was ever wrong with the records: with the overwrites stopped
+    // the same store resolves the live generation, so the refusal above was the churn.
+    let got = read_object(&store, &chunks, 1).await.unwrap();
+    assert_eq!(
+        got,
+        Some(data),
+        "the same store resolves once the churn stops"
+    );
+}
+
+/// **Chunks are ordered by the parsed index, never by page-arrival order.** A page
+/// deliberately handed back in REVERSED order still reads back byte-identical, proving the
+/// resolver sorts on the parsed key, not on whatever order the store returned.
+#[tokio::test]
+async fn chunks_are_ordered_by_parsed_index_not_by_page_arrival_order() {
+    let (redb, chunks, _dir) = backends();
+    let data = payload(60, 0);
+    let plan = write_flat(&redb, &chunks, 1, "obj", &data, 0x700).await;
+    seed_segmented(&redb, 1, &plan, &SegmentGroup::new(NONCE, 1).unwrap(), 3).await;
+
+    let store = Probe::new(redb, Quirk::Reverse);
+    let got = read_object(&store, &chunks, 1).await.unwrap();
+    assert_eq!(got, Some(data), "chunks splice in PARSED-index order");
+    store.assert_root_gets(1, CLEAN_RESOLVE_ROOT_GETS);
+}
