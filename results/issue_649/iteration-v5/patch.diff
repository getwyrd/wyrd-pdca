+/// **A generation retired under EVERY restart fails closed — bounded, and never "this
+/// object owns no bytes".** The interleaving the restart budget exists for: an object
+/// republished — whole, and resolvable at every instant — faster than a reader can
+/// resolve it, so each snapshot the read takes is retired before its own re-check
+/// settles it. The single-flip races above all end in a restart that *succeeds*; none of
+/// them reaches what happens when restarting stops helping. Three properties in one
+/// fixture:
+///
+///  * The read **terminates**. A resolver that simply restarted while the root kept
+///    moving would spin here forever, hanging the suite rather than failing it.
+///  * It fails **closed**, with a resolved typed refusal — not `Ok(None)` (a 404 for an
+///    object that exists whole in every generation, the data-losing answer decision 7(h)
+///    forbids), and not a torn or empty chunk list.
+///  * The budget is the **reader's**: the churn outlasts the read — a generation is
+///    retired under every attempt the reader makes — and the whole read still costs
+///    exactly [`EXHAUSTED_RESOLVE_ROOT_GETS`] root reads.
+///
+/// The control at the end is what separates "the race" from "broken data": with the
+/// queue dry, the SAME store, the SAME object and the SAME `seg:` records read back
+/// byte-identical to the flat payload.
+#[tokio::test]
+async fn a_generation_retired_under_every_restart_fails_closed_and_terminates() {
+    let (redb, chunks, _dir) = backends();
+    let data = payload(32, 0);
+    let plan = write_flat(&redb, &chunks, 1, "obj", &data, 0x540).await;
+    // Generation 1 is what the read starts from; every queued generation republishes the
+    // same chunks under a new epoch.
+    reshape_into_segments(&redb, 1, &plan, &SegmentGroup::new(NONCE, 1).unwrap(), 2).await;
+    let churn = (2..)
+        .take(CHURN_GENERATIONS)
+        .map(|epoch| segmented_generation(1, &plan, epoch));
+
+    let store = Probe::superseding_each_generation(redb, churn);
+    let err = read_object(&store, &chunks, 1)
+        .await
+        .expect_err("a resolution that never settles must fail closed for THIS object");
+    assert_resolved_typed_refusal(err);
+    assert_eq!(
+        store.assert_gets_only_the_root_of(1),
+        EXHAUSTED_RESOLVE_ROOT_GETS,
+        "the restart budget belongs to the READER: a root that keeps moving may not buy \
+         itself more re-reads, and giving up is bounded work, not a spin"
+    );
+
+    // The control. Nothing was ever wrong with the records: the object still reads back
+    // whole from the generation the churn left live.
+    let got = read_object(&store, &chunks, 1)
+        .await
+        .unwrap()
+        .expect("the object exists in every generation");
+    assert_eq!(
+        got, data,
+        "with the overwrites stopped the same store resolves the live generation — the \
+         refusal above was the churn, never the data"
+    );
+}
+
+/// **A row from another epoch is never spliced into this generation's map.** The
+/// resolver pins the group by parsing every key it consumes — it does not trust the
+/// prefix it asked for to be the prefix it got back. Were it to trust it, the retired
+/// generation's segment 0 here (same extents, *different* chunks) would silently take
+/// the live segment 0's place: an object reading back half someone else's bytes, with
+/// every length and offset still agreeing.
+#[tokio::test]
+async fn a_row_from_another_epoch_is_never_spliced_into_this_generation() {
+    let (redb, chunks, _dir) = backends();
+    let data = payload(32, 0);
+    let plan = write_flat(&redb, &chunks, 1, "obj", &data, 0x440).await;
+    let (group, refs, records) = two_segments(&plan);
+    commit_segmented(
+        &redb,
+        1,
+        &group,
+        refs,
+        vec![row(&group, 0, &records[0]), row(&group, 1, &records[1])],
+    )
+    .await;
+
+    // A retired generation of the SAME group (one epoch back) whose segment 0 covers
+    // the same byte extent with different chunks — same size payload, other bytes.
+    let retired = write_flat(&redb, &chunks, 2, "retired", &payload(32, 111), 0x445).await;
+    let (_, _, other_records) = two_segments(&retired);
+    assert_eq!(other_records[0].byte_len(), records[0].byte_len());
+    let older = SegmentGroup::new(NONCE, 0).unwrap();
+    let store = Probe::new(
+        redb,
+        Quirk::Smuggle(
+            seg_key(&older, 0).unwrap(),
+            encode(&SegmentRecord::new(other_records[0].chunks().to_vec(), 0).unwrap()),
+        ),
+    );
+
+    let err = read_object(&store, &chunks, 1)
+        .await
+        .expect_err("a row keyed to another epoch must never enter this resolution");
+    assert_resolved_typed_refusal(err);
+    // Refusing it is a question about THIS root, answered by reading THIS root — the
+    // other epoch's own record is never fetched to compare against.
+    store.assert_gets_only_the_root_of(1);
+}
+
+/// **Chunks are ordered by the parsed index, never by page-arrival order.** A page
+/// deliberately handed back in REVERSED order still reads back byte-identical, proving
+/// the resolver sorts on the parsed key, not on whatever order the store returned.
+#[tokio::test]
+async fn chunks_are_ordered_by_parsed_index_not_by_page_arrival_order() {
+    let (redb, chunks, _dir) = backends();
+    let data = payload(60, 0);
+    let plan = write_flat(&redb, &chunks, 1, "obj", &data, 0x700).await;
+    let group = SegmentGroup::new(NONCE, 1).unwrap();
+    reshape_into_segments(&redb, 1, &plan, &group, 3).await;
+
+    let store = Probe::new(redb, Quirk::Reverse);
+    let got = read_object(&store, &chunks, 1)
+        .await
+        .unwrap()
+        .expect("a shuffled page order must not change the resolved object");
+    assert_eq!(
+        got, data,
+        "chunks must splice in PARSED-index order despite reversed page order"
+    );
+    assert_eq!(
+        store.assert_gets_only_the_root_of(1),
+        CLEAN_RESOLVE_ROOT_GETS,
+        "re-ordering the page changes nothing about what the resolve costs"
+    );
+}
