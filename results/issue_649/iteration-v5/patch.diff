+/// **root unchanged + ONE extent coordinate disagrees — the length ⇒ fail closed.** A
+/// single-segment root claims one byte more than the record it names actually carries:
+/// same start, different length. The refusal must be the **resolver's** typed one, not
+/// a later size check downstream — a map the resolver passed on as agreeing is already
+/// the under-approximation C-1 forbids, whoever notices it afterwards.
+#[tokio::test]
+async fn root_unchanged_extent_len_only_mismatch_fails_closed() {
+    let (meta, chunks, _dir) = backends();
+    let plan = write_flat(&meta, &chunks, 1, "obj", &payload(32, 0), 0x435).await;
+    let group = SegmentGroup::new(NONCE, 1).unwrap();
+    let whole = SegmentRecord::new(plan.chunk_refs(), 0).unwrap();
+    commit_segmented(
+        &meta,
+        1,
+        &group,
+        vec![SegmentRef {
+            index: 0,
+            byte_offset: 0, // start agrees
+            byte_len: whole.byte_len() + 1,
+        }],
+        vec![row(&group, 0, &whole)],
+    )
+    .await;
+
+    let err = read_object(&meta, &chunks, 1)
+        .await
+        .expect_err("a segment whose recorded LENGTH disagrees with the root must fail closed");
+    assert_resolved_typed_refusal(err);
+}
