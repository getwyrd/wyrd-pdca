+/// **root unchanged + ONE extent coordinate disagrees — the offset ⇒ fail closed.** The
+/// root's table is exactly right and segment 1 holds exactly the right chunks; only its
+/// recorded *start* is a byte off. A resolver that refused a mismatch merely when
+/// **both** coordinates disagreed would hand this map back as if the two descriptions
+/// agreed — the quiet misdescription this check exists to catch.
+#[tokio::test]
+async fn root_unchanged_extent_offset_only_mismatch_fails_closed() {
+    let (meta, chunks, _dir) = backends();
+    let plan = write_flat(&meta, &chunks, 1, "obj", &payload(32, 0), 0x430).await;
+    let (group, refs, records) = two_segments(&plan);
+    let shifted = SegmentRecord::new(
+        records[1].chunks().to_vec(),
+        records[1].byte_offset() + 1, // one byte later than the root places it
+    )
+    .unwrap();
+    assert_eq!(shifted.byte_len(), refs[1].byte_len, "length agrees");
+    commit_segmented(
+        &meta,
+        1,
+        &group,
+        refs,
+        vec![row(&group, 0, &records[0]), row(&group, 1, &shifted)],
+    )
+    .await;
+
+    let err = read_object(&meta, &chunks, 1)
+        .await
+        .expect_err("a segment whose recorded START disagrees with the root must fail closed");
+    assert_resolved_typed_refusal(err);
+}
