+/// **root unchanged + a malformed key in the range ⇒ fail closed.**
+#[tokio::test]
+async fn root_unchanged_malformed_seg_key_fails_closed() {
+    let (meta, chunks, _dir) = backends();
+    let plan = write_flat(&meta, &chunks, 1, "obj", &payload(32, 0), 0x450).await;
+    let (group, refs, records) = two_segments(&plan);
+    commit_segmented(
+        &meta,
+        1,
+        &group,
+        refs,
+        vec![
+            row(&group, 0, &records[0]),
+            row(&group, 1, &records[1]),
+            malformed_row(&group),
+        ],
+    )
+    .await;
+
+    let err = read_object(&meta, &chunks, 1)
+        .await
+        .expect_err("an unparsable key in a LIVE generation's range must fail closed");
+    assert_resolved_typed_refusal(err);
+}
