+    /// A store that retires the generation a reader is resolving at every **new** `seg:`
+    /// range it opens: the first page of each distinct range publishes the next complete
+    /// generation from `pending`, so the snapshot the resolver took a moment ago is
+    /// already stale when its own root re-check runs. That is the one interleaving
+    /// [`MAX_RESOLVE_RESTARTS`] exists for — an object republished faster than any reader
+    /// can resolve it.
+    ///
+    /// Retiring per *range* rather than per *page* keeps the fixture independent of how
+    /// many pages a group takes, and the queue is finite: once dry the store falls quiet,
+    /// so the same records resolve — which is what proves the refusal below is the churn
+    /// and not a record this store could not read.
+    struct Churn {
+        inner: wyrd_metadata_redb::RedbMetadataStore,
+        pending: std::sync::Mutex<std::collections::VecDeque<WriteBatch>>,
+        opened: std::sync::Mutex<Vec<Vec<u8>>>,
+        gets: std::sync::Mutex<Vec<Vec<u8>>>,
+    }
+
+    impl Churn {
+        fn new(
+            inner: wyrd_metadata_redb::RedbMetadataStore,
+            pending: impl IntoIterator<Item = WriteBatch>,
+        ) -> Self {
+            Self {
+                inner,
+                pending: std::sync::Mutex::new(pending.into_iter().collect()),
+                opened: std::sync::Mutex::new(Vec::new()),
+                gets: std::sync::Mutex::new(Vec::new()),
+            }
+        }
+
+        /// The next generation to publish, or `None` for a range already retired on (a
+        /// later page of the same walk) — taken out of both mutexes before any await.
+        fn retire_next(&self, prefix: &[u8]) -> Option<WriteBatch> {
+            let mut opened = self.opened.lock().unwrap();
+            if opened.iter().any(|seen| seen == prefix) {
+                return None;
