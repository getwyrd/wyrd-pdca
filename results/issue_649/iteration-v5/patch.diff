+/// so a single fragment resolves through the identity placement fallback onto server 0)
+/// then reshape it into the SEGMENTED spelling directly — raw `seg:` records plus a
+/// segmented root, written by hand, never via a committer (this slice ships no
+/// producer). Returns the group the segments are keyed by, so the campaign can retire
+/// one of its records the way a drain would.
+async fn seed_segmented(meta: &MemMeta, fleet: &Fleet<'_>, data: &[u8]) -> metadata::SegmentGroup {
+    let mut next = 0u128;
+    let plan = write::plan_write(data, 4, EcScheme::None, || {
+        next += 1;
+        next
+    })
+    .unwrap();
+    write::intent(meta, &plan, 1_000).await.unwrap();
+    write::write_fragments(fleet, &plan).await.unwrap();
+    assert_eq!(
+        write::commit_create(meta, ROOT, "obj", INODE, &plan, 0)
+            .await
+            .unwrap(),
+        CommitOutcome::Committed
