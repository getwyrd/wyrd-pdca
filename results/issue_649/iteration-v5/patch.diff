+    fn segmented_generation(inode_id: InodeId, epoch: u64) -> WriteBatch {
+        let group = SegmentGroup::new(NONCE, epoch).unwrap();
+        let first = SegmentRecord::new(vec![chunk_of_len(1, 5)], 0).unwrap();
+        let second = SegmentRecord::new(vec![chunk_of_len(2, 7)], 5).unwrap();
