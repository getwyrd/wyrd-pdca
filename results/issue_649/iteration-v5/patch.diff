+        // would spin a reader forever. Past the budget the honest answer is a typed error
+        // about THIS object: answering `Ok(None)` instead would tell a caller "this object
+        // owns no bytes" about an object that is whole in every generation — a maintenance
+        // pass would then protect nothing of it and a reader would 404 it (decision 7(h),
+        // `0016:2463-2471`; C-1, `docs/principles.md` §5).
+        let inner = store();
+        pollster::block_on(inner.commit(segmented_generation(2, 1))).unwrap();
+        // ONE queued generation per attempt the reader may make, and not one more: the
+        // queue runs dry immediately after the budget does, so a WIDER budget resolves the
+        // last generation cleanly and this call answers `Ok` instead of failing closed.
+        let churn =
+            (2..=MAX_RESOLVE_RESTARTS as u64 + 1).map(|epoch| segmented_generation(2, epoch));
