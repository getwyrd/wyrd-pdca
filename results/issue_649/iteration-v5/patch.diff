+                    index: 0,
+                    byte_offset: 0,
+                    byte_len: 5,
+                },
+                SegmentRef {
+                    index: 1,
+                    byte_offset: 5,
+                    byte_len: 7,
+                },
+            ],
+        )
+        .unwrap();
