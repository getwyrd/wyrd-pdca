@@ -0,0 +1,290 @@
+//! The maintenance plane's shared door onto a committed object's chunk list, and the
+//! shared decode arm every `scan("inode:")` loop needs (proposal 0016 decision 7(e),
+//! `0016:2393-2415`).
+//!
+//! [`chunks_of`] is the thin wrapper: every custodian pass that used to walk
+//! `record.chunk_map` directly must instead resolve through here, so a **segmented**
+//! map (decision 7(a)) is read by *all* of them or by none — never wired into the read
+//! path alone while a maintenance pass still reads the raw field. It resolves against
+//! the **live** root ([`metadata::resolve_current_chunk_map`]), never the pass's own
+//! scan snapshot: a `scan("inode:")` walk over a large store is minutes old by the time
+//! it reaches its last record, and a pass that trusted that snapshot for a segmented
+//! object would silently protect a superseded generation's fragments while omitting the
+//! live one's — the shape of the recorded #508-attempt-4 failure.
+//!
+//! [`classify_root`] is the other half every walk needs: a `scan("inode:")` pass that
+//! propagated an undecodable record's error would let one damaged object end the whole
+//! pass — every *other* object's availability and protection lost with it. So the
+//! decode arm lives here, once, and hands back a [`Root`] the caller matches on rather
+//! than a bare `?`.
+//!
+//! This slice lands the wrapper and the classifier with their own unit coverage; the
+//! passes that call them (GC, backfill, restore, rebalance, reconstruction) land in
+//! #650/#651 — wiring a shared primitive into six loops is that pass's own change, not
+//! this one's.
+
+use wyrd_core::metadata::{self, ChunkRef, InodeRecord};
+use wyrd_traits::{BoxError, MetadataStore, Result};
+
+/// One committed inode's chunk list, resolved against the **live** root — never a
+/// pass's own (possibly stale) scan snapshot (decision 7(h), `0016:2463-2471`).
+pub struct LiveMap {
+    /// The live root the chunks were resolved from.
+    pub record: InodeRecord,
+    /// That generation's ordered chunk list.
+    pub chunks: Vec<ChunkRef>,
+}
+
+/// Resolve one `inode:<id>` key's chunk list against the live root, or `None` if the
+/// object has no live committed generation (deleted, or not yet committed) — the
+/// maintenance plane's one door onto [`metadata::resolve_current_chunk_map`], which
+/// re-reads the root itself so the answer is about the generation the store holds
+/// *now*, for a flat and a segmented map alike.
+pub async fn chunks_of(meta: &dyn MetadataStore, inode_key: &[u8]) -> Result<Option<LiveMap>> {
+    let Some(current) = metadata::resolve_current_chunk_map(meta, inode_key).await? else {
+        return Ok(None);
+    };
+    Ok(Some(LiveMap {
+        record: current.record,
+        chunks: current.chunks,
+    }))
+}
+
+/// One `inode:` value from a maintenance walk's `scan`, classified by [`classify_root`].
+pub enum Root {
+    /// The bytes decoded.
+    Decoded(InodeRecord),
+    /// The bytes did not decode: the object's own fault, contained here rather than
+    /// propagated, so one damaged record cannot end a walk for every other object.
+    Unresolvable(ChunkMapFault),
+}
+
+/// One object's record that could not be decoded, attributed rather than dropped
+/// silently.
+pub struct ChunkMapFault {
+    object: Vec<u8>,
+    err: BoxError,
+}
+
+impl ChunkMapFault {
+    /// Attribute the fault on the durability-plane audit seam (ADR-0011 / ADR-0012) and
+    /// hand back the blocker — the inode key — for the pass to record. Consuming `self`
+    /// is the point: a fault is attributed exactly once, by the pass that contained it,
+    /// so a blocker can neither be recorded silently nor emitted twice for one object.
+    pub fn attribute(self, pass: &'static str) -> Vec<u8> {
+        tracing::warn!(
+            monotonic_counter.custodian_unresolvable_chunk_map = 1_u64,
+            pass
+        );
+        tracing::warn!(
+            target: "wyrd.custodian.audit",
+            action = "unresolvable-chunk-map",
+            pass,
+            inode = %String::from_utf8_lossy(&self.object),
+            error = %self.err,
+            "a committed object's record could not be read; this pass acts on nothing \
+             of it and every other object is unaffected — operator signal",
+        );
+        self.object
+    }
+}
+
+/// **The decode arm of every `scan("inode:")` loop.** A record this cannot decode is
+/// that object's own fault — contained here rather than propagated and ending the walk
+/// for every other object, the same per-object containment boundary a resolve draws
+/// (`metadata::ChunkMapError`). This never fails: the store read that produced `value`
+/// already succeeded, so a decode failure on these bytes is unambiguously the record's
+/// own, never a store fault the caller has no view of.
+pub fn classify_root(key: &[u8], value: &[u8]) -> Root {
+    match metadata::decode::<InodeRecord>(value) {
+        Ok(record) => Root::Decoded(record),
+        Err(err) => Root::Unresolvable(ChunkMapFault {
+            object: key.to_vec(),
+            err,
+        }),
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use std::collections::HashMap;
+    use std::sync::Mutex;
+
+    use async_trait::async_trait;
+    use bytes::Bytes;
+    use wyrd_core::metadata::{
+        encode, inode_key, seg_key, ChunkMap, EcScheme, InodeRecord, InodeState, SegmentGroup,
+        SegmentRecord, SegmentRef, SegmentedMap,
+    };
+    use wyrd_traits::{CommitOutcome, WriteBatch};
+
+    use super::*;
+
+    /// A minimal in-memory [`MetadataStore`] double (ADR-0010: this crate depends on
+    /// no concrete backend, in tests either — `wyrd-testkit`'s paged-scan helper is the
+    /// dev-only escape hatch every such double shares, mirroring
+    /// `crates/custodian/tests/gc.rs`'s own).
+    #[derive(Default)]
+    struct MemMeta {
+        kv: Mutex<HashMap<Vec<u8>, Bytes>>,
+    }
+
+    #[async_trait]
+    impl MetadataStore for MemMeta {
+        async fn get(&self, key: &[u8]) -> Result<Option<Bytes>> {
+            Ok(self.kv.lock().unwrap().get(key).cloned())
+        }
+
+        async fn scan(&self, prefix: &[u8]) -> Result<Vec<(Vec<u8>, Bytes)>> {
+            Ok(self
+                .kv
+                .lock()
+                .unwrap()
+                .iter()
+                .filter(|(k, _)| k.starts_with(prefix))
+                .map(|(k, v)| (k.clone(), v.clone()))
+                .collect())
+        }
+
+        async fn scan_page(
+            &self,
+            prefix: &[u8],
+            after: Option<&[u8]>,
+            limit: usize,
+        ) -> Result<wyrd_traits::ScanPage> {
+            wyrd_testkit::test_double_scan_page(self, prefix, after, limit).await
+        }
+
+        async fn commit(&self, batch: WriteBatch) -> Result<CommitOutcome> {
+            let mut kv = self.kv.lock().unwrap();
+            for pre in &batch.preconditions {
+                if kv.get(&pre.key).cloned() != pre.expected {
+                    return Ok(CommitOutcome::Conflict);
+                }
+            }
+            for (k, v) in batch.puts {
+                kv.insert(k, v);
+            }
+            for k in batch.deletes {
+                kv.remove(&k);
+            }
+            Ok(CommitOutcome::Committed)
+        }
+    }
+
+    fn flat_chunk(id: u128, len: u64) -> ChunkRef {
+        ChunkRef {
+            id,
+            scheme: EcScheme::None,
+            len,
+            placement: Vec::new(),
+        }
+    }
+
+    #[tokio::test]
+    async fn chunks_of_resolves_a_flat_map_with_no_extra_read() {
+        let meta = MemMeta::default();
+        let record = InodeRecord {
+            size: 3,
+            chunk_map: vec![flat_chunk(1, 3)].into(),
+            state: InodeState::Committed,
+            version: 1,
+            ..Default::default()
+        };
+        meta.commit(WriteBatch::new().put(inode_key(1), encode(&record)))
+            .await
+            .unwrap();
+
+        let live = chunks_of(&meta, &inode_key(1))
+            .await
+            .unwrap()
+            .expect("a live committed generation");
+        assert_eq!(live.record, record);
+        assert_eq!(live.chunks, vec![flat_chunk(1, 3)]);
+    }
+
+    #[tokio::test]
+    async fn chunks_of_resolves_a_segmented_map_from_its_seg_records() {
+        let meta = MemMeta::default();
+        let group = SegmentGroup::new("0123456789abcdef0123456789abcdef", 1).unwrap();
+        let first = SegmentRecord::new(vec![flat_chunk(1, 3)], 0).unwrap();
+        let second = SegmentRecord::new(vec![flat_chunk(2, 4)], 3).unwrap();
+        let table = SegmentedMap::new(
+            group.clone(),
+            vec![
+                SegmentRef {
+                    index: 0,
+                    byte_offset: 0,
+                    byte_len: 3,
+                },
+                SegmentRef {
+                    index: 1,
+                    byte_offset: 3,
+                    byte_len: 4,
+                },
+            ],
+        )
+        .unwrap();
+        let record = InodeRecord {
+            size: 7,
+            chunk_map: ChunkMap::Segmented(table),
+            state: InodeState::Committed,
+            version: 1,
+            ..Default::default()
+        };
+        let batch = WriteBatch::new()
+            .put(seg_key(&group, 0).unwrap(), encode(&first))
+            .put(seg_key(&group, 1).unwrap(), encode(&second))
+            .put(inode_key(1), encode(&record));
+        assert_eq!(meta.commit(batch).await.unwrap(), CommitOutcome::Committed);
+
+        let live = chunks_of(&meta, &inode_key(1))
+            .await
+            .unwrap()
+            .expect("a live committed generation");
+        assert_eq!(live.chunks, vec![flat_chunk(1, 3), flat_chunk(2, 4)]);
+    }
+
+    #[tokio::test]
+    async fn chunks_of_answers_none_for_a_deleted_or_uncommitted_object() {
+        let meta = MemMeta::default();
+        // Deleted / never written.
+        assert!(chunks_of(&meta, &inode_key(9)).await.unwrap().is_none());
+
+        // Pending (not yet committed).
+        let pending = InodeRecord::new_empty();
+        assert_eq!(pending.state, InodeState::Pending);
+        meta.commit(WriteBatch::new().put(inode_key(9), encode(&pending)))
+            .await
+            .unwrap();
+        assert!(chunks_of(&meta, &inode_key(9)).await.unwrap().is_none());
+    }
+
+    #[test]
+    fn classify_root_decodes_a_well_formed_record() {
+        let record = InodeRecord {
+            size: 1,
+            chunk_map: vec![flat_chunk(1, 1)].into(),
+            state: InodeState::Committed,
+            version: 1,
+            ..Default::default()
+        };
+        match classify_root(&inode_key(1), &encode(&record)) {
+            Root::Decoded(decoded) => assert_eq!(decoded, record),
+            Root::Unresolvable(_) => panic!("a well-formed record must decode"),
+        }
+    }
+
+    /// A record no other object's pass may lose over: the byte-`0x00` value below
+    /// decodes as neither JSON nor anything this class recognises.
+    #[test]
+    fn classify_root_contains_an_undecodable_record_rather_than_erroring() {
+        match classify_root(&inode_key(1), b"\x00not json") {
+            Root::Unresolvable(fault) => {
+                let blocker = fault.attribute("gc");
+                assert_eq!(blocker, inode_key(1));
+            }
+            Root::Decoded(_) => panic!("malformed bytes must not decode"),
+        }
+    }
+}
