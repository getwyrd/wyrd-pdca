+//! The shared chunk-map resolver (issue #649, proposal 0016 decision 7(e)/(h)), proved
+//! through the **base-visible** whole-object read entries — [`read_object`] /
+//! [`read_path`] — over a segmented object seeded as raw `seg:` records plus a
+//! segmented root, **never via a committer** (this slice ships no producer). Every
+//! object here is built by hand: a genuine flat write (real fragments, via
+//! `wyrd_core::write`) reshaped into the segmented spelling by a raw `WriteBatch`, so
+//! `.chunk_map` is segmented before a single read touches it.
+//!
+//! RED on `origin/main` (with `crates/core/src/metadata.rs`/`read.rs` and
+//! `crates/custodian/src/resolve.rs` reverted): a segmented root still **decodes**
+//! (#648's contribution) but every read here fails or panics resolving it — these are
+//! assertion failures, not compile failures, because every imported symbol
+//! (`seg_key`/`SegmentRecord`/`SegmentedMap`/… ) is base-visible from #648.
+//!
+//! Nothing this patch adds (`resolve_chunk_map`, `MapResolution`, the new
+//! `ChunkMapError` variants, …) is imported: criteria (2)-(3) are observed through the
+//! read path plus the instrumented store doubles below, never by naming the resolver.
+
+#![forbid(unsafe_code)]
+
+use std::collections::VecDeque;
+use std::sync::Mutex;
+
+use async_trait::async_trait;
+use bytes::Bytes;
+use wyrd_chunkstore_fs::FsChunkStore;
+use wyrd_core::metadata::{
+    encode, inode_key, seg_key, seg_range_prefix, ChunkMap, ChunkMapError, EcScheme, InodeRecord,
+    InodeState, SegmentGroup, SegmentRecord, SegmentRef, SegmentedMap, MAX_ROOT_SEGMENTS,
+    SEG_PREFIX,
+};
+use wyrd_core::read::{read_object, read_path};
+use wyrd_core::write;
+use wyrd_metadata_redb::RedbMetadataStore;
+use wyrd_traits::{BoxError, CommitOutcome, MetadataStore, Result, ScanPage, WriteBatch};
+
+/// Assert `err` is a **typed, resolved** refusal — never the base's blanket "nothing
+/// can resolve a segmented map yet" ([`ChunkMapError::SegmentedMapUnsupported`], the
+/// ONLY error `.chunk_map` sites raised before this patch). `SegmentedMapUnsupported`
+/// is base-visible (#648) and named here deliberately: without this check, a "the read
+/// must fail" assertion would pass equally well pre-fix (every segmented map is
+/// refused, unconditionally) and post-fix (this ONE anomaly is refused, resolved),
+/// which is not a fix-discriminating assertion. The new variant this anomaly actually
+/// raises is not named — nothing this patch adds is imported (Test file constraint) —
+/// so the discriminator is "resolved AND typed AND not the blanket refusal", not which
+/// spelling of that. It is also what separates a refusal made **by the resolver** from
+/// one a later stage happens to make on its behalf: a downstream size check
+/// (`ReadError::SizeMismatch`) is not a `ChunkMapError` and fails this assertion, so a
+/// resolution that leaks an under-described map to the byte layer cannot pass as
+/// "fails closed".
+fn assert_resolved_typed_refusal(err: BoxError) {
+    let typed = err.downcast_ref::<ChunkMapError>().unwrap_or_else(|| {
+        panic!("a resolve failure must surface as a typed ChunkMapError, got: {err}")
+    });
+    assert!(
+        !matches!(typed, ChunkMapError::SegmentedMapUnsupported { .. }),
+        "must be refused by the NEW resolver's own typed anomaly, not the base's blanket \
+         'this build cannot yet resolve a segmented map' refusal: {err}"
+    );
+}
+
+const ROOT: u64 = 0;
+const NOW: u64 = 1_000;
+const TTL: u64 = 5_000;
+const CHUNK: usize = 4;
+/// A 32-lowercase-hex nonce, exactly [`wyrd_core::metadata::SEG_NONCE_HEX_LEN`] chars.
+const NONCE: &str = "0123456789abcdef0123456789abcdef";
+/// A second, distinct nonce — a group that must never be touched resolving the first.
+const OTHER_NONCE: &str = "fedcba9876543210fedcba9876543210";
+
+fn backends() -> (RedbMetadataStore, FsChunkStore, tempfile::TempDir) {
+    let meta = RedbMetadataStore::in_memory().expect("in-memory redb");
+    let dir = tempfile::tempdir().expect("temp dir");
+    let chunks = FsChunkStore::open(dir.path()).expect("fs chunk store");
+    (meta, chunks, dir)
+}
+
+fn ids_from(base: u128) -> impl FnMut() -> u128 {
+    let mut n = base;
+    move || {
+        n += 1;
+        n
+    }
+}
+
+/// `n` deterministic bytes from `base` — two payloads built with different `base`
+/// values never share a byte, so *which* generation answered a read is decidable from
+/// the bytes alone.
+fn payload(n: u32, base: u32) -> Vec<u8> {
+    (0..n).map(|i| ((i + base) % 251) as u8).collect()
+}
+
+/// Plan, fan out and commit a genuine **flat** object at `inode_id`/`name` — real
+/// fragments on disk, via the ordinary single-shot write path (`wyrd_core::write`),
+/// exactly as every pre-existing flat object is built. Returns the plan so its
+/// `chunk_refs()`/`size` are in hand without reading the record back.
+async fn write_flat(
+    meta: &RedbMetadataStore,
+    chunks: &FsChunkStore,
+    inode_id: u64,
+    name: &str,
+    data: &[u8],
+    id_base: u128,
+) -> write::WritePlan {
+    let mut next = ids_from(id_base);
+    let plan = write::plan_write(data, CHUNK, EcScheme::None, &mut next).expect("plan");
+    write::intent(meta, &plan, NOW + TTL).await.expect("intent");
+    write::write_fragments(chunks, &plan)
+        .await
+        .expect("fan out");
+    assert_eq!(
+        write::commit_create(meta, ROOT, name, inode_id, &plan, NOW)
+            .await
+            .expect("commit"),
+        CommitOutcome::Committed
+    );
+    write::release(meta, &plan).await.expect("release");
+    plan
+}
+
+/// Overwrite `inode_id`'s root with the **segmented** spelling of `plan`'s chunks,
+/// split into `n` segments, keyed by `group` — a raw `WriteBatch`, never a committer
+/// (this slice ships no producer).
+async fn reshape_into_segments(
+    meta: &RedbMetadataStore,
+    inode_id: u64,
+    plan: &write::WritePlan,
+    group: &SegmentGroup,
+    n: usize,
+) {
+    let chunks = plan.chunk_refs();
+    assert!(n >= 2 && n <= chunks.len(), "fixture needs a real split");
+    let per = chunks.len().div_ceil(n);
+    let mut refs = Vec::new();
+    let mut rows = Vec::new();
+    let mut offset = 0u64;
+    for (index, part) in chunks.chunks(per).enumerate() {
+        let record = SegmentRecord::new(part.to_vec(), offset).expect("segment record");
+        refs.push(SegmentRef {
+            index: index as u32,
+            byte_offset: offset,
+            byte_len: record.byte_len(),
+        });
+        offset += record.byte_len();
+        rows.push(row(group, index as u32, &record));
+    }
+    commit_segmented(meta, inode_id, group, refs, rows).await;
+}
+
+/// The **correct** two-segment spelling of `plan`: the group, the root's segment table,
+/// and the two records that satisfy it. Every fail-closed fixture below starts from
+/// this and bends exactly ONE thing, so what each test differs by *is* the property it
+/// binds.
+fn two_segments(plan: &write::WritePlan) -> (SegmentGroup, Vec<SegmentRef>, Vec<SegmentRecord>) {
+    let chunks = plan.chunk_refs();
+    let (a, b) = chunks.split_at(chunks.len() / 2);
+    let first = SegmentRecord::new(a.to_vec(), 0).expect("segment record");
+    let second = SegmentRecord::new(b.to_vec(), first.byte_len()).expect("segment record");
+    let refs = vec![
+        SegmentRef {
+            index: 0,
+            byte_offset: 0,
+            byte_len: first.byte_len(),
+        },
+        SegmentRef {
+            index: 1,
+            byte_offset: first.byte_len(),
+            byte_len: second.byte_len(),
+        },
+    ];
+    (
+        SegmentGroup::new(NONCE, 1).expect("group"),
+        refs,
+        vec![first, second],
+    )
+}
+
+/// One raw `seg:` row: the canonical key for `index` and the encoded record.
+fn row(group: &SegmentGroup, index: u32, record: &SegmentRecord) -> (Vec<u8>, Bytes) {
+    (
+        seg_key(group, index).expect("addressable index"),
+        encode(record),
+    )
+}
+
+/// The raw batch publishing a segmented root at `inode_id` over `refs`, plus **exactly**
+/// the `rows` given — raw keys and values, never a committer, so a fixture can omit a
+/// named segment, corrupt one, key one to another group, or leave one the table does not
+/// name. The root's `size` is the table's own span (the decode invariant), so the
+/// object's size is never the thing under test.
+fn segmented_batch(
+    inode_id: u64,
+    group: &SegmentGroup,
+    refs: Vec<SegmentRef>,
+    rows: Vec<(Vec<u8>, Bytes)>,
+    version: u64,
+) -> WriteBatch {
+    let table = SegmentedMap::new(group.clone(), refs).expect("segment table");
+    let mut batch = WriteBatch::new().put(
+        inode_key(inode_id),
+        encode(&InodeRecord {
+            size: table.span(),
+            chunk_map: ChunkMap::Segmented(table),
+            state: InodeState::Committed,
+            version,
+            ..Default::default()
+        }),
+    );
+    for (key, value) in rows {
+        batch = batch.put(key, value);
+    }
+    batch
+}
+
+/// Commit [`segmented_batch`] — the seeding form every fixture below starts from.
+async fn commit_segmented(
+    meta: &RedbMetadataStore,
+    inode_id: u64,
+    group: &SegmentGroup,
+    refs: Vec<SegmentRef>,
+    rows: Vec<(Vec<u8>, Bytes)>,
+) {
+    assert_eq!(
+        meta.commit(segmented_batch(inode_id, group, refs, rows, 1))
+            .await
+            .expect("seed the segmented root"),
+        CommitOutcome::Committed
+    );
+}
+
+/// A pending mutation publishing a **complete** further segmented generation of
+/// `inode_id`: a new epoch of [`NONCE`], `plan`'s own chunks, and the `seg:` rows that
+/// satisfy the table — all in ONE batch, exactly as a publisher must (the root moves
+/// last, `0016:2452-2462`). Every generation resolves perfectly on its own and carries
+/// the SAME bytes as the one it replaced, so nothing about the data can explain a
+/// refusal: the only thing that changes across them is the generation the root names.
+fn segmented_generation(inode_id: u64, plan: &write::WritePlan, epoch: u64) -> WriteBatch {
+    let (_, refs, records) = two_segments(plan);
+    let group = SegmentGroup::new(NONCE, epoch).expect("group");
+    let rows = records
+        .iter()
+        .enumerate()
+        .map(|(index, record)| row(&group, index as u32, record))
+        .collect();
+    segmented_batch(inode_id, &group, refs, rows, epoch)
+}
+
+/// A brand-new **flat** generation for `inode_id` — fragments already on disk, root not
+/// yet published — and the batch that publishes it. The pending batch is what a
+/// mid-resolve double applies, modelling the overwrite the resolve-retry rule is about.
+async fn pending_overwrite(
+    chunks: &FsChunkStore,
+    inode_id: u64,
+    data: &[u8],
+    id_base: u128,
+) -> WriteBatch {
+    let mut next = ids_from(id_base);
+    let plan = write::plan_write(data, CHUNK, EcScheme::None, &mut next).expect("plan");
+    write::write_fragments(chunks, &plan)
+        .await
+        .expect("fan out");
+    WriteBatch::new().put(
+        inode_key(inode_id),
+        encode(&InodeRecord {
+            size: plan.size,
+            chunk_map: plan.chunk_refs().into(),
+            state: InodeState::Committed,
+            version: 2,
+            ..Default::default()
+        }),
+    )
+}
+
+// ---------------------------------------------------------------------------
+// (1) Byte-identical reads.
+// ---------------------------------------------------------------------------
+
+#[tokio::test]
+async fn segmented_object_reads_byte_identical_to_the_flat_equivalent() {
+    let (meta, chunks, _dir) = backends();
+    let data = payload(48, 0);
+
+    let flat_plan = write_flat(&meta, &chunks, 1, "segmented", &data, 0x100).await;
+    let group = SegmentGroup::new(NONCE, 1).unwrap();
+    reshape_into_segments(&meta, 1, &flat_plan, &group, 2).await;
+
+    // The byte-for-byte control: the SAME payload, published and left flat.
+    write_flat(&meta, &chunks, 2, "flat", &data, 0x200).await;
+
+    let segmented = read_object(&meta, &chunks, 1)
+        .await
+        .unwrap()
+        .expect("the segmented object reads");
+    let flat = read_object(&meta, &chunks, 2)
+        .await
+        .unwrap()
+        .expect("the flat object reads");
+    assert_eq!(segmented, data, "segmented read must match the source data");
+    assert_eq!(
+        segmented, flat,
+        "segmented and flat reads must agree byte-for-byte"
+    );
+
+    // `read_path` (the name-resolving entry) agrees too.
+    assert_eq!(
+        read_path(&meta, &chunks, ROOT, "segmented").await.unwrap(),
+        Some(data),
+    );
+}
+
+// ---------------------------------------------------------------------------
+// (2) The resolver is bounded — an instrumented double records every key/prefix.
+// ---------------------------------------------------------------------------
+
+/// What the double does to the group's **own range read** — the one moment every
+/// resolve-retry arm turns on (`0016:2452-2462`: the root always moves first, so a
+/// reader's window is exactly between its root read and this page).
+enum Quirk {
+    /// Nothing: a faithful pass-through that only records.
+    None,
+    /// Apply a pending mutation at the FIRST `seg:` page: the root moves on (or is
+    /// deleted) while this resolve is in flight.
+    Supersede(Mutex<Option<WriteBatch>>),
+    /// Apply a pending mutation the moment the FIRST root read returns — the reader
+    /// holds the old root, the store already holds the new one. This is the only window
+    /// a resolve that is refused *before* any range read ever has, so it is how the
+    /// retirement arm of an over-ceiling root is reached at all. It fires on the first
+    /// `get` of any key, which for every read entry driven here is the object's own
+    /// root (`read_object` reads the inode record before it resolves anything).
+    SupersedeAfterRootRead(Mutex<Option<WriteBatch>>),
+    /// Retire the reader's generation **again on every restart**: the first page of each
+    /// distinct `seg:` range publishes the next complete generation from the queue, so a
+    /// resolve that restarts onto the live root finds THAT generation retired under it
+    /// too — an object republished faster than any reader can resolve it, which is the
+    /// only interleaving that reaches the reader's restart budget at all.
+    ///
+    /// Retiring once per *range* rather than per *page* keeps the fixture independent of
+    /// how many pages a group happens to take, and the queue is finite: when it runs dry
+    /// the store falls quiet, so the same fixture resolves — which is what separates "the
+    /// race" from "records this store could not read".
+    SupersedeEachGeneration {
+        /// One further generation per resolve attempt the reader may make.
+        pending: Mutex<VecDeque<WriteBatch>>,
+        /// The `seg:` ranges already retired on, so one generation is retired once
+        /// however many pages its range takes.
+        opened: Mutex<Vec<Vec<u8>>>,
+    },
+    /// Splice one extra row into the page — a row keyed to another generation.
+    Smuggle(Vec<u8>, Bytes),
+    /// Hand the page back in REVERSED order, violating the paging contract's
+    /// byte-lexicographic order clause.
+    Reverse,
+    /// Serve at most this many rows per `seg:` page, whatever limit was asked for —
+    /// a store whose own effective page cap is below the resolver's request, which
+    /// `scan_page` explicitly permits (`items.len() <= min(limit, the store's effective
+    /// cap)`, `crates/traits/src/lib.rs:1069-1071`). The truncated page carries the
+    /// contract's cursor: `Some(last key returned)` (clause 3, `:1054-1056`).
+    PageCap(usize),
+}
+
+/// How many `seg:` pages [`Quirk::PageCap`] serves before it refuses. A resolver that
+/// dropped the continuation cursor and re-anchored each page at the prefix would page
+/// forever; this makes that a loud test failure instead of a hang.
+const PAGE_WALK_GUARD: usize = 16;
+
+/// How many root `get`s one clean segmented resolve is allowed to cost, whatever the
+/// root's table names: the read's own root read, plus the ONE re-read that settles
+/// whether the generation just resolved is still the live one. Pinned as a constant, and
+/// asserted on both a two-segment object and a 512-segment one read over three pages,
+/// because "every get is the root" alone would still let a resolver re-ask the root once
+/// per segment (or per page) — work the record sets, not the reader.
+const CLEAN_RESOLVE_ROOT_GETS: usize = 2;
+
+/// What a read costs whose object is retired under **every** restart: the reader's first
+/// resolve plus its whole restart budget, each attempt costing exactly
+/// [`CLEAN_RESOLVE_ROOT_GETS`] root reads (its own root read, plus the one re-check that
+/// finds the generation retired). A **literal**, deliberately, and not a formula over a
+/// constant this patch exports: the restart budget is the reader's own policy — the
+/// record's churn may not buy more re-reads — so pinning the number here is what turns a
+/// widened, narrowed, or removed budget into a failure instead of a silently rescaled
+/// expectation.
+const EXHAUSTED_RESOLVE_ROOT_GETS: usize = 8;
+
+/// How many further generations the churn double queues: one per resolve attempt the
+/// reader is allowed. The queue runs dry **immediately** after the last one, so a reader
+/// whose budget were wider would resolve the next generation cleanly and answer `Ok` —
+/// which is how [`a_generation_retired_under_every_restart_fails_closed_and_terminates`]
+/// binds the budget from above as well as below.
+const CHURN_GENERATIONS: usize = EXHAUSTED_RESOLVE_ROOT_GETS / CLEAN_RESOLVE_ROOT_GETS;
+
+/// The one [`MetadataStore`] double these tests observe the resolver through: a **real**
+/// redb backend, every access recorded — each `get` key, each unpaged `scan` prefix,
+/// each `scan_page` prefix with the cursor it was anchored after and its page limit —
+/// and at most one [`Quirk`] applied to the `seg:` range read. Nothing else is
+/// intercepted: the resolver under test is always the production one, reached only
+/// through `read_object`/`read_path`.
+///
+/// Recording all three channels is the point: a resolver that reached another
+/// generation's records by a direct `get`, or that walked the whole `seg:` namespace
+/// with one unpaged `scan`, would be invisible to a double that only watched paged
+/// prefixes.
+struct Probe {
+    inner: RedbMetadataStore,
+    quirk: Quirk,
+    gets: Mutex<Vec<Vec<u8>>>,
+    scans: Mutex<Vec<Vec<u8>>>,
+    /// Every paged read: its prefix, the cursor it was anchored after, and its limit.
+    /// The cursor is recorded because a group wider than one page is resolved *only* by
+    /// carrying it forward — the walk is as much part of the bound as the prefix is.
+    pages: Mutex<Vec<Page>>,
+}
+
+/// One recorded `scan_page` call: `(prefix, after, limit)`.
+type Page = (Vec<u8>, Option<Vec<u8>>, usize);
+
+impl Probe {
+    fn new(inner: RedbMetadataStore, quirk: Quirk) -> Self {
+        Self {
+            inner,
+            quirk,
+            gets: Mutex::new(Vec::new()),
+            scans: Mutex::new(Vec::new()),
+            pages: Mutex::new(Vec::new()),
+        }
+    }
+
+    /// A double that applies `pending` at the first `seg:` page — the mid-resolve
+    /// retirement race.
+    fn superseding(inner: RedbMetadataStore, pending: WriteBatch) -> Self {
+        Self::new(inner, Quirk::Supersede(Mutex::new(Some(pending))))
+    }
+
+    /// A double that applies `pending` the moment the first root read returns — the
+    /// retirement race as a resolve that never reaches a page can meet it.
+    fn superseding_after_root_read(inner: RedbMetadataStore, pending: WriteBatch) -> Self {
+        Self::new(
+            inner,
+            Quirk::SupersedeAfterRootRead(Mutex::new(Some(pending))),
+        )
+    }
+
+    /// A double that retires the reader's generation at every new `seg:` range it opens
+    /// ([`Quirk::SupersedeEachGeneration`]) — the retirement race repeated under every
+    /// restart, rather than the single flip the two doubles above model.
+    fn superseding_each_generation(
+        inner: RedbMetadataStore,
+        pending: impl IntoIterator<Item = WriteBatch>,
+    ) -> Self {
+        Self::new(
+            inner,
+            Quirk::SupersedeEachGeneration {
+                pending: Mutex::new(pending.into_iter().collect()),
+                opened: Mutex::new(Vec::new()),
+            },
+        )
+    }
+
+    /// Assert the whole recorded **`get` channel** of the read just driven: every key
+    /// this store was asked for *by key* is `inode_id`'s own root, and there was at
+    /// least one. Hands back how many, so a caller can also pin that the count is set by
+    /// the READER and not by the root's table.
+    ///
+    /// A whitelist, not a blacklist, and that is the whole point of it. Criterion (2) is
+    /// "the root **plus only** the range `seg:<nonce>:<epoch>:`", so any *other* metadata
+    /// key a resolve consults — a sibling object's root, a directory entry, an index, a
+    /// probe of a neighbouring inode — is out of budget even though it is not a `seg:`
+    /// key and touches no second group. Forbidding only [`SEG_PREFIX`] gets would let
+    /// every one of those through unseen.
+    fn assert_gets_only_the_root_of(&self, inode_id: u64) -> usize {
+        let root = inode_key(inode_id);
+        let gets = self.gets.lock().unwrap();
+        assert!(
+            !gets.is_empty(),
+            "a read of inode {inode_id} must read that object's own root"
+        );
+        for key in gets.iter() {
+            assert_eq!(
+                key,
+                &root,
+                "the ONLY metadata key a resolve may fetch is the object's own root \
+                 (inode {inode_id}); this read also fetched {}",
+                String::from_utf8_lossy(key)
+            );
+        }
+        gets.len()
+    }
+
+    /// Every key or prefix this store was asked about, in one list — the whole access
+    /// footprint of a read, whichever channel it went through.
+    fn footprint(&self) -> Vec<Vec<u8>> {
+        let mut all = self.gets.lock().unwrap().clone();
+        all.extend(self.scans.lock().unwrap().iter().cloned());
+        all.extend(self.pages.lock().unwrap().iter().map(|(p, _, _)| p.clone()));
+        all
+    }
+
+    /// The cursor each recorded page was anchored after, in order — the walk itself.
+    fn page_cursors(&self) -> Vec<Option<Vec<u8>>> {
+        self.pages
+            .lock()
+            .unwrap()
+            .iter()
+            .map(|(_, after, _)| after.clone())
+            .collect()
+    }
+}
+
+#[async_trait]
+impl MetadataStore for Probe {
+    async fn get(&self, key: &[u8]) -> Result<Option<Bytes>> {
+        self.gets.lock().unwrap().push(key.to_vec());
+        let value = self.inner.get(key).await;
+        // Taken out of the mutex BEFORE the await: the guard never crosses it. The
+        // read already has the OLD bytes in hand when the overwrite lands, which is
+        // exactly the reader's window (`0016:2452-2462`: the root always moves first).
+        let pending = match &self.quirk {
+            Quirk::SupersedeAfterRootRead(pending) => pending.lock().unwrap().take(),
+            _ => None,
+        };
+        if let Some(batch) = pending {
+            assert_eq!(
+                self.inner.commit(batch).await.unwrap(),
+                CommitOutcome::Committed
+            );
+        }
+        value
+    }
+
+    async fn scan(&self, prefix: &[u8]) -> Result<Vec<(Vec<u8>, Bytes)>> {
+        self.scans.lock().unwrap().push(prefix.to_vec());
+        self.inner.scan(prefix).await
+    }
+
+    async fn scan_page(
+        &self,
+        prefix: &[u8],
+        after: Option<&[u8]>,
+        limit: usize,
+    ) -> Result<ScanPage> {
+        let taken = {
+            let mut pages = self.pages.lock().unwrap();
+            pages.push((prefix.to_vec(), after.map(<[u8]>::to_vec), limit));
+            pages.len()
+        };
+        // Taken out of the mutex BEFORE the await: the guard never crosses it.
+        let pending = match &self.quirk {
+            Quirk::Supersede(pending) if prefix.starts_with(SEG_PREFIX) => {
+                pending.lock().unwrap().take()
+            }
+            Quirk::SupersedeEachGeneration { pending, opened }
+                if prefix.starts_with(SEG_PREFIX) =>
+            {
+                let mut opened = opened.lock().unwrap();
+                if opened.iter().any(|seen| seen == prefix) {
+                    // A later page of a range already retired on: one generation is
+                    // retired exactly once, whatever its walk costs.
+                    None
+                } else {
+                    opened.push(prefix.to_vec());
+                    pending.lock().unwrap().pop_front()
+                }
+            }
+            _ => None,
+        };
+        if let Some(batch) = pending {
+            assert_eq!(
+                self.inner.commit(batch).await.unwrap(),
+                CommitOutcome::Committed
+            );
+        }
+        let (mut items, mut next) = self.inner.scan_page(prefix, after, limit).await?;
+        if prefix.starts_with(SEG_PREFIX) {
+            match &self.quirk {
+                Quirk::Smuggle(key, value) => items.push((key.clone(), value.clone())),
+                Quirk::Reverse => items.reverse(),
+                Quirk::PageCap(cap) => {
+                    if taken > PAGE_WALK_GUARD {
+                        return Err(format!(
+                            "{taken} pages over one group's range: the walk is not \
+                             advancing on the cursor it was handed"
+                        )
+                        .into());
+                    }
+                    if items.len() > *cap {
+                        items.truncate(*cap);
+                        // Clause 3: `Some(last key returned)` while more may remain.
+                        next = items.last().map(|(key, _)| key.clone());
+                    }
+                }
+                _ => {}
+            }
+        }
+        Ok((items, next))
+    }
+
+    async fn commit(&self, batch: WriteBatch) -> Result<CommitOutcome> {
+        self.inner.commit(batch).await
+    }
+}
+
+/// Seed a "decoy" group's `seg:` records directly — never named by any root, and
+/// [`resolver_touches_only_its_own_group_range`] asserts they are never read either.
+async fn seed_decoy_group(meta: &RedbMetadataStore, group: &SegmentGroup) {
+    let record = SegmentRecord::new(
+        vec![wyrd_core::metadata::ChunkRef {
+            id: 0xDEAD,
+            scheme: EcScheme::None,
+            len: 3,
+            placement: Vec::new(),
+        }],
+        0,
+    )
+    .unwrap();
+    let batch = WriteBatch::new().put(seg_key(group, 0).unwrap(), encode(&record));
+    assert_eq!(meta.commit(batch).await.unwrap(), CommitOutcome::Committed);
+}
+
+#[tokio::test]
+async fn resolver_touches_only_its_own_group_range() {
+    let (redb, chunks, _dir) = backends();
+    let data = payload(40, 0);
+    let flat_plan = write_flat(&redb, &chunks, 1, "obj", &data, 0x300).await;
+    let group = SegmentGroup::new(NONCE, 5).unwrap();
+    const NAMED: usize = 2;
+    reshape_into_segments(&redb, 1, &flat_plan, &group, NAMED).await;
+
+    // A second group: a different nonce, AND the same nonce at a different epoch — an
+    // older, not-yet-reclaimed generation of the same object. Neither is named by any
+    // live root; the resolver must never read either.
+    let decoys = [
+        SegmentGroup::new(OTHER_NONCE, 5).unwrap(),
+        SegmentGroup::new(NONCE, 4).unwrap(),
+    ];
+    for decoy in &decoys {
+        seed_decoy_group(&redb, decoy).await;
+    }
+
+    let store = Probe::new(redb, Quirk::None);
+    let got = read_object(&store, &chunks, 1)
+        .await
+        .unwrap()
+        .expect("the live object still reads");
+    assert_eq!(got, data);
+
+    // (a) The range read: its own group's prefix, and a page no wider than the root's
+    // OWN claim — the record may not set the budget spent on its behalf.
+    let own_prefix = seg_range_prefix(&group);
+    let pages = store.pages.lock().unwrap().clone();
+    assert!(
+        !pages.is_empty(),
+        "a segmented resolve must read its own range"
+    );
+    for (prefix, _after, limit) in &pages {
+        assert_eq!(
+            prefix, &own_prefix,
+            "the resolver must page ONLY seg:<nonce>:<epoch>: of its own group — never \
+             a second nonce, and never the same nonce at another epoch"
+        );
+        assert!(
+            *limit <= NAMED + 1,
+            "each page is bounded by the root's own claim ({NAMED} segments), not by \
+             whatever the range happens to hold: limit {limit}"
+        );
+    }
+
+    // (b) No unpaged `scan` at all: it is complete-or-fail-loud at SCAN_CAP
+    // (`crates/traits/src/lib.rs:286`), so a damaged range would cost the caller the
+    // whole namespace or the whole call.
+    assert!(
+        store.scans.lock().unwrap().is_empty(),
+        "a segmented resolve must never take an unpaged scan: {:?}",
+        store.scans.lock().unwrap()
+    );
+
+    // (c) The `get` channel is bounded POSITIVELY: this object's own root, nothing else,
+    // and no more often than the reader's own constant. That covers the segment records
+    // (the paged range is the only door onto `seg:`) *and* every other metadata key a
+    // resolve might consult on the side — a sibling root, a directory entry, an index —
+    // which a "no `seg:` gets" check would wave through.
+    assert_eq!(
+        store.assert_gets_only_the_root_of(1),
+        CLEAN_RESOLVE_ROOT_GETS,
+        "a clean resolve costs the root read plus ONE re-read, whatever the table names"
+    );
+
+    // (d) And nothing — get, scan, or page — intersects either decoy group's range.
+    for probe in store.footprint() {
+        for decoy in &decoys {
+            let range = seg_range_prefix(decoy);
+            assert!(
+                !probe.starts_with(&range[..]) && !range.starts_with(&probe[..]),
+                "the second group must never be read: {} touches {}",
+                String::from_utf8_lossy(&probe),
+                String::from_utf8_lossy(&range)
+            );
+        }
+    }
+}
+
+/// Seed a decodable root naming ONE MORE segment than the resolver may ever spend a
+/// read on (`MAX_ROOT_SEGMENTS` is a resolve-time ceiling, not a decode invariant, so
+/// the record exists) — and no `seg:` records for it at all.
+async fn seed_over_ceiling_root(meta: &RedbMetadataStore, inode_id: u64, group: &SegmentGroup) {
+    let refs: Vec<SegmentRef> = (0..(MAX_ROOT_SEGMENTS + 1) as u32)
+        .map(|i| SegmentRef {
+            index: i,
+            byte_offset: i as u64,
+            byte_len: 1,
+        })
+        .collect();
+    commit_segmented(meta, inode_id, group, refs, Vec::new()).await;
+}
+
+/// **A LIVE root over the ceiling fails closed, unread.** The root the store holds is
+/// the one the reader met, so this is the object's own fault: refused before a single
+/// row of its range is asked for.
+#[tokio::test]
+async fn a_root_over_the_segment_ceiling_is_refused_before_any_range_read() {
+    let (redb, chunks, _dir) = backends();
+    let group = SegmentGroup::new(NONCE, 1).unwrap();
+    seed_over_ceiling_root(&redb, 1, &group).await;
+
+    let store = Probe::new(redb, Quirk::None);
+    let err = read_object(&store, &chunks, 1)
+        .await
+        .expect_err("a table over the ceiling must be refused");
+    assert_resolved_typed_refusal(err);
+    assert!(
+        store.pages.lock().unwrap().is_empty(),
+        "the ceiling must be refused BEFORE any range read is performed"
+    );
+    // …and without fetching anything but this object's own root by any other route: not
+    // a segment record, and not some other key consulted to decide the refusal either.
+    store.assert_gets_only_the_root_of(1);
+    assert!(
+        store.scans.lock().unwrap().is_empty(),
+        "a refused table must not be scanned for either: {:?}",
+        store.scans.lock().unwrap()
+    );
+}
+
+/// **An over-ceiling root the store has already moved off is a RETIRED generation, not
+/// a fault.** The ceiling still refuses before any range read — but *which answer* that
+/// refusal becomes is the resolve-retry rule's call, exactly as it is for an absent or
+/// unparsable row. The reader here holds a snapshot whose root was overwritten the
+/// instant after it read it (the only window a resolve refused before its first page
+/// ever has), so the live generation is what it must read. Answering `TooManySegments`
+/// where the ceiling is noticed instead fails a perfectly healthy object over bytes
+/// nothing points at any more — a permanent read failure invented out of an ordinary
+/// overwrite, which is exactly what C-1 forbids.
+#[tokio::test]
+async fn an_over_ceiling_root_superseded_mid_read_restarts_onto_the_live_generation() {
+    let (redb, chunks, _dir) = backends();
+    let group = SegmentGroup::new(NONCE, 1).unwrap();
+    seed_over_ceiling_root(&redb, 1, &group).await;
+
+    let new_data = payload(36, 170);
+    let flip = pending_overwrite(&chunks, 1, &new_data, 0x640).await;
+    let store = Probe::superseding_after_root_read(redb, flip);
+    let got = read_object(&store, &chunks, 1)
+        .await
+        .unwrap()
+        .expect("an overwrite is not a deletion");
+    assert_eq!(
+        got, new_data,
+        "a retired over-ceiling root must restart onto the live generation, never fail \
+         the read of an object that resolves fine"
+    );
+    assert!(
+        store.pages.lock().unwrap().is_empty(),
+        "…and the retired table must still authorise no range read whatsoever"
+    );
+    // The restart is onto the SAME object's root — settling "retired or corrupt?" and
+    // re-resolving may not reach for any other metadata key.
+    store.assert_gets_only_the_root_of(1);
+}
+
+/// **Exactly [`MAX_ROOT_SEGMENTS`] is inside the ceiling — and it is read by PAGING.**
+/// Two properties on one fixture, because they are the same walk:
+///
+/// * the boundary the refusal above must not swallow — the most segments this
+///   deployment allows still resolves, all 512 records, byte-identical bytes back. A
+///   ceiling that refused *at* its own limit would strand every object written right up
+///   to it, the permanent-unreadability failure mode C-1 forbids; and
+/// * a group wider than one page. `scan_page` clamps a page to the store's own
+///   effective cap whatever limit was asked for (`crates/traits/src/lib.rs:1069-1071`),
+///   so a real backend hands the ceiling-sized group back in pieces. The store here caps
+///   at 200 rows: 512 segments is then a three-page walk, each page anchored strictly
+///   after the last key of the one before (clause 2/3, `crates/traits/src/lib.rs:1046-1056`).
+///   A resolver that stopped at the first short page would answer a torn map; one that
+///   re-anchored at the prefix would never terminate.
+#[tokio::test]
+async fn a_root_at_exactly_the_segment_ceiling_resolves_across_paged_reads() {
+    let (meta, chunks, _dir) = backends();
+    // One chunk per segment, so the root names exactly MAX_ROOT_SEGMENTS of them.
+    let data = payload((MAX_ROOT_SEGMENTS * CHUNK) as u32, 7);
+    let plan = write_flat(&meta, &chunks, 1, "obj", &data, 0x1000).await;
+    assert_eq!(plan.chunk_refs().len(), MAX_ROOT_SEGMENTS);
+    let group = SegmentGroup::new(NONCE, 1).unwrap();
+    reshape_into_segments(&meta, 1, &plan, &group, MAX_ROOT_SEGMENTS).await;
+
+    const PAGE_CAP: usize = 200;
+    let store = Probe::new(meta, Quirk::PageCap(PAGE_CAP));
+    assert_eq!(
+        read_object(&store, &chunks, 1)
+            .await
+            .unwrap()
+            .expect("a root AT the ceiling is inside it"),
+        data
+    );
+
+    // …and it got there by carrying the cursor, not by one lucky page.
+    assert_eq!(
+        store.page_cursors(),
+        vec![
+            None,
+            Some(seg_key(&group, PAGE_CAP as u32 - 1).unwrap()),
+            Some(seg_key(&group, 2 * PAGE_CAP as u32 - 1).unwrap()),
+        ],
+        "512 rows at {PAGE_CAP} a page is a three-page walk, each anchored strictly \
+         after the previous page's last key"
+    );
+
+    // …and the root was read exactly as often as it is for a TWO-segment object: the
+    // widest table this deployment allows, walked over three pages, buys no extra root
+    // read. A resolver re-asking the root per segment or per page — still only ever the
+    // right key — would spend 512 (or 3) reads here and 2 in the small fixture.
+    assert_eq!(
+        store.assert_gets_only_the_root_of(1),
+        CLEAN_RESOLVE_ROOT_GETS,
+        "the root-read count is the reader's constant, not a function of the table"
+    );
+}
