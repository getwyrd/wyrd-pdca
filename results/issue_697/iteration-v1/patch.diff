+        action = "ambiguous-chunk-id",
+        chunk = %wyrd_traits::chunk_hex(chunk),
+        inode = %crate::gc::object_name(first),
+        other = %crate::gc::object_name(second),
+        "two committed chunk maps reference one chunk id; neither is repaired (repointing one orphan-marks a fragment the other points at) and the obligation stays queued — NEEDS-HUMAN",
+    );
+}
+
+/// Emit a **refused repair**: the obligation was found — or could not be shown not to exist — and
+/// this pass may not discharge it. NOTHING is written, it stays queued, and the pass answers
+/// [`Reconciled::Blocked`]; `Satisfied` would tell an operator the store is whole.
+fn emit_refused(chunk: ChunkId, reason: &'static str, object: Option<&[u8]>) {
+    let object = object.map(crate::gc::object_name).unwrap_or_default();
+    tracing::warn!(monotonic_counter.reconstruction_repair_refused = 1_u64);
+    tracing::warn!(
+        target: "wyrd.custodian.reconstruction.audit",
+        action = "refused",
+        chunk = %wyrd_traits::chunk_hex(chunk),
+        reason,
+        inode = %object,
+        "reconstruction refused a queued repair it may not perform; the obligation stays queued and NOTHING was written — the pass does not certify",
+    );
+}
