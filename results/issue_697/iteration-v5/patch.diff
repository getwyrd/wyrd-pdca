+        let mut topo = Topology::default();
+        for (id, at) in DOMAINS.iter().enumerate() { topo.register(id as DServerId, *at); }
+        Self { meta: Default::default(), fleet: DOMAINS.map(|_| MemDServer::default()).into(), topo }
+    }
+    /// The BYTES a server holds at one address — "a fragment is there" is not the question a
+    /// landing decision turns on; WHOSE bytes they are is.
+    async fn at(&self, at: DServerId, f: FragmentId) -> Option<Bytes> {
+        self.fleet[at as usize].get_fragment(f).await.unwrap()
+    }
+    /// The reads since the last call, zeroed: ONE pass's, never the seeding's.
+    fn take_reads(&self) -> (usize, usize) { std::mem::take(&mut *self.meta.reads.lock().unwrap()) }
