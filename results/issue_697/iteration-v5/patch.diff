+    /// — asked — a healthy segmented object holding TWO chunks in its `seg:` records, one of them
+    /// named TWICE so **rule D's count is of obligations and not of references** (leg 2).
+    async fn seed_fixture(&self) {
+        let (a, b) = (seeded(S_A, &[0, 1, 4], &[0, 1]), seeded(S_B, &[0], &[]));
+        self.seed_seg(SEG, NONCE, 3, vec![a, b.clone(), b]).await;
