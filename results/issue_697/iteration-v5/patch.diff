+    let store = Store::new();
+    for key in [&b"inode:40"[..], b"inode:41"] {
+        store.seed(key, one(C_REPAIR, &[0, 1, 4], &[0, 1])).await;
+    }
+    // The same id twice in ONE record at DISTINCT placements: neither can pass for the other.
+    let twice = vec![seeded(C_DUP, &[0, 1, 4], &[0, 1]), seeded(C_DUP, &[2, 3, 4], &[])];
+    store.seed(b"inode:42", twice).await;
+    for chunk in [C_REPAIR, C_DUP] { store.enqueue(chunk).await; }
+
+    let (got, audit) = store.drive().await;
+
+    assert_eq!(got.expect("an ambiguity ends no pass"), Reconciled::Blocked, "no repair");
+    assert_eq!(store.queued().await, vec![C_REPAIR, C_DUP], "neither");
+    for key in [&b"inode:40"[..], b"inode:41", b"inode:42"] {
+        assert_eq!(store.placement(key, 0).await, vec![0, 1, 4], "no repoint");
+        said(&audit, &named(key));
+    }
+    // The SECOND reference too: a repoint of one orphan-marks a fragment the other points at.
+    assert_eq!(store.placement(b"inode:42", 1).await, vec![2, 3, 4], "nor the duplicate");
+    assert!(store.at(2, frag(C_REPAIR, 2)).await.is_none(), "nothing rebuilt");
+    said(&audit, r#""action":"ambiguous-chunk-id""#);
+}
+
+/// LEG 6. The deployed repair loop is Q namespace scans × N point reads (`assess` → `find_chunk`,
+/// which scans all of `inode:`); wire the resolver in naively and each of those N objects costs a
+/// `seg:` read too — Q×N *resolves*, which stops converging as a store grows (C-1). Closes #647.
+#[tokio::test]
+#[rustfmt::skip]
+async fn the_namespace_is_read_once_per_pass_not_once_per_obligation() {
+    // N = 3 committed flat objects, each holding one repairable chunk; Q = 3 obligations.
+    let store = Store::new(); let repairable = [C_REPAIR, S_A, S_B];
+    for (n, chunk) in repairable.iter().enumerate() {
+        store.seed(format!("inode:5{n}").as_bytes(), one(*chunk, &[0, 1, 4], &[0, 1])).await;
+        store.enqueue(*chunk).await;
+    }
+    // S = 2 segmented objects beside them, so the bounded `seg:` range reads are counted too.
+    store.seed_seg(b"inode:60", NONCE, 1, one(C_UNSEEN, &[0, 1, 4], &[])).await;
+    store.seed_seg(b"inode:61", OTHER_NONCE, 1, one(C_DUP, &[0, 1, 4], &[])).await;
+    store.take_reads();
+
+    let (got, _) = store.drive().await;
+
+    // FIRST, so #647's own property is what this leg goes red on, not a consequence of it.
+    let (namespace, segments) = store.take_reads();
+    assert_eq!(namespace, 1, "read ONCE, not once per obligation");
+    assert!(segments <= 2, "one `seg:` read per object, got {segments}");
+    // and a segmented object owed nothing refuses nothing:
+    assert_eq!(got.expect("the pass must run"), Reconciled::Changed, "none refused");
+    // The bound is worth nothing if the repairs stopped landing:
+    for n in 0..repairable.len() {
+        assert_eq!(store.placement(format!("inode:5{n}").as_bytes(), 0).await, vec![0, 1, 2]);
+    }
+    assert!(store.queued().await.is_empty(), "all discharged");
+}
+
+/// LEG 7 (**not base-red, and deliberate**). A pass certifies only over the reading it PERFORMED:
+/// with no obligations it reads no namespace and claims nothing about the objects in it. Leg 6
+/// moves the reading out of the per-obligation loop, and the obvious way to do that — read once at
+/// the top, unconditionally — breaks this silently. The base already passes (`for chunk in queue`
+/// scans nothing when empty): this leg is a REGRESSION guard on the restructure, not a
+/// discriminator.
+#[tokio::test]
+#[rustfmt::skip]
+async fn an_empty_queue_reads_nothing_and_certifies() {
+    let store = Store::new(); store.seed_damaged().await; store.seed_fixture().await;
+    store.take_reads();
+
+    let (got, _) = store.drive().await;
+
+    assert_eq!(got.expect("an idle pass runs"), Reconciled::Satisfied, "claims over its reading");
+    assert_eq!(store.take_reads().0, 0, "an idle pass reads nothing");
+}
+
+/// LEG 8 — guards OVER-containment. A store failing underneath the resolver is not one object's
+/// fault and must NOT be folded into "this object is unreadable": a walk that cannot reach the
+/// store answers for NO object, and a pass containing EVERY error would pass all six discriminating
+/// legs above. The fault is armed on `get`, which ONLY a segmented generation's root re-read
+/// reaches (`metadata.rs:2338-2339`) — under the resolver, exactly where containment is decided.
+/// That half is **not base-red, and deliberate**: the base passes it for a related reason (it
+/// cannot reach a `get` at all, aborting at the first damaged record, having likewise written and
+/// discharged nothing). Contained, this pass would answer `Ok` and repair `C_REPAIR` off a reading
+/// it never completed. **Rule E** is the other half, and it IS new: a pass that ends still owes the
+/// operator every name it read a fault under, emitted where the read happened.
+#[tokio::test]
+#[rustfmt::skip]
+async fn a_fault_that_is_not_one_objects_map_still_ends_the_pass() {
+    let store = Store::new(); store.seed_damaged().await; store.seed_fixture().await;
+    store.enqueue(C_REPAIR).await; let before = store.rows();
+    *store.meta.failing_gets.lock().unwrap() = true;
+
+    let (got, audit) = store.drive().await;
+
+    got.expect_err("a store fault is contained as one object's by nothing");
+    assert_eq!(store.rows(), before, "a pass that ends writes nothing");
+    assert_eq!(store.queued().await, vec![C_REPAIR], "nothing gone");
+    // **Rule E**, where it matters most: the pass ends, and NOTHING downstream will name what it
+    // read. Both objects are already on the seam — the undecodable record met before the fault,
+    // and the object the store fault itself was met under (named, then propagated).
+    assert!(said(&audit, &named(DAMAGED_RECORD)) < said(&audit, &named(DAMAGED_SEG)), "in order");
+}
