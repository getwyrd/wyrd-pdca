+// ---- fixture: raw `seg:` + root seeding (#653 owns the real committer). Domains A..E on servers
+// 0..4, one free beyond any chunk's three fragments; every chunk is RS(2,1). ----
+const DOMAINS: [&str; 5] = ["A", "B", "C", "D", "E"];
+const K: u8 = 2;
+const M: u8 = 1;
+const PAYLOAD: &[u8] = b"twelve bytes";
+const CHUNK_LEN: u64 = PAYLOAD.len() as u64;
+const EPOCH: u64 = 7;
+// In the byte order the `BTreeMap` answers in — `inode:0` < `inode:00` < `inode:006` < `inode:007`
+// < `inode:7` — so every damaged record and the segmented object is met BEFORE the healthy work.
+// `inode:007` parses to the id `inode:7` already spells: the WORK object is keyed that way (rule C).
+const DAMAGED_RECORD: &[u8] = b"inode:0";
+const DAMAGED_SEG: &[u8] = b"inode:00";
+const SEG: &[u8] = b"inode:006";
+const F_WORK: &[u8] = b"inode:007";
+const CANON_KEY: &[u8] = b"inode:7";
+/// A second under-replicated object, whose rebuild would CLAIM a slot that is not empty (leg 3).
+const OCCUPIED: &[u8] = b"inode:8";
+/// The under-replicated flat chunk every leg's positive half rests on: fragment 2 is gone.
+const C_REPAIR: ChunkId = 0xA1;
+/// A second under-replicated flat chunk, whose rebuild lands at the same server `C_REPAIR`'s does
+/// — where bytes already stand under its own `FragmentId`: the other half of the decision leg 3
+/// makes at one re-placement target, in one pass.
+const C_HELD: ChunkId = 0xA7;
+/// A chunk owing NO work — whole at every fragment — under the CANONICAL spelling of the work
+/// object's id (rule C). Queued, it is the OTHER route to a no-op drain (leg 3).
+const C_IDLE: ChunkId = 0xA4;
+/// Chunks inside a `seg:` record — real references this slice writes nothing to.
+const S_A: ChunkId = 0xB1;
+const S_B: ChunkId = 0xB2;
+/// A chunk no map this pass CAN read references — "referenced by nothing" established, or not.
+const C_UNSEEN: ChunkId = 0xD2;
+/// One record's SECOND claim on a single id (leg 5).
+const C_DUP: ChunkId = 0xD3;
+/// Segment-group nonces (32 lowercase hex, `0016:354`); a damaged object gets its own.
+const NONCE: &str = "0123456789abcdef0123456789abcdef";
+const OTHER_NONCE: &str = "fedcba9876543210fedcba9876543210";
+type Seeded = (ChunkId, Vec<DServerId>, Vec<u16>);
+
+#[rustfmt::skip]
+struct Store { meta: MemMeta, fleet: Vec<MemDServer>, topo: Topology }
+#[rustfmt::skip]
+impl Store {
+    fn new() -> Self {
+        // A permissive global `tracing` default, installed ONCE, so the audit callsites never latch
+        // `Interest::never` (#214).
