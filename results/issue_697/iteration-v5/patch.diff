+    async fn stored_at(&self, key: &[u8]) -> Option<Bytes> { self.meta.get(key).await.unwrap() }
+    async fn queued(&self) -> Vec<ChunkId> { repair::queued_repairs(&self.meta).await.unwrap() }
+    async fn enqueue(&self, chunk: ChunkId) {
