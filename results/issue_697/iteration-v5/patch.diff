+#[derive(Default)]
+struct MemMeta {
+    kv: Mutex<BTreeMap<Vec<u8>, Bytes>>,
+    /// `(namespace readings, `seg:` range reads)` — an O(N) pass told from an O(Q×N) one.
+    reads: Mutex<(usize, usize)>,
+    /// Armed: every `get` fails with a plain, non-`metadata::ChunkMapError` fault — a backend
+    /// outage under a read, not an anomaly the resolver describes and a pass downcasts. Its text is
