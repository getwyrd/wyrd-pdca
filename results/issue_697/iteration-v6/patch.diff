+        // are decided off **the generation the scan returned** — its own `chunk_map`, already
+        // in hand — never off the shape a resolve answered after restarting onto a newer
+        // root. A flat snapshot resolves to a borrow of the record and reads nothing, so it
+        // can never be superseded and never restarts (`crates/core/src/metadata.rs:2585`);
+        // only a segmented snapshot can, and a segmented snapshot is one this pass refuses.
+        // So the restart path reaches no write at all, by construction.
+        let flat = match (&record.chunk_map, parse_inode_key(&key)) {
+            (ChunkMap::Flat(chunks), Some(inode_id)) => Some((inode_id, chunks)),
