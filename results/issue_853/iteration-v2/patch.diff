+    // A coding the client does not decode: the bytes are not the object.
+    get_200(
+        &mut verdicts,
+        "gzip",
+        &[te("gzip")],
+        object.clone(),
+        &Expect::BodyError {
+            object: object.clone(),
+        },
+    )
+    .await;
+    // The same, with `chunked` the final coding: the framing is whole, the content still coded.
+    get_200(
+        &mut verdicts,
+        "gzip-chunked",
+        &[te("gzip, chunked")],
+        chunked(&object),
+        &Expect::BodyError { object },
+    )
+    .await;
+    verdicts.finish();
+}
