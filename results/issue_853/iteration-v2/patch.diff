+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn an_error_document_at_the_budget_is_read_and_one_byte_more_is_unreadable() {
+    let mut verdicts = Verdicts::default();
+    for (size, name) in [
