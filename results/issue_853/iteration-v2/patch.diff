+                message: Some(message),
+            }
+        } else {
+            // The detail says why: the budget, whether the length was declared or counted.
+            Expect::Unreadable {
+                status: 503,
+                detail_has: Some("budget"),
+            }
+        };
+        // Declared up front.
+        on_every_operation(
+            &mut verdicts,
+            &format!("{name}-content-length"),
