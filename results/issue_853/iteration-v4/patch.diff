+    // body either way, so nothing follows the head here.
+    for op in OPS {
+        let request_id = format!("853-304-transfer-encoding-{}", op.method());
+        let script = Script::exact(head("304 Not Modified", &request_id, &[te_chunked()]), "");
+        let expect = match op {
