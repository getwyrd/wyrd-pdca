+            },
+            Op::Put | Op::Delete => Expect::Service {
+                status: 304,
+                code: ErrorCode::NoBody,
+                message: None,
+            },
+        };
+        run(
+            &mut verdicts,
+            "304-content-length",
+            op,
+            script,
+            &request_id,
+            &expect,
