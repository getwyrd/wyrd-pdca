@@ -0,0 +1,987 @@
+//! Issue #681 (slice 4b of 7 of the #635 re-slicing, proposal 0016 decision 7(e)): **the three
+//! maintenance passes that scan `inode:` themselves read every committed object through the
+//! shared resolver, contain what they cannot read, and refuse rather than abort the writes this
+//! slice does not own** — reconstruction (`wyrd_custodian::reconcile_step`), backfill
+//! (`wyrd_custodian::backfill::reconcile`) and rebalance (`reconcile_step` again).
+//!
+//! #650 landed the containment vocabulary (`gc::ReferenceSet::unresolvable`,
+//! `Reconciled::Blocked`) and #651 applied it to restore + the drain surface. These three
+//! passes were left reading the chunk map out of the inode record INLINE, so on the base:
+//!
+//!   * ONE segmented object turned all three into an `Err` for the WHOLE store — the passes
+//!     that restore redundancy stop self-healing the moment a store publishes one multipart
+//!     object, which is a permanent, data-losing failure mode (`docs/principles.md` §5 C-1);
+//!   * a repair obligation whose chunk lives in a `seg:` record had no readable answer at all,
+//!     and the only two answers reachable from there were an abort or a DRAIN — deleting the
+//!     last record that says live data is under-replicated; and
+//!   * a committed record that would not `decode` ended the walk before any resolver was
+//!     involved, costing every healthy object its repair, its fill and its evacuation.
+//!
+//! The fixture (in-memory trait stores, raw-record `seg:`/root seeding, never a committer —
+//! #653 owns the staged-publication producer) is the pruned #650/#651 fixture
+//! (`crates/custodian/tests/segmented_map_{consumers,restore}.rs`); integration-test crates
+//! cannot import across files. `BTreeMap`-backed, so "the damaged record is met FIRST" is a
+//! property of the fixture rather than luck.
+//!
+//! **Why no assertion here names a symbol this patch introduces:** the per-fix red leg reverts
+//! the production files, so naming one would make that leg fail to COMPILE and the red would
+//! degrade from "the behaviour was wrong" to "a symbol is missing". Every leg below is
+//! expressed in entries visible on the base — `Reconciled::Blocked` among them (`#650`,
+//! `reconciliation.rs`) — plus the audit records the passes emit.
+//!
+//! 1. `a_segmented_object_no_longer_ends_any_of_the_three_passes` — criterion (1).
+//! 2. `a_repair_obligation_for_a_segmented_chunk_is_refused_not_drained` — criterion (2).
+//! 3. `an_unreadable_object_is_named_the_walk_continues_and_no_pass_certifies` — criterion (3).
+//! 4. `a_store_fault_under_the_resolve_still_ends_every_pass` — criterion (4).
+//! 5. `reconstruction_reads_the_namespace_once_per_pass_not_once_per_obligation` — criterion (5).
+
+#![forbid(unsafe_code)]
+
+use std::collections::{BTreeMap, HashMap};
+use std::sync::{Arc, Mutex};
+
+use async_trait::async_trait;
+use bytes::Bytes;
+use tracing::instrument::WithSubscriber;
+use tracing_subscriber::prelude::*;
+use wyrd_chunk_format::FragmentHeader;
+use wyrd_coordination_mem::MemCoordination;
+use wyrd_core::erasure;
+use wyrd_core::metadata::{
+    self, ChunkMap, ChunkRef, EcScheme, InodeId, InodeRecord, InodeState, SegmentGroup,
+    SegmentRecord, SegmentRef, SegmentedMap,
+};
+use wyrd_core::placement::Topology;
+use wyrd_core::repair::{enqueue_repair, queued_repairs, repair_key};
+use wyrd_core::write::encode_ec_fragment;
+use wyrd_custodian::backfill::{self, BackfillContext};
+use wyrd_custodian::desired_state::{set_lifecycle, DServerLifecycle};
+use wyrd_custodian::{
+    reconcile_step, Custodian, FencedZone, RebalanceContext, Reconciled, ReconstructionContext,
+};
+use wyrd_traits::{
+    ChunkId, ChunkStore, CommitOutcome, DServerId, FragmentId, Health, MetadataStore, Result,
+    WriteBatch,
+};
+
+// ---- in-memory trait stores (the passes are proven over the seams, backend-agnostic) ----
+
+/// A trivial in-memory metadata store that **counts its reads** and can be armed to fail a
+/// `get` under a chosen prefix.
+///
+/// `BTreeMap`, so `scan` answers in key order and the DAMAGED record is always the one a walk
+/// meets FIRST — otherwise "the healthy object was still handled" could pass on an
+/// implementation that abandons the walk at the first blocker, simply because the healthy
+/// object had already been handled by then.
+#[derive(Default)]
+struct MemMeta {
+    kv: Mutex<BTreeMap<Vec<u8>, Bytes>>,
+    /// How many times the committed namespace was scanned — the O(N)-not-O(Q×N) property is a
+    /// COUNT, never a timing.
+    inode_scans: Mutex<usize>,
+    /// How many bounded `seg:<nonce>:<epoch>:` range reads were issued (each `scan_page` of a
+    /// group's range pages through this store's own `scan`).
+    seg_reads: Mutex<usize>,
+    /// A key prefix whose `get` fails with a plain, non-`ChunkMapError` fault — a genuine
+    /// backend outage underneath the resolver's root re-read, which is not one object's fault
+    /// and must end the pass rather than be contained as "this object is unreadable".
+    failing_gets: Mutex<Option<Vec<u8>>>,
+}
+
+impl MemMeta {
+    fn fail_gets_of(&self, prefix: &[u8]) {
+        *self.failing_gets.lock().unwrap() = Some(prefix.to_vec());
+    }
+
+    fn inode_scans(&self) -> usize {
+        *self.inode_scans.lock().unwrap()
+    }
+
+    fn seg_reads(&self) -> usize {
+        *self.seg_reads.lock().unwrap()
+    }
+
+    /// Every key/value the store holds — so a leg can assert a pass wrote **nothing at all**,
+    /// which is stronger than checking the handful of records it thought to look at.
+    fn snapshot(&self) -> BTreeMap<Vec<u8>, Bytes> {
+        self.kv.lock().unwrap().clone()
+    }
+}
+
+#[async_trait]
+impl MetadataStore for MemMeta {
+    async fn get(&self, key: &[u8]) -> Result<Option<Bytes>> {
+        if let Some(failing) = self.failing_gets.lock().unwrap().as_deref() {
+            if key.starts_with(failing) {
+                return Err(Box::new(std::io::Error::other(STORE_FAULT)));
+            }
+        }
+        Ok(self.kv.lock().unwrap().get(key).cloned())
+    }
+
+    async fn scan(&self, prefix: &[u8]) -> Result<Vec<(Vec<u8>, Bytes)>> {
+        if prefix.starts_with(b"inode:") {
+            *self.inode_scans.lock().unwrap() += 1;
+        }
+        if prefix.starts_with(b"seg:") {
+            *self.seg_reads.lock().unwrap() += 1;
+        }
+        Ok(self
+            .kv
+            .lock()
+            .unwrap()
+            .iter()
+            .filter(|(k, _)| k.starts_with(prefix))
+            .map(|(k, v)| (k.clone(), v.clone()))
+            .collect())
+    }
+
+    // The required paginated read (#634): a test double needs *a* body, not a backend's — the
+    // dev-only testkit helper pages over this store's own `scan`.
+    async fn scan_page(
+        &self,
+        prefix: &[u8],
+        after: Option<&[u8]>,
+        limit: usize,
+    ) -> Result<wyrd_traits::ScanPage> {
+        wyrd_testkit::test_double_scan_page(self, prefix, after, limit).await
+    }
+
+    async fn commit(&self, batch: WriteBatch) -> Result<CommitOutcome> {
+        let mut kv = self.kv.lock().unwrap();
+        for pre in &batch.preconditions {
+            if kv.get(&pre.key).cloned() != pre.expected {
+                return Ok(CommitOutcome::Conflict);
+            }
+        }
+        for (k, v) in batch.puts {
+            kv.insert(k, v);
+        }
+        for k in batch.deletes {
+            kv.remove(&k);
+        }
+        Ok(CommitOutcome::Committed)
+    }
+}
+
+/// Bytes that are not an [`InodeRecord`] — a committed record whose own bytes will not decode,
+/// contained by the same per-object rule as a generation the resolver cannot read.
+const UNDECODABLE_RECORD: &[u8] = b"not a record";
+
+/// The injected store fault's exact text, so a leg proves THIS fault came back rather than
+/// accepting any error at all — a pre-fix tree fails the same read differently.
+const STORE_FAULT: &str = "simulated store fault: metadata store unreachable";
+
+/// One D server's fragment bytes — a deliberately dumb `ChunkStore`.
+#[derive(Default)]
+struct MemDServer {
+    frags: Mutex<HashMap<FragmentId, Bytes>>,
+}
+
+impl MemDServer {
+    fn holds(&self, frag: FragmentId) -> bool {
+        self.frags.lock().unwrap().contains_key(&frag)
+    }
+}
+
+#[async_trait]
+impl ChunkStore for MemDServer {
+    async fn put_fragment(&self, id: FragmentId, fragment: Bytes) -> Result<()> {
+        self.frags.lock().unwrap().insert(id, fragment);
+        Ok(())
+    }
+
+    async fn get_fragment(&self, id: FragmentId) -> Result<Option<Bytes>> {
+        Ok(self.frags.lock().unwrap().get(&id).cloned())
+    }
+
+    async fn list_fragments(&self) -> Result<Vec<FragmentId>> {
+        Ok(self.frags.lock().unwrap().keys().copied().collect())
+    }
+
+    async fn delete_fragment(&self, id: FragmentId) -> Result<()> {
+        self.frags.lock().unwrap().remove(&id);
+        Ok(())
+    }
+
+    async fn health(&self) -> Result<Health> {
+        Ok(Health::Healthy)
+    }
+}
+
+// ---- audit capture (the proven in-tree pattern, `crates/custodian/tests/segmented_map_restore.rs`) ----
+
+/// A `MakeWriter` collecting what the subscriber emits, so a leg asserts on the record a pass
+/// actually produced rather than assuming one exists.
+#[derive(Clone, Default)]
+struct Capture(Arc<Mutex<Vec<u8>>>);
+
+impl Capture {
+    fn contents(&self) -> String {
+        String::from_utf8(self.0.lock().unwrap().clone()).unwrap()
+    }
+}
+
+impl std::io::Write for Capture {
+    fn write(&mut self, buf: &[u8]) -> std::io::Result<usize> {
+        self.0.lock().unwrap().extend_from_slice(buf);
+        Ok(buf.len())
+    }
+
+    fn flush(&mut self) -> std::io::Result<()> {
+        Ok(())
+    }
+}
+
+impl<'w> tracing_subscriber::fmt::MakeWriter<'w> for Capture {
+    type Writer = Self;
+    fn make_writer(&'w self) -> Self::Writer {
+        self.clone()
+    }
+}
+
+/// Install a permissive global `tracing` default **once**, so the audit callsites never latch
+/// `Interest::never` under the parallel test harness: `tracing` caches each callsite's interest
+/// in process-global state the first time it is hit, so a sibling test in this binary that hits
+/// an audit callsite with no subscriber installed could otherwise disable it for the whole
+/// process and leave the capture below empty (issue #214).
+fn enable_audit_callsites() {
+    use std::sync::Once;
+    static INIT: Once = Once::new();
+    INIT.call_once(|| {
+        let _ = tracing::subscriber::set_global_default(tracing_subscriber::registry());
+    });
+}
+
+fn capturing_dispatch(capture: Capture) -> tracing::Dispatch {
+    tracing::Dispatch::new(
+        tracing_subscriber::registry()
+            .with(tracing_subscriber::fmt::layer().json().with_writer(capture)),
+    )
+}
+
+/// Assert that `seam`'s audit trail attributes **both** unreadable records: the right seam (so a
+/// collector can select on it), the classification, and — the part an operator actually needs —
+/// the NAME of each record to repair, spelled as `gc::object_name` escapes the store's own key
+/// bytes. A refusal an operator cannot attribute is a stall with no way out.
+fn assert_names_unreadable_records(logged: &str, seam: &str) {
+    for object in [UNDECODABLE_OBJECT, DAMAGED_OBJECT] {
+        assert!(
+            logged.contains(&format!(r#""target":"{seam}""#))
+                && logged.contains(r#""action":"unresolvable-chunk-map""#)
+                && logged.contains(&format!(r#""inode":"{object}""#)),
+            "{seam} must classify the blocker as an unreadable chunk map AND name {object}; \
+             got: {logged}"
+        );
+    }
+}
+
+// ---- fixture: raw-record `seg:` + root seeding (this slice lands no producer of segmented
+// maps; #653 owns the real staged-publication committer) ----
+
+const NOW: u64 = 10_000;
+
+/// Keys sort byte-lexicographically, so every damaged/undecodable record below is met by a
+/// walk BEFORE the healthy objects that carry the real work.
+const UNDECODABLE_INODE: InodeId = 0;
+const DAMAGED_INODE: InodeId = 1;
+const REPAIR_INODE: InodeId = 2;
+const FILL_INODE: InodeId = 3;
+const EVAC_INODE: InodeId = 4;
+const SEGMENTED_INODE: InodeId = 5;
+const UNDECODABLE_OBJECT: &str = "inode:0";
+const DAMAGED_OBJECT: &str = "inode:1";
+
+const REPAIR_CHUNK: ChunkId = 0xA1_00;
+const FILL_CHUNK: ChunkId = 0xA2_00;
+const EVAC_CHUNK: ChunkId = 0xA3_00;
+/// The chunks of the healthy segmented object — `SEG_QUEUED` is the one criterion (2) enqueues
+/// a repair for.
+const SEG_QUEUED: ChunkId = 0xB1_00;
+const SEG_OTHER: ChunkId = 0xB2_00;
+/// The damaged object's two chunks: the one whose `seg:` record was written and the one whose
+/// record never was — the hole that makes the root genuinely unresolvable.
+const DAMAGED_HELD: ChunkId = 0xD1_00;
+const DAMAGED_UNWRITTEN: ChunkId = 0xD2_00;
+
+/// The fence epoch every fixture segment group is scoped by; each object gets its OWN nonce
+/// (derived from its inode id), so nothing about one object is inside another's bounded range.
+const EPOCH: u64 = 7;
+
+/// The scheme every repairable fixture chunk carries: RS(2,1) — three fragments, any two of
+/// which rebuild the third, so "one fragment gone" is a genuine, repairable under-replication.
+const K: u8 = 2;
+const M: u8 = 1;
+const DATA: &[u8] = b"an erasure-coded chunk the reconstruction pass rebuilds from real shards";
+
+/// A D server the desired-state ledger marks draining that **no** committed placement names,
+/// so rebalance is genuinely driven over the namespace without evacuation work of its own
+/// confusing a leg whose subject is another pass.
+const IDLE_DRAINING: DServerId = 9;
+/// The draining server criterion (3) puts real evacuation work on.
+const EVAC_DRAINING: DServerId = 4;
+
+fn frag(chunk: ChunkId, index: u16) -> FragmentId {
+    FragmentId { chunk, index }
+}
+
+/// A per-object segment group: a 32-lowercase-hex nonce (`0016:354`) derived from the inode id,
+/// so two segmented objects never share a `seg:` range.
+fn group_of(inode: InodeId) -> SegmentGroup {
+    SegmentGroup::new(format!("{inode:032x}"), EPOCH).unwrap()
+}
+
+/// A single-copy (`EcScheme::None`) chunk reference — one fragment, one server.
+fn single_copy_ref(chunk: ChunkId, dserver: DServerId) -> ChunkRef {
+    ChunkRef {
+        id: chunk,
+        scheme: EcScheme::None,
+        len: DATA.len() as u64,
+        placement: vec![dserver],
+    }
+}
+
+/// An RS(2,1) chunk reference with the given (possibly empty) placement.
+fn rs_ref(chunk: ChunkId, placement: Vec<DServerId>) -> ChunkRef {
+    ChunkRef {
+        id: chunk,
+        scheme: EcScheme::ReedSolomon { k: K, m: M },
+        len: DATA.len() as u64,
+        placement,
+    }
+}
+
+/// The on-disk bytes of one RS(2,1) shard — encoded exactly as the write path encodes them, so
+/// `repair::intact_shard` verifies their FULL identity (chunk id, fragment index, EC tuple) and
+/// the pass really rebuilds from real survivors rather than from a fixture's say-so.
+fn rs_fragment(chunk: ChunkId, index: u16) -> Bytes {
+    let shards = erasure::encode(K as usize, M as usize, DATA).unwrap();
+    encode_ec_fragment(chunk, index, K, M, &shards[index as usize])
+}
+
+/// The on-disk bytes of a single-copy fragment (`EcScheme::None`: `ec_k = 1`, `ec_m = 0`, index
+/// 0 — what `FragmentHeader::new_v1` stamps), so rebalance's intactness verify passes and the
+/// fragment is genuinely movable.
+fn single_copy_fragment(chunk: ChunkId) -> Bytes {
+    let header = FragmentHeader::new_v1(chunk, DATA.len() as u64);
+    Bytes::from(wyrd_chunk_format::encode(&header, DATA))
+}
+
+async fn commit(meta: &MemMeta, batch: WriteBatch) {
+    assert_eq!(meta.commit(batch).await.unwrap(), CommitOutcome::Committed);
+}
+
+/// Commit `inode`'s root record. Raw `WriteBatch` puts throughout — never a publish path, since
+/// no producer of segmented maps exists yet — but built with the real validating constructors,
+/// so a fixture typo cannot silently change WHICH rule a leg exercises.
+async fn commit_root(meta: &MemMeta, inode: InodeId, size: u64, chunk_map: ChunkMap) {
+    let root = InodeRecord {
+        size,
+        chunk_map,
+        state: InodeState::Committed,
+        version: 1,
+        ..Default::default()
+    };
+    commit(
+        meta,
+        WriteBatch::new().put(metadata::inode_key(inode), metadata::encode(&root)),
+    )
+    .await;
+}
+
+/// Seed a committed object holding `chunks` in a **flat** map.
+async fn seed_flat(meta: &MemMeta, inode: InodeId, chunks: Vec<ChunkRef>) {
+    let size = chunks.len() as u64 * DATA.len() as u64;
+    commit_root(meta, inode, size, chunks.into()).await;
+}
+
+/// Seed a committed **segmented** root at `inode` naming `chunks.len()` segments (one
+/// single-copy chunk each), but WRITE only the first `written` of their `seg:` records.
+/// `written == chunks.len()` is the readable shape; a smaller `written` is the real gap the
+/// containment rule exists for — a segment the root's own table names, on a generation it still
+/// names, that genuinely never got written (`ChunkMapError::SegmentAbsent`).
+async fn seed_segmented(
+    meta: &MemMeta,
+    inode: InodeId,
+    chunks: &[(ChunkId, DServerId)],
+    written: usize,
+) {
+    let group = group_of(inode);
+    let mut segments = Vec::new();
+    for (index, &(chunk, dserver)) in chunks.iter().enumerate() {
+        let offset = index as u64 * DATA.len() as u64;
+        segments.push(SegmentRef {
+            index: index as u32,
+            byte_offset: offset,
+            byte_len: DATA.len() as u64,
+        });
+        if index < written {
+            let record = SegmentRecord::new(vec![single_copy_ref(chunk, dserver)], offset).unwrap();
+            let key = metadata::seg_key(&group, index as u32).unwrap();
+            commit(meta, WriteBatch::new().put(key, metadata::encode(&record))).await;
+        }
+    }
+    let map = SegmentedMap::new(group, segments).unwrap();
+    let size = chunks.len() as u64 * DATA.len() as u64;
+    commit_root(meta, inode, size, ChunkMap::Segmented(map)).await;
+}
+
+/// Seed the object the containment legs are built around: a committed root naming two segments,
+/// only the first of which was ever written. Asserts the fixture really is unreadable, so a leg
+/// can never pass because the fault it was built around silently stopped being one.
+async fn seed_damaged(meta: &MemMeta) {
+    seed_segmented(
+        meta,
+        DAMAGED_INODE,
+        &[(DAMAGED_HELD, 0), (DAMAGED_UNWRITTEN, 0)],
+        1,
+    )
+    .await;
+
+    let root_key = metadata::inode_key(DAMAGED_INODE);
+    let root: InodeRecord = metadata::decode(&meta.get(&root_key).await.unwrap().unwrap()).unwrap();
+    assert!(
+        metadata::resolve_chunk_map(meta, &root_key, &root)
+            .await
+            .is_err(),
+        "fixture: the seeded root's map must genuinely fail to resolve"
+    );
+}
+
+/// Seed a committed record whose own bytes will not `decode` — the other half of criterion (3),
+/// contained by the same per-object rule and met even earlier in the walk.
+async fn seed_undecodable(meta: &MemMeta) {
+    commit(
+        meta,
+        WriteBatch::new().put(
+            metadata::inode_key(UNDECODABLE_INODE),
+            Bytes::from_static(UNDECODABLE_RECORD),
+        ),
+    )
+    .await;
+    assert!(
+        metadata::decode::<InodeRecord>(&Bytes::from_static(UNDECODABLE_RECORD)).is_err(),
+        "fixture: the seeded record's own bytes must genuinely fail to decode"
+    );
+}
+
+/// The healthy failure-domain view: servers 0 (A), 1 (B) and 3 (D) — server 2 is the dead one
+/// every repairable fixture chunk lost a fragment to, so the rebuild has exactly one free
+/// distinct domain (D) to land on and the move is deterministic.
+fn healthy_topology() -> Topology {
+    let mut topo = Topology::default();
+    topo.register(0, "A").register(1, "B").register(3, "D");
+    topo
+}
+
+async fn elect(coord: &MemCoordination) -> (FencedZone, Custodian) {
+    let leader = Custodian::elect(coord, "zone-681").await.unwrap();
+    let mut zone = FencedZone::new();
+    zone.install(leader.leadership());
+    (zone, leader)
+}
+
+async fn read_inode(meta: &MemMeta, inode: InodeId) -> InodeRecord {
+    let bytes = meta
+        .get(&metadata::inode_key(inode))
+        .await
+        .unwrap()
+        .expect("inode present");
+    metadata::decode(&bytes).unwrap()
+}
+
+/// A committed object's placement vector for its first chunk, read back off the store.
+async fn placement_of(meta: &MemMeta, inode: InodeId) -> Vec<DServerId> {
+    read_inode(meta, inode).await.chunk_map.as_flat().unwrap()[0]
+        .placement
+        .clone()
+}
+
+/// Seed the flat object criterion (1)/(3) repair: one RS(2,1) chunk placed on 0/1/2, with only
+/// the fragments on 0 and 1 actually present (server 2 is dead) — under-replicated, repairable,
+/// and enqueued on the shared repair queue.
+async fn seed_repairable(
+    meta: &MemMeta,
+    d0: &MemDServer,
+    d1: &MemDServer,
+    inode: InodeId,
+    chunk: ChunkId,
+) {
+    seed_flat(meta, inode, vec![rs_ref(chunk, vec![0, 1, 2])]).await;
+    d0.put_fragment(frag(chunk, 0), rs_fragment(chunk, 0))
+        .await
+        .unwrap();
+    d1.put_fragment(frag(chunk, 1), rs_fragment(chunk, 1))
+        .await
+        .unwrap();
+    enqueue_repair(meta, chunk, "scrub").await.unwrap();
+}
+
+// ---- criterion (1): a segmented object no longer ends any of the three passes ----
+
+/// On the base a store holding ONE healthy segmented object turned every one of the three
+/// passes into an `Err` — for the whole store, not for that object — so a store that published
+/// a single multipart object stopped repairing, filling and draining every OTHER object too.
+///
+/// Asserted POSITIVELY, not merely "no error": the flat objects' genuine work still happens in
+/// the same passes, which a pass that returned `Ok` by quietly SKIPPING the namespace would not
+/// produce.
+#[tokio::test]
+async fn a_segmented_object_no_longer_ends_any_of_the_three_passes() {
+    enable_audit_callsites();
+    let meta = MemMeta::default();
+    let (d0, d1, d3) = (
+        MemDServer::default(),
+        MemDServer::default(),
+        MemDServer::default(),
+    );
+
+    // One healthy segmented object (both `seg:` records written) beside one flat object with a
+    // queued repair and one flat object whose placement is still empty (the pre-M3 shape
+    // backfill drains).
+    seed_segmented(
+        &meta,
+        SEGMENTED_INODE,
+        &[(SEG_QUEUED, 0), (SEG_OTHER, 0)],
+        2,
+    )
+    .await;
+    seed_repairable(&meta, &d0, &d1, REPAIR_INODE, REPAIR_CHUNK).await;
+    seed_flat(&meta, FILL_INODE, vec![rs_ref(FILL_CHUNK, vec![])]).await;
+    // A drain is in progress, so rebalance really walks the namespace rather than returning on
+    // its no-draining-servers short-circuit.
+    set_lifecycle(&meta, IDLE_DRAINING, DServerLifecycle::Draining)
+        .await
+        .unwrap();
+
+    let topology = healthy_topology();
+    let fleet: [(DServerId, &dyn ChunkStore); 3] = [(0, &d0), (1, &d1), (3, &d3)];
+    let reconstruction = ReconstructionContext {
+        meta: &meta,
+        fleet: &fleet,
+        topology: &topology,
+        unreachable: &[],
+    };
+    let rebalance = RebalanceContext {
+        meta: &meta,
+        fleet: &fleet,
+        topology: &topology,
+    };
+
+    let coord = MemCoordination::new();
+    let (zone, custodian) = elect(&coord).await;
+    let outcome = reconcile_step(
+        &zone,
+        &custodian,
+        None,
+        None,
+        Some(&reconstruction),
+        Some(&rebalance),
+        NOW,
+    )
+    .await
+    .expect("one segmented object must not turn reconstruction or rebalance into an error");
+    assert_eq!(
+        outcome,
+        Reconciled::Changed,
+        "the flat object's repair converged; the healthy segmented object refused nothing"
+    );
+
+    // The flat object's repair really happened: the rebuilt fragment moved to the one free
+    // distinct domain (D, server 3), its bytes are on that server, and the obligation is drained.
+    assert_eq!(
+        placement_of(&meta, REPAIR_INODE).await,
+        vec![0, 1, 3],
+        "the under-replicated flat chunk was repaired and its placement record repointed"
+    );
+    assert!(
+        d3.holds(frag(REPAIR_CHUNK, 2)),
+        "the rebuilt shard was written to its new D server before the commit"
+    );
+    assert!(
+        queued_repairs(&meta).await.unwrap().is_empty(),
+        "the flat chunk's obligation is drained by the repair commit"
+    );
+
+    // And backfill fills the flat record in the same store.
+    let filled = backfill::reconcile(&BackfillContext { meta: &meta })
+        .await
+        .expect("one segmented object must not turn backfill into an error");
+    assert_eq!(
+        filled,
+        Reconciled::Changed,
+        "the fillable flat record was filled; the healthy segmented record declined nothing"
+    );
+    assert_eq!(
+        placement_of(&meta, FILL_INODE).await,
+        vec![0, 1, 2],
+        "the empty-placement flat chunk still gets its explicit identity vector"
+    );
+}
+
+// ---- criterion (2): an obligation for a `seg:`-resident chunk is REFUSED, never drained ----
+
+/// The loss this slice must not introduce while removing the abort. `assess` reads "referenced
+/// by no committed chunk map" as `Drain` and DELETES the obligation, so a walk that merely
+/// SKIPPED a segmented object would silently discard the repair obligation for live,
+/// under-replicated data — quieter than the abort and strictly worse.
+#[tokio::test]
+async fn a_repair_obligation_for_a_segmented_chunk_is_refused_not_drained() {
+    enable_audit_callsites();
+    let meta = MemMeta::default();
+    let d0 = MemDServer::default();
+
+    seed_segmented(
+        &meta,
+        SEGMENTED_INODE,
+        &[(SEG_QUEUED, 0), (SEG_OTHER, 0)],
+        2,
+    )
+    .await;
+    enqueue_repair(&meta, SEG_QUEUED, "scrub").await.unwrap();
+    let before = meta.snapshot();
+
+    let topology = healthy_topology();
+    let fleet: [(DServerId, &dyn ChunkStore); 1] = [(0, &d0)];
+    let reconstruction = ReconstructionContext {
+        meta: &meta,
+        fleet: &fleet,
+        topology: &topology,
+        unreachable: &[],
+    };
+
+    let coord = MemCoordination::new();
+    let (zone, custodian) = elect(&coord).await;
+    let outcome = reconcile_step(
+        &zone,
+        &custodian,
+        None,
+        None,
+        Some(&reconstruction),
+        None,
+        NOW,
+    )
+    .await
+    .expect("a queued obligation on a segmented object must not end the pass");
+
+    assert!(
+        queued_repairs(&meta).await.unwrap().contains(&SEG_QUEUED),
+        "the obligation for a chunk this pass could not repair MUST stay queued: \"I may not \
+         repair it\" and \"no committed map references it\" are different facts, and draining \
+         on the first deletes the last record saying live data is under-replicated"
+    );
+    assert!(
+        meta.get(&repair_key(SEG_QUEUED)).await.unwrap().is_some(),
+        "the obligation's ledger entry itself survives the pass"
+    );
+    // Nothing at all was written — not the `seg:` record, not the root, not the queue.
+    assert_eq!(
+        meta.snapshot(),
+        before,
+        "a refusal writes NOTHING: this slice owns no write to a segmented record (#682)"
+    );
+    assert_eq!(
+        outcome,
+        Reconciled::Blocked,
+        "a pass that refused a repair it was asked for may not certify: `Satisfied` there tells \
+         an operator redundancy is whole"
+    );
+}
+
+// ---- criterion (3): an unreadable object is NAMED, the walk continues, nothing certifies ----
+
+/// The conjunction, over one store holding BOTH shapes of unreadable record — a committed root
+/// whose own bytes will not decode (`inode:0`) and a segmented root naming a segment that was
+/// never written (`inode:1`) — met FIRST in key order, beside three healthy flat objects each
+/// carrying real work for one of the three passes.
+///
+/// Each pass must do all three things at once: return `Ok` (the walk continues), do the healthy
+/// objects' work, and refuse to certify while naming the records it could not read. Any one of
+/// them alone is satisfiable by a wrong implementation — an abort, a silent skip, or a pass that
+/// names the blocker and then returns without doing the rest of its job.
+#[tokio::test]
+async fn an_unreadable_object_is_named_the_walk_continues_and_no_pass_certifies() {
+    enable_audit_callsites();
+    let meta = MemMeta::default();
+    let (d0, d1, d3, d4) = (
+        MemDServer::default(),
+        MemDServer::default(),
+        MemDServer::default(),
+        MemDServer::default(),
+    );
+
+    seed_undecodable(&meta).await;
+    seed_damaged(&meta).await;
+    seed_repairable(&meta, &d0, &d1, REPAIR_INODE, REPAIR_CHUNK).await;
+    seed_flat(&meta, FILL_INODE, vec![rs_ref(FILL_CHUNK, vec![])]).await;
+    // The evacuation work: a single-copy chunk whose only fragment sits on the draining server.
+    seed_flat(
+        &meta,
+        EVAC_INODE,
+        vec![single_copy_ref(EVAC_CHUNK, EVAC_DRAINING)],
+    )
+    .await;
+    d4.put_fragment(frag(EVAC_CHUNK, 0), single_copy_fragment(EVAC_CHUNK))
+        .await
+        .unwrap();
+    set_lifecycle(&meta, EVAC_DRAINING, DServerLifecycle::Draining)
+        .await
+        .unwrap();
+
+    let mut topology = healthy_topology();
+    topology.register(EVAC_DRAINING, "E");
+    let fleet: [(DServerId, &dyn ChunkStore); 4] = [(0, &d0), (1, &d1), (3, &d3), (4, &d4)];
+    let reconstruction = ReconstructionContext {
+        meta: &meta,
+        fleet: &fleet,
+        topology: &topology,
+        unreachable: &[],
+    };
+    let rebalance = RebalanceContext {
+        meta: &meta,
+        fleet: &fleet,
+        topology: &topology,
+    };
+    let coord = MemCoordination::new();
+    let (zone, custodian) = elect(&coord).await;
+
+    // --- reconstruction ---
+    let capture = Capture::default();
+    let outcome = reconcile_step(
+        &zone,
+        &custodian,
+        None,
+        None,
+        Some(&reconstruction),
+        None,
+        NOW,
+    )
+    .with_subscriber(capturing_dispatch(capture.clone()))
+    .await
+    .expect("one unreadable record must not end the reconstruction pass");
+    assert_eq!(
+        outcome,
+        Reconciled::Blocked,
+        "reconstruction read less than the store, so it may not certify redundancy"
+    );
+    assert_eq!(
+        placement_of(&meta, REPAIR_INODE).await,
+        vec![0, 1, 3],
+        "the healthy object's queued repair was still assessed and repaired: one damaged record \
+         may not cost every other object its repair"
+    );
+    assert!(
+        queued_repairs(&meta).await.unwrap().is_empty(),
+        "and its obligation was drained by that repair"
+    );
+    assert_names_unreadable_records(&capture.contents(), "wyrd.custodian.reconstruction.audit");
+
+    // --- backfill ---
+    let capture = Capture::default();
+    let outcome = backfill::reconcile(&BackfillContext { meta: &meta })
+        .with_subscriber(capturing_dispatch(capture.clone()))
+        .await
+        .expect("one unreadable record must not end the backfill pass");
+    assert_eq!(
+        outcome,
+        Reconciled::Blocked,
+        "backfill's drain-to-zero gauge is drawn over less than the store, so it may not certify"
+    );
+    assert_eq!(
+        placement_of(&meta, FILL_INODE).await,
+        vec![0, 1, 2],
+        "the healthy object's fill still happened beside the record backfill could not read"
+    );
+    assert_names_unreadable_records(&capture.contents(), "wyrd.custodian.backfill.audit");
+
+    // --- rebalance ---
+    let capture = Capture::default();
+    let outcome = reconcile_step(&zone, &custodian, None, None, None, Some(&rebalance), NOW)
+        .with_subscriber(capturing_dispatch(capture.clone()))
+        .await
+        .expect("one unreadable record must not end the rebalance pass");
+    assert_eq!(
+        outcome,
+        Reconciled::Blocked,
+        "rebalance cannot see whether the records it could not read hold fragments on the \
+         draining server, so the drain is NOT satisfied"
+    );
+    assert_eq!(
+        placement_of(&meta, EVAC_INODE).await,
+        vec![0],
+        "the healthy object's fragment was still evacuated off the draining server"
+    );
+    assert!(
+        d0.holds(frag(EVAC_CHUNK, 0)),
+        "and its bytes were copied to the new home before the commit"
+    );
+    assert_names_unreadable_records(&capture.contents(), "wyrd.custodian.rebalance.audit");
+}
+
+// ---- criterion (4): a store fault under the resolve still ENDS the pass ----
+
+/// The other half of criterion (3), and what the downcast rule exists for: a fault that is not
+/// one object's own — the metadata store failing underneath the resolver's root re-read — has no
+/// answer for ANY object, so containing it as "this object is unreadable" would be the wrong
+/// answer for every object in the store. It must propagate.
+#[tokio::test]
+async fn a_store_fault_under_the_resolve_still_ends_every_pass() {
+    enable_audit_callsites();
+    let meta = MemMeta::default();
+    let d0 = MemDServer::default();
+
+    seed_segmented(
+        &meta,
+        SEGMENTED_INODE,
+        &[(SEG_QUEUED, 0), (SEG_OTHER, 0)],
+        2,
+    )
+    .await;
+    // Reconstruction only reads the namespace when it holds an obligation to place.
+    enqueue_repair(&meta, REPAIR_CHUNK, "scrub").await.unwrap();
+    set_lifecycle(&meta, IDLE_DRAINING, DServerLifecycle::Draining)
+        .await
+        .unwrap();
+    // Armed AFTER seeding: from here every root read fails with a plain, non-`ChunkMapError`
+    // backend fault — the resolve of a segmented map re-reads its root to settle the read.
+    meta.fail_gets_of(b"inode:");
+
+    let topology = healthy_topology();
+    let fleet: [(DServerId, &dyn ChunkStore); 1] = [(0, &d0)];
+    let reconstruction = ReconstructionContext {
+        meta: &meta,
+        fleet: &fleet,
+        topology: &topology,
+        unreachable: &[],
+    };
+    let rebalance = RebalanceContext {
+        meta: &meta,
+        fleet: &fleet,
+        topology: &topology,
+    };
+    let coord = MemCoordination::new();
+    let (zone, custodian) = elect(&coord).await;
+
+    let reconstruction_err = reconcile_step(
+        &zone,
+        &custodian,
+        None,
+        None,
+        Some(&reconstruction),
+        None,
+        NOW,
+    )
+    .await
+    .expect_err("a store fault under the resolve must END the reconstruction pass");
+    assert!(
+        reconstruction_err.to_string().contains(STORE_FAULT),
+        "the store's own fault propagates, not a chunk-map verdict: {reconstruction_err}"
+    );
+
+    let backfill_err = backfill::reconcile(&BackfillContext { meta: &meta })
+        .await
+        .expect_err("a store fault under the resolve must END the backfill pass");
+    assert!(
+        backfill_err.to_string().contains(STORE_FAULT),
+        "the store's own fault propagates, not a chunk-map verdict: {backfill_err}"
+    );
+
+    let rebalance_err = reconcile_step(&zone, &custodian, None, None, None, Some(&rebalance), NOW)
+        .await
+        .expect_err("a store fault under the resolve must END the rebalance pass");
+    assert!(
+        rebalance_err.to_string().contains(STORE_FAULT),
+        "the store's own fault propagates, not a chunk-map verdict: {rebalance_err}"
+    );
+}
+
+// ---- criterion (5): the reconstruction pass is O(N), not O(Q×N) ----
+
+/// The deployed repair loop was Q namespace scans × N record decodes: `assess` called
+/// `find_chunk`, which scanned the ENTIRE `inode:` namespace once per queued obligation. With
+/// the resolver wired in, each of those N objects also costs a bounded `seg:` range read — so
+/// left alone the pass would go from Q×N decodes to Q×N *resolves*, and a repair loop whose cost
+/// is the product of its backlog and the namespace stops converging as a store grows.
+///
+/// A COUNT, never a timing. Scoped to the reconstruction pass alone (no GC/scrub/rebalance
+/// context beside it): the other loops each walk `inode:` themselves, and sharing one walk
+/// across passes is a larger refactor that is not this slice's.
+#[tokio::test]
+async fn reconstruction_reads_the_namespace_once_per_pass_not_once_per_obligation() {
+    enable_audit_callsites();
+    let meta = MemMeta::default();
+    let (d0, d1, d3) = (
+        MemDServer::default(),
+        MemDServer::default(),
+        MemDServer::default(),
+    );
+
+    // N = 5 committed objects, 2 of them segmented; Q = 3 queued obligations, each in a
+    // DIFFERENT flat object (so all three repairs commit against their own record).
+    const FLAT_OBJECTS: [(InodeId, ChunkId); 3] = [(2, 0xA1_00), (3, 0xA2_00), (4, 0xA3_00)];
+    const SEGMENTED_OBJECTS: [InodeId; 2] = [5, 6];
+    for (inode, chunk) in FLAT_OBJECTS {
+        seed_repairable(&meta, &d0, &d1, inode, chunk).await;
+    }
+    for inode in SEGMENTED_OBJECTS {
+        seed_segmented(&meta, inode, &[(SEG_QUEUED + inode as u128, 0)], 1).await;
+    }
+    assert_eq!(
+        queued_repairs(&meta).await.unwrap().len(),
+        FLAT_OBJECTS.len(),
+        "fixture: the pass carries Q = 3 obligations"
+    );
+
+    let topology = healthy_topology();
+    let fleet: [(DServerId, &dyn ChunkStore); 3] = [(0, &d0), (1, &d1), (3, &d3)];
+    let reconstruction = ReconstructionContext {
+        meta: &meta,
+        fleet: &fleet,
+        topology: &topology,
+        unreachable: &[],
+    };
+
+    let coord = MemCoordination::new();
+    let (zone, custodian) = elect(&coord).await;
+    let outcome = reconcile_step(
+        &zone,
+        &custodian,
+        None,
+        None,
+        Some(&reconstruction),
+        None,
+        NOW,
+    )
+    .await
+    .expect("the pass must run over a store holding segmented objects");
+    assert_eq!(outcome, Reconciled::Changed, "all three repairs converged");
+
+    // The pass still does the WORK — the count leg cannot be satisfied by a pass that stopped
+    // repairing.
+    for (inode, _chunk) in FLAT_OBJECTS {
+        assert_eq!(
+            placement_of(&meta, inode).await,
+            vec![0, 1, 3],
+            "inode {inode}: repaired and repointed onto the free distinct domain"
+        );
+    }
+    assert!(
+        queued_repairs(&meta).await.unwrap().is_empty(),
+        "every obligation was discharged by its repair commit"
+    );
+
+    assert_eq!(
+        meta.inode_scans(),
+        1,
+        "ONE reading of the committed namespace per pass, independent of the Q = {} \
+         obligations it carried",
+        FLAT_OBJECTS.len(),
+    );
+    assert!(
+        meta.seg_reads() <= SEGMENTED_OBJECTS.len(),
+        "at most one bounded `seg:` range read per segmented object ({} of them), never one per \
+         obligation: got {}",
+        SEGMENTED_OBJECTS.len(),
+        meta.seg_reads(),
+    );
+}
