+    self, ChunkMap, ChunkRef, EcScheme, InodeRecord, InodeState, SegmentGroup, SegmentRecord,
+    SegmentRef, SegmentedMap,
+};
+use wyrd_core::placement::Topology;
+use wyrd_core::write::encode_ec_fragment;
+use wyrd_core::{erasure, repair};
+use wyrd_custodian::desired_state::{set_lifecycle, DServerLifecycle};
+use wyrd_custodian::{
+    reconcile_step, BackfillContext, Custodian, FencedZone, RebalanceContext, Reconciled,
+    ReconstructionContext,
+};
+use wyrd_traits::{
+    ChunkId, ChunkStore, CommitOutcome, DServerId, FragmentId, Health, MetadataStore, Result,
+    ScanPage, WriteBatch,
+};
+
+/// The injected fault's exact text, so leg 6 proves THIS error came back, not any error at all.
+const STORE_FAULT: &str = "simulated store fault: root re-read unreachable";
+
+/// ONE metadata double serving every role these legs need — the counters leg 5 reads and the `get`
+/// fault leg 6 injects, never three store types. `BTreeMap`, not `HashMap`: the containment legs
+/// need the DAMAGED record met FIRST, so "the healthy object was still handled" cannot pass on a
+/// walk that gives up at the first blocker.
+#[derive(Default)]
+struct MemMeta {
+    kv: Mutex<BTreeMap<Vec<u8>, Bytes>>,
+    /// `(namespace readings, bounded `seg:` range reads)` — what tells an O(N) pass from an O(Q×N)
+    /// one.
+    reads: Mutex<(usize, usize)>,
+    /// When armed, every `get` fails with a plain, non-`metadata::ChunkMapError` fault: a backend
+    /// outage under a read, not a structural anomaly the resolver describes and a pass downcasts.
+    failing_gets: Mutex<bool>,
+    /// When armed, the named row is REPLACED the first time that key is `get` — a racing writer
+    /// overwriting a root between the scan and the resolver's settle read
+    /// (`metadata.rs:2563-2573`).
+    supersede: Mutex<Option<(Vec<u8>, Bytes)>>,
+}
+
+#[async_trait]
+impl MetadataStore for MemMeta {
+    async fn get(&self, key: &[u8]) -> Result<Option<Bytes>> {
+        if *self.failing_gets.lock().unwrap() {
+            return Err(Box::new(std::io::Error::other(STORE_FAULT)));
+        }
+        let mut armed = self.supersede.lock().unwrap();
+        if armed.as_ref().is_some_and(|(at, _)| at == key) {
+            let (at, live) = armed.take().expect("armed");
+            self.kv.lock().unwrap().insert(at, live);
+        }
+        Ok(self.kv.lock().unwrap().get(key).cloned())
+    }
+
+    async fn scan(&self, prefix: &[u8]) -> Result<Vec<(Vec<u8>, Bytes)>> {
+        if prefix.starts_with(b"inode:") {
+            self.reads.lock().unwrap().0 += 1;
+        }
+        let kv = self.kv.lock().unwrap();
+        let rows = (kv.range(prefix.to_vec()..)).take_while(|(k, _)| k.starts_with(prefix));
+        Ok(rows.map(|(k, v)| (k.clone(), v.clone())).collect())
+    }
+
+    // The required paginated read (#634): the testkit helper pages over this store's own `scan`, as
+    // `segmented_map_consumers.rs:109-116` does.
+    async fn scan_page(&self, prefix: &[u8], after: Option<&[u8]>, n: usize) -> Result<ScanPage> {
+        if prefix.starts_with(b"seg:") {
+            self.reads.lock().unwrap().1 += 1;
+        }
+        wyrd_testkit::test_double_scan_page(self, prefix, after, n).await
+    }
+
+    async fn commit(&self, batch: WriteBatch) -> Result<CommitOutcome> {
+        let mut kv = self.kv.lock().unwrap();
+        let lost = |p: &wyrd_traits::Precondition| kv.get(&p.key).cloned() != p.expected;
+        if batch.preconditions.iter().any(lost) {
+            return Ok(CommitOutcome::Conflict);
+        }
+        kv.extend(batch.puts);
+        for key in batch.deletes {
+            kv.remove(&key);
+        }
+        Ok(CommitOutcome::Committed)
+    }
+}
