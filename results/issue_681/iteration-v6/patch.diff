+/// `pass` NAMED the record an operator has to go and find (`gc::object_name`'s escaping shape,
+/// `gc.rs:470-480`): attribution is what makes a blocker repairable. `None` asks all three.
+fn assert_named(logged: &str, pass: Option<&str>, object: &str) {
+    let quoted = format!(r#""{object}""#);
+    for pass in pass.map_or(PASSES.to_vec(), |one| vec![one]) {
+        let named = audit_lines(logged, pass)
+            .iter()
+            .any(|l| l.contains(&quoted));
+        assert!(named, "{pass} never named {object}. got: {logged}");
+    }
