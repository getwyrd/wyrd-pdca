+/// Every pass ran and none certified: each answered over less than the store, where `Satisfied`
+/// tells an operator a decommission is safe or redundancy whole.
+fn assert_none_certified(passes: [PassResult; 3], why: &str) {
+    for (pass, outcome) in PASSES.iter().zip(passes) {
+        let got = outcome.unwrap_or_else(|err| panic!("{pass} must not end the pass: {err}"));
+        assert_eq!(got, Reconciled::Blocked, "{pass} may not certify: {why}");
+    }
+}
