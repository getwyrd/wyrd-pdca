+/// The empty-placement gauge backfill published, read back off its seam BY VALUE — with the number
+/// of objects the pass could NOT account for, on the SAME sample. PARSED to the full digit run: a
+/// `contains` match on `":1"` reads a tenfold over-report of `10` as the `1` it wanted.
+fn assert_gauge(logged: &str, remaining: u64, unaccounted: u64) {
+    let fields = [
+        ("gauge.backfill_placement_remaining", remaining),
+        ("unaccounted", unaccounted),
+    ];
+    for (field, want) in fields {
+        let at = format!(r#""{field}":"#);
+        let got: Vec<u64> = (logged.split(&at).skip(1))
+            .map(|rest| rest.chars().take_while(char::is_ascii_digit).collect())
+            .map(|digits: String| digits.parse().expect("a numeric sample"))
+            .collect();
+        assert_eq!(got, [want], "the {field} sample: {logged}");
+    }
+}
