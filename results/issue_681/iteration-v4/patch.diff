+/// The audit lines `pass` emitted on its own seam.
+fn audit_lines<'a>(logged: &'a str, pass: &str) -> Vec<&'a str> {
+    let seam = format!(r#""target":"wyrd.custodian.{pass}.audit""#);
+    logged.lines().filter(|line| line.contains(&seam)).collect()
+}
