+// ---- in-memory trait doubles (the passes are proven over the seams, backend-agnostic) ----
+
+/// The injected fault's exact text, so leg 6 proves THIS error came back rather than accepting
+/// any error at all (a pre-fix tree fails that read differently).
+const STORE_FAULT: &str = "simulated store fault: root re-read unreachable";
+
+/// ONE metadata double serving every role these legs need — the two counters leg 5 reads and the
+/// injected `get` fault leg 6 needs, never three separate store types. `BTreeMap`, not a
+/// `HashMap`: the containment legs need the DAMAGED records met FIRST, otherwise "the healthy
+/// object was still handled" could pass on an implementation that abandons the walk at the first
+/// blocker. That ordering is a property of the fixture, not of luck.
+#[derive(Default)]
+struct MemMeta {
+    kv: Mutex<BTreeMap<Vec<u8>, Bytes>>,
+    /// `(committed-namespace reads, bounded `seg:` range reads)` — what tells an O(N) pass from
+    /// an O(Q×N) one, and what bounds the resolves a pass spends (leg 5).
+    reads: Mutex<(usize, usize)>,
+    /// When armed, every `get` fails with a plain, non-`metadata::ChunkMapError` fault: a genuine
+    /// backend outage under a read, as opposed to a structural anomaly the resolver itself
+    /// describes and a maintenance pass recovers by downcast.
+    failing_gets: Mutex<bool>,
+}
+
+#[async_trait]
+impl MetadataStore for MemMeta {
+    async fn get(&self, key: &[u8]) -> Result<Option<Bytes>> {
+        if *self.failing_gets.lock().unwrap() {
+            return Err(Box::new(std::io::Error::other(STORE_FAULT)));
+        }
+        Ok(self.kv.lock().unwrap().get(key).cloned())
+    }
+
+    async fn scan(&self, prefix: &[u8]) -> Result<Vec<(Vec<u8>, Bytes)>> {
+        if prefix.starts_with(b"inode:") {
+            self.reads.lock().unwrap().0 += 1;
+        }
+        let kv = self.kv.lock().unwrap();
+        let rows = kv
+            .range(prefix.to_vec()..)
+            .take_while(|(k, _)| k.starts_with(prefix));
+        Ok(rows.map(|(k, v)| (k.clone(), v.clone())).collect())
+    }
+
+    // The required paginated read (#634): a test double needs *a* body, not a backend's — the
+    // dev-only testkit helper pages over this store's own `scan` (`consumers.rs:109-116`).
+    async fn scan_page(
+        &self,
+        prefix: &[u8],
+        after: Option<&[u8]>,
+        limit: usize,
+    ) -> Result<wyrd_traits::ScanPage> {
+        if prefix.starts_with(b"seg:") {
+            self.reads.lock().unwrap().1 += 1;
+        }
+        wyrd_testkit::test_double_scan_page(self, prefix, after, limit).await
+    }
