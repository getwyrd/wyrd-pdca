+
+    async fn put(&self, key: &[u8], value: Bytes) {
+        let batch = WriteBatch::new().put(key.to_vec(), value);
+        let seeded = self.meta.commit(batch).await.unwrap();
+        assert_eq!(seeded, CommitOutcome::Committed, "the fixture seeds");
+    }
+
+    /// Write the fragments `present` names onto the servers `placement` puts them on — REAL
+    /// erasure-coded bytes from the same two `core` calls the production rebuild makes, so a
+    /// gathered survivor passes `intact_shard` and an evacuated one `fragment_intact`.
+    async fn place(&self, chunk: ChunkId, placement: &[DServerId], present: &[u16]) {
+        let shards = erasure::encode(K as usize, M as usize, PAYLOAD).unwrap();
+        for &index in present {
+            // An empty committed placement resolves fragment `i` to D-server `i` (the identity
+            // fallback every consumer shares, `metadata.rs:119-124`) — seed where the record says.
+            let at = placement.get(index as usize).copied();
+            let shard = &shards[index as usize];
+            let bytes = encode_ec_fragment(chunk, index, K, M, shard);
+            let put = self.fleet[at.unwrap_or(index.into()) as usize]
+                .put_fragment(frag(chunk, index), bytes);
+            put.await.unwrap();
+        }
+    }
+
+    /// Plant ONE committed object under the raw key `key` — the only seeding entry in this file,
+    /// so every leg's store differs by its arguments and not by a fixture of its own. Raw
+    /// `WriteBatch` puts, never a publish path (#653 owns the committer), through the real
+    /// validating constructors so a fixture typo cannot change WHICH rule a leg exercises. And
+    /// it **asserts its own fault is real**: a containment leg must never pass because the
+    /// damage it was built around quietly stopped being damage.
+    async fn seed(&self, key: &[u8], shape: Shape) {
+        let (map, size, readable) = match shape {
+            Shape::Undecodable => {
+                let bad = metadata::decode::<InodeRecord>(UNREADABLE).is_err();
+                assert!(bad, "fixture: those bytes must really fail to decode");
+                return self.put(key, Bytes::from_static(UNREADABLE)).await;
+            }
+            Shape::Flat(chunks) => {
+                let mut refs = Vec::new();
+                for (id, placement, present) in &chunks {
+                    self.place(*id, placement, present).await;
+                    refs.push(chunk_ref(*id, placement.clone()));
+                }
+                let size = refs.len() as u64 * CHUNK_LEN;
+                (ChunkMap::from(refs), size, true)
+            }
+            Shape::Segmented(nonce, written, chunks) => {
+                let group = SegmentGroup::new(nonce, EPOCH).unwrap();
+                let mut table = Vec::new();
+                for (index, (id, placement, present)) in chunks.iter().enumerate() {
+                    self.place(*id, placement, present).await;
+                    let (index, byte_offset) = (index as u32, index as u64 * CHUNK_LEN);
+                    table.push(SegmentRef {
+                        index,
+                        byte_offset,
+                        byte_len: CHUNK_LEN,
+                    });
+                    if (index as usize) < written {
+                        let refs = vec![chunk_ref(*id, placement.clone())];
+                        let record = SegmentRecord::new(refs, byte_offset).unwrap();
+                        let seg = metadata::seg_key(&group, index).unwrap();
+                        self.put(&seg, metadata::encode(&record)).await;
+                    }
+                }
+                let (size, readable) = (table.len() as u64 * CHUNK_LEN, written == table.len());
+                let map = SegmentedMap::new(group, table).unwrap();
+                (ChunkMap::Segmented(map), size, readable)
+            }
+        };
+        let root = InodeRecord {
+            size,
+            chunk_map: map,
+            state: InodeState::Committed,
+            version: 1,
+            ..Default::default()
+        };
+        self.put(key, metadata::encode(&root)).await;
+        let map = metadata::resolve_chunk_map(&self.meta, key, &root).await;
+        assert_eq!(map.is_ok(), readable, "fixture: resolves == {readable}");
+    }
+
+    /// The store every leg's positive half rests on: one segmented object (three chunks — two
+    /// with a fragment on the draining server, one fillable) beside three flat objects carrying
+    /// real work — a chunk to repair, a placement to fill, a fragment to evacuate — and the drain.
+    async fn seed_fixture(&self) {
+        let segments = vec![
+            seeded(S_DRAIN_A, &[0, 1, DRAINING], &[2]),
+            seeded(S_DRAIN_B, &[0, 1, DRAINING], &[2]),
+            seeded(S_FILL, &[], &[]),
+        ];
+        self.seed(SEG, Shape::Segmented(NONCE, 3, segments)).await;
+        self.seed(F_REPAIR, one(C_REPAIR, &[0, 1, 4], &[0, 1]))
+            .await;
+        self.seed(F_FILL, one(C_FILL, &[], &[])).await;
+        self.seed(F_EVAC, one(C_EVAC, &[0, 1, DRAINING], &[0, 1, 2]))
+            .await;
+        let drain = set_lifecycle(&self.meta, DRAINING, DServerLifecycle::Draining);
+        drain.await.unwrap();
+    }
+
+    /// ONE reconciliation step through the REAL fenced control point (`reconcile_step`) — never a
+    /// parallel entry — dispatching the loops `recon` / `rebal` select.
+    async fn step(&self, recon: bool, rebal: bool) -> PassResult {
+        let coord = MemCoordination::new();
+        let leader = Custodian::elect(&coord, "zone-passes").await.unwrap();
+        let mut zone = FencedZone::new();
+        zone.install(leader.leadership());
+        let view: Vec<(DServerId, &dyn ChunkStore)> = self
+            .fleet
+            .iter()
+            .enumerate()
+            .map(|(id, store)| (id as DServerId, store as &dyn ChunkStore))
+            .collect();
+        let reconstruction = ReconstructionContext {
+            meta: &self.meta,
+            fleet: &view,
+            topology: &self.topo,
+            unreachable: &[],
+        };
+        let rebalance = RebalanceContext {
+            meta: &self.meta,
+            fleet: &view,
+            topology: &self.topo,
+        };
+        let recon = recon.then_some(&reconstruction);
+        let rebal = rebal.then_some(&rebalance);
+        reconcile_step(&zone, &leader, None, None, recon, rebal, NOW)
+            .await
+            .map_err(|err| err.to_string())
+    }
+
+    /// One backfill pass, through its own public entry (it is not yet threaded through
+    /// `reconcile_step` — `backfill.rs:40-44`).
+    async fn backfill(&self) -> PassResult {
+        wyrd_custodian::backfill::reconcile(&BackfillContext { meta: &self.meta })
+            .await
+            .map_err(|err| err.to_string())
+    }
+
+    /// Drive ALL THREE passes over this store under one audit subscriber, answering what each
+    /// said. Every leg drives all three — that is what keeps this file six tests, not eighteen.
+    async fn drive(&self, audit: &Capture) -> [PassResult; 3] {
+        let passes = async {
+            let (recon, rebal) = (self.step(true, false).await, self.step(false, true).await);
+            [recon, rebal, self.backfill().await]
+        };
+        passes
+            .with_subscriber(capturing_dispatch(audit.clone()))
+            .await
+    }
+
+    async fn record(&self, key: &[u8]) -> InodeRecord {
+        let bytes = self.meta.get(key).await.unwrap().expect("record present");
+        metadata::decode(&bytes).unwrap()
+    }
+
+    /// The committed placement of a **flat** object's chunk `index` — what a repair, a fill and
+    /// an evacuation each move, and what a refusal must leave exactly where it was.
+    async fn placement(&self, key: &[u8], index: usize) -> Vec<DServerId> {
+        let map = self.record(key).await.chunk_map;
+        map.as_flat().unwrap()[index].placement.clone()
+    }
+
+    async fn enqueue(&self, chunk: ChunkId) {
+        let enqueued = repair::enqueue_repair(&self.meta, chunk, "scrub");
+        enqueued.await.unwrap();
+    }
+
+    async fn queued(&self) -> Vec<ChunkId> {
+        repair::queued_repairs(&self.meta).await.unwrap()
+    }
+
+    /// Every flat object in the shared fixture ended up with its work done: the repair repointed
+    /// onto a free distinct domain, the fill materialised, the evacuation moved off server 3 —
+    /// all three landing on the same `[0, 1, 2]` by construction.
+    async fn assert_flat_work_done(&self) {
+        for (key, work) in [(F_REPAIR, "repair"), (F_FILL, "fill"), (F_EVAC, "evac")] {
+            let moved = self.placement(key, 0).await;
+            assert_eq!(moved, vec![0, 1, 2], "the flat {work} happened");
+        }
+    }
+}
+
+// ---- leg 1: a segmented object ends no pass, and the flat work still happens ----
+
+/// On the base every one of the three passes returns `Err` over this store for a single reason:
+/// one object in it is segmented. "Returned `Ok`" is the base-red half — but `Ok` alone would
+/// also be produced by a pass that quietly stepped over every object, so each pass is asked for
+/// its POSITIVE work too, and for the bytes that back it.
+#[tokio::test]
+async fn a_segmented_object_ends_no_pass_and_the_flat_work_still_happens() {
+    enable_audit_callsites();
+    let store = Store::new();
+    store.seed_fixture().await;
+    store.enqueue(C_REPAIR).await;
+
+    // ONE fenced step dispatching BOTH loops, then backfill's own entry.
+    store.step(true, true).await.expect("the step must run");
+    store.backfill().await.expect("the backfill pass must run");
+
+    store.assert_flat_work_done().await;
+    let landed = store.holds(2, frag(C_REPAIR, 2)) && store.holds(2, frag(C_EVAC, 2));
+    assert!(landed, "the rebuilt and evacuated bytes reached server 2");
+    let queued = store.queued().await;
+    assert!(queued.is_empty(), "the repaired obligation was discharged");
+}
+
+// ---- leg 2: work in a `seg:` record is refused, never discarded ----
+
+/// The failure mode this slice must not introduce while removing the abort: an obligation whose
+/// chunk lives in a `seg:` record read as "referenced by no committed chunk map" and DRAINED as
+/// if the chunk were deleted (`reconstruction.rs:322-325` → `Assessment::Drain`). Refuse instead.
+#[tokio::test]
+async fn work_in_a_segmented_record_is_refused_never_discarded() {
+    enable_audit_callsites();
+    let store = Store::new();
+    store.seed_fixture().await;
+    store.enqueue(S_DRAIN_A).await;
+
+    let group = SegmentGroup::new(NONCE, EPOCH).unwrap();
+    let seg_key = metadata::seg_key(&group, 0).unwrap();
+    let before = store.meta.get(&seg_key).await.unwrap();
+    let version = store.record(SEG).await.version;
+
+    let audit = Capture::default();
+    let passes = store.drive(&audit).await;
+    assert_none_certified(passes, "it refused work that was owed and did not do it");
+
+    // The obligation is KEPT, never discharged for want of a writable shape; the drain is not
+    // silently completed either.
+    let queued = store.queued().await;
+    assert_eq!(queued, vec![S_DRAIN_A], "the refusal kept the obligation");
+    let stayed = store.holds(DRAINING, frag(S_DRAIN_A, 2));
+    assert!(stayed, "the refused fragment stays on the draining server");
+    // And NOTHING at all was written to the object: not its segments, not its root.
+    let after = store.meta.get(&seg_key).await.unwrap();
+    assert_eq!(after, before, "a refusal leaves `seg:` byte-identical");
+    let generation = store.record(SEG).await.version;
+    assert_eq!(generation, version, "a refusal never moves the root");
+
+    // Pinned decision 5 — a refusal is reported ONCE per object, not once per chunk. This object
+    // has TWO fragments on the draining server; a per-chunk line floods the audit seam of exactly
+    // the operator trying to read it.
+    let logged = audit.contents();
+    assert_named(&logged, Some("rebalance"), "inode:20");
+    let refusals = audit_lines(&logged, "rebalance")
+        .iter()
+        .filter(|line| line.contains(r#""action":"refused""#))
+        .count();
+    assert_eq!(refusals, 1, "ONE refusal per object, not one per chunk");
+}
+
+// ---- leg 3: an unreadable object is named, the walk continues, nothing certifies ----
+
+/// Containment is per object, and the answer still gets made. Two damaged objects sit FIRST in
+/// the store's key order — a root naming a `seg:` record that was never written, and a record
+/// whose own bytes will not decode — so a pass that abandons its walk at the first blocker
+/// cannot pass this leg by accident. Carries pinned decisions 2 and 3 as sub-assertions.
+#[tokio::test]
+async fn an_unreadable_object_is_named_and_the_walk_continues() {
+    enable_audit_callsites();
+    let store = Store::new();
+    let unwritten = vec![
+        seeded(0xD1, &[0, 1, 4], &[]),
+        seeded(C_UNSEEN, &[0, 1, 4], &[]),
+    ];
+    store
+        .seed(DAMAGED_SEG, Shape::Segmented(OTHER_NONCE, 1, unwritten))
+        .await;
+    store.seed(DAMAGED_RECORD, Shape::Undecodable).await;
+    store.seed_fixture().await;
+    store.enqueue(C_REPAIR).await;
+    store.enqueue(C_UNSEEN).await;
+
+    let audit = Capture::default();
+    let passes = store.drive(&audit).await;
+    assert_none_certified(passes, "it read less than the store");
+
+    // The sharpest edge of C-1: "I could not read the map" and "no committed map references this
+    // chunk" are different facts, and only the second permits a drain. `C_UNSEEN` is referenced
+    // only by the object the reading could not read, so an incomplete reading must KEEP its
+    // obligation — collapsing the two deletes the last record saying live data is at risk.
+    let kept = store.queued().await;
+    assert_eq!(kept, vec![C_UNSEEN], "never drained for want of a reading");
+    let drop = WriteBatch::new().delete(repair::repair_key(C_UNSEEN));
+    assert_eq!(
+        store.meta.commit(drop).await.unwrap(),
+        CommitOutcome::Committed
+    );
+
+    // One damaged record may not cost every other object its repair, its fill or its evacuation
+    // — and both damaged objects are NAMED, on each pass's own seam, by their `inode:` key.
+    store.assert_flat_work_done().await;
+    let logged = audit.contents();
+    assert_named(&logged, None, "inode:1");
+    assert_named(&logged, None, "inode:2");
+
+    // Pinned decision 2: a pass certifies only over the reading it PERFORMED. With no obligation
+    // queued, reconstruction reads no namespace at all — so it makes no claim about the damaged
+    // objects and answers `Satisfied`, having spent nothing looking for damage it would not act
+    // on (the Q×N-shaped waste this slice exists to remove).
+    assert!(store.queued().await.is_empty(), "the queue is drained");
+    store.take_reads();
+    let idle = store.step(true, false).await.expect("the idle pass ran");
+    assert_eq!(idle, Reconciled::Satisfied, "an idle pass certifies");
+    assert_eq!(
+        store.take_reads().0,
+        0,
+        "an idle pass reads no namespace at all"
+    );
+
+    // Pinned decision 3: a record is read, written and named under exactly the key the store gave
+    // it. `"inode:007"` and `"inode:7"` both parse to id 7, so a pass that re-derives
+    // `metadata::inode_key(id)` for its CAS reads one record and commits over the OTHER — and
+    // where the two records' bytes coincide the CAS succeeds and clobbers an unrelated object.
+    let twins = Store::new();
+    twins.seed(b"inode:007", one(C_FILL, &[], &[])).await;
+    let bytes = twins.meta.get(b"inode:007").await.unwrap().unwrap();
+    twins.put(b"inode:7", bytes).await;
+    twins.backfill().await.expect("backfill ran over both keys");
+    for key in [&b"inode:007"[..], b"inode:7"] {
+        let filled = twins.placement(key, 0).await;
+        assert_eq!(filled, vec![0, 1, 2], "filled in place, on its OWN key");
+    }
+}
+
+// ---- leg 4: a duplicate committed chunk id is repaired by neither reference ----
+
+/// Ids are allocator-minted (`write.rs:170`), never content-addressed, so two committed maps
+/// claiming one `ChunkId` is always an anomaly. Repairing "whichever the scan met first" — what
+/// the base does at `reconstruction.rs:639` — repoints one record while orphan-marking a fragment
+/// the other still points at, which GC then reclaims. So neither is repaired, the obligation
+/// stays queued, and both are named — the same whether the duplicates sit in two records or one.
+#[tokio::test]
+async fn a_duplicate_committed_chunk_id_is_repaired_by_neither_reference() {
+    enable_audit_callsites();
+    let store = Store::new();
+    let twice = vec![
+        seeded(C_EVAC, &[0, 1, 4], &[0, 1]),
+        seeded(C_EVAC, &[0, 1, 4], &[]),
+    ];
+    let claim = || one(C_REPAIR, &[0, 1, 4], &[0, 1]);
+    store.seed(b"inode:40", claim()).await;
+    store.seed(b"inode:41", claim()).await;
+    store.seed(b"inode:42", Shape::Flat(twice)).await;
+    store.enqueue(C_REPAIR).await;
+    store.enqueue(C_EVAC).await;
+
+    let audit = Capture::default();
+    let outcome = store
+        .step(true, false)
+        .with_subscriber(capturing_dispatch(audit.clone()))
+        .await
+        .expect("an ambiguity contains to the objects claiming it");
+
+    assert_eq!(outcome, Reconciled::Blocked, "an ambiguity is not a repair");
+    let kept = store.queued().await.len();
+    assert_eq!(kept, 2, "neither obligation is drained");
+    for (key, index) in [(&b"inode:40"[..], 0), (b"inode:41", 0), (b"inode:42", 1)] {
+        let put = store.placement(key, index).await;
+        assert_eq!(put, vec![0, 1, 4], "no ambiguous reference is repointed");
+    }
+    let logged = audit.contents();
+    assert_named(&logged, Some("reconstruction"), "inode:40");
+    assert_named(&logged, Some("reconstruction"), "inode:41");
+}
+
+// ---- leg 5: reconstruction reads the namespace once per pass ----
+
+/// The deployed repair loop is Q namespace scans × N point reads: `assess` calls `find_chunk` per
+/// obligation and `find_chunk` scans all of `inode:`. Wire the resolver in naively and each of
+/// those N objects also costs a bounded `seg:` range read — Q×N *resolves*, which stops
+/// converging as a store grows (C-1, reached through the scheduler).
+///
+/// Driven with a reconstruction context and NO other loop beside it: the others walk `inode:`
+/// themselves, and sharing one walk across passes is a larger refactor that is out of scope.
+#[tokio::test]
+async fn reconstruction_reads_the_namespace_once_per_pass() {
+    enable_audit_callsites();
+    let store = Store::new();
+    // N = 3 committed flat objects, each holding one repairable chunk; Q = 3 obligations.
+    let repairable = [C_REPAIR, C_FILL, C_EVAC];
+    for (n, chunk) in repairable.iter().enumerate() {
+        let key = format!("inode:5{n}").into_bytes();
+        store.seed(&key, one(*chunk, &[0, 1, 4], &[0, 1])).await;
+        store.enqueue(*chunk).await;
+    }
+    // S = 2 segmented objects beside them, so the bounded `seg:` range reads are counted too.
+    for (s, nonce) in [NONCE, OTHER_NONCE].into_iter().enumerate() {
+        let key = format!("inode:6{s}").into_bytes();
+        let chunks = vec![seeded(0xE0 + s as ChunkId, &[0, 1, 4], &[])];
+        store.seed(&key, Shape::Segmented(nonce, 1, chunks)).await;
+    }
+
+    store.take_reads();
+    store.step(true, false).await.expect("the pass must run");
+
+    let (inode_reads, seg_reads) = store.take_reads();
+    assert_eq!(inode_reads, 1, "read ONCE, not once per obligation");
+    assert!(seg_reads <= 2, "one `seg:` read per object: {seg_reads}");
+    // The bound is worth nothing if the repairs stopped landing.
+    for n in 0..repairable.len() {
+        let moved = store.placement(format!("inode:5{n}").as_bytes(), 0).await;
+        assert_eq!(moved, vec![0, 1, 2], "every queued repair still lands");
+    }
+    let queued = store.queued().await;
+    assert!(queued.is_empty(), "every obligation was discharged");
+}
+
+// ---- leg 6: a fault that is not one object's map still ends the pass ----
+
+/// The other half of containment, and the reason it is not over-containment: a store failing
+/// underneath the resolver is not one object's fault, so it must NOT be folded into "this object
+/// is unreadable" — a walk that cannot reach the store has no answer for ANY object. It also
+/// binds pinned decision 6: the fault is on `get`, which the segmented object's resolve reaches
+/// AFTER the undecodable record was met, so that name is on the seam before the `Err`.
+#[tokio::test]
+async fn a_fault_that_is_not_one_objects_map_still_ends_the_pass() {
+    enable_audit_callsites();
+    let store = Store::new();
+    store.seed(DAMAGED_RECORD, Shape::Undecodable).await;
+    store.seed_fixture().await;
+    store.enqueue(S_DRAIN_A).await;
+    *store.meta.failing_gets.lock().unwrap() = true;
+
+    let audit = Capture::default();
+    let passes = store.drive(&audit).await;
+    for (pass, outcome) in PASSES.iter().zip(passes) {
+        let err = outcome.expect_err("a store fault must not be absorbed");
+        let propagated = err.contains(STORE_FAULT);
+        assert!(propagated, "{pass} absorbed a store fault: {err}");
+    }
+
+    // Pinned decision 6: attribution is emitted where the object is READ, before the work — so a
+    // later transient fault cannot cost the operator the name of the record to repair.
+    assert_named(&audit.contents(), None, "inode:2");
+}
