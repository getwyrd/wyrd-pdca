+/// The three passes, in the order [`Store::drive`] answers them.
+const PASSES: [&str; 3] = ["reconstruction", "rebalance", "backfill"];
+
+/// What one pass answered, uniform across the three so a leg can assert over all of them.
+type PassResult = std::result::Result<Reconciled, String>;
