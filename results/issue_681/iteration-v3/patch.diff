+/// The name is `gc::object_name`'s escaping shape (`gc.rs:470-480`); `None` asks all three.
+fn assert_named(logged: &str, pass: Option<&str>, object: &str) {
+    for pass in pass.map_or(PASSES.to_vec(), |one| vec![one]) {
+        let named = audit_lines(logged, pass).iter().any(|l| l.contains(object));
+        assert!(named, "{pass} never named {object}. got: {logged}");
+    }
