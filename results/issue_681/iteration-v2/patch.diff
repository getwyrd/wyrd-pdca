+/// A single-copy chunk reference with an **empty** placement — the pre-M3 / mixed-era shape
+/// backfill fills, and the one every other consumer resolves through the identity fallback
+/// (fragment 0 → D server 0).
+fn unplaced_ref(chunk: ChunkId) -> ChunkRef {
+    ChunkRef {
+        placement: vec![],
+        ..single_copy_ref(chunk, 0)
