+// ---- in-memory trait stores (the passes are proven over the seams, backend-agnostic) ----
+
+/// A trivial in-memory metadata store that **counts its reads**, can be armed to fail a `get`
+/// under a chosen prefix, and can land a **racing writer's** record inside either of the two
+/// windows a maintenance pass actually races: between the root read and the `seg:` range read
+/// (decision 7(h)'s supersede), and between the read and the CAS (a lost commit).
+///
+/// `BTreeMap`, so `scan` answers in key order and the DAMAGED record is always the one a walk
+/// meets FIRST — otherwise "the healthy object was still handled" could pass on an
+/// implementation that abandons the walk at the first blocker, simply because the healthy
+/// object had already been handled by then.
+#[derive(Default)]
+struct MemMeta {
+    kv: Mutex<BTreeMap<Vec<u8>, Bytes>>,
+    /// How many times the committed namespace was scanned — the O(N)-not-O(Q×N) property is a
+    /// COUNT, never a timing.
+    inode_scans: Mutex<usize>,
+    /// How many bounded `seg:<nonce>:<epoch>:` range reads were issued (each `scan_page` of a
+    /// group's range pages through this store's own `scan`).
+    seg_reads: Mutex<usize>,
+    /// A key prefix whose `get` fails with a plain, non-`ChunkMapError` fault — a genuine
+    /// backend outage underneath the resolver's root re-read, which is not one object's fault
+    /// and must end the pass rather than be contained as "this object is unreadable".
+    failing_gets: Mutex<Option<Vec<u8>>>,
+    /// A one-shot raw put landed the first time a `seg:` range is read: the window the
+    /// resolver's restart exists for — the root is read at one instant, its segments at
+    /// another, and the generation can be retired in between.
+    race_on_seg_read: Mutex<Option<(Vec<u8>, Bytes)>>,
+    /// A one-shot raw put landed just BEFORE the next commit's preconditions are evaluated —
+    /// the window a lost CAS is: the generation the pass read is gone by the time it writes.
+    race_on_commit: Mutex<Option<(Vec<u8>, Bytes)>>,
+}
+
+impl MemMeta {
+    /// Land a pending one-shot racing write as the window it was armed for is entered. A raw
+    /// put, exactly as the racing publisher's own commit would leave the store.
+    fn land_race(&self, armed: &Mutex<Option<(Vec<u8>, Bytes)>>) {
+        let pending = armed.lock().unwrap().take();
+        if let Some((key, value)) = pending {
+            self.kv.lock().unwrap().insert(key, value);
+        }
+    }
+
+    /// Every key/value the store holds — so a leg can assert a pass wrote **nothing at all**,
+    /// which is stronger than checking the handful of records it thought to look at.
+    fn snapshot(&self) -> BTreeMap<Vec<u8>, Bytes> {
+        self.kv.lock().unwrap().clone()
+    }
+}
+
+#[async_trait]
+impl MetadataStore for MemMeta {
+    async fn get(&self, key: &[u8]) -> Result<Option<Bytes>> {
+        if let Some(failing) = self.failing_gets.lock().unwrap().as_deref() {
+            if key.starts_with(failing) {
+                return Err(Box::new(std::io::Error::other(STORE_FAULT)));
+            }
+        }
+        Ok(self.kv.lock().unwrap().get(key).cloned())
+    }
+
+    async fn scan(&self, prefix: &[u8]) -> Result<Vec<(Vec<u8>, Bytes)>> {
+        if prefix.starts_with(b"inode:") {
+            *self.inode_scans.lock().unwrap() += 1;
+        }
+        if prefix.starts_with(b"seg:") {
+            *self.seg_reads.lock().unwrap() += 1;
+            self.land_race(&self.race_on_seg_read);
+        }
+        Ok(self
+            .kv
+            .lock()
+            .unwrap()
+            .iter()
+            .filter(|(k, _)| k.starts_with(prefix))
+            .map(|(k, v)| (k.clone(), v.clone()))
+            .collect())
+    }
+
+    // The required paginated read (#634): a test double needs *a* body, not a backend's — the
+    // dev-only testkit helper pages over this store's own `scan`.
+    async fn scan_page(
+        &self,
+        prefix: &[u8],
+        after: Option<&[u8]>,
+        limit: usize,
+    ) -> Result<wyrd_traits::ScanPage> {
+        wyrd_testkit::test_double_scan_page(self, prefix, after, limit).await
+    }
+
+    async fn commit(&self, batch: WriteBatch) -> Result<CommitOutcome> {
+        // The racing writer lands FIRST, so the preconditions below are evaluated against the
+        // store a real commit would have found: a genuinely lost CAS, not a simulated verdict.
+        self.land_race(&self.race_on_commit);
+        let mut kv = self.kv.lock().unwrap();
+        for pre in &batch.preconditions {
+            if kv.get(&pre.key).cloned() != pre.expected {
+                return Ok(CommitOutcome::Conflict);
+            }
+        }
+        for (k, v) in batch.puts {
+            kv.insert(k, v);
+        }
+        for k in batch.deletes {
+            kv.remove(&k);
+        }
+        Ok(CommitOutcome::Committed)
+    }
+}
+
+/// Bytes that are not an [`InodeRecord`] — a committed record whose own bytes will not decode,
+/// contained by the same per-object rule as a generation the resolver cannot read.
+const UNDECODABLE_RECORD: &[u8] = b"not a record";
+
+/// The injected store fault's exact text, so a leg proves THIS fault came back rather than
+/// accepting any error at all — a pre-fix tree fails the same read differently.
+const STORE_FAULT: &str = "simulated store fault: metadata store unreachable";
+
+/// One D server's fragment bytes — a deliberately dumb `ChunkStore`.
+#[derive(Default)]
+struct MemDServer {
+    frags: Mutex<HashMap<FragmentId, Bytes>>,
+}
+
+#[async_trait]
+impl ChunkStore for MemDServer {
+    async fn put_fragment(&self, id: FragmentId, fragment: Bytes) -> Result<()> {
+        self.frags.lock().unwrap().insert(id, fragment);
+        Ok(())
+    }
+
+    async fn get_fragment(&self, id: FragmentId) -> Result<Option<Bytes>> {
+        Ok(self.frags.lock().unwrap().get(&id).cloned())
+    }
+
+    async fn list_fragments(&self) -> Result<Vec<FragmentId>> {
+        Ok(self.frags.lock().unwrap().keys().copied().collect())
+    }
+
+    async fn delete_fragment(&self, id: FragmentId) -> Result<()> {
+        self.frags.lock().unwrap().remove(&id);
+        Ok(())
+    }
+
+    async fn health(&self) -> Result<Health> {
+        Ok(Health::Healthy)
+    }
+}
