+const DAMAGED_HELD: ChunkId = 0xD1_00;
+const DAMAGED_UNWRITTEN: ChunkId = 0xD2_00;
+
+/// The fence epoch every fixture segment group is scoped by; each object gets its OWN nonce
+/// (derived from its inode id), so nothing about one object is inside another's bounded range.
+const EPOCH: u64 = 7;
+
+/// The scheme every repairable fixture chunk carries: RS(2,1) — three fragments, any two of
