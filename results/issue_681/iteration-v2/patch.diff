+/// fragment is genuinely movable.
+fn single_copy_fragment(chunk: ChunkId) -> Bytes {
+    let header = FragmentHeader::new_v1(chunk, DATA.len() as u64);
+    Bytes::from(wyrd_chunk_format::encode(&header, DATA))
+}
+
+/// A committed root record over `chunks_len` chunks, at `version`.
+fn root_record(chunks_len: usize, chunk_map: ChunkMap, version: u64) -> InodeRecord {
+    InodeRecord {
+        size: chunks_len as u64 * DATA.len() as u64,
+        chunk_map,
+        state: InodeState::Committed,
+        version,
+        ..Default::default()
+    }
+}
+
+/// The two shapes of committed record a pass cannot read. Contained by the same per-object
+/// rule, and each exercised on its own so neither pass's containment of one shape can be
+/// carried by its containment of the other.
+#[derive(Clone, Copy)]
+enum Damage {
+    /// Bytes that are not an `InodeRecord` at all: the fault is found before any resolver.
+    Undecodable,
+    /// A segmented root naming a segment that was never written: the resolver's own typed
+    /// verdict that THIS generation cannot be read.
+    Unresolvable,
+}
+
+/// Which pass a leg is driving, named by the entry it is reached through: `reconcile_step` (the
+/// fenced control point, never a parallel entry) for reconstruction and rebalance — together
+/// where a leg drives ONE step over both — and `backfill::reconcile` for the fill.
+#[derive(Clone, Copy)]
+enum Pass {
+    Reconstruction,
+    Rebalance,
+    RepairAndDrain,
+    Backfill,
+}
+
+/// The situation one leg seeds and the passes it drives: the metadata store, the D-server
+/// fleet, the failure-domain view, and the leadership fence the control point is admitted
+/// through. One place, so a leg reads as what it seeds and what it asks rather than as three
+/// copies of the same wiring.
+struct Fixture {
+    meta: MemMeta,
+    dservers: [MemDServer; FLEET_SIZE],
+    /// Servers 0 (A), 1 (B) and 3 (D) are registered by default — server 2 is the dead one, so
+    /// a rebuild has exactly one free distinct domain (D) to land on and the move is
+    /// deterministic. A leg registering a draining server adds it.
+    topology: Topology,
+    zone: FencedZone,
+    custodian: Custodian,
+}
+
+impl Fixture {
+    async fn new() -> Self {
+        enable_audit_callsites();
+        let coord = MemCoordination::new();
+        let custodian = Custodian::elect(&coord, "zone-681").await.unwrap();
+        let mut zone = FencedZone::new();
+        zone.install(custodian.leadership());
+        let mut topology = Topology::default();
+        topology.register(0, "A").register(1, "B").register(3, "D");
+        Self {
+            meta: MemMeta::default(),
+            dservers: Default::default(),
+            topology,
+            zone,
+            custodian,
+        }
+    }
+
+    /// The fleet every pass is handed. A server holding no fragments is exactly a server whose
+    /// fragments are gone, so one fleet serves every leg.
+    fn fleet(&self) -> [(DServerId, &dyn ChunkStore); FLEET_SIZE] {
+        std::array::from_fn(|i| (i as DServerId, &self.dservers[i] as &dyn ChunkStore))
+    }
+
+    /// Drive one pass over this store under its OWN audit capture, returning what it answered
+    /// and what it recorded on the durability seam.
+    async fn run(&self, pass: Pass) -> (Result<Reconciled>, String) {
+        let fleet = self.fleet();
+        let repair = ReconstructionContext {
+            meta: &self.meta,
+            fleet: &fleet,
+            topology: &self.topology,
+            unreachable: &[],
+        };
+        let drain = RebalanceContext {
+            meta: &self.meta,
+            fleet: &fleet,
+            topology: &self.topology,
+        };
+        let (repair, drain) = match pass {
+            Pass::Reconstruction => (Some(&repair), None),
+            Pass::Rebalance => (None, Some(&drain)),
+            Pass::RepairAndDrain => (Some(&repair), Some(&drain)),
+            Pass::Backfill => (None, None),
+        };
+        let capture = Capture::default();
+        let outcome = match pass {
+            Pass::Backfill => {
+                backfill::reconcile(&BackfillContext { meta: &self.meta })
+                    .with_subscriber(capturing_dispatch(capture.clone()))
+                    .await
+            }
+            _ => reconcile_step(&self.zone, &self.custodian, None, None, repair, drain, NOW)
+                .with_subscriber(capturing_dispatch(capture.clone()))
+                .await
+                .map_err(|err| Box::new(err) as BoxError),
+        };
+        (outcome, capture.contents())
+    }
+
+    async fn commit(&self, batch: WriteBatch) {
+        let outcome = self.meta.commit(batch).await.unwrap();
+        assert_eq!(outcome, CommitOutcome::Committed, "fixture: seeding commit");
+    }
+
+    /// Commit `inode`'s root record. Raw `WriteBatch` puts throughout — never a publish path,
+    /// since no producer of segmented maps exists yet — but built with the real validating
+    /// constructors, so a fixture typo cannot silently change WHICH rule a leg exercises.
+    async fn commit_root(&self, inode: InodeId, record: &InodeRecord) {
+        self.commit(WriteBatch::new().put(metadata::inode_key(inode), metadata::encode(record)))
+            .await;
+    }
+
+    /// Seed a committed object holding `chunks` in a **flat** map.
+    async fn seed_flat(&self, inode: InodeId, chunks: Vec<ChunkRef>) {
+        let record = root_record(chunks.len(), chunks.into(), 1);
+        self.commit_root(inode, &record).await;
+    }
+
+    /// Seed a committed **segmented** root at `inode` naming `chunks.len()` segments (one chunk
+    /// each), but WRITE only the first `written` of their `seg:` records.
+    /// `written == chunks.len()` is the readable shape; a smaller `written` is the real gap the
+    /// containment rule exists for — a segment the root's own table names, on a generation it
+    /// still names, that genuinely never got written (`ChunkMapError::SegmentAbsent`).
+    async fn seed_segmented(&self, inode: InodeId, chunks: &[ChunkRef], written: usize) {
+        let group = group_of(inode);
+        let mut segments = Vec::new();
+        for (index, chunk) in chunks.iter().enumerate() {
+            let offset = index as u64 * DATA.len() as u64;
+            segments.push(SegmentRef {
+                index: index as u32,
+                byte_offset: offset,
+                byte_len: DATA.len() as u64,
+            });
+            if index < written {
+                let record = SegmentRecord::new(vec![chunk.clone()], offset).unwrap();
+                let key = metadata::seg_key(&group, index as u32).unwrap();
+                self.commit(WriteBatch::new().put(key, metadata::encode(&record)))
+                    .await;
+            }
+        }
+        let map = SegmentedMap::new(group, segments).unwrap();
+        let record = root_record(chunks.len(), ChunkMap::Segmented(map), 1);
+        self.commit_root(inode, &record).await;
+    }
+
+    /// Seed the damaged object the containment legs are built around, and **assert the fault is
+    /// real** — so a leg can never pass because the fault it was built around silently stopped
+    /// being one.
+    async fn seed_damaged(&self, damage: Damage) {
+        let key = metadata::inode_key(DAMAGED_INODE);
+        match damage {
+            Damage::Undecodable => {
+                let bytes = Bytes::from_static(UNDECODABLE_RECORD);
+                self.commit(WriteBatch::new().put(key, bytes.clone())).await;
+                assert!(
+                    metadata::decode::<InodeRecord>(&bytes).is_err(),
+                    "fixture: the seeded record's own bytes must genuinely fail to decode"
+                );
+            }
+            Damage::Unresolvable => {
+                let chunks = [
+                    single_copy_ref(DAMAGED_HELD, 0),
+                    single_copy_ref(DAMAGED_UNWRITTEN, 0),
+                ];
+                self.seed_segmented(DAMAGED_INODE, &chunks, 1).await;
+                let root = self.read_inode(DAMAGED_INODE).await;
+                let resolved = metadata::resolve_chunk_map(&self.meta, &key, &root).await;
+                assert!(
+                    resolved.is_err(),
+                    "fixture: the seeded root's map must genuinely fail to resolve"
+                );
+            }
+        }
+    }
+
+    /// Seed the flat object the repair legs converge: one RS(2,1) chunk placed on 0/1/2, with
+    /// only the fragments on 0 and 1 actually present (server 2 is dead) — under-replicated,
+    /// repairable, and enqueued on the shared repair queue.
+    async fn seed_repairable(&self, inode: InodeId, chunk: ChunkId) {
+        self.seed_flat(inode, vec![rs_ref(chunk, vec![0, 1, 2])])
+            .await;
+        for index in 0..2u16 {
+            self.put_fragment(
+                index as DServerId,
+                frag(chunk, index),
+                rs_fragment(chunk, index),
+            )
+            .await;
+        }
+        enqueue_repair(&self.meta, chunk, "scrub").await.unwrap();
+    }
+
+    async fn put_fragment(&self, dserver: DServerId, frag: FragmentId, bytes: Bytes) {
+        self.dservers[dserver as usize]
+            .put_fragment(frag, bytes)
+            .await
+            .unwrap();
+    }
+
+    fn holds(&self, dserver: DServerId, frag: FragmentId) -> bool {
+        self.dservers[dserver as usize]
+            .frags
+            .lock()
+            .unwrap()
+            .contains_key(&frag)
+    }
+
+    async fn read_inode(&self, inode: InodeId) -> InodeRecord {
+        let bytes = self
+            .meta
+            .get(&metadata::inode_key(inode))
+            .await
+            .unwrap()
+            .expect("inode present");
+        metadata::decode(&bytes).unwrap()
+    }
+
+    /// A committed object's placement vector for its first chunk, read back off the store.
+    async fn placement_of(&self, inode: InodeId) -> Vec<DServerId> {
+        self.read_inode(inode).await.chunk_map.as_flat().unwrap()[0]
+            .placement
+            .clone()
+    }
+
+    async fn queued(&self) -> Vec<ChunkId> {
+        queued_repairs(&self.meta).await.unwrap()
+    }
+}
+
+// ---- criterion (1): a segmented object no longer ends any of the three passes ----
+
+/// On the base a store holding ONE healthy segmented object turned every one of the three
+/// passes into an `Err` — for the whole store, not for that object — so a store that published
+/// a single multipart object stopped repairing, filling and draining every OTHER object too.
+///
+/// Asserted POSITIVELY, not merely "no error": the flat objects' genuine work still happens in
+/// the same passes, which a pass that returned `Ok` by quietly SKIPPING the namespace would not
+/// produce. And because this reading is COMPLETE, the obligation for a chunk no committed map
+/// references is still DRAINED — the other half of the rule leg (3) binds, without which "never
+/// drain on an incomplete reading" would be satisfiable by never draining at all.
+#[tokio::test]
+async fn a_segmented_object_no_longer_ends_any_of_the_three_passes() {
+    let fx = Fixture::new().await;
+
+    // One healthy segmented object (both `seg:` records written) beside one flat object with a
+    // queued repair and one flat object whose placement is still empty (the pre-M3 shape
+    // backfill drains).
+    let segmented = [
+        single_copy_ref(SEG_QUEUED, 0),
+        single_copy_ref(SEG_OTHER, 0),
+    ];
+    fx.seed_segmented(SEGMENTED_INODE, &segmented, 2).await;
+    fx.seed_repairable(REPAIR_INODE, REPAIR_CHUNK).await;
+    fx.seed_flat(FILL_INODE, vec![rs_ref(FILL_CHUNK, vec![])])
+        .await;
+    // An obligation for a chunk no committed map in this store references: deleted out from
+    // under the queue. The reading is complete, so it is drained.
+    enqueue_repair(&fx.meta, STALE_CHUNK, "scrub")
+        .await
+        .unwrap();
+    // A drain is in progress, so rebalance really walks the namespace rather than returning on
+    // its no-draining-servers short-circuit.
+    set_lifecycle(&fx.meta, IDLE_DRAINING, DServerLifecycle::Draining)
+        .await
+        .unwrap();
+
+    let (outcome, _) = fx.run(Pass::RepairAndDrain).await;
+    let outcome =
+        outcome.expect("one segmented object must not turn reconstruction or rebalance into Err");
+    assert_eq!(
+        outcome,
+        Reconciled::Changed,
+        "the flat object's repair converged; the healthy segmented object refused nothing"
+    );
+
+    // The flat object's repair really happened: the rebuilt fragment moved to the one free
+    // distinct domain (D, server 3), its bytes are on that server, and the obligation is drained.
+    assert_eq!(
+        fx.placement_of(REPAIR_INODE).await,
+        vec![0, 1, 3],
+        "the under-replicated flat chunk was repaired and its placement record repointed"
+    );
+    assert!(
+        fx.holds(3, frag(REPAIR_CHUNK, 2)),
+        "the rebuilt shard was written to its new D server before the commit"
+    );
+    assert!(
+        fx.queued().await.is_empty(),
+        "both obligations left the queue: the flat chunk's by its repair, and the stale one \
+         because a COMPLETE reading really did prove no committed map references it"
+    );
+
+    // And backfill fills the flat record in the same store.
+    let (filled, _) = fx.run(Pass::Backfill).await;
+    let filled = filled.expect("one segmented object must not turn backfill into an error");
+    assert_eq!(
+        filled,
+        Reconciled::Changed,
+        "the fillable flat record was filled; the healthy segmented record declined nothing"
+    );
+    assert_eq!(
+        fx.placement_of(FILL_INODE).await,
+        vec![0, 1, 2],
+        "the empty-placement flat chunk still gets its explicit identity vector"
+    );
+}
+
+// ---- criterion (2): a `seg:`-resident chunk is REFUSED by all three passes, never acted on ----
+
+/// The loss this slice must not introduce while removing the abort. `assess` reads "referenced
+/// by no committed chunk map" as `Drain` and DELETES the obligation, so a walk that merely
+/// SKIPPED a segmented object would silently discard the repair obligation for live,
+/// under-replicated data — quieter than the abort and strictly worse.
+///
+/// One store, one segmented object, and one chunk carrying work for each of the three passes at
+/// once: a queued repair (reconstruction), an empty placement (backfill's fill) and — through
+/// the identity fallback that resolves fragment 0 onto D server 0 — a fragment on a draining
+/// server (rebalance's evacuation). Every pass must refuse rather than act, keep the work
+/// visible, decline to certify, and write NOTHING; the store is compared byte-for-byte after
+/// all three have run.
+#[tokio::test]
+async fn the_three_passes_refuse_a_segmented_record_and_write_nothing() {
+    let fx = Fixture::new().await;
+
+    fx.seed_segmented(SEGMENTED_INODE, &[unplaced_ref(SEG_QUEUED)], 1)
+        .await;
+    enqueue_repair(&fx.meta, SEG_QUEUED, "scrub").await.unwrap();
+    // D server 0 is draining, and the segmented chunk's empty placement resolves its only
+    // fragment onto exactly that server.
+    set_lifecycle(&fx.meta, 0, DServerLifecycle::Draining)
+        .await
+        .unwrap();
+    fx.put_fragment(0, frag(SEG_QUEUED, 0), single_copy_fragment(SEG_QUEUED))
+        .await;
+    let before = fx.meta.snapshot();
+
+    // --- reconstruction: the obligation is REFUSED, never drained ---
+    let (outcome, logged) = fx.run(Pass::Reconstruction).await;
+    let outcome = outcome.expect("a queued obligation on a segmented object must not end the pass");
+    assert!(
+        fx.queued().await.contains(&SEG_QUEUED),
+        "the obligation for a chunk this pass could not repair MUST stay queued: \"I may not \
+         repair it\" and \"no committed map references it\" are different facts, and draining \
+         on the first deletes the last record saying live data is under-replicated"
+    );
+    assert!(
+        fx.meta
+            .get(&repair_key(SEG_QUEUED))
+            .await
+            .unwrap()
+            .is_some(),
+        "the obligation's ledger entry itself survives the pass"
+    );
+    assert_eq!(
+        outcome,
+        Reconciled::Blocked,
+        "a pass that refused a repair it was asked for may not certify: `Satisfied` there tells \
+         an operator redundancy is whole"
+    );
+    assert!(
+        logged.contains(r#""action":"refused""#),
+        "the refusal is on the reconstruction seam with a stated reason; got: {logged}"
+    );
+
+    // --- backfill: the fill is DECLINED, and the chunk stays on the remaining gauge ---
+    let (outcome, logged) = fx.run(Pass::Backfill).await;
+    let outcome = outcome.expect("an empty placement in a segmented record must not end the pass");
+    assert_eq!(
+        outcome,
+        Reconciled::Blocked,
+        "backfill declined a fill it may not perform, so it may not certify the drain"
+    );
+    assert_gauge(&logged, "backfill_placement_remaining", 1);
+    assert_named(
+        &logged,
+        "wyrd.custodian.backfill.audit",
+        "declined",
+        SEGMENTED_OBJECT,
+    );
+
+    // --- rebalance: the evacuation is REFUSED and the fragment stays put ---
+    let (outcome, logged) = fx.run(Pass::Rebalance).await;
+    let outcome = outcome.expect("a fragment of a segmented object must not end the drain scan");
+    assert_eq!(
+        outcome,
+        Reconciled::Blocked,
+        "a refused evacuation leaves a fragment ON the draining server: reporting that drain \
+         satisfied tells an operator a decommission is safe"
+    );
+    assert!(
+        fx.holds(0, frag(SEG_QUEUED, 0)),
+        "the fragment stays on the draining server — refused, not moved"
+    );
+    assert_named(
+        &logged,
+        "wyrd.custodian.rebalance.audit",
+        "refused",
+        SEGMENTED_OBJECT,
+    );
+
+    // Nothing at all was written by any of the three — not the `seg:` record, not the root, not
+    // the queue.
+    assert_eq!(
+        fx.meta.snapshot(),
+        before,
+        "a refusal writes NOTHING: this slice owns no write to a segmented record (#682)"
+    );
+}
+
+// ---- criterion (3): an unreadable object is NAMED, the walk continues, nothing certifies ----
+
+/// The conjunction, over one store holding one unreadable record — met FIRST in key order —
+/// beside three healthy flat objects each carrying real work for one of the three passes.
+///
+/// Each pass must do all four things at once: return `Ok` (the walk continues), do the healthy
+/// objects' work, refuse to certify while NAMING the record it could not read, and KEEP the
+/// obligation whose chunk the reading could not account for. Any one alone is satisfiable by a
+/// wrong implementation — an abort, a silent skip, a pass that names the blocker and then
+/// returns without doing the rest of its job, or one that drains an obligation on evidence it
+/// never had.
+async fn one_unreadable_object_is_contained_by_every_pass(damage: Damage) {
+    let mut fx = Fixture::new().await;
+    fx.topology.register(EVAC_DRAINING, "E");
+
+    fx.seed_damaged(damage).await;
+    fx.seed_repairable(REPAIR_INODE, REPAIR_CHUNK).await;
+    fx.seed_flat(FILL_INODE, vec![rs_ref(FILL_CHUNK, vec![])])
+        .await;
+    // The obligation the incomplete reading must NOT discharge: no committed map this pass
+    // COULD read references it — which is exactly what "referenced by nothing" cannot be
+    // concluded from while a record is unreadable.
+    enqueue_repair(&fx.meta, STALE_CHUNK, "scrub")
+        .await
+        .unwrap();
+    // The evacuation work: a single-copy chunk whose only fragment sits on the draining server.
+    fx.seed_flat(EVAC_INODE, vec![single_copy_ref(EVAC_CHUNK, EVAC_DRAINING)])
+        .await;
+    fx.put_fragment(
+        EVAC_DRAINING,
+        frag(EVAC_CHUNK, 0),
+        single_copy_fragment(EVAC_CHUNK),
+    )
+    .await;
+    set_lifecycle(&fx.meta, EVAC_DRAINING, DServerLifecycle::Draining)
+        .await
+        .unwrap();
+
+    // --- reconstruction ---
+    let (outcome, logged) = fx.run(Pass::Reconstruction).await;
+    let outcome = outcome.expect("one unreadable record must not end the reconstruction pass");
+    assert_eq!(
+        outcome,
+        Reconciled::Blocked,
+        "reconstruction read less than the store, so it may not certify redundancy"
+    );
+    assert_eq!(
+        fx.placement_of(REPAIR_INODE).await,
+        vec![0, 1, 3],
+        "the healthy object's queued repair was still assessed and repaired: one damaged record \
+         may not cost every other object its repair"
+    );
+    assert_eq!(
+        fx.queued().await,
+        vec![STALE_CHUNK],
+        "the repaired chunk's obligation was drained by its repair — and the one the reading \
+         could not account for was KEPT, because a hole in the reading is not evidence that no \
+         committed map references it"
+    );
+    assert_named(
+        &logged,
+        "wyrd.custodian.reconstruction.audit",
+        "unresolvable-chunk-map",
+        DAMAGED_OBJECT,
+    );
+
+    // --- backfill ---
+    let (outcome, logged) = fx.run(Pass::Backfill).await;
+    let outcome = outcome.expect("one unreadable record must not end the backfill pass");
+    assert_eq!(
+        outcome,
+        Reconciled::Blocked,
+        "backfill's drain-to-zero gauge is drawn over less than the store, so it may not certify"
+    );
+    assert_eq!(
+        fx.placement_of(FILL_INODE).await,
+        vec![0, 1, 2],
+        "the healthy object's fill still happened beside the record backfill could not read"
+    );
+    assert_named(
+        &logged,
+        "wyrd.custodian.backfill.audit",
+        "unresolvable-chunk-map",
+        DAMAGED_OBJECT,
+    );
+
+    // --- rebalance ---
+    let (outcome, logged) = fx.run(Pass::Rebalance).await;
+    let outcome = outcome.expect("one unreadable record must not end the rebalance pass");
+    assert_eq!(
+        outcome,
+        Reconciled::Blocked,
+        "rebalance cannot see whether the record it could not read holds fragments on the \
+         draining server, so the drain is NOT satisfied"
+    );
+    assert_eq!(
+        fx.placement_of(EVAC_INODE).await,
+        vec![0],
+        "the healthy object's fragment was still evacuated off the draining server"
+    );
+    assert!(
+        fx.holds(0, frag(EVAC_CHUNK, 0)),
+        "and its bytes were copied to the new home before the commit"
+    );
+    assert_named(
+        &logged,
+        "wyrd.custodian.rebalance.audit",
+        "unresolvable-chunk-map",
+        DAMAGED_OBJECT,
+    );
+}
+
+/// A committed record whose own bytes will not `decode`: the fault is this object's, found
+/// before any resolver is involved, and contained by the same rule.
+#[tokio::test]
+async fn an_undecodable_record_is_named_the_walk_continues_and_no_pass_certifies() {
+    one_unreadable_object_is_contained_by_every_pass(Damage::Undecodable).await;
+}
+
+/// A committed root naming a `seg:` record that was never written: the resolver's own typed
+/// verdict, recovered by downcast, that THIS generation cannot be read.
+#[tokio::test]
+async fn an_unresolvable_record_is_named_the_walk_continues_and_no_pass_certifies() {
+    one_unreadable_object_is_contained_by_every_pass(Damage::Unresolvable).await;
+}
+
+// ---- criterion (4): a store fault under the resolve still ENDS the pass ----
+
+/// The other half of criterion (3), and what the downcast rule exists for: a fault that is not
+/// one object's own — the metadata store failing underneath the resolver's root re-read — has no
+/// answer for ANY object, so containing it as "this object is unreadable" would be the wrong
+/// answer for every object in the store. It must propagate.
+#[tokio::test]
+async fn a_store_fault_under_the_resolve_still_ends_every_pass() {
+    let fx = Fixture::new().await;
+
+    let segmented = [
+        single_copy_ref(SEG_QUEUED, 0),
+        single_copy_ref(SEG_OTHER, 0),
+    ];
+    fx.seed_segmented(SEGMENTED_INODE, &segmented, 2).await;
+    // Reconstruction only reads the namespace when it holds an obligation to place.
+    enqueue_repair(&fx.meta, REPAIR_CHUNK, "scrub")
+        .await
+        .unwrap();
+    set_lifecycle(&fx.meta, IDLE_DRAINING, DServerLifecycle::Draining)
+        .await
+        .unwrap();
+    // Armed AFTER seeding: from here every root read fails with a plain, non-`ChunkMapError`
+    // backend fault — the resolve of a segmented map re-reads its root to settle the read.
+    *fx.meta.failing_gets.lock().unwrap() = Some(b"inode:".to_vec());
+
+    for pass in [Pass::Reconstruction, Pass::Backfill, Pass::Rebalance] {
+        let (outcome, _) = fx.run(pass).await;
+        let err = outcome.expect_err("a store fault under the resolve must END the pass");
+        assert!(
+            err.to_string().contains(STORE_FAULT),
+            "the store's own fault propagates, not a chunk-map verdict: {err}"
+        );
+    }
+}
+
+// ---- criterion (5): the reconstruction pass is O(N), not O(Q×N) ----
+
+/// The deployed repair loop was Q namespace scans × N record decodes: `assess` called
+/// `find_chunk`, which scanned the ENTIRE `inode:` namespace once per queued obligation. With
+/// the resolver wired in, each of those N objects also costs a bounded `seg:` range read — so
+/// left alone the pass would go from Q×N decodes to Q×N *resolves*, and a repair loop whose cost
+/// is the product of its backlog and the namespace stops converging as a store grows.
+///
+/// A COUNT, never a timing. Scoped to the reconstruction pass alone (no GC/scrub/rebalance
+/// context beside it): the other loops each walk `inode:` themselves, and sharing one walk
+/// across passes is a larger refactor that is not this slice's.
+#[tokio::test]
+async fn reconstruction_reads_the_namespace_once_per_pass_not_once_per_obligation() {
+    let fx = Fixture::new().await;
+
+    // N = 5 committed objects, 2 of them segmented; Q = 3 queued obligations, each in a
+    // DIFFERENT flat object (so all three repairs commit against their own record).
+    const FLAT_OBJECTS: [(InodeId, ChunkId); 3] = [(2, 0xA1_00), (3, 0xA2_00), (4, 0xA3_00)];
+    const SEGMENTED_OBJECTS: [InodeId; 2] = [5, 6];
+    for (inode, chunk) in FLAT_OBJECTS {
+        fx.seed_repairable(inode, chunk).await;
+    }
+    for inode in SEGMENTED_OBJECTS {
+        let chunks = [single_copy_ref(SEG_QUEUED + inode as ChunkId, 0)];
+        fx.seed_segmented(inode, &chunks, 1).await;
+    }
+    assert_eq!(
+        fx.queued().await.len(),
+        FLAT_OBJECTS.len(),
+        "fixture: the pass carries Q = 3 obligations"
+    );
+
+    let (outcome, _) = fx.run(Pass::Reconstruction).await;
+    let outcome = outcome.expect("the pass must run over a store holding segmented objects");
+    assert_eq!(outcome, Reconciled::Changed, "all three repairs converged");
+
+    // The pass still does the WORK — the count leg cannot be satisfied by a pass that stopped
+    // repairing.
+    for (inode, _chunk) in FLAT_OBJECTS {
+        assert_eq!(
+            fx.placement_of(inode).await,
+            vec![0, 1, 3],
+            "inode {inode}: repaired and repointed onto the free distinct domain"
+        );
+    }
+    assert!(
+        fx.queued().await.is_empty(),
+        "every obligation was discharged by its repair commit"
+    );
+
+    assert_eq!(
+        *fx.meta.inode_scans.lock().unwrap(),
+        1,
+        "ONE reading of the committed namespace per pass, independent of the Q = {} \
+         obligations it carried",
+        FLAT_OBJECTS.len(),
+    );
+    let seg_reads = *fx.meta.seg_reads.lock().unwrap();
+    assert!(
+        seg_reads <= SEGMENTED_OBJECTS.len(),
+        "at most one bounded `seg:` range read per segmented object ({} of them), never one per \
+         obligation: got {seg_reads}",
+        SEGMENTED_OBJECTS.len(),
+    );
+}
+
+// ---- the generation a pass acts on is the one it READ ----
+
+/// A resolve whose generation is retired under it restarts onto the **live** root (decision
+/// 7(h)), so the record a pass reads, classifies, repairs and CASes on can be a different
+/// generation from the one its namespace scan returned. All four must be the same one.
+///
+/// Here the scan meets a SEGMENTED root and, inside the window between that read and the `seg:`
+/// range read, a racing publisher replaces it with a flat committed generation holding the
+/// queued chunk. Classifying the shape off the stale snapshot refuses a repair the live record
+/// could take — and is the same mismatch that would otherwise have a pass reason about one
+/// generation while committing over another. Classifying it off the resolver's answer repairs
+/// the object that is actually there.
+#[tokio::test]
+async fn reconstruction_repairs_the_generation_the_resolver_answered_for() {
+    let fx = Fixture::new().await;
+
+    // The generation the scan will meet: segmented, and READABLE — so the resolve gets as far
+    // as the supersede check rather than being contained as unreadable.
+    fx.seed_segmented(REPAIR_INODE, &[single_copy_ref(SEG_OTHER, 0)], 1)
+        .await;
+    // The generation that replaces it mid-resolve: flat, committed, holding the queued chunk
+    // under-replicated on 0/1/2 with server 2 dead.
+    let live = root_record(1, vec![rs_ref(REPAIR_CHUNK, vec![0, 1, 2])].into(), 2);
+    for index in 0..2u16 {
+        fx.put_fragment(
+            index as DServerId,
+            frag(REPAIR_CHUNK, index),
+            rs_fragment(REPAIR_CHUNK, index),
+        )
+        .await;
+    }
+    enqueue_repair(&fx.meta, REPAIR_CHUNK, "scrub")
+        .await
+        .unwrap();
+    // Armed last: the racing publisher lands INSIDE the resolve, never before it.
+    *fx.meta.race_on_seg_read.lock().unwrap() =
+        Some((metadata::inode_key(REPAIR_INODE), metadata::encode(&live)));
+
+    let (outcome, _) = fx.run(Pass::Reconstruction).await;
+    let outcome = outcome.expect("a generation retired under the resolve must not end the pass");
+
+    assert_eq!(
+        fx.placement_of(REPAIR_INODE).await,
+        vec![0, 1, 3],
+        "the chunk was repaired in the generation the resolver ANSWERED for — the live flat \
+         record — and the repoint CAS'd on that record, not on the retired snapshot"
+    );
+    assert_eq!(
+        fx.read_inode(REPAIR_INODE).await.version,
+        3,
+        "the repoint bumped the LIVE generation's version (2 -> 3), so it is that record the \
+         CAS required and replaced"
+    );
+    assert!(
+        fx.queued().await.is_empty(),
+        "and the obligation was discharged by that repair"
+    );
+    assert_eq!(
+        outcome,
+        Reconciled::Changed,
+        "nothing was refused: the record this pass actually read is one it may repair"
+    );
+}
+
+/// The drain-to-zero gauge an operator watches is a claim about the store, so every number in
+/// it must come from a record that EXISTS. A lost CAS means the generation the pass counted is
+/// gone — the winner may have filled those placements itself — so re-counting the superseded
+/// snapshot's empty chunks would publish a population no record carries, in the one signal
+/// ADR-0040 decision 6 gates the identity-fallback removal on.
+#[tokio::test]
+async fn backfill_counts_the_live_generation_after_a_lost_cas() {
+    let fx = Fixture::new().await;
+
+    // Two empty placements when the pass reads the record...
+    fx.seed_flat(
+        FILL_INODE,
+        vec![unplaced_ref(FILL_CHUNK), unplaced_ref(STALE_CHUNK)],
+    )
+    .await;
+    // ...and one when the racing writer's generation wins the CAS: it filled the first chunk
+    // and left the second.
+    let live = root_record(
+        2,
+        vec![single_copy_ref(FILL_CHUNK, 0), unplaced_ref(STALE_CHUNK)].into(),
+        2,
+    );
+    *fx.meta.race_on_commit.lock().unwrap() =
+        Some((metadata::inode_key(FILL_INODE), metadata::encode(&live)));
+
+    let (outcome, logged) = fx.run(Pass::Backfill).await;
+    let outcome = outcome.expect("a lost CAS is an ordinary race, not a pass-ending fault");
+    assert_eq!(
+        outcome,
+        Reconciled::Satisfied,
+        "the only candidate lost its CAS: nothing converged, and an ordinary race is not a \
+         refusal this slice makes non-certifying"
+    );
+    assert_eq!(
+        fx.read_inode(FILL_INODE).await.version,
+        2,
+        "the racing writer's record stands — backfill's fill did not clobber it"
+    );
+    assert_gauge(&logged, "backfill_placement_remaining", 1);
+
+    // The same reading, one generation on: this time the winner publishes a generation this
+    // pass cannot read at all (a segmented root naming a `seg:` record that was never
+    // written). "I could not read it" is not "it holds none" — so it contributes NOTHING to
+    // the population, is NAMED like every other unreadable record, and the pass certifies
+    // nothing. A count invented for it would be the one number an operator uses to decide the
+    // pre-M3 fallback may be removed.
+    let table = vec![SegmentRef {
+        index: 0,
+        byte_offset: 0,
+        byte_len: DATA.len() as u64,
+    }];
+    let map = SegmentedMap::new(group_of(FILL_INODE), table).unwrap();
+    let unreadable = root_record(1, ChunkMap::Segmented(map), 3);
+    *fx.meta.race_on_commit.lock().unwrap() = Some((
+        metadata::inode_key(FILL_INODE),
+        metadata::encode(&unreadable),
+    ));
+
+    let (outcome, logged) = fx.run(Pass::Backfill).await;
+    let outcome = outcome.expect("an unreadable racing generation is still one object's fault");
+    assert_eq!(
+        outcome,
+        Reconciled::Blocked,
+        "the pass could not read the generation that won the CAS, so it may not certify the \
+         drain it was reporting on"
+    );
+    assert_gauge(&logged, "backfill_placement_remaining", 0);
+    assert_named(
+        &logged,
+        "wyrd.custodian.backfill.audit",
+        "unresolvable-chunk-map",
+        "inode:3",
+    );
+}
