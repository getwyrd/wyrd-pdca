+// ---- fixture: raw-record `seg:` + root seeding (this slice lands no producer of segmented
+// maps; #653 owns the real staged-publication committer) ----
+
+const NOW: u64 = 10_000;
+
+/// Keys sort byte-lexicographically, so the damaged record below is met by a walk BEFORE the
+/// healthy objects that carry the real work.
+const DAMAGED_INODE: InodeId = 1;
+const REPAIR_INODE: InodeId = 2;
+const FILL_INODE: InodeId = 3;
+const EVAC_INODE: InodeId = 4;
+const SEGMENTED_INODE: InodeId = 5;
+const DAMAGED_OBJECT: &str = "inode:1";
+const SEGMENTED_OBJECT: &str = "inode:5";
