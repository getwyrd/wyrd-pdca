+/// An RS(2,1) chunk reference with the given (possibly empty) placement.
+fn rs_ref(chunk: ChunkId, placement: Vec<DServerId>) -> ChunkRef {
+    ChunkRef {
+        id: chunk,
+        scheme: EcScheme::ReedSolomon { k: K, m: M },
+        len: DATA.len() as u64,
+        placement,
+    }
