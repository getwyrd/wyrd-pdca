+fn frag(chunk: ChunkId, index: u16) -> FragmentId {
+    FragmentId { chunk, index }
+}
+
+/// A per-object segment group: a 32-lowercase-hex nonce (`0016:354`) derived from the inode id,
+/// so two segmented objects never share a `seg:` range.
+fn group_of(inode: InodeId) -> SegmentGroup {
+    SegmentGroup::new(format!("{inode:032x}"), EPOCH).unwrap()
