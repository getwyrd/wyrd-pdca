+/// The three passes in the order [`Store::drive`] answers them, and what one of them answered.
+const PASSES: [&str; 3] = ["reconstruction", "rebalance", "backfill"];
+type PassResult = std::result::Result<Reconciled, String>;
+
+/// Every pass ran and none certified: each answered over less than the store, where `Satisfied`
+/// tells an operator a decommission is safe or redundancy whole.
+fn assert_none_certified(passes: [PassResult; 3], why: &str) {
+    for (pass, outcome) in PASSES.iter().zip(passes) {
+        let got = outcome.unwrap_or_else(|err| panic!("{pass} must not end the pass: {err}"));
+        assert_eq!(got, Reconciled::Blocked, "{pass} may not certify: {why}");
+    }
+}
+
+/// The empty-placement gauge the backfill pass published, read back off its seam BY VALUE: a level
+/// holding a number the store does not is worse than no level at all.
+fn assert_gauge(logged: &str, value: u64) {
+    let sample = format!(r#""gauge.backfill_placement_remaining":{value}"#);
+    assert!(logged.contains(&sample), "remaining != {value}: {logged}");
+}
+
+fn audit_lines<'a>(logged: &'a str, pass: &str) -> Vec<&'a str> {
+    let seam = format!(r#""target":"wyrd.custodian.{pass}.audit""#);
+    logged.lines().filter(|line| line.contains(&seam)).collect()
+}
+
+/// `pass` NAMED the record an operator has to go and find, in `gc::object_name`'s escaping shape
+/// (`gc.rs:470-480`) — attribution is what makes a blocker repairable. `None` asks all three.
+fn assert_named(logged: &str, pass: Option<&str>, object: &str) {
+    let quoted = format!(r#""{object}""#);
+    for pass in pass.map_or(PASSES.to_vec(), |one| vec![one]) {
+        let named = audit_lines(logged, pass)
+            .iter()
+            .any(|l| l.contains(&quoted));
