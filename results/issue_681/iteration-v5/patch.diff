+    }
+
+    async fn put(&self, key: &[u8], value: Bytes) {
+        let done = self
+            .meta
+            .commit(WriteBatch::new().put(key.to_vec(), value))
+            .await;
+        assert_eq!(done.unwrap(), CommitOutcome::Committed, "seeded");
+    }
+
+    /// Write the fragments `present` names onto the servers `placement` puts them on — REAL
+    /// erasure-coded bytes from the same two `core` calls the production rebuild makes, so a
+    /// survivor passes `intact_shard` and an evacuated one `fragment_intact`.
+    async fn place(&self, chunk: ChunkId, placement: &[DServerId], present: &[u16]) {
+        let shards = erasure::encode(K as usize, M as usize, PAYLOAD).unwrap();
+        for &index in present {
+            let at = placement
+                .get(index as usize)
+                .copied()
+                .unwrap_or(index.into());
+            let bytes = encode_ec_fragment(chunk, index, K, M, &shards[index as usize]);
+            let at = &self.fleet[at as usize];
+            at.put_fragment(frag(chunk, index), bytes).await.unwrap();
+        }
+    }
+
+    /// Plant ONE committed object under the raw key `key` — the only seeding entry in this file, so
+    /// every leg's store differs by its arguments, not by a fixture of its own. Raw `WriteBatch`
+    /// puts through the real validating constructors, never a publish path (#653 owns the
+    /// committer) — and it **asserts its own fault is real**.
+    async fn seed(&self, key: &[u8], shape: Shape) {
+        let (count, map, readable) = match shape {
+            Shape::Undecodable => {
+                let bad = metadata::decode::<InodeRecord>(UNREADABLE).is_err();
+                assert!(bad, "fixture: those bytes must really fail to decode");
+                return self.put(key, Bytes::from_static(UNREADABLE)).await;
+            }
+            Shape::Flat(chunks) => {
+                let mut refs = Vec::new();
+                for (id, placement, present) in &chunks {
+                    self.place(*id, placement, present).await;
+                    refs.push(chunk_ref(*id, placement.clone()));
+                }
+                (refs.len(), ChunkMap::from(refs), true)
+            }
+            Shape::Segmented(nonce, written, chunks) => {
+                let group = SegmentGroup::new(nonce, EPOCH).unwrap();
+                let mut table = Vec::new();
+                for (i, (id, placement, present)) in chunks.iter().enumerate() {
+                    self.place(*id, placement, present).await;
+                    let (index, byte_offset) = (i as u32, i as u64 * CHUNK_LEN);
+                    let byte_len = CHUNK_LEN;
+                    table.push(SegmentRef {
+                        index,
+                        byte_offset,
+                        byte_len,
+                    });
+                    if i < written {
+                        let refs = vec![chunk_ref(*id, placement.clone())];
+                        let seg = SegmentRecord::new(refs, byte_offset).unwrap();
+                        let at = metadata::seg_key(&group, index).unwrap();
+                        self.put(&at, metadata::encode(&seg)).await;
+                    }
+                }
+                let map = SegmentedMap::new(group, table).unwrap();
+                let readable = written == chunks.len();
+                (chunks.len(), ChunkMap::Segmented(map), readable)
+            }
+        };
+        let root = InodeRecord {
+            size: count as u64 * CHUNK_LEN,
+            chunk_map: map,
+            state: InodeState::Committed,
+            version: 1,
+            ..Default::default()
+        };
+        self.put(key, stored(&root)).await;
+        let resolved = metadata::resolve_chunk_map(&self.meta, key, &root).await;
+        assert_eq!(resolved.is_ok(), readable, "fixture: resolves");
+    }
+
+    /// The store every leg's positive half rests on: three flat objects carrying real work — a chunk
+    /// to repair, a placement to fill, a fragment to evacuate — the drain, and (when `segmented`) a
+    /// healthy segmented object beside them.
+    async fn seed_fixture(&self, segmented: bool) {
+        if segmented {
+            self.seed(SEG, Shape::Segmented(NONCE, 3, draining_segments()))
+                .await;
+        }
+        let evac = one(C_EVAC, &[0, 1, DRAINING], &[0, 1, 2]);
+        self.seed(F_REPAIR, one(C_REPAIR, &[0, 1, 4], &[0, 1]))
+            .await;
+        self.seed(F_FILL, one(C_FILL, &[], &[])).await;
+        self.seed(F_EVAC, evac).await;
+        self.drain(DRAINING).await;
+    }
+
+    async fn drain(&self, at: DServerId) {
+        set_lifecycle(&self.meta, at, DServerLifecycle::Draining)
+            .await
+            .unwrap();
+    }
+
+    /// ONE step through the REAL fenced control point (`reconcile_step`) — never a parallel entry.
+    async fn step(&self, recon: bool, rebal: bool) -> PassResult {
+        let coord = MemCoordination::new();
+        let leader = Custodian::elect(&coord, "zone-passes").await.unwrap();
+        let mut zone = FencedZone::new();
+        zone.install(leader.leadership());
+        let view: Vec<(DServerId, &dyn ChunkStore)> = (self.fleet.iter().enumerate())
+            .map(|(id, store)| (id as DServerId, store as &dyn ChunkStore))
+            .collect();
+        let (meta, fleet, topology) = (&self.meta as &dyn MetadataStore, &view[..], &self.topo);
+        let unreachable = &[];
+        let recon_ctx = ReconstructionContext {
+            meta,
+            fleet,
+            topology,
+            unreachable,
+        };
+        let rebal_ctx = RebalanceContext {
+            meta,
+            fleet,
+            topology,
+        };
+        let (recon, rebal) = (recon.then_some(&recon_ctx), rebal.then_some(&rebal_ctx));
+        reconcile_step(&zone, &leader, None, None, recon, rebal, NOW)
+            .await
+            .map_err(|err| err.to_string())
+    }
+
+    /// One backfill pass, through its own public entry (`backfill.rs:40-44`).
+    async fn backfill(&self) -> PassResult {
+        wyrd_custodian::backfill::reconcile(&BackfillContext { meta: &self.meta })
+            .await
+            .map_err(|err| err.to_string())
+    }
+
+    /// Drive ALL THREE passes under one audit subscriber — what keeps this file six tests, not 18.
+    async fn drive(&self, audit: &Capture) -> [PassResult; 3] {
+        let passes = async {
+            let (recon, rebal) = (self.step(true, false).await, self.step(false, true).await);
+            [recon, rebal, self.backfill().await]
+        };
+        let audit = capturing_dispatch(Arc::clone(audit));
+        passes.with_subscriber(audit).await
+    }
+
+    async fn record(&self, key: &[u8]) -> InodeRecord {
+        let bytes = self.meta.get(key).await.unwrap().expect("record present");
+        metadata::decode(&bytes).unwrap()
+    }
+
+    /// A **flat** object's chunk `index` placement — what a repair, a fill and an evacuation each
+    /// move, and what a refusal leaves exactly where it was.
+    async fn placement(&self, key: &[u8], index: usize) -> Vec<DServerId> {
+        let map = self.record(key).await.chunk_map;
+        map.as_flat().unwrap()[index].placement.clone()
+    }
+
+    async fn enqueue(&self, chunk: ChunkId) {
+        repair::enqueue_repair(&self.meta, chunk, "scrub")
+            .await
+            .unwrap();
+    }
+
+    async fn queued(&self) -> Vec<ChunkId> {
+        repair::queued_repairs(&self.meta).await.unwrap()
+    }
+
+    /// Every flat object ended up with its work done — the repair repointed onto a free domain, the
+    /// fill materialised, the evacuation moved off server 3, all landing on `[0, 1, 2]` — and the
+    /// moved bytes reached the server the record names.
+    async fn assert_flat_work_done(&self) {
+        for (key, work) in [(F_REPAIR, "repair"), (F_FILL, "fill"), (F_EVAC, "evac")] {
+            let moved = self.placement(key, 0).await;
+            assert_eq!(moved, vec![0, 1, 2], "the flat {work} happened");
+        }
+        let landed = self.holds(2, frag(C_REPAIR, 2)) && self.holds(2, frag(C_EVAC, 2));
+        assert!(landed, "the rebuilt and evacuated bytes reached server 2");
+    }
+}
+
+/// On the base all three passes return `Err` over this store for one reason: an object in it is
+/// segmented. "Returned `Ok`" is the base-red half — but `Ok` alone would also come from a pass that
+/// stepped over every object, so each is asked for its POSITIVE work too.
+#[tokio::test]
+async fn a_segmented_object_ends_no_pass_and_the_flat_work_still_happens() {
+    enable_audit_callsites();
+    let store = Store::new();
+    store.seed_fixture(true).await;
+    store.enqueue(C_REPAIR).await;
+    store.enqueue(C_UNSEEN).await;
+
+    store.step(true, true).await.expect("the step must run");
+    store.backfill().await.expect("the backfill pass must run");
+
+    store.assert_flat_work_done().await;
+    // Both discharged over a reading that COULD read every object: one repaired, one drained as
+    // unreferenced — an answer only a COMPLETE reading may give (leg 3 is its other side).
+    assert!(store.queued().await.is_empty(), "both discharged");
+}
+
+/// The failure mode this slice must not introduce while removing the abort: an obligation whose
+/// chunk lives in a `seg:` record read as "referenced by no committed chunk map" and DRAINED as if
+/// deleted (`reconstruction.rs:322-325`). Refuse instead.
+#[tokio::test]
+async fn work_in_a_segmented_record_is_refused_never_discarded() {
+    enable_audit_callsites();
+    let store = Store::new();
+    store.seed_fixture(true).await;
+    store.enqueue(S_DRAIN_A).await;
+
+    let seg_key = metadata::seg_key(&SegmentGroup::new(NONCE, EPOCH).unwrap(), 0).unwrap();
+    let before = store.meta.get(&seg_key).await.unwrap();
+    let version = store.record(SEG).await.version;
+
+    let audit = Capture::default();
+    let passes = store.drive(&audit).await;
+    assert_none_certified(passes, "it refused work that was owed and did not do it");
+
+    // The obligation is KEPT, the drain is not silently completed, and NOTHING was written.
+    assert_eq!(store.queued().await, vec![S_DRAIN_A], "the refusal kept it");
+    assert!(store.holds(DRAINING, frag(S_DRAIN_A, 2)), "stays put");
+    let after = store.meta.get(&seg_key).await.unwrap();
+    assert_eq!(after, before, "a refusal leaves `seg:` byte-identical");
+    assert_eq!(store.record(SEG).await.version, version, "root unmoved");
+
+    // The declined fill is still POPULATION: reporting it filled says the pre-M3 tail is gone.
+    let logged = contents(&audit);
+    assert_gauge(&logged, 1);
+
+    // Pinned decision 5 — ONCE per object, not once per chunk: a per-chunk line floods the seam the
+    // operator reads. And the line carries what is being waited on: this object holds THREE
+    // fragments on the draining server across TWO chunks, so counting chunks would under-state the
+    // drain it holds open by a whole fragment.
+    assert_named(&logged, Some("rebalance"), "inode:20");
+    let refusals: Vec<&str> = audit_lines(&logged, "rebalance")
+        .into_iter()
+        .filter(|line| line.contains(r#""action":"refused""#))
+        .collect();
+    assert_eq!(refusals.len(), 1, "ONE refusal per object: {logged}");
+    let counted = refusals[0].contains(r#""fragments":3"#);
+    assert!(counted, "the refusal counts FRAGMENTS: {}", refusals[0]);
+
+    // A generation this pass did NOT read is one it may not write — and the only way to be handed
+    // one is a resolve that restarted (`metadata.rs:2563-2573`, decision 7(h)). Here the root moves
+    // to a FILLABLE FLAT record between the scan and the resolver's settle read: the pass then holds
+    // a chunk list whose stored bytes it never saw, so it can neither frame a commit by that
+    // generation nor CAS on it. It writes nothing at all, and says so.
+    let store = Store::new();
+    let healthy = Shape::Segmented(NONCE, 3, draining_segments());
+    store.seed(SEG, healthy).await;
+    let mut live = store.record(SEG).await;
+    live.chunk_map = ChunkMap::from(vec![chunk_ref(S_FILL, vec![])]);
+    // Written CANONICALLY, so a pass that did fill this generation would WIN its compare-and-swap
+    // and the bytes below would move: the assertion is about the write, not about a lost race.
+    let live = metadata::encode(&live);
+    *store.meta.supersede.lock().unwrap() = Some((SEG.to_vec(), live.clone()));
+
+    let got = store.backfill().await.expect("a retired snapshot runs");
+    assert_eq!(got, Reconciled::Blocked, "it read less than the store");
+    let after = store.meta.get(SEG).await.unwrap();
+    assert_eq!(
+        after,
+        Some(live),
+        "the generation it never read is untouched"
+    );
+}
+
+/// Containment is per object, and the answer still gets made. Each damaged shape is exercised ALONE
+/// beside the healthy work, because a store carrying both would answer `Blocked` with either
+/// containment removed. Each sits FIRST in key order. Carries pinned decisions 2 and 3.
+#[tokio::test]
+async fn an_unreadable_object_is_named_and_the_walk_continues() {
+    enable_audit_callsites();
+    // A root naming a `seg:` record that was never written is the generation the shared resolver
+    // reports it cannot read (a typed `ChunkMapError`), as against bytes it cannot decode.
+    let unwritten = vec![seeded(C_UNSEEN, &[0, 1, 4], &[])];
+    let dangling = Shape::Segmented(OTHER_NONCE, 0, unwritten);
+    for (damaged, shape) in [
+        (DAMAGED_RECORD, Shape::Undecodable),
+        (DAMAGED_SEG, dangling),
+    ] {
+        let store = Store::new();
+        store.seed(damaged, shape).await;
+        store.seed_fixture(false).await;
+        store.enqueue(C_REPAIR).await;
+        store.enqueue(C_UNSEEN).await;
+
+        let audit = Capture::default();
+        assert_none_certified(store.drive(&audit).await, "it read less");
+
+        // The sharpest edge of C-1: "I could not read the map" and "no committed map references
+        // this chunk" are different facts, and only the second permits a drain — collapsing them
+        // deletes the last record saying live data is under-replicated. Nor may one damaged record
+        // cost another its work; and it is NAMED on each pass's own seam.
+        let kept = store.queued().await;
+        assert_eq!(kept, vec![C_UNSEEN], "never drained unread");
+        store.assert_flat_work_done().await;
+        assert_named(&contents(&audit), None, &String::from_utf8_lossy(damaged));
+
+        // Pinned decision 2: a pass certifies only over the reading it PERFORMED. With nothing
+        // queued, reconstruction reads no namespace at all — no claim about the damaged object,
+        // `Satisfied`, and nothing spent looking for damage it would not act on.
+        let drop = WriteBatch::new().delete(repair::repair_key(C_UNSEEN));
+        store.meta.commit(drop).await.unwrap();
+        store.take_reads();
+        let idle = store.step(true, false).await.expect("the idle pass ran");
+        assert_eq!(idle, Reconciled::Satisfied, "an idle pass certifies");
+        assert_eq!(store.take_reads().0, 0, "an idle pass reads no namespace");
+    }
+
+    // Pinned decision 3: a record is read, written and named under exactly the key the store gave
+    // it. `"inode:007"` and `"inode:7"` both parse to id 7, so a pass re-deriving
+    // `metadata::inode_key(id)` for its CAS reads one record and commits over the OTHER — and
+    // where their bytes coincide the CAS succeeds and clobbers an unrelated object.
+    let store = Store::new();
+    store.seed(b"inode:007", one(C_FILL, &[], &[])).await;
+    let bytes = store.meta.get(b"inode:007").await.unwrap().unwrap();
+    store.put(b"inode:7", bytes).await;
+    // Refusing nothing, this store is the control against OVER-containment: every pass does its
+    // work AND certifies it, and the drain-to-zero gauge reads 0.
+    let audit = Capture::default();
+    for (pass, got) in PASSES.iter().zip(store.drive(&audit).await) {
+        assert_ne!(got.unwrap(), Reconciled::Blocked, "{pass} certifies");
+    }
+    assert_gauge(&contents(&audit), 0);
+    for key in [&b"inode:007"[..], b"inode:7"] {
+        let put = store.placement(key, 0).await;
+        assert_eq!(put, vec![0, 1, 2], "filled under its OWN key");
+    }
+
+    // Nor is a key the `inode:` grammar refuses reinterpreted into one: every pass leaves the row
+    // byte-identical, NAMES it and certifies nothing — a decodable record under `inode:not-an-id`
+    // is not an inode to rewrite, nor a row to skip in silence (`metadata.rs:2155-2170`).
+    let stray: &[u8] = b"inode:not-an-id";
+    store.seed(stray, one(C_UNSEEN, &[], &[])).await;
+    let before = store.meta.get(stray).await.unwrap();
+    store.enqueue(C_UNSEEN).await;
+    store.drain(DRAINING).await;
+
+    let audit = Capture::default();
+    assert_none_certified(store.drive(&audit).await, "a row it cannot read");
+    let after = store.meta.get(stray).await.unwrap();
+    assert_eq!(after, before, "the stray row is byte-identical");
+    assert_named(&contents(&audit), None, "inode:not-an-id");
+    let kept = store.queued().await;
+    assert_eq!(kept, vec![C_UNSEEN], "nothing drained unread");
+}
+
+/// Ids are allocator-minted (`write.rs:170`), never content-addressed, so two committed maps
+/// claiming one `ChunkId` is always an anomaly. Repairing "whichever the scan met first" — what the
+/// base does at `reconstruction.rs:639` — repoints one record while orphan-marking a fragment the
+/// other points at, which GC reclaims. Neither is repaired and both are named.
+#[tokio::test]
+async fn a_duplicate_committed_chunk_id_is_repaired_by_neither_reference() {
+    enable_audit_callsites();
+    let store = Store::new();
+    let claim = || one(C_REPAIR, &[0, 1, 4], &[0, 1]);
+    let dup = |present: &[u16]| seeded(C_EVAC, &[0, 1, 4], present);
+    let twice = Shape::Flat(vec![dup(&[0, 1]), dup(&[])]);
+    store.seed(b"inode:40", claim()).await;
+    store.seed(b"inode:41", claim()).await;
+    store.seed(b"inode:42", twice).await;
+    store.enqueue(C_REPAIR).await;
+    store.enqueue(C_EVAC).await;
+
+    let audit = Capture::default();
+    let dispatch = capturing_dispatch(Arc::clone(&audit));
+    let pass = store.step(true, false).with_subscriber(dispatch).await;
+
+    let outcome = pass.expect("an ambiguity contains to the objects claiming it");
+    assert_eq!(outcome, Reconciled::Blocked, "ambiguity is no repair");
+    assert_eq!(store.queued().await.len(), 2, "neither is drained");
+    for (key, index) in [(&b"inode:40"[..], 0), (b"inode:41", 0), (b"inode:42", 1)] {
+        let put = store.placement(key, index).await;
+        assert_eq!(put, vec![0, 1, 4], "no ambiguous repoint");
+    }
+    let logged = contents(&audit);
+    for object in ["inode:40", "inode:41", "inode:42"] {
+        assert_named(&logged, Some("reconstruction"), object);
+    }
+}
+
+/// The deployed repair loop is Q namespace scans × N point reads: `assess` calls `find_chunk` per
+/// obligation and `find_chunk` scans all of `inode:`. Wire the resolver in naively and each of those
+/// N objects also costs a `seg:` range read — Q×N *resolves*, which stops converging as a store grows
+/// (C-1, through the scheduler). Reconstruction alone: sharing one walk is out of scope.
+#[tokio::test]
+async fn reconstruction_reads_the_namespace_once_per_pass() {
+    enable_audit_callsites();
+    let store = Store::new();
+    // N = 3 committed flat objects, each holding one repairable chunk; Q = 3 obligations.
+    let repairable = [C_REPAIR, C_FILL, C_EVAC];
+    for (n, chunk) in repairable.iter().enumerate() {
+        let key = format!("inode:5{n}").into_bytes();
+        store.seed(&key, one(*chunk, &[0, 1, 4], &[0, 1])).await;
+        store.enqueue(*chunk).await;
+    }
+    // S = 2 segmented objects beside them, so the bounded `seg:` range reads are counted too.
+    for (s, nonce) in [NONCE, OTHER_NONCE].into_iter().enumerate() {
+        let key = format!("inode:6{s}").into_bytes();
+        let chunks = vec![seeded(0xE0 + s as ChunkId, &[0, 1, 4], &[])];
+        store.seed(&key, Shape::Segmented(nonce, 1, chunks)).await;
+    }
+
+    store.take_reads();
+    store.step(true, false).await.expect("the pass must run");
+
+    let (inode_reads, seg_reads) = store.take_reads();
+    assert_eq!(inode_reads, 1, "read ONCE, not once per obligation");
+    assert!(seg_reads <= 2, "one `seg:` read per object: {seg_reads}");
+    // The bound is worth nothing if the repairs stopped landing.
+    for n in 0..repairable.len() {
+        let moved = store.placement(format!("inode:5{n}").as_bytes(), 0).await;
+        assert_eq!(moved, vec![0, 1, 2], "every queued repair still lands");
+    }
+    assert!(store.queued().await.is_empty(), "all discharged");
+}
+
+/// A store failing underneath the resolver is not one object's fault, so it must NOT be folded into
+/// "this object is unreadable" — a walk that cannot reach the store answers for NO object. It also
+/// binds decision 6: the fault is on `get`, which the segmented resolve reaches AFTER the undecodable
+/// record was met, so that name is on the seam before the `Err` comes back.
+#[tokio::test]
+async fn a_fault_that_is_not_one_objects_map_still_ends_the_pass() {
+    enable_audit_callsites();
+    let store = Store::new();
+    store.seed(DAMAGED_RECORD, Shape::Undecodable).await;
+    store.seed_fixture(true).await;
+    store.enqueue(S_DRAIN_A).await;
+    *store.meta.failing_gets.lock().unwrap() = true;
+
+    let audit = Capture::default();
+    for (pass, outcome) in PASSES.iter().zip(store.drive(&audit).await) {
+        let err = outcome.expect_err("a store fault is not absorbed");
+        assert!(err.contains(STORE_FAULT), "{pass} absorbed: {err}");
+    }
+
+    // Pinned decision 6: attribution is emitted where the object is READ, before the work — so a
+    // later transient fault cannot cost the operator the name of the record to repair.
+    assert_named(&contents(&audit), None, "inode:2");
+}
