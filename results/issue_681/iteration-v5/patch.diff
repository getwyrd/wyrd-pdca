+/// Install a permissive global `tracing` default **once**, so the audit callsites never latch
+/// `Interest::never` under the parallel harness (#214, `segmented_map_consumers.rs:326-332`). At the
+/// top of EVERY leg: whichever runs first must install it, not just the reader.
+fn enable_audit_callsites() {
+    static INIT: std::sync::Once = std::sync::Once::new();
+    INIT.call_once(|| {
+        let _ = tracing::subscriber::set_global_default(tracing_subscriber::registry());
+    });
+}
