+// ---- property 13: GC's staged build under a concurrent part commit, then publication (#803) ----
+//
+// GC's reference set carries a second, disjoint class: the bytes multipart uploads have made
+// durable but not yet published, read per listed session through its own bounded ranges — the
+// owned `sidx:` range, then the `part:` range — and only after both, the committed `inode:`
+// namespace (proposal 0016 decision 2, `0016:782-800`; X67 `:2596`). Protection moves between those
+// classes in single batches: a part commit deletes the chunk's `sidx:` entry and writes its `part:`
+// record, and a publication writes the committed inode naming the chunk and removes that `part:`
+// record. Read source before destination, every interleaving observes the chunk in at least one
+// class. The per-pass legs in `crates/custodian/tests/staged_protection.rs` land each handoff right
+// after one scripted read; here a genuinely concurrent writer lands BOTH, one after the other, at
+// instants the seed picks, against the simulated-TiKV model whose every read and commit spans a
+// simulated network hop.
+//
+// The chunk's one fragment carries an `orphan:` mark long past grace for the whole run, so the
+// staged records — and, once published, the committed inode — are all that keep it.
+
+/// The staged chunk: one un-coded fragment on [`STAGED_DSERVER`].
+const STAGED_CHUNK: ChunkId = 0x803;
+const STAGED_DSERVER: DServerId = 1;
+/// A fragment on server 2 that nothing names, marked long past grace: the pass's positive
+/// observable, so "kept" never passes on a pass that reclaimed nothing at all.
+const STAGED_STRAY: ChunkId = 0x8031;
+/// The inode the publication writes.
+const STAGED_INODE: InodeId = 6;
+/// The part the chunk is staged, then committed, under.
+const STAGED_PART: u32 = 1;
+const STAGED_GRACE: u64 = 1_000;
+const STAGED_NOW: u64 = 10_000;
+/// Where the GC pass starts, in simulated milliseconds after the writer is spawned: late enough
+/// that a writer drawn early lands both handoffs before the build's first read.
+const STAGED_PASS_START: u64 = 4;
+/// How far past the writer's start the part commit's landing point is drawn from, in simulated
+/// milliseconds. A commit is two hops and [`StagedMeta`] spaces the build's three class reads two
+/// hops apart, so this spans "both handoffs before the build", the part commit between the `sidx:`
+/// and `part:` reads, the publication between the `part:` read and the `inode:` scan, and "after
+/// the whole build" — and the coverage property below proves each is reached rather than assuming
+/// it. Zero means now (see `RESTORE_NEMESIS_SPAN`).
+const STAGED_COMMIT_SPAN: u32 = 12;
+/// How long after the part commit lands the publication starts, drawn from `0..=` this.
+const STAGED_PUBLISH_SPAN: u32 = 4;
+
+/// Which of the three classes a read of the staged build reached.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+enum StagedClass {
+    /// The session's owned `sidx:` range.
+    Owned,
+    /// The session's `part:` range.
+    Part,
+    /// The committed `inode:` namespace.
+    Committed,
+}
+
+/// A recording tap over the simulated-TiKV store for property 13. Every call is forwarded,
+/// network hops included; each read of one of the three classes records whether its ANSWER held
+/// the record naming the chunk — what the production build observed, never the fixture's intended
+/// timing. And each such read spends one more simulated hop once the store has answered: the
+/// answer's trip back, during which a commit can land. That spaces the build's three observations
+/// two hops apart, so a handoff landing strictly between two of them is reachable whatever order
+/// the scheduler picks for a tie. Instance state only (ADR-0035).
+struct StagedMeta {
+    inner: SimTikvMetadataStore,
+    /// Each class's read prefix and the key that names the chunk under it.
+    watch: [(StagedClass, Vec<u8>, Vec<u8>); 3],
+    seen: Mutex<Vec<(StagedClass, bool)>>,
+}
+
+impl StagedMeta {
+    /// Record what a read of `prefix` answered, if it is one of the three classes, and spend the
+    /// answer's trip back.
+    async fn observe(&self, prefix: &[u8], answer: &[(Vec<u8>, Bytes)]) {
+        let Some((class, _, key)) = self.watch.iter().find(|(_, p, _)| p.as_slice() == prefix)
+        else {
+            return;
+        };
+        let saw = answer.iter().any(|(k, _)| k == key);
+        self.seen.lock().unwrap().push((*class, saw));
+        madsim::time::sleep(Duration::from_millis(1)).await;
+    }
+
+    fn landing(&self) -> StagedLanding {
+        let seen = self.seen.lock().unwrap();
+        let saw = |class| seen.iter().any(|&(c, saw)| c == class && saw);
+        let read = |class| seen.iter().any(|&(c, _)| c == class);
+        StagedLanding {
+            owned: saw(StagedClass::Owned),
+            part: saw(StagedClass::Part),
+            committed: saw(StagedClass::Committed),
+            read_all: read(StagedClass::Owned)
+                && read(StagedClass::Part)
+                && read(StagedClass::Committed),
+        }
+    }
+}
+
+#[async_trait]
+impl MetadataStore for StagedMeta {
+    async fn get(&self, key: &[u8]) -> Result<Option<Bytes>> {
+        self.inner.get(key).await
+    }
+
+    async fn scan(&self, prefix: &[u8]) -> Result<Vec<(Vec<u8>, Bytes)>> {
+        let answer = self.inner.scan(prefix).await?;
+        self.observe(prefix, &answer).await;
+        Ok(answer)
+    }
+
+    async fn scan_page(
+        &self,
+        prefix: &[u8],
+        after: Option<&[u8]>,
+        limit: usize,
+    ) -> Result<wyrd_traits::ScanPage> {
+        let (items, next) = self.inner.scan_page(prefix, after, limit).await?;
+        self.observe(prefix, &items).await;
+        Ok((items, next))
+    }
+
+    async fn commit(&self, batch: WriteBatch) -> Result<CommitOutcome> {
+        self.inner.commit(batch).await
+    }
+}
+
+/// Which classes the build's reads saw the chunk in — the interleaving that actually happened.
+struct StagedLanding {
+    /// The `sidx:` read answered with the owned entry: the part commit had not landed yet.
+    owned: bool,
+    /// The `part:` read answered with the part record: committed, not yet published.
+    part: bool,
+    /// The `inode:` scan answered with the published inode.
+    committed: bool,
+    /// The build read all three classes.
+    read_all: bool,
+}
+
+/// An `Open` session record as `mpu:` holds it — the spelling `decode_session_record` accepts and
+/// re-encodes byte-identically.
+const STAGED_SESSION: &[u8] = br#"{"parent":42,"object":"staged/one","created_at_millis":1000,"clock_source":"wall","epoch":3,"attempts":1,"state":{"kind":"Open"}}"#;
+
+/// One run: an `Open` session stages [`STAGED_CHUNK`] under an owned `sidx:` entry; a concurrent
+/// writer commits the part `commit_at` ms after it starts, then publishes it `publish_after` ms
+/// after that, while one GC pass starting [`STAGED_PASS_START`] ms in builds its reference set.
+/// Asserts the chunk is never reclaimed and returns what the build's reads saw.
+async fn gc_pass_across_staged_handoffs(commit_at: u64, publish_after: u64) -> StagedLanding {
+    let d = servers();
+    let upload = UploadId::new("83".repeat(16)).expect("32 lowercase-hex characters");
+    let part = PartNumber::new(STAGED_PART).expect("a part number in range");
+    let owned_key = sidx_key(&upload, part, STAGED_CHUNK);
+    let part_record = part_key(&upload, part);
+    let inode_key = metadata::inode_key(STAGED_INODE);
+    let meta = Arc::new(StagedMeta {
+        inner: SimTikvMetadataStore::new(),
+        watch: [
+            (StagedClass::Owned, sidx_range(&upload), owned_key.clone()),
+            (StagedClass::Part, part_range(&upload), part_record.clone()),
+            (
+                StagedClass::Committed,
+                b"inode:".to_vec(),
+                inode_key.clone(),
+            ),
+        ],
+        seen: Mutex::new(Vec::new()),
+    });
+
+    // The three records the chunk moves through, each one the production decoder for its
+    // namespace accepts: the owned entry minted through the public checked path, the part record
+    // and the session as raw JSON (neither has a writer-side constructor).
+    let staged = StagedPlacement::new(EcScheme::None, vec![STAGED_DSERVER]).unwrap();
+    let owned_value =
+        metadata::encode(&OwnedEntry::new(upload.clone(), 60_000, staged).to_pending());
+    decode_owned_entry(&owned_key, &owned_value).expect("the owned entry decodes under its key");
+    let part_value = Bytes::from(format!(
+        r#"{{"chunks":[{{"id":{STAGED_CHUNK},"scheme":"None","len":5,"placement":[{STAGED_DSERVER}]}}],"len":5,"digest":"{}","committed_at_millis":900,"session_epoch":3}}"#,
+        "ab".repeat(32)
+    ));
+    decode_part_record(&part_value).expect("the part record decodes");
+    decode_session_record(STAGED_SESSION).expect("the session record decodes");
+    let inode_value = metadata::encode(&flat_committed(STAGED_CHUNK, STAGED_DSERVER));
+
+    // The run's starting state: the session and its owned entry, the staged fragment and an
+    // unnamed stray on disk, each carrying a mark long past grace.
+    let seeded = WriteBatch::new()
+        .put(mpu_key(&upload), STAGED_SESSION.to_vec())
+        .put(owned_key.clone(), owned_value);
+    assert_eq!(meta.commit(seeded).await.unwrap(), CommitOutcome::Committed);
+    let chunk = frag_of(STAGED_CHUNK);
+    let stray = frag_of(STAGED_STRAY);
+    d[STAGED_DSERVER as usize]
+        .put_fragment(chunk, Bytes::from_static(b"staged"), None)
+        .await
+        .unwrap();
+    d[2].put_fragment(stray, Bytes::from_static(b"stray"), None)
+        .await
+        .unwrap();
+    mark_orphaned(&*meta, STAGED_DSERVER, chunk, 0)
+        .await
+        .unwrap();
+    mark_orphaned(&*meta, 2, stray, 0).await.unwrap();
+
+    // Elected before the writer starts, so the pass's start is exactly `STAGED_PASS_START` after it.
+    let coord = MemCoordination::new();
+    let (zone, custodian) = elect(&coord, "zone-gc-staged").await;
+
+    // The genuinely concurrent writer: the part commit, then the publication — each ONE batch.
+    let writer = madsim::task::spawn({
+        let meta = Arc::clone(&meta);
+        let part_record = part_record.clone();
+        async move {
+            // Zero means now: see `RESTORE_NEMESIS_SPAN`.
+            if commit_at > 0 {
+                madsim::time::sleep(Duration::from_millis(commit_at)).await;
+            }
+            let commit = WriteBatch::new()
+                .delete(owned_key)
+                .put(part_record.clone(), part_value);
+            assert_eq!(
+                meta.commit(commit).await.unwrap(),
+                CommitOutcome::Committed,
+                "the part commit must land, or this run tests nothing"
+            );
+            if publish_after > 0 {
+                madsim::time::sleep(Duration::from_millis(publish_after)).await;
+            }
+            let publication = WriteBatch::new()
+                .put(inode_key, inode_value)
+                .delete(part_record);
+            assert_eq!(
+                meta.commit(publication).await.unwrap(),
+                CommitOutcome::Committed,
+                "the publication must land, or this run tests nothing"
+            );
+        }
+    });
+
+    madsim::time::sleep(Duration::from_millis(STAGED_PASS_START)).await;
+    let fleet: [(DServerId, &dyn ChunkStore); 4] = [(0, &d[0]), (1, &d[1]), (2, &d[2]), (3, &d[3])];
+    let ctx = GcContext {
+        meta: &*meta,
+        fleet: &fleet,
+        grace_window_millis: STAGED_GRACE,
+        expired_pending: ExpiredPendingPolicy::Defer,
+    };
+    let outcome = reconcile_step(&zone, &custodian, Some(&ctx), None, None, None, STAGED_NOW).await;
+    writer
+        .await
+        .expect("the concurrent writer ran to completion");
+    let landing = meta.landing();
+    let at = format!(
+        "part commit at {commit_at} ms, publication {publish_after} ms after it; the build saw \
+         the owned entry: {}, the part record: {}, the published inode: {}",
+        landing.owned, landing.part, landing.committed
+    );
+
+    let outcome = outcome.unwrap_or_else(|err| panic!("the GC pass failed ({at}): {err:?}"));
+
+    // (1) NEVER RECLAIMED, AND NOT DEPRIVED OF ITS EVIDENCE: the chunk's fragment is on disk and
+    //     its mark untouched — GC consumes a mark only when it reclaims.
+    assert!(
+        d[STAGED_DSERVER as usize]
+            .get_fragment(chunk)
+            .await
+            .unwrap()
+            .is_some(),
+        "GC reclaimed a fragment a staged record or the published inode named throughout ({at})"
+    );
+    assert!(is_marked(&*meta, STAGED_DSERVER, chunk).await, "({at})");
+
+    // (2) POSITIVE OBSERVABLE: the stray nothing names was reclaimed, and its mark consumed.
+    assert!(
+        d[2].get_fragment(stray).await.unwrap().is_none() && !is_marked(&*meta, 2, stray).await,
+        "the unnamed stray survived a pass that must reclaim it ({at})"
+    );
+    assert_eq!(outcome, Reconciled::Changed, "({at})");
+
+    // (3) WHY (1) HOLDS, observed at the store seam — source before destination: the build read
+    //     every class, and whatever the interleaving, at least one of its reads saw the record
+    //     naming the chunk.
+    assert!(
+        landing.read_all,
+        "the build did not read all three classes ({at})"
+    );
+    assert!(
+        landing.owned || landing.part || landing.committed,
+        "the build's reads saw the chunk in NO class — a handoff fell between a destination read \
+         and its source read ({at})"
+    );
+
+    landing
+}
+
+/// The campaign leg: the seed picks where the part commit lands and how long the publication
+/// follows it, so 50 seeds sweep the schedule space around the staged build's reads.
+async fn prop_gc_staged_build_under_concurrent_handoffs(rng: &mut ChaCha8Rng) {
+    let commit_at = u64::from(rng.next_u32() % (STAGED_COMMIT_SPAN + 1));
+    let publish_after = u64::from(rng.next_u32() % (STAGED_PUBLISH_SPAN + 1));
+    gc_pass_across_staged_handoffs(commit_at, publish_after).await;
+}
+
+/// **Every landing the property is about is genuinely REACHED.** Walks the part commit's landing
+/// point across its whole span, the publication both right behind it and two hops later, asserting
+/// the full property at every point — then asserts four schedules occurred: the part commit
+/// between the build's `sidx:` and `part:` reads, the publication between its `part:` read and the
+/// `inode:` scan (the two handoffs landing BETWEEN the builder's reads), and both handoffs before
+/// the build and both after it (landings OUTSIDE them). Without it a span that drifted off the
+/// build would leave the campaign green with nothing behind it.
+async fn prop_gc_staged_build_reaches_every_landing() {
+    let mut commit_between = Vec::new();
+    let mut publication_between = Vec::new();
+    let mut before = Vec::new();
+    let mut after = Vec::new();
+    for commit_at in 0..=u64::from(STAGED_COMMIT_SPAN) {
+        for publish_after in [0, 2] {
+            let seen = gc_pass_across_staged_handoffs(commit_at, publish_after).await;
+            let at = (commit_at, publish_after);
+            if seen.owned && seen.part {
+                commit_between.push(at);
+            }
+            if seen.part && seen.committed {
+                publication_between.push(at);
+            }
+            if !seen.owned && !seen.part && seen.committed {
+                before.push(at);
+            }
+            if seen.owned && !seen.part && !seen.committed {
+                after.push(at);
+            }
+        }
+    }
+    assert!(
+        !commit_between.is_empty(),
+        "no landing put the part commit between the build's `sidx:` and `part:` reads — the \
+         source-before-destination order of that handoff was never exercised"
+    );
+    assert!(
+        !publication_between.is_empty(),
+        "no landing put the publication between the build's `part:` read and its `inode:` scan — \
+         the source-before-destination order of that handoff was never exercised"
+    );
+    assert!(
+        !before.is_empty() && !after.is_empty(),
+        "the sweep never landed both handoffs outside the build (before: {before:?}, after: \
+         {after:?}) — the span no longer brackets it, so it is stuck in one regime"
+    );
+}
+
 // ---- the seed sweep: each property over the run seed (madsim sweeps MADSIM_TEST_NUM) ----
 
 /// A fresh ChaCha RNG seeded from the madsim run seed, so the whole campaign — *which*
@@ -2649,6 +2998,18 @@ dst_campaign_test! {
     }
 }
 
+dst_campaign_test! {
+    async fn gc_staged_build_under_concurrent_handoffs() {
+        prop_gc_staged_build_under_concurrent_handoffs(&mut rand_seed()).await;
+    }
+}
+
+dst_campaign_test! {
+    async fn gc_staged_build_reaches_every_landing() {
+        prop_gc_staged_build_reaches_every_landing().await;
+    }
+}
+
 // ---- committed regression seeds (ADR-0009: a bug-finding seed is a permanent test) ----
 
 /// Seeds committed as **permanent regressions** (ADR-0009, `0005:374`): the campaign
@@ -2682,6 +3043,7 @@ dst_campaign_test! {
             prop_gc_over_a_segmented_map_never_reclaims_it_and_never_over_certifies(&mut rng).await;
             prop_restore_two_readings_never_license_a_mark(&mut rng).await;
             prop_gc_orphan_walk_under_a_concurrent_unlink(&mut rng).await;
+            prop_gc_staged_build_under_concurrent_handoffs(&mut rng).await;
         }
     }
 }
