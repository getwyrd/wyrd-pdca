+++ b/crates/custodian/tests/staged_protection.rs
@@ -0,0 +1,1045 @@
+//! Issue #803 (child 1 of 2 of #662): the **staged protection class** in the shared reference
+//! set (proposal 0016 decision 2, `0016:765-893`).
+//!
+//! What a multipart upload has made durable but not yet published — the chunks its committed
+//! `part:` records name, and the chunks its in-flight owned `sidx:` entries stage — must be
+//! protected by the SAME reference set every destructive pass reads, as a member of its own beside
+//! the committed placements. On `main` that set is committed placements only, built from the
+//! `inode:` scan alone (`crates/custodian/src/gc.rs:383-413`, `:478-573`), so nothing in the
+//! maintenance plane reads a staged record: GC reclaims a staged fragment as soon as it carries an
+//! `orphan:` mark past grace, and the post-restore pass marks a live upload's fragments stranded
+//! for the next GC pass to delete.
+//!
+//! Every leg drives the production entry points — `reconcile_step` with a `GcContext`, and
+//! `reconcile_after_restore` — over in-memory doubles. No client creates a session yet (#508), so
+//! each leg seeds its staged records as raw JSON, and every one it seeds as valid is first
+//! decoded by the production decoder for its namespace (`decode_session_record`,
+//! `decode_part_record`, `decode_owned_entry`) and re-encoded byte-identically: the fixture is the
+//! state the protocol's writers will produce, not a shape only this file believes in. Every
+//! protection leg also seeds an unprotected control the pass does reclaim or mark, so "kept" can
+//! never pass on a pass that did nothing.
+//!
+//! The legs:
+//!
+//! * **A** — GC keeps a committed part's fragments and an in-flight owned entry's fragment, each
+//!   marked `orphan:` past grace. Unmarked, GC's conservative arm keeps any fragment
+//!   (`gc.rs:307-310`), so the mark is what makes the leg bite.
+//! * **B** — restore protects them through the same predicate: it marks none of them, and a GC
+//!   pass past grace keeps them all afterwards. A filter inside GC alone passes A and fails here.
+//! * **C** — source before destination, both handoffs (`0016:782-800`, X67): the double performs
+//!   a part commit (the chunk's `sidx:` entry deleted and its `part:` record written, one batch)
+//!   or a publication (the committed inode written and the `part:` record removed, one batch)
+//!   atomically, the moment the FIRST of the two reads involved completes — the source range or
+//!   the destination, whichever the builder issues first. The marked fragment survives.
+//! * **D** — bounded per-session reads (`0016:890`): with the store's `scan` cap below the number
+//!   of staged records a global `scan("part:")` or `scan("sidx:")` would return, the pass succeeds,
+//!   protects every session's fragments, and reads those namespaces through per-session ranges
+//!   only. A guard.
+//! * **E** — what the build cannot read or trust fails closed (ADR-0045 decision 3): (i) a `part:`
+//!   value that will not decode, an `sidx:` key naming no chunk or an `mpu:` key naming no upload
+//!   blocks GC (`Reconciled::Blocked`, nothing reclaimed) and restore (nothing marked, the record
+//!   named in `RestoreReport::unresolvable`); (ii) a staged placement of the wrong length, or an
+//!   undecodable owned value under a key naming its chunk, holds that whole chunk in both passes
+//!   and is named on each audit seam, while unrelated fragments are still judged.
+//!
+//! The file names no symbol this slice adds. The staged member, its audit reasons and its emitters
+//! are observed only through what the two passes do, and through the record keys their audit seams
+//! carry.
+
+#![forbid(unsafe_code)]
+
+use std::collections::{BTreeMap, HashMap, HashSet};
+use std::ops::Bound;
+use std::sync::{Arc, Mutex};
+
+use async_trait::async_trait;
+use bytes::Bytes;
+use tracing::instrument::WithSubscriber;
+use tracing_subscriber::prelude::*;
+use wyrd_coordination_mem::MemCoordination;
+use wyrd_core::metadata::{
+    self, inode_key, orphan_key, ChunkRef, EcScheme, InodeRecord, InodeState,
+};
+use wyrd_core::multipart::{
+    decode_owned_entry, decode_part_record, decode_session_record, mpu_key, parse_mpu_key,
+    part_key, part_range, sidx_key, sidx_range, PartNumber, UploadId, PART_PREFIX, SIDX_PREFIX,
+};
+use wyrd_custodian::{
+    mark_orphaned, reconcile_after_restore, reconcile_step, Custodian, ExpiredPendingPolicy,
+    FencedZone, GcContext, Reconciled, RestoreReport,
+};
+use wyrd_traits::{
+    page_cursor, page_limit, page_start, ChunkId, ChunkStore, CommitOutcome, DServerId, FragmentId,
+    Health, MetadataStore, PageStart, Result, ScanCapExceeded, ScanPage, WriteBatch, SCAN_CAP,
+};
+
+/// The reader-safe grace window every pass runs with.
+const GRACE: u64 = 50;
+/// The instant every first pass runs at. A mark stamped at `0` is long past grace by then.
+const NOW: u64 = 1_000;
+/// The instant a GC pass runs at after the post-restore pass: past the grace window of every mark
+/// that pass stamped at [`NOW`].
+const AFTER_GRACE: u64 = NOW + GRACE + 1;
+/// The lease every seeded owned entry carries — never consulted by either pass.
+const LEASE: u64 = 5_000;
+
+/// `rs(2,1)`: three fragments, a geometry `erasure::supported` accepts, as each scheme's JSON
+/// spelling (`EcScheme`'s externally tagged form).
+const RS_2_1: &str = r#"{"ReedSolomon":{"k":2,"m":1}}"#;
+/// `EcScheme::None`: one fragment.
+const NONE: &str = r#""None""#;
+
+const GC_AUDIT: &str = "wyrd.custodian.gc.audit";
+const RESTORE_AUDIT: &str = "wyrd.custodian.restore.audit";
+
+// ---- the metadata double ----
+
+/// An in-memory metadata store over an ORDERED map, with a `scan` cap (lowered by leg D, full
+/// [`SCAN_CAP`] otherwise), a log of every prefix a `scan` or `scan_page` was asked for (leg D),
+/// and at most one armed [`Handoff`] (leg C). `scan_page` is implemented over the map with the
+/// seam's own page helpers, never over `scan`, so it neither inherits the lowered cap nor logs a
+/// read twice.
+struct Meta {
+    kv: Mutex<BTreeMap<Vec<u8>, Bytes>>,
+    cap: usize,
+    reads: Mutex<Vec<Vec<u8>>>,
+    handoff: Mutex<Option<Handoff>>,
+    fired_after: Mutex<Option<Vec<u8>>>,
+}
+
+/// One protocol handoff the double lands atomically — as the single batch the protocol commits it
+/// in — the moment the first read that could observe it completes: a range read whose prefix
+/// covers either the key the fact is moved **from** (`source`) or the key it is moved **to**
+/// (`destination`), or a point read of either. The read's own answer is taken before the batch
+/// applies: that read completed, and the handoff landed right after it.
+struct Handoff {
+    source: Vec<u8>,
+    destination: Vec<u8>,
+    batch: WriteBatch,
+}
+
+impl Default for Meta {
+    fn default() -> Self {
+        Self::with_cap(SCAN_CAP)
+    }
+}
+
+impl Meta {
+    fn with_cap(cap: usize) -> Self {
+        Self {
+            kv: Mutex::new(BTreeMap::new()),
+            cap,
+            reads: Mutex::new(Vec::new()),
+            handoff: Mutex::new(None),
+            fired_after: Mutex::new(None),
+        }
+    }
+
+    fn seed(&self, key: Vec<u8>, value: impl Into<Bytes>) {
+        self.kv.lock().unwrap().insert(key, value.into());
+    }
+
+    fn value(&self, key: &[u8]) -> Option<Bytes> {
+        self.kv.lock().unwrap().get(key).cloned()
+    }
+
+    fn arm(&self, handoff: Handoff) {
+        *self.handoff.lock().unwrap() = Some(handoff);
+    }
+
+    /// The read the armed handoff landed after — `None` if no read could observe it.
+    fn fired_after(&self) -> Option<Vec<u8>> {
+        self.fired_after.lock().unwrap().clone()
+    }
+
+    fn reads(&self) -> Vec<Vec<u8>> {
+        self.reads.lock().unwrap().clone()
+    }
+
+    /// A read that `observes` the armed handoff has just produced its answer: land the handoff.
+    fn after_read(&self, what: &[u8], observes: impl Fn(&Handoff) -> bool) {
+        let mut slot = self.handoff.lock().unwrap();
+        if !slot.as_ref().is_some_and(observes) {
+            return;
+        }
+        let handoff = slot.take().expect("checked just above");
+        let mut kv = self.kv.lock().unwrap();
+        for (key, value) in handoff.batch.puts {
+            kv.insert(key, value);
+        }
+        for key in handoff.batch.deletes {
+            kv.remove(&key);
+        }
+        *self.fired_after.lock().unwrap() = Some(what.to_vec());
+    }
+
+    /// Whether a range read of `prefix` could observe the handoff's source or destination.
+    fn covers(prefix: &[u8]) -> impl Fn(&Handoff) -> bool + '_ {
+        move |h| h.source.starts_with(prefix) || h.destination.starts_with(prefix)
+    }
+}
+
+#[async_trait]
+impl MetadataStore for Meta {
+    async fn get(&self, key: &[u8]) -> Result<Option<Bytes>> {
+        let answer = self.value(key);
+        self.after_read(key, |h| h.source == key || h.destination == key);
+        Ok(answer)
+    }
+
+    async fn scan(&self, prefix: &[u8]) -> Result<Vec<(Vec<u8>, Bytes)>> {
+        self.reads.lock().unwrap().push(prefix.to_vec());
+        let hits: Vec<(Vec<u8>, Bytes)> = self
+            .kv
+            .lock()
+            .unwrap()
+            .range(prefix.to_vec()..)
+            .take_while(|(key, _)| key.starts_with(prefix))
+            .take(self.cap + 1)
+            .map(|(key, value)| (key.clone(), value.clone()))
+            .collect();
+        // `>` not `>=`: exactly `cap` keys is a complete answer, as on every backend.
+        if hits.len() > self.cap {
+            return Err(Box::new(ScanCapExceeded {
+                cap: self.cap,
+                prefix: prefix.to_vec(),
+            }));
+        }
+        self.after_read(prefix, Self::covers(prefix));
+        Ok(hits)
+    }
+
+    async fn scan_page(
+        &self,
+        prefix: &[u8],
+        after: Option<&[u8]>,
+        limit: usize,
+    ) -> Result<ScanPage> {
+        self.reads.lock().unwrap().push(prefix.to_vec());
+        let limit = page_limit(limit, self.cap, prefix)?;
+        let lower = match page_start(prefix, after) {
+            PageStart::Prefix => Bound::Included(prefix.to_vec()),
+            PageStart::After(cursor) => Bound::Excluded(cursor.to_vec()),
+            PageStart::PastPrefix => return Ok((Vec::new(), None)),
+        };
+        let items: Vec<(Vec<u8>, Bytes)> = self
+            .kv
+            .lock()
+            .unwrap()
+            .range((lower, Bound::Unbounded))
+            .take_while(|(key, _)| key.starts_with(prefix))
+            .take(limit)
+            .map(|(key, value)| (key.clone(), value.clone()))
+            .collect();
+        let next = page_cursor(&items, limit);
+        self.after_read(prefix, Self::covers(prefix));
+        Ok((items, next))
+    }
+
+    async fn commit(&self, batch: WriteBatch) -> Result<CommitOutcome> {
+        let mut kv = self.kv.lock().unwrap();
+        for pre in &batch.preconditions {
+            if kv.get(&pre.key).cloned() != pre.expected {
+                return Ok(CommitOutcome::Conflict);
+            }
+        }
+        for (key, value) in batch.puts {
+            kv.insert(key, value);
+        }
+        for key in batch.deletes {
+            kv.remove(&key);
+        }
+        Ok(CommitOutcome::Committed)
+    }
+}
+
+// ---- the D-server double ----
+
+/// One D server's fragment bytes.
+#[derive(Default)]
+struct MemDServer {
+    frags: Mutex<HashMap<FragmentId, Bytes>>,
+}
+
+impl MemDServer {
+    fn put(&self, frag: FragmentId) {
+        self.frags
+            .lock()
+            .unwrap()
+            .insert(frag, Bytes::from_static(b"bytes"));
+    }
+
+    fn holds(&self, frag: FragmentId) -> bool {
+        self.frags.lock().unwrap().contains_key(&frag)
+    }
+}
+
+#[async_trait]
+impl ChunkStore for MemDServer {
+    async fn put_fragment(
+        &self,
+        id: FragmentId,
+        fragment: Bytes,
+        _deadline_millis: Option<u64>,
+    ) -> Result<()> {
+        self.frags.lock().unwrap().insert(id, fragment);
+        Ok(())
+    }
+
+    async fn get_fragment(&self, id: FragmentId) -> Result<Option<Bytes>> {
+        Ok(self.frags.lock().unwrap().get(&id).cloned())
+    }
+
+    async fn list_fragments(&self) -> Result<Vec<FragmentId>> {
+        Ok(self.frags.lock().unwrap().keys().copied().collect())
+    }
+
+    async fn delete_fragment(&self, id: FragmentId) -> Result<()> {
+        self.frags.lock().unwrap().remove(&id);
+        Ok(())
+    }
+
+    async fn health(&self) -> Result<Health> {
+        Ok(Health::Healthy)
+    }
+}
+
+/// A fleet of four D servers, ids `0..4`.
+struct Fleet([MemDServer; 4]);
+
+impl Fleet {
+    fn new() -> Self {
+        Self(Default::default())
+    }
+
+    fn put(&self, dserver: DServerId, frag: FragmentId) {
+        self.0[dserver as usize].put(frag);
+    }
+
+    fn holds(&self, dserver: DServerId, frag: FragmentId) -> bool {
+        self.0[dserver as usize].holds(frag)
+    }
+
+    fn stores(&self) -> [(DServerId, &dyn ChunkStore); 4] {
+        [
+            (0, &self.0[0]),
+            (1, &self.0[1]),
+            (2, &self.0[2]),
+            (3, &self.0[3]),
+        ]
+    }
+}
+
+// ---- the audit seam, read back ----
+
+/// Collects what a `tracing` subscriber writes, so a leg reads back the audit lines a pass actually
+/// emitted — the pattern of `gc.rs`'s #772 leg.
+#[derive(Clone, Default)]
+struct Capture(Arc<Mutex<Vec<u8>>>);
+
+impl Capture {
+    fn text(&self) -> String {
+        String::from_utf8(self.0.lock().unwrap().clone()).unwrap()
+    }
+
+    fn dispatch(&self) -> tracing::Dispatch {
+        tracing::Dispatch::new(
+            tracing_subscriber::registry().with(
+                tracing_subscriber::fmt::layer()
+                    .json()
+                    .with_writer(self.clone()),
+            ),
+        )
+    }
+}
+
+impl std::io::Write for Capture {
+    fn write(&mut self, buf: &[u8]) -> std::io::Result<usize> {
+        self.0.lock().unwrap().extend_from_slice(buf);
+        Ok(buf.len())
+    }
+
+    fn flush(&mut self) -> std::io::Result<()> {
+        Ok(())
+    }
+}
+
+impl<'w> tracing_subscriber::fmt::MakeWriter<'w> for Capture {
+    type Writer = Self;
+    fn make_writer(&'w self) -> Self::Writer {
+        self.clone()
+    }
+}
+
+/// A permissive global default, installed before any callsite a pass fires is first hit, so none
+/// can latch `Interest::never` under the parallel harness and leave a capture empty (#214 — the
+/// guard `gc.rs`'s #772 leg installs). Every leg calls it first.
+fn guard() {
+    let _ = tracing::subscriber::set_global_default(tracing_subscriber::registry());
+}
+
+/// Whether an audit line on `target` names `record` — its key exactly as the store spells it.
+/// Every key this file seeds is printable ASCII, so the escaped name a seam carries is the key.
+fn audit_names(audit: &str, target: &str, record: &[u8]) -> bool {
+    let target = format!(r#""target":"{target}""#);
+    let record = std::str::from_utf8(record).expect("every key this file seeds is ASCII");
+    audit
+        .lines()
+        .any(|line| line.contains(&target) && line.contains(record))
+}
+
+// ---- the two passes ----
+
+async fn elect(coord: &MemCoordination) -> (FencedZone, Custodian) {
+    let leader = Custodian::elect(coord, "zone-staged").await.unwrap();
+    let mut zone = FencedZone::new();
+    zone.install(leader.leadership());
+    (zone, leader)
+}
+
+/// One GC pass at `now` through the real fenced control point, under the deployed default for the
+/// expired-lease input — staged protection must not lean on it — with its audit lines captured.
+async fn gc_pass(meta: &Meta, fleet: &Fleet, now: u64) -> (Reconciled, String) {
+    let coord = MemCoordination::new();
+    let (zone, custodian) = elect(&coord).await;
+    let stores = fleet.stores();
+    let ctx = GcContext {
+        meta,
+        fleet: &stores,
+        grace_window_millis: GRACE,
+        expired_pending: ExpiredPendingPolicy::Defer,
+    };
+    let audit = Capture::default();
+    let outcome = reconcile_step(&zone, &custodian, Some(&ctx), None, None, None, now)
+        .with_subscriber(audit.dispatch())
+        .await
+        .unwrap_or_else(|err| panic!("the GC pass failed: {err:?}"));
+    (outcome, audit.text())
+}
+
+/// One post-restore pass at `now` over the complete fleet, with its audit lines captured.
+async fn restore_pass(meta: &Meta, fleet: &Fleet, now: u64) -> (RestoreReport, String) {
+    let stores = fleet.stores();
+    let ctx = GcContext {
+        meta,
+        fleet: &stores,
+        grace_window_millis: GRACE,
+        expired_pending: ExpiredPendingPolicy::Defer,
+    };
+    let audit = Capture::default();
+    let report = reconcile_after_restore(&ctx, now)
+        .with_subscriber(audit.dispatch())
+        .await
+        .unwrap_or_else(|err| panic!("the post-restore pass failed: {err}"));
+    (report, audit.text())
+}
+
+// ---- the staged records, as raw JSON the production decoders accept ----
+
+fn upload(pair: &str) -> UploadId {
+    UploadId::new(pair.repeat(16)).expect("32 lowercase-hex characters are an upload id")
+}
+
+fn part_number(n: u32) -> PartNumber {
+    PartNumber::new(n).expect("a part number in range")
+}
+
+fn frag(chunk: ChunkId, index: u16) -> FragmentId {
+    FragmentId { chunk, index }
+}
+
+async fn mark(meta: &Meta, dserver: DServerId, frag: FragmentId, at: u64) {
+    mark_orphaned(meta, dserver, frag, at).await.unwrap();
+}
+
+fn is_marked(meta: &Meta, dserver: DServerId, frag: FragmentId) -> bool {
+    meta.value(&orphan_key(dserver, frag)).is_some()
+}
+
+/// Seed `upload`'s session record — `Open` — under its `mpu:` key.
+fn seed_session(meta: &Meta, upload: &UploadId) {
+    meta.seed(mpu_key(upload), session_value());
+}
+
+/// An `Open` session record: decoded by `decode_session_record`, re-encoded byte-identically.
+fn session_value() -> Bytes {
+    let bytes: &'static [u8] = br#"{"parent":42,"object":"key/one","created_at_millis":1000,"clock_source":"wall","epoch":3,"attempts":1,"state":{"kind":"Open"}}"#;
+    let record = decode_session_record(bytes).expect("the seeded session decodes");
+    assert_eq!(
+        metadata::encode(&record).as_ref(),
+        bytes,
+        "session round trip"
+    );
+    Bytes::from_static(bytes)
+}
+
+/// One chunk of a `part:` record: `id`, a scheme's JSON, its logical `len` and its placement.
+fn chunk_json(id: ChunkId, scheme: &str, len: u64, placement: &[DServerId]) -> String {
+    let placement: Vec<String> = placement.iter().map(u64::to_string).collect();
+    format!(
+        r#"{{"id":{id},"scheme":{scheme},"len":{len},"placement":[{}]}}"#,
+        placement.join(",")
+    )
+}
+
+/// A committed part over `chunks`, whose lengths total `len`: decoded by `decode_part_record`,
+/// re-encoded byte-identically.
+fn part_value(chunks: &[String], len: u64) -> Bytes {
+    let bytes = format!(
+        r#"{{"chunks":[{}],"len":{len},"digest":"{}","committed_at_millis":900,"session_epoch":3}}"#,
+        chunks.join(","),
+        "ab".repeat(32),
+    )
+    .into_bytes();
+    let record = decode_part_record(&bytes).expect("the seeded part record decodes");
+    assert_eq!(
+        metadata::encode(&record).as_ref(),
+        &bytes[..],
+        "part record round trip"
+    );
+    Bytes::from(bytes)
+}
+
+/// Seed a committed part record under `part:<upload>:<n>`; returns its key.
+fn seed_part(meta: &Meta, upload: &UploadId, n: u32, chunks: &[String], len: u64) -> Vec<u8> {
+    let key = part_key(upload, part_number(n));
+    meta.seed(key.clone(), part_value(chunks, len));
+    key
+}
+
+/// An owned entry's value for `sidx:<upload>:<n>:<chunk>`, staging `chunk` on `placement` under
+/// `scheme`: decoded by `decode_owned_entry` WITH that key, which hands back the part number and
+/// chunk the key names, and re-encoded byte-identically in its stored form.
+fn owned_value(
+    upload: &UploadId,
+    n: u32,
+    chunk: ChunkId,
+    scheme: &str,
+    placement: &[DServerId],
+) -> (Vec<u8>, Bytes) {
+    let key = sidx_key(upload, part_number(n), chunk);
+    let placement: Vec<String> = placement.iter().map(u64::to_string).collect();
+    let bytes = format!(
+        r#"{{"lease_expiry_millis":{LEASE},"owner":"{upload}","staged":{{"scheme":{scheme},"placement":[{}]}}}}"#,
+        placement.join(",")
+    )
+    .into_bytes();
+    let (n_back, chunk_back, entry) =
+        decode_owned_entry(&key, &bytes).expect("the seeded owned entry decodes under its key");
+    assert_eq!((n_back, chunk_back), (part_number(n), chunk));
+    assert_eq!(
+        metadata::encode(&entry.to_pending()).as_ref(),
+        &bytes[..],
+        "owned entry round trip"
+    );
+    (key, Bytes::from(bytes))
+}
+
+/// Seed an owned entry (see [`owned_value`]); returns its key.
+fn seed_owned(
+    meta: &Meta,
+    upload: &UploadId,
+    n: u32,
+    chunk: ChunkId,
+    scheme: &str,
+    placement: &[DServerId],
+) -> Vec<u8> {
+    let (key, value) = owned_value(upload, n, chunk, scheme, placement);
+    meta.seed(key.clone(), value);
+    key
+}
+
+/// A committed inode whose single un-coded chunk places fragment 0 on `dserver` — what a
+/// publication writes for a one-chunk object.
+fn published(chunk: ChunkId, dserver: DServerId) -> Bytes {
+    metadata::encode(&InodeRecord {
+        size: 5,
+        chunk_map: vec![ChunkRef {
+            id: chunk,
+            scheme: EcScheme::None,
+            len: 5,
+            placement: vec![dserver],
+        }]
+        .into(),
+        state: InodeState::Committed,
+        version: 1,
+        ..Default::default()
+    })
+}
+
+// ---- A and B: both staged classes, in both passes ----
+
+/// The committed part's chunk (`rs(2,1)` over servers 0, 1 and 2) and the owned entry's chunk
+/// (one un-coded fragment on server 3).
+const PART_CHUNK: ChunkId = 0xA1;
+const OWNED_CHUNK: ChunkId = 0xA2;
+/// A chunk nothing names.
+const UNRELATED: ChunkId = 0xA3;
+
+/// The world A and B share: an `Open` session with one committed part and one in-flight owned
+/// entry, every fragment either names on disk — and two controls no staged record protects: a
+/// copy of the part chunk's fragment 0 on server 3, which its placement does not name (the shape
+/// a staged re-place's losing destination leaves), and a fragment nothing names at all.
+struct Staged {
+    meta: Meta,
+    fleet: Fleet,
+    protected: Vec<(DServerId, FragmentId)>,
+    controls: Vec<(DServerId, FragmentId)>,
+}
+
+fn staged_world() -> Staged {
+    let meta = Meta::default();
+    let fleet = Fleet::new();
+    let u = upload("a1");
+    seed_session(&meta, &u);
+    seed_part(
+        &meta,
+        &u,
+        1,
+        &[chunk_json(PART_CHUNK, RS_2_1, 10, &[0, 1, 2])],
+        10,
+    );
+    seed_owned(&meta, &u, 2, OWNED_CHUNK, NONE, &[3]);
+    let protected = vec![
+        (0, frag(PART_CHUNK, 0)),
+        (1, frag(PART_CHUNK, 1)),
+        (2, frag(PART_CHUNK, 2)),
+        (3, frag(OWNED_CHUNK, 0)),
+    ];
+    let controls = vec![(3, frag(PART_CHUNK, 0)), (1, frag(UNRELATED, 0))];
+    for &(dserver, frag) in protected.iter().chain(&controls) {
+        fleet.put(dserver, frag);
+    }
+    Staged {
+        meta,
+        fleet,
+        protected,
+        controls,
+    }
+}
+
+#[tokio::test]
+async fn a_gc_keeps_committed_part_and_owned_entry_fragments_marked_past_grace() {
+    guard();
+    let world = staged_world();
+    for &(dserver, frag) in world.protected.iter().chain(&world.controls) {
+        mark(&world.meta, dserver, frag, 0).await;
+    }
+
+    let (outcome, _) = gc_pass(&world.meta, &world.fleet, NOW).await;
+
+    for &(dserver, frag) in &world.protected {
+        assert!(
+            world.fleet.holds(dserver, frag),
+            "GC reclaimed {frag:?} on server {dserver}, which a live session's staged record \
+             names — its `orphan:` mark is past grace, and only the staged class stands between \
+             it and a reclaim"
+        );
+        assert!(
+            is_marked(&world.meta, dserver, frag),
+            "GC consumed the mark of {frag:?} on server {dserver} without reclaiming it"
+        );
+    }
+    for &(dserver, frag) in &world.controls {
+        assert!(
+            !world.fleet.holds(dserver, frag),
+            "the control {frag:?} on server {dserver} — named by no staged placement, marked past \
+             grace — was not reclaimed: the pass is keeping more than the staged class"
+        );
+    }
+    assert_eq!(outcome, Reconciled::Changed);
+}
+
+#[tokio::test]
+async fn b_restore_marks_no_staged_fragment_and_gc_keeps_them_all_afterwards() {
+    guard();
+    let world = staged_world();
+
+    let (report, _) = restore_pass(&world.meta, &world.fleet, NOW).await;
+
+    for &(dserver, frag) in &world.protected {
+        assert!(
+            !is_marked(&world.meta, dserver, frag),
+            "the post-restore pass marked {frag:?} on server {dserver} stranded, though a live \
+             session's staged record names it — the next GC pass past grace deletes it"
+        );
+    }
+    for &(dserver, frag) in &world.controls {
+        assert!(
+            is_marked(&world.meta, dserver, frag),
+            "the control {frag:?} on server {dserver} is referenced by nothing and was not marked"
+        );
+    }
+    assert_eq!(
+        report.stranded_marked,
+        world.controls.len(),
+        "stranded_marked counts the controls and no staged fragment: {report:?}"
+    );
+    assert!(report.unresolvable.is_empty(), "{report:?}");
+
+    // The marks the pass wrote are evidence GC acts on: past their grace window, GC reclaims
+    // exactly what was marked and nothing a staged record names.
+    let (outcome, _) = gc_pass(&world.meta, &world.fleet, AFTER_GRACE).await;
+    for &(dserver, frag) in &world.protected {
+        assert!(
+            world.fleet.holds(dserver, frag),
+            "{frag:?} on server {dserver} did not survive the GC pass after the restore"
+        );
+    }
+    for &(dserver, frag) in &world.controls {
+        assert!(!world.fleet.holds(dserver, frag), "{frag:?} on {dserver}");
+    }
+    assert_eq!(outcome, Reconciled::Changed);
+}
+
+// ---- C: source before destination, across both handoffs ----
+
+/// The chunk each handoff moves: one un-coded fragment on server 0, marked long past grace — so
+/// whichever record names it at the instant the build reads is all that keeps it.
+const MOVED_CHUNK: ChunkId = 0xC1;
+/// An unrelated fragment on server 1, marked past grace: the pass's positive observable.
+const C_CONTROL: ChunkId = 0xC2;
+/// The inode a publication writes.
+const PUBLISHED_INODE: u64 = 7;
+
+/// Run one GC pass over `meta` with `handoff` armed, then assert the moved chunk's fragment
+/// survived, the control was reclaimed, and the handoff really landed mid-pass.
+async fn gc_across_a_handoff(meta: Meta, fleet: Fleet, handoff: Handoff, which: &str) {
+    let moved = frag(MOVED_CHUNK, 0);
+    let control = frag(C_CONTROL, 0);
+    fleet.put(0, moved);
+    fleet.put(1, control);
+    mark(&meta, 0, moved, 0).await;
+    mark(&meta, 1, control, 0).await;
+    let (source, destination) = (handoff.source.clone(), handoff.destination.clone());
+    meta.arm(handoff);
+
+    let (outcome, _) = gc_pass(&meta, &fleet, NOW).await;
+
+    let fired_after = meta.fired_after();
+    assert!(
+        fleet.holds(0, moved),
+        "a {which} landing right after the build's first read of its two classes left the chunk \
+         in neither, and GC reclaimed a live upload's bytes (the handoff landed after reading \
+         {:?})",
+        fired_after.as_deref().map(String::from_utf8_lossy),
+    );
+    assert!(
+        !fleet.holds(1, control),
+        "the unrelated control was not reclaimed"
+    );
+    assert_eq!(outcome, Reconciled::Changed);
+    // Not vacuous: the handoff landed during the pass, moving the fact from source to destination.
+    assert!(
+        fired_after.is_some(),
+        "no read of the pass could observe the {which}, so it never landed"
+    );
+    assert!(
+        meta.value(&source).is_none() && meta.value(&destination).is_some(),
+        "the {which} did not move its record"
+    );
+}
+
+#[tokio::test]
+async fn c1_a_part_commit_landing_mid_build_never_leaves_the_chunk_in_neither_class() {
+    guard();
+    let meta = Meta::default();
+    let u = upload("c1");
+    seed_session(&meta, &u);
+    let owned = seed_owned(&meta, &u, 1, MOVED_CHUNK, NONE, &[0]);
+    let part = part_key(&u, part_number(1));
+    let committed = part_value(&[chunk_json(MOVED_CHUNK, NONE, 5, &[0])], 5);
+    // The part commit: ONE batch deletes the chunk's `sidx:` entry and writes its `part:` record.
+    let handoff = Handoff {
+        source: owned.clone(),
+        destination: part.clone(),
+        batch: WriteBatch::new().delete(owned).put(part, committed),
+    };
+    gc_across_a_handoff(meta, Fleet::new(), handoff, "part commit").await;
+}
+
+#[tokio::test]
+async fn c2_a_publication_landing_mid_build_never_leaves_the_chunk_in_neither_class() {
+    guard();
+    let meta = Meta::default();
+    let u = upload("c2");
+    seed_session(&meta, &u);
+    let part = seed_part(&meta, &u, 1, &[chunk_json(MOVED_CHUNK, NONE, 5, &[0])], 5);
+    let inode = inode_key(PUBLISHED_INODE);
+    // The publication: ONE batch writes the committed inode naming the chunk and removes the
+    // `part:` record that named it until then.
+    let handoff = Handoff {
+        source: part.clone(),
+        destination: inode.clone(),
+        batch: WriteBatch::new()
+            .put(inode, published(MOVED_CHUNK, 0))
+            .delete(part),
+    };
+    gc_across_a_handoff(meta, Fleet::new(), handoff, "publication").await;
+}
+
+// ---- D: bounded per-session reads ----
+
+/// The lowered cap: on one `scan`'s answer and on one `scan_page` page.
+const CAP: usize = 8;
+/// More sessions-with-parts than a global `scan("part:")` could return under [`CAP`]: 5 sessions
+/// with 2 committed parts and 2 owned entries each put 10 records under each of `part:` and
+/// `sidx:`, while `mpu:` itself (5) and every session's own two ranges (2 each) fit.
+const SESSIONS: [&str; 5] = ["d1", "d2", "d3", "d4", "d5"];
+const PARTS: u32 = 2;
+const OWNED: u32 = 2;
+
+/// Whether a read of `prefix` reaches keys under `namespace`: a prefix of it, or a narrowing of it.
+fn reaches(prefix: &[u8], namespace: &[u8]) -> bool {
+    namespace.starts_with(prefix) || prefix.starts_with(namespace)
+}
+
+#[tokio::test]
+async fn d_the_staged_build_reads_part_and_sidx_through_per_session_ranges_only() {
+    guard();
+    let meta = Meta::with_cap(CAP);
+    let fleet = Fleet::new();
+    let mut protected = Vec::new();
+    let mut ranges = HashSet::new();
+    for (s, pair) in SESSIONS.iter().enumerate() {
+        let u = upload(pair);
+        seed_session(&meta, &u);
+        ranges.insert(part_range(&u));
+        ranges.insert(sidx_range(&u));
+        let dserver = (s % 4) as DServerId;
+        for n in 1..=PARTS {
+            let chunk = 0xD000 + (s as ChunkId) * 0x10 + ChunkId::from(n);
+            seed_part(&meta, &u, n, &[chunk_json(chunk, NONE, 5, &[dserver])], 5);
+            protected.push((dserver, frag(chunk, 0)));
+        }
+        for n in PARTS + 1..=PARTS + OWNED {
+            let chunk = 0xD000 + (s as ChunkId) * 0x10 + ChunkId::from(n);
+            seed_owned(&meta, &u, n, chunk, NONE, &[dserver]);
+            protected.push((dserver, frag(chunk, 0)));
+        }
+    }
+    let control = (2, frag(0xDFFF, 0));
+    for &(dserver, frag) in protected.iter().chain([&control]) {
+        fleet.put(dserver, frag);
+        mark(&meta, dserver, frag, 0).await;
+    }
+
+    // Succeeds: a global `scan("part:")` or `scan("sidx:")` here would fail whole past the cap.
+    let (outcome, _) = gc_pass(&meta, &fleet, NOW).await;
+
+    for &(dserver, frag) in &protected {
+        assert!(
+            fleet.holds(dserver, frag),
+            "{frag:?} on server {dserver} was reclaimed — a staged record of one of {} sessions \
+             names it",
+            SESSIONS.len()
+        );
+    }
+    assert!(!fleet.holds(control.0, control.1), "the control survived");
+    assert_eq!(outcome, Reconciled::Changed);
+    for prefix in meta.reads() {
+        if reaches(&prefix, PART_PREFIX) || reaches(&prefix, SIDX_PREFIX) {
+            assert!(
+                ranges.contains(&prefix),
+                "the pass read {:?}, which is not one session's own `part:` or `sidx:` range — as \
+                 one `scan` that read fails whole past the cap once enough sessions hold staged \
+                 records, and paged it is no longer bounded by any one session's caps",
+                String::from_utf8_lossy(&prefix)
+            );
+        }
+    }
+}
+
+// ---- E(i): a staged record the build cannot read blocks both passes and is named ----
+
+/// A fragment of a chunk no record names — held back from both passes while the set is
+/// incomplete, and the observable that says so.
+const STRAY: ChunkId = 0xE0;
+
+/// With `record` unreadable in `meta`: the post-restore pass marks nothing — not even a genuine
+/// stray — names the record in `RestoreReport::unresolvable` and on its audit seam; then, with the
+/// stray marked past grace, a GC pass reclaims nothing, answers `Blocked`, and names the record.
+async fn assert_blocks_both_passes(meta: Meta, record: &[u8]) {
+    let fleet = Fleet::new();
+    let stray = frag(STRAY, 0);
+    fleet.put(1, stray);
+    let name = String::from_utf8(record.to_vec()).expect("an ASCII key");
+
+    let (report, audit) = restore_pass(&meta, &fleet, NOW).await;
+    assert!(
+        !is_marked(&meta, 1, stray) && report.stranded_marked == 0,
+        "the post-restore pass marked a fragment while the staged record {name} was unreadable — \
+         it may be one of the chunks that record protects: {report:?}"
+    );
+    assert!(
+        report.unresolvable.contains(&name),
+        "the unreadable staged record {name} is not named in the report: {report:?}"
+    );
+    assert!(report.needs_human(), "{report:?}");
+    assert!(
+        audit_names(&audit, RESTORE_AUDIT, record),
+        "the restore audit seam does not name {name}:\n{audit}"
+    );
+
+    mark(&meta, 1, stray, 0).await;
+    let (outcome, audit) = gc_pass(&meta, &fleet, NOW).await;
+    assert!(
+        fleet.holds(1, stray),
+        "GC reclaimed a fragment while the staged record {name} was unreadable"
+    );
+    assert_eq!(
+        outcome,
+        Reconciled::Blocked,
+        "GC certified a pass over a reference set with a hole in it ({name})"
+    );
+    assert!(
+        audit_names(&audit, GC_AUDIT, record),
+        "the GC audit seam does not name {name}:\n{audit}"
+    );
+}
+
+#[tokio::test]
+async fn e1_a_part_value_that_will_not_decode_blocks_gc_and_restore() {
+    guard();
