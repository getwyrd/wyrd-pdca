+    /// Read one committed `part:` record. Its **value** names every chunk it protects, so a
+    /// value that will not decode hides them all — a hole in the set. Nothing here needs the
+    /// key's part number, so the key is never parsed: it is only the record's name.
+    fn add_part(&mut self, key: Vec<u8>, value: &[u8]) {
