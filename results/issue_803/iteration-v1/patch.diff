+// ---- E(ii): a staged record the build cannot trust holds its whole chunk in both passes ----
+
+/// The chunk each untrusted record names, `rs(2,1)`: its three fragments on servers 0, 1 and 2,
+/// and a copy of fragment 0 on server 3, a server no placement names.
+const HELD: ChunkId = 0xE5;
+/// An unrelated fragment on server 1, unmarked: the passes must still judge it.
+const JUDGED: ChunkId = 0xE6;
+
+fn held_fragments() -> [(DServerId, FragmentId); 4] {
+    [
+        (0, frag(HELD, 0)),
+        (1, frag(HELD, 1)),
+        (2, frag(HELD, 2)),
+        (3, frag(HELD, 0)),
+    ]
+}
+
+/// With `record` naming [`HELD`] untrustworthily: the post-restore pass marks no fragment bearing
+/// its id, marks the unrelated stray, and names the record on its audit seam; then, with every
+/// held fragment marked past grace, a GC pass keeps them all, reclaims the stray, and names the
+/// record on its own seam. Neither pass is blocked by it.
+async fn assert_holds_its_chunk(meta: Meta, record: &[u8]) {
+    let fleet = Fleet::new();
+    let judged = (1, frag(JUDGED, 0));
+    for (dserver, frag) in held_fragments().into_iter().chain([judged]) {
+        fleet.put(dserver, frag);
+    }
+    let name = String::from_utf8(record.to_vec()).expect("an ASCII key");
+
+    let (report, audit) = restore_pass(&meta, &fleet, NOW).await;
+    for (dserver, frag) in held_fragments() {
+        assert!(
+            !is_marked(&meta, dserver, frag),
+            "the post-restore pass marked {frag:?} on server {dserver} though {name} names its \
+             chunk — a record it cannot trust must hold every fragment of that chunk"
+        );
+    }
+    assert!(
+        is_marked(&meta, judged.0, judged.1) && report.stranded_marked == 1,
+        "an untrusted staged record must hold its own chunk, not the fleet: the unrelated stray \
+         is still judged and marked ({name}): {report:?}"
+    );
+    assert!(report.unresolvable.is_empty(), "{report:?}");
+    assert!(
+        audit_names(&audit, RESTORE_AUDIT, record),
+        "the restore audit seam does not name {name}:\n{audit}"
+    );
+
+    for (dserver, frag) in held_fragments() {
+        mark(&meta, dserver, frag, 0).await;
+    }
+    let (outcome, audit) = gc_pass(&meta, &fleet, AFTER_GRACE).await;
+    for (dserver, frag) in held_fragments() {
+        assert!(
+            fleet.holds(dserver, frag),
+            "GC reclaimed {frag:?} on server {dserver} though {name} names its chunk"
+        );
+    }
+    assert!(
+        !fleet.holds(judged.0, judged.1),
+        "the unrelated stray, marked by the restore, was not reclaimed past its grace ({name})"
+    );
+    assert_eq!(outcome, Reconciled::Changed);
+    assert!(
+        audit_names(&audit, GC_AUDIT, record),
+        "the GC audit seam does not name {name}:\n{audit}"
+    );
+}
+
+#[tokio::test]
+async fn e2_a_part_placement_of_the_wrong_length_holds_its_chunk_in_both_passes() {
+    guard();
+    let meta = Meta::default();
+    let u = upload("e5");
+    seed_session(&meta, &u);
+    // Two D servers for `rs(2,1)`'s three fragments — it decodes (placement length is no decode
+    // invariant), and a maintenance pass may not guess the third.
+    let key = seed_part(&meta, &u, 1, &[chunk_json(HELD, RS_2_1, 10, &[0, 1])], 10);
+    assert_holds_its_chunk(meta, &key).await;
+}
+
+#[tokio::test]
+async fn e2_an_owned_placement_of_the_wrong_length_holds_its_chunk_in_both_passes() {
+    guard();
+    let meta = Meta::default();
+    let u = upload("e6");
+    seed_session(&meta, &u);
+    // An EMPTY planned placement: a committed record's pre-M3 spelling, but a staged record is
+    // born full-length, so here it names no D server for any of the three fragments.
+    let key = seed_owned(&meta, &u, 1, HELD, RS_2_1, &[]);
+    assert_holds_its_chunk(meta, &key).await;
+}
+
+#[tokio::test]
+async fn e2_an_undecodable_owned_value_under_a_key_naming_its_chunk_holds_it_in_both_passes() {
+    guard();
+    let meta = Meta::default();
+    let u = upload("e7");
+    seed_session(&meta, &u);
+    // The key names its chunk; the value will not decode, so where its fragments sit is unknown.
+    let key = sidx_key(&u, part_number(1), HELD);
+    let value = b"these bytes are not an owned entry";
+    assert!(decode_owned_entry(&key, value).is_err());
+    meta.seed(key.clone(), Bytes::from_static(value));
+    assert_holds_its_chunk(meta, &key).await;
+}
