+impl StagedSet {
+    /// Read one owned `sidx:` entry. Its **key** is what names the chunk — the value carries
+    /// only the planned placement — so the key is read first: one that names no chunk hides
+    /// what the entry protects, a hole in the set. Once the key has named its chunk, a value
+    /// that will not decode is a hold on that chunk rather than a hole: which bytes are at
+    /// stake is known, only where they sit is not.
+    fn add_owned(&mut self, key: Vec<u8>, value: &[u8]) {
+        let chunk = match parse_sidx_key(&key) {
+            Ok((_, _, chunk)) => chunk,
+            Err(fault) => {
+                self.unresolvable.insert(key, fault.to_string());
+                return;
+            }
+        };
+        match decode_owned_entry(&key, value) {
+            Ok((_, _, entry)) => {
+                // The planned placement, read as the chunk ref it will commit as. `len` is not
+                // known at intent time, and nothing below reads it.
+                let planned = ChunkRef {
+                    id: chunk,
+                    scheme: entry.staged().scheme(),
+                    len: 0,
+                    placement: entry.staged().placement().to_vec(),
+                };
+                self.add_chunk(&key, &planned);
+            }
+            Err(fault) => self.hold(chunk, key, fault.to_string()),
+        }
+    }
