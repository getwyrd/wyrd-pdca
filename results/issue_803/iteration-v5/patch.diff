+            cap,
+            reads: Mutex::new(Vec::new()),
+            faults: Mutex::new(Vec::new()),
+            hooks: Mutex::new(Vec::new()),
+        }
+    }
+
+    /// Put a fixture record in place — not a read, and not a pass's write.
