+        self.faults.lock().unwrap().push(range.to_vec());
+    }
+
+    fn heal(&self) {
+        self.faults.lock().unwrap().clear();
+    }
+
+    /// Commit `batch` right after the `fire_after`-th completed read of any of `triggers`.
