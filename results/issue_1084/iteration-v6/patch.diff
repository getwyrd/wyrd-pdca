+const BLOCKED_LEVEL: &str = "gauge.reconstruction_repair_blocked";
+/// The fleet with [`SOURCE`] lost and [`FREE`] down: no free domain is left for a repair.
+const SURVIVORS: [DServerId; 2] = [3, 4];
