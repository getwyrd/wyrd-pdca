+const COMMITTED_AT: u64 = 1_500;
+const RS21: EcScheme = EcScheme::ReedSolomon { k: 2, m: 1 };
+/// The swap leg's scheme.
+const RS22: EcScheme = EcScheme::ReedSolomon { k: 2, m: 2 };
