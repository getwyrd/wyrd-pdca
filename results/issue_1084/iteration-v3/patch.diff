+const W_REPOINT: u64 = 10_000;
+const _: () = assert!(W_REPOINT == W_REPOINT_MILLIS);
+// A clock moved past the grace is past `W_repoint` and the write window too.
+const _: () = assert!(GRACE > W_REPOINT + W_WRITE_MILLIS);
