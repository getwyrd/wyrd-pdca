diff --git a/crates/dst/tests/custodian.rs b/crates/dst/tests/custodian.rs
index 92567a3..3751687 100644
--- a/crates/dst/tests/custodian.rs
+++ b/crates/dst/tests/custodian.rs
@@ -5900,6 +5900,298 @@ async fn prop_restore_fence_reaches_the_contested_window() {
