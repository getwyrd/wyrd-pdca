+// ===========================================================================
+// 5. The record envelope — the shared codec every record class routes through
+//    (`0016` §1). The class-specific relational checks live on each class's own
+//    `Deserialize` (ADR-0045, parse-don't-validate).
+// ===========================================================================
+
+/// Encode a multipart record to its stored bytes — the same infallible JSON encoding every
+/// record in [`crate::metadata`] uses (`metadata.rs:1536-1538`). This is the **canonical**
+/// spelling of a record: [`decode_record`] admits no other.
+pub fn encode_record<T: Serialize>(record: &T) -> Vec<u8> {
+    serde_json::to_vec(record).expect("multipart record serialization is infallible")
+}
+
+/// Decode one record class's stored bytes, turning a serde failure — including every
+/// validating-decode rejection below — into a typed [`RecordError`] (ADR-0045).
+///
+/// **One spelling per record, enforced by re-encoding.** A decoded value is accepted only if
+/// `encode_record(value)` reproduces the input bytes exactly. This is the value-side of the
+/// canonicality rule this module's own doc states for keys (two spellings of one record are
+/// residue nothing enumerates, C-1): every record class here is mutated by a whole-record
+/// compare-and-swap — `require(mpuctl == prior)` for the admission ledger (`0016:348`), whose
+/// precondition bytes are `encode(prior)`, as `metadata.rs:1766` builds them for every CAS in
+/// that module. A record stored with reordered fields, inserted
+/// whitespace or a dropped-on-decode extra field would decode to a value whose re-encoding
+/// is *different bytes*, so every CAS against it would fail its precondition forever — the
+/// admission ledger silently wedged, with no error anywhere. Refusing the second spelling at
+/// decode turns that into one typed error at the read that meets it.
+fn decode_record<T: DeserializeOwned + Serialize>(
+    record: &'static str,
+    bytes: &[u8],
+) -> Result<T, RecordError> {
+    let value: T =
+        serde_json::from_slice(bytes).map_err(|error| structural(record, error.to_string()))?;
+    if encode_record(&value) != bytes {
+        return Err(structural(
+            record,
+            "non-canonical encoding: a record is stored in exactly the bytes \
+             `encode_record` emits, or a whole-record CAS against it could never match",
+        ));
+    }
+    Ok(value)
+}
