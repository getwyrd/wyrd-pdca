+// ===========================================================================
+// 5. The record envelope (`0016` §1) — the one codec every record class in this module
+//    routes through, and the shape later record children extend with their own decode
+//    arm. Class-specific **relational** checks live on each class's own `Deserialize`
+//    (ADR-0045), never here.
+// ===========================================================================
+
+/// Encode a multipart record to its stored bytes — the same JSON every record in
+/// [`crate::metadata`] is stored as (`metadata.rs:1536-1538`), and infallible for the same
+/// reason: every field of every record this module defines is already-validated data, never
+/// a type serde could refuse mid-encode.
+pub fn encode_record<T: Serialize>(record: &T) -> Vec<u8> {
+    serde_json::to_vec(record).expect("multipart record serialization is infallible")
+}
+
+/// Decode one record class's stored JSON, turning **every** serde failure — a truncated
+/// value, an unknown field, and every relational rejection a class's own `Deserialize`
+/// raises — into a typed [`RecordError::Structural`] tagged with the record's name, so a
+/// caller classifies a torn record without learning serde's error shape (ADR-0045; the
+/// typed-error demand of `0016:390-402`).
+///
+/// Later record children add their own arm the way [`decode_admission_record`] does: a thin
+/// wrapper naming the class, never a second codec.
+pub fn decode_record<T: serde::de::DeserializeOwned>(
+    record: &'static str,
+    bytes: &[u8],
+) -> Result<T, RecordError> {
+    serde_json::from_slice(bytes).map_err(|error| structural(record, error.to_string()))
+}
