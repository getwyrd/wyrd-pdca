+// ===========================================================================
+// 6. The admission ledger — the `mpuctl` value (`0016:348`) and the `Budget` profile
+//    tuple it stores (`0016:1463-1480`)
+// ===========================================================================
+
+/// Half of [`wyrd_traits::SCAN_CAP`] — the bound `0016:1470` clamps the reaper's one
+/// `scan("mpu:")` to, and `0016:1476` clamps a session's staging range to. `SCAN_CAP` is a
+/// **compile-time store-seam constant** (`crates/traits/src/lib.rs:286`), fleet-wide by
+/// construction ("backends of the same trait must not disagree about how large a listing may
+/// be"), so it is of the same class as the format bounds decode may check against — never a
+/// deployment knob a rolling configuration change can lower under a stored record
+/// (`0016:390-402`).
+pub const SCAN_HALF: u64 = (wyrd_traits::SCAN_CAP / 2) as u64;
+
+/// Half the value ceiling every backend inherits (`metadata.rs:327`) — the `V / 2` every
+/// chunk-count rule in `0016`'s knob table is written against (`0016:1466-1467`). The other
+/// half is the reserve `metadata.rs:329-352` documents.
+pub const VALUE_CEILING_HALF: usize = metadata::MAX_VALUE_BYTES / 2;
+
+/// The **smallest** number of bytes one [`crate::metadata::ChunkRef`] can occupy in a stored
+/// value: `{"id":0,"scheme":"None","len":0,"placement":[]}` — every field at its narrowest
+/// spelling, the `None` scheme (the shortest of the two) and an empty placement
+/// (`metadata.rs:128-140`).
+///
+/// **Why the minimum and not `0016`'s `b_ref = 131–302 B`** (`0016:1053`, `:2844`). Those are
+/// *deployment-calibrated* widths — a real 128-bit chunk id, a real EC scheme, a real
+/// placement vector — and they are what #508 sizes its knob **values** against. A bound
+/// **decode** enforces has the opposite job: it must admit every record any legal
+/// configuration could have written (`0016:390-402`, "every record ever written under a legal
+/// configuration stays decodable under every later one"), so it is derived from the width the
+/// encoding can reach at its *narrowest*. A chunk count past `V / 2` divided by this width
+/// fits in no value under **any** configuration — that is a property of the format, not of a
+/// knob, which is exactly what decode may check.
+///
+/// Measured against the real encoder, not asserted in prose:
+/// `crates/core/tests/multipart_budget_admission.rs` encodes that witness through
+/// `metadata::encode` and requires this constant to equal it, and requires every wider
+/// spelling (a larger id, a larger length, a Reed-Solomon scheme, a non-empty placement) to
+/// encode strictly larger — so a field added to `ChunkRef` breaks the test rather than
+/// silently invalidating both ceilings below.
+pub const MIN_CHUNKREF_BYTES: usize = 47;
+
+/// The **smallest** number of bytes one [`crate::metadata::SegmentRef`] can occupy in a
+/// stored root: `{"index":0,"byte_offset":0,"byte_len":0}` (`metadata.rs:812-822`). The
+/// minimum, for the reason [`MIN_CHUNKREF_BYTES`] gives, and measured the same way.
+pub const MIN_SEGREF_BYTES: usize = 40;
+
+/// The **format** maximum of `MAX_SEG_CHUNKS` — the most chunk-refs one `seg:` value can
+/// ever carry, `⌊(V / 2) / MIN_CHUNKREF_BYTES⌋` (`0016:1467`, the `MAX_SEG_CHUNKS` row: "same
+/// rule against a `seg:` record").
+///
+/// `MAX_SEG_CHUNKS` itself has **no** code definition on this base — only 0016's prose — and
+/// its *deployment* value stays #508's, calibrated against that deployment's own `b_ref`. This
+/// constant is the other thing `0016:390-402` asks for: the compile-time maximum of the
+/// **encoding**, which moves only when the record shape does.
+pub const MAX_SEG_CHUNKS_FORMAT_MAX: u32 = (VALUE_CEILING_HALF / MIN_CHUNKREF_BYTES) as u32;
+
+/// The **format** maximum of `MAX_PART_CHUNKS`. `0016:1466` states the rule as **identical**
+/// to `MAX_MAP_CHUNKS`' and `MAX_SEG_CHUNKS`' — "a `part:` record is one value" — so it is
+/// the same number, named separately because the two legs cite different rows and a later
+/// divergence should show up as an edit here rather than a silent aliasing.
+pub const MAX_PART_CHUNKS_FORMAT_MAX: u32 = MAX_SEG_CHUNKS_FORMAT_MAX;
+
+/// The **format** maximum of `MAX_ROOT_SEGMENTS` — the most segment-refs one root value can
+/// ever carry, `⌊MAX_ROOT_VALUE_BYTES / MIN_SEGREF_BYTES⌋` (`0016:1467`'s
+/// `max_segref_bytes × MAX_ROOT_SEGMENTS ≤ V / 2`, against the budget `metadata.rs:329-352`
+/// defines as exactly that half).
+///
+/// **Not** [`crate::metadata::MAX_ROOT_SEGMENTS`]: that constant is a *capacity* number this
+/// deployment chooses, and its own doc records why it is deliberately **not** a decode bound
+/// — "rejecting a stored record on a derived capacity constant would turn a durable object
+/// unreadable if the constant ever moved" (`metadata.rs:312-321`). `0016:390-402` names the
+/// same constant in the same role: "lowering `MAX_ROOT_SEGMENTS` would likewise make
+/// already-published roots unreadable". The const assertion below keeps the deployment number
+/// inside this format maximum, so the two can never drift apart unnoticed.
+pub const MAX_ROOT_SEGMENTS_FORMAT_MAX: u32 =
+    (metadata::MAX_ROOT_VALUE_BYTES / MIN_SEGREF_BYTES) as u32;
+
+/// The **publishable ceiling** in format terms: the most chunk-refs one completed object can
+/// ever name, `MAX_ROOT_SEGMENTS_FORMAT_MAX × MAX_SEG_CHUNKS_FORMAT_MAX` — the upper end of
+/// `MAX_STAGED_CHUNKS`' settled range (`0016:1472`), read at the format maxima decode is
+/// entitled to (`0016:390-402`) rather than at the deployment's own two knobs.
+pub const MAX_PUBLISHABLE_CHUNKS_FORMAT_MAX: u64 =
+    MAX_ROOT_SEGMENTS_FORMAT_MAX as u64 * MAX_SEG_CHUNKS_FORMAT_MAX as u64;
+
+// Each format maximum satisfies the value-ceiling rule it was derived from, and is the
+// LARGEST count that does — so it is the format's own maximum, not a rounding of one.
+const _: () =
+    assert!(MAX_SEG_CHUNKS_FORMAT_MAX as usize * MIN_CHUNKREF_BYTES <= VALUE_CEILING_HALF);
+const _: () =
+    assert!((MAX_SEG_CHUNKS_FORMAT_MAX as usize + 1) * MIN_CHUNKREF_BYTES > VALUE_CEILING_HALF);
+const _: () = assert!(
+    MAX_ROOT_SEGMENTS_FORMAT_MAX as usize * MIN_SEGREF_BYTES <= metadata::MAX_ROOT_VALUE_BYTES
+);
+const _: () = assert!(
+    (MAX_ROOT_SEGMENTS_FORMAT_MAX as usize + 1) * MIN_SEGREF_BYTES > metadata::MAX_ROOT_VALUE_BYTES
+);
+// The deployment's capacity number stays inside the format's — the tie `0016:1467` implies
+// and `metadata.rs:312-321` depends on (a capacity guard above the format maximum would
+// promise a table no value could hold).
+const _: () = assert!(metadata::MAX_ROOT_SEGMENTS <= MAX_ROOT_SEGMENTS_FORMAT_MAX as usize);
+// A root may name no more segments than the `seg:` key space can address, whatever the value
+// ceiling allows (`metadata.rs:275-286`).
+const _: () =
+    assert!(MAX_ROOT_SEGMENTS_FORMAT_MAX as u64 <= metadata::MAX_SEGMENT_INDEX as u64 + 1);
+
+/// `U_ref` over a **raw** tuple, exact and in `u128` (`0016:1469`):
+///
+/// ```text
+/// U_ref = min( (MAX_PARTS_PER_SESSION + MAX_INFLIGHT_PARTS) x MAX_PART_CHUNKS,
+///              MAX_STAGED_CHUNKS + 2 x MAX_INFLIGHT_PARTS x MAX_PART_CHUNKS )
+/// ```
+///
+/// The first term is the raw part-number space; the second is the enforced staged ceiling
+/// **plus** the bounded commit overshoot **plus** the in-flight owned entries (the same term
+/// twice, by construction). Whichever binds first is the worst legal per-session footprint.
+///
+/// **Exact, never saturating.** The operands are `u32`s, so either product can exceed `u64`
+/// — and a *saturated* `U_ref` is not a fail-closed approximation but a false one: at
+/// `W_ref = u64::MAX` a saturating `U_ref = u64::MAX` derives `⌊W_ref/U_ref⌋ = 1` and admits
+/// a session whose true worst-case footprint is larger than the whole budget. In `u128` the
+/// comparison `W_ref < U_ref` is the mathematical one, so [`Budget::new`] refuses that tuple
+/// outright and no `Budget` can derive a limit its own arithmetic overflowed.
+fn u_ref_of(
+    max_part_chunks: u32,
+    max_parts_per_session: u32,
+    max_inflight_parts: u32,
+    max_staged_chunks: u32,
+) -> u128 {
+    let part_chunks = u128::from(max_part_chunks);
+    let inflight = u128::from(max_inflight_parts);
+    let raw = (u128::from(max_parts_per_session) + inflight) * part_chunks;
+    let ceiling = u128::from(max_staged_chunks) + 2 * inflight * part_chunks;
+    raw.min(ceiling)
+}
+
+/// The budget **profile** tuple `mpuctl` stores and every admitter and custodian compares
+/// whole (`0016:348`, the knob table `:1463-1480`). This slice owns the **shape**, the valid
+/// **ranges** 0016 settles for it, and the two pure derivations below; the deployment's own
+/// values are #655's — the same format/capacity split `metadata.rs:270-322` already draws.
+///
+/// The fields are **private** behind [`Budget::new`] because the derivations are safety
+/// arithmetic: a tuple with a zero component derives a `U_ref` of zero, and `MAX_SESSIONS`
+/// would then be a division by zero rather than a limit. A profile that violates its own
+/// ranges is therefore not merely refused at decode — it is unrepresentable
+/// (parse-don't-validate, ADR-0045
+/// `docs/design/adr/0045-metadata-validation-boundaries.md:42-49`), so no caller can
+/// construct one and hand it to [`encode_record`].
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize)]
+pub struct Budget {
+    w_ref: u64,
+    max_part_chunks: u32,
+    max_parts_per_session: u32,
+    max_inflight_parts: u32,
+    max_staged_chunks: u32,
+}
+
+impl Budget {
+    /// The validating constructor — the **only** way to obtain a profile, and the one place
+    /// 0016's valid ranges for the tuple are enforced (`0016:1463-1480`). Only a knob whose
+    /// *entire* range is safe is an implementer's freely; a knob a safety property depends on
+    /// has its range settled by the proposal, so a profile outside those ranges is refused
+    /// here rather than persisted and enforced fleet-wide.
+    ///
+    /// Every rule below is a relation **among the tuple's own components** or against a
+    /// **format** constant of the encoding — never against a live deployment knob, which
+    /// `0016:390-402` puts at admission (the slot reserve, the part commit, the Complete
+    /// fence), never at decode:
+    ///
+    /// * every component non-zero — a zero derives a `U_ref` of zero and turns `MAX_SESSIONS`
+    ///   into a division by zero rather than a limit;
+    /// * `MIN_CHUNKREF_BYTES × MAX_PART_CHUNKS ≤ V / 2` (`0016:1466`, the value-ceiling rule)
+    ///   — i.e. `MAX_PART_CHUNKS ≤ MAX_PART_CHUNKS_FORMAT_MAX`: past it a maximal `part:`
+    ///   record fits in no value under any configuration, so the commit that writes it could
+    ///   never succeed;
+    /// * `MAX_PARTS_PER_SESSION ≤ MAX_PART_NUMBER` (`multipart.rs:271-277`) — the knob may
+    ///   not promise a part-number space the key grammar cannot address;
+    /// * `MAX_INFLIGHT_PARTS ≤ MAX_PARTS_PER_SESSION` (`0016:1476`, iteration-13 finding 2):
+    ///   a session cannot have more parts in flight than it may ever hold, and the
+    ///   `MAX_OWNED_FLEET ≤ W_ref / 2` derivation silently assumes it;
+    /// * `MAX_STAGED_CHUNKS ≥ MAX_PART_CHUNKS` (`0016:1472`, the range's lower end): at least
+    ///   one maximal part must remain stageable, or the staged ceiling refuses the very first
+    ///   part every session must be able to commit;
+    /// * `MAX_STAGED_CHUNKS ≤ min(MAX_PUBLISHABLE_CHUNKS_FORMAT_MAX,
+    ///   MAX_PARTS_PER_SESSION × MAX_PART_CHUNKS)` (`0016:1472`, the range's upper end): a
+    ///   session may not be allowed to stage more than it could publish — read at the
+    ///   **format** ceiling — nor more than **its own** part-number space could ever produce,
+    ///   which is a relation between two stored fields and the tighter of the two by far on
+    ///   today's constants (see [`Budget::staged_upper_bound`]);
+    /// * `MAX_STAGED_CHUNKS + MAX_INFLIGHT_PARTS × MAX_PART_CHUNKS ≤ SCAN_CAP / 2`
+    ///   (`0016:1476`'s bounding invariant, widened by #692's batch review): the per-session
+    ///   staging scan the teardown path must walk empty covers the committed staging entries
+    ///   as well as the in-flight ones, and a profile whose sum exceeds the cap makes that one
+    ///   scan fail — leaving an abandoned session that can never be torn down;
+    /// * `W_ref ≥ U_ref` (`0016:1479`, the range `[U_ref, deployment RAM budget]`): a budget
+    ///   below one session's worst-case footprint derives `MAX_SESSIONS = 0`, so no session
+    ///   could ever be admitted.
+    ///
+    /// The clamps 0016 states for `MAX_INFLIGHT_PARTS` that are **not** checkable here —
+    /// `⌊(E_tx/2) / (bytes per slot key)⌋` and `B_ops` — are backend **envelope** quantities
+    /// this tuple does not carry: `B_ops` is calibrated per backend and owned by #625
+    /// (`0016:1475`, `:1487`), so by `0016:390-402` it is not a format constant and does not
+    /// belong at decode. They are enforced where work is admitted (#508's, #625's).
+    pub fn new(
+        w_ref: u64,
+        max_part_chunks: u32,
+        max_parts_per_session: u32,
+        max_inflight_parts: u32,
+        max_staged_chunks: u32,
+    ) -> Result<Self, RecordError> {
+        let invalid = |reason: String| Err(structural("mpuctl", reason));
+        for (is_zero, field) in [
+            (w_ref == 0, "w_ref"),
+            (max_part_chunks == 0, "max_part_chunks"),
+            (max_parts_per_session == 0, "max_parts_per_session"),
+            (max_inflight_parts == 0, "max_inflight_parts"),
+            (max_staged_chunks == 0, "max_staged_chunks"),
+        ] {
+            if is_zero {
+                return invalid(format!(
+                    "`{field}` is zero: no configuration admits a session under it"
+                ));
+            }
+        }
+        if max_part_chunks > MAX_PART_CHUNKS_FORMAT_MAX {
+            return invalid(format!(
+                "max_part_chunks={max_part_chunks} exceeds the value-ceiling format maximum \
+                 {MAX_PART_CHUNKS_FORMAT_MAX} (MIN_CHUNKREF_BYTES={MIN_CHUNKREF_BYTES} x N <= \
+                 {VALUE_CEILING_HALF}): a maximal `part:` record would fit in no value \
+                 (`0016:1466`)"
+            ));
+        }
+        if max_parts_per_session > MAX_PART_NUMBER {
+            return invalid(format!(
+                "max_parts_per_session={max_parts_per_session} exceeds the part-number key \
+                 space [1, {MAX_PART_NUMBER}]: it would promise `part:` records the key \
+                 grammar cannot address"
+            ));
+        }
+        if max_inflight_parts > max_parts_per_session {
+            return invalid(format!(
+                "max_inflight_parts={max_inflight_parts} exceeds \
+                 max_parts_per_session={max_parts_per_session}: a session cannot have more \
+                 parts in flight than it may ever hold (`0016:1476`)"
+            ));
+        }
+        if max_staged_chunks < max_part_chunks {
+            return invalid(format!(
+                "max_staged_chunks={max_staged_chunks} is below \
+                 max_part_chunks={max_part_chunks}: at least one maximal part must remain \
+                 stageable (`0016:1472`)"
+            ));
+        }
+        let staged_upper = Self::staged_upper_bound(max_part_chunks, max_parts_per_session);
+        if u128::from(max_staged_chunks) > staged_upper {
+            return invalid(format!(
+                "max_staged_chunks={max_staged_chunks} exceeds the publishable ceiling \
+                 {staged_upper}: a session may stage no more than it could publish \
+                 (`0016:1472`)"
+            ));
+        }
+        let staging_scan_charge = u128::from(max_staged_chunks)
+            + u128::from(max_inflight_parts) * u128::from(max_part_chunks);
+        if staging_scan_charge > u128::from(SCAN_HALF) {
+            return invalid(format!(
+                "max_staged_chunks + max_inflight_parts x max_part_chunks = \
+                 {staging_scan_charge} exceeds the per-session staging scan bound \
+                 {SCAN_HALF} (SCAN_CAP/2): the teardown scan could not walk the range empty \
+                 (`0016:1476`)"
+            ));
+        }
+        let u_ref = u_ref_of(
+            max_part_chunks,
+            max_parts_per_session,
+            max_inflight_parts,
+            max_staged_chunks,
+        );
+        if u128::from(w_ref) < u_ref {
+            return invalid(format!(
+                "w_ref={w_ref} is below the U_ref={u_ref} its own caps derive: the budget \
+                 must hold at least one session's worst-case footprint (`0016:1479`)"
+            ));
+        }
+        Ok(Self {
+            w_ref,
+            max_part_chunks,
+            max_parts_per_session,
+            max_inflight_parts,
+            max_staged_chunks,
+        })
+    }
+
+    /// The upper end of `MAX_STAGED_CHUNKS`' settled range (`0016:1472`), as the **two**
+    /// bounds a stored record can be judged against:
+    ///
+    /// * [`MAX_PUBLISHABLE_CHUNKS_FORMAT_MAX`] — the format's own publishable ceiling;
+    /// * `MAX_PARTS_PER_SESSION × MAX_PART_CHUNKS` — what **this** profile's own part-number
+    ///   space can produce. A session holds at most `MAX_PARTS_PER_SESSION` committed parts of
+    ///   at most `MAX_PART_CHUNKS` chunks each, so a larger staged ceiling is a field
+    ///   disagreeing with its own siblings: it names a state the profile forbids reaching.
+    ///
+    /// On today's constants the second term is the one that binds. The first is
+    /// `MAX_ROOT_SEGMENTS_FORMAT_MAX × MAX_SEG_CHUNKS_FORMAT_MAX = 1_250 × 1_063 = 1_328_750`,
+    /// while the staging-scan rule above independently holds `max_staged_chunks` below
+    /// `SCAN_CAP/2 = 524_288`; it is kept because it is the ceiling `0016:1472` names, it is
+    /// what ties `MAX_SEG_CHUNKS_FORMAT_MAX` to a stored field, and it binds again the moment
+    /// `SCAN_CAP` is raised. Real deployments sit far under both: 0016's settled pairing is
+    /// `10_000 × 165 = 1_650_000` of raw part space against an `84_480`-chunk publishable
+    /// ceiling (`0016:1472`).
+    fn staged_upper_bound(max_part_chunks: u32, max_parts_per_session: u32) -> u128 {
+        let own_part_space = u128::from(max_parts_per_session) * u128::from(max_part_chunks);
+        own_part_space.min(u128::from(MAX_PUBLISHABLE_CHUNKS_FORMAT_MAX))
+    }
+
+    /// The reconcile pass's staged-reference memory budget, in chunk-refs (`W_ref`).
+    pub const fn w_ref(&self) -> u64 {
+        self.w_ref
+    }
+
+    /// The per-`part:`-record chunk ceiling (`MAX_PART_CHUNKS`).
+    pub const fn max_part_chunks(&self) -> u32 {
+        self.max_part_chunks
+    }
+
+    /// The per-session part-number space (`MAX_PARTS_PER_SESSION`).
+    pub const fn max_parts_per_session(&self) -> u32 {
+        self.max_parts_per_session
+    }
+
+    /// The per-session in-flight part cap (`MAX_INFLIGHT_PARTS`).
+    pub const fn max_inflight_parts(&self) -> u32 {
+        self.max_inflight_parts
+    }
+
+    /// The per-session committed-staging ceiling (`MAX_STAGED_CHUNKS`).
+    pub const fn max_staged_chunks(&self) -> u32 {
+        self.max_staged_chunks
+    }
+
+    /// `U_ref` — the worst-case **per-session** staged-reference footprint, in chunk-refs
+    /// ([`u_ref_of`], `0016:1469`).
+    ///
+    /// The arithmetic is exact (`u128`) and [`Budget::new`] refuses a tuple whose `U_ref`
+    /// exceeds its own `w_ref`, so the value always fits the `u64` the budget is stated in;
+    /// the unreachable fallback charges the whole `u64` range to one session, the fail-closed
+    /// direction.
+    pub fn u_ref(&self) -> u64 {
+        let exact = u_ref_of(
+            self.max_part_chunks,
+            self.max_parts_per_session,
+            self.max_inflight_parts,
+            self.max_staged_chunks,
+        );
+        u64::try_from(exact).unwrap_or(u64::MAX)
+    }
+
+    /// `MAX_SESSIONS` — the fleet admission limit, `min( ⌊W_ref / U_ref⌋ , SCAN_CAP/2 )`,
+    /// **derived, never chosen** (`0016:1470`).
+    ///
+    /// **Both terms bind.** The quotient is the memory bound the reconcile pass is sized for;
+    /// the [`SCAN_HALF`] term is a clamp *the implementation applies*, not an operator range
+    /// check — `W_ref` is sized from host RAM and `U_ref` from the caps, so a legal pairing (a
+    /// large `W_ref` with small parts) makes `⌊W_ref/U_ref⌋` exceed `SCAN_CAP` and break the
+    /// reaper's one `scan("mpu:")` (`0016:1470`). A derivation that omits the clamp is wrong.
+    ///
+    /// [`Budget::new`] refuses a zero component, so `u_ref()` is at least 2 and the division
+    /// is total; it also refuses `W_ref < U_ref`, so the quotient is at least 1 — a `Budget`
+    /// that exists always admits at least one session.
+    pub fn max_sessions(&self) -> u64 {
+        let quotient = self.w_ref / self.u_ref();
+        quotient.min(SCAN_HALF)
+    }
+}
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct BudgetWire {
+    w_ref: u64,
+    max_part_chunks: u32,
+    max_parts_per_session: u32,
+    max_inflight_parts: u32,
+    max_staged_chunks: u32,
+}
+
+impl<'de> Deserialize<'de> for Budget {
+    fn deserialize<D: Deserializer<'de>>(deserializer: D) -> Result<Self, D::Error> {
+        let wire = BudgetWire::deserialize(deserializer)?;
+        Self::new(
+            wire.w_ref,
+            wire.max_part_chunks,
+            wire.max_parts_per_session,
+            wire.max_inflight_parts,
+            wire.max_staged_chunks,
+        )
+        .map_err(DeError::custom)
+    }
+}
+
+/// The `mpuctl` value: the fleet's **admission ledger**, one record with three fields
+/// (`0016:348`).
+///
+/// `count` is how many `mpu:` records exist in any state; `max_sessions` is the governing
+/// limit those increments were admitted against; `profile` is the [`Budget`] tuple that
+/// *establishes* it. All three live in one record and every mutation CASes it whole, so the
+/// count and the limit it was checked against can never be read apart — and the profile is
+/// stored rather than re-derived per gateway so a rolling configuration change cannot leave
+/// two gateways enforcing different bounds (`0016:348`).
+///
+/// **`max_sessions` is checked against the profile at decode**, because it is *derived*
+/// ([`Budget::max_sessions`], `0016:1470`) and never independently chosen. It is the
+/// record's own identity relation: a torn or rolled-back `mpuctl` naming a larger
+/// `max_sessions` than its own profile derives admits sessions past the memory bound the
+/// reconcile pass is sized for — a fleet-wide overrun let in by one unvalidated field. So the
+/// fields are private, `new` derives the limit rather than accepting one, and decode rejects a
+/// stored disagreement as [`RecordError::Structural`] (ADR-0045
+/// `docs/design/adr/0045-metadata-validation-boundaries.md:42-49`).
+///
+/// **`count` is deliberately NOT checked against `max_sessions`.** Occupancy above a lowered
+/// cap is a legitimate live state (0016 permits lowering a cap while live sessions still hold
+/// their slots), so a `count` above `max_sessions` still decodes — the liberal-on-read half of
+/// the same boundary (`0016:390-402`; `metadata.rs:312-321` draws it for `MAX_ROOT_SEGMENTS`).
+/// The line the class settles: two stored spellings of **one** quantity (`max_sessions` and
+/// what the profile derives) must agree; a live **occupancy** against a limit need not.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize)]
+pub struct AdmissionRecord {
+    count: u64,
+    max_sessions: u64,
+    profile: Budget,
+}
+
+impl AdmissionRecord {
+    /// The only constructor: `max_sessions` is **derived** from the profile, never supplied,
+    /// so a record whose stored limit disagrees with its own profile cannot be built — let
+    /// alone encoded (`0016:1470`).
+    pub fn new(count: u64, profile: Budget) -> Self {
+        Self {
+            count,
+            max_sessions: profile.max_sessions(),
+            profile,
+        }
+    }
+
+    /// How many `mpu:` records exist in any state.
+    pub const fn count(&self) -> u64 {
+        self.count
+    }
+
+    /// The governing admission limit those increments were admitted against.
+    pub const fn max_sessions(&self) -> u64 {
+        self.max_sessions
+    }
+
+    /// The budget tuple that establishes [`Self::max_sessions`].
+    pub const fn profile(&self) -> &Budget {
+        &self.profile
+    }
+}
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct AdmissionRecordWire {
+    count: u64,
+    max_sessions: u64,
+    profile: Budget,
+}
+
+impl<'de> Deserialize<'de> for AdmissionRecord {
+    fn deserialize<D: Deserializer<'de>>(deserializer: D) -> Result<Self, D::Error> {
+        let wire = AdmissionRecordWire::deserialize(deserializer)?;
+        let derived = wire.profile.max_sessions();
+        if wire.max_sessions != derived {
+            return Err(DeError::custom(format!(
+                "max_sessions={} disagrees with the {derived} its own profile derives \
+                 (W_ref={} / U_ref={}, clamped to SCAN_CAP/2={SCAN_HALF}): the stored limit \
+                 and the profile that establishes it are one quantity (`0016:1470`)",
+                wire.max_sessions,
+                wire.profile.w_ref(),
+                wire.profile.u_ref(),
+            )));
+        }
+        Ok(Self {
+            count: wire.count,
+            max_sessions: wire.max_sessions,
+            profile: wire.profile,
+        })
+    }
+}
+
+/// Decode the `mpuctl` value — this slice's arm of [`decode_record`].
+pub fn decode_admission_record(bytes: &[u8]) -> Result<AdmissionRecord, RecordError> {
+    decode_record("mpuctl", bytes)
+}
