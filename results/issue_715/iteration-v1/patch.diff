+// ===========================================================================
+// 6. The admission ledger — `mpuctl` (`0016:348`) — and the `Budget` profile tuple it
+//    stores (`0016:1463-1480`)
+// ===========================================================================
+
+/// Half of [`wyrd_traits::SCAN_CAP`] — the bound `0016:1470` clamps the reaper's one
+/// `scan("mpu:")` to, and `0016:1476` clamps a session's owned `sidx:<upload-id>:` range
+/// to. `SCAN_CAP` is a **compile-time store-seam constant** (`crates/traits/src/lib.rs:286`),
+/// of the same class as the format bounds decode checks against — never a deployment knob
+/// a rolling configuration change can lower under a stored record (`0016:390-402`).
+fn scan_half() -> u64 {
+    (wyrd_traits::SCAN_CAP / 2) as u64
+}
+
+/// A conservative **upper bound**, in bytes, on one `ChunkRef`'s JSON encoding — `0016`'s
+/// own `b_ref`, the divisor `MAX_MAP_CHUNKS`/`MAX_PART_CHUNKS` are computed against
+/// (`0016:1053`, `:1063`, `:1466`). `0016:2844` states the range this proposal itself
+/// computed across its supported EC schemes, `b_ref = 131-302 B`; this constant takes the
+/// **high** end, since a looser (larger) `b_ref` makes the value-ceiling check below
+/// *more* restrictive, never less — the safe direction for a FORMAT maximum decode
+/// enforces (`0016:390-402`; the same "a looser bound can only reject a shape that would
+/// have fit, never admit one that would not" rule
+/// `crates/core/tests/segmented_map_record.rs:521-524` states for `MAX_ROOT_SEGMENTS`'s
+/// own encoded-size bound). A **format** constant of the encoding — never a value #508 or
+/// any later slice may widen without moving this constant with it.
+pub const MAX_CHUNKREF_BYTES: usize = 302;
+
+/// Half the value ceiling every backend inherits (`crate::metadata::MAX_VALUE_BYTES`,
+/// `metadata.rs:327`) — the budget both `MAX_PART_CHUNKS` (`0016:1466`) and a segment
+/// table (`metadata.rs:329-331`, `0016:1467`) are sized against, with the 2x headroom
+/// `0016:1465-1467` requires throughout this value-ceiling family of rules.
+pub const VALUE_CEILING_HALF: usize = metadata::MAX_VALUE_BYTES / 2;
+
+/// The **format** maximum for a segment's chunk count — `0016`'s own `MAX_SEG_CHUNKS`
+/// (`0016:1465`, referenced again at `:1468`), which has **no** code definition on this
+/// base: it is only a prose cross-reference ("same rule against a `seg:` record"), never
+/// given a constant. [`Budget::new`]'s `max_staged_chunks` ceiling (`0016:1468`'s upper
+/// end, `MAX_ROOT_SEGMENTS × MAX_SEG_CHUNKS`) needs a *format* value to check against —
+/// the **deployment** `MAX_SEG_CHUNKS` value #508 eventually chooses stays that slice's,
+/// exactly as `MAX_PART_CHUNKS`'s own deployment value does — so this module defines the
+/// format ceiling here, by the **identical** value-ceiling rule `0016:1465` states
+/// (`max_chunkref_bytes × N ≤ MAX_VALUE_BYTES / 2`), tied to [`MAX_CHUNKREF_BYTES`] by the
+/// `const` assertion immediately below.
+pub const MAX_SEG_CHUNKS_FORMAT_MAX: u32 = (VALUE_CEILING_HALF / MAX_CHUNKREF_BYTES) as u32;
+
+const _: () = assert!(
+    (MAX_SEG_CHUNKS_FORMAT_MAX as usize) * MAX_CHUNKREF_BYTES <= VALUE_CEILING_HALF,
+    "MAX_SEG_CHUNKS_FORMAT_MAX must itself satisfy the value-ceiling rule it is derived from"
+);
+
+/// `U_ref` over a **raw** tuple, exact and in `u128` (`0016:1469`):
+///
+/// ```text
+/// U_ref = min( (MAX_PARTS_PER_SESSION + MAX_INFLIGHT_PARTS) x MAX_PART_CHUNKS,
+///              MAX_STAGED_CHUNKS + 2 x MAX_INFLIGHT_PARTS x MAX_PART_CHUNKS )
+/// ```
+///
+/// **Exact, never saturating.** The operands are `u32`s, so both products can exceed
+/// `u64` (`(2^32 + 2^32) × 2^32 = 2^65`), and a *saturated* `U_ref` is not a fail-closed
+/// approximation but a false one: at `W_ref = u64::MAX` a saturating `U_ref = u64::MAX`
+/// derives `⌊W_ref/U_ref⌋ = 1` and admits a session whose true worst-case footprint is
+/// **larger than the whole budget**. In `u128` the comparison `W_ref < U_ref` is the
+/// mathematical one, so [`Budget::new`] refuses that tuple outright and no `Budget` can
+/// derive a limit its own arithmetic overflowed.
+fn u_ref_of(
+    max_part_chunks: u32,
+    max_parts_per_session: u32,
+    max_inflight_parts: u32,
+    max_staged_chunks: u32,
+) -> u128 {
+    let part_chunks = u128::from(max_part_chunks);
+    let inflight = u128::from(max_inflight_parts);
+    let raw = (u128::from(max_parts_per_session) + inflight) * part_chunks;
+    let ceiling = u128::from(max_staged_chunks) + 2 * inflight * part_chunks;
+    raw.min(ceiling)
+}
+
+/// The budget **profile** tuple `mpuctl` stores and every admitter/custodian compares
+/// whole (`0016:348`, the knob table `:1463-1480`). This child owns the **shape**, the
+/// valid **ranges** `0016` settles for it, and the two pure derivations below; the
+/// deployment's own values are #508's/#655's — mirroring the format/capacity split
+/// `metadata.rs:270-322` already draws.
+///
+/// The fields are private behind [`Budget::new`] because the derivations are safety
+/// arithmetic: a tuple with a zero component derives a `U_ref` of zero, and
+/// `MAX_SESSIONS` would then be a division by zero rather than a limit. No legal
+/// configuration has one, so it is refused at construction and at decode, and every
+/// `Budget` in existence therefore derives a defined limit.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize)]
+pub struct Budget {
+    w_ref: u64,
+    max_part_chunks: u32,
+    max_parts_per_session: u32,
+    max_inflight_parts: u32,
+    max_staged_chunks: u32,
+}
+
+impl Budget {
+    /// The validating constructor — the **only** way to obtain a profile, and the one
+    /// place `0016`'s valid ranges for the tuple are enforced (`0016:1463-1480`). Every
+    /// rule below is a relation **among the tuple's own components** or against a
+    /// **format** constant — never a deployment value, which stays #508's/#655's
+    /// (`0016:390-402`; `B_ops`, named at `0016:1466`/`:1475`/`:1487`, is a
+    /// backend-calibrated deployment knob with no value on this base and is deliberately
+    /// **not** checked here — it is enforced where new work is admitted, #625's):
+    ///
+    /// * every component non-zero — a zero derives a `U_ref` of zero, and `MAX_SESSIONS`
+    ///   would be a division by zero rather than a limit;
+    /// * `MAX_INFLIGHT_PARTS ≤ MAX_PARTS_PER_SESSION` (`0016:1476`, iteration-13 finding
+    ///   2): a session cannot have more parts in flight than it may ever hold;
+    /// * `MAX_STAGED_CHUNKS ≥ MAX_PART_CHUNKS` (`0016:1468`'s lower end): at least one
+    ///   maximal part must remain stageable, or the staged ceiling refuses the very first
+    ///   part every session must be able to commit;
+    /// * `MAX_PARTS_PER_SESSION ≤ MAX_PART_NUMBER` — the knob may not promise a
+    ///   part-number space the key grammar cannot address (`multipart.rs:277`);
+    /// * `MAX_CHUNKREF_BYTES × MAX_PART_CHUNKS ≤ MAX_VALUE_BYTES / 2` (`0016:1466`, the
+    ///   `part:` record's own value-ceiling rule): a `part:` record holding
+    ///   `MAX_PART_CHUNKS` chunk-refs must fit the backend value ceiling with the
+    ///   required 2x headroom;
+    /// * `MAX_STAGED_CHUNKS ≤ MAX_ROOT_SEGMENTS × MAX_SEG_CHUNKS_FORMAT_MAX` (`0016:1468`'s
+    ///   upper end, the publishable segmented ceiling);
+    /// * `MAX_STAGED_CHUNKS + MAX_INFLIGHT_PARTS × MAX_PART_CHUNKS ≤ SCAN_CAP/2`
+    ///   (`0016:1476`'s bounding invariant): the per-session `sidx:` scan the teardown
+    ///   path depends on counts **committed staging entries as well as in-flight
+    ///   chunks** (batch-review `multipart.rs:1074`), so both terms must fit inside the
+    ///   reaper's one bounded scan;
+    /// * `W_ref ≥ U_ref` (`0016:1479`, the range `[U_ref, deployment RAM budget]`): a
+    ///   budget below one session's worst-case footprint derives `MAX_SESSIONS = 0` — no
+    ///   session could ever be admitted — and, at the extreme, is exactly the tuple whose
+    ///   true `U_ref` overflows `u64` while its saturated one looks affordable.
+    pub fn new(
+        w_ref: u64,
+        max_part_chunks: u32,
+        max_parts_per_session: u32,
+        max_inflight_parts: u32,
+        max_staged_chunks: u32,
+    ) -> Result<Self, RecordError> {
+        let invalid = |reason: String| Err(structural("mpuctl profile", reason));
+        let zero = [
+            (w_ref == 0, "w_ref"),
+            (max_part_chunks == 0, "max_part_chunks"),
+            (max_parts_per_session == 0, "max_parts_per_session"),
+            (max_inflight_parts == 0, "max_inflight_parts"),
+            (max_staged_chunks == 0, "max_staged_chunks"),
+        ];
+        for (is_zero, field) in zero {
+            if is_zero {
+                return invalid(format!(
+                    "`{field}` is zero: no configuration admits a session under it"
+                ));
+            }
+        }
+        if max_inflight_parts > max_parts_per_session {
+            return invalid(format!(
+                "max_inflight_parts={max_inflight_parts} exceeds \
+                 max_parts_per_session={max_parts_per_session}: a session cannot have more \
+                 parts in flight than it may ever hold (`0016:1476`)"
+            ));
+        }
+        if max_staged_chunks < max_part_chunks {
+            return invalid(format!(
+                "max_staged_chunks={max_staged_chunks} is below \
+                 max_part_chunks={max_part_chunks}: at least one maximal part must remain \
+                 stageable (`0016:1468`)"
+            ));
+        }
+        if max_parts_per_session > MAX_PART_NUMBER {
+            return invalid(format!(
+                "max_parts_per_session={max_parts_per_session} exceeds the part-number key \
+                 space [1, {MAX_PART_NUMBER}]: the knob may not promise parts the key \
+                 grammar cannot address"
+            ));
+        }
+        let part_value_charge = u128::from(max_part_chunks) * (MAX_CHUNKREF_BYTES as u128);
+        if part_value_charge > VALUE_CEILING_HALF as u128 {
+            return invalid(format!(
+                "max_part_chunks={max_part_chunks} x MAX_CHUNKREF_BYTES={MAX_CHUNKREF_BYTES} \
+                 = {part_value_charge} exceeds the value-ceiling budget \
+                 {VALUE_CEILING_HALF} (`0016:1466`, half MAX_VALUE_BYTES with the required \
+                 2x headroom): a part: record at this max_part_chunks would not fit the \
+                 backend value ceiling"
+            ));
+        }
+        let staged_format_ceiling =
+            u128::from(metadata::MAX_ROOT_SEGMENTS as u32) * u128::from(MAX_SEG_CHUNKS_FORMAT_MAX);
+        if u128::from(max_staged_chunks) > staged_format_ceiling {
+            return invalid(format!(
+                "max_staged_chunks={max_staged_chunks} exceeds the publishable format \
+                 ceiling MAX_ROOT_SEGMENTS x MAX_SEG_CHUNKS_FORMAT_MAX = \
+                 {staged_format_ceiling} (`0016:1468`)"
+            ));
+        }
+        let owned_scan_charge = u128::from(max_staged_chunks)
+            + u128::from(max_inflight_parts) * u128::from(max_part_chunks);
+        if owned_scan_charge > u128::from(scan_half()) {
+            return invalid(format!(
+                "max_staged_chunks + max_inflight_parts x max_part_chunks = \
+                 {owned_scan_charge} exceeds the sidx: scan bound {} (SCAN_CAP/2): the \
+                 teardown scan, which walks committed staging entries as well as \
+                 in-flight chunks (`0016:1476`, batch-review multipart.rs:1074), could not \
+                 walk the range empty",
+                scan_half()
+            ));
+        }
+        let u_ref = u_ref_of(
+            max_part_chunks,
+            max_parts_per_session,
+            max_inflight_parts,
+            max_staged_chunks,
+        );
+        if u128::from(w_ref) < u_ref {
+            return invalid(format!(
+                "w_ref={w_ref} is below the U_ref={u_ref} its own caps derive: the budget \
+                 must hold at least one session's worst-case footprint (`0016:1479`)"
+            ));
+        }
+        Ok(Self {
+            w_ref,
+            max_part_chunks,
+            max_parts_per_session,
+            max_inflight_parts,
+            max_staged_chunks,
+        })
+    }
+
+    /// The reconcile pass's staged-reference memory budget, in chunk-refs (`W_ref`).
+    pub const fn w_ref(&self) -> u64 {
+        self.w_ref
+    }
+
+    /// The per-`part:`-record chunk ceiling (`MAX_PART_CHUNKS`).
+    pub const fn max_part_chunks(&self) -> u32 {
+        self.max_part_chunks
+    }
+
+    /// The per-session part-number space (`MAX_PARTS_PER_SESSION`).
+    pub const fn max_parts_per_session(&self) -> u32 {
+        self.max_parts_per_session
+    }
+
+    /// The per-session in-flight cap (`MAX_INFLIGHT_PARTS`).
+    pub const fn max_inflight_parts(&self) -> u32 {
+        self.max_inflight_parts
+    }
+
+    /// The per-session committed-staging ceiling (`MAX_STAGED_CHUNKS`).
+    pub const fn max_staged_chunks(&self) -> u32 {
+        self.max_staged_chunks
+    }
+
+    /// `U_ref` — the worst-case **per-session** staged-reference footprint, in
+    /// chunk-refs (`u_ref_of`, `0016:1469`). [`Budget::new`] refuses a tuple whose
+    /// `U_ref` exceeds its own `w_ref`, so the value always fits the `u64` the budget is
+    /// stated in; the fallback charges the whole budget to one session, the fail-closed
+    /// direction.
+    pub fn u_ref(&self) -> u64 {
+        let exact = u_ref_of(
+            self.max_part_chunks,
+            self.max_parts_per_session,
+            self.max_inflight_parts,
+            self.max_staged_chunks,
+        );
+        u64::try_from(exact).unwrap_or(u64::MAX)
+    }
+
+    /// `MAX_SESSIONS` — the admission limit, `min(floor(W_ref / U_ref), SCAN_CAP/2)`,
+    /// **derived, never chosen** (`0016:1470`). The `scan_half` clamp is what keeps a
+    /// legal pairing (a large `W_ref` with small parts) from exceeding the reaper's one
+    /// `scan("mpu:")`; [`wyrd_traits::SCAN_CAP`] is a pre-existing store-seam constant,
+    /// not a multipart deployment knob, so consulting it here is still pure arithmetic
+    /// over values already fixed.
+    ///
+    /// [`Budget::new`] refuses a zero component, so `u_ref()` is at least 2 and the
+    /// division is total; it also refuses `W_ref < U_ref`, so the quotient is at least 1
+    /// — a `Budget` that exists always admits at least one session.
+    pub fn max_sessions(&self) -> u64 {
+        let quotient = self.w_ref / self.u_ref();
+        quotient.min(scan_half())
+    }
+}
+
+#[derive(Deserialize)]
+struct BudgetWire {
+    w_ref: u64,
+    max_part_chunks: u32,
+    max_parts_per_session: u32,
+    max_inflight_parts: u32,
+    max_staged_chunks: u32,
+}
+
+impl<'de> Deserialize<'de> for Budget {
+    fn deserialize<D: Deserializer<'de>>(deserializer: D) -> Result<Self, D::Error> {
+        let wire = BudgetWire::deserialize(deserializer)?;
+        Budget::new(
+            wire.w_ref,
+            wire.max_part_chunks,
+            wire.max_parts_per_session,
+            wire.max_inflight_parts,
+            wire.max_staged_chunks,
+        )
+        .map_err(DeError::custom)
+    }
+}
+
+/// The singleton **admission ledger** record, `mpuctl` (`0016:348`): one record, three
+/// fields, CAS'd **whole**, so the count and the limit it was checked against can never
+/// be read apart.
+///
+/// **`max_sessions` is checked against the profile at decode**, because it is *derived*
+/// ([`Budget::max_sessions`], `0016:1470`) and never independently chosen. Admission
+/// enforces the **stored** limit — deliberately, so every admitter in the fleet agrees
+/// on one number — which is exactly why the stored number may not be free: a torn or
+/// rolled-back `mpuctl` naming a larger `max_sessions` than its own profile derives would
+/// be trusted by every host, and `Σ_sessions(U_ref) ≤ W_ref` (the bound the whole
+/// reconcile pass is sized for) would be exceeded on hosts that never observe the
+/// overrun. The relation between the two fields is a structural invariant of this record
+/// class, so it surfaces as an error at decode rather than as an admitted value
+/// (ADR-0045).
+///
+/// **`count` is deliberately NOT checked against `max_sessions` at decode**: `count`
+/// exceeding `max_sessions` is a live **occupancy** state, not a torn identity — a
+/// profile lowered while sessions are live leaves the ledger over its new cap until
+/// admission (a later slice) refuses to grow it further, the same liberal-on-read
+/// boundary [`metadata::MAX_ROOT_SEGMENTS`] draws (`metadata.rs:312-321`) between a
+/// format bound (checked at decode) and a capacity policy (checked where work is
+/// admitted). Rejecting it at decode would make a durable ledger unreadable the day the
+/// profile is lowered (`0016:390-402`).
+#[derive(Debug, Clone, PartialEq, Eq, Serialize)]
+pub struct AdmissionRecord {
+    /// How many `mpu:` records exist, in any state (tombstones included).
+    pub count: u64,
+    /// The governing limit those increments were admitted against.
+    pub max_sessions: u64,
+    /// The budget tuple that establishes `max_sessions`.
+    pub profile: Budget,
+}
+
+impl AdmissionRecord {
+    /// The ledger a first Create initializes on a fresh or upgraded store: one session,
+    /// the limit its own profile derives (`0016:348`).
+    pub fn new(count: u64, profile: Budget) -> Self {
+        Self {
+            count,
+            max_sessions: profile.max_sessions(),
+            profile,
+        }
+    }
+}
+
+#[derive(Deserialize)]
+struct AdmissionRecordWire {
+    count: u64,
+    max_sessions: u64,
+    profile: Budget,
+}
+
+impl<'de> Deserialize<'de> for AdmissionRecord {
+    fn deserialize<D: Deserializer<'de>>(deserializer: D) -> Result<Self, D::Error> {
+        let wire = AdmissionRecordWire::deserialize(deserializer)?;
+        let derived = wire.profile.max_sessions();
+        if wire.max_sessions != derived {
+            return Err(DeError::custom(structural(
+                "mpuctl",
+                format!(
+                    "records max_sessions={} but its own profile derives {derived} \
+                     (U_ref={}, W_ref={}): the stored limit is derived, never chosen",
+                    wire.max_sessions,
+                    wire.profile.u_ref(),
+                    wire.profile.w_ref(),
+                ),
+            )));
+        }
+        Ok(Self {
+            count: wire.count,
+            max_sessions: wire.max_sessions,
+            profile: wire.profile,
+        })
+    }
+}
+
+/// Decode the `mpuctl` singleton, with its relational invariant enforced.
+pub fn decode_admission_record(bytes: &[u8]) -> Result<AdmissionRecord, RecordError> {
+    decode_record("mpuctl", bytes)
+}
