+// ===========================================================================
+// 5. Record encode/decode (`0016` §1) — the shared codec this child's `mpuctl` value
+//    routes through, and the shape every later record class in this module extends with
+//    its own decode wrapper. The class-specific **relational** checks live on each
+//    class's own `Deserialize` (ADR-0045), never here.
+// ===========================================================================
+
+/// Decode one record class's stored JSON, turning every serde failure — including every
+/// validating-decode rejection a class's own `Deserialize` raises — into a typed
+/// [`RecordError::Structural`] tagged with the record's name, so a caller need not learn
+/// serde's own error shape to classify a torn record.
+fn decode_record<T: serde::de::DeserializeOwned>(
+    record: &'static str,
+    bytes: &[u8],
+) -> Result<T, RecordError> {
+    serde_json::from_slice(bytes).map_err(|error| structural(record, error.to_string()))
+}
+
+/// Encode a multipart record to its stored bytes — the same infallible JSON encoding
+/// every record in [`crate::metadata`] uses (`metadata.rs:1536-1538`); infallible because
+/// every field of every record this module defines is already-validated data, never a
+/// type serde could refuse mid-encode.
+pub fn encode_record<T: Serialize>(record: &T) -> Vec<u8> {
+    serde_json::to_vec(record).expect("multipart record serialization is infallible")
+}
