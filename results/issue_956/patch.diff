+            other => failures.push(format!(
+                "{name} ({}): expected {expected:?}, got {other:?}",
+                case.method
+            )),
+        }
+    }
+    assert!(
+        failures.is_empty(),
+        "{} case(s) misread:\n{}",
+        failures.len(),
+        failures.join("\n")
+    );
+}
