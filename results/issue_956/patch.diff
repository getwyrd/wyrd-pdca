+/// Every probe that names a key.
+fn probes_with_a_key(key: &str, upload_id: &str) -> Vec<Probe> {
+    let mut probes = vec![
+        Probe::CopyObject {
+            key: key.to_string(),
+            source_key: "source".to_string(),
+        },
+        Probe::CreateMultipartUpload {
+            key: key.to_string(),
+        },
+    ];
+    probes.extend(probes_with_an_upload_id(key, upload_id));
+    probes
+}
