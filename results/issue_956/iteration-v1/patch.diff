+    let started = Instant::now();
+    for (name, outcome) in every_probe_under(addr, limits).await {
+        assert_eq!(
+            outcome.err(),
+            Some(S3Error::Timeout {
+                phase: Phase::Operation,
+                limit: limits.operation,
+            }),
+            "{name}"
+        );
+    }
+    assert!(started.elapsed() >= limits.operation);
+}
