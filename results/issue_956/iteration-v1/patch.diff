+/// A bare `400` with no body: what the scripted endpoint answers every request of the path
+/// test with.
+fn bare_400(request_id: &str) -> Script {
+    Script::ended(head(
+        "400 Bad Request",
+        request_id,
+        &[("Content-Length", "0".to_string())],
+    ))
+}
