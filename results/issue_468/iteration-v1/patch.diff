index 0000000..15378b6
--- /dev/null
+++ b/crates/dst/tests/commit_ambiguity.rs
@@ -0,0 +1,285 @@
+//! **Commit ambiguity** — the one failure shape FoundationDB introduces that neither redb
+//! nor the simulated-TiKV model can render, driven inside the deterministic simulator
+//! (issue #468).
+//!
+//! `1021 commit_unknown_result` means the commit **may or may not have landed** and the
+//! client cannot tell. The production driver surfaces it as a distinguishable `Err`, never
+//! as `Ok(Conflict)` and never retried, because a `WriteBatch` is not guaranteed idempotent
+//! (`crates/metadata-fdb/src/lib.rs:67-73`, `:150-153`). A caller's only correct move is a
+//! **settling re-read**.
+//!
+//! This cannot be tested against a real cluster: *"A healthy `fdbserver` cannot be made to
+//! emit 1021 on demand"* (`crates/metadata-fdb/src/lib.rs:71`). A real fault battery can
+//! only *sample* the ambiguity space; a seed-driven nemesis inside madsim **searches** it —
+//! which is exactly why the simulated-FDB model exists.
+//!
+//! ## The invariant
+//!
+//! An ambiguous commit is never counted either way without a settling re-read; once the
+//! re-read settles it, at most one writer won, the inode's version bumped exactly as many
+//! times as there were winners, and no torn/hybrid inode is ever observable.
+//!
+//! ## Why this file, and not `concurrency.rs`
+//!
+//! `concurrency.rs`'s `exactly_one_writer_wins_over` (`:75`) is the **shared** property body
+//! driving redb and simulated-TiKV, and it `.unwrap()`s the commit result (`:106`). That
+//! strictness is correct *for those stores* — an `Err` from their `commit` genuinely is a
+//! bug — so it must not be weakened to accommodate an ambiguity-capable store. The ambiguity
+//! scenario therefore gets its own property body here.
+//!
+//! Requires `--cfg madsim` (set by `cargo xtask dst`, which sweeps 50 seeds); without it
+//! this file compiles to nothing, so a normal `cargo test` neither builds nor runs it. The
+//! structural companion guard, `crates/dst/tests/no_fdb_linkage.rs`, is deliberately *not*
+//! madsim-gated.
+#![cfg(madsim)]
+
+use std::sync::Arc;
+
+use wyrd_chunkstore_fs::FsChunkStore;
+use wyrd_core::metadata::{ChunkRef, EcScheme};
+use wyrd_core::{read, write};
+use wyrd_traits::CommitOutcome;
+
+#[path = "support/mod.rs"]
+mod support;
+use support::{FdbObservations, SimCommitUnknownResult, SimFdbMetadataStore};
+
+const CHUNK: usize = 4;
+const LEASE_EXPIRY: u64 = 6_000;
+const RS: EcScheme = EcScheme::ReedSolomon { k: 6, m: 3 };
+
+/// How many seeds the two plain-`#[test]` sweeps below drive. `cargo xtask dst` sweeps its
+/// own 50 seeds over the `#[madsim::test]` entry point; these explicit sweeps additionally
+/// need to see **both halves** of the ambiguity space (an ambiguous commit that landed and
+/// one that did not), which a single seed cannot show.
+const AMBIGUITY_SWEEP_SEEDS: u64 = 64;
+
+/// A unique, deterministic chunk-id generator starting just above `base`. Each writer gets
+/// a disjoint id range, so an inode's `chunk_map` **identifies** the writer that wrote it —
+/// which is what lets a settling re-read decide whether *this* writer's ambiguous commit
+/// landed.
+fn ids_from(base: u128) -> impl FnMut() -> u128 {
+    let mut n = base;
+    move || {
+        n += 1;
+        n
+    }
+}
+
+/// How an observer treats a commit that returned `1021 commit_unknown_result`.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+enum Observer {
+    /// The **correct** move: re-read the inode and let the store's own state settle whether
+    /// the ambiguous commit landed.
+    SettlingReRead,
+    /// The **violating** observer (the demonstrated red): assume an ambiguous commit did not
+    /// land — i.e. count it as a loser without re-reading. Half the ambiguity space makes
+    /// that assumption false.
+    AssumeNotCommitted,
+}
+
+/// The ambiguity property body. Four writers read the same prior inode, stage independently,
+/// then race the version-conditional CAS while the `1021` nemesis is armed. Every `Err` is
+/// settled by re-reading the inode (or, for the violating observer, *not*), and the invariant
+/// is asserted over the settled set.
+///
+/// Note what is **not** done here: no commit result is `.unwrap()`ed, and no `Err` is turned
+/// into a winner or a loser before the settling read. That is the property.
+async fn ambiguous_commit_settles_over(meta: Arc<SimFdbMetadataStore>, observer: Observer) {
+    let dir = tempfile::tempdir().expect("temp dir");
+    let chunks = Arc::new(FsChunkStore::open(dir.path()).expect("fs store"));
+
+    // An existing object at version 1. The nemesis is still disarmed, so the fixture's own
+    // commits are determinate — the ambiguity under test is the four-writer race, not the
+    // fixture build.
+    let v0 = write::plan_write(b"v0", CHUNK, RS, ids_from(1)).unwrap();
+    write::intent(&*meta, &v0, LEASE_EXPIRY).await.unwrap();
+    write::write_fragments(&*chunks, &v0).await.unwrap();
+    write::commit_create(&*meta, 0, "obj", 1, &v0)
+        .await
+        .unwrap();
+    write::release(&*meta, &v0).await.unwrap();
+    let prior = read::read_inode(&*meta, 1).await.unwrap().unwrap();
+
+    // Arm the 1021 nemesis: the first CAS the resolver accepts becomes ambiguous, and the
+    // seed decides whether its mutation landed.
+    meta.arm_commit_ambiguity(1);
+
+    let mut handles = Vec::new();
+    for i in 0..4u128 {
+        let meta = Arc::clone(&meta);
+        let chunks = Arc::clone(&chunks);
+        let prior = prior.clone();
+        handles.push(madsim::task::spawn(async move {
+            let plan =
+                write::plan_write(b"contended", CHUNK, RS, ids_from(0x1000 * (i + 1))).unwrap();
+            write::intent(&*meta, &plan, LEASE_EXPIRY).await.unwrap();
+            write::write_fragments(&*chunks, &plan).await.unwrap();
+            // NOT unwrapped: this commit may legitimately be ambiguous.
+            let outcome = write::commit_overwrite(&*meta, 1, &prior, &plan, 0).await;
+            (outcome, plan.chunk_refs())
+        }));
+    }
+
+    let mut results = Vec::new();
+    for handle in handles {
+        results.push(handle.await.unwrap());
+    }
+
+    // ── settle ────────────────────────────────────────────────────────────────────────
+    // ONE re-read of the committed inode; every ambiguous commit is decided against it.
+    let settled = read::read_inode(&*meta, 1).await.unwrap().unwrap();
+
+    let mut winners: u64 = 0;
+    let mut winner_chunk_map: Option<Vec<ChunkRef>> = None;
+    for (outcome, chunk_map) in &results {
+        let won = match outcome {
+            Ok(CommitOutcome::Committed) => true,
+            Ok(CommitOutcome::Conflict) => false,
+            Err(err) => {
+                // The ONLY `Err` a correct simulated-FDB commit may return is the ambiguous
+                // one, and it must be distinguishable by type — not by message. A blind
+                // batch losing a race, or any other fault, would fail here.
+                assert!(
+                    err.downcast_ref::<SimCommitUnknownResult>().is_some(),
+                    "a simulated-FDB commit returned a non-1021 Err: {err}"
+                );
+                match observer {
+                    // Correct: the store's settled state decides. Chunk ids are disjoint per
+                    // writer, so an exact chunk-map match means *this* writer's commit landed.
+                    Observer::SettlingReRead => settled.chunk_map == *chunk_map,
+                    // Violating: assume it did not land.
+                    Observer::AssumeNotCommitted => false,
+                }
+            }
+        };
+        if won {
+            winners += 1;
+            winner_chunk_map = Some(chunk_map.clone());
+        }
+    }
+
+    // ── the invariant ─────────────────────────────────────────────────────────────────
+    assert!(
+        winners <= 1,
+        "at most one writer may win the version CAS; {winners} settled as winners"
+    );
+
+    // The load-bearing clause. An ambiguous commit that LANDED but was counted as a loser
+    // (or vice versa) shows up exactly here: the store bumped the version, the observer
+    // counted nobody. This is the assertion the `AssumeNotCommitted` observer trips.
+    assert_eq!(
+        settled.version - prior.version,
+        winners,
+        "the settled winner count ({winners}) must equal the inode's version bump ({} -> {}) \
+         — an ambiguous commit was counted without a settling re-read",
+        prior.version,
+        settled.version,
+    );
+
+    // No torn/hybrid inode: the committed chunk map is exactly ONE writer's plan (or the
+    // untouched prior), never a mix of several.
+    match winner_chunk_map {
+        Some(expected) => {
+            assert_eq!(
+                settled.chunk_map, expected,
+                "the settled inode's chunk map must be the winner's, whole — not a \
+                 torn/hybrid of several writers' plans"
+            );
+            // …and the object reassembles to the winner's bytes, end to end.
+            let bytes = read::read_path(&*meta, &*chunks, 0, "obj").await.unwrap();
+            assert_eq!(bytes.as_deref(), Some(&b"contended"[..]));
+        }
+        None => {
+            assert_eq!(
+                settled, prior,
+                "with no winner the inode must be byte-identical to the prior — a commit \
+                 that did not land must leave nothing behind"
+            );
+        }
+    }
+}
+
+/// Drive the four-writer ambiguity race at one fixed seed and return what the store observed.
+/// Mirrors `concurrency.rs:158`'s `run_pinned_race`.
+fn run_ambiguity_race(seed: u64, observer: Observer) -> FdbObservations {
+    let rt = madsim::runtime::Runtime::with_seed_and_config(seed, madsim::Config::default());
+    rt.block_on(async move {
+        let meta = Arc::new(SimFdbMetadataStore::new());
+        ambiguous_commit_settles_over(Arc::clone(&meta), observer).await;
+        meta.observations()
+    })
+}
+
+/// **The seed sweep `cargo xtask dst` drives** (`MADSIM_TEST_NUM=50`, `xtask/src/main.rs:1337`):
+/// with the 1021 nemesis armed, no invariant is violated at any seed — an ambiguous commit is
+/// never counted as a winner *or* a loser without a settling re-read; once settled, exactly one
+/// writer won and the version bumped exactly once; no torn/hybrid inode is observable.
+///
+/// The `ambiguous_commits == 1` assertion keeps the sweep honest: a seed where the nemesis
+/// never fired would prove nothing about ambiguity, and this fails loudly rather than passing
+/// vacuously.
+#[madsim::test]
+async fn commit_ambiguity_invariants_hold_under_the_dst_seed_sweep() {
+    let meta = Arc::new(SimFdbMetadataStore::new());
+    ambiguous_commit_settles_over(Arc::clone(&meta), Observer::SettlingReRead).await;
+
+    let obs = meta.observations();
+    assert_eq!(
+        obs.ambiguous_commits, 1,
+        "the 1021 nemesis must strike exactly the one commit its budget allows — a sweep \
+         that never armed it is vacuous"
+    );
+}
+
+/// The sweep is only meaningful if it actually explores **both halves** of the ambiguity
+/// space: seeds where the ambiguous commit landed (so the settling re-read must count it a
+/// winner) and seeds where it did not (so the re-read must count it a loser and let a later
+/// writer win). This asserts both occur, and — because `run_ambiguity_race` asserts the full
+/// invariant at every seed — that the invariant holds across all of them.
+#[test]
+fn the_settling_re_read_covers_both_halves_of_the_ambiguity_space() {
+    let mut landed = 0u64;
+    let mut did_not_land = 0u64;
+    for seed in 0..AMBIGUITY_SWEEP_SEEDS {
+        let obs = run_ambiguity_race(seed, Observer::SettlingReRead);
+        assert_eq!(
+            obs.ambiguous_commits, 1,
+            "the nemesis must fire once at seed {seed}"
+        );
+        if obs.ambiguous_commits_that_landed == 1 {
+            landed += 1;
+        } else {
+            did_not_land += 1;
+        }
+    }
+    assert!(
+        landed >= 1,
+        "no seed in 0..{AMBIGUITY_SWEEP_SEEDS} produced an ambiguous commit that LANDED; the \
+         settling re-read is never exercised on the half that matters"
+    );
+    assert!(
+        did_not_land >= 1,
+        "no seed in 0..{AMBIGUITY_SWEEP_SEEDS} produced an ambiguous commit that did NOT land; \
+         the sweep only sees one half of the ambiguity space"
+    );
+}
+
+/// **The demonstrated red** (cf. `crates/metadata-conformance/tests/demonstrated_red.rs`),
+/// proving the invariant above is load-bearing rather than a tautology.
+///
+/// The *only* thing that changes is the observer: instead of settling an `Err` by re-reading,
+/// it **assumes the ambiguous commit did not land**. That is precisely the reasoning
+/// `crates/metadata-fdb/src/lib.rs:67-73` forbids. On every seed where the struck commit
+/// actually landed, the store bumped the inode's version while this observer counted zero
+/// winners — and the version-bump assertion panics.
+///
+/// If the sweep somehow contained no landed-ambiguous seed, this test would *not* panic and
+/// `#[should_panic]` would fail it — so it doubles as a vacuity guard on the nemesis itself.
+#[test]
+#[should_panic(expected = "must equal the inode's version bump")]
+fn assuming_an_ambiguous_commit_did_not_land_fails_the_sweep() {
+    for seed in 0..AMBIGUITY_SWEEP_SEEDS {
+        run_ambiguity_race(seed, Observer::AssumeNotCommitted);
+    }
+}
