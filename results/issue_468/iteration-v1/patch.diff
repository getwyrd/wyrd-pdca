index 0000000..20f9b00
--- /dev/null
+++ b/crates/dst/tests/no_fdb_linkage.rs
@@ -0,0 +1,197 @@
+//! **No `libfdb_c` in the simulator's dependency graph** — the mechanical guarantee that
+//! backs the simulated-FDB model (issue #468).
+//!
+//! `crates/dst` is the deterministic-simulation tier (ADR-0009). The `foundationdb` crate
+//! binds `libfdb_c`, which **spawns its own network thread** and does real, non-deterministic
+//! I/O — `ensure_network()` boots it behind a process-wide `OnceLock`
+//! (`crates/metadata-fdb/src/lib.rs:846-869`). Linking it into a DST build target would
+//! violate seed determinism outright (ADR-0035; the rejection is recorded at
+//! `crates/dst/tests/support/mod.rs:6-8`). So the FDB backend is **modelled**
+//! (`support::SimFdbMetadataStore`), never linked — and there is exactly one way `libfdb_c`
+//! could enter this graph: someone adding the dependency to `crates/dst/Cargo.toml`.
+//!
+//! Two assertions, both cheap and deterministic, both run by `cargo xtask ci` (via
+//! `run_dst()`):
+//!
+//! 1. **The purity invariant.** `crates/dst/Cargo.toml` declares neither `wyrd-metadata-fdb`
+//!    nor `foundationdb` — with a **planted red** proving the scanner actually catches one,
+//!    rather than resting green on non-existence (the shape of
+//!    `xtask/tests/deploy_no_orchestrator_coupling.rs:67`).
+//! 2. **The model exists.** `crates/dst/tests/support/mod.rs` declares
+//!    `SimFdbMetadataStore` — the second parametrization this slice ships. A structural
+//!    assertion, stated plainly: it pins the *seam*, not the behaviour. The behavioural
+//!    red→green for the 1021 ambiguity property lives in
+//!    `crates/dst/tests/commit_ambiguity.rs`, which only executes under `--cfg madsim`.
+//!
+//! ## Why a plain-text scan and not a TOML parse
+//!
+//! `crates/dst` has no `toml`/`serde` dependency. Adding one to satisfy a guard would trip
+//! ADR-0003 §2's three-test dependency audit and the `deny.toml` allowlist — a real cost for
+//! no benefit, since the property ("this manifest names no FDB dependency") is a property of
+//! the manifest's *text*.
+//!
+//! Unlike its sibling `commit_ambiguity.rs`, this file is deliberately **not**
+//! `#![cfg(madsim)]`-gated, so it also runs under a bare
+//! `cargo test -p wyrd-dst --test no_fdb_linkage`.
+
+use std::path::{Path, PathBuf};
+
+/// The dependency names that would drag `libfdb_c` into the simulator: the FDB backend crate
+/// itself, and the `foundationdb` FFI crate it binds.
+const FDB_DEPENDENCY_NEEDLES: [&str; 2] = ["wyrd-metadata-fdb", "foundationdb"];
+
+/// This crate's directory (`<root>/crates/dst`).
+fn crate_dir() -> PathBuf {
+    Path::new(env!("CARGO_MANIFEST_DIR")).to_path_buf()
+}
+
+/// The dependency name a single manifest line declares, if it is one of the banned ones.
+///
+/// Handles the three shapes a Cargo manifest can use, and ignores prose:
+///
+/// * `foundationdb = { version = "0.9" }`
+/// * `wyrd-metadata-fdb.workspace = true`
+/// * `[dependencies.foundationdb]`
+///
+/// A comment mentioning FoundationDB — as this crate's own docs do — is **not** a dependency,
+/// so everything from a `#` on is stripped first.
+fn scan_line(line: &str) -> Option<&'static str> {
+    let code = line.split('#').next().unwrap_or("").trim();
+    if code.is_empty() {
+        return None;
+    }
+
+    // `[dependencies.foundationdb]` / `[target.'cfg(x)'.dev-dependencies.foundationdb]`
+    if let Some(section) = code.strip_prefix('[').and_then(|s| s.strip_suffix(']')) {
+        let last = section.rsplit('.').next().unwrap_or("");
+        return FDB_DEPENDENCY_NEEDLES.iter().copied().find(|n| last == *n);
+    }
+
+    // `name = ...` / `name.workspace = true` — the key is the text before the first
+    // `=`, `.` or whitespace.
+    let key = code
+        .split(['=', '.', ' ', '\t'])
+        .next()
+        .unwrap_or("")
+        .trim_matches('"');
+    FDB_DEPENDENCY_NEEDLES.iter().copied().find(|n| key == *n)
+}
+
+/// Every banned FDB dependency a Cargo manifest declares. **One scanner, two call sites**:
+/// the real `crates/dst/Cargo.toml` (which must be empty) and a planted temp fixture (which
+/// must not be).
+fn scan_manifest_at(manifest: &Path) -> Vec<String> {
+    let text = std::fs::read_to_string(manifest)
+        .unwrap_or_else(|e| panic!("read {}: {e}", manifest.display()));
+    text.lines()
+        .filter_map(scan_line)
+        .map(str::to_string)
+        .collect()
+}
+
+/// A unique temp directory, mirroring `xtask/tests/deploy_no_orchestrator_coupling.rs:72-79`.
+fn temp_fixture_dir(tag: &str) -> PathBuf {
+    let dir = std::env::temp_dir().join(format!(
+        "wyrd-no-fdb-linkage-{tag}-{}-{}",
+        std::process::id(),
+        std::time::SystemTime::now()
+            .duration_since(std::time::UNIX_EPOCH)
+            .expect("system clock before UNIX epoch")
+            .as_nanos()
+    ));
+    std::fs::create_dir_all(&dir).expect("create fixture dir");
+    dir
+}
+
+// ─── (1) the purity invariant, with a planted red ─────────────────────────────────────
+
+#[test]
+fn scan_line_catches_every_manifest_dependency_shape() {
+    assert_eq!(
+        scan_line("foundationdb = { version = \"0.9\" }"),
+        Some("foundationdb")
+    );
+    assert_eq!(
+        scan_line("wyrd-metadata-fdb.workspace = true"),
+        Some("wyrd-metadata-fdb")
+    );
+    assert_eq!(
+        scan_line("[target.'cfg(madsim)'.dev-dependencies.foundationdb]"),
+        Some("foundationdb")
+    );
+    assert_eq!(
+        scan_line("[dependencies.wyrd-metadata-fdb]"),
+        Some("wyrd-metadata-fdb")
+    );
+}
+
+#[test]
+fn scan_line_ignores_comments_and_unrelated_dependencies() {
+    // This crate's own manifest and docs discuss FoundationDB in prose; prose is not a
+    // dependency edge. Only a real declaration is a violation.
+    assert!(scan_line("# never depend on foundationdb here (ADR-0035)").is_none());
+    assert!(scan_line("wyrd-metadata-redb.workspace = true # not foundationdb").is_none());
+    assert!(scan_line("[dev-dependencies]").is_none());
+    // A crate whose name merely *contains* a needle is not the needle.
+    assert!(scan_line("foundationdb-sys-shim.workspace = true").is_none());
+}
+
+#[test]
+fn scan_manifest_is_red_when_an_fdb_dependency_is_planted() {
+    // Plant a REAL FDB dependency in a temp-fixture manifest and prove the SAME scanner the
+    // invariant below runs catches it: a demonstrated red, not a guard resting red on
+    // non-existence (`xtask/tests/deploy_no_orchestrator_coupling.rs:67-99`).
+    let dir = temp_fixture_dir("planted");
+    let manifest = dir.join("Cargo.toml");
+    std::fs::write(
+        &manifest,
+        "[package]\nname = \"wyrd-dst\"\n\n[dev-dependencies]\n\
+         wyrd-metadata-redb.workspace = true\nwyrd-metadata-fdb.workspace = true\n\
+         foundationdb = { version = \"0.9\", features = [\"fdb-7_1\"] }\n",
+    )
+    .expect("write fixture manifest");
+
+    let violations = scan_manifest_at(&manifest);
+    std::fs::remove_dir_all(&dir).ok();
+
+    assert_eq!(
+        violations,
+        vec!["wyrd-metadata-fdb".to_string(), "foundationdb".to_string()],
+        "planting the FDB dependencies must be caught, once each"
+    );
+}
+
+#[test]
+fn the_dst_manifest_declares_no_fdb_dependency() {
+    // The invariant itself: `libfdb_c` cannot reach a DST build target, because nothing in
+    // this crate's graph names it.
+    let manifest = crate_dir().join("Cargo.toml");
+    let violations = scan_manifest_at(&manifest);
+    assert!(
+        violations.is_empty(),
+        "{} declares FDB dependenc(ies) {violations:?} — `libfdb_c` spawns its own network \
+         thread and would break the simulator's seed determinism (ADR-0009/ADR-0035). The FDB \
+         backend is MODELLED in tests/support/mod.rs, never linked.",
+        manifest.display()
+    );
+}
+
+// ─── (2) the model this slice ships actually exists ───────────────────────────────────
+
+#[test]
