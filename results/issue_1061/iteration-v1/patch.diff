+/// `value` with `cursor` spelled in as its last field.
+fn with_cursor(value: &str, cursor: &str) -> String {
+    let open = value.strip_suffix('}').expect("an object");
+    format!(r#"{open},"cursor":{cursor}}}"#)
+}
