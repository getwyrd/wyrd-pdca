+/// The op label for `method` — the request plane's stable, low-cardinality key.
+fn op_label(method: &Method) -> &'static str {
+    match *method {
+        Method::PUT => "put",
+        Method::GET => "get",
+        Method::DELETE => "delete",
+        Method::HEAD => "head",
+        _ => "other",
+    }
