+    ($lines:literal) => {
+        concat!("crates/gateway-s3/src/lib.rs:", $lines)
+    };
+}
+
+/// `unsupported`: refused `501 NotImplemented`.
+const fn nimpl(operation: Operation, issue: u32, cites: &'static str) -> Row {
+    Row::unsupported(
+        operation,
+        issue,
+        501,
+        DeclaredCode::Code("NotImplemented"),
+        cites,
+    )
+}
