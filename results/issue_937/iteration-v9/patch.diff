+            just(204),
+            just(206),
+            body(200, cutn(0)),
+            body(200, cutb(b"<xml")),
+            body(200, bad()),
+        ] {
+            let result = classify(row(op), &other(op, answer.clone()));
+            assert_eq!(
+                class_of(&result),
+                Some(UnexpectedSupport),
+                "{op:?}: {answer:?}"
+            );
+        }
+    }
+    fails(other(CompleteMultipartUpload, just(200)), UnexpectedSupport);
+    fails(other(CopyObject, body(200, cutn(3))), UnexpectedSupport);
+}
