+}
+
+fn selected(table: &[Profile], v: &str) -> Result<&'static str, NoProfile> {
+    select_reported(table, v).map(Profile::name)
+}
+
+#[test]
+fn pre_0_1_covers_every_version_below_0_1_0() {
