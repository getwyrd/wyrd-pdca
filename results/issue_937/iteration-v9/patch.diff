+        get(just(500)),
+        ranged(just(502)),
+        hit(just(500)),
+        miss(just(503)),
+        head_of(resp(500)),
+        del(just(500), just(404)),
+        bulk(just(503), hs(404, 404)),
+        list_v2(just(500)),
+        list_v1(just(502)),
