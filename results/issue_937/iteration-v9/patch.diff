+// --- Versions -------------------------------------------------------------------------------
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum PreId {
+    Numeric(u64),
+    Alpha(String),
+}
+
+/// `MAJOR.MINOR.PATCH` with any pre-release; build metadata never changes the selection.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Release {
+    pub major: u64,
+    pub minor: u64,
+    pub patch: u64,
+    pub pre: Vec<PreId>,
+}
+
+impl Release {
+    /// On the same triple a pre-release sorts before the release (SemVer 2.0.0 §11).
+    fn cmp_bound(&self, bound: Bound) -> Ordering {
+        (self.major, self.minor, self.patch)
+            .cmp(&(bound.major, bound.minor, bound.patch))
+            .then(if self.pre.is_empty() {
+                Ordering::Equal
+            } else {
+                Ordering::Less
+            })
+    }
+}
+
+impl fmt::Display for Release {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        write!(f, "{}.{}.{}", self.major, self.minor, self.patch)?;
+        for (i, id) in self.pre.iter().enumerate() {
+            f.write_str(if i == 0 { "-" } else { "." })?;
+            match id {
+                PreId::Numeric(n) => write!(f, "{n}")?,
+                PreId::Alpha(s) => f.write_str(s)?,
+            }
+        }
+        Ok(())
+    }
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum ReportedVersion {
+    Release(Release),
+    /// The gateway's default `unknown` (`crates/gateway-s3/src/lib.rs:121`) or the "nothing was
+    /// known" identity `+git.unknown[.dirty]` (`derivation.rs:65`). Never read as `0.0.0`.
+    Unknown,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct VersionError {
+    pub input: String,
+    pub reason: &'static str,
+}
+
+impl fmt::Display for VersionError {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        write!(f, "cannot read version {:?}: {}", self.input, self.reason)
+    }
+}
+
+impl std::error::Error for VersionError {}
+
+const UNKNOWN: &str = "unknown";
+
+const UNKNOWN_BUILDS: [&str; 2] = ["git.unknown", "git.unknown.dirty"];
+
+/// `unknown`, or `MAJOR.MINOR.PATCH[-PRE][+BUILD]` by the SemVer 2.0.0 grammar, every token
+/// checked. The server emits `0.0.0+git.<sha>[.dirty]`, `0.1.0`, `0.1.0+git.dirty` and
+/// `0.1.0+git.3.<sha>[.dirty]` (`crates/server/src/version/derivation.rs:33-68`).
+pub fn parse_version(input: &str) -> Result<ReportedVersion, VersionError> {
+    let err = |reason| VersionError {
+        input: input.to_string(),
+        reason,
+    };
+    if input == UNKNOWN {
+        return Ok(ReportedVersion::Unknown);
+    }
+    let (release_part, build) = match input.split_once('+') {
+        Some((release, build)) => (release, Some(build)),
+        None => (input, None),
+    };
+    let ident = |id: &str| !id.is_empty() && id.bytes().all(is_ident_byte);
+    if build.is_some_and(|build| !build.split('.').all(ident)) {
+        return Err(err("malformed build metadata"));
+    }
+    let (core, pre) = match release_part.split_once('-') {
+        Some((core, pre)) => (core, Some(pre)),
+        None => (release_part, None),
+    };
+    let mut numbers = core.split('.');
+    let (Some(major), Some(minor), Some(patch), None) = (
+        numbers.next(),
+        numbers.next(),
+        numbers.next(),
+        numbers.next(),
+    ) else {
+        return Err(err("expected MAJOR.MINOR.PATCH"));
+    };
+    let number = |s: &str| parse_numeric(s).ok_or_else(|| err("malformed version number"));
+    let (major, minor, patch) = (number(major)?, number(minor)?, number(patch)?);
+    let mut pre_ids = Vec::new();
+    if let Some(pre) = pre {
+        for id in pre.split('.') {
+            if !ident(id) {
+                return Err(err("malformed pre-release"));
+            }
+            if id.bytes().all(|b| b.is_ascii_digit()) {
+                pre_ids.push(PreId::Numeric(
+                    parse_numeric(id).ok_or_else(|| err("malformed pre-release"))?,
+                ));
+            } else {
+                pre_ids.push(PreId::Alpha(id.to_string()));
+            }
+        }
+    }
+    if build.is_some_and(|build| UNKNOWN_BUILDS.contains(&build)) {
+        return Ok(ReportedVersion::Unknown);
+    }
+    Ok(ReportedVersion::Release(Release {
+        major,
+        minor,
+        patch,
+        pre: pre_ids,
+    }))
+}
+
+fn is_ident_byte(b: u8) -> bool {
+    b.is_ascii_alphanumeric() || b == b'-'
+}
+
+/// ASCII digits only (no `+` sign, which `u64::from_str` takes), no leading zero, fits `u64`.
+fn parse_numeric(s: &str) -> Option<u64> {
+    if !s.bytes().all(|b| b.is_ascii_digit()) || (s.len() > 1 && s.starts_with('0')) {
+        return None;
+    }
+    s.parse().ok()
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum NoProfile {
+    Unknown,
+    Unparsable(VersionError),
+    NoMatch(Release),
+    /// More than one profile covers it: picking one would be a guess.
+    Ambiguous(Release),
+}
+
+impl fmt::Display for NoProfile {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            Self::Unknown => f.write_str("the server's version is unknown"),
+            Self::Unparsable(e) => write!(f, "{e}"),
+            Self::NoMatch(r) => write!(f, "no profile covers release {r}"),
+            Self::Ambiguous(r) => write!(f, "more than one profile covers release {r}"),
+        }
+    }
+}
+
+pub fn select<'a>(
+    profiles: &'a [Profile],
+    version: &ReportedVersion,
+) -> Result<&'a Profile, NoProfile> {
+    let release = match version {
+        ReportedVersion::Unknown => return Err(NoProfile::Unknown),
+        ReportedVersion::Release(release) => release,
+    };
+    let mut covering = profiles.iter().filter(|p| p.range.contains(release));
+    match (covering.next(), covering.next()) {
+        (Some(profile), None) => Ok(profile),
+        (None, _) => Err(NoProfile::NoMatch(release.clone())),
+        (Some(_), Some(_)) => Err(NoProfile::Ambiguous(release.clone())),
+    }
+}
+
+/// [`parse_version`] then [`select`].
+pub fn select_reported<'a>(profiles: &'a [Profile], input: &str) -> Result<&'a Profile, NoProfile> {
+    let version = parse_version(input).map_err(NoProfile::Unparsable)?;
+    select(profiles, &version)
+}
+
+// --- Observations ---------------------------------------------------------------------------
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum Answer {
+    /// No response head arrived: no connection, a reset, a timeout before the head.
+    NoAnswer {
+        why: String,
+    },
+    Response(Response),
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Response {
+    pub status: u16,
+    pub etag: Option<String>,
+    pub content_range: Option<String>,
+    pub content_length: Option<u64>,
+    /// The S3 error code of an error response, as the client read it; `None` on a success.
+    pub error_code: Option<ErrorCode>,
+    pub body: Body,
+}
+
+impl Response {
+    pub fn new(status: u16) -> Self {
+        Self {
+            status,
+            etag: None,
+            content_range: None,
+            content_length: None,
+            error_code: None,
+            body: Body::Empty,
+        }
+    }
+
+    pub fn with_etag(mut self, etag: &str) -> Self {
+        self.etag = Some(etag.to_string());
+        self
+    }
+
+    pub fn with_content_range(mut self, content_range: &str) -> Self {
+        self.content_range = Some(content_range.to_string());
+        self
+    }
+
+    pub fn with_content_length(mut self, content_length: u64) -> Self {
+        self.content_length = Some(content_length);
+        self
+    }
+
+    pub fn with_error_code(mut self, code: ErrorCode) -> Self {
+        self.error_code = Some(code);
+        self
+    }
+
+    pub fn with_body(mut self, body: Body) -> Self {
+        self.body = body;
+        self
+    }
+
+    fn is_success(&self) -> bool {
+        (200..300).contains(&self.status)
+    }
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum Body {
+    Empty,
+    Bytes(Vec<u8>),
+    /// A listing document, every page together: each key with its size.
+    Listing(Vec<Listed>),
+    /// A `<DeleteResult>` document (requested without `Quiet`).
+    DeleteResult(DeleteResult),
+    /// Arrived whole, and is not the document its status calls for (an error body that is not
+    /// one S3 `<Error>` document; a 200 without its listing or `<DeleteResult>`): `protocol`.
+    Unreadable {
+        why: String,
+    },
+    /// The head arrived and the body was then cut off (a transport failure, a timeout) after
+    /// `arrived`. What arrived is evidence; the cut itself settles nothing.
+    Cut {
+        arrived: Arrived,
+        why: String,
+    },
+}
+
+/// What arrived before a cut: the bytes (a streamed object body), or only how many (a body the
+/// client buffers whole).
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum Arrived {
+    Bytes(Vec<u8>),
+    Count(u64),
+}
+
+impl Arrived {
+    fn count(&self) -> u64 {
+        match self {
+            Self::Bytes(bytes) => bytes.len() as u64,
+            Self::Count(count) => *count,
+        }
+    }
+}
+
+#[derive(Debug, Clone, PartialEq, Eq, PartialOrd, Ord)]
+pub struct Listed {
+    pub key: String,
+    pub size: u64,
+}
+
+/// The keys under `<Deleted>`, and each `<Error>` row.
+#[derive(Debug, Clone, PartialEq, Eq, Default)]
+pub struct DeleteResult {
+    pub deleted: Vec<String>,
+    pub errors: Vec<DeleteFailure>,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct DeleteFailure {
+    pub key: String,
+    pub code: String,
+}
+
+/// One exercise of one row: what was asked, what the oracle expects, every answer the check reads.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum Exercise {
+    PutObject {
+        answer: Answer,
+        /// Whether the request body had ended when the response head arrived. A success
+        /// before that is not a receipt (the client's `BodyError::AcknowledgedEarly`).
+        request_body_ended: bool,
+    },
+    GetObject {
+        object: Vec<u8>,
+        answer: Answer,
+    },
+    /// `Range: bytes=first-last` of `object`.
+    GetObjectRanged {
+        object: Vec<u8>,
+        first: u64,
+        last: u64,
+        answer: Answer,
+    },
+    /// `If-None-Match: sent` of an object whose PUT answered `ETag: etag`. Settled only when
+    /// `sent` is a strong entity-tag equal to `etag`.
+    GetObjectIfNoneMatchHit {
+        sent: String,
+        etag: String,
+        answer: Answer,
+    },
+    /// `If-None-Match: sent` of `object`, whose PUT answered `ETag: etag`. Settled only when
+    /// `sent` is a strong entity-tag that differs from `etag`: the negative control that tells
+    /// "compares tags" from "answers 304 to anything".
+    GetObjectIfNoneMatchMiss {
+        sent: String,
+        etag: String,
+        object: Vec<u8>,
+        answer: Answer,
+    },
+    /// `size` and `etag` are the object's: its length and the `ETag` its PUT answered.
+    HeadObject {
+        size: u64,
+        etag: String,
+        answer: Answer,
+    },
+    /// `follow_up` is the `HEAD` of the key sent after the delete answered.
+    DeleteObject {
+        answer: Answer,
+        follow_up: Answer,
+    },
+    /// `follow_ups` are the `HEAD`s sent after the delete answered, each with the key it asked
+    /// about; a key may be probed more than once (a retry), and every entry is judged.
+    DeleteObjects {
+        keys: Vec<String>,
+        answer: Answer,
+        follow_ups: Vec<(String, Answer)>,
+    },
+    /// `expected` is every key written under the listed prefix, with its size.
+    ListObjectsV2 {
+        expected: Vec<Listed>,
+        answer: Answer,
+    },
+    ListObjects {
+        expected: Vec<Listed>,
+        answer: Answer,
+    },
+    /// An operation with no check of its own (an `unsupported` row): only the refusal is judged.
+    Other {
+        operation: Operation,
+        answer: Answer,
+    },
+}
+
+impl Exercise {
+    pub fn operation(&self) -> Operation {
+        match self {
+            Self::PutObject { .. } => Operation::PutObject,
+            Self::GetObject { .. } => Operation::GetObject,
+            Self::GetObjectRanged { .. } => Operation::GetObjectRanged,
+            Self::GetObjectIfNoneMatchHit { .. } => Operation::GetObjectIfNoneMatchHit,
+            Self::GetObjectIfNoneMatchMiss { .. } => Operation::GetObjectIfNoneMatchMiss,
+            Self::HeadObject { .. } => Operation::HeadObject,
+            Self::DeleteObject { .. } => Operation::DeleteObject,
+            Self::DeleteObjects { .. } => Operation::DeleteObjects,
+            Self::ListObjectsV2 { .. } => Operation::ListObjectsV2,
+            Self::ListObjects { .. } => Operation::ListObjects,
+            Self::Other { operation, .. } => *operation,
+        }
+    }
+
+    pub fn answer(&self) -> &Answer {
+        match self {
+            Self::PutObject { answer, .. }
+            | Self::GetObject { answer, .. }
+            | Self::GetObjectRanged { answer, .. }
+            | Self::GetObjectIfNoneMatchHit { answer, .. }
+            | Self::GetObjectIfNoneMatchMiss { answer, .. }
+            | Self::HeadObject { answer, .. }
+            | Self::DeleteObject { answer, .. }
+            | Self::DeleteObjects { answer, .. }
+            | Self::ListObjectsV2 { answer, .. }
+            | Self::ListObjects { answer, .. }
+            | Self::Other { answer, .. } => answer,
+        }
+    }
+}
+
+// --- Classification -------------------------------------------------------------------------
+
+/// The fatal classes of proposal 0017 §7. `availability` is not one: it covers only failures
+/// that leave no answer to judge; a 5xx is an answer.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum FailureClass {
+    /// Bytes, digest or size differ.
+    Integrity,
+    /// The model and the server disagree (a deleted key readable, a written key not found, a
+    /// listing mismatch).
+    Oracle,
+    /// An `unsupported` operation succeeded.
+    UnexpectedSupport,
+    /// Wrong status (a 5xx included), error code, or document shape.
+    Protocol,
+}
+
+impl fmt::Display for FailureClass {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.write_str(match self {
+            Self::Integrity => "integrity",
+            Self::Oracle => "oracle",
+            Self::UnexpectedSupport => "unexpected-support",
+            Self::Protocol => "protocol",
+        })
+    }
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum RowResult {
+    Pass,
+    Fatal {
+        class: FailureClass,
+        detail: String,
+    },
+    /// No response head arrived: nothing to judge.
+    NoAnswer {
+        why: String,
+    },
+    /// Nothing to judge: a body cut off with nothing wrong before the cut, a probe with no
+    /// answer, or an exercise that cannot show anything about the row. Never a 5xx.
+    Unsettled {
+        why: String,
+    },
+    /// The row is `supported, not checked (#issue)`: whatever came back, it is not a pass.
+    NotChecked {
+        issue: u32,
+    },
+}
+
+fn fatal(class: FailureClass, detail: impl Into<String>) -> RowResult {
+    RowResult::Fatal {
+        class,
+        detail: detail.into(),
+    }
+}
+
+fn protocol(detail: impl Into<String>) -> RowResult {
+    fatal(FailureClass::Protocol, detail)
+}
+
+fn oracle(detail: impl Into<String>) -> RowResult {
+    fatal(FailureClass::Oracle, detail)
+}
+
+fn integrity(detail: impl Into<String>) -> RowResult {
+    fatal(FailureClass::Integrity, detail)
+}
+
+fn unsettled(why: impl Into<String>) -> RowResult {
+    RowResult::Unsettled { why: why.into() }
+}
+
+/// Judge one exercise of `row`; an exercise of another operation shows nothing about it.
+pub fn classify(row: &Row, exercise: &Exercise) -> RowResult {
+    let (of, want) = (exercise.operation(), row.operation);
+    if of != want {
+        return unsettled(format!(
+            "an exercise of {of:?} cannot settle the {want:?} row"
+        ));
+    }
+    let checked = match row.expected {
+        Expected::SupportedNotChecked { issue } => return RowResult::NotChecked { issue },
+        Expected::Unsupported { status, code, .. } => {
+            check_unsupported(status, code, exercise.answer())
+        }
+        Expected::Required => check_required(exercise),
+    };
+    checked.err().unwrap_or(RowResult::Pass)
+}
+
+/// Any 2xx is support, however the body then ended; any other status (a 5xx included) is
+/// `protocol`. On the declared status a row declaring no body is held to it first (a byte, cut
+/// or not, is `protocol`; a cut after no byte settles nothing); an error body that is not an
+/// `<Error>` document is `protocol`; one cut off before its code is unsettled.
+fn check_unsupported(status: u16, code: DeclaredCode, answer: &Answer) -> Result<(), RowResult> {
+    let response = head(answer)?;
+    let got = response.status;
+    if response.is_success() {
+        let detail = format!("answered {got}; declared {status} {code}");
+        return Err(fatal(FailureClass::UnexpectedSupport, detail));
+    }
+    if got != status {
+        return Err(protocol(format!(
+            "answered {got}; declared {status} {code}"
+        )));
+    }
+    if code == DeclaredCode::NoBody {
+        expect_no_body(response)?;
+    }
+    match &response.body {
+        Body::Cut { why, .. } => {
+            return Err(unsettled(format!(
+                "{status} error body cut off before its code: {why}"
+            )))
+        }
+        Body::Unreadable { why } => {
+            return Err(protocol(format!(
+                "{status} error body is not an <Error> document: {why}"
+            )))
+        }
+        Body::Listing(_) | Body::DeleteResult(_) => {
+            return Err(protocol(format!(
+                "{status} error body is not an <Error> document"
+            )))
+        }
+        Body::Empty | Body::Bytes(_) => {}
+    }
+    if code.matches(response.error_code.as_ref()) {
+        return Ok(());
+    }
+    let observed = match &response.error_code {
+        Some(observed) => observed.to_string(),
+        None => "no error code".to_string(),
+    };
+    Err(protocol(format!(
+        "answered {status} with {observed}; declared {status} {code}"
+    )))
+}
+
+fn head(answer: &Answer) -> Result<&Response, RowResult> {
+    match answer {
+        Answer::NoAnswer { why } => Err(RowResult::NoAnswer { why: why.clone() }),
+        Answer::Response(r) => Ok(r),
+    }
+}
+
+fn expect_status(response: &Response, want: u16) -> Result<(), RowResult> {
+    let got = response.status;
+    if got == want {
+        Ok(())
+    } else {
+        Err(protocol(format!("answered {got}; expected {want}")))
+    }
+}
+
+/// A read of a key the run wrote: a 404 is `oracle`, the mirror of a deleted key readable
+/// (proposal 0017 §7); any other wrong status is `protocol`.
+fn expect_read_status(response: &Response, want: u16) -> Result<(), RowResult> {
+    if response.status == 404 {
+        return Err(oracle(format!(
+            "404 to a key the run wrote; expected {want}"
+        )));
+    }
+    expect_status(response, want)
+}
+
+/// Exactly `want`, else `integrity`; bytes before a cut that are not a prefix of `want` are
+/// `integrity` too, a cut after a correct prefix settles nothing, a document is `protocol`.
+fn expect_bytes(response: &Response, want: &[u8]) -> Result<(), RowResult> {
+    let size = want.len();
+    let (got, cut): (&[u8], Option<&String>) = match &response.body {
+        Body::Empty => (&[], None),
+        Body::Bytes(bytes) => (bytes, None),
+        Body::Cut {
+            arrived: Arrived::Bytes(bytes),
+            why,
+        } => (bytes, Some(why)),
+        Body::Cut {
+            arrived: Arrived::Count(count),
+            why,
+        } => {
+            // Only a count: more bytes than expected is a wrong body whatever they were.
+            if *count > size as u64 {
+                return Err(integrity(format!(
+                    "{count} bytes before the cut; expected {size}"
+                )));
+            }
+            return Err(unsettled(format!("cut off after {count} bytes: {why}")));
+        }
+        Body::Unreadable { why } => return Err(protocol(format!("not object bytes: {why}"))),
+        Body::Listing(_) | Body::DeleteResult(_) => {
+            return Err(protocol("a document where object bytes were expected"));
+        }
+    };
+    let n = got.len();
+    match cut {
+        None if got == want => return Ok(()),
+        Some(why) if want.starts_with(got) => {
+            return Err(unsettled(format!(
+                "cut off after {n} correct bytes of {size}: {why}"
+            )));
+        }
+        _ => {}
+    }
+    let at = got
+        .iter()
+        .zip(want)
+        .position(|(a, b)| a != b)
+        .unwrap_or(n.min(size));
+    let before = if cut.is_some() { " before the cut" } else { "" };
+    Err(integrity(format!(
+        "{n} bytes{before} differ from the expected {size} at offset {at}"
+    )))
+}
+
+/// An answer that carries no body: no bytes passes; any byte, before a cut or not, or any
+/// document is `protocol`; a cut after no byte settles nothing.
+fn expect_no_body(response: &Response) -> Result<(), RowResult> {
+    let status = response.status;
+    let arrived = match &response.body {
+        Body::Empty => return Ok(()),
+        Body::Bytes(bytes) => bytes.len() as u64,
+        Body::Cut { arrived, why } if arrived.count() == 0 => {
+            return Err(unsettled(format!("cut off after the head: {why}")));
+        }
+        Body::Cut { arrived, .. } => arrived.count(),
+        Body::Unreadable { .. } | Body::Listing(_) | Body::DeleteResult(_) => {
+            return Err(protocol(format!("answered {status} with a body")));
+        }
+    };
+    if arrived == 0 {
+        return Ok(());
+    }
+    Err(protocol(format!(
+        "answered {status} with a body of {arrived} bytes"
+    )))
+}
+
+/// Where a document is expected: cut off settles nothing; unreadable is the wrong shape.
+fn whole_document<'a>(response: &'a Response, name: &str) -> Result<&'a Body, RowResult> {
+    match &response.body {
+        Body::Cut { why, .. } => Err(unsettled(format!("the {name} was cut off: {why}"))),
+        Body::Unreadable { why } => Err(protocol(format!("200 body is not a {name}: {why}"))),
+        body => Ok(body),
+    }
+}
+
+/// A fatal result outranks an unsettled one, which outranks a pass.
+fn worst(checks: impl IntoIterator<Item = Result<(), RowResult>>) -> Result<(), RowResult> {
+    let mut first_unsettled = None;
+    for check in checks {
+        match check {
+            Ok(()) => {}
+            Err(fatal @ RowResult::Fatal { .. }) => return Err(fatal),
+            Err(other) => {
+                first_unsettled.get_or_insert(other);
+            }
+        }
+    }
+    first_unsettled.map_or(Ok(()), Err)
+}
+
+fn check_required(exercise: &Exercise) -> Result<(), RowResult> {
+    match exercise {
+        Exercise::PutObject {
+            answer,
+            request_body_ended,
+        } => {
+            let r = head(answer)?;
+            expect_status(r, 200)?;
+            if !request_body_ended {
+                return Err(protocol("answered 200 before the request body had ended"));
+            }
+            match r.etag.as_deref() {
+                Some(etag) if is_strong_etag(etag) => {}
+                Some(etag) => {
+                    return Err(protocol(format!(
+                        "ETag {etag:?} is not a strong entity-tag"
+                    )))
+                }
+                None => return Err(protocol("answered 200 with no ETag")),
+            }
+            // The head is a receipt only if the answer ended whole.
+            expect_no_body(r)
+        }
+        Exercise::GetObject { object, answer } => {
+            let r = head(answer)?;
+            expect_read_status(r, 200)?;
+            expect_bytes(r, object)
+        }
+        Exercise::GetObjectRanged {
+            object,
+            first,
+            last,
+            answer,
+        } => {
+            let size = object.len() as u64;
+            if first > last || *last >= size {
+                return Err(unsettled(format!(
+                    "asked bytes={first}-{last} of {size} bytes"
+                )));
+            }
+            let r = head(answer)?;
+            expect_read_status(r, 206)?;
+            let want = (*first, *last, size);
+            match r.content_range.as_deref() {
+                Some(value) if parse_content_range(value) == Some(want) => {}
+                Some(value) => {
+                    let want = format!("bytes {first}-{last}/{size}");
+                    return Err(protocol(format!(
+                        "Content-Range {value:?}; expected {want:?}"
+                    )));
+                }
+                None => return Err(protocol("answered 206 with no Content-Range")),
+            }
+            // In range by the guard above, so the slice cannot panic.
+            expect_bytes(r, &object[*first as usize..=*last as usize])
+        }
+        Exercise::GetObjectIfNoneMatchHit { sent, etag, answer } => {
+            if !is_strong_etag(sent) || sent != etag {
+                return Err(unsettled(format!(
+                    "sent If-None-Match: {sent}; the row needs the object's tag {etag}"
+                )));
+            }
+            let r = head(answer)?;
+            expect_read_status(r, 304)?;
+            expect_no_body(r)
+        }
+        Exercise::GetObjectIfNoneMatchMiss {
+            sent,
+            etag,
+            object,
+            answer,
+        } => {
+            if !is_strong_etag(sent) || sent == etag {
+                return Err(unsettled(format!(
+                    "sent If-None-Match: {sent}; the row needs a strong tag other than {etag}"
+                )));
+            }
+            let r = head(answer)?;
+            expect_read_status(r, 200)?;
+            expect_bytes(r, object)
+        }
+        Exercise::HeadObject { size, etag, answer } => {
+            let r = head(answer)?;
+            expect_read_status(r, 200)?;
+            let (length, got) = (r.content_length, r.etag.as_deref());
+            if length != Some(*size) {
+                return Err(oracle(format!(
+                    "Content-Length {length:?}; the object holds {size}"
+                )));
+            }
+            if got != Some(etag.as_str()) {
+                return Err(oracle(format!("ETag {got:?}; the PUT answered {etag:?}")));
+            }
+            expect_no_body(r)
+        }
+        Exercise::DeleteObject { answer, follow_up } => {
+            let r = head(answer)?;
+            expect_status(r, 204)?;
+            worst([expect_no_body(r), probe_deleted("the key", follow_up)])
+        }
+        Exercise::DeleteObjects {
+            keys,
+            answer,
+            follow_ups,
+        } => check_delete_objects(keys, answer, follow_ups),
+        Exercise::ListObjectsV2 { expected, answer }
+        | Exercise::ListObjects { expected, answer } => {
+            let r = head(answer)?;
+            expect_status(r, 200)?;
+            let Body::Listing(listed) = whole_document(r, "listing")? else {
+                return Err(protocol("answered 200 without a listing document"));
+            };
+            let mut got = listed.clone();
+            let mut want = expected.clone();
+            got.sort();
+            want.sort();
+            if got != want {
+                // A key missing, extra, listed twice or with another size.
+                Err(oracle(format!("listed {got:?}; wrote {want:?}")))
+            } else if want.is_empty() {
+                Err(unsettled(
+                    "a listing of a prefix with nothing written proves nothing",
+                ))
+            } else {
+                Ok(())
+            }
+        }
+        Exercise::Other { operation, .. } => Err(unsettled(format!(
+            "{operation:?} is required and has no check here"
+        ))),
+    }
+}
+
+/// The follow-up `HEAD` of a deleted key: a whole 404 proves the delete; a 2xx is `oracle`;
+/// any other status, a 5xx included, is `protocol`; no answer or a cut-off 404 settles nothing.
+fn probe_deleted(what: &str, follow_up: &Answer) -> Result<(), RowResult> {
+    let r = match follow_up {
+        Answer::NoAnswer { why } => {
+            return Err(unsettled(format!(
+                "HEAD of {what} after its delete: no answer: {why}"
+            )))
+        }
+        Answer::Response(r) => r,
+    };
+    let status = r.status;
+    match status {
+        404 => expect_no_body(r),
+        200..=299 => Err(oracle(format!(
+            "{what} answers {status} to a HEAD after its delete"
+        ))),
+        _ => Err(protocol(format!(
+            "HEAD of {what} after its delete answered {status}"
+        ))),
+    }
+}
+
+/// The document and every probe are separate checks folded by [`worst`]: after a `200` a key
+/// that still reads is fatal whatever the (possibly lost) document said. Without a `200` no
+/// delete was acknowledged, so the probes are not judged.
+fn check_delete_objects(
+    keys: &[String],
+    answer: &Answer,
+    follow_ups: &[(String, Answer)],
+) -> Result<(), RowResult> {
+    if keys.is_empty() {
+        return Err(unsettled("a DeleteObjects of no keys proves nothing"));
+    }
+    let r = head(answer)?;
+    expect_status(r, 200)?;
+    let mut requested = keys.to_vec();
+    requested.sort();
+    let mut checks = vec![check_delete_result(&requested, r)];
+    requested.dedup();
+    // The document alone never proves a delete; a key is proved gone by a HEAD of it answering
+    // 404. Every follow-up is judged: a key not requested settles nothing, and a fatal probe
+    // fails the row whatever another probe of the same key said.
+    for (key, _) in follow_ups
+        .iter()
+        .filter(|(key, _)| !requested.contains(key))
+    {
+        checks.push(Err(unsettled(format!(
+            "a HEAD of key {key:?}, not requested"
+        ))));
+    }
+    for key in &requested {
+        let what = format!("key {key:?}");
+        let probes: Vec<_> = follow_ups
+            .iter()
+            .filter(|(probed, _)| probed == key)
+            .map(|(_, follow_up)| probe_deleted(&what, follow_up))
+            .collect();
+        let proved = probes.iter().any(Result::is_ok);
+        match worst(probes) {
+            Err(fatal @ RowResult::Fatal { .. }) => checks.push(Err(fatal)),
+            _ if proved => {}
+            Err(other) => checks.push(Err(other)),
+            Ok(()) => checks.push(Err(unsettled(format!("{what} was not probed")))),
+        }
+    }
+    worst(checks)
+}
+
+/// Every key of `requested` (sorted) under `<Deleted>` exactly once, and no `<Error>` row.
+fn check_delete_result(requested: &[String], response: &Response) -> Result<(), RowResult> {
+    if let Some(twice) = requested.windows(2).find(|w| w[0] == w[1]) {
+        // The document could then not be matched key by key.
+        let key = &twice[0];
+        return Err(unsettled(format!(
+            "the exercise requested key {key:?} twice"
+        )));
+    }
+    let Body::DeleteResult(result) = whole_document(response, "<DeleteResult>")? else {
+        return Err(protocol("answered 200 without a <DeleteResult> document"));
+    };
+    // The gateway answers 200 even when keys failed (`crates/gateway-s3/src/lib.rs:2293-2300`),
+    // so the status says nothing about the keys.
+    if !result.errors.is_empty() {
+        let rows: Vec<String> = result
+            .errors
+            .iter()
+            .map(|e| format!("{} ({})", e.key, e.code))
+            .collect();
+        let rows = rows.join(", ");
+        return Err(protocol(format!(
+            "<Error> rows in the DeleteResult: {rows}"
+        )));
+    }
+    let mut deleted = result.deleted.clone();
+    deleted.sort();
+    if deleted != requested {
+        // A key missing, extra or named twice.
+        return Err(protocol(format!(
+            "<Deleted> names {deleted:?}; requested {requested:?}"
+        )));
+    }
+    Ok(())
+}
+
+/// A strong entity-tag (RFC 9110 §8.8.3): `"` etagc* `"`, etagc = `%x21 / %x23-7E / obs-text`.
+pub fn is_strong_etag(value: &str) -> bool {
+    let bytes = value.as_bytes();
+    bytes.len() >= 2
+        && bytes[0] == b'"'
+        && bytes[bytes.len() - 1] == b'"'
+        && bytes[1..bytes.len() - 1]
+            .iter()
+            .all(|&b| b == 0x21 || (0x23..=0x7E).contains(&b) || b >= 0x80)
+}
+
+/// `bytes first-last/size` (RFC 9110 §14.4): unit case-insensitive, numbers ASCII digits only.
+fn parse_content_range(value: &str) -> Option<(u64, u64, u64)> {
+    let (unit, rest) = value.split_once(' ')?;
+    if !unit.eq_ignore_ascii_case("bytes") {
+        return None;
+    }
+    let (range, size) = rest.split_once('/')?;
+    let (first, last) = range.split_once('-')?;
+    let digits = |s: &str| {
+        if !s.is_empty() && s.bytes().all(|b| b.is_ascii_digit()) {
+            s.parse::<u64>().ok()
+        } else {
+            None
+        }
+    };
+    Some((digits(first)?, digits(last)?, digits(size)?))
+}
+
+// --- The run verdict ------------------------------------------------------------------------
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum Outcome {
+    Pass,
+    Fail,
+    Inconclusive,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Fatal {
+    pub operation: Operation,
+    pub class: FailureClass,
+    pub detail: String,
+}
+
+/// Why a row is not proved; `Undeclared`: exercised, but the profile declares no row for it.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum Unproved {
+    NotExercised,
+    NoAnswer { why: String },
+    Unsettled { why: String },
+    Undeclared,
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct NotCovered {
+    pub operation: Operation,
+    pub issue: u32,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct RunVerdict {
+    pub outcome: Outcome,
+    /// Every `required` or `unsupported` row whose every exercise passed, in profile order.
+    pub proved: Vec<Operation>,
+    /// Every fatal result, in exercise order.
+    pub fatal: Vec<Fatal>,
+    /// Every row not proved, with the first reason found.
+    pub unproved: Vec<(Operation, Unproved)>,
+    /// Every `supported, not checked` row, exercised or not.
+    pub not_covered: Vec<NotCovered>,
+}
+
+/// Any fatal result ⇒ FAIL; else any `required` or `unsupported` row not exercised, or with an
+/// exercise that got no answer or was not settled ⇒ INCONCLUSIVE; else PASS, if at least one
+/// row was proved (a profile with no row to prove is INCONCLUSIVE: 0017's vacuity gate).
+pub fn verdict(profile: &Profile, exercises: &[Exercise]) -> RunVerdict {
+    let mut fatal = Vec::new();
+    let mut unproved: Vec<(Operation, Unproved)> = Vec::new();
+    let mut note = |operation: Operation, why: Unproved| {
+        if !unproved.iter().any(|(op, _)| *op == operation) {
+            unproved.push((operation, why));
+        }
+    };
+    for exercise in exercises {
+        let operation = exercise.operation();
+        let Some(row) = profile.row(operation) else {
+            note(operation, Unproved::Undeclared);
+            continue;
+        };
+        match classify(row, exercise) {
+            RowResult::Pass | RowResult::NotChecked { .. } => {}
+            RowResult::Fatal { class, detail } => fatal.push(Fatal {
+                operation,
+                class,
+                detail,
+            }),
+            RowResult::NoAnswer { why } => note(operation, Unproved::NoAnswer { why }),
+            RowResult::Unsettled { why } => note(operation, Unproved::Unsettled { why }),
+        }
+    }
+    let mut not_covered = Vec::new();
+    for row in profile.rows() {
+        match row.expected {
+            Expected::SupportedNotChecked { issue } => not_covered.push(NotCovered {
+                operation: row.operation,
+                issue,
+            }),
+            Expected::Required | Expected::Unsupported { .. } => {
+                if !exercises.iter().any(|e| e.operation() == row.operation) {
+                    note(row.operation, Unproved::NotExercised);
+                }
+            }
+        }
+    }
+    // A checked row not noted unproved was exercised, and is proved unless an exercise failed.
+    let proved: Vec<Operation> = profile
+        .rows()
+        .iter()
+        .filter(|row| !matches!(row.expected, Expected::SupportedNotChecked { .. }))
+        .map(|row| row.operation)
+        .filter(|op| {
+            !unproved.iter().any(|(o, _)| o == op) && !fatal.iter().any(|f| f.operation == *op)
+        })
+        .collect();
+    let outcome = if !fatal.is_empty() {
+        Outcome::Fail
+    } else if !unproved.is_empty() || proved.is_empty() {
+        Outcome::Inconclusive
+    } else {
+        Outcome::Pass
+    };
+    RunVerdict {
+        outcome,
+        proved,
+        fatal,
+        unproved,
+        not_covered,
+    }
+}
