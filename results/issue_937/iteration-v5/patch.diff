+//! The capability matrix (proposal 0017 §3, §7; #937): today's profile, the classification of
+//! every row state, version keying, and the run verdict. Pure: every leg calls the production
+//! `wyrd_validate::matrix` functions with a fixed input. No network, no second process.
+
+#![forbid(unsafe_code)]
+
+use wyrd_validate::matrix::{
+    classify, is_strong_etag, parse_version, select, select_reported, verdict, Answer, Body, Bound,
+    DeclaredCode, DeleteFailure, DeleteResult, Exercise, Expected, FailureClass, Listed, NoProfile,
+    Operation, Outcome, PreId, Profile, Release, ReportedVersion, Response, Row, RowResult,
+    Unproved, VersionRange, PRE_0_1, PROFILES,
+};
+use wyrd_validate::ErrorCode;
+
+// ---------------------------------------------------------------------------------------------
+// Fixtures
+// ---------------------------------------------------------------------------------------------
+
+const OBJECT: &[u8] = b"0123456789abcdef";
+const ETAG: &str = "\"d41d8cd98f00b204e9800998ecf8427e\"";
+
+fn resp(status: u16) -> Response {
+    Response::new(status)
+}
+
+fn ans(response: Response) -> Answer {
+    Answer::Response(response)
+}
+
+fn no_answer() -> Answer {
+    Answer::NoAnswer {
+        why: "timed out before a response head".to_string(),
+    }
+}
+
+fn code(c: &str) -> ErrorCode {
+    ErrorCode::Code(c.to_string())
+}
+
+fn refusal(status: u16, c: &str) -> Answer {
+    ans(resp(status).with_error_code(code(c)))
+}
+
+fn row(op: Operation) -> &'static Row {
+    PRE_0_1.row(op).expect("pre-0.1 declares the row")
+}
+
+fn class_of(result: &RowResult) -> Option<FailureClass> {
+    match result {
+        RowResult::Fatal { class, .. } => Some(*class),
+        _ => None,
+    }
+}
+
+fn put(answer: Answer, ended: bool) -> Exercise {
+    Exercise::PutObject {
+        answer,
+        request_body_ended: ended,
+    }
+}
+
+fn good_put() -> Exercise {
+    put(ans(resp(200).with_etag(ETAG)), true)
+}
+
+fn keys() -> Vec<String> {
+    vec!["p/a".to_string(), "p/b".to_string()]
+}
+
+fn listing() -> Vec<Listed> {
+    vec![
+        Listed {
+            key: "p/a".to_string(),
+            size: 16,
+        },
+        Listed {
+            key: "p/b".to_string(),
+            size: 3,
+        },
+    ]
+}
+
+fn delete_objects(answer: Answer, follow_ups: Vec<(String, Answer)>) -> Exercise {
+    Exercise::DeleteObjects {
+        keys: keys(),
+        answer,
+        follow_ups,
+    }
+}
+
+fn deleted_all() -> Answer {
+    ans(resp(200).with_body(Body::DeleteResult(DeleteResult {
+        deleted: keys(),
+        errors: vec![],
+    })))
+}
+
+fn heads(a: Answer, b: Answer) -> Vec<(String, Answer)> {
+    vec![("p/a".to_string(), a), ("p/b".to_string(), b)]
+}
+
+fn failed() -> Body {
+    Body::Failed {
+        why: "connection reset after the head".to_string(),
+    }
+}
+
+/// A `DeleteObjects` of `keys` whose document names every one under `<Deleted>`, then one
+/// follow-up `HEAD` per `(key, status)`, in that order.
+fn bulk(keys: &[&str], heads: &[(&str, u16)]) -> Exercise {
+    let keys: Vec<String> = keys.iter().map(|k| k.to_string()).collect();
+    Exercise::DeleteObjects {
+        answer: ans(resp(200).with_body(Body::DeleteResult(DeleteResult {
+            deleted: keys.clone(),
+            errors: vec![],
+        }))),
+        keys,
+        follow_ups: heads
+            .iter()
+            .map(|(k, s)| (k.to_string(), ans(resp(*s))))
+            .collect(),
+    }
+}
+
+/// One passing exercise for every row of `pre-0.1`, unsupported rows answering exactly as
+/// declared. Each test replaces one entry to isolate the leg it judges.
+fn passing_run() -> Vec<Exercise> {
+    let mut run = vec![
+        good_put(),
+        Exercise::GetObject {
+            object: OBJECT.to_vec(),
+            answer: ans(resp(200).with_body(Body::Bytes(OBJECT.to_vec()))),
+        },
+        Exercise::GetObjectRanged {
+            object: OBJECT.to_vec(),
+            first: 2,
+            last: 5,
+            answer: ans(resp(206)
+                .with_content_range("bytes 2-5/16")
+                .with_body(Body::Bytes(OBJECT[2..=5].to_vec()))),
+        },
+        Exercise::GetObjectIfNoneMatchHit {
+            answer: ans(resp(304)),
+        },
+        Exercise::GetObjectIfNoneMatchMiss {
+            object: OBJECT.to_vec(),
+            answer: ans(resp(200).with_body(Body::Bytes(OBJECT.to_vec()))),
+        },
+        Exercise::HeadObject {
+            size: 16,
+            etag: ETAG.to_string(),
+            answer: ans(resp(200).with_content_length(16).with_etag(ETAG)),
+        },
+        Exercise::DeleteObject {
+            answer: ans(resp(204)),
+            follow_up: ans(resp(404)),
+        },
+        delete_objects(deleted_all(), heads(ans(resp(404)), ans(resp(404)))),
+        Exercise::ListObjectsV2 {
+            expected: listing(),
+            answer: ans(resp(200).with_body(Body::Listing(listing()))),
+        },
+        Exercise::ListObjects {
+            expected: listing(),
+            answer: ans(resp(200).with_body(Body::Listing(listing()))),
+        },
+    ];
+    for r in PRE_0_1.rows() {
+        if let Expected::Unsupported { status, code, .. } = r.expected {
+            let response = match code {
+                DeclaredCode::Code(c) => resp(status).with_error_code(ErrorCode::Code(c.into())),
+                DeclaredCode::NoBody => resp(status).with_error_code(ErrorCode::NoBody),
+            };
+            run.push(Exercise::Other {
+                operation: r.operation,
+                answer: ans(response),
+            });
+        }
+    }
+    run
+}
+
+fn replace(run: &mut [Exercise], exercise: Exercise) {
+    let op = exercise.operation();
+    let slot = run
+        .iter_mut()
+        .find(|e| e.operation() == op)
+        .expect("the run exercises the row");
+    *slot = exercise;
+}
+
+/// The run verdict when exactly one exercise of the passing run is replaced.
+fn verdict_with(exercise: Exercise) -> wyrd_validate::matrix::RunVerdict {
+    let mut run = passing_run();
+    replace(&mut run, exercise);
+    verdict(&PRE_0_1, &run)
+}
+
+fn assert_fails_with(exercise: Exercise, class: FailureClass) {
+    let op = exercise.operation();
+    let v = verdict_with(exercise);
+    assert_eq!(v.outcome, Outcome::Fail, "{v}");
+    assert_eq!(v.fatal.len(), 1, "{v}");
+    assert_eq!(v.fatal[0].operation, op, "{v}");
+    assert_eq!(v.fatal[0].class, class, "{v}");
+}
+
+fn assert_inconclusive_on(exercise: Exercise) {
+    let op = exercise.operation();
+    let v = verdict_with(exercise);
+    assert_eq!(v.outcome, Outcome::Inconclusive, "{v}");
+    assert!(v.fatal.is_empty(), "{v}");
+    assert_eq!(v.unproved.len(), 1, "{v}");
+    assert_eq!(v.unproved[0].0, op, "{v}");
+    assert!(matches!(v.unproved[0].1, Unproved::Unsettled { .. }), "{v}");
+}
+
