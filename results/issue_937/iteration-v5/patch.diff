+// ---------------------------------------------------------------------------------------------
+// Versions
+// ---------------------------------------------------------------------------------------------
+
+/// One dot-separated pre-release identifier.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum PreId {
+    Numeric(u64),
+    Alpha(String),
+}
+
+/// A release version: `MAJOR.MINOR.PATCH` with any pre-release. Build metadata is not part of
+/// it: it never changes which profile a version selects.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Release {
+    pub major: u64,
+    pub minor: u64,
+    pub patch: u64,
+    pub pre: Vec<PreId>,
+}
+
+impl Release {
+    /// SemVer precedence against a bound, which has no pre-release: on the same triple a
+    /// pre-release sorts before the release itself (SemVer 2.0.0 §11).
+    fn cmp_bound(&self, bound: Bound) -> Ordering {
+        (self.major, self.minor, self.patch)
+            .cmp(&(bound.major, bound.minor, bound.patch))
+            .then(if self.pre.is_empty() {
+                Ordering::Equal
+            } else {
+                Ordering::Less
+            })
+    }
+}
+
+impl fmt::Display for Release {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        write!(f, "{}.{}.{}", self.major, self.minor, self.patch)?;
+        for (i, id) in self.pre.iter().enumerate() {
+            f.write_str(if i == 0 { "-" } else { "." })?;
+            match id {
+                PreId::Numeric(n) => write!(f, "{n}")?,
+                PreId::Alpha(s) => f.write_str(s)?,
+            }
+        }
+        Ok(())
+    }
+}
+
+/// What a reported version says.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum ReportedVersion {
+    Release(Release),
+    /// The server does not know its own version: the gateway's default (`unknown`,
+    /// `crates/gateway-s3/src/lib.rs:121`), or a build whose identity is the "nothing was
+    /// known" fallback `+git.unknown[.dirty]` (`crates/server/src/version/derivation.rs:65`).
+    /// Never read as release `0.0.0`.
+    Unknown,
+}
+
+/// Why a reported version could not be read.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct VersionError {
+    pub input: String,
+    pub reason: &'static str,
+}
+
+impl fmt::Display for VersionError {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        write!(f, "cannot read version {:?}: {}", self.input, self.reason)
+    }
+}
+
+impl std::error::Error for VersionError {}
+
+/// The gateway's "not told" version (`crates/gateway-s3/src/lib.rs:121`).
+const UNKNOWN: &str = "unknown";
+
+/// The build-metadata identities the version derivation gives when nothing was known
+/// (`crates/server/src/version/derivation.rs:65`, the `Fallback` rung at `:121`).
+const UNKNOWN_BUILDS: [&str; 2] = ["git.unknown", "git.unknown.dirty"];
+
+/// Read a reported version: `unknown`, or `MAJOR.MINOR.PATCH[-PRE][+BUILD]` by the SemVer 2.0.0
+/// grammar, every token checked (digits only, no leading zeros in numeric identifiers, no empty
+/// identifiers, identifier characters `[0-9A-Za-z-]`). The shapes the server's derivation emits
+/// (`normalize_describe`, `crates/server/src/version/derivation.rs:30-41`) are `0.0.0+git.<sha>
+/// [.dirty]`, `0.1.0`, and `0.1.0+git.3.<sha>[.dirty]`.
+pub fn parse_version(input: &str) -> Result<ReportedVersion, VersionError> {
+    let err = |reason| VersionError {
+        input: input.to_string(),
+        reason,
+    };
+    if input == UNKNOWN {
+        return Ok(ReportedVersion::Unknown);
+    }
+    let (release_part, build) = match input.split_once('+') {
+        Some((release, build)) => (release, Some(build)),
+        None => (input, None),
+    };
+    if let Some(build) = build {
+        let ok = build
+            .split('.')
+            .all(|id| !id.is_empty() && id.bytes().all(is_ident_byte));
+        if !ok {
+            return Err(err("malformed build metadata"));
+        }
+    }
+    let (core, pre) = match release_part.split_once('-') {
+        Some((core, pre)) => (core, Some(pre)),
+        None => (release_part, None),
+    };
+    let mut numbers = core.split('.');
+    let (Some(major), Some(minor), Some(patch), None) = (
+        numbers.next(),
+        numbers.next(),
+        numbers.next(),
+        numbers.next(),
+    ) else {
+        return Err(err("expected MAJOR.MINOR.PATCH"));
+    };
+    let number = |s: &str| parse_numeric(s).ok_or_else(|| err("malformed version number"));
+    let (major, minor, patch) = (number(major)?, number(minor)?, number(patch)?);
+    let mut pre_ids = Vec::new();
+    if let Some(pre) = pre {
+        for id in pre.split('.') {
+            if id.is_empty() || !id.bytes().all(is_ident_byte) {
+                return Err(err("malformed pre-release"));
+            }
+            if id.bytes().all(|b| b.is_ascii_digit()) {
+                pre_ids.push(PreId::Numeric(
+                    parse_numeric(id).ok_or_else(|| err("malformed pre-release"))?,
+                ));
+            } else {
+                pre_ids.push(PreId::Alpha(id.to_string()));
+            }
+        }
+    }
+    if build.is_some_and(|build| UNKNOWN_BUILDS.contains(&build)) {
+        return Ok(ReportedVersion::Unknown);
+    }
+    Ok(ReportedVersion::Release(Release {
+        major,
+        minor,
+        patch,
+        pre: pre_ids,
+    }))
+}
+
+fn is_ident_byte(b: u8) -> bool {
+    b.is_ascii_alphanumeric() || b == b'-'
+}
+
+/// A SemVer numeric identifier: ASCII digits, no leading zero unless it is `0`, fits a `u64`.
+/// The digit check refuses the `+` sign `u64::from_str` would take; `from_str` refuses the
+/// empty string and a value past `u64::MAX`.
+fn parse_numeric(s: &str) -> Option<u64> {
+    if !s.bytes().all(|b| b.is_ascii_digit()) || (s.len() > 1 && s.starts_with('0')) {
+        return None;
+    }
+    s.parse().ok()
+}
+
+/// Why no profile was selected.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum NoProfile {
+    /// The server does not know its version.
+    Unknown,
+    /// The version could not be read.
+    Unparsable(VersionError),
+    /// No profile covers this release.
+    NoMatch(Release),
+    /// More than one profile covers it: the table is wrong, and picking one would be a guess.
+    Ambiguous(Release),
+}
+
+impl fmt::Display for NoProfile {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            Self::Unknown => f.write_str("the server's version is unknown"),
+            Self::Unparsable(e) => write!(f, "{e}"),
+            Self::NoMatch(r) => write!(f, "no profile covers release {r}"),
+            Self::Ambiguous(r) => write!(f, "more than one profile covers release {r}"),
+        }
+    }
+}
+
+/// The one profile in `profiles` whose range covers `version`.
+pub fn select<'a>(
+    profiles: &'a [Profile],
+    version: &ReportedVersion,
+) -> Result<&'a Profile, NoProfile> {
+    let release = match version {
+        ReportedVersion::Unknown => return Err(NoProfile::Unknown),
+        ReportedVersion::Release(release) => release,
+    };
+    let mut covering = profiles.iter().filter(|p| p.range.contains(release));
+    match (covering.next(), covering.next()) {
+        (Some(profile), None) => Ok(profile),
+        (None, _) => Err(NoProfile::NoMatch(release.clone())),
+        (Some(_), Some(_)) => Err(NoProfile::Ambiguous(release.clone())),
+    }
+}
+
+/// [`parse_version`] then [`select`].
+pub fn select_reported<'a>(profiles: &'a [Profile], input: &str) -> Result<&'a Profile, NoProfile> {
+    let version = parse_version(input).map_err(NoProfile::Unparsable)?;
+    select(profiles, &version)
+}
+
+// ---------------------------------------------------------------------------------------------
+// Observations
+// ---------------------------------------------------------------------------------------------
+
+/// What came back for one request.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum Answer {
+    /// No response head arrived: no connection, a reset, a timeout before the head.
+    NoAnswer {
+        why: String,
+    },
+    Response(Response),
+}
+
+/// A response head and what followed it.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Response {
+    pub status: u16,
+    pub etag: Option<String>,
+    pub content_range: Option<String>,
+    pub content_length: Option<u64>,
+    /// The S3 error code of an error response, as the client read it; `None` on a success.
+    pub error_code: Option<ErrorCode>,
+    pub body: Body,
+}
+
+impl Response {
+    /// A response with `status`, no headers the checks read, no error code and no body.
+    pub fn new(status: u16) -> Self {
+        Self {
+            status,
+            etag: None,
+            content_range: None,
+            content_length: None,
+            error_code: None,
+            body: Body::Empty,
+        }
+    }
+
+    pub fn with_etag(mut self, etag: &str) -> Self {
+        self.etag = Some(etag.to_string());
+        self
+    }
+
+    pub fn with_content_range(mut self, content_range: &str) -> Self {
+        self.content_range = Some(content_range.to_string());
+        self
+    }
+
+    pub fn with_content_length(mut self, content_length: u64) -> Self {
+        self.content_length = Some(content_length);
+        self
+    }
+
+    pub fn with_error_code(mut self, code: ErrorCode) -> Self {
+        self.error_code = Some(code);
+        self
+    }
+
+    pub fn with_body(mut self, body: Body) -> Self {
+        self.body = body;
+        self
+    }
+
+    fn is_success(&self) -> bool {
+        (200..300).contains(&self.status)
+    }
+}
+
+/// The body of a response, as far as it arrived.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum Body {
+    /// No body bytes.
+    Empty,
+    Bytes(Vec<u8>),
+    /// A listing document, every page together: each key with its size.
+    Listing(Vec<Listed>),
+    /// A `<DeleteResult>` document (requested without `Quiet`).
+    DeleteResult(DeleteResult),
+    /// The head arrived and the body then failed or timed out.
+    Failed {
+        why: String,
+    },
+}
+
+/// One `<Contents>` entry of a listing.
+#[derive(Debug, Clone, PartialEq, Eq, PartialOrd, Ord)]
+pub struct Listed {
+    pub key: String,
+    pub size: u64,
+}
+
+/// A bulk delete's `<DeleteResult>`: the keys under `<Deleted>`, and each `<Error>` row.
+#[derive(Debug, Clone, PartialEq, Eq, Default)]
+pub struct DeleteResult {
+    pub deleted: Vec<String>,
+    pub errors: Vec<DeleteFailure>,
+}
+
+/// One `<Error>` row of a `<DeleteResult>`.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct DeleteFailure {
+    pub key: String,
+    pub code: String,
+}
+
+/// One exercise of one row: what was asked, what the oracle expects, and every answer the
+/// check reads. A check that needs more than one request (a delete and its follow-up `HEAD`s)
+/// carries each follow-up as an answer of its own.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum Exercise {
+    PutObject {
+        answer: Answer,
+        /// Whether the request body had ended when the response head arrived. A success
+        /// before that is not a receipt (the client's `BodyError::AcknowledgedEarly`).
+        request_body_ended: bool,
+    },
+    GetObject {
+        object: Vec<u8>,
+        answer: Answer,
+    },
+    /// `Range: bytes=first-last` of `object`.
+    GetObjectRanged {
+        object: Vec<u8>,
+        first: u64,
+        last: u64,
+        answer: Answer,
+    },
+    GetObjectIfNoneMatchHit {
+        answer: Answer,
+    },
+    GetObjectIfNoneMatchMiss {
+        object: Vec<u8>,
+        answer: Answer,
+    },
+    HeadObject {
+        size: u64,
+        /// The `ETag` the PUT answered.
+        etag: String,
+        answer: Answer,
+    },
+    DeleteObject {
+        answer: Answer,
+        /// The `HEAD` of the key sent after the delete answered.
+        follow_up: Answer,
+    },
+    DeleteObjects {
+        keys: Vec<String>,
+        answer: Answer,
+        /// The `HEAD`s sent after the delete answered, each with the key it asked about. A key
+        /// may be probed more than once (a retry); every entry is judged.
+        follow_ups: Vec<(String, Answer)>,
+    },
+    ListObjectsV2 {
+        /// Every key written under the listed prefix, with its size.
+        expected: Vec<Listed>,
+        answer: Answer,
+    },
+    ListObjects {
+        expected: Vec<Listed>,
+        answer: Answer,
+    },
+    /// An operation with no check of its own: one whose row is `unsupported`, where only the
+    /// refusal is judged.
+    Other {
+        operation: Operation,
+        answer: Answer,
+    },
+}
+
+impl Exercise {
+    pub fn operation(&self) -> Operation {
+        match self {
+            Self::PutObject { .. } => Operation::PutObject,
+            Self::GetObject { .. } => Operation::GetObject,
+            Self::GetObjectRanged { .. } => Operation::GetObjectRanged,
+            Self::GetObjectIfNoneMatchHit { .. } => Operation::GetObjectIfNoneMatchHit,
+            Self::GetObjectIfNoneMatchMiss { .. } => Operation::GetObjectIfNoneMatchMiss,
+            Self::HeadObject { .. } => Operation::HeadObject,
+            Self::DeleteObject { .. } => Operation::DeleteObject,
+            Self::DeleteObjects { .. } => Operation::DeleteObjects,
+            Self::ListObjectsV2 { .. } => Operation::ListObjectsV2,
+            Self::ListObjects { .. } => Operation::ListObjects,
+            Self::Other { operation, .. } => *operation,
+        }
+    }
+
+    /// The answer to the operation itself (not to a follow-up).
+    pub fn answer(&self) -> &Answer {
+        match self {
+            Self::PutObject { answer, .. }
+            | Self::GetObject { answer, .. }
+            | Self::GetObjectRanged { answer, .. }
+            | Self::GetObjectIfNoneMatchHit { answer }
+            | Self::GetObjectIfNoneMatchMiss { answer, .. }
+            | Self::HeadObject { answer, .. }
+            | Self::DeleteObject { answer, .. }
+            | Self::DeleteObjects { answer, .. }
+            | Self::ListObjectsV2 { answer, .. }
+            | Self::ListObjects { answer, .. }
+            | Self::Other { answer, .. } => answer,
+        }
+    }
+}
+
+// ---------------------------------------------------------------------------------------------
+// Classification
+// ---------------------------------------------------------------------------------------------
+
+/// The fatal classes of proposal 0017 §7. (`availability` is budgeted, not fatal; an answer
+/// of that shape leaves a row [`RowResult::Unsettled`] here.)
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum FailureClass {
+    /// Bytes, digest or size differ.
+    Integrity,
+    /// The model and the server disagree (a deleted key readable, a listing mismatch).
+    Oracle,
+    /// An `unsupported` operation succeeded.
+    UnexpectedSupport,
+    /// Wrong status, error code, or document shape.
+    Protocol,
+}
+
+impl FailureClass {
+    pub fn name(self) -> &'static str {
+        match self {
+            Self::Integrity => "integrity",
+            Self::Oracle => "oracle",
+            Self::UnexpectedSupport => "unexpected-support",
+            Self::Protocol => "protocol",
+        }
+    }
+}
+
+impl fmt::Display for FailureClass {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.write_str(self.name())
+    }
+}
+
+/// The result of one exercise of one row.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum RowResult {
+    Pass,
+    Fatal {
+        class: FailureClass,
+        detail: String,
+    },
+    /// No response head arrived: nothing to judge.
+    NoAnswer {
+        why: String,
+    },
+    /// The row cannot be settled: a body cut off after its head, a 5xx, a follow-up probe that
+    /// got no answer, or an exercise that cannot show anything about the row.
+    Unsettled {
+        why: String,
+    },
+    /// The row is `supported, not checked (#issue)`: whatever came back, it is not a pass.
+    NotChecked {
+        issue: u32,
+    },
+}
+
+fn fatal(class: FailureClass, detail: impl Into<String>) -> RowResult {
+    RowResult::Fatal {
+        class,
+        detail: detail.into(),
+    }
+}
+
+fn protocol(detail: impl Into<String>) -> RowResult {
+    fatal(FailureClass::Protocol, detail)
+}
+
+fn unsettled(why: impl Into<String>) -> RowResult {
+    RowResult::Unsettled { why: why.into() }
+}
+
+/// Judge one exercise of `row`. The exercise must be of `row.operation`; one that is not is
+/// unsettled (it shows nothing about the row).
+pub fn classify(row: &Row, exercise: &Exercise) -> RowResult {
+    if exercise.operation() != row.operation {
+        return unsettled(format!(
+            "an exercise of {} cannot settle the {} row",
+            exercise.operation(),
+            row.operation
+        ));
+    }
+    match row.expected {
+        Expected::SupportedNotChecked { issue } => RowResult::NotChecked { issue },
+        Expected::Unsupported { status, code, .. } => {
+            classify_unsupported(status, code, exercise.answer())
+        }
+        Expected::Required => classify_required(exercise),
+    }
+}
+
+fn classify_unsupported(status: u16, code: DeclaredCode, answer: &Answer) -> RowResult {
+    let response = match answer {
+        Answer::NoAnswer { why } => return RowResult::NoAnswer { why: why.clone() },
+        Answer::Response(response) => response,
+    };
+    // Any 2xx is support, however the body then ended: the server started doing it.
+    if response.is_success() {
+        return fatal(
+            FailureClass::UnexpectedSupport,
+            format!("answered {}; declared {status} {code}", response.status),
+        );
+    }
+    if response.status != status {
+        return protocol(format!(
+            "answered {}; declared {status} {code}",
+            response.status
+        ));
+    }
+    if let Body::Failed { why } = &response.body {
+        return unsettled(format!(
+            "the {status} error body failed before its code could be read: {why}"
+        ));
+    }
+    if code.matches(response.error_code.as_ref()) {
+        RowResult::Pass
+    } else {
+        protocol(format!(
+            "answered {status} with {}; declared {status} {code}",
+            match &response.error_code {
+                Some(observed) => observed.to_string(),
+                None => "no error code".to_string(),
+            }
+        ))
+    }
+}
+
+/// The first steps of every required check: no head is no answer, and a 5xx other than
+/// `501 Not Implemented` is `availability` (budgeted, §7), which settles nothing here.
+fn required_response(answer: &Answer) -> Result<&Response, RowResult> {
+    match answer {
+        Answer::NoAnswer { why } => Err(RowResult::NoAnswer { why: why.clone() }),
+        Answer::Response(r) if (500..600).contains(&r.status) && r.status != 501 => {
+            Err(unsettled(format!("availability: answered {}", r.status)))
+        }
+        Answer::Response(r) => Ok(r),
+    }
+}
+
+fn expect_status(response: &Response, want: u16) -> Result<(), RowResult> {
+    if response.status == want {
+        Ok(())
+    } else {
+        Err(protocol(format!(
+            "answered {}; expected {want}",
+            response.status
+        )))
+    }
+}
+
+/// The body as bytes. A body cut off in transport settles nothing; a document where bytes were
+/// expected is the wrong shape.
+fn body_bytes(response: &Response) -> Result<&[u8], RowResult> {
+    match &response.body {
+        Body::Empty => Ok(&[]),
+        Body::Bytes(bytes) => Ok(bytes),
+        Body::Failed { why } => Err(unsettled(format!("the body failed: {why}"))),
+        Body::Listing(_) | Body::DeleteResult(_) => {
+            Err(protocol("a document where object bytes were expected"))
+        }
+    }
+}
+
+/// The body of an answer that carries none (a PUT's 200, a `HEAD`, a 204, a 304): nothing, or no
+/// bytes, passes. A body cut off in transport settles nothing (whether bytes arrived is not
+/// known); any bytes or document is the wrong shape.
+fn expect_no_body(response: &Response) -> Result<(), RowResult> {
+    match &response.body {
+        Body::Empty => Ok(()),
+        Body::Bytes(bytes) if bytes.is_empty() => Ok(()),
+        Body::Failed { why } => Err(unsettled(format!("the body failed: {why}"))),
+        Body::Bytes(_) | Body::Listing(_) | Body::DeleteResult(_) => Err(protocol(format!(
+            "answered {} with a body",
+            response.status
+        ))),
+    }
+}
+
+/// Fold a row's independent checks: a fatal result outranks one that cannot settle, which
+/// outranks a pass. Every check is judged; none is skipped because another already failed.
+fn worst(checks: impl IntoIterator<Item = Result<(), RowResult>>) -> Result<(), RowResult> {
+    let mut first_unsettled = None;
+    for check in checks {
+        match check {
+            Ok(()) => {}
+            Err(fatal @ RowResult::Fatal { .. }) => return Err(fatal),
+            Err(other) => {
+                first_unsettled.get_or_insert(other);
+            }
+        }
+    }
+    first_unsettled.map_or(Ok(()), Err)
+}
+
+fn expect_bytes(response: &Response, want: &[u8]) -> Result<(), RowResult> {
+    let got = body_bytes(response)?;
+    if got == want {
+        return Ok(());
+    }
+    let at = got
+        .iter()
+        .zip(want)
+        .position(|(a, b)| a != b)
+        .unwrap_or(got.len().min(want.len()));
+    Err(fatal(
+        FailureClass::Integrity,
+        format!(
+            "body of {} bytes differs from the expected {} bytes at offset {at}",
+            got.len(),
+            want.len()
+        ),
+    ))
+}
+
+fn classify_required(exercise: &Exercise) -> RowResult {
+    match check_required(exercise) {
+        Ok(()) => RowResult::Pass,
+        Err(result) => result,
+    }
+}
+
+fn check_required(exercise: &Exercise) -> Result<(), RowResult> {
+    match exercise {
+        Exercise::PutObject {
+            answer,
+            request_body_ended,
+        } => {
+            let r = required_response(answer)?;
+            expect_status(r, 200)?;
+            if !request_body_ended {
+                return Err(protocol(
+                    "answered 200 before the request body had ended: not a receipt",
+                ));
+            }
+            match r.etag.as_deref() {
+                Some(etag) if is_strong_etag(etag) => {}
+                Some(etag) => {
+                    return Err(protocol(format!(
+                        "ETag {etag:?} is not a strong entity-tag (RFC 9110 §8.8.3)"
+                    )))
+                }
+                None => return Err(protocol("answered 200 with no ETag")),
+            }
+            // The head is a receipt only if the answer ended whole.
+            expect_no_body(r)
+        }
+        Exercise::GetObject { object, answer } => {
+            let r = required_response(answer)?;
+            expect_status(r, 200)?;
+            expect_bytes(r, object)
+        }
+        Exercise::GetObjectRanged {
+            object,
+            first,
+            last,
+            answer,
+        } => {
+            let size = object.len() as u64;
+            if first > last || *last >= size {
+                return Err(unsettled(format!(
+                    "the exercise asked bytes={first}-{last} of a {size}-byte object"
+                )));
+            }
+            let r = required_response(answer)?;
+            expect_status(r, 206)?;
+            let want = (*first, *last, size);
+            match r.content_range.as_deref() {
+                Some(value) if parse_content_range(value) == Some(want) => {}
+                Some(value) => {
+                    return Err(protocol(format!(
+                        "Content-Range {value:?}; expected \"bytes {first}-{last}/{size}\""
+                    )))
+                }
+                None => return Err(protocol("answered 206 with no Content-Range")),
+            }
+            // In range by the guard above, so the slice cannot panic.
+            let wanted = &object[*first as usize..=*last as usize];
+            expect_bytes(r, wanted)
+        }
+        Exercise::GetObjectIfNoneMatchHit { answer } => {
+            let r = required_response(answer)?;
+            expect_status(r, 304)?;
+            expect_no_body(r)
+        }
+        Exercise::GetObjectIfNoneMatchMiss { object, answer } => {
+            let r = required_response(answer)?;
+            expect_status(r, 200)?;
+            expect_bytes(r, object)
+        }
+        Exercise::HeadObject { size, etag, answer } => {
+            let r = required_response(answer)?;
+            expect_status(r, 200)?;
+            if r.content_length != Some(*size) {
+                return Err(fatal(
+                    FailureClass::Oracle,
+                    format!(
+                        "Content-Length {:?}; the object holds {size} bytes",
+                        r.content_length
+                    ),
+                ));
+            }
+            if r.etag.as_deref() != Some(etag.as_str()) {
+                return Err(fatal(
+                    FailureClass::Oracle,
+                    format!("ETag {:?}; the PUT answered {etag:?}", r.etag),
+                ));
+            }
+            expect_no_body(r)
+        }
+        Exercise::DeleteObject { answer, follow_up } => {
+            let r = required_response(answer)?;
+            expect_status(r, 204)?;
+            worst([expect_no_body(r), probe_deleted("the key", follow_up)])
+        }
+        Exercise::DeleteObjects {
+            keys,
+            answer,
+            follow_ups,
+        } => check_delete_objects(keys, answer, follow_ups),
+        Exercise::ListObjectsV2 { expected, answer }
+        | Exercise::ListObjects { expected, answer } => {
+            let r = required_response(answer)?;
+            expect_status(r, 200)?;
+            let listed = match &r.body {
+                Body::Listing(listed) => listed,
+                Body::Failed { why } => return Err(unsettled(format!("the body failed: {why}"))),
+                _ => return Err(protocol("answered 200 without a listing document")),
+            };
+            let mut got = listed.clone();
+            let mut want = expected.clone();
+            got.sort();
+            want.sort();
+            if got != want {
+                Err(fatal(
+                    FailureClass::Oracle,
+                    format!("listed {got:?}; wrote {want:?}"),
+                ))
+            } else if want.is_empty() {
+                Err(unsettled(
+                    "a listing of a prefix with nothing written proves nothing",
+                ))
+            } else {
+                Ok(())
+            }
+        }
+        Exercise::Other { operation, .. } => Err(unsettled(format!(
+            "{operation} is required and this tool has no check for it"
+        ))),
+    }
+}
+
+/// The follow-up `HEAD` of a deleted key is a probe (proposal 0017 §7): a 404 that ended whole
+/// proves the delete; a 2xx is `oracle` (a deleted key is readable); no answer, a 5xx or a cut-off
+/// answer cannot settle it; any other status is `protocol`.
+fn probe_deleted(what: &str, follow_up: &Answer) -> Result<(), RowResult> {
+    match follow_up {
+        Answer::NoAnswer { why } => Err(unsettled(format!(
+            "the HEAD of {what} after its delete got no answer: {why}"
+        ))),
+        Answer::Response(r) => match r.status {
+            404 => expect_no_body(r),
+            200..=299 => Err(fatal(
+                FailureClass::Oracle,
+                format!("{what} answers {} to a HEAD after its delete", r.status),
+            )),
+            500..=599 => Err(unsettled(format!(
+                "the HEAD of {what} after its delete answered {}",
+                r.status
+            ))),
+            other => Err(protocol(format!(
+                "the HEAD of {what} after its delete answered {other}; expected 404"
+            ))),
+        },
+    }
+}
+
+/// The document and every follow-up `HEAD` are separate checks, folded by [`worst`]: a document
+/// cut off in transport never excuses a probe, since after a `200` a requested key that still
+/// reads is fatal whatever the lost document said. Without a `200` no delete was acknowledged,
+/// so a readable key disagrees with nothing and the probes are not judged.
+fn check_delete_objects(
+    keys: &[String],
+    answer: &Answer,
+    follow_ups: &[(String, Answer)],
+) -> Result<(), RowResult> {
+    if keys.is_empty() {
+        return Err(unsettled("a DeleteObjects of no keys proves nothing"));
+    }
+    let r = required_response(answer)?;
+    expect_status(r, 200)?;
+    let mut requested = keys.to_vec();
+    requested.sort();
+    let mut checks = vec![check_delete_result(&requested, &r.body)];
+    requested.dedup();
+    // The document alone never proves a delete: a key is proved gone by a HEAD of it that
+    // answered 404. Every follow-up is judged: one naming a key the delete did not request
+    // settles nothing, and any fatal probe of a key fails the row even when another probe of
+    // the same key answered 404.
+    checks.extend(
+        follow_ups
+            .iter()
+            .filter(|(key, _)| !requested.contains(key))
+            .map(|(key, _)| {
+                Err(unsettled(format!(
+                    "a HEAD of key {key:?}, which the delete did not request, settles nothing"
+                )))
+            }),
+    );
+    for key in &requested {
+        let what = format!("key {key:?}");
+        let probes: Vec<_> = follow_ups
+            .iter()
+            .filter(|(probed, _)| probed == key)
+            .map(|(_, follow_up)| probe_deleted(&what, follow_up))
+            .collect();
+        let proved = probes.iter().any(Result::is_ok);
+        match worst(probes) {
+            Err(fatal @ RowResult::Fatal { .. }) => checks.push(Err(fatal)),
+            _ if proved => {}
+            Err(other) => checks.push(Err(other)),
+            Ok(()) => checks.push(Err(unsettled(format!(
+                "{what} was not probed after its delete"
+            )))),
+        }
+    }
+    worst(checks)
+}
+
+/// The `<DeleteResult>` of a bulk delete of `requested` (sorted): every key under `<Deleted>`
+/// and no `<Error>` row.
+fn check_delete_result(requested: &[String], body: &Body) -> Result<(), RowResult> {
+    if let Some(twice) = requested.windows(2).find(|w| w[0] == w[1]) {
+        // The document could then not be matched key by key.
+        return Err(unsettled(format!(
+            "the exercise requested key {:?} twice",
+            twice[0]
+        )));
+    }
+    let result = match body {
+        Body::DeleteResult(result) => result,
+        Body::Failed { why } => return Err(unsettled(format!("the body failed: {why}"))),
+        _ => return Err(protocol("answered 200 without a <DeleteResult> document")),
+    };
+    // The gateway answers 200 even when keys failed (`crates/gateway-s3/src/lib.rs:2293-2300`),
+    // so the status says nothing about the keys.
+    if !result.errors.is_empty() {
+        let rows: Vec<String> = result
+            .errors
+            .iter()
+            .map(|e| format!("{} ({})", e.key, e.code))
+            .collect();
+        return Err(protocol(format!(
+            "<Error> rows in the DeleteResult: {}",
+            rows.join(", ")
+        )));
+    }
+    let mut deleted = result.deleted.clone();
+    deleted.sort();
+    if deleted != requested {
+        return Err(protocol(format!(
+            "<Deleted> names {deleted:?}; requested {requested:?}"
+        )));
+    }
+    Ok(())
+}
+
+/// A strong entity-tag (RFC 9110 §8.8.3): `"` etagc* `"`, etagc = `%x21 / %x23-7E / obs-text`.
+/// So `*`, an unquoted value, a weak `W/"…"` tag, an empty value and a quote inside the tag are
+/// each refused.
+pub fn is_strong_etag(value: &str) -> bool {
+    let bytes = value.as_bytes();
+    bytes.len() >= 2
+        && bytes[0] == b'"'
+        && bytes[bytes.len() - 1] == b'"'
+        && bytes[1..bytes.len() - 1]
+            .iter()
+            .all(|&b| b == 0x21 || (0x23..=0x7E).contains(&b) || b >= 0x80)
+}
+
+/// `bytes first-last/size` (RFC 9110 §14.4): the unit case-insensitive, every number ASCII
+/// digits only. Anything else (an unsatisfied `*/size`, a sign, a space) is `None`.
+fn parse_content_range(value: &str) -> Option<(u64, u64, u64)> {
+    let (unit, rest) = value.split_once(' ')?;
+    if !unit.eq_ignore_ascii_case("bytes") {
+        return None;
+    }
+    let (range, size) = rest.split_once('/')?;
+    let (first, last) = range.split_once('-')?;
+    let digits = |s: &str| {
+        if !s.is_empty() && s.bytes().all(|b| b.is_ascii_digit()) {
+            s.parse::<u64>().ok()
+        } else {
+            None
+        }
+    };
+    Some((digits(first)?, digits(last)?, digits(size)?))
+}
+
+// ---------------------------------------------------------------------------------------------
+// The run verdict
+// ---------------------------------------------------------------------------------------------
+
+/// The run's outcome.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum Outcome {
+    Pass,
+    Fail,
+    Inconclusive,
+}
+
+impl fmt::Display for Outcome {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.write_str(match self {
+            Self::Pass => "PASS",
+            Self::Fail => "FAIL",
+            Self::Inconclusive => "INCONCLUSIVE",
+        })
+    }
+}
+
+/// A fatal row result.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Fatal {
+    pub operation: Operation,
+    pub class: FailureClass,
+    pub detail: String,
+}
+
+/// Why a `required` or `unsupported` row is not proved.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum Unproved {
+    /// Never exercised.
+    NotExercised,
+    /// Exercised, and no response head came back.
+    NoAnswer { why: String },
+    /// Exercised, and the answer could not settle the row.
+    Unsettled { why: String },
+    /// Exercised, but the profile declares no row for it: nothing says what it should answer.
+    Undeclared,
+}
+
+/// A `supported, not checked` row, with the issue that will add its check.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct NotCovered {
+    pub operation: Operation,
+    pub issue: u32,
+}
+
+/// The folded verdict of one run against one profile.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct RunVerdict {
+    pub outcome: Outcome,
+    /// Every fatal result, in exercise order.
+    pub fatal: Vec<Fatal>,
+    /// Every row not proved, with why (one entry per row: the first reason found).
+    pub unproved: Vec<(Operation, Unproved)>,
+    /// Every `supported, not checked` row: listed whether or not it was exercised.
+    pub not_covered: Vec<NotCovered>,
+}
+
+/// Fold a run: any fatal result ⇒ FAIL, naming every fatal row and its class; else any
+/// `required` or `unsupported` row that was not exercised, or that has an exercise with no
+/// answer or one that could not be settled ⇒ INCONCLUSIVE, naming those rows; else PASS. So a
+/// row is proved only when it was exercised and every exercise of it passed.
+pub fn verdict(profile: &Profile, exercises: &[Exercise]) -> RunVerdict {
+    let mut fatal = Vec::new();
+    let mut unproved: Vec<(Operation, Unproved)> = Vec::new();
+    let mut note = |operation: Operation, why: Unproved| {
+        if !unproved.iter().any(|(op, _)| *op == operation) {
+            unproved.push((operation, why));
+        }
+    };
+    for exercise in exercises {
+        let operation = exercise.operation();
+        let Some(row) = profile.row(operation) else {
+            note(operation, Unproved::Undeclared);
+            continue;
+        };
+        match classify(row, exercise) {
+            RowResult::Pass | RowResult::NotChecked { .. } => {}
+            RowResult::Fatal { class, detail } => fatal.push(Fatal {
+                operation,
+                class,
+                detail,
+            }),
+            RowResult::NoAnswer { why } => note(operation, Unproved::NoAnswer { why }),
+            RowResult::Unsettled { why } => note(operation, Unproved::Unsettled { why }),
+        }
+    }
+    let mut not_covered = Vec::new();
+    for row in profile.rows() {
+        match row.expected {
+            Expected::SupportedNotChecked { issue } => not_covered.push(NotCovered {
+                operation: row.operation,
+                issue,
+            }),
+            Expected::Required | Expected::Unsupported { .. } => {
+                if !exercises.iter().any(|e| e.operation() == row.operation) {
+                    note(row.operation, Unproved::NotExercised);
+                }
+            }
+        }
+    }
+    let outcome = if !fatal.is_empty() {
+        Outcome::Fail
+    } else if !unproved.is_empty() {
+        Outcome::Inconclusive
+    } else {
+        Outcome::Pass
+    };
+    RunVerdict {
+        outcome,
+        fatal,
+        unproved,
+        not_covered,
+    }
+}
+
+impl fmt::Display for RunVerdict {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        writeln!(f, "{}", self.outcome)?;
+        for fatal in &self.fatal {
+            writeln!(
+                f,
+                "  fatal: {}: {}: {}",
+                fatal.operation, fatal.class, fatal.detail
+            )?;
+        }
+        for (operation, why) in &self.unproved {
+            let why = match why {
+                Unproved::NotExercised => "not exercised".to_string(),
+                Unproved::NoAnswer { why } => format!("no answer: {why}"),
+                Unproved::Unsettled { why } => format!("not settled: {why}"),
+                Unproved::Undeclared => "no row declares it".to_string(),
+            };
+            writeln!(f, "  not proved: {operation}: {why}")?;
+        }
+        for row in &self.not_covered {
+            writeln!(
+                f,
+                "  not covered: {}: supported, not checked (#{})",
+                row.operation, row.issue
+            )?;
+        }
+        Ok(())
+    }
+}
