+#[test]
+fn each_version_selects_its_own_profile_and_expectations() {
+    let old = select_reported(TABLE, "0.9.3+git.2.abc").expect("0.9.3 selects");
+    let new = select_reported(TABLE, "1.4.0").expect("1.4.0 selects");
+    assert_eq!(old.name(), "old");
+    assert_eq!(new.name(), "new");
+    assert_eq!(
+        select_reported(TABLE, "1.0.0-rc.1").map(Profile::name),
+        Ok("old")
+    );
+    assert_eq!(
+        select_reported(TABLE, "1.0.0").map(Profile::name),
+        Ok("new")
+    );
+    // The same answer flips: a receipt to PutObject passes where it is required and is
+    // unexpected support where it is unsupported.
+    let same = good_put();
+    assert_eq!(
+        classify(new.row(Operation::PutObject).unwrap(), &same),
+        RowResult::Pass
+    );
+    assert_eq!(
+        class_of(&classify(old.row(Operation::PutObject).unwrap(), &same)),
+        Some(FailureClass::UnexpectedSupport)
+    );
+    let head = Exercise::HeadObject {
+        size: 16,
+        etag: ETAG.to_string(),
+        answer: ans(resp(200).with_content_length(16).with_etag(ETAG)),
+    };
+    assert_eq!(
+        verdict(new, &[same.clone(), head.clone()]).outcome,
+        Outcome::Pass
+    );
+    assert_eq!(verdict(old, &[same, head]).outcome, Outcome::Fail);
