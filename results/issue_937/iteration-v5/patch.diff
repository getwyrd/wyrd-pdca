+            ),
+            RowResult::NotChecked { issue: 750 }
+        );
+    }
+    let v = verdict(
+        &UNCHECKED,
+        &[
+            good_put(),
+            Exercise::Other {
+                operation: Operation::UploadPart,
+                answer: ans(resp(200)),
+            },
+        ],
+    );
+    assert_eq!(v.not_covered.len(), 1, "still not covered: {v}");
+}
+
+// ---------------------------------------------------------------------------------------------
+// (E) The run verdict
+// ---------------------------------------------------------------------------------------------
+
+#[test]
+fn any_fatal_fails_the_run_naming_every_fatal_row() {
+    let mut run = passing_run();
+    replace(&mut run, put(ans(resp(200).with_etag("*")), true));
+    replace(
+        &mut run,
+        Exercise::Other {
+            operation: Operation::CopyObject,
+            answer: ans(resp(200)),
+        },
+    );
+    // An unproved row does not soften a fatal one.
+    replace(
+        &mut run,
+        Exercise::DeleteObject {
+            answer: ans(resp(204)),
+            follow_up: no_answer(),
+        },
+    );
+    let v = verdict(&PRE_0_1, &run);
+    assert_eq!(v.outcome, Outcome::Fail, "{v}");
+    let fatal: Vec<_> = v.fatal.iter().map(|f| (f.operation, f.class)).collect();
+    assert_eq!(
+        fatal,
+        vec![
+            (Operation::PutObject, FailureClass::Protocol),
+            (Operation::CopyObject, FailureClass::UnexpectedSupport),
+        ]
+    );
+    let text = v.to_string();
+    assert!(text.starts_with("FAIL"), "{text}");
+    assert!(text.contains("PutObject: protocol"), "{text}");
+    assert!(text.contains("CopyObject: unexpected-support"), "{text}");
+}
+
+#[test]
+fn an_unexercised_row_makes_the_run_inconclusive() {
+    let mut run = passing_run();
+    run.retain(|e| e.operation() != Operation::ListBuckets);
+    let v = verdict(&PRE_0_1, &run);
+    assert_eq!(v.outcome, Outcome::Inconclusive, "{v}");
+    assert_eq!(
+        v.unproved,
+        vec![(Operation::ListBuckets, Unproved::NotExercised)]
+    );
+    assert!(v.to_string().contains("ListBuckets: not exercised"));
+}
+
+#[test]
+fn a_required_row_exercised_only_with_no_answer_is_inconclusive() {
+    let v = verdict_with(put(no_answer(), true));
+    assert_eq!(v.outcome, Outcome::Inconclusive, "{v}");
+    assert_eq!(v.unproved.len(), 1);
+    assert_eq!(v.unproved[0].0, Operation::PutObject);
+    assert!(matches!(v.unproved[0].1, Unproved::NoAnswer { .. }));
+}
+
+#[test]
+fn an_unresolved_delete_names_the_delete_row() {
+    let v = verdict_with(Exercise::DeleteObject {
+        answer: ans(resp(204)),
+        follow_up: no_answer(),
+    });
+    assert_eq!(v.outcome, Outcome::Inconclusive);
+    assert!(v.to_string().contains("not proved: DeleteObject"), "{v}");
+    let v = verdict_with(delete_objects(
+        deleted_all(),
+        heads(ans(resp(404)), no_answer()),
+    ));
+    assert!(v.to_string().contains("not proved: DeleteObjects"), "{v}");
+}
+
+#[test]
+fn an_empty_run_proves_nothing() {
+    let v = verdict(&PRE_0_1, &[]);
+    assert_eq!(v.outcome, Outcome::Inconclusive);
+    assert_eq!(v.unproved.len(), PRE_0_1.rows().len());
+}
+
+#[test]
+fn a_row_passes_only_when_every_exercise_of_it_passed() {
+    let mut run = passing_run();
+    run.push(put(no_answer(), true));
+    let v = verdict(&PRE_0_1, &run);
+    assert_eq!(v.outcome, Outcome::Inconclusive, "{v}");
+    assert_eq!(v.unproved[0].0, Operation::PutObject);
+}
