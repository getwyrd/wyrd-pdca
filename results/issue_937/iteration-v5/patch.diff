+#[test]
+fn every_follow_up_is_judged_against_the_key_it_asked_about() {
+    use FailureClass::Oracle;
+    // The readable key is the last: probes paired with the wrong keys would miss it.
+    let abc = ["p/a", "p/b", "p/c"];
+    assert_fails_with(
+        bulk(&abc, &[("p/a", 404), ("p/b", 404), ("p/c", 200)]),
+        Oracle,
+    );
+    // A key with no HEAD of its own is not proved by the HEADs of the others.
+    assert_inconclusive_on(bulk(&abc, &[("p/a", 404), ("p/b", 404)]));
+    // A later HEAD that reads a key is fatal, whatever an earlier HEAD of it said.
+    let ab = ["p/a", "p/b"];
+    assert_fails_with(
+        bulk(&ab, &[("p/a", 404), ("p/a", 200), ("p/b", 404)]),
+        Oracle,
+    );
+    // A retry that answers 404 proves what the first HEAD could not.
+    assert_eq!(
+        classify(
+            row(Operation::DeleteObjects),
+            &bulk(&ab, &[("p/a", 503), ("p/a", 404), ("p/b", 404)])
+        ),
+        RowResult::Pass
+    );
+    // A HEAD of a key the delete did not request settles nothing, alone or beside the others.
+    assert_inconclusive_on(bulk(&ab, &[("p/c", 404), ("p/c", 404)]));
+    assert_inconclusive_on(bulk(&ab, &[("p/a", 404), ("p/b", 404), ("p/c", 404)]));
+    // A key requested twice cannot be matched against the document key by key, but its probe
+    // is still judged.
+    assert_inconclusive_on(bulk(&["p/a", "p/a"], &[("p/a", 404)]));
+    assert_fails_with(bulk(&["p/a", "p/a"], &[("p/a", 200)]), Oracle);
+}
