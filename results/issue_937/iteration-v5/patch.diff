+//! The capability matrix (proposal 0017 §3) and the failure taxonomy that judges it (§7).
+//!
+//! Pure: nothing here sends a request, opens a socket or reads a clock. A scenario exercises
+//! the operations, maps what came back onto this module's own observation type ([`Answer`],
+//! [`Exercise`]), and hands that to [`classify`] and [`verdict`]. The client's error types
+//! never reach this module, so it judges the same facts whichever client produced them.
+//!
+//! Three pieces:
+//!
+//! * **Profiles.** A [`Profile`] declares, per [`Operation`], one of three states
+//!   ([`Expected`]): `required` (must succeed, and the answer must show it was done),
+//!   `unsupported(#NNN)` (must be refused with an exact status and S3 error code), or
+//!   `supported, not checked (#NNN)` (the server should accept it and the tool cannot check it
+//!   yet). Profiles are constants: [`PRE_0_1`] describes today's gateway, row by row, each row
+//!   citing the gateway line that gives today's answer.
+//! * **Version keying.** [`parse_version`] reads the version a server reports, and
+//!   [`select`] picks the one profile whose range covers it. "Version unknown" (the gateway's
+//!   `unknown`, or a build whose identity is `+git.unknown[.dirty]`) is never read as a
+//!   release: it selects no profile.
+//! * **Judging.** [`classify`] turns one exercise of one row into a [`RowResult`]; [`verdict`]
+//!   folds a run's results into PASS, FAIL or INCONCLUSIVE.
+//!
+//! The invariant: **the verdict never claims more than the answers prove.** An `unsupported`
+//! operation that succeeds in any part is fatal (`unexpected-support`); a `required` operation
+//! passes only on an answer that shows the operation was done and ended whole; an answer that
+//! cannot settle a check (no response head, a body cut off in transport, a 5xx, a follow-up
+//! probe that got no answer) neither passes nor fails it, so a row with such a check and no
+//! fatal one is unproved; and a run with any row unproved is INCONCLUSIVE, never PASS.
+
+use std::cmp::Ordering;
+use std::fmt;
+
+use crate::s3::ErrorCode;
+
+// ---------------------------------------------------------------------------------------------
+// Operations and rows
+// ---------------------------------------------------------------------------------------------
+
+/// One row of the matrix: an S3 operation, or one form of it whose answer differs (a ranged
+/// or conditional `GetObject`).
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash, PartialOrd, Ord)]
+pub enum Operation {
+    PutObject,
+    /// `GetObject` of the whole object.
+    GetObject,
+    /// `GetObject` with `Range: bytes=a-b`.
+    GetObjectRanged,
+    /// `GetObject` with an `If-None-Match` naming the object's current entity-tag.
+    GetObjectIfNoneMatchHit,
+    /// `GetObject` with an `If-None-Match` naming a valid strong tag the object does not have.
+    GetObjectIfNoneMatchMiss,
+    HeadObject,
+    DeleteObject,
+    /// Bulk `POST /bucket?delete`.
+    DeleteObjects,
+    ListObjectsV2,
+    /// The v1 listing (`GET /bucket` without `list-type=2`).
+    ListObjects,
+    CopyObject,
+    CreateMultipartUpload,
+    UploadPart,
+    CompleteMultipartUpload,
+    AbortMultipartUpload,
+    ListParts,
+    ListMultipartUploads,
+    CreateBucket,
+    DeleteBucket,
+    HeadBucket,
+    ListBuckets,
+    GetBucketLocation,
+}
+
+impl Operation {
+    /// The row's name as a report spells it.
+    pub fn name(self) -> &'static str {
+        match self {
+            Self::PutObject => "PutObject",
+            Self::GetObject => "GetObject",
+            Self::GetObjectRanged => "GetObject (Range)",
+            Self::GetObjectIfNoneMatchHit => "GetObject (If-None-Match, matching)",
+            Self::GetObjectIfNoneMatchMiss => "GetObject (If-None-Match, not matching)",
+            Self::HeadObject => "HeadObject",
+            Self::DeleteObject => "DeleteObject",
+            Self::DeleteObjects => "DeleteObjects",
+            Self::ListObjectsV2 => "ListObjectsV2",
+            Self::ListObjects => "ListObjects",
+            Self::CopyObject => "CopyObject",
+            Self::CreateMultipartUpload => "CreateMultipartUpload",
+            Self::UploadPart => "UploadPart",
+            Self::CompleteMultipartUpload => "CompleteMultipartUpload",
+            Self::AbortMultipartUpload => "AbortMultipartUpload",
+            Self::ListParts => "ListParts",
+            Self::ListMultipartUploads => "ListMultipartUploads",
+            Self::CreateBucket => "CreateBucket",
+            Self::DeleteBucket => "DeleteBucket",
+            Self::HeadBucket => "HeadBucket",
+            Self::ListBuckets => "ListBuckets",
+            Self::GetBucketLocation => "GetBucketLocation",
+        }
+    }
+}
+
+impl fmt::Display for Operation {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.write_str(self.name())
+    }
+}
+
+/// The S3 error code an `unsupported` row declares.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum DeclaredCode {
+    /// The `<Code>` of the error document.
+    Code(&'static str),
+    /// No body at all (a `HEAD` refusal cannot carry one).
+    NoBody,
+}
+
+impl DeclaredCode {
+    fn matches(self, observed: Option<&ErrorCode>) -> bool {
+        match (self, observed) {
+            (Self::Code(want), Some(ErrorCode::Code(got))) => want == got,
+            (Self::NoBody, Some(ErrorCode::NoBody)) => true,
+            _ => false,
+        }
+    }
+}
+
+impl fmt::Display for DeclaredCode {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            Self::Code(code) => f.write_str(code),
+            Self::NoBody => f.write_str("no body"),
+        }
+    }
+}
+
+/// A row's declared state (proposal 0017 §3).
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum Expected {
+    /// Must succeed, and the answer must show the operation was done.
+    Required,
+    /// Must be refused with exactly this status and code. `issue` is the issue that will build
+    /// the operation.
+    Unsupported {
+        issue: u32,
+        status: u16,
+        code: DeclaredCode,
+    },
+    /// The server is expected to accept the operation and the tool cannot check it yet;
+    /// `issue` is the issue that will add the check. Never counted as a pass.
+    SupportedNotChecked { issue: u32 },
+}
+
+/// One declared row: the operation, its state, and where today's answer comes from.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct Row {
+    pub operation: Operation,
+    pub expected: Expected,
+    /// The source line that gives the answer this row expects.
+    pub cites: &'static str,
+}
+
+impl Row {
+    pub const fn required(operation: Operation, cites: &'static str) -> Self {
+        Self {
+            operation,
+            expected: Expected::Required,
+            cites,
+        }
+    }
+
+    pub const fn unsupported(
+        operation: Operation,
+        issue: u32,
+        status: u16,
+        code: DeclaredCode,
+        cites: &'static str,
+    ) -> Self {
+        Self {
+            operation,
+            expected: Expected::Unsupported {
+                issue,
+                status,
+                code,
+            },
+            cites,
+        }
+    }
+
+    pub const fn not_checked(operation: Operation, issue: u32, cites: &'static str) -> Self {
+        Self {
+            operation,
+            expected: Expected::SupportedNotChecked { issue },
+            cites,
+        }
+    }
+}
+
+// ---------------------------------------------------------------------------------------------
+// Profiles
+// ---------------------------------------------------------------------------------------------
+
+/// A release `MAJOR.MINOR.PATCH` with no pre-release: the edge of a profile's range.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct Bound {
+    pub major: u64,
+    pub minor: u64,
+    pub patch: u64,
+}
+
+impl Bound {
+    pub const fn new(major: u64, minor: u64, patch: u64) -> Self {
+        Self {
+            major,
+            minor,
+            patch,
+        }
+    }
+}
+
+/// The releases a profile covers: at or above `from` (when set) and below `below` (when set),
+/// by semantic-version precedence, so `0.1.0-rc.1` is below `0.1.0`.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct VersionRange {
+    pub from: Option<Bound>,
+    pub below: Option<Bound>,
+}
+
+impl VersionRange {
+    pub fn contains(&self, release: &Release) -> bool {
+        let at_or_above = self
+            .from
+            .is_none_or(|from| release.cmp_bound(from) != Ordering::Less);
+        let under = self
+            .below
+            .is_none_or(|below| release.cmp_bound(below) == Ordering::Less);
+        at_or_above && under
+    }
+}
+
+/// An immutable set of rows keyed by the release range it applies to.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct Profile {
+    name: &'static str,
+    range: VersionRange,
+    rows: &'static [Row],
+}
+
+impl Profile {
+    pub const fn new(name: &'static str, range: VersionRange, rows: &'static [Row]) -> Self {
+        Self { name, range, rows }
+    }
+
+    pub fn name(&self) -> &'static str {
+        self.name
+    }
+
+    pub fn range(&self) -> VersionRange {
+        self.range
+    }
+
+    pub fn rows(&self) -> &'static [Row] {
+        self.rows
+    }
+
+    /// The row declared for `operation`, if the profile declares one.
+    pub fn row(&self, operation: Operation) -> Option<&'static Row> {
+        self.rows.iter().find(|row| row.operation == operation)
+    }
+}
