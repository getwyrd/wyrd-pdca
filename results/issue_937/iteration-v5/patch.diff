+#[test]
+fn pre_0_1_declares_exactly_todays_rows() {
+    use Operation::*;
+    let nimpl = DeclaredCode::Code("NotImplemented");
+    let invalid = DeclaredCode::Code("InvalidRequest");
+    let unsupported = |issue, status, code| Expected::Unsupported {
+        issue,
+        status,
+        code,
+    };
+    let want: Vec<(Operation, Expected)> = vec![
+        (PutObject, Expected::Required),
+        (GetObject, Expected::Required),
+        (GetObjectRanged, Expected::Required),
+        (GetObjectIfNoneMatchHit, Expected::Required),
+        (GetObjectIfNoneMatchMiss, Expected::Required),
+        (HeadObject, Expected::Required),
+        (DeleteObject, Expected::Required),
+        (DeleteObjects, Expected::Required),
+        (ListObjectsV2, Expected::Required),
+        (ListObjects, Expected::Required),
+        (CopyObject, unsupported(766, 501, nimpl)),
+        (CreateMultipartUpload, unsupported(508, 501, nimpl)),
+        (UploadPart, unsupported(508, 501, nimpl)),
+        (CompleteMultipartUpload, unsupported(508, 501, nimpl)),
+        (AbortMultipartUpload, unsupported(508, 501, nimpl)),
+        (ListParts, unsupported(508, 501, nimpl)),
+        (ListMultipartUploads, unsupported(508, 501, nimpl)),
+        (GetBucketLocation, unsupported(511, 501, nimpl)),
+        (CreateBucket, unsupported(511, 400, invalid)),
+        (DeleteBucket, unsupported(511, 400, invalid)),
+        (ListBuckets, unsupported(511, 400, invalid)),
+        (HeadBucket, unsupported(511, 400, DeclaredCode::NoBody)),
+    ];
+    let mut got: Vec<(Operation, Expected)> = PRE_0_1
+        .rows()
+        .iter()
+        .map(|r| (r.operation, r.expected))
+        .collect();
+    let mut want_sorted = want.clone();
+    got.sort_by_key(|(op, _)| *op);
+    want_sorted.sort_by_key(|(op, _)| *op);
+    assert_eq!(got, want_sorted, "pre-0.1 declares exactly today's rows");
+    assert_eq!(PRE_0_1.rows().len(), want.len(), "no row is declared twice");
+    assert!(
+        PRE_0_1
+            .rows()
+            .iter()
+            .all(|r| !matches!(r.expected, Expected::SupportedNotChecked { .. })),
+        "no row is `supported, not checked` today"
+    );
+    for r in PRE_0_1.rows() {
+        assert!(
+            r.cites.starts_with("crates/gateway-s3/src/lib.rs:"),
+            "{} cites the gateway line giving today's answer: {}",
+            r.operation,
+            r.cites
+        );
+    }
+    assert_eq!(PRE_0_1.name(), "pre-0.1");
+}
