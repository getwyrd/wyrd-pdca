+    for cr in [
+        "bytes 2-6/16",
+        "bytes 2-5/17",
+        "bytes 0-3/16",
+        "bytes */16",
+        "bytes 2-5",
+        // Signs are not digits, though `u64::from_str` takes a `+` (AGENTS.md grammar rule).
+        "bytes +2-+5/+16",
+        "bytes +2-5/16",
+        "bytes 2-+5/16",
+        "bytes 2-5/+16",
+    ] {
+        assert_fails_with(
+            ranged(ans(resp(206)
+                .with_content_range(cr)
+                .with_body(Body::Bytes(OBJECT[2..=5].to_vec())))),
+            FailureClass::Protocol,
+        );
+    }
+    // The unit is case-insensitive (RFC 9110 §14.1).
+    let ok = classify(
+        row(Operation::GetObjectRanged),
+        &ranged(ans(resp(206)
+            .with_content_range("Bytes 2-5/16")
+            .with_body(Body::Bytes(OBJECT[2..=5].to_vec())))),
+    );
+    assert_eq!(ok, RowResult::Pass);
+}
