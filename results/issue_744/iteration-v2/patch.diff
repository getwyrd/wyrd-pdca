index 0000000..44550f5
--- /dev/null
+++ b/crates/validate/src/payload.rs
@@ -0,0 +1,253 @@
+//! Derived payloads: `bytes = f(seed, key, size, generation)` (proposal 0017 §4).
+//!
+//! A run never stores an object body. Every byte it writes is a pure function of four inputs
+//! the run records anyway — the `--seed` value, the object key, the object's size and the
+//! write's generation number — so a checkpoint keeps those and a digest, and a resumed run
+//! (or the oracle reading an object back) re-derives the bytes instead of keeping them.
+//! Nothing here reads process state: no hasher seed, no address, no clock. The same inputs
+//! give the same bytes in every process, on every host, in every release that keeps the
+//! construction below.
+//!
+//! # The construction (version 1)
+//!
+//! Stated exactly, so it can be reimplemented. **Changing it silently invalidates every
+//! checkpoint ever written**; the known-answer constants in
+//! `crates/validate/tests/payload_and_sizes.rs` are what make such a change visible.
+//!
+//! All integers are unsigned 64-bit, big-endian. Let
+//!
+//! ```text
+//! prefix  = "wyrd-validate/payload/v1" || 0x00
+//!        || u64(len(seed)) || seed          (the --seed value's exact UTF-8 bytes)
+//!        || u64(len(key))  || key           (the object key's exact UTF-8 bytes)
+//!        || u64(size)
+//!        || u64(generation)
+//! block_i = SHA-256(prefix || u64(i))       for i = 0, 1, 2, ...
+//! bytes   = the first `size` bytes of block_0 || block_1 || block_2 || ...
+//! ```
+//!
+//! Each variable-length field carries its length, so no two input tuples share a `prefix`.
+//! Block `i` depends on `i` alone, so the bytes of any range `[a, b)` cost
+//! `⌈(b − a) / 32⌉ + 1` hashes at most, wherever the range sits in the object, and the state a
+//! [`Payload`] holds (the SHA-256 state after `prefix`) does not grow with `size`.
+//!
+//! # What the bytes can and cannot tell apart
+//!
+//! Because `size` and `generation` are both in `prefix`, two payloads that differ in any input
+//! are independent SHA-256 streams. Over `n` bytes they coincide with probability `2^(-8n)`:
+//! negligible from a few bytes up, but **not** at the smallest sizes. At 0 bytes every input
+//! gives the same (empty) payload, and a 1-byte payload takes only 256 values, so two
+//! generations of one key coincide with probability 1/256. Below one block (32 bytes) the
+//! guarantee is only that probability, not a certainty. At those sizes the bytes alone cannot
+//! tell a stale generation from the current one, and neither can the `ETag`, which the gateway
+//! derives from the body. The oracle (#746) must account for that: a read of a tiny object
+//! that returns the right bytes is not, by itself, proof that it returned the right generation.
+
+use std::fmt;
+
+use sha2::{Digest, Sha256};
+
+/// The construction version stated in the module docs, and the tag every `prefix` starts with.
+const DOMAIN: &[u8] = b"wyrd-validate/payload/v1\0";
+
+/// Bytes per derived block: one SHA-256 output.
+pub const BLOCK_BYTES: u64 = 32;
+
+/// The largest piece [`Pieces`] yields, whatever the payload's size (every piece but the last
+/// is exactly this long). A caller streaming an object holds at most this much of it at a time.
+pub const PIECE_BYTES: usize = 64 * 1024;
+
+/// One object body, derived and never stored: what to send for `(seed, key, size, generation)`.
+///
+/// Holds the hash state after the `prefix` of the construction and the size — a fixed amount of
+/// state whatever the size. Bytes are produced on demand, by [`Payload::fill`] for a range or by
+/// [`Payload::pieces`] / [`Payload::range`] as a stream.
+#[derive(Clone)]
+pub struct Payload {
+    keyed: Sha256,
+    size: u64,
+    generation: u64,
+}
+
+impl fmt::Debug for Payload {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.debug_struct("Payload")
+            .field("size", &self.size)
+            .field("generation", &self.generation)
+            .finish_non_exhaustive()
+    }
+}
+
+/// A range that does not lie inside the payload. Refused, never truncated to fit.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct OutOfRange {
+    /// The requested start.
+    pub start: u64,
+    /// The requested end (exclusive); `None` when `start + len` overflows `u64`.
+    pub end: Option<u64>,
+    /// The payload's size.
+    pub size: u64,
+}
+
+impl fmt::Display for OutOfRange {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self.end {
+            Some(end) => write!(
+                f,
+                "byte range [{}, {end}) is not inside a {}-byte payload",
+                self.start, self.size
+            ),
+            None => write!(
+                f,
+                "byte range starting at {} overflows a 64-bit offset (payload is {} bytes)",
+                self.start, self.size
+            ),
+        }
+    }
+}
+
+impl std::error::Error for OutOfRange {}
+
+/// A `usize` length as a `u64`. Lossless on every target Rust supports, where `usize` is at
+/// most 64 bits wide.
+fn len_u64(len: usize) -> u64 {
+    len as u64
+}
+
+impl Payload {
+    /// The payload for `(seed, key, size, generation)`: `seed` is the `--seed` value exactly as
+    /// given, `key` the object key, `generation` the write's number for that key.
+    pub fn new(seed: &str, key: &str, size: u64, generation: u64) -> Self {
+        let mut keyed = Sha256::new();
+        keyed.update(DOMAIN);
+        keyed.update(len_u64(seed.len()).to_be_bytes());
+        keyed.update(seed.as_bytes());
+        keyed.update(len_u64(key.len()).to_be_bytes());
+        keyed.update(key.as_bytes());
+        keyed.update(size.to_be_bytes());
+        keyed.update(generation.to_be_bytes());
+        Self {
+            keyed,
+            size,
+            generation,
+        }
+    }
+
+    /// The payload's length in bytes.
+    pub fn size(&self) -> u64 {
+        self.size
+    }
+
+    /// The generation the payload was derived for.
+    pub fn generation(&self) -> u64 {
+        self.generation
+    }
+
+    /// `block_index` of the construction.
+    fn block(&self, block_index: u64) -> [u8; 32] {
+        let mut hasher = self.keyed.clone();
+        hasher.update(block_index.to_be_bytes());
+        hasher.finalize().into()
+    }
+
+    /// Fill `buf` with the payload's bytes `[offset, offset + buf.len())`, computed directly:
+    /// only the blocks the range touches are hashed, wherever it sits. A range that does not
+    /// lie inside the payload is refused and `buf` is left untouched.
+    pub fn fill(&self, offset: u64, buf: &mut [u8]) -> Result<(), OutOfRange> {
+        let end = offset.checked_add(len_u64(buf.len()));
+        if end.is_none_or(|end| end > self.size) {
+            return Err(OutOfRange {
+                start: offset,
+                end,
+                size: self.size,
+            });
+        }
+        self.fill_inside(offset, buf);
+        Ok(())
+    }
+
+    /// [`Payload::fill`] for a range already known to lie inside the payload.
+    fn fill_inside(&self, offset: u64, buf: &mut [u8]) {
+        let mut position = offset;
+        let mut written = 0;
+        while written < buf.len() {
+            let block = self.block(position / BLOCK_BYTES);
+            // `position % BLOCK_BYTES` is below 32, so the cast is exact.
+            let within = (position % BLOCK_BYTES) as usize;
+            let take = (block.len() - within).min(buf.len() - written);
+            buf[written..written + take].copy_from_slice(&block[within..within + take]);
+            written += take;
+            position += len_u64(take);
+        }
+    }
+
+    /// The bytes `[start, end)` as a stream of pieces of at most [`PIECE_BYTES`] each. The
+    /// first piece is computed directly from `start`, never by generating the prefix before it.
+    pub fn range(&self, start: u64, end: u64) -> Result<Pieces, OutOfRange> {
+        if start > end || end > self.size {
+            return Err(OutOfRange {
+                start,
+                end: Some(end),
+                size: self.size,
+            });
+        }
+        Ok(Pieces {
+            payload: self.clone(),
+            next: start,
+            end,
+        })
+    }
+
+    /// The whole payload as a stream of pieces of at most [`PIECE_BYTES`] each.
+    pub fn pieces(&self) -> Pieces {
+        Pieces {
+            payload: self.clone(),
+            next: 0,
+            end: self.size,
+        }
+    }
+
+    /// The SHA-256 of the whole payload, computed by streaming it piece by piece — the digest a
+    /// checkpoint and the oracle key on. Costs one pass over `size` bytes; holds one piece.
+    pub fn sha256(&self) -> [u8; 32] {
+        let mut digest = Sha256::new();
+        for piece in self.pieces() {
+            digest.update(&piece);
+        }
+        digest.finalize().into()
+    }
+}
+
+/// A payload range, streamed: the items concatenate to exactly the range. Every item but the
+/// last is exactly [`PIECE_BYTES`] long, the last holds the rest (1 to [`PIECE_BYTES`] bytes),
+/// and an empty range yields no item. No item is ever empty, so a range of `n` bytes yields
+/// `⌈n / PIECE_BYTES⌉` items, the count [`Iterator::size_hint`] reports exactly.
+#[derive(Debug, Clone)]
+pub struct Pieces {
+    payload: Payload,
+    next: u64,
+    end: u64,
+}
+
+impl Iterator for Pieces {
+    type Item = Vec<u8>;
+
+    fn next(&mut self) -> Option<Vec<u8>> {
+        if self.next >= self.end {
+            return None;
+        }
+        // At most `PIECE_BYTES`, so the cast back to `usize` is exact.
+        let len = (self.end - self.next).min(len_u64(PIECE_BYTES)) as usize;
+        let mut piece = vec![0; len];
+        self.payload.fill_inside(self.next, &mut piece);
+        self.next += len_u64(len);
+        Some(piece)
+    }
+
+    /// Exact: the items still to come. A 64-bit range has at most 2^48 of them, so the count
+    /// fits a 64-bit `usize`; where it would not, the hint is `(usize::MAX, None)`.
+    fn size_hint(&self) -> (usize, Option<usize>) {
+        let pieces = usize::try_from((self.end - self.next).div_ceil(len_u64(PIECE_BYTES))).ok();
+        (pieces.unwrap_or(usize::MAX), pieces)
+    }
+}
diff --git a/crates/validate/src/sizes.rs b/crates/validate/src/sizes.rs
new file mode 100644
index 0000000..bd949c5
--- /dev/null
+++ b/crates/validate/src/sizes.rs
@@ -0,0 +1,354 @@
+//! Size classes, computed from the deployment's tuning (proposal 0017 §4).
+//!
+//! The sizes a run writes straddle S3's boundaries and Wyrd's own. Wyrd's depend on two
+//! values a blackbox tool cannot import (proposal 0017 §9): the chunk size `C` and the root
+//! value budget, from which the chunk-map segmentation threshold `T` follows. So they are
+//! inputs — `--chunk-size`, `--max-root-value-bytes`, `--segment-threshold-bytes` — and the
+//! table is computed from them at run time, never copied from today's constants. A table copied
+//! from them goes stale the day one moves, and the run then reports coverage of a boundary it
+//! never crossed.
+//!
+//! Each input is optional, with a default that mirrors today's server value; the resolved
+//! configuration echo records each value with where it came from ([`Source`]), so a run's size
+//! coverage reads against the tuning it actually used. The defaults mirror, they do not import:
+//! a dev-only test (`crates/validate/tests/payload_and_sizes.rs`) compares them with the
+//! `wyrd-core` constants and goes red the day either side moves alone.
+//!
+//! Which verb drives a class, and what each class is expected to answer, is the capability
+//! matrix's business (#743), not this module's.
+
+use std::fmt;
+
+/// Today's chunk size, mirroring the server's `DEFAULT_CHUNK_SIZE = 1 << 20`
+/// (`crates/server/src/lib.rs`).
+pub const DEFAULT_CHUNK_SIZE: u64 = 1 << 20;
+
+/// Today's root value budget, mirroring `wyrd_core::metadata::MAX_ROOT_VALUE_BYTES`.
+pub const DEFAULT_MAX_ROOT_VALUE_BYTES: u64 = 50_000;
+
+/// The widest encoding of one chunk record in a chunk map, mirroring
+/// `wyrd_core::multipart::MAX_CHUNKREF_BYTES`. Not a flag: it is an internal detail of the
+/// server's encoding, which is why the segmentation threshold has its own flag.
+pub const CHUNK_REF_BYTES: u64 = 315;
+
+const KIB: u64 = 1 << 10;
+const MIB: u64 = 1 << 20;
+const GIB: u64 = 1 << 30;
+
+/// Where a tuning value came from, as the resolved-configuration echo prints it.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum Source {
+    /// The operator passed the flag.
+    Given,
+    /// The flag was absent; the value mirrors today's server value.
+    Default,
+    /// The flag was absent; the value was computed from the other tuning values.
+    Derived,
+}
+
+impl fmt::Display for Source {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.write_str(match self {
+            Self::Given => "given",
+            Self::Default => "default",
+            Self::Derived => "derived",
+        })
+    }
+}
+
+/// One resolved tuning value and its [`Source`].
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct Setting {
+    pub value: u64,
+    pub source: Source,
+}
+
+/// The tuning flags as given on the command line: `None` for an absent flag. Each present value
+/// is already a positive integer (the argument parser refuses anything else).
+#[derive(Debug, Clone, Copy, Default, PartialEq, Eq)]
+pub struct TuningFlags {
+    pub chunk_size: Option<u64>,
+    pub max_root_value_bytes: Option<u64>,
+    pub segment_threshold_bytes: Option<u64>,
+}
+
+/// The deployment's tuning, resolved: every value present, each with its [`Source`].
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct Tuning {
+    /// `C`: the chunk size, in bytes.
+    pub chunk_size: Setting,
+    /// The root value budget, in bytes.
+    pub max_root_value_bytes: Setting,
+    /// `T`: the object size at which the chunk map must segment, in bytes.
+    pub segment_threshold_bytes: Setting,
+}
+
+/// Why a tuning was refused: it cannot produce a valid size table. Never clamped to one that
+/// can.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum TuningError {
+    /// A tuning value of zero, named by its flag. The argument parser refuses it first; this
+    /// covers a [`TuningFlags`] built by hand.
+    Zero(&'static str),
+    /// The root budget holds no chunk record at all, so the derived segmentation threshold
+    /// would be zero.
+    NoChunkRefFits { max_root_value_bytes: u64 },
+    /// A size the table needs does not fit in 64 bits: `class` is the size (e.g. `T + 1`),
+    /// `from` the flag or flags its value is computed from, so the refusal names them.
+    Overflow {
+        class: &'static str,
+        from: &'static str,
+    },
+}
+
+/// What the chunk-size classes are computed from.
+const FROM_CHUNK_SIZE: &str = "`--chunk-size`";
+/// What a given segmentation threshold, and the classes around it, are computed from.
+const FROM_GIVEN_THRESHOLD: &str = "`--segment-threshold-bytes`";
+/// What a derived segmentation threshold, and the classes around it, are computed from.
+const FROM_DERIVED_THRESHOLD: &str =
+    "`--max-root-value-bytes` and `--chunk-size` (no `--segment-threshold-bytes` was given)";
+
+impl fmt::Display for TuningError {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            Self::Zero(flag) => write!(f, "flag `--{flag}` must be a positive integer, not 0"),
+            Self::NoChunkRefFits {
+                max_root_value_bytes,
+            } => write!(
+                f,
+                "`--max-root-value-bytes` {max_root_value_bytes} holds no {CHUNK_REF_BYTES}-byte \
+                 chunk record, so no segmentation threshold can be derived from it; pass \
+                 `--segment-threshold-bytes` or a larger budget"
+            ),
+            Self::Overflow { class, from } => write!(
+                f,
+                "the {class} size class, computed from {from}, does not fit in 64 bits"
+            ),
+        }
+    }
+}
+
+impl std::error::Error for TuningError {}
+
+/// The segmentation threshold the server's rule gives for `chunk_size` and
+/// `max_root_value_bytes`: a flat chunk map holds `⌊max_root_value_bytes / CHUNK_REF_BYTES⌋`
+/// chunks, and a larger one segments, so `T = ⌊max_root_value_bytes / CHUNK_REF_BYTES⌋ ×
+/// chunk_size` (158 MiB at the defaults).
+pub fn derived_segment_threshold(
+    chunk_size: u64,
+    max_root_value_bytes: u64,
+) -> Result<u64, TuningError> {
+    let chunks = max_root_value_bytes / CHUNK_REF_BYTES;
+    if chunks == 0 {
+        return Err(TuningError::NoChunkRefFits {
+            max_root_value_bytes,
+        });
+    }
+    chunks.checked_mul(chunk_size).ok_or(TuningError::Overflow {
+        class: "T (⌊root budget / 315⌋ × C)",
+        from: FROM_DERIVED_THRESHOLD,
+    })
+}
+
+impl Tuning {
+    /// Resolve the flags: a given value is used as given, an absent chunk size or root budget
+    /// takes its default, and an absent segmentation threshold is derived from the other two.
+    /// Refused if the result cannot produce a valid size table.
+    pub fn resolve(flags: &TuningFlags) -> Result<Self, TuningError> {
+        for (flag, value) in [
+            ("chunk-size", flags.chunk_size),
+            ("max-root-value-bytes", flags.max_root_value_bytes),
+            ("segment-threshold-bytes", flags.segment_threshold_bytes),
+        ] {
+            if value == Some(0) {
+                return Err(TuningError::Zero(flag));
+            }
+        }
+        let setting = |given: Option<u64>, default: u64| match given {
+            Some(value) => Setting {
+                value,
+                source: Source::Given,
+            },
+            None => Setting {
+                value: default,
+                source: Source::Default,
+            },
+        };
+        let chunk_size = setting(flags.chunk_size, DEFAULT_CHUNK_SIZE);
+        let max_root_value_bytes =
+            setting(flags.max_root_value_bytes, DEFAULT_MAX_ROOT_VALUE_BYTES);
+        let segment_threshold_bytes = match flags.segment_threshold_bytes {
+            Some(value) => Setting {
+                value,
+                source: Source::Given,
+            },
+            None => Setting {
+                value: derived_segment_threshold(chunk_size.value, max_root_value_bytes.value)?,
+                source: Source::Derived,
+            },
+        };
+        let tuning = Self {
+            chunk_size,
+            max_root_value_bytes,
+            segment_threshold_bytes,
+        };
+        tuning.size_classes()?;
+        Ok(tuning)
+    }
+
+    /// `(flag, setting)` for each tuning flag, in the order the echo prints them.
+    pub fn pairs(&self) -> [(&'static str, Setting); 3] {
+        [
+            ("chunk-size", self.chunk_size),
+            ("max-root-value-bytes", self.max_root_value_bytes),
+            ("segment-threshold-bytes", self.segment_threshold_bytes),
+        ]
+    }
+
+    /// The size classes for this tuning: ascending, each size once, each carrying every
+    /// boundary it straddles (two boundaries that land on one size share a class). Checked
+    /// arithmetic throughout; a size that does not fit in 64 bits is refused.
+    pub fn size_classes(&self) -> Result<Vec<SizeClass>, TuningError> {
+        let c = self.chunk_size.value;
+        let t = self.segment_threshold_bytes.value;
+        let chunk = |class| TuningError::Overflow {
+            class,
+            from: FROM_CHUNK_SIZE,
+        };
+        let t_from = match self.segment_threshold_bytes.source {
+            Source::Given => FROM_GIVEN_THRESHOLD,
+            Source::Default | Source::Derived => FROM_DERIVED_THRESHOLD,
+        };
+        let threshold = |class| TuningError::Overflow {
+            class,
+            from: t_from,
+        };
+        let mut points: Vec<(u64, Boundary)> = vec![
+            (0, Boundary::Empty),
+            (1, Boundary::MinimumNonEmpty),
+            (4 * KIB, Boundary::SubChunk),
+            (64 * KIB, Boundary::SubChunk),
+            (
+                c.checked_sub(1).ok_or(chunk("C - 1"))?,
+                Boundary::BelowChunk,
+            ),
+            (c, Boundary::AtChunk),
+            (
+                c.checked_add(1).ok_or(chunk("C + 1"))?,
+                Boundary::AboveChunk,
+            ),
+            (5 * MIB, Boundary::S3MinimumPart),
+            (8 * MIB, Boundary::SdkMultipartThreshold),
+            (
+                c.checked_mul(64).ok_or(chunk("64 x C"))?,
+                Boundary::MultiChunk,
+            ),
+            (
+                t.checked_sub(1).ok_or(threshold("T - 1"))?,
+                Boundary::BelowSegmentation,
+            ),
+            (t, Boundary::AtSegmentation),
+            (
+                t.checked_add(1).ok_or(threshold("T + 1"))?,
+                Boundary::AboveSegmentation,
+            ),
+            (5 * GIB, Boundary::S3MaxSinglePut),
+            (5 * GIB + 1, Boundary::PastS3MaxSinglePut),
+            (10 * GIB + 1, Boundary::BeyondTenGib),
+        ];
+        points.sort_unstable();
+        let mut classes: Vec<SizeClass> = Vec::with_capacity(points.len());
+        for (size, boundary) in points {
+            match classes.last_mut() {
+                Some(class) if class.size == size => {
+                    if !class.boundaries.contains(&boundary) {
+                        class.boundaries.push(boundary);
+                    }
+                }
+                _ => classes.push(SizeClass {
+                    size,
+                    boundaries: vec![boundary],
+                }),
+            }
+        }
+        Ok(classes)
+    }
+}
+
+/// The boundary a size class straddles (proposal 0017 §4's table).
+#[derive(Debug, Clone, Copy, PartialEq, Eq, PartialOrd, Ord, Hash)]
+pub enum Boundary {
+    /// 0 B.
+    Empty,
+    /// 1 B.
+    MinimumNonEmpty,
+    /// 4 KiB and 64 KiB: inside one chunk.
+    SubChunk,
+    /// `C − 1`.
+    BelowChunk,
+    /// `C`.
+    AtChunk,
+    /// `C + 1`.
+    AboveChunk,
+    /// 5 MiB.
+    S3MinimumPart,
+    /// 8 MiB.
+    SdkMultipartThreshold,
+    /// `64 × C`.
+    MultiChunk,
+    /// `T − 1`.
+    BelowSegmentation,
+    /// `T`.
+    AtSegmentation,
+    /// `T + 1`.
+    AboveSegmentation,
+    /// 5 GiB.
+    S3MaxSinglePut,
+    /// 5 GiB + 1.
+    PastS3MaxSinglePut,
+    /// 10 GiB + 1, standing for the > 10 GiB launch requirement.
+    BeyondTenGib,
+}
+
+impl Boundary {
+    /// What the boundary is, in words.
+    pub fn label(self) -> &'static str {
+        match self {
+            Self::Empty => "empty object",
+            Self::MinimumNonEmpty => "minimum non-empty",
+            Self::SubChunk => "sub-chunk",
+            Self::BelowChunk => "one byte below the chunk size (C - 1)",
+            Self::AtChunk => "the chunk size (C)",
+            Self::AboveChunk => "one byte past the chunk size (C + 1)",
+            Self::S3MinimumPart => "S3 minimum part size (5 MiB)",
+            Self::SdkMultipartThreshold => {
+                "stock SDK multipart threshold; bulk-delete body cap (8 MiB)"
+            }
+            Self::MultiChunk => "multi-chunk, many fragments (64 x C)",
+            Self::BelowSegmentation => {
+                "one byte below the chunk-map segmentation threshold (T - 1)"
+            }
+            Self::AtSegmentation => "the chunk-map segmentation threshold (T)",
+            Self::AboveSegmentation => "one byte past the chunk-map segmentation threshold (T + 1)",
+            Self::S3MaxSinglePut => "S3's largest accepted single PUT (5 GiB)",
+            Self::PastS3MaxSinglePut => "first size past S3's single-PUT maximum (5 GiB + 1)",
+            Self::BeyondTenGib => {
+                "beyond 5 GiB: an object over 10 GiB, the launch requirement (10 GiB + 1)"
+            }
+        }
+    }
+}
+
+impl fmt::Display for Boundary {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.write_str(self.label())
+    }
+}
+
+/// One size a run writes, with every boundary it straddles.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct SizeClass {
+    pub size: u64,
+    pub boundaries: Vec<Boundary>,
+}
diff --git a/crates/validate/tests/payload_and_sizes.rs b/crates/validate/tests/payload_and_sizes.rs
new file mode 100644
index 0000000..54f5459
--- /dev/null
+++ b/crates/validate/tests/payload_and_sizes.rs
@@ -0,0 +1,1115 @@
+//! Derived payloads, size classes and the deployment tuning flags (proposal 0017 §4; #744).
+//!
+//! Binds two properties a months-long run depends on:
+//!
+//! - **Payloads are derived, never stored**: `bytes = f(seed, key, size, generation)`, the same
+//!   in every process (pinned known-answer digests), with every input mattering — the
+//!   generation above all, or a stale read after a same-size overwrite looks correct — and any
+//!   byte range computable on its own, in bounded memory, wherever it sits in the object.
+//! - **Size classes come from the tuning**, never from a hardcoded table: they move with
+//!   `--chunk-size`, `--max-root-value-bytes` and `--segment-threshold-bytes`, whose defaults
+//!   are echoed as defaults and checked here against the `wyrd-core` constants they mirror.
+//!
+//! Every test that produces payload bytes runs under a wall-clock bound ([`bounded`],
+//! [`within`]), and every stream is drained through [`drain`], which stops at the first byte
+//! past the expected length. `cargo test` has no per-test timeout, so without them a generator
+//! that never finishes (a stream that does not advance, a fill that does not end, a range that
+//! regenerates the prefix of a 1 TiB object) would hang the run instead of failing a test.
+#![forbid(unsafe_code)]
+
+use std::collections::HashMap;
+use std::ffi::OsString;
+use std::process::Command;
+use std::sync::mpsc::{self, RecvTimeoutError};
+use std::time::{Duration, Instant};
+
+use sha2::{Digest, Sha256};
+use wyrd_validate::sizes::derived_segment_threshold;
+use wyrd_validate::{
+    run, Boundary, OutOfRange, Payload, Pieces, SizeClass, Source, Tuning, TuningError,
+    TuningFlags, CHUNK_REF_BYTES, DEFAULT_CHUNK_SIZE, DEFAULT_MAX_ROOT_VALUE_BYTES,
+    EXIT_INCONCLUSIVE, EXIT_USAGE, PIECE_BYTES, TUNING_FLAGS,
+};
+
+const KIB: u64 = 1 << 10;
+const MIB: u64 = 1 << 20;
+const GIB: u64 = 1 << 30;
+const TIB: u64 = 1 << 40;
+
+fn hex(bytes: &[u8]) -> String {
+    bytes.iter().map(|byte| format!("{byte:02x}")).collect()
+}
+
+/// Run `work` on its own thread and fail if it has not finished within `limit` of wall time.
+/// A panic inside `work` is raised again here, with its own message. Work that runs past the
+/// limit is left running on its thread while this test fails; the test process ends it when
+/// the run ends.
+fn within<T: Send + 'static>(
+    limit: Duration,
+    what: &str,
+    work: impl FnOnce() -> T + Send + 'static,
+) -> T {
+    let (done, finished) = mpsc::channel();
+    let started = Instant::now();
+    let worker = std::thread::spawn(move || {
+        let value = work();
+        // Nobody is listening if the limit has already passed; the value is dropped then.
+        let _ = done.send(());
+        value
+    });
+    match finished.recv_timeout(limit) {
+        // Finished, or panicked (which drops `done` unsent): either way the thread is ending,
+        // so the join returns promptly and a panic is raised again with its own message.
+        Ok(()) | Err(RecvTimeoutError::Disconnected) => worker
+            .join()
+            .unwrap_or_else(|panic| std::panic::resume_unwind(panic)),
+        Err(RecvTimeoutError::Timeout) => panic!(
+            "{what} did not finish within {limit:?} (gave up after {:?})",
+            started.elapsed()
+        ),
+    }
+}
+
+/// The bound on every payload test outside (C′)'s own 5 s checks. Honest work here takes
+/// milliseconds; this is far above that and still below any harness timeout, so a generator
+/// that never finishes fails the test that drove it.
+const GUARD: Duration = Duration::from_secs(10);
+
+/// A whole test body, run [`within`] [`GUARD`].
+fn bounded(test: &str, body: impl FnOnce() + Send + 'static) {
+    within(GUARD, test, body);
+}
+
+/// Drain `pieces`, which must stream exactly `len` bytes, and check the [`Pieces`] contract on
+/// the way: no piece is empty, every piece but the last is exactly [`PIECE_BYTES`] and the last
+/// at most that, the total never passes `len` (so a stream that never ends fails at once,
+/// holding no more than `len` bytes), and `size_hint` reports exactly the pieces still to
+/// come, before every step and after the end.
+fn drain(mut pieces: Pieces, len: u64) -> Vec<u8> {
+    let mut bytes: Vec<u8> = Vec::new();
+    let mut piece_lens: Vec<usize> = Vec::new();
+    let mut hints = vec![pieces.size_hint()];
+    while let Some(piece) = pieces.next() {
+        assert!(
+            !piece.is_empty(),
+            "an empty piece after {} bytes",
+            bytes.len()
+        );
+        assert!(piece.len() <= PIECE_BYTES, "a {}-byte piece", piece.len());
+        piece_lens.push(piece.len());
+        bytes.extend_from_slice(&piece);
+        assert!(
+            bytes.len() as u64 <= len,
+            "the stream passed its {len} bytes"
+        );
+        hints.push(pieces.size_hint());
+    }
+    assert_eq!(bytes.len() as u64, len, "the stream ended early");
+    if let Some((_, full)) = piece_lens.split_last() {
+        assert!(
+            full.iter().all(|piece_len| *piece_len == PIECE_BYTES),
+            "a short piece before the last: {piece_lens:?}"
+        );
+    }
+    // Before item k of n, exactly n - k remain; after the end, none.
+    let remaining: Vec<(usize, Option<usize>)> = (0..=piece_lens.len())
+        .rev()
+        .map(|left| (left, Some(left)))
+        .collect();
+    assert_eq!(hints, remaining, "size_hint against the pieces yielded");
+    // An ended stream stays ended.
+    assert!(pieces.next().is_none(), "a piece after the end");
+    assert_eq!(pieces.size_hint(), (0, Some(0)));
+    bytes
+}
+
+/// The whole payload, materialized through [`drain`]. Only for the small sizes these tests use.
+fn whole(payload: &Payload) -> Vec<u8> {
+    drain(payload.pieces(), payload.size())
+}
+
+/// `[start, start + len)` produced directly.
+fn direct(payload: &Payload, start: u64, len: usize) -> Vec<u8> {
+    let mut buf = vec![0; len];
+    payload
+        .fill(start, &mut buf)
+        .unwrap_or_else(|e| panic!("fill: {e}"));
+    buf
+}
+
+// ---- (A) Payload determinism: known answers --------------------------------------------------
+
+/// `(seed, key, size, generation, SHA-256 of the payload)`. The digests were produced by a
+/// separate process, and checked against an independent implementation of the construction
+/// written from `src/payload.rs`'s module docs alone. Any input the generator takes from
+/// process state breaks them; so does any change to the construction, which would silently
+/// invalidate every checkpoint ever written.
+const KNOWN_ANSWERS: [(&str, &str, u64, u64, &str); 6] = [
+    (
+        "424242",
+        "kat/empty",
+        0,
+        0,
+        "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
+    ),
+    (
+        "424242",
+        "kat/one",
+        1,
+        0,
+        "1f184f101c67d585ba00d24cfde36863f747fbab9e84af7760ec771e9b36ca51",
+    ),
+    (
+        "424242",
+        "kat/block",
+        32,
+        3,
+        "2e2ec4a04bbd9bedd9d0557cfbd8ae03a9a855ce49a407f494b1c145f138b0da",
+    ),
+    (
+        "424242",
+        "kat/4k",
+        4096,
+        1,
+        "a2e4f16a4135b8f9d108370cbff07e956d716f0d2f4cc5a51ea7d1114f1bf8a3",
+    ),
+    (
+        "seed-\u{fc}",
