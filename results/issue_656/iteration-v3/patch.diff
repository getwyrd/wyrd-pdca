@@ -0,0 +1,791 @@
+//! The multipart protocol's **store round trips** (proposal 0016) — the first writers of its
+//! session state machine that a client drives (#656, slice 3 of 7 of #636):
+//!
+//! * [`create_session`] — `CreateMultipartUpload`: admission through the serialized fleet ledger
+//!   `mpuctl`, plus the session and its segment-group reservation, in **one** batch
+//!   (`0016:657`); the two retry budgets #655 split are spent separately here, and an unknown
+//!   commit outcome is recovered under the **original** upload id (`0016:2009-2027`);
+//! * [`abort_session`] — `AbortMultipartUpload`, decision 3's Abort row (`0016:977`): an `Open`
+//!   session is fenced to `Aborting` with its teardown obligation in the same batch (`0016:665`);
+//! * [`fence_batch`] — that batch, built in one place for both teardown writers: the client Abort
+//!   here and the post-restore fence (`wyrd_custodian::restore`).
+//!
+//! Every answer is a value of the parent module's vocabulary ([`CreateOutcome`],
+//! [`AbortOutcome`], [`Refusal`], [`Backpressure`]); a typed error ([`CreateFault`],
+//! [`AbortFault`]) is reserved for what is not a protocol answer.
+//!
+//! # The invariant these batches keep (C-1, `docs/principles.md` §5)
+//!
+//! Every `mpu:` session and `seggrp:` marker a Create installs is counted by `mpuctl` **in the same
+//! batch**, and every Abort installs, in the same batch as its fence, the obligation naming
+//! everything the session protects. So no admitted and no fenced session is ever outside the reach
+//! of the actor that reclaims it (the retirement drain, #659; the reaper, #625). The count moves
+//! on admission (+1) and on the terminal delete (−1, #659) only — **never** on a fence: an
+//! `Aborting` session still holds its `mpu:` record, and a `Completed` tombstone stays counted
+//! (`0016:965-969`).
+//!
+//! # Nothing in production calls these yet
+//!
+//! The S3 verbs that call them arrive with #668, which also carries 0016's rule that the reaper
+//! (#625) and operator abort ship in the same release as any verb that creates sessions
+//! (`0016:236-268`). Until then no deployment can create a session.
+//!
+//! # Runtime-free (ADR-0009)
+//!
+//! Core reads no clock, draws no randomness and sleeps no task. The caller supplies all three:
+//! the creation instant and the clock that stamped it in [`CreateRequest`], and the identity
+//! bits, the backoff jitter and the backoff wait through [`CreateHost`] — the shape
+//! [`admission_backoff_millis`] was made pure for.
+
+use std::fmt;
+use std::future::Future;
+
+use wyrd_traits::{
+    BoxError, CommitOutcome, CommitUnknownResult, MetadataStore, Result, WriteBatch,
+};
+
+use super::{
+    abort_answer, admission_backoff_millis, decode_admission_record, decode_session_record,
+    mpu_key, AbortAnswer, AbortOutcome, AdmissionRecord, Backpressure, Budget, CreateOutcome,
+    Refusal, RetireObligation, SessionRecord, UploadId, MAX_COMPLETE_ATTEMPTS,
+    MAX_UPLOAD_ID_ATTEMPTS, MPUCTL_KEY,
+};
+use crate::metadata::{
+    self, bucket_key, flat_value_ceiling_crossed, seggrp_key, InodeId, SegmentNonce, SEGGRP_MARKER,
+};
+
+// ===========================================================================
+// Create — `0016:657`, the admission arithmetic of `0016:2000-2039`
+// ===========================================================================
+
+/// What one `CreateMultipartUpload` asks for: the bucket whose existence it is conditioned on, the
+/// dirent identity the session will publish, and the stamps the session records.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct CreateRequest {
+    /// The bucket's name. Create requires its `bucket:<name>` marker
+    /// ([`crate::metadata::bucket_key`]) to hold the exact bytes it read (ADR-0046 §4).
+    pub bucket: String,
+    /// The bucket inode the session targets ([`SessionRecord::parent`]).
+    pub parent: InodeId,
+    /// The object name the session will publish ([`SessionRecord::object`]).
+    pub object: String,
+    /// The client's declared content type, if any; omitted from the record when absent.
+    pub content_type: Option<String>,
+    /// When the create was accepted, in milliseconds of the clock `clock_source` names. Core reads
+    /// no clock: this is the caller's read of the **deployment wall clock**, the one source that
+    /// owns a session's whole abandonment lifecycle (`0016:1950-1957`, ADR-0009 — madsim
+    /// virtualises it under DST).
+    pub created_at_millis: u64,
+    /// The clock that stamped `created_at_millis`. The reaper judges a session only under a clock
+    /// it owns, and every later stamp on this session must come from the same one
+    /// (`0016:1957-1990`).
+    pub clock_source: String,
+}
+
+/// What a create needs from its caller that core cannot own (ADR-0009): randomness for the
+/// identities it mints and for its backoff, and the backoff wait itself.
+pub trait CreateHost {
+    /// 128 fresh random bits for an identity. Called twice per identity — the upload id first,
+    /// then the segment-group nonce — and rendered as 32 lowercase-hex characters, the grammar
+    /// both share (`0016:493-497`, `:499-527`). An identity is minted once per create, and again
+    /// only after a collision.
+    fn mint(&mut self) -> u128;
+
+    /// A fresh random `u64` placing one backoff inside its window
+    /// ([`admission_backoff_millis`]'s `jitter`).
+    fn jitter(&mut self) -> u64;
+
+    /// Wait `millis` milliseconds before the next admission attempt.
+    fn wait(&mut self, millis: u64) -> impl Future<Output = ()> + Send;
+}
+
+/// Why a create ended with neither a session nor a protocol answer. Typed, so a caller tells it
+/// from a store fault with one `downcast_ref` — the convention [`CommitUnknownResult`] set.
+#[derive(Debug)]
+pub enum CreateFault {
+    /// Every one of [`MAX_UPLOAD_ID_ATTEMPTS`] minted identities collided with a record another
+    /// session holds — its `mpu:<id>`, or its `seggrp:<nonce>`, which outlives an adopted
+    /// session (`0016:499-527`). Each mint is a 2^-128 event, so this says the caller's
+    /// randomness is broken, not that the fleet is busy: a server fault, never a backpressure
+    /// answer to the client. Nothing was written.
+    IdentitiesExhausted {
+        /// Identities minted.
+        attempts: u32,
+    },
+    /// The session this request would install outgrows, in a later state, the value ceiling
+    /// every backend inherits ([`crate::metadata::MAX_VALUE_BYTES`]): its widest later form —
+    /// `Completing` names the object a second time, and every state may carry wider numbers
+    /// than `Open@0` — encodes to `bytes`. Every later transition puts the whole record, so such
+    /// a session could be admitted and then never fenced, completed or torn down, holding its
+    /// admission slot for good. Refused before anything is read or written. The object name,
+    /// content type and clock source come from the caller, so this is caller input past a bound
+    /// (an S3 key is at most 1024 bytes, far inside it): 0016 names no protocol answer for it,
+    /// and the gateway (#668) maps it to a client error.
+    SessionTooLarge {
+        /// The encoded length of the session's widest later form.
+        bytes: usize,
+        /// The ceiling it crossed.
+        ceiling: usize,
+    },
+    /// A create batch's outcome was unknown and the create ended before settling it, so its
+    /// session may still land, admitted and counted, under this identity.
+    Unsettled(Box<UnsettledCreate>),
+}
+
+/// A create that ended while one of its batches may still land: the identity, so it can be named
+/// on the audit seam and found by the reaper (#625), and what ended it.
+#[derive(Debug)]
+pub struct UnsettledCreate {
+    /// The upload id the in-doubt batch would install. No client was told it.
+    pub upload_id: UploadId,
+    /// The segment-group nonce the in-doubt batch would reserve.
+    pub segment_nonce: SegmentNonce,
+    /// The outcome the store could not report.
+    pub unknown: CommitUnknownResult,
+    /// What ended the create first.
+    pub ended: CreateEnd,
+}
+
+/// What ended a create whose last batch was still in doubt.
+#[derive(Debug)]
+pub enum CreateEnd {
+    /// The answer it would have given, had no batch of it been in doubt.
+    Refused(Refusal),
+    /// The identity collided. It is not re-minted while a batch under it may still land: that
+    /// is the stranded-session case `0016:2009-2027` exists to close.
+    Collided,
+    /// A store fault.
+    Fault(BoxError),
+}
+
+impl fmt::Display for CreateFault {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            Self::IdentitiesExhausted { attempts } => write!(
+                f,
+                "multipart create: all {attempts} minted upload ids collided with existing \
+                 sessions — a 2^-128 event per mint, so the identity source is broken; nothing \
+                 was written"
+            ),
+            Self::SessionTooLarge { bytes, ceiling } => write!(
+                f,
+                "multipart create: the session would encode to {bytes} bytes in its widest later \
+                 state, past the {ceiling}-byte value ceiling, so it could never be fenced or \
+                 torn down; nothing was written"
+            ),
+            Self::Unsettled(unsettled) => {
+                let ended = match &unsettled.ended {
+                    CreateEnd::Refused(refusal) => format!("would have answered {refusal:?}"),
+                    CreateEnd::Collided => "its identity collided".to_owned(),
+                    CreateEnd::Fault(fault) => format!("store fault: {fault}"),
+                };
+                write!(
+                    f,
+                    "multipart create: upload {} (segment group {}) may still be admitted — a \
+                     batch's outcome is unknown ({}) and the create ended before settling it \
+                     ({ended}); the reaper reclaims it if it lands",
+                    unsettled.upload_id, unsettled.segment_nonce, unsettled.unknown.detail
+                )
+            }
+        }
+    }
+}
+
+impl std::error::Error for CreateFault {}
+
+/// An upload id and the segment-group nonce minted with it — the identity one admission attempt
+/// installs, kept across an unknown outcome so the re-drive installs the **same** one.
+struct Identity {
+    upload_id: UploadId,
+    segment_nonce: SegmentNonce,
+    /// Whether both of its keys were read vacant ([`Self::vacant`]) — done once, before the
+    /// identity's first batch.
+    checked: bool,
+}
+
+impl Identity {
+    /// Mint a fresh identity from the caller's randomness. 32 lowercase-hex digits is the one
+    /// spelling both validating constructors accept, so neither `?` can fire.
+    fn mint(host: &mut impl CreateHost) -> Result<Self> {
+        let upload_id = UploadId::new(format!("{:032x}", host.mint()))?;
+        let segment_nonce = SegmentNonce::new(format!("{:032x}", host.mint()))?;
+        Ok(Self {
+            upload_id,
+            segment_nonce,
+            checked: false,
+        })
+    }
+
+    /// Whether this identity's `mpu:<id>` and `seggrp:<nonce>` are both absent. Read before its
+    /// first batch, so that a session found at `mpu:<id>` later, while a batch is in doubt, was
+    /// put there after this create began — never one that was there all along, which an unknown
+    /// outcome says nothing about. Without this read, an identity source that repeats an
+    /// existing upload's id and nonce, then a first commit answered `CommitUnknownResult`
+    /// without landing, would hand the caller that upload's id as `Created`, with no count.
+    async fn vacant(&self, store: &impl MetadataStore) -> Result<bool> {
+        let session = store.get(&mpu_key(&self.upload_id)).await?;
+        let group = store.get(&seggrp_key(&self.segment_nonce)).await?;
+        Ok(session.is_none() && group.is_none())
+    }
+
+    /// Whether `found` — the value at this identity's `mpu:` key — is **this attempt's own**
+    /// session: every field the create wrote and no transition rewrites — nonce, bucket inode,
+    /// object, content type, creation stamp and its clock — equal to this create's
+    /// (`0016:2009-2027`). A value that does not decode is not one this writer could have
+    /// produced.
+    ///
+    /// Asked **only while a batch of this identity is in doubt**, and only of an identity whose
+    /// keys were read vacant before its first batch ([`Self::vacant`]): then nothing but that
+    /// batch can have put such a session there, so finding it means the batch landed. With
+    /// nothing in doubt the same find is a collision, whatever the session holds — a caller
+    /// whose identity source repeats an id and nonce must be re-minted, never handed another
+    /// upload's id. One case is left that no record can settle: a **concurrent** create handed
+    /// the very same identity for a request equal in every field, which writes byte-identical
+    /// bytes.
+    fn owns(&self, request: &CreateRequest, found: &[u8]) -> bool {
+        decode_session_record(found).is_ok_and(|session| {
+            session.segment_nonce() == &self.segment_nonce
+                && session.parent() == request.parent
+                && session.object() == request.object
+                && session.content_type() == request.content_type.as_deref()
+                && session.created_at_millis() == request.created_at_millis
+                && session.clock_source() == request.clock_source
+        })
+    }
+}
+
+/// What one admission attempt came to.
+enum Step {
+    /// This identity's session is durable — by this attempt's commit, or by an earlier in-doubt
+    /// one found landed.
+    Created,
+    /// A protocol answer that ends the create and writes nothing.
+    Refused(Refusal),
+    /// The identity's `mpu:<id>` or `seggrp:<nonce>` is another session's: re-mint.
+    Collided,
+    /// Another writer moved `mpuctl` under this attempt: back off and retry.
+    Contended,
+    /// The store could not report the commit's outcome: re-drive the same identity.
+    Unknown,
+}
+
+/// **`CreateMultipartUpload`** (`0016:657`): admit one session through the fleet ledger `mpuctl`
+/// and create it, answering [`CreateOutcome`].
+///
+/// Each attempt reads the bucket marker and the ledger — and, on an identity's first attempt,
+/// both of that identity's keys — then commits **one** batch:
+///
+/// * `require(bucket:<name> == the marker bytes read)` — ADR-0046 §4, `0046:93-95`;
+/// * the ledger: `require(mpuctl == the bytes read)` and a put of the same record at `count + 1`,
+///   admitted only while `count < max_sessions` — the **stored** limit — and only when the
+///   caller's `local` profile equals the stored one; or, with no ledger yet,
+///   `require_absent(mpuctl)` and a bootstrap `{count: 1, max_sessions, profile}` from `local`;
+/// * `require_absent(mpu:<id>)` and `require_absent(seggrp:<nonce>)`, and puts of the `Open`
+///   session and the marker.
+///
+/// A `Conflict` is re-read to find **which** precondition lost:
+///
+/// * the bucket marker gone or changed — `Refused(NoSuchBucket)`;
+/// * `mpu:<id>` or `seggrp:<nonce>` another session's — a **collision**: mint a new identity, at
+///   most [`MAX_UPLOAD_ID_ATTEMPTS`] in all, else [`CreateFault::IdentitiesExhausted`];
+/// * otherwise the ledger moved — **contention**: wait [`admission_backoff_millis`] and retry, at
+///   most [`Budget::max_sessions`] of `local` attempts — the stored limit, since only a ledger
+///   whose profile is `local` is admitted against — else `Refused(SlowDown { AdmissionContention
+///   })`. Among creates every lost CAS is another session admitted, so this refusal is the
+///   capacity bound, never a lost race: what [`MAX_ADMISSION_CAS_ATTEMPTS`] is at the shipped
+///   profile, under any profile.
+///
+/// The two budgets never share a count: a lost ledger CAS mints nothing, and a collision is not a
+/// lost CAS (#655; the #508 defect was one budget, sized for a 2^-128 collision, refusing ordinary
+/// concurrency on an empty store). Before an identity's first batch both of its keys are read,
+/// and one found taken is the same collision, found without a commit — so a session at
+/// `mpu:<id>` that predates this create is never mistaken for its own under an unknown outcome
+/// (below).
+///
+/// # The session must fit every state it can reach
+///
+/// Before anything is read or written, the session the request would install is weighed in its
+/// widest later form — every state it can move to, with every number at its widest, as
+/// [`crate::metadata::encode`] spells it — against the value ceiling every backend inherits
+/// ([`crate::metadata::MAX_VALUE_BYTES`], by [`flat_value_ceiling_crossed`]). Each later
+/// transition puts the whole record, and `Completing` names the object a second time, so a
+/// session that fits only as `Open` would be admitted and counted, and then neither fenced nor
+/// torn down: [`CreateFault::SessionTooLarge`].
+///
+/// # An unknown commit outcome (`0016:2009-2027`)
+///
+/// A [`CommitUnknownResult`] is never read as `Conflict` and never answered by minting a new id.
+/// The identity survives it; the next attempt first re-reads `mpu:<id>` and answers `Created` if
+/// the batch landed (no second increment), and otherwise re-drives the **same** identity with the
+/// ledger precondition rebuilt from a fresh read — a replay of the identical batch could never
+/// commit once the ledger moved. `require_absent(mpu:<id>)` alone makes the attempts mutually
+/// exclusive, so at most one lands. With `may_still_commit == false` that one re-read settles it.
+/// With `true`, an absent re-read proves nothing (`crates/traits/src/lib.rs:240-247`), so the
+/// doubt stays until a batch of the identity is seen committed. Only while a batch is in doubt is
+/// a session found at `mpu:<id>` taken for this create's own, and only one equal to this
+/// create's request in every field it wrote; otherwise it is a collision.
+///
+/// A create that is about to end while a batch is still in doubt — refused, out of budget, or on a
+/// store fault — first reads `mpu:<id>` once more, because the batch may have landed after the
+/// last look (even between the attempt's own reads, filling the ledger it then found full). Found,
+/// the answer is `Created`. Not found, an out-of-flight batch never landed, so the ending stands
+/// as it is; one that may still land ends the create in [`CreateFault::Unsettled`], which carries
+/// the identity — never in a refusal that would strand an admitted session no client can name.
+/// An unknown outcome spends the contention budget, as any attempt that neither won nor collided
+/// does, so a store that cannot report outcomes ends the create rather than looping.
+///
+/// # Refusals write nothing
+///
+/// Every refusal is decided from reads before any commit, or from a commit that was a `Conflict`
+/// — so a refused create leaves the store byte-identical.
+///
+/// # Errors
+///
+/// A store fault ([`CreateFault::Unsettled`] when a batch was in doubt); a torn ledger
+/// ([`super::RecordError`] from [`decode_admission_record`]); [`CreateFault`] — including
+/// [`CreateFault::SessionTooLarge`], before anything is read.
+///
+/// [`MAX_ADMISSION_CAS_ATTEMPTS`]: super::MAX_ADMISSION_CAS_ATTEMPTS
+pub async fn create_session<H: CreateHost>(
+    store: &impl MetadataStore,
+    request: &CreateRequest,
+    local: &Budget,
+    host: &mut H,
+) -> Result<CreateOutcome> {
+    let budget = contention_budget(local);
+    let mut identity = Identity::mint(host)?;
+    // Every identity is the same width (32 hex digits each), so one weighing serves them all.
+    let widest = SessionRecord::open(request, identity.segment_nonce.clone()).widest_encoding();
+    if let Some(ceiling) = flat_value_ceiling_crossed(&widest) {
+        return Err(CreateFault::SessionTooLarge {
+            bytes: widest.len(),
+            ceiling,
+        }
+        .into());
+    }
+    let mut minted: u32 = 1;
+    let mut contended: u32 = 0;
+    // The outcome of an earlier batch of `identity` that the store could not report.
+    let mut doubt: Option<CommitUnknownResult> = None;
+    // How the create ends when no session was seen: a refusal, or a store fault.
+    let ending: Result<Refusal> = loop {
+        let step = match attempt(store, request, local, &mut identity, &mut doubt).await {
+            Ok(step) => step,
+            Err(fault) => break Err(fault),
+        };
+        match step {
+            Step::Created => {
+                return Ok(CreateOutcome::Created {
+                    upload_id: identity.upload_id,
+                })
+            }
+            Step::Refused(refusal) => break Ok(refusal),
+            Step::Collided => {
+                // `doubt` here is one that may still land: an out-of-flight one was settled by
+                // the attempt's first read. The identity cannot be re-minted under it.
+                if let Some(unknown) = doubt {
+                    return Err(unsettled(identity, unknown, CreateEnd::Collided));
+                }
+                if minted >= MAX_UPLOAD_ID_ATTEMPTS {
+                    return Err(CreateFault::IdentitiesExhausted { attempts: minted }.into());
+                }
+                identity = Identity::mint(host)?;
+                minted += 1;
+            }
+            Step::Contended | Step::Unknown => {
+                contended += 1;
+                if contended >= budget {
+                    let pressure = Backpressure::AdmissionContention {
+                        attempts: contended,
+                    };
+                    break Ok(Refusal::SlowDown { pressure });
+                }
+                let jitter = host.jitter();
+                host.wait(admission_backoff_millis(contended - 1, jitter))
+                    .await;
+            }
+        }
+    };
+    match doubt {
+        None => ending.map(CreateOutcome::Refused),
+        Some(unknown) => settle(store, request, identity, unknown, ending).await,
+    }
+}
+
+/// The contention budget of a create admitting against `profile`: its
+/// [`Budget::max_sessions`], which is also the stored ledger's limit, since a create commits only
+/// against a ledger whose profile equals `profile` (G8 ties the limit to the profile).
+///
+/// Among creates, every lost ledger CAS is one more session admitted, so a create that has lost
+/// this many times has watched the ledger fill: its refusal is the capacity bound, never a lost
+/// race. That is the derivation [`MAX_ADMISSION_CAS_ATTEMPTS`] is of the shipped profile, and
+/// the relation [`knob_clamps_hold`] holds a configured budget to
+/// ([`KnobClamp::AdmissionCasBelowSessions`]). A fixed count would refuse ordinary concurrency
+/// on a ledger with room under any profile larger than the shipped one — the #508 defect again.
+///
+/// [`MAX_ADMISSION_CAS_ATTEMPTS`]: super::MAX_ADMISSION_CAS_ATTEMPTS
+/// [`knob_clamps_hold`]: super::knob_clamps_hold
+/// [`KnobClamp::AdmissionCasBelowSessions`]: super::KnobClamp::AdmissionCasBelowSessions
+fn contention_budget(profile: &Budget) -> u32 {
+    // `max_sessions` is clamped to `SCAN_CAP / 2`, so this never saturates.
+    u32::try_from(profile.max_sessions()).unwrap_or(u32::MAX)
+}
+
+/// The create is ending with `ending` while a batch of `identity` is in doubt. That batch may
+/// have landed since the last look, so look once more (`0016:2025-2027`): this create's own
+/// session there is `Created`. Otherwise an out-of-flight batch never landed and `ending`
+/// stands; one that may still land — or a look that failed — ends the create
+/// [`CreateFault::Unsettled`], naming the identity.
+async fn settle(
+    store: &impl MetadataStore,
+    request: &CreateRequest,
+    identity: Identity,
+    unknown: CommitUnknownResult,
+    ending: Result<Refusal>,
+) -> Result<CreateOutcome> {
+    match store.get(&mpu_key(&identity.upload_id)).await {
+        Ok(Some(found)) if identity.owns(request, &found) => Ok(CreateOutcome::Created {
+            upload_id: identity.upload_id,
+        }),
+        Ok(_) if !unknown.may_still_commit => ending.map(CreateOutcome::Refused),
+        // The look's own fault is dropped: what ended the create is `ending`, and the identity
+        // is what the caller needs.
+        _ => {
+            let ended = match ending {
+                Ok(refusal) => CreateEnd::Refused(refusal),
+                Err(fault) => CreateEnd::Fault(fault),
+            };
+            Err(unsettled(identity, unknown, ended))
+        }
+    }
+}
+
+/// One admission attempt under `identity` (see [`create_session`]).
+async fn attempt(
+    store: &impl MetadataStore,
+    request: &CreateRequest,
+    local: &Budget,
+    identity: &mut Identity,
+    doubt: &mut Option<CommitUnknownResult>,
+) -> Result<Step> {
+    // An earlier batch of this identity may have landed: look before building another, so a
+    // landed one is answered and never admitted twice.
+    if let Some(unknown) = doubt.as_ref() {
+        let found = store.get(&mpu_key(&identity.upload_id)).await?;
+        if found
+            .as_deref()
+            .is_some_and(|found| identity.owns(request, found))
+        {
+            return Ok(Step::Created);
+        }
+        // Out of flight and not ours to find: it did not land, and never will.
+        if !unknown.may_still_commit {
+            *doubt = None;
+        }
+        if found.is_some() {
+            return Ok(Step::Collided);
+        }
+    }
+    let Some(marker) = store.get(&bucket_key(&request.bucket)).await? else {
+        return Ok(Step::Refused(Refusal::NoSuchBucket));
+    };
+    let prior = store.get(MPUCTL_KEY).await?;
+    let ledger = match prior.as_deref() {
+        None => AdmissionRecord::bootstrap(*local),
+        Some(bytes) => {
+            let ledger = decode_admission_record(bytes)?;
+            // The profile first: the stored limit belongs to the stored profile, so a process
+            // that derives another one must not admit against either (`0016:348`).
+            if ledger.profile() != local {
+                return Ok(Step::Refused(Refusal::ProfileSkew {
+                    local: *local,
+                    ledger: *ledger.profile(),
+                }));
+            }
+            let Some(next) = ledger.admit() else {
+                let pressure = Backpressure::SessionCap {
+                    count: ledger.count(),
+                    max_sessions: ledger.max_sessions(),
+                };
+                return Ok(Step::Refused(Refusal::SlowDown { pressure }));
+            };
+            next
+        }
+    };
+    // A fresh identity's keys, once, before its first batch: nothing is in doubt yet, so a
+    // record found there is another session's.
+    if !identity.checked {
+        if !identity.vacant(store).await? {
+            return Ok(Step::Collided);
+        }
+        identity.checked = true;
+    }
+    let session = SessionRecord::open(request, identity.segment_nonce.clone());
+    let batch = create_batch(
+        request,
+        identity,
+        &marker,
+        prior.as_deref(),
+        &session,
+        &ledger,
+    );
+    match store.commit(batch).await {
+        Ok(CommitOutcome::Committed) => Ok(Step::Created),
+        Ok(CommitOutcome::Conflict) => {
+            lost(store, request, identity, &marker, doubt.is_some()).await
+        }
+        Err(fault) => {
+            let Some(unknown) = fault.downcast_ref::<CommitUnknownResult>() else {
+                return Err(fault);
+            };
+            // Keep the doubt that can still land: a batch left in flight earlier stays in
+            // flight whatever a later one reports.
+            if !doubt.as_ref().is_some_and(|held| held.may_still_commit) {
+                *doubt = Some(unknown.clone());
+            }
+            Ok(Step::Unknown)
+        }
+    }
+}
+
+/// The create batch (`0016:657`) — preconditions first, then the three puts.
+fn create_batch(
+    request: &CreateRequest,
+    identity: &Identity,
+    marker: &[u8],
+    prior: Option<&[u8]>,
+    session: &SessionRecord,
+    ledger: &AdmissionRecord,
+) -> WriteBatch {
+    let session_key = mpu_key(&identity.upload_id);
+    let group_key = seggrp_key(&identity.segment_nonce);
+    // The bucket-existence precondition, in this one place (ADR-0046 §4, `0046:93-95`): the
+    // marker's exact bytes.
+    // deferred: #511 — §4's other half, `require_absent` on the bucket's deletion fence
+    // (decision 5), joins it here once #511 defines that key; nothing on `main` writes one.
+    let batch = WriteBatch::new().require(bucket_key(&request.bucket), marker.to_vec());
+    let batch = match prior {
+        Some(bytes) => batch.require(MPUCTL_KEY, bytes.to_vec()),
+        None => batch.require_absent(MPUCTL_KEY),
+    };
+    batch
+        .require_absent(session_key.clone())
+        .require_absent(group_key.clone())
+        .put(session_key, metadata::encode(session))
+        .put(group_key, SEGGRP_MARKER)
+        .put(MPUCTL_KEY, metadata::encode(ledger))
+}
+
+/// Classify a lost create batch by re-reading what it required. The ledger is the one
+/// precondition not re-read: every other one still holding means it is the one that moved — or
+/// moved and came back (an admission, then a terminal delete), which is the same lost race.
+///
+/// `in_doubt`: an earlier batch of this identity may still land. Only then can the session at
+/// `mpu:<id>` be this create's own (see [`Identity::owns`]); otherwise it is a collision.
+async fn lost(
+    store: &impl MetadataStore,
+    request: &CreateRequest,
+    identity: &Identity,
+    marker: &[u8],
+    in_doubt: bool,
+) -> Result<Step> {
+    // The marker before the session: an in-doubt batch installs both at once, so one landing
+    // between the two reads shows as this create's own session, never as a collision.
+    let group = store.get(&seggrp_key(&identity.segment_nonce)).await?;
+    let found = store.get(&mpu_key(&identity.upload_id)).await?;
+    // The in-doubt batch landed before this one.
+    if in_doubt
+        && found
+            .as_deref()
+            .is_some_and(|found| identity.owns(request, found))
+    {
+        return Ok(Step::Created);
+    }
+    if store.get(&bucket_key(&request.bucket)).await?.as_deref() != Some(marker) {
+        return Ok(Step::Refused(Refusal::NoSuchBucket));
+    }
+    if found.is_some() || group.is_some() {
+        return Ok(Step::Collided);
+    }
+    Ok(Step::Contended)
+}
+
+fn unsettled(identity: Identity, unknown: CommitUnknownResult, ended: CreateEnd) -> BoxError {
+    CreateFault::Unsettled(Box::new(UnsettledCreate {
+        upload_id: identity.upload_id,
+        segment_nonce: identity.segment_nonce,
+        unknown,
+        ended,
+    }))
+    .into()
+}
+
+// ===========================================================================
+// Abort — `0016:665`, decision 3's row `0016:977`
+// ===========================================================================
+
+/// Rounds one Abort may spend. A round ends without an answer only when the fence lost to a
+/// session that moved, or its outcome was unknown. A session the Abort finds `Open` again has had
+/// a Complete fence rolled back, and each Complete fence spends one of the session's
+/// [`MAX_COMPLETE_ATTEMPTS`] (`0016:661`), so a session is `Open` in at most that many epochs plus
+/// its first. An unknown outcome spends a round too, so a store that cannot report outcomes ends
+/// the Abort with that error rather than looping.
+const ABORT_ROUNDS: u32 = MAX_COMPLETE_ATTEMPTS + 1;
+
+/// Why an Abort ended with no protocol answer.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum AbortFault {
+    /// The session is `Open` at `u64::MAX`: no epoch is left to fence it at (`0016:704-708`).
+    EpochExhausted,
+    /// The fence lost while the session stayed byte-identical, so its obligation key is already
+    /// taken. A retirement token is minted once (`0016:358-373`): this is damage a retry cannot
+    /// settle.
+    ObligationKeyTaken {
+        /// The taken `retire:` key, as UTF-8 (lossy).
+        key: String,
+    },
+    /// Every round the Abort may spend — one per epoch a session can be `Open` in,
+    /// [`MAX_COMPLETE_ATTEMPTS`] `+ 1` — found the session `Open` and lost its fence to a move,
+    /// and the last round's re-read still found it `Open`. The session is left as that read
+    /// found it; the client may retry.
+    RoundsExhausted {
+        /// Rounds spent.
+        rounds: u32,
+    },
+}
+
+impl fmt::Display for AbortFault {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            Self::EpochExhausted => f.write_str(
+                "multipart abort: the session is Open at the last epoch; no fence can bump it",
+            ),
+            Self::ObligationKeyTaken { key } => write!(
+                f,
+                "multipart abort: the teardown obligation key {key} is already taken while the \
+                 session is unchanged — a token is minted once, so this is damage"
+            ),
+            Self::RoundsExhausted { rounds } => write!(
+                f,
+                "multipart abort: the session moved under all {rounds} fence attempts"
+            ),
+        }
+    }
+}
+
+impl std::error::Error for AbortFault {}
+
+/// **`AbortMultipartUpload`** (`0016:665`, decision 3's row `0016:977`), answering
+/// [`AbortOutcome`] by [`abort_answer`]'s table:
+///
+/// * `Open@E` — fence it: one [`fence_batch`] committing [`SessionRecord::open_teardown`]'s
+///   `Aborting@E+1` session and its `retire:bytes:s:<id>:<E>` `{session, all}` obligation, under
+///   `require` of the exact bytes read and `require_absent` of the obligation key. A client Abort
+///   pins no slots (`0016:665`). Answers `Fenced`;
+/// * `Aborting` — `AlreadyAborting` (idempotent);
+/// * `Completing` — `Refused(OperationAborted)`: a client Abort never takes the `Completing →
+///   Aborting` edge;
+/// * `Completed`, or no record — `Refused(NoSuchUpload)`.
+///
+/// A lost fence is re-read once and answered from the state found, so two Aborts racing one
+/// `Open` session answer one `Fenced` and one `AlreadyAborting`, never `OperationAborted`; a
+/// session that moved to a later `Open@E'` is fenced again at `E'`. An unknown commit outcome is
+/// never read as a `Conflict`: the session is re-read, and an unchanged one is fenced again with
+/// the identical batch, which is safe because each copy requires the same session bytes, so at
+/// most one lands. The last round's re-read is answered like every other — a fence found landed
+/// is `AlreadyAborting`, not an error — and only a session still `Open` after
+/// [`MAX_COMPLETE_ATTEMPTS`] `+ 1` rounds ends the Abort without an answer.
+///
+/// **The admission count is never touched**: a fenced session still holds its `mpu:` record, and
+/// the only decrement is the terminal delete (#659).
+///
+/// # Errors
+///
+/// A store fault, returned as it came, never retried; a torn session record
+/// ([`super::RecordError`]); [`AbortFault`]; and, when the session is still `Open` after the last
+/// round and that round's outcome was unknown, that [`CommitUnknownResult`].
+pub async fn abort_session(
+    store: &impl MetadataStore,
+    upload_id: &UploadId,
+) -> Result<AbortOutcome> {
+    let key = mpu_key(upload_id);
+    let mut read = store.get(&key).await?;
+    // The last round's outcome, when the store could not report it.
+    let mut unknown: Option<BoxError> = None;
+    let mut rounds: u32 = 0;
+    loop {
+        // Every read is answered from the state it found — the first, and each round's re-read,
+        // the last one's included: a fence that landed under an unknown outcome, or a rival
+        // Abort that won the last round, is an answer, not an exhausted budget.
+        let Some(bytes) = read else {
+            return Ok(AbortOutcome::Refused(Refusal::NoSuchUpload));
+        };
+        let record = decode_session_record(&bytes)?;
+        match abort_answer(Some(record.state())) {
+            AbortAnswer::Fences => {}
+            AbortAnswer::AlreadyAborting => return Ok(AbortOutcome::AlreadyAborting),
+            AbortAnswer::Refused(refusal) => return Ok(AbortOutcome::Refused(refusal)),
+        }
+        // Still `Open` after every round this Abort may spend.
+        if rounds == ABORT_ROUNDS {
+            return Err(unknown.unwrap_or_else(|| AbortFault::RoundsExhausted { rounds }.into()));
+        }
+        rounds += 1;
+        let teardown = record
+            .open_teardown(upload_id)
+            .ok_or(AbortFault::EpochExhausted)?;
+        let owed = std::slice::from_ref(teardown.obligation());
+        let batch = fence_batch(upload_id, &bytes, teardown.session(), owed);
+        match store.commit(batch).await {
+            Ok(CommitOutcome::Committed) => return Ok(AbortOutcome::Fenced),
+            Ok(CommitOutcome::Conflict) => {
+                read = store.get(&key).await?;
+                if read.as_deref() == Some(&bytes[..]) {
+                    let key = String::from_utf8_lossy(&teardown.obligation().key()).into_owned();
+                    return Err(AbortFault::ObligationKeyTaken { key }.into());
+                }
+                unknown = None;
+            }
+            Err(fault) if fault.downcast_ref::<CommitUnknownResult>().is_some() => {
+                read = store.get(&key).await?;
+                unknown = Some(fault);
+            }
+            Err(fault) => return Err(fault),
+        }
+    }
+}
+
+// ===========================================================================
+// The fence batch — one builder for every teardown writer
+// ===========================================================================
+
+/// The **teardown fence batch** (`0016:665`, `:666`): the session read as `read` under
+/// `mpu:<upload_id>` moves to `fenced`, and every obligation in `obligations` is installed
+/// beside it, in one commit or not at all.
+///
+/// Preconditions first — `require(mpu:<id> == read)`, then `require_absent` of each obligation's
+/// key, in order (`0016:676-682`: every row installing a `retire:` obligation carries one) — then
+/// a put of `fenced` and a put of each obligation, in the same order.
+///
+/// **One builder for both writers of the edge**: the client Abort ([`abort_session`], one
+/// `{session, all}` obligation from [`SessionRecord::open_teardown`]) and the post-restore fence
+/// (`wyrd_custodian::restore`, which also fences `Completing` sessions with
+/// [`SessionRecord::completing_teardown`]'s two). Two copies of these preconditions are what
+/// drifts apart; the record halves were already shared (#841, #842), and this is the batch half.
+pub fn fence_batch(
+    upload_id: &UploadId,
+    read: &[u8],
+    fenced: &SessionRecord,
+    obligations: &[RetireObligation],
+) -> WriteBatch {
+    let key = mpu_key(upload_id);
+    let mut batch = WriteBatch::new().require(key.clone(), read.to_vec());
+    for obligation in obligations {
+        batch = batch.require_absent(obligation.key());
+    }
+    batch = batch.put(key, metadata::encode(fenced));
+    for obligation in obligations {
+        batch = batch.put(obligation.key(), metadata::encode(obligation.payload()));
+    }
+    batch
+}
diff --git a/crates/core/tests/multipart_create_abort.rs b/crates/core/tests/multipart_create_abort.rs
new file mode 100644
index 0000000..0409fa4
--- /dev/null
+++ b/crates/core/tests/multipart_create_abort.rs
@@ -0,0 +1,2750 @@
+//! Issue #656 — the multipart protocol's first store round trips, driven over a real
+//! `RedbMetadataStore` with real preconditions and real contention:
+//! `CreateMultipartUpload`'s admission through the serialized fleet ledger `mpuctl` (proposal
+//! 0016 `:657`, `:2000-2039`) and `AbortMultipartUpload`'s teardown fence (`:665`, decision 3's
+//! row `:977`), both `wyrd_core::multipart::store`.
+//!
+//! The legs, by the brief's letters:
+//!
+//! * **(A)** 8, 10 and 16 free-running concurrent creates, each level on a fresh store, on a
+//!   multi-thread runtime: every one admitted, ids distinct, and the store holds exactly N
+//!   sessions, N markers and a ledger counting N.
+//! * **(A′)** 8 creates through [`Interposer`]'s commit barrier, which holds every commit until
+//!   every live creator has read the ledger and built its batch — so each round has exactly one
+//!   winner and every other creator loses the ledger CAS. The last creator loses it 7 times,
+//!   more than `MAX_UPLOAD_ID_ATTEMPTS`, and still gets its session. A collision-sized or shared
+//!   budget fails this on every run, not on an unlucky schedule. The same barrier with 47
+//!   creators under a profile larger than the shipped one shows the contention budget follows the
+//!   profile's own session limit, not the shipped 46.
+//! * **(B)** the real bounds — the stored session cap, a profile skew, an absent bucket, a
+//!   bucket marker deleted or rewritten between Create's read and its commit, and a session too
+//!   large for a state it can later reach, found at the exact encoded-byte boundary through a
+//!   store that enforces the backend value ceiling — each leaving the store byte-identical.
+//! * **(C)** the two retry budgets kept apart: a collision re-mints, every mint colliding fails,
+//!   a collision — found by the read before an identity's first commit, or by a lost commit —
+//!   does not spend the contention budget (nor a lost CAS the collision one), and an identity
+//!   source that repeats an existing session's identity is re-minted, never handed that session,
+//!   even when its first commit's outcome is unknown.
+//! * **(D)** Abort per decision 3, including two Aborts forced to race one `Open` session, and the
+//!   last round's re-read answered like any other.
+//! * **(E)** Abort never moves `mpuctl.count`, and a `Completed` tombstone stays counted.
+//! * **(F)** an unknown Create outcome — applied, not applied, and applied *late* (after the
+//!   re-drive, or between the recovery's reads) — recovered under the original upload id, with one
+//!   session, one marker and one increment; settled even on the create's last permitted attempt;
+//!   and only a batch in doubt can make a found session this create's own, and only one equal to
+//!   it in every field the create wrote.
+//!
+//! [`Interposer`] keeps all its state in struct fields, never a `static` (ADR-0035).
+//!
+//! No `#![cfg(...)]` here — this file always compiles and always runs.
+
+#![forbid(unsafe_code)]
+
+use std::collections::{BTreeMap, BTreeSet, VecDeque};
+use std::future::Future;
+use std::ops::RangeInclusive;
+use std::sync::{Arc, Mutex};
+use std::time::Duration;
+
+use async_trait::async_trait;
+use bytes::Bytes;
+use tokio::sync::Notify;
+use wyrd_core::metadata::{
+    self, bucket_key, seggrp_key, InodeId, SegmentNonce, MAX_SEGMENT_INDEX, MAX_VALUE_BYTES,
+    SEGGRP_MARKER, SEGGRP_PREFIX,
+};
+use wyrd_core::multipart::store::{
+    abort_session, create_session, fence_batch, AbortFault, CreateEnd, CreateFault, CreateHost,
+    CreateRequest, UnsettledCreate,
+};
+use wyrd_core::multipart::{
+    admission_backoff_millis, decode_admission_record, decode_retire_obligation,
+    decode_session_record, mpu_key, parse_mpu_key, retire_key, AbortOutcome, AdmissionRecord,
+    Backpressure, Budget, CreateOutcome, PartScope, Refusal, RetireMode, RetireToken,
+    SessionRecord, SessionState, UploadId, MAX_ADMISSION_CAS_ATTEMPTS, MAX_COMPLETE_ATTEMPTS,
+    MAX_INFLIGHT_PARTS, MAX_PARTS_PER_SESSION, MAX_PART_CHUNKS, MAX_PART_NUMBER, MAX_SESSIONS,
+    MAX_STAGED_CHUNKS, MAX_UPLOAD_ID_ATTEMPTS, MPUCTL_KEY, MPU_PREFIX, W_REF,
+};
+use wyrd_metadata_redb::RedbMetadataStore;
+use wyrd_traits::{
+    BoxError, CommitOutcome, CommitUnknownResult, MetadataStore, Result, ScanPage, WriteBatch,
+};
+
+// ───────────────────────────────── fixtures ─────────────────────────────────
+
+const BUCKET: &str = "photos";
+/// A bucket marker as #511's CreateBucket will write one (ADR-0046 decision 2: name and
+/// creation time). Create treats it as opaque bytes and requires them exactly.
+const MARKER: &[u8] = br#"{"name":"photos","created_at_millis":7}"#;
+/// The flat-namespace root the gateway binds `{bucket}/{key}` dirents under.
+const PARENT: InodeId = 1;
+const CREATED_AT: u64 = 1_000;
+const CLOCK: &str = "wall";
+/// No leg may hang the suite: a stalled barrier or a create that never ends fails here.
+const LEG_DEADLINE: Duration = Duration::from_secs(60);
+/// What the interposer's plain store fault says.
+const INJECTED_FAULT: &str = "an injected store fault";
+/// Commits one interposer forwards before it calls the writer runaway — far above any leg's
+/// legitimate count (A′ at 47 creators makes 1128). redb's `get` and `commit` never await
+/// inside, so a writer looping on them never yields, and [`LEG_DEADLINE`] could not fire: the
+/// interposer stops it instead.
+const COMMIT_CEILING: u32 = 4096;
+
+fn request(object: &str) -> CreateRequest {
+    CreateRequest {
+        bucket: BUCKET.to_owned(),
+        parent: PARENT,
+        object: format!("{BUCKET}/{object}"),
+        content_type: None,
+        created_at_millis: CREATED_AT,
+        clock_source: CLOCK.to_owned(),
+    }
+}
+
+/// A profile through the one validating route a `Budget` has: its own decode.
+fn profile(w_ref: u64, part_chunks: u32, parts: u32, inflight: u32, staged: u32) -> Budget {
+    let json = format!(
+        "{{\"w_ref\":{w_ref},\"max_part_chunks\":{part_chunks},\"max_parts_per_session\":\
+         {parts},\"max_inflight_parts\":{inflight},\"max_staged_chunks\":{staged}}}"
+    );
+    metadata::decode(json.as_bytes()).expect("a valid profile")
+}
+
+/// The shipped profile — the one `MAX_SESSIONS` and `MAX_ADMISSION_CAS_ATTEMPTS` derive from.
+fn shipped() -> Budget {
+    let budget = profile(
+        W_REF,
+        MAX_PART_CHUNKS,
+        MAX_PARTS_PER_SESSION,
+        MAX_INFLIGHT_PARTS,
+        MAX_STAGED_CHUNKS,
+    );
+    assert_eq!(budget.max_sessions(), MAX_SESSIONS);
+    budget
+}
+
+fn hex(bits: u128) -> String {
+    format!("{bits:032x}")
+}
+
+fn upload_id(bits: u128) -> UploadId {
+    UploadId::new(hex(bits)).expect("32 lowercase hex digits")
+}
+
+/// The `seggrp:` key of the nonce minted from `bits`.
+fn marker_key(bits: u128) -> Vec<u8> {
+    seggrp_key(&SegmentNonce::new(hex(bits)).expect("32 lowercase hex digits"))
+}
+
+/// A fresh in-memory store holding the bucket marker and nothing else.
+async fn store_with_bucket() -> Arc<RedbMetadataStore> {
+    let store = Arc::new(RedbMetadataStore::in_memory().expect("an in-memory store"));
+    let put = WriteBatch::new().put(bucket_key(BUCKET), MARKER);
+    assert_eq!(store.commit(put).await.unwrap(), CommitOutcome::Committed);
+    store
+}
+
+/// Every key and value in the store.
+async fn dump(store: &impl MetadataStore) -> BTreeMap<Vec<u8>, Bytes> {
+    store.scan(b"").await.unwrap().into_iter().collect()
+}
+
+async fn ledger(store: &impl MetadataStore) -> AdmissionRecord {
+    let bytes = store.get(MPUCTL_KEY).await.unwrap().expect("a ledger");
+    decode_admission_record(&bytes).expect("a canonical ledger")
+}
+
+async fn session(store: &impl MetadataStore, id: &UploadId) -> (Bytes, SessionRecord) {
+    let bytes = store.get(&mpu_key(id)).await.unwrap().expect("a session");
+    let record = decode_session_record(&bytes).expect("a canonical session");
+    (bytes, record)
+}
+
+/// The caller's side of a create: identity bits (a script first, then a counter from `base`),
+/// jitter, and a wait — each recorded.
+struct Host {
+    script: VecDeque<u128>,
+    next: u128,
+    minted: Vec<u128>,
+    waits: Vec<u64>,
+    jitters: Vec<u64>,
+    jitter: u64,
+    /// Record each wait without sleeping it out — for legs whose schedule the interposer forces,
+    /// where the wait changes nothing but the run time.
+    instant: bool,
+}
+
+impl Host {
+    fn new(base: u128) -> Self {
+        Self::scripted(base, &[])
+    }
+
+    fn scripted(base: u128, script: &[u128]) -> Self {
+        Self {
+            script: script.iter().copied().collect(),
+            next: base,
+            minted: Vec::new(),
+            waits: Vec::new(),
+            jitters: Vec::new(),
+            jitter: base as u64 ^ 0x9e37_79b9_7f4a_7c15,
+            instant: false,
+        }
+    }
+
+    fn instant(mut self) -> Self {
+        self.instant = true;
+        self
+    }
+
+    /// The identities this host minted, as `(upload id bits, nonce bits)` pairs.
+    fn identities(&self) -> Vec<(u128, u128)> {
+        self.minted
+            .chunks(2)
+            .map(|pair| (pair[0], pair[1]))
+            .collect()
+    }
+
+    /// Every wait is exactly the backoff for its lost CAS: the `i`-th wait (from 0) is
+    /// `admission_backoff_millis(i, the jitter drawn for it)`. So the window grows with each
+    /// loss — doubling from `BASE` toward `CAP` — rather than staying at, or skipping past, any
+    /// one size.
+    fn assert_backoff(&self) {
+        assert_eq!(self.waits.len(), self.jitters.len(), "one jitter per wait");
+        for (attempt, (wait, jitter)) in self.waits.iter().zip(&self.jitters).enumerate() {
+            let attempt = u32::try_from(attempt).unwrap();
+            assert_eq!(
+                *wait,
+                admission_backoff_millis(attempt, *jitter),
+                "backoff after lost CAS {attempt}"
+            );
+        }
+    }
+}
+
+impl CreateHost for Host {
+    fn mint(&mut self) -> u128 {
+        let bits = self.script.pop_front().unwrap_or_else(|| {
+            self.next += 1;
+            self.next
+        });
+        self.minted.push(bits);
+        bits
+    }
+
+    fn jitter(&mut self) -> u64 {
+        self.jitter = self
+            .jitter
+            .wrapping_mul(6_364_136_223_846_793_005)
+            .wrapping_add(1_442_695_040_888_963_407);
+        self.jitters.push(self.jitter);
+        self.jitter
+    }
+
+    fn wait(&mut self, millis: u64) -> impl Future<Output = ()> + Send {
+        self.waits.push(millis);
+        let millis = if self.instant { 0 } else { millis };
+        tokio::time::sleep(Duration::from_millis(millis))
+    }
+}
+
+/// A disjoint identity range per creator, so every minted id is distinct by construction and an
+/// id names the creator that minted it.
+fn base(creator: usize) -> u128 {
+    (creator as u128 + 1) << 64
+}
+
+fn created(outcome: Result<CreateOutcome>) -> UploadId {
+    match outcome.expect("the create answered") {
+        CreateOutcome::Created { upload_id } => upload_id,
+        CreateOutcome::Refused(refusal) => panic!("the create was refused: {refusal:?}"),
+    }
+}
+
+/// The create ended `Unsettled`: return what it carries.
+fn as_unsettled(err: &BoxError) -> &UnsettledCreate {
+    match err.downcast_ref::<CreateFault>() {
+        Some(CreateFault::Unsettled(unsettled)) => unsettled,
+        other => panic!("expected Unsettled, got {other:?} ({err})"),
+    }
+}
+
+/// Exactly the sessions `admitted` names exist, each `Open` for the request that created it,
+/// each with its own `seggrp:` marker, and `mpuctl` counts exactly them — plus `extra_markers`,
+/// `seggrp:` markers that outlived their session and are deliberately not counted.
+async fn assert_admitted(
+    store: &impl MetadataStore,
+    admitted: &[(UploadId, CreateRequest)],
+    budget: &Budget,
+    extra_markers: &[u128],
+) {
+    let ids: BTreeSet<&str> = admitted.iter().map(|(id, _)| id.as_str()).collect();
+    assert_eq!(
+        ids.len(),
+        admitted.len(),
+        "upload ids must be pairwise distinct"
+    );
+
+    let sessions = store.scan(MPU_PREFIX).await.unwrap();
+    assert_eq!(
+        sessions.len(),
+        admitted.len(),
+        "exactly one mpu: record per admitted create"
+    );
+    let mut nonces = BTreeSet::new();
+    for (key, bytes) in &sessions {
+        let id = parse_mpu_key(key).expect("a canonical mpu: key");
+        let (_, wanted) = admitted
+            .iter()
+            .find(|(admitted, _)| admitted == &id)
+            .unwrap_or_else(|| panic!("mpu:{id} was never answered Created"));
+        let record = decode_session_record(bytes).expect("a canonical session");
+        assert_eq!(record.state(), &SessionState::Open {}, "mpu:{id}");
+        assert_eq!(record.parent(), wanted.parent, "mpu:{id}");
+        assert_eq!(record.object(), wanted.object, "mpu:{id}");
+        assert_eq!(record.content_type(), wanted.content_type.as_deref());
+        assert_eq!(record.created_at_millis(), wanted.created_at_millis);
+        assert_eq!(record.clock_source(), wanted.clock_source);
+        assert_eq!((record.epoch(), record.attempts()), (0, 0), "mpu:{id}");
+        assert_eq!(
+            &metadata::encode(&record),
+            bytes,
+            "a session is the codec's own spelling"
+        );
+        assert!(nonces.insert(seggrp_key(record.segment_nonce())));
+    }
+
+    let markers = store.scan(SEGGRP_PREFIX).await.unwrap();
+    let mut expected = nonces;
+    expected.extend(extra_markers.iter().map(|bits| marker_key(*bits)));
+    let found: BTreeSet<Vec<u8>> = markers.iter().map(|(key, _)| key.clone()).collect();
+    assert_eq!(
+        found, expected,
+        "exactly one seggrp: marker per session's nonce"
+    );
+    assert!(markers
+        .iter()
+        .all(|(_, value)| value.as_ref() == SEGGRP_MARKER));
+
+    let ledger = ledger(store).await;
+    assert_eq!(
+        ledger.count(),
+        admitted.len() as u64,
+        "mpuctl counts every admitted session"
+    );
+    assert_eq!(ledger.profile(), budget);
+    assert_eq!(ledger.max_sessions(), budget.max_sessions());
+}
+
+// ─────────────────────────────── the interposer ───────────────────────────────
+
+/// A test-local `MetadataStore` over the real redb store that controls **when** a commit runs
+/// and what it is answered, and records what each commit lost. Every read and every forwarded or
+/// applied batch goes to the real store, whose preconditions decide every `Conflict`.
+struct Interposer {
+    inner: Arc<RedbMetadataStore>,
+    plan: Plan,
+    state: Mutex<State>,
+    turn: Notify,
+}
+
+enum Plan {
+    /// Forward every call.
+    PassThrough,
+    /// Hold every commit until every live participant has reached its commit — so all of a
+    /// round's batches are built from the same reads — then release the round. A participant
+    /// leaves when a commit of its lands (or errors).
+    Barrier { participants: usize },
+    /// Before forwarding the first commit, delete the bucket marker (`None`) or rewrite it.
+    MoveBucket { to: Option<&'static [u8]> },
+    /// Refuse, as FoundationDB does (`value_too_large`), any commit putting a value longer than
+    /// [`MAX_VALUE_BYTES`] — with a plain store fault, applying nothing; forward every other.
+    ValueCeiling,
+    /// Act on commits by their number, from 1.
+    Script(Script),
+}
+
+/// What the interposer does at a numbered commit (from 1); a commit nothing names is forwarded.
+struct Script {
+    /// The profile rival creates admit against.
+    budget: Budget,
+    /// Before forwarding each of these commits, admit a rival session straight on the inner
+    /// store — a real create that moves the ledger.
+    rivals: Option<RangeInclusive<u32>>,
+    /// Answer each of these commits with a `CommitUnknownResult`, the batch's fate by its kind.
+    unknown: BTreeMap<u32, Unknown>,
+    /// Before forwarding each of these commits, move the session the batch fences to `Open` two
+    /// epochs on, with one more Complete attempt spent — what a Complete fence and its rollback
+    /// leave (#658).
+    reopen: Option<RangeInclusive<u32>>,
+    /// Before forwarding this commit, a rival Abort of the session the batch fences runs to its
+    /// answer on the inner store.
+    rival_abort: Option<u32>,
+    /// Answer this commit with a plain store fault — not a `CommitUnknownResult` — applying
+    /// nothing.
+    fault: Option<u32>,
+    /// Before forwarding this commit, put a `seggrp:` marker at this key straight on the inner
+    /// store — a record that appears after the create read its identity's keys vacant.
+    plant_marker: Option<(u32, Vec<u8>)>,
+}
+
+impl Script {
+    fn new(budget: Budget) -> Self {
+        Self {
+            budget,
+            rivals: None,
+            unknown: BTreeMap::new(),
+            reopen: None,
+            rival_abort: None,
+            fault: None,
+            plant_marker: None,
+        }
+    }
+}
+
+/// What became of a batch the store answered `CommitUnknownResult`.
+#[derive(Debug, Clone, Copy)]
+enum Unknown {
+    /// It was applied before the error.
+    Applied { may_still_commit: bool },
+    /// It was not applied, and will not be.
+    Dropped { may_still_commit: bool },
+    /// It was not applied, and a rival then moved the ledger.
+    DroppedThenRival,
+    /// It was not applied, and another session then took its `mpu:<id>`: the batch's own
+    /// session with one field changed — a 2^-128 event by chance, forced here.
+    DroppedThenSquatted(Squat),
+    /// It is held, and applied right after the **next** commit is forwarded — the recovery
+    /// re-drive.
+    Late,
+    /// It is held, and applied at the next read of `mpuctl` — after the recovery has looked at
+    /// `mpu:<id>` and before it reads the ledger.
+    LateAtLedgerRead,
+}
+
+/// The one field a squatting session changes — each one Create wrote and no transition rewrites.
+#[derive(Debug, Clone, Copy)]
+enum Squat {
+    Nonce,
+    Object,
+    Parent,
+    ContentType,
+    CreatedAt,
+    ClockSource,
+}
+
+/// When a held batch lands.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+enum Landing {
+    AfterNextCommit,
+    AtLedgerRead,
+}
+
+/// Which of a lost batch's preconditions failed when re-read.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Default)]
+struct Lost {
+    /// `require(mpuctl == …)` / `require_absent(mpuctl)`.
+    ledger: bool,
+    /// `require_absent(mpu:<id>)` / `require_absent(seggrp:<nonce>)`.
+    collision: bool,
+    /// Anything else (the bucket marker, a session's exact bytes, an obligation key).
+    other: bool,
+}
+
+#[derive(Default)]
+struct State {
+    commits: u32,
+    live: usize,
+    arrived: usize,
+    generation: u64,
+    /// Ledger-CAS losses per creator, by the upload id its batch puts under `mpu:`.
+    ledger_losses: BTreeMap<String, u32>,
+    lost: Vec<Lost>,
+    committed: Vec<WriteBatch>,
+    held: Option<(WriteBatch, Landing)>,
+    /// The held batch's own outcome, and whether its `mpu:<id>` was present when it ran.
+    late: Option<(CommitOutcome, bool)>,
+    rivals: u32,
+    rival_aborts: Vec<AbortOutcome>,
+    /// Commits [`Plan::ValueCeiling`] refused.
+    oversized: u32,
+    /// Point reads made through the interposer.
+    reads: u32,
+}
+
+impl Interposer {
+    fn new(inner: Arc<RedbMetadataStore>, plan: Plan) -> Self {
+        let live = match &plan {
+            Plan::Barrier { participants } => *participants,
+            _ => 0,
+        };
+        Self {
+            inner,
+            plan,
+            state: Mutex::new(State {
+                live,
+                ..State::default()
+            }),
+            turn: Notify::new(),
+        }
+    }
+
+    fn scripted(inner: &Arc<RedbMetadataStore>, script: Script) -> Self {
+        Self::new(Arc::clone(inner), Plan::Script(script))
+    }
+
+    fn state(&self) -> std::sync::MutexGuard<'_, State> {
+        self.state.lock().unwrap()
+    }
+
+    /// Release the round once everyone still live has arrived.
+    fn release_if_full(&self, state: &mut State) {
+        if state.arrived > 0 && state.arrived >= state.live {
+            state.arrived = 0;
+            state.generation += 1;
+            self.turn.notify_waiters();
+        }
+    }
+
+    async fn barrier(&self) {
+        let generation = {
+            let mut state = self.state();
+            state.arrived += 1;
+            let generation = state.generation;
+            self.release_if_full(&mut state);
+            generation
+        };
+        loop {
+            // Registered before the check, so a release between the two is not missed.
+            let released = self.turn.notified();
+            if self.state().generation > generation {
+                return;
+            }
+            tokio::time::timeout(Duration::from_secs(10), released)
+                .await
+                .expect("the barrier stalled: a live participant never reached its commit");
+        }
+    }
+
+    /// Admit one rival session straight on the inner store.
+    async fn rival(&self, budget: &Budget) {
+        let n = {
+            let mut state = self.state();
+            state.rivals += 1;
+            state.rivals
+        };
+        let mut host = Host::new((1 << 120) + (u128::from(n) << 32)).instant();
+        let rival = request(&format!("rival-{n}"));
+        created(create_session(&*self.inner, &rival, budget, &mut host).await);
+    }
+
+    /// A rival Abort of the session `batch` fences, run to its answer on the inner store.
+    async fn rival_abort(&self, batch: &WriteBatch) {
+        let key = session_key(batch).expect("a fence batch puts its session");
+        let id = parse_mpu_key(&key).expect("a canonical mpu: key");
+        let answer = abort_session(&*self.inner, &id)
+            .await
+            .expect("the rival Abort answered");
+        self.state().rival_aborts.push(answer);
+    }
+
+    async fn unknown(&self, kind: Unknown, budget: &Budget, batch: WriteBatch) -> BoxError {
+        let may_still_commit = match kind {
+            Unknown::Applied { may_still_commit } => {
+                let landed = self.inner.commit(batch).await.unwrap();
+                assert_eq!(
+                    landed,
+                    CommitOutcome::Committed,
+                    "the applied variant must land"
+                );
+                may_still_commit
+            }
+            Unknown::Dropped { may_still_commit } => may_still_commit,
+            Unknown::DroppedThenRival => {
+                self.rival(budget).await;
+                true
+            }
+            Unknown::DroppedThenSquatted(squat) => {
+                self.squat(squat, &batch).await;
+                true
+            }
+            Unknown::Late => {
+                self.state().held = Some((batch, Landing::AfterNextCommit));
+                true
+            }
+            Unknown::LateAtLedgerRead => {
+                self.state().held = Some((batch, Landing::AtLedgerRead));
+                true
+            }
+        };
+        Box::new(CommitUnknownResult {
+            backend: "interposer",
+            code: None,
+            detail: "forced by the test".to_owned(),
+            may_still_commit,
+        })
+    }
+
+    /// Install at the create batch's `mpu:<id>` the session it carries with one field changed.
+    async fn squat(&self, squat: Squat, batch: &WriteBatch) {
+        let (key, value) = batch
+            .puts
+            .iter()
+            .find(|(key, _)| key.starts_with(MPU_PREFIX))
+            .expect("a create batch puts its session");
+        let own = decode_session_record(value).unwrap();
+        let json = String::from_utf8(value.to_vec()).unwrap();
+        let created_at = format!("\"created_at_millis\":{},", own.created_at_millis());
+        let changed = match squat {
+            Squat::Nonce => json.replacen(own.segment_nonce().as_str(), &hex(0x5e17), 1),
+            Squat::Object => json.replacen(
+                &format!("\"object\":\"{}\"", own.object()),
+                "\"object\":\"photos/squatter\"",
+                1,
+            ),
+            Squat::Parent => json.replacen(
+                &format!("\"parent\":{},", own.parent()),
+                &format!("\"parent\":{},", own.parent() + 1),
+                1,
+            ),
+            Squat::ContentType => match own.content_type() {
+                Some(declared) => json.replacen(
+                    &format!("\"content_type\":\"{declared}\""),
+                    "\"content_type\":\"application/x-squatter\"",
+                    1,
+                ),
+                None => json.replacen(
+                    &created_at,
+                    &format!("\"content_type\":\"application/x-squatter\",{created_at}"),
+                    1,
+                ),
+            },
+            Squat::CreatedAt => json.replacen(
+                &created_at,
+                &format!("\"created_at_millis\":{},", own.created_at_millis() + 1),
+                1,
+            ),
+            Squat::ClockSource => json.replacen(
+                &format!("\"clock_source\":\"{}\"", own.clock_source()),
+                "\"clock_source\":\"squatter-clock\"",
+                1,
+            ),
+        };
+        let other = decode_session_record(changed.as_bytes()).expect("a canonical session");
+        let same = [
+            other.segment_nonce() == own.segment_nonce(),
+            other.object() == own.object(),
+            other.parent() == own.parent(),
+            other.content_type() == own.content_type(),
+            other.created_at_millis() == own.created_at_millis(),
+            other.clock_source() == own.clock_source(),
+        ];
+        assert_eq!(
+            same.iter().filter(|same| !**same).count(),
+            1,
+            "{squat:?}: exactly one field differs"
+        );
+        let put = WriteBatch::new().put(key.clone(), changed.into_bytes());
+        assert_eq!(
+            self.inner.commit(put).await.unwrap(),
+            CommitOutcome::Committed
+        );
+    }
+
+    /// Move the session `batch` fences to `Open@E+2` with one more attempt spent.
+    async fn reopen(&self, batch: &WriteBatch) {
+        let key = session_key(batch).expect("a fence batch puts its session");
+        let bytes = self.inner.get(&key).await.unwrap().expect("a session");
+        let record = decode_session_record(&bytes).unwrap();
+        let (epoch, attempts) = (record.epoch(), record.attempts());
+        let reopened = String::from_utf8(bytes.to_vec()).unwrap().replacen(
+            &format!("\"epoch\":{epoch},\"attempts\":{attempts},"),
+            &format!("\"epoch\":{},\"attempts\":{},", epoch + 2, attempts + 1),
+            1,
+        );
+        let moved = decode_session_record(reopened.as_bytes()).expect("a canonical session");
+        assert_eq!(
+            (moved.epoch(), moved.state()),
+            (epoch + 2, &SessionState::Open {})
+        );
+        let put = WriteBatch::new().put(key, reopened.into_bytes());
+        assert_eq!(
+            self.inner.commit(put).await.unwrap(),
+            CommitOutcome::Committed
+        );
+    }
+
+    /// Apply the held batch now, if it lands `at` this point.
+    async fn land_held(&self, at: Landing) {
+        let held = {
+            let mut state = self.state();
+            match &state.held {
+                Some((_, landing)) if *landing == at => state.held.take(),
+                _ => None,
+            }
+        };
+        let Some((held, _)) = held else { return };
+        let key = session_key(&held).expect("a batch puts its session");
+        let present = self.inner.get(&key).await.unwrap().is_some();
+        let outcome = self.inner.commit(held).await.unwrap();
+        self.state().late = Some((outcome, present));
+    }
+
+    /// Re-read each precondition of a lost batch and name the ones that no longer hold.
+    async fn lost(&self, batch: &WriteBatch) -> Lost {
+        let mut lost = Lost::default();
+        for pre in &batch.preconditions {
+            let now = self.inner.get(&pre.key).await.unwrap();
+            if now == pre.expected {
+                continue;
+            }
+            if pre.key == MPUCTL_KEY {
+                lost.ledger = true;
+            } else if pre.expected.is_none()
+                && (pre.key.starts_with(MPU_PREFIX) || pre.key.starts_with(SEGGRP_PREFIX))
+            {
+                lost.collision = true;
+            } else {
+                lost.other = true;
+            }
+        }
+        lost
+    }
+
+    async fn observe(&self, batch: &WriteBatch, outcome: &Result<CommitOutcome>) {
+        match outcome {
+            Ok(CommitOutcome::Conflict) => {
+                let lost = self.lost(batch).await;
+                let mut state = self.state();
+                if lost.ledger {
+                    if let Some(id) = session_key(batch) {
+                        let id = String::from_utf8_lossy(&id).into_owned();
+                        *state.ledger_losses.entry(id).or_default() += 1;
+                    }
+                }
+                state.lost.push(lost);
+            }
+            Ok(CommitOutcome::Committed) | Err(_) => {
+                let mut state = self.state();
+                if outcome.is_ok() {
+                    state.committed.push(batch.clone());
+                }
+                if matches!(self.plan, Plan::Barrier { .. }) {
+                    state.live -= 1;
+                    self.release_if_full(&mut state);
+                }
+            }
+        }
+    }
+}
+
+/// The `mpu:` key a batch puts — its creator's (or its fenced session's) identity.
+fn session_key(batch: &WriteBatch) -> Option<Vec<u8>> {
+    batch
+        .puts
+        .iter()
+        .map(|(key, _)| key)
+        .find(|key| key.starts_with(MPU_PREFIX))
+        .cloned()
+}
+
+#[async_trait]
+impl MetadataStore for Interposer {
+    async fn get(&self, key: &[u8]) -> Result<Option<Bytes>> {
+        self.state().reads += 1;
+        if key == MPUCTL_KEY {
+            self.land_held(Landing::AtLedgerRead).await;
+        }
+        self.inner.get(key).await
+    }
+
+    async fn scan(&self, prefix: &[u8]) -> Result<Vec<(Vec<u8>, Bytes)>> {
+        self.inner.scan(prefix).await
+    }
+
+    async fn scan_page(
+        &self,
+        prefix: &[u8],
+        after: Option<&[u8]>,
+        limit: usize,
+    ) -> Result<ScanPage> {
+        self.inner.scan_page(prefix, after, limit).await
+    }
+
+    async fn commit(&self, batch: WriteBatch) -> Result<CommitOutcome> {
+        let n = {
+            let mut state = self.state();
+            state.commits += 1;
+            state.commits
+        };
+        assert!(
+            n <= COMMIT_CEILING,
+            "the writer made more than {COMMIT_CEILING} commits: its retry loop is unbounded"
+        );
+        match &self.plan {
+            Plan::PassThrough => {}
+            Plan::Barrier { .. } => self.barrier().await,
+            Plan::MoveBucket { to } => {
+                if n == 1 {
+                    let moved = match to {
+                        Some(bytes) => WriteBatch::new().put(bucket_key(BUCKET), *bytes),
+                        None => WriteBatch::new().delete(bucket_key(BUCKET)),
+                    };
+                    self.inner.commit(moved).await.unwrap();
+                }
+            }
+            Plan::ValueCeiling => {
+                let widest = batch.puts.iter().map(|(_, value)| value.len()).max();
+                if let Some(bytes) = widest.filter(|bytes| *bytes > MAX_VALUE_BYTES) {
+                    self.state().oversized += 1;
+                    return Err(format!(
+                        "value_too_large: a {bytes}-byte value, past {MAX_VALUE_BYTES}"
+                    )
+                    .into());
+                }
+            }
+            Plan::Script(script) => {
+                if let Some((at, key)) = &script.plant_marker {
+                    if *at == n {
+                        let plant = WriteBatch::new().put(key.clone(), SEGGRP_MARKER);
+                        self.inner.commit(plant).await.unwrap();
+                    }
+                }
+                if script.rivals.as_ref().is_some_and(|at| at.contains(&n)) {
+                    self.rival(&script.budget).await;
+                }
+                if script.reopen.as_ref().is_some_and(|at| at.contains(&n)) {
+                    self.reopen(&batch).await;
+                }
+                if script.rival_abort == Some(n) {
+                    self.rival_abort(&batch).await;
+                }
+                if script.fault == Some(n) {
+                    return Err(INJECTED_FAULT.into());
+                }
+                if let Some(kind) = script.unknown.get(&n) {
+                    return Err(self.unknown(*kind, &script.budget, batch).await);
+                }
+            }
+        }
+        let outcome = self.inner.commit(batch.clone()).await;
+        self.observe(&batch, &outcome).await;
+        self.land_held(Landing::AfterNextCommit).await;
+        outcome
+    }
+}
+
+async fn within<T>(leg: impl Future<Output = T>) -> T {
+    tokio::time::timeout(LEG_DEADLINE, leg)
+        .await
+        .expect("the leg ran past its deadline")
+}
