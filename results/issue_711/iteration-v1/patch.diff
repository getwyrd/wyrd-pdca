+// ---- property 12: a placement move inside a `seg:` record versus a writer that changes
+//      what it pinned — exactly one of the two lands, and the loser writes NOTHING
+//      (issue #711, proposal 0016 decision 7(f)) ----
+//
+// The move a repair makes inside a segmented object is conditioned on the exact bytes the
+// resolve read: the ROOT generation (a supersede always moves the root first,
+// `0016:2452-2462`) and, additionally, the SEGMENT record the placement lives in. Either can
+// change between the read and the commit. The property is what a losing move may leave
+// behind: **nothing at all** — no placement, no orphan mark, no discharged obligation — and
+// the object still naming fragments that exist. A move that half-landed would either strand
+// an object on bytes nobody has (the placement without the fragments) or authorise GC to
+// reclaim bytes the live generation still names (the orphan mark without the placement).
+
+/// The segment-group nonce this property's fixture is keyed by (32 lowercase hex characters).
+const REPOINT_NONCE: &str = "abcdef0123456789abcdef0123456789";
+
+/// Which pinned bytes the racing writer changes.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+enum Racer {
+    /// The **root generation**: a fresh flat generation supersedes the segmented one, its own
+    /// fragments already on the fleet. The repoint never rewrites the root, so this write and
+    /// a landed repoint touch different keys — both may commit, in either order.
+    Supersede,
+    /// The **segment record**: a competing writer moves the same chunk's placement itself.
+    /// This write and the repoint are the same key, so whichever arrives second loses its CAS
+    /// and writes nothing.
+    Rewrite,
+}
+
+/// A store that lands `pending` in the window around the repair's own repoint — the ONE batch
+/// a maintenance pass sends carrying a positive precondition (`0005:351-354`), exactly as
+/// [`CrashMeta`] identifies it. `repoint_first` chooses the interleaving: the repoint commits
+/// before the racing write, or after it.
+struct RaceAtRepoint {
+    inner: MemMeta,
+    pending: Mutex<Option<WriteBatch>>,
+    repoint_first: bool,
+    /// What the racing write did once the store applied it — `None` until it has run.
+    racer_outcome: Mutex<Option<CommitOutcome>>,
+}
+
+#[async_trait]
+impl MetadataStore for RaceAtRepoint {
+    async fn get(&self, key: &[u8]) -> Result<Option<Bytes>> {
+        self.inner.get(key).await
+    }
+
+    async fn scan(&self, prefix: &[u8]) -> Result<Vec<(Vec<u8>, Bytes)>> {
+        self.inner.scan(prefix).await
+    }
+
+    async fn scan_page(
+        &self,
+        prefix: &[u8],
+        after: Option<&[u8]>,
+        limit: usize,
+    ) -> Result<wyrd_traits::ScanPage> {
+        self.inner.scan_page(prefix, after, limit).await
+    }
+
+    async fn commit(&self, batch: WriteBatch) -> Result<CommitOutcome> {
+        let repoint = batch.preconditions.iter().any(|pre| pre.expected.is_some());
+        let racer = if repoint {
+            self.pending.lock().unwrap().take()
+        } else {
+            None
+        };
+        let Some(racer) = racer else {
+            return self.inner.commit(batch).await;
+        };
+        let outcome = if self.repoint_first {
+            let landed = self.inner.commit(batch).await?;
+            *self.racer_outcome.lock().unwrap() = Some(self.inner.commit(racer).await?);
+            landed
+        } else {
+            *self.racer_outcome.lock().unwrap() = Some(self.inner.commit(racer).await?);
+            self.inner.commit(batch).await?
+        };
+        Ok(outcome)
+    }
+}
+
+/// Re-spell the committed RS(2,1) object at [`INODE`] as a **segmented** generation: one
+/// `seg:` record holding its chunk, plus a segmented root naming that group. Raw records
+/// written by hand, never a committer (this build ships no producer of segmented maps).
+async fn respell_as_segmented(
+    meta: &MemMeta,
+    chunk: metadata::ChunkRef,
+) -> (metadata::SegmentGroup, metadata::SegmentRecord) {
+    let group = metadata::SegmentGroup::new(REPOINT_NONCE, 1).unwrap();
+    let record = metadata::SegmentRecord::new(vec![chunk], 0).unwrap();
+    let table = metadata::SegmentedMap::new(
+        group.clone(),
+        vec![metadata::SegmentRef {
+            index: 0,
+            byte_offset: 0,
+            byte_len: record.byte_len(),
+        }],
+    )
+    .unwrap();
+    let root = InodeRecord {
+        size: table.span(),
+        chunk_map: metadata::ChunkMap::Segmented(table),
+        state: InodeState::Committed,
+        version: 2,
+        ..Default::default()
+    };
+    let batch = WriteBatch::new()
+        .put(seg_row(&group, 0), metadata::encode(&record))
+        .put(metadata::inode_key(INODE), metadata::encode(&root));
+    assert_eq!(meta.commit(batch).await.unwrap(), CommitOutcome::Committed);
+    (group, record)
+}
+
+/// A copy of `chunk`'s segment record with fragment `index` placed on `server`.
+fn placed_on(
+    record: &metadata::SegmentRecord,
+    index: usize,
+    server: DServerId,
+) -> metadata::SegmentRecord {
+    let mut chunks = record.chunks().to_vec();
+    chunks[0].placement[index] = server;
+    metadata::SegmentRecord::new(chunks, record.byte_offset()).unwrap()
+}
+
+async fn prop_repoint_versus_supersede_commits_all_or_nothing(rng: &mut ChaCha8Rng) {
+    let d = servers();
+    let fleet = fleet_of(&d);
+    let meta = MemMeta::default();
+    write_rs_2_1(&meta, &fleet).await;
+    let chunk = read_inode(&meta).await.chunk_map.into_flat().unwrap()[0].clone();
+    let (group, seeded) = respell_as_segmented(&meta, chunk).await;
+    let seg_key = seg_row(&group, 0);
+    let root_before = meta
+        .get(&metadata::inode_key(INODE))
+        .await
+        .unwrap()
+        .unwrap();
+
+    // The seed picks the loss, which pinned bytes the racing writer changes, and which of the
+    // two writes the store lets through first.
+    let kill = SeededStorageFaults::kill(&mut *rng, N);
+    let victim = *kill.faults().keys().next().unwrap() as u16;
+    let lost = d[victim as usize]
+        .get_fragment(frag(victim))
+        .await
+        .unwrap()
+        .expect("the fixture placed every fragment");
+    apply_storage_faults(&d, &kill).await;
+    repair::enqueue_repair(&meta, CHUNK, "health")
+        .await
+        .unwrap();
+    let racer = if rng.next_u32().is_multiple_of(2) {
+        Racer::Supersede
+    } else {
+        Racer::Rewrite
+    };
+    let repoint_first = rng.next_u32().is_multiple_of(2);
+
+    // The rebuilt fragment always lands on the one free domain (D = server 3) for any victim
+    // in 0..N, so both the repoint's answer and the racing writer's are known up front.
+    let repointed = placed_on(&seeded, victim as usize, 3);
+    let (pending, after_racer) = match racer {
+        Racer::Supersede => {
+            // A fresh generation, its fragments really on the fleet, replacing the root under
+            // the move — CAS'd on the root the repair pinned, as a real publish is.
+            let mut next = 0x2000u128;
+            let plan = write::plan_write(b"the superseding generation", 8, EcScheme::None, || {
+                next += 1;
+                next
+            })
+            .unwrap();
+            write::write_fragments(&fleet, &plan).await.unwrap();
+            let new_root = InodeRecord {
+                size: plan.size,
+                chunk_map: plan.chunk_refs().into(),
+                state: InodeState::Committed,
+                version: 3,
+                ..Default::default()
+            };
+            let batch = WriteBatch::new()
+                .require(metadata::inode_key(INODE), root_before.clone())
+                .put(metadata::inode_key(INODE), metadata::encode(&new_root));
+            (batch, metadata::encode(&seeded))
+        }
+        Racer::Rewrite => {
+            // A competing writer that has already moved this very fragment to server 3 —
+            // bytes first, then the record, so whichever write wins the record names bytes
+            // that exist.
+            d[3].put_fragment(frag(victim), lost).await.unwrap();
+            let batch = WriteBatch::new()
+                .require(seg_key.clone(), metadata::encode(&seeded))
+                .put(seg_key.clone(), metadata::encode(&repointed));
+            (batch, metadata::encode(&repointed))
+        }
+    };
+
+    let store = RaceAtRepoint {
+        inner: meta,
+        pending: Mutex::new(Some(pending)),
+        repoint_first,
+        racer_outcome: Mutex::new(None),
+    };
+    let (topo, healthy) = healthy_view(victim, &d);
+    let ctx = ReconstructionContext {
+        meta: &store,
+        fleet: &healthy,
+        topology: &topo,
+        unreachable: &[],
+    };
+    let coord = MemCoordination::new();
+    let (zone, custodian) = elect(&coord, "zone-repoint-race").await;
+    reconcile_step(&zone, &custodian, None, None, Some(&ctx), None, 500)
+        .await
+        .expect("a raced repoint is a lost CAS, never an error that ends the pass");
+
+    let arm = format!("racer {racer:?}, repoint first: {repoint_first}");
+    let stored = store
+        .get(&seg_key)
+        .await
+        .unwrap()
+        .expect("the segment record");
+    let orphans = store.scan(b"orphan:").await.unwrap();
+    let queued = repair::queued_repairs(&store).await.unwrap();
+    if repoint_first {
+        // The move landed, and landed WHOLE: placement, obligation and orphan mark are one
+        // commit, so no arm of it can be observed without the others.
+        assert_eq!(
+            stored,
+            metadata::encode(&repointed),
+            "the repoint went first and its placement is not in the record ({arm})"
+        );
+        assert!(
+            queued.is_empty(),
+            "the obligation outlived the commit that discharged it ({arm})"
+        );
+        assert_eq!(
+            orphans.into_iter().map(|(key, _)| key).collect::<Vec<_>>(),
+            vec![metadata::orphan_key(u64::from(victim), frag(victim))],
+            "exactly the vacated position is marked collectable ({arm})"
+        );
+        // A writer that pinned the same record loses; one that pinned only the root does not,
+        // because a repoint never rewrites the root.
+        let expected = match racer {
+            Racer::Supersede => CommitOutcome::Committed,
+            Racer::Rewrite => CommitOutcome::Conflict,
+        };
+        assert_eq!(
+            *store.racer_outcome.lock().unwrap(),
+            Some(expected),
+            "the racing write's own outcome is wrong ({arm})"
+        );
+    } else {
+        // The move lost, so it wrote NOTHING AT ALL: not the placement, not the orphan mark,
+        // and not the discharge of the obligation that is the last record saying this data is
+        // under-replicated.
+        assert_eq!(
+            stored, after_racer,
+            "a repoint that lost its race still rewrote the record ({arm})"
+        );
+        assert!(
+            orphans.is_empty(),
+            "a repoint that committed nothing still marked a fragment collectable — GC \
+             reclaims it once the grace window elapses ({arm}): {orphans:?}"
+        );
+        assert!(
+            queued.contains(&CHUNK),
+            "a repoint that committed nothing still discharged its obligation ({arm})"
+        );
+        assert_eq!(
+            *store.racer_outcome.lock().unwrap(),
+            Some(CommitOutcome::Committed),
+            "the racing write went first and must have landed ({arm})"
+        );
+    }
+
+    // However the race resolved, the LIVE generation names only fragments that exist: an
+    // object left pointing at bytes nobody holds is the data loss a half-applied move is.
+    let live = metadata::resolve_current_chunk_map(&store, &metadata::inode_key(INODE))
+        .await
+        .expect("the live generation resolves")
+        .expect("the object is live here");
+    for (dserver, fragment) in fragments_of(&live.chunks) {
+        assert!(
+            d[dserver as usize]
+                .get_fragment(fragment)
+                .await
+                .unwrap()
+                .is_some(),
+            "the live generation names {fragment:?} on server {dserver}, which holds no such \
+             bytes ({arm})"
+        );
+    }
+}
