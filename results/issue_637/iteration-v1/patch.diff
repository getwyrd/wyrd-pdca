+}
+
+/// One placement move's identity: the destination position it writes (`dserver`, `chunk`,
+/// `index`) and the instant the move began. Two attempts of **one** move — a retry within the
+/// pass that began it — share it; a move begun later is a different move, so a pre-mark an
+/// earlier, failed move left behind always reads as a *different* identity and is replaced
+/// (`0016:1177-1187`).
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
+pub struct MoveId {
+    dserver: DServerId,
+    chunk: ChunkId,
+    index: u16,
+    started_at_millis: u64,
+}
+
+impl MoveId {
+    /// The identity of the move writing fragment `index` of `chunk` to `dserver`, begun at
+    /// `started_at_millis`.
+    pub const fn new(
+        dserver: DServerId,
+        chunk: ChunkId,
+        index: u16,
+        started_at_millis: u64,
+    ) -> Self {
+        Self {
+            dserver,
+            chunk,
+            index,
+            started_at_millis,
+        }
+    }
+}
+
+impl MarkEvent {
+    /// The key of the `retire:bytes:` obligation this event names, if it is a retirement —
+    /// **present** means the retirement is still draining and the positions it names are still
+    /// protected; **absent** means it drained and the mark's own grace governs
+    /// (`0016:1242-1247`). A move names no obligation.
+    pub fn retirement_key(&self) -> Option<Vec<u8>> {
+        match self {
+            Self::Retirement(token) => Some(multipart::retire_key(RetireMode::Bytes, token)),
+            Self::Move(_) => None,
+        }
+    }
+
+    /// Parse an event from its spelling, refusing every other one.
+    ///
+    /// A retirement is read through the **one** token grammar (`crate::multipart::
+    /// parse_retire_key`), by the key its token names, so a mark and the obligation it points
+    /// at can never disagree about what a token is.
+    fn parse(text: &str) -> Result<Self, RecordError> {
+        let malformed = || RecordError::MalformedRecordValue {
+            namespace: "orphan:",
+            detail: format!("the mark's event {text:?} is neither a retirement token nor a move"),
+        };
+        if let Some(rest) = text.strip_prefix("m:") {
+            let fields: Vec<&str> = rest.split(':').collect();
+            let [dserver, chunk, index, started] = fields.as_slice() else {
+                return Err(malformed());
+            };
+            return Ok(Self::Move(MoveId {
+                dserver: multipart::canonical_decimal(dserver).ok_or_else(malformed)?,
+                chunk: multipart::canonical_decimal(chunk).ok_or_else(malformed)?,
+                index: multipart::canonical_decimal(index).ok_or_else(malformed)?,
+                started_at_millis: multipart::canonical_decimal(started).ok_or_else(malformed)?,
+            }));
+        }
+        let mut key = RetireMode::Bytes.prefix().to_vec();
+        key.extend_from_slice(text.as_bytes());
+        let (_, token) = multipart::parse_retire_key(&key).map_err(|_| malformed())?;
+        Ok(Self::Retirement(token))
+    }
+}
+
+impl fmt::Display for MarkEvent {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            Self::Retirement(token) => write!(f, "{token}"),
+            Self::Move(id) => write!(
+                f,
+                "m:{}:{}:{}:{}",
+                id.dserver, id.chunk, id.index, id.started_at_millis
+            ),
+        }
+    }
+}
