+#[derive(Clone, Debug)]
+pub(crate) struct PartSite {
+    /// The owning session's key.
+    pub session_key: Vec<u8>,
+    /// The session record's bytes as read — shared by every chunk of every part it owns.
+    pub session_bytes: Arc<[u8]>,
+    /// Whether that record decoded as `Open` — the only state a part may be re-placed under.
+    pub open: bool,
+    /// The part record's key.
+    pub part_key: Vec<u8>,
+    /// The part record's bytes as read — shared by every chunk it lists.
+    pub part_bytes: Arc<[u8]>,
+    /// This chunk's index in the part's chunk list.
+    pub chunk_index: usize,
+    /// This chunk's committed reference, as the part record carries it.
+    pub chunk: ChunkRef,
+}
+
+/// The **staged set** (`0016:767-782`): disjoint from the committed placements, so each consumer
+/// makes its own decision from it — GC, restore and the drain count both classes; scrub and
+/// reconstruction act only on the committed-part subset, which alone carries a committed EC
+/// scheme (`0016:775-781`); rebalance never moves any of it (`0016:826`).
+#[derive(Debug, Default)]
+pub(crate) struct StagedSet {
+    /// `(dserver, fragment)` a committed `part:` record places.
+    pub parts: HashSet<(DServerId, FragmentId)>,
+    /// `(dserver, fragment)` an in-flight owned `sidx:` entry plans.
+    pub owned: HashSet<(DServerId, FragmentId)>,
+    /// The committed EC scheme of each validly placed part chunk, for scrub's full-identity
+    /// verify.
+    pub schemes: HashMap<ChunkId, EcScheme>,
+    /// Chunks whose staged placement — a part chunk's, or an owned entry's planned one — is
+    /// malformed (non-empty, the wrong length): every fragment bearing the id is protected, as a
+    /// committed chunk's is (`0016:416-432`).
+    pub malformed: HashMap<ChunkId, MalformedPlacement>,
+    /// Where each committed part chunk lives, for reconstruction. The first record met names a
+    /// chunk; a second naming the same id is protected all the same.
+    pub sites: HashMap<ChunkId, PartSite>,
+    /// Session records whose key parses but whose value does not decode, by key, with the fault.
+    /// Their ranges were read and are protected; only their state is unknown.
+    pub unreadable_sessions: BTreeMap<Vec<u8>, String>,
+}
+
+impl StagedSet {
+    /// Whether a staging record names `frag` on `dserver`.
+    pub fn holds(&self, dserver: DServerId, frag: FragmentId) -> bool {
+        self.parts.contains(&(dserver, frag)) || self.owned.contains(&(dserver, frag))
+    }
+
+    /// Whether a staging record names any fragment on `dserver` — what a drain waits on.
+    pub fn holds_any_on(&self, dserver: DServerId) -> bool {
+        self.parts
+            .iter()
+            .chain(self.owned.iter())
+            .any(|(server, _)| *server == dserver)
+    }
+}
+
+/// Build the staged set, recording every record it cannot read into `unresolvable` (keyed by the
+/// record's own key bytes, valued by the fault) — see the module doc.
+///
+/// A store fault under a read propagates (`?`): a build that cannot reach the store has no set at
+/// all, and containing that as "one record is unreadable" would be the wrong answer for all of
+/// them. The awaits are bounded by the `MetadataStore` implementation, the rule every read of the
+/// reference build follows (`crate::gc::referenced_fragments`).
+pub(crate) async fn build(
+    meta: &dyn MetadataStore,
+    unresolvable: &mut BTreeMap<Vec<u8>, String>,
+) -> Result<StagedSet> {
+    let mut set = StagedSet::default();
+    for (session_key, session_value) in meta.scan(multipart::MPU_PREFIX).await? {
+        let upload = match multipart::parse_mpu_key(&session_key) {
+            Ok(upload) => upload,
+            Err(fault) => {
+                // No upload id, so no range to read: a hole in the set.
+                unresolvable.insert(session_key, fault.to_string());
+                continue;
+            }
+        };
+        let session_bytes: Arc<[u8]> = Arc::from(session_value.as_ref());
+        let open = match multipart::decode_session_record(&session_bytes) {
+            Ok(session) => matches!(session.state(), SessionState::Open {}),
+            Err(fault) => {
+                set.unreadable_sessions
+                    .insert(session_key.clone(), fault.to_string());
+                false
+            }
+        };
+
+        // SOURCE: the in-flight owned entries.
+        for (key, value) in meta.scan(&multipart::sidx_range(&upload)).await? {
+            let (_part, chunk, entry) = match multipart::decode_owned_entry(&key, &value) {
+                Ok(decoded) => decoded,
+                Err(fault) => {
+                    unresolvable.insert(key, fault.to_string());
+                    continue;
+                }
+            };
+            let planned = ChunkRef {
+                id: chunk,
+                scheme: entry.staged().scheme(),
+                len: 0,
+                placement: entry.staged().placement().to_vec(),
+            };
+            match planned.checked_fragments() {
+                Ok(frags) => {
+                    for (index, dserver) in frags {
+                        set.owned.insert((dserver, FragmentId { chunk, index }));
+                    }
+                }
+                Err(malformed) => {
+                    set.malformed.insert(chunk, malformed);
+                }
+            };
+        }
+
+        // DESTINATION: the committed parts.
+        for (part_key, part_value) in meta.scan(&multipart::part_range(&upload)).await? {
+            let part = match multipart::parse_part_key(&part_key)
+                .and_then(|_| multipart::decode_part_record(&part_value))
+            {
+                Ok(part) => part,
+                Err(fault) => {
+                    unresolvable.insert(part_key, fault.to_string());
+                    continue;
+                }
+            };
+            let part_bytes: Arc<[u8]> = Arc::from(part_value.as_ref());
+            for (chunk_index, chunk) in part.chunks().iter().enumerate() {
+                match chunk.checked_fragments() {
+                    Ok(frags) => {
+                        for (index, dserver) in frags {
+                            set.parts.insert((
+                                dserver,
+                                FragmentId {
+                                    chunk: chunk.id,
+                                    index,
+                                },
+                            ));
+                        }
+                        set.schemes.insert(chunk.id, chunk.scheme);
+                        set.sites.entry(chunk.id).or_insert_with(|| PartSite {
+                            session_key: session_key.clone(),
+                            session_bytes: session_bytes.clone(),
+                            open,
+                            part_key: part_key.clone(),
+                            part_bytes: part_bytes.clone(),
+                            chunk_index,
+                            chunk: chunk.clone(),
+                        });
+                    }
+                    Err(malformed) => {
+                        set.malformed.insert(chunk.id, malformed);
+                    }
+                }
+            }
+        }
+    }
+    Ok(set)
+}
