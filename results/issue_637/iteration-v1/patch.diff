+// ---- #637 J(ii): a staged re-place versus a session fence (X29, 0016:888) ----
+
+/// What one run of the re-place-versus-fence race ended with.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
+enum ReplaceEnd {
+    /// The re-place won: the part names the rebuilt fragment's new holder.
+    Adopted,
+    /// The fence landed after the rebuilt fragment was written and before the CAS: the CAS lost.
+    LostAfterWrite,
+    /// The fence landed before the re-place could write anything.
+    FencedFirst,
+}
+
+/// One run: an `Open` session's committed part holds an RS(2,1) chunk on servers 0, 1, 2; server
+/// 2 is lost and the chunk's repair is queued. The PRODUCTION reconstruction pass re-places the
+/// lost fragment on server 3 while a client Abort fences the session `fence_delay` ms in — 0016's
+/// abort fence, `Open@E → Aborting@E+1` on the session's exact bytes, emulated (#656's). Whatever
+/// the interleaving: the part names a holder only if that holder has the rebuilt fragment; a
+/// fragment written but not adopted is covered by its destination pre-mark; the obligation drains
+/// only when the re-place won; and the classification sweep finds no gap.
+async fn replace_versus_fence(fence_delay: u64) -> ReplaceEnd {
+    let meta = Arc::new(StagedTap::new());
+    let d = servers();
+    let upload = staged_upload();
+    let open = session_bytes(4, 0, OPEN);
+    let aborting = session_bytes(5, 0, r#"{"kind":"Aborting"}"#);
+    put_raw(&*meta, multipart::mpu_key(&upload), open.clone()).await;
+    let placement = [0, 1, 2];
+    let (part, summary) = part_and_summary(&[staged_ref(STAGED_CHUNK, placement)], 4);
+    let part_key = multipart::part_key(&upload, part_one());
+    put_raw(&*meta, part_key.clone(), part.clone()).await;
+    put_raw(&*meta, multipart::psum_key(&upload, part_one()), summary).await;
+    let data = [0x29u8; 40];
+    for (index, bytes) in staged_stripe(STAGED_CHUNK, &data).into_iter().enumerate() {
+        if index == 2 {
+            continue; // server 2 is lost, and its fragment with it
+        }
+        let frag = FragmentId {
+            chunk: STAGED_CHUNK,
+            index: index as u16,
+        };
+        d[index].put_fragment(frag, bytes, None).await.unwrap();
+    }
+    repair::enqueue_repair(&*meta, STAGED_CHUNK, "scrub")
+        .await
+        .unwrap();
+    meta.events.lock().unwrap().clear();
+
+    let fence = madsim::task::spawn({
+        let meta = Arc::clone(&meta);
+        let key = multipart::mpu_key(&upload);
+        async move {
+            madsim::time::sleep(Duration::from_millis(fence_delay)).await;
+            let batch = WriteBatch::new()
+                .require(key.clone(), open)
+                .put(key, aborting);
+            // A lock race with the re-place's own CAS is the fence's to retry.
+            for _ in 0..8 {
+                if meta.commit(batch.clone()).await.unwrap() == CommitOutcome::Committed {
+                    return;
+                }
+                madsim::time::sleep(Duration::from_millis(1)).await;
+            }
+            panic!("the session fence never landed");
+        }
+    });
+
+    let mut topology = Topology::default();
+    topology.register(0, "A").register(1, "B").register(3, "D");
+    let live: [(DServerId, &dyn ChunkStore); 3] = [(0, &d[0]), (1, &d[1]), (3, &d[3])];
+    let ctx = ReconstructionContext {
+        meta: &*meta,
+        fleet: &live,
+        topology: &topology,
+        unreachable: &[],
+    };
+    let coord = MemCoordination::new();
+    let (zone, custodian) = elect(&coord, "zone-637").await;
+    reconcile_step(&zone, &custodian, None, None, Some(&ctx), None, 10_000)
+        .await
+        .expect("the reconstruction pass completes whatever the interleaving");
+    fence.await.expect("the fence task finished");
+
+    let moved = FragmentId {
+        chunk: STAGED_CHUNK,
+        index: 2,
+    };
+    let now_part = meta.get(&part_key).await.unwrap().unwrap();
+    let now_part = multipart::decode_part_record(&now_part).unwrap();
+    let premark = meta
+        .get(&metadata::orphan_key(3, moved))
+        .await
+        .unwrap()
+        .map(|value| decode_orphan_mark(&value).expect("a pre-mark always decodes"));
+    let queued = repair::queued_repairs(&*meta)
+        .await
+        .unwrap()
+        .contains(&STAGED_CHUNK);
+    let written = d[3].get_fragment(moved).await.unwrap();
+    let scheme = EcScheme::ReedSolomon {
+        k: K as u8,
+        m: M as u8,
+    };
+    let end = if now_part.chunks()[0].placement == [0, 1, 3] {
+        assert!(
+            written
+                .as_deref()
+                .is_some_and(|bytes| repair::fragment_intact(bytes, moved, scheme)),
+            "the part names server 3, which must hold the intact rebuilt fragment"
+        );
+        assert!(
+            premark.is_none(),
+            "an adopted destination's pre-mark is removed"
+        );
+        assert!(!queued, "the obligation drains on the win");
+        assert!(
+            meta.get(&metadata::orphan_key(2, moved))
+                .await
+                .unwrap()
+                .is_some(),
+            "the vacated position is evidenced on the win"
+        );
+        ReplaceEnd::Adopted
+    } else {
+        assert_eq!(
+            meta.get(&part_key).await.unwrap(),
+            Some(part),
+            "a re-place that lost changes nothing in the part record"
+        );
+        assert!(
+            queued,
+            "the obligation stays queued when the re-place does not win"
+        );
+        if written.is_some() {
+            assert!(
+                premark.is_some(),
+                "a rebuilt fragment written but never adopted must stay covered by its \
+                 destination pre-mark (fence at {fence_delay} ms)"
+            );
+            ReplaceEnd::LostAfterWrite
+        } else {
+            ReplaceEnd::FencedFirst
+        }
+    };
+    // The session fence is what the re-place's CAS is conditioned on: once the fence has landed,
+    // no part record may be rewritten under it — whichever branch the run then took.
+    let events = meta.events.lock().unwrap().clone();
+    let fenced_at = events.iter().position(|e| *e == TapEvent::SessionWrite);
+    let repointed_at = events.iter().position(|e| *e == TapEvent::PartWrite);
+    if let (Some(fenced_at), Some(repointed_at)) = (fenced_at, repointed_at) {
+        assert!(
+            repointed_at < fenced_at,
+            "the part record was rewritten AFTER the session was fenced (fence at {fence_delay} \
+             ms): a re-place outside the session fence — the one writer 0016 forbids"
+        );
+    }
+    let fleet: Vec<(DServerId, &MemDServer)> = (0..4).map(|id| (id, &d[id as usize])).collect();
+    assert_classified(&*meta, &fleet, 10_000, 1_000, "J(ii)").await;
+    end
+}
+
+async fn prop_replace_versus_fence_never_strands_the_rebuilt_fragment(rng: &mut ChaCha8Rng) {
+    replace_versus_fence(rng.next_u64() % (u64::from(STAGED_SPAN) + 1)).await;
+}
+
+/// The X29 window — the fence landing after the rebuilt fragment's write and before the
+/// re-place's CAS — is genuinely reached, beside the plain win.
+async fn prop_replace_versus_fence_reaches_the_lost_cas_window() {
+    let mut ends = HashSet::new();
+    for delay in 0..=u64::from(STAGED_SPAN) {
+        ends.insert(replace_versus_fence(delay).await);
+    }
+    assert!(
+        ends.contains(&ReplaceEnd::LostAfterWrite),
+        "no landing point fenced the session between the rebuilt fragment's write and the \
+         re-place's CAS — the X29 window was never exercised: {ends:?}"
+    );
+    assert!(
+        ends.contains(&ReplaceEnd::Adopted),
+        "no landing point let the re-place win: {ends:?}"
+    );
+}
