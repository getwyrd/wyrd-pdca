+// ---- #637 G / I / H2(b) under concurrency: GC's paged ledger walk against a concurrent delete ----
+
+/// The simulated store's lowered per-listing cap for the walk property: a population of a few
+/// dozen marks then spans several pages, and a pass's page budget several passes.
+const LEDGER_CAP: usize = 8;
+/// The object the concurrent writer deletes, and the name it is published under.
+const DOOMED: InodeId = 20;
+
+/// A D server that fails the first `delete_fragment` of one chosen fragment — the custodian dying
+/// between its committed reclamation intent and the deletion (X86) — and counts the deletes that
+/// land.
+#[derive(Default)]
+struct FlakyDServer {
+    inner: MemDServer,
+    fail_once: Mutex<Option<FragmentId>>,
+    landed_deletes: Mutex<Vec<FragmentId>>,
+}
+
+#[async_trait]
+impl ChunkStore for FlakyDServer {
+    async fn put_fragment(
+        &self,
+        id: FragmentId,
+        fragment: Bytes,
+        deadline_millis: Option<u64>,
+    ) -> Result<()> {
+        self.inner.put_fragment(id, fragment, deadline_millis).await
+    }
+
+    async fn get_fragment(&self, id: FragmentId) -> Result<Option<Bytes>> {
+        self.inner.get_fragment(id).await
+    }
+
+    async fn list_fragments(&self) -> Result<Vec<FragmentId>> {
+        self.inner.list_fragments().await
+    }
+
+    async fn delete_fragment(&self, id: FragmentId) -> Result<()> {
+        {
+            let mut armed = self.fail_once.lock().unwrap();
+            if *armed == Some(id) {
+                *armed = None;
+                return Err(Box::new(std::io::Error::other(
+                    "simulated crash between the reclamation intent and the delete",
+                )));
+            }
+        }
+        if self.inner.get_fragment(id).await?.is_some() {
+            self.landed_deletes.lock().unwrap().push(id);
+        }
+        self.inner.delete_fragment(id).await
+    }
+
+    async fn health(&self) -> Result<Health> {
+        Ok(Health::Healthy)
+    }
+}
+
+/// One run: a store whose `orphan:` ledger spans several pages and several passes — lapsed
+/// garbage, in-grace garbage, and lapsed legacy marks an older build left on fragments live
+/// objects still reference — walked by repeated GC passes (each a freshly elected custodian, so
+/// the walk's place can only be kept in the store), while a concurrent writer deletes a live
+/// object `unlink_delay` ms in (`metadata::unlink`, which marks its fragment in the same batch)
+/// and a seed-chosen reclamation is interrupted by a crash between its intent and its delete.
+///
+/// Whatever the interleaving: no fragment a committed object references at the end of a pass has
+/// been deleted; the deleted object's fresh mark is never dropped as stale evidence — even when the
+/// delete lands between a pass's reference read and its ledger read, the window this property's
+/// coverage leg proves is reached; every lapsed piece of garbage is reclaimed exactly once, the
+/// interrupted one resumed; and the classification sweep finds no gap. Returns whether the delete
+/// landed in that window.
+async fn gc_walk_under_a_concurrent_unlink(unlink_delay: u64, crash_on: u64) -> bool {
+    let meta = Arc::new(StagedTap::over(
+        SimTikvMetadataStore::new().with_scan_cap(LEDGER_CAP),
+    ));
+    let d: [FlakyDServer; 4] = Default::default();
+    let (now, grace) = (10_000, 1_000);
+    let frag0 = |chunk: ChunkId| FragmentId { chunk, index: 0 };
+
+    // Live objects, each one single-copy fragment; the first two carry lapsed legacy marks an
+    // older build left on them — the stale population the identity cleanup drops.
+    let live: Vec<(InodeId, ChunkId, DServerId)> = (0..6)
+        .map(|n| (10 + n, 0x1_0000 + ChunkId::from(n), n % 4))
+        .chain([(DOOMED, 0x1_0100, 1)])
+        .collect();
+    for &(inode, chunk, dserver) in &live {
+        let record = flat_committed(chunk, dserver);
+        let name = format!("obj-{inode}");
+        assert_eq!(
+            metadata::create(&*meta, ROOT, &name, inode, &record)
+                .await
+                .unwrap(),
+            CommitOutcome::Committed
+        );
+        d[dserver as usize]
+            .inner
+            .put_fragment(frag0(chunk), Bytes::from_static(b"live"), None)
+            .await
+            .unwrap();
+    }
+    for &(_, chunk, dserver) in &live[..2] {
+        let key = metadata::orphan_key(dserver, frag0(chunk));
+        put_raw(&*meta, key, Bytes::from_static(b"0")).await;
+    }
+    // Lapsed garbage — reclaimable — and in-grace garbage, spread over the fleet.
+    let lapsed: Vec<(ChunkId, DServerId)> = (0..12u64)
+        .map(|n| (0x2_0000 + ChunkId::from(n), n % 4))
+        .collect();
+    let fresh: Vec<(ChunkId, DServerId)> = (0..4u64)
+        .map(|n| (0x3_0000 + ChunkId::from(n), n % 4))
+        .collect();
+    for &(chunk, dserver) in &lapsed {
+        d[dserver as usize]
+            .inner
+            .put_fragment(frag0(chunk), Bytes::from_static(b"garbage"), None)
+            .await
+            .unwrap();
+        put_raw(
+            &*meta,
+            metadata::orphan_key(dserver, frag0(chunk)),
+            Bytes::from_static(b"0"),
+        )
+        .await;
+    }
+    for &(chunk, dserver) in &fresh {
+        d[dserver as usize]
+            .inner
+            .put_fragment(frag0(chunk), Bytes::from_static(b"recent"), None)
+            .await
+            .unwrap();
+        let stamp = Bytes::from((now - 10).to_string());
+        put_raw(&*meta, metadata::orphan_key(dserver, frag0(chunk)), stamp).await;
+    }
+    // The crash lands on one lapsed piece of garbage, chosen by the seed.
+    let (crash_chunk, crash_server) = lapsed[(crash_on % lapsed.len() as u64) as usize];
+    *d[crash_server as usize].fail_once.lock().unwrap() = Some(frag0(crash_chunk));
+
+    let writer = madsim::task::spawn({
+        let meta = Arc::clone(&meta);
+        async move {
+            madsim::time::sleep(Duration::from_millis(unlink_delay)).await;
+            let name = format!("obj-{DOOMED}");
+            for _ in 0..16 {
+                match metadata::unlink(&*meta, ROOT, &name, now).await {
+                    Ok(Some(unlinked)) if unlinked.outcome == CommitOutcome::Committed => return,
+                    Ok(_) | Err(_) => madsim::time::sleep(Duration::from_millis(1)).await,
+                }
+            }
+            panic!("the concurrent delete never landed");
+        }
+    });
+
+    let doomed_frag = frag0(live[6].1);
+    let doomed_key = metadata::orphan_key(live[6].2, doomed_frag);
+    let fleet: Vec<(DServerId, &dyn ChunkStore)> = (0..4)
+        .map(|id| (id as DServerId, &d[id] as &dyn ChunkStore))
+        .collect();
+    for pass in 0..12 {
+        let ctx = GcContext {
+            meta: &*meta,
+            fleet: &fleet,
+            grace_window_millis: grace,
+            expired_pending: ExpiredPendingPolicy::Defer,
+        };
+        let coord = MemCoordination::new();
+        let (zone, custodian) = elect(&coord, "zone-637-gc").await;
+        // A pass the injected crash ends is an `Err`; the next one resumes it.
+        let _ = reconcile_step(&zone, &custodian, Some(&ctx), None, None, None, now).await;
+
+        for &(inode, chunk, dserver) in &live {
+            if meta
+                .get(&metadata::inode_key(inode))
+                .await
+                .unwrap()
+                .is_some()
+            {
+                assert!(
+                    d[dserver as usize]
+                        .inner
+                        .get_fragment(frag0(chunk))
+                        .await
+                        .unwrap()
+                        .is_some(),
+                    "pass {pass}: GC deleted a fragment a committed object references \
+                     (delete at {unlink_delay} ms)"
+                );
+            }
+        }
+        if meta
+            .get(&metadata::inode_key(DOOMED))
+            .await
+            .unwrap()
+            .is_none()
+        {
+            let mark = meta.get(&doomed_key).await.unwrap();
+            assert_eq!(
+                mark.as_deref(),
+                Some(now.to_string().as_bytes()),
+                "pass {pass}: the deleted object's fresh mark was dropped or rewritten — its \
+                 reader-safe grace window lost (delete at {unlink_delay} ms)"
+            );
+        }
+    }
+    writer.await.expect("the concurrent delete finished");
+
+    for &(chunk, dserver) in &lapsed {
+        assert!(
+            d[dserver as usize]
+                .inner
+                .get_fragment(frag0(chunk))
+                .await
+                .unwrap()
+                .is_none()
+                && meta
+                    .get(&metadata::orphan_key(dserver, frag0(chunk)))
+                    .await
+                    .unwrap()
+                    .is_none(),
+            "lapsed garbage {chunk:#x} was never reclaimed — the walk did not converge"
+        );
+        let deletes = d
+            .iter()
+            .map(|server| {
+                server
+                    .landed_deletes
+                    .lock()
+                    .unwrap()
+                    .iter()
+                    .filter(|frag| **frag == frag0(chunk))
+                    .count()
+            })
+            .sum::<usize>();
+        assert_eq!(
+            deletes, 1,
+            "{chunk:#x} was deleted {deletes} times, not once"
+        );
+    }
+    for &(chunk, dserver) in &fresh {
+        assert!(
+            d[dserver as usize]
+                .inner
+                .get_fragment(frag0(chunk))
+                .await
+                .unwrap()
+                .is_some(),
+            "in-grace garbage {chunk:#x} was reclaimed before its grace window"
+        );
+    }
+    for &(_, chunk, dserver) in &live[..2] {
+        assert!(
+            meta.get(&metadata::orphan_key(dserver, frag0(chunk)))
+                .await
+                .unwrap()
+                .is_none(),
+            "the lapsed stale mark on live chunk {chunk:#x} was never dropped"
+        );
+    }
+    let inners: Vec<(DServerId, &MemDServer)> =
+        (0..4).map(|id| (id as DServerId, &d[id].inner)).collect();
+    assert_classified(&*meta, &inners, now, grace, "GC walk").await;
+
+    // Did the delete land after a pass read the committed namespace and before that same pass
+    // read the ledger — the window in which a cleanup that trusted its reference read would drop
+    // the delete's own fresh mark as stale?
+    let events = meta.events.lock().unwrap().clone();
+    let reference_read = TapEvent::Scan(b"inode:".to_vec());
+    let ledger_read = TapEvent::Page(metadata::ORPHAN_PREFIX.to_vec());
+    let at = events.iter().position(|event| *event == TapEvent::Unlink);
+    at.is_some_and(|at| {
+        let before = events[..at]
+            .iter()
+            .rposition(|event| *event == reference_read || *event == ledger_read);
+        let after = events[at..]
+            .iter()
+            .position(|event| *event == ledger_read || *event == reference_read);
+        matches!(
+            (before.map(|i| &events[i]), after.map(|i| &events[at + i])),
+            (Some(r), Some(l)) if *r == reference_read && *l == ledger_read
+        )
+    })
+}
+
+async fn prop_gc_walk_never_loses_a_live_byte_or_a_fresh_mark(rng: &mut ChaCha8Rng) {
+    gc_walk_under_a_concurrent_unlink(rng.next_u64() % 60, rng.next_u64()).await;
+}
+
+/// The window the stale-mark rule has to survive is genuinely reached: a delete landing after a
+/// pass's reference read and before its ledger read.
+async fn prop_gc_walk_reaches_the_reference_to_ledger_window() {
+    let mut reached = false;
+    for delay in 0..60 {
+        reached |= gc_walk_under_a_concurrent_unlink(delay, delay).await;
+    }
+    assert!(
+        reached,
+        "no landing point put the delete between a pass's reference read and its ledger read"
+    );
+}
