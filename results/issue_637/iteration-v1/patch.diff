+/// The owned `sidx:` entry for [`STAGED_CHUNK`] planned on `placement`.
+fn owned_bytes(upload: &UploadId, placement: [DServerId; 3]) -> Bytes {
+    let staged = StagedPlacement::new(
+        EcScheme::ReedSolomon {
+            k: K as u8,
+            m: M as u8,
+        },
+        placement.to_vec(),
+    )
+    .unwrap();
+    metadata::encode(&OwnedEntry::new(upload.clone(), 1_000_000, staged).to_pending())
+}
+
+fn part_one() -> PartNumber {
+    PartNumber::new(1).unwrap()
+}
+
+/// The three real RS(2,1) fragments of `data` under `chunk`.
+fn staged_stripe(chunk: ChunkId, data: &[u8]) -> Vec<Bytes> {
+    erasure::encode(K, M, data)
+        .unwrap()
+        .iter()
+        .enumerate()
+        .map(|(index, shard)| {
+            write::encode_ec_fragment(chunk, index as u16, K as u8, M as u8, shard)
+        })
+        .collect()
+}
+
+async fn put_raw(meta: &dyn MetadataStore, key: Vec<u8>, value: Bytes) {
+    let landed = meta.commit(
+        WriteBatch::new()
+            .require_absent(key.clone())
+            .put(key, value),
+    );
+    assert_eq!(
+        landed.await.unwrap(),
+        CommitOutcome::Committed,
+        "fixture put"
+    );
+}
+
+/// A recording tap over the simulated-TiKV store: every call is forwarded unchanged — network
+/// hops included — and every `scan`'s ANSWER is kept with its prefix, so a property is conditioned
+/// on what the PRODUCTION pass's own reads returned rather than on the fixture's intended timing.
+/// Instance state only (ADR-0035).
+struct StagedTap {
+    inner: SimTikvMetadataStore,
+    scans: Mutex<Vec<ScanAnswer>>,
+    /// Every range read and every object-deleting commit, in the order the store answered them.
+    events: Mutex<Vec<TapEvent>>,
+}
+
+/// One thing the tap saw happen, in order.
+#[derive(Clone, Debug, PartialEq, Eq)]
+enum TapEvent {
+    /// A `scan` of this prefix.
+    Scan(Vec<u8>),
+    /// A `scan_page` of this prefix.
+    Page(Vec<u8>),
+    /// A commit that deleted a `dirent:` — an object's unlink.
+    Unlink,
+    /// A commit that wrote a session record (`mpu:`) — a fence.
+    SessionWrite,
+    /// A commit that wrote a part record (`part:`) — a re-place's CAS.
+    PartWrite,
+}
+
+/// One `scan` the tap answered: the prefix asked for, and the keys it returned.
+type ScanAnswer = (Vec<u8>, Vec<Vec<u8>>);
+
+impl StagedTap {
+    fn new() -> Self {
+        Self::over(SimTikvMetadataStore::new())
+    }
+
+    fn over(inner: SimTikvMetadataStore) -> Self {
+        Self {
+            inner,
+            scans: Mutex::new(Vec::new()),
+            events: Mutex::new(Vec::new()),
+        }
+    }
+
+    /// Whether some `scan` of a prefix starting with `prefix` returned `key`.
+    fn scan_returned(&self, prefix: &[u8], key: &[u8]) -> bool {
+        self.scans
+            .lock()
+            .unwrap()
+            .iter()
+            .any(|(asked, keys)| asked.starts_with(prefix) && keys.iter().any(|k| k == key))
+    }
+
+    /// Whether some `scan` of a prefix starting with `prefix` was made at all.
+    fn scanned(&self, prefix: &[u8]) -> bool {
+        self.scans
+            .lock()
+            .unwrap()
+            .iter()
+            .any(|(asked, _)| asked.starts_with(prefix))
+    }
+}
+
+#[async_trait]
+impl MetadataStore for StagedTap {
+    async fn get(&self, key: &[u8]) -> Result<Option<Bytes>> {
+        self.inner.get(key).await
+    }
+
+    async fn scan(&self, prefix: &[u8]) -> Result<Vec<(Vec<u8>, Bytes)>> {
+        let answer = self.inner.scan(prefix).await?;
+        let keys = answer.iter().map(|(key, _)| key.clone()).collect();
+        self.scans.lock().unwrap().push((prefix.to_vec(), keys));
+        self.events
+            .lock()
+            .unwrap()
+            .push(TapEvent::Scan(prefix.to_vec()));
+        Ok(answer)
+    }
+
+    async fn scan_page(
+        &self,
+        prefix: &[u8],
+        after: Option<&[u8]>,
+        limit: usize,
+    ) -> Result<wyrd_traits::ScanPage> {
+        let page = self.inner.scan_page(prefix, after, limit).await?;
+        self.events
+            .lock()
+            .unwrap()
+            .push(TapEvent::Page(prefix.to_vec()));
+        Ok(page)
+    }
+
+    async fn commit(&self, batch: WriteBatch) -> Result<CommitOutcome> {
+        let unlinks = batch.deletes.iter().any(|key| key.starts_with(b"dirent:"));
+        let puts = |prefix: &[u8]| batch.puts.iter().any(|(key, _)| key.starts_with(prefix));
+        let (session, part) = (puts(multipart::MPU_PREFIX), puts(multipart::PART_PREFIX));
+        let outcome = self.inner.commit(batch).await?;
+        if outcome == CommitOutcome::Committed {
+            let mut events = self.events.lock().unwrap();
+            for (happened, event) in [
+                (unlinks, TapEvent::Unlink),
+                (session, TapEvent::SessionWrite),
+                (part, TapEvent::PartWrite),
+            ] {
+                if happened {
+                    events.push(event);
+                }
+            }
+        }
+        Ok(outcome)
+    }
+}
+
+/// 0016's **classification sweep** (`0016:2906-2921`) over `fleet`: every fragment on disk is in
+/// at least one safe class — committed-referenced, staged with a session that still exists, or
+/// evidenced for reclamation by an `orphan:` mark that decodes — and none is committed-referenced
+/// while carrying lapsed evidence. No gaps, never a partition.
+async fn assert_classified(
+    meta: &dyn MetadataStore,
+    fleet: &[(DServerId, &MemDServer)],
+    now: u64,
+    grace: u64,
+    context: &str,
+) {
+    let mut committed = HashSet::new();
+    for (key, value) in meta.scan(b"inode:").await.unwrap() {
+        let Ok(record) = metadata::decode::<InodeRecord>(&value) else {
+            continue;
+        };
+        if record.state != InodeState::Committed {
+            continue;
+        }
+        if let Ok(Some(resolved)) = metadata::resolve_chunk_map(meta, &key, &record).await {
+            for chunk in resolved.chunks.iter() {
+                for (index, dserver) in chunk.fragments() {
+                    committed.insert((
+                        dserver,
+                        FragmentId {
+                            chunk: chunk.id,
+                            index,
+                        },
+                    ));
+                }
+            }
+        }
+    }
+    let mut staged = HashSet::new();
+    for (key, _) in meta.scan(multipart::MPU_PREFIX).await.unwrap() {
+        let Ok(upload) = multipart::parse_mpu_key(&key) else {
+            continue;
+        };
+        for (key, value) in meta.scan(&multipart::sidx_range(&upload)).await.unwrap() {
+            if let Ok((_, chunk, entry)) = multipart::decode_owned_entry(&key, &value) {
+                for (index, &dserver) in entry.staged().placement().iter().enumerate() {
+                    staged.insert((
+                        dserver,
+                        FragmentId {
+                            chunk,
+                            index: index as u16,
+                        },
+                    ));
+                }
+            }
+        }
+        for (_, value) in meta.scan(&multipart::part_range(&upload)).await.unwrap() {
+            if let Ok(part) = multipart::decode_part_record(&value) {
+                for chunk in part.chunks() {
+                    for (index, dserver) in chunk.fragments() {
+                        staged.insert((
+                            dserver,
+                            FragmentId {
+                                chunk: chunk.id,
+                                index,
+                            },
+                        ));
+                    }
+                }
+            }
+        }
+    }
+    for &(dserver, store) in fleet {
+        for frag in store.list_fragments().await.unwrap() {
+            let at = (dserver, frag);
+            let mark = meta
+                .get(&metadata::orphan_key(dserver, frag))
+                .await
+                .unwrap()
+                .and_then(|value| decode_orphan_mark(&value).ok());
+            if committed.contains(&at) {
+                if let Some(mark) = &mark {
+                    assert!(
+                        mark.is_reclaiming()
+                            || now < mark.orphaned_at_millis().saturating_add(grace),
+                        "{context}: {at:?} is committed-referenced AND carries lapsed evidence"
+                    );
+                }
+                continue;
+            }
+            assert!(
+                staged.contains(&at) || mark.is_some(),
+                "{context}: fragment {frag:?} on D server {dserver} is in NO safe class — neither \
+                 committed-referenced, nor staged with a live session, nor evidenced for \
+                 reclamation"
+            );
+        }
+    }
+}
+
+// ---- #637 J(i): the drain request versus the part intent (X59, 0016:885) ----
+
+/// What one run of the drain-versus-intent race observed.
+struct DrainRace {
+    /// Every answer the operator's status read gave, in order.
+    answers: Vec<ReconciliationStatus>,
+    /// The placement the part's committed intent recorded.
+    placement: [DServerId; 3],
+    /// Whether the intent's first attempt — the placement chosen from the pre-drain topology
+    /// snapshot — was refused by the drain fence and re-planned.
+    replanned: bool,
+}
+
+/// One run: a part upload chose a placement naming [`DRAINED`] from a pre-drain topology
+/// snapshot, and its `sidx:` intent lands `intent_delay` ms in; the operator records the drain
+/// of that server `drain_delay` ms in and reads its status. The intent carries the drain fence —
+/// `require_absent(desired:dserver:<S>)` for every server it places on, 0016 §3's part-intent row,
+/// here emulated since the production writer is #657's — so the two writes are a single-winner
+/// race: the intent lands first and the drain's status is `Pending`, or the drain lands first and
+/// the intent fails and re-plans off the draining server. The status MAY answer `Satisfied` —
+/// but then no fragment of the part may ever land on that server.
+async fn drain_versus_intent(intent_delay: u64, drain_delay: u64) -> DrainRace {
+    let meta = Arc::new(StagedTap::new());
+    let d = servers();
+    let upload = staged_upload();
+    let open = session_bytes(1, 0, OPEN);
+    put_raw(&*meta, multipart::mpu_key(&upload), open.clone()).await;
+    let data = [0x5Au8; 40];
+
+    let intent = madsim::task::spawn({
+        let meta = Arc::clone(&meta);
+        let upload = upload.clone();
+        async move {
+            madsim::time::sleep(Duration::from_millis(intent_delay)).await;
+            // The placement the upload chose before the drain existed.
+            let mut placement: [DServerId; 3] = [DRAINED, 1, 2];
+            let mut replanned = false;
+            for _ in 0..8 {
+                let key = multipart::sidx_key(&upload, part_one(), STAGED_CHUNK);
+                let mut batch = WriteBatch::new()
+                    .require(multipart::mpu_key(&upload), open.clone())
+                    .require_absent(key.clone())
+                    .put(key, owned_bytes(&upload, placement));
+                for &server in &placement {
+                    batch =
+                        batch.require_absent(wyrd_custodian::desired_state::desired_key(server));
+                }
+                if meta.commit(batch).await.unwrap() == CommitOutcome::Committed {
+                    return (placement, replanned);
+                }
+                // Refused: re-plan against the fresh topology with every draining server
+                // excluded (`Topology::excluding(draining)`), and retry.
+                let draining = draining_servers(&*meta).await.unwrap();
+                if draining.contains_key(&DRAINED) {
+                    placement = [0, 1, 2];
+                    replanned = true;
+                }
+            }
+            panic!("the intent never committed");
+        }
+    });
+
+    let operator = madsim::task::spawn({
+        let meta = Arc::clone(&meta);
+        async move {
+            madsim::time::sleep(Duration::from_millis(drain_delay)).await;
+            // A blind write, retried as an operator retries one that raced a lock.
+            let mut recorded = false;
+            for _ in 0..8 {
+                if set_lifecycle(&*meta, DRAINED, DServerLifecycle::Draining)
+                    .await
+                    .is_ok()
+                {
+                    recorded = true;
+                    break;
+                }
+                madsim::time::sleep(Duration::from_millis(1)).await;
+            }
+            assert!(recorded, "the drain request never landed");
+            vec![reconciliation_status(&*meta, DRAINED).await.unwrap()]
+        }
+    });
+
+    let (placement, replanned) = intent.await.expect("the intent task finished");
+    let mut answers = operator.await.expect("the operator task finished");
+    // The part's fragments land where its committed intent placed them — the write path writes
+    // only after its intent commits.
+    for (index, bytes) in staged_stripe(STAGED_CHUNK, &data).into_iter().enumerate() {
+        let frag = FragmentId {
+            chunk: STAGED_CHUNK,
+            index: index as u16,
+        };
+        d[placement[index] as usize]
+            .put_fragment(frag, bytes, None)
+            .await
+            .unwrap();
+    }
+    // ...and the operator reads again once everything has landed.
+    answers.push(reconciliation_status(&*meta, DRAINED).await.unwrap());
+
+    let on_drained = !d[DRAINED as usize]
+        .list_fragments()
+        .await
+        .unwrap()
+        .is_empty();
+    if answers.contains(&ReconciliationStatus::Satisfied) {
+        assert!(
+            !placement.contains(&DRAINED) && !on_drained,
+            "the drain of server {DRAINED} was reported Satisfied, and a fragment of the part \
+             still landed there (placement {placement:?}, intent at {intent_delay} ms, drain at \
+             {drain_delay} ms) — wiping the server now loses a live upload's bytes"
+        );
+    }
+    if placement.contains(&DRAINED) {
+        assert_eq!(
+            answers.last(),
+            Some(&ReconciliationStatus::Pending),
+            "the intent landed on server {DRAINED} before its drain: the drain must stay Pending"
+        );
+    }
+    let fleet: Vec<(DServerId, &MemDServer)> = (0..4).map(|id| (id, &d[id as usize])).collect();
+    assert_classified(&*meta, &fleet, 10_000, 1_000, "J(i)").await;
+    DrainRace {
+        answers,
+        placement,
+        replanned,
+    }
+}
+
+async fn prop_drain_versus_intent_never_strands_a_fragment_on_a_satisfied_drain(
+    rng: &mut ChaCha8Rng,
+) {
+    let span = u64::from(STAGED_SPAN);
+    drain_versus_intent(rng.next_u64() % (span + 1), rng.next_u64() % (span + 1)).await;
+}
+
+/// Both orders of the race are genuinely reached: an intent landing first (the drain is `Pending`
+/// on a part placed on the server) and a drain landing first (the intent is refused, re-plans, and
+/// the drain may be — and is — answered `Satisfied` with nothing ever landing there).
+async fn prop_drain_versus_intent_reaches_both_orders() {
+    let (mut intent_first, mut drain_first_satisfied) = (false, false);
+    for intent_delay in [0, 4, 8, 12] {
+        for drain_delay in 0..=u64::from(STAGED_SPAN) {
+            let race = drain_versus_intent(intent_delay, drain_delay).await;
+            intent_first |= race.placement.contains(&DRAINED);
+            drain_first_satisfied |=
+                race.replanned && race.answers.first() == Some(&ReconciliationStatus::Satisfied);
+        }
+    }
+    assert!(
+        intent_first,
+        "no landing point let the intent land on the draining server first"
+    );
+    assert!(
+        drain_first_satisfied,
+        "no landing point recorded the drain first and answered Satisfied before a re-planned \
+         intent — the interleaving X59 is about was never exercised"
+    );
+}
+
+// ---- #637 I2: the two handoffs, source before destination (0016:782-800) ----
+
+/// What the reference build's own reads saw of a handoff.
+struct HandoffSeen {
+    /// The source class's read returned the chunk's record.
+    source: bool,
+    /// The destination class's read returned the chunk's record.
+    destination: bool,
+}
+
+/// **The part commit** (`sidx:` → `part:`): one batch deletes the chunk's owned entry and writes
+/// the part record that protects the same bytes (0016 §3's part-commit row, emulated — #657's).
+/// It lands `delay` ms into a drain-status read of a server the chunk is placed on. Read source
+/// before destination, the build sees the chunk in both or in `part:` alone — never in neither —
+/// so the drain is `Pending` at every landing point.
+async fn part_commit_handoff(delay: u64) -> HandoffSeen {
+    let meta = Arc::new(StagedTap::new());
+    let upload = staged_upload();
+    let open = session_bytes(1, 0, OPEN);
+    let placement = [DRAINED, 1, 2];
+    let sidx = multipart::sidx_key(&upload, part_one(), STAGED_CHUNK);
+    let owned = owned_bytes(&upload, placement);
+    put_raw(&*meta, multipart::mpu_key(&upload), open.clone()).await;
+    put_raw(&*meta, sidx.clone(), owned.clone()).await;
+    set_lifecycle(&*meta, DRAINED, DServerLifecycle::Draining)
+        .await
+        .unwrap();
+    let (part, summary) = part_and_summary(&[staged_ref(STAGED_CHUNK, placement)], 1);
+    let part_key = multipart::part_key(&upload, part_one());
+
+    let commit = madsim::task::spawn({
+        let meta = Arc::clone(&meta);
+        let (upload, part_key, sidx) = (upload.clone(), part_key.clone(), sidx.clone());
+        async move {
+            madsim::time::sleep(Duration::from_millis(delay)).await;
+            let batch = WriteBatch::new()
+                .require(multipart::mpu_key(&upload), open)
+                .require(sidx.clone(), owned)
+                .require_absent(part_key.clone())
+                .delete(sidx)
+                .put(part_key, part)
+                .put(multipart::psum_key(&upload, part_one()), summary);
+            assert_eq!(meta.commit(batch).await.unwrap(), CommitOutcome::Committed);
+        }
+    });
+    let status = reconciliation_status(&*meta, DRAINED).await.unwrap();
+    commit.await.expect("the part commit landed");
+
+    assert_eq!(
+        status,
+        ReconciliationStatus::Pending,
+        "a part commit landing {delay} ms into the drain read left its chunk in NEITHER staged \
+         class — the drain answered as though server {DRAINED} held nothing"
+    );
+    HandoffSeen {
+        source: meta.scan_returned(multipart::SIDX_PREFIX, &sidx),
+        destination: meta.scan_returned(multipart::PART_PREFIX, &part_key),
+    }
+}
+
+/// **Publication** (`part:` → committed inode): the root flip writes the inode and the dirent,
+/// moves the session to `Completed` and installs `retire:records:{parts}` in one batch; the
+/// retirement drain then deletes the part records it names (0016 §3's root-flip and drain rows,
+/// emulated — #658/#659's). Both land around a drain-status read that starts `read_delay` ms in.
+/// Read `part:` before the committed inodes, a chunk is always seen in at least one of them (X67).
+async fn publication_handoff(flip_delay: u64, drain_delay: u64, read_delay: u64) -> HandoffSeen {
+    let meta = Arc::new(StagedTap::new());
+    let upload = staged_upload();
+    let placement = [DRAINED, 1, 2];
+    let chunk = staged_ref(STAGED_CHUNK, placement);
+    let fenced = session_bytes(2, 1, &completing(2));
+    put_raw(&*meta, multipart::mpu_key(&upload), fenced.clone()).await;
+    let (part, summary) = part_and_summary(std::slice::from_ref(&chunk), 1);
+    let part_key = multipart::part_key(&upload, part_one());
+    let psum_key = multipart::psum_key(&upload, part_one());
+    put_raw(&*meta, part_key.clone(), part).await;
+    put_raw(&*meta, psum_key.clone(), summary).await;
+    set_lifecycle(&*meta, DRAINED, DServerLifecycle::Draining)
+        .await
+        .unwrap();
+    let published: InodeId = 5;
+    let root = InodeRecord {
+        size: 40,
+        chunk_map: vec![chunk].into(),
+        state: InodeState::Committed,
+        version: 1,
+        ..Default::default()
+    };
+
+    let mover = madsim::task::spawn({
+        let meta = Arc::clone(&meta);
+        let upload = upload.clone();
+        async move {
+            madsim::time::sleep(Duration::from_millis(flip_delay)).await;
+            let token = multipart::RetireToken::Session {
+                upload_id: upload.clone(),
+                epoch: 2,
+                part: None,
+            };
+            let obligation = multipart::retire_key(multipart::RetireMode::Records, &token);
+            let owed = Bytes::from_static(br#"{"parts":[[1,1]]}"#);
+            multipart::decode_retire_obligation(&obligation, &owed)
+                .expect("fixture: a canonical retirement obligation");
+            let flip = WriteBatch::new()
+                .require(multipart::mpu_key(&upload), fenced)
+                .require_absent(metadata::inode_key(published))
+                .require_absent(metadata::dirent_key(ROOT, "big.bin"))
+                .require_absent(obligation.clone())
+                .put(metadata::inode_key(published), metadata::encode(&root))
+                .put(
+                    metadata::dirent_key(ROOT, "big.bin"),
+                    metadata::encode(&metadata::DirentRecord { inode: published }),
+                )
+                .put(
+                    multipart::mpu_key(&upload),
+                    session_bytes(3, 1, &completed(published)),
+                )
+                .put(obligation.clone(), owed.clone());
+            assert_eq!(meta.commit(flip).await.unwrap(), CommitOutcome::Committed);
+            madsim::time::sleep(Duration::from_millis(drain_delay)).await;
+            let drain = WriteBatch::new()
+                .require(obligation.clone(), owed)
+                .delete(part_key)
+                .delete(psum_key)
+                .delete(obligation);
+            assert_eq!(meta.commit(drain).await.unwrap(), CommitOutcome::Committed);
+        }
+    });
+    madsim::time::sleep(Duration::from_millis(read_delay)).await;
+    let status = reconciliation_status(&*meta, DRAINED).await.unwrap();
+    mover.await.expect("the flip and the drain landed");
+
+    assert_eq!(
+        status,
+        ReconciliationStatus::Pending,
+        "a publication flipping at {flip_delay} ms and drained {drain_delay} ms later, around a \
+         drain read starting at {read_delay} ms, left the published chunk in NEITHER its part \
+         record nor the committed inode — the drain answered as though server {DRAINED} held \
+         nothing while a live object names it"
+    );
+    HandoffSeen {
+        source: meta.scan_returned(
+            multipart::PART_PREFIX,
+            &multipart::part_key(&staged_upload(), part_one()),
+        ),
+        destination: meta.scanned(b"inode:")
+            && meta.scan_returned(b"inode:", &metadata::inode_key(published)),
+    }
+}
+
+async fn prop_handoffs_never_hide_a_chunk_from_the_reference_build(rng: &mut ChaCha8Rng) {
+    let span = u64::from(STAGED_SPAN);
+    part_commit_handoff(rng.next_u64() % (span + 1)).await;
+    publication_handoff(
+        rng.next_u64() % (span + 1),
+        rng.next_u64() % 4,
+        rng.next_u64() % (span + 1),
+    )
+    .await;
+}
+
+/// The windows the read order exists for are genuinely reached: a part commit landing BETWEEN the
+/// build's `sidx:` and `part:` reads (seen in both), and a publication whose drain retired the part
+/// record BEFORE the build read `part:` (seen only in the committed inode) — the interleaving that
+/// leaves a chunk in neither class under the opposite order.
+async fn prop_handoffs_reach_the_windows_the_read_order_closes() {
+    let mut between = false;
+    for delay in 0..=u64::from(STAGED_SPAN) {
+        let seen = part_commit_handoff(delay).await;
+        between |= seen.source && seen.destination;
+    }
+    let (mut drained_first, mut flipped_between) = (false, false);
+    for flip_delay in 0..=u64::from(STAGED_SPAN) {
+        for read_delay in [0, 2, 4, 8] {
+            let seen = publication_handoff(flip_delay, 0, read_delay).await;
+            drained_first |= !seen.source && seen.destination;
+            flipped_between |= seen.source && seen.destination;
+        }
+    }
+    assert!(
+        between,
+        "no landing point put the part commit between the build's sidx: and part: reads"
+    );
+    assert!(
+        drained_first,
+        "no landing point retired the part record before the build read part: while the root \
+         had flipped — the X67 window was never exercised"
+    );
+    assert!(
+        flipped_between,
+        "no landing point flipped the root between the build's part: and inode: reads"
+    );
+}
