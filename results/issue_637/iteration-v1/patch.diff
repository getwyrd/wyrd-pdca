+/// One decoded `orphan:` value — see the module doc for its three shapes.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum OrphanMark {
+    /// The bare stamp every writer before this module spells: no identity.
+    Legacy {
+        /// When the position was orphaned — the start of its grace window.
+        orphaned_at_millis: u64,
+    },
+    /// Evidence naming the unreference event that wrote it.
+    Evidence {
+        /// When the position was orphaned — the start of its grace window.
+        orphaned_at_millis: u64,
+        /// The unreference event this mark evidences.
+        event: MarkEvent,
+    },
+    /// GC's reclamation intent: reclamation of this position is already decided, committed
+    /// before its bytes are destroyed (`0016:1312-1333`). A pass that meets one resumes it.
+    Reclaiming {
+        /// The stamp of the mark it replaced, kept as it was.
+        orphaned_at_millis: u64,
+        /// The identity of the mark it replaced, if that mark carried one.
+        event: Option<MarkEvent>,
+    },
+}
+
+/// The wire shape of a **structured** mark: closed, and each optional field omitted when absent,
+/// so the accepted set is exactly the encoder's image (checked in [`decode_orphan_mark`]).
+#[derive(Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct MarkWire {
+    orphaned_at_millis: u64,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    event: Option<String>,
+    #[serde(default, skip_serializing_if = "is_false")]
+    reclaiming: bool,
+}
+
+/// `skip_serializing_if` for a flag that is spelled only when set.
+fn is_false(flag: &bool) -> bool {
+    !*flag
+}
+
+impl OrphanMark {
+    /// Evidence of `event`, stamped at `orphaned_at_millis`.
+    pub const fn evidence(orphaned_at_millis: u64, event: MarkEvent) -> Self {
+        Self::Evidence {
+            orphaned_at_millis,
+            event,
+        }
+    }
+
+    /// When the position was orphaned — the stamp its grace window runs from.
+    pub const fn orphaned_at_millis(&self) -> u64 {
+        match self {
+            Self::Legacy { orphaned_at_millis }
+            | Self::Evidence {
+                orphaned_at_millis, ..
+            }
+            | Self::Reclaiming {
+                orphaned_at_millis, ..
+            } => *orphaned_at_millis,
+        }
+    }
+
+    /// The unreference event this mark names, if it names one (a legacy mark never does).
+    pub const fn event(&self) -> Option<&MarkEvent> {
+        match self {
+            Self::Legacy { .. } => None,
+            Self::Evidence { event, .. } => Some(event),
+            Self::Reclaiming { event, .. } => event.as_ref(),
+        }
+    }
+
+    /// Whether reclamation of this position is already decided.
+    pub const fn is_reclaiming(&self) -> bool {
+        matches!(self, Self::Reclaiming { .. })
+    }
+
+    /// The **reclamation intent** GC commits over this mark before it destroys the bytes: the
+    /// same stamp and the same identity, marked `reclaiming` (`0016:1316-1319`). Idempotent.
+    pub fn reclaiming(&self) -> Self {
+        Self::Reclaiming {
+            orphaned_at_millis: self.orphaned_at_millis(),
+            event: self.event().cloned(),
+        }
+    }
+
+    /// The stored bytes — the one spelling [`decode_orphan_mark`] accepts for this value.
+    pub fn encode(&self) -> Bytes {
+        let (event, reclaiming) = match self {
+            Self::Legacy { orphaned_at_millis } => {
+                return Bytes::from(orphaned_at_millis.to_string());
+            }
+            Self::Evidence { event, .. } => (Some(event.to_string()), false),
+            Self::Reclaiming { event, .. } => (event.as_ref().map(ToString::to_string), true),
+        };
+        metadata::encode(&MarkWire {
+            orphaned_at_millis: self.orphaned_at_millis(),
+            event,
+            reclaiming,
+        })
+    }
+}
+
+/// Decode an `orphan:` value into one of its three shapes, refusing every other spelling — see
+/// the module doc. The error is typed ([`RecordError::MalformedRecordValue`] /
+/// [`RecordError::NoncanonicalRecordValue`], namespace `orphan:`) so a pass can classify the value
+/// and name it rather than guess at it.
+pub fn decode_orphan_mark(value: &[u8]) -> Result<OrphanMark, RecordError> {
+    let noncanonical = RecordError::NoncanonicalRecordValue {
+        namespace: "orphan:",
+    };
+    if !value.is_empty() && value.iter().all(u8::is_ascii_digit) {
+        // The legacy shape. ASCII digits are UTF-8, so the conversion cannot fail.
+        let text = std::str::from_utf8(value).map_err(|_| noncanonical.clone())?;
+        let stamp = multipart::canonical_decimal(text).ok_or(noncanonical)?;
+        return Ok(OrphanMark::Legacy {
+            orphaned_at_millis: stamp,
+        });
+    }
+    let wire: MarkWire =
+        metadata::decode(value).map_err(|err| RecordError::MalformedRecordValue {
+            namespace: "orphan:",
+            detail: err.to_string(),
+        })?;
+    let event = wire.event.as_deref().map(MarkEvent::parse).transpose()?;
+    let mark = match (event, wire.reclaiming) {
+        (event, true) => OrphanMark::Reclaiming {
+            orphaned_at_millis: wire.orphaned_at_millis,
+            event,
+        },
+        (Some(event), false) => OrphanMark::Evidence {
+            orphaned_at_millis: wire.orphaned_at_millis,
+            event,
+        },
+        // A mark with no identity and no intent has exactly one spelling: the bare stamp.
+        (None, false) => return Err(noncanonical),
+    };
+    if mark.encode().as_ref() != value {
+        return Err(noncanonical);
+    }
+    Ok(mark)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::multipart::UploadId;
+
+    fn session_token() -> RetireToken {
+        RetireToken::Session {
+            upload_id: UploadId::new("ab".repeat(16)).unwrap(),
+            epoch: 3,
+            part: None,
+        }
+    }
+
+    /// Every shape round-trips byte-identically — the property a CAS on a mark's exact bytes
+    /// turns on — and decodes to what was encoded.
+    #[test]
+    fn every_shape_round_trips_byte_identically() {
+        let marks = [
+            OrphanMark::Legacy {
+                orphaned_at_millis: 0,
+            },
+            OrphanMark::Legacy {
+                orphaned_at_millis: 1_700_000_000_123,
+            },
+            OrphanMark::evidence(42, MarkEvent::Retirement(session_token())),
+            OrphanMark::evidence(
+                42,
+                MarkEvent::Retirement(RetireToken::Generation {
+                    inode: 9,
+                    version: 1,
+                }),
+            ),
+            OrphanMark::evidence(7, MarkEvent::Move(MoveId::new(3, 0xC0FFEE, 2, 10_000))),
+            OrphanMark::evidence(42, MarkEvent::Retirement(session_token())).reclaiming(),
+            OrphanMark::Legacy {
+                orphaned_at_millis: 5,
+            }
+            .reclaiming(),
+        ];
+        for mark in marks {
+            let bytes = mark.encode();
+            assert_eq!(decode_orphan_mark(&bytes).unwrap(), mark, "{bytes:?}");
+            assert_eq!(decode_orphan_mark(&bytes).unwrap().encode(), bytes);
+        }
+    }
+
+    /// The spellings the module doc names, pinned: the tree's legacy writers' `u64::to_string`,
+    /// and the two structured shapes.
+    #[test]
+    fn the_three_shapes_are_spelled_as_documented() {
+        let legacy = OrphanMark::Legacy {
+            orphaned_at_millis: 1234,
+        };
+        assert_eq!(legacy.encode().as_ref(), b"1234");
+        let evidence = OrphanMark::evidence(
+            0,
+            MarkEvent::Retirement(RetireToken::Generation {
+                inode: 9,
+                version: 1,
+            }),
+        );
+        assert_eq!(
+            evidence.encode().as_ref(),
+            br#"{"orphaned_at_millis":0,"event":"g:9:1"}"#
+        );
+        assert_eq!(
+            evidence.reclaiming().encode().as_ref(),
+            br#"{"orphaned_at_millis":0,"event":"g:9:1","reclaiming":true}"#
+        );
+        assert_eq!(
+            legacy.reclaiming().encode().as_ref(),
+            br#"{"orphaned_at_millis":1234,"reclaiming":true}"#
+        );
+        let moved = OrphanMark::evidence(10, MarkEvent::Move(MoveId::new(3, 17, 2, 10)));
+        assert_eq!(
+            moved.encode().as_ref(),
+            br#"{"orphaned_at_millis":10,"event":"m:3:17:2:10"}"#
+        );
+    }
+
+    /// Every other spelling is refused — each one a value no writer produces and a CAS on exact
+    /// bytes could never match.
+    #[test]
+    fn every_other_spelling_is_refused() {
+        for bad in [
+            b"".as_slice(),
+            b"007",
+            b"+7",
+            b"-1",
+            b"18446744073709551616",
+            b"not a mark",
+            br#"{"orphaned_at_millis":5}"#,
+            br#"{"orphaned_at_millis":5,"event":null}"#,
+            br#"{"orphaned_at_millis":5,"event":"g:9:1","reclaiming":false}"#,
+            br#"{"event":"g:9:1","orphaned_at_millis":5}"#,
+            br#"{"orphaned_at_millis": 5,"event":"g:9:1"}"#,
+            br#"{"orphaned_at_millis":"soon"}"#,
+            br#"{"orphaned_at_millis":5,"event":"g:09:1"}"#,
+            br#"{"orphaned_at_millis":5,"event":"x:1"}"#,
+            br#"{"orphaned_at_millis":5,"event":"m:1:2:3"}"#,
+            br#"{"orphaned_at_millis":5,"event":"m:1:2:3:04"}"#,
+            br#"{"orphaned_at_millis":5,"event":"g:9:1","extra":1}"#,
+        ] {
+            assert!(
+                decode_orphan_mark(bad).is_err(),
+                "{:?} must not decode",
+                String::from_utf8_lossy(bad)
+            );
+        }
+    }
+
+    /// A retirement's event names its obligation's key — the keyed lookup — and a move names
+    /// none.
+    #[test]
+    fn a_retirement_event_names_its_obligation_key() {
+        let token = session_token();
+        assert_eq!(
+            MarkEvent::Retirement(token.clone()).retirement_key(),
+            Some(multipart::retire_key(RetireMode::Bytes, &token))
+        );
+        assert_eq!(
+            MarkEvent::Move(MoveId::new(1, 2, 3, 4)).retirement_key(),
+            None
+        );
+    }
+}
