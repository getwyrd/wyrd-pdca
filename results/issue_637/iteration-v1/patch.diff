+//! GC's walk of the **`orphan:` ledger** — the reclaim half of the GC loop ([`crate::gc`]),
+//! built to proposal 0016 decision 4.2
+//! (`docs/design/proposals/draft/0016-multipart-commit-protocol.md:1121-1408`).
+//!
+//! # Bounded per pass, and the tail never starves (`0016:1392-1404`)
+//!
+//! One maximum segmented-object retirement installs ~1.78 M marks against a `scan` cap of
+//! 1,048,576, and `scan` fails whole — so a ledger read with one `scan` takes GC out for good,
+//! and with it the fragment-less mark sweep that bounds this very namespace. The ledger is
+//! therefore walked with [`MetadataStore::scan_page`], at most [`PAGES_PER_PASS`] pages of at
+//! most [`PAGE_LIMIT`] marks per pass: a pass's ledger footprint is bounded by those two
+//! constants, never by the ledger's size. Its place is kept in the store (`WALK_KEY`), so the
+//! next pass — whichever custodian runs it — continues where this one stopped, and a population
+//! larger than one pass drains across passes instead of the first pages being read forever.
+//!
+//! A pass that did not read the whole ledger draws only **retention-safe** conclusions from it:
+//! a mark it did not read leaves its fragment looking unmarked, which GC keeps; nothing is ever
+//! destroyed on the strength of not having seen a record. The walk's progress is on the
+//! durability seam — pages read, sweeps completed, and the age of the oldest mark still waiting —
+//! so a walk that falls behind is visible to an operator.
+//!
+//! # Reclamation intent precedes destruction (`0016:1312-1333`, X61, X86)
+//!
+//! GC CASes a mark to `reclaiming` — from the exact bytes it read — and **commits** that before
+//! it calls `delete_fragment`, deleting the key afterwards. Any adoption CAS preconditioned on a
+//! destination pre-mark's original bytes therefore fails from the instant reclamation begins.
+//! A crash between the intent and the delete leaves a `reclaiming` mark over a fragment still on
+//! disk; the next pass that reads it resumes the reclamation — the fragment deleted if it is
+//! still there, then the key — with no second grace test, since the first already passed.
+//!
+//! # Keyed pending-retirement protection (`0016:1226-1247`, X97)
+//!
+//! A mark names the unreference event that wrote it, and a retirement's token **is** its
+//! obligation's key: while `retire:bytes:<token>` is present the retirement is still draining and
+//! the positions it names are protected. That is one `get` per event met, never an expansion of
+//! the obligation — the `retire:` namespace is never read as a range here.
+//!
+//! # The fragment-less mark sweep (`0016:1359-1391`, X87, X91, X96)
+//!
+//! A mark whose position no server's listing reports is visited by nothing else. It is deleted
+//! once it is older than the late-write deadline [`LATE_WRITE_DEADLINE_MILLIS`] **and** its
+//! absence was observed after that deadline — the listing is the one this pass took, at
+//! `now_millis`. A mark on a server outside the fleet is never swept: its absence was never
+//! observed at all.
+//!
+//! # The orphan-identity migration gate (`0016:1249-1279`, X92)
+//!
+//! The keyed lookup is sound only once every mark names its **most recent** unreference event.
+//! The population that breaks that is bounded and known: marks an older build left on fragments a
+//! live reference still names — a legacy (identity-free) mark over a still-referenced or staged
+//! fragment. Each pass drops the lapsed ones it meets; a mark still inside its grace window that
+//! was already there when the pass began stops the current sweep from counting as clean. When a
+//! **clean** sweep — every page read against a complete reference set, every stale mark dropped —
+//! reaches the end of the ledger, the durable marker [`IDENTITY_CLEANUP_KEY`] is written. Until it
+//! exists, identity-keyed retirement is disabled and GC falls back to the safe direction: **every
+//! mark protects**, and nothing is reclaimed on one. A post-restore pass deletes the marker, since
+//! a rewound ledger is a population the cleanup has not yet read (`crate::restore`).
+//!
+//! # Clock
+//!
+//! Every stamp compared here — a mark's `orphaned_at_millis` against the grace window, the
+//! late-write deadline and the pass's own start — is the **deployment wall clock** the pass is
+//! handed as `now_millis` (ADR-0009; 0016's clock table, the orphan-grace row): the one source
+//! that stamps the marks this protocol writes.
+
+use std::collections::{HashMap, HashSet};
+
+use wyrd_core::metadata::{parse_orphan_key, ORPHAN_PREFIX};
+use wyrd_core::orphan::{decode_orphan_mark, MarkEvent, OrphanMark};
+use wyrd_traits::{
+    ChunkStore, CommitOutcome, DServerId, FragmentId, MetadataStore, Result, WriteBatch,
+};
+
+use crate::gc::{emit_reclaim, emit_skip, object_name, GcContext, ReferenceSet};
+
+/// Marks per page of the walk.
+pub(crate) const PAGE_LIMIT: usize = 1_024;
+
+/// Pages one pass may read — with [`PAGE_LIMIT`], the bound on one pass's ledger footprint:
+/// `16 × 1,024 = 16,384` marks. A mark's key is at most 73 bytes (`orphan:<u64>:<u128>:<u16>` in
+/// decimal: 7 + 20 + 1 + 39 + 1 + 5) and its value at most 166 (the `reclaiming` shape carrying
+/// the longest event, a per-part session token of 94 bytes), so the marks one pass holds come to
+/// at most ~3.9 MB of key and value bytes — ~1.1 MB for the common legacy mark, a ~54-byte key
+/// over a 13-digit stamp — whatever the ledger's size. A store whose own cap is lower clamps each
+/// page to it, which only lowers the bound.
+pub(crate) const PAGES_PER_PASS: usize = 16;
+
+/// `W_write`: the window a fragment write, once authorized, has to land in (`0016:1478`). A
+/// **local** value for the sweep's deadline: the write path has not chosen its own yet, and the
+/// value is the window-sizing slice's (#625) to reconcile with this one.
+pub(crate) const W_WRITE_MILLIS: u64 = 20_000;
+
+/// `W_repoint`: how long after its pre-mark a repoint or staged re-place may still authorize its
+/// destination write (`0016:1479`). Local, and #625's to reconcile, as [`W_WRITE_MILLIS`].
+pub(crate) const W_REPOINT_MILLIS: u64 = 20_000;
+
+/// `δ_clock`: the skew allowed between the clock that authorizes a write and the one that applies
+/// it (`0016:1478`).
+pub(crate) const DELTA_CLOCK_MILLIS: u64 = 5_000;
+
+/// The **late-write deadline** `W_repoint + W_write + δ_clock` (`0016:1381-1391`): no fragment
+/// authorized against a mark can land at its position later than this after the mark's stamp. It
+/// must stay strictly inside the orphan grace window `G_orphan`, and the 45 s here does against
+/// the 60 s the deployed pass is handed (`crates/server/src/custodian.rs`,
+/// `GC_GRACE_WINDOW_MILLIS`).
+pub(crate) const LATE_WRITE_DEADLINE_MILLIS: u64 =
+    W_REPOINT_MILLIS + W_WRITE_MILLIS + DELTA_CLOCK_MILLIS;
+
+/// Where the walk's continuation lives: `[flag][after]` — one byte, `c` while the current sweep
+/// is still clean and `d` once it is not, then the raw key the next page starts after (empty at
+/// the start of a sweep). GC's own bookkeeping; nothing else reads it.
+pub(crate) const WALK_KEY: &[u8] = b"custodian:gc:orphan-walk";
+
+/// The durable marker a completed orphan-identity cleanup leaves: present means a clean sweep of
+/// the whole ledger has run, and identity-keyed retirement is enabled. Its value is the instant
+/// the sweep completed, for an operator reading the store.
+pub(crate) const IDENTITY_CLEANUP_KEY: &[u8] = b"custodian:gc:orphan-identity";
+
+/// How many positions one mutation batch carries: well inside the byte budget of a transaction,
+/// and — at two operations per position, a precondition and a mutation — inside the operation
+/// budget the `restore.rs` `MARK_BATCH` precedent keeps.
+const MUTATION_BATCH: usize = 256;
+
+/// The walk's durable continuation.
+#[derive(Debug, Clone, PartialEq, Eq)]
+struct Walk {
+    /// The key the next page starts strictly after; `None` at the start of a sweep.
+    after: Option<Vec<u8>>,
+    /// Whether the sweep in progress has, so far, met nothing that stops it counting as a
+    /// completed cleanup.
+    clean: bool,
+}
+
+impl Walk {
+    const fn start() -> Self {
+        Self {
+            after: None,
+            clean: true,
+        }
+    }
+
+    fn encode(&self) -> Vec<u8> {
+        let mut value = vec![if self.clean { b'c' } else { b'd' }];
+        value.extend_from_slice(self.after.as_deref().unwrap_or_default());
+        value
+    }
+
+    /// `None` for any value [`Self::encode`] could not have written.
+    fn decode(value: &[u8]) -> Option<Self> {
+        let (&flag, after) = value.split_first()?;
+        let clean = match flag {
+            b'c' => true,
+            b'd' => false,
+            _ => return None,
+        };
+        let after = match after {
+            [] => None,
+            key if key.starts_with(ORPHAN_PREFIX) => Some(key.to_vec()),
+            _ => return None,
+        };
+        Some(Self { after, clean })
+    }
+}
+
+/// One mark this pass read, with the exact bytes every mutation of it CASes on.
+struct Seen {
+    dserver: DServerId,
+    frag: FragmentId,
+    key: Vec<u8>,
+    value: Vec<u8>,
+    mark: OrphanMark,
+}
+
+/// What this pass decided about the marks it read.
+#[derive(Default)]
+struct Plan {
+    /// Legacy marks on still-referenced fragments, lapsed: stale evidence, dropped.
+    stale: Vec<Seen>,
+    /// Marks over positions no listing reported, past the late-write deadline: swept.
+    sweep: Vec<Seen>,
+    /// Lapsed marks over unreferenced fragments on disk: reclaimed, if the identity gate is open.
+    reclaim: Vec<Seen>,
+    /// `reclaiming` marks: reclamation already decided, resumed.
+    resume: Vec<Seen>,
+    /// The oldest stamp among the marks this pass left waiting.
+    oldest_waiting: Option<u64>,
+}
+
+/// One walk of the ledger for one GC pass: read at most [`PAGES_PER_PASS`] pages from where the
+/// last pass stopped, judge every mark on them against `referenced` and this pass's `listed`
+/// fleet, and act — metadata-only decisions first, the continuation next, destruction last.
+/// Returns whether any fragment bytes were deleted.
+pub(crate) async fn walk(
+    ctx: &GcContext<'_>,
