+                .mark(&key, &value, &mut walk, &mut plan, &mut retiring)
+                .await?;
+        }
+        match next {
+            Some(cursor) => walk.after = Some(cursor),
+            None => {
+                wrapped = true;
+                break;
+            }
+        }
+    }
