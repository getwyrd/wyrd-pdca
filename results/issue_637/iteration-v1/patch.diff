+// ===========================================================================
+// 11. The restore-fence generation — the `restore:fence` VALUE (`0016:723-728`)
+// ===========================================================================
+
+/// The singleton key of the **restore-fence generation** record ([`RestoreFence`]). Disjoint
+/// from every other prefix in the store (`repair:`, `retire:` and it part at their third byte),
+/// and never a prefix of one.
+pub const RESTORE_FENCE_KEY: &[u8] = b"restore:fence";
+
+/// The **restore-fence generation**: which post-restore pass this is, and whether that pass has
+/// fenced every session the restored image resurrected (D-B; `0016:723-728`).
+///
+/// A restore rewinds the store to an image whose staged bytes may be gone, so no session
+/// resurrected in it may Complete — and "the restore fence generation MUST complete before any
+/// gateway serves multipart verbs on the restored image" (`0016:723-728`, X17/X17b). This is the
+/// one durable, authoritative record a gateway reads to know that, without inferring anything:
+///
+/// * **absent** — no post-restore pass has ever run against this store;
+/// * **`complete: false`** — a pass of this `generation` has started and has **not** fenced every
+///   resurrected session: it is running, it died, or it met a session it could not fence;
+/// * **`complete: true`** — the pass of this `generation` fenced every one.
+///
+/// The generation advances by one at the start of every post-restore pass, so a later restore
+/// **invalidates** an earlier completion the instant it begins rather than being masked by it.
+/// What a gateway does with each answer is #508's; this record only has to leave nothing to
+/// infer.
+///
+/// Its only writer is the post-restore pass (`wyrd_custodian::reconcile_after_restore`), which
+/// moves it with exact-bytes compare-and-sets, so two passes racing one store cannot both claim
+/// one generation. Serialization identity holds as for every record here: both fields are
+/// required and the shape is closed, and [`decode_restore_fence`] accepts only the encoder's own
+/// spelling.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct RestoreFence {
+    generation: u64,
+    complete: bool,
+}
+
+impl RestoreFence {
+    /// A pass of `generation` that has started and not yet fenced every resurrected session.
+    pub const fn in_progress(generation: u64) -> Self {
+        Self {
+            generation,
+            complete: false,
+        }
+    }
+
+    /// The pass of `generation`, having fenced every resurrected session.
+    pub const fn completed(generation: u64) -> Self {
+        Self {
+            generation,
+            complete: true,
+        }
+    }
+
+    /// Which post-restore pass this record belongs to.
+    pub const fn generation(&self) -> u64 {
+        self.generation
+    }
+
+    /// Whether that pass fenced every session the restored image resurrected.
+    pub const fn is_complete(&self) -> bool {
+        self.complete
+    }
+}
+
+/// Decode the `restore:fence` value ([`RESTORE_FENCE_KEY`]), accepting only this codec's own
+/// spelling of it — the peer of [`decode_session_record`] for this record, and necessary for the
+/// same reason: its writer CASes it on its exact bytes.
+pub fn decode_restore_fence(value: &[u8]) -> Result<RestoreFence, RecordError> {
+    let fence: RestoreFence =
+        metadata::decode(value).map_err(|err| RecordError::MalformedRecordValue {
+            namespace: "restore:fence",
+            detail: err.to_string(),
+        })?;
+    require_canonical(fence, value, "restore:fence")
+}
