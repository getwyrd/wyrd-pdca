+                .put(IDENTITY_CLEANUP_KEY, now_millis.to_string().into_bytes());
+            // A `Conflict` means another pass completed the same cleanup first: open either way.
+            ctx.meta.commit(marker).await?;
+            gate_open = true;
+            emit_identity_cleanup_complete();
+        }
+        emit_sweep_completed(walk.clean);
+        walk = Walk::start();
+    }
+    if !gate_open {
+        // Held back by the gate: these are waiting too, and count toward how far behind it is.
+        for seen in &plan.reclaim {
+            let stamp = seen.mark.orphaned_at_millis();
+            plan.oldest_waiting = Some(plan.oldest_waiting.map_or(stamp, |o| o.min(stamp)));
+        }
+    }
+    emit_walk(pages, gate_open, &plan, now_millis);
+
+    // The continuation is durable BEFORE anything is destroyed, so a delete that fails below
+    // never holds the walk back and the tail cannot starve behind it; the marks it concerned are
+    // still in the ledger, and a later sweep meets them again.
+    if walk != prior || !stored_readable {
+        let batch = match stored {
+            Some(value) => WriteBatch::new().require(WALK_KEY, value),
+            None => WriteBatch::new().require_absent(WALK_KEY),
+        };
+        // A `Conflict` means another pass moved the walk first: the next pass reads its value.
+        ctx.meta.commit(batch.put(WALK_KEY, walk.encode())).await?;
+    }
+
+    let mut changed = false;
+    if gate_open {
+        changed |= reclaim(ctx, &plan.reclaim).await?;
+    } else {
+        for seen in &plan.reclaim {
+            emit_skip(seen.dserver, seen.frag, "identity-migration");
+        }
+    }
+    changed |= resume(ctx, listed, &plan.resume).await?;
+    Ok(changed)
+}
+
+/// The judgement of one mark, with what it is judged against.
+struct Judge<'a> {
+    ctx: &'a GcContext<'a>,
+    referenced: &'a ReferenceSet,
+    listed: &'a HashMap<DServerId, HashSet<FragmentId>>,
+    now_millis: u64,
+}
+
+impl Judge<'_> {
+    async fn mark(
+        &self,
+        key: &[u8],
+        value: &[u8],
+        walk: &mut Walk,
+        plan: &mut Plan,
+        retiring: &mut HashMap<Vec<u8>, bool>,
+    ) -> Result<()> {
+        let Some((dserver, frag)) = parse_orphan_key(key) else {
+            // A key under the ledger that names no position: nothing can act on it.
+            emit_unparsable_key(key);
+            return Ok(());
+        };
+        let mark = match decode_orphan_mark(value) {
+            Ok(mark) => mark,
+            Err(fault) => {
+                // Fail CLOSED: left exactly as it is, and named (ADR-0045 decision 3).
+                emit_undecodable(key, &fault.to_string());
+                return Ok(());
+            }
+        };
+        let stamp = mark.orphaned_at_millis();
+        let seen = Seen {
+            dserver,
+            frag,
+            key: key.to_vec(),
+            value: value.to_vec(),
+            mark,
+        };
+        let protection = self.referenced.protection(dserver, frag);
+
+        if seen.mark.is_reclaiming() {
+            // Reclamation already decided: resume it — unless a reference now names the
+            // fragment, which the safety gate outranks whatever the ledger says.
+            if let Some(reason) = protection {
+                emit_protected_reclaim(&seen, reason);
+            } else if self.listed.contains_key(&dserver) {
+                plan.resume.push(seen);
+            }
+            return Ok(());
+        }
+
+        if self.referenced.definitely_references(dserver, frag) {
+            // Evidence over a fragment a live reference still names. A legacy mark written
+            // before this pass began is stale: dropped once its own grace has lapsed, and until
+            // then it keeps this sweep from counting as the completed identity cleanup. A mark
+            // written since the pass began may be a concurrent unreference's fresh evidence. A
+            // structured mark is not the stale population either (`0016:1249-1257`): only legacy
+            // writers leave a mark over a fragment that stays referenced (the unlink and overwrite
+            // batches, the post-restore pass, a custodian older than this one); a structured mark
+            // names an event of this protocol — a move, whose own CAS consumes its pre-mark, or a
+            // retirement, whose drain marks the bytes before it deletes the records naming them —
+            // and is left to that event.
+            if matches!(seen.mark, OrphanMark::Legacy { .. }) && stamp < self.now_millis {
+                if self.now_millis >= stamp.saturating_add(self.ctx.grace_window_millis) {
+                    plan.stale.push(seen);
+                } else {
+                    walk.clean = false;
+                }
+            }
+            return Ok(());
+        }
+        if protection.is_some() {
+            // A blanket rule (a malformed placement, an incomplete set) holds it: kept.
+            return Ok(());
+        }
+
+        // Unreferenced. A retirement still draining protects what it names — one keyed read per
+        // event, never an expansion of the obligation.
+        if let Some(obligation) = seen.mark.event().and_then(MarkEvent::retirement_key) {
+            let pending = match retiring.get(&obligation) {
+                Some(&pending) => pending,
+                None => {
+                    let pending = self.ctx.meta.get(&obligation).await?.is_some();
+                    retiring.insert(obligation, pending);
+                    pending
+                }
+            };
+            if pending {
+                emit_skip(dserver, frag, "retirement-pending");
+                return Ok(());
+            }
+        }
+
+        let Some(on_disk) = self.listed.get(&dserver) else {
+            // A server outside this pass's fleet: nothing about it was observed.
+            return Ok(());
+        };
+        if on_disk.contains(&frag) {
+            if self.now_millis >= stamp.saturating_add(self.ctx.grace_window_millis) {
+                plan.reclaim.push(seen);
+            } else {
+                emit_skip(dserver, frag, "within-grace");
+                plan.oldest_waiting = Some(plan.oldest_waiting.map_or(stamp, |o| o.min(stamp)));
+            }
+        } else if self.now_millis >= stamp.saturating_add(LATE_WRITE_DEADLINE_MILLIS) {
+            // Fragment-less, and its absence observed by THIS pass's listing, taken past the
+            // deadline: no write authorized against the mark can still land there.
+            plan.sweep.push(seen);
+        }
+        Ok(())
+    }
+}
+
+/// Delete each `(key, expected)` under `require(key == expected)`, in bounded batches; a batch
+/// that loses falls back to one key at a time, so one mark that changed under the pass costs only
+/// itself. Returns the indices of the pairs actually removed.
+async fn remove(meta: &dyn MetadataStore, pairs: &[(&[u8], &[u8])]) -> Result<Vec<usize>> {
+    let mut removed = Vec::new();
+    for (base, batch) in pairs
+        .chunks(MUTATION_BATCH)
+        .enumerate()
+        .map(|(n, batch)| (n * MUTATION_BATCH, batch))
+    {
+        let whole = batch
+            .iter()
+            .fold(WriteBatch::new(), |acc, &(key, expected)| {
+                acc.require(key.to_vec(), expected.to_vec())
+                    .delete(key.to_vec())
+            });
+        if meta.commit(whole).await? == CommitOutcome::Committed {
+            removed.extend(base..base + batch.len());
+            continue;
+        }
+        for (offset, &(key, expected)) in batch.iter().enumerate() {
+            let one = WriteBatch::new()
+                .require(key.to_vec(), expected.to_vec())
+                .delete(key.to_vec());
+            if meta.commit(one).await? == CommitOutcome::Committed {
+                removed.push(base + offset);
+            }
+        }
+    }
+    Ok(removed)
+}
+
+/// The `(key, bytes read)` pair every mutation of a mark CASes on.
+fn read_pairs(marks: &[Seen]) -> Vec<(&[u8], &[u8])> {
+    marks
+        .iter()
+        .map(|seen| (seen.key.as_slice(), seen.value.as_slice()))
+        .collect()
+}
+
+/// Reclaim `candidates`: the intent first — each mark CASed to `reclaiming` and committed — then
+/// the bytes, then the keys. A mark that changed under the pass keeps its fragment this pass.
+async fn reclaim(ctx: &GcContext<'_>, candidates: &[Seen]) -> Result<bool> {
+    let stores: HashMap<DServerId, &dyn ChunkStore> = ctx.fleet.iter().copied().collect();
+    let mut changed = false;
+    for batch in candidates.chunks(MUTATION_BATCH) {
+        let intents: Vec<Vec<u8>> = batch
+            .iter()
+            .map(|seen| seen.mark.reclaiming().encode().to_vec())
+            .collect();
+        // 1. THE INTENT, committed before a single byte is destroyed.
+        let whole = batch
+            .iter()
+            .zip(&intents)
+            .fold(WriteBatch::new(), |acc, (seen, intent)| {
+                acc.require(seen.key.clone(), seen.value.clone())
+                    .put(seen.key.clone(), intent.clone())
+            });
+        let decided: Vec<(&Seen, &Vec<u8>)> =
+            if ctx.meta.commit(whole).await? == CommitOutcome::Committed {
+                batch.iter().zip(&intents).collect()
+            } else {
+                let mut decided = Vec::new();
+                for (seen, intent) in batch.iter().zip(&intents) {
+                    let one = WriteBatch::new()
+                        .require(seen.key.clone(), seen.value.clone())
+                        .put(seen.key.clone(), intent.clone());
+                    if ctx.meta.commit(one).await? == CommitOutcome::Committed {
+                        decided.push((seen, intent));
+                    }
+                }
+                decided
+            };
+        // 2. The bytes.
+        for (seen, _) in &decided {
+            if let Some(store) = stores.get(&seen.dserver) {
+                store.delete_fragment(seen.frag).await?;
+                emit_reclaim(seen.dserver, seen.frag, "orphan");
+                changed = true;
+            }
+        }
+        // 3. The keys, each over the intent it now holds. One that moved under the pass stays,
+        //    and the next pass that reads it finishes it.
+        let retire: Vec<(&[u8], &[u8])> = decided
+            .iter()
+            .map(|(seen, intent)| (seen.key.as_slice(), intent.as_slice()))
+            .collect();
+        remove(ctx.meta, &retire).await?;
+    }
+    Ok(changed)
+}
+
+/// Resume each `reclaiming` mark: delete its fragment if this pass's listing still shows it, then
+/// its key. A delete already landed before the crash is not issued again.
+async fn resume(
+    ctx: &GcContext<'_>,
+    listed: &HashMap<DServerId, HashSet<FragmentId>>,
+    marks: &[Seen],
+) -> Result<bool> {
+    let stores: HashMap<DServerId, &dyn ChunkStore> = ctx.fleet.iter().copied().collect();
+    let mut changed = false;
+    for seen in marks {
+        let on_disk = listed
+            .get(&seen.dserver)
+            .is_some_and(|frags| frags.contains(&seen.frag));
+        if on_disk {
+            if let Some(store) = stores.get(&seen.dserver) {
+                store.delete_fragment(seen.frag).await?;
+                emit_reclaim(seen.dserver, seen.frag, "orphan-resumed");
+                changed = true;
+            }
+        }
+    }
+    remove(ctx.meta, &read_pairs(marks)).await?;
+    Ok(changed)
+}
+
+// ---- the durability seam ----
+
+/// The walk's progress, every pass (ADR-0011): the pages it read, whether identity-keyed
+/// retirement is enabled, and the age of the oldest mark it left waiting — the signal that the
+/// walk is falling behind (`0016:2929-2938`).
+fn emit_walk(pages: usize, gate_open: bool, plan: &Plan, now_millis: u64) {
+    tracing::info!(histogram.gc_orphan_pages_walked = pages as u64);
+    tracing::info!(gauge.gc_orphan_identity_gate_open = u64::from(gate_open));
+    let oldest = plan
+        .oldest_waiting
+        .map_or(0, |stamp| now_millis.saturating_sub(stamp));
+    tracing::info!(gauge.gc_orphan_oldest_waiting_millis = oldest);
+}
+
+/// One sweep of the whole ledger completed: the walk starts the next from the beginning. Counted,
+/// with whether it was clean, so the cadence of full sweeps is readable off the seam.
+fn emit_sweep_completed(clean: bool) {
+    tracing::info!(monotonic_counter.gc_orphan_sweeps_completed = 1_u64, clean);
+}
+
+fn emit_identity_cleanup_complete() {
+    tracing::info!(
+        target: "wyrd.custodian.gc.audit",
+        action = "orphan-identity-cleanup-complete",
+        "a clean sweep of the whole orphan ledger found no stale mark left on a live fragment; identity-keyed retirement is enabled",
+    );
+}
+
+fn emit_dropped(seen: &Seen) {
+    tracing::info!(monotonic_counter.gc_stale_marks_dropped = 1_u64);
+    tracing::info!(
+        target: "wyrd.custodian.gc.audit",
+        action = "stale-mark-dropped",
+        dserver = seen.dserver,
+        chunk = %wyrd_traits::chunk_hex(seen.frag.chunk),
+        index = seen.frag.index,
+        "gc dropped a lapsed legacy orphan mark over a fragment a live reference still names — stale evidence an older build left",
+    );
+}
+
+fn emit_swept(seen: &Seen) {
+    tracing::info!(monotonic_counter.gc_fragment_less_marks_swept = 1_u64);
+    tracing::info!(
+        target: "wyrd.custodian.gc.audit",
+        action = "fragment-less-mark-swept",
+        dserver = seen.dserver,
+        chunk = %wyrd_traits::chunk_hex(seen.frag.chunk),
+        index = seen.frag.index,
+        "gc deleted an orphan mark whose position no fragment occupies, its absence observed past the late-write deadline",
+    );
+}
+
+/// An `orphan:` value that decodes as none of its three shapes (ADR-0045 decision 3): left
+/// exactly as it is — rewriting corrupt metadata is the one thing a maintenance loop may never
+/// do — and named here, every pass that reads it, until a human repairs it.
+fn emit_undecodable(key: &[u8], fault: &str) {
+    tracing::warn!(monotonic_counter.gc_undecodable_orphan_marks = 1_u64);
+    tracing::warn!(
+        target: "wyrd.custodian.gc.audit",
+        action = "undecodable-orphan-mark",
+        entry = %object_name(key),
+        fault = %fault,
+        "gc could not decode an orphan mark; it reclaims nothing on it and leaves it exactly as it is — operator signal",
+    );
+}
+
+fn emit_unparsable_key(key: &[u8]) {
+    tracing::warn!(monotonic_counter.gc_unparsable_orphan_keys = 1_u64);
+    tracing::warn!(
+        target: "wyrd.custodian.gc.audit",
+        action = "unparsable-orphan-key",
+        entry = %object_name(key),
+        "gc met a key under the orphan ledger that names no fragment position; it is left in place — operator signal",
+    );
+}
+
+fn emit_unreadable_walk(value: &[u8]) {
+    tracing::warn!(
+        target: "wyrd.custodian.gc.audit",
+        action = "unreadable-orphan-walk",
+        value = %object_name(value),
+        "gc could not read its own orphan-ledger continuation; the walk restarts from the beginning of the ledger",
+    );
+}
+
+/// A `reclaiming` mark over a fragment a reference now protects. Never deleted: the safety gate
+/// outranks the ledger. Reachable only through a store the ledger and the references disagree
+/// about — a human looks.
+fn emit_protected_reclaim(seen: &Seen, reason: &str) {
+    tracing::warn!(monotonic_counter.gc_reclaiming_marks_on_protected_fragments = 1_u64);
+    tracing::warn!(
+        target: "wyrd.custodian.gc.audit",
+        action = "reclaiming-mark-on-protected-fragment",
+        reason,
+        dserver = seen.dserver,
+        chunk = %wyrd_traits::chunk_hex(seen.frag.chunk),
+        index = seen.frag.index,
+        "gc found a reclamation already decided over a fragment a reference now protects; it deletes nothing — operator signal",
+    );
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    /// The continuation round-trips, and a value `encode` could not have written restarts the
+    /// walk rather than being trusted.
+    #[test]
+    fn the_continuation_round_trips_and_refuses_what_it_did_not_write() {
+        for walk in [
+            Walk::start(),
+            Walk {
+                after: Some(b"orphan:3:17:2".to_vec()),
+                clean: false,
+            },
+        ] {
+            assert_eq!(Walk::decode(&walk.encode()), Some(walk));
+        }
+        for bad in [b"".as_slice(), b"x", b"cinode:1", b"dorphan"] {
+            assert_eq!(Walk::decode(bad), None, "{bad:?}");
+        }
+    }
+
+    /// The late-write deadline stays strictly inside the grace window the deployed pass is given
+    /// (`0016:1478-1479`): `G_orphan > W_repoint + W_write + δ_clock`.
+    #[test]
+    fn the_late_write_deadline_stays_inside_the_deployed_grace_window() {
+        const DEPLOYED_GRACE_MILLIS: u64 = 60_000;
+        const { assert!(LATE_WRITE_DEADLINE_MILLIS < DEPLOYED_GRACE_MILLIS) };
+    }
+}
