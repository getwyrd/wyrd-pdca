+        digest_hex()
+    ));
+    multipart::decode_part_record(&part).expect("fixture: a canonical part record");
+    let summary = Bytes::from(format!(
+        r#"{{"chunks":{},"len":{len},"digest":"{}","committed_at_millis":1500}}"#,
+        chunks.len(),
+        digest_hex()
+    ));
+    multipart::decode_part_summary(&summary).expect("fixture: a canonical part summary");
+    (part, summary)
+}
