+    if fdb {
+        checks.push(vec![
+            "check",
+            "-p",
+            "wyrd-metadata-fdb",
+            "--features",
+            "fdb",
+            "--tests",
+        ]);
+        checks.push(vec![
+            "check",
+            "-p",
+            "wyrd-server",
+            "--features",
+            "fdb",
+            "--tests",
+        ]);
+    }
+    checks
+}
