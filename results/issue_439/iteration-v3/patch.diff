+#[test]
+fn the_fdb_conformance_workflow_executes_only_real_subcommands() {
+    let workflow = read(WORKFLOW);
+    let main_rs = read("xtask/src/main.rs");
+
+    let subs = xtask_subcommands(&run_script_lines(&workflow));
+    assert!(
+        subs.contains(&"fdb-conformance".to_string()),
+        "the workflow must actually RUN `cargo xtask fdb-conformance` — that is the whole \
+         job (gap 1 of #439). Executed: {subs:?}"
+    );
+
+    // The doc↔dispatch contract: the workflow cannot execute a command `cargo xtask` does
+    // not have. `run_*` arms are matched on the literal `Some("<sub>")` of `main`'s
+    // dispatch table (the `readme_dev_section.rs` pattern).
+    for sub in &subs {
+        assert!(
+            main_rs.contains(&format!("Some(\"{sub}\")")),
+            "{WORKFLOW} runs `cargo xtask {sub}`, which xtask/src/main.rs does not dispatch"
+        );
+    }
+
+    // The doctor is a real subcommand, and it is offered in the usage line so
+    // `cargo xtask` discloses it.
+    assert!(
+        main_rs.contains("Some(\"fdb-doctor\")"),
+        "xtask/src/main.rs does not dispatch the `fdb-doctor` preflight"
+    );
+    assert!(
+        main_rs.contains("fdb-doctor|"),
+        "`fdb-doctor` is missing from xtask's usage line"
+    );
+
+    // The conformance run is unconditional — it is the job. A `if:` here would silently
+    // reduce the PR leg to a no-op.
+    assert!(
+        !step_running(&workflow, "cargo xtask fdb-conformance").contains("if:"),
+        "the conformance step must run on every trigger, not behind an `if:`"
+    );
