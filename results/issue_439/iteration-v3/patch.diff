+// ─── (4) the workflow exists, and every command it EXECUTES is really dispatched ───────
+
+/// Strip a trailing shell `#` comment from one command line, honouring quotes.
+///
+/// A `#` begins a comment only when it is unquoted **and** at a word boundary (start of
+/// line or preceded by whitespace) — the POSIX shell rule. `echo a#b` keeps its `#`;
+/// `echo a #b` and `echo DISABLED # cargo xtask fdb-conformance` do not. This is the fix
+/// for the iteration-2 hole: a scraper that only dropped lines *starting* with `#` let a
+/// trailing `# cargo xtask fdb-conformance` be tokenised as a real command, so a step that
+/// executed nothing (`run: echo DISABLED # cargo xtask fdb-conformance`) satisfied the
+/// dispatch contract. The returned string is what the shell would actually execute.
+fn strip_shell_comment(line: &str) -> String {
+    let mut kept = String::new();
+    let mut in_single = false;
+    let mut in_double = false;
+    let mut prev_was_boundary = true; // start of line is a word boundary
+    for c in line.chars() {
+        if c == '#' && !in_single && !in_double && prev_was_boundary {
+            break;
+        }
+        match c {
+            '\'' if !in_double => in_single = !in_single,
+            '"' if !in_single => in_double = !in_double,
+            _ => {}
+        }
+        prev_was_boundary = c.is_whitespace();
+        kept.push(c);
+    }
+    kept.trim().to_string()
+}
+
+/// Every shell line a `run:` key actually executes, inline or block, with trailing shell
+/// comments stripped. Comments (YAML `#` lines, whole shell `#` lines, and trailing shell
+/// `#…` on a real line) are excluded — the header prose of a workflow is not a command it
+/// runs, and neither is a `# cargo xtask …` note dangling off an `echo`.
+///
+/// This scoping is the whole point: scraping `cargo xtask <sub>` from the raw file text
+/// would let a workflow that *mentions* the conformance run in a comment satisfy the
+/// dispatch contract while executing nothing. Plain-text parsing, as
+/// `xtask/tests/readme_dev_section.rs` parses the README: `xtask` has no YAML parser, and
+/// adding one would trigger the ADR-0003 §2 dependency audit for a substring check.
+fn run_script_lines(yaml: &str) -> Vec<String> {
+    fn push_command(raw_command: &str, out: &mut Vec<String>) {
+        let command = strip_shell_comment(raw_command);
+        if !command.is_empty() {
+            out.push(command);
+        }
+    }
+
+    let mut out = Vec::new();
+    let mut block_indent: Option<usize> = None;
+
+    for raw in yaml.lines() {
+        let trimmed = raw.trim_start();
+        let indent = raw.len() - trimmed.len();
+
+        if let Some(key_indent) = block_indent {
+            if trimmed.is_empty() {
+                continue;
+            }
+            if indent > key_indent {
+                if !trimmed.starts_with('#') {
+                    push_command(trimmed, &mut out);
+                }
+                continue;
+            }
+            block_indent = None;
+        }
+
+        if trimmed.is_empty() || trimmed.starts_with('#') {
+            continue;
+        }
+        // `run:` may be the step's list-item key (`- run: …`) or a plain mapping key.
+        let (key_indent, key_line) = match trimmed.strip_prefix("- ") {
+            Some(rest) => (indent + 2, rest),
+            None => (indent, trimmed),
+        };
+        let Some(value) = key_line.strip_prefix("run:") else {
+            continue;
+        };
+        let value = value.trim();
+        if value.is_empty() || value.starts_with('|') || value.starts_with('>') {
+            block_indent = Some(key_indent);
+        } else {
+            push_command(value, &mut out);
+        }
+    }
+    out
+}
+
+/// The `cargo xtask <sub>` subcommands the given shell lines invoke, in order.
+fn xtask_subcommands(run_lines: &[String]) -> Vec<String> {
+    let mut subs: Vec<String> = Vec::new();
+    for line in run_lines {
+        let tokens: Vec<&str> = line.split_whitespace().collect();
+        for window in tokens.windows(3) {
+            if window[0] == "cargo" && window[1] == "xtask" {
+                let sub = window[2].trim_matches(|c: char| !c.is_ascii_alphanumeric() && c != '-');
+                if !sub.is_empty() && !subs.iter().any(|s| s == sub) {
+                    subs.push(sub.to_string());
+                }
+            }
+        }
+    }
+    subs
+}
+
+/// The workflow's steps, one string each, comments stripped — so an `if:` in a step is
+/// distinguishable from the word "if" in the prose above it.
+fn steps(yaml: &str) -> Vec<String> {
+    let mut steps: Vec<String> = Vec::new();
+    let mut current: Option<String> = None;
+    for raw in yaml.lines() {
+        let trimmed = raw.trim_start();
+        if trimmed.starts_with('#') {
+            continue;
+        }
+        if trimmed.starts_with("- name:") || trimmed.starts_with("- uses:") {
+            if let Some(step) = current.take() {
+                steps.push(step);
+            }
+            current = Some(String::new());
+        }
+        if let Some(step) = current.as_mut() {
+            step.push_str(raw);
+            step.push('\n');
+        }
+    }
+    steps.extend(current);
+    steps
+}
+
+/// The one step whose script executes `needle`.
+fn step_running(yaml: &str, needle: &str) -> String {
+    let matching: Vec<String> = steps(yaml)
+        .into_iter()
+        .filter(|step| run_script_lines(step).iter().any(|l| l.contains(needle)))
+        .collect();
+    assert_eq!(
+        matching.len(),
+        1,
+        "expected exactly one step whose `run:` script executes `{needle}`, found \
+         {}",
+        matching.len()
+    );
+    matching.into_iter().next().expect("checked non-empty")
+}
+
+#[test]
+fn run_script_scraping_ignores_prose_and_is_red_on_a_workflow_that_runs_nothing() {
+    // The demonstrated red for the scraper itself. This synthetic workflow *mentions*
+    // `cargo xtask fdb-conformance` in a header comment, in a step `name:`, in a full-line
+    // shell comment, AND — the iteration-2 hole — as a TRAILING inline comment dangling
+    // off a real `echo`, both inline and inside a `run: |` block. It executes none of it.
+    // A whole-file substring scrape (the shape this replaced) reports the contract
+    // satisfied; a scrape that only drops lines *starting* with `#` still tokenises the
+    // trailing `# cargo xtask …` as a command; the quote-aware `run:`-scoped scrape reports
+    // nothing executed, which is the truth.
+    const PROSE_ONLY: &str = "\
+# `cargo xtask fdb-conformance` brings the cluster up, and `cargo xtask ci` gates it.
+jobs:
+  fdb-conformance:
+    steps:
+      - name: cargo xtask fdb-conformance
+        uses: actions/checkout@v7
+      - name: Docker info
+        run: docker info
+      - name: disabled (inline trailing comment)
+        run: echo DISABLED # cargo xtask fdb-conformance
+      - name: install
+        run: |
+          # then run `cargo xtask fdb-doctor`
+          set -euo pipefail
+          echo installed # cargo xtask ci
+          curl --fail --output c.deb \"https://example.invalid/c.deb\"
+";
+    let lines = run_script_lines(PROSE_ONLY);
+    assert_eq!(
+        xtask_subcommands(&lines),
+        Vec::<String>::new(),
+        "a workflow that only MENTIONS `cargo xtask …` (including as a trailing `#` comment \
+         on a real command) runs no xtask command: {lines:?}"
+    );
+    // …while the commands it really runs are still seen (the scraper is not simply blind),
+    // and their trailing comments are stripped rather than the whole line dropped.
+    assert!(
+        lines.iter().any(|l| l == "docker info"),
+        "an inline `run:` must be captured: {lines:?}"
+    );
+    assert!(
+        lines.iter().any(|l| l == "echo DISABLED"),
+        "the real command must survive with its trailing `#` comment stripped: {lines:?}"
+    );
+    assert!(
+        lines.iter().any(|l| l == "echo installed"),
+        "a `run: |` block line's trailing `#` comment must be stripped, not the line \
+         dropped: {lines:?}"
+    );
+    assert!(
+        lines.iter().any(|l| l == "set -euo pipefail"),
+        "a `run: |` block's lines must be captured: {lines:?}"
+    );
+    assert!(
+        !lines.iter().any(|l| l.contains('#')),
+        "no captured command may retain a `#` comment: {lines:?}"
+    );
+}
+
+#[test]
+fn strip_shell_comment_honours_quotes_and_word_boundaries() {
+    // The predicate the scraper leans on. A `#` opens a comment only when it is unquoted
+    // AND at a word boundary — the POSIX shell rule — so a real command's arguments that
+    // legitimately contain `#` survive, while a dangling `# cargo xtask …` note is removed.
+    assert_eq!(
+        strip_shell_comment("echo DISABLED # cargo xtask ci"),
+        "echo DISABLED"
+    );
+    assert_eq!(
+        strip_shell_comment("cargo xtask ci # trailing"),
+        "cargo xtask ci"
+    );
+    // A `#` glued to a word is part of that word, not a comment (`foo#bar`, an URL anchor).
+    assert_eq!(strip_shell_comment("echo foo#bar"), "echo foo#bar");
+    assert_eq!(
+        strip_shell_comment("curl \"https://host/p#frag\""),
+        "curl \"https://host/p#frag\""
+    );
+    // A `#` inside quotes is data, even at a word boundary.
+    assert_eq!(
+        strip_shell_comment("echo '# not a comment'"),
+        "echo '# not a comment'"
+    );
+    assert_eq!(strip_shell_comment("echo \"a # b\""), "echo \"a # b\"");
+    // A whole-line comment collapses to nothing.
+    assert_eq!(strip_shell_comment("# just a note"), "");
+}
