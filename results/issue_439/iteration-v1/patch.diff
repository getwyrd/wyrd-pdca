new file mode 100644
index 0000000..a2a7457
--- /dev/null
+++ b/.github/workflows/fdb-conformance.yml
@@ -0,0 +1,141 @@
+name: fdb-conformance
+
+# **FoundationDB conformance tier** (ADR-0042, issues #438 / #439): the standing
+# automated signal for the *chosen production metadata backend*.
+#
+# `cargo xtask fdb-conformance` (added by #438) brings up the throwaway single-node
+# `fdbserver` under `deploy/fdb-single-node/`, creates the database, and drives the shared
+# `MetadataStore` conformance suite plus the driver-level contention/scan/timeout
+# properties against it (`cargo test -p wyrd-metadata-fdb --features fdb`). Until this
+# job existed nothing invoked that subcommand: the `fdb` backend had zero automated
+# coverage on any PR or nightly and could rot silently (#439).
+#
+# Runs on TWO triggers:
+#   1. **pull_request**, filtered to the paths that can plausibly break it — the backend
+#      crate, the server's backend-selection arms, the compose stack, the xtask driver,
+#      the lockfile, and this file. The filter keeps every unrelated PR off a container
+#      runner.
+#   2. **nightly cron + workflow_dispatch**, mirroring `tier1-jepsen.yml` — post-merge
+#      regression visibility for what the path filter cannot catch (an upstream image
+#      change, a transitive dependency bump).
+#
+# Gating policy (ADR-0016): this is NOT a required merge-gate status check. The
+# `cargo xtask ci` merge gate stays unprivileged and container-free — it neither links
+# `libfdb_c` nor starts a container. This job is the privileged sibling that supplies the
+# live evidence, exactly as `tier1-jepsen.yml` and `integration-nightly.yml` do for theirs.
+#
+# It deliberately does NOT consume a prebuilt `wyrd:fdb` image (#470): it installs the
+# FoundationDB *client package* on the runner and runs the test harness, so the signal
+# stays fast and un-blocked by an image build.
+#
+# Locally, `cargo xtask fdb-doctor` prints the same three-row environment report this job
+# depends on — a loadable `libfdb_c`, a readable cluster file, a healthy cluster — each
+# failing row carrying its remediation. `cargo xtask fdb-conformance` runs the
+# client-library row of it as a fail-fast preflight, so a missing client package is an
+# actionable message rather than a linker error.
+
+on:
+  pull_request:
+    paths:
+      # The backend itself, and the server arms that select it.
+      - "crates/metadata-fdb/**"
+      - "crates/server/**"
+      # The throwaway cluster and the driver that stands it up.
+      - "deploy/fdb-single-node/**"
+      - "xtask/**"
+      - ".github/workflows/fdb-conformance.yml"
+      # A dependency bump can move the `foundationdb` crate or its API version.
+      - "Cargo.lock"
+  schedule:
+    # 06:00 UTC daily — after tier1-jepsen (02:00), tier1-disk-faults (03:00),
+    # integration-nightly (04:00) and tier2-kill-reconstruct (05:00), so the container
+    # jobs never contend for a runner.
+    - cron: "0 6 * * *"
+  workflow_dispatch: {}
+
+permissions:
+  contents: read
+
+concurrency:
+  group: fdb-conformance-${{ github.ref }}
+  cancel-in-progress: true
+
+jobs:
+  fdb-conformance:
+    runs-on: ubuntu-latest
+    # Cold Rust build + image pull + cluster bring-up + the five `--features fdb` test
+    # legs fit well under this, and on the nightly leg the whole `cargo xtask ci` gate as
+    # well. The bound stops a hung `fdbcli` drifting toward GitHub's 6h default (#150).
+    timeout-minutes: 60
+    env:
+      CI: "true"
+      # Pinned to the server image `deploy/fdb-single-node/docker-compose.yml` runs and to
+      # the crate's `fdb-7_3` API feature (root Cargo.toml). A client library from a
+      # different version never connects, so this pin is load-bearing, not cosmetic. It is
+      # also `xtask::fdb_doctor::FDB_VERSION`, which `xtask/tests/fdb_harness.rs` asserts
+      # equal to both of the above.
+      FDB_VERSION: "7.3.77"
+      # Opt the two `--features fdb` type-checks (`xtask::feature_gated_checks`) into the
+      # `cargo xtask ci` step below. Gated SEPARATELY from `WYRD_TIKV_TOOLCHAIN`: the two
+      # backends need different privileged toolchains and must never imply one another.
+      # This runner is the only one that installs `libfdb_c`, so it is the only place
+      # those checks can compile.
+      WYRD_FDB_TOOLCHAIN: "1"
+    steps:
+      - uses: actions/checkout@v7
+
+      - name: Install Rust toolchain
+        run: rustup show active-toolchain || rustup toolchain install
+
+      - name: Cache cargo build
+        uses: Swatinem/rust-cache@v2
+
+      # ubuntu-latest ships Docker with the compose plugin; this confirms the daemon is
+      # reachable (the same step integration-nightly.yml and tier1-jepsen.yml use).
+      # `cargo xtask fdb-conformance` re-checks it and hard-fails when CI=true.
+      - name: Docker info
+        run: docker info
+
+      # The `fdb` feature is a binding over the FoundationDB C client: `libfdb_c` must be
+      # present at BUILD time or the link fails. `fdbcli`, from the same package, backs
+      # the doctor's cluster-health probe.
+      - name: Install the FoundationDB client package
+        run: |
+          set -euo pipefail
+          curl --fail --location --silent --show-error \
+            --output foundationdb-clients.deb \
+            "https://github.com/apple/foundationdb/releases/download/${FDB_VERSION}/foundationdb-clients_${FDB_VERSION}-1_amd64.deb"
+          sudo dpkg --install foundationdb-clients.deb
+          rm -f foundationdb-clients.deb
+          fdbcli --version
+
+      # Brings up deploy/fdb-single-node, runs `configure new single memory`, writes the
+      # host-side cluster file, drives the five `--features fdb` test legs, and tears the
+      # stack down unconditionally. Its own preflight fails fast if the step above did not
+      # put libfdb_c where the linker looks.
+      - name: cargo xtask fdb-conformance
+        run: cargo xtask fdb-conformance
+
+      # The whole gate, with WYRD_FDB_TOOLCHAIN set — which is what makes
+      # `xtask::feature_gated_checks` emit `cargo check -p wyrd-metadata-fdb --features
+      # fdb --tests` and `cargo check -p wyrd-server --features fdb --tests`. Those two
+      # rows type-check the `#[cfg(feature = "fdb")]` store module and the server's
+      # backend-selection arms, which NO default-feature build ever compiles. Restricted
+      # to the nightly/dispatch legs: on a pull request `ci.yml` already runs this gate
+      # (minus the fdb rows) and the step above already compiles metadata-fdb with the
+      # feature on, so running it here too would duplicate ~15 minutes of CI per PR to
+      # type-check the server arms alone. Nightly catches those.
+      - name: cargo xtask ci (fdb feature type-checks opted in)
+        if: github.event_name != 'pull_request'
+        run: cargo xtask ci
+
+      # Surface the failure diagnostics before they are lost (#150): the host-side cluster
+      # file and anything the run wrote under target/fdb-single-node/.
+      - name: Upload FoundationDB diagnostics
+        if: failure()
+        uses: actions/upload-artifact@v7
+        with:
+          name: fdb-conformance-logs
+          path: target/fdb-single-node/
+          if-no-files-found: ignore
+          retention-days: 14
diff --git a/deny.toml b/deny.toml
index b6f2377..ad2e5ec 100644
--- a/deny.toml
+++ b/deny.toml
@@ -3,6 +3,28 @@
 # "paywall" licenses (BSL/SSPL), plus the RUSTSEC advisory database. A
 # contribution that pulls in a disqualified license or a vulnerable crate fails
 # `cargo deny check` in CI.
+#
+# AUDIT POLICY — what this file can and cannot see (ADR-0042, issue #439).
+# `cargo deny` / `cargo audit` traverse the **Rust dependency graph** recorded in
+# Cargo.lock. For the FoundationDB metadata backend that graph is
+# `foundationdb -> foundationdb-sys -> (build) bindgen -> clang-sys -> libloading`,
+# and it IS audited here — the ISC allowlist entry below exists precisely because
+# `cargo deny check` (run by `cargo xtask ci`, xtask/src/main.rs) walks it even
+# though the `fdb` feature is off by default.
+#
+# What neither tool can see is **`libfdb_c` itself**: the FoundationDB C client is
+# a system shared object installed from an upstream .deb/.rpm, linked at build
+# time by `foundationdb-sys`. It appears in no lockfile, has no crates.io version,
+# and carries no RUSTSEC advisories. Its advisory surface is therefore tracked
+# OUT of band, by following upstream FoundationDB release notes and security
+# announcements (https://github.com/apple/foundationdb/releases) and bumping the
+# pinned version in lockstep across the three places that name it:
+# `deploy/fdb-single-node/docker-compose.yml` (server image),
+# `.github/workflows/fdb-conformance.yml` (client package), and
+# `xtask::fdb_doctor::FDB_VERSION` (which xtask/tests/fdb_harness.rs asserts
+# equal to the other two, so a partial bump fails the gate). The same split
+# applies to any future backend whose Rust crate is a binding over a system
+# library; it is a property of the tooling, not of this dependency.
 
 [advisories]
 # Fail on any RUSTSEC advisory for a crate in the dependency graph.
diff --git a/xtask/src/fdb_doctor.rs b/xtask/src/fdb_doctor.rs
new file mode 100644
index 0000000..49d81e8
--- /dev/null
+++ b/xtask/src/fdb_doctor.rs
@@ -0,0 +1,285 @@
+//! FoundationDB environment doctor (issue #439): map each environment probe's
+//! outcome to a **verdict + an actionable remediation**, so a developer or a CI job
+//! with no `libfdb_c`, no cluster file, or a dead container gets a sentence telling
+//! them what to install or run — never a raw linker error or a transaction timeout.
+//!
+//! Exposed as a **library** module (the same seam `deploy_guard` uses, `lib.rs:1-19`)
+//! and kept **pure**: the probes' *results* are inputs, so every row and every
+//! remediation string is unit-testable on a machine with no FoundationDB, no Docker,
+//! and no `fdbcli` (`xtask/tests/fdb_harness.rs`). `main.rs` owns the impure half —
+//! stat the library paths, read the cluster file, spawn `fdbcli` — and hands the
+//! outcomes here. That split is what keeps the binding criterion container-free while
+//! still driving the production decision logic: `run_fdb_doctor` (the `cargo xtask
+//! fdb-doctor` arm) and `run_fdb_conformance`'s preflight call the SAME [`diagnose`]
+//! the planted-red test drives — one doctor, two call sites, exactly as
+//! `deploy_guard::scan_dir` is one guard with two call sites.
+//!
+//! The three rows are the ones the issue names:
+//!
+//! 1. **client library** — is `libfdb_c` present and loadable? The `fdb` feature links
+//!    it at *build* time (`crates/metadata-fdb/Cargo.toml`), so its absence is a linker
+//!    error deep inside `cargo test`, not a runtime message.
+//! 2. **cluster file** — is the file named by `WYRD_FDB_CLUSTER_FILE`
+//!    (`crates/metadata-fdb/src/lib.rs:386`), or its `/etc/foundationdb/fdb.cluster`
+//!    default (`:390`), readable and non-empty?
+//! 3. **cluster health** — does `fdbcli --exec "status minimal"` report the database
+//!    available? A cluster that is up but *unconfigured* reports `configuration
+//!    missing` and every transaction blocks until its deadline.
+
+use std::fmt::Write as _;
+
+/// The FoundationDB version this repo is pinned to, in exactly one place per artifact:
+/// the compose image (`deploy/fdb-single-node/docker-compose.yml:22`) and the crate's
+/// `fdb-7_3` API feature (root `Cargo.toml:108`). A client library from a different
+/// major/minor never connects, so the remediation names the version, not just the package.
+pub const FDB_VERSION: &str = "7.3.77";
+
+/// The server image the throwaway single-node cluster runs
+/// (`deploy/fdb-single-node/docker-compose.yml:22`).
+pub const FDB_IMAGE: &str = "foundationdb/foundationdb:7.3.77";
+
+/// The upstream package that provides both [`CLIENT_LIBRARY_SONAME`] and `fdbcli`.
+pub const CLIENT_PACKAGE: &str = "foundationdb-clients";
+
+/// The shared object the `foundationdb` crate's `fdb` feature links at build time.
+pub const CLIENT_LIBRARY_SONAME: &str = "libfdb_c.so";
+
+/// Where the upstream packages install [`CLIENT_LIBRARY_SONAME`]. Probed in order; the
+/// dynamic-linker cache (`ldconfig -p`, parsed by [`ldconfig_lists_client_library`]) is
+/// the fallback for a non-standard prefix.
+pub const CLIENT_LIBRARY_CANDIDATES: &[&str] = &[
+    "/usr/lib/libfdb_c.so",
+    "/usr/lib64/libfdb_c.so",
+    "/usr/lib/x86_64-linux-gnu/libfdb_c.so",
+    "/usr/local/lib/libfdb_c.so",
+    "/lib/libfdb_c.so",
+];
+
+/// The environment variable naming the cluster file. Mirrors
+/// `wyrd_metadata_fdb::config::CLUSTER_FILE_ENV` (`crates/metadata-fdb/src/lib.rs:386`)
+/// — duplicated as a literal rather than imported, because `xtask` must not depend on
+/// `wyrd-metadata-fdb` (its `fdb` feature would drag `libfdb_c` into the gate's build
+/// graph, and a new Cargo dependency is an ADR-0003 §2 decision). The duplication is
+/// pinned by a drift assertion in `xtask/tests/fdb_harness.rs`.
+pub const CLUSTER_FILE_ENV: &str = "WYRD_FDB_CLUSTER_FILE";
+
+/// Where FoundationDB's own packages install the cluster file; used when
+/// [`CLUSTER_FILE_ENV`] is unset or blank. Mirrors
+/// `wyrd_metadata_fdb::config::DEFAULT_CLUSTER_FILE` (`crates/metadata-fdb/src/lib.rs:390`).
+pub const DEFAULT_CLUSTER_FILE: &str = "/etc/foundationdb/fdb.cluster";
+
+/// The throwaway single-node compose stack (#438), relative to the workspace root.
+pub const COMPOSE_FILE: &str = "deploy/fdb-single-node/docker-compose.yml";
+
+/// The one command that brings [`COMPOSE_FILE`]'s cluster up.
+pub const CLUSTER_BRINGUP_COMMAND: &str =
+    "docker compose -f deploy/fdb-single-node/docker-compose.yml up -d";
+
+/// The health probe itself, quoted back to the operator so they can re-run it by hand.
+pub const HEALTH_COMMAND: &str = "fdbcli --exec \"status minimal\"";
+
+/// What `status minimal` prints when the database is usable. Deliberately includes
+/// `database is` so it cannot match `The database is unavailable` (which *contains* the
+/// substring "available").
+const HEALTHY_STATUS_NEEDLE: &str = "database is available";
+
+/// The three environment probes the doctor reports on.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Probe {
+    /// `libfdb_c` present and loadable.
+    ClientLibrary,
+    /// The cluster file readable and non-empty.
+    ClusterFile,
+    /// `fdbcli --exec "status minimal"` reports the database available.
+    ClusterHealth,
+}
+
+impl Probe {
+    /// The row's short name, as printed.
+    pub fn label(self) -> &'static str {
+        match self {
+            Probe::ClientLibrary => "client library (libfdb_c)",
+            Probe::ClusterFile => "cluster file",
+            Probe::ClusterHealth => "cluster health",
+        }
+    }
+
+    /// What to do when this probe fails. This is the whole point of the module: each
+    /// string names the concrete package, variable, or command that fixes the row.
+    pub fn remediation(self) -> String {
+        match self {
+            Probe::ClientLibrary => format!(
+                "install the FoundationDB client package `{CLIENT_PACKAGE}` at version \
+                 {FDB_VERSION} (matching the pinned server image `{FDB_IMAGE}`): it provides \
+                 `{CLIENT_LIBRARY_SONAME}`, which the `fdb` feature links at BUILD time. \
+                 Packages: https://github.com/apple/foundationdb/releases/tag/{FDB_VERSION}"
+            ),
+            Probe::ClusterFile => format!(
+                "point `{CLUSTER_FILE_ENV}` at a readable cluster file, or install one at the \
+                 `{DEFAULT_CLUSTER_FILE}` default. `cargo xtask fdb-conformance` writes a \
+                 matching one under `target/fdb-single-node/fdb.cluster` once the cluster is up."
+            ),
+            Probe::ClusterHealth => format!(
+                "bring the throwaway single-node cluster up with \
+                 `{CLUSTER_BRINGUP_COMMAND}`, then re-check with `{HEALTH_COMMAND}`. A cluster \
+                 that is running but never had `configure new single memory` applied reports \
+                 `configuration missing` and blocks every transaction. (`fdbcli` ships in the \
+                 `{CLIENT_PACKAGE}` package.)"
+            ),
+        }
+    }
+}
+
+/// One probe's measured result. The *measurement* happens in `main.rs` (it stats files
+/// and spawns `fdbcli`); this type is the pure boundary between that and the verdict.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub enum Outcome {
+    /// The probe passed; the string is the evidence (e.g. the path the library was found at).
+    Ok(String),
+    /// The probe failed; the string is what was observed (e.g. the `fdbcli` error).
+    Failed(String),
+}
+
+impl Outcome {
+    /// A passing outcome carrying its evidence.
+    pub fn ok(detail: impl Into<String>) -> Self {
+        Outcome::Ok(detail.into())
+    }
+
+    /// A failing outcome carrying what was observed.
+    pub fn failed(detail: impl Into<String>) -> Self {
+        Outcome::Failed(detail.into())
+    }
+
+    /// Did the probe pass?
+    pub fn passed(&self) -> bool {
+        matches!(self, Outcome::Ok(_))
+    }
+
+    /// The observed evidence, pass or fail.
+    pub fn detail(&self) -> &str {
+        match self {
+            Outcome::Ok(detail) | Outcome::Failed(detail) => detail,
+        }
+    }
+}
+
+/// One diagnosed row: a probe, what was observed, and — when it failed — how to fix it.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct Row {
+    /// Which environment property was probed.
+    pub probe: Probe,
+    /// What the probe observed.
+    pub outcome: Outcome,
+}
+
+impl Row {
+    /// Did this row pass?
+    pub fn passed(&self) -> bool {
+        self.outcome.passed()
+    }
+
+    /// The remediation text for a failing row (`None` when it passed — nothing to fix).
+    pub fn remediation(&self) -> Option<String> {
+        if self.passed() {
+            None
+        } else {
+            Some(self.probe.remediation())
+        }
+    }
+}
+
+/// The doctor's verdict over a set of probes.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct Report {
+    /// One row per probe, in the order they were supplied.
+    pub rows: Vec<Row>,
+}
+
+impl Report {
+    /// Is the environment ready? Vacuously true for an empty probe set — callers always
+    /// supply the rows they mean to gate on (`run_fdb_conformance`'s preflight supplies
+    /// only [`Probe::ClientLibrary`], because the cluster file and the cluster itself are
+    /// what the job goes on to create).
+    pub fn is_ok(&self) -> bool {
+        self.rows.iter().all(Row::passed)
+    }
+
+    /// The failing rows, in probe order.
+    pub fn failures(&self) -> Vec<&Row> {
+        self.rows.iter().filter(|row| !row.passed()).collect()
+    }
+
+    /// The full report, one row per line, with a `fix:` line under each failure.
+    pub fn render(&self) -> String {
+        let mut out = String::new();
+        for row in &self.rows {
+            let mark = if row.passed() { "ok  " } else { "FAIL" };
+            let _ = writeln!(
+                out,
+                "[{mark}] {}: {}",
+                row.probe.label(),
+                row.outcome.detail()
+            );
+            if let Some(fix) = row.remediation() {
+                let _ = writeln!(out, "       fix: {fix}");
+            }
+        }
+        out
+    }
+
+    /// `Ok(())` when every row passed; otherwise an error naming each failing row and its
+    /// remediation — the message `run_fdb_conformance`'s preflight fails fast with, in
+    /// place of a raw linker error.
+    pub fn into_result(self) -> Result<(), String> {
+        if self.is_ok() {
+            return Ok(());
+        }
+        let mut out = String::from("the FoundationDB environment is not ready:\n");
+        for row in self.failures() {
+            let _ = writeln!(out, "  - {}: {}", row.probe.label(), row.outcome.detail());
+            if let Some(fix) = row.remediation() {
+                let _ = writeln!(out, "    fix: {fix}");
+            }
+        }
+        Err(out.trim_end().to_string())
+    }
+}
+
+/// Turn measured probe outcomes into a report. Pure: no IO, no environment reads.
+pub fn diagnose(probes: Vec<(Probe, Outcome)>) -> Report {
+    Report {
+        rows: probes
+            .into_iter()
+            .map(|(probe, outcome)| Row { probe, outcome })
+            .collect(),
+    }
+}
+
+/// Resolve the cluster-file path from the environment value, falling back to
+/// [`DEFAULT_CLUSTER_FILE`] when it is unset **or blank**. Mirrors the driver's own
+/// resolution (`crates/metadata-fdb/src/lib.rs:384-390`) so the doctor reports on the
+/// same file the driver would open.
+pub fn cluster_file_path(env_value: Option<&str>) -> String {
+    match env_value {
+        Some(value) if !value.trim().is_empty() => value.trim().to_string(),
+        _ => DEFAULT_CLUSTER_FILE.to_string(),
+    }
+}
+
+/// Does `ldconfig -p` output list the FDB client library? The fallback probe for a
+/// client installed outside [`CLIENT_LIBRARY_CANDIDATES`].
+pub fn ldconfig_lists_client_library(ldconfig_output: &str) -> bool {
+    ldconfig_output
+        .lines()
+        .any(|line| line.contains(CLIENT_LIBRARY_SONAME))
+}
+
+/// Does `fdbcli --exec "status minimal"` output say the database is available?
+///
+/// Note the needle: `The database is unavailable` contains the word "available", so a
+/// naive `contains("available")` would report a dead cluster healthy. It does not
+/// contain `database is available`.
+pub fn cluster_status_is_healthy(status_output: &str) -> bool {
+    status_output.to_lowercase().contains(HEALTHY_STATUS_NEEDLE)
+}
diff --git a/xtask/src/lib.rs b/xtask/src/lib.rs
index 55b46d7..4ce68f5 100644
--- a/xtask/src/lib.rs
+++ b/xtask/src/lib.rs
@@ -15,4 +15,78 @@
 
 pub mod deploy_guard;
 pub mod disk_faults;
+pub mod fdb_doctor;
 pub mod metadata_faults;
+
+/// The dedicated `cargo check --features …` runs `run_ci` makes to type-check
+/// feature-gated code the default `--workspace` build never compiles.
+///
+/// `run_ci`'s `build`/`test`/`clippy` all run `--workspace` with **default**
+/// features. `--all-targets` widens the *target kinds* (bins, tests, benches) but
+/// **not the feature set**, so any `#[cfg(feature = "…")]` body that is off by
+/// default is compiled by **none** of those steps — a type error inside it passes
+/// the whole gate silently.
+///
+/// Two backends sit behind such a feature today, and **each carries its own
+/// toolchain gate** (`tikv`, `fdb`), because each needs a *different* privileged
+/// build environment:
+///
+/// * `tikv` — the M4.6 (#257) Tier-1/Tier-2 metadata scenarios
+///   (`crates/metadata-tikv/tests/tier1_metadata_consistency.rs`, `tier2_metadata_io.rs`):
+///   their live bodies (the `SymmetricPartition` fault, its `Drop` heal, the PD-side
+///   fault-effect oracle) sit behind `#[cfg(feature = "tikv")]`. Compiling them means
+///   compiling the pre-1.0 `tikv-client` tree (grpcio/protoc), which the default
+///   container-free / offline `cargo xtask ci` must never touch. Opted in with
+///   `WYRD_TIKV_TOOLCHAIN`.
+/// * `fdb` — the ADR-0042 production metadata backend (#438, #440, #439): the whole
+///   `#[cfg(feature = "fdb")]` `store` module of `crates/metadata-fdb/src/lib.rs` and
+///   every `#[cfg(feature = "fdb")]` backend-selection arm in `crates/server/src/cli.rs`
+///   (`:101`, `:120`, `:168`, `:373`, `:459`, `:714`, `:840`, `:1480`, `:1486`).
+///   Compiling them means linking the system `libfdb_c`, which a plain laptop or PDCA
+///   worktree does not have. Opted in with `WYRD_FDB_TOOLCHAIN` (set by
+///   `.github/workflows/fdb-conformance.yml`, the one runner that installs the client
+///   package).
+///
+/// **The two gates are independent, and that independence is the point.** A single
+/// zero-argument `feature_gated_checks()` gated on one boolean — the shape this
+/// replaced (`main.rs`'s `if tikv_toolchain { … }`) — would fire the FDB typecheck only
+/// when `WYRD_TIKV_TOOLCHAIN` happened to be set: a silent, wrong coupling between two
+/// unrelated backends. Hence two parameters, and the assertion in
+/// `xtask/tests/fdb_harness.rs` that each set of rows appears independently of the other.
+///
+/// Lives in the **lib** target (like [`deploy_guard`]) so `xtask/tests/fdb_harness.rs`
+/// can call it directly. `main.rs`'s `run_ci_steps` is its only production caller, and
+/// its own unit test drives that wiring with a recording executor, so deleting the
+/// wiring loop flips red too — one list, two call sites.
+pub fn feature_gated_checks(tikv: bool, fdb: bool) -> Vec<Vec<&'static str>> {
+    let mut checks = Vec::new();
+    if tikv {
+        checks.push(vec![
+            "check",
+            "-p",
+            "wyrd-metadata-tikv",
+            "--features",
+            "tikv",
+            "--tests",
+        ]);
+    }
+    if fdb {
+        checks.push(vec![
+            "check",
+            "-p",
+            "wyrd-metadata-fdb",
+            "--features",
+            "fdb",
+            "--tests",
+        ]);
+        checks.push(vec![
+            "check",
+            "-p",
+            "wyrd-server",
+            "--features",
+            "fdb",
+            "--tests",
+        ]);
+    }
+    checks
+}
