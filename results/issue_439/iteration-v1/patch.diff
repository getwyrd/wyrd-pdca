+// ─── (3) the workflow exists, and every command it names is really dispatched ──────────
+
+/// The workflow file, relative to the workspace root.
+const WORKFLOW: &str = ".github/workflows/fdb-conformance.yml";
+
+/// Every `cargo xtask <sub>` token in `text`, in order. Plain-text scraping, exactly as
+/// `xtask/tests/readme_dev_section.rs` asserts the README: `xtask` has no YAML parser and
+/// adding one would trigger the ADR-0003 §2 dependency audit for a substring check.
+fn xtask_subcommands(text: &str) -> Vec<String> {
+    const NEEDLE: &str = "cargo xtask ";
+    let mut subs = Vec::new();
+    let mut rest = text;
+    while let Some(idx) = rest.find(NEEDLE) {
+        rest = &rest[idx + NEEDLE.len()..];
+        let token: String = rest.chars().take_while(|c| !c.is_whitespace()).collect();
+        // Strip the surrounding backticks / punctuation of a prose mention.
+        let token = token.trim_matches(|c: char| !c.is_ascii_alphanumeric() && c != '-');
+        if !token.is_empty() && !subs.iter().any(|s: &String| s == token) {
+            subs.push(token.to_string());
+        }
+    }
+    subs
+}
+
+#[test]
+fn the_fdb_conformance_workflow_exists_and_only_names_real_subcommands() {
+    let workflow = read(WORKFLOW);
+    let main_rs = read("xtask/src/main.rs");
+
+    let subs = xtask_subcommands(&workflow);
+    assert!(
+        subs.contains(&"fdb-conformance".to_string()),
+        "the workflow must actually run `cargo xtask fdb-conformance` — that is the whole \
+         job. Found: {subs:?}"
+    );
+    // Non-vacuity: an empty scrape (a workflow that runs nothing, or a broken scraper)
+    // would satisfy the per-subcommand loop below.
+    assert!(
+        subs.len() >= 2,
+        "the workflow should name more than one xtask command (the conformance run and the \
+         doctor preflight at minimum): {subs:?}"
+    );
+
+    // The doc↔dispatch contract: the workflow cannot name a command `cargo xtask` does
+    // not have — including in its prose. `run_*` arms are matched on the literal
+    // `Some("<sub>")` of `main`'s dispatch table.
+    for sub in &subs {
+        assert!(
+            main_rs.contains(&format!("Some(\"{sub}\")")),
+            "{WORKFLOW} names `cargo xtask {sub}`, which xtask/src/main.rs does not dispatch"
+        );
+    }
+
+    // The doctor is a real subcommand, not just prose in the header comment.
+    assert!(
+        main_rs.contains("Some(\"fdb-doctor\")"),
+        "xtask/src/main.rs does not dispatch the `fdb-doctor` preflight"
+    );
+    // …and it is offered in the usage line, so `cargo xtask` discloses it.
+    assert!(
+        main_rs.contains("fdb-doctor|"),
+        "`fdb-doctor` is missing from xtask's usage line"
+    );
+}
+
+#[test]
+fn the_workflow_runs_on_pull_requests_touching_the_fdb_backend_and_nightly() {
+    let workflow = read(WORKFLOW);
+
+    // (a) A pull-request trigger whose path filter covers the backend crate — otherwise a
+    //     PR that breaks `metadata-fdb` gets no FDB signal at all (gap 1 of #439).
+    assert!(
+        workflow.contains("pull_request:"),
+        "the workflow must run on pull requests"
+    );
+    assert!(
+        workflow.contains("\"crates/metadata-fdb/**\""),
+        "the pull-request path filter must include `crates/metadata-fdb/**`"
+    );
+
+    // (b) Nightly + opt-in, the tier1-jepsen.yml shape: post-merge regression visibility
+    //     for what a path filter cannot catch.
+    assert!(
+        workflow.contains("schedule:") && workflow.contains("cron:"),
+        "the workflow must run nightly (tier1-jepsen.yml's shape)"
+    );
+    assert!(
+        workflow.contains("workflow_dispatch:"),
+        "the workflow must be runnable on demand"
+    );
+
+    // (c) The integration-nightly.yml container-job shape: a docker check, a timeout so a
+    //     hung run fails fast (#150), and a failure-artifact upload.
+    assert!(
+        workflow.contains("docker info"),
+        "a container job must confirm the Docker daemon is reachable"
+    );
+    assert!(
+        workflow.contains("timeout-minutes:"),
+        "the job must be bounded, or a hung run drifts to GitHub's 6h default (#150)"
+    );
+    assert!(
+        workflow.contains("if: failure()") && workflow.contains("upload-artifact"),
+        "a failed run must upload its diagnostics"
+    );
+
+    // (d) NOT a required merge gate (ADR-0016): the unprivileged, container-free
+    //     `cargo xtask ci` stays the one gating check. Recorded as prose in the workflow
+    //     so the next editor knows the job is deliberately non-gating.
+    assert!(
+        workflow.contains("NOT a required merge-gate status check"),
+        "the workflow must record that it is not a required merge gate (ADR-0016)"
+    );
+}
