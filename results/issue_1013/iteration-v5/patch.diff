+async fn create_upload(meta: &MemMeta, n: u64, object: &str) -> UploadId {
+    let profile: Budget = metadata::decode(
+        b"{\"w_ref\":128,\"max_part_chunks\":1,\"max_parts_per_session\":1,\
+          \"max_inflight_parts\":1,\"max_staged_chunks\":1}",
