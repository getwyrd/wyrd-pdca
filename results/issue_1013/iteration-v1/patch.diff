+async fn d_two_drainers_racing_the_terminal_delete_release_the_slot_once() {
+    let sent = race(5, true).await;
+    assert_eq!(sent.len(), 1, "the first drainer sent one terminal batch");
+    assert_eq!(
+        sent[0].1,
+        Some(CommitOutcome::Conflict),
+        "and it was refused"
+    );
+}
