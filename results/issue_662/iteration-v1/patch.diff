+/// Sleep `half_millis` half-milliseconds — at once for zero (see `RESTORE_NEMESIS_SPAN`).
+async fn sleep_half_millis(half_millis: u64) {
+    if half_millis > 0 {
+        madsim::time::sleep(Duration::from_micros(500 * half_millis)).await;
+    }
+}
