+/// A committed `part:` value holding one un-erasure-coded chunk on `dserver`, hand-written and
+/// read back through its decoder.
+fn part_value_on(chunk: ChunkId, dserver: DServerId) -> Bytes {
+    let bytes = format!(
+        r#"{{"chunks":[{{"id":{chunk},"scheme":"None","len":5,"placement":[{dserver}]}}],"len":5,"digest":"{}","committed_at_millis":1,"session_epoch":1}}"#,
+        "ab".repeat(32)
+    );
+    decode_part_record(bytes.as_bytes()).expect("fixture: a part record the decoder accepts");
+    Bytes::from(bytes)
