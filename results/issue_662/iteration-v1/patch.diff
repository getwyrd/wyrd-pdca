+/// An `Open` session's `mpu:` value, hand-written — the record has no writer-side constructor —
+/// and read back through its decoder.
+fn open_session_value() -> Bytes {
+    let bytes: &'static str = r#"{"parent":1,"object":"staged","created_at_millis":1,"clock_source":"wall","epoch":1,"attempts":0,"state":{"kind":"Open"}}"#;
+    decode_session_record(bytes.as_bytes()).expect("fixture: an Open session the decoder accepts");
+    Bytes::from_static(bytes.as_bytes())
+}
