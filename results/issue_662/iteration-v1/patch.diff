+/// One GC pass at [`STAGED_NOW`], through the fenced `reconcile_step` with a fresh context.
+async fn staged_gc_pass(
+    zone: &FencedZone,
+    custodian: &Custodian,
+    meta: &StagedMeta,
+    fleet: &[(DServerId, &dyn ChunkStore)],
+) -> std::result::Result<Reconciled, String> {
+    meta.log(StagedEvent::Pass);
+    let ctx = GcContext {
+        meta,
+        fleet,
+        grace_window_millis: STAGED_GRACE,
+        expired_pending: ExpiredPendingPolicy::Defer,
+    };
+    reconcile_step(zone, custodian, Some(&ctx), None, None, None, STAGED_NOW)
+        .await
+        .map_err(|err| err.to_string())
