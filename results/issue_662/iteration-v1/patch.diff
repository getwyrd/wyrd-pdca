+/// One observation at the store seams, in the order the simulation produced it.
+#[derive(Clone, Debug, PartialEq, Eq)]
+enum StagedEvent {
+    /// The run began a GC pass.
+    Pass,
+    /// A `scan` or `scan_page` of this prefix answered.
+    Read(Vec<u8>),
+    /// The concurrent task's commit landed: `"part-commit"`, `"publication"` or `"adoption"`.
+    Landed(&'static str),
+    /// The mover began its adoption CAS.
+    AdoptionBegun,
+    /// The mover's adoption CAS answered `Conflict`.
+    AdoptionLost,
+    /// GC's reclaim intent on the watched mark landed.
+    IntentLanded,
+    /// A D server finished deleting the watched fragment.
