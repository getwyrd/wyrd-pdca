+/// The campaign leg: the seed picks when the part commit lands and how long after it the upload
+/// publishes.
+async fn prop_staged_build_under_concurrent_handoffs(rng: &mut ChaCha8Rng) {
+    let part_commit_at = u64::from(rng.next_u32() % (STAGED_NEMESIS_SPAN + 1));
+    let publish_after = u64::from(rng.next_u32() % (STAGED_NEMESIS_SPAN + 1));
+    staged_build_under_concurrent_handoffs(part_commit_at, publish_after).await;
+}
+
+/// **Both handoffs genuinely land between the builder's reads.** Walks the part commit across the
+/// whole span, with the publication at several distances behind it, asserting the full property
+/// at every point, then asserts that some run landed the part commit between a pass's `sidx:` and
+/// `part:` reads and some run landed the publication between its `part:` and `inode:` reads — the
+/// two interleavings a destination-first build gets wrong.
+async fn prop_staged_build_reaches_both_handoff_landings() {
+    let (mut part_commits, mut publications) = (Vec::new(), Vec::new());
+    for part_commit_at in 0..=u64::from(STAGED_NEMESIS_SPAN) {
+        for publish_after in [0, 1, 3] {
+            let landing =
+                staged_build_under_concurrent_handoffs(part_commit_at, publish_after).await;
+            if landing.part_commit_between_reads {
+                part_commits.push((part_commit_at, publish_after));
+            }
+            if landing.publication_between_reads {
+                publications.push((part_commit_at, publish_after));
+            }
+        }
+    }
+    assert!(
+        !part_commits.is_empty(),
+        "no run landed the part commit between a pass's `sidx:` and `part:` reads"
+    );
+    assert!(
+        !publications.is_empty(),
+        "no run landed the publication between a pass's `part:` and `inode:` reads"
+    );
+}
+
+/// Where the adoption landed relative to GC's reclamation of the fragment.
+struct AdoptionLanding {
+    /// The mover began its adoption after GC's reclaim intent had landed — the window in which
+    /// the old order left the mark holding its pre-mark bytes over a fragment being deleted.
+    after_intent: bool,
+    /// The adoption committed.
+    adopted: bool,
+}
+
+/// One run: GC reclaims a pre-marked fragment while a mover tries to adopt it
+/// `delay_half_millis` half-milliseconds into the run. Asserts that a committed adoption never
+/// names a deleted fragment, and that a fragment nobody adopted is reclaimed; returns where the
+/// adoption landed.
+async fn gc_reclaim_under_a_concurrent_adoption(delay_half_millis: u64) -> AdoptionLanding {
+    let fragment = frag_of(ADOPT_CHUNK);
+    let mark = metadata::orphan_key(2, fragment);
+    let events = Arc::new(Mutex::new(Vec::new()));
+    let meta = Arc::new(StagedMeta {
+        inner: SimTikvMetadataStore::new(),
+        events: Arc::clone(&events),
+        watched_mark: mark.clone(),
+    });
+    let d: Vec<HopDServer> = (0..4)
+        .map(|_| HopDServer {
+            inner: MemDServer::default(),
+            events: Arc::clone(&events),
+            watched: fragment,
+        })
+        .collect();
+    // The move wrote its pre-mark, then the destination fragment, and paused past the grace.
+    d[2].put_fragment(fragment, Bytes::from_static(b"moved"), None)
+        .await
+        .unwrap();
+    let seeded = meta
+        .commit(WriteBatch::new().put(mark.clone(), b"0".to_vec()))
+        .await
+        .unwrap();
+    assert_eq!(seeded, CommitOutcome::Committed);
+    events.lock().unwrap().clear();
+
+    // The mover's adoption: one CAS on the pre-mark's exact bytes, publishing a placement that
+    // names the fragment and deleting the pre-mark (`0016:825`, "on win it adopts").
+    let mover = madsim::task::spawn({
+        let meta = Arc::clone(&meta);
+        let mark = mark.clone();
+        async move {
+            sleep_half_millis(delay_half_millis).await;
+            meta.log(StagedEvent::AdoptionBegun);
+            let outcome = meta
+                .commit(
+                    WriteBatch::new()
+                        .require(mark.clone(), b"0".to_vec())
+                        .put(
+                            metadata::inode_key(ADOPT_INODE),
+                            metadata::encode(&flat_committed_on(&[(ADOPT_CHUNK, 2)])),
+                        )
+                        .delete(mark),
+                )
+                .await
+                .unwrap();
+            meta.log(match outcome {
+                CommitOutcome::Committed => StagedEvent::Landed("adoption"),
+                CommitOutcome::Conflict => StagedEvent::AdoptionLost,
+            });
+            outcome
+        }
+    });
+
+    let coord = MemCoordination::new();
+    let (zone, custodian) = elect(&coord, "zone-staged-adoption").await;
+    let fleet: [(DServerId, &dyn ChunkStore); 4] = [(0, &d[0]), (1, &d[1]), (2, &d[2]), (3, &d[3])];
+    for pass in 1..=STAGED_PASSES {
+        let outcome = staged_gc_pass(&zone, &custodian, &meta, &fleet).await;
+        assert!(
+            outcome.is_ok(),
+            "GC pass {pass} failed (adoption at {delay_half_millis} half-ms): {outcome:?}"
+        );
+    }
+    let adoption = mover.await.expect("the mover ran to completion");
+    // One pass more over the settled store, so a fragment nobody adopted is judged after the
+    // mover's last word.
+    let settled = staged_gc_pass(&zone, &custodian, &meta, &fleet).await;
+    assert!(settled.is_ok(), "the settled pass failed: {settled:?}");
+
+    let present = d[2].get_fragment(fragment).await.unwrap().is_some();
+    let published = meta
+        .get(&metadata::inode_key(ADOPT_INODE))
+        .await
+        .unwrap()
+        .is_some();
+    let events = events.lock().unwrap().clone();
+    match adoption {
+        CommitOutcome::Committed => assert!(
+            published && present,
+            "the adoption published a placement naming a fragment GC deleted — outcome (c) \
+             (adoption at {delay_half_millis} half-ms): {events:?}"
+        ),
+        CommitOutcome::Conflict => assert!(
+            !published && !present && meta.get(&mark).await.unwrap().is_none(),
+            "the fragment nobody adopted must be reclaimed and its mark consumed (adoption at \
+             {delay_half_millis} half-ms): {events:?}"
+        ),
+    }
+    let intent_at = events.iter().position(|e| *e == StagedEvent::IntentLanded);
+    let begun_at = events.iter().position(|e| *e == StagedEvent::AdoptionBegun);
+    AdoptionLanding {
+        after_intent: matches!((intent_at, begun_at), (Some(i), Some(b)) if i < b),
+        adopted: adoption == CommitOutcome::Committed,
+    }
+}
+
+/// The campaign leg: the seed picks when the mover's adoption lands.
+async fn prop_gc_reclaim_under_a_concurrent_adoption(rng: &mut ChaCha8Rng) {
+    let delay = u64::from(rng.next_u32() % (STAGED_NEMESIS_SPAN + 1));
+    gc_reclaim_under_a_concurrent_adoption(delay).await;
+}
+
+/// **Both outcomes of the race are genuinely reached.** Walks the adoption across the whole span,
+/// asserting the property at every point, then asserts that some adoption landed first and won,
+/// and some began after GC's reclaim intent had landed and lost — the interleaving in which the
+/// old order (delete first, record after) let the adoption publish over deleted bytes.
+async fn prop_gc_reclaim_reaches_both_adoption_outcomes() {
+    let (mut won, mut lost_after_intent) = (Vec::new(), Vec::new());
+    for delay in 0..=u64::from(STAGED_NEMESIS_SPAN) {
+        let landing = gc_reclaim_under_a_concurrent_adoption(delay).await;
+        if landing.adopted {
+            won.push(delay);
+        }
+        if landing.after_intent && !landing.adopted {
+            lost_after_intent.push(delay);
+        }
+    }
+    assert!(
+        !won.is_empty(),
+        "no adoption in 0..={STAGED_NEMESIS_SPAN} half-ms landed ahead of GC's reclamation"
+    );
+    assert!(
+        !lost_after_intent.is_empty(),
+        "no adoption in 0..={STAGED_NEMESIS_SPAN} half-ms began after GC's reclaim intent landed \
+         — the interleaving this property exists for was never exercised"
+    );
+}
+
 // ---- the seed sweep: each property over the run seed (madsim sweeps MADSIM_TEST_NUM) ----
 
 /// A fresh ChaCha RNG seeded from the madsim run seed, so the whole campaign — *which*
@@ -2649,6 +3189,30 @@ dst_campaign_test! {
     }
 }
 
+dst_campaign_test! {
+    async fn staged_build_keeps_a_chunk_across_concurrent_handoffs() {
+        prop_staged_build_under_concurrent_handoffs(&mut rand_seed()).await;
+    }
+}
+
+dst_campaign_test! {
+    async fn staged_build_reaches_both_handoff_landings() {
+        prop_staged_build_reaches_both_handoff_landings().await;
+    }
+}
+
+dst_campaign_test! {
+    async fn gc_reclaim_never_lets_a_concurrent_adoption_publish_over_deleted_bytes() {
+        prop_gc_reclaim_under_a_concurrent_adoption(&mut rand_seed()).await;
+    }
+}
+
+dst_campaign_test! {
+    async fn gc_reclaim_reaches_both_adoption_outcomes() {
+        prop_gc_reclaim_reaches_both_adoption_outcomes().await;
+    }
+}
+
 // ---- committed regression seeds (ADR-0009: a bug-finding seed is a permanent test) ----
 
 /// Seeds committed as **permanent regressions** (ADR-0009, `0005:374`): the campaign
@@ -2682,6 +3246,8 @@ dst_campaign_test! {
             prop_gc_over_a_segmented_map_never_reclaims_it_and_never_over_certifies(&mut rng).await;
             prop_restore_two_readings_never_license_a_mark(&mut rng).await;
             prop_gc_orphan_walk_under_a_concurrent_unlink(&mut rng).await;
+            prop_staged_build_under_concurrent_handoffs(&mut rng).await;
+            prop_gc_reclaim_under_a_concurrent_adoption(&mut rng).await;
         }
     }
 }
diff --git a/docs/design/architecture/06-runtime-view.md b/docs/design/architecture/06-runtime-view.md
index bde114c..4f55385 100644
--- a/docs/design/architecture/06-runtime-view.md
+++ b/docs/design/architecture/06-runtime-view.md
@@ -74,5 +74,7 @@ Delete is a commit-point operation too, and its cost is paid lazily, off the cri
 2. **Reclaim (custodian GC, L4).** The orphaned fragments are reclaimed by a GC custodian after a grace period — long enough that an in-flight reader holding the old version is never torn — exactly the pending-ledger sweep pattern (section 5). Reclamation is background work, not on the delete's latency path.
 
    The ledger of these grace records can outgrow what one metadata listing may return — a single delete of the largest segmented object writes more records than that — so GC **walks it in bounded windows** rather than reading it whole. Each pass reads at most a fixed number of records, in pages, starting where the previous pass stopped, and returns to the start of the ledger once it reaches the end; where to resume is kept in one small record of its own in the metadata store, so the walk carries over from pass to pass and across a change of leader. A pass that stops short of the ledger's end reports the walk as partial rather than the store as converged, so a caller that drives reconciliation until it is satisfied keeps going; and a resume record that no longer spells a key the ledger could hold (torn, oversized, damaged) is named to the operator and the walk restarts from the head, rewriting the record, rather than failing every pass on it. A pass concludes only what its window shows: a fragment whose record lies outside the window is left for a later pass, never reclaimed meanwhile on other evidence such as an expired write lease; a record whose value cannot be read still counts as a record — its fragment is kept and the record is named to the operator — and only a record spelled exactly as the delete path writes it can license a reclaim. The chunk-wide lease entry of an interrupted write is retired only once no fragment it accounts for is left, since other windows may still hold some. GC's own clean-up writes go out in commits of a fixed size, never one commit sized by the pass. The post-restore pass reads the same ledger page by page too, to its end, before deciding which fragments already carry a record.
+
+   A reclaim is **recorded before it destroys anything**: GC first rewrites the fragment's record, by a compare-and-set on the exact value it read, into a "reclaiming" form, and deletes the fragment only once that commit has landed — so any other writer still relying on the record's earlier value (a move adopting a fragment it pre-marked) fails from that instant — and a pass that dies in between leaves a reclaiming record the next pass finishes. A record that changed after GC read it is left for a later pass. Bytes an in-progress multipart upload still owns — a committed part's, or an in-flight part's — are never reclaimed or marked, whatever record they carry, and neither are the fragments of a byte retirement that is still draining (section 8.7).
 3. **Propagate across zones (L3).** If the object had replicas, the deletion propagates through the replica catalog: each holding zone drops its catalog record and its GC reclaims the local fragments. Until propagation completes, a *stale-tolerant* read in a lagging zone may still see the old object, bounded by replication lag (section 8.1); consistency-sensitive reads route to the home zone and never do.
 4. **Prove it (audit + crypto-erase).** The deletion is recorded in the append-only audit/event log — the operator's compliance and GDPR-deletion story (section 8.3). Where per-tenant envelope encryption is enabled, dropping the object/tenant key crypto-shreds the data immediately, making it unrecoverable independent of when GC runs (section 8.5).
diff --git a/docs/design/architecture/08-crosscutting-concepts.md b/docs/design/architecture/08-crosscutting-concepts.md
index 60a1e8d..95a1ff2 100644
--- a/docs/design/architecture/08-crosscutting-concepts.md
+++ b/docs/design/architecture/08-crosscutting-concepts.md
@@ -84,6 +84,12 @@ A half-upgraded fleet is the normal state during a rolling upgrade (constraint 2
 
 **A metadata record's shape evolves the same way (proposal 0016 decision 7(a)).** An inode's chunk map is either **flat** (the chunk list inline, a JSON array — the shape every record written before segmentation carries, needed because one metadata value has a size ceiling far below the launch object-size target) or **segmented** (a JSON object: the segment-group identity `{nonce, epoch}`, a segment count, and the segment table, with the chunks themselves in per-segment `seg:<nonce>:<epoch>:<index>` records). The two are told apart by JSON *type*, so a pre-existing record decodes and re-encodes **byte-identically** — a correctness requirement, not hygiene: every metadata compare-and-swap in the system is `require(key, encode(prior))` compared byte-for-byte against the stored value, so an encoding that gained a tag or a wrapper would turn every overwrite, backfill, reconstruction and rebalance of every pre-existing object into a permanent conflict. `seg:`/`seggrp:` are **new key prefixes** over which nothing older reads, so their introduction needs no migration and rewrites no existing record. Structural invariants of the segmented shape — the segment count agreeing with the table, a gap-free ascending index sequence, every index inside the fixed-width key space the `seg:` grammar can address (which is therefore also the *format's* maximum segment count), a contiguous byte tiling that spans exactly the object's recorded size (and one whose arithmetic stays inside `u64`, since a wrapped span would agree with a forged size), a well-formed nonce, and one segment record's chunk lengths summing (checked, never wrapped) to the span it declares — are enforced **at decode**: a malformed record is an error, never a value a consumer could half-resolve. **Capacity** is deliberately not one of those invariants: the ceiling on how many segments a root may name is a number a deployment picks, so it is enforced only where a table becomes *work* — a publication that writes one, and the range read that would spend one — and a limit that moves later can never make an already-published object *undecodable*. That ceiling is itself sized with **2× headroom**: a worst-case segment *table* encodes to at most *half* the tightest backend's value limit and the other half is a reserve for the rest of the record — the object metadata a client supplies, whose width is the caller's, and whatever field a later revision adds — because a root that only just fits is one a later field addition would make unwritable, and an object whose root can no longer be re-written is an object whose placement can never be repaired. The nonce is a **validated type** rather than a string for the same class of reason: the `seg:` range derived from it is what a cleanup pass deletes, so a nonce carrying the key grammar's separator would name another generation's live range. The key space is the opposite case and that is why it *is* checked at decode: a segment past it has no canonical key at any setting, so no reader, GC pass or repair could ever address its record. Symmetrically, a shape this build cannot yet resolve or publish is refused **on the way in** as well: until the staged-publication committer exists, creating an inode with a segmented map, or superseding one, is a typed error rather than a root written over segments that do not exist (or one whose `seg:` records nothing would ever reclaim). Every *existing* consumer of a chunk map obeys the same rule from the other side — the read path, the delete that must orphan an object's fragments, the maintenance loops that reclaim or move them, the id recovery that must not re-mint them all treat a shape they cannot resolve as a typed error **for that object** rather than as an empty chunk list, because "this object owns no chunks" is indistinguishable from a zero-length object and is precisely how a live object's fragments would become unreferenced and be collected. Landing the shape and its codec ahead of any producer or resolver (this slice) keeps the byte-identical, always-flat behaviour of every object in the fleet unchanged until a later slice actually publishes a segmented map.
 
+**An `orphan:` mark's value evolves the same way (proposal 0016, `0016:1189-1204`, `:1321-1336`).** A mark is the evidence GC reclaims a fragment on: its value says when the fragment became orphaned, and its grace window runs from that instant. It now takes one of **three shapes**, told apart by JSON type. The **legacy** shape is the bare decimal instant every writer that predates 0016 puts — the delete and overwrite paths, the post-restore pass, reconstruction, rebalance — and those writers keep putting exactly it. The **structured** shape, `{"orphaned_at_millis":…,"event":"…"}`, adds the identity of the unreference event that wrote the mark; for a retirement drain that identity is its retirement token, which is also the key of its `retire:bytes:` obligation. The **reclaiming** shape, `{"orphaned_at_millis":…,"event":"…","reclaiming":true}` (the event omitted when the mark it replaced carried none), is GC's own: it records that GC has decided to reclaim the fragment, *before* GC destroys anything (below). The decoder accepts a value only when it is exactly the bytes the encoder writes for what it decodes to, so a legacy mark decodes and re-encodes as itself and a pass that merely reads the ledger never rewrites a mark or restarts its grace clock — the post-restore pass counts a mark of any shape as already marked and leaves it untouched. A value is also bounded in length, measured on its reclaiming form, so GC can always write the reclaiming form of a mark it read and read it back. A value that is **none** of the three fails closed: it still counts as its fragment's mark, so the fragment is kept on no other evidence; no pass rewrites or deletes it; and GC and the post-restore pass each name it to an operator on their audit seam. An older custodian that meets a structured value fails its bare-decimal parse and keeps the fragment, which is the safe direction for a rolling upgrade.
+
+**Staged bytes are a protection class of their own (proposal 0016 decision 2, `0016:765-893`).** A multipart upload's bytes are durable long before any committed chunk map names them: a committed part's fragments, named by its `part:` record, and an in-flight part's, named by the owned `sidx:` entry written before its fragments reach a D server. The reference set every destructive pass shares — GC's reclaim gate and the post-restore pass's mark gate — carries them as a **staged** member beside the committed placements, never merged into them, so each consumer decides what a staged fragment means to it (scrub, reconstruction and the drain-status surface still read committed placements alone; their staged halves are later work). GC never reclaims a staged fragment and the post-restore pass never marks one, whatever mark it already carries. The set is built **per session and never from a global scan**: one listing of the `mpu:` sessions — whose count admission bounds — then each session's own `sidx:` range and `part:` range, both bounded, where a listing of `part:` or `sidx:` as a whole would outgrow what one metadata read may return once enough sessions hold their maximum parts. It covers every session whatever its state, which protects more than the protocol needs and never less. The reads run **source before destination**, because each handoff moves a chunk's protection in one atomic batch — a part commit from its `sidx:` entry to the `part:` record, a publication from the `part:` record to the committed inode — and a reader that looked at the destination first could miss a handoff that landed between its two reads and see the chunk in neither class. So a session's `sidx:` range is read before its `part:` range, and every `part:` range before the committed inodes; protection deliberately **overlaps** across each handoff, since the rule is "no gaps", never a partition. A staged record that cannot be read is contained, not skipped: one whose chunk is known but whose placement cannot be trusted has every fragment of that chunk held, and one whose chunks cannot be known — a part record that will not decode, an entry whose key names no chunk — may be holding any fragment, so it makes the reference set incomplete for the passes that honour the staged class: GC reclaims and certifies nothing and the post-restore pass marks nothing and names the record, until a human repairs it, exactly as for a committed object whose chunk map cannot be read.
+
+**No pass destroys a byte before the destruction is durable in metadata (`0016:1312-1336`).** GC used to delete a fragment and only afterwards commit the deletion of its mark, so for the length of a pass the ledger still held a mark's exact bytes over a fragment that was gone — and a move adopting a pre-marked destination, whose commit is conditioned on those bytes, could publish a placement naming deleted bytes. GC now compare-and-sets the mark from the bytes it read into its reclaiming shape, in bounded batches, and deletes the fragment only once that commit has landed; the mark itself is deleted after, as before. Any other commit still conditioned on the mark's earlier bytes fails from that instant, whatever its latency, with no clock read on either side. A pass that dies between the two leaves a reclaiming mark over a present fragment, which the next pass finishes — the fragment deleted, then the mark — with no second grace test, since the window already elapsed once. A mark that changed after GC read it loses only its own compare-and-set: that fragment is left for a later pass to judge on the new value, every other fragment in the batch is still reclaimed, and a pass whose only verdict was lost that way reports its walk as partial rather than the store as converged. And a byte retirement still draining protects the fragments it names: a structured mark names its event, the event's token is the obligation's key, so GC asks with **one keyed read per candidate** whether `retire:bytes:<token>` still exists — never by reading the `retire:` namespace, which is deliberately unbounded, as a range.
+
 ## 8.8 Multi-tenancy
 
 The primary deployment is a provider serving many tenants on shared infrastructure (section 1.4), so a **tenant** is a first-class unit — a namespace partition plus an identity domain, carrying its own policy (residency, replication factor, encryption, quotas, rate limits). See ADR-0022.
