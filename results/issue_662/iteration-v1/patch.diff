+    part_commit_between_reads: bool,
+    /// The publication landed after a pass read `part:` and before its `inode:` scan (X67).
+    publication_between_reads: bool,
+}
+
+fn handoff_landing(events: &[StagedEvent], upload: &UploadId) -> HandoffLanding {
+    let (sidx, part) = (sidx_range(upload), part_range(upload));
+    let mut read = (false, false, false);
+    let mut landing = HandoffLanding {
+        part_commit_between_reads: false,
+        publication_between_reads: false,
+    };
+    for event in events {
+        match event {
+            StagedEvent::Pass => read = (false, false, false),
+            StagedEvent::Read(prefix) if *prefix == sidx => read.0 = true,
+            StagedEvent::Read(prefix) if *prefix == part => read.1 = true,
+            StagedEvent::Read(prefix) if prefix.as_slice() == b"inode:" => read.2 = true,
+            StagedEvent::Landed("part-commit") => {
+                landing.part_commit_between_reads |= read.0 && !read.1;
+            }
+            StagedEvent::Landed("publication") => {
+                landing.publication_between_reads |= read.1 && !read.2;
+            }
+            _ => {}
+        }
+    }
+    landing
