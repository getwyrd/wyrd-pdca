+/// The multipart session both handoffs belong to (its upload id is this pair, sixteen times).
+const STAGED_UPLOAD_PAIR: &str = "62";
+/// The chunk that moves `sidx:` → `part:` → committed inode: one fragment on D server 1, carrying
+/// a mark long past grace for the whole run, so only its staged or committed protection keeps it.
+const HANDOFF_CHUNK: ChunkId = 0x6621;
+/// The inode the upload publishes.
+const HANDOFF_INODE: InodeId = 7;
+/// The pre-marked fragment the mover adopts: one fragment on D server 2, its pre-mark aged past
+/// grace (the move wrote it, then paused).
+const ADOPT_CHUNK: ChunkId = 0x6622;
+/// The inode whose placement the adoption publishes.
+const ADOPT_INODE: InodeId = 8;
+const STAGED_GRACE: u64 = 1_000;
+/// Every pass runs at this instant; every mark in this property is stamped at zero.
+const STAGED_NOW: u64 = 10_000;
