+/// A recording tap over the simulated-TiKV store: every call forwarded unchanged, hops included.
+/// Instance state only (ADR-0035).
+struct StagedMeta {
+    inner: SimTikvMetadataStore,
+    events: Arc<Mutex<Vec<StagedEvent>>>,
+    /// The mark whose reclaim intent — a CAS requiring it and putting it — is logged.
+    watched_mark: Vec<u8>,
+}
+
+impl StagedMeta {
+    fn log(&self, event: StagedEvent) {
+        self.events.lock().unwrap().push(event);
+    }
+}
+
+#[async_trait]
+impl MetadataStore for StagedMeta {
+    async fn get(&self, key: &[u8]) -> Result<Option<Bytes>> {
+        self.inner.get(key).await
+    }
+
+    async fn scan(&self, prefix: &[u8]) -> Result<Vec<(Vec<u8>, Bytes)>> {
+        let hits = self.inner.scan(prefix).await?;
+        self.log(StagedEvent::Read(prefix.to_vec()));
+        Ok(hits)
+    }
+
+    async fn scan_page(
+        &self,
+        prefix: &[u8],
+        after: Option<&[u8]>,
+        limit: usize,
+    ) -> Result<wyrd_traits::ScanPage> {
+        let page = self.inner.scan_page(prefix, after, limit).await?;
+        self.log(StagedEvent::Read(prefix.to_vec()));
+        Ok(page)
+    }
+
+    async fn commit(&self, batch: WriteBatch) -> Result<CommitOutcome> {
+        let intent = batch
+            .preconditions
+            .iter()
+            .any(|pre| pre.key == self.watched_mark)
+            && batch.puts.iter().any(|(key, _)| *key == self.watched_mark);
+        let outcome = self.inner.commit(batch).await?;
+        if intent && outcome == CommitOutcome::Committed {
+            self.log(StagedEvent::IntentLanded);
+        }
+        Ok(outcome)
+    }
