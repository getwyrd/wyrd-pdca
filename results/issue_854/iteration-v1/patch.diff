+// --- the scripted peer -----------------------------------------------------------------------
+
+/// When the peer answers, after it has read the request head.
+enum Answer {
+    /// At once.
+    AtHead,
+    /// Once the source has given its whole length and reported its end.
+    WhenExhausted(Arc<Probe>),
+    /// Once the client's writes have backed up.
+    WhenBackedUp,
+    /// Never.
+    Never,
+}
+
+/// Whether the client's writes backed up before the peer answered.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+enum BackedUp {
+    /// Not asked for by the script.
+    NotWaited,
+    /// The client socket's send queue held this many bytes, unmoving.
+    Yes(u64),
+    /// The send queue never held still within `BACKED_UP_WAIT`; the last sample.
+    No(Option<u64>),
+    /// `/proc/net/tcp` cannot be read here, so the peer waited a fixed second instead.
+    Unobservable,
+}
+
+/// Whether the client closed its end after the call returned, judged from its socket in
+/// `/proc/net/tcp` while the peer reads nothing.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+enum ClientClose {
+    /// The socket had left `ESTABLISHED`, or was gone, this long after the call returned.
+    After(Duration),
+    /// Still `ESTABLISHED` `CLOSE_BOUND` after the call returned.
+    Not,
+    /// `/proc/net/tcp` cannot be read here.
+    Unobservable,
+}
+
+/// How the peer's connection ended, as seen by reads after the call returned.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+enum Closed {
+    /// EOF, after `drained` bytes the client had queued.
+    Eof { drained: u64 },
+    /// The client reset the connection.
+    Reset { drained: u64 },
+    /// Still open `CLOSE_BOUND` after the call returned; `drained` bytes read meanwhile.
+    StillOpen { drained: u64 },
+}
+
+impl Closed {
+    fn is_closed(self) -> bool {
+        !matches!(self, Self::StillOpen { .. })
+    }
+}
+
+/// What the peer observed.
+#[derive(Debug)]
+struct PeerReport {
+    backed_up: BackedUp,
+    answered: bool,
+    client_close: ClientClose,
+    closed: Closed,
+}
+
+/// A loopback peer serving one connection by its script. Dropping it aborts its task, which
+/// closes whatever socket it still holds.
+struct Peer {
+    addr: SocketAddr,
+    returned: Option<oneshot::Sender<()>>,
+    report: Option<oneshot::Receiver<PeerReport>>,
+    task: JoinHandle<()>,
+}
+
+impl Peer {
+    async fn start(answer: Answer, then_open: Option<Arc<Gate>>) -> Self {
+        let socket = TcpSocket::new_v4().expect("socket");
+        socket.set_recv_buffer_size(PEER_RCVBUF).expect("SO_RCVBUF");
+        socket
+            .bind("127.0.0.1:0".parse().expect("loopback"))
+            .expect("bind");
+        let listener = socket.listen(16).expect("listen");
+        let addr = listener.local_addr().expect("addr");
+        let (returned_tx, returned_rx) = oneshot::channel();
+        let (report_tx, report_rx) = oneshot::channel();
+        let task = tokio::spawn(async move {
+            let report = serve(listener, answer, then_open, returned_rx).await;
+            let _ = report_tx.send(report);
+        });
+        Self {
+            addr,
+            returned: Some(returned_tx),
+            report: Some(report_rx),
+            task,
+        }
+    }
+
+    /// Tell the peer the call has returned, and collect what it saw. `None` if it never got
+    /// a connection to watch.
+    async fn after_return(&mut self) -> Option<PeerReport> {
+        if let Some(returned) = self.returned.take() {
+            let _ = returned.send(());
+        }
+        let report = self.report.take()?;
+        // The peer bounds its own wait by `CLOSE_BOUND`; the margin covers scheduling only.
+        timeout(CLOSE_BOUND + Duration::from_secs(1), report)
+            .await
+            .ok()?
+            .ok()
+    }
+}
+
+impl Drop for Peer {
+    fn drop(&mut self) {
+        self.task.abort();
+    }
+}
+
+async fn serve(
+    listener: TcpListener,
+    answer: Answer,
+    then_open: Option<Arc<Gate>>,
+    returned: oneshot::Receiver<()>,
+) -> PeerReport {
+    let (mut stream, client) = listener.accept().await.expect("accept");
+    let peer = stream.local_addr().expect("peer addr");
+    read_head(&mut stream).await;
+    let mut backed_up = BackedUp::NotWaited;
+    let answered = match answer {
+        Answer::AtHead => true,
+        Answer::WhenExhausted(probe) => {
+            while !probe.exhausted.load(Ordering::SeqCst) {
+                sleep(Duration::from_millis(5)).await;
+            }
+            true
+        }
+        Answer::WhenBackedUp => {
+            backed_up = wait_backed_up(client, peer).await;
+            true
+        }
+        Answer::Never => false,
+    };
+    if answered {
+        stream
+            .write_all(ACK)
+            .await
+            .expect("write the acknowledgement");
+    }
+    if let Some(gate) = then_open {
+        // Fail the source only once the acknowledgement has reached the client's socket, so
+        // the failure comes after it on the client's side too, not merely on the peer's.
+        wait_delivered(peer, client).await;
+        gate.open();
+    }
+    // Stop reading and hold the socket open until the call returns.
+    let _ = returned.await;
+    let deadline = Instant::now() + CLOSE_BOUND;
+    let client_close = wait_client_close(client, peer, deadline).await;
+    let closed = drain_until_closed(&mut stream, deadline).await;
+    PeerReport {
+        backed_up,
+        answered,
+        client_close,
+        closed,
+    }
+}
+
+/// Read until the end of the request head. Body bytes that arrive with it are discarded.
+async fn read_head(stream: &mut TcpStream) {
+    let mut seen = Vec::new();
+    let mut buf = [0u8; 4096];
+    while !seen.windows(4).any(|w| w == b"\r\n\r\n") {
+        let n = stream.read(&mut buf).await.expect("read the request head");
+        assert!(n > 0, "the client closed before sending a request head");
+        seen.extend_from_slice(&buf[..n]);
+        assert!(seen.len() < 1 << 20, "no end of the request head in 1 MiB");
+    }
+}
+
+/// Wait until the client socket's send queue is non-empty and holds still for
+/// `BACKED_UP_STEADY`: on loopback a queue only stays non-empty while the peer's receive
+/// window is closed, and it only stops growing once the client has stopped writing.
+async fn wait_backed_up(client: SocketAddr, peer: SocketAddr) -> BackedUp {
+    if !tcp_table_readable() {
+        sleep(Duration::from_secs(1)).await;
+        return BackedUp::Unobservable;
+    }
+    let deadline = Instant::now() + BACKED_UP_WAIT;
+    let needed = (BACKED_UP_STEADY.as_millis() / BACKED_UP_SAMPLE.as_millis()) as u32;
+    let mut last = None;
+    let mut steady = 0;
+    while Instant::now() < deadline {
+        let queued = tcp_socket(client, peer).map(|socket| socket.send_queue);
+        if queued.is_some_and(|q| q > 0) && queued == last {
+            steady += 1;
+            if steady >= needed {
+                return BackedUp::Yes(queued.unwrap_or_default());
+            }
+        } else {
+            steady = 0;
+        }
+        last = queued;
+        sleep(BACKED_UP_SAMPLE).await;
+    }
+    BackedUp::No(last)
+}
+
+/// Wait, reading nothing, until the client's socket has left `ESTABLISHED` or is gone: the
+/// client has closed its end, whether or not its FIN can reach the peer yet.
+async fn wait_client_close(client: SocketAddr, peer: SocketAddr, deadline: Instant) -> ClientClose {
+    if !tcp_table_readable() {
+        return ClientClose::Unobservable;
+    }
+    let returned = Instant::now();
+    loop {
+        match tcp_socket(client, peer) {
+            Some(socket) if socket.state == TCP_ESTABLISHED => {}
+            _ => return ClientClose::After(returned.elapsed()),
+        }
+        if Instant::now() >= deadline {
+            return ClientClose::Not;
+        }
+        sleep(Duration::from_millis(10)).await;
+    }
+}
+
+/// Wait until everything the peer wrote has been acknowledged by the client's kernel, which
+/// queues it for reading, and signals the client readable, before it acknowledges. Without
+/// `/proc/net/tcp`, a fixed tenth of a second instead.
+async fn wait_delivered(peer: SocketAddr, client: SocketAddr) {
+    if !tcp_table_readable() {
+        sleep(Duration::from_millis(100)).await;
+        return;
+    }
+    let deadline = Instant::now() + CLOSE_BOUND;
+    while tcp_socket(peer, client).is_some_and(|socket| socket.send_queue > 0) {
+        assert!(
+            Instant::now() < deadline,
+            "the client never acknowledged the peer's answer"
+        );
+        sleep(Duration::from_millis(1)).await;
+    }
+}
+
+/// The `st` value of an established connection in `/proc/net/tcp`.
+const TCP_ESTABLISHED: u8 = 0x01;
+
+/// One end of a loopback connection as the kernel's table of IPv4 TCP sockets lists it.
+struct TcpEntry {
+    /// The `st` column.
+    state: u8,
+    /// The `tx_queue` column: bytes written and not yet acknowledged.
+    send_queue: u64,
+}
+
+fn tcp_table_readable() -> bool {
+    std::fs::read_to_string("/proc/net/tcp").is_ok()
+}
+
+/// The end of a loopback connection at `local` facing `remote`, `None` once the kernel no
+/// longer lists it.
+fn tcp_socket(local: SocketAddr, remote: SocketAddr) -> Option<TcpEntry> {
+    let table = std::fs::read_to_string("/proc/net/tcp").ok()?;
+    let local = format!("0100007F:{:04X}", local.port());
+    let remote = format!("0100007F:{:04X}", remote.port());
+    table.lines().skip(1).find_map(|line| {
+        let fields: Vec<&str> = line.split_whitespace().collect();
+        if *fields.get(1)? != local.as_str() || *fields.get(2)? != remote.as_str() {
+            return None;
+        }
+        let state = u8::from_str_radix(fields.get(3)?, 16).ok()?;
+        let (tx, _rx) = fields.get(4)?.split_once(':')?;
+        let send_queue = u64::from_str_radix(tx, 16).ok()?;
+        Some(TcpEntry { state, send_queue })
+    })
+}
+
+/// Read, discarding, until EOF or a reset, until `deadline`.
+async fn drain_until_closed(stream: &mut TcpStream, deadline: Instant) -> Closed {
+    let deadline = tokio::time::Instant::from_std(deadline);
+    let mut buf = vec![0u8; 256 * 1024];
+    let mut drained = 0u64;
+    loop {
+        match timeout_at(deadline, stream.read(&mut buf)).await {
+            Ok(Ok(0)) => return Closed::Eof { drained },
+            Ok(Ok(n)) => drained += n as u64,
+            Ok(Err(_)) => return Closed::Reset { drained },
+            Err(_) => return Closed::StillOpen { drained },
+        }
+    }
+}
+
+// --- one PUT against one peer ----------------------------------------------------------------
+
+/// Everything one call was observed to do.
+#[derive(Debug)]
+struct Run {
+    outcome: Result<PutOutcome, S3Error>,
+    declared: u64,
+    elapsed: Duration,
+    /// Read right after the call returned.
+    dropped_at_return: bool,
+    /// Bytes the source had given by then.
+    given_at_return: u64,
+    peer: Option<PeerReport>,
+}
+
+/// PUT `declared` bytes from `source` against a peer playing `answer`, then let the peer
+/// watch for the close.
+async fn put_against(
+    answer: Answer,
+    then_open: Option<Arc<Gate>>,
+    declared: u64,
+    source: Source,
+    probe: &Probe,
+) -> Run {
+    let mut peer = Peer::start(answer, then_open).await;
+    let client = client(peer.addr);
+    let started = Instant::now();
+    let call = timeout(
+        CALL_BOUND,
+        client.put_object(KEY, PutSource::new(declared, source)),
+    )
+    .await;
+    // No grace period: read on this current-thread runtime before anything else can run.
+    let dropped_at_return = probe.dropped.load(Ordering::SeqCst);
+    let given_at_return = probe.given.load(Ordering::SeqCst);
+    let elapsed = started.elapsed();
+    let Ok(outcome) = call else {
+        panic!(
+            "put_object did not return within {CALL_BOUND:?} (T_op {T_OP:?} + 1 s); the \
+             source had given {given_at_return} of {declared} bytes"
+        );
+    };
+    let report = peer.after_return().await;
+    Run {
+        outcome,
+        declared,
+        elapsed,
+        dropped_at_return,
+        given_at_return,
+        peer: report,
+    }
+}
+
+/// The lifetime contract: returned in time, source dropped at return, connection closed
+/// within `CLOSE_BOUND` after.
+fn assert_lifetime(run: &Run) {
+    assert!(
+        run.elapsed <= CALL_BOUND,
+        "the call took {:?}, past T_op + 1 s: {run:?}",
+        run.elapsed
+    );
+    assert!(
+        run.dropped_at_return,
+        "the source was still alive when put_object returned: the upload outlived its call. \
+         {run:?}"
+    );
+    let report = run
+        .peer
+        .as_ref()
+        .unwrap_or_else(|| panic!("the peer never reported on its connection: {run:?}"));
+    assert!(
+        matches!(
+            report.client_close,
+            ClientClose::After(_) | ClientClose::Unobservable
+        ),
+        "the client's socket was still ESTABLISHED {CLOSE_BOUND:?} after put_object returned: \
+         the client had not closed the connection. {run:?}"
+    );
+    assert!(
+        report.closed.is_closed(),
+        "the peer's connection was still open {CLOSE_BOUND:?} after put_object returned: \
+         {run:?}"
+    );
+}
+
+/// Whether the peer answered, as its script says it should have.
+fn assert_answered(run: &Run, expected: bool) {
+    let answered = run.peer.as_ref().map(|report| report.answered);
+    assert_eq!(
+        answered,
+        Some(expected),
+        "the peer's answer is not what its script says: {run:?}"
+    );
+}
+
+/// The outcome is the body error and carries the acknowledgement's request id.
+fn assert_answered_early(run: &Run) {
+    // The fixture must include the fault: an answer while the source still had bytes.
+    assert_answered(run, true);
+    assert!(
+        run.given_at_return < run.declared,
+        "the source had given its whole length, so this run did not answer early: {run:?}"
+    );
+    match &run.outcome {
+        Err(err @ S3Error::Body(_)) => assert!(
+            err.to_string()
+                .contains(&format!("x-amz-request-id {REQUEST_ID}")),
+            "the body error does not carry the acknowledgement's request id: {err}. {run:?}"
+        ),
+        _ => panic!(
+            "an acknowledgement that arrived while the source still had bytes to give must \
+             be the body error carrying request id `{REQUEST_ID}`, never a receipt: {run:?}"
+        ),
+    }
+}
+
+// --- scenario 1: no receipt while the source still had bytes ----------------------------------
+
+#[tokio::test]
+async fn an_acknowledgement_before_the_source_is_done_is_the_body_error() {
+    let declared = 64 * 1024 * 1024;
+    let (source, probe) = Source::new(declared, 1024 * 1024);
+    let run = put_against(Answer::AtHead, None, declared, source, &probe).await;
+    assert_answered_early(&run);
+    assert_lifetime(&run);
+}
+
+#[tokio::test]
+async fn a_source_that_fails_after_the_acknowledgement_is_the_body_error() {
+    let gate = Arc::new(Gate::default());
+    let (source, probe) = Source::new(10, 10);
+    let source = source.failing_at(4, &gate);
+    let run = put_against(Answer::AtHead, Some(gate), 10, source, &probe).await;
+    assert_answered_early(&run);
+    assert_lifetime(&run);
+}
+
+// --- scenario 2: early acknowledgement under backpressure ------------------------------------
+
+#[tokio::test]
+async fn an_acknowledgement_under_backpressure_is_the_body_error_and_releases_the_upload() {
+    let (source, probe) = Source::new(LARGE_OBJECT, LARGE_PIECE);
+    let run = put_against(Answer::WhenBackedUp, None, LARGE_OBJECT, source, &probe).await;
+    // The fixture must include the fault: the peer answered a client blocked mid-write.
+    let backed_up = run.peer.as_ref().map(|report| report.backed_up);
+    assert!(
+        matches!(
+            backed_up,
+            Some(BackedUp::Yes(_)) | Some(BackedUp::Unobservable)
+        ),
+        "the client's writes never backed up before the peer answered, so this run did not \
+         test backpressure: {run:?}"
+    );
+    assert_answered_early(&run);
+    assert_lifetime(&run);
+}
+
+// --- scenario 3: stops reading, never answers -----------------------------------------------
+
+#[tokio::test]
+async fn a_peer_that_stops_reading_and_never_answers_is_the_operation_timeout() {
+    let (source, probe) = Source::new(LARGE_OBJECT, LARGE_PIECE);
+    let run = put_against(Answer::Never, None, LARGE_OBJECT, source, &probe).await;
+    assert_answered(&run, false);
+    assert_eq!(
+        run.outcome,
+        Err(S3Error::Timeout {
+            phase: Phase::Operation,
+            limit: T_OP,
+        }),
+        "{run:?}"
+    );
+    assert!(run.elapsed >= T_OP, "the deadline ran its course: {run:?}");
+    assert_lifetime(&run);
+}
+
+// --- the stated limit -------------------------------------------------------------------------
+
+#[tokio::test]
+async fn a_source_fully_taken_before_the_acknowledgement_is_a_receipt() {
+    let (source, probe) = Source::new(10, 10);
+    let run = put_against(
+        Answer::WhenExhausted(Arc::clone(&probe)),
+        None,
+        10,
+        source,
+        &probe,
+    )
+    .await;
+    assert_answered(&run, true);
+    assert_eq!(run.given_at_return, run.declared, "{run:?}");
+    assert_eq!(run.outcome, Ok(PutOutcome { etag: None }), "{run:?}");
+    assert_lifetime(&run);
+}
