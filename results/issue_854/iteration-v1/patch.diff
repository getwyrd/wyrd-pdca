+// --- the source ------------------------------------------------------------------------------
+
+/// What the test sees of its source from outside.
+#[derive(Debug, Default)]
+struct Probe {
+    /// Bytes the source has given.
+    given: AtomicU64,
+    /// The source has reported its end.
+    exhausted: AtomicBool,
+    /// The source has been dropped.
+    dropped: AtomicBool,
+}
+
+/// A failure the test arms from outside: once opened, a source waiting on it fails.
+#[derive(Debug, Default)]
+struct Gate {
+    open: AtomicBool,
+    waiter: Mutex<Option<Waker>>,
+}
+
+impl Gate {
+    fn open(&self) {
+        self.open.store(true, Ordering::SeqCst);
+        if let Some(waker) = self.waiter.lock().expect("gate lock").take() {
+            waker.wake();
+        }
+    }
+
+    /// Ready once open; otherwise registers `cx` to be woken when it opens.
+    fn poll_open(&self, cx: &mut Context<'_>) -> Poll<()> {
+        if self.open.load(Ordering::SeqCst) {
+            return Poll::Ready(());
+        }
+        *self.waiter.lock().expect("gate lock") = Some(cx.waker().clone());
+        // Opened between the first check and the registration: the wake was missed.
+        if self.open.load(Ordering::SeqCst) {
+            return Poll::Ready(());
+        }
+        Poll::Pending
+    }
+}
+
+/// A source of `total` bytes in pieces of up to `piece.len()`, each a slice of one shared
+/// buffer, so a large piece costs no allocation. With a `fail_at`, it gives that many bytes,
+/// then waits for the gate and fails. Dropping it raises the probe's `dropped` flag.
+struct Source {
+    total: u64,
+    piece: Bytes,
+    given: u64,
+    fail_at: Option<(u64, Arc<Gate>)>,
+    probe: Arc<Probe>,
+}
+
+impl Source {
+    fn new(total: u64, piece: usize) -> (Self, Arc<Probe>) {
+        let probe = Arc::new(Probe::default());
+        let source = Self {
+            total,
+            piece: Bytes::from(vec![0x5a; piece]),
+            given: 0,
+            fail_at: None,
+            probe: Arc::clone(&probe),
+        };
+        (source, probe)
+    }
+
+    fn failing_at(mut self, at: u64, gate: &Arc<Gate>) -> Self {
+        self.fail_at = Some((at, Arc::clone(gate)));
+        self
+    }
+}
+
+impl Stream for Source {
+    type Item = Result<Bytes, std::io::Error>;
+
+    fn poll_next(self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<Option<Self::Item>> {
+        let this = self.get_mut();
+        let mut limit = this.total;
+        if let Some((at, gate)) = &this.fail_at {
+            if this.given >= *at {
+                return match gate.poll_open(cx) {
+                    Poll::Ready(()) => Poll::Ready(Some(Err(std::io::Error::other(
+                        "the source failed after the acknowledgement",
+                    )))),
+                    Poll::Pending => Poll::Pending,
+                };
+            }
+            limit = *at;
+        }
+        let left = limit - this.given;
+        if left == 0 {
+            this.probe.exhausted.store(true, Ordering::SeqCst);
+            return Poll::Ready(None);
+        }
+        let len = left.min(this.piece.len() as u64) as usize;
+        this.given += len as u64;
+        this.probe.given.store(this.given, Ordering::SeqCst);
+        Poll::Ready(Some(Ok(this.piece.slice(..len))))
+    }
+}
+
+impl Drop for Source {
+    fn drop(&mut self) {
+        self.probe.dropped.store(true, Ordering::SeqCst);
+    }
+}
