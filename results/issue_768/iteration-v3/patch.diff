+// ---- (7) and (8): the same rule, read over the real S3 surface ----
+
+/// Await `fut` for at most [`DEADLINE`], failing the test (not hanging it) past that.
+async fn bounded<F: Future>(what: &str, fut: F) -> F::Output {
+    tokio::time::timeout(DEADLINE, fut)
+        .await
+        .unwrap_or_else(|_| panic!("{what} did not finish within {DEADLINE:?}"))
+}
+
+/// Seed a `bucket:{name}` existence marker as raw key/value bytes, as
+/// `s3_last_modified_agreement.rs::seed_bucket` does.
+async fn seed_bucket(meta: &RedbMetadataStore, name: &str) {
+    let key = format!("bucket:{name}").into_bytes();
+    let value = format!("{{\"name\":\"{name}\",\"created_millis\":0}}").into_bytes();
+    meta.commit(WriteBatch::new().put(key, value))
+        .await
+        .expect("commit bucket marker");
+}
+
+/// The running S3 gateway. Dropping it aborts the serve task, so no helper task outlives
+/// the test; it also keeps the chunk store's temp dir alive as long as the gateway runs.
+struct Server {
+    addr: SocketAddr,
+    task: JoinHandle<()>,
+    _dir: tempfile::TempDir,
+}
+
+impl Drop for Server {
+    fn drop(&mut self) {
+        self.task.abort();
+    }
+}
+
+/// Start the S3 gateway on an ephemeral loopback port over a store with the bucket
+/// marker and, if `prior` is given, `KEY` already written with that `modified`.
+async fn start_s3(prior: Option<u64>) -> Server {
+    let (meta, chunks, dir) = backends();
+    bounded("seeding the store", async {
+        seed_bucket(&meta, BUCKET).await;
+        if let Some(modified) = prior {
+            seed(&meta, &chunks, &format!("{BUCKET}/{KEY}"), OLD, modified).await;
+        }
+    })
+    .await;
+    let gateway = Arc::new(gateway(meta, chunks));
+    let config = S3Config::new(vec![GatewayCredentials {
+        access_key_id: ACCESS_KEY.to_string(),
+        secret_access_key: SECRET_KEY.to_string(),
+    }]);
+    let listener = bounded("binding the listener", TcpListener::bind("127.0.0.1:0"))
+        .await
+        .expect("bind");
+    let addr = listener.local_addr().expect("addr");
+    let server = S3Gateway::new(gateway, config);
+    let task = tokio::spawn(async move {
+        server.serve(listener).await.expect("serve");
+    });
+    Server {
+        addr,
+        task,
+        _dir: dir,
+    }
+}
+
+/// A stock `aws-sdk-s3` client for the loopback gateway, as `s3_gateway_cluster.rs`
+/// builds it; retries and stalled-stream protection are off so the test is deterministic.
+fn sdk_client(addr: SocketAddr) -> Client {
+    let http_client = aws_smithy_http_client::Builder::new().build_http();
+    let config = aws_sdk_s3::Config::builder()
+        .behavior_version_latest()
+        .region(Region::new(REGION))
+        .endpoint_url(format!("http://{addr}"))
+        .credentials_provider(SdkCredentials::new(
+            ACCESS_KEY, SECRET_KEY, None, None, "static",
+        ))
+        .http_client(http_client)
+        .force_path_style(true)
+        .retry_config(aws_sdk_s3::config::retry::RetryConfig::disabled())
+        .stalled_stream_protection(aws_sdk_s3::config::StalledStreamProtectionConfig::disabled())
+        .build();
+    Client::from_conf(config)
+}
+
+/// What a client sees of `KEY`: HEAD's `Last-Modified` (whole epoch seconds, as the SDK
+/// parses the header), HEAD's `ETag`, and ListObjectsV2's `<LastModified>` for it.
+async fn wire_view(client: &Client) -> (i64, String, i64) {
+    let head = bounded("HEAD", client.head_object().bucket(BUCKET).key(KEY).send())
+        .await
+        .expect("HEAD");
+    let listing = bounded(
+        "ListObjectsV2",
+        client.list_objects_v2().bucket(BUCKET).send(),
+    )
+    .await
+    .expect("ListObjectsV2");
+    let listed = listing
+        .contents()
+        .iter()
+        .find(|o| o.key() == Some(KEY))
+        .expect("the object is listed");
+    (
+        head.last_modified()
+            .expect("HEAD carries Last-Modified")
+            .secs(),
+        head.e_tag().expect("HEAD carries an ETag").to_owned(),
+        listed
+            .last_modified()
+            .expect("the listing carries LastModified")
+            .secs(),
+    )
+}
+
+async fn sdk_put(client: &Client, data: &'static [u8]) -> String {
+    bounded(
+        "PUT",
+        client
+            .put_object()
+            .bucket(BUCKET)
+            .key(KEY)
+            .body(ByteStream::from_static(data))
+            .send(),
+    )
+    .await
+    .expect("PUT")
+    .e_tag()
+    .expect("PUT answers an ETag")
+    .to_owned()
+}
+
+/// (7) Over the real S3 surface: after a gateway an hour fast wrote the prior, a same-size
+/// overwrite shows a strictly later second on HEAD and in the listing — exactly the next
+/// one — and a second overwrite steps once more.
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn wire_shows_a_later_second_after_a_fast_clock() {
+    let (seeded, _) = an_hour_fast();
+    let seeded_secs = (seeded / SECOND_MS) as i64;
+    let server = start_s3(Some(seeded)).await;
+    let client = sdk_client(server.addr);
+
+    let (head_before, etag_before, listed_before) = wire_view(&client).await;
+    assert_eq!(
+        (head_before, listed_before),
+        (seeded_secs, seeded_secs),
+        "the prior renders at its own second on both surfaces"
+    );
+
+    let etag = sdk_put(&client, NEW).await;
+    let (head_after, etag_after, listed_after) = wire_view(&client).await;
+    assert_ne!(etag_after, etag_before, "the new content has a new ETag");
+    assert_eq!(etag_after, etag, "HEAD's ETag is the PUT's");
+    assert_eq!(
+        (head_after, listed_after),
+        (seeded_secs + 1, seeded_secs + 1),
+        "a same-size overwrite must show a later Last-Modified on HEAD and in the listing, \
+         not an earlier one and not the same second"
+    );
+
+    sdk_put(&client, NEWER).await;
+    let (head_again, _, listed_again) = wire_view(&client).await;
+    assert_eq!(
+        (head_again, listed_again),
+        (seeded_secs + 2, seeded_secs + 2),
+        "the next overwrite steps one more second"
+    );
+}
+
+/// (8) On one gateway with an accurate clock, back-to-back same-size PUTs land well within
+/// a second of each other. Each still shows a later second than the one before, and the
+/// burst runs ahead of the clock by at most one second per overwrite (the lead the rule
+/// accepts so that every overwrite is visible).
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn wire_back_to_back_overwrites_each_show_a_later_second() {
+    let server = start_s3(None).await;
+    let client = sdk_client(server.addr);
+
+    sdk_put(&client, OLD).await;
+    let (mut last, _, listed) = wire_view(&client).await;
+    assert_eq!(listed, last, "HEAD and the listing agree");
+
+    for (overwrite, data) in (1_i64..).zip([NEW, NEWER, OLD]) {
+        sdk_put(&client, data).await;
+        let clock = (wall_millis() / SECOND_MS) as i64;
+        let (head, _, listed) = wire_view(&client).await;
+        assert!(
+            head > last,
+            "overwrite {overwrite}: Last-Modified {head} must be later than the {last} it \
+             replaced"
+        );
+        assert!(
+            head <= clock + overwrite,
+            "overwrite {overwrite}: Last-Modified {head} may lead the clock ({clock}) by at \
+             most one second per overwrite in the burst"
+        );
+        assert_eq!(listed, head, "HEAD and the listing agree");
+        last = head;
+    }
+}
