+        let (committed, log) = logged(|| overwrite_modified(3, Some(T + DAY), Some(T)));
+        assert_eq!(committed, Ok(Some(T + DAY + 1)));
+        assert!(
+            log.is_empty(),
+            "a lead of exactly a day is not logged: {log}"
+        );
+    }
+}
