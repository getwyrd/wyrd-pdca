+                assert_eq!(rig.log.commits(Kind::Commit).len(), 1, "{at}");
+                assert_eq!(rig.log.commits(Kind::Compensation).len(), 0, "{at}");
+                assert_nothing_after(&rig, Kind::Commit, 0, &at);
