diff --git a/crates/custodian/tests/staged_drain_status.rs b/crates/custodian/tests/staged_drain_status.rs
new file mode 100644
index 0000000..608541f
--- /dev/null
+++ b/crates/custodian/tests/staged_drain_status.rs
@@ -0,0 +1,945 @@
+//! Issue #808 (664.1) — the **drain-status query counts staged bytes as held** (proposal 0016
+//! decision 2, its drain and rebalance rows,
+//! `docs/design/proposals/draft/0016-multipart-commit-protocol.md:826-827`, and its failure table
+//! `:874-890`).
+//!
+//! A multipart upload's bytes sit on D servers long before anything publishes them: a committed
+//! part's fragments are named by its `part:` record, and a still-streaming part's by the owned
+//! `sidx:` entries staged for it (#716, #772). Neither is a committed chunk map, and on `main`
+//! `reconciliation_status` reads committed chunk maps only — so it answers `Satisfied` for a
+//! draining server that holds nothing but such bytes, telling an operator to wipe a server whose
+//! bytes a later Complete publishes an object over (the F6 trace, `0016:827`).
+//!
+//! Every leg drives the production `reconciliation_status`, and leg D the production rebalance loop
+//! through `reconcile_step`, over in-memory doubles. No client creates a session before the S3
+//! verbs (#508), so every staged record is seeded, as raw JSON in the shapes of
+//! `crates/core/tests/multipart_session_records.rs:81-145` (and, for an owned `sidx:` value,
+//! `OwnedEntry::to_pending`'s), each value checked against the base decoder before a leg relies on
+//! it. The query reads no D server, so only leg D puts bytes on one.
+//!
+//! The legs:
+//! - **A** an in-flight part's owned `sidx:` fragment on the drained server keeps its drain
+//!   `Pending`;
+//! - **B** so does a committed part's `part:` fragment, on its own — a query counting only one of
+//!   the two classes passes one of A and B and fails the other (`0016:883`);
+//! - **C** a drain whose server holds none of the staged fragments, and no committed one, is still
+//!   `Satisfied` (a guard);
+//! - **D** a rebalance pass over a draining server holding only staged fragments plans and writes
+//!   nothing, while that server's drain status is `Pending` (`0016:881`);
+//! - **E** a staged record the query cannot read, one it can read but not trust, and a store fault
+//!   under a staged read each keep every drain from `Satisfied`.
+//!
+//! Beside them, one leg pins the read order: a publication landing between the two classes'
+//! readings cannot hide a chunk from both (`0016:793-800`).
+//!
+//! Nothing here names a symbol the fix adds: every type, function and string it uses is on `main`
+//! already.
+
+#![forbid(unsafe_code)]
+
+use std::collections::{BTreeMap, HashMap};
+use std::sync::{Arc, Mutex};
+
+use async_trait::async_trait;
+use bytes::Bytes;
+use tracing::instrument::WithSubscriber;
+use tracing_subscriber::prelude::*;
+use wyrd_chunk_format::FragmentHeader;
+use wyrd_coordination_mem::MemCoordination;
+use wyrd_core::metadata::{self, inode_key, ChunkRef, EcScheme, InodeId, InodeRecord, InodeState};
+use wyrd_core::multipart::{
+    decode_owned_entry, decode_part_record, decode_session_record, mpu_key, part_key, part_range,
+    sidx_key, PartNumber, UploadId, MPU_PREFIX,
+};
+use wyrd_custodian::{
+    reconcile_step, reconciliation_status, set_lifecycle, Custodian, DServerLifecycle, FencedZone,
+    RebalanceContext, Reconciled, ReconciliationStatus, Topology,
+};
+use wyrd_traits::{
+    BoxError, ChunkId, ChunkStore, CommitOutcome, DServerId, FragmentId, Health, MetadataStore,
+    Result, ScanPage, WriteBatch,
+};
+
+/// The D server every leg drains.
+const DRAINED: DServerId = 3;
+/// A placement for an `RS(2, 1)` chunk that puts exactly one fragment on [`DRAINED`] — at index 1,
+/// where the identity fallback a committed map's empty placement gets would put server 1. A query
+/// that read only a placement's first entry, or resolved a staged one by identity, misses it.
+const ONE_ON_DRAINED: [DServerId; 3] = [1, DRAINED, 0];
+/// The logical length of every seeded chunk: the length of the one fragment payload leg D writes.
+const PAYLOAD: &[u8] = b"staged";
+const CHUNK_LEN: u64 = PAYLOAD.len() as u64;
+/// When every seeded owned entry's lease expires — far past any clock here; no leg turns on it.
+const LEASE: u64 = 1_000_000;
+/// The bucket and object every seeded session targets, and its epoch.
+const PARENT: InodeId = 42;
+const OBJECT: &str = "staged/drain";
+const EPOCH: u64 = 3;
+/// The inode a publication writes in the read-order leg.
+const PUBLISHED: InodeId = 7;
+/// The instant leg D's rebalance pass runs at.
+const NOW: u64 = 10_000;
+/// What the metadata double answers a read it was armed to fail with.
+const INJECTED_FAULT: &str = "injected metadata-store fault";
+/// The drain-status audit seam.
+const DRAIN_AUDIT: &str = "wyrd.custodian.drain.audit";
+
+// ---- the metadata double ------------------------------------------------------------------------
+
+/// A batch the double commits itself, once, right after the first completed read of any of
+/// `triggers` — so when a concurrent writer lands is the double's decision, not the query's.
+struct Hook {
+    triggers: Vec<Vec<u8>>,
+    batch: WriteBatch,
+}
+
+/// An in-memory `MetadataStore` over an ordered map, with one armable read fault and one
+/// read-triggered writer.
+#[derive(Default)]
+struct Meta {
+    kv: Mutex<BTreeMap<Vec<u8>, Bytes>>,
+    /// Every read whose key or prefix overlaps this range fails.
+    fault: Mutex<Option<Vec<u8>>>,
+    hook: Mutex<Option<Hook>>,
+}
+
+impl Meta {
+    /// Put a fixture record in place — not a read, and not a pass's write.
+    fn seed(&self, key: impl Into<Vec<u8>>, value: impl Into<Bytes>) {
+        self.kv.lock().unwrap().insert(key.into(), value.into());
+    }
+
+    fn holds(&self, key: &[u8]) -> bool {
+        self.kv.lock().unwrap().contains_key(key)
+    }
+
+    /// Every record the store holds, key and value.
+    fn snapshot(&self) -> BTreeMap<Vec<u8>, Bytes> {
+        self.kv.lock().unwrap().clone()
+    }
+
+    /// Fail every later read that overlaps `range`.
+    fn fail_reads_of(&self, range: &[u8]) {
+        *self.fault.lock().unwrap() = Some(range.to_vec());
+    }
+
+    /// Commit `batch` right after the first completed read of any of `triggers`.
+    fn hook(&self, triggers: &[&[u8]], batch: WriteBatch) {
+        *self.hook.lock().unwrap() = Some(Hook {
+            triggers: triggers.iter().map(|trigger| trigger.to_vec()).collect(),
+            batch,
+        });
+    }
+
+    /// Refuse a read of `subject` if it overlaps the armed fault.
+    fn admit(&self, subject: &[u8]) -> Result<()> {
+        let faulted = self
+            .fault
+            .lock()
+            .unwrap()
+            .as_ref()
+            .is_some_and(|range| range.starts_with(subject) || subject.starts_with(range));
+        if faulted {
+            return Err(BoxError::from(INJECTED_FAULT));
+        }
+        Ok(())
+    }
+
+    /// A read of `subject` completed: commit the hook's batch if `subject` is one of its triggers.
+    fn completed(&self, subject: &[u8]) {
+        let fired = {
+            let mut hook = self.hook.lock().unwrap();
+            let triggered = hook.as_ref().is_some_and(|hook| {
+                hook.triggers
+                    .iter()
+                    .any(|trigger| trigger.as_slice() == subject)
+            });
+            if triggered {
+                hook.take()
+            } else {
+                None
+            }
+        };
+        if let Some(hook) = fired {
+            assert_eq!(
+                self.apply(hook.batch),
+                CommitOutcome::Committed,
+                "the concurrent writer's batch must land"
+            );
+        }
+    }
+
+    /// Apply `batch` atomically: every precondition holds, or nothing changes.
+    fn apply(&self, batch: WriteBatch) -> CommitOutcome {
+        let mut kv = self.kv.lock().unwrap();
+        for pre in &batch.preconditions {
+            if kv.get(&pre.key) != pre.expected.as_ref() {
+                return CommitOutcome::Conflict;
+            }
+        }
+        for key in batch.deletes {
+            kv.remove(&key);
+        }
+        for (key, value) in batch.puts {
+            kv.insert(key, value);
+        }
+        CommitOutcome::Committed
+    }
+}
+
+#[async_trait]
+impl MetadataStore for Meta {
+    async fn get(&self, key: &[u8]) -> Result<Option<Bytes>> {
+        self.admit(key)?;
+        let value = self.kv.lock().unwrap().get(key).cloned();
+        self.completed(key);
+        Ok(value)
+    }
+
+    async fn scan(&self, prefix: &[u8]) -> Result<Vec<(Vec<u8>, Bytes)>> {
+        self.admit(prefix)?;
+        let hits = self
+            .kv
+            .lock()
+            .unwrap()
+            .iter()
+            .filter(|(key, _)| key.starts_with(prefix))
+            .map(|(key, value)| (key.clone(), value.clone()))
+            .collect();
+        self.completed(prefix);
+        Ok(hits)
+    }
+
+    // A double needs *a* paged read, not a backend's: the testkit helper pages over `scan` above,
+    // so a fault or a writer armed on a range meets that range's paged reads too.
+    async fn scan_page(
+        &self,
+        prefix: &[u8],
+        after: Option<&[u8]>,
+        limit: usize,
+    ) -> Result<ScanPage> {
+        wyrd_testkit::test_double_scan_page(self, prefix, after, limit).await
+    }
+
+    async fn commit(&self, batch: WriteBatch) -> Result<CommitOutcome> {
+        Ok(self.apply(batch))
+    }
+}
+
+// ---- the D-server double and the fleet ----------------------------------------------------------
+
+/// One D server's fragments.
+#[derive(Default)]
+struct Disk {
+    frags: Mutex<HashMap<FragmentId, Bytes>>,
+}
+
+#[async_trait]
+impl ChunkStore for Disk {
+    async fn put_fragment(
+        &self,
+        id: FragmentId,
+        fragment: Bytes,
+        _deadline_millis: Option<u64>,
+    ) -> Result<()> {
+        self.frags.lock().unwrap().insert(id, fragment);
+        Ok(())
+    }
+
+    async fn get_fragment(&self, id: FragmentId) -> Result<Option<Bytes>> {
+        Ok(self.frags.lock().unwrap().get(&id).cloned())
+    }
+
+    async fn list_fragments(&self) -> Result<Vec<FragmentId>> {
+        Ok(self.frags.lock().unwrap().keys().copied().collect())
+    }
+
+    async fn delete_fragment(&self, id: FragmentId) -> Result<()> {
+        self.frags.lock().unwrap().remove(&id);
+        Ok(())
+    }
+
+    async fn health(&self) -> Result<Health> {
+        Ok(Health::Healthy)
+    }
+}
+
+fn frag(chunk: ChunkId, index: u16) -> FragmentId {
+    FragmentId { chunk, index }
+}
+
+/// Put a real, intact v1 single-copy fragment of `frag`'s chunk on `disk`: bytes rebalance's
+/// verify accepts, so a pass that planned a move over them would copy them rather than abort.
+fn place(disk: &Disk, frag: FragmentId) {
+    let bytes = wyrd_chunk_format::encode(&FragmentHeader::new_v1(frag.chunk, CHUNK_LEN), PAYLOAD);
+    disk.frags.lock().unwrap().insert(frag, Bytes::from(bytes));
+}
+
+/// Every fragment on every disk, in fleet order.
+fn disk_contents(disks: &[Disk; 4]) -> Vec<HashMap<FragmentId, Bytes>> {
+    disks
+        .iter()
+        .map(|disk| disk.frags.lock().unwrap().clone())
+        .collect()
+}
+
+/// Four failure domains A..D, one D server each (servers 0..3): with [`DRAINED`] excluded,
+/// three free domains remain for any move a pass plans.
+fn four_domains() -> Topology {
+    let mut topology = Topology::default();
+    topology
+        .register(0, "A")
+        .register(1, "B")
+        .register(2, "C")
+        .register(3, "D");
+    topology
+}
+
+// ---- the records --------------------------------------------------------------------------------
+
+/// An upload id: 32 lowercase-hex characters from a 2-character pair. Every leg uses its own.
+fn upload(pair: &str) -> UploadId {
+    UploadId::new(pair.repeat(16)).expect("32 lowercase-hex characters")
+}
+
+fn part_no(n: u32) -> PartNumber {
+    PartNumber::new(n).expect("a part number in range")
+}
+
+/// A scheme as the base encoder spells it inside a chunk reference or a staged placement.
+const SINGLE: &str = "\"None\"";
+const RS_2_1: &str = "{\"ReedSolomon\":{\"k\":2,\"m\":1}}";
+const RS_2_1_SCHEME: EcScheme = EcScheme::ReedSolomon { k: 2, m: 1 };
+
+/// A JSON array of D server ids.
+fn servers(placement: &[DServerId]) -> String {
+    let ids: Vec<String> = placement.iter().map(ToString::to_string).collect();
+    format!("[{}]", ids.join(","))
+}
+
+/// An `Open` session record, spelled as `multipart_session_records.rs:88-99` spells one (content
+/// type omitted), and accepted by the base decoder.
+fn open_session() -> Bytes {
+    let bytes = format!(
+        "{{\"parent\":{PARENT},\"object\":\"{OBJECT}\",\"created_at_millis\":100,\
+         \"clock_source\":\"wall\",\"epoch\":{EPOCH},\"attempts\":1,\
+         \"state\":{{\"kind\":\"Open\"}}}}"
+    );
+    decode_session_record(bytes.as_bytes())
+        .unwrap_or_else(|fault| panic!("the seeded session must decode: {fault}"));
+    Bytes::from(bytes)
+}
+
+/// A committed part record naming one chunk of `scheme` at `placement`, spelled as
+/// `multipart_session_records.rs:131-141` spells one, and accepted by the base decoder — which
+/// does not judge a placement's length, so a wrong-length one is accepted too.
+fn part(chunk: ChunkId, scheme: &str, placement: &[DServerId]) -> Bytes {
+    let bytes = format!(
+        "{{\"chunks\":[{{\"id\":{chunk},\"scheme\":{scheme},\"len\":{CHUNK_LEN},\
+         \"placement\":{}}}],\"len\":{CHUNK_LEN},\"digest\":\"{}\",\
+         \"committed_at_millis\":800,\"session_epoch\":{EPOCH}}}",
+        servers(placement),
+        "ef".repeat(32)
+    );
+    decode_part_record(bytes.as_bytes())
+        .unwrap_or_else(|fault| panic!("the seeded part record must decode: {fault}"));
+    Bytes::from(bytes)
+}
+
+/// The value of an owned staging entry of `owner` planning its chunk as `scheme` at `placement`:
+/// a pending lease carrying both ownership fields, as `OwnedEntry::to_pending` stores one. Not
+/// checked here — see [`owned`].
+fn owned_json(owner: &UploadId, scheme: &str, placement: &[DServerId]) -> String {
+    format!(
+        "{{\"lease_expiry_millis\":{LEASE},\"owner\":\"{owner}\",\
+         \"staged\":{{\"scheme\":{scheme},\"placement\":{}}}}}",
+        servers(placement)
+    )
+}
+
+/// [`owned_json`], accepted by the base decoder under `key` — which does not judge a staged
+/// placement's length either.
+fn owned(owner: &UploadId, key: &[u8], scheme: &str, placement: &[DServerId]) -> Bytes {
+    let bytes = owned_json(owner, scheme, placement);
+    decode_owned_entry(key, bytes.as_bytes())
+        .unwrap_or_else(|fault| panic!("the seeded owned entry must decode: {fault}"));
+    Bytes::from(bytes)
+}
+
+/// A listed `Open` session under `pair`'s upload id, nothing staged for it yet.
+fn open(meta: &Meta, pair: &str) -> UploadId {
+    let id = upload(pair);
+    meta.seed(mpu_key(&id), open_session());
+    id
+}
+
+/// Stage `chunk` in flight for `id`: an owned `sidx:` entry of part `n` planning it at
+/// `placement`.
+fn stage_owned(
+    meta: &Meta,
+    id: &UploadId,
+    n: u32,
+    chunk: ChunkId,
+    scheme: &str,
+    placement: &[DServerId],
+) {
+    let key = sidx_key(id, part_no(n), chunk);
+    let value = owned(id, &key, scheme, placement);
+    meta.seed(key, value);
+}
+
+/// Commit `chunk` as `id`'s part `n`: a `part:` record naming it at `placement`.
+fn stage_part(
+    meta: &Meta,
+    id: &UploadId,
+    n: u32,
+    chunk: ChunkId,
+    scheme: &str,
+    placement: &[DServerId],
+) {
+    meta.seed(part_key(id, part_no(n)), part(chunk, scheme, placement));
+}
+
+/// A committed object record whose chunks are `chunks`, each `(id, scheme, placement)`.
+fn committed(chunks: &[(ChunkId, EcScheme, &[DServerId])]) -> Bytes {
+    let record = InodeRecord {
+        size: CHUNK_LEN * chunks.len() as u64,
+        chunk_map: chunks
+            .iter()
+            .map(|&(id, scheme, placement)| ChunkRef {
+                id,
+                scheme,
+                len: CHUNK_LEN,
+                placement: placement.to_vec(),
+            })
+            .collect::<Vec<_>>()
+            .into(),
+        state: InodeState::Committed,
+        version: 1,
+        ..Default::default()
+    };
+    metadata::encode(&record)
+}
+
+/// A healthy `Open` session under `pair` whose committed part (part 1, chunk `base + 1`) and
+/// in-flight owned entry (part 2, chunk `base + 2`) are both staged on servers 0-2 only, never on
+/// [`DRAINED`].
+fn staged_elsewhere(meta: &Meta, pair: &str, base: ChunkId) -> UploadId {
+    let id = open(meta, pair);
+    stage_part(meta, &id, 1, base + 1, RS_2_1, &[0, 1, 2]);
+    stage_owned(meta, &id, 2, base + 2, RS_2_1, &[2, 0, 1]);
+    id
+}
+
+// ---- the passes ---------------------------------------------------------------------------------
+
+/// Record the operator's drain of [`DRAINED`] — "policy changed" — through the production write.
+async fn drain(meta: &Meta) {
+    set_lifecycle(meta, DRAINED, DServerLifecycle::Draining)
+        .await
+        .expect("recording the drain");
+}
+
+/// [`DRAINED`]'s drain status, through the production query.
+async fn status(meta: &Meta) -> ReconciliationStatus {
+    reconciliation_status(meta, DRAINED)
+        .await
+        .unwrap_or_else(|fault| panic!("the drain-status query returned Err: {fault}"))
+}
+
+async fn elect() -> (FencedZone, Custodian) {
+    let coord = MemCoordination::new();
+    let custodian = Custodian::elect(&coord, "zone-staged-drain-status")
+        .await
+        .expect("leader election over the in-memory coordination seam");
+    let mut zone = FencedZone::new();
+    zone.install(custodian.leadership());
+    (zone, custodian)
+}
+
+// ---- the audit seam -----------------------------------------------------------------------------
+
+/// A `MakeWriter` collecting what a scoped subscriber emits, so a leg asserts on the lines the
+/// query actually produced.
+#[derive(Clone, Default)]
+struct Capture(Arc<Mutex<Vec<u8>>>);
+
+impl Capture {
+    fn contents(&self) -> String {
+        String::from_utf8(self.0.lock().unwrap().clone()).unwrap()
+    }
+}
+
+impl std::io::Write for Capture {
+    fn write(&mut self, buf: &[u8]) -> std::io::Result<usize> {
+        self.0.lock().unwrap().extend_from_slice(buf);
+        Ok(buf.len())
+    }
+
+    fn flush(&mut self) -> std::io::Result<()> {
+        Ok(())
+    }
+}
+
+impl<'w> tracing_subscriber::fmt::MakeWriter<'w> for Capture {
+    type Writer = Self;
+    fn make_writer(&'w self) -> Self::Writer {
+        self.clone()
+    }
+}
+
+/// Install a permissive global `tracing` default once, before any query in this binary runs, so
+/// no audit callsite is first met with no subscriber in place and latched off for the whole
+/// process under the parallel test harness (#214). Called at the top of every test here.
+fn enable_audit_callsites() {
+    static INIT: std::sync::Once = std::sync::Once::new();
+    INIT.call_once(|| {
+        let _ = tracing::subscriber::set_global_default(tracing_subscriber::registry());
+    });
+}
+
+fn capturing_dispatch(capture: Capture) -> tracing::Dispatch {
+    tracing::Dispatch::new(
+        tracing_subscriber::registry()
+            .with(tracing_subscriber::fmt::layer().json().with_writer(capture)),
+    )
+}
+
+/// [`DRAINED`]'s drain status through the production query, with what it emitted.
+async fn status_with_audit(meta: &Meta) -> (ReconciliationStatus, String) {
+    let audit = Capture::default();
+    let status = reconciliation_status(meta, DRAINED)
+        .with_subscriber(capturing_dispatch(audit.clone()))
+        .await
+        .unwrap_or_else(|fault| panic!("the drain-status query returned Err: {fault}"));
+    (status, audit.contents())
+}
+
+/// Whether one line on the drain's audit seam named `record` in its `field` under `action`.
+fn drain_seam_names(logged: &str, action: &str, field: &str, record: &str) -> bool {
+    logged.lines().any(|line| {
+        line.contains(&format!(r#""target":"{DRAIN_AUDIT}""#))
+            && line.contains(&format!(r#""action":"{action}""#))
+            && line.contains(&format!(r#""{field}":"{record}""#))
+    })
+}
+
+/// A key as the drain names it: every key here is printable ASCII, which the naming leaves as is.
+fn name(key: &[u8]) -> String {
+    String::from_utf8(key.to_vec()).expect("an ASCII key")
+}
+
+// ---- (A) an in-flight part's owned fragment is held ---------------------------------------------
+
+/// **(A)** [`DRAINED`] holds one fragment and nothing else: fragment 1 of an in-flight part's
+/// erasure-coded chunk, named by the owned `sidx:` entry its upload staged — no `part:` record, no
+/// committed map. Its drain is `Pending`: wiping it would let the part commit and a Complete
+/// publish an object over the missing fragment (`0016:883`).
+///
+/// Base: `Satisfied` — the query reads committed chunk maps only.
+#[tokio::test]
+async fn an_in_flight_part_holds_the_drain() {
+    enable_audit_callsites();
+    let meta = Meta::default();
+    let id = open(&meta, "0a");
+    stage_owned(&meta, &id, 1, 0xA01, RS_2_1, &ONE_ON_DRAINED);
+    drain(&meta).await;
+
+    assert_eq!(
+        status(&meta).await,
+        ReconciliationStatus::Pending,
+        "the drained server holds fragment 1 of a chunk an in-flight part's owned entry names; \
+         certifying the drain licenses wiping bytes the part will commit and publish"
+    );
+}
+
+// ---- (B) a committed part's fragment is held ----------------------------------------------------
+
+/// **(B)** [`DRAINED`] holds one fragment and nothing else: fragment 1 of a committed part's
+/// erasure-coded chunk, named by its `part:` record — no owned entry, no committed map. Its drain
+/// is `Pending`: the F6 trace (`0016:882`).
+///
+/// Base: `Satisfied`.
+#[tokio::test]
+async fn a_committed_part_holds_the_drain() {
+    enable_audit_callsites();
+    let meta = Meta::default();
+    let id = open(&meta, "0b");
+    stage_part(&meta, &id, 1, 0xB01, RS_2_1, &ONE_ON_DRAINED);
+    drain(&meta).await;
+
+    assert_eq!(
+        status(&meta).await,
+        ReconciliationStatus::Pending,
+        "the drained server holds fragment 1 of a chunk a committed part names; certifying the \
+         drain licenses wiping bytes a Complete will publish"
+    );
+}
+
+// ---- (C) a drain still finishes when the uploads live elsewhere ---------------------------------
+
+/// **(C)** Both staged classes and a committed object, all placed on servers 0-2; [`DRAINED`]
+/// holds none of them. Its drain is `Satisfied`: counting staged bytes as held must hold only the
+/// servers they are on, or no drain finishes while any upload is open anywhere.
+///
+/// A guard: green on base.
+#[tokio::test]
+async fn a_drain_finishes_when_the_uploads_live_elsewhere() {
+    enable_audit_callsites();
+    let meta = Meta::default();
+    staged_elsewhere(&meta, "0c", 0xC00);
+    meta.seed(
+        inode_key(1),
+        committed(&[(0xC10, RS_2_1_SCHEME, &[1, 2, 0])]),
+    );
+    drain(&meta).await;
+
+    assert_eq!(
+        status(&meta).await,
+        ReconciliationStatus::Satisfied,
+        "no staged record and no committed map names the drained server"
+    );
+}
+
+// ---- (D) rebalance leaves staged bytes alone, and agrees with drain status ----------------------
+
+/// **(D)** [`DRAINED`] holds two fragments, both staged: one a committed part names and one an
+/// in-flight owned entry names, each an intact single-copy fragment. One rebalance pass through
+/// the fenced control point writes nothing — no fragment on any D server, no record, so no `part:`
+/// record rewritten — and the drain status for that server is then `Pending`: rebalance's plan is
+/// empty while the status is not satisfied (`0016:881`).
+///
+/// The pass answers `Satisfied`: no committed chunk this loop may move is on a draining server.
+/// That is the loop's claim about its own work, not the drain's — the drain is the status query's
+/// to certify (`rebalance.rs`, module doc), and it does not.
+///
+/// Base: the pass is the same; the status is `Satisfied`.
+#[tokio::test]
+async fn rebalance_moves_no_staged_fragment_while_the_drain_is_pending() {
+    enable_audit_callsites();
+    let meta = Meta::default();
+    let disks: [Disk; 4] = Default::default();
+    let id = open(&meta, "0d");
+    stage_part(&meta, &id, 1, 0xD01, SINGLE, &[DRAINED]);
+    stage_owned(&meta, &id, 2, 0xD02, SINGLE, &[DRAINED]);
+    place(&disks[DRAINED as usize], frag(0xD01, 0));
+    place(&disks[DRAINED as usize], frag(0xD02, 0));
+    drain(&meta).await;
+    let records_before = meta.snapshot();
+    let disks_before = disk_contents(&disks);
+
+    let (zone, custodian) = elect().await;
+    let fleet: [(DServerId, &dyn ChunkStore); 4] = [
+        (0, &disks[0]),
+        (1, &disks[1]),
+        (2, &disks[2]),
+        (3, &disks[3]),
+    ];
+    let topology = four_domains();
+    let ctx = RebalanceContext {
+        meta: &meta,
+        fleet: &fleet,
+        topology: &topology,
+    };
+    let outcome = reconcile_step(&zone, &custodian, None, None, None, Some(&ctx), NOW)
+        .await
+        .unwrap_or_else(|fault| panic!("the rebalance pass returned Err: {fault}"));
+
+    assert_eq!(
+        disk_contents(&disks),
+        disks_before,
+        "rebalance wrote or removed a fragment for a draining server holding only staged ones"
+    );
+    assert_eq!(
+        meta.snapshot(),
+        records_before,
+        "rebalance wrote a record — a rewritten `part:` or `sidx:` record, a repoint or a mark — \
+         for a draining server holding only staged fragments"
+    );
+    assert_eq!(
+        outcome,
+        Reconciled::Satisfied,
+        "the pass had nothing it may move, so it has nothing to refuse or report as changed"
+    );
+    assert_eq!(
+        status(&meta).await,
+        ReconciliationStatus::Pending,
+        "rebalance planned nothing for the draining server, and the drain status must not \
+         certify it either: both of its fragments are staged there"
+    );
+}
+
+// ---- (E) an unreadable or untrusted staged record never yields Satisfied ------------------------
+
+/// One staged record the query cannot read at all.
+#[derive(Clone, Copy, Debug)]
+enum Unreadable {
+    /// A `part:` record whose value will not decode.
+    UndecodablePart,
+    /// A record under a session's part range whose key the parser rejects.
+    UnparsablePartKey,
+    /// A record under a session's owned range whose key names no chunk.
+    OwnedKeyNamingNoChunk,
+    /// A session listed under a key that names no upload.
+    SessionKeyNamingNoUpload,
+}
+
+impl Unreadable {
+    /// Seed the damaged record beside `id`'s healthy ones, returning its key.
+    fn seed(self, meta: &Meta, id: &UploadId) -> Vec<u8> {
+        let (key, value) = match self {
+            Unreadable::UndecodablePart => (
+                part_key(id, part_no(3)),
+                Bytes::from_static(b"{\"chunks\":\"not a chunk list\"}"),
+            ),
+            Unreadable::UnparsablePartKey => (
+                format!("part:{id}:3").into_bytes(),
+                part(0xE31, RS_2_1, &[0, 1, 2]),
+            ),
+            Unreadable::OwnedKeyNamingNoChunk => (
+                format!("sidx:{id}:000003:no-chunk").into_bytes(),
+                Bytes::from(owned_json(id, RS_2_1, &[0, 1, 2])),
+            ),
+            Unreadable::SessionKeyNamingNoUpload => {
+                (b"mpu:not-an-upload-id".to_vec(), open_session())
+            }
+        };
+        meta.seed(key.clone(), value);
+        key
+    }
+}
+
+/// **(E)(i)** A staged record the query cannot read hides which chunks, and so which servers, its
+/// upload staged on — so it blocks **every** drain: [`DRAINED`], which holds nothing any record
+/// names, is `PendingUnresolvable` naming that record, for each way a staged record can be
+/// unreadable, and the record is named on the drain's audit seam too.
+///
+/// Base: `Satisfied` for every one — the query reads no staged record.
+#[tokio::test]
+async fn an_unreadable_staged_record_blocks_every_drain() {
+    enable_audit_callsites();
+    for unreadable in [
+        Unreadable::UndecodablePart,
+        Unreadable::UnparsablePartKey,
+        Unreadable::OwnedKeyNamingNoChunk,
+        Unreadable::SessionKeyNamingNoUpload,
+    ] {
+        let meta = Meta::default();
+        let id = staged_elsewhere(&meta, "e1", 0xE00);
+        let damaged = unreadable.seed(&meta, &id);
+        drain(&meta).await;
+
+        let (status, logged) = status_with_audit(&meta).await;
+        assert_eq!(
+            status,
+            ReconciliationStatus::PendingUnresolvable {
+                objects: vec![name(&damaged)],
+            },
+            "{unreadable:?}: a staged record the query cannot read must block the drain and be \
+             named in the answer"
+        );
+        assert!(
+            drain_seam_names(
+                &logged,
+                "unresolvable-staged-record",
+                "record",
+                &name(&damaged)
+            ),
+            "{unreadable:?}: the drain's audit seam must name the record too. got: {logged}"
+        );
+    }
+}
+
+/// **(E)(i)** An unreadable committed object and an unreadable staged record at once: both are
+/// named, the committed object first, each on the seam under its own class's action.
+///
+/// Base: only the committed object is named.
+#[tokio::test]
+async fn unreadable_records_of_both_classes_are_all_named() {
+    enable_audit_callsites();
+    let meta = Meta::default();
+    let id = staged_elsewhere(&meta, "e2", 0xE40);
+    let damaged_part = Unreadable::UndecodablePart.seed(&meta, &id);
+    let damaged_inode = inode_key(9);
+    meta.seed(
+        damaged_inode.clone(),
+        Bytes::from_static(b"not an inode record"),
+    );
+    drain(&meta).await;
+
+    let (status, logged) = status_with_audit(&meta).await;
+    assert_eq!(
+        status,
+        ReconciliationStatus::PendingUnresolvable {
+            objects: vec![name(&damaged_inode), name(&damaged_part)],
+        },
+        "both unreadable records block the drain, committed objects first"
+    );
+    assert!(
+        drain_seam_names(
+            &logged,
+            "unresolvable-chunk-map",
+            "inode",
+            &name(&damaged_inode)
+        ) && drain_seam_names(
+            &logged,
+            "unresolvable-staged-record",
+            "record",
+            &name(&damaged_part)
+        ),
+        "each record must be named on the drain's audit seam under its own class. got: {logged}"
+    );
+}
+
+/// One staged record the query can read but not trust about where its chunk's fragments are.
+#[derive(Clone, Copy, Debug)]
+enum Untrusted {
+    /// An owned entry whose `RS(2, 1)` placement names one server for three fragments.
+    ShortOwnedPlacement,
+    /// A committed part whose `RS(2, 1)` chunk's placement names two servers for three fragments.
+    ShortPartPlacement,
+    /// An owned value that will not decode, under a key that still names its chunk.
+    UndecodableOwnedValue,
+}
+
+impl Untrusted {
+    /// Seed the damaged record for `chunk` beside `id`'s healthy ones. None of them names
+    /// [`DRAINED`]: the block they cause is not scoped to servers a damaged record names.
+    fn seed(self, meta: &Meta, id: &UploadId, chunk: ChunkId) {
+        match self {
+            Untrusted::ShortOwnedPlacement => stage_owned(meta, id, 3, chunk, RS_2_1, &[0]),
+            Untrusted::ShortPartPlacement => stage_part(meta, id, 3, chunk, RS_2_1, &[0, 1]),
+            Untrusted::UndecodableOwnedValue => meta.seed(
+                sidx_key(id, part_no(3), chunk),
+                Bytes::from_static(b"{\"lease_expiry_millis\":\"not a number\"}"),
+            ),
+        }
+    }
+}
+
+/// **(E)(ii)** A staged record the query can read but not trust holds its chunk whole, as a
+/// malformed committed placement does — so it blocks **every** drain the same way:
+/// [`DRAINED`], which holds nothing any trustworthy record names and which the damaged record does
+/// not name either, is `PendingMalformed` naming the chunk.
+///
+/// Base: `Satisfied` for every one.
+#[tokio::test]
+async fn an_untrusted_staged_record_blocks_every_drain() {
+    enable_audit_callsites();
+    const CHUNK: ChunkId = 0xE8F;
+    for untrusted in [
+        Untrusted::ShortOwnedPlacement,
+        Untrusted::ShortPartPlacement,
+        Untrusted::UndecodableOwnedValue,
+    ] {
+        let meta = Meta::default();
+        let id = staged_elsewhere(&meta, "e3", 0xE80);
+        untrusted.seed(&meta, &id, CHUNK);
+        drain(&meta).await;
+
+        assert_eq!(
+            status(&meta).await,
+            ReconciliationStatus::PendingMalformed {
+                chunks: vec![CHUNK],
+            },
+            "{untrusted:?}: a staged record that cannot be trusted about where its chunk is must \
+             block the drain under that chunk's id"
+        );
+    }
+}
+
+/// **(E)(ii)** Untrusted placements in both classes at once — a committed object with two
+/// malformed chunks, a staged part placing one of them untrustworthily too, and an owned entry
+/// placing a third chunk untrustworthily — are named once each, in chunk order. The chunk ids
+/// interleave the two classes, so the answer's order is the sort's, not either class's.
+///
+/// Base: only the two committed chunks are named.
+#[tokio::test]
+async fn untrusted_placements_of_both_classes_are_each_named_once() {
+    enable_audit_callsites();
+    const SHARED: ChunkId = 0xEC5;
+    const STAGED_ONLY: ChunkId = 0xEC6;
+    const COMMITTED_ONLY: ChunkId = 0xEC7;
+    let meta = Meta::default();
+    let id = staged_elsewhere(&meta, "e4", 0xEC0);
+    Untrusted::ShortPartPlacement.seed(&meta, &id, SHARED);
+    Untrusted::ShortOwnedPlacement.seed(&meta, &id, STAGED_ONLY);
+    meta.seed(
+        inode_key(9),
+        committed(&[
+            (SHARED, RS_2_1_SCHEME, &[0]),
+            (COMMITTED_ONLY, RS_2_1_SCHEME, &[0]),
+        ]),
+    );
+    drain(&meta).await;
+
+    assert_eq!(
+        status(&meta).await,
+        ReconciliationStatus::PendingMalformed {
+            chunks: vec![SHARED, STAGED_ONLY, COMMITTED_ONLY],
+        },
+        "every untrusted chunk blocks the drain, each named once, in chunk order"
+    );
+}
+
+/// **(E)(iii)** A store fault under the staged reading leaves the query without that class, so it
+/// answers nothing rather than an answer drawn without it: the listing of sessions fails, and the
+/// query returns `Err` — never `Satisfied`.
+///
+/// Base: `Satisfied` — the query never reads the listing.
+#[tokio::test]
+async fn a_store_fault_under_the_staged_reading_fails_the_query() {
+    enable_audit_callsites();
+    let meta = Meta::default();
+    staged_elsewhere(&meta, "e5", 0xEF0);
+    drain(&meta).await;
+    meta.fail_reads_of(MPU_PREFIX);
+
+    let answer = reconciliation_status(&meta, DRAINED).await;
+    assert!(
+        answer.is_err(),
+        "a query that could not read the staged class must fail, not answer: {answer:?}"
+    );
+}
+
+// ---- the read order -----------------------------------------------------------------------------
+
+/// A committed part names a chunk on [`DRAINED`], and its upload publishes **during** the query:
+/// the object's committed inode appears naming the chunk where the part placed it, and the part
+/// record its retirement drains is gone — both in one batch, landing right after whichever of the
+/// part range and the committed namespace the query reads first. Read staged first, the query sees
+/// the chunk in the part record and then in the inode; read committed first, it sees it in
+/// neither, and answers `Satisfied` over a live object's bytes (`0016:793-800`).
+///
+/// Base: `Satisfied` — the query reads the committed namespace alone, before the publication.
+#[tokio::test]
+async fn a_publication_during_the_query_cannot_hide_a_chunk_from_both_classes() {
+    enable_audit_callsites();
+    const CHUNK: ChunkId = 0xF01;
+    let meta = Meta::default();
+    let id = open(&meta, "0f");
+    stage_part(&meta, &id, 1, CHUNK, SINGLE, &[DRAINED]);
+    drain(&meta).await;
+    let part_record = part_key(&id, part_no(1));
+    meta.hook(
+        &[&part_range(&id), b"inode:"],
+        WriteBatch::new()
+            .put(
+                inode_key(PUBLISHED),
+                committed(&[(CHUNK, EcScheme::None, &[DRAINED])]),
+            )
+            .delete(part_record.clone()),
+    );
+
+    let status = status(&meta).await;
+    assert!(
+        meta.holds(&inode_key(PUBLISHED)) && !meta.holds(&part_record),
+        "the publication must land during the query, or this leg races nothing"
+    );
+    assert_eq!(
+        status,
+        ReconciliationStatus::Pending,
+        "the published chunk is on the drained server throughout; a publication racing the query \
+         must not hide it from both classes"
+    );
+}
