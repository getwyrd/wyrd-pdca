+// ---- M4.6 metadata-swap Tier-1 / Tier-2 runners (proposal 0015 PR item 6, #257) ----
+//
+// The pure routing + nemesis-plan decisions live in `crate::meta_dispatch` (exposed via
+// the xtask lib target and unit-tested at Check by `xtask/tests/meta_dispatch_
+// orchestration.rs`). These runners are the *privileged* side: they gate on the opt-in
+// var + `docker`, stand up the `deploy/` TiKV, drive the routed `wyrd-metadata-tikv`
+// scenario, and — for the Jepsen leg — actually inject a **process-pause nemesis on the
+// single TiKV data node** (`docker compose pause tikv`), synchronized with live load via
+// a handshake, checking every compose result so an un-injected fault fails loudly.
+
+use crate::meta_dispatch::{
+    meta_dispatch, nemesis_pd_services, nemesis_plan, MetaDispatch, MetaTier,
+    META_DATA_PLANE_SERVICE, META_FAULT_SIGNAL_VAR,
+};
+
+/// **Tier-1 metadata integration** (proposal 0015 §"DST and tests" → "Integration"):
+/// stand up the real containerized TiKV-backed cluster (the `deploy/` stack, slice 5 /
+/// #256), export its PD endpoints, and drive the production `MetadataStore` end-to-end —
+/// PUT/GET + multi-key atomic create/rename/delete, all-or-nothing under contention —
+/// behind the **unchanged** trait. Opt in with `WYRD_TIER1=1`; needs `docker`.
+/// Deferred/off-Check by default (skips cleanly).
+pub fn run_meta_integration() -> Result<(), String> {
+    run_meta_tier(MetaTier::Integration)
+}
+
+/// **Tier-1 Jepsen against TiKV** (proposal 0015 §"DST and tests" → "Jepsen consistency"):
+/// a nemesis process-pauses the **single TiKV data node** (the metadata store — the
+/// `wyrd-testkit` `MetaFault::Pause` seam, applied via `docker compose pause tikv`)
+/// concurrently with a CAS/read load, and the scenario validates the single-zone
+/// consistency clauses across the stall-and-resume. Opt in with `WYRD_TIER1=1`; needs
+/// `docker`. Deferred/off-Check by default.
+pub fn run_meta_jepsen() -> Result<(), String> {
+    run_meta_tier(MetaTier::Jepsen)
+}
+
+/// **Tier-2 single-node metadata I/O** (proposal 0015 §"DST and tests" → "Tier-2"): a run
+/// on one real machine against real TiKV — real `fsync`, real NVMe, real OS — for honest
+/// single-node I/O semantics. Opt in with `WYRD_TIER2=1`; needs `docker`. Deferred/off-Check
+/// by default.
+pub fn run_meta_tier2() -> Result<(), String> {
+    run_meta_tier(MetaTier::Tier2)
+}
+
+/// Shared body for the three metadata-swap legs: gate on the leg's opt-in var + `docker`
+/// ([`plan`]), then route via [`meta_dispatch`] and run the in-repo scenario against a
+/// freshly stood-up `deploy/` TiKV.
+fn run_meta_tier(tier: MetaTier) -> Result<(), String> {
+    let dispatch = meta_dispatch(tier);
+    let label = match tier {
+        MetaTier::Integration => "Tier-1 metadata integration (TiKV)",
+        MetaTier::Jepsen => "Tier-1 Jepsen consistency (TiKV metadata swap)",
+        MetaTier::Tier2 => "Tier-2 single-node metadata I/O (TiKV)",
+    };
+    match plan(
+        label,
+        "docker",
+        opted_in(dispatch.opt_in_var),
+        tool_available("docker"),
+    ) {
+        Plan::Deferred(reason) => {
+            eprintln!("xtask: {reason}");
+            return Ok(());
+        }
+        Plan::MissingTool(msg) => return Err(msg),
+        Plan::Run => {}
+    }
+    run_meta_scenario(tier, dispatch)
+}
+
+/// The `deploy/` compose file each metadata leg stands its cluster up from. Tier-1
+/// (integration + Jepsen) runs the multi-node stack (slice 5 / #256, static endpoints per
+/// the Deployment-prerequisite note); Tier-2 runs the throwaway single-node stack (one
+/// failure domain — I/O honesty, not failure-domain independence).
+fn meta_compose_file(tier: MetaTier) -> std::path::PathBuf {
+    let rel = match tier {
+        MetaTier::Integration | MetaTier::Jepsen => "deploy/small-multi-node/docker-compose.yml",
+        MetaTier::Tier2 => "deploy/tikv-single-node/docker-compose.yml",
+    };
+    crate::workspace_root().join(rel)
+}
+
+/// The PD client endpoints the metadata scenario dials — the host-published static
+/// endpoints (per the Deployment-prerequisite note; #365 L5-discovery is a later slice).
+/// The multi-node stack publishes its 3-member PD ensemble on `23791..=23793`; the
+/// single-node stack on `2379`.
+fn meta_pd_endpoints(tier: MetaTier) -> &'static str {
+    match tier {
+        MetaTier::Integration | MetaTier::Jepsen => {
+            "127.0.0.1:23791,127.0.0.1:23792,127.0.0.1:23793"
+        }
+        MetaTier::Tier2 => "127.0.0.1:2379",
+    }
+}
+
+/// Bring the `deploy/` TiKV up, wait for PD, run the routed `wyrd-metadata-tikv` scenario
+/// with `WYRD_TIKV_PD_ENDPOINTS` exported (and `--features tikv`); for the Jepsen leg, run
+/// the process-pause nemesis concurrently against the live TiKV node. Tear the stack down
+/// unconditionally afterward.
+fn run_meta_scenario(tier: MetaTier, dispatch: MetaDispatch) -> Result<(), String> {
+    let compose = meta_compose_file(tier).to_string_lossy().to_string();
+    let project = format!("wyrd-{}-m46", dispatch.test.replace('_', "-"));
+    let pd = meta_pd_endpoints(tier);
+
+    meta_compose(&project, &compose, &["up", "-d"])?;
+    // Wait for the first published PD member before driving load / injecting faults.
+    let first_pd = pd.split(',').next().unwrap_or(pd);
+    let result = crate::wait_for_port(first_pd).and_then(|()| {
+        if tier == MetaTier::Jepsen {
+            run_meta_jepsen_with_nemesis(dispatch, pd, &project, &compose)
+        } else {
+            run_meta_scenario_test(dispatch, pd, None, None)
+        }
+    });
+    let _ = meta_compose(&project, &compose, &["down", "-v", "--remove-orphans"]);
+    result?;
+    println!(
+        "\nxtask: {} scenario passed against real TiKV",
+        dispatch.test
+    );
+    Ok(())
+}
+
+/// Run the Jepsen scenario while a reproducible **process-pause nemesis on the single TiKV
+/// data node** is actually injected, synchronized so it **provably overlaps live load**.
+///
+/// The correction over the earlier attempts (which paused a PD minority, leaving the sole
+/// data node serving CAS locally — proving nothing): the primary fault is on the metadata
+/// store *itself* (`docker compose pause tikv`, a real container `SIGSTOP`), a bounded
+/// stall the load loop straddles. The seed (`WYRD_TIER1_SEED`, default `0`) draws the
+/// window through the `wyrd-testkit` [`nemesis_plan`] seam so a bug-finding run replays
+/// (ADR-0009).
+///
+/// **Synchronization handshake:** the scenario is a fresh `cargo test` subprocess that has
+/// to compile + connect + seed before its load overlaps anything. So the runner passes it
+/// a signal-file path ([`META_FAULT_SIGNAL_VAR`]); the scenario creates that file *after*
+/// it has connected, seeded, and begun its CAS load; the runner **waits for the file**,
+/// then pauses `tikv` (the fault now provably overlaps live load), holds the window, and
+/// unpauses. Every `docker compose` result is checked — a pause/unpause that failed to
+/// apply is a hard error, never a silent no-op that lets the leg pass without a fault.
+fn run_meta_jepsen_with_nemesis(
+    dispatch: MetaDispatch,
+    pd: &str,
+    project: &str,
+    compose: &str,
+) -> Result<(), String> {
+    let seed = std::env::var("WYRD_TIER1_SEED")
+        .ok()
+        .and_then(|s| s.parse::<u64>().ok())
+        .unwrap_or(0);
+    let plan = nemesis_plan(seed);
+    if !plan.data_plane_fault_is_healable() {
+        return Err(format!(
+            "meta-jepsen seed={seed}: the data-node fault is not healable ({:?}) — refusing \
+             to indefinitely down the sole metadata replica",
+            plan.data_plane_fault()
+        ));
+    }
+    let window = plan
+        .data_plane_fault()
+        .window_ms()
+        .expect("a healable data-plane fault has a window");
+    let pd_services = nemesis_pd_services(seed);
+    let nemesis_nodes = plan
+        .faulted_pd_nodes()
+        .iter()
+        .map(usize::to_string)
+        .collect::<Vec<_>>()
+        .join(",");
+    println!(
+        "\nxtask meta-jepsen: seed={seed} process-pauses the TiKV data node \
+         `{META_DATA_PLANE_SERVICE}` for {window}ms (a majority PD quorum survives: \
+         faulting PD {pd_services:?})"
+    );
+
+    // The handshake signal file: the scenario creates it once its load is live.
+    let signal = crate::workspace_root()
+        .join("target")
+        .join(format!("tier1-jepsen-meta-{seed}.ready"));
+    let _ = std::fs::remove_file(&signal);
+    if let Some(dir) = signal.parent() {
+        std::fs::create_dir_all(dir).map_err(|e| format!("create {}: {e}", dir.display()))?;
+    }
+    let signal_str = signal.to_string_lossy().to_string();
+
+    // Drive the scenario subprocess on a background thread; inject the fault from here once
+    // the scenario signals its load is live, so the pause provably overlaps live load.
+    let dispatch_owned = dispatch;
+    let pd_owned = pd.to_string();
+    let nodes_owned = nemesis_nodes.clone();
+    let signal_for_test = signal_str.clone();
+    let scenario = std::thread::spawn(move || {
+        run_meta_scenario_test(
+            dispatch_owned,
+            &pd_owned,
+            Some(&nodes_owned),
+            Some(&signal_for_test),
+        )
+    });
+
+    // Wait for the scenario to signal its load is live (bounded), then inject the pause.
+    let injected = wait_for_signal(&signal, std::time::Duration::from_secs(180)).and_then(|()| {
+        // Partition the PD minority first (keeps a quorum), then pause the data node.
+        for svc in &pd_services {
+            meta_compose(project, compose, &["pause", svc])?;
+        }
+        meta_compose(project, compose, &["pause", META_DATA_PLANE_SERVICE])?;
+        std::thread::sleep(std::time::Duration::from_millis(window));
+        // Heal: unpause the data node and the PD minority.
+        meta_compose(project, compose, &["unpause", META_DATA_PLANE_SERVICE])?;
+        for svc in &pd_services {
+            meta_compose(project, compose, &["unpause", svc])?;
+        }
+        Ok(())
+    });
+
+    // Always join the scenario (and always try to heal on an injection error) so the
+    // cluster is not left paused before teardown.
+    if injected.is_err() {
+        let _ = meta_compose(project, compose, &["unpause", META_DATA_PLANE_SERVICE]);
+        for svc in &pd_services {
+            let _ = meta_compose(project, compose, &["unpause", svc]);
+        }
+    }
+    let scenario_result = scenario
+        .join()
+        .map_err(|_| "meta-jepsen scenario thread panicked".to_string())?;
+    let _ = std::fs::remove_file(&signal);
+    injected?;
+    scenario_result
+}
+
+/// Poll for the scenario's handshake signal file, up to `timeout`. A timeout is a hard
+/// error: it means the scenario never signalled a live load, so injecting the fault could
+/// not have overlapped it — exactly the un-synchronized-nemesis defect this guards against.
+fn wait_for_signal(signal: &std::path::Path, timeout: std::time::Duration) -> Result<(), String> {
+    let deadline = std::time::Instant::now() + timeout;
+    while std::time::Instant::now() < deadline {
+        if signal.exists() {
+            return Ok(());
+        }
+        std::thread::sleep(std::time::Duration::from_millis(100));
+    }
+    Err(format!(
+        "meta-jepsen: the scenario never signalled a live load at {} within {:?} — the \
+         nemesis could not be synchronized to overlap load; refusing to claim a fault ran",
+        signal.display(),
+        timeout
+    ))
+}
+
+/// Run the routed metadata scenario (`--features tikv`, `--ignored`) with the resolved PD
+/// endpoints exported so the test dials the live cluster. The invocation is built from the
+/// [`meta_dispatch`] decision — package + test — so re-routing a leg changes exactly this
+/// argv. For the Jepsen leg it also passes the nemesis plan + the handshake signal path.
+fn run_meta_scenario_test(
+    dispatch: MetaDispatch,
+    pd_endpoints: &str,
+    nemesis_nodes: Option<&str>,
+    fault_signal: Option<&str>,
+) -> Result<(), String> {
+    let args = [
+        "test",
+        "-p",
+        dispatch.package,
+        "--features",
+        "tikv",
+        "--test",
+        dispatch.test,
+        "--",
+        "--ignored",
+        "--nocapture",
+    ];
+    crate::print_step(&{
+        let mut display = vec!["cargo"];
+        display.extend_from_slice(&args);
+        display
+    });
+    let mut cmd = Command::new("cargo");
+    cmd.args(args)
+        .current_dir(crate::workspace_root())
+        .env("WYRD_TIKV_PD_ENDPOINTS", pd_endpoints);
+    if let Some(nodes) = nemesis_nodes {
+        // The reproducible, quorum-safe PD-minority schedule (diagnostic reproduction).
+        cmd.env("WYRD_TIER1_NEMESIS_NODES", nodes);
+    }
+    if let Some(signal) = fault_signal {
+        // The handshake: the scenario creates this file once its CAS load is live, and the
+        // runner waits for it before pausing the data node.
+        cmd.env(META_FAULT_SIGNAL_VAR, signal);
+    }
+    let status = cmd
+        .status()
+        .map_err(|e| format!("failed to spawn cargo for {}: {e}", dispatch.test))?;
+    if status.success() {
+        Ok(())
+    } else {
+        Err(format!("{} scenario failed with {status}", dispatch.test))
+    }
+}
+
+/// Run a `docker compose -p <project> -f <file> …` for a metadata leg's `deploy/` stack,
+/// **checking the result** — a failed `pause`/`unpause` is a hard error (never the silent
+/// `let _ =` no-op that would let a Jepsen leg pass with the nemesis un-applied).
+fn meta_compose(project: &str, compose: &str, args: &[&str]) -> Result<(), String> {
+    let mut full = vec!["compose", "-p", project, "-f", compose];
+    full.extend_from_slice(args);
+    let mut display = vec!["docker"];
+    display.extend_from_slice(&full);
+    crate::print_step(&display);
+    let status = Command::new("docker")
+        .args(&full)
+        .current_dir(crate::workspace_root())
+        .status()
+        .map_err(|e| format!("failed to spawn docker: {e}"))?;
+    if status.success() {
+        Ok(())
+    } else {
+        Err(format!("`docker {}` failed with {status}", full.join(" ")))
+    }
+}
+
