+//! **M4.6 metadata-swap runner dispatch — a Check-observable flippable** (#257;
+//! proposal 0015 §"DST and tests", §"Suggested PR sequence" item 6; the defect statement
+//! "the tree's realism-ladder tiers exercise the M2/M3 chunkstore + repair path, not the
+//! metadata swap"). Mirrors `xtask/tests/disk_faults_orchestration.rs`.
+//!
+//! **Why this file exists.** The load-bearing tier green (a live TiKV cluster under a real
+//! nemesis) is DEFERRED / privileged-off-Check. The deliverable that IS proven at Check is
+//! the pure runner **dispatch/routing + nemesis-plan** decision ([`xtask::meta_dispatch`]).
+//! Being an added integration test (`xtask/tests/*.rs`), the per-fix `C4-verify` gate keeps
+//! it while reverting the production change: with `xtask/src/meta_dispatch.rs` removed (and
+//! its `pub mod meta_dispatch` gone from `lib.rs`), `use xtask::meta_dispatch::…` fails to
+//! resolve and this target goes **RED**; with the module present it goes **GREEN**.
+//!
+//! **The oracles are not tautologies.** A prior attempt asserted the same string literals
+//! the dispatch returns (a matching typo in literal + expectation passes green), and only
+//! checked each leg's file *exists* (a leg-crossing bug — Jepsen routed to the integration
+//! scenario — stays green). Here:
+//!  - the route is **resolved against the real workspace**: the routed `package` must equal
+//!    the crate's actual `Cargo.toml` `name`, and the routed `--test <name>` must be an
+//!    **existing** `tests/<name>.rs` file (the filesystem is the oracle, not a mirror);
+//!  - the three legs are pinned to **pairwise-distinct** scenarios, and each leg is pinned
+//!    to its own scenario by a **behavioral marker** in the routed file (only the Jepsen
+//!    leg's scenario performs the nemesis handshake), so a leg-crossing re-route goes red.
+//!
+//! **Determinism (the gate-honesty fix).** This test reads only files THIS patch adds
+//! (`crates/metadata-tikv/tests/*.rs`), never a not-yet-landed deploy artifact — so it
+//! cannot panic on a missing `deploy/` file and `cargo xtask ci` stays deterministically
+//! green with no TiKV (brief.md invariant "Gate honesty").
+
+use std::path::{Path, PathBuf};
+
+use xtask::meta_dispatch::{
+    meta_dispatch, nemesis_pd_services, nemesis_plan, pd_service, MetaTier,
+    META_DATA_PLANE_SERVICE, META_FAULT_SIGNAL_VAR, META_JEPSEN_PD_NODES,
+};
+
+/// The workspace root, resolved from this crate's manifest dir (`…/xtask`) → parent.
+fn workspace_root() -> PathBuf {
+    Path::new(env!("CARGO_MANIFEST_DIR"))
+        .parent()
+        .expect("xtask has a parent workspace dir")
+        .to_path_buf()
+}
+
+/// Read the `name = "…"` from a crate's `Cargo.toml` (`[package]` name).
+fn crate_name(manifest_dir: &Path) -> String {
+    let toml = std::fs::read_to_string(manifest_dir.join("Cargo.toml"))
+        .unwrap_or_else(|e| panic!("read {}: {e}", manifest_dir.join("Cargo.toml").display()));
+    for line in toml.lines() {
+        let line = line.trim();
+        if let Some(rest) = line.strip_prefix("name") {
+            if let Some(eq) = rest.trim_start().strip_prefix('=') {
+                return eq.trim().trim_matches('"').to_string();
+            }
+        }
+    }
+    panic!(
+        "no `name = ` in {}",
+        manifest_dir.join("Cargo.toml").display()
+    );
+}
+
+/// The source of a leg's routed `--test` file (the behavioral-marker oracle reads it).
+fn routed_test_source(tier: MetaTier) -> String {
+    let d = meta_dispatch(tier);
+    let file = workspace_root()
+        .join(d.manifest_dir)
+        .join("tests")
+        .join(format!("{}.rs", d.test));
+    std::fs::read_to_string(&file).unwrap_or_else(|e| panic!("read {}: {e}", file.display()))
+}
+
+const CHUNKSTORE_PACKAGE: &str = "wyrd-chunkstore-grpc";
+const CHUNKSTORE_JEPSEN_TEST: &str = "tier1_jepsen_consistency";
+
+/// Every metadata leg routes to a **real, runnable** `wyrd-metadata-tikv` `--test` target —
+/// resolved against the actual `Cargo.toml` name and the actual test file on disk — and
+/// never to the M2/M3 chunkstore repair path.
+#[test]
+fn every_meta_leg_routes_to_a_real_metadata_swap_target() {
+    let root = workspace_root();
+    for tier in [MetaTier::Integration, MetaTier::Jepsen, MetaTier::Tier2] {
+        let d = meta_dispatch(tier);
+
+        // --- it must be the metadata swap, not the chunkstore repair path ---
+        assert_ne!(
+            d.package, CHUNKSTORE_PACKAGE,
+            "{tier:?} must NOT route to the M2/M3 chunkstore crate (the wrong system)"
+        );
+        assert_ne!(
+            d.test, CHUNKSTORE_JEPSEN_TEST,
+            "{tier:?} must NOT reuse the chunkstore repair Jepsen scenario"
+        );
+
+        // --- the route RESOLVES to a real target (filesystem is the oracle) ---
+        let manifest_dir = root.join(d.manifest_dir);
+        assert!(
+            manifest_dir.join("Cargo.toml").is_file(),
+            "{tier:?} routes to manifest_dir {:?} which has no Cargo.toml",
+            d.manifest_dir
+        );
+        assert_eq!(
+            crate_name(&manifest_dir),
+            d.package,
+            "{tier:?}: routed package must equal the crate's real Cargo.toml name at {:?}",
+            d.manifest_dir
+        );
+        let test_file = manifest_dir.join("tests").join(format!("{}.rs", d.test));
+        assert!(
+            test_file.is_file(),
+            "{tier:?}: routed `--test {}` must resolve to an existing target file {test_file:?} \
+             — a typo cannot pass, the file must actually exist to be `cargo test`-runnable",
+            d.test
+        );
+    }
+}
+
+/// The three legs route to **pairwise-distinct** scenarios — a leg-crossing re-route that
+/// pointed two legs at one file (or reused another leg's scenario) is caught here.
+#[test]
+fn the_three_legs_route_to_distinct_scenarios() {
+    let names: Vec<&str> = [MetaTier::Integration, MetaTier::Jepsen, MetaTier::Tier2]
+        .into_iter()
+        .map(|t| meta_dispatch(t).test)
+        .collect();
+    let unique: std::collections::BTreeSet<&str> = names.iter().copied().collect();
+    assert_eq!(
+        unique.len(),
+        names.len(),
+        "each metadata leg must route to its own distinct scenario, got {names:?}"
+    );
+}
+
+/// **Leg-crossing oracle.** Only the *Jepsen* leg's scenario performs the runner↔scenario
+/// nemesis handshake (it reads [`META_FAULT_SIGNAL_VAR`]); the integration and Tier-2
+/// scenarios do not. So if the Jepsen leg were re-routed to the integration/Tier-2
+/// scenario (or vice-versa) the marker would land on the wrong file and this fails —
+/// catching a crossing that a mere "the file exists" check misses.
+#[test]
+fn only_the_jepsen_leg_routes_to_the_nemesis_scenario() {
+    let jepsen = routed_test_source(MetaTier::Jepsen);
+    assert!(
+        jepsen.contains(META_FAULT_SIGNAL_VAR),
+        "the Jepsen leg must route to the scenario that performs the nemesis handshake \
+         ({META_FAULT_SIGNAL_VAR}); it does not — a leg-crossing re-route?"
+    );
+    for other in [MetaTier::Integration, MetaTier::Tier2] {
+        assert!(
+            !routed_test_source(other).contains(META_FAULT_SIGNAL_VAR),
+            "{other:?} must NOT route to the nemesis (Jepsen) scenario — its scenario \
+             performs no {META_FAULT_SIGNAL_VAR} handshake"
+        );
+    }
+}
+
+/// The opt-in vars gate the three legs onto the right off-Check jobs, so a Check/dev box
+/// (neither var set) defers all three.
+#[test]
+fn opt_in_vars_partition_tier1_from_tier2() {
+    assert_eq!(
+        meta_dispatch(MetaTier::Integration).opt_in_var,
+        "WYRD_TIER1"
+    );
+    assert_eq!(meta_dispatch(MetaTier::Jepsen).opt_in_var, "WYRD_TIER1");
+    assert_eq!(meta_dispatch(MetaTier::Tier2).opt_in_var, "WYRD_TIER2");
+}
+
+/// **The nemesis actually faults the data plane.** The load-bearing nemesis process-pauses
+/// the **single TiKV data node** (`tikv`), healably, and — separately — keeps a PD majority
+/// by faulting only a quorum-safe minority. This directly encodes the correction over the
+/// earlier attempts (which faulted only a PD minority and never the data node, leaving it
+/// serving CAS locally — proving nothing under fault).
+#[test]
+fn nemesis_pauses_the_data_node_healably_and_keeps_pd_quorum() {
+    let n = META_JEPSEN_PD_NODES;
+    assert!(
+        n >= 3,
+        "single-zone Jepsen needs a real PD quorum ensemble; got n={n}"
+    );
+    // The data-plane target is the sole TiKV metadata node, not a PD node.
+    assert_eq!(META_DATA_PLANE_SERVICE, "tikv");
+    assert!(
+        (0..n).all(|i| pd_service(i) != META_DATA_PLANE_SERVICE),
+        "the data-plane service must be the TiKV node, never a PD service"
+    );
+
+    for seed in 0..16u64 {
+        let plan = nemesis_plan(seed);
+        // Reproducible.
+        assert_eq!(
+            plan,
+            nemesis_plan(seed),
+            "seed {seed} plan must be reproducible"
+        );
+        // The data node is faulted, healably (the primary nemesis).
+        assert!(
+            plan.data_plane_fault_is_healable(),
+            "seed {seed}: the TiKV data node must be faulted healably, got {:?}",
+            plan.data_plane_fault()
+        );
+        // A PD majority survives.
+        assert!(
+            plan.pd_quorum_survives(),
+            "seed {seed}: faulting PD {:?} of {n} must leave a MAJORITY quorum",
+            plan.faulted_pd_nodes()
+        );
+        // Each faulted PD node maps to a real `pd<i>` service; the convenience path agrees.
+        let services = nemesis_pd_services(seed);
+        assert_eq!(
+            services,
+            plan.faulted_pd_nodes()
+                .into_iter()
+                .map(pd_service)
+                .collect::<Vec<_>>()
+        );
+        assert!(
+            services.iter().all(|s| s.starts_with("pd")),
+            "seed {seed}: PD nemesis services must be pd<i>, got {services:?}"
+        );
+    }
+}
