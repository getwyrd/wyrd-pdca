--- /dev/null
+++ b/crates/metadata-tikv/tests/tier1_jepsen_metadata.rs
@@ -0,0 +1,240 @@
+//! **Tier-1 Jepsen consistency over the metadata swap** (M4.6, #257; proposal 0015
+//! §"DST and tests" → "Jepsen consistency", §"Suggested PR sequence" item 6) — the
+//! realism-ladder Jepsen leg extended across the redb→TiKV **metadata** backend swap.
+//!
+//! The Jepsen line began at M2 over the networked chunkstore path
+//! (`crates/chunkstore-grpc/tests/tier1_jepsen_consistency.rs`) and is extended here
+//! across the backend swap. The metadata store in `deploy/small-multi-node` is a **single
+//! TiKV node** (one `tikv` service), so the honest single-zone nemesis is a **real process
+//! pause of that data node itself** — `cargo xtask meta-jepsen` `docker compose pause`s
+//! `tikv` (a container `SIGSTOP`) for a bounded window, then unpauses it, *concurrent with*
+//! this test's CAS/read load. (Faulting a PD minority instead — an earlier attempt — leaves
+//! the sole data node serving CAS locally and proves nothing; the data node must itself be
+//! faulted. A separate PD minority is also paused, but the load-bearing fault is on `tikv`.)
+//!
+//! **Jepsen semantics under a single-replica pause.** While the sole data node is frozen it
+//! is *unavailable*, so an operation may legitimately fail (`Err` — a timeout), OR block
+//! until the node resumes. What must **never** happen — the property this leg pins — is a
+//! **consistency** violation across the pause-and-resume (proposal 0015; ADR-0015):
+//! - **exactly-one-winner:** for a `require`-guarded key, at most **one** racer ever reports
+//!   `Committed` (never two winners); losers are `Conflict`, and `Err` is a tolerated
+//!   *unavailability*, never a second silent winner.
+//! - **clause 2 — commit-point linearizability:** once a key has a committed winner, every
+//!   subsequent read (retried past the pause) returns **that** value, and it is stable.
+//!
+//! We additionally require the cluster to **recover** — at least one round commits across
+//! the run — so a run where the node never came back (everything `Err`) does not pass
+//! vacuously.
+//!
+//! Single-zone only (clause 1 collapses into zonal linearizability; Tier-3/multi-region
+//! does not begin until M9, §13.4).
+//!
+//! **The nemesis is injected by the runner, synchronized to overlap live load.** This body
+//! **refuses to run without the runner's handshake** (`WYRD_TIER1_FAULT_SIGNAL`): it creates
+//! that signal file only once its load is live, and the runner waits for the file before
+//! pausing `tikv`, so the fault provably overlaps load. A Jepsen leg run without the
+//! handshake (no nemesis) would prove nothing — so it fails loudly rather than passing.
+//!
+//! **Gated** like every tier test: `#[ignore]` + a clean skip when `WYRD_TIKV_PD_ENDPOINTS`
+//! is unset, so `cargo xtask ci` compiles the body but never runs it.
+
+/// The PD endpoints, or `None` when TiKV is not configured — the family-wide skip gate.
+fn pd_endpoints() -> Option<Vec<String>> {
+    match std::env::var("WYRD_TIKV_PD_ENDPOINTS") {
+        Ok(raw) if !raw.trim().is_empty() => Some(
+            raw.split(',')
+                .map(|e| e.trim().to_string())
+                .filter(|e| !e.is_empty())
+                .collect(),
+        ),
+        _ => None,
+    }
+}
+
+/// The runner's handshake signal-file path (the test creates it once its load is live and
+/// the runner waits for it before injecting the pause), or `None` if no nemesis was wired.
+fn fault_signal_path() -> Option<std::path::PathBuf> {
+    match std::env::var("WYRD_TIER1_FAULT_SIGNAL") {
+        Ok(p) if !p.trim().is_empty() => Some(std::path::PathBuf::from(p.trim())),
+        _ => None,
+    }
+}
+
+#[test]
+#[ignore = "Tier-1: needs a real containerized TiKV + fault injection — run via `cargo xtask meta-jepsen`"]
+fn commit_point_linearizable_and_exactly_one_winner_across_a_data_node_pause() {
+    let Some(endpoints) = pd_endpoints() else {
+        eprintln!(
+            "tier1_jepsen_metadata: WYRD_TIKV_PD_ENDPOINTS unset — skipping (clean skip; the \
+             gate stays green without a TiKV). Run `cargo xtask meta-jepsen`."
+        );
+        return;
+    };
+    // A Jepsen run with no injected nemesis proves nothing — refuse it. `cargo xtask
+    // meta-jepsen` always wires the handshake; running this target by hand without it is
+    // the configuration error we surface loudly rather than pass silently.
+    let signal = fault_signal_path().unwrap_or_else(|| {
+        panic!(
+            "tier1_jepsen_metadata: WYRD_TIER1_FAULT_SIGNAL is absent — no nemesis handshake \
+             was wired, so no fault can be synchronized to overlap load. Run via `cargo xtask \
+             meta-jepsen`, which pauses the `tikv` data node while this load runs."
+        )
+    });
+    run(endpoints, signal);
+}
+
+#[cfg(feature = "tikv")]
+fn run(endpoints: Vec<String>, signal: std::path::PathBuf) {
+    use std::sync::Arc;
+    use std::time::{Duration, Instant};
+    use wyrd_traits::{CommitOutcome, MetadataStore, WriteBatch};
+
+    const RACERS: usize = 8;
+    const LOAD: Duration = Duration::from_secs(25); // must outlast the runner's ≤8s pause
+
+    let runtime = tokio::runtime::Builder::new_multi_thread()
+        .worker_threads(4)
+        .enable_all()
+        .build()
+        .expect("tokio runtime");
+
+    runtime.block_on(async move {
+        use futures_util::future::join_all;
+
+        let namespace = format!("wyrd-tier1-jepsen/{}/", std::process::id()).into_bytes();
+        let store = Arc::new(
+            wyrd_metadata_tikv::TikvMetadataStore::connect(endpoints)
+                .await
+                .expect("connect to TiKV")
+                .with_namespace(namespace),
+        );
+
+        // Prove connectivity with a warm-up commit BEFORE signalling the load is live, so
+        // the runner's pause lands on a genuinely serving cluster.
+        let warm = b"warmup".as_slice();
+        assert_eq!(
+            store
+                .commit(WriteBatch::new().require_absent(warm).put(warm, &b"1"[..]))
+                .await
+                .expect("warm-up commit before the fault window"),
+            CommitOutcome::Committed,
+        );
+
+        // Signal the runner: our CAS load is now live — inject the pause.
+        std::fs::write(&signal, b"live")
+            .unwrap_or_else(|e| panic!("write fault-signal {}: {e}", signal.display()));
+
+        let mut committed_rounds = 0usize;
+        let mut round = 0usize;
+        let deadline = Instant::now() + LOAD;
+        while Instant::now() < deadline {
+            round += 1;
+            let key: Vec<u8> = format!("inode:{round}").into_bytes();
+
+            // Seed the key at v0 (best-effort — during the pause this may Err; that is
+            // unavailability, tolerated). Only race rounds that were seeded.
+            let seeded = store
+                .commit(
+                    WriteBatch::new()
+                        .require_absent(&key[..])
+                        .put(&key[..], &b"v0"[..]),
+                )
+                .await;
+            if !matches!(seeded, Ok(CommitOutcome::Committed)) {
+                continue; // node unavailable (paused) — skip this round's assertions
+            }
+
+            // N racers CAS v0 → "w{i}", concurrent with the runner's data-node pause.
+            let racers = (0..RACERS).map(|i| {
+                let store = Arc::clone(&store);
+                let key = key.clone();
+                async move {
+                    store
+                        .commit(
+                            WriteBatch::new()
+                                .require(&key[..], &b"v0"[..])
+                                .put(&key[..], format!("w{i}").into_bytes()),
+                        )
+                        .await
+                }
+            });
+            let outcomes = join_all(racers).await;
+
+            let winners = outcomes
+                .iter()
+                .filter(|o| matches!(o, Ok(CommitOutcome::Committed)))
+                .count();
+            // exactly-one-winner: NEVER two winners. Zero is allowed (all racers may have
+            // hit the pause and Err'd — unavailability, not a lost update).
+            assert!(
+                winners <= 1,
+                "round {round}: at most one racer may win the CAS, saw {winners} winners \
+                 ({outcomes:?})"
+            );
+
+            if winners == 1 {
+                committed_rounds += 1;
+                // clause 2 — commit-point linearizability: the committed value is what every
+                // subsequent read observes (retried past the pause) and it is stable.
+                let observed = read_stable(&store, &key).await;
+                assert!(
+                    observed.starts_with(b"w"),
+                    "round {round}: the committed value must be a racer's write, got {:?}",
+                    String::from_utf8_lossy(&observed)
+                );
+                let again = read_stable(&store, &key).await;
+                assert_eq!(
+                    again, observed,
+                    "round {round}: the commit point must be stable (linearizable)"
+                );
+            }
+        }
+
+        // Recovery / non-vacuity: the cluster must have served across the pause-and-resume.
+        assert!(
+            committed_rounds > 0,
+            "no round ever committed across {round} rounds — the cluster never recovered \
+             from the pause, so consistency was not actually exercised"
+        );
+        eprintln!(
+            "tier1_jepsen_metadata: {committed_rounds}/{round} rounds committed across the \
+             data-node pause; exactly-one-winner and commit-point linearizability held"
+        );
+    });
+}
+
+/// Read `key` retrying past a transient unavailability (the data-node pause) until it
+/// succeeds, then return the present value. Fails only if it stays unreadable well past the
+/// pause window.
+#[cfg(feature = "tikv")]
+async fn read_stable(store: &wyrd_metadata_tikv::TikvMetadataStore, key: &[u8]) -> Vec<u8> {
+    use std::time::{Duration, Instant};
+    use wyrd_traits::MetadataStore;
+
+    let deadline = Instant::now() + Duration::from_secs(30);
+    loop {
+        match store.get(key).await {
+            Ok(Some(v)) => return v.to_vec(),
+            Ok(None) => panic!(
+                "committed key {:?} read back absent — a lost committed write",
+                String::from_utf8_lossy(key)
+            ),
+            Err(_) if Instant::now() < deadline => {
+                tokio::time::sleep(Duration::from_millis(200)).await;
+            }
+            Err(e) => panic!(
+                "key {:?} stayed unreadable past the pause window: {e}",
+                String::from_utf8_lossy(key)
+            ),
+        }
+    }
+}
+
+#[cfg(not(feature = "tikv"))]
+fn run(endpoints: Vec<String>, signal: std::path::PathBuf) {
+    let _ = (endpoints, signal);
+    eprintln!(
+        "tier1_jepsen_metadata: WYRD_TIKV_PD_ENDPOINTS is set but the crate was built without \
+         `--features tikv` — skipping. Run it via `cargo xtask meta-jepsen`."
+    );
+}
