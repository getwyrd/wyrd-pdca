+/// The **real-TiKV-cluster fault model** (proposal 0015 §"Crate touch-points":
+/// "`testkit` — a real-TiKV-cluster fault seam (**partition/latency/pause**) for the
+/// Tier-1 integration + Jepsen runs"; §"DST and tests": the M4 single-zone topology
+/// under `tc netem` / `iptables` partitions / cgroup throttling / `libfaketime` clock
+/// skew). A `MetaFault` is a **software-defined** fault the Tier-1 nemesis injects on a
+/// node of the *real* TiKV/PD metadata cluster.
+///
+/// The fault *model* lives here, free of any `tikv-client` / transport dependency, so
+/// it stays import-light (the whole-tree gate compiles it on a machine with **no** TiKV
+/// and no privileged fault injection); a Tier-1 campaign maps each variant onto the
+/// concrete privileged mechanism. The mechanism identities are illustrative (proposal
+/// 0015 Success criterion); the *model* — and the schedule [`MetaClusterFaultPlan`]
+/// draws from it — is what is load-bearing and unit-tested.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum MetaFault {
+    /// The node is **network-partitioned** — its link is cut in both directions until
+    /// the nemesis heals it (`iptables` drop / `tc netem` 100%-loss). Distinct from
+    /// [`MetaFault::Pause`]: the process keeps running, only the network is severed.
+    /// Holds until an explicit heal, so it carries **no** self-healing window.
+    Partition,
+    /// Traffic to/from the node is **delayed** by this many milliseconds (`tc netem
+    /// delay`) for a bounded window — a slow replica the commit path must not livelock
+    /// on. Self-heals when the window elapses.
+    Latency(u64),
+    /// The node's **process is frozen** for this many milliseconds (`SIGSTOP` /
+    /// cgroup-freeze / `docker compose pause`) — a stalled-then-resumed node, the
+    /// "process pause" nemesis. This is the fault `docker compose pause` **actually**
+    /// implements (a container-level `SIGSTOP`, no root required); it is *not* a network
+    /// partition. Self-heals when the window elapses (the runner `unpause`s it).
+    Pause(u64),
+    /// The node's clock is **skewed** by this signed offset in milliseconds
+    /// (`libfaketime`) — a PD timestamp-oracle stress the commit point must tolerate.
+    /// Holds until reset, so it carries no self-healing window.
+    ClockSkew(i64),
+}
+
+impl MetaFault {
+    /// The bounded self-heal window in milliseconds, if this fault is **time-bounded**
+    /// ([`Pause`](MetaFault::Pause) / [`Latency`](MetaFault::Latency)), or `None` for a
+    /// fault that holds until an explicit heal ([`Partition`](MetaFault::Partition) /
+    /// [`ClockSkew`](MetaFault::ClockSkew)).
+    ///
+    /// Load-bearing for the **single-replica data node**: the metadata store is one TiKV
+    /// node (`deploy/small-multi-node` has a single `tikv` service), so it has no peer to
+    /// fail over to. Any fault the nemesis applies to it must therefore **self-heal**
+    /// within the run (a bounded [`Pause`](MetaFault::Pause)), never an indefinite
+    /// partition of the sole replica — otherwise the store is simply down and the
+    /// consistency clauses are never observable. See
+    /// [`MetaClusterFaultPlan::data_plane_fault_is_healable`].
+    #[must_use]
+    pub fn window_ms(&self) -> Option<u64> {
+        match self {
+            MetaFault::Pause(ms) | MetaFault::Latency(ms) => Some(*ms),
+            MetaFault::Partition | MetaFault::ClockSkew(_) => None,
+        }
+    }
+}
+
+/// Decides whether — and how — to fault the TiKV/PD node at a given index. Mirrors
+/// [`NetFaultInjector`]/[`StorageFaultInjector`] for the metadata-cluster seam; the
+/// default injects nothing.
+pub trait MetaFaultInjector {
+    /// The fault to inject for the cluster node at `node_index`, or `None` to leave it
+    /// untouched.
+    fn meta_fault_for(&mut self, node_index: usize) -> Option<MetaFault>;
+}
+
+/// A **single-zone metadata-cluster** fault plan fixed once from the run seed — the
+/// metadata-seam sibling of [`SeededStorageFaults`]. Drawing the schedule from the seed
+/// is what makes a Tier-1 fault run reproducible (ADR-0009): a bug-finding seed replays
+/// the *same* schedule as a committed regression.
+///
+/// **The topology this plan is honest about** (`deploy/small-multi-node`): one **TiKV
+/// data node** (the metadata store — a single replica) and an **`m`-node PD ensemble**
+/// (a real Raft group; `m = 3`). The two are faulted on **different** invariants, which
+/// is the correction the earlier attempts missed (they faulted only a PD minority, which
+/// leaves the single data node serving CAS locally — proving nothing under fault):
+///
+/// 1. **Data plane (the load-bearing nemesis).** [`data_plane`](Self::data_plane) faults
+///    the **sole TiKV node itself** — a bounded [`Pause`](MetaFault::Pause) so it stalls
+///    then resumes. The consistency clauses (exactly-one-winner; commit-point
+///    linearizability) must hold **across** the stall-and-resume. Because the node has no
+///    replica, the fault must be **healable** (a finite window) — never an indefinite
+///    partition ([`data_plane_fault_is_healable`](Self::data_plane_fault_is_healable)).
+/// 2. **PD ensemble (quorum preservation).** [`pd_faults`](Self::pd_faults) may fault a
+///    **strict minority** of the PD ensemble ([`pd_quorum_safe_max`](Self::pd_quorum_safe_max))
+///    so a majority quorum — the timestamp oracle — always survives. Faulting a PD
+///    majority would stall the whole cluster, so nothing about consistency could be
+///    observed (proposal 0015 §"DST and tests"; ADR-0015 clause 2).
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct MetaClusterFaultPlan {
+    pd_ensemble: usize,
+    pd_faults: std::collections::BTreeMap<usize, MetaFault>,
+    data_plane: MetaFault,
+}
+
+impl MetaClusterFaultPlan {
+    /// The maximum number of PD nodes the nemesis may fault while a quorum **majority**
+    /// still survives in an `n`-node ensemble: a strict minority, `⌊(n-1)/2⌋`
+    /// (`n=3 → 1`, `n=5 → 2`, `n=7 → 3`; and for even `n`, `n=4 → 1`, `n=6 → 2`).
+    /// Faulting more isolates the quorum, so the consistency clauses could never be
+    /// observed (proposal 0015 §"DST and tests"; ADR-0015 clause 2).
+    #[must_use]
+    pub fn pd_quorum_safe_max(n: usize) -> usize {
+        n.saturating_sub(1) / 2
+    }
+
+    /// Draw the reproducible single-zone fault schedule from `seed` for a cluster with an
+    /// `pd_ensemble`-node PD group and a single TiKV data node.
+    ///
+    /// - The **data-plane** fault is a bounded [`Pause`](MetaFault::Pause) of the sole
+    ///   TiKV node, with a seed-derived window in `[3000, 8000)` ms — a stall the load
+    ///   loop straddles. It is always present (the data node is *always* faulted — that
+    ///   is the nemesis that actually stresses the metadata store) and always healable.
+    /// - The **PD** faults are a quorum-safe strict minority
+    ///   ([`pd_quorum_safe_max`](Self::pd_quorum_safe_max)), each a bounded
+    ///   [`Pause`](MetaFault::Pause), drawn from the same seed by the identical
+    ///   Fisher–Yates prefix shuffle the other seams use.
+    #[must_use]
+    pub fn from_seed(seed: u64, pd_ensemble: usize) -> Self {
+        let mut rng = ChaCha8Rng::seed_from_u64(seed);
+
+        // The data node is ALWAYS faulted — a bounded pause it must recover from.
+        let data_window = 3000 + (rng.next_u32() as u64) % 5000; // [3000, 8000)
+        let data_plane = MetaFault::Pause(data_window);
+
+        // A quorum-safe strict minority of PD nodes, drawn deterministically.
+        let max = Self::pd_quorum_safe_max(pd_ensemble);
+        let mut indices: Vec<usize> = (0..pd_ensemble).collect();
+        let take = max.min(pd_ensemble);
+        for i in 0..take {
+            let j = i + (rng.next_u32() as usize) % (pd_ensemble - i);
+            indices.swap(i, j);
+        }
+        let pd_faults = indices
+            .into_iter()
+            .take(take)
+            .map(|index| {
+                let win = 2000 + (rng.next_u32() as u64) % 3000; // [2000, 5000)
+                (index, MetaFault::Pause(win))
+            })
+            .collect();
+
+        Self {
+            pd_ensemble,
+            pd_faults,
+            data_plane,
+        }
+    }
+
+    /// The PD ensemble size this plan was drawn for.
+    #[must_use]
+    pub fn pd_ensemble(&self) -> usize {
+        self.pd_ensemble
+    }
+
+    /// The fault applied to the **sole TiKV data node** — the load-bearing nemesis.
+    #[must_use]
+    pub fn data_plane_fault(&self) -> MetaFault {
+        self.data_plane
+    }
+
+    /// The PD-ensemble faults, by node index.
+    #[must_use]
+    pub fn pd_faults(&self) -> &std::collections::BTreeMap<usize, MetaFault> {
+        &self.pd_faults
+    }
+
+    /// The faulted PD node indices, ascending — the reproducible target set the `xtask`
+    /// runner turns into concrete `docker compose pause pd<i>` actions.
+    #[must_use]
+    pub fn faulted_pd_nodes(&self) -> Vec<usize> {
+        self.pd_faults.keys().copied().collect()
+    }
+
+    /// **Invariant — the sole data replica's fault is healable.** The single TiKV node
+    /// has no peer, so the nemesis may only apply a **time-bounded** fault to it (it
+    /// stalls, then the run heals it and the clauses are checked across the recovery). An
+    /// indefinite partition of the sole replica would just take the store down. True iff
+    /// the data-plane fault carries a positive self-heal window
+    /// ([`MetaFault::window_ms`]).
+    #[must_use]
+    pub fn data_plane_fault_is_healable(&self) -> bool {
+        self.data_plane.window_ms().is_some_and(|w| w > 0)
+    }
+
+    /// **Invariant — a PD majority survives.** The faulted PD set is a strict minority,
+    /// so the surviving majority keeps the timestamp-oracle quorum: `survivors * 2 > n`.
+    #[must_use]
+    pub fn pd_quorum_survives(&self) -> bool {
+        let survivors = self.pd_ensemble - self.pd_faults.len();
+        survivors * 2 > self.pd_ensemble
+    }
+}
+
+impl MetaFaultInjector for MetaClusterFaultPlan {
+    /// Fault decisions for the **PD ensemble** by node index (the data-plane fault is a
+    /// separate, always-present decision — [`data_plane_fault`](Self::data_plane_fault)).
+    fn meta_fault_for(&mut self, node_index: usize) -> Option<MetaFault> {
+        self.pd_faults.get(&node_index).copied()
+    }
+}
+
