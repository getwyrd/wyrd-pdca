@@ -0,0 +1,163 @@
+//! **Tier-1 metadata integration** (M4.6, #257; proposal 0015 §"DST and tests" →
+//! "Integration", §"Suggested PR sequence" item 6) — the realism-ladder Tier-1 leg for
+//! the redb→TiKV **metadata backend swap**.
+//!
+//! Where the M2/M3 `crates/chunkstore-grpc/tests/tier2_integration.rs` proves the
+//! *chunkstore* data path against real containers, this leg proves the *metadata swap*:
+//! the **same system** — the production `MetadataStore` trait — runs on a real
+//! containerized TiKV cluster behind the **unchanged** trait, and multi-key atomic
+//! create / rename / delete are **all-or-nothing** (proposal 0015: "the bare composition
+//! swap: the same system runs on TiKV behind the unchanged trait; multi-key atomic
+//! create/rename/delete succeed").
+//!
+//! It is **gated** exactly like the sibling tier tests: `#[ignore]` keeps it out of the
+//! unprivileged `cargo xtask ci` (`cargo test --workspace` still COMPILES and type-checks
+//! the body — an API regression on `MetadataStore` would fail to build), and it
+//! additionally no-ops when `WYRD_TIKV_PD_ENDPOINTS` is unset, so a laptop / PDCA worktree
+//! with no TiKV skips cleanly and the gate stays green. It is run by the privileged
+//! `cargo xtask meta-integration` job (`WYRD_TIER1=1`), which stands up the `deploy/`
+//! TiKV, exports its PD endpoints, and runs this with `--ignored --features tikv`.
+
+/// The PD (Placement Driver) endpoints, or `None` when TiKV is not configured —
+/// identical gate to `tests/conformance.rs` so the whole family skips together.
+fn pd_endpoints() -> Option<Vec<String>> {
+    match std::env::var("WYRD_TIKV_PD_ENDPOINTS") {
+        Ok(raw) if !raw.trim().is_empty() => Some(
+            raw.split(',')
+                .map(|e| e.trim().to_string())
+                .filter(|e| !e.is_empty())
+                .collect(),
+        ),
+        _ => None,
+    }
+}
+
+#[test]
+#[ignore = "Tier-1: needs a real containerized TiKV — run via `cargo xtask meta-integration`"]
+fn multi_key_create_rename_delete_atomic_on_tikv() {
+    let Some(endpoints) = pd_endpoints() else {
+        eprintln!(
+            "tier1_metadata_integration: WYRD_TIKV_PD_ENDPOINTS unset — skipping (clean skip; \
+             the gate stays green without a TiKV). Run `cargo xtask meta-integration`."
+        );
+        return;
+    };
+    run(endpoints);
+}
+
+#[cfg(feature = "tikv")]
+fn run(endpoints: Vec<String>) {
+    use wyrd_traits::{CommitOutcome, MetadataStore, WriteBatch};
+
+    let runtime = tokio::runtime::Builder::new_current_thread()
+        .enable_all()
+        .build()
+        .expect("tokio runtime");
+
+    runtime.block_on(async move {
+        let namespace = format!("wyrd-tier1-integration/{}/", std::process::id()).into_bytes();
+        let store = wyrd_metadata_tikv::TikvMetadataStore::connect(endpoints)
+            .await
+            .expect("connect to TiKV")
+            .with_namespace(namespace);
+
+        // Logical keys standing in for `core`'s inode + dirent records — this leg drives
+        // the trait primitive directly (no `core` dep), which is the atomicity surface
+        // the milestone retires the trait-leak on.
+        let inode = b"inode:1".as_slice();
+        let dirent_a = b"dirent:/a".as_slice();
+        let dirent_b = b"dirent:/b".as_slice();
+
+        // ---- create: two keys, all-or-nothing, guarded by require_absent ----
+        let created = store
+            .commit(
+                WriteBatch::new()
+                    .require_absent(inode)
+                    .require_absent(dirent_a)
+                    .put(inode, &b"v1"[..])
+                    .put(dirent_a, &b"1"[..]),
+            )
+            .await
+            .expect("create commit");
+        assert_eq!(created, CommitOutcome::Committed, "create must commit");
+        // Read-after-commit: both keys are visible.
+        assert_eq!(store.get(inode).await.unwrap().as_deref(), Some(&b"v1"[..]));
+        assert_eq!(
+            store.get(dirent_a).await.unwrap().as_deref(),
+            Some(&b"1"[..])
+        );
+
+        // ---- all-or-nothing: a batch with ONE failing precondition writes NOTHING ----
+        let rejected = store
+            .commit(
+                WriteBatch::new()
+                    .require(inode, &b"WRONG"[..]) // stale precondition → Conflict
+                    .put(inode, &b"v2"[..])
+                    .put(b"dirent:/c".as_slice(), &b"1"[..]),
+            )
+            .await
+            .expect("rejected commit is Ok(Conflict), never Err");
+        assert_eq!(
+            rejected,
+            CommitOutcome::Conflict,
+            "stale precondition conflicts"
+        );
+        assert_eq!(
+            store.get(b"dirent:/c".as_slice()).await.unwrap(),
+            None,
+            "a conflicted batch must leave NONE of its puts (all-or-nothing)"
+        );
+        assert_eq!(
+            store.get(inode).await.unwrap().as_deref(),
+            Some(&b"v1"[..]),
+            "the conflicted batch must not have mutated the inode"
+        );
+
+        // ---- rename /a → /b: delete old dirent + put new, atomic under preconditions ----
+        let renamed = store
+            .commit(
+                WriteBatch::new()
+                    .require(dirent_a, &b"1"[..])
+                    .require_absent(dirent_b)
+                    .delete(dirent_a)
+                    .put(dirent_b, &b"1"[..]),
+            )
+            .await
+            .expect("rename commit");
+        assert_eq!(renamed, CommitOutcome::Committed, "rename must commit");
+        assert_eq!(store.get(dirent_a).await.unwrap(), None, "old name is gone");
+        assert_eq!(
+            store.get(dirent_b).await.unwrap().as_deref(),
+            Some(&b"1"[..])
+        );
+        assert_eq!(
+            store.get(inode).await.unwrap().as_deref(),
+            Some(&b"v1"[..]),
+            "rename leaves the inode untouched"
+        );
+
+        // ---- delete: remove dirent + inode atomically ----
+        let deleted = store
+            .commit(
+                WriteBatch::new()
+                    .require(dirent_b, &b"1"[..])
+                    .require(inode, &b"v1"[..])
+                    .delete(dirent_b)
+                    .delete(inode),
+            )
+            .await
+            .expect("delete commit");
+        assert_eq!(deleted, CommitOutcome::Committed, "delete must commit");
+        assert_eq!(store.get(dirent_b).await.unwrap(), None, "dirent removed");
+        assert_eq!(store.get(inode).await.unwrap(), None, "inode removed");
+    });
+}
+
+#[cfg(not(feature = "tikv"))]
+fn run(endpoints: Vec<String>) {
+    let _ = endpoints;
+    eprintln!(
+        "tier1_metadata_integration: WYRD_TIKV_PD_ENDPOINTS is set but the crate was built \
+         without `--features tikv` — skipping. Run it via `cargo xtask meta-integration`."
+    );
+}
