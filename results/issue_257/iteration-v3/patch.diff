 ///
 /// Everything non-deterministic a component needs — randomness, time, fault
diff --git a/crates/testkit/tests/meta_fault_seam.rs b/crates/testkit/tests/meta_fault_seam.rs
new file mode 100644
index 0000000..26ec521
--- /dev/null
+++ b/crates/testkit/tests/meta_fault_seam.rs
@@ -0,0 +1,126 @@
+//! **The real-TiKV metadata fault seam — a Check-observable flippable** (M4.6, #257;
+//! proposal 0015 §"Crate touch-points": "`testkit` — a real-TiKV-cluster fault seam
+//! (partition/latency/pause) for the Tier-1 integration + Jepsen runs"; §"DST and
+//! tests"; ADR-0015 clause 2).
+//!
+//! This file is an **added integration test** (`crates/testkit/tests/*.rs`), so the
+//! per-fix `C4-verify` gate keeps it while reverting the production change: with
+//! `crates/testkit/src/lib.rs`'s `MetaClusterFaultPlan` seam removed, `use
+//! wyrd_testkit::MetaClusterFaultPlan` fails to resolve and this target goes **RED**;
+//! with the seam present it goes **GREEN**. That is the demonstrated red→green the brief
+//! requires *at Check* (the load-bearing tier green is separately DEFERRED / privileged).
+//!
+//! **The oracle is independent of the implementation**, not a restatement of it. Two
+//! load-bearing single-zone invariants, each catchable by an independent inequality:
+//!
+//! 1. **A PD majority survives** the nemesis — `survivors * 2 > n`. A regression that let
+//!    the seam fault a PD *majority* (e.g. `n / 2` instead of `⌊(n-1)/2⌋`) breaks it at
+//!    `n = 4` (fault 2, leaves 2 — not a majority).
+//! 2. **The sole data node's fault is healable** — the single TiKV replica may only be
+//!    given a *time-bounded* fault (it stalls, then the run heals it). A regression that
+//!    faulted the data node with an indefinite `Partition` (no window) breaks it. This is
+//!    the correction over an earlier attempt that faulted only PD and never the data node
+//!    at all — here the data node is *always* faulted, and always healably.
+
+use wyrd_testkit::{MetaClusterFaultPlan, MetaFault};
+
+/// `pd_quorum_safe_max(n) = ⌊(n-1)/2⌋` is a **strict minority** that always leaves a
+/// **majority quorum** surviving. The `survivors * 2 > n` check is the independent oracle:
+/// a majority-faulting regression (`n / 2`) fails it at `n = 4` (fault 2, leaves 2).
+#[test]
+fn pd_quorum_safe_max_leaves_a_surviving_majority() {
+    for n in 1..=12 {
+        let faulted = MetaClusterFaultPlan::pd_quorum_safe_max(n);
+        let survivors = n - faulted;
+        assert!(
+            survivors * 2 > n,
+            "faulting pd_quorum_safe_max({n}) = {faulted} must leave a MAJORITY quorum \
+             ({survivors} of {n}); a majority-faulting bound (e.g. n/2) breaks this"
+        );
+        assert!(
+            faulted * 2 < n || n == 0,
+            "pd_quorum_safe_max({n}) = {faulted} must be a strict minority of {n}"
+        );
+    }
+}
+
+/// The exact `⌊(n-1)/2⌋` values, pinned so an off-by-one that still happens to leave a
+/// majority for small n is caught (e.g. a regression to `n.saturating_sub(2) / 2`).
+#[test]
+fn pd_quorum_safe_max_matches_floor_n_minus_1_over_2() {
+    for (n, expected) in [(1, 0), (2, 0), (3, 1), (4, 1), (5, 2), (6, 2), (7, 3)] {
+        assert_eq!(
+            MetaClusterFaultPlan::pd_quorum_safe_max(n),
+            expected,
+            "pd_quorum_safe_max({n}) must be ⌊(n-1)/2⌋ = {expected}"
+        );
+    }
+}
+
+/// A seeded plan is a **pure function of the seed** (reproducibility — ADR-0009), it
+/// **always faults the sole data node healably** (the load-bearing nemesis), and it keeps
+/// a **PD majority** — the two single-zone invariants the Tier-1 Jepsen leg rests on.
+#[test]
+fn from_seed_is_reproducible_faults_the_data_node_healably_and_keeps_pd_quorum() {
+    for pd in [3, 5, 7] {
+        for seed in 0..16u64 {
+            let a = MetaClusterFaultPlan::from_seed(seed, pd);
+            let b = MetaClusterFaultPlan::from_seed(seed, pd);
+            assert_eq!(a, b, "same seed → same plan (seed={seed}, pd={pd})");
+
+            // (1) The DATA node is always faulted — the nemesis that actually stresses the
+            // metadata store — and always healably (the sole replica must recover).
+            assert!(
+                a.data_plane_fault_is_healable(),
+                "seed={seed}: the sole data node's fault must be healable, got {:?}",
+                a.data_plane_fault()
+            );
+            assert!(
+                a.data_plane_fault().window_ms().is_some_and(|w| w > 0),
+                "seed={seed}: the data-node pause must carry a positive window"
+            );
+
+            // (2) A PD majority survives the nemesis.
+            assert!(
+                a.pd_quorum_survives(),
+                "seed={seed}, pd={pd}: a PD majority must survive"
+            );
+            assert!(
+                a.faulted_pd_nodes().len() <= MetaClusterFaultPlan::pd_quorum_safe_max(pd),
+                "seed={seed}: never faults more than a strict PD minority"
+            );
+            assert!(
+                a.faulted_pd_nodes().iter().all(|&i| i < pd),
+                "seed={seed}: faulted PD indices are valid nodes: {:?}",
+                a.faulted_pd_nodes()
+            );
+        }
+    }
+}
+
+/// An indefinite fault (a `Partition` / `ClockSkew`) carries **no** self-heal window,
+/// while a bounded `Pause` / `Latency` does — the discriminator the data-node healability
+/// invariant rests on (so it is genuinely load-bearing, not a tautology on `Pause`).
+#[test]
+fn only_time_bounded_faults_have_a_window() {
+    assert_eq!(MetaFault::Pause(4000).window_ms(), Some(4000));
+    assert_eq!(MetaFault::Latency(250).window_ms(), Some(250));
+    assert_eq!(MetaFault::Partition.window_ms(), None);
+    assert_eq!(MetaFault::ClockSkew(-500).window_ms(), None);
+}
+
+/// A different seed selects a different data-node pause window and/or PD target set for a
+/// large enough ensemble — the schedule is genuinely seed-driven, not a constant.
+#[test]
+fn distinct_seeds_drive_distinct_schedules() {
+    let mut seen = std::collections::BTreeSet::new();
+    for seed in 0..64u64 {
+        let plan = MetaClusterFaultPlan::from_seed(seed, 7);
+        seen.insert((plan.data_plane_fault().window_ms(), plan.faulted_pd_nodes()));
+    }
+    assert!(
+        seen.len() > 1,
+        "the seed must actually drive the schedule (saw {} distinct schedules over 64 seeds)",
+        seen.len()
+    );
+}
