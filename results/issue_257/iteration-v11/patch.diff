         "clippy",
         "--workspace",
         "--exclude",
         "wyrd-dst",
         "--all-targets",
     ])?;
-    cargo(&[
+    exec(&[
         "build",
         "--workspace",
         "--exclude",
         "wyrd-dst",
         "--all-targets",
     ])?;
