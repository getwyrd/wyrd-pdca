+# Throwaway ≥3-REPLICA TiKV Raft group for the M4.6 (#257) Tier-1 metadata
+# consistency-over-the-swap leg (proposal 0015 §"DST and tests", PR-sequence item 6;
+# ADR-0039 in-repo consistency scenario; ADR-0015 single-zone contract). Like its
+# single-node sibling it lives under `deploy/`, OUTSIDE the Cargo workspace (ADR-0010:
+# the guard that keeps orchestrator coupling out of the crates).
+#
+# `pd` is TiKV's coordinator (Placement Driver). Three `tikv-N` storage nodes form the
+# Raft group whose quorum the Tier-1 consistency leg reasons about: a SYMMETRIC partition
+# of ONE node (a minority) leaves the other two holding quorum, so the majority side stays
+# writable and no split-brain / lost update is reachable against the linearizable store
+# (the load-bearing single-zone demonstration — proposal 0015; ADR-0015). PD's default
+# region replication factor is 3, so every region is placed on all three nodes.
+#
+# Host networking so a `tikv-client` on the HOST reaches PD (127.0.0.1:2379) and each store
+# address PD hands back. Crucially each node binds a **DISTINCT loopback IP** (pd/tikv-0 =
+# 127.0.0.1, tikv-1 = 127.0.0.2, tikv-2 = 127.0.0.3) — so the Tier-1 scenario can isolate a
+# single node **by IP, bidirectionally** (`iptables -s <ip>`/`-d <ip>`), the genuine symmetric
+# partition Invariant B mandates (the v6/v7 `--dport`-only cut on a shared 127.0.0.1 could only
+# blackhole inbound traffic to a port and could not identify a node's own outbound traffic).
+# The runner exports WYRD_TIER1_ISOLATED_IP=127.0.0.2, WYRD_TIER1_STORE_ADDRS, and the replica
+# topology; the fault-effect oracle observes isolation from PD's side (peer view), not by
+# probing the dropped port.
+#
+# Static endpoints only (reduced bar until #365 lands L5 discovery — the "Deployment
+# prerequisite" note in proposal 0015).
+name: wyrd-tier1-metadata
+services:
+  pd:
+    image: pingcap/pd:v8.5.1
+    network_mode: host
+    command:
+      - --name=pd
+      - --data-dir=/data/pd
+      - --client-urls=http://127.0.0.1:2379
+      - --peer-urls=http://127.0.0.1:2380
+      - --initial-cluster=pd=http://127.0.0.1:2380
+    restart: on-failure
+
+  tikv-0:
+    image: pingcap/tikv:v8.5.1
+    network_mode: host
+    depends_on:
+      - pd
+    command:
+      - --addr=127.0.0.1:20160
+      - --advertise-addr=127.0.0.1:20160
+      - --status-addr=127.0.0.1:20180
+      - --data-dir=/data/tikv-0
+      - --pd-endpoints=127.0.0.1:2379
+    restart: on-failure
+
+  tikv-1:
+    image: pingcap/tikv:v8.5.1
+    network_mode: host
+    depends_on:
+      - pd
+    command:
+      - --addr=127.0.0.2:20161
+      - --advertise-addr=127.0.0.2:20161
+      - --status-addr=127.0.0.2:20181
+      - --data-dir=/data/tikv-1
+      - --pd-endpoints=127.0.0.1:2379
+    restart: on-failure
+
+  tikv-2:
+    image: pingcap/tikv:v8.5.1
+    network_mode: host
+    depends_on:
+      - pd
+    command:
+      - --addr=127.0.0.3:20162
+      - --advertise-addr=127.0.0.3:20162
+      - --status-addr=127.0.0.3:20182
+      - --data-dir=/data/tikv-2
+      - --pd-endpoints=127.0.0.1:2379
+    restart: on-failure
