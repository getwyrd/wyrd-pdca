+pub mod meta_faults {
+    //! **The M4.6 real-TiKV metadata-swap fault seam** (proposal 0015 §"DST and
+    //! tests" → the Tier-1 Jepsen / Tier-1 integration / Tier-2 legs across the
+    //! redb→TiKV metadata backend swap; #257). The *pure* decision logic the
+    //! privileged `xtask meta-*` runners and the `wyrd-metadata-tikv` tier tests
+    //! consume — kept free of any `tikv-client` / container dependency so it
+    //! compiles and is unit-tested on every machine (TiKV or not), exactly like
+    //! the sibling [`crate::SeededStorageFaults`] / [`crate::SeededNetFaults`]
+    //! seams.
+    //!
+    //! # Why the data-plane replica count is load-bearing (the iteration-3 lesson)
+    //!
+    //! The binding Tier-1 Jepsen criterion is **exactly-one-winner under a real
+    //! partition** (Success criterion (b); ADR-0015 clause 2). That property is
+    //! only *falsifiable* — able to go red on a metadata-layer bug — when the
+    //! partition can isolate a **strict minority** of the TiKV data plane while the
+    //! surviving **majority keeps the Raft group AVAILABLE**: concurrent CAS still
+    //! commits, so a non-atomic commit would surface as two winners. Partitioning a
+    //! **single-replica** data plane can only make it *unavailable* (every op
+    //! `Err`s) — it can never split-brain, so the property cannot fail and the test
+    //! proves nothing. A single-node TiKV therefore **cannot demonstrate** the
+    //! criterion; the seam refuses it ([`plan_data_plane_partition`] returns
+    //! [`TopologyTooSmall`]) and the runners stand up a **≥3-store Raft group**
+    //! (`deploy/tikv-raft-3/`).
+
+    /// The minimum TiKV **data-plane** replica count that can demonstrate
+    /// exactly-one-winner under partition: three, the smallest strict-majority
+    /// Raft group where a one-store partition leaves a two-store quorum serving.
+    /// The `deploy/tikv-raft-3/` stack declares exactly this many stores.
+    pub const MIN_DEMONSTRABLE_REPLICAS: usize = 3;
+
+    /// A real fault a Tier-1 metadata nemesis injects against the containerized
+    /// TiKV cluster. The seam decides **which** stores and **which** kind; the
+    /// privileged runner applies it. Illustrative mechanisms in parentheses are the
+    /// model's, not this pure module's (`docs/…` / proposal 0015 "ILLUSTRATIVE").
+    #[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
+    pub enum MetaFault {
+        /// A **real network partition** cutting the targeted stores off from the
+        /// rest of the cluster and PD (`docker network disconnect` / `iptables`).
+        /// A network cut — distinct from a process pause — held until healed.
+        Partition,
+        /// Injected packet **latency** on the targeted stores' links (`tc netem
+        /// delay`). Time-bounded.
+        Latency,
+        /// **Clock skew** on the targeted stores (`libfaketime`) — stresses PD's
+        /// timestamp oracle / TiKV's lease reasoning. Held until healed.
+        ClockSkew,
+        /// A process **pause** (`SIGSTOP` via `docker compose pause`) — a store
+        /// that stops responding without a network cut. Time-bounded.
+        Pause,
+    }
+
+    impl MetaFault {
+        /// A **time-bounded** fault (`Some(ms)`) is lifted by the runner after a
+        /// fixed window; a **hold-until-heal** fault (`None`) stays until the
+        /// runner explicitly heals it. The discriminator the runner uses to decide
+        /// whether to sleep-then-lift or cut-then-reconnect — and the reason the
+        /// set is not a single degenerate kind (iteration-2: "ClockSkew defined but
+        /// never wired", "Partition≡pause conflation").
+        #[must_use]
+        pub fn window_ms(self) -> Option<u64> {
+            match self {
+                MetaFault::Latency => Some(3_000),
+                MetaFault::Pause => Some(8_000),
+                MetaFault::Partition | MetaFault::ClockSkew => None,
+            }
+        }
+
+        /// Is this a genuine network cut (vs. a process/timing fault)? The
+        /// load-bearing Jepsen partition is `Partition` — a runner that applied a
+        /// `Pause` where the plan says `Partition` (iteration-2 conflation) is a
+        /// bug this predicate lets a test catch.
+        #[must_use]
+        pub fn is_network_partition(self) -> bool {
+            matches!(self, MetaFault::Partition)
+        }
+    }
+
+    /// The seam refused to plan a partition because the data plane is too small to
+    /// keep a quorum while isolating any store — so exactly-one-winner-under-
+    /// partition cannot be demonstrated (the iteration-3 single-replica finding).
+    #[derive(Debug, Clone, PartialEq, Eq)]
+    pub struct TopologyTooSmall {
+        /// The (insufficient) data-plane replica count.
+        pub replicas: usize,
+        /// The minimum that could demonstrate the property.
+        pub minimum: usize,
+    }
+
+    impl core::fmt::Display for TopologyTooSmall {
+        fn fmt(&self, f: &mut core::fmt::Formatter<'_>) -> core::fmt::Result {
+            write!(
+                f,
+                "a {}-store TiKV data plane cannot demonstrate exactly-one-winner under \
+                 partition: isolating any store would drop below a Raft quorum, so the store \
+                 can only go UNAVAILABLE, never split-brain — need at least {} stores",
+                self.replicas, self.minimum
+            )
+        }
+    }
+
+    impl std::error::Error for TopologyTooSmall {}
+
+    /// The **largest strict minority** of an `replicas`-store Raft group that can be
+    /// faulted while the survivors still form a strict **majority** (a live quorum):
+    /// the greatest `f` with `2 * (replicas - f) > replicas`, i.e. `f < replicas /
+    /// 2`, i.e. `(replicas - 1) / 2`.
+    ///
+    /// `0` means "no store can be faulted without losing quorum" — for `replicas <
+    /// 3` (a single- or two-store data plane, the iteration-3 topology). This is the
+    /// independent majority-arithmetic oracle the seam test pins: `survivors * 2 >
+    /// replicas` must hold for the returned `f`, and `(survivors - 1) * 2 <=
+    /// replicas` must hold (one more fault would break quorum — `f` is maximal).
+    #[must_use]
+    pub fn max_quorum_safe_faults(replicas: usize) -> usize {
+        replicas.saturating_sub(1) / 2
+    }
+
+    /// The concrete nemesis the runner applies: which store indices to fault, with
+    /// which fault kind, against an `replicas`-store data plane.
+    #[derive(Debug, Clone, PartialEq, Eq)]
+    pub struct PartitionPlan {
+        /// The data-plane store count the plan was computed for.
+        pub replicas: usize,
+        /// The store indices (`0..replicas`) the nemesis isolates — always a strict
+        /// quorum-safe minority.
+        pub faulted: Vec<usize>,
+        /// The fault kind (the load-bearing Jepsen fault is [`MetaFault::Partition`]).
+        pub fault: MetaFault,
+    }
+
+    impl PartitionPlan {
+        /// How many stores survive the fault.
+        #[must_use]
+        pub fn surviving(&self) -> usize {
+            self.replicas - self.faulted.len()
+        }
+
+        /// Do the survivors still form a strict Raft majority (a live quorum)? The
+        /// load-bearing invariant: a plan that faults a **majority** leaves the
+        /// cluster unavailable and the property vacuous, so this MUST hold.
+        #[must_use]
+        pub fn keeps_quorum(&self) -> bool {
+            self.surviving() * 2 > self.replicas
+        }
+
+        /// Is the faulted set **maximal** — would one more fault break quorum? A
+        /// plan that faults *fewer* stores than it safely could (e.g. zero) applies
+        /// less pressure than the topology allows; the runner wants the largest
+        /// quorum-safe minority.
+        #[must_use]
+        pub fn is_maximal(&self) -> bool {
+            (self.surviving() - 1) * 2 <= self.replicas
+        }
+    }
+
+    /// Plan the load-bearing data-plane partition for an `replicas`-store TiKV Raft
+    /// group: isolate the largest quorum-safe **minority** with a real network
+    /// [`MetaFault::Partition`], so the surviving majority keeps serving CAS and a
+    /// metadata-layer bug can surface as two winners.
+    ///
+    /// Refuses (`Err(TopologyTooSmall)`) any data plane too small to keep a quorum
+    /// while faulting a store — i.e. `replicas < 3`. This is the seam-level encoding
+    /// of the iteration-3 finding: a single-replica metadata store can never
+    /// split-brain, so it cannot demonstrate the criterion and must not be dressed
+    /// up as if it could.
+    pub fn plan_data_plane_partition(replicas: usize) -> Result<PartitionPlan, TopologyTooSmall> {
+        let f = max_quorum_safe_faults(replicas);
+        if f == 0 {
+            return Err(TopologyTooSmall {
+                replicas,
+                minimum: MIN_DEMONSTRABLE_REPLICAS,
+            });
+        }
+        Ok(PartitionPlan {
+            replicas,
+            faulted: (0..f).collect(),
+            fault: MetaFault::Partition,
+        })
+    }
+
+    /// Count the TiKV **store** services a compose file declares — a service whose
+    /// key matches `tikv<N>` at the two-space `services:` indent (the
+    /// `deploy/tikv-raft-3/` naming). Pure text scan so the tier harness and the
+    /// on-Check test can both assert the data plane really declares a ≥3-store Raft
+    /// group without standing a container up. A compose reverted to a single store
+    /// makes this return `1`, which [`plan_data_plane_partition`] then refuses —
+    /// tying the topology fix to a red→green oracle.
+    #[must_use]
+    pub fn count_data_plane_stores(compose_yaml: &str) -> usize {
+        compose_yaml
+            .lines()
+            .filter(|line| {
+                let Some(key) = line.strip_prefix("  ") else {
+                    return false;
+                };
+                // A service key: `  tikv<digits>:` with no deeper indent.
+                let Some(rest) = key.strip_prefix("tikv") else {
+                    return false;
+                };
+                let Some(name) = rest.strip_suffix(':') else {
+                    return false;
+                };
+                !name.is_empty() && name.bytes().all(|b| b.is_ascii_digit())
+            })
+            .count()
+    }
+}
+
 #[cfg(test)]
 mod tests {
     use super::*;
diff --git a/crates/testkit/tests/meta_fault_seam.rs b/crates/testkit/tests/meta_fault_seam.rs
new file mode 100644
index 0000000..3d1ee7c
--- /dev/null
+++ b/crates/testkit/tests/meta_fault_seam.rs
@@ -0,0 +1,199 @@
+//! **The Check-observable flippable for the M4.6 real-TiKV metadata fault seam**
+//! (`wyrd_testkit::meta_faults`; proposal 0015 §"DST and tests"; #257).
+//!
+//! The load-bearing Tier-1 Jepsen / integration green is privileged and off-Check
+//! (a real containerized TiKV Raft group under a real partition — `cargo xtask
+//! meta-jepsen`, `WYRD_TIER1=1`). "Deferred" does **not** mean "unbuilt": the
+//! *decision logic* the runners consume is pure and is exercised here, in
+//! `cargo xtask ci`'s `cargo test --workspace`, with an **independent oracle** —
+//! majority arithmetic derived without reference to the function's body — so a
+//! wrong decision goes **red behaviourally**, not merely on a deleted module.
+//!
+//! Why this seam matters (the iteration-3 finding): exactly-one-winner under
+//! partition is only *falsifiable* when the partition isolates a strict **minority**
+//! of a ≥3-store data plane while the majority keeps serving. A single-replica data
+//! plane can only go unavailable, never split-brain, so it proves nothing — the
+//! seam must **refuse** it, and these tests pin that refusal.
+
+use wyrd_testkit::meta_faults::{
+    count_data_plane_stores, max_quorum_safe_faults, plan_data_plane_partition, MetaFault,
+    MIN_DEMONSTRABLE_REPLICAS,
+};
+
+// ─── the independent majority-arithmetic oracle ───────────────────────────────
+
+/// The oracle, stated independently of `max_quorum_safe_faults`'s body: `f` stores
+/// may be faulted iff the `n - f` survivors are a **strict majority**, `2*(n-f) > n`.
+fn survivors_keep_quorum(replicas: usize, faulted: usize) -> bool {
+    2 * (replicas - faulted) > replicas
+}
+
+#[test]
+fn max_quorum_safe_faults_is_the_largest_strict_minority() {
+    // Check the seam against the independent oracle across the ladder of sizes: the
+    // returned f keeps quorum, and f+1 breaks it (maximality). This is NOT a
+    // restatement of the implementation — it is the majority definition itself.
+    for replicas in 1..=9 {
+        let f = max_quorum_safe_faults(replicas);
+        assert!(
+            survivors_keep_quorum(replicas, f),
+            "n={replicas}: faulting {f} stores must keep a quorum (2*(n-f) > n)"
+        );
+        assert!(
+            !survivors_keep_quorum(replicas, f + 1),
+            "n={replicas}: f={f} must be MAXIMAL — faulting one more must break quorum"
+        );
+    }
+}
+
+#[test]
+fn max_quorum_safe_faults_known_values() {
+    // Spot values a human can verify by hand — the seam is not free to drift.
+    assert_eq!(
+        max_quorum_safe_faults(1),
+        0,
+        "a lone store: nothing is safe"
+    );
+    assert_eq!(
+        max_quorum_safe_faults(2),
+        0,
+        "two stores: no strict majority survives a fault"
+    );
+    assert_eq!(
+        max_quorum_safe_faults(3),
+        1,
+        "3-store Raft: one store partitionable"
+    );
+    assert_eq!(max_quorum_safe_faults(4), 1);
+    assert_eq!(max_quorum_safe_faults(5), 2);
+}
+
+// ─── the iteration-3 refusal: a sub-quorum topology cannot demonstrate ─────────
+
+#[test]
+fn a_single_or_two_store_data_plane_is_refused() {
+    // THE lesson of iteration 3, encoded: a single-replica TiKV metadata store can
+    // only go unavailable, never split-brain, so it cannot demonstrate
+    // exactly-one-winner under partition. The seam must refuse it, loudly.
+    for too_small in [0usize, 1, 2] {
+        let err = plan_data_plane_partition(too_small)
+            .expect_err("a sub-quorum data plane must be refused, not planned");
+        assert_eq!(err.replicas, too_small);
+        assert_eq!(err.minimum, MIN_DEMONSTRABLE_REPLICAS);
+        let msg = err.to_string();
+        assert!(
+            msg.contains("split-brain") || msg.contains("UNAVAILABLE"),
+            "the refusal must explain WHY a small data plane proves nothing: {msg}"
+        );
+    }
+    assert_eq!(
+        MIN_DEMONSTRABLE_REPLICAS, 3,
+        "three stores is the smallest strict-majority Raft group"
+    );
+}
+
+// ─── the plan the runner applies: a quorum-safe minority, network-partitioned ──
+
+#[test]
+fn a_three_store_plan_partitions_a_quorum_safe_minority() {
+    let plan = plan_data_plane_partition(3).expect("a 3-store Raft group is demonstrable");
+
+    // It faults a real NETWORK partition (not a process pause — the iteration-2
+    // conflation) of a strict minority...
+    assert_eq!(plan.fault, MetaFault::Partition);
+    assert!(
+        plan.fault.is_network_partition(),
+        "the load-bearing Jepsen fault must be a real network cut, not a pause/latency"
+    );
+    assert_eq!(plan.faulted, vec![0], "one of three stores is isolated");
+
+    // ...the survivors keep a live quorum (else the property is vacuous — every op
+    // Errs and no winner can ever be observed)...
+    assert!(
+        plan.keeps_quorum(),
+        "the surviving majority must keep the Raft group available"
+    );
+    assert!(
+        survivors_keep_quorum(plan.replicas, plan.faulted.len()),
+        "cross-check against the independent oracle"
+    );
+
+    // ...and the minority is MAXIMAL (a plan that faults zero stores applies no
+    // pressure and the partition proves nothing).
+    assert!(
+        plan.is_maximal(),
+        "the plan must isolate the largest quorum-safe minority, not fewer"
+    );
+    assert!(
+        !plan.faulted.is_empty(),
+        "a plan faulting no store proves nothing"
+    );
+}
+
+#[test]
+fn a_five_store_plan_isolates_two_and_keeps_three() {
+    let plan = plan_data_plane_partition(5).expect("a 5-store Raft group is demonstrable");
+    assert_eq!(plan.faulted, vec![0, 1]);
+    assert_eq!(plan.surviving(), 3);
+    assert!(plan.keeps_quorum() && plan.is_maximal());
+}
+
+// ─── fault kinds are honestly distinguished (iteration-2 remarks) ──────────────
+
+#[test]
+fn time_bounded_and_hold_until_heal_faults_are_distinguished() {
+    // A time-bounded fault is lifted after a fixed window; a network cut / clock
+    // skew is held until the runner heals it. The runner branches on this — so it
+    // must not collapse to one degenerate kind (iteration-2: Partition≡Pause).
+    assert!(
+        MetaFault::Pause.window_ms().is_some(),
+        "a pause is time-bounded"
+    );
+    assert!(
+        MetaFault::Latency.window_ms().is_some(),
+        "latency is time-bounded"
+    );
+    assert!(
+        MetaFault::Partition.window_ms().is_none(),
+        "a partition is held until healed, not auto-lifted on a timer"
+    );
+    assert!(
+        MetaFault::ClockSkew.window_ms().is_none(),
+        "clock skew is held until healed (and is a real, distinct kind — not unwired)"
+    );
+    // Only a real network cut counts as a partition.
+    assert!(MetaFault::Partition.is_network_partition());
+    for other in [MetaFault::Pause, MetaFault::Latency, MetaFault::ClockSkew] {
+        assert!(
+            !other.is_network_partition(),
+            "{other:?} is not a network partition"
+        );
+    }
+}
+
+// ─── the compose-store counter (ties the pure oracle to the real topology) ─────
+
+#[test]
+fn count_data_plane_stores_counts_tikv_service_keys() {
+    let three = "\
+services:
+  pd0:
+    image: pingcap/pd:v8.5.1
+  tikv0:
+    image: pingcap/tikv:v8.5.1
+  tikv1:
+    image: pingcap/tikv:v8.5.1
+  tikv2:
+    image: pingcap/tikv:v8.5.1
+";
+    assert_eq!(count_data_plane_stores(three), 3);
+    // A single-store compose (the rejected topology) counts 1, which the planner
+    // then refuses — the topology fix and the seam refusal are one oracle.
+    let single = "services:\n  pd0:\n    image: x\n  tikv:\n    image: y\n";
+    assert_eq!(
+        count_data_plane_stores(single),
+        0,
+        "the un-suffixed `tikv` single-store service is not a `tikv<N>` Raft member"
+    );
+    assert!(plan_data_plane_partition(1).is_err());
+}
