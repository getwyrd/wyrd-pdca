@@ -0,0 +1,132 @@
+//! **Pure routing/orchestration core for the M4.6 metadata-swap tier runners**
+//! (`cargo xtask meta-integration|meta-jepsen|meta-tier2`; proposal 0015 §"DST and
+//! tests", §"Suggested PR sequence" item 6; #257) — the Check-observable flippable.
+//!
+//! Mirrors the existing pure-dispatch seam (`faults::jepsen_dispatch`,
+//! `xtask/src/faults.rs`) and the born-at-tier coverage pattern
+//! (`xtask::disk_faults`): the privileged runners live in `faults.rs` and need a
+//! container host, but the **decision** each consumes — which package + `#[ignore]`d
+//! scenario a subcommand routes to, and which real fault kinds its nemesis applies —
+//! is pure and unit-tested here (`xtask/tests/meta_dispatch_orchestration.rs`)
+//! without a TiKV or a privileged host.
+//!
+//! The nemesis-plan itself (which quorum-safe minority of the TiKV data plane to
+//! partition) delegates to the shared seam `wyrd_testkit::meta_faults` — one
+//! definition, consumed by both the runner and the tier tests — so the load-bearing
+//! majority-arithmetic oracle is not re-derived here.
+
+use wyrd_testkit::meta_faults::{self, MetaFault, PartitionPlan, TopologyTooSmall};
+
+/// One realism-ladder leg of the metadata-swap campaign: the `cargo xtask`
+/// subcommand, the `wyrd-metadata-tikv` scenario it routes to, the data-plane
+/// replica count it stands up, and the **distinct** set of real fault kinds its
+/// nemesis applies. The (scenario, fault-posture) pairing is what makes a
+/// leg-crossing regression observable: routing Jepsen at the integration scenario,
+/// or dropping the Jepsen nemesis, changes this value and reddens the dispatch test.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct MetaLeg {
+    /// The `cargo xtask <subcommand>` that selects this leg.
+    pub subcommand: &'static str,
+    /// The crate whose `--test <scenario>` target runs (always the backend crate).
+    pub package: &'static str,
+    /// The `#[ignore]`d scenario test file (`crates/metadata-tikv/tests/<scenario>.rs`).
+    pub scenario: &'static str,
+    /// How many TiKV data-plane stores this leg stands up. A leg that injects a
+    /// partition needs `>= meta_faults::MIN_DEMONSTRABLE_REPLICAS` (a Raft group
+    /// that stays available under a minority cut); a pure single-node real-I/O leg
+    /// (Tier-2) is one honest machine.
+    pub replicas: usize,
+    /// The real fault kinds the leg's nemesis applies, in the order the runner
+    /// injects them. Empty for the no-nemesis Tier-2 real-I/O leg.
+    pub faults: &'static [MetaFault],
+}
+
+impl MetaLeg {
+    /// Does this leg inject a real network partition of the data plane?
+    #[must_use]
+    pub fn partitions_data_plane(&self) -> bool {
+        self.faults.iter().any(|f| f.is_network_partition())
+    }
+
+    /// The concrete nemesis plan for this leg's data plane, delegated to the shared
+    /// seam. `Err(TopologyTooSmall)` if the leg's `replicas` cannot demonstrate a
+    /// partition (a leg that partitions must stand up a ≥3-store Raft group); a
+    /// no-partition leg has no plan to compute (`Ok(None)`).
+    pub fn partition_plan(&self) -> Result<Option<PartitionPlan>, TopologyTooSmall> {
+        if self.partitions_data_plane() {
+            meta_faults::plan_data_plane_partition(self.replicas).map(Some)
+        } else {
+            Ok(None)
+        }
+    }
+}
+
+/// **Tier-1 integration** (Success criterion (a)): end-to-end PUT/GET + multi-key
+/// atomic create/rename/delete on TiKV behind the unchanged trait, all-or-nothing
+/// under a real data-plane **partition**/contention.
+pub const META_INTEGRATION: MetaLeg = MetaLeg {
+    subcommand: "meta-integration",
+    package: "wyrd-metadata-tikv",
+    scenario: "tier1_metadata_integration",
+    replicas: meta_faults::MIN_DEMONSTRABLE_REPLICAS,
+    faults: &[MetaFault::Partition],
+};
+
+/// **Tier-1 Jepsen** (Success criterion (b)): a nemesis injecting a real
+/// **partition**, **clock skew**, and **process pause** validates the single-zone
+/// consistency clauses (clause-2 commit-point linearizability + exactly-one-winner
+/// under genuine concurrency).
+pub const META_JEPSEN: MetaLeg = MetaLeg {
+    subcommand: "meta-jepsen",
+    package: "wyrd-metadata-tikv",
+    scenario: "tier1_jepsen_metadata",
+    replicas: meta_faults::MIN_DEMONSTRABLE_REPLICAS,
+    faults: &[MetaFault::Partition, MetaFault::ClockSkew, MetaFault::Pause],
+};
+
+/// **Tier-2** (Success criterion (c)): a run on **one real machine** (real `fsync`,
+/// real NVMe, real OS) green for honest single-node I/O semantics — no network
+/// nemesis (a single node has no partition to demonstrate; that is Jepsen's job).
+pub const META_TIER2: MetaLeg = MetaLeg {
+    subcommand: "meta-tier2",
+    package: "wyrd-metadata-tikv",
+    scenario: "tier2_metadata_io",
+    replicas: 1,
+    faults: &[],
+};
+
+/// Every metadata-swap leg, in PR-sequence order. The single source both `main.rs`'s
+/// subcommand table and the dispatch test enumerate.
+pub const META_LEGS: &[MetaLeg] = &[META_INTEGRATION, META_JEPSEN, META_TIER2];
+
+/// Route a `cargo xtask <subcommand>` to its leg, or `None` for an unknown
+/// subcommand. Pure — no env, no container — so the dispatch test binds to it.
+#[must_use]
+pub fn meta_dispatch(subcommand: &str) -> Option<MetaLeg> {
+    META_LEGS
+        .iter()
+        .find(|leg| leg.subcommand == subcommand)
+        .cloned()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn every_subcommand_routes_to_its_own_leg() {
+        assert_eq!(
+            meta_dispatch("meta-integration").unwrap().scenario,
+            META_INTEGRATION.scenario
+        );
+        assert_eq!(
+            meta_dispatch("meta-jepsen").unwrap().scenario,
+            META_JEPSEN.scenario
+        );
+        assert_eq!(
+            meta_dispatch("meta-tier2").unwrap().scenario,
+            META_TIER2.scenario
+        );
+        assert!(meta_dispatch("nope").is_none());
+    }
+}
diff --git a/xtask/tests/meta_dispatch_orchestration.rs b/xtask/tests/meta_dispatch_orchestration.rs
new file mode 100644
index 0000000..e708052
--- /dev/null
+++ b/xtask/tests/meta_dispatch_orchestration.rs
@@ -0,0 +1,188 @@
+//! **Check-observable flippable for the M4.6 metadata-swap tier runners**
+//! (`xtask::meta_dispatch`; proposal 0015 §"DST and tests", §"Suggested PR sequence"
+//! item 6; #257).
+//!
+//! The live Tier-1 integration + Jepsen + Tier-2 green is privileged and off-Check
+//! (a real containerized TiKV Raft group under a real partition, `WYRD_TIER1=1`).
+//! "Deferred" is not "unbuilt": the routing + nemesis-plan **decision** each runner
+//! consumes is pure and exercised here, inside `cargo xtask ci`'s `cargo test
+//! --workspace`, with oracles that redden on a WRONG DECISION (a leg-crossing route,
+//! a partition of a majority, a single-replica data plane), not merely a deleted
+//! module.
+//!
+//! The oracles, and the iteration remarks each closes:
+//!   * **routing resolves to a real, runnable target** — each leg's scenario file
+//!     must exist on disk (a typo'd scenario name is red, not green) [iter-1];
+//!   * **each leg pinned to its OWN distinct scenario** — pairwise-distinct names,
+//!     so a leg-crossing re-route (Jepsen → the integration scenario) is red [iter-2];
+//!   * **distinct fault posture per leg** — the Jepsen nemesis really injects a
+//!     partition + clock-skew + pause, integration partitions, Tier-2 has none
+//!     [iter-2: "ClockSkew unwired", "Partition≡pause"];
+//!   * **the partition targets a quorum-safe data-plane minority of a ≥3-store Raft
+//!     group** — the load-bearing iteration-3 fix, delegated to the shared seam and
+//!     cross-checked against the REAL `deploy/tikv-raft-3/` compose file.
+
+use std::path::{Path, PathBuf};
+
+use wyrd_testkit::meta_faults::{count_data_plane_stores, MetaFault, MIN_DEMONSTRABLE_REPLICAS};
+use xtask::meta_dispatch::{meta_dispatch, MetaLeg, META_JEPSEN, META_LEGS};
+
+fn workspace_root() -> PathBuf {
+    Path::new(env!("CARGO_MANIFEST_DIR"))
+        .parent()
+        .expect("xtask is nested under the workspace root")
+        .to_path_buf()
+}
+
+/// The scenario file a leg routes to — the runnable `--test` target.
+fn scenario_path(leg: &MetaLeg) -> PathBuf {
+    workspace_root()
+        .join("crates/metadata-tikv/tests")
+        .join(format!("{}.rs", leg.scenario))
+}
+
+// ─── routing resolves to a real, runnable target (iter-1) ─────────────────────
+
+#[test]
+fn every_leg_routes_to_a_scenario_file_that_exists() {
+    for leg in META_LEGS {
+        let path = scenario_path(leg);
+        assert!(
+            path.is_file(),
+            "`cargo xtask {}` routes to `-p {} --test {}`, but {} does not exist — a route to a \
+             non-existent (or typo'd) scenario would never run",
+            leg.subcommand,
+            leg.package,
+            leg.scenario,
+            path.display()
+        );
+        assert_eq!(
+            leg.package, "wyrd-metadata-tikv",
+            "the metadata swap must be proven on the backend crate, behind the unchanged trait"
+        );
+    }
+}
+
+#[test]
+fn dispatch_round_trips_and_rejects_unknown_subcommands() {
+    for leg in META_LEGS {
+        assert_eq!(
+            meta_dispatch(leg.subcommand).as_ref(),
+            Some(leg),
+            "each subcommand must route back to its own leg"
+        );
+    }
+    assert!(
+        meta_dispatch("jepsen").is_none(),
+        "the chunkstore Jepsen leg is a different command"
+    );
+    assert!(meta_dispatch("").is_none());
+}
+
+// ─── each leg pinned to its OWN distinct scenario + fault posture (iter-2) ─────
+
+#[test]
+fn the_three_legs_are_pairwise_distinct_scenarios() {
+    let scenarios: Vec<&str> = META_LEGS.iter().map(|l| l.scenario).collect();
+    for (i, a) in scenarios.iter().enumerate() {
+        for b in &scenarios[i + 1..] {
+            assert_ne!(
+                a, b,
+                "each realism-ladder leg must pin its OWN scenario, not share one"
+            );
+        }
+    }
+    assert_eq!(scenarios.len(), 3, "integration + Jepsen + Tier-2");
+}
+
+#[test]
+fn each_leg_carries_its_own_fault_posture() {
+    // A leg-crossing re-route (Jepsen routed to the integration scenario, or the
+    // Jepsen nemesis dropped) changes one of these signatures and reddens.
+
+    let integration = meta_dispatch("meta-integration").unwrap();
+    assert_eq!(
+        integration.faults,
+        &[MetaFault::Partition],
+        "integration is all-or-nothing under a real partition/contention"
+    );
+
+    let jepsen = meta_dispatch("meta-jepsen").unwrap();
+    assert_eq!(
+        jepsen.faults,
+        &[MetaFault::Partition, MetaFault::ClockSkew, MetaFault::Pause],
+        "the Jepsen nemesis injects a REAL partition + clock-skew + process-pause — the three \
+         fault kinds Success criterion (b) names (not a single degenerate kind)"
+    );
+
+    let tier2 = meta_dispatch("meta-tier2").unwrap();
+    assert!(
+        tier2.faults.is_empty(),
+        "Tier-2 is one real machine's honest single-node I/O — no network nemesis"
+    );
+    assert_eq!(
+        tier2.replicas, 1,
+        "Tier-2 is a single honest node, not a Raft group"
+    );
+}
+
+// ─── the partition targets a quorum-safe minority of a ≥3-store Raft group (iter-3) ─
+
+#[test]
+fn partition_legs_plan_a_quorum_safe_data_plane_minority() {
+    for leg in META_LEGS {
+        let plan = leg
+            .partition_plan()
+            .expect("a partition leg must stand up a data plane that can demonstrate the property");
+        match (leg.partitions_data_plane(), plan) {
+            (true, Some(plan)) => {
+                // The load-bearing fix: fault a strict quorum-safe MINORITY (never a
+                // majority — that only makes the store unavailable, iteration-3), and
+                // it must be a real network partition (not a pause, iteration-2).
+                assert!(
+                    leg.replicas >= MIN_DEMONSTRABLE_REPLICAS,
+                    "a partition leg needs a >=3-store Raft group, has {}",
+                    leg.replicas
+                );
+                assert!(
+                    plan.keeps_quorum(),
+                    "the surviving majority must stay available"
+                );
+                assert!(
+                    plan.is_maximal(),
+                    "isolate the largest quorum-safe minority"
+                );
+                assert_eq!(plan.fault, MetaFault::Partition, "a real network cut");
+                assert!(!plan.faulted.is_empty());
+            }
+            (false, None) => { /* the no-nemesis Tier-2 leg has no partition to plan */ }
+            (has, plan) => panic!(
+                "leg {} partitions={has} but produced plan {plan:?} — mismatch",
+                leg.subcommand
+            ),
+        }
+    }
+}
+
+#[test]
+fn the_deploy_stack_declares_a_real_three_store_raft_group() {
+    // Tie the pure planner to the REAL topology: the Jepsen leg's partition is only
+    // falsifiable because `deploy/tikv-raft-3/` actually stands up >=3 TiKV stores.
+    // Revert that compose to a single store and this goes red — the iteration-3
+    // "single TiKV replica proves nothing" finding, encoded as a red→green oracle.
+    let compose = workspace_root().join("deploy/tikv-raft-3/docker-compose.yml");
+    let yaml = std::fs::read_to_string(&compose)
+        .unwrap_or_else(|e| panic!("read {}: {e}", compose.display()));
+    let stores = count_data_plane_stores(&yaml);
+    assert!(
+        stores >= MIN_DEMONSTRABLE_REPLICAS,
+        "{} must declare a >=3-store TiKV Raft group (found {stores}) so the Jepsen partition \
+         isolates a minority while a majority keeps serving — a single-store data plane can only \
+         go unavailable, never split-brain",
+        compose.display()
+    );
+    assert_eq!(
+        stores, META_JEPSEN.replicas,
+        "the Jepsen leg's data-plane replica count must match the deploy stack it stands up"
+    );
+}
