+// ============================================================================
+// M4.6 — metadata-swap realism-ladder runners (#257; proposal 0015 §"DST and
+// tests", §"Suggested PR sequence" item 6)
+//
+// The three legs across the redb→TiKV **metadata** backend swap (behind the
+// unchanged `MetadataStore` trait): Tier-1 integration, Tier-1 Jepsen, Tier-2. The
+// pure routing/nemesis-plan decision lives in `xtask::meta_dispatch` (+ the shared
+// `wyrd_testkit::meta_faults` seam) and is unit-tested at Check; these runners are
+// the privileged, off-Check orchestration (`WYRD_TIER1` / `WYRD_TIER2`), deferred
+// and skipping cleanly by default exactly like the M3 legs above.
+//
+// The load-bearing Jepsen fault is a **real partition of a quorum-safe minority of
+// the TiKV data plane** (iteration-3: a single-replica store can only go
+// unavailable, never split-brain), synchronized to overlap live load via a
+// signal-file handshake, with EVERY injection result checked (iteration-2: a
+// discarded `pause` result could pass with the nemesis never applied).
+// ============================================================================
+
+use wyrd_testkit::meta_faults::{MetaFault, PartitionPlan};
+use xtask::meta_dispatch::{meta_dispatch, MetaLeg};
+
+/// The 3-store TiKV Raft-group compose project (host networking; `deploy/tikv-raft-3`).
+const RAFT3_PROJECT: &str = "wyrd-tikv-raft-3-m46";
+/// The single-node throwaway TiKV compose project reused for the Tier-2 real-I/O leg.
+const META_TIER2_PROJECT: &str = "wyrd-tikv-m46-tier2";
+/// PD client endpoints the host client dials (host-networked, distinct ports).
+const RAFT3_PD_ENDPOINTS: &str = "127.0.0.1:2479,127.0.0.1:2481,127.0.0.1:2483";
+/// Single-node PD endpoint (`deploy/tikv-single-node`, host networking).
+const META_TIER2_PD_ENDPOINT: &str = "127.0.0.1:2379";
+
+/// The data-plane store services, indexed as the [`PartitionPlan`] indexes them,
+/// each paired with the distinct host TCP port it binds/advertises (see
+/// `deploy/tikv-raft-3/docker-compose.yml`). The nemesis targets the store the plan
+/// names, by BOTH its compose service (for `pause`) and its loopback port (for the
+/// `iptables` partition).
+const RAFT3_STORES: &[(&str, u16)] = &[("tikv0", 20160), ("tikv1", 20161), ("tikv2", 20162)];
+
+/// **Tier-1 metadata integration** (Success criterion (a)): end-to-end PUT/GET +
+/// multi-key atomic create/rename/delete on real TiKV behind the unchanged trait,
+/// all-or-nothing under a real data-plane partition/contention. Opt in `WYRD_TIER1=1`.
+pub fn run_meta_integration() -> Result<(), String> {
+    run_meta_partition_leg(meta_leg("meta-integration"), "WYRD_TIER1")
+}
+
+/// **Tier-1 metadata Jepsen** (Success criterion (b)): a nemesis injecting a real
+/// partition + clock skew + process pause validates the single-zone consistency
+/// clauses (clause-2 commit-point linearizability + exactly-one-winner under genuine
+/// concurrency) on the 3-store TiKV Raft group. Opt in `WYRD_TIER1=1`.
+pub fn run_meta_jepsen() -> Result<(), String> {
+    run_meta_partition_leg(meta_leg("meta-jepsen"), "WYRD_TIER1")
+}
+
+/// **Tier-2 metadata single-node I/O** (Success criterion (c)): a run on one real
+/// machine (real `fsync`, real NVMe, real OS) green for honest single-node I/O
+/// semantics — no network nemesis. Opt in `WYRD_TIER2=1`.
+pub fn run_meta_tier2() -> Result<(), String> {
+    let leg = meta_leg("meta-tier2");
+    let p = plan(
+        "Tier-2 metadata single-node I/O",
+        "docker",
+        opted_in("WYRD_TIER2"),
+        tool_available("docker"),
+    );
+    match p {
+        Plan::Deferred(reason) => {
+            eprintln!("xtask: {reason}");
+            return Ok(());
+        }
+        Plan::MissingTool(msg) => return Err(msg),
+        Plan::Run => {}
+    }
+
+    let compose = crate::workspace_root()
+        .join("deploy/tikv-single-node/docker-compose.yml")
+        .to_string_lossy()
+        .to_string();
+    meta_compose(META_TIER2_PROJECT, &compose, &["up", "-d"])?;
+    let result = crate::wait_for_port(META_TIER2_PD_ENDPOINT)
+        .and_then(|()| run_meta_scenario(&leg, META_TIER2_PD_ENDPOINT, None));
+    // Best-effort teardown — a failed teardown must not mask the real result.
+    let _ = meta_compose(
+        META_TIER2_PROJECT,
+        &compose,
+        &["down", "-v", "--remove-orphans"],
+    );
+    result?;
+    println!("\nxtask meta-tier2: single-node real-I/O metadata semantics passed");
+    Ok(())
+}
+
+/// Look the leg up from the pure dispatch, panicking on an internal wiring bug (a
+/// subcommand this file names that `meta_dispatch` does not know is a code error,
+/// not a user error).
+fn meta_leg(subcommand: &str) -> MetaLeg {
+    meta_dispatch(subcommand)
+        .unwrap_or_else(|| panic!("internal: no meta leg routes `{subcommand}`"))
+}
+
+/// Bring up the 3-store Raft group, drive the leg's scenario under a real
+/// data-plane nemesis synchronized to overlap live load, then heal + tear down.
+///
+/// The scenario child runs concurrently; it writes the handshake signal file once
+/// its CAS load is live. The runner waits for that signal, THEN injects each of the
+/// leg's fault kinds against a quorum-safe minority store (checking every result),
+/// heals, and joins the child. So the fault provably overlaps live load, on the data
+/// plane, and cannot be silently skipped.
+fn run_meta_partition_leg(leg: MetaLeg, opt_in_var: &str) -> Result<(), String> {
+    let p = plan(
+        "Tier-1 metadata (partition)",
+        "docker",
+        opted_in(opt_in_var),
+        tool_available("docker"),
+    );
+    match p {
+        Plan::Deferred(reason) => {
+            eprintln!("xtask: {reason}");
+            return Ok(());
+        }
+        Plan::MissingTool(msg) => return Err(msg),
+        Plan::Run => {}
+    }
+
+    // The load-bearing plan: which quorum-safe minority of the data plane to fault.
+    // A `TopologyTooSmall` here is a wiring bug (the leg's `replicas` is < 3), surfaced
+    // loudly rather than run against an undemonstrable cluster.
+    let partition = leg
+        .partition_plan()
+        .map_err(|e| format!("meta {}: {e}", leg.subcommand))?
+        .expect("a partition leg must yield a plan");
+
+    let compose = crate::workspace_root()
+        .join("deploy/tikv-raft-3/docker-compose.yml")
+        .to_string_lossy()
+        .to_string();
+
+    meta_compose(RAFT3_PROJECT, &compose, &["up", "-d"])?;
+    let result = meta_partition_run(&leg, &partition, &compose);
+    // Best-effort teardown (which also drops any leaked iptables rule via container
+    // removal is NOT guaranteed, so `meta_partition_run` heals its own rules on every
+    // path); a failed teardown must not mask the real result.
+    let _ = meta_compose(RAFT3_PROJECT, &compose, &["down", "-v", "--remove-orphans"]);
+    result?;
+    println!(
+        "\nxtask {}: metadata swap held its consistency clauses on real TiKV under a real \
+         data-plane partition",
+        leg.subcommand
+    );
+    Ok(())
+}
+
+/// Wait for the cluster to accept connections, launch the scenario child, then run
+/// the synchronized nemesis against the planned minority store.
+fn meta_partition_run(
+    leg: &MetaLeg,
+    partition: &PartitionPlan,
+    compose: &str,
+) -> Result<(), String> {
+    for endpoint in RAFT3_PD_ENDPOINTS.split(',') {
+        crate::wait_for_port(endpoint)?;
+    }
+
+    // A per-run signal file the scenario creates once its load is live.
+    let signal = crate::workspace_root()
+        .join("target")
+        .join(format!("meta-fault-signal-{}", std::process::id()));
+    let _ = std::fs::remove_file(&signal);
+
+    // Launch the scenario child (non-blocking) so the runner can fault WHILE it runs.
+    let mut child = spawn_meta_scenario(leg, RAFT3_PD_ENDPOINTS, Some(&signal))?;
+
+    // Barrier: the fault must overlap live load, so wait for the scenario's signal
+    // BEFORE injecting (iteration-2: a wall-clock window can hit a healed cluster).
+    let nemesis = wait_for_signal(&signal, std::time::Duration::from_secs(180))
+        .and_then(|()| apply_meta_nemesis(leg, partition, compose));
+
+    // Join the scenario regardless of the nemesis outcome so no child leaks.
+    let child_status = child.wait();
+    let _ = std::fs::remove_file(&signal);
+
+    nemesis?;
+    match child_status {
+        Ok(status) if status.success() => Ok(()),
+        Ok(status) => Err(format!(
+            "meta {} scenario failed with {status}",
+            leg.subcommand
+        )),
+        Err(e) => Err(format!(
+            "meta {} scenario: wait failed: {e}",
+            leg.subcommand
+        )),
+    }
+}
+
+/// Inject each of the leg's fault kinds against a quorum-safe minority store, in
+/// order, holding each so it overlaps load, then healing it — checking EVERY result
+/// so a fault that failed to apply is a hard error, never a silent pass.
+fn apply_meta_nemesis(
+    leg: &MetaLeg,
+    partition: &PartitionPlan,
+    compose: &str,
+) -> Result<(), String> {
+    // The planned faulted store (the minority). One index for a 3-store group.
+    let victim = *partition
+        .faulted
+        .first()
+        .expect("a partition plan faults at least one store");
+    let (service, port) = RAFT3_STORES
+        .get(victim)
+        .copied()
+        .ok_or_else(|| format!("planned store index {victim} is outside the data plane"))?;
+
+    for &fault in leg.faults {
+        println!(
+            "\nxtask {}: injecting {fault:?} on data-plane store {service} (port {port})",
+            leg.subcommand
+        );
+        inject_meta_fault(fault, service, port, compose)?;
+        let hold = fault.window_ms().unwrap_or(6_000);
+        std::thread::sleep(std::time::Duration::from_millis(hold));
+        heal_meta_fault(fault, service, port, compose)?;
+    }
+    Ok(())
+}
+
+/// Apply one real fault to the victim store. Every mechanism's result is checked
+/// (`?`), so a fault that did not take hold fails the leg loudly.
+fn inject_meta_fault(
+    fault: MetaFault,
+    service: &str,
+    port: u16,
+    compose: &str,
+) -> Result<(), String> {
+    match fault {
+        // A REAL network partition: drop loopback TCP to the store's port, cutting
+        // it from clients AND peers (host networking → all on 127.0.0.1). Needs root
+        // (the privileged Tier job); distinct from a process pause.
+        MetaFault::Partition => iptables_port(true, port),
+        // Injected packet latency on the loopback link (needs NET_ADMIN).
+        MetaFault::Latency => meta_exec(
+            compose,
+            service,
+            &[
+                "tc", "qdisc", "add", "dev", "lo", "root", "netem", "delay", "200ms",
+            ],
+        ),
+        // Clock skew (needs SYS_TIME) — a distinct kind, now actually wired.
+        MetaFault::ClockSkew => meta_exec(compose, service, &["date", "-s", "+8min"]),
+        // A process pause (SIGSTOP) — the store stops responding without a net cut.
+        MetaFault::Pause => meta_compose(RAFT3_PROJECT, compose, &["pause", service]),
+    }
+}
+
+/// Undo the fault applied by [`inject_meta_fault`]. Checked, so a failed heal is
+/// surfaced (a stuck partition would poison later rounds).
+fn heal_meta_fault(
+    fault: MetaFault,
+    service: &str,
+    port: u16,
+    compose: &str,
+) -> Result<(), String> {
+    match fault {
+        MetaFault::Partition => iptables_port(false, port),
+        MetaFault::Latency => meta_exec(
+            compose,
+            service,
+            &["tc", "qdisc", "del", "dev", "lo", "root", "netem"],
+        ),
+        MetaFault::ClockSkew => meta_exec(compose, service, &["date", "-s", "-8min"]),
+        MetaFault::Pause => meta_compose(RAFT3_PROJECT, compose, &["unpause", service]),
+    }
+}
+
+/// Add (`add=true`) or delete a loopback `INPUT` DROP rule on `port` — a real
+/// partition of the store bound there. `iptables` needs root; a non-zero exit is a
+/// hard error (the opted-in Tier job promised the privilege).
+fn iptables_port(add: bool, port: u16) -> Result<(), String> {
+    let flag = if add { "-A" } else { "-D" };
+    let dport = port.to_string();
+    let args = [
+        "iptables", flag, "INPUT", "-p", "tcp", "--dport", &dport, "-j", "DROP",
+    ];
+    crate::print_step(&args);
+    let status = Command::new(args[0])
+        .args(&args[1..])
+        .status()
+        .map_err(|e| format!("failed to spawn iptables: {e}"))?;
+    if status.success() {
+        Ok(())
+    } else {
+        Err(format!("`{}` failed with {status}", args.join(" ")))
+    }
+}
+
+/// `docker compose -p <RAFT3_PROJECT> exec -T <service> <cmd…>` — checked.
+fn meta_exec(compose: &str, service: &str, cmd: &[&str]) -> Result<(), String> {
+    let mut full = vec![
+        "compose",
+        "-p",
+        RAFT3_PROJECT,
+        "-f",
+        compose,
+        "exec",
+        "-T",
+        service,
+    ];
+    full.extend_from_slice(cmd);
+    let mut display = vec!["docker"];
+    display.extend_from_slice(&full);
+    crate::print_step(&display);
+    let status = Command::new("docker")
+        .args(&full)
+        .current_dir(crate::workspace_root())
+        .status()
+        .map_err(|e| format!("failed to spawn docker exec: {e}"))?;
+    if status.success() {
+        Ok(())
+    } else {
+        Err(format!("`docker {}` failed with {status}", full.join(" ")))
+    }
+}
+
+/// A checked `docker compose -p <project> -f <file> <args…>` for the meta legs.
+fn meta_compose(project: &str, compose: &str, args: &[&str]) -> Result<(), String> {
+    let mut full = vec!["compose", "-p", project, "-f", compose];
+    full.extend_from_slice(args);
+    let mut display = vec!["docker"];
+    display.extend_from_slice(&full);
+    crate::print_step(&display);
+    let status = Command::new("docker")
+        .args(&full)
+        .current_dir(crate::workspace_root())
+        .status()
+        .map_err(|e| format!("failed to spawn docker: {e}"))?;
+    if status.success() {
+        Ok(())
+    } else {
+        Err(format!("`docker {}` failed with {status}", full.join(" ")))
+    }
+}
+
+/// Poll for the scenario's handshake `signal` file (created once its load is live),
+/// up to `timeout`. A timeout is a hard error — without the handshake the fault
+/// cannot be proven to overlap load, so the leg must not proceed silently.
+fn wait_for_signal(signal: &std::path::Path, timeout: std::time::Duration) -> Result<(), String> {
+    let deadline = std::time::Instant::now() + timeout;
+    while std::time::Instant::now() < deadline {
+        if signal.exists() {
+            return Ok(());
+        }
+        std::thread::sleep(std::time::Duration::from_millis(200));
+    }
+    Err(format!(
+        "the scenario never signalled its load was live ({}) within {:?} — cannot inject a \
+         fault that provably overlaps load",
+        signal.display(),
+        timeout
+    ))
+}
+
+/// Build the `cargo test --features tikv --test <scenario> -- --ignored` argv for a
+/// leg, with the PD endpoints and (optional) fault-signal path exported.
+fn meta_scenario_command(
+    leg: &MetaLeg,
+    endpoints: &str,
+    signal: Option<&std::path::Path>,
+) -> Command {
+    let mut cmd = Command::new("cargo");
+    cmd.args([
+        "test",
+        "-p",
+        leg.package,
+        "--features",
+        "tikv",
+        "--test",
+        leg.scenario,
+        "--",
+        "--ignored",
+        "--nocapture",
+    ])
+    .current_dir(crate::workspace_root())
+    .env("WYRD_TIKV_PD_ENDPOINTS", endpoints);
+    if let Some(signal) = signal {
+        cmd.env("WYRD_TIER1_FAULT_SIGNAL", signal);
+    }
+    cmd
+}
+
+/// Spawn the scenario as a child so the runner can fault while it runs.
+fn spawn_meta_scenario(
+    leg: &MetaLeg,
+    endpoints: &str,
+    signal: Option<&std::path::Path>,
+) -> Result<std::process::Child, String> {
+    crate::print_step(&[
+        "cargo",
+        "test",
+        "-p",
+        leg.package,
+        "--features",
+        "tikv",
+        "--test",
+        leg.scenario,
+        "--",
+        "--ignored",
+    ]);
+    meta_scenario_command(leg, endpoints, signal)
+        .spawn()
+        .map_err(|e| format!("failed to spawn meta {} scenario: {e}", leg.subcommand))
+}
+
+/// Run a leg's scenario to completion (the no-nemesis Tier-2 path).
+fn run_meta_scenario(
+    leg: &MetaLeg,
+    endpoints: &str,
+    signal: Option<&std::path::Path>,
+) -> Result<(), String> {
+    crate::print_step(&[
+        "cargo",
+        "test",
+        "-p",
+        leg.package,
+        "--features",
+        "tikv",
+        "--test",
+        leg.scenario,
+        "--",
+        "--ignored",
+    ]);
+    let status = meta_scenario_command(leg, endpoints, signal)
+        .status()
+        .map_err(|e| format!("failed to spawn meta {} scenario: {e}", leg.subcommand))?;
+    if status.success() {
+        Ok(())
+    } else {
+        Err(format!(
+            "meta {} scenario failed with {status}",
+            leg.subcommand
+        ))
+    }
+}
+
