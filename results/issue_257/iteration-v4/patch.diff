@@ -0,0 +1,263 @@
+//! **Tier-1 Jepsen consistency over the metadata swap** (M4.6, #257; proposal 0015
+//! §"DST and tests" → "Jepsen consistency", §"Suggested PR sequence" item 6) — the
+//! realism-ladder Jepsen leg extended across the redb→TiKV **metadata** backend swap.
+//!
+//! # The topology is load-bearing (the iteration-3 fix)
+//!
+//! The Jepsen line began at M2 over the networked chunkstore path
+//! (`crates/chunkstore-grpc/tests/tier1_jepsen_consistency.rs`) and is extended here
+//! across the backend swap. Crucially, this leg drives a **3-store TiKV Raft group**
+//! (`deploy/tikv-raft-3/`), NOT a single store: `cargo xtask meta-jepsen` injects a
+//! **real network partition of a quorum-safe MINORITY** (one of three stores) while
+//! this load runs. The surviving two-store **majority keeps serving**, so under the
+//! partition the cluster stays *available* AND must stay *consistent* — the strong
+//! property. (A single-replica store could only go *unavailable* under a partition,
+//! never split-brain, so it can never fail this criterion; that is why the earlier
+//! single-node-pause attempt proved nothing and was rejected.)
+//!
+//! # The property this leg pins (proposal 0015; ADR-0015 clause 2, single-zone)
+//!
+//! - **exactly-one-winner under a real partition:** for a `require`-guarded key, at
+//!   most **one** racer ever reports `Committed` — never two winners. A metadata-layer
+//!   non-atomic commit would surface here as two winners while the majority served.
+//! - **clause 2 — commit-point linearizability:** once a key has a committed winner,
+//!   every subsequent read returns **that** value, and it is stable.
+//! - **availability under a minority partition:** because a two-store majority keeps
+//!   quorum, commits keep landing across the partition-and-heal — at least one round
+//!   commits, so the run is not vacuous (an all-`Err` run would mean the cluster went
+//!   unavailable, which a minority partition must NOT cause).
+//!
+//! Single-zone only (clause 1 collapses into zonal linearizability; Tier-3/multi-region
+//! does not begin until M9, §13.4).
+//!
+//! **The nemesis is injected by the runner, synchronized to overlap live load.** This
+//! body **refuses to run without the runner's handshake** (`WYRD_TIER1_FAULT_SIGNAL`):
+//! it creates that signal only once its load is live, and the runner waits for it
+//! before partitioning a store, so the fault provably overlaps load. Run without the
+//! handshake (no nemesis) it fails loudly rather than passing vacuously.
+//!
+//! **Gated** like every tier test: `#[ignore]` + a clean skip when
+//! `WYRD_TIKV_PD_ENDPOINTS` is unset, so `cargo xtask ci` compiles the body but never
+//! runs it. Run it for real via `cargo xtask meta-jepsen` (`WYRD_TIER1=1`).
+
+/// The PD endpoints, or `None` when TiKV is not configured — the family-wide skip gate.
+fn pd_endpoints() -> Option<Vec<String>> {
+    match std::env::var("WYRD_TIKV_PD_ENDPOINTS") {
+        Ok(raw) if !raw.trim().is_empty() => Some(
+            raw.split(',')
+                .map(|e| e.trim().to_string())
+                .filter(|e| !e.is_empty())
+                .collect(),
+        ),
+        _ => None,
+    }
+}
+
+/// The runner's handshake signal-file path (the test creates it once its load is
+/// live and the runner waits for it before partitioning a store), or `None`.
+fn fault_signal_path() -> Option<std::path::PathBuf> {
+    match std::env::var("WYRD_TIER1_FAULT_SIGNAL") {
+        Ok(p) if !p.trim().is_empty() => Some(std::path::PathBuf::from(p.trim())),
+        _ => None,
+    }
+}
+
+#[test]
+#[ignore = "Tier-1: needs a 3-store TiKV Raft group + partition injection — run via `cargo xtask meta-jepsen`"]
+fn commit_point_linearizable_and_exactly_one_winner_across_a_data_plane_partition() {
+    let Some(endpoints) = pd_endpoints() else {
+        eprintln!(
+            "tier1_jepsen_metadata: WYRD_TIKV_PD_ENDPOINTS unset — skipping (clean skip; the \
+             gate stays green without a TiKV). Run `cargo xtask meta-jepsen`."
+        );
+        return;
+    };
+    // A Jepsen run with no injected nemesis proves nothing — refuse it loudly.
+    let signal = fault_signal_path().unwrap_or_else(|| {
+        panic!(
+            "tier1_jepsen_metadata: WYRD_TIER1_FAULT_SIGNAL is absent — no nemesis handshake was \
+             wired, so no partition can be synchronized to overlap load. Run via `cargo xtask \
+             meta-jepsen`, which partitions a quorum-safe minority of the 3-store Raft group \
+             while this load runs."
+        )
+    });
+    run(endpoints, signal);
+}
+
+#[cfg(feature = "tikv")]
+fn run(endpoints: Vec<String>, signal: std::path::PathBuf) {
+    use std::sync::Arc;
+    use std::time::{Duration, Instant};
+    use wyrd_traits::{CommitOutcome, MetadataStore, WriteBatch};
+
+    const RACERS: usize = 8;
+    const LOAD: Duration = Duration::from_secs(35); // must outlast the runner's nemesis window
+
+    let runtime = tokio::runtime::Builder::new_multi_thread()
+        .worker_threads(4)
+        .enable_all()
+        .build()
+        .expect("tokio runtime");
+
+    runtime.block_on(async move {
+        use futures_util::future::join_all;
+
+        let namespace = format!("wyrd-tier1-jepsen/{}/", std::process::id()).into_bytes();
+        let store = Arc::new(
+            wyrd_metadata_tikv::TikvMetadataStore::connect(endpoints)
+                .await
+                .expect("connect to TiKV")
+                .with_namespace(namespace),
+        );
+
+        // Warm-up commit BEFORE signalling, so the partition lands on a serving cluster.
+        let warm = b"warmup".as_slice();
+        assert_eq!(
+            store
+                .commit(WriteBatch::new().require_absent(warm).put(warm, &b"1"[..]))
+                .await
+                .expect("warm-up commit before the fault window"),
+            CommitOutcome::Committed,
+        );
+
+        // Signal the runner: our CAS load is now live — inject the partition.
+        std::fs::write(&signal, b"live")
+            .unwrap_or_else(|e| panic!("write fault-signal {}: {e}", signal.display()));
+
+        let mut committed_rounds = 0usize;
+        let mut round = 0usize;
+        let deadline = Instant::now() + LOAD;
+        while Instant::now() < deadline {
+            round += 1;
+            let key: Vec<u8> = format!("inode:{round}").into_bytes();
+
+            // Seed the key at v0. Under a MINORITY partition the majority keeps serving,
+            // so this normally succeeds; a transient Err during a leader election is
+            // tolerated (retry briefly) — only race rounds that were seeded.
+            if !seed_with_retry(&store, &key).await {
+                continue;
+            }
+
+            // N racers CAS v0 → "w{i}", concurrent with the runner's data-plane partition.
+            let racers = (0..RACERS).map(|i| {
+                let store = Arc::clone(&store);
+                let key = key.clone();
+                async move {
+                    store
+                        .commit(
+                            WriteBatch::new()
+                                .require(&key[..], &b"v0"[..])
+                                .put(&key[..], format!("w{i}").into_bytes()),
+                        )
+                        .await
+                }
+            });
+            let outcomes = join_all(racers).await;
+
+            let winners = outcomes
+                .iter()
+                .filter(|o| matches!(o, Ok(CommitOutcome::Committed)))
+                .count();
+            // exactly-one-winner: NEVER two winners. Zero is tolerated transiently (a
+            // racer may hit the partitioned store's brief unavailability and Err), but
+            // two winners is a linearizability violation the partition would expose.
+            assert!(
+                winners <= 1,
+                "round {round}: at most one racer may win the CAS under partition, saw {winners} \
+                 winners ({outcomes:?}) — a split-brain / lost-update violation"
+            );
+
+            if winners == 1 {
+                committed_rounds += 1;
+                // clause 2 — commit-point linearizability: the committed value is what
+                // every subsequent read observes and it is stable.
+                let observed = read_stable(&store, &key).await;
+                assert!(
+                    observed.starts_with(b"w"),
+                    "round {round}: the committed value must be a racer's write, got {:?}",
+                    String::from_utf8_lossy(&observed)
+                );
+                let again = read_stable(&store, &key).await;
+                assert_eq!(
+                    again, observed,
+                    "round {round}: the commit point must be stable (linearizable)"
+                );
+            }
+        }
+
+        // Availability + non-vacuity: a MINORITY partition keeps a majority quorum, so
+        // the cluster must have kept committing across the partition-and-heal. An
+        // all-`Err` run would mean the store went unavailable — which a minority
+        // partition must not cause (and which a single-replica store could not avoid,
+        // the iteration-3 point).
+        assert!(
+            committed_rounds > 0,
+            "no round ever committed across {round} rounds — the majority did not keep serving \
+             under the minority partition, so consistency-under-availability was not exercised"
+        );
+        eprintln!(
+            "tier1_jepsen_metadata: {committed_rounds}/{round} rounds committed across the \
+             data-plane partition; exactly-one-winner and commit-point linearizability held while \
+             the majority stayed available"
+        );
+    });
+}
+
+/// Seed `key` at `v0`, retrying a transient unavailability (a brief region leader
+/// election under the partition) for a bounded time. Returns whether it was seeded.
+#[cfg(feature = "tikv")]
+async fn seed_with_retry(store: &wyrd_metadata_tikv::TikvMetadataStore, key: &[u8]) -> bool {
+    use std::time::{Duration, Instant};
+    use wyrd_traits::{CommitOutcome, MetadataStore, WriteBatch};
+
+    let deadline = Instant::now() + Duration::from_secs(5);
+    loop {
+        match store
+            .commit(WriteBatch::new().require_absent(key).put(key, &b"v0"[..]))
+            .await
+        {
+            Ok(CommitOutcome::Committed) => return true,
+            // Already seeded (a retry after a partial success) — treat as seeded.
+            Ok(CommitOutcome::Conflict) => return true,
+            Err(_) if Instant::now() < deadline => {
+                tokio::time::sleep(Duration::from_millis(200)).await;
+            }
+            Err(_) => return false,
+        }
+    }
+}
+
+/// Read `key` retrying past a transient unavailability until it succeeds, then return
+/// the present value. Fails only if it stays unreadable well past the partition window.
+#[cfg(feature = "tikv")]
+async fn read_stable(store: &wyrd_metadata_tikv::TikvMetadataStore, key: &[u8]) -> Vec<u8> {
+    use std::time::{Duration, Instant};
+    use wyrd_traits::MetadataStore;
+
+    let deadline = Instant::now() + Duration::from_secs(30);
+    loop {
+        match store.get(key).await {
+            Ok(Some(v)) => return v.to_vec(),
+            Ok(None) => panic!(
+                "committed key {:?} read back absent — a lost committed write",
+                String::from_utf8_lossy(key)
+            ),
+            Err(_) if Instant::now() < deadline => {
+                tokio::time::sleep(Duration::from_millis(200)).await;
+            }
+            Err(e) => panic!(
+                "key {:?} stayed unreadable past the partition window: {e}",
+                String::from_utf8_lossy(key)
+            ),
+        }
+    }
+}
+
+#[cfg(not(feature = "tikv"))]
+fn run(endpoints: Vec<String>, signal: std::path::PathBuf) {
+    let _ = (endpoints, signal);
+    eprintln!(
+        "tier1_jepsen_metadata: WYRD_TIKV_PD_ENDPOINTS is set but the crate was built without \
+         `--features tikv` — skipping. Run it via `cargo xtask meta-jepsen`."
+    );
+}
diff --git a/crates/metadata-tikv/tests/tier1_metadata_integration.rs b/crates/metadata-tikv/tests/tier1_metadata_integration.rs
new file mode 100644
index 0000000..e9ba029
--- /dev/null
+++ b/crates/metadata-tikv/tests/tier1_metadata_integration.rs
@@ -0,0 +1,225 @@
+//! **Tier-1 metadata integration over the swap** (M4.6, #257; Success criterion (a);
+//! proposal 0015 §"DST and tests", §"Suggested PR sequence" item 6) — end-to-end
+//! multi-key **atomic** create/rename/delete on real TiKV behind the *unchanged*
+//! `MetadataStore` trait, all-or-nothing under a real data-plane partition/contention.
+//!
+//! Where `tests/tier1_jepsen_metadata.rs` pins exactly-one-winner + commit-point
+//! linearizability, this leg pins the **multi-key atomicity** the filesystem model
+//! rests on: a create/rename/delete touches several keys (a dirent + its inode; an
+//! old dirent removed as a new one is written) and must land **all-or-nothing** — a
+//! reader must never observe a torn, half-applied commit. It drives the SAME
+//! production `TikvMetadataStore::commit` path, on the 3-store Raft group
+//! (`deploy/tikv-raft-3/`), while `cargo xtask meta-integration` partitions a
+//! quorum-safe minority — so the atomicity holds even as a store drops out and the
+//! majority keeps serving.
+//!
+//! The multi-key invariant, checked every round: two keys that a "rename" must move
+//! **together** always read back at the **same generation** — never one advanced and
+//! the other stale (a torn commit). Exactly one concurrent racer wins each
+//! generation; the loser is a `Conflict`, never a fault, never a partial write.
+//!
+//! Gated like every tier test: `#[ignore]` + a clean skip without
+//! `WYRD_TIKV_PD_ENDPOINTS`, real body only under `--features tikv`. Run via
+//! `cargo xtask meta-integration` (`WYRD_TIER1=1`).
+
+fn pd_endpoints() -> Option<Vec<String>> {
+    match std::env::var("WYRD_TIKV_PD_ENDPOINTS") {
+        Ok(raw) if !raw.trim().is_empty() => Some(
+            raw.split(',')
+                .map(|e| e.trim().to_string())
+                .filter(|e| !e.is_empty())
+                .collect(),
+        ),
+        _ => None,
+    }
+}
+
+fn fault_signal_path() -> Option<std::path::PathBuf> {
+    match std::env::var("WYRD_TIER1_FAULT_SIGNAL") {
+        Ok(p) if !p.trim().is_empty() => Some(std::path::PathBuf::from(p.trim())),
+        _ => None,
+    }
+}
+
+#[test]
+#[ignore = "Tier-1: needs a 3-store TiKV Raft group + partition injection — run via `cargo xtask meta-integration`"]
+fn multi_key_atomic_rename_is_all_or_nothing_under_partition() {
+    let Some(endpoints) = pd_endpoints() else {
+        eprintln!(
+            "tier1_metadata_integration: WYRD_TIKV_PD_ENDPOINTS unset — skipping (clean skip; the \
+             gate stays green without a TiKV). Run `cargo xtask meta-integration`."
+        );
+        return;
+    };
+    let signal = fault_signal_path().unwrap_or_else(|| {
+        panic!(
+            "tier1_metadata_integration: WYRD_TIER1_FAULT_SIGNAL is absent — no nemesis handshake \
+             was wired, so atomicity would not be exercised under a partition. Run via `cargo \
+             xtask meta-integration`."
+        )
+    });
+    run(endpoints, signal);
+}
+
+#[cfg(feature = "tikv")]
+fn run(endpoints: Vec<String>, signal: std::path::PathBuf) {
+    use std::sync::Arc;
+    use std::time::{Duration, Instant};
+    use wyrd_traits::{CommitOutcome, MetadataStore, WriteBatch};
+
+    const RACERS: usize = 6;
+    const LOAD: Duration = Duration::from_secs(35);
+
+    let left = b"link:left".to_vec();
+    let right = b"link:right".to_vec();
+
+    let runtime = tokio::runtime::Builder::new_multi_thread()
+        .worker_threads(4)
+        .enable_all()
+        .build()
+        .expect("tokio runtime");
+
+    runtime.block_on(async move {
+        use futures_util::future::join_all;
+
+        let namespace = format!("wyrd-tier1-integration/{}/", std::process::id()).into_bytes();
+        let store = Arc::new(
+            wyrd_metadata_tikv::TikvMetadataStore::connect(endpoints)
+                .await
+                .expect("connect to TiKV")
+                .with_namespace(namespace),
+        );
+
+        // Seed both keys at generation 0 atomically — the create.
+        assert_eq!(
+            store
+                .commit(
+                    WriteBatch::new()
+                        .require_absent(&left[..])
+                        .require_absent(&right[..])
+                        .put(&left[..], gen_value(0))
+                        .put(&right[..], gen_value(0)),
+                )
+                .await
+                .expect("atomic create of the link pair"),
+            CommitOutcome::Committed,
+        );
+
+        // Signal the runner: load is live — inject the partition.
+        std::fs::write(&signal, b"live")
+            .unwrap_or_else(|e| panic!("write fault-signal {}: {e}", signal.display()));
+
+        let mut generation = 0u64;
+        let mut advanced = 0usize;
+        let deadline = Instant::now() + LOAD;
+        while Instant::now() < deadline {
+            // N racers each try the SAME atomic rename: move BOTH keys gen → gen+1,
+            // guarded on both. Exactly one may win; the losers Conflict.
+            let racers = (0..RACERS).map(|_| {
+                let store = Arc::clone(&store);
+                let (left, right) = (left.clone(), right.clone());
+                async move {
+                    store
+                        .commit(
+                            WriteBatch::new()
+                                .require(&left[..], gen_value(generation))
+                                .require(&right[..], gen_value(generation))
+                                .put(&left[..], gen_value(generation + 1))
+                                .put(&right[..], gen_value(generation + 1)),
+                        )
+                        .await
+                }
+            });
+            let outcomes = join_all(racers).await;
+
+            let mut winners = 0usize;
+            for outcome in &outcomes {
+                match outcome {
+                    Ok(CommitOutcome::Committed) => winners += 1,
+                    Ok(CommitOutcome::Conflict) => {}
+                    // Under a minority partition a racer may briefly hit unavailability
+                    // (Err) — tolerated. It must never be a torn/partial write, which the
+                    // read-back invariant below would catch.
+                    Err(_) => {}
+                }
+            }
+            assert!(
+                winners <= 1,
+                "at most one racer may advance the generation, saw {winners} ({outcomes:?})"
+            );
+
+            // The atomicity invariant: read BOTH keys and assert they are at the SAME
+            // generation — never one advanced and the other stale (a torn multi-key
+            // commit). This holds whether or not anyone won this round.
+            if let Some(observed) = read_pair(&store, &left, &right).await {
+                assert_eq!(
+                    observed.0,
+                    observed.1,
+                    "torn multi-key commit: left={:?} right={:?} — a rename must move both keys \
+                     all-or-nothing",
+                    String::from_utf8_lossy(&observed.0),
+                    String::from_utf8_lossy(&observed.1),
+                );
+                if observed.0 == gen_value(generation + 1) {
+                    generation += 1;
+                    advanced += 1;
+                }
+            }
+        }
+
+        // Non-vacuity: the majority kept serving under the minority partition, so the
+        // atomic rename advanced at least once (an all-unavailable run would not be an
+        // atomicity proof).
+        assert!(
+            advanced > 0,
+            "the atomic rename never advanced across the run — the cluster did not keep serving \
+             under the minority partition, so multi-key atomicity was not exercised"
+        );
+        eprintln!(
+            "tier1_metadata_integration: advanced the atomic rename {advanced} generations under \
+             the data-plane partition; every read observed a consistent (non-torn) link pair"
+        );
+    });
+}
+
+/// The value encoding generation `g` — distinct per generation so a torn commit
+/// (mismatched generations across the two keys) is detectable.
+#[cfg(feature = "tikv")]
+fn gen_value(g: u64) -> Vec<u8> {
+    format!("gen{g}").into_bytes()
+}
+
+/// Read both keys, retrying transient unavailability. `None` if it stayed unreadable
+/// past the partition window (surfaced by the caller's non-vacuity assertion).
+#[cfg(feature = "tikv")]
+async fn read_pair(
+    store: &wyrd_metadata_tikv::TikvMetadataStore,
+    left: &[u8],
+    right: &[u8],
+) -> Option<(Vec<u8>, Vec<u8>)> {
+    use std::time::{Duration, Instant};
+    use wyrd_traits::MetadataStore;
+
+    let deadline = Instant::now() + Duration::from_secs(10);
+    loop {
+        match (store.get(left).await, store.get(right).await) {
+            (Ok(Some(l)), Ok(Some(r))) => return Some((l.to_vec(), r.to_vec())),
+            (Ok(None), _) | (_, Ok(None)) => {
+                panic!("a link key read back absent — a lost committed write")
+            }
+            _ if Instant::now() < deadline => {
+                tokio::time::sleep(Duration::from_millis(200)).await;
+            }
+            _ => return None,
+        }
+    }
+}
+
+#[cfg(not(feature = "tikv"))]
+fn run(endpoints: Vec<String>, signal: std::path::PathBuf) {
+    let _ = (endpoints, signal);
+    eprintln!(
+        "tier1_metadata_integration: WYRD_TIKV_PD_ENDPOINTS is set but the crate was built without \
+         `--features tikv` — skipping. Run it via `cargo xtask meta-integration`."
+    );
+}
diff --git a/crates/metadata-tikv/tests/tier2_metadata_io.rs b/crates/metadata-tikv/tests/tier2_metadata_io.rs
new file mode 100644
index 0000000..7f2598b
--- /dev/null
+++ b/crates/metadata-tikv/tests/tier2_metadata_io.rs
@@ -0,0 +1,138 @@
+//! **Tier-2 metadata single-node I/O over the swap** (M4.6, #257; Success criterion
+//! (c); proposal 0015 §"DST and tests" → the Tier-2 "single owned machine" leg,
+//! §"Suggested PR sequence" item 6) — a run on **one real machine** (real `fsync`,
+//! real NVMe, real OS) proving honest single-node I/O semantics of the metadata store
+//! behind the *unchanged* `MetadataStore` trait.
+//!
+//! Tier-2 is deliberately **not** a fault-injection tier (that is Tier-1/Jepsen): a
+//! single node has no partition to demonstrate. It proves the store's ordinary
+//! read-your-writes / durability semantics survive **real** disk I/O — the layer DST
+//! simulates against a fake now exercised against a real TiKV+NVMe. It drives the
+//! SAME production `TikvMetadataStore` get/scan/commit path against the throwaway
+//! single-node stack (`deploy/tikv-single-node/`).
+//!
+//! Gated like every tier test: `#[ignore]` + a clean skip without
+//! `WYRD_TIKV_PD_ENDPOINTS`, real body only under `--features tikv`. Run via
+//! `cargo xtask meta-tier2` (`WYRD_TIER2=1`).
+
+fn pd_endpoints() -> Option<Vec<String>> {
+    match std::env::var("WYRD_TIKV_PD_ENDPOINTS") {
+        Ok(raw) if !raw.trim().is_empty() => Some(
+            raw.split(',')
+                .map(|e| e.trim().to_string())
+                .filter(|e| !e.is_empty())
+                .collect(),
+        ),
+        _ => None,
+    }
+}
+
+#[test]
+#[ignore = "Tier-2: needs a real single-node TiKV on real disk — run via `cargo xtask meta-tier2`"]
+fn put_get_and_multi_key_commit_survive_real_single_node_io() {
+    let Some(endpoints) = pd_endpoints() else {
+        eprintln!(
+            "tier2_metadata_io: WYRD_TIKV_PD_ENDPOINTS unset — skipping (clean skip; the gate \
+             stays green without a TiKV). Run `cargo xtask meta-tier2`."
+        );
+        return;
+    };
+    run(endpoints);
+}
+
+#[cfg(feature = "tikv")]
+fn run(endpoints: Vec<String>) {
+    use wyrd_traits::{CommitOutcome, MetadataStore, WriteBatch};
+
+    let runtime = tokio::runtime::Builder::new_multi_thread()
+        .worker_threads(2)
+        .enable_all()
+        .build()
+        .expect("tokio runtime");
+
+    runtime.block_on(async move {
+        let namespace = format!("wyrd-tier2-io/{}/", std::process::id()).into_bytes();
+        let store = wyrd_metadata_tikv::TikvMetadataStore::connect(endpoints)
+            .await
+            .expect("connect to TiKV")
+            .with_namespace(namespace);
+
+        // PUT then GET — read-your-writes against real fsync/NVMe.
+        let key = b"inode:1".to_vec();
+        assert_eq!(
+            store
+                .commit(
+                    WriteBatch::new()
+                        .require_absent(&key[..])
+                        .put(&key[..], &b"v1"[..])
+                )
+                .await
+                .expect("single-node put must not fault"),
+            CommitOutcome::Committed,
+        );
+        assert_eq!(
+            store
+                .get(&key)
+                .await
+                .expect("get must not fault")
+                .as_deref(),
+            Some(&b"v1"[..]),
+            "read-your-writes must hold on real single-node I/O"
+        );
+
+        // A multi-key atomic commit lands all-or-nothing on real disk.
+        let (a, b) = (b"dir:d/".to_vec(), b"dirent:d/a".to_vec());
+        assert_eq!(
+            store
+                .commit(
+                    WriteBatch::new()
+                        .require_absent(&a[..])
+                        .require_absent(&b[..])
+                        .put(&a[..], &b"meta"[..])
+                        .put(&b[..], &b"inode:1"[..]),
+                )
+                .await
+                .expect("multi-key create must not fault"),
+            CommitOutcome::Committed,
+        );
+
+        // A prefix scan reads back the committed dirent set at one consistent cut.
+        let listing = store.scan(b"dir").await.expect("scan must not fault");
+        assert!(
+            listing.iter().any(|(k, _)| k == &a),
+            "the committed dir key must appear in its prefix scan, got {listing:?}"
+        );
+
+        // A stale CAS is a Conflict (not a fault), even against real disk.
+        assert_eq!(
+            store
+                .commit(
+                    WriteBatch::new()
+                        .require(&key[..], &b"WRONG"[..])
+                        .put(&key[..], &b"v2"[..])
+                )
+                .await
+                .expect("a stale CAS is a Conflict, not a fault"),
+            CommitOutcome::Conflict,
+        );
+        assert_eq!(
+            store.get(&key).await.expect("get").as_deref(),
+            Some(&b"v1"[..]),
+            "a rejected CAS must not have mutated the value",
+        );
+
+        eprintln!(
+            "tier2_metadata_io: read-your-writes, multi-key atomicity, prefix scan, and \
+                   CAS-conflict semantics all held on real single-node I/O"
+        );
+    });
+}
+
+#[cfg(not(feature = "tikv"))]
+fn run(endpoints: Vec<String>) {
+    let _ = endpoints;
+    eprintln!(
+        "tier2_metadata_io: WYRD_TIKV_PD_ENDPOINTS is set but the crate was built without \
+         `--features tikv` — skipping. Run it via `cargo xtask meta-tier2`."
+    );
+}
