+# The M4.6 metadata-swap **Tier-1 Jepsen** cluster: a real 3-store TiKV **Raft
+# group** for exactly-one-winner-under-partition (proposal 0015 §"DST and tests" →
+# the Jepsen leg across the redb→TiKV metadata swap; #257).
+#
+# **Why three stores, not one (the load-bearing iteration-3 fix).** The single-zone
+# "Small multi-node" profile (`deploy/small-multi-node/`, #256) runs ONE `tikv`
+# store — correct for that profile (architecture §7.1: "TiKV (small)"), but a
+# single data replica can only go *unavailable* under a partition, never
+# split-brain. So it cannot demonstrate the binding Jepsen criterion (Success
+# criterion (b); ADR-0015 clause 2): exactly-one-winner is only *falsifiable* when a
+# partition isolates a strict **minority** of a Raft group while the surviving
+# **majority keeps serving** — concurrent CAS still commits, so a non-atomic commit
+# would surface as two winners. This stack stands up THREE TiKV stores
+# (`tikv0/1/2`) with the default replication factor of 3: every region replicates
+# across all three stores, and `cargo xtask meta-jepsen` partitions ONE of them (a
+# quorum-safe minority — `wyrd_testkit::meta_faults::plan_data_plane_partition`),
+# leaving a two-store majority quorum available under load.
+#
+# **Host networking + distinct ports (not bridge).** Unlike `small-multi-node`'s
+# bridge network (whose stores advertise container DNS names a HOST-run client
+# cannot resolve — that stack is only a bring-up smoke check), the Jepsen leg drives
+# the store from a host `cargo test`, so every PD/store must be reachable AND
+# advertised on `127.0.0.1`. Each store therefore binds a DISTINCT host port
+# (20160/1/2) and advertises `127.0.0.1:2016X`, so PD hands the client host-reachable
+# store addresses and the runner can inject a real partition with `iptables` on the
+# loopback port of the minority store (`cargo xtask meta-jepsen`, privileged Tier
+# job). Host networking cannot give three same-port replicas distinct addresses, so
+# distinct ports are mandatory here.
+#
+# Lives under `deploy/`, OUTSIDE the Cargo workspace (ADR-0010). Static endpoints per
+# proposal 0015's Deployment-prerequisite note (L5 discovery is #365, out of scope).
+# Single-zone only: NO L2/L3/TiDB (Tier-3/multi-region does not begin until M9,
+# architecture §13.4). A purpose-built fault-injection cluster, distinct from the
+# `small-multi-node` production profile — not an edit to it.
+name: wyrd-tikv-raft-3-m46
+
+services:
+  # ── PD (Placement Driver) ensemble — 3 nodes on host networking with distinct
+  #    client/peer ports, so PD itself keeps a quorum while a TiKV DATA-plane store
+  #    is partitioned (the fault under test is on the data plane, not PD).
+  pd0:
+    image: pingcap/pd:v8.5.1
+    network_mode: host
+    command:
+      - --name=pd0
+      - --data-dir=/data/pd
+      - --client-urls=http://0.0.0.0:2479
+      - --advertise-client-urls=http://127.0.0.1:2479
+      - --peer-urls=http://0.0.0.0:2480
+      - --advertise-peer-urls=http://127.0.0.1:2480
+      - --initial-cluster=pd0=http://127.0.0.1:2480,pd1=http://127.0.0.1:2482,pd2=http://127.0.0.1:2484
+    volumes:
+      - pd0-data:/data
+    restart: on-failure
+
+  pd1:
+    image: pingcap/pd:v8.5.1
+    network_mode: host
+    command:
+      - --name=pd1
+      - --data-dir=/data/pd
+      - --client-urls=http://0.0.0.0:2481
+      - --advertise-client-urls=http://127.0.0.1:2481
+      - --peer-urls=http://0.0.0.0:2482
+      - --advertise-peer-urls=http://127.0.0.1:2482
+      - --initial-cluster=pd0=http://127.0.0.1:2480,pd1=http://127.0.0.1:2482,pd2=http://127.0.0.1:2484
+    volumes:
+      - pd1-data:/data
+    restart: on-failure
+
+  pd2:
+    image: pingcap/pd:v8.5.1
+    network_mode: host
+    command:
+      - --name=pd2
+      - --data-dir=/data/pd
+      - --client-urls=http://0.0.0.0:2483
+      - --advertise-client-urls=http://127.0.0.1:2483
+      - --peer-urls=http://0.0.0.0:2484
+      - --advertise-peer-urls=http://127.0.0.1:2484
+      - --initial-cluster=pd0=http://127.0.0.1:2480,pd1=http://127.0.0.1:2482,pd2=http://127.0.0.1:2484
+    volumes:
+      - pd2-data:/data
+    restart: on-failure
+
+  # ── The 3-store TiKV DATA plane (the Raft group under test). Default replication
+  #    factor 3 ⇒ every region has a replica on each store, so partitioning ONE
+  #    store (a quorum-safe minority) leaves a two-store majority serving. Each binds
+  #    and advertises a DISTINCT host port (2016X) so a host client reaches all
+  #    three and the runner's `iptables` partition targets one store's loopback port.
+  tikv0:
+    image: pingcap/tikv:v8.5.1
+    network_mode: host
+    depends_on: [pd0, pd1, pd2]
+    command:
+      - --addr=127.0.0.1:20160
+      - --advertise-addr=127.0.0.1:20160
+      - --status-addr=127.0.0.1:20180
+      - --data-dir=/data/tikv
+      - --pd-endpoints=127.0.0.1:2479,127.0.0.1:2481,127.0.0.1:2483
+    volumes:
+      - tikv0-data:/data
+    restart: on-failure
+
+  tikv1:
+    image: pingcap/tikv:v8.5.1
+    network_mode: host
+    depends_on: [pd0, pd1, pd2]
+    command:
+      - --addr=127.0.0.1:20161
+      - --advertise-addr=127.0.0.1:20161
+      - --status-addr=127.0.0.1:20181
+      - --data-dir=/data/tikv
+      - --pd-endpoints=127.0.0.1:2479,127.0.0.1:2481,127.0.0.1:2483
+    volumes:
+      - tikv1-data:/data
+    restart: on-failure
+
+  tikv2:
+    image: pingcap/tikv:v8.5.1
+    network_mode: host
+    depends_on: [pd0, pd1, pd2]
+    command:
+      - --addr=127.0.0.1:20162
+      - --advertise-addr=127.0.0.1:20162
+      - --status-addr=127.0.0.1:20182
+      - --data-dir=/data/tikv
+      - --pd-endpoints=127.0.0.1:2479,127.0.0.1:2481,127.0.0.1:2483
+    volumes:
+      - tikv2-data:/data
+    restart: on-failure
+
+volumes:
+  pd0-data:
+  pd1-data:
+  pd2-data:
+  tikv0-data:
+  tikv1-data:
+  tikv2-data:
