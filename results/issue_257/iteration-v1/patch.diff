+/// Where a metadata-swap runner routes once opted in: the in-repo `cargo test
+/// -p <package> --features tikv --test <test> -- --ignored` scenario. Modeled as a value
+/// (like [`JepsenDispatch`]) so a Check-time dispatch test binds to it: a regression
+/// re-pointing a metadata leg at the **chunkstore** package/scenario (`wyrd-chunkstore-grpc`
+/// / `tier1_jepsen_consistency` — the M2/M3 repair path, the WRONG system) flips that test
+/// red. That is exactly the defect this slice fixes: the pre-M4 tiers proved the
+/// chunkstore path, not the metadata swap (proposal 0015 §"DST and tests").
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(crate) struct MetaDispatch {
+    /// The cargo package the scenario lives in — always the metadata backend crate.
+    pub package: &'static str,
+    /// The `--test <name>` scenario target that drives the production `MetadataStore`.
+    pub test: &'static str,
+    /// The opt-in env var the dedicated off-Check job sets (`WYRD_TIER1` / `WYRD_TIER2`).
+    pub opt_in_var: &'static str,
