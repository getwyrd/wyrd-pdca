+/// The **real-TiKV-cluster fault model** (proposal 0015 §"Crate touch-points":
+/// "`testkit` — a real-TiKV-cluster fault seam (**partition/latency/pause**) for the
+/// Tier-1 integration + Jepsen runs"; §"DST and tests": the M4 single-zone topology
+/// under `tc netem` / `iptables` partitions / cgroup throttling / `libfaketime` clock
+/// skew). A `MetaFault` is a **software-defined** fault the Tier-1 nemesis injects on a
+/// node of the *real* TiKV/PD metadata cluster — the metadata-plane sibling of
+/// [`NetFault`] (which faults a *chunkstore* link, not a metadata-store node).
+///
+/// The fault *model* lives here, free of any `tikv-client` / transport dependency, so
+/// it stays import-light (the whole-tree gate compiles it on a machine with **no** TiKV
+/// and no privileged fault injection); a Tier-1 campaign maps each variant onto the
+/// concrete privileged mechanism (`iptables`/`tc netem` for `Partition`, `tc netem
+/// delay` for `Latency`, `SIGSTOP`/cgroup-freeze for `Pause`, `libfaketime` for
+/// `ClockSkew`). The mechanism identities are illustrative (proposal 0015 Success
+/// criterion); the *model* — and the quorum-safe selection [`SeededMetaFaults`] draws
+/// from it — is what is load-bearing and unit-tested.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum MetaFault {
+    /// The node is **partitioned away** — its link is cut in both directions for the
+    /// duration (an `iptables` drop / `tc netem` 100%-loss). The single-zone consistency
+    /// clauses must hold across the partition-and-heal.
+    Partition,
+    /// Traffic to/from the node is **delayed** by this many milliseconds (`tc netem
+    /// delay`) — a slow replica the commit path must not livelock on.
+    Latency(u64),
+    /// The node's process is **frozen** for this many milliseconds (`SIGSTOP` /
+    /// cgroup-freeze) — a stalled-then-resumed node, the "process pause" nemesis.
+    Pause(u64),
+    /// The node's clock is **skewed** by this signed offset in milliseconds
+    /// (`libfaketime`) — a PD timestamp-oracle stress the commit point must tolerate.
+    ClockSkew(i64),
+}
+
+/// Decides whether — and how — to fault the TiKV/PD node at a given index. Mirrors
+/// [`NetFaultInjector`]/[`StorageFaultInjector`] for the metadata-cluster seam; the
+/// default injects nothing.
+pub trait MetaFaultInjector {
+    /// The fault to inject for the cluster node at `node_index`, or `None` to leave it
+    /// untouched.
+    fn meta_fault_for(&mut self, node_index: usize) -> Option<MetaFault>;
+}
+
+/// A metadata-cluster fault plan fixed once from the run seed: a chosen set of TiKV/PD
+/// nodes, each with the fault to apply. The metadata-seam sibling of [`SeededNetFaults`];
+/// drawing the selection from the simulation RNG is what makes a Tier-1 fault schedule
+/// reproducible (ADR-0009) — a bug-finding schedule replays the *same* faulted nodes as
+/// a committed regression.
+///
+/// The load-bearing decision is [`SeededMetaFaults::quorum_safe_max`]: in a single-zone
+/// cluster the nemesis must fault a **strict minority** of nodes, so a Raft/PD quorum
+/// **majority always survives** and the single-zone consistency clauses (proposal 0015
+/// §"DST and tests": clause-2 linearizability of the commit point, exactly-one-winner)
+/// are *tested* under fault rather than made trivially unavailable. Faulting a majority
+/// would isolate the quorum — the cluster would simply stall, proving nothing about
+/// consistency. [`SeededMetaFaults::minority`] enforces the bound.
+#[derive(Debug, Clone, Default)]
+pub struct SeededMetaFaults {
+    faults: std::collections::BTreeMap<usize, MetaFault>,
+}
+
+impl SeededMetaFaults {
+    /// A plan from an explicit map of `node_index → fault` — e.g. partition PD node 1.
+    pub fn new(faults: std::collections::BTreeMap<usize, MetaFault>) -> Self {
+        Self { faults }
+    }
+
+    /// The maximum number of nodes the nemesis may fault while a quorum **majority**
+    /// still survives in an `n`-node single-zone cluster: a strict minority,
+    /// `⌊(n-1)/2⌋`. For the usual odd clusters that is `n=3 → 1`, `n=5 → 2`, `n=7 → 3`;
+    /// it stays a strict minority for even `n` too (`n=4 → 1`, `n=6 → 2`). Faulting more
+    /// than this isolates the quorum, so the consistency clauses could never be observed
+    /// (proposal 0015 §"DST and tests"; the single-zone invariant, [ADR-0015] clause 2).
+    #[must_use]
+    pub fn quorum_safe_max(n: usize) -> usize {
+        n.saturating_sub(1) / 2
+    }
+
+    /// Pick up to `max` **distinct** node indices in `0..n`, each to be hit with `fault`,
+    /// drawing the choice from `rng`. The identical Fisher–Yates prefix shuffle the link
+    /// and storage seams use, so the selection is a pure function of the seed.
+    pub fn pick<R: Rng>(rng: &mut R, n: usize, max: usize, fault: MetaFault) -> Self {
+        let mut indices: Vec<usize> = (0..n).collect();
+        let take = max.min(n);
+        for i in 0..take {
+            let j = i + (rng.next_u32() as usize) % (n - i);
+            indices.swap(i, j);
+        }
+        let faults = indices
+            .into_iter()
+            .take(take)
+            .map(|index| (index, fault))
+            .collect();
+        Self { faults }
+    }
+
+    /// A **quorum-safe** fault plan: fault a strict minority
+    /// ([`quorum_safe_max`](Self::quorum_safe_max)) of the `n` nodes with `fault`, drawn
+    /// from `rng`, so a majority quorum always survives. This is the single-zone premise
+    /// the Tier-1 Jepsen leg rests on — the nemesis stresses consistency, it does not
+    /// simply take the cluster down (proposal 0015 §"DST and tests"; ADR-0015 clause 2).
+    pub fn minority<R: Rng>(rng: &mut R, n: usize, fault: MetaFault) -> Self {
+        Self::pick(rng, n, Self::quorum_safe_max(n), fault)
+    }
+
+    /// A quorum-safe [`minority`](Self::minority) plan drawn from `seed` — a convenience
+    /// that builds the deterministic RNG internally, so a consumer (the `xtask`
+    /// Jepsen-against-TiKV runner) draws a reproducible nemesis plan without a direct
+    /// `rand` dependency. The same `seed` always selects the same faulted nodes, so a
+    /// bug-finding fault schedule replays as a committed regression (ADR-0009).
+    pub fn minority_from_seed(seed: u64, n: usize, fault: MetaFault) -> Self {
+        Self::minority(&mut ChaCha8Rng::seed_from_u64(seed), n, fault)
+    }
+
+    /// The chosen faults, by node index.
+    pub fn faults(&self) -> &std::collections::BTreeMap<usize, MetaFault> {
+        &self.faults
+    }
+
+    /// Whether the node at `index` carries a fault in this plan.
+    pub fn is_faulted(&self, index: usize) -> bool {
+        self.faults.contains_key(&index)
+    }
+}
+
+impl MetaFaultInjector for SeededMetaFaults {
+    fn meta_fault_for(&mut self, node_index: usize) -> Option<MetaFault> {
+        self.faults.get(&node_index).copied()
+    }
+}
