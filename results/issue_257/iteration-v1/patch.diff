+/// failure domain — I/O honesty, not failure-domain independence).
+fn meta_compose_file(tier: MetaTier) -> std::path::PathBuf {
+    let rel = match tier {
+        MetaTier::Integration | MetaTier::Jepsen => "deploy/small-multi-node/docker-compose.yml",
+        MetaTier::Tier2 => "deploy/tikv-single-node/docker-compose.yml",
+    };
+    crate::workspace_root().join(rel)
+}
+
+/// PD client endpoint the metadata scenario dials (host-published, static endpoints per
+/// the Deployment-prerequisite note; #365 L5-discovery is a later slice).
+fn meta_pd_endpoint(tier: MetaTier) -> &'static str {
+    match tier {
+        // The multi-node stack publishes its PD ensemble; the first member is enough for
+        // the transactional client to discover the cluster.
+        MetaTier::Integration | MetaTier::Jepsen => "127.0.0.1:23791",
+        MetaTier::Tier2 => "127.0.0.1:2379",
