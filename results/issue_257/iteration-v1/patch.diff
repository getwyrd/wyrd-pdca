+/// The 3-node PD ensemble the multi-node `deploy/` stack stands up — the single-zone
+/// quorum the Jepsen nemesis must keep a majority of.
+const META_JEPSEN_PD_NODES: usize = 3;
+
+/// Draw the Jepsen leg's reproducible, **quorum-safe** nemesis plan and render it as the
+/// comma-separated node indices the nemesis partitions. The seed comes from
+/// `WYRD_TIER1_SEED` (default `0`) so a bug-finding schedule replays; the plan is drawn
+/// through [`SeededMetaFaults::minority_from_seed`], which faults only a **strict
+/// minority** so the single-zone consistency clauses stay observable (a majority PD
+/// quorum survives — proposal 0015 §"DST and tests", ADR-0015 clause 2).
+fn meta_jepsen_nemesis() -> String {
+    use wyrd_testkit::{MetaFault, SeededMetaFaults};
+    let seed = std::env::var("WYRD_TIER1_SEED")
+        .ok()
+        .and_then(|s| s.parse::<u64>().ok())
+        .unwrap_or(0);
+    let plan =
+        SeededMetaFaults::minority_from_seed(seed, META_JEPSEN_PD_NODES, MetaFault::Partition);
+    let nodes: Vec<String> = plan.faults().keys().map(usize::to_string).collect();
+    println!(
+        "\nxtask meta-jepsen: seed={seed} partitions a quorum-safe minority of \
+         {META_JEPSEN_PD_NODES} PD nodes: [{}] (a majority survives)",
+        nodes.join(",")
+    );
+    nodes.join(",")
+}
+
+/// Run the routed metadata scenario (`--features tikv`, `--ignored`) with the resolved PD
