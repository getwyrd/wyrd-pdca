@@ -0,0 +1,101 @@
+//! **Tier-2 single-node metadata I/O** (M4.6, #257; proposal 0015 §"DST and tests" →
+//! "Tier-2", §"Suggested PR sequence" item 6) — the realism-ladder Tier-2 leg for the
+//! redb→TiKV metadata backend swap.
+//!
+//! A run on **one real machine** against real TiKV — real `fsync`, real NVMe latency,
+//! real OS behavior — proving honest single-node I/O semantics the in-memory / redb fakes
+//! abstract away (a single failure domain, so it proves real-silicon durability, **not**
+//! failure-domain independence — proposal 0015). Distinct from slice 5's multi-node
+//! stand-up: one machine for I/O honesty, not the production topology.
+//!
+//! The load-bearing property this leg pins is **durability across a fresh connection**:
+//! a committed value survives being read back through a **new** transactional client
+//! (a fresh PD-assigned read snapshot), i.e. the write actually reached durable storage
+//! rather than a client-side buffer — the honest single-node durability the fake cannot
+//! demonstrate.
+//!
+//! **Gated** like every tier test: `#[ignore]` + a clean skip when `WYRD_TIKV_PD_ENDPOINTS`
+//! is unset. Run for real by the privileged `cargo xtask meta-tier2` job (`WYRD_TIER2=1`),
+//! which stands up the single-node `deploy/tikv-single-node` stack on real hardware.
+
+/// The PD endpoints, or `None` when TiKV is not configured — the family-wide skip gate.
+fn pd_endpoints() -> Option<Vec<String>> {
+    match std::env::var("WYRD_TIKV_PD_ENDPOINTS") {
+        Ok(raw) if !raw.trim().is_empty() => Some(
+            raw.split(',')
+                .map(|e| e.trim().to_string())
+                .filter(|e| !e.is_empty())
+                .collect(),
+        ),
+        _ => None,
+    }
+}
+
+#[test]
+#[ignore = "Tier-2: needs real single-node TiKV on real hardware — run via `cargo xtask meta-tier2`"]
+fn committed_value_survives_a_fresh_client_on_real_hardware() {
+    let Some(endpoints) = pd_endpoints() else {
+        eprintln!(
+            "tier2_metadata_io: WYRD_TIKV_PD_ENDPOINTS unset — skipping (clean skip; the gate \
+             stays green without a TiKV). Run `cargo xtask meta-tier2`."
+        );
+        return;
+    };
+    run(endpoints);
+}
+
+#[cfg(feature = "tikv")]
+fn run(endpoints: Vec<String>) {
+    use wyrd_traits::{CommitOutcome, MetadataStore, WriteBatch};
+
+    let runtime = tokio::runtime::Builder::new_current_thread()
+        .enable_all()
+        .build()
+        .expect("tokio runtime");
+
+    runtime.block_on(async move {
+        let namespace = format!("wyrd-tier2-io/{}/", std::process::id()).into_bytes();
+        let key = b"inode:1".as_slice();
+
+        // Commit through one client...
+        {
+            let store = wyrd_metadata_tikv::TikvMetadataStore::connect(endpoints.clone())
+                .await
+                .expect("connect to TiKV (writer)")
+                .with_namespace(namespace.clone());
+            assert_eq!(
+                store
+                    .commit(
+                        WriteBatch::new()
+                            .require_absent(key)
+                            .put(key, &b"durable"[..])
+                    )
+                    .await
+                    .expect("commit"),
+                CommitOutcome::Committed,
+            );
+        } // ...drop the writer client entirely.
+
+        // ...then read it back through a brand-new client (fresh PD snapshot). On real
+        // hardware this proves the commit reached durable storage (real fsync/NVMe), not a
+        // buffer that vanished with the first client.
+        let reader = wyrd_metadata_tikv::TikvMetadataStore::connect(endpoints)
+            .await
+            .expect("connect to TiKV (reader)")
+            .with_namespace(namespace);
+        assert_eq!(
+            reader.get(key).await.expect("durable read").as_deref(),
+            Some(&b"durable"[..]),
+            "a committed value must survive a fresh client on real hardware"
+        );
+    });
+}
+
+#[cfg(not(feature = "tikv"))]
+fn run(endpoints: Vec<String>) {
+    let _ = endpoints;
+    eprintln!(
+        "tier2_metadata_io: WYRD_TIKV_PD_ENDPOINTS is set but the crate was built without \
+         `--features tikv` — skipping. Run it via `cargo xtask meta-tier2`."
+    );
+}
