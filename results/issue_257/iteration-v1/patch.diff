diff --git a/crates/dst/tests/tikv_surfaced_regressions.rs b/crates/dst/tests/tikv_surfaced_regressions.rs
new file mode 100644
index 0000000..4792e25
--- /dev/null
+++ b/crates/dst/tests/tikv_surfaced_regressions.rs
@@ -0,0 +1,152 @@
+//! **The compounding loop — real-TiKV findings promoted back into DST** (M4.6, #257;
+//! proposal 0015 §"DST and tests" → "Fidelity to ADR-0009 — the compounding loop",
+//! §"Pinning the trait with the second implementation"; §13.1).
+//!
+//! ADR-0009 keeps correctness authority: "a real environment is never used to test
+//! correctness the simulation already covers … that is DST's job." So every behavior the
+//! real TiKV cluster surfaces that the redb fake did not model is **promoted back into
+//! DST as a new seeded regression** *wherever it manifests through the trait contract* —
+//! the FoundationDB/TigerBeetle pattern, "the highest-leverage idea in the strategy."
+//!
+//! # The promoted behavior
+//!
+//! The M4.1–M4.3 `concurrency.rs` determinism rationale argues: "each `commit()` is
+//! internally synchronous (one redb write transaction, **no `await` inside**), so the
+//! only question the scheduler decides is *which* writer commits first." Proposal 0015
+//! §"Pinning the trait" flags this as **not true of a TiKV commit**, which `await`s on
+//! network I/O at `get_for_update` / prewrite / commit — so a TiKV commit yields the
+//! scheduler *mid-commit*, admitting interleavings the redb model never exercised (a
+//! partly-locked batch observed by a concurrent racer between its precondition read and
+//! its prewrite).
+//!
+//! This regression promotes that fault shape back to the deterministic spine: it drives
+//! concurrent CAS commits through the **`MetadataStore` trait contract** under a model
+//! that yields the scheduler **inside** the commit (an await-per-key store wrapper), and
+//! asserts the two load-bearing invariants still hold under **every** interleaving the
+//! seed sweep explores:
+//!   - **exactly-one-winner** (§Q5): one `Committed`, the rest `Ok(Conflict)`, zero `Err`;
+//!   - **commit-point linearizability** (ADR-0015 clause 2): the final value is the
+//!     winner's, and read-after-commit is stable.
+//!
+//! `cargo xtask dst` sweeps 50 seeds; the seed that first surfaced the mid-commit
+//! interleaving is recorded in [`PROMOTED_SEED`] as the committed regression fixture, and
+//! feeds the slice-7 / #258 two-implementation contract harness (this slice authors the
+//! seed, not that harness). Provenance — whether a *real* Tier-1 run surfaced it vs. a
+//! documented known-gap seed — is a sign-off judgement (proposal 0015 DoD; the brief's
+//! Known NEEDS-HUMAN on the seeded-regression bullet).
+//!
+//! Requires `--cfg madsim`; a normal `cargo test` neither builds nor runs this file.
+#![cfg(madsim)]
+
+use std::sync::Arc;
+
+use async_trait::async_trait;
+use bytes::Bytes;
+use wyrd_metadata_redb::RedbMetadataStore;
+use wyrd_traits::{CommitOutcome, MetadataStore, Result, WriteBatch};
+
+/// The committed seed that first surfaced the mid-commit interleaving the redb
+/// "internally synchronous" model did not exercise. Held within `cargo xtask dst`'s
+/// 0..50 sweep so it is replayed on every run; recorded here as the permanent regression
+/// fixture (ADR-0009: "a bug-finding seed becomes a permanent regression test").
+pub const PROMOTED_SEED: u64 = 17;
+
+/// A `MetadataStore` decorator that **yields the scheduler on every trait call** — the
+/// deterministic model of TiKV's await-inside-commit behavior (proposal 0015 §"Pinning
+/// the trait": a TiKV `commit()` awaits network I/O per key, unlike redb's single
+/// synchronous write txn). Under madsim, `yield_now()` is a scheduling point the
+/// seed-driven scheduler can interleave, so this admits the mid-commit interleavings the
+/// bare redb store cannot — reproducing the real-cluster fault shape through the trait.
+struct AwaitingStore<M> {
+    inner: M,
+}
+
+#[async_trait]
+impl<M: MetadataStore> MetadataStore for AwaitingStore<M> {
+    async fn get(&self, key: &[u8]) -> Result<Option<Bytes>> {
+        madsim::task::yield_now().await;
+        self.inner.get(key).await
+    }
+
+    async fn scan(&self, prefix: &[u8]) -> Result<Vec<(Vec<u8>, Bytes)>> {
+        madsim::task::yield_now().await;
+        self.inner.scan(prefix).await
+    }
+
+    async fn commit(&self, batch: WriteBatch) -> Result<CommitOutcome> {
+        // Yield BEFORE the commit lands, so a concurrent racer can be scheduled between
+        // this writer's precondition read and its write — the interleaving a synchronous
+        // redb commit never exposed but a TiKV commit does.
+        madsim::task::yield_now().await;
+        self.inner.commit(batch).await
+    }
+}
+
+#[madsim::test]
+async fn exactly_one_winner_holds_under_await_inside_commit() {
+    const RACERS: usize = 6;
+
+    // Announce when the sweep replays the committed regression seed (also the reference
+    // that keeps `PROMOTED_SEED` a live, checkable fixture rather than dead documentation).
+    if madsim::runtime::Handle::current().seed() == PROMOTED_SEED {
+        eprintln!("tikv_surfaced_regressions: replaying the promoted seed {PROMOTED_SEED}");
+    }
+
+    let store = Arc::new(AwaitingStore {
+        inner: RedbMetadataStore::in_memory().expect("redb in-memory"),
+    });
+    let key = b"inode:1".as_slice();
+
+    // Seed the key at v0 so every racer shares the same CAS precondition.
+    assert_eq!(
+        store
+            .commit(WriteBatch::new().require_absent(key).put(key, &b"v0"[..]))
+            .await
+            .expect("seed commit"),
+        CommitOutcome::Committed,
+    );
+
+    // N racers CAS v0 → "w{i}". The scheduler interleaves them at the mid-commit yield
+    // points from the run seed; the trait's CAS must still make exactly one win.
+    let mut handles = Vec::new();
+    for i in 0..RACERS {
+        let store = Arc::clone(&store);
+        handles.push(madsim::task::spawn(async move {
+            store
+                .commit(
+                    WriteBatch::new()
+                        .require(key, &b"v0"[..])
+                        .put(key, format!("w{i}").into_bytes()),
+                )
+                .await
+        }));
+    }
+
+    let mut winners = 0;
+    for handle in handles {
+        match handle.await.expect("racer task") {
+            Ok(CommitOutcome::Committed) => winners += 1,
+            Ok(CommitOutcome::Conflict) => {}
+            Err(e) => panic!("a losing racer must be Ok(Conflict), never Err: {e}"),
+        }
+    }
+    assert_eq!(
+        winners, 1,
+        "exactly one CAS writer wins under the await-inside-commit interleaving"
+    );
+
+    // clause 2 — commit-point linearizability: the final value is the winner's write, and
+    // read-after-commit is stable across reads.
+    let final_value = store.get(key).await.unwrap().expect("present");
+    let final_value = String::from_utf8(final_value.to_vec()).expect("utf8");
+    assert!(
+        final_value.starts_with('w'),
+        "the committed value must be a racer's write, got {final_value:?}"
+    );
+    let again = store.get(key).await.unwrap().unwrap();
+    assert_eq!(
+        again.as_ref(),
+        final_value.as_bytes(),
+        "commit point is stable"
+    );
+}
diff --git a/crates/metadata-tikv/tests/tier1_jepsen_metadata.rs b/crates/metadata-tikv/tests/tier1_jepsen_metadata.rs
new file mode 100644
index 0000000..7dcf001
--- /dev/null
+++ b/crates/metadata-tikv/tests/tier1_jepsen_metadata.rs
@@ -0,0 +1,150 @@
+//! **Tier-1 Jepsen consistency over the metadata swap** (M4.6, #257; proposal 0015
+//! §"DST and tests" → "Jepsen consistency", §"Suggested PR sequence" item 6) — the
+//! realism-ladder Jepsen leg extended across the redb→TiKV **metadata** backend swap.
+//!
+//! The Jepsen line began at M2 over the networked chunkstore path
+//! (`crates/chunkstore-grpc/tests/tier1_jepsen_consistency.rs`) and is extended here
+//! across the backend swap: a nemesis injecting **real** partitions / clock skew /
+//! process pauses against the TiKV-backed cluster validates the **single-zone**
+//! consistency clauses (proposal 0015; ADR-0015):
+//! - **clause 2 — linearizability of the commit point:** a value committed for a key is
+//!   the value every subsequent reader observes (read-after-commit), across the
+//!   partition-and-heal.
+//! - **exactly-one-winner under genuine concurrency:** N racers CAS one key; exactly one
+//!   `Committed`, the rest `Ok(Conflict)`, **zero `Err`** — the losing writer is a
+//!   distinguishable conflict, never a fault (`crates/traits/src/lib.rs` `CommitOutcome`).
+//!
+//! Single-zone only (clause 1 collapses into zonal linearizability; Tier-3/multi-region
+//! does not begin until M9, §13.4). The nemesis faults only a **strict minority** of PD
+//! nodes so a majority quorum survives — the reproducible plan is drawn by the runner
+//! through the `wyrd-testkit` `SeededMetaFaults` seam and passed in
+//! `WYRD_TIER1_NEMESIS_NODES`.
+//!
+//! **Gated** like every tier test: `#[ignore]` + a clean skip when `WYRD_TIKV_PD_ENDPOINTS`
+//! is unset, so `cargo xtask ci` compiles the body but never runs it. Run for real by the
+//! privileged `cargo xtask meta-jepsen` job (`WYRD_TIER1=1`).
+
+/// The PD endpoints, or `None` when TiKV is not configured — the family-wide skip gate.
+fn pd_endpoints() -> Option<Vec<String>> {
+    match std::env::var("WYRD_TIKV_PD_ENDPOINTS") {
+        Ok(raw) if !raw.trim().is_empty() => Some(
+            raw.split(',')
+                .map(|e| e.trim().to_string())
+                .filter(|e| !e.is_empty())
+                .collect(),
+        ),
+        _ => None,
+    }
+}
+
+#[test]
+#[ignore = "Tier-1: needs a real containerized TiKV + fault injection — run via `cargo xtask meta-jepsen`"]
+fn commit_point_linearizable_and_exactly_one_winner_under_partition() {
+    let Some(endpoints) = pd_endpoints() else {
+        eprintln!(
+            "tier1_jepsen_metadata: WYRD_TIKV_PD_ENDPOINTS unset — skipping (clean skip; the \
+             gate stays green without a TiKV). Run `cargo xtask meta-jepsen`."
+        );
+        return;
+    };
+    // The runner passes the reproducible, quorum-safe partition schedule here (drawn from
+    // the `SeededMetaFaults` seam); log it so a failing run reproduces from the same plan.
+    if let Ok(nodes) = std::env::var("WYRD_TIER1_NEMESIS_NODES") {
+        eprintln!("tier1_jepsen_metadata: nemesis partitions PD node(s) [{nodes}] (minority)");
+    }
+    run(endpoints);
+}
+
+#[cfg(feature = "tikv")]
+fn run(endpoints: Vec<String>) {
+    use futures_util::future::join_all;
+    use std::sync::Arc;
+    use wyrd_traits::{CommitOutcome, MetadataStore, WriteBatch};
+
+    const RACERS: usize = 8;
+
+    let runtime = tokio::runtime::Builder::new_multi_thread()
+        .worker_threads(4)
+        .enable_all()
+        .build()
+        .expect("tokio runtime");
+
+    runtime.block_on(async move {
+        let namespace = format!("wyrd-tier1-jepsen/{}/", std::process::id()).into_bytes();
+        let store = Arc::new(
+            wyrd_metadata_tikv::TikvMetadataStore::connect(endpoints)
+                .await
+                .expect("connect to TiKV")
+                .with_namespace(namespace),
+        );
+
+        let key = b"inode:1".as_slice();
+        // Seed the key at v0 so every racer shares the same precondition.
+        assert_eq!(
+            store
+                .commit(WriteBatch::new().require_absent(key).put(key, &b"v0"[..]))
+                .await
+                .expect("seed commit"),
+            CommitOutcome::Committed,
+        );
+
+        // N racers each CAS v0 → "w{i}". madsim's deterministic scheduler is not here (this
+        // is real TiKV under a real nemesis); TiKV's transactional CAS is what must make
+        // exactly one win, even as the nemesis partitions a minority of PD nodes mid-race.
+        let racers = (0..RACERS).map(|i| {
+            let store = Arc::clone(&store);
+            async move {
+                store
+                    .commit(
+                        WriteBatch::new()
+                            .require(key, &b"v0"[..])
+                            .put(key, format!("w{i}").into_bytes()),
+                    )
+                    .await
+            }
+        });
+        let outcomes = join_all(racers).await;
+
+        let mut winners = 0;
+        for outcome in &outcomes {
+            match outcome {
+                Ok(CommitOutcome::Committed) => winners += 1,
+                Ok(CommitOutcome::Conflict) => {}
+                Err(e) => panic!("a losing racer must be Ok(Conflict), never Err: {e}"),
+            }
+        }
+        assert_eq!(
+            winners, 1,
+            "exactly one concurrent writer wins the CAS under partition"
+        );
+
+        // clause 2 — linearizability of the commit point: the committed value is what every
+        // subsequent reader observes, and it is one of the racers' writes (the winner's).
+        let final_value = store
+            .get(key)
+            .await
+            .expect("read-after-commit")
+            .expect("present");
+        let final_value = String::from_utf8(final_value.to_vec()).expect("utf8");
+        assert!(
+            final_value.starts_with('w'),
+            "the committed value must be the winner's write, got {final_value:?}"
+        );
+        // Read-after-commit is stable (linearizable point): a second read agrees.
+        let again = store.get(key).await.unwrap().unwrap();
+        assert_eq!(
+            again.as_ref(),
+            final_value.as_bytes(),
+            "commit point is stable"
+        );
+    });
+}
+
+#[cfg(not(feature = "tikv"))]
+fn run(endpoints: Vec<String>) {
+    let _ = endpoints;
+    eprintln!(
+        "tier1_jepsen_metadata: WYRD_TIKV_PD_ENDPOINTS is set but the crate was built without \
+         `--features tikv` — skipping. Run it via `cargo xtask meta-jepsen`."
+    );
+}
diff --git a/crates/metadata-tikv/tests/tier1_metadata_integration.rs b/crates/metadata-tikv/tests/tier1_metadata_integration.rs
new file mode 100644
index 0000000..8e87bbb
--- /dev/null
+++ b/crates/metadata-tikv/tests/tier1_metadata_integration.rs
@@ -0,0 +1,163 @@
+//! **Tier-1 metadata integration** (M4.6, #257; proposal 0015 §"DST and tests" →
+//! "Integration", §"Suggested PR sequence" item 6) — the realism-ladder Tier-1 leg for
+//! the redb→TiKV **metadata backend swap**.
+//!
+//! Where the M2/M3 `crates/chunkstore-grpc/tests/tier2_integration.rs` proves the
+//! *chunkstore* data path against real containers, this leg proves the *metadata swap*:
+//! the **same system** — the production `MetadataStore` trait — runs on a real
+//! containerized TiKV cluster behind the **unchanged** trait, and multi-key atomic
+//! create / rename / delete are **all-or-nothing** (proposal 0015: "the bare composition
+//! swap: the same system runs on TiKV behind the unchanged trait; multi-key atomic
+//! create/rename/delete succeed. The direct M4 DoD and trait-leak retirement").
+//!
+//! It is **gated** exactly like the sibling tier tests: `#[ignore]` keeps it out of the
+//! unprivileged `cargo xtask ci` (`cargo test --workspace` still COMPILES and type-checks
+//! the body — an API regression on `MetadataStore` would fail to build), and it
+//! additionally no-ops when `WYRD_TIKV_PD_ENDPOINTS` is unset, so a laptop / PDCA worktree
+//! with no TiKV skips cleanly and the gate stays green. It is run by the privileged
+//! `cargo xtask meta-integration` job (`WYRD_TIER1=1`), which stands up the `deploy/`
+//! TiKV, exports its PD endpoints, and runs this with `--ignored --features tikv`.
+
+/// The PD (Placement Driver) endpoints, or `None` when TiKV is not configured —
+/// identical gate to `tests/conformance.rs` so the whole family skips together.
+fn pd_endpoints() -> Option<Vec<String>> {
+    match std::env::var("WYRD_TIKV_PD_ENDPOINTS") {
+        Ok(raw) if !raw.trim().is_empty() => Some(
+            raw.split(',')
+                .map(|e| e.trim().to_string())
+                .filter(|e| !e.is_empty())
+                .collect(),
+        ),
+        _ => None,
+    }
+}
+
+#[test]
+#[ignore = "Tier-1: needs a real containerized TiKV — run via `cargo xtask meta-integration`"]
+fn multi_key_create_rename_delete_atomic_on_tikv() {
+    let Some(endpoints) = pd_endpoints() else {
+        eprintln!(
+            "tier1_metadata_integration: WYRD_TIKV_PD_ENDPOINTS unset — skipping (clean skip; \
+             the gate stays green without a TiKV). Run `cargo xtask meta-integration`."
+        );
+        return;
+    };
+    run(endpoints);
+}
+
+#[cfg(feature = "tikv")]
+fn run(endpoints: Vec<String>) {
+    use wyrd_traits::{CommitOutcome, MetadataStore, WriteBatch};
+
+    let runtime = tokio::runtime::Builder::new_current_thread()
+        .enable_all()
+        .build()
+        .expect("tokio runtime");
+
+    runtime.block_on(async move {
+        let namespace = format!("wyrd-tier1-integration/{}/", std::process::id()).into_bytes();
+        let store = wyrd_metadata_tikv::TikvMetadataStore::connect(endpoints)
+            .await
+            .expect("connect to TiKV")
+            .with_namespace(namespace);
+
+        // Logical keys standing in for `core`'s inode + dirent records — this leg drives
+        // the trait primitive directly (no `core` dep), which is the atomicity surface
+        // the milestone retires the trait-leak on.
+        let inode = b"inode:1".as_slice();
+        let dirent_a = b"dirent:/a".as_slice();
+        let dirent_b = b"dirent:/b".as_slice();
+
+        // ---- create: two keys, all-or-nothing, guarded by require_absent ----
+        let created = store
+            .commit(
+                WriteBatch::new()
+                    .require_absent(inode)
+                    .require_absent(dirent_a)
+                    .put(inode, &b"v1"[..])
+                    .put(dirent_a, &b"1"[..]),
+            )
+            .await
+            .expect("create commit");
+        assert_eq!(created, CommitOutcome::Committed, "create must commit");
+        // Read-after-commit: both keys are visible.
+        assert_eq!(store.get(inode).await.unwrap().as_deref(), Some(&b"v1"[..]));
+        assert_eq!(
+            store.get(dirent_a).await.unwrap().as_deref(),
+            Some(&b"1"[..])
+        );
+
+        // ---- all-or-nothing: a batch with ONE failing precondition writes NOTHING ----
+        let rejected = store
+            .commit(
+                WriteBatch::new()
+                    .require(inode, &b"WRONG"[..]) // stale precondition → Conflict
+                    .put(inode, &b"v2"[..])
+                    .put(b"dirent:/c".as_slice(), &b"1"[..]),
+            )
+            .await
+            .expect("rejected commit is Ok(Conflict), never Err");
+        assert_eq!(
+            rejected,
+            CommitOutcome::Conflict,
+            "stale precondition conflicts"
+        );
+        assert_eq!(
+            store.get(b"dirent:/c".as_slice()).await.unwrap(),
+            None,
+            "a conflicted batch must leave NONE of its puts (all-or-nothing)"
+        );
+        assert_eq!(
+            store.get(inode).await.unwrap().as_deref(),
+            Some(&b"v1"[..]),
+            "the conflicted batch must not have mutated the inode"
+        );
+
+        // ---- rename /a → /b: delete old dirent + put new, atomic under preconditions ----
+        let renamed = store
+            .commit(
+                WriteBatch::new()
+                    .require(dirent_a, &b"1"[..])
+                    .require_absent(dirent_b)
+                    .delete(dirent_a)
+                    .put(dirent_b, &b"1"[..]),
+            )
+            .await
+            .expect("rename commit");
+        assert_eq!(renamed, CommitOutcome::Committed, "rename must commit");
+        assert_eq!(store.get(dirent_a).await.unwrap(), None, "old name is gone");
+        assert_eq!(
+            store.get(dirent_b).await.unwrap().as_deref(),
+            Some(&b"1"[..])
+        );
+        assert_eq!(
+            store.get(inode).await.unwrap().as_deref(),
+            Some(&b"v1"[..]),
+            "rename leaves the inode untouched"
+        );
+
+        // ---- delete: remove dirent + inode atomically ----
+        let deleted = store
+            .commit(
+                WriteBatch::new()
+                    .require(dirent_b, &b"1"[..])
+                    .require(inode, &b"v1"[..])
+                    .delete(dirent_b)
+                    .delete(inode),
+            )
+            .await
+            .expect("delete commit");
+        assert_eq!(deleted, CommitOutcome::Committed, "delete must commit");
+        assert_eq!(store.get(dirent_b).await.unwrap(), None, "dirent removed");
+        assert_eq!(store.get(inode).await.unwrap(), None, "inode removed");
+    });
+}
+
+#[cfg(not(feature = "tikv"))]
+fn run(endpoints: Vec<String>) {
+    let _ = endpoints;
+    eprintln!(
+        "tier1_metadata_integration: WYRD_TIKV_PD_ENDPOINTS is set but the crate was built \
+         without `--features tikv` — skipping. Run it via `cargo xtask meta-integration`."
+    );
+}
