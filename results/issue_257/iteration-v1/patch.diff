+    let args = [
+        "test",
+        "-p",
+        dispatch.package,
+        "--features",
+        "tikv",
+        "--test",
+        dispatch.test,
+        "--",
+        "--ignored",
+        "--nocapture",
+    ];
+    crate::print_step(&{
+        let mut display = vec!["cargo"];
+        display.extend_from_slice(&args);
+        display
+    });
