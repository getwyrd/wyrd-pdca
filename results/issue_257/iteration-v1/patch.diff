+    meta_compose(&project, &compose, &["up", "-d"])?;
+    let result = crate::wait_for_port(pd)
+        .and_then(|()| run_meta_scenario_test(dispatch, pd, nemesis.as_deref()));
+    let _ = meta_compose(&project, &compose, &["down", "-v", "--remove-orphans"]);
