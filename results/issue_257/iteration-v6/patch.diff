+        assert!(!plan.is_effective(), "a zero-node partition is a no-op");
+        assert!(
+            !plan.is_valid_minority_fault(),
+            "a no-op partition must not count as a valid fault leg"
+        );
+    }
+
+    #[test]
+    fn fewer_than_three_replicas_cannot_carry_the_consistency_leg() {
+        // The iter-3 bug: a single data replica can only go unavailable, never
+        // split-brain — the property is unfalsifiable. A ≥3 Raft group is required.
+        let plan = MetadataQuorumPlan {
+            replicas: 2,
+            partitioned: 1,
+        };
+        assert!(
+            !plan.is_valid_minority_fault(),
+            "a <3-replica group cannot host a minority-partition consistency leg"
+        );
+    }
 }
