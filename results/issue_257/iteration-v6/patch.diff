diff --git a/crates/metadata-tikv/tests/tier1_metadata_consistency.rs b/crates/metadata-tikv/tests/tier1_metadata_consistency.rs
new file mode 100644
index 0000000..99db9ae
--- /dev/null
+++ b/crates/metadata-tikv/tests/tier1_metadata_consistency.rs
@@ -0,0 +1,192 @@
+//! **Tier-1 metadata consistency-over-the-swap** (M4.6, #257; ADR-0039 — the in-repo
+//! Rust scenario that realises the "Jepsen" leg for the metadata swap; proposal 0015
+//! §"DST and tests"). Drives the **production** `TikvMetadataStore` commit path behind
+//! the unchanged trait against a real ≥3-replica TiKV Raft group under a **software-
+//! defined minority-partition fault**, and asserts the ADR-0015 single-zone contract:
+//! read-after-commit, no torn/stale reads, and commit-point atomicity that converges
+//! **exactly once** across the heal — under a fault that **provably materialised**.
+//!
+//! Per ADR-0039 this is **not** literal public Jepsen/Elle (deferred to #329); it is the
+//! in-repo scenario asserting the ADR-0015 contract directly. It never asserts
+//! "exactly-one-winner goes red" as its bindingness — a minority partition against a
+//! linearizable store never changes that outcome (Invariant: DST keeps atomicity
+//! authority). Its bindingness is the ADR-0015 contract **plus** the fault-effect oracle.
+//!
+//! **Privileged / off-Check.** Endpoint-gated (clean skip with no `WYRD_TIKV_PD_ENDPOINTS`)
+//! **and** fault-descriptor-gated: the consistency leg **cannot pass with the fault
+//! absent** (Invariant B), so without the fault descriptor the runner exports it skips
+//! rather than passing vacuously. Live run: `cargo xtask metadata-tier1` (opt in via
+//! `WYRD_TIER1=1`).
+
+/// The PD (Placement Driver) endpoints, or `None` when TiKV is not configured.
+fn pd_endpoints() -> Option<Vec<String>> {
+    match std::env::var("WYRD_TIKV_PD_ENDPOINTS") {
+        Ok(raw) if !raw.trim().is_empty() => Some(
+            raw.split(',')
+                .map(|e| e.trim().to_string())
+                .filter(|e| !e.is_empty())
+                .collect(),
+        ),
+        _ => None,
+    }
+}
+
+/// The fault descriptor the `xtask metadata-tier1` runner exports around the load: the
+/// target replica's independently-probed reachability before/after the partition, and
+/// the Raft group size + partitioned-replica count. Absent ⇒ no fault was injected, so
+/// the consistency leg is not evidence and must not pass (Invariant B).
+struct FaultDescriptor {
+    before: wyrd_testkit::Reachability,
+    after: wyrd_testkit::Reachability,
+    plan: wyrd_testkit::MetadataQuorumPlan,
+}
+
+fn fault_descriptor() -> Option<FaultDescriptor> {
+    fn reach(var: &str) -> Option<wyrd_testkit::Reachability> {
+        match std::env::var(var).ok()?.trim() {
+            "reachable" => Some(wyrd_testkit::Reachability::Reachable),
+            "unreachable" => Some(wyrd_testkit::Reachability::Unreachable),
+            _ => None,
+        }
+    }
+    fn count(var: &str) -> Option<usize> {
+        std::env::var(var).ok()?.trim().parse().ok()
+    }
+    Some(FaultDescriptor {
+        before: reach("WYRD_METADATA_FAULT_BEFORE")?,
+        after: reach("WYRD_METADATA_FAULT_AFTER")?,
+        plan: wyrd_testkit::MetadataQuorumPlan {
+            replicas: count("WYRD_METADATA_REPLICAS")?,
+            partitioned: count("WYRD_METADATA_PARTITIONED")?,
+        },
+    })
+}
+
+#[test]
+#[ignore = "privileged Tier-1 metadata leg: needs a real TiKV cluster + fault (cargo xtask metadata-tier1)"]
+fn adr0015_contract_under_materialized_partition() {
+    let Some(endpoints) = pd_endpoints() else {
+        eprintln!(
+            "wyrd-metadata-tikv: WYRD_TIKV_PD_ENDPOINTS not set — skipping the Tier-1 metadata \
+             consistency leg (clean skip; the gate stays green without a TiKV)."
+        );
+        return;
+    };
+    let Some(fault) = fault_descriptor() else {
+        eprintln!(
+            "wyrd-metadata-tikv: no fault descriptor exported — the consistency leg cannot pass \
+             with the fault absent (Invariant B); skipping. Run it via `cargo xtask metadata-tier1`."
+        );
+        return;
+    };
+
+    // Invariant B — the fault provably materialised and was a survivable minority
+    // partition. These use the SHARED testkit oracle the Check-time unit tests pin, so a
+    // no-op partition / a majority partition fails the leg here, red, exactly as at Check.
+    assert!(
+        wyrd_testkit::partition_materialized(fault.before, fault.after),
+        "the injected partition did not materialise (target still reachable) — the leg is \
+         not evidence (Invariant B: red when the fault is a no-op)"
+    );
+    assert!(
+        fault.plan.is_valid_minority_fault(),
+        "the partition was not a survivable minority of a ≥3-replica group ({:?}) — a \
+         majority partition just takes the store down (Invariant B)",
+        fault.plan
+    );
+
+    run(endpoints);
+}
+
+#[cfg(feature = "tikv")]
+fn run(endpoints: Vec<String>) {
+    use futures_util::future::join_all;
+    use wyrd_traits::{CommitOutcome, MetadataStore, WriteBatch};
+
+    const WRITERS: usize = 5;
+
+    let runtime = tokio::runtime::Builder::new_multi_thread()
+        .worker_threads(WRITERS)
+        .enable_all()
+        .build()
+        .expect("tokio runtime");
+
+    runtime.block_on(async move {
+        let namespace = format!("wyrd-tier1-consistency/{}/", std::process::id()).into_bytes();
+        let key = b"meta:version".to_vec();
+
+        let connect = |ns: Vec<u8>| {
+            let endpoints = endpoints.clone();
+            async move {
+                wyrd_metadata_tikv::TikvMetadataStore::connect(endpoints)
+                    .await
+                    .expect("connect to TiKV")
+                    .with_namespace(ns)
+            }
+        };
+
+        // Seed version 1 so every racer's require(k, "1") holds at the outset.
+        connect(namespace.clone())
+            .await
+            .commit(
+                WriteBatch::new()
+                    .require_absent(key.clone())
+                    .put(key.clone(), b"1".to_vec()),
+            )
+            .await
+            .expect("seeding must not fault");
+
+        // Concurrent overwrites racing the same version under the live partition.
+        let mut stores = Vec::with_capacity(WRITERS);
+        for _ in 0..WRITERS {
+            stores.push(connect(namespace.clone()).await);
+        }
+        let outcomes: Vec<_> = join_all(stores.iter().enumerate().map(|(i, store)| {
+            let batch = WriteBatch::new()
+                .require(key.clone(), b"1".to_vec())
+                .put(key.clone(), format!("w{i}").into_bytes());
+            async move { store.commit(batch).await }
+        }))
+        .await;
+
+        // Commit-point atomicity converges EXACTLY ONCE across the heal: the winning
+        // overwrite is the single one that moved the version off "1"; losers are clean
+        // Conflicts, never Err, never a torn partial. (ADR-0015; not asserted as the
+        // bindingness of the fault — the fault-effect oracle above is.)
+        let winners: Vec<usize> = outcomes
+            .into_iter()
+            .enumerate()
+            .filter_map(|(i, o)| match o {
+                Ok(CommitOutcome::Committed) => Some(i),
+                Ok(CommitOutcome::Conflict) => None,
+                Err(e) => panic!("writer {i} surfaced a fault instead of a Conflict: {e}"),
+            })
+            .collect();
+        assert_eq!(
+            winners.len(),
+            1,
+            "the commit point must converge exactly once across the heal"
+        );
+
+        // Read-after-commit, no torn/stale read: the value is the winner's WHOLE write.
+        let reader = connect(namespace).await;
+        let stored = reader
+            .get(&key)
+            .await
+            .expect("read-after-commit must not fault");
+        assert_eq!(
+            stored.as_deref(),
+            Some(format!("w{}", winners[0]).into_bytes().as_slice()),
+            "read-after-commit must return the winner's whole value, no torn/stale read"
+        );
+    });
+}
+
+#[cfg(not(feature = "tikv"))]
+fn run(endpoints: Vec<String>) {
+    let _ = endpoints;
+    eprintln!(
+        "wyrd-metadata-tikv: WYRD_TIKV_PD_ENDPOINTS is set but the crate was built without \
+         `--features tikv` — skipping. Run it via `cargo xtask metadata-tier1`."
+    );
+}
