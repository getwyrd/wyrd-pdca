+//! **Tier-2 metadata single-machine real-I/O** (M4.6, #257; proposal 0015 §"Tier-2 —
+//! first real-world hardware"). Drives the **production** `TikvMetadataStore` commit
+//! path behind the unchanged trait against real `fsync` / real NVMe / real OS on one
+//! owned machine — honest single-node durability and I/O semantics the in-memory fakes
+//! abstract away. A single failure domain: it proves real-silicon behaviour, **not**
+//! failure-domain independence.
+//!
+//! **Privileged / off-Check.** Endpoint-gated (clean skip with no `WYRD_TIKV_PD_ENDPOINTS`)
+//! so `cargo xtask ci` stays green. Live run: `cargo xtask metadata-tier2` (opt in via
+//! `WYRD_TIER2=1`).
+
+/// The PD (Placement Driver) endpoints, or `None` when TiKV is not configured.
+fn pd_endpoints() -> Option<Vec<String>> {
+    match std::env::var("WYRD_TIKV_PD_ENDPOINTS") {
+        Ok(raw) if !raw.trim().is_empty() => Some(
+            raw.split(',')
+                .map(|e| e.trim().to_string())
+                .filter(|e| !e.is_empty())
+                .collect(),
+        ),
+        _ => None,
+    }
+}
+
+#[test]
+#[ignore = "privileged Tier-2 metadata leg: needs real hardware + TiKV (cargo xtask metadata-tier2)"]
+fn durable_read_your_writes_on_real_hardware() {
+    let Some(endpoints) = pd_endpoints() else {
+        eprintln!(
+            "wyrd-metadata-tikv: WYRD_TIKV_PD_ENDPOINTS not set — skipping the Tier-2 metadata \
+             real-I/O leg (clean skip; the gate stays green without a TiKV)."
+        );
+        return;
+    };
+    run(endpoints);
+}
+
+#[cfg(feature = "tikv")]
+fn run(endpoints: Vec<String>) {
+    use wyrd_traits::{CommitOutcome, MetadataStore, WriteBatch};
+
+    let runtime = tokio::runtime::Builder::new_current_thread()
+        .enable_all()
+        .build()
+        .expect("tokio runtime");
+
+    runtime.block_on(async move {
+        let namespace = format!("wyrd-tier2-io/{}/", std::process::id()).into_bytes();
+        let store = wyrd_metadata_tikv::TikvMetadataStore::connect(endpoints)
+            .await
+            .expect("connect to TiKV")
+            .with_namespace(namespace);
+
+        // A sequence of durable commits, each read back — real fsync/NVMe on the commit
+        // path. Read-your-writes on real hardware, version bumped once per commit.
+        let key = b"meta:version".to_vec();
+        store
+            .commit(
+                WriteBatch::new()
+                    .require_absent(key.clone())
+                    .put(key.clone(), b"1".to_vec()),
+            )
+            .await
+            .expect("first durable commit must not fault");
+
+        for version in 1..8u64 {
+            let expected = version.to_string().into_bytes();
+            let next = (version + 1).to_string().into_bytes();
+            let outcome = store
+                .commit(
+                    WriteBatch::new()
+                        .require(key.clone(), expected.clone())
+                        .put(key.clone(), next.clone()),
+                )
+                .await
+                .expect("durable overwrite must not fault");
+            assert_eq!(
+                outcome,
+                CommitOutcome::Committed,
+                "an uncontended durable overwrite must commit (version {version})"
+            );
+            assert_eq!(
+                store.get(&key).await.expect("durable read-back").as_deref(),
+                Some(next.as_slice()),
+                "read-your-writes must hold after a real-hardware durable commit"
+            );
+        }
+    });
+}
+
+#[cfg(not(feature = "tikv"))]
+fn run(endpoints: Vec<String>) {
+    let _ = endpoints;
+    eprintln!(
+        "wyrd-metadata-tikv: WYRD_TIKV_PD_ENDPOINTS is set but the crate was built without \
+         `--features tikv` — skipping. Run it via `cargo xtask metadata-tier2`."
+    );
+}
