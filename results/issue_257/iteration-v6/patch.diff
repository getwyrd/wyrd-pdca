--- a/crates/metadata-tikv/Cargo.toml
+++ b/crates/metadata-tikv/Cargo.toml
@@ -38,6 +38,11 @@ wyrd-metadata-conformance.workspace = true
 # shared namespace with `join_all` to force a server-side write-write race; used
