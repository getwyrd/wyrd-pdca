+# A ≥3-replica TiKV Raft group for the M4.6 metadata realism-ladder Tier-1 legs
+# (#257; proposal 0015 §"DST and tests"; ADR-0039). Three TiKV storage nodes so PD
+# places every region across THREE replicas — a genuine Raft group whose consensus a
+# minority-partition fault can exercise without taking the store down (quorum retained;
+# see `wyrd_testkit::MetadataQuorumPlan`). This is the metadata-consistency topology the
+# `cargo xtask metadata-tier1` runner faults; it is NOT the M4.5 "Small multi-node
+# Production" stack (that stands up discovery/topology shape, #256).
+#
+# Lives under `deploy/`, OUTSIDE the Cargo workspace (ADR-0010) — the structural guard
+# that keeps orchestrator coupling out of the crates.
+#
+# `pd` is TiKV's coordinator (region placement + timestamp oracle) with the default
+# max-replicas=3, so each region's Raft group spans all three stores. Host networking is
+# used so a `tikv-client` on the HOST reaches PD (127.0.0.1:2379) and every store address
+# PD hands back (127.0.0.1:20160/20161/20162). Set
+# WYRD_TIKV_PD_ENDPOINTS=127.0.0.1:2379 for the run.
+#
+# The fault mechanism (which store to partition, and how — `docker pause` / `iptables` /
+# `tc netem`) is the runner's choice within Invariant B: it must partition a survivable
+# MINORITY (one of three), the fault must provably materialise, and it must self-heal on
+# every path. The compose only provides the topology.
+name: wyrd-metadata-tier-m46
+services:
+  pd:
+    image: pingcap/pd:v8.5.1
+    network_mode: host
+    command:
+      - --name=pd
+      - --data-dir=/data/pd
+      - --client-urls=http://127.0.0.1:2379
+      - --peer-urls=http://127.0.0.1:2380
+      - --initial-cluster=pd=http://127.0.0.1:2380
+    restart: on-failure
+
+  tikv0:
+    image: pingcap/tikv:v8.5.1
+    network_mode: host
+    depends_on:
+      - pd
+    command:
+      - --addr=127.0.0.1:20160
+      - --status-addr=127.0.0.1:20180
+      - --data-dir=/data/tikv0
+      - --pd-endpoints=127.0.0.1:2379
+    restart: on-failure
+
+  tikv1:
+    image: pingcap/tikv:v8.5.1
+    network_mode: host
+    depends_on:
+      - pd
+    command:
+      - --addr=127.0.0.1:20161
+      - --status-addr=127.0.0.1:20181
+      - --data-dir=/data/tikv1
+      - --pd-endpoints=127.0.0.1:2379
+    restart: on-failure
+
+  tikv2:
+    image: pingcap/tikv:v8.5.1
+    network_mode: host
+    depends_on:
+      - pd
+    command:
+      - --addr=127.0.0.1:20162
+      - --status-addr=127.0.0.1:20182
+      - --data-dir=/data/tikv2
+      - --pd-endpoints=127.0.0.1:2379
+    restart: on-failure
