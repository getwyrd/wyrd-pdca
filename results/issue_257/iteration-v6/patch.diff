+//! **Tier-1 metadata integration over the redb→TiKV swap** (M4.6, #257; proposal 0015
+//! §"DST and tests" — "the bare composition swap: the same system runs on TiKV behind
+//! the unchanged trait; multi-key atomic create/rename/delete succeed"). Drives the
+//! **production** `TikvMetadataStore` commit path behind the unchanged `MetadataStore`
+//! trait against a real ≥3-replica TiKV Raft group, asserting a **multi-key** batch is
+//! all-or-nothing and read-after-commit holds.
+//!
+//! **Privileged / off-Check.** Endpoint-gated exactly like `tests/conformance.rs`: with
+//! no `WYRD_TIKV_PD_ENDPOINTS` (a laptop or a PDCA worktree with no TiKV) it **skips
+//! cleanly** so `cargo xtask ci` stays green. The live run is `cargo xtask metadata-tier1`
+//! (opt in via `WYRD_TIER1=1`), which stands up `deploy/metadata-3replica/`, exports the
+//! PD endpoint, rebuilds with `--features tikv`, and drives it under a software-defined
+//! fault. Marked `#[ignore]` so even with the feature on it runs only when asked.
+
+/// The PD (Placement Driver) endpoints, or `None` when TiKV is not configured.
+fn pd_endpoints() -> Option<Vec<String>> {
+    match std::env::var("WYRD_TIKV_PD_ENDPOINTS") {
+        Ok(raw) if !raw.trim().is_empty() => Some(
+            raw.split(',')
+                .map(|e| e.trim().to_string())
+                .filter(|e| !e.is_empty())
+                .collect(),
+        ),
+        _ => None,
+    }
+}
+
+#[test]
+#[ignore = "privileged Tier-1 metadata leg: needs a real TiKV cluster (cargo xtask metadata-tier1)"]
+fn multi_key_atomic_create_over_the_swap() {
+    let Some(endpoints) = pd_endpoints() else {
+        eprintln!(
+            "wyrd-metadata-tikv: WYRD_TIKV_PD_ENDPOINTS not set — skipping the Tier-1 metadata \
+             integration leg (clean skip; the gate stays green without a TiKV)."
+        );
+        return;
+    };
+    run(endpoints);
+}
+
+#[cfg(feature = "tikv")]
+fn run(endpoints: Vec<String>) {
+    use wyrd_traits::{CommitOutcome, MetadataStore, WriteBatch};
+
+    let runtime = tokio::runtime::Builder::new_current_thread()
+        .enable_all()
+        .build()
+        .expect("tokio runtime");
+
+    runtime.block_on(async move {
+        let namespace = format!("wyrd-tier1-integration/{}/", std::process::id()).into_bytes();
+        let store = wyrd_metadata_tikv::TikvMetadataStore::connect(endpoints)
+            .await
+            .expect("connect to TiKV")
+            .with_namespace(namespace);
+
+        // A multi-key atomic create: the inode record AND its dirent land in ONE commit,
+        // guarded by require_absent on the name — the multi-key atomicity that is the
+        // whole reason TiKV was chosen over a single-key store (ADR-0008).
+        let inode = b"inode:1".to_vec();
+        let dirent = b"dirent:0/obj".to_vec();
+        let outcome = store
+            .commit(
+                WriteBatch::new()
+                    .require_absent(dirent.clone())
+                    .put(inode.clone(), b"v1".to_vec())
+                    .put(dirent.clone(), b"1".to_vec()),
+            )
+            .await
+            .expect("multi-key create must not fault");
+        assert_eq!(outcome, CommitOutcome::Committed, "the create must commit");
+
+        // Read-after-commit: BOTH keys are visible (all-or-nothing landed).
+        assert_eq!(
+            store.get(&inode).await.expect("read inode").as_deref(),
+            Some(&b"v1"[..]),
+            "the inode must be readable immediately after commit"
+        );
+        assert_eq!(
+            store.get(&dirent).await.expect("read dirent").as_deref(),
+            Some(&b"1"[..]),
+            "the dirent must be readable immediately after commit"
+        );
+
+        // A second create on the same name is a Conflict (the batch's require_absent now
+        // fails) — never a partial second write.
+        let dup = store
+            .commit(
+                WriteBatch::new()
+                    .require_absent(dirent.clone())
+                    .put(inode, b"v2".to_vec()),
+            )
+            .await
+            .expect("a duplicate create must be Conflict, not a fault");
+        assert_eq!(
+            dup,
+            CommitOutcome::Conflict,
+            "creating an existing name must Conflict all-or-nothing"
+        );
+    });
+}
+
+#[cfg(not(feature = "tikv"))]
+fn run(endpoints: Vec<String>) {
+    let _ = endpoints;
+    eprintln!(
+        "wyrd-metadata-tikv: WYRD_TIKV_PD_ENDPOINTS is set but the crate was built without \
+         `--features tikv` — skipping. Run it via `cargo xtask metadata-tier1`."
+    );
+}
