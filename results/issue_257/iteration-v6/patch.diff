 futures-util.workspace = true
+# The Tier-1 metadata consistency leg (M4.6, #257) validates its software-defined
+# fault via the SHARED fault-effect oracle / quorum arithmetic in `testkit`
+# (`partition_materialized`, `MetadataQuorumPlan`) — the same pure checks the
+# Check-time unit tests pin — so a no-op / majority partition fails the leg (Invariant B).
+wyrd-testkit.workspace = true
 
