@@ -0,0 +1,183 @@
+//! **Runtime-free behavioural coverage of the await-inside-commit interleaving**
+//! (M4.6, #257; proposal 0015 §"Pinning the trait with the second implementation").
+//!
+//! The compounding-loop seed `tests/tikv_await_commit_interleaving.rs` proves the same
+//! property under madsim (`--cfg madsim`, via `cargo xtask dst`). This file proves it a
+//! second way — on a **hand-rolled, deterministic two-task scheduler** built on
+//! `core::task` alone, with **no** madsim and **no** async runtime — so the flip is
+//! exercised by the ordinary `cargo test` inside `cargo xtask ci`, where the madsim seed
+//! compiles to nothing.
+//!
+//! It drives the production [`SimTikvMetadataStore::commit`] (the same code the madsim
+//! seed drives through `wyrd_core::write`) and asserts the **behavioural** difference the
+//! seed's bindingness rests on: under the await-inside-commit interleaving, the correct
+//! [`CommitMode::AtomicCommit`] admits **no** stale commit (the trait contract survives),
+//! while [`CommitMode::PrewriteTrust`] admits **one** (a lost update — the interleaving is
+//! consequential). Neither rests on "exactly one winner"; both rest on the commit-point
+//! atomicity the [`wyrd_traits::MetadataStore::commit`] contract promises.
+
+use std::future::Future;
+use std::pin::Pin;
+use std::sync::Arc;
+use std::task::{Context, Poll, RawWaker, RawWakerVTable, Waker};
+
+use wyrd_dst::sim_tikv::{CommitMode, SimTikvMetadataStore};
+use wyrd_traits::{CommitOutcome, MetadataStore, WriteBatch};
+
+const KEY: &[u8] = b"meta:version";
+
+// A no-op waker: our scheduler re-polls every not-yet-ready future each round, so it does
+// not need real wake notifications — it only needs a `Context` to poll with.
+fn noop_waker() -> Waker {
+    fn clone(_: *const ()) -> RawWaker {
+        RawWaker::new(std::ptr::null(), &VTABLE)
+    }
+    fn noop(_: *const ()) {}
+    static VTABLE: RawWakerVTable = RawWakerVTable::new(clone, noop, noop, noop);
+    // SAFETY: the vtable's clone/wake/drop are all no-ops over a null data pointer, so the
+    // waker is inert and sound to construct.
+    unsafe { Waker::from_raw(RawWaker::new(std::ptr::null(), &VTABLE)) }
+}
+
+/// Run `fut` to completion by polling it repeatedly (single task, no interleaving) — used
+/// to seed the store before the race.
+fn drive_to_completion<F: Future>(mut fut: Pin<&mut F>) -> F::Output {
+    let waker = noop_waker();
+    let mut cx = Context::from_waker(&waker);
+    loop {
+        if let Poll::Ready(out) = fut.as_mut().poll(&mut cx) {
+            return out;
+        }
+    }
+}
+
+/// Interleave two commit futures against the same store on a deterministic round-robin
+/// scheduler: poll A, poll B, poll A, poll B … until both are `Ready`. Because each
+/// `commit` yields exactly once (the modelled network round-trip) between reading its
+/// preconditions and applying, both futures reach their prewrite before either applies —
+/// forcing the await-inside-commit interleaving that redb never exhibits.
+fn interleave_two<FA, FB>(mut a: Pin<&mut FA>, mut b: Pin<&mut FB>) -> (FA::Output, FB::Output)
+where
+    FA: Future,
+    FB: Future,
+{
+    let waker = noop_waker();
+    let mut cx = Context::from_waker(&waker);
+    let mut out_a: Option<FA::Output> = None;
+    let mut out_b: Option<FB::Output> = None;
+    // Bounded so a scheduling bug can never hang the gate; two YieldOnce futures settle in
+    // a couple of rounds, far under the cap.
+    for _ in 0..64 {
+        if out_a.is_none() {
+            if let Poll::Ready(o) = a.as_mut().poll(&mut cx) {
+                out_a = Some(o);
+            }
+        }
+        if out_b.is_none() {
+            if let Poll::Ready(o) = b.as_mut().poll(&mut cx) {
+                out_b = Some(o);
+            }
+        }
+        if out_a.is_some() && out_b.is_some() {
+            break;
+        }
+    }
+    match (out_a, out_b) {
+        (Some(a), Some(b)) => (a, b),
+        _ => panic!("two YieldOnce-bounded commits failed to settle — the scheduler model is broken"),
+    }
+}
+
+/// Seed `store` with `KEY = "1"`, then race two overwrites that both require `KEY == "1"`
+/// under the interleaving. Returns `(outcomes, stale_admitted, final_value)`.
+fn race_two_overwrites(mode: CommitMode) -> (Vec<CommitOutcome>, u64, Option<Vec<u8>>) {
+    let store = Arc::new(SimTikvMetadataStore::with_mode(mode));
+
+    // Seed KEY = "1" (single commit, no race).
+    {
+        let seed = store.commit(
+            WriteBatch::new()
+                .require_absent(KEY.to_vec())
+                .put(KEY.to_vec(), b"1".to_vec()),
+        );
+        let mut seed = Box::pin(seed);
+        drive_to_completion(seed.as_mut()).expect("seed commit");
+    }
+
+    // Two writers both read version "1" and race to overwrite it.
+    let a = store.commit(
+        WriteBatch::new()
+            .require(KEY.to_vec(), b"1".to_vec())
+            .put(KEY.to_vec(), b"wA".to_vec()),
+    );
+    let b = store.commit(
+        WriteBatch::new()
+            .require(KEY.to_vec(), b"1".to_vec())
+            .put(KEY.to_vec(), b"wB".to_vec()),
+    );
+    let mut a = Box::pin(a);
+    let mut b = Box::pin(b);
+    let (ra, rb) = interleave_two(a.as_mut(), b.as_mut());
+    let outcomes = vec![ra.expect("commit A"), rb.expect("commit B")];
+
+    // Read back the final value (read-after-commit).
+    let read = store.get(KEY);
+    let mut read = Box::pin(read);
+    let final_value = drive_to_completion(read.as_mut())
+        .expect("read-after-commit")
+        .map(|b| b.to_vec());
+
+    (outcomes, store.stale_commits_admitted(), final_value)
+}
+
+#[test]
+fn atomic_commit_survives_the_interleaving_no_lost_update() {
+    let (outcomes, stale, final_value) = race_two_overwrites(CommitMode::AtomicCommit);
+
+    // BINDING: the correct model admits ZERO stale commits — the trait contract's
+    // commit-point atomicity survives the await-inside-commit interleaving.
+    assert_eq!(
+        stale, 0,
+        "AtomicCommit must admit no stale write at the commit point (ADR-0015): {outcomes:?}"
+    );
+    // Exactly one legitimate winner overwrote; the loser is a clean Conflict.
+    let committed = outcomes
+        .iter()
+        .filter(|o| **o == CommitOutcome::Committed)
+        .count();
+    assert_eq!(
+        committed, 1,
+        "one writer overwrites, the stale one Conflicts (no lost update): {outcomes:?}"
+    );
+    // Read-after-commit returns the winner's WHOLE value, never torn/stale "1".
+    let v = final_value.expect("value must read back");
+    assert!(
+        v == b"wA" || v == b"wB",
+        "read-after-commit must be a winner's whole value, got {:?}",
+        String::from_utf8_lossy(&v)
+    );
+}
+
+#[test]
+fn prewrite_trust_breaks_the_contract_admits_a_lost_update() {
+    let (outcomes, stale, _final_value) = race_two_overwrites(CommitMode::PrewriteTrust);
+
+    // ORACLE (load-bearing): the naive translation of the synchronous-commit assumption
+    // admits a stale commit under the SAME interleaving — a lost update. This is what
+    // proves the AtomicCommit assertion above is not vacuous: the contract is genuinely
+    // violable, and a plausible naive store violates it, only because commit awaits inside.
+    assert_eq!(
+        stale, 1,
+        "PrewriteTrust must admit exactly one stale commit (the second writer's require \
+         went stale during the await, yet it was applied): {outcomes:?}"
+    );
+    // The lost update: both writers committed over the same prior "1".
+    let committed = outcomes
+        .iter()
+        .filter(|o| **o == CommitOutcome::Committed)
+        .count();
+    assert_eq!(
+        committed, 2,
+        "the lost update means both writers commit over the same prior version: {outcomes:?}"
+    );
+}
diff --git a/crates/dst/tests/tikv_await_commit_interleaving.rs b/crates/dst/tests/tikv_await_commit_interleaving.rs
new file mode 100644
index 0000000..920737b
--- /dev/null
+++ b/crates/dst/tests/tikv_await_commit_interleaving.rs
@@ -0,0 +1,332 @@
+//! **Compounding-loop DST seed — the TiKV-shaped await-inside-commit interleaving.**
+//!
+//! This is proposal 0015's first "compounding loop" seed (§"Fidelity to ADR-0009 —
+//! the compounding loop"): a behaviour the real TiKV backend exhibits that the redb
+//! fake never modelled — a `commit()` that **suspends on network I/O between prewrite
+//! and commit** — folded back into the deterministic spine as a permanent seeded
+//! regression, "wherever it manifests through the trait contract".
+//!
+//! # What determinism rationale it corrects
+//!
+//! `tests/concurrency.rs` argues each `commit()` is "internally synchronous (one redb
+//! write transaction, no `await` inside), so the only question the scheduler decides is
+//! *which* writer commits first". That is true for redb and **false for a TiKV commit
+//! that awaits network I/O** (`crates/metadata-redb/src/lib.rs:6-10`; proposal 0015
+//! §"Pinning the trait with the second implementation"). Under a synchronous commit,
+//! madsim — which interleaves only at `.await` boundaries — can *never* run a second
+//! writer between a commit's precondition read and its apply, so a whole class of
+//! interleavings is unmodelled. This seed drives the **production** `wyrd_core::write`
+//! commit path against [`SimTikvMetadataStore`], whose `commit` awaits between prewrite
+//! and commit, so those interleavings become reachable.
+//!
+//! # The load-bearing red→green (Success criterion §1.1) — behavioural, not a self-toggle
+//!
+//! The binding assertion is that the **trait contract survives** the newly-reachable
+//! interleaving — NOT "exactly one writer wins" (that re-proves the CAS atomicity DST
+//! already owns; the Invariant forbids resting bindingness on it). It rests on the
+//! **commit-point atomicity** the [`MetadataStore::commit`] contract promises, measured
+//! as the store's own *stale-commit oracle* — and it is a **production-observable
+//! behavioural fact**, not a fixture reporting a boolean about itself:
+//!
+//! 1. **Materialisation guard** — [`SimTikvMetadataStore::interleavings_observed`] is
+//!    `>= 1`: at least one commit observed another commit land between its prewrite and
+//!    its commit point. Impossible under the uncorrected synchronous-commit assumption
+//!    (no `await` inside → nothing interleaves), so without the await-inside-commit
+//!    model the whole seed is vacuous. This is a **necessary guard**, not the binding
+//!    flip — a counter alone is decorative (the iter-5 defect), so it never stands alone.
+//!
+//! 2. **The trait contract survives (binding).** The **correct** async model
+//!    ([`CommitMode::AtomicCommit`], which re-checks preconditions at the commit point)
+//!    admits **zero** stale commits: no write whose precondition went stale during the
+//!    await is ever reported `Committed`. Plus read-after-commit returns one writer's
+//!    *whole* payload and the applied history is contiguous. This is the ADR-0015
+//!    commit-point-atomicity contract, holding under the interleaving.
+//!
+//! 3. **The interleaving is consequential (the oracle is load-bearing).** The **naive**
+//!    async model ([`CommitMode::PrewriteTrust`], the direct translation of redb's
+//!    synchronous-commit assumption, which trusts the prewrite check) admits **at least
+//!    one** stale commit under the *same* seed — a lost update. This proves assertion
+//!    (2) is not vacuous: the contract *can* be violated, a plausible naive store *does*
+//!    violate it, and it violates it *only because* the await made the interleaving
+//!    reachable. Flip the store's commit-point re-check off (regress `AtomicCommit` to
+//!    `PrewriteTrust`) and assertion (2) goes red with a real lost update — the
+//!    behavioural red the corrected determinism assumption is measured against.
+//!
+//! Requires `--cfg madsim` (set by `cargo xtask dst`); without it this file compiles to
+//! nothing. The identical behavioural property is *also* asserted with **no** madsim, on
+//! a deterministic hand-rolled two-task scheduler, in `tests/sim_tikv_await_commit.rs`,
+//! so `cargo xtask ci`'s ordinary `cargo test` exercises the flip too.
+#![cfg(madsim)]
+
+use std::sync::Arc;
+
+use madsim::runtime::Runtime;
+use wyrd_chunkstore_fs::FsChunkStore;
+use wyrd_core::metadata::EcScheme;
+use wyrd_core::{read, write};
+use wyrd_dst::sim_tikv::{CommitMode, SimTikvMetadataStore};
+use wyrd_traits::CommitOutcome;
+
+const CHUNK: usize = 4;
+const LEASE_EXPIRY: u64 = 6_000;
+const RS: EcScheme = EcScheme::ReedSolomon { k: 6, m: 3 };
+/// Four writers race the same overwrite — enough concurrent, awaiting commits that the
+/// await-inside-commit interleaving materialises under every seed (see the sweep below).
+const WRITERS: u128 = 4;
+
+/// The pinned seed the compounding-loop regression is committed under (Success
+/// criterion §1.1: "committed with its `MADSIM_TEST_SEED` **asserted on**, not
+/// `eprintln`'d"). The property is seed-independent — `interleaving_sweep` proves it
+/// across a range — but a fixed seed pins one reproducible schedule as the canonical
+/// regression.
+const SEED: u64 = 0xC0117_15EED;
+
+/// A unique, deterministic chunk-id generator starting just above `base`.
+fn ids_from(base: u128) -> impl FnMut() -> u128 {
+    let mut n = base;
+    move || {
+        n += 1;
+        n
+    }
+}
+
+/// What the race produced, extracted from the store so the assertions can inspect the
+/// full commit history rather than only the final read.
+struct RaceReport {
+    interleavings_observed: u64,
+    stale_commits_admitted: u64,
+    committed_applied_generations: Vec<u64>,
+    final_object: Option<Vec<u8>>,
+    final_version: u64,
+    committed_writers: usize,
+}
+
+/// Run the contended-overwrite race against a [`SimTikvMetadataStore`] in the given
+/// [`CommitMode`], driving the **production** four-phase write path.
+async fn run_race(mode: CommitMode) -> RaceReport {
+    let dir = tempfile::tempdir().expect("temp dir");
+    let meta = Arc::new(SimTikvMetadataStore::with_mode(mode));
+    let chunks = Arc::new(FsChunkStore::open(dir.path()).expect("fs store"));
+
+    // An existing object at version 1 (single writer, no race yet).
+    let v0 = write::plan_write(b"v0", CHUNK, RS, ids_from(1)).unwrap();
+    write::intent(&*meta, &v0, LEASE_EXPIRY).await.unwrap();
+    write::write_fragments(&*chunks, &v0).await.unwrap();
+    write::commit_create(&*meta, 0, "obj", 1, &v0)
+        .await
+        .unwrap();
+    write::release(&*meta, &v0).await.unwrap();
+    let prior = read::read_inode(&*meta, 1).await.unwrap().unwrap();
+
+    // Writers all read the same prior (version 1), stage independently, then race to
+    // commit. madsim schedules their interleaving from the seed; each commit awaits
+    // between prewrite and apply, so a second writer can run mid-commit.
+    let mut handles = Vec::new();
+    for i in 0..WRITERS {
+        let meta = Arc::clone(&meta);
+        let chunks = Arc::clone(&chunks);
+        let prior = prior.clone();
+        let content = format!("writer-{i}").into_bytes();
+        handles.push(madsim::task::spawn(async move {
+            let plan = write::plan_write(&content, CHUNK, RS, ids_from(0x1000 * (i + 1))).unwrap();
+            write::intent(&*meta, &plan, LEASE_EXPIRY).await.unwrap();
+            write::write_fragments(&*chunks, &plan).await.unwrap();
+            let outcome = write::commit_overwrite(&*meta, 1, &prior, &plan)
+                .await
+                .unwrap();
+            if outcome == CommitOutcome::Committed {
+                write::release(&*meta, &plan).await.unwrap();
+            }
+            outcome
+        }));
+    }
+
+    let mut committed_writers = 0;
+    for handle in handles {
+        if handle.await.unwrap() == CommitOutcome::Committed {
+            committed_writers += 1;
+        }
+    }
+
+    // The winning content, whole (read-after-commit).
+    let final_object = read::read_path(&*meta, &*chunks, 0, "obj").await.unwrap();
+    let final_version = read::read_inode(&*meta, 1).await.unwrap().unwrap().version;
+
+    // The applied generations pin the linearizable commit history (one bump per commit,
+    // no gap/phantom) — a generic property of the store's logical clock.
+    let committed_applied_generations = meta
+        .commit_log()
+        .iter()
+        .filter_map(|r| r.applied_generation)
+        .collect();
+
+    RaceReport {
+        interleavings_observed: meta.interleavings_observed(),
+        stale_commits_admitted: meta.stale_commits_admitted(),
+        committed_applied_generations,
+        final_object: final_object.map(|b| b.to_vec()),
+        final_version,
+        committed_writers,
+    }
+}
+
+/// Build a madsim runtime pinned to `seed` and run the race under it. A fresh runtime
+/// per seed keeps each schedule isolated and reproducible.
+fn race_under_seed(seed: u64, mode: CommitMode) -> RaceReport {
+    Runtime::with_seed_and_config(seed, madsim::Config::default()).block_on(run_race(mode))
+}
+
+/// The prior object's version before the race (created at version 1).
+const PRIOR_VERSION: u64 = 1;
+
+/// Assert the trait contract survived the race under the CORRECT model — the store-local
+/// properties that hold for *any* number of legitimate winners, so this never rests on
+/// "exactly one winner". The binding property is commit-point atomicity: no stale write
+/// was admitted, read-after-commit is whole, and the applied history is contiguous.
+fn assert_contract_survived(report: &RaceReport) {
+    // (2, the binding flip) Commit-point atomicity: the correct model admits ZERO stale
+    // commits. A stale admit is a lost update — a write reported Committed whose
+    // precondition no longer held at the commit point. Regress the commit-point re-check
+    // (AtomicCommit → PrewriteTrust) and this goes red with a real lost update.
+    assert_eq!(
+        report.stale_commits_admitted, 0,
+        "the trait contract must survive the interleaving: no commit may be admitted with \
+         stale preconditions (ADR-0015 commit-point atomicity). {} stale commit(s) slipped \
+         through — a lost update.",
+        report.stale_commits_admitted
+    );
+
+    // Read-after-commit, no torn read: the object is a WHOLE writer payload.
+    let object = report
+        .final_object
+        .as_ref()
+        .expect("committed object must read back (read-after-commit)");
+    let is_whole_writer_payload =
+        (0..WRITERS).any(|i| object == format!("writer-{i}").into_bytes().as_slice());
+    assert!(
+        is_whole_writer_payload,
+        "read-after-commit returned a torn/foreign value {:?}, not one writer's whole \
+         payload",
+        String::from_utf8_lossy(object)
+    );
+
+    // (linearizability) The applied history is contiguous and monotonic: exactly one
+    // bump per committed commit, no gap, no phantom version.
+    let mut applied = report.committed_applied_generations.clone();
+    applied.sort_unstable();
+    for (offset, gen) in applied.iter().enumerate() {
+        assert_eq!(
+            *gen,
+            offset as u64 + 1,
+            "commit generations must be contiguous from 1 (no gap/phantom): {:?}",
+            report.committed_applied_generations
+        );
+    }
+
+    // (version integrity) Each committed *overwrite* bumps the inode version exactly once
+    // from the prior; intent/create/release commits touch other keys and never the version.
+    assert_eq!(
+        report.final_version,
+        PRIOR_VERSION + report.committed_writers as u64,
+        "the inode version must bump exactly once per committed overwrite"
+    );
+}
+
+/// **The compounding-loop seed.** Under the pinned seed the await-inside-commit
+/// interleaving materialises; the correct model's trait contract survives it and the
+/// naive model breaks it — the behavioural difference that makes the contract assertion
+/// load-bearing rather than decorative.
+#[test]
+fn tikv_await_commit_interleaving_seed() {
+    let atomic = race_under_seed(SEED, CommitMode::AtomicCommit);
+    let naive = race_under_seed(SEED, CommitMode::PrewriteTrust);
+
+    // (1) Materialisation guard — the interleaving is reachable (else the seed is
+    //     vacuous). RED (== 0) under a synchronous, no-`await`-inside commit; GREEN
+    //     (>= 1) once the TiKV-shaped await-inside-commit model is exercised.
+    assert!(
+        atomic.interleavings_observed >= 1,
+        "no await-inside-commit interleaving materialised under the correct model (seed \
+         {SEED:#x}); the seed cannot be load-bearing without the interleaving it models"
+    );
+    assert!(
+        naive.interleavings_observed >= 1,
+        "no await-inside-commit interleaving materialised under the naive model (seed \
+         {SEED:#x})"
+    );
+
+    // (2) The trait contract SURVIVES the interleaving under the correct model.
+    assert_contract_survived(&atomic);
+
+    // (3) The interleaving is CONSEQUENTIAL: the naive translation of the synchronous-
+    //     commit assumption admits a stale commit (a lost update) under the SAME seed.
+    //     This is what proves (2) is not vacuous — the contract is genuinely violable,
+    //     and a plausible naive store violates it, only because commit awaits inside.
+    assert!(
+        naive.stale_commits_admitted >= 1,
+        "the await-inside-commit interleaving must be consequential: a prewrite-trust \
+         store must admit at least one stale commit (lost update) under seed {SEED:#x}, \
+         else the contract assertion above is decorative (the interleaving does not bite)"
+    );
+}
+
+/// The uncorrected assumption, made concrete in the same run: with the commit-point
+/// re-check dropped (`PrewriteTrust`, the redb-shaped "trust the prewrite check" model),
+/// the interleaving that the correct model absorbs instead produces a **lost update**.
+/// This pins the exact behaviour a regression to a synchronous/trust-prewrite commit
+/// would restore — the demonstrated red the seed's green is measured against.
+#[test]
+fn prewrite_trust_admits_a_lost_update_under_the_interleaving() {
+    let naive = race_under_seed(SEED, CommitMode::PrewriteTrust);
+    assert!(
+        naive.interleavings_observed >= 1,
+        "the interleaving must materialise for the lost update to be reachable"
+    );
+    assert!(
+        naive.stale_commits_admitted >= 1,
+        "a prewrite-trust commit MUST admit a stale write under the await-inside-commit \
+         interleaving; if this is zero the model no longer isolates the gap"
+    );
+    // The lost update shows up as more committed overwrites than a linearizable history
+    // permits: two writers that both read version 1 both commit over it.
+    assert!(
+        naive.committed_writers >= 2,
+        "a lost update means >= 2 writers committed over the same prior version; got {}",
+        naive.committed_writers
+    );
+}
+
+/// Seed-independence, stated at the right strength for each side:
+///
+/// * The **correct** model's trait contract survives the interleaving under **every**
+///   seed (a universal invariant — the whole point of the commit-point re-check), and
+///   the interleaving materialises under every seed (else the coverage is vacuous).
+/// * The **naive** model exposes the lost update under **at least one** seed of the
+///   sweep (an existential — whether two overwrites actually overlap at the commit point
+///   is a property of the individual schedule, so it is seed-dependent by nature; the
+///   pinned `SEED` is one such witness, and the runtime-free
+///   `tests/sim_tikv_await_commit.rs` forces it deterministically). This keeps the claim
+///   honest: the interleaving is *consequential* (a plausible naive store loses an
+///   update), without over-claiming it bites on every schedule.
+#[test]
+fn interleaving_sweep() {
+    let mut seeds_with_lost_update = 0;
+    for seed in 0..16u64 {
+        let atomic = race_under_seed(seed, CommitMode::AtomicCommit);
+        let naive = race_under_seed(seed, CommitMode::PrewriteTrust);
+        assert!(
+            atomic.interleavings_observed >= 1,
+            "await-inside-commit interleaving failed to materialise under seed {seed}"
+        );
+        assert_contract_survived(&atomic);
+        if naive.stale_commits_admitted >= 1 {
+            seeds_with_lost_update += 1;
+        }
+    }
+    assert!(
+        seeds_with_lost_update >= 1,
+        "the naive prewrite-trust model exposed no lost update across seeds 0..16 — the \
+         interleaving must be consequential on at least one schedule for the contract \
+         assertion to be load-bearing"
+    );
+}
