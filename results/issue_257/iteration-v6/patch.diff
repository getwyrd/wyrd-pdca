+// ─── Metadata realism-ladder Tier legs (M4.6, #257) ──────────────────────────
+//
+// The metadata-swap extension of the Tier-1/Tier-2 lines (proposal 0015 §"DST and
+// tests"; ADR-0039's in-repo scenario). Deferred/off-Check exactly like the sibling
+// legs: without `WYRD_TIER1` / `WYRD_TIER2` they print what they need and exit cleanly,
+// so they are INERT at Check. The pure decision + fault-effect oracle they consume is
+// unit-tested at Check in `xtask::metadata_faults` (`xtask/tests/`).
+
+/// Compose project for the ≥3-replica TiKV Raft group the metadata Tier legs fault —
+/// distinct from the throwaway single-node (`TIKV_PROJECT`) and multi-node stacks.
+const METADATA_TIER_PROJECT: &str = "wyrd-metadata-tier-m46";
+/// PD's client endpoint the metadata Tier stack publishes (`deploy/metadata-3replica`).
+const METADATA_TIER_PD_ENDPOINT: &str = "127.0.0.1:2379";
+/// The Raft group size `deploy/metadata-3replica` stands up — three TiKV stores, so a
+/// single-replica partition is a survivable minority (quorum on the other two).
+const METADATA_TIER_REPLICAS: usize = 3;
+/// The **one** minority replica the consistency leg partitions (tikv2 in the compose):
+/// its client + status ports. Cutting exactly one of three keeps quorum (Invariant B),
+/// so the cluster makes progress and self-heals across the fault.
+const METADATA_TIER_PARTITION_PORTS: [u16; 2] = [20162, 20182];
+/// The reachability probe dials the partitioned replica's status port, independently of
+/// the injector's own claim it cut the link (Invariant B: an *observed* transition).
+const METADATA_TIER_PROBE_ADDR: &str = "127.0.0.1:20182";
+
+/// **Tier-1 metadata integration + consistency-over-the-swap** (M4.6, #257; proposal
+/// 0015 §"DST and tests"; ADR-0039). Stand up the ≥3-replica TiKV Raft group under
+/// `deploy/metadata-3replica/`, drive the **production** `metadata-tikv` commit path
+/// behind the unchanged trait — the integration leg unfaulted, the consistency leg under
+/// a software-defined **minority-partition** fault — and assert the ADR-0015 single-zone
+/// contract holds across a fault that **provably materialised** (Invariant B). Opt in
+/// with `WYRD_TIER1=1`. Requires `docker` + `iptables` (privileged).
+///
+/// The consistency leg routes via [`crate::metadata_faults::metadata_consistency_route`]
+/// (ADR-0039: the in-repo scenario, never the literal Jepsen tool deferred to #329) — the
+/// same pure decision the Check-time dispatch test binds to — and passes only when the
+/// fault-effect oracle ([`xtask::metadata_faults::metadata_leg_passes`]) accepts a verdict
+/// built from **real probes**: the partition materialised, kept quorum, the scenario's
+/// ADR-0015 assertions held, and the fault self-healed.
+pub fn run_metadata_tier1() -> Result<(), String> {
+    let p = plan(
+        "Tier-1 metadata integration + consistency-over-the-swap",
+        "docker",
+        opted_in("WYRD_TIER1"),
+        tool_available("docker"),
+    );
+    match p {
+        Plan::Deferred(reason) => {
+            eprintln!("xtask: {reason}");
+            return Ok(());
+        }
+        Plan::MissingTool(msg) => return Err(msg),
+        Plan::Run => {}
+    }
+    if !tool_available("iptables") {
+        return Err(
+            "WYRD_TIER1=1 but `iptables` is unavailable — the consistency leg injects a \
+             minority-partition fault and needs it (privileged Tier job)"
+                .to_string(),
+        );
+    }
+
+    let integration = xtask::metadata_faults::TIER1_INTEGRATION_TEST;
+    let consistency = match xtask::metadata_faults::metadata_consistency_route(false) {
+        xtask::metadata_faults::MetadataConsistencyRoute::InRepoScenario { test, .. } => test,
+        xtask::metadata_faults::MetadataConsistencyRoute::LiteralJepsenTool { deferred_to } => {
+            return Err(format!(
+                "the metadata consistency leg routed to the literal Jepsen tool (deferred \
+                 to {deferred_to}); ADR-0039 mandates the in-repo scenario for this slice"
+            ));
+        }
+    };
+
+    with_metadata_tier_stack(|| {
+        // 1. Integration leg — the bare composition swap, NO fault: multi-key atomic
+        //    create/read-after-commit on the real TiKV path behind the unchanged trait.
+        run_metadata_scenario(integration, &[])?;
+        // 2. Consistency leg — under a materialised minority partition, gated by the
+        //    fault-effect oracle so it cannot pass with the fault absent (Invariant B).
+        run_metadata_consistency_under_partition(consistency)
+    })
+}
+
+/// **Tier-2 metadata single-machine real-I/O** (M4.6, #257; proposal 0015 §"Tier-2").
+/// Drive the production `metadata-tikv` path against real `fsync`/NVMe/OS on one owned
+/// machine — honest single-node I/O semantics the in-memory fakes abstract away. Opt in
+/// with `WYRD_TIER2=1`. Requires `docker`.
+pub fn run_metadata_tier2() -> Result<(), String> {
+    let p = plan(
+        "Tier-2 metadata single-machine real-I/O",
+        "docker",
+        opted_in("WYRD_TIER2"),
+        tool_available("docker"),
+    );
+    match p {
+        Plan::Deferred(reason) => {
+            eprintln!("xtask: {reason}");
+            return Ok(());
+        }
+        Plan::MissingTool(msg) => return Err(msg),
+        Plan::Run => {}
+    }
+
+    with_metadata_tier_stack(|| run_metadata_scenario(xtask::metadata_faults::TIER2_IO_TEST, &[]))
+}
+
+/// Bring up the ≥3-replica metadata cluster, wait for PD, run `body` against it, then
+/// tear the stack down **unconditionally** (a run never leaks containers, even on a
+/// scenario failure or a panic in `body`).
+fn with_metadata_tier_stack<F>(body: F) -> Result<(), String>
+where
+    F: FnOnce() -> Result<(), String>,
+{
+    let compose = crate::workspace_root()
+        .join("deploy/metadata-3replica/docker-compose.yml")
+        .to_string_lossy()
+        .to_string();
+
+    metadata_tier_compose(&compose, &["up", "-d"])?;
+    let result = crate::wait_for_port(METADATA_TIER_PD_ENDPOINT).and_then(|()| body());
+    let _ = metadata_tier_compose(&compose, &["down", "-v", "--remove-orphans"]);
+    result?;
+    println!("\nxtask metadata-tier: legs passed against the ≥3-replica TiKV Raft group");
+    Ok(())
+}
+
+/// Run one in-repo metadata scenario (`cargo test --features tikv --test <test>`) against
+/// the live cluster, with the PD endpoint exported (plus any `extra_env`) so the scenario
+/// dials it and drives the **real** commit path. `--features tikv` is load-bearing: without
+/// it the scenario compiles its `#[cfg(not(feature = "tikv"))]` skip branch and returns
+/// success WITHOUT connecting — a false green (the iter-5 defect this closes).
+fn run_metadata_scenario(test: &str, extra_env: &[(&str, String)]) -> Result<(), String> {
+    let args = xtask::metadata_faults::metadata_scenario_args(test);
+    crate::print_step(&{
+        let mut display = vec!["cargo"];
+        display.extend_from_slice(&args);
+        display
+    });
+    let mut cmd = Command::new("cargo");
+    cmd.args(args)
+        .current_dir(crate::workspace_root())
+        .env("WYRD_TIKV_PD_ENDPOINTS", METADATA_TIER_PD_ENDPOINT);
+    for (k, v) in extra_env {
+        cmd.env(k, v);
+    }
+    let status = cmd
+        .status()
+        .map_err(|e| format!("failed to spawn cargo for metadata Tier scenario: {e}"))?;
+    if status.success() {
+        Ok(())
+    } else {
+        Err(format!(
+            "metadata Tier scenario `{test}` failed with {status}"
+        ))
+    }
+}
+
+/// Run the consistency scenario **under a materialised minority partition**, then gate on
+/// the fault-effect oracle built from **real observations** — not hand-set fields
+/// (Invariant B; the iter-5 defect this closes).
+///
+/// The sequence: probe the target replica's reachability (before), inject the partition
+/// (a [`PartitionGuard`] that self-heals on **every** path, including a panic), probe
+/// again (after), export the fault descriptor so the scenario runs its ADR-0015
+/// assertions under the fault (rather than skipping as "no fault"), heal, and probe that
+/// it recovered. The [`xtask::metadata_faults::MetadataLegVerdict`] is assembled from
+/// those probes + the scenario's exit and must pass
+/// [`xtask::metadata_faults::metadata_leg_passes`].
+fn run_metadata_consistency_under_partition(test: &str) -> Result<(), String> {
+    use xtask::metadata_faults::{metadata_leg_passes, MetadataLegVerdict};
+
+    let quorum_plan = wyrd_testkit::MetadataQuorumPlan {
+        replicas: METADATA_TIER_REPLICAS,
+        partitioned: 1, // the two ports belong to ONE replica (tikv2) — a minority of three
+    };
+    // Reject an unsound fault shape before touching the host (Invariant B): a majority
+    // partition (takes the store down) or a zero-node partition (no-op) is not evidence.
+    if !quorum_plan.is_valid_minority_fault() {
+        return Err(format!(
+            "the configured partition is not a survivable minority fault ({quorum_plan:?}) — \
+             a majority/zero partition cannot carry the consistency leg (Invariant B)"
+        ));
+    }
+
+    let before = probe_reachability(METADATA_TIER_PROBE_ADDR);
+    let guard = PartitionGuard::inject(&METADATA_TIER_PARTITION_PORTS)?;
+    let after = probe_reachability(METADATA_TIER_PROBE_ADDR);
+
+    // Export the descriptor the scenario reads (it also independently re-checks
+    // `partition_materialized`, so a no-op fault fails the scenario too).
+    let extra_env = vec![
+        (
+            "WYRD_METADATA_FAULT_BEFORE",
+            reachability_env(before).to_string(),
+        ),
+        (
+            "WYRD_METADATA_FAULT_AFTER",
+            reachability_env(after).to_string(),
+        ),
+        ("WYRD_METADATA_REPLICAS", quorum_plan.replicas.to_string()),
+        (
+            "WYRD_METADATA_PARTITIONED",
+            quorum_plan.partitioned.to_string(),
+        ),
+    ];
+    let scenario = run_metadata_scenario(test, &extra_env);
+
+    // Heal explicitly and confirm recovery independently (the guard would also heal on
+    // drop; healing twice is idempotent).
+    drop(guard);
+    let healed = probe_reachability(METADATA_TIER_PROBE_ADDR);
+
+    let verdict = MetadataLegVerdict {
+        // Invariant B: an OBSERVED reachable→unreachable transition, not the injector's claim.
+        fault_materialized: wyrd_testkit::partition_materialized(before, after),
+        // Invariant B: a survivable minority — quorum retained across the fault.
+        retains_quorum: quorum_plan.is_valid_minority_fault(),
+        // ADR-0015: the scenario's read-after-commit + no-torn-read assertions held under
+        // the fault (the scenario exits non-zero if they did not).
+        read_after_commit_holds: scenario.is_ok(),
+        // ADR-0015: the scenario's exactly-once commit-point convergence assertion held.
+        converged_once: scenario.is_ok(),
+        // Invariant B: the fault left no host state behind — the target recovered.
+        self_healed: healed == wyrd_testkit::Reachability::Reachable,
+    };
+
+    if metadata_leg_passes(&verdict) {
+        Ok(())
+    } else {
+        Err(format!(
+            "the metadata consistency leg failed the fault-effect oracle — verdict \
+             {verdict:?}; scenario result: {scenario:?}"
+        ))
+    }
+}
+
+/// The env string the consistency scenario parses a [`wyrd_testkit::Reachability`] from.
+fn reachability_env(r: wyrd_testkit::Reachability) -> &'static str {
+    match r {
+        wyrd_testkit::Reachability::Reachable => "reachable",
+        wyrd_testkit::Reachability::Unreachable => "unreachable",
+    }
+}
+
+/// Probe a replica's reachability by dialling its status port with a short timeout —
+/// an **independent** observation of the fault's effect (Invariant B), never the
+/// injector's own claim. A successful connect ⇒ `Reachable`; a refused/timed-out connect
+/// ⇒ `Unreachable`.
+fn probe_reachability(addr: &str) -> wyrd_testkit::Reachability {
+    let reachable = addr
+        .to_socket_addrs()
+        .ok()
+        .and_then(|mut addrs| addrs.next())
+        .and_then(|sock| TcpStream::connect_timeout(&sock, Duration::from_millis(750)).ok())
+        .is_some();
+    if reachable {
+        wyrd_testkit::Reachability::Reachable
+    } else {
+        wyrd_testkit::Reachability::Unreachable
+    }
+}
+
+/// A live minority-partition fault against the metadata cluster: it DROPs loopback
+/// traffic to the target replica's ports with `iptables`, and **self-heals on every
+/// path** — [`Drop`] removes the rules even if the scenario panics or errors, so no host
+/// state leaks (Invariant B; the iter-2/3/4 leaked-`iptables`-rule bug this forecloses).
+struct PartitionGuard {
+    ports: Vec<u16>,
+    healed: bool,
+}
+
+impl PartitionGuard {
+    /// Inject the partition, dropping inbound traffic to each `port` on loopback.
+    fn inject(ports: &[u16]) -> Result<Self, String> {
+        let mut guard = Self {
+            ports: Vec::new(),
+            healed: false,
+        };
+        for &port in ports {
+            iptables_rule("-A", port)?;
+            // Record incrementally so a mid-injection failure still heals what landed.
+            guard.ports.push(port);
+        }
+        Ok(guard)
+    }
+
+    /// Remove every injected rule; idempotent (safe to call from both an explicit
+    /// `drop` and the `Drop` impl). Best-effort on each rule so one stuck delete cannot
+    /// strand the others.
+    fn heal(&mut self) {
+        if self.healed {
+            return;
+        }
+        for &port in &self.ports {
+            let _ = iptables_rule("-D", port);
+        }
+        self.healed = true;
+    }
+}
+
+impl Drop for PartitionGuard {
+    fn drop(&mut self) {
+        self.heal();
+    }
+}
+
+/// Add (`-A`) or delete (`-D`) an `iptables` INPUT DROP rule for TCP traffic to `port`
+/// on loopback — the partition primitive. `-D` failures are surfaced to the caller (the
+/// `heal` path swallows them best-effort).
+fn iptables_rule(op: &str, port: u16) -> Result<(), String> {
+    let port = port.to_string();
+    let args = [op, "INPUT", "-p", "tcp", "--dport", &port, "-j", "DROP"];
+    crate::print_step(&{
+        let mut display = vec!["iptables"];
+        display.extend_from_slice(&args);
+        display
+    });
+    let status = Command::new("iptables")
+        .args(args)
+        .status()
+        .map_err(|e| format!("failed to spawn iptables: {e}"))?;
+    if status.success() {
+        Ok(())
+    } else {
+        Err(format!(
+            "`iptables {}` failed with {status}",
+            args.join(" ")
+        ))
+    }
+}
+
+fn metadata_tier_compose(compose: &str, args: &[&str]) -> Result<(), String> {
+    let mut full = vec!["compose", "-p", METADATA_TIER_PROJECT, "-f", compose];
+    full.extend_from_slice(args);
+    let mut display = vec!["docker"];
+    display.extend_from_slice(&full);
+    crate::print_step(&display);
+    let status = Command::new("docker")
+        .args(&full)
+        .current_dir(crate::workspace_root())
+        .status()
+        .map_err(|e| format!("failed to spawn docker: {e}"))?;
+    if status.success() {
+        Ok(())
+    } else {
+        Err(format!("`docker {}` failed with {status}", full.join(" ")))
+    }
+}
+
