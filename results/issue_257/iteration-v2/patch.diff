index 0000000..9562569
--- /dev/null
+++ b/xtask/src/meta_dispatch.rs
@@ -0,0 +1,128 @@
+//! **M4.6 metadata-swap runner dispatch + nemesis plan** (proposal 0015 §"DST and
+//! tests", §"Crate touch-points", §"Suggested PR sequence" item 6, #257).
+//!
+//! The M2/M3 fault runners in [`crate::faults`] (`run_jepsen`, `run_kill_reconstruct`)
+//! exercise the **chunkstore + repair** path. M4 swaps the *metadata* backend redb→TiKV
+//! behind the unchanged `MetadataStore` trait, so it needs its OWN Tier-1 (integration +
+//! Jepsen) and Tier-2 legs that drive the *metadata* swap — never the chunkstore path
+//! (that is precisely the defect this slice fixes: "the tree's realism-ladder tiers
+//! exercise the M2/M3 chunkstore + repair path, not the metadata swap").
+//!
+//! This module is the **pure, host-independent** core — no docker, no TiKV, no
+//! `crate::` runner helpers — so it is exposed via the xtask **library target**
+//! (`pub mod meta_dispatch` in `lib.rs`) and unit-tested at Check without a privileged
+//! host (`xtask/tests/meta_dispatch_orchestration.rs`, mirroring
+//! `xtask/tests/disk_faults_orchestration.rs`). The privileged runners in
+//! [`crate::faults`] consume these decisions on their `Plan::Run` path.
+
+/// Which metadata-swap realism-ladder leg a runner drives (proposal 0015 §"DST and
+/// tests"). Distinct from the chunkstore legs: each exercises the redb→TiKV **metadata**
+/// backend swap behind the unchanged trait.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum MetaTier {
+    /// Tier-1 integration: end-to-end PUT/GET + multi-key atomic create/rename/delete on
+    /// TiKV behind the unchanged trait, all-or-nothing under partition/contention.
+    Integration,
+    /// Tier-1 Jepsen consistency: a nemesis injecting real partitions/clock-skew/pauses
+    /// validates the single-zone clauses (clause-2 linearizability; exactly-one-winner).
+    Jepsen,
+    /// Tier-2: a run on one real machine (real fsync/NVMe/OS) for I/O honesty.
+    Tier2,
+}
+
+/// Where a metadata-swap runner routes once opted in: the in-repo `cargo test
+/// -p <package> --features tikv --test <test> -- --ignored` scenario in the metadata
+/// backend crate at `manifest_dir`.
+///
+/// Modeled as a value (like [`crate::faults`]'s `JepsenDispatch`) so the Check-time
+/// dispatch test binds to it. Crucially, [`MetaDispatch::manifest_dir`] lets that test
+/// **resolve the route against the real workspace** — read the crate's `Cargo.toml`
+/// `name` and assert the `--test` file exists — so a typo in `package`/`test` (matched by
+/// a typo in the test's own expectation) can *not* pass green: the filesystem is the
+/// oracle, not a mirrored literal.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct MetaDispatch {
+    /// The cargo package the scenario lives in — always the metadata backend crate.
+    pub package: &'static str,
+    /// The `--test <name>` scenario target that drives the production `MetadataStore`.
+    pub test: &'static str,
+    /// The package's manifest directory, workspace-root-relative (e.g.
+    /// `crates/metadata-tikv`) — so a test can locate `Cargo.toml` and `tests/<test>.rs`
+    /// and verify the route resolves to a **real, runnable** target.
+    pub manifest_dir: &'static str,
+    /// The opt-in env var the dedicated off-Check job sets (`WYRD_TIER1` / `WYRD_TIER2`).
+    pub opt_in_var: &'static str,
+}
+
+/// The metadata backend crate every metadata-swap leg drives — never the chunkstore crate.
+pub const META_PACKAGE: &str = "wyrd-metadata-tikv";
+
+/// The metadata backend crate's manifest directory (workspace-root-relative).
+pub const META_MANIFEST_DIR: &str = "crates/metadata-tikv";
+
+/// Decide where a metadata-swap runner routes. Pure — decided solely from the [`MetaTier`]
+/// — so the dispatch test binds to it without a TiKV or a privileged host. Each leg routes
+/// to its `wyrd-metadata-tikv` scenario, proving the *metadata swap* behaves correctly on
+/// real TiKV, not the chunkstore repair path the pre-M4 tiers covered.
+#[must_use]
+pub fn meta_dispatch(tier: MetaTier) -> MetaDispatch {
+    match tier {
+        MetaTier::Integration => MetaDispatch {
+            package: META_PACKAGE,
+            test: "tier1_metadata_integration",
+            manifest_dir: META_MANIFEST_DIR,
+            opt_in_var: "WYRD_TIER1",
+        },
+        MetaTier::Jepsen => MetaDispatch {
+            package: META_PACKAGE,
+            test: "tier1_jepsen_metadata",
+            manifest_dir: META_MANIFEST_DIR,
+            opt_in_var: "WYRD_TIER1",
+        },
+        MetaTier::Tier2 => MetaDispatch {
+            package: META_PACKAGE,
+            test: "tier2_metadata_io",
+            manifest_dir: META_MANIFEST_DIR,
+            opt_in_var: "WYRD_TIER2",
+        },
+    }
+}
+
+// ---- Jepsen nemesis: the reproducible, quorum-safe partition plan ------------------
+
+/// The 3-node PD ensemble the multi-node `deploy/small-multi-node` stack stands up
+/// (`pd0`/`pd1`/`pd2`) — the single-zone quorum the Jepsen nemesis must keep a majority of.
+pub const META_JEPSEN_PD_NODES: usize = 3;
+
+/// Draw the Jepsen leg's reproducible, **quorum-safe** set of PD node indices to fault,
+/// from `seed` over an `n`-node PD ensemble. Delegates to the `wyrd-testkit`
+/// [`SeededMetaFaults`](wyrd_testkit::SeededMetaFaults) seam so the *same* seam the DST
+/// spine uses draws the schedule: a strict minority (a majority quorum always survives),
+/// a pure function of the seed (a bug-finding schedule replays — ADR-0009).
+#[must_use]
+pub fn nemesis_partition_nodes(seed: u64, n: usize) -> Vec<usize> {
+    use wyrd_testkit::{MetaFault, SeededMetaFaults};
+    SeededMetaFaults::minority_from_seed(seed, n, MetaFault::Partition).faulted_nodes()
+}
+
+/// One concrete container the nemesis acts on: the `deploy/small-multi-node` **service
+/// name** for a faulted PD node index (`pd0`/`pd1`/`pd2`). The runner turns each into a
+/// real `docker compose -p <project> pause <service>` (fault) then `unpause` (heal),
+/// wiring the reproducible plan through to an **actually injected** nemesis against the
+/// cluster — not merely an exported env var.
+///
+/// Kept pure and separate so the mapping (node index → the compose service that hosts
+/// that PD member) is unit-testable at Check.
+#[must_use]
+pub fn nemesis_pd_services(nodes: &[usize]) -> Vec<String> {
+    nodes.iter().map(|&i| format!("pd{i}")).collect()
+}
+
+/// The full, ordered nemesis schedule the runner executes for a `seed`: fault a
+/// quorum-safe minority of the [`META_JEPSEN_PD_NODES`] PD services, then heal them. The
+/// returned services are exactly those of [`nemesis_partition_nodes`]; a caller pauses
+/// each (the partition), holds the fault window, then unpauses each (the heal).
+#[must_use]
+pub fn jepsen_nemesis_services(seed: u64) -> Vec<String> {
+    nemesis_pd_services(&nemesis_partition_nodes(seed, META_JEPSEN_PD_NODES))
+}
diff --git a/xtask/tests/meta_dispatch_orchestration.rs b/xtask/tests/meta_dispatch_orchestration.rs
new file mode 100644
index 0000000..4ab8453
--- /dev/null
+++ b/xtask/tests/meta_dispatch_orchestration.rs
@@ -0,0 +1,166 @@
+//! **M4.6 metadata-swap runner dispatch — the Check-observable flippable** (#257;
+//! proposal 0015 §"DST and tests", §"Suggested PR sequence" item 6; the defect statement
+//! "the tree's realism-ladder tiers exercise the M2/M3 chunkstore + repair path, not the
+//! metadata swap"). Mirrors `xtask/tests/disk_faults_orchestration.rs`.
+//!
+//! **Why this file exists.** The load-bearing tier green (a live TiKV cluster under a real
+//! nemesis) is DEFERRED / privileged-off-Check. The deliverable that IS proven at Check is
+//! the pure runner **dispatch/routing** decision ([`xtask::meta_dispatch`]). Being an added
+//! integration test (`xtask/tests/*.rs`), the per-fix `C4-verify` gate keeps it while
+//! reverting the production change: with `xtask/src/meta_dispatch.rs` removed (and its
+//! `pub mod meta_dispatch` gone from `lib.rs`), `use xtask::meta_dispatch::…` fails to
+//! resolve and this target goes **RED**; with the module present it goes **GREEN**.
+//!
+//! **The oracle is not a tautology.** A prior attempt asserted the same string literals the
+//! dispatch returns — a change-detector that a matching typo in literal + expectation passes
+//! green. Here the route is **resolved against the real workspace**: the routed
+//! `package`/`manifest_dir` must match the crate's actual `Cargo.toml` `name`, and the
+//! routed `--test <name>` must correspond to an **existing** `tests/<name>.rs` file. A typo
+//! in either can no longer pass, because the filesystem — not a mirrored literal — is the
+//! oracle. That is exactly "verify routing resolves to a real, runnable target."
+
+use std::path::{Path, PathBuf};
+
+use xtask::meta_dispatch::{
+    jepsen_nemesis_services, meta_dispatch, nemesis_partition_nodes, nemesis_pd_services, MetaTier,
+    META_JEPSEN_PD_NODES,
+};
+
+/// The workspace root, resolved from this crate's manifest dir (`…/xtask`) → parent.
+fn workspace_root() -> PathBuf {
+    Path::new(env!("CARGO_MANIFEST_DIR"))
+        .parent()
+        .expect("xtask has a parent workspace dir")
+        .to_path_buf()
+}
+
+/// Read the `name = "…"` from a crate's `Cargo.toml` (`[package]` name).
+fn crate_name(manifest_dir: &Path) -> String {
+    let toml = std::fs::read_to_string(manifest_dir.join("Cargo.toml"))
+        .unwrap_or_else(|e| panic!("read {}: {e}", manifest_dir.join("Cargo.toml").display()));
+    for line in toml.lines() {
+        let line = line.trim();
+        if let Some(rest) = line.strip_prefix("name") {
+            if let Some(eq) = rest.trim_start().strip_prefix('=') {
+                return eq.trim().trim_matches('"').to_string();
+            }
+        }
+    }
+    panic!(
+        "no `name = ` in {}",
+        manifest_dir.join("Cargo.toml").display()
+    );
+}
+
+const CHUNKSTORE_PACKAGE: &str = "wyrd-chunkstore-grpc";
+const CHUNKSTORE_JEPSEN_TEST: &str = "tier1_jepsen_consistency";
+
+/// Every metadata leg routes to a **real, runnable** `wyrd-metadata-tikv` `--test` target —
+/// resolved against the actual `Cargo.toml` name and the actual test file on disk — and
+/// never to the M2/M3 chunkstore repair path.
+#[test]
+fn every_meta_leg_routes_to_a_real_metadata_swap_target() {
+    let root = workspace_root();
+    for tier in [MetaTier::Integration, MetaTier::Jepsen, MetaTier::Tier2] {
+        let d = meta_dispatch(tier);
+
+        // --- it must be the metadata swap, not the chunkstore repair path ---
+        assert_ne!(
+            d.package, CHUNKSTORE_PACKAGE,
+            "{tier:?} must NOT route to the M2/M3 chunkstore crate (the wrong system)"
+        );
+        assert_ne!(
+            d.test, CHUNKSTORE_JEPSEN_TEST,
+            "{tier:?} must NOT reuse the chunkstore repair Jepsen scenario"
+        );
+
+        // --- the route RESOLVES to a real target (filesystem is the oracle) ---
+        let manifest_dir = root.join(d.manifest_dir);
+        assert!(
+            manifest_dir.join("Cargo.toml").is_file(),
+            "{tier:?} routes to manifest_dir {:?} which has no Cargo.toml",
+            d.manifest_dir
+        );
+        assert_eq!(
+            crate_name(&manifest_dir),
+            d.package,
+            "{tier:?}: routed package must equal the crate's real Cargo.toml name at {:?}",
+            d.manifest_dir
+        );
+        let test_file = manifest_dir.join("tests").join(format!("{}.rs", d.test));
+        assert!(
+            test_file.is_file(),
+            "{tier:?}: routed `--test {}` must resolve to an existing target file {test_file:?} \
+             — a typo cannot pass, the file must actually exist to be `cargo test`-runnable",
+            d.test
+        );
+    }
+}
+
+/// The opt-in vars gate the three legs onto the right off-Check jobs, so a Check/dev box
+/// (neither var set) defers all three.
+#[test]
+fn opt_in_vars_partition_tier1_from_tier2() {
+    assert_eq!(
+        meta_dispatch(MetaTier::Integration).opt_in_var,
+        "WYRD_TIER1"
+    );
+    assert_eq!(meta_dispatch(MetaTier::Jepsen).opt_in_var, "WYRD_TIER1");
+    assert_eq!(meta_dispatch(MetaTier::Tier2).opt_in_var, "WYRD_TIER2");
+}
+
+/// The Jepsen nemesis plan is a reproducible, **quorum-safe minority** of the PD ensemble,
+/// and each faulted node maps to the real `deploy/small-multi-node` PD service name.
+#[test]
+fn jepsen_nemesis_is_reproducible_quorum_safe_and_maps_to_real_pd_services() {
+    let n = META_JEPSEN_PD_NODES;
+    assert!(
+        n >= 3,
+        "single-zone Jepsen needs a real quorum ensemble; got n={n}"
+    );
+
+    for seed in 0..16u64 {
+        let nodes = nemesis_partition_nodes(seed, n);
+        // Reproducible: the same seed yields the same plan.
+        assert_eq!(
+            nodes,
+            nemesis_partition_nodes(seed, n),
+            "seed {seed} must yield a reproducible nemesis plan"
+        );
+        // Quorum-safe: a strict minority so a PD majority survives.
+        assert!(
+            (n - nodes.len()) * 2 > n,
+            "seed {seed}: faulting {} of {n} PD nodes must leave a MAJORITY quorum",
+            nodes.len()
+        );
+        assert!(
+            nodes.iter().all(|&i| i < n),
+            "seed {seed}: faulted indices must be valid PD nodes: {nodes:?}"
+        );
+
+        // Each faulted node maps to a real deploy compose PD service (`pd0`..`pd{n-1}`).
+        let services = nemesis_pd_services(&nodes);
+        assert_eq!(services.len(), nodes.len());
+        for (svc, &i) in services.iter().zip(&nodes) {
+            assert_eq!(svc, &format!("pd{i}"));
+            assert!(
+                pd_service_exists(svc),
+                "nemesis targets service {svc:?} which is not defined in \
+                 deploy/small-multi-node/docker-compose.yml"
+            );
+        }
+        // The convenience path agrees with the two-step derivation.
+        assert_eq!(jepsen_nemesis_services(seed), services);
+    }
+}
+
+/// Whether `service` is defined in the multi-node deploy compose — the second real oracle:
+/// the nemesis can only pause a PD service that the cluster actually declares.
+fn pd_service_exists(service: &str) -> bool {
+    let compose = workspace_root().join("deploy/small-multi-node/docker-compose.yml");
+    let text = std::fs::read_to_string(&compose)
+        .unwrap_or_else(|e| panic!("read {}: {e}", compose.display()));
+    // A top-level service is a 2-space-indented `  <name>:` under `services:`.
+    text.lines()
+        .any(|l| l.trim_end() == format!("  {service}:"))
+}
