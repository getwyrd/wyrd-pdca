@@ -0,0 +1,106 @@
+//! **The real-TiKV metadata fault seam — the Check-observable flippable** (M4.6, #257;
+//! proposal 0015 §"Crate touch-points": "`testkit` — a real-TiKV-cluster fault seam
+//! (partition/latency/pause) for the Tier-1 integration + Jepsen runs"; §"DST and
+//! tests"; ADR-0015 clause 2).
+//!
+//! This file is an **added integration test** (`crates/testkit/tests/*.rs`), so the
+//! per-fix `C4-verify` gate keeps it while reverting the production change: with
+//! `crates/testkit/src/lib.rs`'s `SeededMetaFaults` seam removed, `use
+//! wyrd_testkit::SeededMetaFaults` fails to resolve and this target goes **RED**; with
+//! the seam present it goes **GREEN**. That is the demonstrated red→green the brief
+//! requires *at Check* (the load-bearing tier green is separately DEFERRED / privileged).
+//!
+//! The oracle is **independent of the implementation**, not a restatement of it: the
+//! single-zone premise is that the nemesis may fault only a strict minority so a quorum
+//! **majority survives** — `survivors * 2 > n`. A regression that let the seam fault a
+//! majority (e.g. `n / 2` instead of `⌊(n-1)/2⌋`) breaks that inequality and flips this
+//! test red, because for `n = 4` it would fault 2 and leave only 2 — not a majority.
+
+use wyrd_testkit::{MetaFault, SeededMetaFaults};
+
+/// `quorum_safe_max(n) = ⌊(n-1)/2⌋` is a **strict minority** that always leaves a
+/// **majority quorum** surviving. The `survivors * 2 > n` check is the independent
+/// oracle (proposal 0015 §"DST and tests"; ADR-0015 clause 2): a majority-faulting
+/// regression (`n / 2`) fails it at `n = 4` (fault 2, leaves 2 — not a majority).
+#[test]
+fn quorum_safe_max_leaves_a_surviving_majority() {
+    for n in 1..=12 {
+        let faulted = SeededMetaFaults::quorum_safe_max(n);
+        let survivors = n - faulted;
+        assert!(
+            survivors * 2 > n,
+            "faulting quorum_safe_max({n}) = {faulted} must leave a MAJORITY quorum \
+             ({survivors} of {n}); a majority-faulting bound (e.g. n/2) breaks this"
+        );
+        // And it is genuinely a *strict minority* — never half or more.
+        assert!(
+            faulted * 2 < n || n == 0,
+            "quorum_safe_max({n}) = {faulted} must be a strict minority of {n}"
+        );
+    }
+}
+
+/// The exact `⌊(n-1)/2⌋` values, pinned so an off-by-one that still happens to leave a
+/// majority for small n is caught (e.g. a regression to `n.saturating_sub(2) / 2`).
+#[test]
+fn quorum_safe_max_matches_floor_n_minus_1_over_2() {
+    for (n, expected) in [(1, 0), (2, 0), (3, 1), (4, 1), (5, 2), (6, 2), (7, 3)] {
+        assert_eq!(
+            SeededMetaFaults::quorum_safe_max(n),
+            expected,
+            "quorum_safe_max({n}) must be ⌊(n-1)/2⌋ = {expected}"
+        );
+    }
+}
+
+/// A seeded plan is a **pure function of the seed** (reproducibility — ADR-0009) and
+/// never faults more than a quorum-safe minority (so the consistency clauses stay
+/// observable under the Tier-1 nemesis).
+#[test]
+fn seeded_minority_is_reproducible_and_quorum_safe() {
+    for n in [3, 5, 7] {
+        let a = SeededMetaFaults::minority_from_seed(2024, n, MetaFault::Partition);
+        let b = SeededMetaFaults::minority_from_seed(2024, n, MetaFault::Partition);
+        assert_eq!(
+            a.faulted_nodes(),
+            b.faulted_nodes(),
+            "same seed → same faulted nodes (n={n})"
+        );
+
+        let faulted = a.faulted_nodes();
+        assert!(
+            faulted.len() <= SeededMetaFaults::quorum_safe_max(n),
+            "never faults more than a strict minority: {} of {n}",
+            faulted.len()
+        );
+        // The survivors form a majority quorum — the load-bearing single-zone premise.
+        assert!(
+            (n - faulted.len()) * 2 > n,
+            "a majority of {n} survives the nemesis"
+        );
+        assert!(
+            faulted.iter().all(|&i| i < n),
+            "faulted indices are valid cluster nodes: {faulted:?}"
+        );
+    }
+}
+
+/// A different seed selects a different (still quorum-safe) target set for a large
+/// enough cluster — the selection is genuinely seed-driven, not a constant.
+#[test]
+fn distinct_seeds_can_select_distinct_targets() {
+    let mut seen = std::collections::BTreeSet::new();
+    for seed in 0..32u64 {
+        let plan = SeededMetaFaults::minority_from_seed(seed, 7, MetaFault::Partition);
+        assert!(
+            plan.faulted_nodes().len() <= SeededMetaFaults::quorum_safe_max(7),
+            "every seed stays quorum-safe"
+        );
+        seen.insert(plan.faulted_nodes());
+    }
+    assert!(
+        seen.len() > 1,
+        "the seed actually drives the selection (saw {} distinct target sets over 32 seeds)",
+        seen.len()
+    );
+}
