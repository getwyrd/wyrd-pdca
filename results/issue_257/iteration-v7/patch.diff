+# Throwaway ≥3-REPLICA TiKV Raft group for the M4.6 (#257) Tier-1 metadata
+# consistency-over-the-swap leg (proposal 0015 §"DST and tests", PR-sequence item 6;
+# ADR-0039 in-repo consistency scenario; ADR-0015 single-zone contract). Like its
+# single-node sibling it lives under `deploy/`, OUTSIDE the Cargo workspace (ADR-0010:
+# the guard that keeps orchestrator coupling out of the crates).
+#
+# `pd` is TiKV's coordinator (Placement Driver). Three `tikv-N` storage nodes form the
+# Raft group whose quorum the Tier-1 consistency leg reasons about: a SYMMETRIC partition
+# of ONE node (a minority) leaves the other two holding quorum, so the majority side stays
+# writable and no split-brain / lost update is reachable against the linearizable store
+# (the load-bearing single-zone demonstration — proposal 0015; ADR-0015). PD's data
+# replication factor is set to 3 so every region is placed on all three nodes.
+#
+# Host networking so a `tikv-client` on the HOST reaches PD (127.0.0.1:2379) and each
+# store address PD hands back (127.0.0.1:2016{0,1,2}). The Tier-1 scenario isolates
+# tikv-1 (store port 20161) with a symmetric iptables DROP; the runner exports
+# WYRD_TIER1_PARTITION_PORTS=20161, WYRD_TIER1_REPLICAS=3, WYRD_TIER1_ISOLATED=1.
+# PD's default region replication factor is 3, so every region is placed on all three
+# TiKV nodes with no extra config — a one-node partition is always a minority.
+#
+# Static endpoints only (reduced bar until #365 lands L5 discovery — the "Deployment
+# prerequisite" note in proposal 0015).
+name: wyrd-tier1-metadata
+services:
+  pd:
+    image: pingcap/pd:v8.5.1
+    network_mode: host
+    command:
+      - --name=pd
+      - --data-dir=/data/pd
+      - --client-urls=http://127.0.0.1:2379
+      - --peer-urls=http://127.0.0.1:2380
+      - --initial-cluster=pd=http://127.0.0.1:2380
+    restart: on-failure
+
+  tikv-0:
+    image: pingcap/tikv:v8.5.1
+    network_mode: host
+    depends_on:
+      - pd
+    command:
+      - --addr=127.0.0.1:20160
+      - --status-addr=127.0.0.1:20180
+      - --data-dir=/data/tikv-0
+      - --pd-endpoints=127.0.0.1:2379
+    restart: on-failure
+
+  tikv-1:
+    image: pingcap/tikv:v8.5.1
+    network_mode: host
+    depends_on:
+      - pd
+    command:
+      - --addr=127.0.0.1:20161
+      - --status-addr=127.0.0.1:20181
+      - --data-dir=/data/tikv-1
+      - --pd-endpoints=127.0.0.1:2379
+    restart: on-failure
+
+  tikv-2:
+    image: pingcap/tikv:v8.5.1
+    network_mode: host
+    depends_on:
+      - pd
+    command:
+      - --addr=127.0.0.1:20162
+      - --status-addr=127.0.0.1:20182
+      - --data-dir=/data/tikv-2
+      - --pd-endpoints=127.0.0.1:2379
+    restart: on-failure
