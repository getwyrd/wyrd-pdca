@@ -0,0 +1,121 @@
+//! Tier-1/Tier-2 **metadata-backend** fault-harness orchestration (M4.6, #257; proposal
+//! 0015 §"DST and tests", PR-sequence item 6; ADR-0039 in-repo consistency scenario;
+//! ADR-0015 single-zone contract). The **host-independent** part of the metadata-swap
+//! fault harness — the run-routing decision and the partition **fault-effect oracle** —
+//! as pure functions with no privileged I/O (no `docker`, no `iptables`, no cluster).
+//!
+//! These are the metadata-tier siblings of [`crate::disk_faults`] (the M3 custodian tier)
+//! and of `xtask/src/faults.rs`'s `jepsen_dispatch`: the privileged legs that stand up a
+//! real ≥3-replica TiKV Raft group and partition it live are **deferred / off-Check**, but
+//! the DECISIONS they turn on are pure and unit-tested inside the unprivileged `cargo xtask
+//! ci` gate — the "deferred ≠ unbuilt" bar.
+//!
+//! # Born-at-tier flippable coverage
+//!
+//! `xtask/tests/metadata_faults_orchestration.rs` imports these helpers and tests them
+//! with no privileged environment. When a helper is removed, stubbed, or regressed (e.g.
+//! the dispatch re-points the live route at the removed external shell-out, or the
+//! fault-effect oracle stops requiring the target to actually go unreachable), those tests
+//! go **RED** inside `cargo xtask ci`. The privileged scenarios themselves
+//! (`crates/metadata-tikv/tests/tier1_metadata_consistency.rs`, `.../tier2_metadata_io.rs`)
+//! are compiled and type-checked by `cargo test --workspace` but skip cleanly without a
+//! configured cluster; they run for real only in the off-Check Tier job.
+
+// ─── Run-routing dispatch (mirrors faults::jepsen_dispatch) ───────────────────────
+
+/// The in-repo Tier-1 metadata consistency-over-the-swap scenario test (the `cargo test
+/// --test <name>` target). The ADR-0039-sanctioned realization of the consistency leg: an
+/// in-repo Rust scenario driving the production `metadata-tikv` path, NOT a literal public
+/// Jepsen tool (deferred to #329).
+pub const METADATA_TIER1_SCENARIO_TEST: &str = "tier1_metadata_consistency";
+
+/// The Tier-2 single-machine metadata I/O scenario test.
+pub const METADATA_TIER2_SCENARIO_TEST: &str = "tier2_metadata_io";
+
+/// A deprecated external-harness env var. There is **no** external metadata fault harness;
+/// this is representable only so the routing decision stays testable — selecting it is a
+/// hard error downstream, never a shell-out (the same shape `jepsen_dispatch` keeps for its
+/// removed legacy command).
+pub const METADATA_TIER1_LEGACY_CMD_VAR: &str = "WYRD_TIER1_METADATA_CMD";
+
+/// Where a metadata Tier run routes. Modelling the route as a value with BOTH alternatives
+/// representable is the non-tautological bar (Success criterion §1): a Check-time unit test
+/// binds to [`metadata_tier_dispatch`], and a regression that re-points the live route at
+/// the (nonexistent) external command flips that test **red behaviourally** — not by a
+/// compile error over a deleted module, and not by a constant the runner never reads.
+#[derive(Debug, PartialEq, Eq)]
+pub enum MetadataTierDispatch {
+    /// Run the in-repo `cargo test --test <test> --features tikv` consistency scenario.
+    InRepoScenario { test: &'static str },
+    /// The removed external shell-out to `env_var` — representable but never re-selected for
+    /// the default inputs; the runner turns it into a hard error.
+    ExternalCommand { env_var: &'static str },
+}
+
+/// Decide where a metadata Tier run routes. Pure — decided solely from
+/// `legacy_cmd_configured` (whether the deprecated [`METADATA_TIER1_LEGACY_CMD_VAR`] is
+/// set) — so the dispatch test binds to it without a privileged environment. The default
+/// (legacy var unset) is always the in-repo scenario (ADR-0039).
+#[must_use]
+pub fn metadata_tier_dispatch(legacy_cmd_configured: bool) -> MetadataTierDispatch {
+    if legacy_cmd_configured {
+        MetadataTierDispatch::ExternalCommand {
+            env_var: METADATA_TIER1_LEGACY_CMD_VAR,
+        }
+    } else {
+        MetadataTierDispatch::InRepoScenario {
+            test: METADATA_TIER1_SCENARIO_TEST,
+        }
+    }
+}
+
+/// The `cargo test --features tikv --test <name> -- --ignored` argv that runs an in-repo
+/// metadata scenario. The metadata scenarios drive the real `TikvMetadataStore` behind the
+/// unchanged trait, so — unlike the custodian legs — the argv MUST carry `--features tikv`
+/// (the backend is off by default so the whole-tree gate compiles the empty skeleton).
+#[must_use]
+pub fn metadata_scenario_args(test: &str) -> [&str; 10] {
+    [
+        "test",
+        "-p",
+        "wyrd-metadata-tikv",
+        "--features",
+        "tikv",
+        "--test",
+        test,
+        "--",
+        "--ignored",
+        "--nocapture",
+    ]
+}
+
+// ─── Partition fault-effect oracle (Invariant B) ──────────────────────────────────
+
+/// Did the injected **symmetric** partition actually isolate the target metadata node?
+///
+/// Invariant B (accepted with the human at Plan): a partition leg is evidence **only if the
+/// fault provably materialized**. The v6 defect was an asymmetric `iptables -j DROP` on
+/// **inbound-only** ports (`xtask/src/faults.rs:2107-2109` in that attempt) — a no-op
+/// partition that left the target reachable. This oracle is **RED (returns `false`)** unless
+/// the target's store port was reachable **before** the partition and became unreachable
+/// **during** it — a real, bidirectional isolation. A partition that leaves the port
+/// reachable (`reachable_during == true`) fails the oracle, exactly catching the asymmetric
+/// no-op shape.
+///
+/// The oracle is deliberately over the OBSERVED reachability (probed by the runner), not the
+/// `iptables` command that was issued — so a rule that "ran" but did not actually cut
+/// traffic still fails it.
+#[must_use]
+pub fn partition_took_effect(reachable_before: bool, reachable_during: bool) -> bool {
+    reachable_before && !reachable_during
+}
+
+/// Did the partition also **heal** on every dropped port? Invariant B / the v6 review: the
+/// live partition must heal **every** port it dropped (v6 dropped 20162 + 20182 but healed
+/// only 20182), and the target must be reachable again after the heal or the host state
+/// leaked. `dropped` and `healed` are the port sets the runner recorded; the heal is
+/// complete only when every dropped port was healed AND the target is reachable after.
+#[must_use]
+pub fn heal_is_complete(dropped: &[u16], healed: &[u16], reachable_after_heal: bool) -> bool {
+    reachable_after_heal && dropped.iter().all(|p| healed.contains(p))
+}
