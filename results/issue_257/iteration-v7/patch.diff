diff --git a/crates/dst/tests/tikv_await_commit_interleaving.rs b/crates/dst/tests/tikv_await_commit_interleaving.rs
new file mode 100644
index 0000000..8448c04
--- /dev/null
+++ b/crates/dst/tests/tikv_await_commit_interleaving.rs
@@ -0,0 +1,172 @@
+//! **The await-inside-commit determinism-gap seed** (M4.6, #257; proposal 0015
+//! §"Pinning the trait with the second implementation"; ADR-0009; ADR-0039 Option-B
+//! posture; ADR-0015 commit-point contract).
+//!
+//! # What this seed asserts — and, deliberately, what it does NOT
+//!
+//! The `concurrency.rs` commit-protocol campaign rests its determinism argument on a
+//! rationale scoped to redb (`crates/dst/tests/concurrency.rs:3-4`):
+//!
+//! > "each `commit()` is internally synchronous (one redb write transaction, **no await
+//! > inside**), so the only question the scheduler decides is *which* writer commits
+//! > first".
+//!
+//! That is **true for redb** and **false for `TikvMetadataStore::commit`**, which awaits
+//! network I/O between the precondition re-read (`get_for_update`,
+//! `crates/metadata-tikv/src/lib.rs:560`) and the terminal `txn.commit().await`
+//! (`crates/metadata-tikv/src/lib.rs:597`). Between those awaits a concurrent committer can
+//! interleave — an interleaving the "no await inside" rationale declares impossible. This
+//! seed **demonstrates that the interleaving is reachable**, and shows its concrete
+//! consequence, so the `concurrency.rs` rationale is on record as **unsound for the TiKV
+//! backend** the swap introduces.
+//!
+//! **This is a coverage / determinism-gap artifact, not a correctness proof of production
+//! code.** The plan's primary route — driving the real, unchanged `TikvMetadataStore::commit`
+//! over a third-party `madsim-tikv-client` deterministic sim (direction (a)) — is **blocked**:
+//! no `madsim-tikv-client` crate exists in the registry (confirmed at build; the brief's
+//! declared contingency). Under the brief's **declared Option-B fallback** the binding
+//! *correctness* bar moves to the live Tier-1 legs (off-Check), and this seed's job is the
+//! narrower, honest one: assert the *real, checkable scheduling fact* that the await-inside
+//! shape makes a new interleaving reachable. It carries **no** "a branch I wrote to be
+//! correct is correct" tautology (the v6 defect) — its teeth are a **negative control**: the
+//! synchronous shape the rationale assumes must NOT reach the same interleaving, so the
+//! positive assertion is measuring something real.
+//!
+//! # Determinism
+//!
+//! The two committers synchronise their reads before either commits (they both read version
+//! `0`, then both cross the await window), so the demonstrated interleaving is reached under
+//! **every** madsim seed the `cargo xtask dst` sweep runs (`MADSIM_TEST_NUM`), not just a
+//! lucky one — the seed is asserted-on and stable, exactly as a permanent DST regression
+//! must be (ADR-0009).
+//!
+//! Requires `--cfg madsim` (set by `cargo xtask dst`); without it this file compiles to
+//! nothing, so a normal `cargo test` neither builds nor runs it (matching `concurrency.rs`).
+#![cfg(madsim)]
+
+use std::sync::{Arc, Mutex};
+use std::time::Duration;
+
+/// A minimal model of **one metadata key's version** plus an occupancy tracker. It stands in
+/// for the single contended inode a CAS `commit(require(k, v0).put(k, v1))` re-reads and
+/// bumps; it is NOT the production store (direction (a), which would drive the real store,
+/// is blocked — see the module docs). The tracker records the maximum number of commit
+/// critical sections that were simultaneously **in flight** — between reading the
+/// precondition and writing the terminal value — which is precisely the quantity the
+/// "no await inside" rationale claims can never exceed one.
+#[derive(Default)]
+struct KeyModel {
+    /// The current committed version of the contended key.
+    version: u64,
+    /// How many commit critical sections are in flight right now.
+    in_flight: usize,
+    /// The maximum `in_flight` ever observed — `2` means two critical sections overlapped.
+    max_in_flight: usize,
+    /// How many committers wrote while still believing the version was the initial `0`
+    /// (i.e. acted on a stale pre-await read).
+    commits_from_v0: usize,
+}
+
+impl KeyModel {
+    fn enter_read(&mut self) -> u64 {
+        self.in_flight += 1;
+        self.max_in_flight = self.max_in_flight.max(self.in_flight);
+        self.version
+    }
+
+    fn commit_naive(&mut self, seen: u64) {
+        if seen == 0 {
+            self.commits_from_v0 += 1;
+        }
+        // The NAIVE commit trusts the value it read before the await window — it does NOT
+        // re-check under the transaction lock. (Production TiKV guards exactly this with the
+        // locking `get_for_update` re-read at lib.rs:560; the point here is what happens
+        // WITHOUT that guard once an await window exists.)
+        self.version = seen + 1;
+        self.in_flight -= 1;
+    }
+}
+
+/// The **await-inside** commit shape — the `TikvMetadataStore::commit` structure
+/// (`crates/metadata-tikv/src/lib.rs:540-600`): read the precondition, then **`.await`
+/// network I/O** before the terminal write. Modelled here as: read the version (enter the
+/// critical section), cross the await window (`madsim::time::sleep`, a scheduler yield
+/// point the simulator interleaves), then write `seen + 1`.
+async fn commit_await_inside(model: Arc<Mutex<KeyModel>>) {
+    let seen = model.lock().unwrap().enter_read();
+    // The await-inside-commit window the `concurrency.rs:3-4` rationale says does not exist.
+    madsim::time::sleep(Duration::from_millis(1)).await;
+    model.lock().unwrap().commit_naive(seen);
+}
+
+/// The **synchronous** commit shape the `concurrency.rs:3-4` rationale ASSUMES (redb: one
+/// write transaction, no await inside): read and write in a single, non-yielding step. This
+/// is the **negative control** — with no await window the scheduler can only *order* whole
+/// commits, so no interleaving inside a commit is reachable.
+async fn commit_synchronous(model: Arc<Mutex<KeyModel>>) {
+    let mut m = model.lock().unwrap();
+    let seen = m.enter_read();
+    m.commit_naive(seen);
+}
+
+/// Two committers race a single key at version `0`. Under the **await-inside** shape both
+/// read `0` before either writes (the critical sections overlap), so both commit believing
+/// the version is still `0` and the version advances only once — a **lost update** the
+/// interleaving admits. Under the **synchronous** shape the same two committers cannot
+/// overlap, so the second reads the first's write and the version advances twice.
+///
+/// The delta between the two runs is the evidence: the await window makes a *new*
+/// interleaving — and its lost-update consequence — reachable, which is exactly what the
+/// `concurrency.rs:3-4` "no await inside commit" rationale (sound for redb, unsound for
+/// TiKV) declares impossible.
+#[madsim::test]
+async fn await_inside_commit_reaches_an_interleaving_the_synchronous_rationale_forbids() {
+    // ── Await-inside shape (the TiKV commit structure) ──
+    let async_model = Arc::new(Mutex::new(KeyModel::default()));
+    let a = madsim::task::spawn(commit_await_inside(Arc::clone(&async_model)));
+    let b = madsim::task::spawn(commit_await_inside(Arc::clone(&async_model)));
+    a.await.unwrap();
+    b.await.unwrap();
+
+    let am = async_model.lock().unwrap();
+    assert_eq!(
+        am.max_in_flight, 2,
+        "await-inside commit: two commit critical sections overlap — the interleaving the \
+         `concurrency.rs:3-4` 'no await inside' rationale declares impossible IS reachable"
+    );
+    assert_eq!(
+        am.commits_from_v0, 2,
+        "both committers acted on the SAME stale pre-await read (version 0)"
+    );
+    assert_eq!(
+        am.version, 1,
+        "two commits from v0 with no in-txn re-check → a LOST UPDATE (version advanced once, \
+         not twice) — the concrete consequence the await window admits, and why the \
+         production `get_for_update` re-lock (lib.rs:560) is load-bearing for TiKV"
+    );
+    drop(am);
+
+    // ── NEGATIVE CONTROL: the synchronous shape the rationale assumes (redb) ──
+    let sync_model = Arc::new(Mutex::new(KeyModel::default()));
+    let a = madsim::task::spawn(commit_synchronous(Arc::clone(&sync_model)));
+    let b = madsim::task::spawn(commit_synchronous(Arc::clone(&sync_model)));
+    a.await.unwrap();
+    b.await.unwrap();
+
+    let sm = sync_model.lock().unwrap();
+    assert_eq!(
+        sm.max_in_flight, 1,
+        "synchronous commit: NO interleaving inside a commit is reachable (the property the \
+         rationale relies on — true for redb). Without this control the assertions above \
+         would be measuring nothing."
+    );
+    assert_eq!(
+        sm.commits_from_v0, 1,
+        "under the synchronous shape the second committer reads the first's write, not a \
+         stale 0"
+    );
+    assert_eq!(
+        sm.version, 2,
+        "no overlap → no lost update: the version advances exactly twice"
+    );
+}
