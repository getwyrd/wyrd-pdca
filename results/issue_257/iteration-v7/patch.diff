@@ -0,0 +1,345 @@
+//! **Tier-1 metadata consistency-over-the-swap scenario** (M4.6, #257; proposal 0015
+//! §"DST and tests", PR-sequence item 6; ADR-0039 in-repo consistency scenario; ADR-0015
+//! single-zone contract).
+//!
+//! What this proves that no in-process test can: the **production `TikvMetadataStore` commit
+//! path** (behind the unchanged `MetadataStore` trait) upholds the **ADR-0015 single-zone
+//! contract** across a real ≥3-replica TiKV Raft group when the cluster is hit by a
+//! **symmetric** network partition of a minority of voters. It carries the Tier-1
+//! **integration** leg (end-to-end multi-key atomic **create / rename / delete**,
+//! all-or-nothing across the fault) AND the Tier-1 **consistency** leg (read-after-commit
+//! and exactly-once convergence as **INDEPENDENT** signals — the v6 defect collapsed them —
+//! asserted **across the heal**, each gated by the Invariant-B fault-effect oracle).
+//!
+//! # Realization (ADR-0039)
+//!
+//! ADR-0039 rules that Wyrd's immutable single-write-per-key model does not fit a literal
+//! public Jepsen/Elle artifact (deferred to #329); the sanctioned realization is this in-repo
+//! Rust scenario driving the production path against a real containerized cluster, asserting
+//! the contract directly.
+//!
+//! # Fault soundness (Invariant B)
+//!
+//! The partition is **symmetric** (bidirectional — not the v6 inbound-only DROP), it **heals
+//! every port it dropped** on **every** exit path incl. panic (the RAII [`SymmetricPartition`]
+//! guard — the v6 leg healed only one of two dropped ports), and the scenario **waits for
+//! store-port readiness** before asserting (the v6 leg raced cluster formation). A leg is
+//! evidence only if [`wyrd_testkit::partition_materialized`] holds AND the isolated node
+//! provably went unreachable — a no-op partition fails the [`wyrd_testkit::ConsistencySignals`]
+//! `fault_materialized` gate.
+//!
+//! # Gating
+//!
+//! `#[ignore]`d and **endpoint-gated**: with no `WYRD_TIKV_PD_ENDPOINTS` set (a laptop or a
+//! PDCA worktree) it skips cleanly, and `cargo test --workspace` still **compiles and
+//! type-checks** it — proving the harness is real API-bound Rust, not an env-var shell
+//! string. The live execution happens only in the privileged off-Check Tier job
+//! (`WYRD_TIER1=1`), which stands up the ≥3-replica `deploy/tikv-multi-replica` cluster,
+//! exports the endpoints + partition target, and runs `cargo test --features tikv -- --ignored`
+//! (routed by `xtask::metadata_faults::metadata_tier_dispatch`).
+
+/// The PD endpoints, or `None` when TiKV is not configured (clean-skip gate).
+fn pd_endpoints() -> Option<Vec<String>> {
+    match std::env::var("WYRD_TIKV_PD_ENDPOINTS") {
+        Ok(raw) if !raw.trim().is_empty() => Some(
+            raw.split(',')
+                .map(|e| e.trim().to_string())
+                .filter(|e| !e.is_empty())
+                .collect(),
+        ),
+        _ => None,
+    }
+}
+
+/// Tier-1 integration + consistency-over-the-swap on the real ≥3-replica cluster. Skips
+/// cleanly (and is `#[ignore]`d) unless the privileged Tier job configured the cluster.
+#[test]
+#[ignore = "privileged Tier-1: needs a live ≥3-replica TiKV cluster (WYRD_TIER1 job)"]
+fn tier1_metadata_consistency_over_the_swap() {
+    let Some(endpoints) = pd_endpoints() else {
+        eprintln!(
+            "wyrd-metadata-tikv: WYRD_TIKV_PD_ENDPOINTS not set — skipping the Tier-1 metadata \
+             consistency scenario (clean skip; the gate stays green without a TiKV)."
+        );
+        return;
+    };
+    run(endpoints);
+}
+
+#[cfg(feature = "tikv")]
+fn run(endpoints: Vec<String>) {
+    use wyrd_testkit::{
+        consistency_passes, converged_exactly_once, partition_materialized, ConsistencySignals,
+    };
+    use wyrd_traits::{CommitOutcome, MetadataStore, WriteBatch};
+
+    let runtime = tokio::runtime::Builder::new_multi_thread()
+        .enable_all()
+        .build()
+        .expect("tokio runtime");
+
+    runtime.block_on(async move {
+        let ns = format!("wyrd-tier1-consistency/{}/", std::process::id()).into_bytes();
+        let store = connect(&endpoints, &ns).await;
+
+        // A per-key monotonic "version" cell so exactly-once convergence is observable as an
+        // arithmetic delta (testkit::converged_exactly_once), independent of the value read.
+        let vkey = b"dir/version".to_vec();
+        let a = b"dir/a".to_vec();
+        let b = b"dir/b".to_vec();
+
+        // ── Tier-1 integration: multi-key atomic CREATE (all-or-nothing) ──
+        // Create key `a` and the version cell in ONE batch: either both land or neither.
+        assert_eq!(
+            store
+                .commit(
+                    WriteBatch::new()
+                        .require_absent(a.clone())
+                        .require_absent(vkey.clone())
+                        .put(a.clone(), b"payload-0".to_vec())
+                        .put(vkey.clone(), 0u64.to_be_bytes().to_vec()),
+                )
+                .await
+                .expect("atomic create must not fault"),
+            CommitOutcome::Committed,
+            "multi-key atomic create must commit all-or-nothing",
+        );
+        let version_before = read_version(&store, &vkey).await;
+        // ADR-0015 read-after-commit signal #1: the committed value is readable now.
+        let read_after_create =
+            store.get(&a).await.expect("get a").as_deref() == Some(b"payload-0".as_slice());
+
+        // ── Apply the SYMMETRIC partition of a minority voter (Invariant B) ──
+        let partition = SymmetricPartition::from_env();
+        let fault_materialized = match &partition {
+            Some(p) => {
+                p.wait_store_ports_ready();
+                let before = p.target_reachable();
+                p.apply();
+                let during = !p.target_reachable();
+                // A minority partition of a linearizable Raft group leaves quorum on the
+                // majority side (testkit::partition_materialized asserts the split is real),
+                // and the isolated node must provably have gone unreachable (the runner-side
+                // reachability oracle) — a no-op partition fails this gate.
+                partition_materialized(p.total_replicas, p.isolated_count()) && before && during
+            }
+            // No partition target configured (e.g. a single-node smoke run): the fault did
+            // NOT materialize, so the consistency verdict below cannot pass — honest by design.
+            None => false,
+        };
+
+        // ── Tier-1 integration under the fault: multi-key atomic RENAME a→b + version bump ──
+        // A rename is delete-old + put-new in one batch; guarded on the version cell so the
+        // commit point is a single CAS. The majority side retains quorum, so this commits.
+        let rename = store
+            .commit(
+                WriteBatch::new()
+                    .require(vkey.clone(), version_before.to_be_bytes().to_vec())
+                    .require(a.clone(), b"payload-0".to_vec())
+                    .delete(a.clone())
+                    .put(b.clone(), b"payload-0".to_vec())
+                    .put(vkey.clone(), (version_before + 1).to_be_bytes().to_vec()),
+            )
+            .await
+            .expect("atomic rename must not fault on the majority side");
+        assert_eq!(
+            rename,
+            CommitOutcome::Committed,
+            "the rename must commit on the quorum-holding majority side across the partition",
+        );
+
+        // ── Heal AFTER the assertions run under partition (heal across, not before) ──
+        drop(partition); // RAII: heals EVERY dropped port on every path (incl. panic).
+
+        // ── Consistency signals, INDEPENDENT, asserted ACROSS the heal ──
+        let version_after = read_version(&store, &vkey).await;
+        let signals = ConsistencySignals {
+            // read-after-commit: both the pre-fault create AND the post-heal rename are
+            // readable, with no torn/stale state (a and b are mutually exclusive after rename).
+            read_after_commit: read_after_create
+                && store.get(&b).await.expect("get b").as_deref() == Some(b"payload-0".as_slice())
+                && store.get(&a).await.expect("get a").is_none(),
+            // exactly-once convergence: the version advanced by EXACTLY one across the heal.
+            converged_once: converged_exactly_once(version_before, version_after),
+            fault_materialized,
+        };
+        assert!(
+            consistency_passes(&signals),
+            "ADR-0015 single-zone contract must hold across the swap+heal (independent \
+             signals): {signals:?}",
+        );
+
+        // ── Tier-1 integration: multi-key atomic DELETE (cleanup, all-or-nothing) ──
+        assert_eq!(
+            store
+                .commit(
+                    WriteBatch::new()
+                        .require(b.clone(), b"payload-0".to_vec())
+                        .delete(b.clone())
+                        .delete(vkey.clone()),
+                )
+                .await
+                .expect("atomic delete must not fault"),
+            CommitOutcome::Committed,
+            "multi-key atomic delete must commit all-or-nothing",
+        );
+    });
+}
+
+#[cfg(feature = "tikv")]
+async fn connect(endpoints: &[String], namespace: &[u8]) -> wyrd_metadata_tikv::TikvMetadataStore {
+    wyrd_metadata_tikv::TikvMetadataStore::connect(endpoints.to_vec())
+        .await
+        .expect("connect to TiKV")
+        .with_namespace(namespace.to_vec())
+}
+
+#[cfg(feature = "tikv")]
+async fn read_version(store: &wyrd_metadata_tikv::TikvMetadataStore, vkey: &[u8]) -> u64 {
+    use wyrd_traits::MetadataStore;
+    let bytes = store
+        .get(vkey)
+        .await
+        .expect("read version cell")
+        .expect("version cell present");
+    let mut buf = [0u8; 8];
+    buf.copy_from_slice(&bytes[..8]);
+    u64::from_be_bytes(buf)
+}
+
+/// A **symmetric**, self-healing network partition of a minority TiKV voter (Invariant B).
+///
+/// Bidirectional `iptables` DROP on every configured store port (not the v6 inbound-only
+/// no-op), applied to the isolated node, and — via `Drop` — **healed on every exit path
+/// including panic**, restoring *every* port it dropped (the v6 leg leaked a port). The
+/// target ports and replica topology come from the runner
+/// (`WYRD_TIER1_PARTITION_PORTS`, `WYRD_TIER1_REPLICAS`, `WYRD_TIER1_ISOLATED`).
+#[cfg(feature = "tikv")]
+struct SymmetricPartition {
+    ports: Vec<u16>,
+    total_replicas: usize,
+    isolated: usize,
+    applied: std::cell::Cell<bool>,
+}
+
+#[cfg(feature = "tikv")]
+impl SymmetricPartition {
+    fn from_env() -> Option<Self> {
+        let ports: Vec<u16> = std::env::var("WYRD_TIER1_PARTITION_PORTS")
+            .ok()?
+            .split(',')
+            .filter_map(|p| p.trim().parse().ok())
+            .collect();
+        if ports.is_empty() {
+            return None;
+        }
+        let total_replicas = std::env::var("WYRD_TIER1_REPLICAS")
+            .ok()
+            .and_then(|v| v.parse().ok())
+            .unwrap_or(3);
+        let isolated = std::env::var("WYRD_TIER1_ISOLATED")
+            .ok()
+            .and_then(|v| v.parse().ok())
+            .unwrap_or(1);
+        Some(Self {
+            ports,
+            total_replicas,
+            isolated,
+            applied: std::cell::Cell::new(false),
+        })
+    }
+
+    fn isolated_count(&self) -> usize {
+        self.isolated
+    }
+
+    /// Wait until every store port accepts a connection before asserting (don't race
+    /// cluster formation — the v6 defect).
+    fn wait_store_ports_ready(&self) {
+        use std::net::TcpStream;
+        use std::time::{Duration, Instant};
+        let deadline = Instant::now() + Duration::from_secs(30);
+        for &port in &self.ports {
+            let addr = format!("127.0.0.1:{port}");
+            while TcpStream::connect_timeout(
+                &addr.parse().expect("addr"),
+                Duration::from_millis(500),
+            )
+            .is_err()
+            {
+                if Instant::now() >= deadline {
+                    panic!("store port {port} never became ready within 30s");
+                }
+                std::thread::sleep(Duration::from_millis(250));
+            }
+        }
+    }
+
+    fn target_reachable(&self) -> bool {
+        use std::net::TcpStream;
+        use std::time::Duration;
+        self.ports.iter().any(|&port| {
+            let addr = format!("127.0.0.1:{port}");
+            TcpStream::connect_timeout(&addr.parse().expect("addr"), Duration::from_millis(500))
+                .is_ok()
+        })
+    }
+
+    /// Apply a BIDIRECTIONAL DROP on every configured port (INPUT + OUTPUT), so the node is
+    /// isolated both ways — never the asymmetric inbound-only no-op.
+    fn apply(&self) {
+        for &port in &self.ports {
+            for chain in ["INPUT", "OUTPUT"] {
+                iptables(&[
+                    "-A",
+                    chain,
+                    "-p",
+                    "tcp",
+                    "--dport",
+                    &port.to_string(),
+                    "-j",
+                    "DROP",
+                ]);
+            }
+        }
+        self.applied.set(true);
+    }
+}
+
+#[cfg(feature = "tikv")]
+impl Drop for SymmetricPartition {
+    fn drop(&mut self) {
+        if !self.applied.get() {
+            return;
+        }
+        // Heal EVERY dropped port on both chains — best-effort on every exit path.
+        for &port in &self.ports {
+            for chain in ["INPUT", "OUTPUT"] {
+                iptables(&[
+                    "-D",
+                    chain,
+                    "-p",
+                    "tcp",
+                    "--dport",
+                    &port.to_string(),
+                    "-j",
+                    "DROP",
+                ]);
+            }
+        }
+    }
+}
+
+#[cfg(feature = "tikv")]
+fn iptables(args: &[&str]) {
