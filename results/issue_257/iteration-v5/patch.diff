new file mode 100644
index 0000000..a5e658e
--- /dev/null
+++ b/crates/dst/tests/tikv_await_commit_interleaving.rs
@@ -0,0 +1,291 @@
+//! **Compounding-loop DST seed — the TiKV-shaped await-inside-commit interleaving.**
+//!
+//! This is proposal 0015's first "compounding loop" seed (§"Fidelity to ADR-0009 —
+//! the compounding loop"): a behaviour the real TiKV backend exhibits that the redb
+//! fake never modelled — a `commit()` that **suspends on network I/O between prewrite
+//! and commit** — folded back into the deterministic spine as a permanent seeded
+//! regression, "wherever it manifests through the trait contract".
+//!
+//! # What determinism rationale it corrects
+//!
+//! `tests/concurrency.rs` argues each `commit()` is "internally synchronous (one redb
+//! write transaction, no `await` inside), so the only question the scheduler decides is
+//! *which* writer commits first". That is true for redb and **false for a TiKV commit
+//! that awaits network I/O** (`crates/metadata-redb/src/lib.rs:6-10`; proposal 0015
+//! §"Pinning the trait with the second implementation"). Under a synchronous commit,
+//! madsim — which interleaves only at `.await` boundaries — can *never* run a second
+//! writer between a commit's precondition read and its apply, so a whole class of
+//! interleavings is unmodelled. This seed drives the **production** `wyrd_core::write`
+//! commit path against [`SimTikvMetadataStore`], whose `commit` awaits between prewrite
+//! and commit, so those interleavings become reachable.
+//!
+//! # The load-bearing red→green (Success criterion §1.1)
+//!
+//! The binding assertion is that the **trait contract survives** the newly-reachable
+//! interleavings — NOT "exactly one writer wins" (that re-proves the CAS atomicity DST
+//! already owns; the Invariant forbids resting bindingness on it). Concretely:
+//!
+//! 1. **Materialisation oracle** — [`SimTikvMetadataStore::interleavings_observed`] is
+//!    `>= 1`: at least one commit observed another commit land between its prewrite and
+//!    its commit point. This is **impossible under the uncorrected synchronous-commit
+//!    assumption** (no `await` inside → nothing interleaves → the counter stays `0`), so
+//!    the seed is **red** there and **green** once the await-inside-commit model is
+//!    exercised. Two ways to reproduce the red (documented for the reviewer):
+//!    `SimTikvMetadataStore::commit` built with `with_await_inside_commit(false)` (the
+//!    redb-shaped assumption), or removing the `network_round_trip().await` from
+//!    `crates/dst/src/sim_tikv.rs` — the interleaving becomes unreachable.
+//!    [`no_interleaving_reachable_under_synchronous_commit`] asserts that red directly,
+//!    in the same run.
+//! 2. **Read-after-commit / no torn read** — after the race settles, the object reads
+//!    back as exactly one writer's *whole* payload (ADR-0015: read-after-commit, no
+//!    torn/stale reads).
+//! 3. **No lost update — the swap is observationally equivalent to the reference
+//!    backend.** The await-inside-commit run must reach the **same** committed state as
+//!    the synchronous (redb-shaped) run of the identical scenario: same final version,
+//!    same number of committed overwrites, a whole payload. A store that trusted its
+//!    *prewrite* precondition check (rather than re-checking at the commit point) would
+//!    let two writers that both read the same prior version both commit — bumping the
+//!    version twice and diverging from the reference — a lost update this catches, and
+//!    one that ONLY manifests once the interleaving is reachable. The applied
+//!    generations are also asserted contiguous and monotonic (no gap/phantom version).
+//!
+//! Requires `--cfg madsim` (set by `cargo xtask dst`); without it this file compiles to
+//! nothing.
+#![cfg(madsim)]
+
+use std::sync::Arc;
+
+use madsim::runtime::Runtime;
+use wyrd_chunkstore_fs::FsChunkStore;
+use wyrd_core::metadata::EcScheme;
+use wyrd_core::{read, write};
+use wyrd_dst::sim_tikv::SimTikvMetadataStore;
+use wyrd_traits::CommitOutcome;
+
+const CHUNK: usize = 4;
+const LEASE_EXPIRY: u64 = 6_000;
+const RS: EcScheme = EcScheme::ReedSolomon { k: 6, m: 3 };
+/// Four writers race the same overwrite — enough concurrent, awaiting commits that the
+/// await-inside-commit interleaving materialises under every seed (see the sweep below).
+const WRITERS: u128 = 4;
+
+/// The pinned seed the compounding-loop regression is committed under (Success
+/// criterion §1.1: "committed with its `MADSIM_TEST_SEED` **asserted on**, not
+/// `eprintln`'d"). The property is seed-independent — `interleaving_sweep` proves it
+/// across a range — but a fixed seed pins one reproducible schedule as the canonical
+/// regression.
+const SEED: u64 = 0xC0117_15EED;
+
+/// A unique, deterministic chunk-id generator starting just above `base`.
+fn ids_from(base: u128) -> impl FnMut() -> u128 {
+    let mut n = base;
+    move || {
+        n += 1;
+        n
+    }
+}
+
+/// What the race produced, extracted from the store so the assertions can inspect the
+/// full commit history rather than only the final read.
+struct RaceReport {
+    interleavings_observed: u64,
+    committed_applied_generations: Vec<u64>,
+    final_object: Option<Vec<u8>>,
+    final_version: u64,
+    committed_writers: usize,
+}
+
+/// Run the contended-overwrite race against a [`SimTikvMetadataStore`] built with the
+/// given `await_inside_commit`, driving the **production** four-phase write path.
+async fn run_race(await_inside_commit: bool) -> RaceReport {
+    let dir = tempfile::tempdir().expect("temp dir");
+    let meta = Arc::new(SimTikvMetadataStore::with_await_inside_commit(
+        await_inside_commit,
+    ));
+    let chunks = Arc::new(FsChunkStore::open(dir.path()).expect("fs store"));
+
+    // An existing object at version 1 (single writer, no race yet).
+    let v0 = write::plan_write(b"v0", CHUNK, RS, ids_from(1)).unwrap();
+    write::intent(&*meta, &v0, LEASE_EXPIRY).await.unwrap();
+    write::write_fragments(&*chunks, &v0).await.unwrap();
+    write::commit_create(&*meta, 0, "obj", 1, &v0)
+        .await
+        .unwrap();
+    write::release(&*meta, &v0).await.unwrap();
+    let prior = read::read_inode(&*meta, 1).await.unwrap().unwrap();
+
+    // Writers all read the same prior (version 1), stage independently, then race to
+    // commit. madsim schedules their interleaving from the seed; each commit awaits
+    // between prewrite and apply, so a second writer can run mid-commit.
+    let mut handles = Vec::new();
+    for i in 0..WRITERS {
+        let meta = Arc::clone(&meta);
+        let chunks = Arc::clone(&chunks);
+        let prior = prior.clone();
+        let content = format!("writer-{i}").into_bytes();
+        handles.push(madsim::task::spawn(async move {
+            let plan = write::plan_write(&content, CHUNK, RS, ids_from(0x1000 * (i + 1))).unwrap();
+            write::intent(&*meta, &plan, LEASE_EXPIRY).await.unwrap();
+            write::write_fragments(&*chunks, &plan).await.unwrap();
+            let outcome = write::commit_overwrite(&*meta, 1, &prior, &plan)
+                .await
+                .unwrap();
+            if outcome == CommitOutcome::Committed {
+                write::release(&*meta, &plan).await.unwrap();
+            }
+            outcome
+        }));
+    }
+
+    let mut committed_writers = 0;
+    for handle in handles {
+        if handle.await.unwrap() == CommitOutcome::Committed {
+            committed_writers += 1;
+        }
+    }
+
+    // The winning content, whole (read-after-commit).
+    let final_object = read::read_path(&*meta, &*chunks, 0, "obj").await.unwrap();
+    let final_version = read::read_inode(&*meta, 1).await.unwrap().unwrap().version;
+
+    // The applied generations pin the linearizable commit history (one bump per commit,
+    // no gap/phantom) — a generic property of the store's logical clock.
+    let committed_applied_generations = meta
+        .commit_log()
+        .iter()
+        .filter_map(|r| r.applied_generation)
+        .collect();
+
+    RaceReport {
+        interleavings_observed: meta.interleavings_observed(),
+        committed_applied_generations,
+        final_object: final_object.map(|b| b.to_vec()),
+        final_version,
+        committed_writers,
+    }
+}
+
+/// Build a madsim runtime pinned to `seed` and run the race under it. A fresh runtime
+/// per seed keeps each schedule isolated and reproducible.
+fn race_under_seed(seed: u64, await_inside_commit: bool) -> RaceReport {
+    Runtime::with_seed_and_config(seed, madsim::Config::default())
+        .block_on(run_race(await_inside_commit))
+}
+
+/// The prior object's version before the race (created at version 1).
+const PRIOR_VERSION: u64 = 1;
+
+/// Assert the trait contract survived the race — the store-local properties that hold
+/// for *any* number of winners, so this never rests on "exactly one winner".
+fn assert_contract_survived(report: &RaceReport) {
+    // (2) Read-after-commit, no torn read: the object is a WHOLE writer payload.
+    let object = report
+        .final_object
+        .as_ref()
+        .expect("committed object must read back (read-after-commit)");
+    let is_whole_writer_payload =
+        (0..WRITERS).any(|i| object == format!("writer-{i}").into_bytes().as_slice());
+    assert!(
+        is_whole_writer_payload,
+        "read-after-commit returned a torn/foreign value {:?}, not one writer's whole \
+         payload",
+        String::from_utf8_lossy(object)
+    );
+
+    // (3, linearizability) The applied history is contiguous and monotonic: exactly one
+    // bump per committed commit, no gap, no phantom version.
+    let mut applied = report.committed_applied_generations.clone();
+    applied.sort_unstable();
+    for (offset, gen) in applied.iter().enumerate() {
+        assert_eq!(
+            *gen,
+            offset as u64 + 1,
+            "commit generations must be contiguous from 1 (no gap/phantom): {:?}",
+            report.committed_applied_generations
+        );
+    }
+
+    // (version integrity) Each committed *overwrite* bumps the inode version exactly once
+    // from the prior; intent/create/release commits touch other keys and never the version.
+    assert_eq!(
+        report.final_version,
+        PRIOR_VERSION + report.committed_writers as u64,
+        "the inode version must bump exactly once per committed overwrite"
+    );
+}
+
+/// Assert the await-inside-commit swap is **observationally equivalent** to the
+/// synchronous reference backend on the identical scenario (the no-lost-update property,
+/// framed as "the backend matches", never as a winner count). A store that skipped the
+/// commit-point re-check would let a second stale writer commit under the interleaving,
+/// diverging the version/winner count from the reference.
+fn assert_backend_equivalence(await_run: &RaceReport, sync_run: &RaceReport) {
+    assert_eq!(
+        await_run.final_version, sync_run.final_version,
+        "await-inside-commit diverged from the synchronous backend on the final version \
+         — a lost update slipped through the interleaving"
+    );
+    assert_eq!(
+        await_run.committed_writers, sync_run.committed_writers,
+        "await-inside-commit committed a different number of overwrites than the \
+         synchronous backend — the CAS did not survive the interleaving"
+    );
+}
+
+/// **The compounding-loop seed.** Under the pinned seed the await-inside-commit
+/// interleaving materialises and the trait contract survives it.
+#[test]
+fn tikv_await_commit_interleaving_seed() {
+    let await_run = race_under_seed(SEED, true);
+
+    // (1) Materialisation oracle — the load-bearing red→green. RED (== 0) under a
+    //     synchronous, no-`await`-inside commit; GREEN (>= 1) once the TiKV-shaped
+    //     model is exercised.
+    assert!(
+        await_run.interleavings_observed >= 1,
+        "no await-inside-commit interleaving materialised (seed {SEED:#x}); the seed \
+         cannot be load-bearing without the interleaving it exists to model — this is \
+         the red the uncorrected synchronous-commit assumption produces"
+    );
+
+    // (2) + linearizability + version integrity: the contract held under the interleaving.
+    assert_contract_survived(&await_run);
+
+    // (3) No lost update: the swap matches the synchronous reference backend exactly.
+    let sync_run = race_under_seed(SEED, false);
+    assert_backend_equivalence(&await_run, &sync_run);
+}
+
+/// The uncorrected assumption, asserted directly in the same run: with the
+/// await-inside-commit suspension **off** (the redb-shaped "internally synchronous, no
+/// `await` inside" model), the interleaving is unreachable — the materialisation oracle
+/// is `0`. This is the concrete "demonstrated red" the seed's green run is measured
+/// against, and it pins the exact behaviour a regression to a synchronous commit would
+/// restore.
+#[test]
+fn no_interleaving_reachable_under_synchronous_commit() {
+    let report = race_under_seed(SEED, false);
+    assert_eq!(
+        report.interleavings_observed, 0,
+        "a synchronous, no-`await`-inside commit must NOT interleave mid-commit; if this \
+         is non-zero the model no longer isolates the await-inside-commit gap"
+    );
+    // The contract still holds under synchronous commit — the point of the seed is the
+    // *interleaving coverage*, not that TiKV's CAS is more correct than redb's.
+    assert_contract_survived(&report);
+}
+
+/// Seed-independence: across a range of seeds the interleaving always materialises AND
+/// the contract always survives. This is why the pinned `SEED` above is a canonical
+/// witness, not a lucky draw.
+#[test]
+fn interleaving_sweep() {
+    for seed in 0..16u64 {
+        let report = race_under_seed(seed, true);
+        assert!(
+            report.interleavings_observed >= 1,
+            "await-inside-commit interleaving failed to materialise under seed {seed}"
+        );
+        assert_contract_survived(&report);
+    }
+}
