-         <ci|conformance|gen-vectors|dst|statics|integration|tikv-conformance|deploy-small-multi-node|disk-faults|jepsen|kill-reconstruct|bench>"
+         <ci|conformance|gen-vectors|dst|statics|integration|tikv-conformance|deploy-small-multi-node|disk-faults|jepsen|kill-reconstruct|metadata-tier1|metadata-tier2|bench>"
     );
 }
 
diff --git a/xtask/src/metadata_faults.rs b/xtask/src/metadata_faults.rs
new file mode 100644
index 0000000..ba30b98
--- /dev/null
+++ b/xtask/src/metadata_faults.rs
@@ -0,0 +1,142 @@
+//! **Metadata realism-ladder Tier-1/Tier-2 harness orchestration** (M4.6, #257;
+//! proposal 0015 §"DST and tests" — the metadata-swap extension of the Tier-1 lines;
+//! ADR-0039 — the in-repo-scenario realisation of the consistency leg).
+//!
+//! The **host-independent** part of the metadata Tier harness: the dispatch decision
+//! (which in-repo scenario a leg routes to) and the **fault-effect oracle** (whether a
+//! leg's injected fault provably took effect and the ADR-0015 contract held across it).
+//!
+//! These are pure functions with no privileged I/O (no `docker`, no `iptables`, no TiKV),
+//! so they are unit-testable inside the unprivileged `cargo xtask ci` gate and compile
+//! on any host (ADR-0016) — the "deferred ≠ unbuilt" bar: the live legs run only in the
+//! off-Check privileged Tier job, but their decision logic is compiled and
+//! test-exercised at Check, red when negated.
+//!
+//! The privileged scenarios themselves live at `crates/metadata-tikv/tests/tier1_*.rs`
+//! and `tier2_*.rs`, are endpoint-gated (`#[ignore]`-equivalent: they skip cleanly with
+//! no `WYRD_TIKV_PD_ENDPOINTS`), and are driven by `cargo xtask metadata-tier1 /
+//! metadata-tier2` in the off-Check Tier job (opted in via `WYRD_TIER1=1` /
+//! `WYRD_TIER2=1`).
+//!
+//! # Born-at-tier flippable coverage
+//!
+//! `xtask/tests/metadata_faults_orchestration.rs` imports these helpers and tests them
+//! with no privileges. When a helper is removed or returns a wrong value — or a
+//! regression re-points the consistency leg at the literal Jepsen tool ADR-0039 defers
+//! to #329 — those tests go RED inside `cargo xtask ci`.
+
+// ─── Dispatch: which realisation runs the consistency leg ─────────────────────
+
+/// The crate the metadata Tier scenarios live in (driven behind the unchanged trait).
+pub const METADATA_TIKV_CRATE: &str = "wyrd-metadata-tikv";
+/// The in-repo Tier-1 **integration** scenario (end-to-end PUT/GET + multi-key atomic
+/// create/rename/delete on the real `metadata-tikv` path across a fault).
+pub const TIER1_INTEGRATION_TEST: &str = "tier1_metadata_integration";
+/// The in-repo Tier-1 **consistency-over-the-swap** scenario (the ADR-0015 single-zone
+/// contract under a materialised fault) — ADR-0039's sanctioned realisation.
+pub const TIER1_CONSISTENCY_TEST: &str = "tier1_metadata_consistency";
+/// The Tier-2 **single-machine real-I/O** scenario (real `fsync`/NVMe/OS).
+pub const TIER2_IO_TEST: &str = "tier2_metadata_io";
+
+/// Where the Tier-1 **consistency** leg routes. Modelled as a value with BOTH
+/// alternatives representable — mirroring `faults::jepsen_dispatch` — so a Check-time
+/// unit test binds to the decision and a regression flips it **behaviourally**, not by
+/// a compile error over a deleted module.
+#[derive(Debug, PartialEq, Eq)]
+pub enum MetadataConsistencyRoute {
+    /// ADR-0039's sanctioned realisation: the in-repo Rust scenario driving the
+    /// production `metadata-tikv` commit path behind the unchanged trait.
+    InRepoScenario {
+        /// The crate the scenario lives in.
+        crate_name: &'static str,
+        /// The `cargo test --test <test>` target.
+        test: &'static str,
+    },
+    /// The **literal public Jepsen/Elle** credibility artifact — ADR-0039 finds it does
+    /// not fit Wyrd's immutable single-write-per-key model and **defers it to #329**.
+    /// It is NEVER the route for this slice; representable only so a regression that
+    /// re-attempts it (the iter-4 demand ADR-0039 forbids) is caught by the dispatch test.
+    LiteralJepsenTool {
+        /// The issue the literal-Jepsen artifact is deferred to.
+        deferred_to: &'static str,
+    },
+}
+
+/// Decide where the Tier-1 consistency leg routes. Pure — decided solely from
+/// `force_literal_jepsen` — so the dispatch test binds to it without a privileged
+/// environment. Per ADR-0039 the route is the in-repo scenario; the literal Jepsen tool
+/// is honoured only as a **deferred** route (never selected for the production inputs
+/// the metadata Tier job runs with, `force_literal_jepsen == false`). Reverting this so
+/// the default input returns `LiteralJepsenTool` re-attempts what ADR-0039 forbids here
+/// and turns the dispatch test red.
+#[must_use]
+pub fn metadata_consistency_route(force_literal_jepsen: bool) -> MetadataConsistencyRoute {
+    if force_literal_jepsen {
+        MetadataConsistencyRoute::LiteralJepsenTool {
+            deferred_to: "#329",
+        }
+    } else {
+        MetadataConsistencyRoute::InRepoScenario {
+            crate_name: METADATA_TIKV_CRATE,
+            test: TIER1_CONSISTENCY_TEST,
+        }
+    }
+}
+
+/// The `cargo test --test <test> -- --ignored` argv the in-repo route runs — the same
+/// shape the sibling `faults::jepsen_scenario_args` leg uses, against the metadata crate.
+#[must_use]
+pub fn metadata_scenario_args(test: &str) -> [&str; 8] {
+    [
+        "test",
+        "-p",
+        METADATA_TIKV_CRATE,
+        "--test",
+        test,
+        "--",
+        "--ignored",
+        "--nocapture",
+    ]
+}
+
+// ─── Fault-effect oracle: did the leg's fault provably take effect? ────────────
+
+/// The verdict for one live metadata Tier-1 leg (integration or consistency). A leg is
+/// evidence **only if** every component holds — most importantly `fault_materialized`
+/// (Invariant B: the fault provably took effect) and `self_healed` (Invariant B: no
+/// leaked host state). This is the fault-effect oracle: it is **red when the fault was a
+/// no-op**, the exact iter-2/3/4 failure the pure check now forecloses.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct MetadataLegVerdict {
+    /// The injected partition/pause provably materialised — an *observed* reachability
+    /// transition, from `wyrd_testkit::partition_materialized` (NOT the injector's claim).
+    pub fault_materialized: bool,
+    /// The fault was a **survivable minority** partition — the Raft group kept quorum, so
+    /// the cluster made progress and self-healed across the fault
+    /// (`wyrd_testkit::MetadataQuorumPlan::is_valid_minority_fault`).
+    pub retains_quorum: bool,
+    /// ADR-0015: a committed value stayed readable across the fault — read-after-commit,
+    /// no torn/stale read.
+    pub read_after_commit_holds: bool,
+    /// ADR-0015: commit-point atomicity converged **exactly once** across the heal.
+    pub converged_once: bool,
+    /// Invariant B: the fault self-healed on every path — no host-wide mutation survived
+    /// the run (link restored, no leaked `iptables` rule / clock skew / paused container).
+    pub self_healed: bool,
+}
+
+/// Whether a Tier-1 metadata leg passes: the ADR-0015 contract held **and** the fault
+/// that tested it provably materialised, was survivable, and left no host state behind.
+///
+/// The two Invariant-B components (`fault_materialized`, `self_healed`) are what make
+/// this an *oracle* and not a rubber stamp: a leg whose "partition" was an asymmetric
+/// no-op has `fault_materialized == false` and **fails**, even if every consistency
+/// assertion trivially passed against an un-faulted cluster.
+#[must_use]
+pub fn metadata_leg_passes(v: &MetadataLegVerdict) -> bool {
+    v.fault_materialized
+        && v.retains_quorum
+        && v.read_after_commit_holds
+        && v.converged_once
+        && v.self_healed
+}
diff --git a/xtask/tests/metadata_faults_orchestration.rs b/xtask/tests/metadata_faults_orchestration.rs
new file mode 100644
index 0000000..c6fae0e
--- /dev/null
+++ b/xtask/tests/metadata_faults_orchestration.rs
@@ -0,0 +1,154 @@
+//! Unit tests for the metadata realism-ladder Tier harness orchestration
+//! (`xtask::metadata_faults` — the Check-time flippable coverage, M4.6, #257,
+//! proposal 0015 §"DST and tests", ADR-0039).
+//!
+//! **Why these tests exist.** The metadata Tier-1/Tier-2 legs are "deferred"
+//! (privileged): their live scenarios (`crates/metadata-tikv/tests/tier1_*.rs`,
+//! `tier2_metadata_io.rs`) need a real ≥3-replica TiKV cluster + software-defined
+//! faults and skip cleanly at Check. "Deferred" does NOT mean unbuilt: the dispatch
+//! decision and the fault-effect oracle are compiled and test-exercised here, inside
+//! `cargo xtask ci`'s `cargo test --workspace`, and go **RED** when a helper is removed,
+//! returns a wrong value, or a regression re-points the consistency leg at the literal
+//! Jepsen tool ADR-0039 defers to #329.
+
+use xtask::metadata_faults::{
+    metadata_consistency_route, metadata_leg_passes, metadata_scenario_args,
+    MetadataConsistencyRoute, MetadataLegVerdict, METADATA_TIKV_CRATE, TIER1_CONSISTENCY_TEST,
+};
+
+// ─── Dispatch/routing (mirrors faults::jepsen_dispatch, ADR-0039) ─────────────
+
+#[test]
+fn consistency_leg_routes_to_in_repo_scenario_not_literal_jepsen() {
+    // The production metadata Tier job runs with `force_literal_jepsen == false`, so the
+    // route MUST be the in-repo Rust scenario ADR-0039 sanctions — never the literal
+    // Jepsen tool it defers to #329.
+    match metadata_consistency_route(false) {
+        MetadataConsistencyRoute::InRepoScenario { crate_name, test } => {
+            assert_eq!(crate_name, METADATA_TIKV_CRATE);
+            assert_eq!(
+                test, TIER1_CONSISTENCY_TEST,
+                "the consistency leg must route to the in-repo tier1_metadata_consistency scenario"
+            );
+        }
+        MetadataConsistencyRoute::LiteralJepsenTool { deferred_to } => panic!(
+            "the consistency leg regressed to the literal Jepsen tool (deferred to \
+             {deferred_to}) — ADR-0039 forbids re-attempting literal Jepsen in this slice"
+        ),
+    }
+}
+
+#[test]
+fn literal_jepsen_is_representable_but_deferred_and_never_the_default() {
+    // The literal-Jepsen route is representable (so a regression to it is catchable) but
+    // is reached ONLY by an explicit force flag, and it names the deferral issue.
+    assert!(
+        matches!(
+            metadata_consistency_route(true),
+            MetadataConsistencyRoute::LiteralJepsenTool { deferred_to } if deferred_to == "#329"
+        ),
+        "literal Jepsen must be reachable only under an explicit force flag, deferred to #329"
+    );
+}
+
+#[test]
+fn in_repo_route_assembles_the_ignored_scenario_argv() {
+    let args = metadata_scenario_args(TIER1_CONSISTENCY_TEST);
+    assert_eq!(
+        args[0], "test",
+        "must be a `cargo test` invocation: {args:?}"
+    );
+    let flat = args.join(" ");
+    assert!(
+        flat.contains(TIER1_CONSISTENCY_TEST)
+            && flat.contains("--ignored")
+            && flat.contains(METADATA_TIKV_CRATE),
+        "in-repo route must run the endpoint-gated scenario in wyrd-metadata-tikv: {flat}"
+    );
+}
+
+// ─── Fault-effect oracle (Invariant B) ────────────────────────────────────────
+
+fn passing_verdict() -> MetadataLegVerdict {
+    MetadataLegVerdict {
+        fault_materialized: true,
+        retains_quorum: true,
+        read_after_commit_holds: true,
+        converged_once: true,
+        self_healed: true,
+    }
+}
+
+#[test]
+fn leg_passes_when_fault_materialized_and_contract_held() {
+    assert!(
+        metadata_leg_passes(&passing_verdict()),
+        "a materialised, survivable, self-healing fault under which the ADR-0015 contract \
+         held must pass"
+    );
+}
+
+#[test]
+fn leg_fails_when_fault_was_a_noop() {
+    // The iter-2/3/4 failure: the "partition" never took effect. Even with every
+    // consistency assertion trivially green against the un-faulted cluster, the leg fails.
+    let v = MetadataLegVerdict {
+        fault_materialized: false,
+        ..passing_verdict()
+    };
+    assert!(
+        !metadata_leg_passes(&v),
+        "a fault that did not materialise (no-op partition) must fail the leg (Invariant B)"
+    );
+}
+
+#[test]
+fn leg_fails_when_fault_took_down_quorum() {
+    // A majority partition takes the store down — not a survivable minority fault.
+    let v = MetadataLegVerdict {
+        retains_quorum: false,
+        ..passing_verdict()
+    };
+    assert!(
+        !metadata_leg_passes(&v),
+        "a fault that cost the group quorum is not a valid consistency leg"
+    );
+}
+
+#[test]
+fn leg_fails_on_torn_or_stale_read() {
+    let v = MetadataLegVerdict {
+        read_after_commit_holds: false,
+        ..passing_verdict()
+    };
+    assert!(
+        !metadata_leg_passes(&v),
+        "a torn/stale read violates ADR-0015 read-after-commit and must fail the leg"
+    );
+}
+
+#[test]
+fn leg_fails_when_convergence_was_not_exactly_once() {
+    let v = MetadataLegVerdict {
+        converged_once: false,
+        ..passing_verdict()
+    };
+    assert!(
+        !metadata_leg_passes(&v),
+        "commit-point atomicity must converge exactly once across the heal"
+    );
+}
+
+#[test]
+fn leg_fails_when_host_state_leaked() {
+    // Invariant B: a leaked iptables rule / clock skew / paused container that survived
+    // the run fails the leg even if the consistency assertions passed.
+    let v = MetadataLegVerdict {
+        self_healed: false,
+        ..passing_verdict()
+    };
+    assert!(
+        !metadata_leg_passes(&v),
+        "a fault that leaked host state (did not self-heal) must fail the leg (Invariant B)"
+    );
+}
