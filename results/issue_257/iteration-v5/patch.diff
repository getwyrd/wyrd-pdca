@@ -0,0 +1,326 @@
+//! A **deterministic simulated-TiKV [`MetadataStore`]** for DST (proposal 0015
+//! §"Crate touch-points": `dst` — "a deterministic simulated-TiKV model (or a
+//! trait-level contract property harness) so the property suite drives both
+//! backends"; §"Pinning the trait with the second implementation", ADR-0009,
+//! ADR-0006).
+//!
+//! # The await-inside-commit determinism gap this closes
+//!
+//! The redb backend commits **synchronously**: one redb write transaction, with the
+//! preconditions checked *inside* that transaction and no `await` between reading
+//! them and applying the batch (`crates/metadata-redb/src/lib.rs:6-10`). madsim's
+//! cooperative, single-threaded scheduler interleaves tasks **only at `.await`
+//! boundaries**, so with redb *nothing* can run between a commit's precondition read
+//! and its apply — the commit is atomic w.r.t. the scheduler, and the concurrency
+//! harness's stated rationale ("each `commit()` is internally synchronous …, no
+//! `await` inside", `crates/dst/tests/concurrency.rs`) holds.
+//!
+//! A **TiKV** commit is *not* internally synchronous: it `await`s network I/O
+//! between reading the preconditions (prewrite) and applying the batch (commit), so
+//! the scheduler **can** run another writer in that gap — an interleaving redb never
+//! exhibits and the synchronous-commit rationale wrongly excludes (proposal 0015
+//! §"Pinning the trait with the second implementation", which names this gap).
+//!
+//! [`SimTikvMetadataStore::commit`] models exactly that suspension point: it snapshots
+//! the store generation and preconditions, `await`s [`network_round_trip`], then
+//! **re-checks the preconditions at the commit point** and applies atomically. That
+//! commit-point re-check is the optimistic compare-and-set that keeps the trait
+//! contract intact under the newly-reachable interleaving. The seed
+//! `crates/dst/tests/tikv_await_commit_interleaving.rs` drives the production
+//! `wyrd_core::write` commit path against this backend and asserts the interleaving
+//! **materialised** and the **trait contract survived** it — the compounding-loop
+//! seed (proposal 0015 §"Fidelity to ADR-0009 — the compounding loop") that folds
+//! the await-inside-commit finding back into the deterministic spine.
+//!
+//! This crate holds no production *service* code, but the simulated backend is a
+//! real library item (not a test fixture) so #258's second-implementation
+//! contract/property harness can drive it through the identical suite.
+
+use std::collections::HashMap;
+use std::future::Future;
+use std::pin::Pin;
+use std::sync::atomic::{AtomicU64, Ordering};
+use std::sync::Mutex;
+use std::task::{Context, Poll};
+
+use async_trait::async_trait;
+use bytes::Bytes;
+use wyrd_traits::{CommitOutcome, MetadataStore, Precondition, Result, WriteBatch};
+
+/// A future that yields control to the scheduler **exactly once** before completing.
+///
+/// This is the single scheduler-visible suspension point of a modelled TiKV commit —
+/// the deterministic stand-in for the network round-trip a real `tikv-client` commit
+/// awaits. It depends on nothing but `core::task`, so it yields identically under
+/// madsim (giving the deterministic scheduler an interleaving point) and under any
+/// other executor, and it compiles in the ordinary non-`madsim` build too.
+pub struct YieldOnce {
+    yielded: bool,
+}
+
+impl Future for YieldOnce {
+    type Output = ();
+
+    fn poll(mut self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<()> {
+        if self.yielded {
+            Poll::Ready(())
+        } else {
+            self.yielded = true;
+            // Re-schedule ourselves so the executor parks us and is free to run any
+            // other ready task first — this is the interleaving point redb never has.
+            cx.waker().wake_by_ref();
+            Poll::Pending
+        }
+    }
+}
+
+/// Model one TiKV commit's network round-trip: a single scheduler-visible `await`
+/// between prewrite and commit, at which madsim may interleave another writer.
+#[must_use]
+pub fn network_round_trip() -> YieldOnce {
+    YieldOnce { yielded: false }
+}
+
+/// Whether every precondition in `batch` holds against the key/value map `kv` — the
+/// **pure** commit-point compare-and-set decision, factored out so it is unit-testable
+/// with no async runtime (and reused unchanged by [`SimTikvMetadataStore::commit`]).
+///
+/// A `Some(expected)` precondition requires the key currently equal `expected`; a
+/// `None` (absent) precondition requires the key be absent. This mirrors the redb
+/// backend's in-transaction check (`crates/metadata-redb/src/lib.rs:78-87`) exactly,
+/// so the two backends make the identical CAS decision (ADR-0006).
+#[must_use]
+pub fn preconditions_hold(kv: &HashMap<Vec<u8>, Bytes>, batch: &WriteBatch) -> bool {
+    batch
+        .preconditions
+        .iter()
+        .all(|pc| precondition_holds(kv, pc))
+}
+
+fn precondition_holds(kv: &HashMap<Vec<u8>, Bytes>, pc: &Precondition) -> bool {
+    match &pc.expected {
+        Some(expected) => kv.get(&pc.key).map(Bytes::as_ref) == Some(expected.as_ref()),
+        None => !kv.contains_key(&pc.key),
+    }
+}
+
+/// The committed contents plus the monotonic commit generation.
+#[derive(Default)]
+struct State {
+    kv: HashMap<Vec<u8>, Bytes>,
+    /// Bumped on every applied commit — the store's own logical clock, used both as
+    /// the interleaving oracle and to pin the linearizable-CAS history.
+    generation: u64,
+}
+
+/// A record of one [`SimTikvMetadataStore::commit`] attempt — the audit trail the seed
+/// asserts the trait contract against (so a violation names *which* commit tore).
+#[derive(Debug, Clone)]
+pub struct CommitRecord {
+    /// The store generation observed at prewrite (before the network round-trip).
+    pub base_generation: u64,
+    /// The generation this commit produced, if it committed (`None` on conflict).
+    pub applied_generation: Option<u64>,
+    /// The trait outcome the store returned.
+    pub outcome: CommitOutcome,
+    /// Whether another commit landed between this commit's prewrite and its commit
+    /// point — the positive interleaving oracle (impossible under a synchronous,
+    /// no-`await`-inside commit).
+    pub observed_interleaving: bool,
+}
+
+/// A deterministic in-memory [`MetadataStore`] whose `commit` **awaits between
+/// prewrite and commit**, modelling a TiKV commit's network round-trip so the
+/// deterministic harness reaches interleavings the synchronous redb commit never
+/// exhibits (see the module docs).
+pub struct SimTikvMetadataStore {
+    state: Mutex<State>,
+    interleavings: AtomicU64,
+    commit_log: Mutex<Vec<CommitRecord>>,
+    await_inside_commit: bool,
+}
+
+impl Default for SimTikvMetadataStore {
+    fn default() -> Self {
+        Self::new()
+    }
+}
+
+impl SimTikvMetadataStore {
+    /// The TiKV-shaped backend: `commit` suspends on a modelled network round-trip
+    /// between prewrite and commit, so the scheduler can interleave another writer
+    /// mid-commit.
+    #[must_use]
+    pub fn new() -> Self {
+        Self::with_await_inside_commit(true)
+    }
+
+    /// Construct the backend with the await-inside-commit suspension either **on**
+    /// (`true`, the TiKV-shaped model) or **off** (`false`, the *uncorrected*
+    /// redb-shaped "commit is internally synchronous, no `await` inside" assumption).
+    ///
+    /// The `false` mode exists to make the determinism gap demonstrable in one run:
+    /// with the suspension off, no writer can interleave mid-commit, so
+    /// [`interleavings_observed`](Self::interleavings_observed) stays `0` — which is
+    /// exactly why the seed's materialisation oracle is **red under the uncorrected
+    /// assumption** and green once the TiKV-shaped model (`true`) is exercised.
+    #[must_use]
+    pub fn with_await_inside_commit(await_inside_commit: bool) -> Self {
+        Self {
+            state: Mutex::new(State::default()),
+            interleavings: AtomicU64::new(0),
+            commit_log: Mutex::new(Vec::new()),
+            await_inside_commit,
+        }
+    }
+
+    /// How many commits observed another commit land between their prewrite and their
+    /// commit point — the positive interleaving oracle. `>= 1` proves the
+    /// await-inside-commit interleaving materialised; `0` means it did not (the
+    /// synchronous-commit case).
+    #[must_use]
+    pub fn interleavings_observed(&self) -> u64 {
+        self.interleavings.load(Ordering::SeqCst)
+    }
+
+    /// The per-commit audit trail, in commit-point order.
+    #[must_use]
+    pub fn commit_log(&self) -> Vec<CommitRecord> {
+        self.commit_log.lock().expect("commit log poisoned").clone()
+    }
+}
+
+#[async_trait]
+impl MetadataStore for SimTikvMetadataStore {
+    async fn get(&self, key: &[u8]) -> Result<Option<Bytes>> {
+        let state = self.state.lock().expect("state poisoned");
+        Ok(state.kv.get(key).cloned())
+    }
+
+    async fn scan(&self, prefix: &[u8]) -> Result<Vec<(Vec<u8>, Bytes)>> {
+        let state = self.state.lock().expect("state poisoned");
+        Ok(state
+            .kv
+            .iter()
+            .filter(|(k, _)| k.starts_with(prefix))
+            .map(|(k, v)| (k.clone(), v.clone()))
+            .collect())
+    }
+
+    async fn commit(&self, batch: WriteBatch) -> Result<CommitOutcome> {
+        // 1. Prewrite: snapshot the generation the commit reads its preconditions
+        //    against. The lock is released immediately — it is NOT held across the
+        //    round-trip, exactly as a networked commit cannot hold a local lock over
+        //    the wire.
+        let base_generation = {
+            let state = self.state.lock().expect("state poisoned");
+            state.generation
+        };
+
+        // 2. A TiKV commit awaits network I/O between prewrite and commit; redb does
+        //    not. This single `await` is the newly-reachable interleaving point — the
+        //    scheduler may run another writer's commit here. Removing it (or the
+        //    `with_await_inside_commit(false)` path) reproduces the uncorrected
+        //    synchronous-commit assumption, under which no interleaving is reachable.
+        if self.await_inside_commit {
+            network_round_trip().await;
+        }
+
+        // 3. Commit point: re-check the preconditions against the CURRENT state (the
+        //    optimistic CAS) and apply atomically. Re-checking here — not at prewrite —
+        //    is what keeps a stale writer from committing a lost update over the
+        //    interleaving; a store that trusted the prewrite check would tear.
+        let mut state = self.state.lock().expect("state poisoned");
+        let observed_interleaving = state.generation != base_generation;
+        if observed_interleaving {
+            self.interleavings.fetch_add(1, Ordering::SeqCst);
+        }
+        let (outcome, applied_generation) = if preconditions_hold(&state.kv, &batch) {
+            for (key, value) in &batch.puts {
+                state.kv.insert(key.clone(), value.clone());
+            }
+            for key in &batch.deletes {
+                state.kv.remove(key);
+            }
+            state.generation += 1;
+            (CommitOutcome::Committed, Some(state.generation))
+        } else {
+            (CommitOutcome::Conflict, None)
+        };
+        self.commit_log
+            .lock()
+            .expect("commit log poisoned")
+            .push(CommitRecord {
+                base_generation,
+                applied_generation,
+                outcome,
+                observed_interleaving,
+            });
+        Ok(outcome)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    //! Pure, runtime-free coverage of the commit-point compare-and-set decision
+    //! ([`preconditions_hold`]) — the load-light unit that the madsim interleaving
+    //! seed drives through the production write path. These run in the ordinary
+    //! `cargo test --workspace` (no `--cfg madsim`, no async runtime).
+    use super::*;
+
+    fn kv(pairs: &[(&[u8], &[u8])]) -> HashMap<Vec<u8>, Bytes> {
+        pairs
+            .iter()
+            .map(|(k, v)| (k.to_vec(), Bytes::copy_from_slice(v)))
+            .collect()
+    }
+
+    #[test]
+    fn require_matches_current_value_holds() {
+        let kv = kv(&[(b"meta:version", b"1")]);
+        let batch = WriteBatch::new().require(b"meta:version".to_vec(), b"1".to_vec());
+        assert!(preconditions_hold(&kv, &batch));
+    }
+
+    #[test]
+    fn require_stale_value_conflicts() {
+        // The lost-update case: the key moved to "2" while a writer still requires "1".
+        let kv = kv(&[(b"meta:version", b"2")]);
+        let batch = WriteBatch::new().require(b"meta:version".to_vec(), b"1".to_vec());
+        assert!(
+            !preconditions_hold(&kv, &batch),
+            "a require() on a stale value must not hold — this is the CAS that rejects \
+             a lost update at the commit point"
+        );
+    }
+
+    #[test]
+    fn require_absent_holds_only_when_absent() {
+        let empty = HashMap::new();
+        let batch = WriteBatch::new().require_absent(b"dirent:0/obj".to_vec());
+        assert!(preconditions_hold(&empty, &batch));
+
+        let present = kv(&[(b"dirent:0/obj", b"x")]);
+        assert!(
+            !preconditions_hold(&present, &batch),
+            "require_absent must fail when the key exists (a name already taken)"
+        );
+    }
+
+    #[test]
+    fn all_preconditions_must_hold() {
+        let kv = kv(&[(b"meta:version", b"1")]);
+        let batch = WriteBatch::new()
+            .require(b"meta:version".to_vec(), b"1".to_vec())
+            .require_absent(b"dirent:0/new".to_vec());
+        assert!(preconditions_hold(&kv, &batch));
+
+        let batch_bad = WriteBatch::new()
+            .require(b"meta:version".to_vec(), b"1".to_vec())
+            .require(b"missing".to_vec(), b"x".to_vec());
+        assert!(
+            !preconditions_hold(&kv, &batch_bad),
+            "one failing precondition fails the whole batch (all-or-nothing)"
+        );
+    }
+}
