+// ── Metadata-cluster (TiKV Raft group) fault seam (M4.6, #257) ────────────────
+//
+// The realism-ladder Tier-1 metadata legs (proposal 0015 §"DST and tests"; ADR-0039)
+// fault a **real** ≥3-replica TiKV Raft group. Two things must be *arithmetically*
+// decidable off-Check, so the deferred legs are Check-time unit-testable (the
+// "deferred ≠ unbuilt" bar) and Invariant B (fault-soundness) is enforced in pure
+// code rather than in a nemesis that might silently no-op:
+//
+//   1. **The fault provably materialised** — a partition is evidence only if the
+//      target actually became unreachable (an *observed* transition), never the
+//      injector's own claim it cut the link (the iter-2/3/4 asymmetric-no-op bug).
+//   2. **The fault is a survivable minority partition** — it must leave the Raft
+//      group with quorum (so the cluster self-heals and the ADR-0015 contract is
+//      asserted *under* a live fault), never partition a majority (the iter-2/3/4
+//      "paused a majority" bug that just takes the store down).
+//
+// Both are pure functions here (no container, no `iptables`), mirroring
+// `xtask::disk_faults` and `SeededNetFaults` — the fault *model* lives in the seam,
+// free of any transport dependency.
+
+/// The observed reachability of a Raft replica, probed **independently** of the fault
+/// injector's own claim it applied the fault (Invariant B). A partition leg reads this
+/// before and after injecting the fault and passes it to [`partition_materialized`].
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum Reachability {
+    /// A health probe to the replica succeeded.
+    Reachable,
+    /// A health probe to the replica failed — it is cut off.
+    Unreachable,
+}
+
+/// Did an intended partition/pause fault **provably materialise**? True iff the target
+/// was reachable *before* the fault and unreachable *after* — an observed state
+/// transition, not the injector's assertion. A fault that leaves the target reachable
+/// (an asymmetric no-op partition, a leaked-but-ineffective `iptables` rule) did NOT
+/// materialise, so the leg carrying it must go **red** (Invariant B; the iter-2/3/4
+/// regression this guards). A target already unreachable before the fault also fails —
+/// the fault cannot be credited for a state it did not cause.
+#[must_use]
+pub fn partition_materialized(before: Reachability, after: Reachability) -> bool {
+    before == Reachability::Reachable && after == Reachability::Unreachable
+}
+
+/// A **minority-partition plan** for an `replicas`-node TiKV Raft group: how many
+/// replicas a fault may cut off while the group keeps quorum (proposal 0015 §"DST and
+/// tests"; ADR-0015 clause 2, single-zone). Pure arithmetic, so the deferred Tier-1
+/// consistency leg's fault shape is validated inside `cargo xtask ci`.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct MetadataQuorumPlan {
+    /// The Raft group size (replica count).
+    pub replicas: usize,
+    /// How many replicas this plan partitions away.
+    pub partitioned: usize,
+}
+
+impl MetadataQuorumPlan {
+    /// The quorum (strict majority) an `replicas`-node Raft group needs to make progress.
+    #[must_use]
+    pub fn quorum(replicas: usize) -> usize {
+        replicas / 2 + 1
+    }
+
+    /// The largest minority that can be partitioned while the survivors still hold
+    /// quorum — `replicas - quorum(replicas)`.
+    #[must_use]
+    pub fn max_faultable(replicas: usize) -> usize {
+        replicas.saturating_sub(Self::quorum(replicas))
+    }
+
+    /// Do the **surviving** replicas still form a strict majority (so the group makes
+    /// progress and self-heals across the fault)?
+    #[must_use]
+    pub fn retains_quorum(&self) -> bool {
+        let alive = self.replicas.saturating_sub(self.partitioned);
+        alive * 2 > self.replicas
+    }
+
+    /// Is the fault **effective** — does it partition at least one replica? A zero-node
+    /// partition is a no-op that cannot be evidence (Invariant B).
+    #[must_use]
+    pub fn is_effective(&self) -> bool {
+        self.partitioned >= 1
+    }
+
+    /// Is this a **valid minority-partition fault**: a ≥3-replica group, at least one
+    /// replica cut off, and quorum retained by the survivors? This is the whole
+    /// Invariant-B shape the deferred consistency leg must inject — a majority partition
+    /// (takes the store down) and a zero-node partition (no-op) both fail it.
+    #[must_use]
+    pub fn is_valid_minority_fault(&self) -> bool {
+        self.replicas >= 3 && self.is_effective() && self.retains_quorum()
+    }
+}
+
