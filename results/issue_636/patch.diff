+            &upload_id,
+            3,
+            NOW,
+            LEASE_TTL,
+            "wall",
+            None,
+            &mut tokens,
+            &budget,
+        )
+        .await
+        .unwrap()
+        {
+            mpu::ReserveOutcome::Reserved(part) => *part,
+            other => panic!("reserve refused: {other:?}"),
+        };
+        // The caller saw an unknown outcome and re-drives with the SAME attempt id.
+        let again = match mpu::reserve_slot(
+            &meta,
+            &upload_id,
+            3,
+            NOW + 1,
+            LEASE_TTL,
+            "wall",
+            Some(&first.attempt_id),
+            &mut tokens,
+            &budget,
+        )
+        .await
+        .unwrap()
+        {
+            mpu::ReserveOutcome::Reserved(part) => *part,
+            other => panic!("re-drive refused: {other:?}"),
+        };
+        assert_eq!(
+            again.slot_index, first.slot_index,
+            "the re-drive must adopt its own slot, not claim another"
+        );
+        assert_eq!(again.attempt_id, first.attempt_id);
+        assert_eq!(
+            meta.keys_with(&mpu::slot_range(&upload_id)).len(),
+            1,
+            "exactly one slot key exists; a second would be leaked until teardown"
+        );
+    });
+}
+
+/// **An indeterminate slot reserve keeps the attempt id it minted** (X68).
+///
+/// The tokens are minted *inside* `reserve_slot`, so a caller that saw a bare
+/// `CommitUnknownResult` could only retry by minting a fresh one — and a fresh attempt claims a
+/// second index while the first batch lands on the old one, leaking one of `MAX_INFLIGHT_PARTS`
+/// per retry. Both halves are asserted: the error carries the identity a re-drive must present,
+/// and the end-to-end verb re-drives with it and ends up holding exactly one slot.
+#[test]
+fn an_indeterminate_slot_reserve_keeps_its_attempt_id() {
+    pollster::block_on(async {
+        let meta = MemMeta::default();
+        let fleet = MemFleet::default();
+        create_bucket(&meta).await;
+        let mut tokens = tokens_from(0x51D0);
+        let mut ids = ids_from(0x51D0);
+        let budget = Budget::deployed();
+        let upload_id = create(&meta, &mut tokens, &budget).await;
+
+        // (a) The batch did NOT land: the error names the attempt to re-drive with.
+        meta.unknown_result_on_next_commit(1, false);
+        let err = mpu::reserve_slot(
+            &meta,
+            &upload_id,
+            1,
+            NOW,
+            LEASE_TTL,
+            "wall",
+            None,
+            &mut tokens,
+            &budget,
+        )
+        .await
+        .expect_err("an unknown result is not a reserve");
+        let indeterminate = err
+            .downcast_ref::<mpu::IndeterminateCommit>()
+            .expect("the identity to re-drive with must reach the caller");
+        let attempt = indeterminate
+            .attempt_id()
+            .expect("a slot reserve names its attempt")
+            .to_string();
+        assert_eq!(
+            wyrd_traits::classify(err.as_ref()),
+            wyrd_traits::ErrorClass::Indeterminate,
+            "wrapping the store error must not re-class it as terminal",
+        );
+        assert!(
+            meta.keys_with(&mpu::slot_range(&upload_id)).is_empty(),
+            "nothing landed in this arm"
+        );
+
+        // …and the re-drive with that identity reserves exactly one slot.
+        match mpu::reserve_slot(
+            &meta,
+            &upload_id,
+            1,
+            NOW + 1,
+            LEASE_TTL,
+            "wall",
+            Some(&attempt),
+            &mut tokens,
+            &budget,
+        )
+        .await
+        .unwrap()
+        {
+            mpu::ReserveOutcome::Reserved(part) => assert_eq!(part.attempt_id, attempt),
+            other => panic!("re-drive refused: {other:?}"),
+        }
+        assert_eq!(meta.keys_with(&mpu::slot_range(&upload_id)).len(), 1);
+        meta.remove_keys(&meta.keys_with(&mpu::slot_range(&upload_id)));
+
+        // (b) End to end: the batch DID land under an unknown result. `upload_part` re-drives
+        // with its own attempt id, adopts the landed slot, and finishes with one slot consumed
+        // and none leaked.
+        meta.unknown_result_on_next_commit(1, true);
+        let outcome = put_part(
+            &meta,
+            &fleet,
+            &upload_id,
+            2,
+            &[7u8; 512],
+            &mut tokens,
+            &mut ids,
+            &budget,
+        )
+        .await;
+        assert!(
+            matches!(outcome, UploadPartOutcome::Committed { .. }),
+            "the re-drive adopts its own landed slot: {outcome:?}"
+        );
+        assert!(
+            meta.keys_with(&mpu::slot_range(&upload_id)).is_empty(),
+            "the part commit released the one slot it held, and no second was claimed"
+        );
+        assert_no_classification_gap(&meta, &fleet, NOW).await;
+    });
+}
