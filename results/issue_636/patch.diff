+/// **A stale `orphan:` mark on a fragment a LATER unreference event removes is re-stamped**
+/// (`0016:1160-1172`, the three-arm guard's second arm).
+///
+/// The population is 0016's own: an old custodian's restore pass marks fragments that are in fact
+/// live staged bytes, and those marks survive the upgrade that stops new ones. Such a mark can be
+/// arbitrarily old. If the drain treats "present" as "already evidenced" and keeps the ancient
+/// stamp, then the moment a supersede removes the last reference GC sees an unreferenced fragment
+/// whose grace elapsed long ago and reclaims it on its very next pass — giving a GET that
+/// overlapped the deletion **no** grace window at all, which is the one thing `G_orphan` exists
+/// to provide.
+#[test]
+fn a_stale_orphan_mark_is_restamped_by_the_event_that_unreferences_it() {
+    pollster::block_on(async {
+        let meta = MemMeta::default();
+        let fleet = MemFleet::default();
+        create_bucket(&meta).await;
+        let mut ids = ids_from(0xD000);
+        let prior = commit_generation(&meta, &fleet, 5, OBJECT, 60, &mut ids).await;
+        let flat = prior.chunk_map.as_flat().unwrap().to_vec();
+        let (marked_chunk, marked_index) = flat
+            .first()
+            .map(|chunk| (chunk.id, chunk.fragments().next().unwrap().0))
+            .unwrap();
+        let dserver = flat[0].fragments().next().unwrap().1;
+
+        // The rollout-skew mark: ancient, and on a fragment that is still referenced.
+        const ANCIENT: u64 = 1;
+        meta.commit(WriteBatch::new().put(
+            metadata::orphan_key(
+                dserver,
+                FragmentId {
+                    chunk: marked_chunk,
+                    index: marked_index,
+                },
+            ),
+            Bytes::from_static(b"1"),
+        ))
+        .await
+        .unwrap();
+
+        // The later unreference event: an ordinary overwrite, drained.
+        let plan = wyrd_core::write::plan_write(b"next", CHUNK, RS, &mut ids).unwrap();
+        wyrd_core::write::intent(&meta, &plan, NOW + LEASE_TTL)
+            .await
+            .unwrap();
+        wyrd_core::write::write_fragments(&fleet, &plan)
+            .await
+            .unwrap();
+        metadata::commit_chunk_map_superseding(
+            &meta,
+            5,
+            &prior,
+            plan.chunk_refs(),
+            plan.size,
+            NOW + 1,
+            &metadata::ObjectMeta::default(),
+        )
+        .await
+        .unwrap();
+        let obligations = meta.keys_with(b"retire:bytes:g:");
+        let mut report = mpu::DrainReport::default();
+        mpu::drain_obligation(&meta, &obligations[0], NOW + 2, &tiny_budget(), &mut report)
+            .await
+            .unwrap();
+
+        let stamp = meta
+            .get(&metadata::orphan_key(
+                dserver,
+                FragmentId {
+                    chunk: marked_chunk,
+                    index: marked_index,
+                },
+            ))
+            .await
+            .unwrap()
+            .map(|bytes| String::from_utf8_lossy(&bytes).parse::<u64>().unwrap())
+            .expect("the mark is still there");
+        assert_eq!(
+            stamp,
+            NOW + 2,
+            "a mark predating the event that removed the reference must be re-stamped with that \
+             event's instant, not left at {ANCIENT}"
+        );
+        // And the fragment is not left in the one combination GC acts on wrongly.
+        let report = mpu::classification_sweep(&meta, &fleet.inventory(), NOW)
+            .await
+            .unwrap();
+        assert!(report.is_sound(), "{report:?}");
+    });
+}
