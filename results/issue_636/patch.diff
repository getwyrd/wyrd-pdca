+    /// authoritative count [`ChunkRef::fragment_count`] gives a committed chunk.
+    pub fn fragment_count(&self) -> u16 {
+        match self.scheme {
+            EcScheme::None => 1,
+            EcScheme::ReedSolomon { k, m } => u16::from(k) + u16::from(m),
