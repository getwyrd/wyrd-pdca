+/// **A drain cursor pointing past the unit it resumes into is an error, not an exhausted unit.**
+///
+/// Treating it as exhausted silently skips every position between the record's true length and
+/// the cursor — unevidenced bytes, with the obligation deleted on top of them once the walk
+/// "finishes". The cursor is a durable field, so this is a decode-adjacent boundary: the check
+/// belongs where the unit's own length is known, which is at the resume.
+#[test]
+fn a_drain_cursor_past_its_unit_is_refused() {
+    pollster::block_on(async {
+        let meta = MemMeta::default();
+        let fleet = MemFleet::default();
+        create_bucket(&meta).await;
+        let mut tokens = tokens_from(0xC025);
+        let mut ids = ids_from(0xC025);
+        let budget = Budget::deployed();
+        let upload_id = create(&meta, &mut tokens, &budget).await;
+        match put_part(
+            &meta,
+            &fleet,
+            &upload_id,
+            1,
+            &[1u8; 512],
+            &mut tokens,
+            &mut ids,
+            &budget,
+        )
+        .await
+        {
+            UploadPartOutcome::Committed { .. } => {}
+            other => panic!("part refused: {other:?}"),
+        }
+        assert!(matches!(
+            mpu::abort(&meta, &upload_id, NOW + 1, "wall")
+                .await
+                .unwrap(),
+            AbortOutcome::Fenced
+        ));
+        let key = meta
+            .keys_with(&mpu::retire_session_range(
+                mpu::RetireMode::Bytes,
+                &upload_id,
+            ))
+            .into_iter()
+            .next()
+            .expect("the abort fence installs retire:bytes:{session}");
+
+        // The part has one chunk; the cursor claims the walk is already past its ninety-ninth.
+        meta.put_raw(
+            key.clone(),
+            metadata::encode(&mpu::RetireObligation {
+                payload: mpu::RetirePayload::Session {},
+                cursor: Some(mpu::RetireCursor {
+                    phase: mpu::DrainPhase::Marking,
+                    outer: 1,
+                    inner: 99,
+                    frag: 0,
+                    arm: 0,
+                }),
+            }),
+        );
+        let mut report = mpu::DrainReport::default();
+        let err = mpu::drain_step(&meta, &key, NOW + 2, &tiny_budget(), &mut report)
+            .await
+            .expect_err("a cursor past its unit cannot be resumed from");
+        assert!(
+            err.to_string().contains("past that unit's own length"),
+            "the fault names itself: {err}"
+        );
+        assert!(
+            !meta.keys_with(&mpu::part_range(&upload_id)).is_empty(),
+            "…and nothing was deleted on the strength of it"
+        );
+    });
+}
