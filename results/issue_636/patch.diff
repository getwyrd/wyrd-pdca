+// ---------------------------------------------------------------------------
+// Leg H — after the terminal delete, nothing is left
+// ---------------------------------------------------------------------------
+
+#[test]
+fn h_terminal_delete_leaves_nothing_and_obeys_the_two_arm_group_rule() {
+    pollster::block_on(async {
+        let meta = MemMeta::default();
+        let fleet = MemFleet::default();
+        let budget = budget_for(4);
+        let mut tokens = tokens_from(0xa0);
+        let mut ids = ids_from(0xa_000);
+        create_bucket(&meta).await;
+        let upload_id = create(&meta, &mut tokens, &budget).await;
+        let nonce = mpu::read_session(&meta, &upload_id)
+            .await
+            .unwrap()
+            .unwrap()
+            .record
+            .group_nonce;
+
+        let body = vec![b'h'; CHUNK * 2 + 11];
+        for number in 1..=3u32 {
+            put_part(
+                &meta,
+                &fleet,
+                &upload_id,
+                number,
+                &body,
+                &mut tokens,
+                &mut ids,
+                &budget,
+            )
+            .await;
+        }
+        // One part that crashed mid-stream: it staged chunks and never committed, so it holds
+        // its slot for ever by design and leaves owned `sidx:` residue. The `Completed`- and
+        // `Aborting`-path walks must both reclaim it (`0016:1775`).
+        let mut crashed = match mpu::reserve_slot(
+            &meta,
+            &upload_id,
+            9,
+            NOW,
+            LEASE_TTL,
+            "wall",
+            None,
+            &mut tokens,
+            &budget,
+        )
+        .await
+        .unwrap()
+        {
+            mpu::ReserveOutcome::Reserved(part) => *part,
+            other => panic!("reserve refused: {other:?}"),
+        };
+        mpu::stage_chunk(
+            &meta,
+            &fleet,
+            &mut crashed,
+            &body[..CHUNK],
+            RS,
+            ids(),
+            &topology(),
+            NOW,
+            LEASE_TTL,
+        )
+        .await
+        .unwrap();
+        let residue: Vec<ChunkId> = crashed.staged.iter().map(|c| c.id).collect();
+        assert_eq!(meta.keys_with(&mpu::sidx_range(&upload_id)).len(), 1);
+
+        assert_eq!(
+            mpu::abort(&meta, &upload_id, NOW + 1, "wall")
+                .await
+                .unwrap(),
+            AbortOutcome::Fenced
+        );
+        let before = count(&meta).await;
+        let report = mpu::teardown_session(&meta, &upload_id, NOW + 2, &tiny_budget())
+            .await
+            .unwrap();
+
+        // Nothing is left.
+        assert!(report.terminal_deleted);
+        assert!(meta.keys_with(&mpu::sidx_range(&upload_id)).is_empty());
+        assert!(meta.keys_with(&mpu::slot_range(&upload_id)).is_empty());
+        assert!(meta.keys_with(&mpu::part_range(&upload_id)).is_empty());
+        assert!(meta.keys_with(&mpu::psum_range(&upload_id)).is_empty());
+        assert!(mpu::read_session(&meta, &upload_id)
+            .await
+            .unwrap()
+            .is_none());
+        assert!(meta
+            .keys_with(&mpu::retire_session_range(
+                mpu::RetireMode::Bytes,
+                &upload_id
+            ))
+            .is_empty());
+        // The decrement happened EXACTLY once.
+        assert_eq!(count(&meta).await, before - 1);
+        // The crashed attempt's residue was evidenced, not silently dropped: its bytes carry
+        // orphan marks so GC — which reclaims only on explicit evidence — will free them.
+        for chunk in &residue {
+            assert!(
+                (0..9u16).all(|index| orphan_present(&meta, *chunk, index)),
+                "a crashed in-flight part's full planned placement must be orphan-marked"
+            );
+        }
+        // The group was never adopted (a flat publish, and this session aborted), so the
+        // terminal delete removed its `seggrp:` marker in the same batch — arm (a) of the
+        // two-arm rule (`0016:513-527`). Otherwise every small upload would leak one key.
+        assert!(
+            meta.keys_with(&metadata::seggrp_key(&nonce)).is_empty(),
+            "an UNADOPTED segment group's marker is deleted with the session"
+        );
+        assert_no_classification_gap(&meta, &fleet, NOW).await;
+
+        // The other arm: a group whose `seg:` range is non-empty is ADOPTED, so the terminal
+        // delete leaves the marker — it outlives the session and belongs to the object.
+        let adopted = create(&meta, &mut tokens, &budget).await;
+        let adopted_nonce = mpu::read_session(&meta, &adopted)
+            .await
+            .unwrap()
+            .unwrap()
+            .record
+            .group_nonce;
+        let group = metadata::SegmentGroup::new(adopted_nonce.clone(), 1).unwrap();
+        let segment = metadata::SegmentRecord::new(
+            vec![metadata::ChunkRef {
+                id: 0xfeed,
+                scheme: EcScheme::None,
+                len: 4,
+                placement: vec![0],
+            }],
+            0,
+        )
+        .unwrap();
+        meta.commit(
+            WriteBatch::new().put(metadata::seg_key(&group, 0), metadata::encode(&segment)),
+        )
+        .await
+        .unwrap();
+        assert_eq!(
+            mpu::abort(&meta, &adopted, NOW + 3, "wall").await.unwrap(),
+            AbortOutcome::Fenced
+        );
+        mpu::teardown_session(&meta, &adopted, NOW + 4, &tiny_budget())
+            .await
+            .unwrap();
+        assert!(mpu::read_session(&meta, &adopted).await.unwrap().is_none());
+        assert!(
+            !meta
+                .keys_with(&metadata::seggrp_key(&adopted_nonce))
+                .is_empty(),
+            "an ADOPTED group's marker outlives the session that reserved it"
+        );
+    });
+}
