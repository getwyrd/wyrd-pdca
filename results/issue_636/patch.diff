+// ---------------------------------------------------------------------------
+// Staged writes — the assembled-write intent (proposal 0016 decision 5, `0016:2692-2709`)
+// ---------------------------------------------------------------------------
+
+/// What a staged intent is authorized by: the session fence and the request's own slot.
+///
+/// Both carry the **exact bytes** they were read as, because those bytes *are* the
+/// authorization — `require(mpu == Open@E)` is what makes it impossible to create owned
+/// residue after the session leaves `Open` (`0016:1540-1543`, the finding-1 serialization
+/// edge closed at creation rather than patched at teardown).
+#[derive(Debug, Clone)]
+pub struct StagedFence<'a> {
+    /// The owning upload id — the `owner` tag the entry carries.
+    pub upload_id: &'a str,
+    /// The part number this chunk belongs to, so a reclaimer can attribute residue to the
+    /// attempt that staged it.
+    pub part_number: u32,
+    /// The session record key.
+    pub session_key: Vec<u8>,
+    /// The session record's exact bytes.
+    pub session_bytes: Bytes,
+    /// This request's slot key.
+    pub slot_key: Vec<u8>,
+    /// Its slot record's exact bytes.
+    pub slot_bytes: Bytes,
+}
+
+/// What [`stage_intent`] answered.
+#[derive(Debug, Clone)]
+pub enum StageOutcome {
+    /// The chunk is staged: its owned `sidx:` entry is durable and its fragments are written.
+    Staged {
+        /// The staged chunk, with the placement its fragments actually landed on.
+        chunk: ChunkRef,
+        /// The rewritten slot bytes, for the next batch's `require(slot == prior)`.
+        slot_bytes: Bytes,
+    },
+    /// The fence was lost and re-planning could not recover it: the session left `Open@E`,
+    /// the slot moved, or the fleet offers no admissible server. **Nothing was written** —
+    /// the intent precedes the bytes, so a refused intent leaves no fragment behind.
+    Refused,
+}
+
+/// How many times a staged intent re-plans around a **drain fence** loss before refusing.
+///
+/// A loss means a server this placement named started draining between the topology read and
+/// the commit, so the remedy is a fresh selection against the fresh draining set, not a
+/// refusal (`0016:851-857`). The bound exists because an operator draining servers faster
+/// than the write path can re-plan is a fleet with no admissible server, which must refuse
+/// the part rather than stage onto a drain.
+const MAX_STAGE_REPLANS: usize = 4;
+
+/// Read the desired-state ledger's draining set — the servers staged placement must select
+/// **against** ([`Topology::excluding`], `0016:831-835`).
+async fn draining_servers(
+    meta: &impl MetadataStore,
+) -> Result<std::collections::BTreeSet<DServerId>> {
+    let mut draining = std::collections::BTreeSet::new();
+    for (key, _) in meta.scan(metadata::DESIRED_DSERVER_PREFIX).await? {
+        // **A key this pass cannot read is an error, not a server it may ignore.** The drain
+        // fence's whole job is to make the *filtered* set complete: a malformed
+        // `desired:dserver:` record that is silently skipped removes that server from the
+        // selector's exclusion set and from the per-server `require_absent` preconditions at
+        // once, so a staged intent could land on a server whose drain was recorded — and
+        // `reconciliation_status(S)` would then answer `Satisfied` while the fragments are
+        // being written (`0016:837-857`). Failing closed refuses the part instead
+        // (`AGENTS.md:175-177`).
+        let id = std::str::from_utf8(&key)
+            .ok()
+            .and_then(|text| text.strip_prefix("desired:dserver:"))
+            .and_then(|id| id.parse::<DServerId>().ok())
+            .ok_or_else(|| crate::multipart::RecordError::MalformedKey {
+                namespace: "desired:dserver:",
+                key: String::from_utf8_lossy(&key).into_owned(),
+            })?;
+        draining.insert(id);
+    }
+    Ok(draining)
+}
+
+/// Stage one chunk of an assembled write: register its **owned** `sidx:` entry, then write
+/// its fragments (`0016:2692-2709`).
+///
+/// This is [`intent`] for a write whose staging outlives the request, and it differs in four
+/// ways, each load-bearing:
+///
+/// 1. the entry lives under `sidx:<upload-id>:<part>:<chunk>`, a prefix **disjoint from
+///    `pending:`**, so no global `scan("pending:")` — the restore pass's `pending_chunks` or
+///    the expiry sweep — ever enumerates it (`0016:1529-1536`). The fleet-wide owned
+///    population can exceed what one scan holds, so keeping it out of `pending:` is what
+///    preserves restore's existing bound;
+/// 2. the value carries `owner` **and** `staged` — the chunk's planned EC placement — so a
+///    record-only reclaimer can compute the `orphan:<dserver>:<chunk>:<index>` keys for every
+///    position the fragments *could* land on, and drain can count them as held on a specific
+///    server (`0016:459-473`);
+/// 3. the batch is fenced `require(mpu == Open@E)` **and** rewrites the request's own
+///    `slot:` record, so creating liveness evidence and advertising it are one commit
+///    (X83/X74);
+/// 4. it carries `require_absent(desired:dserver:<S>)` for **every** server in the placement
+///    it installs — the **drain fence**. Filtering the selector is not enough on its own: a
+///    drain recorded between the topology read and this commit would escape the filter
+///    entirely, `reconciliation_status(S)` would find no staging record naming `S` and answer
+///    `Satisfied`, and the operator could wipe `S` before the intent landed
+///    (`0016:837-857`). With the keyed precondition there are only two outcomes — the intent
+///    lands first, so the staged set counts those fragments as held; or the drain lands
+///    first, so this batch fails and re-plans.
+///
+/// **Intent precedes the bytes**: the entry is durable before any fragment reaches a D
+/// server, so no staged byte can exist without a record naming it.
+#[allow(clippy::too_many_arguments)]
+pub async fn stage_intent(
+    meta: &impl MetadataStore,
+    chunks: &impl PlacementChunkStore,
+    fence: &StagedFence<'_>,
+    piece: &[u8],
+    scheme: EcScheme,
+    id: ChunkId,
+    topology: &Topology,
+    lease_expiry_millis: u64,
+) -> Result<StageOutcome> {
+    let fragments = encode_chunk(scheme, id, piece)?;
+    let n = fragments.len() as u16;
+
+    for _ in 0..MAX_STAGE_REPLANS {
+        let draining = draining_servers(meta).await?;
+        let admissible = topology.excluding(&draining);
+        let placement = match select_distinct_domains(&admissible, n) {
+            Ok(placement) => placement,
+            // A fleet with no admissible server refuses the part rather than staging onto a
+            // drain (`0016:855-857`).
+            Err(_) => return Ok(StageOutcome::Refused),
+        };
+
+        let entry = PendingEntry::owned(
+            fence.upload_id,
+            lease_expiry_millis,
+            metadata::StagedPlacement {
+                scheme,
+                placement: placement.clone(),
+            },
+        );
+        // The slot rewrite is the liveness witness the reap fence pins: a fresh live lease
+        // created without touching the slot would let the fence abort a progressing part
+        // (X83).
+        let mut slot: crate::multipart::SlotRecord = metadata::decode(&fence.slot_bytes)?;
+        slot.lease_expiry_millis = lease_expiry_millis;
+        let slot_bytes = metadata::encode(&slot);
+
+        let mut batch = WriteBatch::new()
+            .require(fence.session_key.clone(), fence.session_bytes.clone())
+            .require(fence.slot_key.clone(), fence.slot_bytes.clone());
+        for dserver in &placement {
+            batch = batch.require_absent(metadata::desired_dserver_key(*dserver));
+        }
+        batch = batch
+            .put(
+                crate::multipart::sidx_key(fence.upload_id, fence.part_number, id),
+                metadata::encode(&entry),
+            )
+            .put(fence.slot_key.clone(), slot_bytes.clone());
+
+        match meta.commit(batch).await? {
+            CommitOutcome::Committed => {
+                let puts = fragments.iter().map(|(index, fragment)| {
+                    let frag_id = FragmentId {
+                        chunk: id,
+                        index: *index,
+                    };
+                    let dserver = placement
+                        .get(*index as usize)
+                        .copied()
+                        .unwrap_or_else(|| DServerId::from(*index));
+                    chunks.put_fragment_at(dserver, frag_id, fragment.clone())
+                });
+                futures_util::future::try_join_all(puts).await?;
+                return Ok(StageOutcome::Staged {
+                    chunk: ChunkRef {
+                        id,
+                        scheme,
+                        len: piece.len() as u64,
+                        placement,
+                    },
+                    slot_bytes,
+                });
+            }
+            CommitOutcome::Conflict => {
+                // Re-read to classify (`traits/src/lib.rs:738-745`): a drain recorded against
+                // a server this placement named is a **re-plan**, anything else (the session
+                // left `Open@E`, or the slot moved) is a refusal this call cannot recover.
+                let fresh = draining_servers(meta).await?;
+                if placement.iter().any(|dserver| fresh.contains(dserver)) {
+                    continue;
+                }
+                return Ok(StageOutcome::Refused);
+            }
+        }
+    }
+    Ok(StageOutcome::Refused)
+}
