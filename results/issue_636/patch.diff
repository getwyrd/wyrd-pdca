+/// Fence a session into `Completing` the way Complete does — through the production fence,
+/// then abandon it, which is exactly the "completer crashed" state.
+async fn fence_into_completing(meta: &MemMeta, upload_id: &str, now: u64) {
+    let session = mpu::read_session(meta, upload_id).await.unwrap().unwrap();
+    let mut record = session.record.clone();
+    record.state = SessionState::Completing;
+    record.epoch += 1;
+    record.attempts += 1;
+    record.fenced_at_millis = Some(now);
+    record.segments_written = Some(0);
+    record.publish_target = Some(mpu::PublishTarget {
+        parent: record.parent,
+        name: record.object.clone(),
+        fence_epoch: record.epoch,
+    });
+    let outcome = meta
+        .commit(
+            session
+                .fence(WriteBatch::new())
+                .put(session.key(), metadata::encode(&record)),
+        )
+        .await
+        .unwrap();
+    assert_eq!(outcome, CommitOutcome::Committed);
+}
