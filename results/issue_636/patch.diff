--- /dev/null
+++ b/crates/core/tests/multipart_admission_and_drain.rs
@@ -0,0 +1,975 @@
+//! The two failure modes rejected attempts actually shipped, as regressions (issue #636,
+//! proposal 0016). Their own test binary so a `tracing` callsite-cache interaction in the
+//! protocol suite cannot mask them (the #214 discipline).
+//!
+//! * **Leg F — concurrent creates on an empty store all succeed.** A previous attempt answered
+//!   a false `503 SlowDown` to `CreateMultipartUpload` at *ordinary client concurrency*
+//!   (aws-cli's default `max_concurrent_requests` is 10) because **one** retry budget served
+//!   both the 2^-128 upload-id collision and the **globally serialized** admission CAS: the
+//!   k-th concurrent creator then needed O(k) attempts. Measured then: 8 creators → 2 refused,
+//!   10 → 3, 16 → 3, with the ledger nowhere near its bound. Asserted here at **8, 10 and
+//!   16** — not one number — and never on "all succeed" alone, which an implementation that
+//!   answered success without landing a session would also pass: the ids must be **pairwise
+//!   distinct**, **N `mpu:` records** must exist, and `mpuctl.count` must be **exactly N**.
+//!
+//! * **Leg G — the drain converges past the real boundary, and is idempotent.** One attempt
+//!   re-derived the same first `B_ops` keys for ever with no cursor (it never converged); a
+//!   later one truncated derivation while marking the obligation **fully drained**, which is
+//!   silent permanent part loss. So a Complete naming **4,001 parts** — straddling `B_ops`,
+//!   not sitting below it — must drain to empty in **byte-budgeted** batches, and **both**
+//!   halves are asserted: the walk terminates, *and* every named record is actually gone.
+//!   Running the drain twice over a partially drained obligation converges to the same
+//!   terminal state with **no double-decrement** of `mpuctl.count`.
+
+#![forbid(unsafe_code)]
+
+use std::collections::{BTreeSet, HashMap};
+use std::sync::Mutex;
+use std::task::Poll;
+
+use async_trait::async_trait;
+use bytes::Bytes;
+use sha2::{Digest, Sha256};
+use wyrd_core::metadata::{self, EcScheme};
+use wyrd_core::multipart::{
+    self as mpu, AbortOutcome, Backpressure, Budget, CompleteOutcome, CompleteParams,
+    CreateOutcome, CreateParams, CreateRetry, DrainBudget, Refusal, SessionState,
+    UploadPartOutcome,
+};
+use wyrd_core::placement::Topology;
+use wyrd_traits::{
+    ChunkId, ChunkStore, CommitOutcome, DServerId, FragmentId, Health, MetadataStore, Result,
+    WriteBatch,
+};
+
+// ---------------------------------------------------------------------------
+// A store that YIELDS, so single-task concurrency is genuinely interleaved
+// ---------------------------------------------------------------------------
+
+/// Yield to the executor exactly once.
+///
+/// This is what makes leg F a real contention test rather than a sequential one. An in-memory
+/// store whose operations are immediately `Ready` lets `join_all` run each creator to
+/// completion before starting the next, so **no** creator would ever lose the admission CAS
+/// and the defect under test would be unreachable. Yielding inside `get` and `commit` puts
+/// every creator's read before every creator's commit — the worst case, and precisely the
+/// schedule that made the k-th creator need O(k) attempts.
+async fn yield_once() {
+    let mut yielded = false;
+    std::future::poll_fn(move |cx| {
+        if yielded {
+            Poll::Ready(())
+        } else {
+            yielded = true;
+            cx.waker().wake_by_ref();
+            Poll::Pending
+        }
+    })
+    .await
+}
+
+#[derive(Default)]
+struct MemMeta {
+    kv: Mutex<HashMap<Vec<u8>, Bytes>>,
+    /// Whether store operations yield to the executor (leg F) or complete immediately (leg G,
+    /// where 4,001 sequential parts would otherwise pay a scheduler round trip each).
+    interleave: bool,
+    commits: Mutex<usize>,
+    /// Rows **returned** by `scan_page` — the seam's own cost, which is what a page bound is
+    /// about (a real backend transfers them).
+    scanned_rows: Mutex<usize>,
+    /// How many further commits answer [`wyrd_traits::CommitUnknownResult`], and whether they
+    /// nevertheless **apply**.
+    unknown: Mutex<Option<(usize, bool)>>,
+}
+
+impl MemMeta {
+    fn interleaving() -> Self {
+        Self {
+            interleave: true,
+            ..Self::default()
+        }
+    }
+
+    fn scanned_rows(&self) -> usize {
+        *self.scanned_rows.lock().unwrap()
+    }
+
+    /// Answer [`wyrd_traits::CommitUnknownResult`] for the next `count` commits — applying them
+    /// or not, as `applies` says. The caller cannot tell which happened and must re-read
+    /// (`traits/src/lib.rs:211-213`).
+    fn unknown_result_on_next_commit(&self, count: usize, applies: bool) {
+        *self.unknown.lock().unwrap() = Some((count, applies));
+    }
+
+    fn keys_with(&self, prefix: &[u8]) -> Vec<Vec<u8>> {
+        let mut keys: Vec<Vec<u8>> = self
+            .kv
+            .lock()
+            .unwrap()
+            .keys()
+            .filter(|k| k.starts_with(prefix))
+            .cloned()
+            .collect();
+        keys.sort();
+        keys
+    }
+
+    fn commits(&self) -> usize {
+        *self.commits.lock().unwrap()
+    }
+}
+
+#[async_trait]
+impl MetadataStore for MemMeta {
+    async fn get(&self, key: &[u8]) -> Result<Option<Bytes>> {
+        if self.interleave {
+            yield_once().await;
+        }
+        Ok(self.kv.lock().unwrap().get(key).cloned())
+    }
+
+    async fn scan(&self, prefix: &[u8]) -> Result<Vec<(Vec<u8>, Bytes)>> {
+        if self.interleave {
+            yield_once().await;
+        }
+        let mut rows: Vec<(Vec<u8>, Bytes)> = self
+            .kv
+            .lock()
+            .unwrap()
+            .iter()
+            .filter(|(k, _)| k.starts_with(prefix))
+            .map(|(k, v)| (k.clone(), v.clone()))
+            .collect();
+        rows.sort_by(|a, b| a.0.cmp(&b.0));
+        Ok(rows)
+    }
+
+    async fn scan_page(
+        &self,
+        prefix: &[u8],
+        after: Option<&[u8]>,
+        limit: usize,
+    ) -> Result<wyrd_traits::ScanPage> {
+        let page = wyrd_testkit::test_double_scan_page(self, prefix, after, limit).await?;
+        *self.scanned_rows.lock().unwrap() += page.0.len();
+        Ok(page)
+    }
+
+    async fn commit(&self, batch: WriteBatch) -> Result<CommitOutcome> {
+        // The yield is BEFORE the apply, so every concurrent creator's read happens before any
+        // creator's write lands — the schedule the defect needs.
+        if self.interleave {
+            yield_once().await;
+        }
+        let mut kv = self.kv.lock().unwrap();
+        *self.commits.lock().unwrap() += 1;
+        let unknown = {
+            let mut slot = self.unknown.lock().unwrap();
+            match slot.as_mut() {
+                Some((remaining, applies)) if *remaining > 0 => {
+                    *remaining -= 1;
+                    Some(*applies)
+                }
+                _ => None,
+            }
+        };
+        for pre in &batch.preconditions {
+            if kv.get(&pre.key).cloned() != pre.expected {
+                return Ok(CommitOutcome::Conflict);
+            }
+        }
+        if let Some(applies) = unknown {
+            if applies {
+                for (k, v) in batch.puts {
+                    kv.insert(k, v);
+                }
+                for k in batch.deletes {
+                    kv.remove(&k);
+                }
+            }
+            return Err(wyrd_traits::CommitUnknownResult {
+                backend: "memmeta",
+                code: None,
+                detail: "injected".into(),
+                may_still_commit: true,
+            }
+            .into());
+        }
+        for (k, v) in batch.puts {
+            kv.insert(k, v);
+        }
+        for k in batch.deletes {
+            kv.remove(&k);
+        }
+        Ok(CommitOutcome::Committed)
+    }
+}
+
+/// A single-authority fragment store: leg F writes no fragments and leg G writes one per chunk,
+/// so the fleet only has to be honest, not placement-rich.
+#[derive(Default)]
+struct MemFleet {
+    frags: Mutex<HashMap<(DServerId, ChunkId, u16), Bytes>>,
+}
+
+#[async_trait]
+impl ChunkStore for MemFleet {
+    async fn put_fragment(&self, id: FragmentId, fragment: Bytes) -> Result<()> {
+        self.frags
+            .lock()
+            .unwrap()
+            .insert((0, id.chunk, id.index), fragment);
+        Ok(())
+    }
+
+    async fn get_fragment(&self, id: FragmentId) -> Result<Option<Bytes>> {
+        Ok(self
+            .frags
+            .lock()
+            .unwrap()
+            .iter()
+            .find(|((_, chunk, index), _)| (*chunk, *index) == (id.chunk, id.index))
+            .map(|(_, bytes)| bytes.clone()))
+    }
+
+    async fn list_fragments(&self) -> Result<Vec<FragmentId>> {
+        Ok(self
+            .frags
+            .lock()
+            .unwrap()
+            .keys()
+            .map(|(_, chunk, index)| FragmentId {
+                chunk: *chunk,
+                index: *index,
+            })
+            .collect())
+    }
+
+    async fn delete_fragment(&self, id: FragmentId) -> Result<()> {
+        self.frags
+            .lock()
+            .unwrap()
+            .retain(|(_, chunk, index), _| (*chunk, *index) != (id.chunk, id.index));
+        Ok(())
+    }
+
+    async fn health(&self) -> Result<Health> {
+        Ok(Health::Healthy)
+    }
+}
+
+#[async_trait]
+impl wyrd_traits::PlacementChunkStore for MemFleet {
+    async fn get_fragment_at(&self, dserver: DServerId, id: FragmentId) -> Result<Option<Bytes>> {
+        Ok(self
+            .frags
+            .lock()
+            .unwrap()
+            .get(&(dserver, id.chunk, id.index))
+            .cloned())
+    }
+
+    async fn put_fragment_at(
+        &self,
+        dserver: DServerId,
+        id: FragmentId,
+        fragment: Bytes,
+    ) -> Result<()> {
+        self.frags
+            .lock()
+            .unwrap()
+            .insert((dserver, id.chunk, id.index), fragment);
+        Ok(())
+    }
+}
