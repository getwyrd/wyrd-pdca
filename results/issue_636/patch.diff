+// ---------------------------------------------------------------------------
+// Leg D — the disjoint owned staging class, observed WHILE the part is in flight
+// ---------------------------------------------------------------------------
+
+#[test]
+fn d_staging_is_the_disjoint_owned_class_observed_mid_flight() {
+    pollster::block_on(async {
+        let meta = MemMeta::default();
+        let fleet = MemFleet::default();
+        let budget = Budget::deployed();
+        let mut tokens = tokens_from(0x80);
+        let mut ids = ids_from(0x8_000);
+        create_bucket(&meta).await;
+        let upload_id = create(&meta, &mut tokens, &budget).await;
+
+        // Drive the part path by hand so there is a real MID-STAGE checkpoint: a post-hoc scan
+        // alone proves nothing, because an implementation that staged under `pending:` and
+        // deleted it during the commit would pass it — while re-entering the global `pending:`
+        // scans and the #557 cross-clock expiry semantics for the whole life of the upload
+        // (`0016:480-490`).
+        let mut part = match mpu::reserve_slot(
+            &meta,
+            &upload_id,
+            1,
+            NOW,
+            LEASE_TTL,
+            "wall",
+            None,
+            &mut tokens,
+            &budget,
+        )
+        .await
+        .unwrap()
+        {
+            mpu::ReserveOutcome::Reserved(part) => *part,
+            other => panic!("reserve refused: {other:?}"),
+        };
+        assert_eq!(
+            meta.keys_with(&mpu::slot_range(&upload_id)).len(),
+            1,
+            "the slot is claimed BEFORE the first chunk streams"
+        );
+
+        let body = vec![b'd'; CHUNK * 2 + 3];
+        let pieces: Vec<&[u8]> = body.chunks(CHUNK).collect();
+        for piece in &pieces {
+            let outcome = mpu::stage_chunk(
+                &meta,
+                &fleet,
+                &mut part,
+                piece,
+                RS,
+                ids(),
+                &topology(),
+                NOW,
+                LEASE_TTL,
+            )
+            .await
+            .unwrap();
+            assert_eq!(outcome, CommitOutcome::Committed);
+        }
+
+        // THE CHECKPOINT, with the part still in flight.
+        let owned = meta.keys_with(&mpu::sidx_range(&upload_id));
+        assert_eq!(
+            owned.len(),
+            pieces.len(),
+            "every in-flight chunk must have an owned `sidx:` entry"
+        );
+        assert!(
+            meta.keys_with(b"pending:").is_empty(),
+            "an owned staging entry must NEVER live under `pending:` — the global scans \
+             (restore's `pending_chunks`, the expiry sweep) must not enumerate it"
+        );
+        // The entry carries `owner` AND the chunk's planned placement, which is what lets a
+        // record-only reclaimer compute the `orphan:` keys (`0016:459-473`).
+        for key in &owned {
+            let value = meta.get(key).await.unwrap().unwrap();
+            let entry: PendingEntry = metadata::decode(&value).unwrap();
+            assert_eq!(entry.owner.as_deref(), Some(upload_id.as_str()));
+            let staged = entry.staged.expect("an owned entry carries its placement");
+            assert_eq!(staged.placement.len(), 9);
+            assert_eq!(
+                staged.placement.iter().collect::<BTreeSet<_>>().len(),
+                9,
+                "placement spans nine distinct D servers"
+            );
+        }
+        // The classification invariant holds MID-HANDOFF too, not only at rest.
+        assert_no_classification_gap(&meta, &fleet, NOW).await;
+
+        // After the commit: no `sidx:` entry and no `slot:` record remains for that part.
+        let outcome = mpu::commit_part(&meta, &mut part, &body, NOW + 1, "wall")
+            .await
+            .unwrap();
+        assert!(matches!(outcome, UploadPartOutcome::Committed { .. }));
+        assert!(
+            meta.keys_with(&mpu::sidx_range(&upload_id)).is_empty(),
+            "the part commit replaces every owned entry with the `part:` record, in one batch"
+        );
+        assert!(
+            meta.keys_with(&mpu::slot_range(&upload_id)).is_empty(),
+            "the commit releases its own slot by a keyed delete in the same batch"
+        );
+        assert!(!meta.keys_with(&mpu::part_key(&upload_id, 1)).is_empty());
+        assert!(
+            !meta.keys_with(&mpu::psum_key(&upload_id, 1)).is_empty(),
+            "the `psum:` summary is written in the SAME batch as the `part:` record"
+        );
+        assert_no_classification_gap(&meta, &fleet, NOW).await;
+    });
+}
