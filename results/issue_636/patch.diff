+/// Key for one **owned staging entry**: `sidx:<upload-id>:<part-number>:<chunk-id>`.
+///
+/// The `<part-number>` component is what lets a reclaimer attribute residue to the part
+/// attempt that staged it (`0016:353`).
+pub fn sidx_key(upload_id: &str, part_number: u32, chunk: ChunkId) -> Vec<u8> {
+    format!(
+        "sidx:{upload_id}:{part_number:0width$}:{chunk}",
+        width = PART_NUMBER_WIDTH
