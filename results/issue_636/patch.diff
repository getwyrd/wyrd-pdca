+// ---------------------------------------------------------------------------
+// Leg E — admission is exact and bounded, and a `Completed` tombstone STAYS COUNTED
+// ---------------------------------------------------------------------------
+
+/// A budget whose derived `MAX_SESSIONS` is small enough to reach in a test — **derived**, by
+/// shrinking `W_ref`, never by overriding the limit (a hard-coded `MAX_SESSIONS` is a defect,
+/// not a value choice, `0016:2118-2124`).
+fn budget_for(sessions: u64) -> Budget {
+    let deployed = Budget::deployed();
+    Budget {
+        w_ref: deployed.u_ref() * sessions,
+        ..deployed
+    }
+}
+
+#[test]
+fn e_admission_is_exact_and_a_completed_tombstone_stays_counted() {
+    pollster::block_on(async {
+        let meta = MemMeta::default();
+        let fleet = MemFleet::default();
+        let budget = budget_for(2);
+        assert_eq!(budget.max_sessions(), 2);
+        let mut tokens = tokens_from(0x90);
+        let mut ids = ids_from(0x9_000);
+        create_bucket(&meta).await;
+
+        // The ledger BOOTSTRAPS on the first create: absent reads as `{count: 0}` and the
+        // create initializes it with `require_absent` + put, carrying the WHOLE schema
+        // (count, max_sessions, profile) — a bootstrap missing `profile` would wedge
+        // admission after the very first session (X89).
+        assert!(mpu::read_admission(&meta).await.unwrap().is_none());
+        let first = create(&meta, &mut tokens, &budget).await;
+        let (_, ledger) = mpu::read_admission(&meta).await.unwrap().unwrap();
+        assert_eq!(ledger.count, 1);
+        assert_eq!(ledger.max_sessions, 2);
+        assert_eq!(ledger.profile, budget);
+
+        let second = create(&meta, &mut tokens, &budget).await;
+        assert_eq!(count(&meta).await, 2, "two open sessions read count == 2");
+
+        // A create past MAX_SESSIONS is the typed backpressure outcome — a normal S3 answer,
+        // not a failure.
+        let refused = mpu::create_session(
+            &meta,
+            &CreateParams {
+                bucket: BUCKET,
+                parent: ROOT,
+                object: OBJECT,
+                content_type: None,
+                created_at_millis: NOW,
+                clock_source: "wall",
+                budget: budget.clone(),
+                resume: None,
+            },
+            &mut tokens,
+            CreateRetry::default(),
+            || 0,
+            |_, _| async {},
+        )
+        .await
+        .unwrap();
+        assert_eq!(
+            refused,
+            CreateOutcome::Refused(Refusal::SlowDown {
+                pressure: Backpressure::SessionCap {
+                    count: 2,
+                    max_sessions: 2
+                }
+            })
+        );
+
+        // A process whose profile disagrees with the ledger's REFUSES to admit and alarms,
+        // rather than silently deferring to either value (X99).
+        let skewed = Budget {
+            max_inflight_parts: budget.max_inflight_parts + 1,
+            ..budget.clone()
+        };
+        assert!(matches!(
+            mpu::create_session(
+                &meta,
+                &CreateParams {
+                    bucket: BUCKET,
+                    parent: ROOT,
+                    object: OBJECT,
+                    content_type: None,
+                    created_at_millis: NOW,
+                    clock_source: "wall",
+                    budget: skewed,
+                    resume: None,
+                },
+                &mut tokens,
+                CreateRetry::default(),
+                || 0,
+                |_, _| async {},
+            )
+            .await
+            .unwrap(),
+            CreateOutcome::Refused(Refusal::ProfileSkew { .. })
+        ));
+
+        // --- ABORT: both halves, separately -------------------------------------------
+        let body = vec![b'e'; CHUNK + 1];
+        put_part(
+            &meta,
+            &fleet,
+            &second,
+            1,
+            &body,
+            &mut tokens,
+            &mut ids,
+            &budget,
+        )
+        .await;
+        assert_eq!(
+            mpu::abort(&meta, &second, NOW + 1, "wall").await.unwrap(),
+            AbortOutcome::Fenced
+        );
+        // (i) The abort RETURNS from the fence commit alone: teardown is not on the request
+        //     path (F9), so the count is unchanged at this instant.
+        assert_eq!(
+            count(&meta).await,
+            2,
+            "abort returns from the fence commit alone — the count is NOT released there"
+        );
+        assert!(
+            !meta
+                .keys_with(&mpu::retire_session_range(mpu::RetireMode::Bytes, &second))
+                .is_empty(),
+            "the fence installs the teardown obligation atomically with itself"
+        );
+        assert_no_classification_gap(&meta, &fleet, NOW).await;
+
+        // (ii) The count returns to its prior value only AFTER the bounded drain and the
+        //      terminal delete.
+        let report = mpu::teardown_session(&meta, &second, NOW + 2, &tiny_budget())
+            .await
+            .unwrap();
+        assert!(report.terminal_deleted && report.count_decremented);
+        assert_eq!(
+            count(&meta).await,
+            1,
+            "the decrement happens in the terminal delete"
+        );
+        // Exactly once: a second teardown of a session that is gone is a no-op.
+        let again = mpu::teardown_session(&meta, &second, NOW + 3, &tiny_budget())
+            .await
+            .unwrap();
+        assert!(!again.count_decremented, "no path decrements twice");
+        assert_eq!(count(&meta).await, 1);
+
+        // --- COMPLETE: the tombstone STAYS COUNTED ------------------------------------
+        put_part(
+            &meta,
+            &fleet,
+            &first,
+            1,
+            &body,
+            &mut tokens,
+            &mut ids,
+            &budget,
+        )
+        .await;
+        let before = count(&meta).await;
+        let published = mpu::complete(
+            &meta,
+            &CompleteParams {
+                upload_id: &first,
+                named: &[(1, part_digest(&body))],
+                clock_source: "wall",
+                now_millis: NOW + 4,
+                budget: &budget,
+                resume: None,
+            },
+            &mut || 51u64,
+        )
+        .await
+        .unwrap();
+        assert!(matches!(published, CompleteOutcome::Published(_)));
+        assert_eq!(
+            count(&meta).await,
+            before,
+            "a Complete must NOT release the admission slot: `count` is the number of `mpu:` \
+             records in ANY state, tombstones included (`0016:348`,`:966-968`,`:2029-2031`)"
+        );
+        let tombstone = mpu::read_session(&meta, &first).await.unwrap().unwrap();
+        assert_eq!(tombstone.state(), SessionState::Completed);
+
+        // The teardown of a `Completed` session drains and reclaims but does NOT terminally
+        // delete: `W_tombstone` is #625's, and deleting the tombstone early would destroy the
+        // identical-retry idempotence leg C depends on.
+        let report = mpu::teardown_session(&meta, &first, NOW + 5, &tiny_budget())
+            .await
+            .unwrap();
+        assert!(!report.terminal_deleted && !report.count_decremented);
+        assert_eq!(count(&meta).await, before);
+        assert!(mpu::read_session(&meta, &first).await.unwrap().is_some());
+        // And it still answers an identical retry.
+        assert!(matches!(
+            mpu::complete(
+                &meta,
+                &CompleteParams {
+                    upload_id: &first,
+                    named: &[(1, part_digest(&body))],
+                    clock_source: "wall",
+                    now_millis: NOW + 6,
+                    budget: &budget,
+                    resume: None,
+                },
+                &mut || 52u64,
+            )
+            .await
+            .unwrap(),
+            CompleteOutcome::AlreadyCompleted(_)
+        ));
+        assert_no_classification_gap(&meta, &fleet, NOW).await;
+    });
+}
+
+async fn count(meta: &MemMeta) -> u64 {
+    mpu::read_admission(meta)
+        .await
+        .unwrap()
+        .map_or(0, |(_, ledger)| ledger.count)
+}
