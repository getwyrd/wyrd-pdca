+
+/// Parse the mode out of a `retire:` key, failing closed on any other spelling — the
+/// boundary the mode-in-the-key argument rests on (`0016:434-440`).
+pub fn parse_retire_mode(key: &[u8]) -> std::result::Result<RetireMode, RecordError> {
+    if key.starts_with(RETIRE_BYTES_PREFIX) {
+        Ok(RetireMode::Bytes)
+    } else if key.starts_with(RETIRE_RECORDS_PREFIX) {
+        Ok(RetireMode::Records)
+    } else {
+        let text = String::from_utf8_lossy(key);
+        Err(RecordError::UnknownRetireMode {
+            mode: text
+                .strip_prefix("retire:")
+                .unwrap_or(&text)
+                .split(':')
+                .next()
+                .unwrap_or_default()
+                .to_string(),
+        })
+    }
+}
+
+fn split_key<'a>(
+    key: &'a [u8],
+    prefix: &str,
+    namespace: &'static str,
+    fields: usize,
+) -> std::result::Result<Vec<&'a str>, RecordError> {
+    let malformed = || RecordError::MalformedKey {
+        namespace,
+        key: String::from_utf8_lossy(key).into_owned(),
+    };
+    let rest = std::str::from_utf8(key)
+        .map_err(|_| malformed())?
+        .strip_prefix(prefix)
+        .ok_or_else(malformed)?;
+    let parts: Vec<&str> = rest.splitn(fields, ':').collect();
+    if parts.len() != fields {
+        return Err(malformed());
+    }
+    Ok(parts)
+}
+
+fn fixed_width_u32(text: &str, width: usize) -> Option<u32> {
+    if text.len() != width || !text.bytes().all(|b| b.is_ascii_digit()) {
+        return None;
+    }
+    text.parse().ok()
+}
+
+/// Parse a `slot:` key into `(upload_id, index)`, rejecting a non-fixed-width or
+/// out-of-**format**-range index (`0016:404-406`).
+pub fn parse_slot_key(key: &[u8]) -> std::result::Result<(String, u32), RecordError> {
+    let fields = split_key(key, "slot:", "slot:", 2)?;
+    let index = fixed_width_u32(fields[1], SLOT_INDEX_WIDTH).ok_or_else(|| {
+        fields[1]
+            .parse::<u64>()
+            .map(|index| RecordError::SlotIndexOutOfRange { index })
+            .unwrap_or_else(|_| RecordError::MalformedKey {
+                namespace: "slot:",
+                key: String::from_utf8_lossy(key).into_owned(),
+            })
+    })?;
+    if index >= SLOT_INDEX_FORMAT_MAX {
+        return Err(RecordError::SlotIndexOutOfRange {
+            index: u64::from(index),
+        });
+    }
+    require_token(fields[0])?;
+    Ok((fields[0].to_string(), index))
+}
+
+fn parse_part_scoped_key(
+    key: &[u8],
+    prefix: &'static str,
+    namespace: &'static str,
+) -> std::result::Result<(String, u32), RecordError> {
+    let fields = split_key(key, prefix, namespace, 2)?;
+    let part_number = fixed_width_u32(fields[1], PART_NUMBER_WIDTH).ok_or_else(|| {
+        fields[1]
+            .parse::<u64>()
+            .map(|part_number| RecordError::PartNumberOutOfRange { part_number })
+            .unwrap_or_else(|_| RecordError::MalformedKey {
+                namespace,
+                key: String::from_utf8_lossy(key).into_owned(),
+            })
+    })?;
+    if part_number == 0 || part_number >= PART_NUMBER_FORMAT_MAX {
+        return Err(RecordError::PartNumberOutOfRange {
+            part_number: u64::from(part_number),
+        });
+    }
+    require_token(fields[0])?;
+    Ok((fields[0].to_string(), part_number))
+}
+
+/// Parse a `part:` key into `(upload_id, part_number)`.
+pub fn parse_part_key(key: &[u8]) -> std::result::Result<(String, u32), RecordError> {
+    parse_part_scoped_key(key, "part:", "part:")
+}
+
+/// Parse a `psum:` key into `(upload_id, part_number)`.
+pub fn parse_psum_key(key: &[u8]) -> std::result::Result<(String, u32), RecordError> {
+    parse_part_scoped_key(key, "psum:", "psum:")
+}
+
+/// Parse a `sidx:` key into `(upload_id, part_number, chunk_id)`.
+pub fn parse_sidx_key(key: &[u8]) -> std::result::Result<(String, u32, ChunkId), RecordError> {
+    let fields = split_key(key, "sidx:", "sidx:", 3)?;
+    let malformed = || RecordError::MalformedKey {
+        namespace: "sidx:",
+        key: String::from_utf8_lossy(key).into_owned(),
+    };
+    let part_number = fixed_width_u32(fields[1], PART_NUMBER_WIDTH).ok_or_else(malformed)?;
+    if part_number == 0 || part_number >= PART_NUMBER_FORMAT_MAX {
+        return Err(RecordError::PartNumberOutOfRange {
+            part_number: u64::from(part_number),
+        });
+    }
+    let chunk: ChunkId = fields[2].parse().map_err(|_| malformed())?;
+    require_token(fields[0])?;
+    Ok((fields[0].to_string(), part_number, chunk))
+}
+
+/// [`metadata::encode`] for a multipart record that is about to be **put**, refusing one
+/// past the backend value ceiling.
+///
+/// The same rule `encode_inode` applies one namespace over: a value the store accepted but
+/// no decode can read is a **poison record** — unreadable, and impossible to overwrite,
+/// because every overwrite is `require(key, encode(prior))` against a prior nobody can
+/// decode. Refusing at the write boundary keeps a caller's mistake from becoming a record
+/// that cannot be repaired.
+fn encode_record<T: Serialize>(value: &T) -> std::result::Result<Bytes, RecordError> {
+    let bytes = metadata::encode(value);
+    if bytes.len() > MAX_VALUE_BYTES {
+        return Err(RecordError::ValueOverCeiling {
+            bytes: bytes.len(),
+            limit: MAX_VALUE_BYTES,
+        });
+    }
+    Ok(bytes)
+}
+
+/// Decode a session record and enforce the state's field rules, so a value a state forbids
+/// is an error rather than a value (`0016:404-408`).
+pub fn decode_session(bytes: &[u8]) -> Result<SessionRecord> {
+    let record: SessionRecord = metadata::decode(bytes)?;
+    // **Every** state x field combination, in one table, checked rather than tolerated: the four
+    // optional fields are what half of each state *means*, so a record carrying one its state
+    // forbids — or missing one its state requires — is a record no writer in this module can
+    // produce, and admitting it as a *value* would let a consumer act on a session it does not
+    // understand. Checking only a subset is how a `Completing` session with no publication
+    // target, or a `Completed` one with no publication, gets past the validation boundary and
+    // becomes an `unwrap` (or a wrong answer) three call frames later (ADR-0045,
+    // `AGENTS.md:146-149`).
+    let (fenced, cursor, target, completion) = (
+        record.fenced_at_millis.is_some(),
+        record.segments_written.is_some(),
+        record.publish_target.is_some(),
+        record.completion.is_some(),
+    );
+    let required: &[(bool, &'static str)] = match record.state {
+        SessionState::Completing => &[
+            (fenced, "fenced_at_millis"),
+            (cursor, "segments_written"),
+            (target, "publish_target"),
+        ],
+        SessionState::Completed => &[(completion, "completion")],
+        SessionState::Open | SessionState::Aborting => &[],
+    };
+    for (present, field) in required {
+        if !present {
+            return Err(RecordError::FieldRequiredByState {
+                state: record.state,
+                field,
+            }
+            .into());
+        }
+    }
+    let forbidden: &[(bool, &'static str)] = match record.state {
+        // A release and a teardown fence both drop every `Completing`-only field, so an `Open`
+        // or `Aborting` record is byte-identical in shape to a freshly created one.
+        SessionState::Open | SessionState::Aborting => &[
+            (fenced, "fenced_at_millis"),
+            (cursor, "segments_written"),
+            (target, "publish_target"),
+            (completion, "completion"),
+        ],
+        SessionState::Completing => &[(completion, "completion")],
+        SessionState::Completed => &[
+            (fenced, "fenced_at_millis"),
+            (cursor, "segments_written"),
+            (target, "publish_target"),
+        ],
+    };
+    for (present, field) in forbidden {
+        if *present {
+            return Err(RecordError::FieldForbiddenByState {
+                state: record.state,
+                field,
+            }
+            .into());
+        }
+    }
+    Ok(record)
+}
+
+/// The refusal a caller's `clock_source` owes against the session's own, or `None` when they
+/// agree — *one clock per correctness lifecycle* (`AGENTS.md:131-142`, X106).
+///
+/// Checked at each point a **new** lifecycle-scoped stamp enters the records — the slot
+/// reserve, the Complete fence, the Abort fence — rather than at every batch: the staging,
+/// renewal and commit batches all precondition on the session record whose source was checked
+/// when their slot was reserved, so one check per part attempt covers every stamp that attempt
+/// writes.
+fn clock_skew(session: &SessionRecord, clock_source: &str) -> Option<RecordError> {
+    (session.clock_source != clock_source).then(|| RecordError::ClockSourceSkew {
+        session: session.clock_source.clone(),
+        local: clock_source.to_string(),
+    })
+}
