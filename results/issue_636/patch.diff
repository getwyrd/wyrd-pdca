+    /// check the maintenance paths quarantine (`0016:416-432`, `AGENTS.md:146-149`) and a
+    /// reclaimer that refused would strand the very bytes it exists to evidence.
+    pub fn fragments(&self) -> impl Iterator<Item = (u16, DServerId)> + '_ {
