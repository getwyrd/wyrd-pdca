+/// **`reclaim_owned` is fence-then-walk, and enforces it itself.**
+///
+/// It is a public entry point, so "the caller checked the state" is not a property of the
+/// system. Called for an `Open` session it would orphan-mark the fragments of a part that is in
+/// flight *right now* and delete the only records protecting them — outcome (c), from the
+/// reclamation path itself.
+#[test]
+fn reclaim_owned_refuses_an_open_session() {
+    pollster::block_on(async {
+        let meta = MemMeta::default();
+        let fleet = MemFleet::default();
+        create_bucket(&meta).await;
+        let mut tokens = tokens_from(0x09E4);
+        let mut ids = ids_from(0x09E4);
+        let budget = Budget::deployed();
+        let upload_id = create(&meta, &mut tokens, &budget).await;
+        let mut part = match mpu::reserve_slot(
+            &meta,
+            &upload_id,
+            1,
+            NOW,
+            LEASE_TTL,
+            "wall",
+            None,
+            &mut tokens,
+            &budget,
+        )
+        .await
+        .unwrap()
+        {
+            mpu::ReserveOutcome::Reserved(part) => *part,
+            other => panic!("reserve refused: {other:?}"),
+        };
+        assert_eq!(
+            mpu::stage_chunk(
+                &meta,
+                &fleet,
+                &mut part,
+                &[5u8; 512],
+                RS,
+                ids(),
+                &topology(),
+                NOW,
+                LEASE_TTL,
+            )
+            .await
+            .unwrap(),
+            CommitOutcome::Committed
+        );
+        let owned = meta.keys_with(&mpu::sidx_range(&upload_id));
+        assert_eq!(owned.len(), 1, "one chunk is in flight");
+
+        let mut report = mpu::DrainReport::default();
+        mpu::reclaim_owned(&meta, &upload_id, NOW + 1, &tiny_budget(), &mut report)
+            .await
+            .unwrap();
+        assert_eq!(
+            meta.keys_with(&mpu::sidx_range(&upload_id)),
+            owned,
+            "an OPEN session's in-flight entries are untouched"
+        );
+        assert_eq!(report.owned_reclaimed, 0);
+        assert!(
+            meta.keys_with(b"orphan:").is_empty(),
+            "…and not one live fragment is marked for reclamation"
+        );
+        assert_no_classification_gap(&meta, &fleet, NOW).await;
+    });
+}
