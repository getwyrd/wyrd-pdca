+/// Key prefix for the **desired-state** ledger — a D server the operator has marked
+/// draining / decommissioning (`crates/custodian/src/desired_state.rs`).
+///
+/// Defined here, beside [`orphan_key`], for the reason that helper states: it is a
+/// **metadata-store key protocol shared by both sides**. The custodian *writes* it when an
+/// operator requests a drain; the write path *reads* it as a `require_absent` precondition
+/// on every batch that installs a reference to a fragment on that server — the **drain
+/// fence** of proposal 0016 decision 2 (`0016:844-848`), which makes intent creation and
+/// the drain request a single-winner race instead of two independent writes ordered by
+/// luck. One source of truth so the key a drain writes and the key a staged intent pins can
+/// never format-drift.
+pub const DESIRED_DSERVER_PREFIX: &[u8] = b"desired:dserver:";
+
+/// Key for one D server's desired-state record: `desired:dserver:<id>`.
+pub fn desired_dserver_key(dserver: DServerId) -> Vec<u8> {
+    format!("desired:dserver:{dserver}").into_bytes()
+}
+
+// ---------------------------------------------------------------------------
+// Retirement obligations — the general bounded-work record class (0016 decision 4.1)
+// ---------------------------------------------------------------------------
+
+/// Key prefix for **byte-mode** retirement obligations: orphan-mark the bytes the obligation
+/// names, *then* delete the records that named them (`0016:355`).
+pub const RETIRE_BYTES_PREFIX: &[u8] = b"retire:bytes:";
+
+/// Key prefix for **record-mode** retirement obligations: delete records whose bytes are
+/// protected by something else — **never** orphan-mark (`0016:356`).
+pub const RETIRE_RECORDS_PREFIX: &[u8] = b"retire:records:";
+
+/// Which of the two retirement modes an obligation is in — read from the **key**, never from a
+/// field (`0016:434-440`): a boolean misread once is silent data loss, a malformed key prefix is
+/// an error at decode.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum RetireMode {
+    /// Orphan-mark the bytes, then delete the records that named them.
+    Bytes,
+    /// Delete records only — **never** orphan-mark.
+    Records,
+}
+
+impl RetireMode {
+    /// The key prefix this mode lives under.
+    pub fn prefix(self) -> &'static [u8] {
+        match self {
+            Self::Bytes => RETIRE_BYTES_PREFIX,
+            Self::Records => RETIRE_RECORDS_PREFIX,
+        }
+    }
+}
+
+/// A retirement token, whose grammar makes reuse impossible (`0016:358-380`).
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum RetireToken {
+    /// A session-scoped obligation: `s:<upload-id>:<epoch>` plus, for a per-part one, the
+    /// `(part, attempt)` pair that produced it.
+    Session {
+        /// The owning session.
+        upload_id: String,
+        /// The epoch whose fence installed it.
+        epoch: u64,
+        /// The part attempt, for a per-part obligation.
+        part: Option<(u32, String)>,
+    },
+    /// A superseded or deleted generation: `g:<inode-id>:<version>`. Produced by exactly one
+    /// publication, since `version = prior.version + 1` under the inode CAS.
+    Generation {
+        /// The inode.
+        inode: InodeId,
+        /// The version.
+        version: u64,
+    },
+}
+
+impl std::fmt::Display for RetireToken {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        match self {
+            Self::Session {
+                upload_id,
+                epoch,
+                part: None,
+            } => write!(f, "s:{upload_id}:{epoch}"),
+            Self::Session {
+                upload_id,
+                epoch,
+                part: Some((part, attempt)),
+            } => write!(f, "s:{upload_id}:{epoch}:{part}:{attempt}"),
+            Self::Generation { inode, version } => write!(f, "g:{inode}:{version}"),
+        }
+    }
+}
+
+/// Key for a retirement obligation: `retire:<mode>:<token>`.
+pub fn retire_key(mode: RetireMode, token: &RetireToken) -> Vec<u8> {
+    let mut key = mode.prefix().to_vec();
+    key.extend_from_slice(token.to_string().as_bytes());
+    key
+}
+
+/// The bounded session-scoped obligation range for one mode: `retire:<mode>:s:<upload-id>:`.
+/// The terminal delete's "no obligation left" gate is two of these emptiness reads, never a
+/// walk of the whole `retire:` namespace (`0016:374-380`).
+pub fn retire_session_range(mode: RetireMode, upload_id: &str) -> Vec<u8> {
+    let mut key = mode.prefix().to_vec();
+    key.extend_from_slice(format!("s:{upload_id}:").as_bytes());
+    key
+}
+
+/// The decimal width a part number is zero-padded to in `part:` / `psum:` / `sidx:` keys, so
+/// a range read returns parts in part-number order.
+///
+/// It lives at this layer — and is re-exported by [`crate::multipart`], which formats the keys
+/// — because [`PartNumberSet`] is a **field of this layer's** retirement obligations and is
+/// validated against the same grammar at decode: a run naming a part number the fixed-width key
+/// format cannot spell would name a `part:` record no parser can read back, so one constant has
+/// to bind both or the two drift apart silently.
+pub const PART_NUMBER_WIDTH: usize = 5;
+
+/// One past the largest part number the fixed-width grammar can spell — the **format**
+/// maximum, a constant of the encoding rather than of the live knob (`0016:390-402`).
+pub const PART_NUMBER_FORMAT_MAX: u32 = 100_000;
+
+/// A **range-encoded** part-number set (`0016:382-388`), so "every staged part was published"
+/// is a few bytes and the worst case — 10,000 alternating numbers — still fits one value.
+///
+/// The encoding is **canonical and validated at decode** ([`Self::from_runs`]): coalesced,
+/// strictly ascending, non-adjacent runs of in-range part numbers. A derived `Deserialize`
+/// admitted reversed, overlapping and out-of-range runs, and each is a live defect rather than
+/// an aesthetic one — a reversed run underflows [`Self::len`], an unordered one makes
+/// [`Self::first_at_or_after`] (the drain cursor's "resume here" query) skip members, and a
+/// part number past the key grammar names a record no parser can read. A malformed obligation
+/// would then be *deleted* without reclaiming the parts it names (ADR-0045,
+/// `AGENTS.md:146-149`).
+#[derive(Debug, Clone, Default, PartialEq, Eq, Serialize)]
+#[serde(transparent)]
+pub struct PartNumberSet(Vec<(u32, u32)>);
+
+impl<'de> Deserialize<'de> for PartNumberSet {
+    fn deserialize<D: Deserializer<'de>>(deserializer: D) -> std::result::Result<Self, D::Error> {
+        let runs = Vec::<(u32, u32)>::deserialize(deserializer)?;
+        Self::from_runs(runs).map_err(D::Error::custom)
+    }
+}
+
+impl PartNumberSet {
+    /// Build the set from any iterator of part numbers, coalescing contiguous runs.
+    pub fn from_iter_unsorted(numbers: impl IntoIterator<Item = u32>) -> Self {
+        let sorted: BTreeSet<u32> = numbers.into_iter().collect();
+        let mut runs: Vec<(u32, u32)> = Vec::new();
+        for n in sorted {
+            match runs.last_mut() {
+                Some(last) if last.1 + 1 == n => last.1 = n,
+                _ => runs.push((n, n)),
+            }
+        }
+        Self(runs)
+    }
+
+    /// The validating constructor every decode goes through: runs must be non-empty ranges of
+    /// part numbers inside `[1, PART_NUMBER_FORMAT_MAX)`, strictly ascending, and separated by
+    /// at least one absent number (adjacent runs are the same set spelled non-canonically, and a
+    /// non-canonical spelling breaks the `decode → encode` byte identity every obligation CAS
+    /// depends on).
+    fn from_runs(runs: Vec<(u32, u32)>) -> std::result::Result<Self, String> {
+        let mut previous_hi: Option<u32> = None;
+        for &(lo, hi) in &runs {
+            if lo == 0 || lo > hi || hi >= PART_NUMBER_FORMAT_MAX {
+                return Err(format!(
+                    "part-number run [{lo}, {hi}] is empty, reversed, or outside the key \
+                     grammar's [1, {PART_NUMBER_FORMAT_MAX})"
+                ));
+            }
+            if let Some(previous) = previous_hi {
+                if lo <= previous + 1 {
+                    return Err(format!(
+                        "part-number run [{lo}, {hi}] overlaps or abuts the run ending at \
+                         {previous}: the encoding is coalesced, strictly ascending runs"
+                    ));
+                }
+            }
+            previous_hi = Some(hi);
+        }
+        Ok(Self(runs))
+    }
+
+    /// Whether the set is empty.
+    pub fn is_empty(&self) -> bool {
+        self.0.is_empty()
+    }
+
+    /// How many part numbers the set holds.
+    pub fn len(&self) -> u64 {
+        self.0
+            .iter()
+            .map(|(lo, hi)| u64::from(*hi) - u64::from(*lo) + 1)
+            .sum()
+    }
+
+    /// Whether `n` is in the set.
+    pub fn contains(&self, n: u32) -> bool {
+        self.0.iter().any(|(lo, hi)| *lo <= n && n <= *hi)
+    }
+
+    /// Every part number in ascending order.
+    pub fn iter(&self) -> impl Iterator<Item = u32> + '_ {
+        self.0.iter().flat_map(|(lo, hi)| *lo..=*hi)
+    }
+
+    /// The smallest member `>= from`, or `None` — the drain cursor's "resume here" query.
+    pub fn first_at_or_after(&self, from: u32) -> Option<u32> {
+        self.0
+            .iter()
+            .find(|(_, hi)| *hi >= from)
+            .map(|(lo, _)| (*lo).max(from))
+    }
+}
+
+/// The `seg:` generation a retirement must also reclaim — a group nonce plus the fence epoch
+/// that wrote it (`0016:354-356`).
+///
+/// The nonce is validated **at decode**, through the same predicate [`SegmentGroup::new`]
+/// applies: it is the only thing that keys the `seg:` range this obligation owes work over, so a
+/// nonce that cannot key a reproducible range makes the obligation undrainable. Left to the
+/// later constructor, the failure surfaced as an *empty key list* deep inside the drain, and the
+/// obligation was then deleted having deleted none of its segments (ADR-0045, parse-don't-validate).
+#[derive(Debug, Clone, PartialEq, Eq, Serialize)]
+pub struct SegmentGeneration {
+    /// The segment-group nonce.
+    pub nonce: String,
+    /// The `Completing` fence epoch whose segments these are.
+    pub epoch: u64,
+}
+
+impl SegmentGeneration {
+    /// The validated [`SegmentGroup`] this generation names — infallible for any value that came
+    /// through [`Deserialize`] or [`Self::of`], which is what makes the drain's key derivation
+    /// total rather than an arm that silently produces no keys.
+    pub fn group(&self) -> std::result::Result<SegmentGroup, ChunkMapError> {
+        SegmentGroup::new(self.nonce.clone(), self.epoch)
+    }
+
+    /// The generation a validated group names.
+    pub fn of(group: &SegmentGroup) -> Self {
+        Self {
+            nonce: group.nonce().to_string(),
+            epoch: group.epoch(),
+        }
+    }
+}
+
+impl<'de> Deserialize<'de> for SegmentGeneration {
+    fn deserialize<D: Deserializer<'de>>(deserializer: D) -> std::result::Result<Self, D::Error> {
+        #[derive(Deserialize)]
+        #[serde(deny_unknown_fields)]
+        struct Raw {
+            nonce: String,
+            epoch: u64,
+        }
+        let raw = Raw::deserialize(deserializer)?;
+        let group = SegmentGroup::new(raw.nonce, raw.epoch).map_err(D::Error::custom)?;
+        Ok(Self::of(&group))
+    }
+}
+
+/// What one retirement obligation owes (`0016:355-356`).
+///
+/// The **mode lives in the key**, not in a field, so a payload variant and its key mode are
+/// cross-checked at drain time rather than trusted (`0016:434-440`).
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+pub enum RetirePayload {
+    /// `retire:bytes:` — a session teardown: orphan-mark every part the session still holds,
+    /// then delete the `part:`/`psum:` pairs that name them.
+    ///
+    /// **It carries no part list, deliberately.** A list frozen by the aborting caller is read
+    /// *before* its fence lands, so a part commit that wins the read→fence window is absent
+    /// from it — and that part's records then survive every teardown batch, which is the
+    /// session-less part leak an earlier attempt shipped. The fence makes the session's own
+    /// `part:<id>:` range immutable, so the drain enumerates it **at drain time** from the
+    /// bounded range and is complete by construction while the fence batch stays O(1)
+    /// (`0016:664`'s `retire:bytes:{session}`).
+    Session {},
+    /// `retire:bytes:` — the staged parts a Complete did **not** name, frozen under the fence
+    /// that already holds the part set immutable. One obligation that marks *then* deletes, so
+    /// no cross-obligation ordering can get it wrong (X104).
+    Parts {
+        /// The unnamed staged parts.
+        parts: PartNumberSet,
+    },
+    /// `retire:bytes:` — a specific chunk list with no naming record left: a losing writer's
+    /// compensation, or any post-staging local refusal (`0016:1418-1430`, X85).
+    Chunks {
+        /// The chunks to orphan-mark.
+        chunks: Vec<ChunkRef>,
+    },
+    /// `retire:bytes:` — a superseded or deleted object generation (`0016:1079-1104`).
+    Generation {
+        /// The inode the generation belonged to.
+        inode: InodeId,
+        /// Its version.
+        version: u64,
+        /// Its flat chunk list, when it had one.
+        #[serde(default, skip_serializing_if = "Vec::is_empty")]
+        chunks: Vec<ChunkRef>,
+        /// Its `seg:` generation, when it was segmented — resolved page-wise at drain time,
+        /// never frozen here.
+        #[serde(default, skip_serializing_if = "Option::is_none")]
+        segments: Option<SegmentGeneration>,
+    },
+    /// `retire:records:` — records to delete whose bytes are protected by something else:
+    /// the **published** parts (never the unnamed ones, X104), and/or one rolled-back
+    /// attempt's dangling segments.
+    Records {
+        /// The published parts whose records the publication superseded.
+        #[serde(default, skip_serializing_if = "Option::is_none")]
+        parts: Option<PartNumberSet>,
+        /// One attempt's dangling `seg:` generation.
+        #[serde(default, skip_serializing_if = "Option::is_none")]
+        segments: Option<SegmentGeneration>,
+    },
+}
+
+impl RetirePayload {
+    /// Whether this payload may live under `mode`'s prefix — the cross-check that makes
+    /// "the mode lives in the key" a checked boundary rather than a convention
+    /// (`0016:434-440`). A `Records` payload under `retire:bytes:` would orphan-mark bytes a
+    /// live object still names; a byte payload under `retire:records:` would delete the only
+    /// records naming durable bytes with no evidence written.
+    pub fn is_valid_for(&self, mode: RetireMode) -> bool {
+        matches!(
+            (self, mode),
+            (Self::Records { .. }, RetireMode::Records)
+                | (
+                    Self::Session { .. }
+                        | Self::Parts { .. }
+                        | Self::Chunks { .. }
+                        | Self::Generation { .. },
+                    RetireMode::Bytes
+                )
+        )
+    }
+
+    /// The **structural** rules a payload must satisfy to be actionable at all, checked at
+    /// decode ([`RetireObligation`]'s `Deserialize`) rather than discovered as a walk that owes
+    /// nothing.
+    ///
+    /// Each rejected shape is one no writer in this crate produces and one whose *effect* is a
+    /// silently incomplete drain:
+    ///
+    /// * a `Generation` naming **both** an inline chunk list and a `seg:` generation — the two
+    ///   are alternatives ([`plan_generation_retirement`]), and a drain that picks one arm would
+    ///   evidence half the payload and then delete the obligation;
+    /// * an **empty** `Chunks`, `Parts` or `Records` payload — an obligation that owes nothing is
+    ///   a producer bug, and admitting it lets that bug look like completed work.
+    fn validate(&self) -> std::result::Result<(), String> {
+        match self {
+            Self::Session {} => Ok(()),
+            Self::Chunks { chunks } if chunks.is_empty() => {
+                Err("a retire:bytes:{chunks} obligation names no chunks".to_string())
+            }
+            Self::Chunks { .. } => Ok(()),
+            Self::Parts { parts } if parts.is_empty() => {
+                Err("a retire:bytes:{parts} obligation names no parts".to_string())
+            }
+            Self::Parts { .. } => Ok(()),
+            Self::Generation {
+                chunks, segments, ..
+            } => {
+                if !chunks.is_empty() && segments.is_some() {
+                    return Err(
+                        "a generation obligation names either a flat chunk list or a seg: \
+                         generation, never both"
+                            .to_string(),
+                    );
+                }
+                Ok(())
+            }
+            Self::Records { parts, segments } => {
+                if parts.is_none() && segments.is_none() {
+                    return Err(
+                        "a retire:records: obligation names neither parts nor segments".to_string(),
+                    );
+                }
+                if parts.as_ref().is_some_and(PartNumberSet::is_empty) {
+                    return Err("a retire:records: obligation names an empty part set".to_string());
+                }
+                Ok(())
+            }
+        }
+    }
+
+    /// How many **independent** index spaces the deleting phase must walk, in walk order — the
+    /// `arm` a [`RetireCursor`] selects (`0016:355-356`, "the published parts … **and/or** one
+    /// rolled-back attempt's dangling segments").
+    ///
+    /// Two spaces walked in lockstep terminate at the first *joint* gap, so an obligation naming
+    /// both sparse parts and segments could be deleted while later part records still existed —
+    /// the naming records of durable bytes, gone with nothing left to name them. They are
+    /// therefore walked one after the other, each to its own exhaustion.
+    pub fn delete_spaces(&self) -> Vec<DeleteSpace> {
+        match self {
+            Self::Session {} | Self::Parts { .. } => vec![DeleteSpace::Parts],
+            Self::Chunks { .. } => Vec::new(),
+            Self::Generation { segments, .. } => match segments {
+                Some(_) => vec![DeleteSpace::Segments],
+                None => Vec::new(),
+            },
+            Self::Records { parts, segments } => {
+                let mut spaces = Vec::new();
+                if parts.is_some() {
+                    spaces.push(DeleteSpace::Parts);
+                }
+                if segments.is_some() {
+                    spaces.push(DeleteSpace::Segments);
+                }
+                spaces
+            }
+        }
+    }
+}
+
+/// One of the two **independent** key spaces a retirement's deleting phase walks — the
+/// discriminant a [`RetireCursor::arm`] selects (see [`RetirePayload::delete_spaces`]).
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum DeleteSpace {
+    /// The part-number space: `part:<id>:<n>` and its `psum:` sibling.
+    Parts,
+    /// The segment-index space: `seg:<nonce>:<epoch>:<i>`.
+    Segments,
+}
+
+/// Which half of a two-phase drain an obligation is in. **Marking precedes deleting,
+/// always** — invariant (2) restated as an ordering rule (`0016:1121-1126`).
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]
+pub enum DrainPhase {
+    /// Writing `orphan:` evidence for the bytes the obligation names.
+    Marking,
+    /// Deleting the records that named them.
+    Deleting,
+}
+
+/// A drain's resumable position **inside the obligation record it walks** — not a record
+/// class of its own (`0016:612-619`): the batch that advances it already CASes the
+/// obligation, so the advance is part of the single-winner mutation that authorizes the
+/// step.
+///
+/// The position is three-level because the drain must be splittable at the granularity of
+/// **one mutation**: a unit (a part, a segment) holds many chunks and a chunk holds one
+/// fragment position per placement entry, so a budget that could only stop at a unit or a
+/// chunk boundary would have to commit an over-envelope batch whenever a single unit's
+/// fan-out exceeded it.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]
+pub struct RetireCursor {
+    /// Which phase.
+    pub phase: DrainPhase,
+    /// The outer unit reached: a part number, or a segment index.
+    pub outer: u32,
+    /// The position **within** that unit: a chunk index.
+    pub inner: u32,
+    /// The fragment position within that chunk — 0 for a whole chunk, so a legacy cursor
+    /// (written before this field existed) decodes and re-encodes identically.
+    #[serde(default, skip_serializing_if = "is_zero_u32")]
+    pub frag: u32,
+    /// Which of the payload's [`RetirePayload::delete_spaces`] the **deleting** phase is walking
+    /// — 0 for the first (and, for every payload this slice's own writers produce, only) space,
+    /// so a cursor that names one space decodes and re-encodes identically to one written before
+    /// this field existed. Always 0 in the marking phase, which has a single unit space.
+    #[serde(default, skip_serializing_if = "is_zero_u32")]
+    pub arm: u32,
+}
+
+fn is_zero_u32(value: &u32) -> bool {
+    *value == 0
+}
+
+/// A durable retirement obligation: what it owes, and how far a drain has got.
+///
+/// Decoding is **validating** ([`RetirePayload::validate`] plus the cursor's own rules): this
+/// record is the only thing that keeps the bytes it names protected, so a shape whose drain
+/// would owe nothing — or would owe less than the payload names — must fail at the boundary
+/// rather than be deleted as completed work.
+#[derive(Debug, Clone, PartialEq, Eq, Serialize)]
+pub struct RetireObligation {
+    /// What is owed.
+    pub payload: RetirePayload,
+    /// Where the drain resumes. Absent means "start at the beginning of the first phase".
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub cursor: Option<RetireCursor>,
+}
+
+impl<'de> Deserialize<'de> for RetireObligation {
+    fn deserialize<D: Deserializer<'de>>(deserializer: D) -> std::result::Result<Self, D::Error> {
+        #[derive(Deserialize)]
+        #[serde(deny_unknown_fields)]
+        struct Raw {
+            payload: RetirePayload,
+            #[serde(default)]
+            cursor: Option<RetireCursor>,
+        }
+        let raw = Raw::deserialize(deserializer)?;
+        raw.payload.validate().map_err(D::Error::custom)?;
+        if let Some(cursor) = &raw.cursor {
+            let spaces = raw.payload.delete_spaces().len() as u32;
+            match cursor.phase {
+                // The marking phase walks a single unit space, so an arm there is a cursor no
+                // writer produces and one whose only possible effect is to select a space the
+                // marking walk does not have.
+                DrainPhase::Marking if cursor.arm != 0 => {
+                    return Err(D::Error::custom(
+                        "a marking cursor may not select a delete-space arm",
+                    ));
+                }
+                DrainPhase::Deleting if cursor.arm >= spaces.max(1) => {
+                    return Err(D::Error::custom(format!(
+                        "delete-space arm {} is outside the payload's {spaces} space(s)",
+                        cursor.arm
+                    )));
+                }
+                _ => {}
+            }
+        }
+        Ok(Self {
+            payload: raw.payload,
+            cursor: raw.cursor,
+        })
+    }
