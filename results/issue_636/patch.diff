+/// **An obligation whose key identity cannot own its payload is refused at the drain.**
+///
+/// The mode cross-check passes for this record — a session teardown payload *is* a byte-mode
+/// payload — but the key names a **generation**, so the walk would enumerate a part range keyed
+/// by an upload id the token does not have: empty for the wrong reason, and the obligation
+/// deleted on the strength of it, taking the last protection off whatever it really named.
+#[test]
+fn a_retire_key_that_cannot_own_its_payload_is_refused() {
+    pollster::block_on(async {
+        let meta = MemMeta::default();
+        let key = mpu::retire_key(
+            mpu::RetireMode::Bytes,
+            &mpu::RetireToken::Generation {
+                inode: 9,
+                version: 2,
+            },
+        );
+        meta.put_raw(
+            key.clone(),
+            metadata::encode(&mpu::RetireObligation::new(mpu::RetirePayload::Session {})),
+        );
+        let mut report = mpu::DrainReport::default();
+        let err = mpu::drain_step(&meta, &key, NOW, &tiny_budget(), &mut report)
+            .await
+            .expect_err("a token that cannot own the payload is a boundary error");
+        assert!(
+            err.to_string().contains("key identity cannot own"),
+            "the fault names itself: {err}"
+        );
+        assert!(
+            meta.get(&key).await.unwrap().is_some(),
+            "…and the obligation is not deleted on the strength of an empty walk"
+        );
+    });
+}
