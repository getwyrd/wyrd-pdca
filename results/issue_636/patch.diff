+// ---------------------------------------------------------------------------
+// The record classes that authorize work — validated where they are read
+// ---------------------------------------------------------------------------
+
+/// **An owned entry whose scheme names no fragment position is an error, not a free delete.**
+///
+/// `reclaim_owned` lifts protection: it marks every position the chunk's `staged` placement
+/// names and deletes the entry in the same batch. A scheme the coder cannot code names *no*
+/// position, so the walk would mark nothing and delete the only record protecting those bytes —
+/// durable, unreferenced and unevidenced at once, which is the one state GC can never recover
+/// from (it reclaims on explicit evidence and otherwise retains). The value is refused at decode,
+/// so the walk stops with the entry intact instead.
+#[test]
+fn an_owned_entry_whose_scheme_names_no_fragment_is_not_deleted_without_evidence() {
+    pollster::block_on(async {
+        let meta = MemMeta::default();
+        create_bucket(&meta).await;
+        let mut tokens = tokens_from(0x5CE0);
+        let budget = Budget::deployed();
+        let upload_id = create(&meta, &mut tokens, &budget).await;
+        assert!(matches!(
+            mpu::abort(&meta, &upload_id, NOW + 1, "wall")
+                .await
+                .unwrap(),
+            AbortOutcome::Fenced
+        ));
+        // A torn owned entry under this session's range: the fields are all present, but the
+        // scheme names zero fragments.
+        let key = mpu::sidx_key(&upload_id, 1, 77);
+        meta.put_raw(
+            key.clone(),
+            Bytes::from(format!(
+                r#"{{"lease_expiry_millis":{},"owner":"{upload_id}","staged":{{"scheme":{{"ReedSolomon":{{"k":0,"m":0}}}},"placement":[]}}}}"#,
+                NOW + LEASE_TTL
+            )),
+        );
+        let mut report = mpu::DrainReport::default();
+        let err = mpu::reclaim_owned(&meta, &upload_id, NOW + 2, &tiny_budget(), &mut report)
+            .await
+            .expect_err("an entry that can evidence nothing must not be deleted");
+        assert!(
+            err.to_string().contains("RS(0,0)"),
+            "the operator signal names the scheme: {err}"
+        );
+        assert!(
+            meta.get(&key).await.unwrap().is_some(),
+            "…and the entry — the only record naming those bytes — is still there"
+        );
+        assert_eq!(report.owned_reclaimed, 0);
+    });
+}
+
+/// **A `mpuctl` whose limit is not its profile's cannot admit anything.**
+///
+/// Admission enforces the **stored** `max_sessions` so every host in the fleet agrees on one
+/// number; that is precisely why the number may not be free. A torn or forged ledger claiming a
+/// larger limit than its own profile derives would be believed by every admitter, and the
+/// reconcile bound `Σ_sessions(U_ref) ≤ W_ref` — which is what `MAX_SESSIONS` is derived from —
+/// would be exceeded on the hosts that never observe the overrun.
+#[test]
+fn a_forged_admission_limit_is_refused_rather_than_admitted_against() {
+    pollster::block_on(async {
+        let meta = MemMeta::default();
+        create_bucket(&meta).await;
+        let mut tokens = tokens_from(0xF0A6);
+        // A ledger at its (small, derived) cap, which would refuse the next create…
+        let budget = budget_for(1);
+        let upload_id = create(&meta, &mut tokens, &budget).await;
+        assert!(!upload_id.is_empty());
+        assert!(matches!(
+            mpu::create_session(
+                &meta,
+                &CreateParams {
+                    bucket: BUCKET,
+                    parent: ROOT,
+                    object: OBJECT,
+                    content_type: None,
+                    created_at_millis: NOW,
+                    clock_source: "wall",
+                    budget: budget.clone(),
+                    resume: None,
+                },
+                &mut tokens,
+                CreateRetry::default(),
+                || 0,
+                |_, _| async {},
+            )
+            .await
+            .unwrap(),
+            CreateOutcome::Refused(Refusal::SlowDown {
+                pressure: Backpressure::SessionCap { .. }
+            })
+        ));
+
+        // …forged to name a bigger one, over the SAME profile. Believing it is how the bound is
+        // exceeded, so the ledger no longer decodes at all.
+        meta.put_raw(
+            mpu::MPUCTL_KEY.to_vec(),
+            Bytes::from(format!(
+                r#"{{"count":1,"max_sessions":{},"profile":{{"w_ref":{},"max_part_chunks":{},"max_parts_per_session":{},"max_inflight_parts":{},"max_staged_chunks":{}}}}}"#,
+                budget.max_sessions() + 1_000,
+                budget.w_ref,
+                budget.max_part_chunks,
+                budget.max_parts_per_session,
+                budget.max_inflight_parts,
+                budget.max_staged_chunks,
+            )),
+        );
+        let err = mpu::read_admission(&meta)
+            .await
+            .expect_err("a limit its own profile does not derive is a torn ledger");
+        assert!(
+            err.to_string().contains("derived, never chosen"),
+            "the operator signal names the rule: {err}"
+        );
+        let err = mpu::create_session(
+            &meta,
+            &CreateParams {
+                bucket: BUCKET,
+                parent: ROOT,
+                object: OBJECT,
+                content_type: None,
+                created_at_millis: NOW,
+                clock_source: "wall",
+                budget: budget.clone(),
+                resume: None,
+            },
+            &mut tokens,
+            CreateRetry::default(),
+            || 0,
+            |_, _| async {},
+        )
+        .await
+        .expect_err("a create must not be admitted against a forged limit");
+        assert!(err.to_string().contains("derived, never chosen"));
+        assert_eq!(
+            meta.keys_with(mpu::MPU_PREFIX).len(),
+            1,
+            "…and no second session was admitted past the derived bound"
+        );
+    });
+}
+
+/// **A budget that violates a clamp never becomes the fleet's stored profile.**
+///
+/// The bootstrap arm writes the caller's budget into `mpuctl`, where every other admitter
+/// compares against it — so an illegal set admitted here would be enforced fleet-wide, and the
+/// ledger's own decode (the same predicate) would then reject the record the fleet must read.
+#[test]
+fn an_illegal_budget_cannot_bootstrap_the_ledger() {
+    pollster::block_on(async {
+        let meta = MemMeta::default();
+        create_bucket(&meta).await;
+        let mut tokens = tokens_from(0xBAD0);
+        let illegal = Budget {
+            // A part-number space the fixed-width key grammar cannot spell.
+            max_parts_per_session: metadata::PART_NUMBER_FORMAT_MAX + 1,
+            ..Budget::deployed()
+        };
+        let err = mpu::create_session(
+            &meta,
+            &CreateParams {
+                bucket: BUCKET,
+                parent: ROOT,
+                object: OBJECT,
+                content_type: None,
+                created_at_millis: NOW,
+                clock_source: "wall",
+                budget: illegal,
+                resume: None,
+            },
+            &mut tokens,
+            CreateRetry::default(),
+            || 0,
+            |_, _| async {},
+        )
+        .await
+        .expect_err("an illegal value set must not become the ledger's profile");
+        assert!(
+            err.to_string().contains("not legal"),
+            "the refusal names the clamp it broke: {err}"
+        );
+        assert!(
+            meta.get(mpu::MPUCTL_KEY).await.unwrap().is_none(),
+            "…and nothing was written: the ledger is still unbootstrapped"
+        );
+    });
+}
+
+/// **A part number the key grammar cannot spell is refused at the seam, whatever the budget
+/// says**, and **a session whose ledger is gone admits no new part.**
+///
+/// The first is the boundary restatement of a clamp: `part:`/`psum:`/`sidx:` keys are
+/// fixed-width, so a part number past the grammar names records that can be written and never
+/// read back — silent loss rather than a refusal. The second is the tear from the reserve's side:
+/// the create wrote the session and the counter in **one** batch, so a session with no `mpuctl`
+/// behind it means the ledger was lost, and staging bytes against an admission state that bounds
+/// nothing is exactly what the counter exists to prevent.
+#[test]
+fn the_reserve_refuses_an_unspellable_part_number_and_a_missing_ledger() {
+    pollster::block_on(async {
+        let meta = MemMeta::default();
+        create_bucket(&meta).await;
+        let mut tokens = tokens_from(0x9A11);
+        let budget = Budget::deployed();
+        let upload_id = create(&meta, &mut tokens, &budget).await;
+
+        // A budget whose part-number space is past the grammar — the shape an unchecked retune
+        // would present. The grammar bound answers before any of it is consulted.
+        let retuned = Budget {
+            max_parts_per_session: metadata::PART_NUMBER_FORMAT_MAX + 10,
+            ..budget.clone()
+        };
+        assert!(
+            matches!(
+                mpu::reserve_slot(
+                    &meta,
+                    &upload_id,
+                    metadata::PART_NUMBER_FORMAT_MAX,
+                    NOW,
+                    LEASE_TTL,
+                    "wall",
+                    None,
+                    &mut tokens,
+                    &retuned,
+                )
+                .await
+                .unwrap(),
+                mpu::ReserveOutcome::Refused(Refusal::InvalidPart {
+                    reason: InvalidPart::OutOfRange,
+                    ..
+                })
+            ),
+            "a part number the key grammar cannot spell is refused, not written"
+        );
+
+        // The tear: the ledger is gone while the session is still there.
+        meta.remove_keys(&[mpu::MPUCTL_KEY.to_vec()]);
+        let err = mpu::reserve_slot(
+            &meta,
+            &upload_id,
+            1,
+            NOW,
+            LEASE_TTL,
+            "wall",
+            None,
+            &mut tokens,
+            &budget,
+        )
+        .await
+        .expect_err("an absent ledger under a live session is a torn store");
+        assert!(
+            err.to_string().contains("admission ledger is absent"),
+            "the operator signal names the tear: {err}"
+        );
+        assert!(
+            meta.keys_with(&mpu::slot_range(&upload_id)).is_empty(),
+            "…and no slot was claimed against an admission state that bounds nothing"
+        );
+    });
+}
+
+/// **A settling read that fails too must not swallow the minted identity.**
+///
+/// The re-read after an unknown result is a *courtesy*: it settles the common case. When the
+/// store cannot answer it either, the commit is no more definite than before — so the answer is
+/// still the indeterminate one, and it must still carry the identity, because that identity is
+/// the only thing that makes the caller's obligation ("re-drive THIS id") performable. Returning
+/// the read's own error instead leaves a create that may still land holding an admission slot no
+/// client will ever name, with the counter charged twice.
+#[test]
+fn an_indeterminate_commit_whose_settling_read_fails_still_carries_its_identity() {
+    pollster::block_on(async {
+        let meta = MemMeta::default();
+        let fleet = MemFleet::default();
+        create_bucket(&meta).await;
+        let mut tokens = tokens_from(0x5EAD);
+        let budget = Budget::deployed();
+
+        // (i) the create.
+        meta.unknown_result_on_next_commit(1, true);
+        meta.fail_reads_of(mpu::MPU_PREFIX);
+        let err = mpu::create_session(
+            &meta,
+            &CreateParams {
+                bucket: BUCKET,
+                parent: ROOT,
+                object: OBJECT,
+                content_type: None,
+                created_at_millis: NOW,
+                clock_source: "wall",
+                budget: budget.clone(),
+                resume: None,
+            },
+            &mut tokens,
+            CreateRetry::default(),
+            || 0,
+            |_, _| async {},
+        )
+        .await
+        .expect_err("an unknown create result is not a definite outcome");
+        meta.stop_failing_reads();
+        let indeterminate = err
+            .downcast_ref::<mpu::IndeterminateCommit>()
+            .expect("the identity to re-drive with must reach the caller");
+        let (upload_id, group_nonce) = match &indeterminate.identity {
+            mpu::MintedIdentity::Session {
+                upload_id,
+                group_nonce,
+            } => (upload_id.clone(), group_nonce.clone()),
+            other => panic!("a create mints a session identity, not {other:?}"),
+        };
+        // The batch did land, so the re-drive ADOPTS it: one session, one increment.
+        let resumed = mpu::create_session(
+            &meta,
+            &CreateParams {
+                bucket: BUCKET,
+                parent: ROOT,
+                object: OBJECT,
+                content_type: None,
+                created_at_millis: NOW,
+                clock_source: "wall",
+                budget: budget.clone(),
+                resume: Some(mpu::SessionIdentity {
+                    upload_id: &upload_id,
+                    group_nonce: &group_nonce,
+                }),
+            },
+            &mut tokens,
+            CreateRetry::default(),
+            || 0,
+            |_, _| async {},
+        )
+        .await
+        .unwrap();
+        assert!(matches!(resumed, CreateOutcome::Created(_)));
+        assert_eq!(count(&meta).await, 1, "one client request, one admission");
+        assert_eq!(meta.keys_with(mpu::MPU_PREFIX).len(), 1);
+
+        // (ii) the slot reserve, one namespace over.
+        meta.unknown_result_on_next_commit(1, true);
+        meta.fail_reads_of(mpu::SLOT_PREFIX);
+        let err = mpu::reserve_slot(
+            &meta,
+            &upload_id,
+            1,
+            NOW,
+            LEASE_TTL,
+            "wall",
+            None,
+            &mut tokens,
+            &budget,
+        )
+        .await
+        .expect_err("an unknown reserve result is not a definite outcome");
+        meta.stop_failing_reads();
+        let attempt_id = err
+            .downcast_ref::<mpu::IndeterminateCommit>()
+            .and_then(mpu::IndeterminateCommit::attempt_id)
+            .expect("the attempt id to re-drive with must reach the caller")
+            .to_string();
+        let mut part = match mpu::reserve_slot(
+            &meta,
+            &upload_id,
+            1,
+            NOW,
+            LEASE_TTL,
+            "wall",
+            Some(&attempt_id),
+            &mut tokens,
+            &budget,
+        )
+        .await
+        .unwrap()
+        {
+            mpu::ReserveOutcome::Reserved(part) => *part,
+            other => panic!("the re-drive must adopt its own slot, not {other:?}"),
+        };
+        assert_eq!(
+            meta.keys_with(&mpu::slot_range(&upload_id)).len(),
+            1,
+            "the re-drive adopted the slot that landed instead of claiming a second index"
+        );
+        assert_eq!(part.attempt_id, attempt_id);
+        assert_eq!(
+            mpu::stage_chunk(
+                &meta,
+                &fleet,
+                &mut part,
+                b"body",
+                RS,
+                1,
+                &topology(),
+                NOW,
+                LEASE_TTL,
+            )
+            .await
+            .unwrap(),
+            CommitOutcome::Committed,
+            "…and the adopted handle is usable"
+        );
+        assert_no_classification_gap(&meta, &fleet, NOW).await;
+    });
+}
+
+/// **A part commits under the caps its reserve was approved with.**
+///
+/// `reserve_slot` compares the caller's budget with the ledger's profile before it claims an
+/// index, so the handle it mints is the authorization — the two record byte-strings *and* the
+/// value set. A commit that took a fresh budget would let a caller reserve under the fleet's caps
+/// and commit under larger ones of its own, which is the overrun of `MAX_SESSIONS x U_ref ≤
+/// W_ref` that no host in the fleet would observe.
+#[test]
+fn a_part_commits_under_the_caps_its_reserve_was_approved_with() {
+    pollster::block_on(async {
+        let meta = MemMeta::default();
+        let fleet = MemFleet::default();
+        create_bucket(&meta).await;
+        let mut tokens = tokens_from(0xCA95);
+        let mut ids = ids_from(0xCA95);
+        // The fleet's profile allows ONE chunk per part.
+        let fleet_profile = Budget {
+            max_part_chunks: 1,
+            ..Budget::deployed()
+        };
+        let upload_id = create(&meta, &mut tokens, &fleet_profile).await;
+        let mut part = match mpu::reserve_slot(
+            &meta,
+            &upload_id,
+            1,
+            NOW,
+            LEASE_TTL,
+            "wall",
+            None,
+            &mut tokens,
+            &fleet_profile,
+        )
+        .await
+        .unwrap()
+        {
+            mpu::ReserveOutcome::Reserved(part) => *part,
+            other => panic!("reserve refused: {other:?}"),
+        };
+        assert_eq!(
+            part.budget, fleet_profile,
+            "the handle carries the approved value set, not the caller's"
+        );
+        for _ in 0..2 {
+            assert_eq!(
+                mpu::stage_chunk(
+                    &meta,
+                    &fleet,
+                    &mut part,
+                    &[7u8; 256],
+                    RS,
+                    ids(),
+                    &topology(),
+                    NOW,
+                    LEASE_TTL,
+                )
+                .await
+                .unwrap(),
+                CommitOutcome::Committed
+            );
+        }
+        // `Budget::deployed()` would admit 165 chunks; the session's own profile admits one, and
+        // that is the one enforced.
+        assert!(Budget::deployed().max_part_chunks > 1, "fixture");
+        assert_eq!(
+            mpu::commit_part(&meta, &mut part, &[7u8; 512], NOW + 1, "wall")
+                .await
+                .unwrap(),
+            UploadPartOutcome::Refused(Refusal::EntityTooLarge {
+                chunks: 2,
+                limit: 1
+            }),
+            "the ceiling is the ledger-approved one"
+        );
+        assert!(
+            meta.keys_with(&mpu::sidx_range(&upload_id)).is_empty()
+                && meta.keys_with(&mpu::slot_range(&upload_id)).is_empty(),
+            "…and the refusal compensated its residue, so the session stays usable"
+        );
+        assert_no_classification_gap(&meta, &fleet, NOW).await;
+    });
+}
+
+/// **A part whose value would cross the ceiling is refused before it stages, and a staging
+/// refusal never leaves a slot behind.**
+///
+/// The chunk **count** ceiling is `V/2` divided by the *settled* scheme's worst-case chunk-ref,
+/// but the EC scheme — hence the placement vector's length — is the deployment's, so a
+/// count-legal part can encode past `V`. Discovering that at the commit is too late in a way that
+/// is easy to miss: the refusal's own compensation installs a `retire:bytes:` obligation carrying
+/// **the same list**, so it is over the ceiling too and cannot be written — the exit that exists
+/// to release the slot and evidence the bytes fails with the commit it was meant to clean up.
+/// So the bound is charged from the plan, and again as the list grows.
+#[test]
+fn a_part_whose_value_would_cross_the_ceiling_stages_nothing_and_leaves_no_slot() {
+    pollster::block_on(async {
+        let meta = MemMeta::default();
+        let fleet = MemFleet::default();
+        create_bucket(&meta).await;
+        let mut tokens = tokens_from(0x7A11);
+        let mut ids = ids_from(0x7A11);
+        let budget = Budget::deployed();
+        let upload_id = create(&meta, &mut tokens, &budget).await;
+        // A wide scheme on a fleet of seven-digit D-server ids: every chunk-ref carries 180
+        // placement entries, so a dozen of them encode past the value budget while the chunk
+        // COUNT stays far inside `MAX_PART_CHUNKS` (165).
+        let wide = EcScheme::ReedSolomon { k: 100, m: 80 };
+        let capacity = mpu::max_part_chunks_for(wide);
+        assert!(
+            capacity < budget.max_part_chunks as usize,
+            "fixture: the scheme's own capacity ({capacity}) must be the binding ceiling"
+        );
+        let mut wide_topology = Topology::default();
+        for id in 0u64..180 {
+            wide_topology.register(1_000_000 + id, format!("domain-{id}"));
+        }
+        let piece = 400usize;
+        let body = vec![9u8; piece * (capacity + 2)];
+
+        // (i) the verb decides it from the plan: nothing staged, no slot claimed.
+        let outcome = mpu::upload_part(
+            &meta,
+            &fleet,
+            &upload_id,
+            1,
+            &body,
+            piece,
+            wide,
+            &wide_topology,
+            &mut || NOW,
+            "wall",
+            LEASE_TTL,
+            &mut tokens,
+            &mut ids,
+            &budget,
+        )
+        .await
+        .unwrap();
+        match outcome {
+            UploadPartOutcome::Refused(Refusal::PartValueTooLarge { bytes, limit }) => {
+                assert!(
+                    bytes > limit,
+                    "the refusal names the overrun: {bytes}/{limit}"
+                );
+            }
+            other => panic!("an over-value part is a typed refusal, not {other:?}"),
+        }
+        assert!(
+            body.len().div_ceil(piece) <= budget.max_part_chunks as usize,
+            "fixture: the CHUNK COUNT is legal, so only the byte ceiling can refuse this part"
+        );
+        assert!(
+            meta.keys_with(&mpu::sidx_range(&upload_id)).is_empty()
+                && meta.keys_with(&mpu::slot_range(&upload_id)).is_empty()
+                && meta.keys_with(b"orphan:").is_empty(),
+            "an over-value part stages nothing at all: no owned entry, no slot, no evidence"
+        );
+
+        // (ii) the primitive refuses the chunk that would cross the budget, leaving everything
+        // already staged intact and still owned — the caller may still commit what it has.
+        let mut part = match mpu::reserve_slot(
+            &meta,
+            &upload_id,
+            1,
+            NOW,
+            LEASE_TTL,
+            "wall",
+            None,
+            &mut tokens,
+            &budget,
+        )
+        .await
+        .unwrap()
+        {
+            mpu::ReserveOutcome::Reserved(part) => *part,
+            other => panic!("reserve refused: {other:?}"),
+        };
+        let mut staged = 0usize;
+        let err = loop {
+            match mpu::stage_chunk(
+                &meta,
+                &fleet,
+                &mut part,
+                &[9u8; 400],
+                wide,
+                ids(),
+                &wide_topology,
+                NOW,
+                LEASE_TTL,
+            )
+            .await
+            {
+                Ok(outcome) => {
+                    assert_eq!(outcome, CommitOutcome::Committed);
+                    staged += 1;
+                    // The accumulated check measures the list as it really encodes, so it binds
+                    // later than the plan's worst-case estimate — but bind it must, and well
+                    // inside the part-record count ceiling.
+                    assert!(
+                        staged <= mpu::MAX_PART_CHUNKS,
+                        "the value budget must bind before the count ceiling does"
+                    );
+                }
+                Err(err) => break err,
+            }
+        };
+        assert!(
+            err.to_string().contains("past the"),
+            "the refusal names the budget: {err}"
+        );
+        assert_eq!(
+            meta.keys_with(&mpu::sidx_range(&upload_id)).len(),
+            staged,
+            "the refused chunk wrote no owned entry, and the staged ones are untouched"
+        );
+        assert_no_classification_gap(&meta, &fleet, NOW).await;
+        // What is staged still commits, and its record is readable — the ceiling refused a
+        // chunk, not the part.
+        let committed = mpu::commit_part(
+            &meta,
+            &mut part,
+            &vec![9u8; piece * staged],
+            NOW + 1,
+            "wall",
+        )
+        .await
+        .unwrap();
+        assert!(matches!(committed, UploadPartOutcome::Committed { .. }));
+        assert_eq!(
+            mpu::read_parts(&meta, &upload_id).await.unwrap()[&1]
+                .chunks
+                .len(),
+            staged
+        );
+        assert_no_classification_gap(&meta, &fleet, NOW + 1).await;
+    });
+}
+
+/// **A staging error compensates its own residue before it propagates.**
+///
+/// `UploadPart` holds a slot from before its first byte. An error mid-part that returned bare
+/// would leave that slot — and any owned entries — on a session that is still `Open`, where
+/// nothing walks the owned range: one of `MAX_INFLIGHT_PARTS` gone per attempt, which a client
+/// that retries turns into a permanent `503` on a session the protocol calls usable.
+#[test]
+fn a_staging_error_releases_the_slot_it_was_holding() {
+    pollster::block_on(async {
+        let meta = MemMeta::default();
+        let fleet = MemFleet::default();
+        create_bucket(&meta).await;
+        let mut tokens = tokens_from(0x51E7);
+        let mut ids = ids_from(0x51E7);
+        let budget = Budget::deployed();
+        let upload_id = create(&meta, &mut tokens, &budget).await;
+        // A fanout no reclamation batch could ever evidence: refused inside the staging loop,
+        // after the slot is claimed.
+        let unreclaimable = EcScheme::ReedSolomon {
+            k: (mpu::MAX_STAGED_FRAGMENTS / 2) as u8 + 1,
+            m: 255,
+        };
+        let err = mpu::upload_part(
+            &meta,
+            &fleet,
+            &upload_id,
+            1,
+            b"body",
+            1_024,
+            unreclaimable,
+            &topology(),
+            &mut || NOW,
+            "wall",
+            LEASE_TTL,
+            &mut tokens,
+            &mut ids,
+            &budget,
+        )
+        .await
+        .expect_err("a chunk that could never be reclaimed must not be staged");
+        assert!(err.to_string().contains("cannot be reclaimed in one batch"));
+        assert!(
+            meta.keys_with(&mpu::slot_range(&upload_id)).is_empty(),
+            "the slot this attempt held is released, so the session stays usable"
+        );
+        assert!(meta.keys_with(&mpu::sidx_range(&upload_id)).is_empty());
+        // …and the session really is still usable.
+        assert!(matches!(
+            put_part(
+                &meta,
+                &fleet,
+                &upload_id,
+                1,
+                b"ordinary",
+                &mut tokens,
+                &mut ids,
+                &budget
+            )
+            .await,
+            UploadPartOutcome::Committed { .. }
+        ));
+        assert_no_classification_gap(&meta, &fleet, NOW).await;
+    });
+}
+
+/// **A re-uploaded empty part installs no obligation, because an empty one is undrainable.**
+///
+/// A zero-length part is legal and commits an empty chunk list. Superseding it owes nothing —
+/// and an *empty* `retire:bytes:` obligation is not a harmless no-op: its own decode rejects it,
+/// so the record sits in the session's range for ever, its drain fails on every pass, and the
+/// terminal delete (the `mpuctl` decrement) never fires.
+#[test]
+fn a_re_uploaded_empty_part_leaves_no_undrainable_obligation() {
+    pollster::block_on(async {
+        let meta = MemMeta::default();
+        let fleet = MemFleet::default();
+        create_bucket(&meta).await;
+        let mut tokens = tokens_from(0x0E97);
+        let mut ids = ids_from(0x0E97);
+        let budget = Budget::deployed();
+        let upload_id = create(&meta, &mut tokens, &budget).await;
+        let before = count(&meta).await;
+
+        // An empty part, then the same part number again with a body.
+        assert!(matches!(
+            put_part(
+                &meta,
+                &fleet,
+                &upload_id,
+                1,
+                b"",
+                &mut tokens,
+                &mut ids,
+                &budget
+            )
+            .await,
+            UploadPartOutcome::Committed { .. }
+        ));
+        assert!(matches!(
+            put_part(
+                &meta,
+                &fleet,
+                &upload_id,
+                1,
+                b"re-uploaded",
+                &mut tokens,
+                &mut ids,
+                &budget
+            )
+            .await,
+            UploadPartOutcome::Committed { .. }
+        ));
+        for key in meta.keys_with(b"retire:") {
+            let value = meta.get(&key).await.unwrap().unwrap();
+            metadata::decode::<metadata::RetireObligation>(&value).unwrap_or_else(|err| {
+                panic!(
+                    "every obligation this protocol writes must be drainable: {} — {err}",
+                    String::from_utf8_lossy(&key)
+                )
+            });
+        }
+
+        // And the teardown really does converge, which is what the undrainable record blocked.
+        assert!(matches!(
+            mpu::abort(&meta, &upload_id, NOW + 2, "wall")
+                .await
+                .unwrap(),
+            AbortOutcome::Fenced
+        ));
+        let report = mpu::teardown_session(&meta, &upload_id, NOW + 3, &tiny_budget())
+            .await
+            .unwrap();
+        assert!(report.terminal_deleted && report.count_decremented);
+        assert_eq!(count(&meta).await, before - 1);
+        assert!(meta.keys_with(b"retire:").is_empty());
+        assert_no_classification_gap(&meta, &fleet, NOW + 3).await;
+    });
+}
+
+/// **An indeterminate Complete fence is re-drivable — the one resume 0016 allows.**
+///
+/// The fence has no client-visible resume: if it lands after the caller gave up, every verb
+/// answers `OperationAborted` and the only other exit is the reaper's `W_completing`, which is
+/// #625's and is not running when this slice merges. So an unknown fence result reports the
+/// **fence value** it minted, and a re-drive presenting those bytes adopts the session it fenced
+/// — matched on the record's exact bytes, which no rival publisher's fence can equal.
+#[test]
+fn an_indeterminate_complete_fence_is_re_drivable_by_its_own_publisher() {
+    pollster::block_on(async {
+        let meta = MemMeta::default();
+        let fleet = MemFleet::default();
+        create_bucket(&meta).await;
+        let mut tokens = tokens_from(0xFE0C);
+        let mut ids = ids_from(0xFE0C);
+        let budget = Budget::deployed();
+        let upload_id = create(&meta, &mut tokens, &budget).await;
+        let body = vec![b'f'; CHUNK + 5];
+        assert!(matches!(
+            put_part(
+                &meta,
+                &fleet,
+                &upload_id,
+                1,
+                &body,
+                &mut tokens,
+                &mut ids,
+                &budget
+            )
+            .await,
+            UploadPartOutcome::Committed { .. }
+        ));
+        let named = vec![(1u32, part_digest(&body))];
+
+        // The fence commit lands, but the store cannot say so — and cannot answer the settling
+        // read either. The read failure is armed to start **after** that commit, so Complete's
+        // own opening read still works and the only broken read is the one that would have
+        // settled the unknown result.
+        meta.unknown_result_on_next_commit(1, true);
+        meta.fail_reads_of_after(1, mpu::MPU_PREFIX);
+        let err = mpu::complete(
+            &meta,
+            &CompleteParams {
+                upload_id: &upload_id,
+                named: &named,
+                now_millis: NOW + 1,
+                clock_source: "wall",
+                budget: &budget,
+                resume: None,
+            },
+            &mut || 9u64,
+        )
+        .await
+        .expect_err("an unknown fence result is not a definite outcome");
+        meta.stop_failing_reads();
+        let fence_bytes = err
+            .downcast_ref::<mpu::IndeterminateCommit>()
+            .and_then(mpu::IndeterminateCommit::fence_bytes)
+            .expect("the fence value to re-drive with must reach the caller")
+            .clone();
+
+        // The fence DID land, so the session is now in the state no client verb can leave.
+        let session = mpu::read_session(&meta, &upload_id).await.unwrap().unwrap();
+        assert_eq!(session.state(), SessionState::Completing);
+        assert!(matches!(
+            mpu::complete(
+                &meta,
+                &CompleteParams {
+                    upload_id: &upload_id,
+                    named: &named,
+                    now_millis: NOW + 2,
+                    clock_source: "wall",
+                    budget: &budget,
+                    resume: None,
+                },
+                &mut || 9u64,
+            )
+            .await
+            .unwrap(),
+            CompleteOutcome::Refused(Refusal::OperationAborted)
+        ));
+
+        // The owning publisher, presenting the fence it minted, publishes.
+        let published = mpu::complete(
+            &meta,
+            &CompleteParams {
+                upload_id: &upload_id,
+                named: &named,
+                now_millis: NOW + 3,
+                clock_source: "wall",
+                budget: &budget,
+                resume: Some(&fence_bytes),
+            },
+            &mut || 9u64,
+        )
+        .await
+        .unwrap();
+        let publication = match published {
+            CompleteOutcome::Published(publication) => *publication,
+            other => panic!("the re-drive publishes, not {other:?}"),
+        };
+        assert_eq!(publication.etag, expected_etag(&[&body]));
+        let read_back = read::read_path(&meta, &fleet, ROOT, OBJECT).await.unwrap();
+        assert_eq!(
+            read_back,
+            Some(body.clone()),
+            "the published bytes are the part's own"
+        );
+        assert_no_classification_gap(&meta, &fleet, NOW + 3).await;
+    });
+}
+
+/// **A release that lost its CAS never rolls back a fence that is not ours.**
+///
+/// The retry exists for one interleaving — this attempt's own segment batches moved the record it
+/// pinned — and `Completing` alone cannot tell that apart from "our fence was rolled back and a
+/// rival fenced afresh". Releasing then would abort a publisher that is mid-publication on the
+/// authority of an error belonging to a request that is already over. The fence epoch is the
+/// identity, exactly as the publish retry's own re-read uses it.
+#[test]
+fn a_release_after_a_lost_cas_never_rolls_back_another_publisher() {
+    pollster::block_on(async {
+        let meta = MemMeta::default();
+        let fleet = MemFleet::default();
+        create_bucket(&meta).await;
+        let mut tokens = tokens_from(0x9E1E);
+        let mut ids = ids_from(0x9E1E);
+        let budget = Budget::deployed();
+        let upload_id = create(&meta, &mut tokens, &budget).await;
+        let body = vec![b'r'; 600];
+        assert!(matches!(
+            put_part(
+                &meta,
+                &fleet,
+                &upload_id,
+                1,
+                &body,
+                &mut tokens,
+                &mut ids,
+                &budget
+            )
+            .await,
+            UploadPartOutcome::Committed { .. }
+        ));
+
+        // A rival's fence, at a LATER epoch, lands in the window between this caller's fence and
+        // the release its invalid part list forces. `skip = 1` aims it past the fence commit.
+        let session = mpu::read_session(&meta, &upload_id).await.unwrap().unwrap();
+        let rival = mpu::SessionRecord {
+            state: SessionState::Completing,
+            epoch: session.record.epoch + 7,
+            attempts: session.record.attempts + 1,
+            fenced_at_millis: Some(NOW + 5),
+            segments_written: Some(0),
+            publish_target: Some(mpu::PublishTarget {
+                parent: ROOT,
+                name: OBJECT.to_string(),
+                fence_epoch: session.record.epoch + 7,
+            }),
+            ..session.record.clone()
+        };
+        let rival_bytes = metadata::encode(&rival);
+        meta.inject_before_commit_after(1, vec![(mpu::mpu_key(&upload_id), rival_bytes.clone())]);
+
+        // This caller names a part that does not exist: refused past the fence, so it releases.
+        let outcome = mpu::complete(
+            &meta,
+            &CompleteParams {
+                upload_id: &upload_id,
+                named: &[(9u32, part_digest(&body))],
+                now_millis: NOW + 1,
+                clock_source: "wall",
+                budget: &budget,
+                resume: None,
+            },
+            &mut || 9u64,
+        )
+        .await
+        .unwrap();
+        assert!(matches!(
+            outcome,
+            CompleteOutcome::Refused(Refusal::InvalidPart { part_number: 9, .. })
+        ));
+        assert_eq!(
+            meta.get(&mpu::mpu_key(&upload_id)).await.unwrap(),
+            Some(rival_bytes),
+            "the rival publisher's fence is untouched: a finished request may not roll it back"
+        );
+        assert_no_classification_gap(&meta, &fleet, NOW + 1).await;
+    });
+}
+
+/// **An owned entry that cannot fit one batch is named, never committed over the envelope — and
+/// no staged chunk of this protocol's making can be one.**
+///
+/// The entry is the indivisible unit of `reclaim_owned`: its marks are the EC fanout, not an O(1)
+/// unit, so committing an over-envelope batch hands the backend one it must reject on every
+/// attempt — the walk re-derives the same shape for ever, the session is never torn down and its
+/// admission slot is never returned. The fanout is therefore bounded **before the intent**, and a
+/// budget below one legal entry's cost is an error rather than a batch that cannot commit.
+#[test]
+fn an_owned_entry_that_cannot_fit_one_batch_is_named_not_committed() {
+    pollster::block_on(async {
+        let meta = MemMeta::default();
+        let fleet = MemFleet::default();
+        create_bucket(&meta).await;
+        let mut tokens = tokens_from(0x0B16);
+        let budget = Budget::deployed();
+        let upload_id = create(&meta, &mut tokens, &budget).await;
+        let mut part = match mpu::reserve_slot(
+            &meta,
+            &upload_id,
+            1,
+            NOW,
+            LEASE_TTL,
+            "wall",
+            None,
+            &mut tokens,
+            &budget,
+        )
+        .await
+        .unwrap()
+        {
+            mpu::ReserveOutcome::Reserved(part) => *part,
+            other => panic!("reserve refused: {other:?}"),
+        };
+        // A fanout wider than one reclaim batch could evidence: refused before the intent, so
+        // not one fragment and not one record is written.
+        let too_wide = EcScheme::ReedSolomon {
+            k: (mpu::MAX_STAGED_FRAGMENTS / 2) as u8 + 1,
+            m: 255,
+        };
+        let err = mpu::stage_chunk(
+            &meta,
+            &fleet,
+            &mut part,
+            b"wide",
+            too_wide,
+            1,
+            &topology(),
+            NOW,
+            LEASE_TTL,
+        )
+        .await
+        .expect_err("a chunk that could never be reclaimed must not be staged");
+        assert!(
+            err.to_string().contains("cannot be reclaimed in one batch"),
+            "the refusal names the reason: {err}"
+        );
+        assert!(meta.keys_with(&mpu::sidx_range(&upload_id)).is_empty());
+
+        // A legal chunk, and then a caller budget below the cost of reclaiming it: the walk says
+        // so rather than committing a batch the backend must reject on every attempt.
+        assert_eq!(
+            mpu::stage_chunk(
+                &meta,
+                &fleet,
+                &mut part,
+                b"legal",
+                RS,
+                2,
+                &topology(),
+                NOW,
+                LEASE_TTL,
+            )
+            .await
+            .unwrap(),
+            CommitOutcome::Committed
+        );
+        assert!(matches!(
+            mpu::abort(&meta, &upload_id, NOW + 1, "wall")
+                .await
+                .unwrap(),
+            AbortOutcome::Fenced
+        ));
+        let starved = DrainBudget {
+            max_batch_bytes: 4_000,
+            max_batch_ops: 4,
+        };
+        let mut report = mpu::DrainReport::default();
+        let err = mpu::reclaim_owned(&meta, &upload_id, NOW + 2, &starved, &mut report)
+            .await
+            .expect_err("a batch that could never commit is not a batch to commit");
+        assert!(
+            err.to_string().contains("could never commit"),
+            "the operator signal names the impossibility: {err}"
+        );
+        assert_eq!(meta.keys_with(&mpu::sidx_range(&upload_id)).len(), 1);
+        assert_eq!(report.owned_reclaimed, 0);
+        // At the real envelope the same entry reclaims in one batch.
+        let mut report = mpu::DrainReport::default();
+        mpu::reclaim_owned(&meta, &upload_id, NOW + 3, &tiny_budget(), &mut report)
+            .await
+            .unwrap();
+        assert_eq!(report.owned_reclaimed, 1);
+        assert!(meta.keys_with(&mpu::sidx_range(&upload_id)).is_empty());
+        assert_no_classification_gap(&meta, &fleet, NOW + 3).await;
+    });
+}
