+/// The terminal delete is preconditioned on the session record's **exact bytes**, which is
+/// what makes the `mpuctl.count` decrement exactly-once when a gateway drain and the reaper
+/// both reach it (`0016:581-590`).
+#[test]
+fn h_terminal_delete_is_preconditioned_on_the_sessions_exact_bytes() {
+    pollster::block_on(async {
+        let meta = MemMeta::default();
+        let fleet = MemFleet::default();
+        let budget = budget_for(4);
+        let mut tokens = tokens_from(0xb0);
+        create_bucket(&meta).await;
+        let upload_id = create(&meta, &mut tokens, &budget).await;
+        assert_eq!(
+            mpu::abort(&meta, &upload_id, NOW + 1, "wall")
+                .await
+                .unwrap(),
+            AbortOutcome::Fenced
+        );
+        // A stale snapshot: read the session, then move it under the reader.
+        let stale = mpu::read_session(&meta, &upload_id).await.unwrap().unwrap();
+        let mut moved = stale.record.clone();
+        moved.epoch += 1;
+        meta.commit(
+            stale
+                .fence(WriteBatch::new())
+                .put(stale.key(), metadata::encode(&moved)),
+        )
+        .await
+        .unwrap();
+
+        let before = count(&meta).await;
+        let mut report = mpu::DrainReport::default();
+        // Drain the teardown obligation first, so the ONLY gate left is the session-bytes CAS
+        // this leg is about — otherwise a `false` here would prove the emptiness gate, not the
+        // precondition.
+        let obligation = meta
+            .keys_with(&mpu::retire_session_range(
+                mpu::RetireMode::Bytes,
+                &upload_id,
+            ))
+            .into_iter()
+            .next()
+            .expect("the abort fence installs the teardown obligation");
+        mpu::drain_obligation(&meta, &obligation, NOW + 2, &tiny_budget(), &mut report)
+            .await
+            .unwrap();
+
+        let fired = mpu::terminal_delete(&meta, &stale, &mut report)
+            .await
+            .unwrap();
+        assert!(
+            !fired,
+            "a terminal delete against stale session bytes must lose its CAS — the whole \
+             batch is a no-op, so the counter can never double-decrement"
+        );
+        assert_eq!(count(&meta).await, before);
+        assert!(mpu::read_session(&meta, &upload_id)
+            .await
+            .unwrap()
+            .is_some());
+        assert!(!report.count_decremented);
+
+        // The fresh snapshot wins, exactly once.
+        let fresh = mpu::read_session(&meta, &upload_id).await.unwrap().unwrap();
+        assert!(mpu::terminal_delete(&meta, &fresh, &mut report)
+            .await
+            .unwrap());
+        assert_eq!(count(&meta).await, before - 1);
+        assert_no_classification_gap(&meta, &fleet, NOW).await;
+    });
+}
