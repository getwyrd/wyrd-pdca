+            RetirePayload::Chunks { chunks: Vec::new() },
+            RetirePayload::Generation {
+                inode: 1,
+                version: 1,
+                chunks: Vec::new(),
+                segments: None,
+            },
+        ] {
+            assert!(payload.is_valid_for(RetireMode::Bytes));
+            assert!(!payload.is_valid_for(RetireMode::Records));
+        }
+        let records = RetirePayload::Records {
+            parts: None,
+            segments: None,
+        };
+        assert!(records.is_valid_for(RetireMode::Records));
+        assert!(!records.is_valid_for(RetireMode::Bytes));
+    }
+
+    #[test]
+    fn a_legacy_drain_cursor_round_trips_byte_identically() {
+        // `frag` and `arm` are additive: a cursor written before either existed must decode and
+        // re-encode unchanged, or a drain step that re-read its own obligation would `Conflict`
+        // against bytes it wrote itself (`AGENTS.md:170-174`).
+        let legacy = br#"{"phase":"Marking","outer":3,"inner":2}"#;
+        let cursor: RetireCursor = metadata::decode(legacy).unwrap();
+        assert_eq!(cursor.frag, 0);
+        assert_eq!(cursor.arm, 0);
+        assert_eq!(metadata::encode(&cursor).as_ref(), legacy);
+
+        // …and a cursor that *does* select a second delete space says so, so the two spaces
+        // are distinguishable in the record rather than inferred from `outer`.
+        let armed = RetireCursor {
+            phase: DrainPhase::Deleting,
+            outer: 0,
+            inner: 0,
+            frag: 0,
+            arm: 1,
+        };
+        let bytes = metadata::encode(&armed);
+        assert_eq!(
+            String::from_utf8_lossy(&bytes),
+            r#"{"phase":"Deleting","outer":0,"inner":0,"arm":1}"#
+        );
+        assert_eq!(metadata::decode::<RetireCursor>(&bytes).unwrap(), armed);
+    }
+
+    /// **The part-number set is validated at decode**, because every way it can be malformed is
+    /// a way the drain skips work it is about to declare done: a reversed run underflows `len`,
+    /// an unordered one makes the cursor's `first_at_or_after` skip members, an out-of-range one
+    /// names a `part:` key the fixed-width grammar cannot spell, and a non-canonical (abutting)
+    /// spelling breaks the `decode → encode` identity the obligation's own CAS rests on.
+    #[test]
+    fn a_part_number_set_decodes_only_canonical_in_range_runs() {
+        for malformed in [
+            br#"[[5,3]]"#.as_slice(),       // reversed
+            br#"[[0,3]]"#.as_slice(),       // part numbers are 1-based
+            br#"[[1,2],[2,4]]"#.as_slice(), // overlapping
+            br#"[[1,2],[3,4]]"#.as_slice(), // abutting: the same set, spelled non-canonically
+            br#"[[7,9],[1,2]]"#.as_slice(), // descending
+            br#"[[1,100000]]"#.as_slice(),  // past the key grammar
+        ] {
+            assert!(
+                metadata::decode::<PartNumberSet>(malformed).is_err(),
+                "{} must not decode",
+                String::from_utf8_lossy(malformed)
+            );
+        }
+        let canonical = PartNumberSet::from_iter_unsorted([1, 2, 3, 7, 9]);
+        let bytes = metadata::encode(&canonical);
+        assert_eq!(String::from_utf8_lossy(&bytes), "[[1,3],[7,7],[9,9]]");
+        assert_eq!(
+            metadata::decode::<PartNumberSet>(&bytes).unwrap(),
+            canonical,
+            "the canonical spelling round-trips",
+        );
+        assert_eq!(canonical.len(), 5);
+    }
+
+    /// **An obligation decodes only in shapes a writer in this crate can produce.** Each shape
+    /// below is one whose *effect* is a drain that owes less than the payload names and then
+    /// deletes the record that was the only thing protecting those bytes.
+    #[test]
+    fn a_retire_obligation_decodes_only_shapes_a_writer_can_produce() {
+        let nonce = "a".repeat(32);
+        for malformed in [
+            // a generation naming BOTH a flat list and a seg: generation: the marking walk takes
+            // one arm, so the other's fragments are never evidenced
+            format!(
+                r#"{{"payload":{{"Generation":{{"inode":1,"version":2,"chunks":[{{"id":1,"len":8,"scheme":"None","placement":[0]}}],"segments":{{"nonce":"{nonce}","epoch":3}}}}}}}}"#
+            ),
+            // obligations that owe nothing at all
+            r#"{"payload":{"Chunks":{"chunks":[]}}}"#.to_string(),
+            r#"{"payload":{"Parts":{"parts":[]}}}"#.to_string(),
+            r#"{"payload":{"Records":{}}}"#.to_string(),
+            // a nonce that could not key a reproducible `seg:` range
+            r#"{"payload":{"Records":{"segments":{"nonce":"NOTHEX","epoch":1}}}}"#.to_string(),
+            // a marking cursor selecting a delete-space arm the marking walk does not have
+            r#"{"payload":{"Session":{}},"cursor":{"phase":"Marking","outer":0,"inner":0,"arm":1}}"#
+                .to_string(),
+            // an arm past the payload's own spaces
+            r#"{"payload":{"Session":{}},"cursor":{"phase":"Deleting","outer":0,"inner":0,"arm":1}}"#
+                .to_string(),
+        ] {
+            assert!(
+                metadata::decode::<RetireObligation>(malformed.as_bytes()).is_err(),
+                "{malformed} must not decode",
+            );
+        }
+        // The two-space shape 0016 permits — published parts **and** a rolled-back attempt's
+        // dangling segments — decodes, with its arm.
+        let both = format!(
+            r#"{{"payload":{{"Records":{{"parts":[[1,2]],"segments":{{"nonce":"{nonce}","epoch":3}}}}}},"cursor":{{"phase":"Deleting","outer":0,"inner":0,"arm":1}}}}"#
+        );
+        let obligation: RetireObligation = metadata::decode(both.as_bytes()).unwrap();
+        assert_eq!(
+            obligation.payload.delete_spaces(),
+            vec![DeleteSpace::Parts, DeleteSpace::Segments],
+            "two independent index spaces, walked one after the other",
+        );
+    }
+
+    /// A `retire:` key's tokens are held to the **128-bit token grammar** its writers use: the
+    /// upload id keys the very ranges the drain enumerates, so anything else names ranges that
+    /// are empty because the id is wrong, not because the work is done.
+    #[test]
+    fn a_retire_key_is_parsed_with_its_token_grammar() {
+        let id = "b".repeat(32);
+        let attempt = "c".repeat(32);
+        assert!(parse_retire_key(format!("retire:bytes:s:{id}:4").as_bytes()).is_ok());
+        assert!(parse_retire_key(format!("retire:bytes:s:{id}:4:7:{attempt}").as_bytes()).is_ok());
+        for malformed in [
+            "retire:bytes:s:not-a-token:4".to_string(),
+            format!("retire:bytes:s:{id}:4:7:not-a-token"),
+            format!("retire:bytes:s:{}:4", "B".repeat(32)),
+            format!("retire:bytes:s:{id}:4:0:{attempt}"),
+            format!("retire:bytes:s:{id}:4:100000:{attempt}"),
+        ] {
+            assert!(
+                parse_retire_key(malformed.as_bytes()).is_err(),
+                "{malformed} must not parse",
+            );
+        }
+    }
+
+    /// **The key's identity must be able to own the value's payload.** The mode cross-check
+    /// alone lets a `Session` payload ride a *generation* token, whose walk then enumerates a
+    /// part range keyed by an upload id the token does not have — empty for the wrong reason,
+    /// and the obligation deleted on the strength of it.
+    #[test]
+    fn payload_and_token_identity_are_cross_checked() {
+        let session = RetireToken::Session {
+            upload_id: "d".repeat(32),
+            epoch: 3,
+            part: None,
+        };
+        let per_part = RetireToken::Session {
+            upload_id: "d".repeat(32),
+            epoch: 3,
+            part: Some((7, "e".repeat(32))),
+        };
+        let generation = RetireToken::Generation {
+            inode: 4,
+            version: 9,
+        };
+        let generation_payload = |inode, version| RetirePayload::Generation {
+            inode,
+            version,
+            chunks: Vec::new(),
+            segments: None,
+        };
+        assert!(payload_matches_token(&session, &RetirePayload::Session {}));
+        assert!(payload_matches_token(
+            &per_part,
+            &RetirePayload::Chunks { chunks: Vec::new() }
+        ));
+        assert!(payload_matches_token(
+            &generation,
+            &generation_payload(4, 9)
+        ));
+        // A session payload under a generation token, a per-part token owning a whole session's
+        // teardown, and a generation payload naming a *different* generation.
+        assert!(!payload_matches_token(
+            &generation,
+            &RetirePayload::Session {}
+        ));
+        assert!(!payload_matches_token(
+            &per_part,
+            &RetirePayload::Session {}
+        ));
+        assert!(!payload_matches_token(
+            &generation,
+            &generation_payload(4, 10)
+        ));
+        assert!(!payload_matches_token(&session, &generation_payload(4, 9)));
+    }
+
+    /// The knob validator bounds the part-number space by the **key grammar** before any
+    /// capacity clamp: a part number the fixed-width `part:` key cannot spell would be accepted
+    /// at reserve and unreadable ever after.
+    #[test]
+    fn the_knob_validator_bounds_the_part_number_space_by_its_key_grammar() {
+        let mut budget = Budget::deployed();
+        budget.max_parts_per_session = PART_NUMBER_FORMAT_MAX;
+        let message = knob_clamps_hold(&budget).expect_err("the grammar bound must be enforced");
+        assert!(message.contains("MAX_PARTS_PER_SESSION"), "{message}");
+        budget.max_parts_per_session = 0;
+        assert!(knob_clamps_hold(&budget).is_err());
+        budget.max_parts_per_session = PART_NUMBER_FORMAT_MAX - 1;
+        assert!(
+            knob_clamps_hold(&budget).is_ok(),
+            "the largest spellable part number is legal",
+        );
+    }
+
+    #[test]
+    fn session_state_field_rules_fail_closed() {
+        let mut record = SessionRecord {
+            bucket: "b".into(),
+            parent: 0,
+            object: "k".into(),
+            content_type: None,
+            created_at_millis: 1,
+            clock_source: "wall".into(),
+            state: SessionState::Open,
+            epoch: 0,
+            attempts: 0,
+            group_nonce: "0123456789abcdef0123456789abcdef".into(),
+            fenced_at_millis: None,
+            segments_written: None,
+            publish_target: None,
+            completion: None,
+        };
+        assert!(decode_session(&metadata::encode(&record)).is_ok());
+        record.fenced_at_millis = Some(9);
+        assert!(decode_session(&metadata::encode(&record)).is_err());
+    }
+}
