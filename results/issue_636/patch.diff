+/// **An ambiguous slot reserve is settled by re-reading, never by claiming a second index**
+/// (X68, `0016:1697-1717`): a re-drive carrying its own `attempt_id` adopts the slot that landed.
+#[test]
+fn an_ambiguous_slot_reserve_adopts_its_own_landed_slot() {
+    pollster::block_on(async {
+        let meta = MemMeta::default();
+        create_bucket(&meta).await;
+        let mut tokens = tokens_from(0xF000);
+        let budget = Budget::deployed();
+        let upload_id = create(&meta, &mut tokens, &budget).await;
