+/// **One clock per correctness lifecycle** (`AGENTS.md:131-142`, X106): a verb offering a
+/// different clock source than the session was stamped under is refused, not silently mixed in.
+#[test]
+fn a_foreign_clock_source_is_refused_by_every_stamping_verb() {
+    pollster::block_on(async {
+        let meta = MemMeta::default();
+        let fleet = MemFleet::default();
+        create_bucket(&meta).await;
+        let mut tokens = tokens_from(0xE000);
+        let mut ids = ids_from(0xE000);
+        let budget = Budget::deployed();
+        let upload_id = create(&meta, &mut tokens, &budget).await;
+        put_part(
+            &meta,
+            &fleet,
+            &upload_id,
+            1,
+            b"one",
+            &mut tokens,
+            &mut ids,
+            &budget,
+        )
+        .await;
+        let named = vec![(1u32, part_digest(b"one"))];
+
+        assert!(
+            mpu::reserve_slot(
+                &meta,
+                &upload_id,
+                2,
+                NOW,
+                LEASE_TTL,
+                "logical",
+                None,
+                &mut tokens,
+                &budget,
+            )
+            .await
+            .is_err(),
+            "a slot stamped from another clock epoch must be refused"
+        );
+        assert!(
+            mpu::complete(
+                &meta,
+                &CompleteParams {
+                    upload_id: &upload_id,
+                    named: &named,
+                    now_millis: NOW + 1,
+                    clock_source: "logical",
+                    budget: &budget,
+                    resume: None,
+                },
+                &mut || 9u64,
+            )
+            .await
+            .is_err(),
+            "a publication stamped from another clock epoch must be refused"
+        );
+        assert!(
+            mpu::abort(&meta, &upload_id, NOW + 2, "logical")
+                .await
+                .is_err(),
+            "a teardown fence stamped from another clock epoch must be refused"
+        );
+        // …and so must the **part commit**, which stamps `committed_at_millis` — the instant
+        // `ListParts` reports and every window is measured from. It is a public entry point, so
+        // the check belongs there rather than in whatever assembled the handle.
+        let mut part = match mpu::reserve_slot(
+            &meta,
+            &upload_id,
+            3,
+            NOW,
+            LEASE_TTL,
+            "wall",
+            None,
+            &mut tokens,
+            &budget,
+        )
+        .await
+        .unwrap()
+        {
+            mpu::ReserveOutcome::Reserved(part) => *part,
+            other => panic!("reserve refused: {other:?}"),
+        };
+        assert!(
+            mpu::commit_part(&meta, &mut part, b"three", NOW + 2, "logical")
+                .await
+                .is_err(),
+            "a part commit stamped from another clock epoch must be refused"
+        );
+        // …and so must the **lease renewal**, which writes the very expiry a reaper's idle fence
+        // judges: renewed under a second clock epoch, the lease expires — and is collected — at
+        // an instant unrelated to the one the session was stamped in, on the record whose only
+        // purpose is liveness.
+        assert_eq!(
+            mpu::stage_chunk(
+                &meta,
+                &fleet,
+                &mut part,
+                b"three",
+                RS,
+                ids(),
+                &topology(),
+                NOW,
+                LEASE_TTL,
+            )
+            .await
+            .unwrap(),
+            CommitOutcome::Committed
+        );
+        let before = part.slot_bytes.clone();
+        assert!(
+            mpu::renew_part_lease(&meta, &mut part, NOW + 2, LEASE_TTL, "logical")
+                .await
+                .is_err(),
+            "a lease renewed from another clock epoch must be refused"
+        );
+        assert_eq!(
+            part.slot_bytes, before,
+            "…and the refusal wrote nothing: the lease still says what its own clock stamped"
+        );
+        assert_eq!(
+            mpu::renew_part_lease(&meta, &mut part, NOW + 2, LEASE_TTL, "wall")
+                .await
+                .unwrap(),
+            CommitOutcome::Committed,
+            "the session's own clock renews it"
+        );
+        // Leave the session as the rest of this test expects: the part is abandoned, so its
+        // residue is compensated rather than left in flight.
+        assert_eq!(
+            mpu::commit_part(&meta, &mut part, b"three", NOW + 2, "wall")
+                .await
+                .unwrap(),
+            UploadPartOutcome::Committed {
+                part_number: 3,
+                digest: part_digest(b"three"),
+            }
+        );
+        // The session is untouched by the refusals and still usable.
+        let session = mpu::read_session(&meta, &upload_id).await.unwrap().unwrap();
+        assert_eq!(session.state(), SessionState::Open);
+        assert!(matches!(
+            mpu::complete(
+                &meta,
+                &CompleteParams {
+                    upload_id: &upload_id,
+                    named: &named,
+                    now_millis: NOW + 3,
+                    clock_source: "wall",
+                    budget: &budget,
+                    resume: None,
+                },
+                &mut || 9u64,
+            )
+            .await
+            .unwrap(),
+            CompleteOutcome::Published(_)
+        ));
+    });
+}
