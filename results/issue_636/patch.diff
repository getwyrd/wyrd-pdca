+/// Whether `token` is a well-formed 128-bit token: exactly 32 lowercase-hex characters
+/// (`0016:493-497`).
+pub fn is_token(token: &str) -> bool {
+    token.len() == metadata::SEG_NONCE_HEX_LEN
+        && token
+            .bytes()
+            .all(|b| b.is_ascii_digit() || (b'a'..=b'f').contains(&b))
+}
+
+fn require_token(token: &str) -> std::result::Result<(), RecordError> {
+    if is_token(token) {
+        Ok(())
+    } else {
+        Err(RecordError::TokenNotHex {
+            token: token.to_string(),
+        })
+    }
+}
