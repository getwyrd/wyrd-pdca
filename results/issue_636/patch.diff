+/// **A compensation that never lands is reported, not answered as a clean refusal.**
+///
+/// A post-staging refusal compensates under the session's fence. When the session is being
+/// re-fenced faster than the compensation can commit, dropping that outcome — the shape this
+/// replaces — returns a tidy `EntityTooLarge` while the slot, the owned `sidx:` entries and the
+/// staged bytes are all still there, on a session that is *still `Open`*: nothing walks an
+/// `Open` session's `sidx:` range, so no one is coming for them. Two such refusals take two of
+/// `MAX_INFLIGHT_PARTS` for good.
+#[test]
+fn a_compensation_that_never_lands_is_surfaced() {
+    pollster::block_on(async {
+        let meta = MemMeta::default();
+        let fleet = MemFleet::default();
+        create_bucket(&meta).await;
+        let mut tokens = tokens_from(0xC0FE);
+        let mut ids = ids_from(0xC0FE);
+        // The per-part ceiling this session is admitted under is ONE chunk, so the two chunks
+        // staged below are a genuine over-ceiling part. It is the ledger's profile, not a budget
+        // handed to `commit_part`: the caps a part commits under are the ones its reserve was
+        // approved with (`PartUpload::budget`), so there is no second value to disagree.
+        let tight = Budget {
+            max_part_chunks: 1,
+            ..Budget::deployed()
+        };
+        let upload_id = create(&meta, &mut tokens, &tight).await;
+
+        let mut part = match mpu::reserve_slot(
+            &meta,
+            &upload_id,
+            1,
+            NOW,
+            LEASE_TTL,
+            "wall",
+            None,
+            &mut tokens,
+            &tight,
+        )
+        .await
+        .unwrap()
+        {
+            mpu::ReserveOutcome::Reserved(part) => *part,
+            other => panic!("reserve refused: {other:?}"),
+        };
+        for _ in 0..2 {
+            assert_eq!(
+                mpu::stage_chunk(
+                    &meta,
+                    &fleet,
+                    &mut part,
+                    &[3u8; 512],
+                    RS,
+                    ids(),
+                    &topology(),
+                    NOW,
+                    LEASE_TTL,
+                )
+                .await
+                .unwrap(),
+                CommitOutcome::Committed
+            );
+        }
+
+        // A rival keeps rolling the session back to a NEWER `Open` epoch, in the window before
+        // every commit — so each compensation loses to a record its predecessor did not write.
+        meta.rebase_session_before_every_commit(&upload_id);
+        let err = mpu::commit_part(&meta, &mut part, &[3u8; 1024], NOW + 1, "wall")
+            .await
+            .expect_err("a refusal whose compensation never landed is not a clean refusal");
+        assert!(
+            err.to_string().contains("compensation never landed"),
+            "the residue must be named, not silently left: {err}"
+        );
+        meta.stop_rebasing();
+        assert!(
+            !meta.keys_with(&mpu::sidx_range(&upload_id)).is_empty(),
+            "the fixture must genuinely leave residue — otherwise this asserts nothing"
+        );
+    });
+}
