+/// **A drain step that LOST its compare-and-set is not a committed batch.**
+///
+/// The report is what the convergence and envelope legs read. Charging a batch before its
+/// outcome is known counts every conflict as a committed batch — a drain that took one batch and
+/// lost four looks like it took five, and the "largest batch" it reports may be one no store
+/// ever applied.
+#[test]
+fn a_lost_drain_step_is_not_a_committed_batch() {
+    pollster::block_on(async {
+        let meta = MemMeta::default();
+        let mut ids = ids_from(0x105E);
+        let key = mpu::retire_key(
+            mpu::RetireMode::Bytes,
+            &mpu::RetireToken::Session {
+                upload_id: "a".repeat(32),
+                epoch: 1,
+                part: Some((2, "b".repeat(32))),
+            },
+        );
+        let obligation = mpu::RetireObligation::new(mpu::RetirePayload::Chunks {
+            chunks: vec![metadata::ChunkRef {
+                id: ids(),
+                scheme: RS,
+                len: 512,
+                placement: (0u64..9).collect(),
+            }],
+        });
+        meta.put_raw(key.clone(), metadata::encode(&obligation));
+
+        // Another drainer advances the obligation in the window before this step's commit, so
+        // this step's `require(retire: == prior)` is the loser.
+        let moved = mpu::RetireObligation {
+            cursor: Some(mpu::RetireCursor {
+                phase: mpu::DrainPhase::Marking,
+                outer: 0,
+                inner: 0,
+                frag: 3,
+                arm: 0,
+            }),
+            ..obligation
+        };
+        meta.inject_before_next_commit(vec![(key.clone(), metadata::encode(&moved))]);
+
+        let mut report = mpu::DrainReport::default();
+        assert_eq!(
+            mpu::drain_step(&meta, &key, NOW, &tiny_budget(), &mut report)
+                .await
+                .unwrap(),
+            mpu::DrainProgress::Lost,
+        );
+        assert_eq!(
+            report,
+            mpu::DrainReport::default(),
+            "a lost batch changed nothing, so it charges nothing",
+        );
+    });
+}
