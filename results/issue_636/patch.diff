+const ROOT: u64 = 0;
+const BUCKET: &str = "buck";
+const NOW: u64 = 2_000_000;
+const LEASE_TTL: u64 = 30_000;
+
+fn topology() -> Topology {
+    let mut t = Topology::default();
+    for id in 0u64..4 {
+        t.register(id, format!("domain-{id}"));
+    }
+    t
+}
+
+async fn create_bucket(meta: &MemMeta) {
+    meta.commit(WriteBatch::new().put(metadata::bucket_key(BUCKET), Bytes::from_static(b"{}")))
+        .await
+        .unwrap();
+}
+
+// ---------------------------------------------------------------------------
+// Leg F — concurrent creates on an empty store all succeed
+// ---------------------------------------------------------------------------
+
+/// Fire `creators` `create_session` calls concurrently against one empty store and return
+/// their outcomes. Each creator has its **own** token source, so their upload ids are
+/// independent (a shared counter would serialize them and hide the contention).
+fn concurrent_creates(creators: u32) -> (Vec<CreateOutcome>, MemMeta) {
+    let meta = MemMeta::interleaving();
+    let budget = Budget::deployed();
+    pollster::block_on(async {
+        create_bucket(&meta).await;
+        let futures = (0..creators).map(|which| {
+            let budget = budget.clone();
+            let meta = &meta;
+            async move {
+                // Distinct token namespaces per creator: `0x1000 * (which + 1)` and up.
+                let mut next = u128::from(which + 1) << 64;
+                let mut tokens = move || {
+                    next += 1;
+                    format!("{next:032x}")
+                };
+                mpu::create_session(
+                    meta,
+                    &CreateParams {
+                        bucket: BUCKET,
+                        parent: ROOT,
+                        object: "buck/obj",
+                        content_type: None,
+                        created_at_millis: NOW,
+                        clock_source: "wall",
+                        budget,
+                        resume: None,
+                    },
+                    &mut tokens,
+                    CreateRetry::default(),
+                    // A deterministic "jitter" and a no-op sleep: what is under test is the
+                    // BUDGET, and `core` neither sleeps nor reads a clock (the caller owns
+                    // both, which is why `backoff` is a hook).
+                    || u64::from(which),
+                    |_, _| async {},
+                )
+                .await
+                .unwrap()
+            }
+        });
+        let outcomes = futures_util::future::join_all(futures).await;
+        (outcomes, meta)
+    })
+}
+
+#[test]
+fn f_concurrent_creates_on_an_empty_store_all_succeed() {
+    // At 8, 10 and 16 — not one number. The shipped defect refused 2 of 8, 3 of 10 and 3 of
+    // 16, so a test at a single concurrency could pass while the class survived.
+    for creators in [8u32, 10, 16] {
+        let (outcomes, meta) = concurrent_creates(creators);
+
+        let mut ids: Vec<String> = Vec::new();
+        for outcome in &outcomes {
+            match outcome {
+                CreateOutcome::Created(session) => ids.push(session.upload_id.clone()),
+                CreateOutcome::Refused(refusal) => panic!(
+                    "{creators} concurrent creates against an EMPTY store: one was refused \
+                     with {refusal:?}. The admission ledger is nowhere near its bound — this \
+                     is the false `503 SlowDown` a single retry budget shared between the \
+                     2^-128 upload-id collision and the globally serialized admission CAS \
+                     produced. {} of {creators} succeeded.",
+                    outcomes
+                        .iter()
+                        .filter(|o| matches!(o, CreateOutcome::Created(_)))
+                        .count()
+                ),
+            }
+        }
+
+        // "All succeed" alone is VACUOUS — an implementation that answered success without
+        // landing a session would pass it. Three further assertions close that:
+        assert_eq!(ids.len() as u32, creators);
+        // 1. the upload ids are pairwise distinct;
+        assert_eq!(
+            ids.iter().collect::<BTreeSet<_>>().len() as u32,
+            creators,
+            "upload ids must be pairwise distinct"
+        );
+        // 2. N `mpu:` records exist afterwards;
+        assert_eq!(
+            meta.keys_with(mpu::MPU_PREFIX).len() as u32,
+            creators,
+            "every successful create must have landed a session record"
+        );
+        // 3. `mpuctl.count` is EXACTLY N — not >= N, not N +/- 1 — so a lost increment, a
+        //    double increment, or a fictitious success all fail here.
+        let count = pollster::block_on(mpu::read_admission(&meta))
+            .unwrap()
+            .expect("the first create bootstraps the ledger")
+            .1
+            .count;
+        assert_eq!(
+            count,
+            u64::from(creators),
+            "mpuctl.count must be exactly the number of sessions that exist"
+        );
+        // The interleaving was real: with N creators serialized through one CAS'd record, the
+        // store saw strictly more commits than creates (each loser retried at least once).
+        assert!(
+            meta.commits() > creators as usize + 1,
+            "the schedule must actually contend (saw {} commits for {creators} creators); \
+             otherwise this leg is a sequential test wearing a concurrency label",
+            meta.commits()
+        );
+    }
+}
+
+/// The **separation** is the fix, so it is asserted directly: a create whose upload-id budget
+/// is spent still has its own CAS budget, and vice versa.
+#[test]
+fn f_the_two_retry_budgets_are_separate_concerns() {
+    let defaults = CreateRetry::default();
+    assert_eq!(defaults.id_attempts, mpu::MAX_UPLOAD_ID_ATTEMPTS);
+    assert_eq!(defaults.cas_attempts, mpu::MAX_ADMISSION_CAS_ATTEMPTS);
+    assert!(
+        defaults.cas_attempts >= 16,
+        "the CAS-contention budget must cover ordinary client concurrency; the shipped defect \
+         shared a 4-attempt budget with the 2^-128 collision retry"
+    );
+
+    // A collapsed budget REPRODUCES the defect, which is what makes the separation
+    // load-bearing rather than decorative: the same 16 creators, refused.
+    let meta = MemMeta::interleaving();
+    let budget = Budget::deployed();
+    let refused = pollster::block_on(async {
+        create_bucket(&meta).await;
+        let futures = (0..16u32).map(|which| {
+            let budget = budget.clone();
+            let meta = &meta;
+            async move {
+                let mut next = u128::from(which + 1) << 64;
+                let mut tokens = move || {
+                    next += 1;
+                    format!("{next:032x}")
+                };
+                mpu::create_session(
+                    meta,
+                    &CreateParams {
+                        bucket: BUCKET,
+                        parent: ROOT,
+                        object: "buck/obj",
+                        content_type: None,
+                        created_at_millis: NOW,
+                        clock_source: "wall",
+                        budget,
+                        resume: None,
+                    },
+                    &mut tokens,
+                    // The shipped shape: ONE small budget for both concerns.
+                    CreateRetry {
+                        id_attempts: 4,
+                        cas_attempts: 4,
+                    },
+                    || u64::from(which),
+                    |_, _| async {},
+                )
+                .await
+                .unwrap()
+            }
+        });
+        futures_util::future::join_all(futures)
+            .await
+            .into_iter()
+            .filter(|o| {
+                matches!(
+                    o,
+                    CreateOutcome::Refused(Refusal::SlowDown {
+                        pressure: Backpressure::AdmissionContention { .. }
+                    })
+                )
+            })
+            .count()
+    });
+    assert!(
+        refused > 0,
+        "a 4-attempt CAS budget must still refuse some of 16 concurrent creators — otherwise \
+         the separated budget above is not what makes them all succeed"
+    );
+}
+
+// ---------------------------------------------------------------------------
+// Leg G — the drain converges past the real boundary, and is idempotent
+// ---------------------------------------------------------------------------
+
+/// Straddling `B_ops`, not sitting below it: `4_001 > MAX_BATCH_OPS`, and each part owes **two**
+/// record deletes (`part:` + its `psum:` sibling), so the deleting phase alone owes 8,002
+/// operations against a 1,000-operation budget.
+const PARTS: u32 = 4_001;
+
+/// One chunk per part, so 4,001 parts is 4,001 chunks — comfortably past the flat map ceiling,
+/// which is what makes the publication a segmented one.
+const CHUNK: usize = 4_096;
+
+fn part_digest(body: &[u8]) -> String {
+    let mut hasher = Sha256::new();
+    hasher.update(body);
+    let out: [u8; 32] = hasher.finalize().into();
+    out.iter().map(|b| format!("{b:02x}")).collect()
+}
+
+/// A budget deliberately far below the work, so the walk is forced to take many batches and
+/// its convergence is a property rather than an accident of scale.
+fn budget() -> DrainBudget {
+    DrainBudget {
+        max_batch_bytes: 20_000,
+        max_batch_ops: 200,
+    }
+}
+
+struct Staged {
+    meta: MemMeta,
+    upload_id: String,
+    bodies: Vec<Vec<u8>>,
+}
+
+/// Create a session and stage `PARTS` one-chunk parts through the **production** verb — no
+/// hand-built fixture, because a curated `retire:` payload would prove nothing about the
+/// records the protocol actually writes.
+fn stage_many_parts() -> Staged {
+    let meta = MemMeta::default();
+    let fleet = MemFleet::default();
+    let budget = Budget::deployed();
+    let upload_id = pollster::block_on(async {
+        create_bucket(&meta).await;
+        let mut next = 1u128;
+        let mut tokens = move || {
+            next += 1;
+            format!("{next:032x}")
+        };
+        let upload_id = match mpu::create_session(
+            &meta,
+            &CreateParams {
+                bucket: BUCKET,
+                parent: ROOT,
+                object: "buck/many",
+                content_type: None,
+                created_at_millis: NOW,
+                clock_source: "wall",
+                budget: budget.clone(),
+                resume: None,
+            },
+            &mut tokens,
+            CreateRetry::default(),
+            || 0,
+            |_, _| async {},
+        )
+        .await
+        .unwrap()
+        {
+            CreateOutcome::Created(session) => session.upload_id.clone(),
+            other => panic!("create refused: {other:?}"),
+        };
+        let mut next_chunk = 0u128;
+        let mut ids = move || {
+            next_chunk += 1;
+            next_chunk
+        };
+        for number in 1..=PARTS {
+            let body = vec![(number % 251) as u8; 1];
+            let outcome = mpu::upload_part(
+                &meta,
+                &fleet,
+                &upload_id,
+                number,
+                &body,
+                CHUNK,
+                // One fragment per chunk: this leg is about the drain's convergence, and nine
+                // fragments per chunk would multiply the fixture cost by nine without adding a
+                // property. Leg A/B/H cover the erasure-coded path.
+                EcScheme::None,
+                &topology(),
+                &mut || NOW,
+                "wall",
+                LEASE_TTL,
+                &mut tokens,
+                &mut ids,
+                &budget,
+            )
+            .await
+            .unwrap();
+            assert!(
+                matches!(outcome, UploadPartOutcome::Committed { .. }),
+                "part {number}: {outcome:?}"
+            );
+        }
+        upload_id
+    });
+    let bodies = (1..=PARTS)
+        .map(|number| vec![(number % 251) as u8; 1])
+        .collect();
+    Staged {
+        meta,
+        upload_id,
+        bodies,
+    }
+}
+
+#[test]
+fn g_a_4001_part_complete_drains_to_empty_in_byte_budgeted_batches() {
+    let Staged {
+        meta,
+        upload_id,
+        bodies,
+    } = stage_many_parts();
+    pollster::block_on(async {
+        let deployed = Budget::deployed();
+        let named: Vec<(u32, String)> = (1..=PARTS)
+            .map(|number| (number, part_digest(&bodies[(number - 1) as usize])))
+            .collect();
+        let published = match mpu::complete(
+            &meta,
+            &CompleteParams {
+                upload_id: &upload_id,
+                named: &named,
+                clock_source: "wall",
+                now_millis: NOW + 1,
+                budget: &deployed,
+                resume: None,
+            },
+            &mut || 7u64,
+        )
+        .await
+        .unwrap()
+        {
+            CompleteOutcome::Published(publication) => *publication,
+            other => panic!("4,001-part complete did not publish: {other:?}"),
+        };
+        // Past the flat ceiling, so this is #635's segmented map published through its staged
+        // publication with this session's fence as the precondition.
+        let inode = metadata::decode::<metadata::InodeRecord>(
+            &meta
+                .get(&metadata::inode_key(published.inode))
+                .await
+                .unwrap()
+                .unwrap(),
+        )
+        .unwrap();
+        assert!(
+            inode.chunk_map.is_segmented(),
+            "4,001 chunks is past MAX_MAP_CHUNKS, so the map must be segmented"
+        );
+        assert_eq!(inode.size, u64::from(PARTS));
+
+        // The publication installed ONE `retire:records:` obligation naming every published
+        // part — a range-encoded set, so 4,001 contiguous numbers are a few bytes.
+        let obligation = meta
+            .keys_with(&mpu::retire_session_range(
+                mpu::RetireMode::Records,
+                &upload_id,
+            ))
+            .into_iter()
+            .next()
+            .expect("the publication installs retire:records:{parts}");
+        assert!(
+            meta.get(&obligation).await.unwrap().unwrap().len() < 200,
+            "a contiguous part-number set must range-encode, not enumerate"
+        );
+
+        // Step the drain, one commit at a time.
+        let budget = budget();
+        let mut report = mpu::DrainReport::default();
+        let mut steps = 0usize;
+        loop {
+            let progress = mpu::drain_step(&meta, &obligation, NOW + 2, &budget, &mut report)
+                .await
+                .unwrap();
+            steps += 1;
+            // BOTH halves are asserted, because one attempt failed each separately: the walk
+            // must terminate (a cursor-less re-derivation loops for ever), and every named
+            // record must actually be gone (a truncated derivation that marks the obligation
+            // fully drained is silent permanent part loss).
+            assert!(
+                steps < 10_000,
+                "the drain did not converge in {steps} steps — a cursor-less walk re-derives \
+                 the same first B_ops keys for ever"
+            );
+            if progress == mpu::DrainProgress::Finished {
+                break;
+            }
+        }
+
+        // It really did take many batches — the boundary was straddled, not skirted.
+        assert!(
+            report.batches > 8_002 / budget.max_batch_ops,
+            "8,002 record deletes under a {}-operation budget must take more than {} batches, \
+             saw {}",
+            budget.max_batch_ops,
+            8_002 / budget.max_batch_ops,
+            report.batches
+        );
+        // The observable is the maximum batch's ENCODED MUTATION BYTES, not its record count
+        // (`0016:1496`): a count-budgeted drain of 1,000 records x 100 KB is 100 MB, 10x the
+        // transaction envelope and a permanent commit failure on FoundationDB.
+        assert!(
+            report.max_batch_bytes <= budget.max_batch_bytes,
+            "the largest batch was {} B, past the {} B envelope",
+            report.max_batch_bytes,
+            budget.max_batch_bytes
+        );
+        assert!(report.max_batch_ops <= budget.max_batch_ops);
+        assert!(report.max_batch_bytes > 0);
+
+        // Every named record is ACTUALLY gone, and the obligation with them.
+        assert_eq!(report.record_deletes, 2 * PARTS as usize);
+        assert!(
+            meta.keys_with(&mpu::part_range(&upload_id)).is_empty(),
+            "a part record left behind is the silent-loss half of this leg"
+        );
+        assert!(meta.keys_with(&mpu::psum_range(&upload_id)).is_empty());
+        assert!(meta.get(&obligation).await.unwrap().is_none());
+        assert_eq!(report.obligations_drained, 1);
+        // A records-mode obligation orphan-marks NOTHING: its bytes are live object content
+        // (`0016:434-440`, and `0016:1501`).
+        assert_eq!(report.marks, 0);
+        assert!(meta.keys_with(metadata::ORPHAN_PREFIX).is_empty());
+
+        // Re-running a fully drained obligation is a no-op, not an error.
+        let mut again = mpu::DrainReport::default();
+        mpu::drain_obligation(&meta, &obligation, NOW + 3, &budget, &mut again)
+            .await
+            .unwrap();
+        assert_eq!(again.record_deletes, 0);
+    });
+}
+
+#[test]
+fn g_a_partially_drained_teardown_converges_with_no_double_decrement() {
+    let Staged {
+        meta,
+        upload_id,
+        bodies: _,
+    } = stage_many_parts();
+    pollster::block_on(async {
+        let before = mpu::read_admission(&meta).await.unwrap().unwrap().1.count;
+        assert_eq!(
+            mpu::abort(&meta, &upload_id, NOW + 1, "wall")
+                .await
+                .unwrap(),
+            AbortOutcome::Fenced
+        );
+        assert_eq!(
+            mpu::read_admission(&meta).await.unwrap().unwrap().1.count,
+            before,
+            "the abort returns from the fence commit alone — teardown is not on the request path"
+        );
+
+        let budget = budget();
+        let obligation = meta
+            .keys_with(&mpu::retire_session_range(
+                mpu::RetireMode::Bytes,
+                &upload_id,
+            ))
+            .into_iter()
+            .next()
+            .expect("the abort fence installs retire:bytes:{session}");
+
+        // Drain PARTIALLY: a handful of steps, then stop — the crash-mid-drain state.
+        let mut partial = mpu::DrainReport::default();
+        for _ in 0..5 {
+            let progress = mpu::drain_step(&meta, &obligation, NOW + 2, &budget, &mut partial)
+                .await
+                .unwrap();
+            assert_ne!(progress, mpu::DrainProgress::Finished);
+        }
+        assert!(partial.marks > 0, "the marking phase runs first");
+        assert!(
+            !meta.keys_with(&mpu::part_range(&upload_id)).is_empty(),
+            "evidence precedes the lifting of protection: records still stand while marking"
+        );
+
+        // Now run the whole teardown TWICE. The second run must converge to the same terminal
+        // state and must NOT decrement the counter again.
+        let rows_before = meta.scanned_rows();
+        let first = mpu::teardown_session(&meta, &upload_id, NOW + 3, &budget)
+            .await
+            .unwrap();
+        assert!(first.terminal_deleted && first.count_decremented);
+        let after_first = mpu::read_admission(&meta).await.unwrap().unwrap().1.count;
+        assert_eq!(after_first, before - 1);
+
+        let second = mpu::teardown_session(&meta, &upload_id, NOW + 4, &budget)
+            .await
+            .unwrap();
+        assert!(
+            !second.terminal_deleted && !second.count_decremented,
+            "the terminal delete is preconditioned on the session record's exact bytes, so a \
+             second teardown is a no-op — the counter can never double-decrement"
+        );
+        assert_eq!(
+            mpu::read_admission(&meta).await.unwrap().unwrap().1.count,
+            after_first
+        );
+
+        // The terminal state, reached once: no session, no records, no obligation, and every
+        // part's bytes evidenced for reclamation rather than silently unprotected.
+        assert!(mpu::read_session(&meta, &upload_id)
+            .await
+            .unwrap()
+            .is_none());
+        assert!(meta.keys_with(&mpu::part_range(&upload_id)).is_empty());
+        assert!(meta.keys_with(&mpu::psum_range(&upload_id)).is_empty());
+        assert!(meta.keys_with(&mpu::slot_range(&upload_id)).is_empty());
+        assert!(meta.keys_with(&mpu::sidx_range(&upload_id)).is_empty());
+        assert!(meta
+            .keys_with(&mpu::retire_session_range(
+                mpu::RetireMode::Bytes,
+                &upload_id
+            ))
+            .is_empty());
+        assert_eq!(
+            meta.keys_with(metadata::ORPHAN_PREFIX).len(),
+            PARTS as usize,
+            "one orphan mark per staged fragment — the evidence GC acts on"
+        );
+        assert!(first.max_batch_bytes <= budget.max_batch_bytes);
+        assert!(first.max_batch_ops <= budget.max_batch_ops);
+
+        // **The walk is bounded per unit, not per range.** Each unit's "what is the next part
+        // at or after n" is one page of one row, keyed by the cursor the walk already has. A
+        // walk that passed an empty cursor and an unbounded limit — the shape this replaces —
+        // re-reads the whole part range for **every** unit, so a maximum-size teardown costs
+        // O(parts^2) rows: ~16 million here rather than the few per part below. That is the
+        // observable, because the rows are what a real backend actually transfers.
+        let rows = meta.scanned_rows() - rows_before;
+        assert!(
+            rows <= 20 * PARTS as usize,
+            "the teardown read {rows} rows for {PARTS} parts: the per-unit page bound is gone",
+        );
+    });
+}
+
+/// **An indeterminate create keeps the identity it minted, and admission is charged once.**
+///
+/// The upload id and group nonce are minted *inside* `create_session`, so a caller that saw a
+/// bare `CommitUnknownResult` could only retry by minting fresh ones — and if the first batch
+/// then lands, that session is `Open`, named by no client, holding an admission slot until
+/// `W_session`, with `mpuctl.count` charged twice for one client request (X78). Both arms of the
+/// unknown result are asserted, because only one of them is visible to a re-read.
+#[test]
+fn an_indeterminate_create_keeps_its_identity_and_charges_admission_once() {
+    pollster::block_on(async {
+        let meta = MemMeta::default();
+        create_bucket(&meta).await;
+        let budget = Budget::deployed();
+        let mut next = 1u128;
+        let mut tokens = move || {
+            next += 1;
+            format!("{next:032x}")
+        };
+        let params = |resume| CreateParams {
+            bucket: BUCKET,
+            parent: ROOT,
+            object: "buck/obj",
+            content_type: None,
+            created_at_millis: NOW,
+            clock_source: "wall",
+            budget: budget.clone(),
+            resume,
+        };
+
+        // (a) The batch did NOT land. The error names the identity to re-drive with.
+        meta.unknown_result_on_next_commit(1, false);
+        let err = mpu::create_session(
+            &meta,
+            &params(None),
+            &mut tokens,
+            CreateRetry::default(),
+            || 0,
+            |_, _| async {},
+        )
+        .await
+        .expect_err("an unknown result is not a create");
+        let indeterminate = err
+            .downcast_ref::<mpu::IndeterminateCommit>()
+            .expect("the identity to re-drive with must reach the caller");
+        let mpu::MintedIdentity::Session {
+            upload_id,
+            group_nonce,
+        } = indeterminate.identity.clone()
+        else {
+            panic!("a create names a session identity: {indeterminate}");
+        };
+        assert_eq!(
+            wyrd_traits::classify(err.as_ref()),
+            wyrd_traits::ErrorClass::Indeterminate,
+            "wrapping the store error must not re-class it as terminal",
+        );
+        assert!(mpu::read_admission(&meta).await.unwrap().is_none());
+
+        // The re-drive presents THAT identity: same session, charged exactly once.
+        let created = match mpu::create_session(
+            &meta,
+            &params(Some(mpu::SessionIdentity {
+                upload_id: &upload_id,
+                group_nonce: &group_nonce,
+            })),
+            &mut tokens,
+            CreateRetry::default(),
+            || 0,
+            |_, _| async {},
+        )
+        .await
+        .unwrap()
+        {
+            CreateOutcome::Created(session) => session.upload_id.clone(),
+            other => panic!("the re-drive must create: {other:?}"),
+        };
+        assert_eq!(created, upload_id, "the re-drive reuses the minted id");
+        assert_eq!(
+            mpu::read_admission(&meta).await.unwrap().unwrap().1.count,
+            1
+        );
+
+        // (b) The batch DID land under the unknown result: the re-read adopts its own record
+        // rather than reporting a collision and re-minting, so this too charges exactly one.
+        meta.unknown_result_on_next_commit(1, true);
+        let adopted = match mpu::create_session(
+            &meta,
+            &params(None),
+            &mut tokens,
+            CreateRetry::default(),
+            || 0,
+            |_, _| async {},
+        )
+        .await
+        .unwrap()
+        {
+            CreateOutcome::Created(session) => session.upload_id.clone(),
+            other => panic!("a landed create must be adopted, not re-minted: {other:?}"),
+        };
+        assert_ne!(adopted, upload_id);
+        assert_eq!(
+            mpu::read_admission(&meta).await.unwrap().unwrap().1.count,
+            2,
+            "two sessions exist and the counter says two — no lost, double or fictitious charge",
+        );
+        assert_eq!(meta.keys_with(mpu::MPU_PREFIX).len(), 2);
+    });
+}
+
+/// A session in `Open` is never torn down: fence-then-walk, so a session still accepting parts
+/// cannot have its in-flight residue reclaimed under it (F15).
+#[test]
+fn g_teardown_refuses_an_open_session() {
+    let Staged {
+        meta, upload_id, ..
+    } = stage_many_parts();
+    pollster::block_on(async {
+        let report = mpu::teardown_session(&meta, &upload_id, NOW + 1, &budget())
+            .await
+            .unwrap();
+        assert_eq!(report, mpu::DrainReport::default());
+        assert_eq!(
+            mpu::read_session(&meta, &upload_id)
+                .await
+                .unwrap()
+                .unwrap()
+                .state(),
+            SessionState::Open
+        );
+        assert!(!meta.keys_with(&mpu::part_range(&upload_id)).is_empty());
+    });
+}
