+/// How the generation an operation unreferences is retired — the routing decision 4.1 makes,
+/// in one place so `unlink`, both superseding committers and multipart's publication cannot
+/// disagree about it (`0016:1079-1104`).
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum GenerationRetirement {
+    /// Expand the prior map's `orphan:` marks **in the unreferencing batch**. Available only
+    /// while that fan-out fits one batch, which is what makes it safe for a small flat object
+    /// and impossible for anything larger.
+    Inline,
+    /// Install **one** `retire:bytes:{generation}` obligation, drained in byte-budgeted batches
+    /// by `multipart::drain_obligation`.
+    Obligated {
+        /// The obligation key.
+        key: Vec<u8>,
+        /// Its encoded value.
+        value: Bytes,
+    },
+}
+
+/// Which route retires the generation `prior` holds at inode `id`.
+///
+/// **Segmented** ⇒ always the obligation: a segmented root does not even name its own chunks
+/// (its `seg:` records do), and its fan-out reaches ~1.78 M fragment orphans plus the segment
+/// deletes — permanently over `E_tx` inline, which is the *outcome (d)* this route exists to
+/// remove.
+///
+/// **Flat** ⇒ inline while the fan-out fits one batch (the small-object case `0016:1102` keeps
+/// on the inline path, so the grace clock starts exactly where it always has), otherwise the
+/// obligation.
+///
+/// **The one residual arm**, and it is worth stating rather than hiding: a flat map so large
+/// that its chunk list will not fit **one obligation value** falls back to inline. Under the
+/// settled knobs that is unreachable — `MAX_MAP_CHUNKS × b_ref ≤ V/2` gives every conforming
+/// flat map 2× the headroom its obligation needs — so the arm exists for a map already past its
+/// own ceiling, which only a `chunk_size` far below the deployed minimum can produce. For those
+/// the obligation route is not available at all (a truncated payload would lose the evidence for
+/// the chunks it dropped, silently), so the honest answer is the behaviour they have today
+/// rather than a delete that can never commit.
+pub fn plan_generation_retirement(
+    id: InodeId,
+    prior: &InodeRecord,
+) -> std::result::Result<GenerationRetirement, ChunkMapError> {
+    let payload = match &prior.chunk_map {
+        ChunkMap::Flat(chunks) => {
+            if generation_retires_inline(prior) {
+                return Ok(GenerationRetirement::Inline);
+            }
+            RetirePayload::Generation {
+                inode: id,
+                version: prior.version,
+                chunks: chunks.clone(),
+                segments: None,
+            }
+        }
+        ChunkMap::Segmented(map) => RetirePayload::Generation {
+            inode: id,
+            version: prior.version,
+            chunks: Vec::new(),
+            segments: Some(SegmentGeneration::of(map.group())),
+        },
+    };
+    let value = encode(&RetireObligation::new(payload));
+    if value.len() > MAX_VALUE_BYTES {
+        // A flat map past its own value ceiling: see the residual arm above. A segmented payload
+        // is a nonce and an epoch, so it can never reach here.
+        debug_assert!(!prior.chunk_map.is_segmented());
+        return Ok(GenerationRetirement::Inline);
+    }
+    Ok(GenerationRetirement::Obligated {
+        key: retire_key(
+            RetireMode::Bytes,
+            &RetireToken::Generation {
+                inode: id,
+                version: prior.version,
+            },
+        ),
+        value,
+    })
+}
+
+/// Whether the generation `prior` holds may be orphan-marked **inline**, in the same batch as
+/// the transition that unreferences it (`0016:1102-1104`: "A small flat object may keep the
+/// inline path (its fan-out fits one batch); the retirement route is **mandatory above one
+/// batch's worth of fragments** and is the single path for both flat-large and segmented").
+///
+/// Charged on both axes of the envelope, because a fan-out breaks each independently: an
+/// `orphan:` mark is a key plus a few bytes, so thousands of them stay far inside `E_tx/2`
+/// while spending the transaction's **5-second** deadline on sequential round trips
+/// (`0016:629-638`). The margin (half a budget) leaves room for the batch's own records — the
+/// dirent, the inode, the leases — which are charged by the caller, not here.
+fn generation_retires_inline(prior: &InodeRecord) -> bool {
+    let Some(chunks) = prior.chunk_map.as_flat() else {
+        // A segmented generation is *never* inline: its fan-out is the segment table's, which
+        // this record does not even name (the `seg:` records do), so it cannot be expanded
+        // from the root at all.
+        return false;
+    };
+    let marks: usize = chunks
+        .iter()
+        .map(|chunk| usize::from(chunk.fragment_count()))
+        .sum();
+    // Two operations per mark (the three-arm guard's precondition plus the put), and ~64 B of
+    // key+value each.
+    marks * 2 <= MAX_BATCH_OPS / 2 && marks * 64 <= MAX_BATCH_BYTES / 2
+}
+
+/// Add the generation `prior` holds to `batch`, by whichever route
+/// [`plan_generation_retirement`] chose — the one implementation every unreferencing committer
+/// shares.
+pub(crate) fn retire_generation(
+    batch: WriteBatch,
+    id: InodeId,
+    prior: &InodeRecord,
+    orphaned_at_millis: u64,
+) -> std::result::Result<WriteBatch, ChunkMapError> {
+    let mut batch = batch;
+    match plan_generation_retirement(id, prior)? {
+        GenerationRetirement::Obligated { key, value } => {
+            // `require_absent` on the token, never a blind put: a collision would replace one
+            // obligation's payload with another's and permanently lose the reclamation evidence
+            // for every fragment the overwritten one named (`0016:369-373`).
+            batch = batch.require_absent(key.clone()).put(key, value);
+        }
+        GenerationRetirement::Inline => {
+            for chunk in prior.chunk_map.as_flat().into_iter().flatten() {
+                for (index, dserver) in chunk.fragments() {
+                    let frag = FragmentId {
+                        chunk: chunk.id,
+                        index,
+                    };
+                    batch = batch.put(
+                        orphan_key(dserver, frag),
+                        orphaned_at_millis.to_string().into_bytes(),
+                    );
+                }
+            }
+        }
+    }
+    Ok(batch)
+}
