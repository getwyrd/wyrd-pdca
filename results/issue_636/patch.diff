+// ===========================================================================
+// 5. The ETag composition — the settled pure function
+// ===========================================================================
+
+/// A 32-byte SHA-256 digest rendered as lowercase hex.
+pub fn hex_lower(bytes: &[u8]) -> String {
+    let mut out = String::with_capacity(bytes.len() * 2);
+    for byte in bytes {
+        out.push(char::from_digit(u32::from(byte >> 4), 16).unwrap_or('0'));
+        out.push(char::from_digit(u32::from(byte & 0x0f), 16).unwrap_or('0'));
+    }
+    out
+}
+
+/// Parse a 64-character lowercase-hex SHA-256 digest back to its 32 raw bytes.
+pub fn parse_digest(hex: &str) -> Option<[u8; 32]> {
+    if hex.len() != 64 {
+        return None;
+    }
+    let mut out = [0u8; 32];
+    let raw = hex.as_bytes();
+    for (i, slot) in out.iter_mut().enumerate() {
+        let hi = (raw[2 * i] as char).to_digit(16)?;
+        let lo = (raw[2 * i + 1] as char).to_digit(16)?;
+        if raw[2 * i].is_ascii_uppercase() || raw[2 * i + 1].is_ascii_uppercase() {
+            return None;
+        }
+        *slot = (hi * 16 + lo) as u8;
+    }
+    Some(out)
+}
+
+/// The SHA-256 digest of `data`, the basis ADR-0047 settled for the change token.
+pub fn digest(data: &[u8]) -> [u8; 32] {
+    let mut hasher = Sha256::new();
+    hasher.update(data);
+    hasher.finalize().into()
+}
+
+/// The **multipart ETag** — the composition this slice settles on top of ADR-0047's basis
+/// (`docs/design/adr/0047-object-metadata-model.md:73-89`, which closed the basis as
+/// lowercase-hex SHA-256 and deferred only the composition, `:112`; `0016:3064-3070`):
+///
+/// ```text
+/// etag = lowercase_hex( SHA-256( d1 || d2 || ... || dN ) ) + "-" + N
+/// ```
+///
+/// where `dᵢ` is the **raw 32 binary digest bytes** — not their hex text, no separators, no
+/// part numbers mixed in — of the *i*-th part in **ascending part-number order over exactly
+/// the parts the caller named**, and `N` is that count.
+///
+/// **Never MD5.** S3's own multipart ETag is an MD5-of-MD5s; Wyrd's change token is
+/// SHA-256-based by ADR-0047, and the composition follows the basis rather than the wire
+/// folklore. The value is opaque to clients (an entity tag, compared for equality), so the
+/// digest algorithm is ours to choose; what must not vary is that it is a **pure function of
+/// the part records' recorded digests and their order**, so a retry recomputes the same
+/// value from the same records.
+pub fn multipart_etag(digests: &[[u8; 32]]) -> String {
+    let mut hasher = Sha256::new();
+    for part in digests {
+        hasher.update(part);
+    }
+    let composed: [u8; 32] = hasher.finalize().into();
+    format!("{}-{}", hex_lower(&composed), digests.len())
+}
+
+/// The **request identity** a `Completed` tombstone answers on — a digest over the *ordered*
+/// `(part_number, digest)` pairs the winning Complete named (`0016:898-908`, X81).
+///
+/// Separate from the ETag, deliberately: the ETag is a function of the digests alone, so two
+/// different part *numberings* of the same bodies would collide in it. The fingerprint mixes
+/// the numbers in, so a client that reuses an upload id with a different assembly gets
+/// [`Refusal::NoSuchUpload`] — the honest answer — rather than being told *its* assembly
+/// succeeded.
+/// **Length-prefixed, not delimited**, because the digests it mixes in are the *client's*
+/// unvalidated strings: the tombstone answer is computed from the request before any digest is
+/// checked against a `part:` record, so a delimiter-framed hash lets one crafted digest
+/// impersonate a different part list — `[(1, "A"), (2, "B")]` and `[(1, "A\n2:B")]` hash
+/// identically under `"{n}:{d}\n"` framing, and the tombstone would then answer *success with
+/// the recorded ETag* to a request for a different assembly, which is the silent wrong answer
+/// the fingerprint exists to prevent (`0016:898-908`). With each field's byte length hashed
+/// ahead of it the encoding is injective for every input, validated or not.
+pub fn complete_fingerprint(named: &[(u32, String)]) -> String {
+    let mut hasher = Sha256::new();
+    hasher.update((named.len() as u64).to_be_bytes());
+    for (part_number, digest) in named {
+        hasher.update(part_number.to_be_bytes());
+        hasher.update((digest.len() as u64).to_be_bytes());
+        hasher.update(digest.as_bytes());
+    }
+    let out: [u8; 32] = hasher.finalize().into();
+    hex_lower(&out)
+}
+
+// ===========================================================================
+// 6. Reading a session — the fence value every transition preconditions on
+// ===========================================================================
+
+/// A session record **plus the exact bytes it was read as**.
+///
+/// The bytes are the point. Every transition is `require(mpu:<id> == <these bytes>)`
+/// (`0016:555-566`), which both authorizes the transition and invalidates every operation
+/// that read the previous state — so a caller that carried only the decoded record could not
+/// state the precondition, and one that re-encoded it would be pinning *its* serialization
+/// rather than the store's.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct SessionSnapshot {
+    /// The upload id.
+    pub upload_id: String,
+    /// The bytes the store held at the read.
+    pub bytes: Bytes,
+    /// The decoded record.
+    pub record: SessionRecord,
+}
+
+impl SessionSnapshot {
+    /// This session's record key.
+    pub fn key(&self) -> Vec<u8> {
+        mpu_key(&self.upload_id)
+    }
+
+    /// The fence precondition: `require(mpu:<id> == the bytes read)`.
+    pub fn fence(&self, batch: WriteBatch) -> WriteBatch {
+        batch.require(self.key(), self.bytes.clone())
+    }
+
+    /// The session's current state.
+    pub fn state(&self) -> SessionState {
+        self.record.state
+    }
+
+    /// The session's current epoch.
+    pub fn epoch(&self) -> u64 {
+        self.record.epoch
+    }
+
+    /// The refusal a **client verb other than Complete/Abort** owes in this state — the
+    /// verb x state answer table's shared column (`0016:972-978`). `None` means the state
+    /// accepts the verb.
+    ///
+    /// One table, consulted by [`reserve_slot`], [`list_parts`] and the part path, so the
+    /// answers cannot drift between verbs.
+    pub fn refusal_for_part_verbs(&self) -> Option<Refusal> {
+        match self.record.state {
+            SessionState::Open => None,
+            // `Completing` answers `NoSuchUpload` to UploadPart specifically (a part
+            // accepted after the fence is invisible to the publication that already read
+            // the set — a silently lost part, `0016:1030`), which is why this is the
+            // part-verb table and not the whole one.
+            SessionState::Completing | SessionState::Aborting | SessionState::Completed => {
+                Some(Refusal::NoSuchUpload)
+            }
+        }
+    }
+}
+
+/// Read a session record, or `None` if the upload id names no session.
+pub async fn read_session(
+    store: &impl MetadataStore,
+    upload_id: &str,
+) -> Result<Option<SessionSnapshot>> {
+    let key = mpu_key(upload_id);
+    let Some(bytes) = store.get(&key).await? else {
+        return Ok(None);
+    };
+    let record = decode_session(&bytes)?;
+    Ok(Some(SessionSnapshot {
+        upload_id: upload_id.to_string(),
+        bytes,
+        record,
+    }))
+}
+
+/// Read the admission ledger. **Absent reads as `None`, which means `{count: 0}`** — the
+/// first create initializes the record in its own batch under `require_absent`, so there is
+/// no migration or init step and no first-create dead-end (`0016:1999-2005`).
+pub async fn read_admission(
+    store: &impl MetadataStore,
+) -> Result<Option<(Bytes, AdmissionRecord)>> {
+    let Some(bytes) = store.get(MPUCTL_KEY).await? else {
+        return Ok(None);
+    };
+    let record: AdmissionRecord = metadata::decode(&bytes)?;
+    Ok(Some((bytes, record)))
+}
+
+// ===========================================================================
+// 7. Create — the serialized admission reservation
+// ===========================================================================
+
+/// A source of 128-bit tokens rendered lowercase hex — upload ids, segment-group nonces and
+/// part attempt ids.
+///
+/// A seam rather than an in-module RNG: `core` holds no randomness (ADR-0009 —
+/// determinism is the test substrate), the gateway mints these coordination-free in the same
+/// spirit as the chunk-id epoch (`crates/server/src/lib.rs:237-251`, ADR-0019), and a DST run
+/// supplies a seeded generator so a failing interleaving replays.
+///
+/// **Unlike the chunk-id epoch, these are *full* 128-bit random tokens** (`0016:493-497`):
+/// `require_absent` on the minted key turns the astronomically unlikely collision into a
+/// `Conflict`, and that 2^-128 argument is what [`MAX_UPLOAD_ID_ATTEMPTS`] rests on — the
+/// gateway's *epoch + counter* chunk-id scheme is a precedent for coordination-free minting,
+/// not for the collision basis.
+pub trait Tokens {
+    /// Mint the next token: 32 lowercase-hex characters.
+    fn token(&mut self) -> String;
+}
+
+impl<F: FnMut() -> String> Tokens for F {
+    fn token(&mut self) -> String {
+        self()
+    }
+}
+
+/// What a create is asked to admit.
+#[derive(Debug, Clone)]
+pub struct CreateParams<'a> {
+    /// The target bucket, whose `bucket:` record must exist (ADR-0046 §4).
+    pub bucket: &'a str,
+    /// The parent inode the object name lives under.
+    pub parent: InodeId,
+    /// The object name.
+    pub object: &'a str,
+    /// The declared content type, stamped at publication (ADR-0047).
+    pub content_type: Option<String>,
+    /// The initiation instant, from the clock named below.
+    pub created_at_millis: u64,
+    /// Which clock stamped it (`0016:1990-1998`).
+    pub clock_source: &'a str,
+    /// **This process's** derived budget. It is compared, whole, against the ledger's; a
+    /// mismatch refuses rather than deferring to either value.
+    pub budget: Budget,
+    /// The identity to **re-drive** with after an [`IndeterminateCommit`] (X78), rather than a
+    /// freshly minted pair. `None` mints. A re-drive spends **one** id attempt, since its id is
+    /// fixed: its own landed record is adopted by byte equality, and anything else at that key
+    /// is a genuine collision this request cannot mint its way out of.
+    pub resume: Option<SessionIdentity<'a>>,
+}
+
+/// The identity a **re-drive** must present after an indeterminate commit — the thing that makes
+/// the caller's "re-drive the same id" obligation performable instead of merely documented
+/// (X78/X68).
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum MintedIdentity {
+    /// A create's session identity: re-drive [`create_session`] with
+    /// [`CreateParams::resume`] set to this pair.
+    Session {
+        /// The upload id the indeterminate batch used.
+        upload_id: String,
+        /// The segment-group nonce it reserved.
+        group_nonce: String,
+    },
+    /// A part attempt's identity: re-drive [`reserve_slot`] with `resume = Some(attempt_id)`.
+    PartAttempt {
+        /// The session.
+        upload_id: String,
+        /// The attempt token the indeterminate batch used.
+        attempt_id: String,
+    },
+    /// A Complete **fence**'s identity: re-drive [`complete`] with
+    /// [`CompleteParams::resume`] set to these bytes.
+    ///
+    /// The fence is the one transition with no client-visible resume (`0016:952-961`,`:980-986`:
+    /// "the only resume is the owning gateway recovering its own unknown result at the same
+    /// epoch"), so an unknown result here is the state a session cannot leave: if the batch does
+    /// land afterwards the session is `Completing`, every client verb answers `OperationAborted`,
+    /// and the only other exit is the reaper's `W_completing` — #625's, not running when this
+    /// slice merges. Carrying the exact fence value makes that recovery performable: the
+    /// re-drive adopts a `Completing` session **iff** its record is byte-for-byte this caller's
+    /// own fence, which no other publisher's fence can be (it carries their epoch).
+    CompleteFence {
+        /// The session.
+        upload_id: String,
+        /// The exact session-record bytes the indeterminate fence batch would have installed.
+        fence_bytes: Bytes,
+    },
+}
+
+/// A commit whose outcome the store could not report, **carrying the identity a re-drive must
+/// reuse**.
+///
+/// Without it the obligation is unperformable: the tokens are minted inside this module, so a
+/// caller that saw a bare `CommitUnknownResult` could only retry by minting *new* ones — and if
+/// the first batch did land, the fresh id leaves an `Open` session no client will ever name
+/// holding an admission slot until `W_session`, with the counter charged twice for one client
+/// request (X78), or one of `MAX_INFLIGHT_PARTS` slots gone per retry (X68).
+///
+/// The original error is the [`std::error::Error::source`], so
+/// [`wyrd_traits::classify`](wyrd_traits::classify) still reports `Indeterminate` through the
+/// wrapper rather than falling back to `Terminal`.
+#[derive(Debug)]
+pub struct IndeterminateCommit {
+    /// What to present on the re-drive.
+    pub identity: MintedIdentity,
+    source: wyrd_traits::BoxError,
+}
+
+impl IndeterminateCommit {
+    fn session(upload_id: String, group_nonce: String, source: wyrd_traits::BoxError) -> Self {
+        Self {
+            identity: MintedIdentity::Session {
+                upload_id,
+                group_nonce,
+            },
+            source,
+        }
+    }
+
+    fn part_attempt(upload_id: String, attempt_id: String, source: wyrd_traits::BoxError) -> Self {
+        Self {
+            identity: MintedIdentity::PartAttempt {
+                upload_id,
+                attempt_id,
+            },
+            source,
+        }
+    }
+
+    fn complete_fence(
+        upload_id: String,
+        fence_bytes: Bytes,
+        source: wyrd_traits::BoxError,
+    ) -> Self {
+        Self {
+            identity: MintedIdentity::CompleteFence {
+                upload_id,
+                fence_bytes,
+            },
+            source,
+        }
+    }
+
+    /// The attempt token to re-drive a slot reserve with, if that is what was indeterminate.
+    pub fn attempt_id(&self) -> Option<&str> {
+        match &self.identity {
+            MintedIdentity::PartAttempt { attempt_id, .. } => Some(attempt_id),
+            MintedIdentity::Session { .. } | MintedIdentity::CompleteFence { .. } => None,
+        }
+    }
+
+    /// The fence value to re-drive a Complete with ([`CompleteParams::resume`]), if that is what
+    /// was indeterminate.
+    pub fn fence_bytes(&self) -> Option<&Bytes> {
+        match &self.identity {
+            MintedIdentity::CompleteFence { fence_bytes, .. } => Some(fence_bytes),
+            MintedIdentity::Session { .. } | MintedIdentity::PartAttempt { .. } => None,
+        }
+    }
+}
+
+impl std::fmt::Display for IndeterminateCommit {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        match &self.identity {
+            MintedIdentity::Session {
+                upload_id,
+                group_nonce,
+            } => write!(
+                f,
+                "the create of session {upload_id} (group nonce {group_nonce}) returned an \
+                 unknown result: re-drive THIS identity, never a fresh one"
+            ),
+            MintedIdentity::PartAttempt {
+                upload_id,
+                attempt_id,
+            } => write!(
+                f,
+                "the slot reserve of attempt {attempt_id} on session {upload_id} returned an \
+                 unknown result: re-drive with THIS attempt id, never a fresh one"
+            ),
+            MintedIdentity::CompleteFence { upload_id, .. } => write!(
+                f,
+                "the Complete fence of session {upload_id} returned an unknown result: re-drive \
+                 Complete with THIS fence value (CompleteParams::resume), never a bare retry — a \
+                 fence that lands afterwards leaves the session Completing, which no client verb \
+                 can resume"
+            ),
+        }
+    }
+}
+
+impl std::error::Error for IndeterminateCommit {
+    fn source(&self) -> Option<&(dyn std::error::Error + 'static)> {
+        Some(self.source.as_ref())
+    }
+}
+
+/// The session identity a re-drive of an indeterminate create presents ([`CreateParams::resume`]).
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct SessionIdentity<'a> {
+    /// The upload id to reuse.
+    pub upload_id: &'a str,
+    /// The group nonce to reuse.
+    pub group_nonce: &'a str,
+}
+
+/// The two **separate** retry budgets a create spends (`0016:2008-2027`).
+///
+/// Separating them is the fix for a shipped defect, and it is why this is a struct rather
+/// than one number: a single budget served both the 2^-128 upload-id collision and the
+/// *globally serialized* admission CAS, so the k-th concurrent creator needed O(k) attempts
+/// and 16 concurrent creates against an **empty** store answered a false `503 SlowDown`.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct CreateRetry {
+    /// Attempts spent minting a fresh upload id / group nonce after a collision.
+    pub id_attempts: u32,
+    /// Attempts spent losing the admission CAS to another creator.
+    pub cas_attempts: u32,
+}
+
+impl Default for CreateRetry {
+    fn default() -> Self {
+        Self {
+            id_attempts: MAX_UPLOAD_ID_ATTEMPTS,
+            cas_attempts: MAX_ADMISSION_CAS_ATTEMPTS,
+        }
+    }
+}
+
+/// `CreateMultipartUpload`: reserve an admission slot and install the session record, its
+/// `seggrp:` reservation and the counter increment **in one batch** (`0016:656`).
+///
+/// The batch is:
+///
+/// * **ledger present** — `require(mpuctl == prior)` with `prior.count < prior.max_sessions`
+///   (the **stored** limit, so every reserver enforces the value in the ledger whatever its
+///   local derivation says) and `prior.profile == params.budget` (else
+///   [`Refusal::ProfileSkew`], fail-closed with the operator signal);
+/// * **ledger absent** — `require_absent(mpuctl)` + a put of
+///   `{count: 1, max_sessions, profile}`, the self-bootstrapping arm. The bootstrap value
+///   carries the **whole** schema including `profile`: omitting it would leave the next
+///   create unable to decode the record it must CAS, wedging admission after the very first
+///   session (X89);
+/// * plus `require_absent(mpu:<id>)`, `require_absent(seggrp:<nonce>)`, and the
+///   bucket-existence read.
+///
+/// `backoff(attempt, millis)` is awaited after a lost admission CAS with the delay
+/// [`admission_backoff_millis`] computes from `jitter()`. The hook is the caller's because
+/// `core` neither sleeps nor reads a clock; pass a no-op to retry immediately (what a
+/// single-threaded test wants) or a timer sleep in the gateway.
+///
+/// # Recovering an unknown outcome
+///
+/// This function reports a definite outcome or an `Err`. On an `Err` that may be a
+/// `CommitUnknownResult` the caller **must re-drive the same upload id**, never a fresh one
+/// (X78): an absent re-read does not prove the batch will not land afterwards, and a create
+/// that retried under a new id can leave an `Open` session no client will ever name, holding
+/// an admission slot until `W_session`. Re-driving through this function is exactly right —
+/// it re-reads `mpuctl` and rebuilds the counter precondition from the fresh value (X101),
+/// while `require_absent(mpu:<id>)` keeps at most one of the two batches able to land.
+pub async fn create_session<M, T, J, F, Fut>(
+    store: &M,
+    params: &CreateParams<'_>,
+    tokens: &mut T,
+    retry: CreateRetry,
+    mut jitter: J,
+    mut backoff: F,
+) -> Result<CreateOutcome>
+where
+    M: MetadataStore,
+    T: Tokens,
+    J: FnMut() -> u64,
+    F: FnMut(u32, u64) -> Fut,
+    Fut: std::future::Future<Output = ()>,
+{
+    // **The value set is checked before it can become the ledger's.** The bootstrap arm writes
+    // `params.budget` into `mpuctl`, where it is thereafter *the fleet's* profile — every other
+    // admitter compares against it and refuses on skew — so an illegal set admitted here would
+    // be enforced everywhere, and `mpuctl`'s own decode (which applies the same predicate) would
+    // then reject the record the fleet needs to read. Fail closed at the one place the value
+    // enters the store.
+    knob_clamps_hold(&params.budget).map_err(|why| RecordError::BudgetIllegal { why })?;
+    let mut cas_spent = 0u32;
+    let id_attempts = match params.resume {
+        Some(_) => 1,
+        None => retry.id_attempts.max(1),
+    };
+    for _ in 0..id_attempts {
+        let (upload_id, group_nonce) = match params.resume {
+            Some(identity) => (
+                identity.upload_id.to_string(),
+                identity.group_nonce.to_string(),
+            ),
+            None => (tokens.token(), tokens.token()),
+        };
+        require_token(&upload_id)?;
+        require_token(&group_nonce)?;
+
+        let mut collided = false;
+        while cas_spent < retry.cas_attempts.max(1) {
+            // The bucket record is a plain READ first, so an absent bucket answers
+            // `NoSuchBucket` rather than stranding a session in a bucket that is gone
+            // (ADR-0046 decision 4). Its bytes are then pinned in the batch, so a
+            // concurrent DeleteBucket in the window loses to, or defeats, this create.
+            let bucket_key = metadata::bucket_key(params.bucket);
+            let Some(bucket_bytes) = store.get(&bucket_key).await? else {
+                return Ok(CreateOutcome::Refused(Refusal::NoSuchBucket));
+            };
+
+            let ledger = read_admission(store).await?;
+            let (admission_pre, admission_next) = match &ledger {
+                Some((bytes, prior)) => {
+                    if prior.profile != params.budget {
+                        // Fail closed and let the operator see it: the disagreement means
+                        // one of the two hosts is sized for a budget it is not getting, and
+                        // silently deferring to either value breaks the
+                        // `MAX_SESSIONS x U_ref <= W_ref` bound on the process that never
+                        // observes the overrun (X99).
+                        return Ok(CreateOutcome::Refused(Refusal::ProfileSkew {
+                            local: Box::new(params.budget.clone()),
+                            ledger: Box::new(prior.profile.clone()),
+                        }));
+                    }
+                    if prior.count >= prior.max_sessions {
+                        return Ok(CreateOutcome::Refused(Refusal::SlowDown {
+                            pressure: Backpressure::SessionCap {
+                                count: prior.count,
+                                max_sessions: prior.max_sessions,
+                            },
+                        }));
+                    }
+                    let next = AdmissionRecord {
+                        count: prior.count + 1,
+                        ..prior.clone()
+                    };
+                    (Some(bytes.clone()), next)
+                }
+                None => {
+                    let next = AdmissionRecord {
+                        count: 1,
+                        max_sessions: params.budget.max_sessions(),
+                        profile: params.budget.clone(),
+                    };
+                    // Unreachable for a budget that passed `knob_clamps_hold` above (its last
+                    // clamp is exactly this one), and kept anyway: this is the arm that writes
+                    // the fleet's profile, so it fails closed on its own terms rather than
+                    // depending on a check twenty lines away staying where it is.
+                    if next.max_sessions == 0 {
+                        return Ok(CreateOutcome::Refused(Refusal::SlowDown {
+                            pressure: Backpressure::SessionCap {
+                                count: 0,
+                                max_sessions: 0,
+                            },
+                        }));
+                    }
+                    (None, next)
+                }
+            };
+
+            let record = SessionRecord {
+                bucket: params.bucket.to_string(),
+                parent: params.parent,
+                object: params.object.to_string(),
+                content_type: params.content_type.clone(),
+                created_at_millis: params.created_at_millis,
+                clock_source: params.clock_source.to_string(),
+                state: SessionState::Open,
+                epoch: 0,
+                attempts: 0,
+                group_nonce: group_nonce.clone(),
+                fenced_at_millis: None,
+                segments_written: None,
+                publish_target: None,
+                completion: None,
+            };
+            let session_bytes = encode_record(&record)?;
+            let session_key = mpu_key(&upload_id);
+
+            let mut batch = WriteBatch::new()
+                .require(bucket_key, bucket_bytes)
+                .require_absent(session_key.clone())
+                .require_absent(metadata::seggrp_key(&group_nonce))
+                .put(session_key.clone(), session_bytes.clone())
+                .put(
+                    metadata::seggrp_key(&group_nonce),
+                    Bytes::from_static(metadata::SEGGRP_MARKER),
+                )
+                .put(MPUCTL_KEY.to_vec(), encode_record(&admission_next)?);
+            batch = match admission_pre {
+                Some(bytes) => batch.require(MPUCTL_KEY.to_vec(), bytes),
+                None => batch.require_absent(MPUCTL_KEY.to_vec()),
+            };
+
+            let outcome = match store.commit(batch).await {
+                Ok(outcome) => outcome,
+                // **An unknown result is re-read here and, if it did not land, reported WITH the
+                // identity to re-drive** (X78). Propagating the bare store error would leave the
+                // caller unable to name this create at all: it would mint a fresh id, and if the
+                // first batch lands afterwards that session is `Open`, unnamed by any client and
+                // holding an admission slot until `W_session`, with the counter charged twice.
+                Err(err) => {
+                    // The settling read is **best-effort, and its own failure may not swallow
+                    // the identity**: a `?` here returns the read's error and drops the minted
+                    // pair, which is precisely the state the caller cannot recover from — the
+                    // batch may still land, and a retry that mints a fresh id then leaves an
+                    // `Open` session no client will ever name holding an admission slot, with
+                    // the counter charged twice. A store that cannot answer the settling read
+                    // has not made the commit any more definite, so the outcome is the same
+                    // indeterminate one and the identity travels with it.
+                    if let Ok(Some(landed)) = store.get(&session_key).await {
+                        if landed.as_ref() == session_bytes.as_ref() {
+                            return Ok(CreateOutcome::Created(Box::new(SessionSnapshot {
+                                upload_id,
+                                bytes: session_bytes,
+                                record,
+                            })));
+                        }
+                    }
+                    return Err(IndeterminateCommit::session(upload_id, group_nonce, err).into());
+                }
+            };
+            match outcome {
+                CommitOutcome::Committed => {
+                    return Ok(CreateOutcome::Created(Box::new(SessionSnapshot {
+                        upload_id,
+                        bytes: session_bytes,
+                        record,
+                    })));
+                }
+                CommitOutcome::Conflict => {
+                    // The store does not name the precondition that failed, so re-read to
+                    // classify (`traits/src/lib.rs:738-745`). Two of the three possible
+                    // causes are 2^-128 token collisions and spend the *id* budget; the
+                    // third is ordinary contention on the one globally serialized record
+                    // and spends the *CAS* budget. Conflating them is the shipped defect.
+                    let landed = store.get(&session_key).await?;
+                    // **A re-drive of this same create is ADOPTED, not called a collision**
+                    // (X78). The caller that saw a `CommitUnknownResult` must re-drive the same
+                    // upload id, and the batch it is re-driving may in fact have landed — in
+                    // which case the session key is occupied by *its own* record, byte for
+                    // byte. Reporting that as an id collision would spend the id budget,
+                    // re-mint, and leave an `Open` session no client will ever name holding an
+                    // admission slot until `W_session`; worse, the fresh id's batch would
+                    // increment the counter a second time for one client request.
+                    if landed.as_deref() == Some(session_bytes.as_ref()) {
+                        return Ok(CreateOutcome::Created(Box::new(SessionSnapshot {
+                            upload_id,
+                            bytes: session_bytes,
+                            record,
+                        })));
+                    }
+                    let id_taken = landed.is_some();
+                    let nonce_taken = store
+                        .get(&metadata::seggrp_key(&group_nonce))
+                        .await?
+                        .is_some();
+                    if id_taken || nonce_taken {
+                        collided = true;
+                        break;
+                    }
+                    let delay = admission_backoff_millis(cas_spent, jitter());
+                    cas_spent += 1;
+                    backoff(cas_spent, delay).await;
+                }
+            }
+        }
+        if !collided {
+            return Ok(CreateOutcome::Refused(Refusal::SlowDown {
+                pressure: Backpressure::AdmissionContention {
+                    attempts: cas_spent,
+                },
+            }));
+        }
+    }
+    Ok(CreateOutcome::Refused(Refusal::SlowDown {
+        pressure: Backpressure::UploadIdCollision {
+            attempts: retry.id_attempts.max(1),
+        },
+    }))
+}
+
+// ===========================================================================
+// 8. The part path — reserve, stage, commit
+// ===========================================================================
+
+/// One in-flight part upload: the slot it holds, the fence it read, and what it has staged.
+///
+/// It is a *handle*, and it carries the exact bytes of both records it preconditions on
+/// (the session and its own slot) because those bytes **are** the authorization.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct PartUpload {
+    /// The session this part belongs to.
+    pub upload_id: String,
+    /// The part number.
+    pub part_number: u32,
+    /// The slot index this attempt claimed.
+    pub slot_index: u32,
+    /// This attempt's token, so an ambiguous reserve is settled by re-reading (X68).
+    pub attempt_id: String,
+    /// The session record as read at the reserve — the fence value every batch pins.
+    pub session: SessionSnapshot,
+    /// The slot record as read/written last — the `require(slot == prior)` value.
+    pub slot: SlotRecord,
+    /// The slot's encoded bytes, for that precondition.
+    pub slot_bytes: Bytes,
+    /// The chunks staged so far, in part order.
+    pub staged: Vec<ChunkRef>,
+    /// The **ledger-approved** budget this attempt was admitted under — the caps
+    /// [`commit_part`] enforces.
+    ///
+    /// It travels with the handle for the same reason the two record byte-strings above do: it
+    /// is part of the authorization, not a parameter of the next call. [`reserve_slot`] is the
+    /// only minter of a `PartUpload`, and it compares the caller's budget with the ledger's
+    /// profile before claiming an index — so taking a *fresh* budget at commit time would let a
+    /// caller reserve under the fleet's caps and then commit under larger ones of its own,
+    /// bypassing the per-part and per-session bounds `MAX_SESSIONS x U_ref <= W_ref` is derived
+    /// from, on the one process that never observes the overrun.
+    pub budget: Budget,
+}
+
+impl PartUpload {
+    /// This attempt's slot key.
+    pub fn slot_key(&self) -> Vec<u8> {
+        slot_key(&self.upload_id, self.slot_index)
+    }
+
+    /// The keyed slot precondition — **its own** key, so a release contends with nothing and
+    /// a replayed release is a no-op (`0016:1736-1740`).
+    pub fn pin_slot(&self, batch: WriteBatch) -> WriteBatch {
+        batch.require(self.slot_key(), self.slot_bytes.clone())
+    }
+
+    /// The total chunks staged so far.
+    pub fn staged_chunks(&self) -> usize {
+        self.staged.len()
+    }
+}
+
+/// `UploadPart`'s first act: claim one index of the fixed per-session range
+/// `slot:<upload-id>:[0, MAX_INFLIGHT_PARTS)` **before streaming any chunk** (`0016:657`).
+///
+/// The bounded range read only **chooses** an index; the per-key `require_absent`
+/// **authorizes** the reservation, so concurrent reservers cannot overshoot the cap however
+/// they interleave — ADR-0046's scan-then-commit warning respected rather than dodged
+/// (`0016:1688-1692`). A reserver that loses an index probes the next free one (at most
+/// `max_inflight_parts` probes, each against a *different* key) and answers
+/// [`Backpressure::InflightParts`] once the range is full: contention resolves into a
+/// refusal, never a retry loop against one hot key.
+///
+/// `now_millis` stamps `reserved_at_millis`, so the request is observably alive from the
+/// instant it reserves — *before* it has written a byte, which is the liveness evidence a
+/// pre-first-chunk request otherwise lacks (`0016:349`, decision 6 finding 2).
+#[allow(clippy::too_many_arguments)]
+pub async fn reserve_slot(
+    store: &impl MetadataStore,
+    upload_id: &str,
+    part_number: u32,
+    now_millis: u64,
+    lease_ttl_millis: u64,
+    clock_source: &str,
+    resume: Option<&str>,
+    tokens: &mut impl Tokens,
+    budget: &Budget,
+) -> Result<ReserveOutcome> {
+    // **The key grammar bounds the part number before any tunable does.** `part:`, `psum:` and
+    // `sidx:` keys are fixed-width [`PART_NUMBER_WIDTH`] digits, so a part number the grammar
+    // cannot spell names a record that can be written and never read back — silent loss rather
+    // than a refusal. `knob_clamps_hold` keeps a *legal* budget inside the grammar and every
+    // budget that reaches here has been through it (the ledger's at decode, this caller's at
+    // create), which is exactly why the boundary check is cheap: it is the invariant restated
+    // where the key is actually formatted, so no future retune path can route around it.
+    if part_number == 0
+        || part_number > budget.max_parts_per_session
+        || part_number >= PART_NUMBER_FORMAT_MAX
+    {
+        return Ok(ReserveOutcome::Refused(Refusal::InvalidPart {
+            part_number,
+            reason: InvalidPart::OutOfRange,
+        }));
+    }
+    let attempt_id = match resume {
+        Some(id) => id.to_string(),
+        None => tokens.token(),
+    };
+    require_token(&attempt_id)?;
+    let mut budget_checked = false;
+
+    // Probe each index at most once per pass, and re-read the session on every pass: a
+    // reserve is only authorized while the session is still `Open@E`, so no slot can be
+    // reserved after the fence (`0016:657`, the finding-1 serialization edge).
+    for _ in 0..=budget.max_inflight_parts {
+        let Some(session) = read_session(store, upload_id).await? else {
+            return Ok(ReserveOutcome::Refused(Refusal::NoSuchUpload));
+        };
+        if let Some(refusal) = session.refusal_for_part_verbs() {
+            return Ok(ReserveOutcome::Refused(refusal));
+        }
+        if let Some(skew) = clock_skew(&session.record, clock_source) {
+            return Err(skew.into());
+        }
+        // The caller's budget is checked against the **ledger's** profile before any slot is
+        // claimed, exactly as the admission CAS checks it (X76/X99) — and here rather than at
+        // each later part verb because a `PartUpload` handle can only be minted by this
+        // function, so every batch that follows it inherits a budget the ledger has agreed to.
+        // Otherwise a host whose configuration drifted would enforce *its* per-session caps on
+        // a session admitted under the fleet's — and `MAX_SESSIONS x U_ref <= W_ref` is derived
+        // from those caps, so a skewed in-flight or per-part cap silently overruns the reconcile
+        // budget the whole fleet is sized for, on the one process that never observes it.
+        //
+        // **An absent ledger is a torn store here, not a free pass.** It is read *after* the
+        // session, and the create wrote both records in one batch, so a session that exists with
+        // no `mpuctl` behind it means the ledger was lost — and admitting work against it would
+        // stage bytes under an admission state that bounds nothing, on the very record whose
+        // content is the fleet's only limit. Surfaced, exactly as the terminal delete surfaces
+        // the same tear from the other side (`AGENTS.md:175-177`).
+        if !budget_checked {
+            let Some((_, ledger)) = read_admission(store).await? else {
+                return Err(RecordError::AdmissionLedgerMissing {
+                    upload_id: upload_id.to_string(),
+                }
+                .into());
+            };
+            if ledger.profile != *budget {
+                return Ok(ReserveOutcome::Refused(Refusal::ProfileSkew {
+                    local: Box::new(budget.clone()),
+                    ledger: Box::new(ledger.profile),
+                }));
+            }
+            budget_checked = true;
+        }
+        // The range read decodes **values**, not just keys, because a re-drive of an
+        // **ambiguous** reserve has to be able to find its own landed slot: `attempt_id` is the
+        // per-attempt token that makes that possible (X68, `0016:1697-1717`). Without it a
+        // replay claims a *second* index and the first is leaked until teardown — one of
+        // `MAX_INFLIGHT_PARTS` gone for the life of the session, which a client that retries
+        // often enough turns into a permanent `503`.
+        let mut taken: BTreeSet<u32> = BTreeSet::new();
+        for (key, value) in store.scan(&slot_range(upload_id)).await? {
+            let (_, index) = parse_slot_key(&key)?;
+            let slot: SlotRecord = metadata::decode(&value)?;
+            if slot.attempt_id == attempt_id {
+                // This attempt's own reservation is already durable: adopt it rather than
+                // reserving another index. `staged` starts empty — anything a previous attempt
+                // staged is named by its own `sidx:` entries and is the teardown's, never
+                // silently adopted into this handle's chunk list.
+                return Ok(ReserveOutcome::Reserved(Box::new(PartUpload {
+                    upload_id: upload_id.to_string(),
+                    part_number: slot.part_number,
+                    slot_index: index,
+                    attempt_id,
+                    session,
+                    slot,
+                    slot_bytes: value,
+                    staged: Vec::new(),
+                    budget: budget.clone(),
+                })));
+            }
+            taken.insert(index);
+        }
+        let Some(index) = (0..budget.max_inflight_parts).find(|k| !taken.contains(k)) else {
+            return Ok(ReserveOutcome::Refused(Refusal::SlowDown {
+                pressure: Backpressure::InflightParts {
+                    max_inflight_parts: budget.max_inflight_parts,
+                },
+            }));
+        };
+        let slot = SlotRecord {
+            part_number,
+            attempt_id: attempt_id.clone(),
+            reserved_at_millis: now_millis,
+            lease_expiry_millis: now_millis + lease_ttl_millis,
+        };
+        let slot_bytes = encode_record(&slot)?;
+        let key = slot_key(upload_id, index);
+        let batch = session
+            .fence(WriteBatch::new())
+            .require_absent(key.clone())
+            .put(key.clone(), slot_bytes.clone());
+        let outcome = match store.commit(batch).await {
+            Ok(outcome) => outcome,
+            // **The locally minted attempt id must not be lost to an unknown result** (X68). A
+            // re-read settles the common case; when it does not, the error carries the id so the
+            // caller re-drives *this* attempt (`resume`), which adopts the slot if it lands. A
+            // fresh attempt id would claim a second index and leak the first for the life of the
+            // session — one of `MAX_INFLIGHT_PARTS`, per retry.
+            Err(err) => {
+                // Best-effort, exactly as the create's settling read is: a `?` on the read
+                // would drop the attempt id on the one path that exists to preserve it, and a
+                // re-drive without it claims a second index and leaks the first for the life of
+                // the session.
+                if let Ok(Some(landed)) = store.get(&key).await {
+                    if landed.as_ref() == slot_bytes.as_ref() {
+                        return Ok(ReserveOutcome::Reserved(Box::new(PartUpload {
+                            upload_id: upload_id.to_string(),
+                            part_number,
+                            slot_index: index,
+                            attempt_id,
+                            session,
+                            slot,
+                            slot_bytes,
+                            staged: Vec::new(),
+                            budget: budget.clone(),
+                        })));
+                    }
+                }
+                return Err(IndeterminateCommit::part_attempt(
+                    upload_id.to_string(),
+                    attempt_id,
+                    err,
+                )
+                .into());
+            }
+        };
+        match outcome {
+            CommitOutcome::Committed => {
+                return Ok(ReserveOutcome::Reserved(Box::new(PartUpload {
+                    upload_id: upload_id.to_string(),
+                    part_number,
+                    slot_index: index,
+                    attempt_id,
+                    session,
+                    slot,
+                    slot_bytes,
+                    staged: Vec::new(),
+                    budget: budget.clone(),
+                })));
+            }
+            CommitOutcome::Conflict => {
+                // Either the index was claimed in the window (probe on) or the session left
+                // `Open@E` (the next pass's read answers `NoSuchUpload`). Both are settled by
+                // the loop, and an **ambiguous** outcome is the caller's to re-drive with
+                // this same `attempt_id`, never a fresh index (X68): the reserver then reads
+                // its own token at that index and adopts the slot.
+                continue;
+            }
+        }
+    }
+    Ok(ReserveOutcome::Refused(Refusal::SlowDown {
+        pressure: Backpressure::InflightParts {
+            max_inflight_parts: budget.max_inflight_parts,
+        },
+    }))
+}
+
+/// Renew this attempt's liveness: the owned `sidx:` leases **and** its `slot:` record, in
+/// **one** batch (`0016:658`, X74/X83).
+///
+/// "The same loop" is not atomicity. Split across two batches, the slot bytes a reaper's
+/// idle fence pinned are still unchanged when the `sidx:` renewal lands — so the fence
+/// commits and aborts a request that has demonstrably just progressed. Every batch that
+/// creates *or* renews this request's liveness evidence therefore rewrites its own slot key
+/// atomically with it, which costs one small key in a batch the renewal already commits.
+///
+/// `clock_source` is checked against the session's, as at every other stamping entry point
+/// (`AGENTS.md:131-142`, X106): this is the call that *writes* the expiry a reaper's idle fence
+/// later judges, so a lease renewed under a second clock epoch expires — and is collected — at
+/// an instant unrelated to the one the session was stamped in. That is the #557/#565 defect
+/// class, inside one upload's lifecycle, on the record whose whole purpose is liveness.
+pub async fn renew_part_lease(
+    store: &impl MetadataStore,
+    part: &mut PartUpload,
+    now_millis: u64,
+    lease_ttl_millis: u64,
+    clock_source: &str,
+) -> Result<CommitOutcome> {
+    if let Some(skew) = clock_skew(&part.session.record, clock_source) {
+        return Err(skew.into());
+    }
+    let expiry = now_millis + lease_ttl_millis;
+    let mut batch = part.session.fence(WriteBatch::new());
+    batch = part.pin_slot(batch);
+    for chunk in &part.staged {
+        let key = sidx_key(&part.upload_id, part.part_number, chunk.id);
+        let Some(current) = store.get(&key).await? else {
+            // Refuse rather than resurrect: an owned entry that is gone was reclaimed by a
+            // teardown, and re-creating it would revive protection the fence revoked
+            // (`write.rs:486-489`, issue #490's rule one namespace over).
+            return Ok(CommitOutcome::Conflict);
+        };
+        let entry: PendingEntry = metadata::decode(&current)?;
+        if entry.lease_expiry_millis <= now_millis {
+            return Ok(CommitOutcome::Conflict);
+        }
+        let renewed = PendingEntry {
+            lease_expiry_millis: expiry,
+            ..entry
+        };
+        batch = batch
+            .require(key.clone(), current)
+            .put(key, metadata::encode(&renewed));
+    }
+    let next_slot = SlotRecord {
+        lease_expiry_millis: expiry,
+        ..part.slot.clone()
+    };
+    let next_bytes = encode_record(&next_slot)?;
+    batch = batch.put(part.slot_key(), next_bytes.clone());
+    let outcome = store.commit(batch).await?;
+    if outcome == CommitOutcome::Committed {
+        part.slot = next_slot;
+        part.slot_bytes = next_bytes;
+    }
+    Ok(outcome)
+}
+
+/// Stage one chunk of an in-flight part: the owned `sidx:` intent, then the fragments
+/// (`0016:2692-2709`).
+///
+/// **Intent precedes the bytes**, always: the entry that will protect the fragments is
+/// durable before any fragment reaches a D server, so the backstop that walks `sidx:` finds
+/// every in-flight fragment and no staged byte can exist without a record naming it
+/// (`0016:1528-1529`). The intent batch is [`write::stage_intent`] — the fence, the keyed
+/// slot rewrite, and one `require_absent(desired:dserver:<S>)` per selected server.
+///
+/// A drain-fence loss is **re-planned, not refused** (`0016:851-857`): the caller's
+/// `topology` is re-filtered against the freshly-read draining set and the chunk is
+/// re-encoded onto admissible servers. Only a fleet with no admissible server refuses.
+///
+/// The scheme's fanout is checked against [`MAX_STAGED_FRAGMENTS`] **before the intent**: the
+/// entry this writes is the indivisible unit of [`reclaim_owned`], so a fanout wider than one
+/// batch can evidence would stage bytes whose protection could never be lifted — a session that
+/// holds its admission slot for ever. Refused here, where nothing has been written yet.
+#[allow(clippy::too_many_arguments)]
+pub async fn stage_chunk(
+    store: &impl MetadataStore,
+    chunks: &impl PlacementChunkStore,
+    part: &mut PartUpload,
+    piece: &[u8],
+    scheme: EcScheme,
+    chunk_id: ChunkId,
+    topology: &Topology,
+    now_millis: u64,
+    lease_ttl_millis: u64,
+) -> Result<CommitOutcome> {
+    let fanout = match scheme {
+        EcScheme::None => 1,
+        EcScheme::ReedSolomon { k, m } => u32::from(k) + u32::from(m),
+    };
+    if fanout > MAX_STAGED_FRAGMENTS {
+        return Err(RecordError::StagedFanoutOverBudget {
+            fragments: fanout,
+            limit: MAX_STAGED_FRAGMENTS,
+        }
+        .into());
+    }
+    // The part's chunk list is bounded **as it grows**, before the intent that would add to it:
+    // once the bytes are staged, the only exits are a `part:` record and a `retire:bytes:`
+    // obligation that both carry this list, so a list that cannot fit a value has no exit at all.
+    // Refusing here leaves everything already staged intact and still owned — the caller can
+    // commit what it has or abort — where refusing at the commit would have nothing to write.
+    let projected = metadata::encode(&part.staged).len() + max_chunkref_bytes_for(scheme);
+    if projected > MAX_PART_VALUE_BYTES {
+        return Err(RecordError::StagedPartOverValueBudget {
+            bytes: projected,
+            limit: MAX_PART_VALUE_BYTES,
+        }
+        .into());
+    }
+    let outcome = write::stage_intent(
+        store,
+        chunks,
+        &write::StagedFence {
+            upload_id: &part.upload_id,
+            part_number: part.part_number,
+            session_key: part.session.key(),
+            session_bytes: part.session.bytes.clone(),
+            slot_key: part.slot_key(),
+            slot_bytes: part.slot_bytes.clone(),
+        },
+        piece,
+        scheme,
+        chunk_id,
+        topology,
+        now_millis + lease_ttl_millis,
+    )
+    .await?;
+    match outcome {
+        write::StageOutcome::Staged { chunk, slot_bytes } => {
+            part.staged.push(chunk);
+            part.slot_bytes = slot_bytes;
+            part.slot = SlotRecord {
+                lease_expiry_millis: now_millis + lease_ttl_millis,
+                ..part.slot.clone()
+            };
+            Ok(CommitOutcome::Committed)
+        }
+        write::StageOutcome::Refused => Ok(CommitOutcome::Conflict),
+    }
+}
+
+/// How a part commit's `Conflict` classified (`0016:1583-1645`, X93/X108).
+///
+/// The store reports a `Conflict` without naming which precondition failed, so the committer
+/// **re-reads to establish what happened** (`traits/src/lib.rs:738-745`) before it acts. The
+/// enumeration below has **no starvation state in it**, which is the property the `slot:` key
+/// space bought over the rejected shared per-session counter: concurrent commits of
+/// *different* part numbers share no writable key at all, so a durable part can never be
+/// defeated by an unrelated part's progress.
+#[derive(Debug, Clone, PartialEq, Eq)]
+enum CommitClass {
+    /// This attempt's own commit is already durable — a retry of a batch that in fact
+    /// committed. Report success and **never** re-release the slot (X38/X93).
+    AlreadyLanded(PartRecord),
+    /// A rival attempt for the **same** part number won: a genuine losing writer, which
+    /// compensates its own distinct chunks (X10).
+    LostSamePart,
+    /// The session left `Open` and is **still** non-`Open`: the residue and slot are the
+    /// reaper's, whose `sidx:` walk covers every non-`Open` state. Self-compensating here
+    /// would race that walk (`0016:1600-1604`).
+    SessionFenced,
+    /// A concurrent Complete fenced and **rolled back** to a newer `Open@E'`. The reaper does
+    /// **not** walk `sidx:` for an `Open` session, so this committer must compensate against
+    /// the newer epoch or its chunks and slot sit protected until `W_session` — epoch-chasing
+    /// but terminating (X108).
+    RolledBackTo(Box<SessionSnapshot>),
+    /// Only this attempt's own slot precondition moved, with the session still `Open@E` and
+    /// the part record unchanged: its **own renewal** rewrote the key. A **benign retry** —
+    /// re-read, rebuild, commit again — never the losing-writer compensation, which would
+    /// discard a part whose chunks are all durable (X84/X93).
+    BenignRetry,
+}
+
+/// The **live-session compensation** batch: one `retire:bytes:{chunks}` obligation for the
+/// bytes this attempt staged, the keyed slot release, and this attempt's own `sidx:` deletes
+/// — all under the fence (`0016:672`).
+///
+/// **Every post-staging local refusal routes through here, not just a losing writer**
+/// (`0016:1418-1430`, X85). Returning `EntityTooLarge` and stopping would strand the bytes,
+/// the `sidx:` records **and the slot** — and a client repeating the refusal, which "the
+/// session stays usable" positively invites, then fills `MAX_INFLIGHT_PARTS` and turns a
+/// usable session into a permanent `503`. Routing it through the same batch makes a refusal a
+/// *bounded* event with an exit.
+async fn compensate(
+    store: &impl MetadataStore,
+    part: &PartUpload,
+    session: &SessionSnapshot,
+) -> Result<CommitOutcome> {
+    let mut batch = session.fence(WriteBatch::new());
+    batch = batch.require(part.slot_key(), part.slot_bytes.clone());
+    if !part.staged.is_empty() {
+        let token = RetireToken::Session {
+            upload_id: part.upload_id.clone(),
+            epoch: session.epoch(),
+            part: Some((part.part_number, part.attempt_id.clone())),
+        };
+        let key = retire_key(RetireMode::Bytes, &token);
+        let obligation = RetireObligation::new(RetirePayload::Chunks {
+            chunks: part.staged.clone(),
+        });
+        batch = batch
+            .require_absent(key.clone())
+            .put(key, encode_record(&obligation)?);
+    }
+    batch = batch.delete(part.slot_key());
+    for chunk in &part.staged {
+        batch = batch.delete(sidx_key(&part.upload_id, part.part_number, chunk.id));
+    }
+    store.commit(batch).await
+}
+
+/// [`compensate`], with its **outcome acted on** rather than discarded.
+///
+/// A `Conflict` here means the session moved under the compensating attempt, and the two cases
+/// have different owners: a session still `Open` at a **newer** epoch is this attempt's to
+/// compensate against (the reaper does not walk an `Open` session's `sidx:` range, so nobody
+/// else would), while a non-`Open` one is the reaper's, whose walk covers every non-`Open`
+/// state. Dropping the outcome — the shape this was — reports a clean refusal while the slot,
+/// the owned entries and the staged bytes are all still there, which is precisely the
+/// accumulation that turns "the session stays usable" into a permanent `503`
+/// (`0016:1418-1430`).
+///
+/// One epoch chase, not a loop: each retry is against a freshly read record, and a session that
+/// keeps moving is one whose teardown is imminent anyway.
+async fn compensate_or_defer(
+    store: &impl MetadataStore,
+    part: &PartUpload,
+    session: &SessionSnapshot,
+) -> Result<()> {
+    if compensate(store, part, session).await? == CommitOutcome::Committed {
+        return Ok(());
+    }
+    // The epoch chase is bounded, and **its own outcome is inspected too**. Discarding the
+    // second `Conflict` — the shape this replaces — reports a clean refusal while the slot, the
+    // owned entries and the staged bytes all survive on a session that is *still `Open`*, so
+    // nothing is coming for them: the reaper walks `sidx:` only for a non-`Open` session. Two
+    // such refusals in a row take two of `MAX_INFLIGHT_PARTS` permanently, which is how "the
+    // session stays usable" becomes a permanent `503` (`0016:1418-1430`).
+    for _ in 0..MAX_COMPENSATE_EPOCH_CHASES {
+        match read_session(store, &part.upload_id).await? {
+            Some(current) if current.state() == SessionState::Open => {
+                if compensate(store, part, &current).await? == CommitOutcome::Committed {
+                    return Ok(());
+                }
+            }
+            // Gone, or fenced: the residue and the slot are the teardown's, whose `sidx:` walk
+            // and terminal delete cover both. This is the one arm that is genuinely *deferred*
+            // rather than dropped — there is an owner for the work.
+            _ => return Ok(()),
+        }
+    }
+    // Still `Open` and still losing after the chase: the session is being re-fenced faster than
+    // this attempt can compensate, so its teardown is imminent and owns the residue. Reported
+    // rather than silent, because "a compensation that never landed" is the accumulation the
+    // in-flight cap turns into backpressure.
+    Err(RecordError::CompensationUnlanded {
+        upload_id: part.upload_id.clone(),
+        part_number: part.part_number,
+    }
+    .into())
+}
+
+/// How many times [`compensate_or_defer`] chases a session that is still `Open` at a newer
+/// epoch. Bounded, not a loop: each pass is against a freshly read record, and a session that
+/// keeps moving under a compensating attempt is one whose teardown is imminent anyway.
+const MAX_COMPENSATE_EPOCH_CHASES: u32 = 3;
+
+/// Classify a part commit's `Conflict` by re-reading the records it preconditioned on.
+async fn classify_commit_conflict(
+    store: &impl MetadataStore,
+    part: &PartUpload,
+) -> Result<CommitClass> {
+    let landed = store
+        .get(&part_key(&part.upload_id, part.part_number))
+        .await?;
+    let landed: Option<PartRecord> = landed
+        .as_deref()
+        .map(metadata::decode::<PartRecord>)
+        .transpose()?;
+    if let Some(record) = &landed {
+        // "Its own commit present" is decided by the chunk list, not by mere presence: a
+        // rival attempt for the same part number also writes this key, and reporting success
+        // for *its* part would return the wrong digest to this client.
+        if record.chunks == part.staged {
+            return Ok(CommitClass::AlreadyLanded(record.clone()));
+        }
+    }
+    let session = read_session(store, &part.upload_id).await?;
+    match session {
+        None => Ok(CommitClass::SessionFenced),
+        Some(current) => {
+            if current.bytes != part.session.bytes {
+                if current.state() == SessionState::Open {
+                    return Ok(CommitClass::RolledBackTo(Box::new(current)));
+                }
+                return Ok(CommitClass::SessionFenced);
+            }
+            // Session unchanged. Either a same-part rival won the part key, or this
+            // request's own renewal moved its slot.
+            if landed.is_some() {
+                Ok(CommitClass::LostSamePart)
+            } else {
+                Ok(CommitClass::BenignRetry)
+            }
+        }
+    }
+}
+
+/// The cumulative staged-chunk total this session already holds, read from the **bounded
+/// `psum:` summary range** — tens of bytes per part, never the fat chunk lists
+/// (`0016:1440-1443`).
+async fn staged_chunk_total(store: &impl MetadataStore, upload_id: &str) -> Result<u64> {
+    let mut total = 0u64;
+    for (_, value) in store.scan(&psum_range(upload_id)).await? {
+        let summary: PartSummary = metadata::decode(&value)?;
+        total += u64::from(summary.chunks);
+    }
+    Ok(total)
+}
+
+/// Commit an in-flight part: write its `part:` record and its `psum:` summary, release its
+/// slot, and delete its owned `sidx:` entries — **in one batch** (`0016:659`).
+///
+/// The handoff is atomic *by construction*: the entries that protect the bytes are replaced
+/// by a record that protects the same bytes in the same commit, so protection is continuous
+/// and there is never an instant where the fragments are unclaimed (`0016:698-703`). Split
+/// across two batches, a kill between them leaves fragments with neither a `sidx:` entry nor
+/// a `part:` record naming them — outcome (a).
+///
+/// Preconditions: the fence, the part key (`require_absent` for a first upload or
+/// `require(part: == prior)` for a re-upload), and `require(slot == prior)` on **its own**
+/// slot. On `Conflict` the committer re-reads and classifies ([`CommitClass`]) rather than
+/// compensating blind — compensating a part whose record exists would orphan-mark the chunks
+/// of a live staged part, refutation outcome (c) (`0016:1790`).
+///
+/// The caps are the handle's ([`PartUpload::budget`]), which [`reserve_slot`] took from the
+/// ledger-approved value — never a budget handed to this call, which would let a caller reserve
+/// under the fleet's caps and commit under larger ones of its own.
+pub async fn commit_part(
+    store: &impl MetadataStore,
+    part: &mut PartUpload,
+    part_bytes: &[u8],
+    now_millis: u64,
+    clock_source: &str,
+) -> Result<UploadPartOutcome> {
+    // **One clock per correctness lifecycle** (`AGENTS.md:131-142`, X106). This is a public
+    // entry point that *stamps* `committed_at_millis` — the instant `ListParts` reports and the
+    // reaper's windows are measured from — so the source is checked here as it is at the reserve
+    // and at Complete, rather than trusted because the handle came from somewhere. A part
+    // reserved under a manual clock and committed under the wall clock is the #557/#565 class
+    // inside one session.
+    if let Some(skew) = clock_skew(&part.session.record, clock_source) {
+        return Err(skew.into());
+    }
+    let budget = part.budget.clone();
+    if part.staged.len() > budget.max_part_chunks as usize {
+        // Refused **before** the over-`V` commit, with the staged residue compensated: the
+        // hidden-ceiling class surfaced, not hit at the backend (`0016:1500`).
+        compensate_or_defer(store, part, &part.session).await?;
+        return Ok(UploadPartOutcome::Refused(Refusal::EntityTooLarge {
+            chunks: part.staged.len() as u64,
+            limit: u64::from(budget.max_part_chunks),
+        }));
+    }
+    // **The count ceiling is a byte ceiling in disguise, so the bytes are what is checked here**
+    // (`0016:1050-1053`): `MAX_PART_CHUNKS` divides `V/2` by the worst-case chunk-ref of the
+    // *settled* scheme, while the scheme — hence the placement vector's length — belongs to the
+    // deployment. A wide fanout therefore makes a count-legal part encode past `V`, and both
+    // records that carry this list (the `part:` record and the obligation that would evidence its
+    // chunks) fail together, so the very refusal that releases the slot cannot be written either.
+    // Measured on the list itself, and compensated like every other post-staging refusal.
+    let staged_bytes = metadata::encode(&part.staged).len();
+    if staged_bytes > MAX_PART_VALUE_BYTES {
+        compensate_or_defer(store, part, &part.session).await?;
+        return Ok(UploadPartOutcome::Refused(Refusal::PartValueTooLarge {
+            bytes: staged_bytes,
+            limit: MAX_PART_VALUE_BYTES,
+        }));
+    }
+
+    let digest_hex = hex_lower(&digest(part_bytes));
+    let record = PartRecord {
+        chunks: part.staged.clone(),
+        len: part_bytes.len() as u64,
+        digest: digest_hex.clone(),
+        committed_at_millis: now_millis,
+        session_epoch: part.session.epoch(),
+    };
+    // The value ceiling again, on the whole record rather than its list — the optional fields
+    // cost bytes the list's own budget did not count. Compensated for the same reason: a
+    // deterministic fault that returned bare would strand the slot and the owned entries on a
+    // still-`Open` session, where nothing walks the owned range, and every retry would reproduce
+    // it until the in-flight cap turned a usable session into a permanent `503`
+    // (`0016:1418-1430`, X85).
+    let record_bytes = match encode_record(&record) {
+        Ok(bytes) => bytes,
+        Err(RecordError::ValueOverCeiling { bytes, limit }) => {
+            compensate_or_defer(store, part, &part.session).await?;
+            return Ok(UploadPartOutcome::Refused(Refusal::PartValueTooLarge {
+                bytes,
+                limit,
+            }));
+        }
+        Err(err) => return Err(err.into()),
+    };
+    let summary = PartSummary {
+        chunks: part.staged.len() as u32,
+        len: record.len,
+        digest: digest_hex.clone(),
+        committed_at_millis: now_millis,
+    };
+
+    let part_key = part_key(&part.upload_id, part.part_number);
+    let prior = store.get(&part_key).await?;
+    let prior_record: Option<PartRecord> = prior
+        .as_deref()
+        .map(metadata::decode::<PartRecord>)
+        .transpose()?;
+
+    // The cumulative ceiling, read from the summaries and charged **net** of a re-upload's
+    // superseded chunks. Read-then-commit, so concurrent commits can race it — and that race
+    // is bounded, because at most `max_inflight_parts` commits are in flight (enforced by the
+    // slot key space, not observed), each adding at most `max_part_chunks` (`0016:1443-1451`).
+    let already = staged_chunk_total(store, &part.upload_id).await?;
+    let superseded = prior_record
+        .as_ref()
+        .map_or(0, |record| record.chunks.len() as u64);
+    let projected = already - superseded.min(already) + part.staged.len() as u64;
+    if projected > u64::from(budget.max_staged_chunks) {
+        compensate_or_defer(store, part, &part.session).await?;
+        return Ok(UploadPartOutcome::Refused(Refusal::EntityTooLarge {
+            chunks: projected,
+            limit: u64::from(budget.max_staged_chunks),
+        }));
+    }
+
+    let mut batch = part.session.fence(WriteBatch::new());
+    batch = part.pin_slot(batch);
+    batch = match &prior {
+        Some(bytes) => batch.require(part_key.clone(), bytes.clone()),
+        None => batch.require_absent(part_key.clone()),
+    };
+    batch = batch
+        .put(part_key, record_bytes)
+        .put(
+            psum_key(&part.upload_id, part.part_number),
+            encode_record(&summary)?,
+        )
+        .delete(part.slot_key());
+    for chunk in &part.staged {
+        batch = batch.delete(sidx_key(&part.upload_id, part.part_number, chunk.id));
+    }
+    // A **re-upload** supersedes the prior attempt's chunks: their bytes lose their only
+    // naming record in this batch, so the obligation that evidences them is installed
+    // atomically with it (`0016:659`) — never in a later commit a crash could skip.
+    //
+    // A prior that named **no** chunks (a zero-length part is legal and commits an empty chunk
+    // list) owes nothing, and an *empty* obligation is not a harmless no-op: `RetirePayload`'s
+    // decode rejects one — an obligation that owes nothing is a record no writer should
+    // produce — so writing it here would leave a `retire:bytes:` key its own drain cannot
+    // decode, blocking that session's teardown and its `mpuctl` decrement for ever. Nothing to
+    // evidence, therefore nothing to install; `compensate` takes the same emptiness guard.
+    if let Some(prior_record) = prior_record.as_ref().filter(|r| !r.chunks.is_empty()) {
+        let token = RetireToken::Session {
+            upload_id: part.upload_id.clone(),
+            epoch: part.session.epoch(),
+            part: Some((part.part_number, part.attempt_id.clone())),
+        };
+        let key = retire_key(RetireMode::Bytes, &token);
+        let obligation = RetireObligation::new(RetirePayload::Chunks {
+            chunks: prior_record.chunks.clone(),
+        });
+        batch = batch
+            .require_absent(key.clone())
+            .put(key, encode_record(&obligation)?);
+    }
+
+    match store.commit(batch).await? {
+        CommitOutcome::Committed => Ok(UploadPartOutcome::Committed {
+            part_number: part.part_number,
+            digest: digest_hex,
+        }),
+        CommitOutcome::Conflict => match classify_commit_conflict(store, part).await? {
+            CommitClass::AlreadyLanded(landed) => Ok(UploadPartOutcome::Committed {
+                part_number: part.part_number,
+                digest: landed.digest,
+            }),
+            CommitClass::BenignRetry => {
+                // Re-read the slot this request's own renewal moved and commit again. The
+                // renewal is this attempt's, so exactly one re-read settles it; a
+                // conforming caller quiesces its renewal loop first (X84) and never
+                // reaches here.
+                let Some(bytes) = store.get(&part.slot_key()).await? else {
+                    return Ok(UploadPartOutcome::Refused(Refusal::NoSuchUpload));
+                };
+                part.slot = metadata::decode(&bytes)?;
+                part.slot_bytes = bytes;
+                let mut retry = part.clone();
+                let outcome = Box::pin(commit_part(
+                    store,
+                    &mut retry,
+                    part_bytes,
+                    now_millis,
+                    clock_source,
+                ))
+                .await?;
+                *part = retry;
+                Ok(outcome)
+            }
+            CommitClass::LostSamePart => {
+                compensate_or_defer(store, part, &part.session).await?;
+                Ok(UploadPartOutcome::Refused(Refusal::InvalidPart {
+                    part_number: part.part_number,
+                    reason: InvalidPart::DigestMismatch,
+                }))
+            }
+            CommitClass::RolledBackTo(current) => {
+                // Compensate against the NEWER epoch: the session is live, this committer
+                // owns exactly those records, and the reaper does not walk an `Open`
+                // session's `sidx:` range (X108).
+                compensate_or_defer(store, part, &current).await?;
+                Ok(UploadPartOutcome::Refused(Refusal::NoSuchUpload))
+            }
+            CommitClass::SessionFenced => {
+                // Deliberately **no** self-compensation: the residue and the slot are the
+                // reaper's, whose `sidx:` walk covers every non-`Open` state, and a second
+                // slot release racing it is the hazard `require(slot == prior)` exists to
+                // make unrepresentable (`0016:1600-1604`).
+                Ok(UploadPartOutcome::Refused(Refusal::NoSuchUpload))
+            }
+        },
+    }
+}
+
+/// `UploadPart` end to end: reserve a slot, stage the part's chunks, commit.
+///
+/// The per-part chunking is the part's **own**: a part is chunked from its own first byte, so
+/// a non-final part that is not a whole multiple of `chunk_size` yields a short final chunk
+/// and the published map's chunk boundaries follow **part** boundaries. That is why a correct
+/// implementation legitimately yields a different chunk count from a plain PUT of the same
+/// bytes, while the published *bytes* are identical.
+///
+/// The `MAX_PART_CHUNKS` refusal is decided **from the plan, before the first intent**, so an
+/// over-large part stages nothing at all (`0016:1500`).
+///
+/// `clock` is read **once per chunk**, not once per part, and that is load-bearing rather than
+/// tidy: each staged chunk rewrites the request's `slot:` record with a fresh
+/// `lease_expiry_millis` (X83), and a single frozen instant makes every one of those rewrites
+/// byte-identical — so a long but steadily progressing upload never extends its lease and the
+/// reaper's idle fence may abort it while it is demonstrably making progress. One source, read
+/// repeatedly (`AGENTS.md:131-142`).
+#[allow(clippy::too_many_arguments)]
+pub async fn upload_part(
+    store: &impl MetadataStore,
+    chunks: &impl PlacementChunkStore,
+    upload_id: &str,
+    part_number: u32,
+    body: &[u8],
+    chunk_size: usize,
+    scheme: EcScheme,
+    topology: &Topology,
+    clock: &mut impl FnMut() -> u64,
+    clock_source: &str,
+    lease_ttl_millis: u64,
+    tokens: &mut impl Tokens,
+    next_chunk_id: &mut impl FnMut() -> ChunkId,
+    budget: &Budget,
+) -> Result<UploadPartOutcome> {
+    let chunk_size = chunk_size.max(1);
+    let planned_chunks = body.len().div_ceil(chunk_size).max(1);
+    if planned_chunks > budget.max_part_chunks as usize {
+        // Nothing staged, nothing to compensate: the refusal is decided from the declared
+        // body before a slot is even claimed, so the session is untouched and still usable.
+        return Ok(UploadPartOutcome::Refused(Refusal::EntityTooLarge {
+            chunks: planned_chunks as u64,
+            limit: u64::from(budget.max_part_chunks),
+        }));
+    }
+    // …and the same decision in **bytes**, from the plan, for the scheme this request actually
+    // uses: `budget.max_part_chunks` divides `V/2` by the *settled* scheme's worst-case
+    // chunk-ref, so a wider fanout makes a count-legal part encode past `V`. Deciding it here
+    // means an over-value part stages nothing at all — the alternative is discovering it at the
+    // commit, where the compensation carries the same oversized list and cannot be written
+    // either (`0016:1500`).
+    let planned_value = planned_chunks * max_chunkref_bytes_for(scheme);
+    if planned_value > MAX_PART_VALUE_BYTES {
+        return Ok(UploadPartOutcome::Refused(Refusal::PartValueTooLarge {
+            bytes: planned_value,
+            limit: MAX_PART_VALUE_BYTES,
+        }));
+    }
+
+    let reserved = match reserve_slot(
+        store,
+        upload_id,
+        part_number,
+        clock(),
+        lease_ttl_millis,
+        clock_source,
+        None,
+        tokens,
+        budget,
+    )
+    .await
+    {
+        Ok(outcome) => outcome,
+        // **An indeterminate reserve is re-driven once with the attempt id it minted** (X68).
+        // That is what lets the re-drive *adopt* a slot that landed — the reserve scans slot
+        // values for its own token — instead of claiming a second index and leaking the first
+        // for the life of the session. Any other error propagates unchanged.
+        Err(err) => {
+            let Some(attempt_id) = err
+                .downcast_ref::<IndeterminateCommit>()
+                .and_then(IndeterminateCommit::attempt_id)
+                .map(str::to_string)
+            else {
+                return Err(err);
+            };
+            reserve_slot(
+                store,
+                upload_id,
+                part_number,
+                clock(),
+                lease_ttl_millis,
+                clock_source,
+                Some(&attempt_id),
+                tokens,
+                budget,
+            )
+            .await?
+        }
+    };
+    let mut part = match reserved {
+        ReserveOutcome::Reserved(part) => *part,
+        ReserveOutcome::Refused(refusal) => return Ok(UploadPartOutcome::Refused(refusal)),
+    };
+
+    for piece in body.chunks(chunk_size) {
+        let staged = stage_chunk(
+            store,
+            chunks,
+            &mut part,
+            piece,
+            scheme,
+            next_chunk_id(),
+            topology,
+            clock(),
+            lease_ttl_millis,
+        )
+        .await;
+        // **An error mid-part compensates before it propagates.** Whatever refused — a fanout no
+        // teardown could reclaim, a chunk list at its value budget, a store fault — this request
+        // holds a slot and, usually, owned entries on a session that is still `Open`, and nothing
+        // walks an `Open` session's owned range. Returning bare would leave one of
+        // `MAX_INFLIGHT_PARTS` and its staged bytes behind per attempt (`AGENTS.md:178-180`, the
+        // roll-back-before-an-early-return rule). The compensation is best-effort *around* the
+        // original error, which is the one the caller must see.
+        let outcome = match staged {
+            Ok(outcome) => outcome,
+            Err(err) => {
+                if let Ok(Some(current)) = read_session(store, upload_id).await {
+                    if current.state() == SessionState::Open {
+                        let _ = compensate_or_defer(store, &part, &current).await;
+                    }
+                }
+                return Err(err);
+            }
+        };
+        if outcome != CommitOutcome::Committed {
+            // The intent lost its fence: the session is no longer `Open@E`, so this
+            // attempt's residue is the reaper's (or, for a rollback, compensated by the
+            // classification below). Nothing is published either way.
+            let session = read_session(store, upload_id).await?;
+            match session {
+                Some(current) if current.state() == SessionState::Open => {
+                    compensate_or_defer(store, &part, &current).await?;
+                }
+                _ => {}
+            }
+            return Ok(UploadPartOutcome::Refused(Refusal::NoSuchUpload));
+        }
+    }
+
+    commit_part(store, &mut part, body, clock(), clock_source).await
+}
+
+/// `ListParts`: the committed part summaries of a session, in part-number order, read from
+/// the bounded `psum:` range — exactly the fields the verb needs and never the chunk lists
+/// (`0016:352`).
+///
+/// `Ok(Err(refusal))` is the verb x state answer: `Aborting`, `Completed` and an absent
+/// record all answer [`Refusal::NoSuchUpload`]; `Completing` answers the **frozen** part set
+/// (`0016:977`).
+pub async fn list_parts(
+    store: &impl MetadataStore,
+    upload_id: &str,
+) -> Result<std::result::Result<Vec<(u32, PartSummary)>, Refusal>> {
+    let Some(session) = read_session(store, upload_id).await? else {
+        return Ok(Err(Refusal::NoSuchUpload));
+    };
+    match session.state() {
+        SessionState::Open | SessionState::Completing => {}
+        SessionState::Aborting | SessionState::Completed => {
+            return Ok(Err(Refusal::NoSuchUpload));
+        }
+    }
+    let mut parts = Vec::new();
+    for (key, value) in store.scan(&psum_range(upload_id)).await? {
+        let (_, part_number) = parse_psum_key(&key)?;
+        parts.push((part_number, metadata::decode::<PartSummary>(&value)?));
+    }
+    parts.sort_by_key(|(number, _)| *number);
+    Ok(Ok(parts))
+}
+
+/// Read a session's committed `part:` records, in part-number order, through the **bounded
+/// per-session range** (`0016:351`).
+pub async fn read_parts(
+    store: &impl MetadataStore,
+    upload_id: &str,
+) -> Result<BTreeMap<u32, PartRecord>> {
+    let mut parts = BTreeMap::new();
+    for (key, value) in store.scan(&part_range(upload_id)).await? {
+        let (_, part_number) = parse_part_key(&key)?;
+        parts.insert(part_number, metadata::decode::<PartRecord>(&value)?);
+    }
+    Ok(parts)
+}
+
+// ===========================================================================
+// 9. Complete — fence, validate, publish
+// ===========================================================================
+
+/// What Complete is asked to assemble.
+#[derive(Debug, Clone)]
+pub struct CompleteParams<'a> {
+    /// The session to publish.
+    pub upload_id: &'a str,
+    /// The parts the client named, in the order it named them: `(part_number, digest)`.
+    pub named: &'a [(u32, String)],
+    /// The publication instant (ADR-0047's `modified`, and `completed_at_millis`).
+    pub now_millis: u64,
+    /// Which clock stamped it — compared against the session's own, so one lifecycle is never
+    /// stamped from two clock epochs (`AGENTS.md:131-142`, X106).
+    pub clock_source: &'a str,
+    /// This process's derived budget.
+    pub budget: &'a Budget,
+    /// The fence value to **adopt** on a re-drive after an indeterminate fence commit — the
+    /// bytes [`IndeterminateCommit::fence_bytes`] carried (X78's rule, one transition over).
+    ///
+    /// `None` on an ordinary request, which is why a `Completing` session still answers
+    /// `OperationAborted` to every client: this is the owning publisher recovering **its own**
+    /// unknown result at the same epoch, the one resume 0016 allows (`0016:952-961`). The match
+    /// is on the session record's exact bytes, so a rival publisher's fence — a different epoch,
+    /// therefore a different record — can never be adopted by mistake.
+    pub resume: Option<&'a [u8]>,
+}
+
+/// The session record a fence or a release installs, derived from `prior`.
+fn fenced_session(
+    prior: &SessionRecord,
+    state: SessionState,
+    now_millis: u64,
+    segments_written: Option<u32>,
+) -> SessionRecord {
+    let epoch = prior.epoch + 1;
+    match state {
+        SessionState::Completing => SessionRecord {
+            state,
+            epoch,
+            attempts: prior.attempts + 1,
+            fenced_at_millis: Some(now_millis),
+            segments_written,
+            publish_target: Some(PublishTarget {
+                parent: prior.parent,
+                name: prior.object.clone(),
+                fence_epoch: epoch,
+            }),
+            ..prior.clone()
+        },
+        // A release drops every `Completing`-only field, so the record an `Open` session
+        // carries is byte-identical in shape to a freshly created one — which is what
+        // `decode_session`'s state rules enforce.
+        SessionState::Open => SessionRecord {
+            state,
+            epoch,
+            fenced_at_millis: None,
+            segments_written: None,
+            publish_target: None,
+            ..prior.clone()
+        },
+        SessionState::Aborting => SessionRecord {
+            state,
+            epoch,
+            fenced_at_millis: None,
+            segments_written: None,
+            publish_target: None,
+            ..prior.clone()
+        },
+        SessionState::Completed => SessionRecord {
+            state,
+            epoch,
+            fenced_at_millis: None,
+            segments_written: None,
+            publish_target: None,
+            ..prior.clone()
+        },
+    }
+}
+
+/// Release a fence back to `Open` — the answer to an invalid request, an exhausted publish
+/// retry budget, or an over-ceiling map (`0016:993-999`, `0016:663`).
+///
+/// The one thing a rejected request may never do is leave the session fenced, which would
+/// make a client error indistinguishable from a crashed completer and wedge the upload until
+/// the reaper's `W_completing`. A release also installs `retire:records:{seg}` for any
+/// segments this attempt wrote, so a rolled-back attempt's `seg:` records always have a
+/// deleter (X57's hole, reached through the ordinary door).
+async fn release_fence(
+    store: &impl MetadataStore,
+    fenced: &SessionSnapshot,
+    now_millis: u64,
+) -> Result<CommitOutcome> {
+    let next = fenced_session(&fenced.record, SessionState::Open, now_millis, None);
+    let mut batch = fenced
+        .fence(WriteBatch::new())
+        .put(fenced.key(), encode_record(&next)?);
+    if fenced.record.segments_written.unwrap_or(0) > 0 {
+        let epoch = fenced
+            .record
+            .publish_target
+            .as_ref()
+            .map_or(fenced.epoch(), |target| target.fence_epoch);
+        let token = RetireToken::Session {
+            upload_id: fenced.upload_id.clone(),
+            epoch,
+            part: None,
+        };
+        let key = retire_key(RetireMode::Records, &token);
+        let obligation = RetireObligation::new(RetirePayload::Records {
+            parts: None,
+            segments: Some(SegmentGeneration {
+                nonce: fenced.record.group_nonce.clone(),
+                epoch,
+            }),
+        });
+        batch = batch
+            .require_absent(key.clone())
+            .put(key, encode_record(&obligation)?);
+    }
+    store.commit(batch).await
+}
+
+/// [`release_fence`] with its **outcome acted on**: one re-read and one retry against what the
+/// store now holds.
+///
+/// The release is preconditioned on the session's bytes, and a segmented attempt's own segment
+/// batches have already advanced them — so releasing against the fence-time snapshot
+/// `Conflict`s and strands the session in `Completing` until the reaper's `W_completing`, which
+/// this slice merges without. A conflict is therefore re-read: still `Completing` **at this
+/// caller's own fence epoch** ⇒ release against the current record; anything else ⇒ the fence is
+/// no longer ours and there is nothing to release.
+///
+/// **The epoch check is what makes the retry safe.** `Completing` alone is not identity: the
+/// interleaving this retry exists for (our own segment batches moved the record) is
+/// indistinguishable by *state* from the one where our fence was rolled back and a rival Complete
+/// fenced afresh — and releasing then would roll back a publisher that is mid-publication, on the
+/// authority of an error that belongs to a finished request. `publish_fenced`'s own retry re-read
+/// applies exactly this test (`fence_epoch` equality), so the two agree on what "still ours"
+/// means.
+async fn release_fenced_session(
+    store: &impl MetadataStore,
+    fenced: &SessionSnapshot,
+    params: &CompleteParams<'_>,
+) -> Result<()> {
+    if release_fence(store, fenced, params.now_millis).await? == CommitOutcome::Conflict {
+        let ours = fenced
+            .record
+            .publish_target
+            .as_ref()
+            .map(|target| target.fence_epoch);
+        if let Some(current) = read_session(store, params.upload_id).await? {
+            let still_ours = current.state() == SessionState::Completing
+                && current
+                    .record
+                    .publish_target
+                    .as_ref()
+                    .map(|target| target.fence_epoch)
+                    == ours;
+            if still_ours {
+                release_fence(store, &current, params.now_millis).await?;
+            }
+        }
+    }
+    Ok(())
+}
+
+/// What the object key currently resolves to — re-resolved at **every** flip attempt
+/// (`0016:350`).
+// The size difference between the arms is the point: `Supersede` carries the two records'
+// exact bytes because those bytes ARE the flip's preconditions, and boxing them would buy a
+// heap indirection on a value that lives for one attempt. A private enum, one construction
+// site, never stored.
+#[allow(clippy::large_enum_variant)]
+enum FlipTarget {
+    /// The dirent is absent: mint a fresh inode id and publish version 1 under
+    /// `require_absent` on both keys.
+    Fresh { inode: InodeId },
+    /// The dirent names a committed generation: CAS its exact bytes and publish
+    /// `prior.version + 1` computed from **this** re-read prior.
+    Supersede {
+        inode: InodeId,
+        dirent_bytes: Bytes,
+        prior_bytes: Bytes,
+        prior: InodeRecord,
+    },
+}
+
+async fn resolve_flip_target(
+    store: &impl MetadataStore,
+    parent: InodeId,
+    name: &str,
+    next_inode_id: &mut impl FnMut() -> InodeId,
+) -> Result<FlipTarget> {
+    let dirent_key = metadata::dirent_key(parent, name);
+    match store.get(&dirent_key).await? {
+        None => Ok(FlipTarget::Fresh {
+            inode: next_inode_id(),
+        }),
+        Some(dirent_bytes) => {
+            let dirent: metadata::DirentRecord = metadata::decode(&dirent_bytes)?;
+            match store.get(&metadata::inode_key(dirent.inode)).await? {
+                // **A dangling dirent is a torn store, surfaced — never published over.** The
+                // shape this replaces fabricated an empty version-1 inode and published
+                // `version 2` on top of it, which records a version derived from a record that
+                // does not exist and silently drops whatever the dirent was meant to name. An
+                // absent referenced entry is an explicit error or a repair obligation, never
+                // silent success (`AGENTS.md:175-177`).
+                None => Err(ChunkMapError::DanglingDirent {
+                    parent,
+                    name: name.to_string(),
+                    inode: dirent.inode,
+                }
+                .into()),
+                Some(prior_bytes) => {
+                    let prior: InodeRecord = metadata::decode(&prior_bytes)?;
+                    Ok(FlipTarget::Supersede {
+                        inode: dirent.inode,
+                        dirent_bytes,
+                        prior_bytes,
+                        prior,
+                    })
+                }
+            }
+        }
+    }
+}
+
+/// The mutations and preconditions a flip owes **besides** the root itself: the session's own
+/// transition to `Completed` and the two publication obligations (`0016:662`).
+///
+/// They ride in the **same** batch as the root by construction, so there is no state in which
+/// the object is published and the session is not `Completed`, or the reverse (`0016:941-947`,
+/// F5) — and no state in which a publication's parts are never retired.
+fn publication_batch(
+    fenced: &SessionSnapshot,
+    published: &[u32],
+    unnamed: &[u32],
+    completion: &Completion,
+    superseded: Option<(InodeId, &InodeRecord)>,
+) -> Result<WriteBatch> {
+    let next = SessionRecord {
+        state: SessionState::Completed,
+        epoch: fenced.record.epoch + 1,
+        fenced_at_millis: None,
+        segments_written: None,
+        publish_target: None,
+        completion: Some(completion.clone()),
+        ..fenced.record.clone()
+    };
+    let mut batch = fenced
+        .fence(WriteBatch::new())
+        .put(fenced.key(), encode_record(&next)?);
+    let epoch = fenced
+        .record
+        .publish_target
+        .as_ref()
+        .map_or(fenced.epoch(), |target| target.fence_epoch);
+
+    // `retire:records:{parts}` names **only the PUBLISHED parts** (X104). If it named all of
+    // them it could delete an unnamed part's `part:` record first — the only thing protecting
+    // those chunks *and* the only source of their placements — leaving the byte obligation
+    // nothing to mark from: durable bytes unreferenced AND unevidenced, outcome (a) installed
+    // by the publication path itself.
+    if !published.is_empty() {
+        let token = RetireToken::Session {
+            upload_id: fenced.upload_id.clone(),
+            epoch,
+            part: None,
+        };
+        let key = retire_key(RetireMode::Records, &token);
+        let obligation = RetireObligation::new(RetirePayload::Records {
+            parts: Some(PartNumberSet::from_iter_unsorted(published.iter().copied())),
+            segments: None,
+        });
+        batch = batch
+            .require_absent(key.clone())
+            .put(key, encode_record(&obligation)?);
+    }
+    // The unnamed staged parts ride ONE `retire:bytes:` obligation, whose payload already
+    // means "mark, then delete the naming records" — one obligation, its own internal order,
+    // no cross-obligation dependency to get wrong.
+    if !unnamed.is_empty() {
+        let token = RetireToken::Session {
+            upload_id: fenced.upload_id.clone(),
+            epoch,
+            part: None,
+        };
+        let key = retire_key(RetireMode::Bytes, &token);
+        let obligation = RetireObligation::new(RetirePayload::Parts {
+            parts: PartNumberSet::from_iter_unsorted(unnamed.iter().copied()),
+        });
+        batch = batch
+            .require_absent(key.clone())
+            .put(key, encode_record(&obligation)?);
+    }
+    // The superseded generation is retired by **obligation**, never by an inline orphan
+    // fan-out: expanding it here would owe one put per prior fragment in the publishing batch
+    // (46,080 for a 5 GiB generation) — permanently over the envelope, outcome (d)
+    // (`0016:1046-1049`,`:1084-1088`).
+    if let Some((inode, prior)) = superseded {
+        // The same routing the ordinary overwrite and delete paths take
+        // ([`metadata::retire_generation`]), so a multipart publication and a `PutObject` over
+        // the same object retire the generation *identically* — one decision, one record class,
+        // one spelling, and the segmented arm resolved from the prior's own group rather than
+        // re-derived here. Expanding it inline unconditionally would owe one put per prior
+        // fragment in the publishing batch (46,080 for a 5 GiB generation) — permanently over
+        // the envelope, outcome (d) (`0016:1046-1049`,`:1084-1088`).
+        batch = metadata::retire_generation(batch, inode, prior, completion.completed_at_millis)?;
+    }
+    Ok(batch)
+}
+
+/// `CompleteMultipartUpload`: fence, validate the named part list against the frozen part
+/// set, then publish (`0016:704-710`).
+///
+/// **The fence is the proof.** Because every part commit carries `require(mpu == Open@E)` and
+/// every teardown begins with a fence, no `part:` record can be created, replaced or deleted
+/// after this fence lands — so one O(1) session precondition proves *the entire part set is
+/// exactly what Complete read*, at no batch-size cost and with no serialization of concurrent
+/// part uploads. Per-part exact-value preconditions would give the same guarantee and put N
+/// part values in the flip batch, which a 10,000-part Complete cannot fit (`0016:711-716`).
+///
+/// **The published version is never frozen at fence time**: each flip attempt re-resolves the
+/// dirent and computes `prior.version + 1` from *that* re-read prior, so a retry against a
+/// prior a concurrent `PutObject` just advanced records the correct next version
+/// (`0016:925-932`, the iteration-4 finding; matching `commit_chunk_map_superseding`,
+/// `metadata.rs:551`,`:595`,`:656`).
+///
+/// A map past the flat ceiling is published as **#635's segmented map** through its staged
+/// publication, with this session's fence supplied as the precondition of every segment batch
+/// and of the flip.
+pub async fn complete(
+    store: &impl MetadataStore,
+    params: &CompleteParams<'_>,
+    next_inode_id: &mut impl FnMut() -> InodeId,
+) -> Result<CompleteOutcome> {
+    // The fence is attempted at most twice. The second attempt exists for exactly one
+    // interleaving: this caller lost the fence CAS to a rival Complete which then *released*
+    // the fence (its own client's part list was invalid, or its publish budget ran out), so the
+    // session is `Open` again and the verb x state table's answer for `Open` is "fences,
+    // publishes" (`0016:972-978`) — reporting `NoSuchUpload` for a session that exists and
+    // accepts Complete would be a wrong answer, not a conservative one. It is bounded rather
+    // than a loop because a session that keeps being re-fenced is contended, and `409` is the
+    // table's answer to contention.
+    for attempt in 0..2u32 {
+        let Some(session) = read_session(store, params.upload_id).await? else {
+            return Ok(CompleteOutcome::Refused(Refusal::NoSuchUpload));
+        };
+        match session.state() {
+            SessionState::Aborting => return Ok(CompleteOutcome::Refused(Refusal::NoSuchUpload)),
+            // There is no *client* path that resumes a `Completing` session: the only resume is
+            // the owning gateway recovering its own unknown result at the same epoch
+            // (`0016:952-961`,`:980-986`), and a crashed completer is recovered by the reaper's
+            // rollback. That one resume is `params.resume`, matched on the record's **exact
+            // bytes**: a session whose record is byte-for-byte this caller's own fence is this
+            // caller's fence — no rival publisher's can be, because theirs carries their epoch —
+            // so publication proceeds under it instead of the session being wedged in a state
+            // whose only other exit is a reaper this slice merges without.
+            SessionState::Completing => {
+                let adopted = params
+                    .resume
+                    .is_some_and(|fence| session.bytes.as_ref() == fence);
+                if !adopted {
+                    return Ok(CompleteOutcome::Refused(Refusal::OperationAborted));
+                }
+                if let Some(skew) = clock_skew(&session.record, params.clock_source) {
+                    return Err(skew.into());
+                }
+                let mut fenced = session;
+                return finish_under_fence(store, &mut fenced, params, next_inode_id).await;
+            }
+            SessionState::Completed => return tombstone_answer(&session, params),
+            SessionState::Open => {}
+        }
+        if let Some(skew) = clock_skew(&session.record, params.clock_source) {
+            return Err(skew.into());
+        }
+        if session.record.attempts >= MAX_COMPLETE_ATTEMPTS {
+            return Ok(CompleteOutcome::Refused(Refusal::CompleteAttemptsExhausted));
+        }
+
+        let fenced_record = fenced_session(
+            &session.record,
+            SessionState::Completing,
+            params.now_millis,
+            Some(0),
+        );
+        let fenced_bytes = encode_record(&fenced_record)?;
+        let fence_batch = session
+            .fence(WriteBatch::new())
+            .put(session.key(), fenced_bytes.clone());
+        // **An `Err` from the fence commit may be an UNKNOWN result, and this one cannot be
+        // retried blind.** If the fence in fact landed, the session is `Completing` and no
+        // public path resumes it (`0016:952-961`) — a client retry answers `OperationAborted`
+        // and the upload is wedged until the reaper's `W_completing`, which is #625's and is not
+        // running when this slice merges.
+        //
+        // One absent re-read does **not** settle it. An unknown result means the batch may still
+        // be in flight, so "not there yet" and "never" are the same observation, and a store that
+        // cannot answer the read at all is a third. All three therefore report the *same*
+        // indeterminate outcome **carrying the fence value**, exactly as an indeterminate create
+        // reports its minted identity (X78): re-driving through `params.resume` then adopts the
+        // fence if it landed — whenever it landed — and fences afresh if it did not. Reporting a
+        // bare error here is what leaves a session `Completing` with nothing able to name it.
+        let fence_outcome = match store.commit(fence_batch).await {
+            Ok(outcome) => outcome,
+            Err(err) => match read_session(store, params.upload_id).await {
+                Ok(Some(current)) if current.bytes == fenced_bytes => CommitOutcome::Committed,
+                _ => {
+                    return Err(IndeterminateCommit::complete_fence(
+                        params.upload_id.to_string(),
+                        fenced_bytes,
+                        err,
+                    )
+                    .into())
+                }
+            },
+        };
+        if fence_outcome == CommitOutcome::Conflict {
+            // Another Complete fenced first, or a teardown did: exactly one fences
+            // (`0016:1031`). The next pass of this loop re-reads and answers from the state it
+            // finds — including the tombstone answer, if the rival has already published.
+            if attempt == 0 {
+                continue;
+            }
+            return Ok(CompleteOutcome::Refused(Refusal::OperationAborted));
+        }
+        let mut fenced = SessionSnapshot {
+            upload_id: params.upload_id.to_string(),
+            bytes: fenced_bytes,
+            record: fenced_record,
+        };
+
+        return finish_under_fence(store, &mut fenced, params, next_inode_id).await;
+    }
+    Ok(CompleteOutcome::Refused(Refusal::OperationAborted))
+}
+
+/// Publish under a fence this caller owns — freshly installed, or **adopted** on a re-drive —
+/// releasing it on every exit that does not publish.
+///
+/// One function for both entries so the release discipline cannot drift between them: a fence
+/// left behind by the adopting path would wedge the session exactly as one left behind by the
+/// fencing path does.
+async fn finish_under_fence(
+    store: &impl MetadataStore,
+    fenced: &mut SessionSnapshot,
+    params: &CompleteParams<'_>,
+    next_inode_id: &mut impl FnMut() -> InodeId,
+) -> Result<CompleteOutcome> {
+    match publish_fenced(store, fenced, params, next_inode_id).await {
+        Ok(CompleteOutcome::Refused(refusal)) => {
+            // Every refusal past the fence releases it, so the session stays usable and
+            // abortable (`0016:1032`).
+            release_fenced_session(store, fenced, params).await?;
+            Ok(CompleteOutcome::Refused(refusal))
+        }
+        // **An `Err` releases the fence too.** A deterministic fault under the fence — an
+        // over-ceiling root, a dangling dirent, a torn record — is as much "this request
+        // will not publish" as a typed refusal is, and propagating it while the session
+        // stays `Completing` wedges the upload for every later verb: Complete answers
+        // `OperationAborted`, Abort answers `OperationAborted`, and the only exit is the
+        // reaper this slice merges without. The release is best-effort *around* the
+        // original error, which is the one the caller must see: a secondary failure here
+        // must not replace the fault that caused it.
+        Err(err) => {
+            let _ = release_fenced_session(store, fenced, params).await;
+            Err(err)
+        }
+        other => other,
+    }
+}
+
+/// What a `Completed` tombstone answers: success with the **recorded** publication for an
+/// identical retry, `NoSuchUpload` for a different assembly under a consumed upload id
+/// (`0016:898-908`, X81).
+fn tombstone_answer(
+    session: &SessionSnapshot,
+    params: &CompleteParams<'_>,
+) -> Result<CompleteOutcome> {
+    let recorded = session
+        .record
+        .completion
+        .as_ref()
+        .ok_or(RecordError::FieldRequiredByState {
+            state: SessionState::Completed,
+            field: "completion",
+        })?;
+    if complete_fingerprint(params.named) == recorded.complete_fingerprint {
+        return Ok(CompleteOutcome::AlreadyCompleted(Box::new(Publication {
+            inode: recorded.inode,
+            version: recorded.version,
+            etag: recorded.etag.clone(),
+            completed_at_millis: recorded.completed_at_millis,
+        })));
+    }
+    // A **different** assembly under a consumed upload id: the honest answer is
+    // `NoSuchUpload`, which is exactly what the same request receives one tick after the
+    // tombstone window closes (X81).
+    Ok(CompleteOutcome::Refused(Refusal::NoSuchUpload))
+}
+
+/// The part of Complete that runs **under** the fence: validate, assemble, publish.
+async fn publish_fenced(
+    store: &impl MetadataStore,
+    fenced: &mut SessionSnapshot,
+    params: &CompleteParams<'_>,
+    next_inode_id: &mut impl FnMut() -> InodeId,
+) -> Result<CompleteOutcome> {
+    let parts = read_parts(store, params.upload_id).await?;
+
+    // Validate against the FROZEN set: every named part exists, its recorded digest matches,
+    // and the numbers ascend strictly.
+    let mut previous = 0u32;
+    let mut named_recorded: Vec<(u32, String)> = Vec::with_capacity(params.named.len());
+    for (part_number, digest) in params.named {
+        if *part_number == 0 || *part_number > params.budget.max_parts_per_session {
+            return Ok(CompleteOutcome::Refused(Refusal::InvalidPart {
+                part_number: *part_number,
+                reason: InvalidPart::OutOfRange,
+            }));
+        }
+        if *part_number <= previous {
+            return Ok(CompleteOutcome::Refused(Refusal::InvalidPart {
+                part_number: *part_number,
+                reason: InvalidPart::OutOfOrder,
+            }));
+        }
+        previous = *part_number;
+        let Some(record) = parts.get(part_number) else {
+            return Ok(CompleteOutcome::Refused(Refusal::InvalidPart {
+                part_number: *part_number,
+                reason: InvalidPart::Absent,
+            }));
+        };
+        if &record.digest != digest {
+            return Ok(CompleteOutcome::Refused(Refusal::InvalidPart {
+                part_number: *part_number,
+                reason: InvalidPart::DigestMismatch,
+            }));
+        }
+        named_recorded.push((*part_number, record.digest.clone()));
+    }
+    if named_recorded.is_empty() {
+        return Ok(CompleteOutcome::Refused(Refusal::InvalidPart {
+            part_number: 0,
+            reason: InvalidPart::Absent,
+        }));
+    }
+
+    // Assemble the map: the named parts' chunk lists concatenated in part-number order.
+    let mut chunks: Vec<ChunkRef> = Vec::new();
+    let mut size = 0u64;
+    let mut digests: Vec<[u8; 32]> = Vec::with_capacity(named_recorded.len());
+    for (part_number, digest_hex) in &named_recorded {
+        let record = &parts[part_number];
+        chunks.extend(record.chunks.iter().cloned());
+        size += record.len;
+        digests.push(
+            parse_digest(digest_hex).ok_or_else(|| RecordError::TokenNotHex {
+                token: digest_hex.clone(),
+            })?,
+        );
+    }
+    // The **authoritative** ceiling check, at the fence where the part set is frozen: the
+    // early per-part refusal is a courtesy, this is what the bound rests on (`0016:1414-1417`).
+    if chunks.len() > MAX_ROOT_SEGMENTS * MAX_SEG_CHUNKS {
+        return Ok(CompleteOutcome::Refused(Refusal::EntityTooLarge {
+            chunks: chunks.len() as u64,
+            limit: (MAX_ROOT_SEGMENTS * MAX_SEG_CHUNKS) as u64,
+        }));
+    }
+
+    let etag = multipart_etag(&digests);
+    let fingerprint = complete_fingerprint(params.named);
+    let published: Vec<u32> = named_recorded.iter().map(|(n, _)| *n).collect();
+    let unnamed: Vec<u32> = parts
+        .keys()
+        .copied()
+        .filter(|n| !published.contains(n))
+        .collect();
+    let meta = ObjectMeta {
+        etag: Some(etag.clone()),
+        content_type: fenced.record.content_type.clone(),
+        modified: Some(params.now_millis),
+    };
+
+    // **The bucket must still exist, and its record is pinned in the flip** (ADR-0046 §4,
+    // `0016:662`,`:1034`): a `DeleteBucket` that lands while this session is open must not leave
+    // an object stranded in a bucket that is gone, and a client told its Complete succeeded into
+    // one is the worst of the three outcomes. Read first so the answer is `NoSuchBucket` rather
+    // than an unexplained `Conflict`, then pinned so a delete racing the flip loses to it.
+    let bucket_key = metadata::bucket_key(&fenced.record.bucket);
+    let Some(bucket_bytes) = store.get(&bucket_key).await? else {
+        return Ok(CompleteOutcome::Refused(Refusal::NoSuchBucket));
+    };
+
+    for attempt in 0..R_PUBLISH.max(1) {
+        if attempt > 0 {
+            // **Re-read the session before retrying.** A segmented attempt's segment batches
+            // advance `segments_written` in the session record, so after a lost root flip the
+            // fence value *and* the resume cursor this attempt must use are both the ones those
+            // batches left — not the ones the fence installed. Retrying from the fence-time
+            // snapshot makes every later batch (and the eventual release) `Conflict` against a
+            // record its own predecessor wrote, so the publication can never finish and the
+            // session is stranded in `Completing` until the reaper's `W_completing`.
+            match read_session(store, params.upload_id).await? {
+                Some(current)
+                    if current.state() == SessionState::Completing
+                        && current
+                            .record
+                            .publish_target
+                            .as_ref()
+                            .map(|t| t.fence_epoch)
+                            == fenced.record.publish_target.as_ref().map(|t| t.fence_epoch) =>
+                {
+                    *fenced = current;
+                }
+                // The fence is no longer ours: rolled back, aborted, or published by the
+                // recovery path. Nothing to retry and nothing to release.
+                _ => return Ok(CompleteOutcome::Refused(Refusal::OperationAborted)),
+            }
+        }
+        let target = resolve_flip_target(
+            store,
+            fenced.record.parent,
+            &fenced.record.object,
+            next_inode_id,
+        )
+        .await?;
+        let (inode, version, superseded, root_pre) = match &target {
+            FlipTarget::Fresh { inode } => (*inode, 1u64, None, None),
+            FlipTarget::Supersede {
+                inode,
+                dirent_bytes,
+                prior_bytes,
+                prior,
+            } => (
+                *inode,
+                // **Checked, never `+ 1`**, through the one helper every version-advancing site
+                // in this crate uses: at `u64::MAX` an unchecked increment panics with overflow
+                // checks on and wraps to zero without them, and a version that went *backwards*
+                // is worse than a refusal because every CAS here orders writers by it
+                // (`metadata::next_root_version`).
+                metadata::next_root_version(prior)?,
+                Some((*inode, prior)),
+                Some((dirent_bytes.clone(), prior_bytes.clone(), prior)),
+            ),
+        };
+        let completion = Completion {
+            inode,
+            version,
+            etag: etag.clone(),
+            completed_at_millis: params.now_millis,
+            complete_fingerprint: fingerprint.clone(),
+        };
+        let mut batch = publication_batch(fenced, &published, &unnamed, &completion, superseded)?;
+        batch = batch.require(bucket_key.clone(), bucket_bytes.clone());
+        // The target dirent is pinned on BOTH branches: publication is defined against the
+        // **dirent identity**, so guarding only the inode would let a `metadata::rename` move
+        // the dirent after Complete resolved it and this flip would overwrite an inode now
+        // bound at another name (`0016:662`, iteration-9 finding 6).
+        let dirent_key = metadata::dirent_key(fenced.record.parent, &fenced.record.object);
+        batch = match &root_pre {
+            None => batch
+                .require_absent(dirent_key.clone())
+                .require_absent(metadata::inode_key(inode))
+                .put(
+                    dirent_key,
+                    metadata::encode(&metadata::DirentRecord { inode }),
+                ),
+            Some((dirent_bytes, prior_bytes, _)) => {
+                let batch = batch.require(dirent_key, dirent_bytes.clone());
+                if prior_bytes.is_empty() {
+                    batch.require_absent(metadata::inode_key(inode))
+                } else {
+                    batch.require(metadata::inode_key(inode), prior_bytes.clone())
+                }
+            }
+        };
+
+        let outcome = if chunks.len() <= MAX_MAP_CHUNKS {
+            let root = InodeRecord {
+                size,
+                chunk_map: chunks.clone().into(),
+                state: InodeState::Committed,
+                version,
+                etag: meta.etag.clone(),
+                content_type: meta.content_type.clone(),
+                modified: meta.modified,
+            };
+            // Through the inode **write boundary**, not a bare `encode`: the shape check is
+            // what keeps a root that no consumer could resolve out of the store, and the value
+            // ceiling is charged here because the optional publication metadata (ADR-0047) can
+            // consume the headroom the chunk-count ceiling reserved.
+            let root_bytes = metadata::encode_inode(&root)?;
+            if root_bytes.len() > MAX_VALUE_BYTES {
+                return Err(RecordError::ValueOverCeiling {
+                    bytes: root_bytes.len(),
+                    limit: MAX_VALUE_BYTES,
+                }
+                .into());
+            }
+            store
+                .commit(batch.put(metadata::inode_key(inode), root_bytes))
+                .await?
+        } else {
+            publish_segmented(store, fenced, inode, &chunks, &meta, batch, &target).await?
+        };
+        if outcome == CommitOutcome::Committed {
+            return Ok(CompleteOutcome::Published(Box::new(Publication {
+                inode,
+                version,
+                etag,
+                completed_at_millis: params.now_millis,
+            })));
+        }
+    }
+    // Retries exhausted: the fence is released by the caller and the client may retry Complete
+    // without re-uploading a part (`0016:938-940`).
+    Ok(CompleteOutcome::Refused(Refusal::OperationAborted))
+}
+
+/// Publish a map past the flat ceiling through #635's **staged publication**: write the
+/// `seg:` records in byte-budgeted batches, then flip the root (`0016:2332-2345`).
+///
+/// Every phase-1 batch and the flip pin **this session's** record, and each phase-1 batch
+/// advances the `segments_written` cursor in the same commit — so the fence value a batch
+/// requires is the record its predecessor left, and a rollback that deletes these segments
+/// must first move that record, which turns the flip into a `Conflict`.
+#[allow(clippy::too_many_arguments)]
+async fn publish_segmented(
+    store: &impl MetadataStore,
+    fenced: &SessionSnapshot,
+    // (the caller passes its freshly re-read snapshot, so `resume_from` below is the cursor the
+    // last committed segment batch left — never the fence-time zero)
+    inode: InodeId,
+    chunks: &[ChunkRef],
+    meta: &ObjectMeta,
+    flip: WriteBatch,
+    target: &FlipTarget,
+) -> Result<CommitOutcome> {
+    let fence_epoch = fenced
+        .record
+        .publish_target
+        .as_ref()
+        .map_or(fenced.epoch(), |t| t.fence_epoch);
+    let group = SegmentGroup::new(fenced.record.group_nonce.clone(), fence_epoch)?;
+    let fence_key = fenced.key();
+    let session_key = fence_key.clone();
+    let cursor_bytes = |written: u32| -> Bytes {
+        let record = SessionRecord {
+            segments_written: Some(written),
+            ..fenced.record.clone()
+        };
+        metadata::encode(&record)
+    };
+    let segment_batch = |info: &SegmentBatchInfo| -> WriteBatch {
+        WriteBatch::new()
+            .require(session_key.clone(), cursor_bytes(info.first_index))
+            .put(session_key.clone(), cursor_bytes(info.written))
+    };
+    let root = match target {
+        FlipTarget::Fresh { .. } => RootPrecondition::Fresh,
+        FlipTarget::Supersede { prior, .. } => RootPrecondition::Supersede(prior),
+    };
+    // The flip contribution's own fence must pin the record the LAST segment batch left, not
+    // the one the fence installed, or a multi-batch publication could never flip.
+    let segments_planned = {
+        let probe = SegmentedPublication {
+            inode_id: inode,
+            root,
+            group: group.clone(),
+            chunks: chunks.to_vec(),
+            meta: meta.clone(),
+            fence_key: fence_key.clone(),
+            segment_batch: &segment_batch,
+            resume_from: 0,
+            batch_budget: None,
+            ops_budget: None,
+            flip: WriteBatch::new(),
+        };
+        probe.plan()?.len() as u32
+    };
+    let mut flip = flip;
+    flip.preconditions.retain(|pre| pre.key != fence_key);
+    flip = flip.require(fence_key.clone(), cursor_bytes(segments_planned));
+    let publication = SegmentedPublication {
+        inode_id: inode,
+        root,
+        group,
+        chunks: chunks.to_vec(),
+        meta: meta.clone(),
+        fence_key: fence_key.clone(),
+        segment_batch: &segment_batch,
+        resume_from: fenced.record.segments_written.unwrap_or(0),
+        batch_budget: None,
+        ops_budget: None,
+        flip,
+    };
+    // The root the flip installs is the publication's own ([`SegmentedPublication::root`]),
+    // which derives `size` from the segment table it planned and the version from `root` — so
+    // neither is passed in here, and there is no second statement of either to disagree.
+    publication.publish(store).await
+}
+
+// ===========================================================================
+// 10. Abort — the fence IS the response
+// ===========================================================================
+
+/// `AbortMultipartUpload`: fence `Open@E → Aborting@E+1` and install the teardown obligation,
+/// in **one** O(1) batch (`0016:664`).
+///
+/// **The fence commit is the response** (`0016:1000-1003`, F9): byte reclamation is the
+/// drain's, asynchronously and in bounded batches, so tearing down a 10,000-part session never
+/// rides inside one request — and the admission counter is deliberately *unchanged* here,
+/// because the decrement belongs to the terminal delete alone.
+pub async fn abort(
+    store: &impl MetadataStore,
+    upload_id: &str,
+    now_millis: u64,
+    clock_source: &str,
+) -> Result<AbortOutcome> {
+    let Some(session) = read_session(store, upload_id).await? else {
+        return Ok(AbortOutcome::Refused(Refusal::NoSuchUpload));
+    };
+    match session.state() {
+        SessionState::Aborting => return Ok(AbortOutcome::AlreadyAborting),
+        SessionState::Completed => return Ok(AbortOutcome::Refused(Refusal::NoSuchUpload)),
+        // A client cannot abort a session a publisher owns; the reaper's `W_completing`
+        // rollback, or the operator verb (#633), is that state's exit.
+        SessionState::Completing => return Ok(AbortOutcome::Refused(Refusal::OperationAborted)),
+        SessionState::Open => {}
+    }
+    if let Some(skew) = clock_skew(&session.record, clock_source) {
+        return Err(skew.into());
+    }
+    // **Nothing is read here, and that is the fix for a real leak.** An earlier shape
+    // enumerated the session's parts *before* this fence and froze the list into the
+    // obligation — but a part commit only *reads* the session record, so one that landed in the
+    // window between that read and this fence was absent from the frozen list, and its
+    // `part:`/`psum:` records then survived every teardown batch and outlived the session
+    // itself: a session-less part record protecting bytes nothing will ever reclaim. The
+    // obligation names the session instead, and the drain enumerates the range this fence has
+    // just made immutable ([`RetirePayload::Session`]).
+    let next = fenced_session(&session.record, SessionState::Aborting, now_millis, None);
+    let token = RetireToken::Session {
+        upload_id: upload_id.to_string(),
+        epoch: session.epoch() + 1,
+        part: None,
+    };
+    let obligation_key = retire_key(RetireMode::Bytes, &token);
+    let obligation = RetireObligation::new(RetirePayload::Session {});
+    let batch = session
+        .fence(WriteBatch::new())
+        .require_absent(obligation_key.clone())
+        .put(session.key(), encode_record(&next)?)
+        .put(obligation_key, encode_record(&obligation)?);
+    match store.commit(batch).await? {
+        CommitOutcome::Committed => Ok(AbortOutcome::Fenced),
+        CommitOutcome::Conflict => match read_session(store, upload_id).await? {
+            None => Ok(AbortOutcome::Refused(Refusal::NoSuchUpload)),
+            Some(current) => match current.state() {
+                SessionState::Aborting => Ok(AbortOutcome::AlreadyAborting),
+                SessionState::Completing => Ok(AbortOutcome::Refused(Refusal::OperationAborted)),
+                _ => Ok(AbortOutcome::Refused(Refusal::NoSuchUpload)),
+            },
+        },
+    }
+}
+
+// ===========================================================================
+// 11. Retirement — bounded, resumable, idempotent
+// ===========================================================================
+
+/// The envelope one drain (or segment) batch stays inside: `min(B_bytes, B_ops)`
+/// (`0016:621-648`).
+///
+/// **Both axes, because they bound different resources.** `E_tx` bounds a transaction's
+/// *size*; the backend also states a 5-second deadline, and every backend applies a batch's
+/// preconditions and mutations **sequentially inside the transaction** (TiKV awaits each
+/// `get_for_update`/`put`/`delete`, `metadata-tikv/src/lib.rs:1063-1095`; FDB awaits every
+/// precondition read, `metadata-fdb/src/lib.rs:1425-1438`). So ~1,000 tiny `orphan:` marks
+/// can exceed the deadline while far under 5 MB — and a batch that always times out is not
+/// slow, it is **stuck**, which for a drain step means the work never completes at all.
+///
+/// A **count** budget alone is worse in the other direction: 1,000 records x `V` is 100 MB,
+/// 10x the envelope and a permanent commit failure (`0016:1496`). Hence neither alone.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct DrainBudget {
+    /// Mutation+precondition bytes per commit (`B_bytes`, `E_tx/2`).
+    pub max_batch_bytes: usize,
+    /// Operations per commit (`B_ops`).
+    pub max_batch_ops: usize,
+}
+
+impl Default for DrainBudget {
+    fn default() -> Self {
+        Self {
+            max_batch_bytes: MAX_BATCH_BYTES,
+            max_batch_ops: MAX_BATCH_OPS,
+        }
+    }
+}
+
+/// What a drain actually did — the observable a convergence test asserts on.
+#[derive(Debug, Clone, Default, PartialEq, Eq)]
+pub struct DrainReport {
+    /// How many batches were committed.
+    pub batches: usize,
+    /// How many `orphan:` marks were written (a position already marked is **skipped**, so
+    /// this counts evidence created, not positions visited).
+    pub marks: usize,
+    /// How many naming records were deleted.
+    pub record_deletes: usize,
+    /// How many obligations were drained to completion and removed.
+    pub obligations_drained: usize,
+    /// How many owned `sidx:` entries were reclaimed by the reference-based walk.
+    pub owned_reclaimed: usize,
+    /// The **largest** batch this drain committed, in encoded mutation+precondition bytes —
+    /// the byte budget's own observable (`0016:1496` demands bytes, not a record count).
+    pub max_batch_bytes: usize,
+    /// The largest batch in operations.
+    pub max_batch_ops: usize,
+    /// Whether a terminal session delete fired.
+    pub terminal_deleted: bool,
+    /// Whether `mpuctl.count` was decremented — **at most once per teardown**, in the
+    /// terminal batch alone.
+    pub count_decremented: bool,
+}
+
+impl DrainReport {
+    /// Charge a batch that **committed**.
+    ///
+    /// Charged *after* the outcome is known, never before: a batch that lost its
+    /// single-winner compare-and-set changed nothing, so counting it would report conflicts as
+    /// committed batches and inflate the very envelope observables leg G asserts on — a drain
+    /// that took one batch and lost four would look like it took five.
+    fn charge(&mut self, batch: &WriteBatch) {
+        self.batches += 1;
+        self.max_batch_bytes = self.max_batch_bytes.max(metadata::batch_bytes(batch));
+        self.max_batch_ops = self.max_batch_ops.max(metadata::batch_ops(batch));
+    }
+}
+
+/// Parse a `retire:` key back into its mode and token — the inverse of [`retire_key`], so an
+/// enumerated obligation can be drained without a second copy of its identity in the value.
+pub fn parse_retire_key(key: &[u8]) -> std::result::Result<(RetireMode, RetireToken), RecordError> {
+    let mode = parse_retire_mode(key)?;
+    let malformed = || RecordError::MalformedKey {
+        namespace: "retire:",
+        key: String::from_utf8_lossy(key).into_owned(),
+    };
+    let text = std::str::from_utf8(key).map_err(|_| malformed())?;
+    let rest = text
+        .strip_prefix(std::str::from_utf8(mode.prefix()).map_err(|_| malformed())?)
+        .ok_or_else(malformed)?;
+    let fields: Vec<&str> = rest.split(':').collect();
+    // Every token in a session-scoped key is a 128-bit token rendered lowercase hex
+    // (`0016:358-380`,`:493-497`). Parsed, not merely split: the upload id keys the bounded
+    // `part:`/`psum:`/`sidx:` ranges the drain enumerates, so a key carrying anything else names
+    // ranges no writer can reproduce — and the drain would then delete an obligation having
+    // walked ranges that were empty because the id was wrong, not because the work was done.
+    let token = match fields.as_slice() {
+        ["s", upload_id, epoch] => RetireToken::Session {
+            upload_id: (*upload_id).to_string(),
+            epoch: epoch.parse().map_err(|_| malformed())?,
+            part: None,
+        },
+        ["s", upload_id, epoch, part, attempt] => RetireToken::Session {
+            upload_id: (*upload_id).to_string(),
+            epoch: epoch.parse().map_err(|_| malformed())?,
+            part: Some((
+                part.parse().map_err(|_| malformed())?,
+                (*attempt).to_string(),
+            )),
+        },
+        ["g", inode, version] => RetireToken::Generation {
+            inode: inode.parse().map_err(|_| malformed())?,
+            version: version.parse().map_err(|_| malformed())?,
+        },
+        _ => return Err(malformed()),
+    };
+    if let RetireToken::Session {
+        upload_id, part, ..
+    } = &token
+    {
+        require_token(upload_id)?;
+        if let Some((part_number, attempt)) = part {
+            require_token(attempt)?;
+            if *part_number == 0 || *part_number >= PART_NUMBER_FORMAT_MAX {
+                return Err(RecordError::PartNumberOutOfRange {
+                    part_number: u64::from(*part_number),
+                });
+            }
+        }
+    }
+    Ok((mode, token))
+}
+
+/// The upload id a session-scoped token names, if it is one.
+fn token_upload_id(token: &RetireToken) -> Option<&str> {
+    match token {
+        RetireToken::Session { upload_id, .. } => Some(upload_id),
+        RetireToken::Generation { .. } => None,
+    }
+}
+
+/// The chunks of one drain **unit** — a part, a segment, or the single inline list — or
+/// `None` when the unit has no record **at this instant**, which the walk steps over rather
+/// than treating as the end of the range.
+///
+/// The distinction is the whole of a shipped defect: the segment arm used to answer `None` for
+/// an absent `seg:` record and the marking walk read that as "range exhausted", so a **missing
+/// middle** segment finished an obligation whose later segments — and every fragment they alone
+/// named — were never evidenced. Units are now enumerated from the ranges that hold them
+/// ([`next_marking_unit`], [`next_segment_unit`]), so a gap is a gap and only exhaustion ends
+/// the walk.
+///
+/// A part named by a **frozen** part set whose record is absent is an **error**, never empty
+/// progress: that record is the only source of its chunks' placements, so finishing the
+/// obligation without it would leave durable bytes unreferenced *and* unevidenced — outcome (a),
+/// silently (`AGENTS.md:175-177`).
+async fn unit_chunks(
+    store: &impl MetadataStore,
+    key: &[u8],
+    token: &RetireToken,
+    payload: &RetirePayload,
+    outer: u32,
+) -> Result<Option<Vec<ChunkRef>>> {
+    match payload {
+        RetirePayload::Session {} | RetirePayload::Parts { .. } => {
+            if let RetirePayload::Parts { parts } = payload {
+                if !parts.contains(outer) {
+                    return Ok(None);
+                }
+            }
+            let Some(upload_id) = token_upload_id(token) else {
+                return Ok(None);
+            };
+            let Some(bytes) = store.get(&part_key(upload_id, outer)).await? else {
+                if matches!(payload, RetirePayload::Session {}) {
+                    // Enumerated from the live range, so an absent record means the range moved
+                    // under a concurrent drainer: re-derive rather than fail.
+                    return Ok(None);
+                }
+                return Err(ChunkMapError::RetireUnitAbsent {
+                    key: String::from_utf8_lossy(key).into_owned(),
+                    unit: outer,
+                }
+                .into());
+            };
+            let record: PartRecord = metadata::decode(&bytes)?;
+            Ok(Some(record.chunks))
+        }
+        RetirePayload::Chunks { chunks } => {
+            if outer == 0 {
+                Ok(Some(chunks.clone()))
+            } else {
+                Ok(None)
+            }
+        }
+        RetirePayload::Generation {
+            chunks, segments, ..
+        } => match segments {
+            None => {
+                if outer == 0 {
+                    Ok(Some(chunks.clone()))
+                } else {
+                    Ok(None)
+                }
+            }
+            Some(generation) => {
+                let group = generation.group()?;
+                match store.get(&metadata::seg_key(&group, outer)).await? {
+                    // Absent *now*, though the enumeration just saw it: another drainer took it.
+                    // The caller steps over the index; it is not the end of the range.
+                    None => Ok(None),
+                    // Re-read at drain time, never a frozen placement: a reconstruction or
+                    // rebalance may have repointed a segment's chunks since the generation was
+                    // superseded (`0016:354`, X47).
+                    Some(bytes) => Ok(Some(
+                        metadata::decode::<metadata::SegmentRecord>(&bytes)?.into_chunks(),
+                    )),
+                }
+            }
+        },
+        // A records-mode obligation orphan-marks nothing at all — its bytes are live object
+        // content or still protected by another record (`0016:434-440`).
+        RetirePayload::Records { .. } => Ok(None),
+    }
+}
+
+/// The first part number `>= from` this session still holds, read from its **bounded** own
+/// range one row at a time (`0016:351`).
+///
+/// This is what makes a `Session` obligation complete without freezing a part list: the fence
+/// that installed the obligation is what stops any part record being created, replaced or
+/// deleted, so the range is immutable from the fence onwards and enumerating it at drain time
+/// sees **exactly** the parts the session holds — including one that landed in the window
+/// between an aborting caller's read and its fence, which a frozen list omits for ever.
+async fn next_session_part(
+    store: &impl MetadataStore,
+    upload_id: &str,
+    from: u32,
+) -> Result<Option<u32>> {
+    let prefix = part_range(upload_id);
+    // **The cursor is the read's own lower bound, and the page is one row.** `after` is
+    // exclusive (`traits/src/lib.rs:1046-1053`), and every key under this prefix is the same
+    // fixed width, so "strictly after part `from - 1`" is exactly "the first part `>= from`".
+    // Passing an empty cursor and an unbounded limit — the shape this replaces — re-read the
+    // whole part range on **every** unit and made a maximum-size teardown quadratic in the
+    // session's part count.
+    let cursor = (from > 1).then(|| part_key(upload_id, from - 1));
+    let (rows, _) = store.scan_page(&prefix, cursor.as_deref(), 1).await?;
+    match rows.first() {
+        Some((key, _)) => {
+            let (_, part_number) = parse_part_key(key)?;
+            Ok((part_number >= from).then_some(part_number))
+        }
+        None => Ok(None),
+    }
+}
+
+/// The first segment index `>= from` a generation's **bounded** `seg:<nonce>:<epoch>:` range
+/// actually holds — enumerated, never probed forward.
+///
+/// Probing forward and stopping at the first absent index is what let a missing middle segment
+/// end the walk (see [`unit_chunks`]); reading the range answers the same question without ever
+/// mistaking a gap for the end, at one page-of-one read per unit.
+async fn next_segment_unit(
+    store: &impl MetadataStore,
+    group: &SegmentGroup,
+    from: u32,
+) -> Result<Option<u32>> {
+    let prefix = metadata::seg_range_prefix(group);
+    let cursor = (from > 0).then(|| metadata::seg_key(group, from - 1));
+    let (rows, _) = store.scan_page(&prefix, cursor.as_deref(), 1).await?;
+    match rows.first() {
+        Some((key, _)) => {
+            let (_, _, index) = metadata::parse_seg_key(key)?;
+            Ok((index >= from).then_some(index))
+        }
+        None => Ok(None),
+    }
+}
+
+/// The validated segment group a payload's segment space belongs to, if it has one.
+///
+/// Total rather than "best effort": [`SegmentGeneration`] validates its nonce at decode, so this
+/// only ever fails for a value constructed in-process, and it **propagates** that failure
+/// instead of converting it into an empty key list — the shape that let a records-mode
+/// obligation be deleted having deleted none of its segments.
+fn payload_group(payload: &RetirePayload) -> Result<Option<SegmentGroup>> {
+    let generation = match payload {
+        RetirePayload::Generation {
+            segments: Some(generation),
+            ..
+        }
+        | RetirePayload::Records {
+            segments: Some(generation),
+            ..
+        } => generation,
+        _ => return Ok(None),
+    };
+    Ok(Some(generation.group()?))
+}
+
+/// The next unit at or after `from`, for the marking walk. The marking phase has exactly **one**
+/// unit space for every payload (a `Generation` naming both a chunk list and a segment
+/// generation is rejected at decode), so it needs no arm.
+async fn next_marking_unit(
+    store: &impl MetadataStore,
+    token: &RetireToken,
+    payload: &RetirePayload,
+    from: u32,
+) -> Result<Option<u32>> {
+    match payload {
+        RetirePayload::Session {} => match token_upload_id(token) {
+            Some(upload_id) => next_session_part(store, upload_id, from).await,
+            None => Ok(None),
+        },
+        RetirePayload::Parts { parts } => Ok(parts.first_at_or_after(from)),
+        RetirePayload::Chunks { .. } => Ok((from == 0).then_some(0)),
+        RetirePayload::Generation { segments, .. } => match segments {
+            None => Ok((from == 0).then_some(0)),
+            Some(generation) => next_segment_unit(store, &generation.group()?, from).await,
+        },
+        RetirePayload::Records { .. } => Ok(None),
+    }
+}
+
+/// The keys one unit's **naming records** occupy in `space`, for the deleting walk.
+///
+/// Never an empty vector: a space the payload does not have is not walked at all
+/// ([`RetirePayload::delete_spaces`]), and a token that cannot name the space's keys is a
+/// token/payload mismatch the drain refuses up front ([`payload_matches_token`]). The shape this
+/// replaces answered `Vec::new()` for both, and the deleting walk read an empty key list as "the
+/// obligation is done".
+fn unit_record_keys(
+    token: &RetireToken,
+    payload: &RetirePayload,
+    space: DeleteSpace,
+    outer: u32,
+) -> Result<Vec<Vec<u8>>> {
+    match space {
+        DeleteSpace::Parts => {
+            let id = token_upload_id(token).ok_or_else(|| {
+                ChunkMapError::RetireTokenPayloadMismatch {
+                    key: format!("{token} names no session, but its payload owes part records"),
+                }
+            })?;
+            Ok(vec![part_key(id, outer), psum_key(id, outer)])
+        }
+        DeleteSpace::Segments => {
+            let group = payload_group(payload)?.ok_or_else(|| {
+                ChunkMapError::RetireTokenPayloadMismatch {
+                    key: format!("{token} owes a segment space its payload does not name"),
+                }
+            })?;
+            Ok(vec![metadata::seg_key(&group, outer)])
+        }
+    }
+}
+
+/// The next unit at or after `from` **inside one delete space**.
+async fn next_delete_unit(
+    store: &impl MetadataStore,
+    token: &RetireToken,
+    payload: &RetirePayload,
+    space: DeleteSpace,
+    from: u32,
+) -> Result<Option<u32>> {
+    match space {
+        DeleteSpace::Parts => match payload {
+            RetirePayload::Session {} => match token_upload_id(token) {
+                Some(upload_id) => next_session_part(store, upload_id, from).await,
+                None => Ok(None),
+            },
+            RetirePayload::Parts { parts }
+            | RetirePayload::Records {
+                parts: Some(parts), ..
+            } => Ok(parts.first_at_or_after(from)),
+            _ => Ok(None),
+        },
+        DeleteSpace::Segments => match payload_group(payload)? {
+            Some(group) => next_segment_unit(store, &group, from).await,
+            None => Ok(None),
+        },
+    }
+}
+
+/// Whether the identity a `retire:` **key** declares can own the payload its value carries
+/// (`0016:358-380`,`:434-440`).
+///
+/// The mode cross-check ([`RetirePayload::is_valid_for`]) is not enough on its own: a `Session`
+/// payload under a **generation** token passes it, and its walk then enumerates a part range
+/// keyed by an upload id the token does not have — an obligation that "finishes" without
+/// processing one named record, deleting the last thing that protected those bytes.
+fn payload_matches_token(token: &RetireToken, payload: &RetirePayload) -> bool {
+    match (token, payload) {
+        // A per-part token owns exactly one shape: the compensating writer's own chunk list.
+        (RetireToken::Session { part: Some(_), .. }, RetirePayload::Chunks { .. }) => true,
+        (
+            RetireToken::Session { part: None, .. },
+            RetirePayload::Session {}
+            | RetirePayload::Parts { .. }
+            | RetirePayload::Chunks { .. }
+            | RetirePayload::Records { .. },
+        ) => true,
+        // A generation token names the exact generation its payload retires — one publication
+        // produced both, so anything else is a record no writer in this crate can have written.
+        (
+            RetireToken::Generation { inode, version },
+            RetirePayload::Generation {
+                inode: payload_inode,
+                version: payload_version,
+                ..
+            },
+        ) => inode == payload_inode && version == payload_version,
+        _ => false,
+    }
+}
+
+/// Whether a unit's records exist — the deleting walk's termination test for a probe-forward
+/// range.
+async fn unit_records_present(store: &impl MetadataStore, keys: &[Vec<u8>]) -> Result<bool> {
+    for key in keys {
+        if store.get(key).await?.is_some() {
+            return Ok(true);
+        }
+    }
+    Ok(false)
+}
+
+/// One `orphan:` mark, under the **three-arm guard** decision 4.2 makes normative
+/// (`0016:1218-1224`, `0016:667`/`:671`).
+///
+/// The arms are chosen by what the writer **read** at that position, and the identity of the
+/// unreference event is *not* read from the mark's value — it is structural, which is what lets
+/// this slice implement the rule without the value-schema change 0016 assigns to the custodian
+/// (`gc.rs` parses a bare decimal today, so a structured value written from here would be
+/// dropped by the running collector and make the fragment unreclaimable):
+///
+/// * **absent** ⇒ write it, stamped now, under `require_absent(orphan:<pos>)`;
+/// * **present** ⇒ this event has *not* marked this position yet, so the mark predates the
+///   reference this event is removing: **stale evidence**, replaced under the exact-value
+///   `require(orphan:<pos> == prior)` with a fresh stamp, which is the full `G_orphan` the
+///   deletion actually happening now owes an overlapping reader (`0016:1160-1172`). An
+///   unconditional "present ⇒ skip" is the reader-safety defect this arm exists to close: it
+///   keeps an already-expired stamp across a later unreference event, and GC then reclaims on
+///   its very next pass with no grace at all;
+/// * **same identity** ⇒ skip, original stamp intact. This arm is **structurally unreachable**
+///   in both writers, which is why it needs no identity in the value. A `retire:`-driven step
+///   only ever visits positions at or after the obligation's own cursor, and the cursor advances
+///   in the **same** compare-and-set batch as the marks — so a position this obligation already
+///   marked is never re-derived. The owned-`sidx:` walk marks a position in the **same** batch
+///   that deletes the entry naming it, so a marked position has no entry left to re-derive it
+///   from. In both cases the second concurrent drainer (X56) loses the batch **whole** and
+///   re-reads, so a position is marked exactly once per unreference event and no live grace
+///   clock is ever re-stamped.
+async fn mark_fragment(
+    store: &impl MetadataStore,
+    batch: WriteBatch,
+    dserver: DServerId,
+    frag: FragmentId,
+    now_millis: u64,
+) -> Result<WriteBatch> {
+    let key = metadata::orphan_key(dserver, frag);
+    let stamp = Bytes::from(now_millis.to_string().into_bytes());
+    Ok(match store.get(&key).await? {
+        None => batch.require_absent(key.clone()).put(key, stamp),
+        Some(prior) => batch.require(key.clone(), prior).put(key, stamp),
+    })
+}
+
+/// Drive one obligation to completion in **byte- and operation-budgeted** batches, resuming
+/// from its own cursor (`0016:667`,`:671`).
+///
+/// Each step is one preconditioned batch: `require(retire:… == prior)` makes it single-winner,
+/// so two drainers (a gateway inline and the reaper) can both run and exactly one advances
+/// per step; the loser re-reads and re-derives. **Marking always precedes deleting**, and the
+/// obligation record itself is deleted last, so a crash anywhere leaves the remaining work
+/// derivable from durable records.
+///
+/// Every mark carries the three-arm guard ([`mark_fragment`]). The mode its key declares, the
+/// payload it carries **and the identity its token names** are all cross-checked before any
+/// work: a `Records` payload under `retire:bytes:` would orphan-mark bytes a live object still
+/// names, a byte payload under `retire:records:` would delete the only records naming durable
+/// bytes with no evidence written, and a payload whose token cannot name its key spaces walks
+/// ranges that are empty for the wrong reason — so each is an error at the boundary, not a
+/// default (`0016:358-380`,`:434-440`).
+pub async fn drain_step(
+    store: &impl MetadataStore,
+    key: &[u8],
+    now_millis: u64,
+    budget: &DrainBudget,
+    report: &mut DrainReport,
+) -> Result<DrainProgress> {
+    let (mode, token) = parse_retire_key(key)?;
+    let Some(bytes) = store.get(key).await? else {
+        return Ok(DrainProgress::Finished);
+    };
+    let obligation: RetireObligation = metadata::decode(&bytes)?;
+    if !obligation.payload.is_valid_for(mode) {
+        return Err(ChunkMapError::RetireModeMismatch {
+            key: String::from_utf8_lossy(key).into_owned(),
+        }
+        .into());
+    }
+    if !payload_matches_token(&token, &obligation.payload) {
+        return Err(ChunkMapError::RetireTokenPayloadMismatch {
+            key: String::from_utf8_lossy(key).into_owned(),
+        }
+        .into());
+    }
+    let first_phase = match mode {
+        RetireMode::Bytes => DrainPhase::Marking,
+        RetireMode::Records => DrainPhase::Deleting,
+    };
+    let cursor = obligation.cursor.unwrap_or(RetireCursor {
+        phase: first_phase,
+        outer: 0,
+        inner: 0,
+        frag: 0,
+        arm: 0,
+    });
+    if mode == RetireMode::Records && cursor.phase == DrainPhase::Marking {
+        // A records-mode obligation has no marking phase: a cursor claiming one is a record no
+        // writer in this crate can produce, and acting on it would orphan-mark live bytes.
+        return Err(ChunkMapError::RetirePhaseInvalid {
+            key: String::from_utf8_lossy(key).into_owned(),
+        }
+        .into());
+    }
+
+    // **The closing mutations are budgeted before the walk spends the envelope, not after.**
+    // Every step ends by either advancing the cursor (a put of the whole obligation value) or
+    // deleting the obligation and, for a segmented generation, its unadopted `seggrp:` marker.
+    // Appending those after the last `fits` check is how a bounded step commits an unbounded
+    // batch — permanently, since the same step re-derives the same over-envelope shape on every
+    // retry. So the walk is run against a budget with that closing cost already withheld.
+    let walk_budget = DrainBudget {
+        max_batch_bytes: budget
+            .max_batch_bytes
+            .saturating_sub(key.len() + bytes.len() + CLOSING_SLACK_BYTES),
+        max_batch_ops: budget.max_batch_ops.saturating_sub(CLOSING_OPS),
+    };
+
+    let mut batch = WriteBatch::new().require(key.to_vec(), bytes.clone());
+    let mut marks = 0usize;
+    let mut deletes = 0usize;
+    let mut next_cursor = cursor;
+    let mut finished = false;
+
+    // One drain step. The **unit of progress is one mutation** — one fragment mark, or one
+    // record group of at most two deletes — and a step always commits at least that one even
+    // when it alone is larger than the budget: a step that committed nothing would rewrite the
+    // obligation with an unchanged cursor and the walk would never converge, which is exactly
+    // the non-convergence a rejected attempt shipped. Because the indivisible unit is O(1)
+    // rather than a whole part or segment, the exception can no longer produce a batch that is
+    // *permanently* over the transaction envelope (`0016:1490-1496`).
+    let mut units = 0usize;
+    match cursor.phase {
+        DrainPhase::Marking => {
+            let mut outer = cursor.outer;
+            let mut inner = cursor.inner;
+            let mut frag_from = cursor.frag;
+            // Only the unit the cursor **resumes into** can carry a stale position; every later
+            // unit starts at 0. Checked once, therefore, and against the record's own length.
+            let mut resuming = true;
+            'marking: loop {
+                let Some(unit) =
+                    next_marking_unit(store, &token, &obligation.payload, outer).await?
+                else {
+                    finished = true;
+                    break 'marking;
+                };
+                if unit != outer {
+                    outer = unit;
+                    inner = 0;
+                    frag_from = 0;
+                    resuming = false;
+                }
+                let Some(chunks) =
+                    unit_chunks(store, key, &token, &obligation.payload, outer).await?
+                else {
+                    // No record at this unit **now**: step over it. Declaring the obligation
+                    // finished here is what let a missing middle segment strand every later one.
+                    outer = outer.saturating_add(1);
+                    inner = 0;
+                    frag_from = 0;
+                    resuming = false;
+                    next_cursor = RetireCursor {
+                        phase: DrainPhase::Marking,
+                        outer,
+                        inner,
+                        frag: 0,
+                        arm: 0,
+                    };
+                    continue 'marking;
+                };
+                if resuming {
+                    // A cursor past this unit's own length cannot be resumed from: the walk
+                    // would skip every position between the record's true length and the
+                    // cursor, which is unevidenced bytes with the obligation deleted on top.
+                    let positions = usize::from(
+                        chunks
+                            .get(inner as usize)
+                            .map_or(0u16, ChunkRef::fragment_count),
+                    );
+                    if inner as usize > chunks.len()
+                        || (inner as usize) < chunks.len() && frag_from as usize > positions
+                        || (inner as usize) == chunks.len() && frag_from > 0
+                    {
+                        return Err(ChunkMapError::RetireCursorOutOfRange {
+                            key: String::from_utf8_lossy(key).into_owned(),
+                            unit: outer,
+                            position: if inner as usize > chunks.len() {
+                                inner
+                            } else {
+                                frag_from
+                            },
+                        }
+                        .into());
+                    }
+                    resuming = false;
+                }
+                while (inner as usize) < chunks.len() {
+                    let chunk = &chunks[inner as usize];
+                    let positions: Vec<(u16, DServerId)> = chunk.fragments().collect();
+                    while (frag_from as usize) < positions.len() {
+                        let (index, dserver) = positions[frag_from as usize];
+                        let candidate = mark_fragment(
+                            store,
+                            batch.clone(),
+                            dserver,
+                            FragmentId {
+                                chunk: chunk.id,
+                                index,
+                            },
+                            now_millis,
+                        )
+                        .await?;
+                        if !fits(&candidate, &walk_budget) && units > 0 {
+                            break 'marking;
+                        }
+                        batch = candidate;
+                        marks += 1;
+                        units += 1;
+                        frag_from += 1;
+                        next_cursor = RetireCursor {
+                            phase: DrainPhase::Marking,
+                            outer,
+                            inner,
+                            frag: frag_from,
+                            arm: 0,
+                        };
+                        if !fits(&batch, &walk_budget) {
+                            break 'marking;
+                        }
+                    }
+                    inner += 1;
+                    frag_from = 0;
+                    next_cursor = RetireCursor {
+                        phase: DrainPhase::Marking,
+                        outer,
+                        inner,
+                        frag: 0,
+                        arm: 0,
+                    };
+                }
+                outer = outer.saturating_add(1);
+                inner = 0;
+                frag_from = 0;
+                next_cursor = RetireCursor {
+                    phase: DrainPhase::Marking,
+                    outer,
+                    inner,
+                    frag: 0,
+                    arm: 0,
+                };
+            }
+            if finished {
+                // Marking is exhausted: hand the SAME obligation to the deleting phase.
+                // Evidence for every byte it names is now durable, which is the ordering
+                // invariant (2) rests on — protection is never lifted before it.
+                next_cursor = RetireCursor {
+                    phase: DrainPhase::Deleting,
+                    outer: 0,
+                    inner: 0,
+                    frag: 0,
+                    arm: 0,
+                };
+                finished = false;
+            }
+        }
+        DrainPhase::Deleting => {
+            // **The payload's index spaces are walked one after another, each to its own
+            // exhaustion** (`RetirePayload::delete_spaces`). Walked in lockstep — the shape this
+            // replaces — an obligation naming both sparse parts and segments stopped at the
+            // first *joint* gap and was deleted while later part records still named durable
+            // bytes.
+            let spaces = obligation.payload.delete_spaces();
+            let mut arm = cursor.arm as usize;
+            let mut outer = cursor.outer;
+            loop {
+                let Some(space) = spaces.get(arm).copied() else {
+                    finished = true;
+                    break;
+                };
+                let Some(unit) =
+                    next_delete_unit(store, &token, &obligation.payload, space, outer).await?
+                else {
+                    // This space is exhausted; the next one starts at its own beginning.
+                    arm += 1;
+                    outer = 0;
+                    if arm >= spaces.len() {
+                        finished = true;
+                        break;
+                    }
+                    next_cursor = RetireCursor {
+                        phase: DrainPhase::Deleting,
+                        outer,
+                        inner: 0,
+                        frag: 0,
+                        arm: arm as u32,
+                    };
+                    continue;
+                };
+                outer = unit;
+                let keys = unit_record_keys(&token, &obligation.payload, space, outer)?;
+                if !unit_records_present(store, &keys).await? {
+                    // A **frozen** parts payload may simply have had this unit deleted by an
+                    // earlier, interrupted pass, so the walk steps on rather than declaring
+                    // itself done — the truncation that marked an obligation "fully drained"
+                    // while records remained is silent permanent part loss. (An enumerated
+                    // space cannot reach here: its units come from the range that holds them.)
+                    outer = outer.saturating_add(1);
+                    next_cursor = RetireCursor {
+                        phase: DrainPhase::Deleting,
+                        outer,
+                        inner: 0,
+                        frag: 0,
+                        arm: arm as u32,
+                    };
+                    continue;
+                }
+                let mut candidate = batch.clone();
+                for record_key in &keys {
+                    candidate = candidate.delete(record_key.clone());
+                }
+                if !fits(&candidate, &walk_budget) && units > 0 {
+                    break;
+                }
+                batch = candidate;
+                deletes += keys.len();
+                units += 1;
+                outer = outer.saturating_add(1);
+                next_cursor = RetireCursor {
+                    phase: DrainPhase::Deleting,
+                    outer,
+                    inner: 0,
+                    frag: 0,
+                    arm: arm as u32,
+                };
+                if !fits(&batch, &walk_budget) {
+                    break;
+                }
+            }
+        }
+    }
+
+    // The cursor advance rides the SAME batch that did the work, so the obligation's own
+    // compare-and-set is what authorizes the step (`0016:612-619`) — there is no cursor
+    // record class and no window in which progress is done but unrecorded.
+    //
+    // The final batch also drops an **unadopted** segment group's `seggrp:` marker, in that
+    // same commit rather than a later one: deleting the obligation first would leave a crash
+    // window in which the marker has no remaining record that could ever resume its cleanup
+    // (the group's own `seg:` records are already gone by then, so nothing else names it).
+    if finished {
+        if let Some((marker_key, marker_bytes)) =
+            unadopted_group_marker(store, &obligation.payload, &batch.deletes).await?
+        {
+            batch = batch
+                .require(marker_key.clone(), marker_bytes)
+                .delete(marker_key);
+        }
+        batch = batch.delete(key.to_vec());
+    } else {
+        let advanced = RetireObligation {
+            cursor: Some(next_cursor),
+            ..obligation.clone()
+        };
+        batch = batch.put(key.to_vec(), encode_record(&advanced)?);
+    }
+    let charged = batch.clone();
+    match store.commit(batch).await? {
+        CommitOutcome::Committed => {
+            // Charged **after** the outcome: a lost batch changed nothing, and counting it would
+            // report conflicts as committed batches (see [`DrainReport::charge`]).
+            report.charge(&charged);
+            report.marks += marks;
+            report.record_deletes += deletes;
+            if finished {
+                report.obligations_drained += 1;
+                return Ok(DrainProgress::Finished);
+            }
+            Ok(DrainProgress::Advanced)
+        }
+        // Lost the single-winner CAS to the other drainer: re-read and re-derive, marking
+        // strictly fewer positions each round, so the walk converges (`0016:1156-1158`).
+        CommitOutcome::Conflict => Ok(DrainProgress::Lost),
+    }
+}
+
+/// What one [`drain_step`] achieved.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum DrainProgress {
+    /// One batch landed and the cursor advanced; the obligation still has work.
+    Advanced,
+    /// The obligation is fully drained and its record is gone (or was already).
+    Finished,
+    /// The single-winner compare-and-set was lost to another drainer: re-read and re-derive.
+    /// Re-deriving marks strictly fewer positions each round, so the walk converges.
+    Lost,
+}
+
+/// Drive one obligation to completion by repeating [`drain_step`].
+///
+/// One **step** per commit is the unit a caller can interleave, crash between, or observe: the
+/// two-phase order (mark, then delete) is visible from outside precisely because the step
+/// boundary is a commit boundary. This wrapper is the ordinary caller's convenience; a test
+/// that must observe the intermediate state — evidence written while the naming record is
+/// still present — steps it itself.
+pub async fn drain_obligation(
+    store: &impl MetadataStore,
+    key: &[u8],
+    now_millis: u64,
+    budget: &DrainBudget,
+    report: &mut DrainReport,
+) -> Result<()> {
+    loop {
+        // **A step that changes nothing is a stalled drain, reported — never looped.** The
+        // detector is the obligation's **own bytes**, and nothing else: a step that committed and
+        // did not finish must have advanced the cursor it carries, because that advance rides the
+        // very batch that did the work (`0016:612-619`). One that leaves the record byte-identical
+        // has therefore re-derived the position it just did and will do so for ever — exactly the
+        // shipped defect, a cursor-less walk re-deriving the same first keys, and an unbounded
+        // loop is the one shape in which that is invisible rather than loud.
+        //
+        // It is deliberately **not** conditioned on the work counters. A re-derived step does
+        // work — it re-writes the same marks — so a detector that also required the counters to
+        // be idle would see a busy but non-advancing walk as healthy, which is the failure mode
+        // wearing a disguise.
+        let before = store.get(key).await?;
+        let progress = drain_step(store, key, now_millis, budget, report).await?;
+        if progress == DrainProgress::Finished {
+            return Ok(());
+        }
+        let after = store.get(key).await?;
+        if progress == DrainProgress::Advanced && after == before {
+            return Err(DrainStalled {
+                obligation: String::from_utf8_lossy(key).into_owned(),
+            }
+            .into());
+        }
+    }
+}
+
+/// A retirement drain whose step committed but changed nothing — neither the obligation's own
+/// record nor any evidence or naming record it owes.
+///
+/// A walk that cannot advance is **stuck, not slow**, and the difference matters: a stuck drain
+/// retains its bytes and records for ever, so it must surface as an error a caller (and the
+/// drain-health alarm the reaper carries, #625) can act on rather than as a loop that never
+/// returns.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct DrainStalled {
+    /// The obligation key that made no progress.
+    pub obligation: String,
+}
+
+impl std::fmt::Display for DrainStalled {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        write!(
+            f,
+            "retirement drain stalled on {}: a step committed but advanced neither its cursor \
+             nor any evidence or record it owes",
+            self.obligation
+        )
+    }
+}
+
+impl std::error::Error for DrainStalled {}
+
+/// Whether `batch` is inside **both** halves of the envelope.
+fn fits(batch: &WriteBatch, budget: &DrainBudget) -> bool {
+    metadata::batch_bytes(batch) <= budget.max_batch_bytes
+        && metadata::batch_ops(batch) <= budget.max_batch_ops
+}
+
+/// The bytes a [`drain_step`]'s **closing** mutations may add beyond the obligation value the
+/// walk already charged: the cursor's own encoding when the step advances, or the `seggrp:`
+/// marker's precondition and delete when it finishes. Withheld from the walk's budget up front
+/// ([`drain_step`]), because a bounded step that appends its closing mutations *after* the last
+/// budget check commits an over-envelope batch — and re-derives the same one on every retry.
+const CLOSING_SLACK_BYTES: usize = 256;
+
+/// The operations those same closing mutations may add: the obligation put **or** its delete,
+/// plus the marker's precondition and delete.
+const CLOSING_OPS: usize = 3;
+
+/// The `seggrp:` marker key and bytes to remove with the **final** batch of a segmented
+/// generation's drain, once the nonce names no `seg:` record any more — or `None` when the
+/// group is still adopted, when the payload names no group, or when the marker is already gone.
+///
+/// It rides the obligation's own last commit rather than a batch after it: the group's `seg:`
+/// records are gone by then, so a crash between "obligation deleted" and "marker deleted" would
+/// leave the marker with no remaining record naming it, permanently (`0016:513-527`, arm (b)).
+async fn unadopted_group_marker(
+    store: &impl MetadataStore,
+    payload: &RetirePayload,
+    pending_deletes: &[Vec<u8>],
+) -> Result<Option<(Vec<u8>, Bytes)>> {
+    let generation = match payload {
+        RetirePayload::Generation {
+            segments: Some(generation),
+            ..
+        } => generation,
+        _ => return Ok(None),
+    };
+    // **Adopted is judged as of this batch's effect, not the store's current content.** The step
+    // that finds no unit left is frequently the same step that deleted the last one, so reading
+    // the range naively would see a `seg:` record this very batch removes and keep the marker
+    // for ever. The read is bounded by the batch itself (one page of at most one row more than
+    // it deletes), so it stays O(batch) exactly as `segment_group_adopted` is O(1).
+    let prefix = metadata::seg_group_prefix(&generation.nonce);
+    let (rows, _) = store
+        .scan_page(&prefix, None, pending_deletes.len().saturating_add(1))
+        .await?;
+    if rows
+        .iter()
+        .any(|(key, _)| !pending_deletes.iter().any(|pending| pending == key))
+    {
+        return Ok(None);
+    }
+    let key = metadata::seggrp_key(&generation.nonce);
+    Ok(store.get(&key).await?.map(|bytes| (key, bytes)))
+}
+
+/// Reclaim a session's **owned** staging residue: orphan-mark each `sidx:` entry's full
+/// planned placement, then delete the entries, in bounded batches until the range is
+/// **empty** (`0016:1652-1666`).
+///
+/// Three properties make this terminate and cover everything:
+///
+/// * the walk is **reference-based**, not expiry-based, so it needs no clock at all and is
+///   immune to the #557 cross-clock trap by construction;
+/// * it runs **only for a non-`Open` session** (fence-then-walk), so a session created or
+///   progressing mid-pass is never condemned (F15) — and, because every `sidx:` intent
+///   carries `require(mpu == Open@E)`, nothing can refill the range once the session left
+///   `Open`: the walked set is **frozen and complete**;
+/// * it marks the chunk's **full** `staged` placement — every position the fragment *could*
+///   land on — so a fragment authorized before the fence but landing after it lands on a
+///   position an `orphan:` record already covers (`0016:1547-1550`).
+///
+/// It runs for **`Completed` as well as `Aborting`** (`0016:1652-1657`, the iteration-3
+/// finding-2 hole): a part that crashed mid-stream left owned residue and no `part:` record,
+/// and a Completed teardown that skipped this walk would strand it forever.
+pub async fn reclaim_owned(
+    store: &impl MetadataStore,
+    upload_id: &str,
+    now_millis: u64,
+    budget: &DrainBudget,
+    report: &mut DrainReport,
+) -> Result<()> {
+    let prefix = sidx_range(upload_id);
+    loop {
+        // **Fence-then-walk is enforced here, not merely documented.** This is a public entry
+        // point, so "the caller checked" is not a property: called for an `Open` session it
+        // would orphan-mark the fragments of parts that are in flight *right now* and delete the
+        // only records protecting them — outcome (c), from the reclamation path itself. The
+        // session is therefore re-read **every pass** and its exact bytes are pinned in the
+        // batch, so a session that is fenced back to `Open` mid-walk (X108's rollback) defeats
+        // the batch instead of losing its live residue.
+        let Some(session) = read_session(store, upload_id).await? else {
+            // No session record at all: nothing can refill the range and nothing can authorize
+            // this walk. The residue is the fleet-wide sweep's, which sees it as session-less.
+            return Ok(());
+        };
+        if session.state() == SessionState::Open || session.state() == SessionState::Completing {
+            return Ok(());
+        }
+        let page_limit = budget.max_batch_ops.max(1);
+        let (rows, _) = store.scan_page(&prefix, None, page_limit).await?;
+        if rows.is_empty() {
+            return Ok(());
+        }
+        let mut batch = session.fence(WriteBatch::new());
+        let mut marks = 0usize;
+        let mut reclaimed = 0usize;
+        for (key, value) in rows {
+            // Parsed, not merely split: a malformed owned key is an error at decode rather
+            // than a position this walk silently skips (ADR-0045). Only the chunk id is used —
+            // the part number is what lets a human attribute residue to an attempt.
+            let (owner_id, _, chunk) = parse_sidx_key(&key)?;
+            let entry: PendingEntry = metadata::decode(&value)?;
+            // **The two fields that make this record what it is are STRUCTURAL, and this is
+            // the path that lifts protection** — so an entry whose `owner` is absent or names
+            // another session, or whose `staged` placement is absent altogether, is an error
+            // rather than a row this walk deletes after marking nothing (`0016:353` defines the
+            // value as carrying both; ADR-0045, `AGENTS.md:146-149`). `staged` is the *only*
+            // source of the `orphan:` keys those bytes need, so deleting the entry without it
+            // would unprotect durable bytes with no evidence at all — outcome (a).
+            //
+            // The placement **length** is the one thing left liberal here, deliberately and on
+            // 0016's own instruction (`0016:416-432`): it is a *contextual* check the fleet
+            // quarantines rather than propagates, and "a reclaimer that refused would strand
+            // the very bytes it exists to evidence". A short vector resolves its tail through
+            // the same identity fallback every reader uses, so every position the fragment
+            // could occupy is still marked.
+            let staged = match (&entry.owner, &entry.staged) {
+                (Some(owner), Some(staged)) if owner == &owner_id => staged,
+                _ => {
+                    return Err(RecordError::OwnedEntryMalformed {
+                        key: String::from_utf8_lossy(&key).into_owned(),
+                    }
+                    .into())
+                }
+            };
+            let mut candidate = batch.clone();
+            let mut candidate_marks = 0usize;
+            for (index, dserver) in staged.fragments() {
+                candidate = mark_fragment(
+                    store,
+                    candidate,
+                    dserver,
+                    FragmentId { chunk, index },
+                    now_millis,
+                )
+                .await?;
+                candidate_marks += 1;
+            }
+            // Evidence precedes the lifting of protection, in ONE batch: the entry is deleted
+            // in the same commit that marks the bytes it named, so there is no instant at
+            // which a durable byte is both unprotected and unevidenced.
+            candidate = candidate
+                .require(key.clone(), value.clone())
+                .delete(key.clone());
+            if !fits(&candidate, budget) {
+                if reclaimed >= 1 {
+                    break;
+                }
+                // **The indivisible unit here is a whole entry, so "commit it anyway" is not
+                // the safe exception it is in `drain_step`.** An entry's mark set is its EC
+                // fanout, which is the deployment's, not an O(1) unit — so committing an
+                // over-envelope batch hands the backend one it must reject on *every* attempt:
+                // the loop re-derives the same shape for ever and the session is never torn
+                // down, never decrements its admission slot, and never releases its bytes.
+                // `MAX_STAGED_FRAGMENTS` keeps this unreachable for anything this protocol
+                // staged; reaching it means a foreign or torn entry, or a caller budget below
+                // one entry's cost, and the honest answer is to name it (`AGENTS.md:175-177`).
+                return Err(RecordError::OwnedEntryOverBudget {
+                    key: String::from_utf8_lossy(&key).into_owned(),
+                    ops: metadata::batch_ops(&candidate),
+                    bytes: metadata::batch_bytes(&candidate),
+                    max_ops: budget.max_batch_ops,
+                    max_bytes: budget.max_batch_bytes,
+                }
+                .into());
+            }
+            batch = candidate;
+            // Counted only once the candidate is **accepted**: a row rejected by the budget
+            // would otherwise inflate the report with evidence that was never written.
+            marks += candidate_marks;
+            reclaimed += 1;
+            if !fits(&batch, budget) {
+                break;
+            }
+        }
+        let charged = batch.clone();
+        match store.commit(batch).await? {
+            CommitOutcome::Committed => {
+                report.charge(&charged);
+                report.marks += marks;
+                report.owned_reclaimed += reclaimed;
+            }
+            // Another drainer took these entries, or one entry's lease was renewed under us:
+            // re-read the range and re-derive (strictly fewer entries each round).
+            CommitOutcome::Conflict => continue,
+        }
+    }
+}
+
+/// Whether a bounded key range is empty — **one row, never the range** (#634's `scan_page`).
+///
+/// The question is existence, and a `scan` over a range whose size the caller does not know
+/// answers `ScanCapExceeded` rather than "yes": that failure would land on the very gate it
+/// is asked about, so the more residue a session accumulated the less able it would be to
+/// clean it up.
+async fn range_is_empty(store: &impl MetadataStore, prefix: &[u8]) -> Result<bool> {
+    let (rows, _): ScanPage = store.scan_page(prefix, None, 1).await?;
+    Ok(rows.is_empty())
+}
+
+/// The **terminal session delete** — the exactly-once `mpuctl.count` decrement point
+/// (`0016:673`).
+///
+/// One batch: delete `mpu:<id>`, delete every surviving `slot:<id>:` record, delete the
+/// `seggrp:` marker **iff** the group was never adopted, and CAS the counter `-1`. Its
+/// preconditions are what make it single-winner and exactly-once:
+///
+/// * `require(mpu:<id> == prior)` — the session record's **exact bytes**, so a gateway
+///   draining inline and the reaper can both reach it and exactly one CAS succeeds; the
+///   loser's whole batch is a no-op, so the counter can neither under-count a live session nor
+///   double-decrement a torn-down one;
+/// * `require(mpuctl == prior)` — the counter is CAS'd whole, so the decrement cannot race an
+///   admission;
+/// * both session-scoped `retire:` ranges observed **empty**, and the session's `sidx:` range
+///   observed **empty in this pass**. The gate is the empty `sidx:` range and **never** an
+///   empty `slot:` range: a part that crashed mid-stream keeps its slot for ever by design
+///   (its residue is deliberately counted against the cap), so gating on slots would deadlock
+///   teardown — while `sidx:` *is* the exact set of byte-bearing residue, because intent
+///   precedes every fragment (`0016:581-590`).
+///
+/// Returns `false` when a gate is not yet satisfied, so a caller loops rather than forcing it.
+pub async fn terminal_delete(
+    store: &impl MetadataStore,
+    session: &SessionSnapshot,
+    report: &mut DrainReport,
+) -> Result<bool> {
+    if session.state() != SessionState::Aborting && session.state() != SessionState::Completed {
+        return Ok(false);
+    }
+    let upload_id = &session.upload_id;
+    if !range_is_empty(store, &sidx_range(upload_id)).await?
+        || !range_is_empty(store, &retire_session_range(RetireMode::Bytes, upload_id)).await?
+        || !range_is_empty(store, &retire_session_range(RetireMode::Records, upload_id)).await?
+    {
+        return Ok(false);
+    }
+
+    let Some((admission_bytes, admission)) = read_admission(store).await? else {
+        // The ledger cannot be absent while a session record exists — the create that wrote
+        // the session wrote the counter in the same batch — so this is a torn store. Answering
+        // `Ok(false)` would stall every teardown of this session silently, on a gate that can
+        // never open (its caller loops on exactly that answer), while fabricating a `{count: 0}`
+        // to decrement would corrupt the bound admission rests on. Surface it.
+        return Err(RecordError::AdmissionLedgerMissing {
+            upload_id: upload_id.clone(),
+        }
+        .into());
+    };
+    // **Never saturating.** A zero count while this session's record still exists is the same
+    // torn-ledger class as an absent ledger: every existing `mpu:` record is one the counter
+    // counts (`0016:348`,`:2029-2031`), so `count == 0` here means an earlier decrement already
+    // ran for a session that is still there. Saturating would delete the session, report a
+    // decrement that never happened, and leave the fleet's admission bound quietly wrong — the
+    // one direction that under-counts live sessions and lets `MAX_SESSIONS x U_ref <= W_ref` be
+    // exceeded. Surface it instead (`AGENTS.md:175-177`).
+    let Some(count) = admission.count.checked_sub(1) else {
+        return Err(RecordError::AdmissionLedgerTorn {
+            upload_id: upload_id.clone(),
+        }
+        .into());
+    };
+    let next = AdmissionRecord { count, ..admission };
+
+    let mut batch = session
+        .fence(WriteBatch::new())
+        .require(MPUCTL_KEY.to_vec(), admission_bytes)
+        .delete(session.key())
+        .put(MPUCTL_KEY.to_vec(), encode_record(&next)?);
+    for (key, _) in store.scan(&slot_range(upload_id)).await? {
+        batch = batch.delete(key);
+    }
+    // The two-arm `seggrp:` rule (`0016:513-527`): an **unadopted** group's marker is removed
+    // here, since nothing references it and the session that reserved it is going; an
+    // **adopted** one outlives the session and is left, gated on one bounded range read this
+    // batch is already shaped to do. Exactly one arm always fires, so no small upload leaks a
+    // marker and no published object loses one.
+    if !metadata::segment_group_adopted(store, &session.record.group_nonce).await? {
+        batch = batch.delete(metadata::seggrp_key(&session.record.group_nonce));
+    }
+    let charged = batch.clone();
+    match store.commit(batch).await? {
+        CommitOutcome::Committed => {
+            // Charged after the outcome: a losing terminal delete decremented nothing, and this
+            // is the report the exactly-once assertions read.
+            report.charge(&charged);
+            report.terminal_deleted = true;
+            report.count_decremented = true;
+            Ok(true)
+        }
+        CommitOutcome::Conflict => Ok(false),
+    }
+}
+
+/// Tear down one non-`Open` session: reclaim its owned residue, drain its session-scoped
+/// obligations, then — for `Aborting` — take the terminal delete (`0016:2198-2215`).
+///
+/// **A `Completed` session is deliberately NOT terminally deleted here.** Its record is a
+/// tombstone that still answers an identical Complete retry, it is **still counted** by the
+/// admission counter (`0016:348`,`:966-968`,`:2029-2031`), and the instant it may be removed
+/// is `W_tombstone` from its own `completed_at_millis` — a window #625 owns. Releasing the
+/// slot early would need either a second, non-authoritative counter or deleting the tombstone,
+/// which destroys the idempotence a client retry depends on. So this slice's **only**
+/// terminal-delete path is the abort/teardown one, and the counter's return to its prior value
+/// is what that path is asserted on.
+pub async fn teardown_session(
+    store: &impl MetadataStore,
+    upload_id: &str,
+    now_millis: u64,
+    budget: &DrainBudget,
+) -> Result<DrainReport> {
+    let mut report = DrainReport::default();
+    let Some(session) = read_session(store, upload_id).await? else {
+        return Ok(report);
+    };
+    if session.state() == SessionState::Open || session.state() == SessionState::Completing {
+        // Fence-then-walk: an `Open` session's owned entries are never touched, so a session
+        // still accepting parts cannot have its in-flight residue reclaimed under it (F15).
+        return Ok(report);
+    }
+    reclaim_owned(store, upload_id, now_millis, budget, &mut report).await?;
+    for mode in [RetireMode::Bytes, RetireMode::Records] {
+        loop {
+            let (rows, _) = store
+                .scan_page(&retire_session_range(mode, upload_id), None, 1)
+                .await?;
+            let Some((key, _)) = rows.into_iter().next() else {
+                break;
+            };
+            drain_obligation(store, &key, now_millis, budget, &mut report).await?;
+        }
+    }
+    // Owned residue can only *decrease* while the session is non-`Open` (nothing can refill
+    // the range), but a drain step may have re-read it, so the emptiness gate is re-observed
+    // by `terminal_delete` itself rather than trusted from above.
+    if session.state() == SessionState::Aborting {
+        let Some(current) = read_session(store, upload_id).await? else {
+            return Ok(report);
+        };
+        terminal_delete(store, &current, &mut report).await?;
+    }
+    Ok(report)
+}
+
+// ===========================================================================
+// 12. The classification sweep — invariant (2) as a checkable property
+// ===========================================================================
+
+/// The **safe classes** a durable fragment can be in (`0016:2911-2924`).
+#[derive(Debug, Clone, Copy, PartialEq, Eq, PartialOrd, Ord)]
+pub enum FragmentClass {
+    /// Named by a **committed** inode's chunk map (flat or segmented).
+    CommittedReferenced,
+    /// Named by a record of a session that still exists: a committed `part:` record, or an
+    /// in-flight owned `sidx:` entry.
+    StagedWithSession,
+    /// Carries an `orphan:` mark — reclamation evidence.
+    EvidencedForReclamation,
+    /// Named by an **installed, undrained** `retire:bytes:` obligation, which protects the
+    /// bytes it names until the drain refreshes their evidence (`0016:1226-1247`, X92).
+    ObligatedForRetirement,
+}
+
+/// What the sweep found: every fragment's classes, and the two things that would be wrong.
+#[derive(Debug, Clone, Default, PartialEq, Eq)]
+pub struct ClassificationReport {
+    /// Every on-disk fragment and the safe classes it is in.
+    pub classes: BTreeMap<(DServerId, ChunkId, u16), Vec<FragmentClass>>,
+    /// Fragments in **no** safe class — the gap invariant (2) forbids. Each is either a leak
+    /// (retained for ever with nothing that will clean it up) or, worse, a byte unprotected
+    /// **and** unevidenced, which GC's conservative arm retains silently for ever.
+    pub gaps: Vec<(DServerId, FragmentId)>,
+    /// Fragments in a **genuinely incompatible** combination: evidenced for reclamation with
+    /// the grace already elapsed **while** still committed-referenced. That is the one pair GC
+    /// would act on wrongly — it reclaims bytes a live object names.
+    pub unsafe_pairs: Vec<(DServerId, FragmentId)>,
+    /// Staging records — `part:` or `sidx:` — whose owning `mpu:` session no longer exists.
+    ///
+    /// They are reported rather than counted as protection: a record no session owns will never
+    /// be published, retired or reclaimed, so treating it as "safely staged" is what let the
+    /// session-less part leak (the shape a rejected attempt shipped) hide from every other
+    /// assertion in the suite while the bytes it names were retained for ever.
+    pub session_less_records: Vec<String>,
+}
+
+impl ClassificationReport {
+    /// Whether the no-gap invariant, the incompatible-pair rule and the session-ownership rule
+    /// all hold.
+    pub fn is_sound(&self) -> bool {
+        self.gaps.is_empty() && self.unsafe_pairs.is_empty() && self.session_less_records.is_empty()
+    }
+}
+
+/// The **classification sweep** 0016 earns from this protocol (`0016:2911-2924`): given the
+/// fleet's on-disk fragment inventory, assert every fragment is in **at least one** safe
+/// class, and separately that it is in no genuinely incompatible combination.
+///
+/// **"Exactly one class" would be WRONG and would fail on correct executions** (X94). This
+/// protocol *deliberately* overlaps protection across both handoffs: after the root flip and
+/// before `retire:records:{parts}` drains, every published chunk is simultaneously
+/// committed-referenced **and** named by a staged `part:` record; and a retirement's marks
+/// precede its record deletions by construction, so a chunk is briefly staged **and**
+/// evidenced. That overlap is exactly what closes the gaps the source-before-destination read
+/// orders exist to prevent, so a helper demanding disjointness would pressure an implementer
+/// into removing the property that makes the handoffs safe. Invariant (2) is a **no-gaps**
+/// claim, not a partition.
+///
+/// `inventory` is what the fleet actually holds — `(dserver, fragment)` pairs from each D
+/// server's `list_fragments()`. Taking it as an argument keeps `core` free of fleet iteration
+/// (the caller owns the `ChunkStore` handles) and lets the sweep run against a *snapshot*,
+/// which is what makes it usable after a scenario rather than only during one.
+///
+/// `grace_elapsed_before` is the instant an `orphan:` stamp older than which counts as
+/// out-of-grace — GC's own `now - orphaned_at >= G_orphan` test, supplied rather than computed
+/// because `core` reads no clock.
+pub async fn classification_sweep(
+    store: &impl MetadataStore,
+    inventory: &[(DServerId, FragmentId)],
+    grace_elapsed_before: u64,
+) -> Result<ClassificationReport> {
+    let mut committed: BTreeSet<(ChunkId, u16, DServerId)> = BTreeSet::new();
+    for (key, value) in scan_pages(store, b"inode:").await? {
+        let record: InodeRecord = metadata::decode(&value)?;
+        if record.state != InodeState::Committed {
+            continue;
+        }
+        // Resolve through the ONE resolver every consumer shares, so a segmented object's
+        // chunks are counted exactly as a flat one's are (`0016:2452-2474`). A resolution of
+        // `Retired` (the root moved on mid-resolve) contributes nothing to the committed class
+        // on purpose: that generation's chunks are named by the `retire:` obligation the
+        // supersede installed, so they are covered by the obligated class rather than lost from
+        // the sweep — the overlap invariant (2) relies on, not a gap.
+        if let Some(chunks) = metadata::resolve_chunk_map(store, &key, &record)
+            .await?
+            .chunks()
+        {
+            for chunk in chunks {
+                for (index, dserver) in chunk.fragments() {
+                    committed.insert((chunk.id, index, dserver));
+                }
+            }
+        }
+    }
+
+    // **A staging record only protects while the session that owns it exists.** A `part:` or
+    // `sidx:` record whose `mpu:` record is gone is residue, not protection: nothing will ever
+    // publish it, retire it, or reclaim its bytes, so counting it as safely staged is exactly
+    // how the session-less part leak stays invisible to every other assertion. The set of live
+    // sessions is one bounded read (`<= MAX_SESSIONS` records, `0016:350`).
+    let mut sessions: BTreeSet<String> = BTreeSet::new();
+    for (key, _) in scan_pages(store, MPU_PREFIX).await? {
+        if let Some(id) = std::str::from_utf8(&key)
+            .ok()
+            .and_then(|text| text.strip_prefix("mpu:"))
+        {
+            sessions.insert(id.to_string());
+        }
+    }
+
+    let mut staged: BTreeSet<(ChunkId, u16, DServerId)> = BTreeSet::new();
+    let mut orphaned_records: Vec<String> = Vec::new();
+    for (key, value) in scan_pages(store, PART_PREFIX).await? {
+        let (upload_id, part_number) = parse_part_key(&key)?;
+        let record: PartRecord = metadata::decode(&value)?;
+        if !sessions.contains(&upload_id) {
+            orphaned_records.push(format!("part:{upload_id}:{part_number}"));
+            continue;
+        }
+        for chunk in &record.chunks {
+            for (index, dserver) in chunk.fragments() {
+                staged.insert((chunk.id, index, dserver));
+            }
+        }
+    }
+    for (key, value) in scan_pages(store, SIDX_PREFIX).await? {
+        let (upload_id, part_number, chunk) = parse_sidx_key(&key)?;
+        let entry: PendingEntry = metadata::decode(&value)?;
+        if !sessions.contains(&upload_id) {
+            orphaned_records.push(format!("sidx:{upload_id}:{part_number}:{chunk}"));
+            continue;
+        }
+        if let Some(placement) = &entry.staged {
+            for (index, dserver) in placement.fragments() {
+                staged.insert((chunk, index, dserver));
+            }
+        }
+    }
+    // An ordinary streaming write's `pending:` lease protects its chunk too; a sweep that
+    // ignored it would report a false gap for every non-multipart write in flight.
+    for (key, _) in scan_pages(store, b"pending:").await? {
+        if let Some(chunk) = std::str::from_utf8(&key)
+            .ok()
+            .and_then(|text| text.strip_prefix("pending:"))
+            .and_then(|id| id.parse::<ChunkId>().ok())
+        {
+            for (dserver, frag) in inventory {
+                if frag.chunk == chunk {
+                    staged.insert((chunk, frag.index, *dserver));
+                }
+            }
+        }
+    }
+
+    // **Keyed by fragment POSITION, not by chunk id.** An obligation protects exactly the
+    // `(chunk, index, dserver)` positions its chunk-refs name — which is exactly the set its
+    // drain will mark — so collapsing it to a chunk id would let *any* fragment bearing that
+    // chunk's id count as protected, including one at a position no record names. That is the
+    // one thing this oracle exists to catch, answered "safe".
+    let mut obligated: BTreeSet<(ChunkId, u16, DServerId)> = BTreeSet::new();
+    let obligate = |chunks: Vec<ChunkRef>, obligated: &mut BTreeSet<_>| {
+        for chunk in chunks {
+            for (index, dserver) in chunk.fragments() {
+                obligated.insert((chunk.id, index, dserver));
+            }
+        }
+    };
+    for (_, value) in scan_pages(store, RETIRE_BYTES_PREFIX).await? {
+        let obligation: RetireObligation = metadata::decode(&value)?;
+        match &obligation.payload {
+            RetirePayload::Chunks { chunks } => obligate(chunks.clone(), &mut obligated),
+            RetirePayload::Generation {
+                chunks, segments, ..
+            } => {
+                obligate(chunks.clone(), &mut obligated);
+                // A **segmented** generation names its chunks through its `seg:` records, so a
+                // sweep that only read the payload's inline list would see none of them — and
+                // report every not-yet-marked fragment of an ordinary superseded segmented
+                // object as an invariant gap, on a perfectly correct execution.
+                //
+                // The range read is the obligated generation's **own epoch**
+                // (`seg:<nonce>:<epoch>:`), never the whole nonce: a nonce outlives its
+                // generations (one session republishes under the same reserved nonce at each
+                // fence epoch), so scanning every epoch would let a *stale* generation's
+                // segments vouch for fragments this obligation does not name — an unprotected
+                // byte reported protected, which is precisely the gap the oracle is for.
+                if let Some(generation) = segments {
+                    let group = generation.group()?;
+                    for (_, value) in scan_pages(store, &metadata::seg_range_prefix(&group)).await?
+                    {
+                        let record: metadata::SegmentRecord = metadata::decode(&value)?;
+                        obligate(record.into_chunks(), &mut obligated);
+                    }
+                }
+            }
+            // A parts-shaped payload names its bytes indirectly, through the `part:`
+            // records the marking phase reads — those are still present until the
+            // deleting phase, so the `staged` class already covers them.
+            RetirePayload::Session { .. }
+            | RetirePayload::Parts { .. }
+            | RetirePayload::Records { .. } => {}
+        }
+    }
+
+    let mut report = ClassificationReport {
+        session_less_records: orphaned_records,
+        ..Default::default()
+    };
+    for (dserver, frag) in inventory {
+        let mut classes = Vec::new();
+        let is_committed = committed.contains(&(frag.chunk, frag.index, *dserver));
+        if is_committed {
+            classes.push(FragmentClass::CommittedReferenced);
+        }
+        if staged.contains(&(frag.chunk, frag.index, *dserver)) {
+            classes.push(FragmentClass::StagedWithSession);
+        }
+        // **Evidence is what the PRODUCTION collector would act on, not any value at the key.**
+        // `gc::orphan_leases` reads the mark as `str::parse::<u64>` and *ignores* anything it
+        // cannot parse (`crates/custodian/src/gc.rs:402-417`), so a malformed value protects
+        // nothing and reclaims nothing — a fragment carrying one is unevidenced in production
+        // while a "present means evidenced" oracle reports it safe. The same parse, spelled the
+        // same way (no trimming: the collector does not trim either).
+        let orphan = store.get(&metadata::orphan_key(*dserver, *frag)).await?;
+        let orphaned_at = orphan.as_deref().and_then(|bytes| {
+            std::str::from_utf8(bytes)
+                .ok()
+                .and_then(|s| s.parse::<u64>().ok())
+        });
+        if orphaned_at.is_some() {
+            classes.push(FragmentClass::EvidencedForReclamation);
+        }
+        let is_obligated = obligated.contains(&(frag.chunk, frag.index, *dserver));
+        if is_obligated {
+            classes.push(FragmentClass::ObligatedForRetirement);
+        }
+        if classes.is_empty() {
+            report.gaps.push((*dserver, *frag));
+        }
+        if is_committed {
+            if let Some(stamp) = orphaned_at {
+                if stamp <= grace_elapsed_before && !is_obligated {
+                    report.unsafe_pairs.push((*dserver, *frag));
+                }
+            }
+        }
+        classes.sort_unstable();
+        report
+            .classes
+            .insert((*dserver, frag.chunk, frag.index), classes);
+    }
+    Ok(report)
+}
+
+/// Every row of a key range, read in **bounded pages** rather than one `scan` (#634's
+/// `scan_page`).
+///
+/// Three of the namespaces this sweep reads are ones 0016 declines to bound by cardinality —
+/// `retire:` explicitly (`0016:2645-2652`), and `sidx:`/`part:` because their fleet-wide
+/// population is `MAX_SESSIONS x MAX_INFLIGHT_PARTS x MAX_PART_CHUNKS` and
+/// `MAX_SESSIONS x MAX_PARTS_PER_SESSION`, which a legal retune can push past `SCAN_CAP`. A
+/// `scan` there answers `ScanCapExceeded` **whole**, with no partial result, so the audit would
+/// fail at exactly the scale the disjoint namespace was introduced to support.
+async fn scan_pages(store: &impl MetadataStore, prefix: &[u8]) -> Result<Vec<(Vec<u8>, Bytes)>> {
+    let mut rows: Vec<(Vec<u8>, Bytes)> = Vec::new();
+    let mut cursor: Option<Vec<u8>> = None;
+    loop {
+        let (page, next): ScanPage = store
+            .scan_page(prefix, cursor.as_deref(), SCAN_PAGE_ROWS)
+            .await?;
+        rows.extend(page);
+        match next {
+            Some(at) => cursor = Some(at),
+            None => return Ok(rows),
+        }
+    }
+}
+
+/// How many rows one [`scan_pages`] page reads — the page size, not a cap on the range.
+const SCAN_PAGE_ROWS: usize = 1_000;
