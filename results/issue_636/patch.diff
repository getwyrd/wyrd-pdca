+
+// ===========================================================================
+// The multipart commit protocol's own races (issue #636, proposal 0016)
+// ===========================================================================
+//
+// ADR-0009 is the correctness authority for interleavings (`0016:2877-2905`), and exactly
+// three of 0016's list belong to this slice — the rest are #625's (the reaper's arms) or
+// #637's (the custodian-side protection class):
+//
+//   (i)   publication CAS loss: the published `version` is `prior.version + 1` computed from
+//         the **re-read** prior at each flip attempt, never frozen at fence time
+//         (`0016:350`, matching `crates/core/src/metadata.rs:551`,`:595`,`:656`);
+//   (ii)  the slot-reserve race at the cap (X41/X55): concurrent part starts at
+//         `MAX_INFLIGHT_PARTS` produce no `MAX_INFLIGHT_PARTS + 1`-th key and no starvation;
+//   (iii) two concurrent drainers over one owned `sidx:` range (X56): exactly-once effects,
+//         the FIRST orphan stamp preserved, and no double-decrement of `mpuctl.count`.
+//
+// They are appended to this campaign rather than given their own file for a mechanical
+// reason: `run-verify.sh` puts every ADDED test file into one cargo invocation and, seeing a
+// `#![cfg(madsim)]` crate root among them, applies `--cfg madsim` to the whole invocation —
+// under which `wyrd-core`'s dev-dependency graph swaps `tonic` for `madsim-tonic`, so the
+// crate-level multipart tests would be built against a simulator graph they are not written
+// for. Appended here they are a *modified* path and run where they belong: `cargo xtask ci` ->
+// `run_dst` (`xtask/src/main.rs:1575-1614`), the gating row.
+
+use wyrd_core::metadata::{self as meta_model, InodeState, ObjectMeta};
+use wyrd_core::multipart::{
+    self as mpu, AbortOutcome, Budget, CompleteOutcome, CompleteParams, CreateOutcome,
+    CreateParams, CreateRetry, DrainBudget, ReserveOutcome, SessionState, UploadPartOutcome,
+};
+use wyrd_core::placement::Topology;
+
+const MPU_BUCKET: &str = "buck";
+const MPU_OBJECT: &str = "buck/obj";
+const MPU_NOW: u64 = 3_000_000;
+const MPU_LEASE_TTL: u64 = 30_000;
+const MPU_CHUNK: usize = 8;
+
+/// Deterministic 32-hex tokens from a counter — a seeded generator, so a failing interleaving
+/// replays exactly (ADR-0009).
+fn mpu_tokens(base: u128) -> impl FnMut() -> String {
+    let mut n = base;
+    move || {
+        n += 1;
+        format!("{n:032x}")
+    }
+}
+
+/// A `MetadataStore` that counts, per key, how many **committed** puts landed on it.
+///
+/// This is the honest observable for X56's no-re-stamp property. Comparing stamp *values*
+/// cannot express it: with two drainers interleaving, a mark carrying the later drainer's
+/// instant may be that position's **first** mark (whoever reached it first writes it), so a
+/// value check either fails on a correct execution or proves nothing. What must never happen is
+/// a **second** committed put to a position that already had one — which would restart that
+/// fragment's grace clock — and that is exactly one put per `orphan:` key.
+struct MarkCountingStore<M> {
+    inner: Arc<M>,
+    puts: std::sync::Mutex<std::collections::BTreeMap<Vec<u8>, usize>>,
+}
+
+impl<M> MarkCountingStore<M> {
+    fn new(inner: Arc<M>) -> Self {
+        Self {
+            inner,
+            puts: std::sync::Mutex::new(std::collections::BTreeMap::new()),
+        }
+    }
+
+    /// How many committed puts each `orphan:` key received.
+    fn orphan_puts(&self) -> std::collections::BTreeMap<Vec<u8>, usize> {
+        self.puts
+            .lock()
+            .unwrap()
+            .iter()
+            .filter(|(key, _)| key.starts_with(meta_model::ORPHAN_PREFIX))
+            .map(|(key, count)| (key.clone(), *count))
+            .collect()
+    }
+}
+
+#[async_trait::async_trait]
+impl<M: MetadataStore> MetadataStore for MarkCountingStore<M> {
+    async fn get(&self, key: &[u8]) -> wyrd_traits::Result<Option<bytes::Bytes>> {
+        self.inner.get(key).await
+    }
+
+    async fn scan(&self, prefix: &[u8]) -> wyrd_traits::Result<Vec<(Vec<u8>, bytes::Bytes)>> {
+        self.inner.scan(prefix).await
+    }
+
+    async fn scan_page(
+        &self,
+        prefix: &[u8],
+        after: Option<&[u8]>,
+        limit: usize,
+    ) -> wyrd_traits::Result<wyrd_traits::ScanPage> {
+        self.inner.scan_page(prefix, after, limit).await
+    }
+
+    async fn commit(&self, batch: WriteBatch) -> wyrd_traits::Result<CommitOutcome> {
+        let keys: Vec<Vec<u8>> = batch.puts.iter().map(|(key, _)| key.clone()).collect();
+        let outcome = self.inner.commit(batch).await?;
+        if outcome == CommitOutcome::Committed {
+            let mut puts = self.puts.lock().unwrap();
+            for key in keys {
+                *puts.entry(key).or_insert(0) += 1;
+            }
+        }
+        Ok(outcome)
+    }
+}
+
+fn mpu_topology() -> Topology {
+    let mut t = Topology::default();
+    for id in 0u64..12 {
+        t.register(id, format!("domain-{id}"));
+    }
+    t
+}
+
+/// Create a bucket record and one `Open` session, returning its upload id.
+async fn mpu_session<M: MetadataStore>(meta: &M, tokens: &mut impl FnMut() -> String) -> String {
+    meta.commit(WriteBatch::new().put(
+        meta_model::bucket_key(MPU_BUCKET),
+        bytes::Bytes::from_static(b"{}"),
+    ))
+    .await
+    .unwrap();
+    match mpu::create_session(
+        meta,
+        &CreateParams {
+            bucket: MPU_BUCKET,
+            parent: 0,
+            object: MPU_OBJECT,
+            content_type: None,
+            created_at_millis: MPU_NOW,
+            clock_source: "wall",
+            budget: Budget::deployed(),
+            resume: None,
+        },
+        tokens,
+        CreateRetry::default(),
+        || 0,
+        |_, _| async {},
+    )
+    .await
+    .unwrap()
+    {
+        CreateOutcome::Created(session) => session.upload_id.clone(),
+        other => panic!("create refused: {other:?}"),
+    }
+}
+
+// ---------------------------------------------------------------------------
+// (i) Publication CAS loss — the version is recomputed from the re-read prior
+// ---------------------------------------------------------------------------
+
+/// What one seed's publication race produced.
+struct PublishRace {
+    /// The version the multipart Complete recorded, if it published.
+    multipart_version: Option<u64>,
+    /// Whether the concurrent overwrite committed.
+    interloper_committed: bool,
+    /// The inode's version after both settled.
+    final_version: u64,
+    /// The session's state after both settled — never `Completing`.
+    session_state: Option<SessionState>,
+}
+
+/// Race a multipart Complete against a plain content overwrite of the same object key.
+///
+/// `parts` is one body per part. Two shapes are raced by the cases below and the difference is
+/// load-bearing: a **flat** publication is one batch, so a lost root flip has nothing durable to
+/// resume from, while a **segmented** one has already advanced the session's `segments_written`
+/// cursor in its own fence record — so the retry is only sound if it re-reads the session it
+/// fenced. A race that only ever runs flat cannot see that (`0016:2332-2345`, decision 7(c)/(d)).
+async fn run_publish_race<M>(meta: Arc<M>, parts: &[Vec<u8>], scheme: EcScheme) -> PublishRace
+where
+    M: MetadataStore + 'static,
+{
+    let dir = tempfile::tempdir().expect("temp dir");
+    let chunks = Arc::new(FsChunkStore::open(dir.path()).expect("fs store"));
+    let mut tokens = mpu_tokens(0x5100);
+
+    // An existing committed generation at version 1, so the flip is a SUPERSEDE and the
+    // version rule (`prior.version + 1` from the re-read prior) is what is under test.
+    let v0 = write::plan_write(b"v0", MPU_CHUNK, RS, ids_from(0x9000)).unwrap();
+    write::intent(&*meta, &v0, LEASE_EXPIRY).await.unwrap();
+    write::write_fragments(&*chunks, &v0).await.unwrap();
+    write::commit_create(&*meta, 0, MPU_OBJECT, 5, &v0, 0)
+        .await
+        .unwrap();
+    write::release(&*meta, &v0).await.unwrap();
+
+    let upload_id = mpu_session(&*meta, &mut tokens).await;
+    let mut ids = ids_from(0xA000);
+    for (index, body) in parts.iter().enumerate() {
+        let outcome = mpu::upload_part(
+            &*meta,
+            &*chunks,
+            &upload_id,
+            index as u32 + 1,
+            body,
+            MPU_CHUNK,
+            scheme,
+            &mpu_topology(),
+            &mut || MPU_NOW,
+            "wall",
+            MPU_LEASE_TTL,
+            &mut tokens,
+            &mut ids,
+            &Budget::deployed(),
+        )
+        .await
+        .unwrap();
+        assert!(matches!(outcome, UploadPartOutcome::Committed { .. }));
+    }
+    // The digests come from the durable `part:` records, not from hashes computed here: the
+    // client names what the records recorded, which is what Complete validates against.
+    let recorded = mpu::read_parts(&*meta, &upload_id).await.unwrap();
+    let named: Vec<(u32, String)> = recorded
+        .iter()
+        .map(|(number, record)| (*number, record.digest.clone()))
+        .collect();
+
+    let completer = {
+        let meta = Arc::clone(&meta);
+        let upload_id = upload_id.clone();
+        let named = named.clone();
+        madsim::task::spawn(async move {
+            mpu::complete(
+                &*meta,
+                &CompleteParams {
+                    upload_id: &upload_id,
+                    named: &named,
+                    now_millis: MPU_NOW + 1,
+                    clock_source: "wall",
+                    budget: &Budget::deployed(),
+                    resume: None,
+                },
+                &mut || 77u64,
+            )
+            .await
+            .unwrap()
+        })
+    };
+    let interloper = {
+        let meta = Arc::clone(&meta);
+        let chunks = Arc::clone(&chunks);
+        madsim::task::spawn(async move {
+            let plan = write::plan_write(b"interloper", MPU_CHUNK, RS, ids_from(0xB000)).unwrap();
+            write::intent(&*meta, &plan, LEASE_EXPIRY).await.unwrap();
+            write::write_fragments(&*chunks, &plan).await.unwrap();
+            let prior = read::read_inode(&*meta, 5).await.unwrap().unwrap();
+            meta_model::commit_chunk_map_superseding(
+                &*meta,
+                5,
+                &prior,
+                plan.chunk_refs(),
+                plan.size,
+                MPU_NOW,
+                &ObjectMeta::default(),
+            )
+            .await
+            .unwrap()
+        })
+    };
+
+    let complete = completer.await.unwrap();
+    let overwrite = interloper.await.unwrap();
+    let final_version = read::read_inode(&*meta, 5).await.unwrap().unwrap().version;
+    // The object resolves whichever writer ended up last — a publication that left an
+    // unresolvable root would fail here before any version assertion ran.
+    read::read_path(&*meta, &*chunks, 0, MPU_OBJECT)
+        .await
+        .unwrap()
+        .expect("the object resolves after both writers settled");
+    PublishRace {
+        multipart_version: match &complete {
+            CompleteOutcome::Published(publication) => Some(publication.version),
+            _ => None,
+        },
+        interloper_committed: overwrite == CommitOutcome::Committed,
+        final_version,
+        session_state: mpu::read_session(&*meta, &upload_id)
+            .await
+            .unwrap()
+            .map(|session| session.state()),
+    }
+}
+
+/// **(i)** A publication that loses its compare-and-set retries against the **re-read** prior
+/// and records `newprior.version + 1` — never the fence-time value.
+///
+/// The seed sweep is what makes this binding: both orders are reachable, and the assertion
+/// that matters (`multipart_version == 3`) only exists in the schedule where the interloper
+/// won first. A design that froze the version in `publish_target` at fence time would retry
+/// version 2 against a prior already at 2 and either loop to exhaustion or record a stale
+/// number (`0016:1024`).
+#[test]
+fn multipart_publication_recomputes_its_version_from_the_reread_prior() {
+    let mut saw_complete_after_interloper = 0usize;
+    let mut saw_interloper_after_complete = 0usize;
+    for seed in 0..48u64 {
+        let rt = madsim::runtime::Runtime::with_seed_and_config(seed, madsim::Config::default());
+        let race = rt.block_on(async {
+            let meta = Arc::new(RedbMetadataStore::in_memory().expect("redb"));
+            run_publish_race(meta, &[b"multipart-body".to_vec()], RS).await
+        });
+
+        // Under EVERY schedule: the session is never left fenced, and no version is reused.
+        assert_ne!(
+            race.session_state,
+            Some(SessionState::Completing),
+            "seed {seed}: a lost publication CAS must never strand the session in Completing"
+        );
+        if let Some(version) = race.multipart_version {
+            assert!(version >= 2, "seed {seed}: a supersede publishes prior + 1");
+            assert!(
+                version <= race.final_version,
+                "seed {seed}: published {version} but the inode ended at {}",
+                race.final_version
+            );
+            if race.interloper_committed && version == 3 {
+                // The multipart flip went SECOND and recomputed from the re-read prior.
+                saw_complete_after_interloper += 1;
+            }
+            if race.interloper_committed && version == 2 {
+                saw_interloper_after_complete += 1;
+            }
+        }
+        if race.multipart_version.is_some() && race.interloper_committed {
+            assert_eq!(
+                race.final_version, 3,
+                "seed {seed}: two publications must advance the version exactly twice"
+            );
+        }
+    }
+    assert!(
+        saw_complete_after_interloper >= 1,
+        "no seed in 0..48 put the multipart flip AFTER the interloper, so the \
+         recomputed-version assertion never ran and the coverage would be vacuous"
+    );
+    assert!(
+        saw_interloper_after_complete >= 1,
+        "no seed put the interloper after the multipart flip; the race is one-sided"
+    );
+}
+
+// ---------------------------------------------------------------------------
+// (ii) The slot-reserve race at the cap (X41/X55)
+// ---------------------------------------------------------------------------
+
+/// Fire `starts` concurrent `UploadPart` slot reserves at one session and report how many were
+/// admitted, how many were refused, and how many `slot:` keys exist.
+async fn run_slot_race<M>(meta: Arc<M>, starts: u32) -> (usize, usize, usize)
+where
+    M: MetadataStore + 'static,
+{
+    let mut tokens = mpu_tokens(0x5200);
+    let upload_id = mpu_session(&*meta, &mut tokens).await;
+    let budget = Budget::deployed();
+
+    let mut handles = Vec::new();
+    for which in 0..starts {
+        let meta = Arc::clone(&meta);
+        let upload_id = upload_id.clone();
+        let budget = budget.clone();
+        handles.push(madsim::task::spawn(async move {
+            let mut tokens = mpu_tokens(u128::from(which + 1) << 64);
+            mpu::reserve_slot(
+                &*meta,
+                &upload_id,
+                which + 1,
+                MPU_NOW,
+                MPU_LEASE_TTL,
+                "wall",
+                None,
+                &mut tokens,
+                &budget,
+            )
+            .await
+            .unwrap()
+        }));
+    }
+    let mut admitted = 0usize;
+    let mut refused = 0usize;
+    for handle in handles {
+        match handle.await.unwrap() {
+            ReserveOutcome::Reserved(_) => admitted += 1,
+            ReserveOutcome::Refused(_) => refused += 1,
+        }
+    }
+    let keys = meta.scan(&mpu::slot_range(&upload_id)).await.unwrap().len();
+    (admitted, refused, keys)
+}
+
+/// **(ii)** Concurrent part starts at the cap produce **no `MAX_INFLIGHT_PARTS + 1`-th key**
+/// and **no starvation**.
+///
+/// The cap is *structural*: each index is claimed by its own `require_absent`, so overshoot is
+/// unrepresentable however the scheduler interleaves — a design that admitted from the
+/// population read instead would let every racing reserver in (ADR-0046's scan-then-commit
+/// class, `0016:1780`). And every admitted reserve must have a real key: `admitted == keys`
+/// rules out a reserver that answered success without landing one.
+#[madsim::test]
+async fn concurrent_slot_reserves_never_exceed_the_cap_and_never_starve() {
+    let starts = mpu::MAX_INFLIGHT_PARTS + 8;
+    let meta = Arc::new(RedbMetadataStore::in_memory().expect("redb"));
+    let (admitted, refused, keys) = run_slot_race(meta, starts).await;
+    assert_eq!(
+        keys, admitted,
+        "every admitted reserve must have landed exactly one slot key"
+    );
+    assert!(
+        keys <= mpu::MAX_INFLIGHT_PARTS as usize,
+        "the slot key space IS the cap: saw {keys} keys for a cap of {}",
+        mpu::MAX_INFLIGHT_PARTS
+    );
+    // No starvation: the cap is filled, not merely respected. A reserver that gave up while an
+    // index was free would show here as an under-filled range.
+    assert_eq!(
+        admitted,
+        mpu::MAX_INFLIGHT_PARTS as usize,
+        "all {} indices must be claimed before any reserver is refused",
+        mpu::MAX_INFLIGHT_PARTS
+    );
+    assert_eq!(refused as u32, starts - mpu::MAX_INFLIGHT_PARTS);
+}
+
+/// The same race over the **second implementation** — the simulated-TiKV model, whose commit
+/// awaits mid-flight, so the scheduler can interleave a reserver *inside* another's commit.
+#[madsim::test]
+async fn concurrent_slot_reserves_never_exceed_the_cap_on_sim_tikv() {
+    let starts = mpu::MAX_INFLIGHT_PARTS + 8;
+    let meta = Arc::new(SimTikvMetadataStore::with_fidelity(
+        Fidelity::AwaitInsideCommit,
+    ));
+    let (admitted, _, keys) = run_slot_race(meta, starts).await;
+    assert_eq!(keys, admitted);
+    assert!(keys <= mpu::MAX_INFLIGHT_PARTS as usize);
+}
+
+// ---------------------------------------------------------------------------
+// (iii) Two concurrent drainers over one owned `sidx:` range (X56)
+// ---------------------------------------------------------------------------
+
+/// **(iii)** A gateway draining its own teardown inline and the reaper draining the same
+/// session are **both** legal by design (§2's exit table), so the owned-`sidx:` walk — which
+/// is reference-derived and has no obligation record to serialize on — must be exactly-once
+/// under every interleaving.
+///
+/// Three properties, each a distinct way to get it wrong:
+///
+/// * **exactly-once effects**: the two walks together reclaim each entry once, so the summed
+///   `owned_reclaimed` equals the number of entries that existed — a walk that deleted an entry
+///   another had already deleted would double-count and, on a real backend, would race the
+///   `require(sidx == prior)` precondition that makes it a no-op;
+/// * **the FIRST orphan stamp survives**: a mark is written only when the position is absent
+///   and skipped when present, so its `orphaned_at` is the first drainer's. Re-stamping would
+///   restart the grace clock and a persistent racer could postpone reclamation without bound
+///   (`0016:1781`);
+/// * **no double-decrement**: both drainers reach the terminal delete, whose
+///   `require(mpu:<id> == prior)` lets exactly one win — the loser's whole batch is a no-op
+///   (`0016:581-590`).
+#[madsim::test]
+async fn two_concurrent_drainers_over_one_owned_range_are_exactly_once() {
+    let meta = Arc::new(MarkCountingStore::new(Arc::new(
+        RedbMetadataStore::in_memory().expect("redb"),
+    )));
+    let dir = tempfile::tempdir().expect("temp dir");
+    let chunks = Arc::new(FsChunkStore::open(dir.path()).expect("fs store"));
+    let mut tokens = mpu_tokens(0x5300);
+    let upload_id = mpu_session(&*meta, &mut tokens).await;
+    let budget = Budget::deployed();
+
+    // Two parts that crashed mid-stream: staged owned entries, no `part:` record, slots still
+    // held (deliberately — the residue is counted against the cap, F11a).
+    let mut ids = ids_from(0xC000);
+    let mut owned_chunks = Vec::new();
+    for part_number in 1..=2u32 {
+        let mut part = match mpu::reserve_slot(
+            &*meta,
+            &upload_id,
+            part_number,
+            MPU_NOW,
+            MPU_LEASE_TTL,
+            "wall",
+            None,
+            &mut tokens,
+            &budget,
+        )
+        .await
+        .unwrap()
+        {
+            ReserveOutcome::Reserved(part) => *part,
+            other => panic!("reserve refused: {other:?}"),
+        };
+        for _ in 0..2 {
+            let outcome = mpu::stage_chunk(
+                &*meta,
+                &*chunks,
+                &mut part,
+                b"staged!!",
+                RS,
+                ids(),
+                &mpu_topology(),
+                MPU_NOW,
+                MPU_LEASE_TTL,
+            )
+            .await
+            .unwrap();
+            assert_eq!(outcome, CommitOutcome::Committed);
+        }
+        owned_chunks.extend(part.staged.iter().map(|chunk| chunk.id));
+    }
+    let entries = meta.scan(&mpu::sidx_range(&upload_id)).await.unwrap().len();
+    assert_eq!(entries, owned_chunks.len());
+
+    // Fence, so the walk is legal at all: fence-then-walk means an `Open` session's owned
+    // entries are never touched.
+    assert_eq!(
+        mpu::abort(&*meta, &upload_id, MPU_NOW + 1, "wall")
+            .await
+            .unwrap(),
+        AbortOutcome::Fenced
+    );
+    let count_before = mpu::read_admission(&*meta)
+        .await
+        .unwrap()
+        .expect("the ledger exists")
+        .1
+        .count;
+
+    // Two drainers, concurrently, with DIFFERENT mark instants so a re-stamp is detectable.
+    let drain_budget = DrainBudget {
+        max_batch_bytes: 4_000,
+        max_batch_ops: 24,
+    };
+    let mut handles = Vec::new();
+    // Two DIFFERENT mark instants, so each mark's value identifies which drainer wrote it.
+    for at in [MPU_NOW + 10, MPU_NOW + 5_000] {
+        let meta = Arc::clone(&meta);
+        let upload_id = upload_id.clone();
+        handles.push(madsim::task::spawn(async move {
+            mpu::teardown_session(&*meta, &upload_id, at, &drain_budget)
+                .await
+                .unwrap()
+        }));
+    }
+    let mut reports = Vec::new();
+    for handle in handles {
+        reports.push(handle.await.unwrap());
+    }
+
+    // Exactly-once effects over the owned range.
+    let reclaimed: usize = reports.iter().map(|r| r.owned_reclaimed).sum();
+    assert_eq!(
+        reclaimed, entries,
+        "two drainers over one owned range must reclaim each entry exactly once (saw \
+         {reclaimed} for {entries} entries)"
+    );
+    assert!(
+        meta.scan(&mpu::sidx_range(&upload_id))
+            .await
+            .unwrap()
+            .is_empty(),
+        "the walk must converge to an EMPTY range"
+    );
+
+    // Every planned position is evidenced...
+    let marks = meta.scan(meta_model::ORPHAN_PREFIX).await.unwrap();
+    assert_eq!(
+        marks.len(),
+        owned_chunks.len() * 9,
+        "the full planned placement of every owned chunk must be evidenced"
+    );
+    // ...and **written exactly once**. A second committed put to a position that already had a
+    // mark is a re-stamp: it restarts that fragment's grace clock, and a persistent racer could
+    // postpone reclamation without bound (`0016:1781`). The two drainers stamp DIFFERENT
+    // instants, so each mark's value also identifies which one got there first — a legitimate
+    // first stamp either way, which is why the assertion is on the put COUNT, not the value.
+    for (key, puts) in meta.orphan_puts() {
+        assert_eq!(
+            puts,
+            1,
+            "orphan mark {} received {puts} committed puts — a mark is written when absent and \
+             SKIPPED when present, never re-stamped",
+            String::from_utf8_lossy(&key)
+        );
+    }
+    for (_, value) in &marks {
+        let stamp: u64 = std::str::from_utf8(value).unwrap().trim().parse().unwrap();
+        assert!(
+            stamp == MPU_NOW + 10 || stamp == MPU_NOW + 5_000,
+            "a mark must carry the instant of the drainer that wrote it, saw {stamp}"
+        );
+    }
+
+    // No double-decrement: exactly one terminal delete fires, whichever drainer wins.
+    let terminal = reports.iter().filter(|r| r.terminal_deleted).count();
+    let decrements = reports.iter().filter(|r| r.count_decremented).count();
+    assert_eq!(terminal, 1, "exactly one terminal delete may fire");
+    assert_eq!(decrements, 1, "the mpuctl.count decrement is exactly-once");
+    assert_eq!(
+        mpu::read_admission(&*meta).await.unwrap().unwrap().1.count,
+        count_before - 1
+    );
+    assert!(mpu::read_session(&*meta, &upload_id)
+        .await
+        .unwrap()
+        .is_none());
+    assert!(meta
+        .scan(&mpu::slot_range(&upload_id))
+        .await
+        .unwrap()
+        .is_empty());
+}
+
+/// The publication race, over the **second implementation** — the trait pinned by two
+/// backends, as the campaign's own header requires (ADR-0006).
+#[madsim::test]
+async fn multipart_publication_race_holds_on_sim_tikv() {
+    let meta = Arc::new(SimTikvMetadataStore::with_fidelity(
+        Fidelity::AwaitInsideCommit,
+    ));
+    let race = run_publish_race(meta, &[b"multipart-body".to_vec()], RS).await;
+    assert_ne!(race.session_state, Some(SessionState::Completing));
+    if let Some(version) = race.multipart_version {
+        assert!(version >= 2 && version <= race.final_version);
+    }
+}
+
+// ---------------------------------------------------------------------------
+// (i-b) The SEGMENTED publication's root flip loses — the stale-resume path
+// ---------------------------------------------------------------------------
+
+/// One part body of `chunks` chunks, so a two-part Complete assembles a map past
+/// [`mpu::MAX_MAP_CHUNKS`] and therefore publishes through the **segmented** committer.
+fn segmented_part(seed: u8, chunks: usize) -> Vec<u8> {
+    (0..chunks * MPU_CHUNK)
+        .map(|i| (i as u8).wrapping_mul(31).wrapping_add(seed))
+        .collect()
+}
+
+/// A store that makes **one** root flip lose its compare-and-swap, at the instant it commits.
+///
+/// The interleaving this leg needs is narrow — another writer must advance the inode *after* the
+/// publisher resolved it and *before* its flip lands — and a seed sweep may simply never schedule
+/// a spawned task into it. So it is **forced** rather than hoped for: the first batch that puts
+/// `inode:<id>` has a version bump applied underneath it, which is exactly what a concurrent
+/// `PutObject` leaves behind, and the flip's `require(inode == prior)` then fails on its own
+/// terms. Everything after that — the re-resolve, the recomputed version, the resumed segment
+/// phase — is the production path.
+struct FlipLoserStore<M> {
+    inner: Arc<M>,
+    inode_key: Vec<u8>,
+    armed: std::sync::Mutex<bool>,
+}
+
+impl<M> FlipLoserStore<M> {
+    fn new(inner: Arc<M>, inode: u64) -> Self {
+        Self {
+            inner,
+            inode_key: meta_model::inode_key(inode),
+            armed: std::sync::Mutex::new(true),
+        }
+    }
+}
+
+#[async_trait::async_trait]
+impl<M: MetadataStore> MetadataStore for FlipLoserStore<M> {
+    async fn get(&self, key: &[u8]) -> wyrd_traits::Result<Option<bytes::Bytes>> {
+        self.inner.get(key).await
+    }
+
+    async fn scan(&self, prefix: &[u8]) -> wyrd_traits::Result<Vec<(Vec<u8>, bytes::Bytes)>> {
+        self.inner.scan(prefix).await
+    }
+
+    async fn scan_page(
+        &self,
+        prefix: &[u8],
+        after: Option<&[u8]>,
+        limit: usize,
+    ) -> wyrd_traits::Result<wyrd_traits::ScanPage> {
+        self.inner.scan_page(prefix, after, limit).await
+    }
+
+    async fn commit(&self, batch: WriteBatch) -> wyrd_traits::Result<CommitOutcome> {
+        let flips_root = batch.puts.iter().any(|(key, _)| *key == self.inode_key);
+        let fire = flips_root && std::mem::replace(&mut *self.armed.lock().unwrap(), false);
+        if fire {
+            if let Some(bytes) = self.inner.get(&self.inode_key).await? {
+                let prior: meta_model::InodeRecord = meta_model::decode(&bytes).unwrap();
+                let bumped = meta_model::InodeRecord {
+                    version: prior.version + 1,
+                    ..prior
+                };
+                assert_eq!(
+                    self.inner
+                        .commit(
+                            WriteBatch::new()
+                                .require(self.inode_key.clone(), bytes)
+                                .put(self.inode_key.clone(), meta_model::encode(&bumped)),
+                        )
+                        .await?,
+                    CommitOutcome::Committed,
+                    "the forced interloper must land before the flip it defeats"
+                );
+            }
+        }
+        self.inner.commit(batch).await
+    }
+}
+
+/// **(i-b)** A segmented publication whose root flip loses **after its segment-write phase has
+/// advanced the session cursor** retries from the state that phase left, and publishes.
+///
+/// This is the leg the flat race cannot reach, and it is the one a stale resume fails. A
+/// segmented attempt's phase-1 batches CAS `segments_written` **in the session record it is
+/// fenced on** (`0016:2336-2338`, decision 7(c)), so after a lost flip the fence value *and* the
+/// resume cursor both live in a record the attempt itself moved. A retry that re-uses the
+/// fence-time snapshot requires `segments_written == 0` against a record that says `N`: every
+/// remaining batch conflicts, the publish budget drains, and the fence release — preconditioned
+/// on the same stale bytes — conflicts too, leaving the session stuck in `Completing` with no
+/// exit but the reaper's `W_completing` (`0016:1023`, and `0016:1032`'s rule that a rejected
+/// request may never leave the session fenced).
+///
+/// `EcScheme::None` keeps the fixture affordable: what has to cross a boundary here is the
+/// **chunk count** (past `MAX_MAP_CHUNKS`, so the map segments), not the fragment fan-out.
+#[madsim::test]
+async fn a_segmented_publication_that_loses_the_root_flip_still_publishes() {
+    let per_part = mpu::MAX_MAP_CHUNKS / 2 + 4;
+    let parts = [segmented_part(1, per_part), segmented_part(2, per_part)];
+    let expected: Vec<u8> = parts.iter().flatten().copied().collect();
+    let dir = tempfile::tempdir().expect("temp dir");
+    let chunks = Arc::new(FsChunkStore::open(dir.path()).expect("fs store"));
+    let inner = Arc::new(RedbMetadataStore::in_memory().expect("redb"));
+    let mut tokens = mpu_tokens(0x5500);
+    let mut ids = ids_from(0xE000);
+
+    // An existing committed generation, so the flip is a supersede and the forced interloper has
+    // a version to advance.
+    let v0 = write::plan_write(b"v0", MPU_CHUNK, EcScheme::None, ids_from(0xE900)).unwrap();
+    write::intent(&*inner, &v0, LEASE_EXPIRY).await.unwrap();
+    write::write_fragments(&*chunks, &v0).await.unwrap();
+    write::commit_create(&*inner, 0, MPU_OBJECT, 5, &v0, 0)
+        .await
+        .unwrap();
+    write::release(&*inner, &v0).await.unwrap();
+
+    let meta = Arc::new(FlipLoserStore::new(Arc::clone(&inner), 5));
+    let upload_id = mpu_session(&*meta, &mut tokens).await;
+    let mut named = Vec::new();
+    for (index, body) in parts.iter().enumerate() {
+        let outcome = mpu::upload_part(
+            &*meta,
+            &*chunks,
+            &upload_id,
+            index as u32 + 1,
+            body,
+            MPU_CHUNK,
+            EcScheme::None,
+            &mpu_topology(),
+            &mut || MPU_NOW,
+            "wall",
+            MPU_LEASE_TTL,
+            &mut tokens,
+            &mut ids,
+            &Budget::deployed(),
+        )
+        .await
+        .unwrap();
+        match outcome {
+            UploadPartOutcome::Committed {
+                part_number,
+                digest,
+            } => named.push((part_number, digest)),
+            other => panic!("part refused: {other:?}"),
+        }
+    }
+
+    let outcome = mpu::complete(
+        &*meta,
+        &CompleteParams {
+            upload_id: &upload_id,
+            named: &named,
+            now_millis: MPU_NOW + 1,
+            clock_source: "wall",
+            budget: &Budget::deployed(),
+            resume: None,
+        },
+        &mut || 77u64,
+    )
+    .await
+    .unwrap();
+
+    // The session left `Completing` whatever happened — this is the assertion a stale resume
+    // fails, and it fails it in the worst way: a client error indistinguishable from a crashed
+    // completer.
+    let state = mpu::read_session(&*meta, &upload_id)
+        .await
+        .unwrap()
+        .map(|session| session.state());
+    assert_ne!(
+        state,
+        Some(SessionState::Completing),
+        "a lost root flip must not strand a segmented publication in Completing (outcome: \
+         {outcome:?})"
+    );
+    let publication = match outcome {
+        CompleteOutcome::Published(publication) => *publication,
+        other => panic!("the retry after a single lost flip must publish, got {other:?}"),
+    };
+    // v1 was the fixture, v2 the forced interloper, so the retry recomputed v3 from the prior it
+    // re-read — never the fence-time value.
+    assert_eq!(
+        publication.version, 3,
+        "the retry publishes prior + 1 from the RE-READ prior"
+    );
+    let root = read::read_inode(&*inner, 5).await.unwrap().unwrap();
+    assert!(
+        root.chunk_map.is_segmented(),
+        "a map past MAX_MAP_CHUNKS publishes as a segmented map"
+    );
+    assert_eq!(
+        read::read_path(&*inner, &*chunks, 0, MPU_OBJECT)
+            .await
+            .unwrap()
+            .expect("the object resolves"),
+        expected,
+        "the published segmented object is the parts concatenated in part-number order"
+    );
+    assert_eq!(state, Some(SessionState::Completed));
+}
+
+/// A dead-simple compile-time reminder that the flat map path is still the one a single-part
+/// publication takes, so the segmented committer is not silently on every write.
+#[madsim::test]
+async fn a_one_part_publication_stays_flat() {
+    let meta = Arc::new(RedbMetadataStore::in_memory().expect("redb"));
+    let dir = tempfile::tempdir().expect("temp dir");
+    let chunks = Arc::new(FsChunkStore::open(dir.path()).expect("fs store"));
+    let mut tokens = mpu_tokens(0x5400);
+    let upload_id = mpu_session(&*meta, &mut tokens).await;
+    let mut ids = ids_from(0xD000);
+    let body = b"one-part".to_vec();
+    mpu::upload_part(
+        &*meta,
+        &*chunks,
+        &upload_id,
+        1,
+        &body,
+        MPU_CHUNK,
+        RS,
+        &mpu_topology(),
+        &mut || MPU_NOW,
+        "wall",
+        MPU_LEASE_TTL,
+        &mut tokens,
+        &mut ids,
+        &Budget::deployed(),
+    )
+    .await
+    .unwrap();
+    let digest = mpu::read_parts(&*meta, &upload_id).await.unwrap()[&1]
+        .digest
+        .clone();
+    let outcome = mpu::complete(
+        &*meta,
+        &CompleteParams {
+            upload_id: &upload_id,
+            named: &[(1, digest)],
+            now_millis: MPU_NOW + 1,
+            clock_source: "wall",
+            budget: &Budget::deployed(),
+            resume: None,
+        },
+        &mut || 9u64,
+    )
+    .await
+    .unwrap();
+    let CompleteOutcome::Published(publication) = outcome else {
+        panic!("expected a publication, got {outcome:?}");
+    };
+    let inode = read::read_inode(&*meta, publication.inode)
+        .await
+        .unwrap()
+        .unwrap();
+    assert!(!inode.chunk_map.is_segmented());
+    assert_eq!(inode.state, InodeState::Committed);
+    assert_eq!(
+        read::read_path(&*meta, &*chunks, 0, MPU_OBJECT)
+            .await
+            .unwrap(),
+        Some(body)
+    );
+    // Nothing here should have needed a segment record.
+    assert!(meta.scan(meta_model::SEG_PREFIX).await.unwrap().is_empty());
+}
