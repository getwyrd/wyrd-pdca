+/// **A step's CLOSING mutations are inside the envelope too** (`0016:1490-1496`).
+///
+/// Every step ends by writing the advanced obligation — the whole payload again — or by deleting
+/// it and its group marker. Appended *after* the last budget check, those bytes are outside the
+/// bound the walk was so careful to respect, and the batch that carries them is over the
+/// transaction envelope **permanently**: the same step re-derives the same over-envelope shape on
+/// every retry, so it is not a slow batch but a stuck one. The fixture is an obligation whose
+/// payload is a real fraction of the budget, which is where the difference shows.
+#[test]
+fn a_drain_step_budgets_the_mutations_that_close_it() {
+    pollster::block_on(async {
+        let meta = MemMeta::default();
+        let mut ids = ids_from(0xB0DE);
+        // A losing writer's compensation payload: a dozen erasure-coded chunks, so the
+        // obligation value is ~a third of the tiny envelope and re-writing it is not free.
+        let chunks: Vec<metadata::ChunkRef> = (0..12)
+            .map(|_| metadata::ChunkRef {
+                id: ids(),
+                scheme: RS,
+                len: 1024,
+                placement: (0u64..9).collect(),
+            })
+            .collect();
+        let marks: usize = chunks
+            .iter()
+            .map(|chunk| usize::from(chunk.fragment_count()))
+            .sum();
+        let key = mpu::retire_key(
+            mpu::RetireMode::Bytes,
+            &mpu::RetireToken::Session {
+                upload_id: "b".repeat(32),
+                epoch: 2,
+                part: Some((3, "c".repeat(32))),
+            },
+        );
+        let obligation = mpu::RetireObligation::new(mpu::RetirePayload::Chunks {
+            chunks: chunks.clone(),
+        });
+        let value = metadata::encode(&obligation);
+        // A byte-bound envelope: the operation half is deliberately generous here, because it is
+        // the BYTES the closing put spends that this leg is about (`0016:1496` — the observable
+        // is encoded mutation bytes, and an obligation's own value is the largest single term).
+        let budget = DrainBudget {
+            max_batch_bytes: 4_000,
+            max_batch_ops: 1_000,
+        };
+        assert!(
+            value.len() > budget.max_batch_bytes / 4,
+            "the fixture's payload must be a real fraction of the envelope, is {} B",
+            value.len()
+        );
+        meta.put_raw(key.clone(), value);
+        let mut report = mpu::DrainReport::default();
+        mpu::drain_obligation(&meta, &key, NOW, &budget, &mut report)
+            .await
+            .unwrap();
+        assert_eq!(report.marks, marks, "every named position is evidenced");
+        assert!(
+            report.batches > 1,
+            "the fixture must take several batches, took {}",
+            report.batches
+        );
+        assert!(
+            report.max_batch_bytes <= budget.max_batch_bytes,
+            "the largest COMMITTED batch was {} B, past the {} B envelope — the closing \
+             mutations must be budgeted with the walk, not appended after it",
+            report.max_batch_bytes,
+            budget.max_batch_bytes
+        );
+        assert!(report.max_batch_ops <= budget.max_batch_ops);
+    });
+}
