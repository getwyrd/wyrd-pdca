+// The **retirement obligation record family lives in [`crate::metadata`]**, beside `orphan_key`
+// and `seg_key`, and is re-exported here because this module is its protocol: 0016 decision 4.1
+// makes the retirement ledger *the general bounded-work pattern*, so the ordinary object
+// committers (`metadata::unlink`, `metadata::commit_chunk_map_superseding{,_leased}`) install
+// obligations too — and a record class the base metadata layer writes cannot live in a module
+// that layer would then have to depend on. What is this module's is the *drain* and the state
+// machine below.
+pub use crate::metadata::{
+    retire_key, retire_session_range, DeleteSpace, DrainPhase, PartNumberSet, RetireCursor,
+    RetireMode, RetireObligation, RetirePayload, RetireToken, SegmentGeneration,
+    PART_NUMBER_FORMAT_MAX, PART_NUMBER_WIDTH, RETIRE_BYTES_PREFIX, RETIRE_RECORDS_PREFIX,
+};
+
+// ===========================================================================
+// 1. The knobs — every value settled here, inside 0016's ranges, with its derivation
+// ===========================================================================
+
+/// The worst-case encoded size of one [`ChunkRef`], in bytes — `b_ref` in 0016's
+/// arithmetic (`0016:1050-1053`: "~131 B (small D-server ids) to ~302 B (worst-case `u64`
+/// ids)").
+///
+/// The **worst** case, deliberately: every ceiling below divides a value budget by it, and
+/// sizing from the typical case would admit a record that fits until a fleet renumbers its
+/// D servers — a *permanent* over-`V` commit, the one failure a publication cannot retry
+/// out of.
+pub const MAX_CHUNKREF_BYTES: usize = 302;
+
+/// The chunk-ref count one JSON value holds at the 2x headroom the object-ceiling
+/// arithmetic assumes: `⌊(V/2) / b_ref⌋` (`0016:1050-1053`).
+///
+/// **The same rule binds three records** — the flat inode map, a `seg:` record, and a
+/// `part:` record — because each is one value (`0016:1044`), which is why
+/// [`MAX_MAP_CHUNKS`], [`MAX_SEG_CHUNKS`] and [`MAX_PART_CHUNKS`] are all this number
+/// rather than three independently chosen ones.
+const VALUE_CHUNK_CAPACITY: usize = (MAX_VALUE_BYTES / 2) / MAX_CHUNKREF_BYTES;
+
+/// The most chunks a **flat** inode chunk map may name (`0016:1464`). Past it, a
+/// publication segments (decision 7) instead of committing an over-`V` value.
+pub const MAX_MAP_CHUNKS: usize = VALUE_CHUNK_CAPACITY;
+
+/// The most chunks one `seg:` record may name (`0016:1465`). The segment split itself is
+/// **byte**-budgeted ([`metadata::SEGMENT_TARGET_BYTES`]); this is the same bound stated as
+/// a count, so the publishable ceiling below is expressible as arithmetic.
+pub const MAX_SEG_CHUNKS: usize = VALUE_CHUNK_CAPACITY;
+
+/// The most chunks one `part:` record may name — `max_part_bytes = MAX_PART_CHUNKS ×
+/// chunk_size`, i.e. **165 MiB at the 1 MiB default chunk** (`0016:1061-1075`,`:1466`).
+///
+/// Two bounds meet here and both are enforced:
+///
+/// * `max_chunkref_bytes × MAX_PART_CHUNKS ≤ V/2` — a `part:` record is one value, so this
+///   is *identical* to [`MAX_MAP_CHUNKS`]'s rule. A part above it is refused at
+///   `UploadPart` with [`Refusal::EntityTooLarge`] **before** the over-`V` commit, never
+///   discovered at the backend (`0016:1500`);
+/// * `MAX_PART_CHUNKS ≤ B_ops` (`0016:1466`, X110). A part commit is an **unsplittable**
+///   batch that deletes up to `MAX_PART_CHUNKS` owned `sidx:` entries, and its compensation
+///   is the same shape — so above the operation budget a *valid* part's commit **and** its
+///   compensation would both time out on the slowest backend, permanently, stranding the
+///   slot and the residue with no path that ever clears them. The clamp is asserted by
+///   [`knob_clamps_hold`], not merely commented.
+///
+/// The S3-conformance consequence — parts above ~165 MiB refused at the default chunk size,
+/// against S3's 5 GiB part maximum — is 0016's stated, accepted cost (`0016:1069-1071`); a
+/// deployment that needs larger parts raises `chunk_size` (FU-5 segments the part record).
+pub const MAX_PART_CHUNKS: usize = VALUE_CHUNK_CAPACITY;
+
+/// The byte budget a part's **chunk list** may occupy — `V/2`, the very quantity
+/// [`MAX_PART_CHUNKS`] is `⌊V/2 / MAX_CHUNKREF_BYTES⌋` of.
+///
+/// **Two records carry that list, not one**: the `part:` record, and the
+/// `retire:bytes:{session,part,attempt}` obligation that evidences its chunks when the attempt is
+/// superseded or refused. So a list that overshoots does not merely fail to commit — it makes its
+/// own *compensation* unwritable, and the refusal path that exists to release the slot and
+/// evidence the bytes fails with it, stranding exactly the residue it was there to clear.
+pub const MAX_PART_VALUE_BYTES: usize = MAX_VALUE_BYTES / 2;
+
+/// The worst-case encoded bytes of one [`ChunkRef`] under `scheme`, measured rather than
+/// assumed: the placement vector is one D-server id per fragment, so the cost is the EC
+/// **fanout**'s, and [`MAX_CHUNKREF_BYTES`] is only its value for the settled scheme.
+///
+/// The estimate is an upper bound by construction — every field is at its maximum — so a plan
+/// this admits can never encode larger than it predicted.
+pub fn max_chunkref_bytes_for(scheme: EcScheme) -> usize {
+    let fanout = match scheme {
+        EcScheme::None => 1usize,
+        EcScheme::ReedSolomon { k, m } => usize::from(k) + usize::from(m),
+    };
+    metadata::encode(&ChunkRef {
+        id: ChunkId::MAX,
+        scheme,
+        len: u64::MAX,
+        placement: vec![u64::MAX; fanout],
+    })
+    .len()
+}
+
+/// The most chunks a part may hold **under `scheme`** — [`MAX_PART_CHUNKS`] is this quantity for
+/// the settled RS(6,3)/`None` shapes, and a wider scheme legitimately gets a smaller number.
+///
+/// A count ceiling derived from one nominal chunk-ref is only a byte ceiling in disguise
+/// (`0016:1050-1053`), and the EC scheme — hence the placement vector's length — is the
+/// deployment's, not the constant's. Deriving the count from the *scheme's own* worst-case ref is
+/// what keeps "count-legal" and "fits one value" the same statement, for every scheme.
+pub fn max_part_chunks_for(scheme: EcScheme) -> usize {
+    (MAX_PART_VALUE_BYTES / max_chunkref_bytes_for(scheme)).max(1)
+}
+
+/// The most part numbers one session may hold — S3's own limit (`0016:1469`).
+pub const MAX_PARTS_PER_SESSION: u32 = 10_000;
+
+/// The most parts one session may have **in flight**, and therefore the size of its
+/// `slot:<id>:[0, MAX_INFLIGHT_PARTS)` key space (`0016:1471`).
+///
+/// **The key space is the cap** (`D-I`, `0016:305-309`): a start claims one index under
+/// `require_absent`, so no amount of concurrency can create a `MAX_INFLIGHT_PARTS + 1`-th
+/// key. Four clamps bound the value, all asserted by [`knob_clamps_hold`]:
+/// `≤ MAX_PARTS_PER_SESSION` (a session cannot have more parts in flight than it may ever
+/// hold), `≤ ⌊SCAN_CAP / (2·MAX_PART_CHUNKS)⌋` (so the per-session `sidx:` range can never
+/// itself cross the scan cap), `≤ ⌊(E_tx/2) / bytes-per-slot-key⌋` and `≤ B_ops` (the
+/// reaper's idle fence pins one precondition per index and the terminal delete removes
+/// every surviving slot, both in **one** unsplittable batch — X77/X98).
+///
+/// 16 matches the concurrency `aws s3 cp` defaults to, so the everyday client never meets
+/// the backpressure.
+pub const MAX_INFLIGHT_PARTS: u32 = 16;
+
+/// The chunk-refs one session may hold in **committed** `part:` records — the *publishable*
+/// segmented ceiling `MAX_ROOT_SEGMENTS × MAX_SEG_CHUNKS` (`0016:1468`, `D-J`).
+///
+/// Not a free knob: a session may not stage more than it could ever publish, or `U_ref`
+/// charges the raw part-number space (≈19x more than Complete would let that session
+/// publish) and the derived [`Budget::max_sessions`] collapses to ≈1 (`0016:1431-1456`).
+/// Enforced by an [`Refusal::EntityTooLarge`] refusal at **part commit**, read from the
+/// bounded `psum:` summary range, with the overshoot bounded by the in-flight cap.
+pub const MAX_STAGED_CHUNKS: u32 = (MAX_ROOT_SEGMENTS * MAX_SEG_CHUNKS) as u32;
+
+/// The reconcile pass's staged-reference **memory** budget, in chunk-refs — `W_ref`
+/// (`0016:1473`).
+///
+/// **This value is #625's by 0016's assignment and is defined here because
+/// [`Budget::max_sessions`] cannot be derived without it** (`0016:3072-3080`; the brief's
+/// *knob values* section). #625 **consumes** it and must not re-derive it: a split budget
+/// authority admits a permanent failure class — a legally admitted session whose
+/// unsplittable reap fence no longer fits is never reaped.
+///
+/// 4,000,000 chunk-refs is 0016's own worked example (`0016:2128-2130`): ≈36 M
+/// `(server, fragment)` pairs at RS(6,3), a few GB of set on a reconcile host.
+pub const W_REF: u64 = 4_000_000;
+
+/// How many times Complete re-reads the target and retries the root flip before releasing
+/// its fence — `R_publish` (`0016:1476`).
+///
+/// Chosen to be safe with **no reaper running**, which is the state this slice merges into
+/// (0016's *Open questions* 3): on exhaustion Complete releases the fence back to `Open`
+/// itself — it never *waits* for `W_completing`, so a client can retry Complete
+/// immediately without re-uploading a part.
+pub const R_PUBLISH: u32 = 3;
+
+/// How many Complete **fences** one session may spend — `MAX_COMPLETE_ATTEMPTS`
+/// (`0016:1477`).
+///
+/// Each fence mints a new `Completing@E` epoch whose rolled-back segments become one
+/// `retire:records:{seg}` obligation, so an unbounded fence/rollback cycle would let **one**
+/// session install obligations and `seg:` generations without bound — `W_session` alone does
+/// not bound it, because a client can loop faster than the drain. At the cap the fence is
+/// refused ([`Refusal::CompleteAttemptsExhausted`]) and the session's only exit is Abort,
+/// which is reachable with no reaper.
+pub const MAX_COMPLETE_ATTEMPTS: u32 = 3;
+
+/// Attempts a create spends on an **upload-id (or group-nonce) collision** — a 2^-128
+/// event (`0016:493-497`).
+///
+/// **Separate from [`MAX_ADMISSION_CAS_ATTEMPTS`], and that separation is the fix for a
+/// shipped defect**: one shared 4-attempt budget served both this and the *globally
+/// serialized* admission CAS, so the k-th concurrent creator needed O(k) attempts and
+/// ordinary client concurrency (aws-cli defaults to 10) answered a false `503 SlowDown` on
+/// an **empty** store. Two retries, two concerns, two bounds.
+pub const MAX_UPLOAD_ID_ATTEMPTS: u32 = 2;
+
+/// Attempts a create spends losing the **admission CAS** to another creator
+/// (`0016:2031-2034`).
+///
+/// Contention here is expected, not exceptional: `mpuctl` is one record every create CASes
+/// whole, so N simultaneous creators serialize through it and the last one legitimately
+/// needs N attempts. The budget is therefore sized against the concurrency a fleet can
+/// present rather than against "a retry or two", and a lost CAS waits
+/// [`admission_backoff_millis`] before the next attempt so a storm de-synchronizes instead
+/// of colliding in lockstep. Exhausting it is genuine backpressure
+/// ([`Backpressure::AdmissionContention`]).
+pub const MAX_ADMISSION_CAS_ATTEMPTS: u32 = 64;
+
+/// The base of the jittered exponential backoff a lost admission CAS waits, in
+/// milliseconds.
+pub const ADMISSION_BACKOFF_BASE_MILLIS: u64 = 2;
+
+/// The ceiling that backoff is capped at, in milliseconds.
+pub const ADMISSION_BACKOFF_CAP_MILLIS: u64 = 50;
+
+/// The delay a creator waits after losing its `attempt`-th admission CAS: capped
+/// exponential backoff, **fully jittered** in `[0, window]`.
+///
+/// Pure — it reads no clock and performs no sleep, so `core` stays runtime- and
+/// clock-agnostic (ADR-0009) and the schedule is unit-testable. The caller supplies
+/// `jitter` (any value; only its remainder is used) and does the waiting, which is why
+/// [`create_session`] takes a `backoff` hook.
+///
+/// **Full jitter, not "capped exponential plus a little noise".** Creators that lose the
+/// same CAS lost it at the *same instant*, so a deterministic delay re-collides them at the
+/// next attempt and the effective concurrency never drops. Spreading uniformly over the
+/// whole window is what turns O(k) collisions into O(1) expected retries per creator.
+pub fn admission_backoff_millis(attempt: u32, jitter: u64) -> u64 {
+    let window = ADMISSION_BACKOFF_BASE_MILLIS
+        .saturating_mul(1u64 << attempt.min(8))
+        .min(ADMISSION_BACKOFF_CAP_MILLIS);
+    jitter % (window + 1)
+}
+
+/// The budget **profile** that establishes `U_ref` — the tuple stored in `mpuctl` and
+/// compared, whole, by every admitter and by the custodian (`0016:2052-2060`, X76).
+///
+/// Stored rather than derived per process because equal quotients hide unequal footprints:
+/// two hosts can agree on `max_sessions` from different `(W_ref, caps)` pairs, and the one
+/// with the smaller `W_ref` then OOMs building the reference set for sessions admitted under
+/// the larger caps. A process whose local profile differs from the ledger's **refuses to
+/// admit** ([`Refusal::ProfileSkew`]) rather than silently deferring to either value.
+///
+/// **Every clamp is checked at decode** ([`knob_clamps_hold`]), because this value arrives from
+/// the store: `mpuctl` is the one record whose *content* authorizes work, so a torn or forged
+/// profile that decoded as a value would be enforced as one — an oversized
+/// `max_parts_per_session` writes `part:` keys its own parsers reject, an oversized
+/// `max_inflight_parts` builds a terminal-delete batch past the operation envelope, and a
+/// too-small `U_ref` inflates the derived limit past what `W_ref` can hold. A structural
+/// invariant surfaces as an error at decode, never as a value (ADR-0045, `AGENTS.md:146-149`).
+#[derive(Debug, Clone, PartialEq, Eq, Serialize)]
+pub struct Budget {
+    /// The reconcile pass's staged-reference memory budget, in chunk-refs (`W_ref`).
+    pub w_ref: u64,
+    /// The per-`part:`-record chunk ceiling ([`MAX_PART_CHUNKS`]).
+    pub max_part_chunks: u32,
+    /// The per-session part-number space ([`MAX_PARTS_PER_SESSION`]).
+    pub max_parts_per_session: u32,
+    /// The per-session in-flight cap ([`MAX_INFLIGHT_PARTS`]).
+    pub max_inflight_parts: u32,
+    /// The per-session committed-staging ceiling ([`MAX_STAGED_CHUNKS`]).
+    pub max_staged_chunks: u32,
+}
+
+impl Budget {
+    /// The **settled deployment value set** — every knob at the constant above.
+    ///
+    /// `const` so it is a compile-time value the clamp assertions can check.
+    pub const fn deployed() -> Self {
+        Self {
+            w_ref: W_REF,
+            max_part_chunks: MAX_PART_CHUNKS as u32,
+            max_parts_per_session: MAX_PARTS_PER_SESSION,
+            max_inflight_parts: MAX_INFLIGHT_PARTS,
+            max_staged_chunks: MAX_STAGED_CHUNKS,
+        }
+    }
+
+    /// The worst legal **per-session** staged-reference footprint, in chunk-refs
+    /// (`0016:2110-2112`):
+    ///
+    /// ```text
+    /// U_ref = min( (MAX_PARTS_PER_SESSION + MAX_INFLIGHT_PARTS) × MAX_PART_CHUNKS,
+    ///              MAX_STAGED_CHUNKS + 2 × MAX_INFLIGHT_PARTS × MAX_PART_CHUNKS )
+    /// ```
+    ///
+    /// The first term is the raw part-number space; the second is the **enforced** staged
+    /// ceiling plus the bounded commit overshoot plus the in-flight owned entries. Each
+    /// committed part is charged its **full** `MAX_PART_CHUNKS` — charging a part as one
+    /// record under-bounds the in-memory footprint by up to `MAX_PART_CHUNKS×` (the
+    /// iteration-4 defect).
+    pub const fn u_ref(&self) -> u64 {
+        let part_chunks = self.max_part_chunks as u64;
+        let inflight = self.max_inflight_parts as u64;
+        let raw = (self.max_parts_per_session as u64 + inflight) * part_chunks;
+        let ceiling = self.max_staged_chunks as u64 + 2 * inflight * part_chunks;
+        if raw < ceiling {
+            raw
+        } else {
+            ceiling
+        }
+    }
+
+    /// The admission limit — `min(⌊W_ref / U_ref⌋, SCAN_CAP/2)`, **derived, never chosen**
+    /// (`0016:1470`,`:2118-2124`).
+    ///
+    /// The serialized counter enforcing this value bounds the aggregate
+    /// `Σ_sessions(footprint) ≤ MAX_SESSIONS × U_ref ≤ W_ref` **mechanically, for every
+    /// part-size distribution**, because every session is charged its worst-case
+    /// [`Self::u_ref`] — an implementer cannot pick a value from a small-part assumption and
+    /// have a later large-part session overrun the maintenance bound. The `SCAN_CAP/2` term
+    /// is a **clamp the implementation applies**, not a range check left to the operator: a
+    /// legal pairing (large `W_ref`, small parts) can make the quotient exceed `SCAN_CAP`
+    /// and break the reaper's one `scan("mpu:")`.
+    ///
+    /// A hard-coded `MAX_SESSIONS` would be a defect, not a value choice, which is why
+    /// there is no such constant in this module.
+    pub const fn max_sessions(&self) -> u64 {
+        let u_ref = self.u_ref();
+        let derived = match self.w_ref.checked_div(u_ref) {
+            Some(quotient) => quotient,
+            None => 0,
+        };
+        let clamp = (SCAN_CAP / 2) as u64;
+        if derived < clamp {
+            derived
+        } else {
+            clamp
+        }
+    }
+}
+
+impl Default for Budget {
+    fn default() -> Self {
+        Self::deployed()
+    }
+}
+
+impl<'de> Deserialize<'de> for Budget {
+    fn deserialize<D: Deserializer<'de>>(deserializer: D) -> std::result::Result<Self, D::Error> {
+        #[derive(Deserialize)]
+        #[serde(deny_unknown_fields)]
+        struct Raw {
+            w_ref: u64,
+            max_part_chunks: u32,
+            max_parts_per_session: u32,
+            max_inflight_parts: u32,
+            max_staged_chunks: u32,
+        }
+        let raw = Raw::deserialize(deserializer)?;
+        let budget = Self {
+            w_ref: raw.w_ref,
+            max_part_chunks: raw.max_part_chunks,
+            max_parts_per_session: raw.max_parts_per_session,
+            max_inflight_parts: raw.max_inflight_parts,
+            max_staged_chunks: raw.max_staged_chunks,
+        };
+        // The same predicate a deployment asserts its own value set with, applied to the one
+        // that arrives from the store — so "the knobs are legal" is a property of every
+        // `Budget` in the process, not only of the compiled-in one.
+        knob_clamps_hold(&budget).map_err(D::Error::custom)?;
+        Ok(budget)
+    }
+}
+
+/// Whether the settled knob values satisfy every clamp 0016's knob table states — the
+/// bounding invariants, checked rather than commented (`0016:1462-1479`).
+///
+/// A free function, not a test, so the property is part of the API a later slice inherits:
+/// #508 takes these values rather than re-choosing them, and a deployment that retunes one
+/// can assert the set is still legal. Returns the first violation as a message so the
+/// failure names itself.
+pub fn knob_clamps_hold(budget: &Budget) -> std::result::Result<(), String> {
+    let part_chunks = budget.max_part_chunks as usize;
+    if part_chunks == 0 || part_chunks * MAX_CHUNKREF_BYTES > MAX_VALUE_BYTES / 2 {
+        return Err(format!(
+            "MAX_PART_CHUNKS={part_chunks} x {MAX_CHUNKREF_BYTES} B must stay inside V/2 = {} B",
+            MAX_VALUE_BYTES / 2
+        ));
+    }
+    if part_chunks > MAX_BATCH_OPS {
+        return Err(format!(
+            "MAX_PART_CHUNKS={part_chunks} exceeds B_ops={MAX_BATCH_OPS}: a part commit is an \
+             unsplittable batch (0016 X110)"
+        ));
+    }
+    // The key grammar bounds the part-number space before any capacity clamp does: `part:`,
+    // `psum:` and `sidx:` keys are fixed-width [`PART_NUMBER_WIDTH`], so a retune that admitted
+    // `max_parts_per_session >= PART_NUMBER_FORMAT_MAX` would let a legally accepted part number
+    // format a key its own parsers reject ([`parse_part_key`]) — a part whose record can be
+    // written and never read back, which is silent loss rather than a refusal.
+    if budget.max_parts_per_session == 0 || budget.max_parts_per_session >= PART_NUMBER_FORMAT_MAX {
+        return Err(format!(
+            "MAX_PARTS_PER_SESSION={} must be in [1, PART_NUMBER_FORMAT_MAX={}]: a part number \
+             the fixed-width {PART_NUMBER_WIDTH}-digit key grammar cannot spell is unreadable \
+             once written",
+            budget.max_parts_per_session,
+            PART_NUMBER_FORMAT_MAX - 1
+        ));
+    }
+    if budget.max_inflight_parts == 0 || budget.max_inflight_parts > budget.max_parts_per_session {
+        return Err(format!(
+            "MAX_INFLIGHT_PARTS={} must be in [1, MAX_PARTS_PER_SESSION={}]",
+            budget.max_inflight_parts, budget.max_parts_per_session
+        ));
+    }
+    let owned_per_session = budget.max_inflight_parts as usize * part_chunks;
+    if owned_per_session > SCAN_CAP / 2 {
+        return Err(format!(
+            "per-session owned sidx: population {owned_per_session} exceeds SCAN_CAP/2 = {}",
+            SCAN_CAP / 2
+        ));
+    }
+    // The whole-range batch is **not** just the slot deletes: the terminal delete carries
+    // [`TERMINAL_DELETE_FIXED_OPS`] operations besides them, and the reaper's idle fence pins one
+    // precondition per index on top of its own session read. A clamp that compared the slot count
+    // alone with `B_ops` admitted `max_inflight_parts == B_ops`, whose terminal batch is
+    // permanently `TERMINAL_DELETE_FIXED_OPS` operations over the envelope — a session that can
+    // never be torn down, so its admission slot is never returned either.
+    let terminal_ops = budget.max_inflight_parts as usize + TERMINAL_DELETE_FIXED_OPS;
+    if terminal_ops > MAX_BATCH_OPS {
+        return Err(format!(
+            "MAX_INFLIGHT_PARTS={} + {TERMINAL_DELETE_FIXED_OPS} fixed operations is \
+             {terminal_ops}, past B_ops={MAX_BATCH_OPS}: the idle fence pins and the terminal \
+             delete removes the whole range in ONE batch (0016 X77/X98)",
+            budget.max_inflight_parts
+        ));
+    }
+    let slot_batch_bytes = budget.max_inflight_parts as usize * MAX_SLOT_RECORD_BYTES;
+    if slot_batch_bytes > MAX_BATCH_BYTES {
+        return Err(format!(
+            "the whole-range slot batch is {slot_batch_bytes} B, past E_tx/2 = {MAX_BATCH_BYTES} B"
+        ));
+    }
+    if budget.max_staged_chunks < budget.max_part_chunks
+        || budget.max_staged_chunks > MAX_STAGED_CHUNKS
+    {
+        return Err(format!(
+            "MAX_STAGED_CHUNKS={} must be in [MAX_PART_CHUNKS={}, MAX_ROOT_SEGMENTS x \
+             MAX_SEG_CHUNKS={MAX_STAGED_CHUNKS}]",
+            budget.max_staged_chunks, budget.max_part_chunks
+        ));
+    }
+    if budget.max_sessions() == 0 {
+        return Err(format!(
+            "W_ref={} is below one session's U_ref={}: no session could ever be admitted",
+            budget.w_ref,
+            budget.u_ref()
+        ));
+    }
+    Ok(())
+}
+
+/// A generous upper bound on one `slot:` record's encoded key+value bytes, used by the
+/// whole-range clamp in [`knob_clamps_hold`]. The record is a part number, a 32-hex
+/// attempt id and two millisecond stamps.
+const MAX_SLOT_RECORD_BYTES: usize = 256;
+
+/// The most fragment positions one **staged** chunk may name, so that reclaiming its owned
+/// `sidx:` entry always fits ONE batch (`0016:1652-1666`).
+///
+/// The entry is the indivisible unit of [`reclaim_owned`]: its batch carries the session fence,
+/// then `require`+`put` per marked position, then the entry's own `require`+`delete`. So
+/// `2n + 3 ≤ B_ops`, i.e. `n ≤ (B_ops - 3) / 2`. Enforced **before the intent** ([`stage_chunk`])
+/// rather than discovered at teardown, because a chunk whose fanout exceeds this can be staged
+/// but never reclaimed — the drain would re-derive the same over-envelope batch on every attempt
+/// and the session would hold its admission slot for ever.
+///
+/// It is far above any deployable Reed-Solomon width (RS(6,3) needs 9), so it constrains no real
+/// configuration; it exists to make "unreclaimable" unrepresentable rather than to tune anything.
+pub const MAX_STAGED_FRAGMENTS: u32 = ((MAX_BATCH_OPS - 3) / 2) as u32;
+
+/// The operations the terminal session delete carries **besides** its `slot:` deletes
+/// ([`terminal_delete`]): `require(mpu == prior)`, `require(mpuctl == prior)`,
+/// `delete(mpu:<id>)`, `put(mpuctl)`, and — on the unadopted arm — `delete(seggrp:<nonce>)`.
+///
+/// Named and added to the in-flight clamp rather than left implicit, because that batch is
+/// **unsplittable**: it is the exactly-once `mpuctl.count` decrement point, so an
+/// `max_inflight_parts` chosen against `B_ops` alone yields a teardown batch the backend must
+/// reject on every attempt, for ever.
+const TERMINAL_DELETE_FIXED_OPS: usize = 5;
+
+// ===========================================================================
+// 2. Typed answers — every refusal is a value, never "an error"
+// ===========================================================================
+
+/// Why a part list Complete named is invalid (`0016:993-999`).
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum InvalidPart {
+    /// The named part has no `part:` record — it was never committed, or was superseded.
+    Absent,
+    /// The named part's recorded digest is not the one the client named.
+    DigestMismatch,
+    /// The named parts are not in strictly ascending part-number order.
+    OutOfOrder,
+    /// A part number outside `[1, MAX_PARTS_PER_SESSION]`.
+    OutOfRange,
+}
+
+/// Which ceiling produced a `503 SlowDown`-class refusal — the designed backpressure, not a
+/// failure (`0016:129-136`).
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum Backpressure {
+    /// The fleet admission ledger is at its stored `max_sessions` (`0016:1999-2005`).
+    SessionCap {
+        /// The live session count the ledger records.
+        count: u64,
+        /// The limit **the ledger** was checked against (never a local derivation).
+        max_sessions: u64,
+    },
+    /// All `MAX_INFLIGHT_PARTS` slot indices of this session are taken — by live parts, or
+    /// by the residue of parts that crashed mid-stream and never released their slot, which
+    /// is deliberately *counted* rather than invisible (`0016:1742-1747`, F11a).
+    InflightParts {
+        /// The size of the session's slot key space.
+        max_inflight_parts: u32,
+    },
+    /// The create lost the serialized admission CAS this many times (`0016:2031-2034`).
+    AdmissionContention {
+        /// Attempts spent.
+        attempts: u32,
+    },
+    /// Every minted upload id collided with a live session — a 2^-128 event per attempt.
+    UploadIdCollision {
+        /// Attempts spent.
+        attempts: u32,
+    },
+}
+
+/// A **typed** protocol answer other than success. #508 maps each to its S3 status and
+/// code; this slice pins the answers, never the wire spelling (`0016:969-978`).
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum Refusal {
+    /// No session can serve this request: the upload id is unknown, aborted, already
+    /// completed with a **different** assembly, or its record is gone.
+    NoSuchUpload,
+    /// The target bucket has no `bucket:` record (ADR-0046 §4).
+    NoSuchBucket,
+    /// The session is fenced into `Completing` by a publisher that still owns it. There is
+    /// no client path that resumes a `Completing` session (`0016:980-986`).
+    OperationAborted,
+    /// The named part list does not match the frozen part set. The fence is **released**
+    /// before this is returned, so a client typo never wedges a session (`0016:1032`).
+    InvalidPart {
+        /// The offending part number.
+        part_number: u32,
+        /// What was wrong with it.
+        reason: InvalidPart,
+    },
+    /// A part, or the session's cumulative staged chunks, is past a ceiling the protocol
+    /// enforces by **refusal** rather than by an over-envelope commit (`0016:1409-1430`).
+    /// The session stays usable and abortable, and anything already staged is compensated.
+    EntityTooLarge {
+        /// The chunk count the request would have installed.
+        chunks: u64,
+        /// The ceiling it crossed.
+        limit: u64,
+    },
+    /// The part's **encoded `part:` value** would cross the backend's value ceiling even though
+    /// its chunk *count* is legal — the placement vector of a wide EC scheme costs more than the
+    /// [`MAX_CHUNKREF_BYTES`] the count ceiling is derived from. Same class as
+    /// [`Self::EntityTooLarge`] and the same guarantee: the staged residue is compensated and
+    /// the session stays usable, rather than the over-`V` commit being discovered at the backend
+    /// (`0016:1500`). Reported separately because the actionable number is a **byte** size, and
+    /// a byte overrun stated as a chunk count would send #508's wire layer looking for a chunk
+    /// ceiling the request never crossed.
+    PartValueTooLarge {
+        /// The encoded size the record would have had.
+        bytes: usize,
+        /// The ceiling it crossed.
+        limit: usize,
+    },
+    /// Designed backpressure.
+    SlowDown {
+        /// Which ceiling engaged.
+        pressure: Backpressure,
+    },
+    /// This process's [`Budget`] disagrees with the one stored in `mpuctl`, so it **refuses
+    /// to admit and alarms** rather than silently deferring to either value — a fail-closed
+    /// configuration-skew signal (`0016:2071-2078`, X99).
+    ProfileSkew {
+        /// What this process derives from its own configuration.
+        local: Box<Budget>,
+        /// What the ledger records.
+        ledger: Box<Budget>,
+    },
+    /// The session has spent all [`MAX_COMPLETE_ATTEMPTS`] fences; its only exit is Abort
+    /// (`0016:1477`).
+    CompleteAttemptsExhausted,
+}
+
+/// What [`create_session`] answered.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum CreateOutcome {
+    /// A session record and its `seggrp:` reservation are durable, and the admission
+    /// counter has been incremented exactly once.
+    Created(Box<SessionSnapshot>),
+    /// A typed refusal.
+    Refused(Refusal),
+}
+
+/// What [`reserve_slot`] answered.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum ReserveOutcome {
+    /// An in-flight slot index is held by this attempt.
+    Reserved(Box<PartUpload>),
+    /// A typed refusal.
+    Refused(Refusal),
+}
+
+/// What [`commit_part`] (and therefore [`upload_part`]) answered.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum UploadPartOutcome {
+    /// The part is durable: its `part:` + `psum:` records exist, its slot is released, and
+    /// its owned `sidx:` entries are gone — all in one batch.
+    Committed {
+        /// The part number.
+        part_number: u32,
+        /// Its content digest, lowercase hex SHA-256.
+        digest: String,
+    },
+    /// A typed refusal. Anything this attempt staged has been **compensated** (its bytes
+    /// carry a `retire:bytes:{chunks}` obligation, its slot is released and its `sidx:`
+    /// entries are deleted) whenever the session was still live enough to own the cleanup
+    /// (`0016:1418-1430`, X85).
+    Refused(Refusal),
+}
+
+/// What [`complete`] answered.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum CompleteOutcome {
+    /// The object is published: this call's flip won.
+    Published(Box<Publication>),
+    /// A `Completed` tombstone answered an **identical** retry inside its window, with the
+    /// **recorded** ETag (`0016:898-908`).
+    AlreadyCompleted(Box<Publication>),
+    /// A typed refusal; nothing was published and the session is not left fenced.
+    Refused(Refusal),
+}
+
+/// What a winning (or recorded) publication established.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Publication {
+    /// The inode the object key resolves to.
+    pub inode: InodeId,
+    /// The version the flip recorded — `prior.version + 1` computed from the **re-read**
+    /// prior at that attempt, never a fence-frozen number (`0016:925-932`).
+    pub version: u64,
+    /// The composed multipart ETag ([`multipart_etag`]).
+    pub etag: String,
+    /// The publication instant.
+    pub completed_at_millis: u64,
+}
+
+/// What [`abort`] answered.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum AbortOutcome {
+    /// The fence landed: the session is `Aborting` and its teardown obligation is durable.
+    /// **This is the response** — byte reclamation is the drain's, asynchronously
+    /// (`0016:1000-1003`, F9), so the admission counter is deliberately *unchanged* here.
+    Fenced,
+    /// The session was already `Aborting` — idempotent success (`0016:976`).
+    AlreadyAborting,
+    /// A typed refusal.
+    Refused(Refusal),
+}
+
+// ===========================================================================
+// 3. The records
+// ===========================================================================
+
+/// The singleton **admission ledger**, `mpuctl` (`0016:348`).
+///
+/// One record, three fields, CAS'd **whole** — so the count and the limit it was checked
+/// against can never be read apart. `count` is the number of `mpu:` records that exist **in
+/// any state**, tombstones included, and it is decremented only in the terminal
+/// session-delete batch.
+///
+/// **`max_sessions` is checked against the profile at decode**, because it is *derived*
+/// (`⌊W_ref / U_ref⌋`, clamped) and never independently chosen ([`Budget::max_sessions`],
+/// `0016:1470`,`:2118-2124`). Admission enforces the **stored** limit — deliberately, so every
+/// admitter in the fleet agrees on one number — which is exactly why the stored number may not
+/// be free: a torn or forged `mpuctl` naming a larger `max_sessions` than its own profile
+/// derives would be trusted by every host, and `Σ_sessions(U_ref) ≤ W_ref` (the bound the whole
+/// reconcile pass is sized for) would be exceeded on hosts that never observe the overrun. The
+/// relation between the two fields is a structural invariant of this record class, so it
+/// surfaces as an error at decode rather than as an admitted value (ADR-0045,
+/// `AGENTS.md:146-149`).
+#[derive(Debug, Clone, PartialEq, Eq, Serialize)]
+pub struct AdmissionRecord {
+    /// How many `mpu:` records exist, in any state.
+    pub count: u64,
+    /// The governing limit those increments were admitted against.
+    pub max_sessions: u64,
+    /// The budget tuple that establishes `max_sessions`.
+    pub profile: Budget,
+}
+
+impl<'de> Deserialize<'de> for AdmissionRecord {
+    fn deserialize<D: Deserializer<'de>>(deserializer: D) -> std::result::Result<Self, D::Error> {
+        #[derive(Deserialize)]
+        #[serde(deny_unknown_fields)]
+        struct Raw {
+            count: u64,
+            max_sessions: u64,
+            // Its own clamps are checked by `Budget`'s decode, so this arm only owes the
+            // *relation* between the two fields.
+            profile: Budget,
+        }
+        let raw = Raw::deserialize(deserializer)?;
+        let derived = raw.profile.max_sessions();
+        if raw.max_sessions != derived {
+            return Err(D::Error::custom(format!(
+                "mpuctl records max_sessions={} but its own profile derives {derived} \
+                 (U_ref={}, W_ref={}): the stored limit is derived, never chosen",
+                raw.max_sessions,
+                raw.profile.u_ref(),
+                raw.profile.w_ref,
+            )));
+        }
+        Ok(Self {
+            count: raw.count,
+            max_sessions: raw.max_sessions,
+            profile: raw.profile,
+        })
+    }
+}
+
+/// A session's lifecycle state (`0016:528-553`).
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]
+pub enum SessionState {
+    /// Accepting parts.
+    Open,
+    /// Fenced by a Complete that owns publication.
+    Completing,
+    /// Fenced for teardown; its `retire:bytes:{session}` obligation is installed.
+    Aborting,
+    /// Published. A **tombstone** that still answers an identical retry, still holds an
+    /// `mpu:` record, and is therefore **still counted** by the admission counter until its
+    /// terminal delete (`0016:964-968`).
+    Completed,
+}
+
+/// The dirent identity a `Completing` session publishes to, plus the fence epoch that owns
+/// the attempt (`0016:350`).
+///
+/// **The key, never a frozen inode id**: an inode id is minted per create and both keys are
+/// `require_absent`-guarded, so a concurrent delete-and-recreate of the same object key
+/// rebinds it to a *different* inode, and a flip reusing a frozen id would address a deleted
+/// generation. Each flip attempt therefore re-resolves the dirent.
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+pub struct PublishTarget {
+    /// The parent inode the object name lives under.
+    pub parent: InodeId,
+    /// The object name.
+    pub name: String,
+    /// The `Completing` fence epoch, so a resumed completer writes the same deterministic
+    /// segment-group range.
+    pub fence_epoch: u64,
+}
+
+/// What a `Completed` session recorded (`0016:350`).
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+pub struct Completion {
+    /// The published inode.
+    pub inode: InodeId,
+    /// The published version.
+    pub version: u64,
+    /// The composed ETag.
+    pub etag: String,
+    /// The publication instant.
+    pub completed_at_millis: u64,
+    /// A digest over the **ordered** `(part_number, digest)` list the winning Complete
+    /// named ([`complete_fingerprint`]).
+    ///
+    /// Idempotence is keyed on **request identity**, not on the upload id alone: a client
+    /// reusing the id with a *different* part list would otherwise be told *its* assembly
+    /// succeeded while the stored object holds the earlier one — a silent wrong answer,
+    /// worse than any error (`0016:898-908`, X81).
+    pub complete_fingerprint: String,
+}
+
+/// One multipart upload session — the record every transition compare-and-sets on its
+/// **exact bytes** (`0016:350`,`:555-566`).
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+pub struct SessionRecord {
+    /// The target bucket.
+    pub bucket: String,
+    /// The parent inode the object name lives under.
+    pub parent: InodeId,
+    /// The object name.
+    pub object: String,
+    /// The declared content type, stamped at publication (ADR-0047).
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub content_type: Option<String>,
+    /// When the session was initiated — the instant `W_session` is measured from (#625).
+    pub created_at_millis: u64,
+    /// Which clock produced every session-scoped stamp. The reaper compares it with its own
+    /// and **declines to judge** a session it does not recognise (`0016:1990-1998`, F10);
+    /// this slice records it and refuses a write whose source disagrees (X106).
+    pub clock_source: String,
+    /// The lifecycle state.
+    pub state: SessionState,
+    /// A monotone counter bumped by every fence, so two successive states are textually
+    /// distinct even when nothing else changes.
+    pub epoch: u64,
+    /// Complete fences spent, capped at [`MAX_COMPLETE_ATTEMPTS`].
+    pub attempts: u32,
+    /// The **segment-group nonce**, minted with the session and independent of its id
+    /// because the `seg:` records it keys **outlive the `mpu:` tombstone** that would
+    /// otherwise be their only reuse guard (`0016:499-527`, X105).
+    pub group_nonce: String,
+    /// When the session fenced into `Completing` — the instant `W_completing` is measured
+    /// from (`0016:1004-1008`). `Completing`-only.
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub fenced_at_millis: Option<u64>,
+    /// The segment-write cursor of the current attempt. `Completing`-only.
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub segments_written: Option<u32>,
+    /// The dirent identity and fence epoch of the current attempt. `Completing`-only.
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub publish_target: Option<PublishTarget>,
+    /// What the winning flip recorded. `Completed`-only.
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub completion: Option<Completion>,
+}
+
+/// One **in-flight part slot** — `slot:<upload-id>:<index>` (`0016:349`).
+///
+/// The stamp records when the slot was claimed, so a request is observably alive from the
+/// instant it reserves, *before* it has written a byte; the lease is renewed in flight by
+/// the same loop that renews the owned `sidx:` leases, **in the same batch**, which is the
+/// atomicity the reaper's fence pin rests on (X74/X83).
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+pub struct SlotRecord {
+    /// The part number this attempt is uploading.
+    pub part_number: u32,
+    /// A per-attempt token, so an **ambiguous** reserve is settled by re-reading rather
+    /// than by re-reserving a different index (`0016:1697-1717`, X68).
+    pub attempt_id: String,
+    /// When the slot was claimed.
+    pub reserved_at_millis: u64,
+    /// The slot's liveness lease.
+    pub lease_expiry_millis: u64,
+}
+
+/// A committed part — `part:<upload-id>:<part-number>` (`0016:351`).
+///
+/// **`len` is checked against the chunk list at decode**, the same size-vs-table invariant
+/// [`metadata::SegmentedMap`] enforces on a published root and for the same reason: the two
+/// state the *same* fact, and Complete uses one (`len`, summed into the published `size`) while
+/// the read path uses the other (the chunks it actually reads). A record whose halves disagree
+/// therefore publishes an object whose declared size is not the number of bytes a reader can
+/// get — a silent wrong answer at `HeadObject`/`GetObject`, and a `Content-Length` a range read
+/// cannot satisfy. Structural, so it is an error at decode, never a value (ADR-0045,
+/// `AGENTS.md:146-149`).
+#[derive(Debug, Clone, PartialEq, Eq, Serialize)]
+pub struct PartRecord {
+    /// The part's chunk list, in object order.
+    pub chunks: Vec<ChunkRef>,
+    /// The part's length in bytes.
+    pub len: u64,
+    /// The part's content digest, lowercase hex SHA-256.
+    pub digest: String,
+    /// When the part committed.
+    pub committed_at_millis: u64,
+    /// The session epoch the commit was fenced on.
+    pub session_epoch: u64,
+}
+
+impl<'de> Deserialize<'de> for PartRecord {
+    fn deserialize<D: Deserializer<'de>>(deserializer: D) -> std::result::Result<Self, D::Error> {
+        #[derive(Deserialize)]
+        #[serde(deny_unknown_fields)]
+        struct Raw {
+            chunks: Vec<ChunkRef>,
+            len: u64,
+            digest: String,
+            committed_at_millis: u64,
+            session_epoch: u64,
+        }
+        let raw = Raw::deserialize(deserializer)?;
+        let span: u64 = raw.chunks.iter().map(|chunk| chunk.len).sum();
+        if span != raw.len {
+            return Err(D::Error::custom(format!(
+                "part record declares len={} but its {} chunk(s) span {span} B",
+                raw.len,
+                raw.chunks.len()
+            )));
+        }
+        Ok(Self {
+            chunks: raw.chunks,
+            len: raw.len,
+            digest: raw.digest,
+            committed_at_millis: raw.committed_at_millis,
+            session_epoch: raw.session_epoch,
+        })
+    }
+}
+
+/// A committed part's **summary** — `psum:<upload-id>:<part-number>`, written in the same
+/// batch as the `part:` record it summarizes (`0016:352`).
+///
+/// Everything about a part except its chunk list, so the cumulative staged-chunk check and
+/// `ListParts` read tens of bytes per part instead of the fat lists.
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+pub struct PartSummary {
+    /// How many chunks the part holds.
+    pub chunks: u32,
+    /// The part's length in bytes.
+    pub len: u64,
+    /// The part's content digest.
+    pub digest: String,
+    /// When the part committed.
+    pub committed_at_millis: u64,
+}
+
+// ===========================================================================
+// 4. Keys and their parsers — structural validity at decode, never defaulted
+// ===========================================================================
+
+/// The singleton admission-ledger key (`0016:348`). Never deleted; an **absent** record
+/// reads as `{count: 0}` and the first create initializes it under `require_absent`, so the
+/// counter is self-bootstrapping with no migration step.
+pub const MPUCTL_KEY: &[u8] = b"mpuctl";
+
+/// Key prefix for session records.
+pub const MPU_PREFIX: &[u8] = b"mpu:";
+/// Key prefix for in-flight part slots.
+pub const SLOT_PREFIX: &[u8] = b"slot:";
+/// Key prefix for committed part records.
+pub const PART_PREFIX: &[u8] = b"part:";
+/// Key prefix for committed part summaries.
+pub const PSUM_PREFIX: &[u8] = b"psum:";
+/// Key prefix for owned staging entries — **disjoint from `pending:`**, which is the whole
+/// point (`0016:1529-1536`).
+pub const SIDX_PREFIX: &[u8] = b"sidx:";
+
+/// The decimal width a `slot:` key's index is zero-padded to, so byte-lexicographic key
+/// order equals index order.
+pub const SLOT_INDEX_WIDTH: usize = 6;
+
+/// The **format** maximum for a slot index — a compile-time constant of the *encoding*,
+/// changed only by a versioned format change.
+///
+/// Deliberately **not** the live [`MAX_INFLIGHT_PARTS`] (`0016:390-402`): the knob is
+/// mutable and 0016 permits lowering it, so a decode that enforced the *current* value would
+/// stop decoding live slots the moment the knob dropped — and those records would become
+/// unreadable exactly when the teardown path needs to read them. The current knob is
+/// enforced where new work is *admitted* ([`reserve_slot`]), not at decode.
+pub const SLOT_INDEX_FORMAT_MAX: u32 = 1_000_000;
+
+// The part-number grammar constants ([`PART_NUMBER_WIDTH`], [`PART_NUMBER_FORMAT_MAX`]) are
+// re-exported from [`crate::metadata`] above, for the reason [`SLOT_INDEX_FORMAT_MAX`] states
+// and one more: `PartNumberSet` — a field of that layer's retirement obligations — validates
+// its runs against the same grammar at decode, so a second spelling here could drift from the
+// one the record class enforces.
+
+/// A structural violation of a multipart key or value. Every variant is an **error**, never
+/// a silently-corrected default (ADR-0045, `AGENTS.md:146-149`; `0016:390-414`).
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum RecordError {
+    /// A token that is not exactly 32 lowercase-hex characters — it would key a range no
+    /// writer can reproduce.
+    TokenNotHex {
+        /// What was wrong with it, for the operator signal.
+        token: String,
+    },
+    /// A key whose prefix, field count or field syntax does not parse.
+    MalformedKey {
+        /// The namespace expected.
+        namespace: &'static str,
+        /// The key as UTF-8 (lossy), for the operator signal.
+        key: String,
+    },
+    /// A slot index outside `[0, SLOT_INDEX_FORMAT_MAX)`, or not fixed-width.
+    SlotIndexOutOfRange {
+        /// The index found.
+        index: u64,
+    },
+    /// A part number outside `[1, PART_NUMBER_FORMAT_MAX)`, or not fixed-width.
+    PartNumberOutOfRange {
+        /// The number found.
+        part_number: u64,
+    },
+    /// A `retire:` key whose mode prefix is neither `bytes` nor `records` (`0016:434-440`).
+    UnknownRetireMode {
+        /// The mode as read.
+        mode: String,
+    },
+    /// A session value carrying a field its state forbids (a `Completing`-only
+    /// `fenced_at_millis` on an `Open` session, `0016:404-408`).
+    FieldForbiddenByState {
+        /// The state the record declares.
+        state: SessionState,
+        /// The field that may not be present in it.
+        field: &'static str,
+    },
+    /// A session value **missing** a field its state requires — a `Completing` session with no
+    /// fence stamp, publication target or segment cursor, or a `Completed` one with no
+    /// publication. Half of the state's meaning is in those fields, so admitting the record as
+    /// a *value* would let a consumer act on a session it does not actually understand
+    /// (`0016:390-414`).
+    FieldRequiredByState {
+        /// The state the record declares.
+        state: SessionState,
+        /// The field that state cannot be without.
+        field: &'static str,
+    },
+    /// An owned `sidx:` entry whose `owner`/`staged` fields do not make it the record class
+    /// `0016:353` defines — absent, or naming another session. The `staged` placement is the
+    /// only source of the `orphan:` keys its bytes need, so a reclamation walk must not delete
+    /// it (see `reclaim_owned`).
+    OwnedEntryMalformed {
+        /// The entry's key, for the operator signal.
+        key: String,
+    },
+    /// The admission ledger is absent while a session record exists — impossible for a
+    /// conforming store, since the create that wrote the session wrote the counter in the
+    /// **same** batch.
+    ///
+    /// Surfaced from both sides of the session's life. At the **teardown** it is answered here
+    /// rather than as `Ok(false)`: the caller would loop for ever on a gate that can never open,
+    /// and fabricating a `{count: 0}` to decrement would corrupt the bound admission rests on. At
+    /// the **reserve** it is answered here rather than admitting the part: staging bytes against
+    /// an admission state that bounds nothing is what the counter exists to prevent.
+    AdmissionLedgerMissing {
+        /// The session whose reserve or teardown found it missing.
+        upload_id: String,
+    },
+    /// The admission ledger's `count` is zero while a session record still exists — the same
+    /// torn store as [`Self::AdmissionLedgerMissing`], seen from the other side. The counter
+    /// counts **every** `mpu:` record in any state (`0016:348`,`:2029-2031`), so a zero count
+    /// under a live record means a decrement has already run for it: a saturating "decrement"
+    /// here would report an event that never happened and leave the fleet's admission bound
+    /// silently under-counting live sessions.
+    AdmissionLedgerTorn {
+        /// The session whose terminal delete found the counter at zero.
+        upload_id: String,
+    },
+    /// A post-staging refusal whose compensation never landed: the session stayed `Open` at ever
+    /// newer epochs for the whole bounded chase, so this attempt's slot, owned entries and
+    /// staged bytes are still there. Reported rather than answered as a clean refusal — nothing
+    /// walks an `Open` session's `sidx:` range, so "deferred to the teardown" would be false
+    /// (`0016:1418-1430`).
+    CompensationUnlanded {
+        /// The session.
+        upload_id: String,
+        /// The part whose residue is still present.
+        part_number: u32,
+    },
+    /// A clock source that disagrees with the one the session was stamped under (X106,
+    /// `0016:1990-1998`; `AGENTS.md:131-142`, *one clock per correctness lifecycle*). Mixing a
+    /// logical and a wall clock inside one session's stamps is the #557/#565 defect class: a
+    /// lease written under one epoch and judged under another expires at an unrelated instant.
+    ClockSourceSkew {
+        /// The source the session record names.
+        session: String,
+        /// The source this caller offered.
+        local: String,
+    },
+    /// A value that would not fit the backend's value ceiling — refused at the **write**
+    /// boundary rather than committed as a record no later decode can read.
+    ValueOverCeiling {
+        /// The encoded size.
+        bytes: usize,
+        /// The ceiling.
+        limit: usize,
+    },
+    /// One owned `sidx:` entry's reclamation — its full placement's orphan marks plus its own
+    /// `require`+`delete`, under the session fence — does not fit the drain budget *on its own*.
+    /// The entry is the indivisible unit of that walk, so committing it anyway would hand the
+    /// backend a batch it must reject on every retry: a teardown that can never progress, hence
+    /// an admission slot that is never returned. Surfaced instead.
+    OwnedEntryOverBudget {
+        /// The entry's key, for the operator signal.
+        key: String,
+        /// The operations its batch would carry.
+        ops: usize,
+        /// The bytes its batch would carry.
+        bytes: usize,
+        /// The operation budget it crossed.
+        max_ops: usize,
+        /// The byte budget it crossed.
+        max_bytes: usize,
+    },
+    /// A staged chunk whose EC scheme names more fragment positions than one reclamation batch
+    /// can evidence ([`MAX_STAGED_FRAGMENTS`]) — refused **before** the intent, so no entry the
+    /// teardown could not reclaim is ever created.
+    StagedFanoutOverBudget {
+        /// The fragment positions the scheme names.
+        fragments: u32,
+        /// The ceiling.
+        limit: u32,
+    },
+    /// One more staged chunk would push this part's chunk list past [`MAX_PART_VALUE_BYTES`] —
+    /// refused **before** the intent, because both records that could ever carry that list (the
+    /// `part:` record and the obligation evidencing its chunks) are single values.
+    StagedPartOverValueBudget {
+        /// The bytes the list would have occupied.
+        bytes: usize,
+        /// The ceiling.
+        limit: usize,
+    },
+    /// A [`Budget`] that violates one of [`knob_clamps_hold`]'s bounding invariants, offered
+    /// where it would become the fleet's stored profile. Refused rather than admitted: the
+    /// ledger's own decode applies the same predicate, so admitting one here would write a
+    /// record the fleet can no longer read.
+    BudgetIllegal {
+        /// The first clamp it violated.
+        why: String,
+    },
+}
+
+impl std::fmt::Display for RecordError {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        match self {
+            Self::TokenNotHex { token } => write!(
+                f,
+                "multipart token {token:?} is not 32 lowercase-hex characters (128-bit token)"
+            ),
+            Self::MalformedKey { namespace, key } => {
+                write!(f, "malformed {namespace} key {key:?}")
+            }
+            Self::SlotIndexOutOfRange { index } => write!(
+                f,
+                "slot index {index} is outside the format bound [0, {SLOT_INDEX_FORMAT_MAX})"
+            ),
+            Self::PartNumberOutOfRange { part_number } => write!(
+                f,
+                "part number {part_number} is outside the format bound [1, \
+                 {PART_NUMBER_FORMAT_MAX})"
+            ),
+            Self::UnknownRetireMode { mode } => write!(
+                f,
+                "retire: key mode {mode:?} is neither `bytes` nor `records`"
+            ),
+            Self::FieldForbiddenByState { state, field } => {
+                write!(f, "session in {state:?} may not carry the field `{field}`")
+            }
+            Self::FieldRequiredByState { state, field } => {
+                write!(f, "session in {state:?} must carry the field `{field}`")
+            }
+            Self::OwnedEntryMalformed { key } => write!(
+                f,
+                "owned staging entry {key:?} lacks the `owner`/`staged` fields its record class \
+                 requires"
+            ),
+            Self::AdmissionLedgerMissing { upload_id } => write!(
+                f,
+                "the mpuctl admission ledger is absent while session {upload_id} exists (torn \
+                 store: the create wrote both in one batch)"
+            ),
+            Self::AdmissionLedgerTorn { upload_id } => write!(
+                f,
+                "the mpuctl admission count is 0 while session {upload_id} still exists: its \
+                 decrement has already run, so this terminal delete would double-count it"
+            ),
+            Self::CompensationUnlanded {
+                upload_id,
+                part_number,
+            } => write!(
+                f,
+                "part {part_number} of session {upload_id} was refused but its compensation \
+                 never landed: the slot, its owned entries and its staged bytes are still present"
+            ),
+            Self::ClockSourceSkew { session, local } => write!(
+                f,
+                "session is stamped under clock source {session:?}, refusing a write stamped \
+                 under {local:?}"
+            ),
+            Self::ValueOverCeiling { bytes, limit } => write!(
+                f,
+                "record value is {bytes} B, past the {limit} B backend value ceiling"
+            ),
+            Self::OwnedEntryOverBudget {
+                key,
+                ops,
+                bytes,
+                max_ops,
+                max_bytes,
+            } => write!(
+                f,
+                "reclaiming owned entry {key:?} alone needs {ops} operations / {bytes} B, past \
+                 the drain budget of {max_ops} / {max_bytes} B: that batch could never commit"
+            ),
+            Self::StagedFanoutOverBudget { fragments, limit } => write!(
+                f,
+                "a staged chunk with {fragments} fragment positions cannot be reclaimed in one \
+                 batch (limit {limit}): its intent is refused rather than written"
+            ),
+            Self::StagedPartOverValueBudget { bytes, limit } => write!(
+                f,
+                "one more staged chunk would take this part's chunk list to {bytes} B, past the \
+                 {limit} B a part record (and its retirement obligation) may occupy"
+            ),
+            Self::BudgetIllegal { why } => {
+                write!(f, "the offered admission budget is not legal: {why}")
+            }
+        }
+    }
+}
