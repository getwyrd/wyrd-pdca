--- /dev/null
+++ b/crates/core/tests/multipart_protocol.rs
@@ -0,0 +1,4344 @@
+//! The multipart commit protocol, crate-level over in-memory trait stores (issue #636,
+//! proposal 0016 `docs/design/proposals/draft/0016-multipart-commit-protocol.md`).
+//!
+//! **No gateway.** The caller here is the test instead of the S3 handler; everything the test
+//! drives is production — the real `wyrd_core::multipart` verbs over a real `MetadataStore`
+//! and a real placement-aware `ChunkStore`. That is deliberate (#508 exposes these functions
+//! over the wire, #637 teaches the maintenance plane about the staged bytes, #625 drives the
+//! states whose only exit is the reaper), and it is why the assertions below reach past the
+//! caller's return value into **durable store state**: an implementation that satisfies the
+//! caller while leaving residue fails.
+//!
+//! The legs, each an item of the slice's success criterion:
+//!
+//! * **A — the happy path is exact.** Create, stage parts **out of order** with a non-final
+//!   part that is not a whole multiple of the chunk size, Complete: the object reads back
+//!   **byte-identical** to the parts concatenated in part-number order. Asserted on the
+//!   *bytes*, never a chunk count — multipart chunking follows **part** boundaries, so a
+//!   correct implementation legitimately yields a different chunk count from a plain PUT of
+//!   the same bytes.
+//! * **B — the ETag is the settled pure function**, and the subset case needs **bytes and
+//!   evidence**, not just an ETag: `0016:1033`'s own oracle.
+//! * **C — decision 3's answer table, cell by cell**, each as a **typed** outcome.
+//! * **D — the staging class is the disjoint owned one, observed WHILE the part is in
+//!   flight** (a post-hoc scan alone proves nothing).
+//! * **E — admission is exact and bounded, and a `Completed` tombstone STAYS COUNTED.**
+//! * **H — after the terminal delete, nothing is left.**
+//! * **H2 — the no-gap classification invariant after every scenario** (the one shared helper
+//!   0016 earns, `multipart::classification_sweep`).
+//!
+//! Legs F (concurrent create) and G (drain convergence) live in
+//! `multipart_admission_and_drain.rs` — their own binary, so a `tracing` callsite-cache
+//! interaction in one cannot mask the other (the #214 discipline).
+
+#![forbid(unsafe_code)]
+
+use std::collections::{BTreeMap, BTreeSet, HashMap};
+use std::sync::Mutex;
+
+use async_trait::async_trait;
+use bytes::Bytes;
+use sha2::{Digest, Sha256};
+use wyrd_core::metadata::{self, EcScheme, PendingEntry};
+use wyrd_core::multipart::{
+    self as mpu, AbortOutcome, Backpressure, Budget, CompleteOutcome, CompleteParams,
+    CreateOutcome, CreateParams, CreateRetry, DrainBudget, InvalidPart, Refusal, SessionState,
+    UploadPartOutcome,
+};
+use wyrd_core::{placement::Topology, read};
+use wyrd_traits::{
+    ChunkId, ChunkStore, CommitOutcome, DServerId, FragmentId, Health, MetadataStore, Result,
+    WriteBatch,
+};
+
+// ---------------------------------------------------------------------------
+// The in-memory harness (the `crates/custodian/tests/gc.rs:26-120` shape)
+// ---------------------------------------------------------------------------
+
+/// Rows a rival writer lands, and how many commits to let past first.
+type InjectedRows = (usize, Vec<(Vec<u8>, Bytes)>);
+
+/// A trivial in-memory metadata store.
+#[derive(Default)]
+struct MemMeta {
+    kv: Mutex<HashMap<Vec<u8>, Bytes>>,
+    /// Rows another writer's batch lands in the window immediately before a commit this store
+    /// applies, after skipping `n` of them (see [`MemMeta::inject_before_next_commit`]).
+    injected: Mutex<Option<InjectedRows>>,
+    /// A session whose `epoch` another writer advances immediately before **every** commit —
+    /// the X108 rollback, arriving faster than a compensating attempt can land
+    /// (see [`MemMeta::rebase_session_before_every_commit`]).
+    rebase: Mutex<Option<String>>,
+    /// How many further commits answer [`CommitUnknownResult`], and whether they nevertheless
+    /// **apply** (see [`MemMeta::unknown_result_on_next_commit`]).
+    unknown: Mutex<Option<(usize, bool)>>,
+    /// A key prefix whose reads fail outright once `skip` further commits have been observed —
+    /// the store that cannot answer the settling re-read an indeterminate commit needs (see
+    /// [`MemMeta::fail_reads_of`]).
+    unreadable: Mutex<Option<(usize, Vec<u8>)>>,
+}
+
+#[async_trait]
+impl MetadataStore for MemMeta {
+    async fn get(&self, key: &[u8]) -> Result<Option<Bytes>> {
+        if let Some((0, prefix)) = self.unreadable.lock().unwrap().as_ref() {
+            if key.starts_with(prefix.as_slice()) {
+                return Err("injected read failure".into());
+            }
+        }
+        Ok(self.kv.lock().unwrap().get(key).cloned())
+    }
+
+    async fn scan(&self, prefix: &[u8]) -> Result<Vec<(Vec<u8>, Bytes)>> {
+        let mut rows: Vec<(Vec<u8>, Bytes)> = self
+            .kv
+            .lock()
+            .unwrap()
+            .iter()
+            .filter(|(k, _)| k.starts_with(prefix))
+            .map(|(k, v)| (k.clone(), v.clone()))
+            .collect();
+        rows.sort_by(|a, b| a.0.cmp(&b.0));
+        Ok(rows)
+    }
+
+    async fn scan_page(
+        &self,
+        prefix: &[u8],
+        after: Option<&[u8]>,
+        limit: usize,
+    ) -> Result<wyrd_traits::ScanPage> {
+        wyrd_testkit::test_double_scan_page(self, prefix, after, limit).await
+    }
+
+    async fn commit(&self, batch: WriteBatch) -> Result<CommitOutcome> {
+        let mut kv = self.kv.lock().unwrap();
+        // Another writer's batch, landing in the window between this caller's reads and its own
+        // commit — applied before the preconditions are evaluated, exactly as a real store would
+        // have applied it before this transaction was admitted. `skip` picks *which* commit it
+        // lands before, so a test can aim it at a specific step of a multi-commit verb.
+        {
+            let mut slot = self.injected.lock().unwrap();
+            if let Some((skip, rows)) = slot.as_mut() {
+                if *skip == 0 {
+                    for (key, value) in std::mem::take(rows) {
+                        kv.insert(key, value);
+                    }
+                    *slot = None;
+                } else {
+                    *skip -= 1;
+                }
+            }
+        }
+        // A read failure armed for a *later* step of a multi-commit verb counts this commit down.
+        if let Some((skip, _)) = self.unreadable.lock().unwrap().as_mut() {
+            *skip = skip.saturating_sub(1);
+        }
+        // A rival Complete that fences and rolls the session back, again, in that same window.
+        if let Some(upload_id) = self.rebase.lock().unwrap().clone() {
+            let key = mpu::mpu_key(&upload_id);
+            if let Some(bytes) = kv.get(&key).cloned() {
+                let record: mpu::SessionRecord = metadata::decode(&bytes).unwrap();
+                let rolled = mpu::SessionRecord {
+                    epoch: record.epoch + 1,
+                    ..record
+                };
+                kv.insert(key, metadata::encode(&rolled));
+            }
+        }
+        // An **unknown result**: the batch may or may not have been applied, and the store
+        // cannot say. `applies` picks which of the two really happened.
+        let unknown = {
+            let mut slot = self.unknown.lock().unwrap();
+            match slot.as_mut() {
+                Some((remaining, applies)) if *remaining > 0 => {
+                    *remaining -= 1;
+                    Some(*applies)
+                }
+                _ => None,
+            }
+        };
+        for pre in &batch.preconditions {
+            if kv.get(&pre.key).cloned() != pre.expected {
+                return Ok(CommitOutcome::Conflict);
+            }
+        }
+        if let Some(applies) = unknown {
+            if applies {
+                for (k, v) in batch.puts {
+                    kv.insert(k, v);
+                }
+                for k in batch.deletes {
+                    kv.remove(&k);
+                }
+            }
+            return Err(wyrd_traits::CommitUnknownResult {
+                backend: "memmeta",
+                code: None,
+                detail: "injected".into(),
+                may_still_commit: true,
+            }
+            .into());
+        }
+        for (k, v) in batch.puts {
+            kv.insert(k, v);
+        }
+        for k in batch.deletes {
+            kv.remove(&k);
+        }
+        Ok(CommitOutcome::Committed)
+    }
+}
+
+impl MemMeta {
+    /// Apply `puts` **immediately before the next `commit`**, so a test can place another
+    /// writer's landed batch in the window between a caller's last read and its own commit.
+    ///
+    /// This is how the read-then-fence window of an Abort is exercised: the racing part commit
+    /// only *reads* the session record, so it and the fence can both land, in that order, and
+    /// what it leaves behind is exactly these rows.
+    fn inject_before_next_commit(&self, puts: Vec<(Vec<u8>, Bytes)>) {
+        self.inject_before_commit_after(0, puts);
+    }
+
+    /// [`Self::inject_before_next_commit`], but landing before the commit that follows `skip`
+    /// further ones — so a test can place a rival's write inside a *later* step of a verb that
+    /// commits more than once (Complete: fence, then publish or release).
+    fn inject_before_commit_after(&self, skip: usize, puts: Vec<(Vec<u8>, Bytes)>) {
+        *self.injected.lock().unwrap() = Some((skip, puts));
+    }
+
+    /// Fail every `get` whose key starts with `prefix`, until [`Self::stop_failing_reads`].
+    ///
+    /// The store that cannot answer the **settling re-read** after an indeterminate commit: a
+    /// caller that drops its minted identity on that read has nothing left to re-drive with.
+    fn fail_reads_of(&self, prefix: &[u8]) {
+        self.fail_reads_of_after(0, prefix);
+    }
+
+    /// [`Self::fail_reads_of`], starting only once `skip` further commits have been observed —
+    /// so a test can leave a multi-commit verb's earlier reads working and break only the one
+    /// that follows the commit it made indeterminate.
+    fn fail_reads_of_after(&self, skip: usize, prefix: &[u8]) {
+        *self.unreadable.lock().unwrap() = Some((skip, prefix.to_vec()));
+    }
+
+    fn stop_failing_reads(&self) {
+        *self.unreadable.lock().unwrap() = None;
+    }
+
+    /// Advance `upload_id`'s session epoch immediately before **every** commit — a rival that
+    /// keeps fencing and rolling back faster than a compensating attempt can land (X108).
+    fn rebase_session_before_every_commit(&self, upload_id: &str) {
+        *self.rebase.lock().unwrap() = Some(upload_id.to_string());
+    }
+
+    /// Stop rebasing.
+    fn stop_rebasing(&self) {
+        *self.rebase.lock().unwrap() = None;
+    }
+
+    /// Answer [`wyrd_traits::CommitUnknownResult`] for the next `count` commits — applying them
+    /// or not, as `applies` says. That is the whole of the class: the caller cannot tell which
+    /// happened and must re-read (`traits/src/lib.rs:211-213`).
+    fn unknown_result_on_next_commit(&self, count: usize, applies: bool) {
+        *self.unknown.lock().unwrap() = Some((count, applies));
+    }
+
+    /// Write a row directly — the test standing in for a writer another slice owns (#625's
+    /// reaper installs `retire:records:` obligations of shapes this slice's own writers do not
+    /// produce), or rewinding a fixture to a torn state.
+    fn put_raw(&self, key: Vec<u8>, value: Bytes) {
+        self.kv.lock().unwrap().insert(key, value);
+    }
+
+    /// Remove keys outright — the test-only inverse of a put, used to rewind a fixture to the
+    /// instant before a racing commit landed.
+    fn remove_keys(&self, keys: &[Vec<u8>]) {
+        let mut kv = self.kv.lock().unwrap();
+        for key in keys {
+            kv.remove(key);
+        }
+    }
+
+    fn keys_with(&self, prefix: &[u8]) -> Vec<Vec<u8>> {
+        let mut keys: Vec<Vec<u8>> = self
+            .kv
+            .lock()
+            .unwrap()
+            .keys()
+            .filter(|k| k.starts_with(prefix))
+            .cloned()
+            .collect();
+        keys.sort();
+        keys
+    }
+}
+
+/// A placement-aware fleet: one fragment map per D server, so the test can read back the
+/// **inventory** the classification sweep classifies.
+#[derive(Default)]
+struct MemFleet {
+    // Keyed `(dserver, chunk, index)` rather than `(dserver, FragmentId)` because
+    // `FragmentId` is not `Ord`; the tuple orders the inventory deterministically, which is
+    // what makes the classification sweep's output reproducible.
+    frags: Mutex<BTreeMap<(DServerId, ChunkId, u16), Bytes>>,
+}
+
+impl MemFleet {
+    fn inventory(&self) -> Vec<(DServerId, FragmentId)> {
+        self.frags
+            .lock()
+            .unwrap()
+            .keys()
+            .map(|(dserver, chunk, index)| {
+                (
+                    *dserver,
+                    FragmentId {
+                        chunk: *chunk,
+                        index: *index,
+                    },
+                )
+            })
+            .collect()
+    }
+
+    fn holds(&self, chunk: ChunkId) -> bool {
+        self.frags
+            .lock()
+            .unwrap()
+            .keys()
+            .any(|(_, held, _)| *held == chunk)
+    }
+}
+
+#[async_trait]
+impl ChunkStore for MemFleet {
+    async fn put_fragment(&self, id: FragmentId, fragment: Bytes) -> Result<()> {
+        self.frags
+            .lock()
+            .unwrap()
+            .insert((0, id.chunk, id.index), fragment);
+        Ok(())
+    }
+
+    async fn get_fragment(&self, id: FragmentId) -> Result<Option<Bytes>> {
+        Ok(self
+            .frags
+            .lock()
+            .unwrap()
+            .iter()
+            .find(|((_, chunk, index), _)| (*chunk, *index) == (id.chunk, id.index))
+            .map(|(_, bytes)| bytes.clone()))
+    }
+
+    async fn list_fragments(&self) -> Result<Vec<FragmentId>> {
+        Ok(self
+            .frags
+            .lock()
+            .unwrap()
+            .keys()
+            .map(|(_, chunk, index)| FragmentId {
+                chunk: *chunk,
+                index: *index,
+            })
+            .collect())
+    }
+
+    async fn delete_fragment(&self, id: FragmentId) -> Result<()> {
+        self.frags
+            .lock()
+            .unwrap()
+            .retain(|(_, chunk, index), _| (*chunk, *index) != (id.chunk, id.index));
+        Ok(())
+    }
+
+    async fn health(&self) -> Result<Health> {
+        Ok(Health::Healthy)
+    }
+}
+
+#[async_trait]
+impl wyrd_traits::PlacementChunkStore for MemFleet {
+    async fn get_fragment_at(&self, dserver: DServerId, id: FragmentId) -> Result<Option<Bytes>> {
+        Ok(self
+            .frags
+            .lock()
+            .unwrap()
+            .get(&(dserver, id.chunk, id.index))
+            .cloned())
+    }
+
+    async fn put_fragment_at(
+        &self,
+        dserver: DServerId,
+        id: FragmentId,
+        fragment: Bytes,
+    ) -> Result<()> {
+        self.frags
+            .lock()
+            .unwrap()
+            .insert((dserver, id.chunk, id.index), fragment);
+        Ok(())
+    }
+}
+
+const ROOT: u64 = 0;
+const BUCKET: &str = "buck";
+const OBJECT: &str = "buck/big.bin";
+/// Small enough that a part of a few KiB yields several chunks, so the part-boundary chunking
+/// the success criterion cares about is actually exercised.
+const CHUNK: usize = 1024;
+/// RS(6,3) — the default erasure-coded data path, 9 fragments per chunk, so a chunk's orphan
+/// evidence spans nine positions rather than one.
+const RS: EcScheme = EcScheme::ReedSolomon { k: 6, m: 3 };
+const LEASE_TTL: u64 = 30_000;
+const NOW: u64 = 1_000_000;
+
+/// A deterministic token source: 32 lowercase-hex characters from a counter, so a failing run
+/// replays. Production mints 128-bit random tokens (`0016:493-497`); what the protocol needs
+/// from a token is that it is *fresh*, which a counter also is.
+fn tokens_from(base: u128) -> impl FnMut() -> String {
+    let mut n = base;
+    move || {
+        n += 1;
+        format!("{n:032x}")
+    }
+}
+
+fn ids_from(base: u128) -> impl FnMut() -> ChunkId {
+    let mut n = base;
+    move || {
+        n += 1;
+        n
+    }
+}
+
+/// Twelve singleton failure domains, so RS(6,3)'s nine fragments always find nine distinct
+/// ones and placement never refuses for want of a domain.
+fn topology() -> Topology {
+    let mut t = Topology::default();
+    for id in 0u64..12 {
+        t.register(id, format!("domain-{id}"));
+    }
+    t
+}
+
+async fn create_bucket(meta: &MemMeta) {
+    meta.commit(WriteBatch::new().put(metadata::bucket_key(BUCKET), Bytes::from_static(b"{}")))
+        .await
+        .unwrap();
+}
+
+async fn create(meta: &MemMeta, tokens: &mut impl FnMut() -> String, budget: &Budget) -> String {
+    let params = CreateParams {
+        bucket: BUCKET,
+        parent: ROOT,
+        object: OBJECT,
+        content_type: Some("application/octet-stream".into()),
+        created_at_millis: NOW,
+        clock_source: "wall",
+        budget: budget.clone(),
+        resume: None,
+    };
+    match mpu::create_session(
+        meta,
+        &params,
+        tokens,
+        CreateRetry::default(),
+        || 0,
+        |_, _| async {},
+    )
+    .await
+    .unwrap()
+    {
+        CreateOutcome::Created(session) => session.upload_id.clone(),
+        CreateOutcome::Refused(refusal) => panic!("create refused: {refusal:?}"),
+    }
+}
+
+/// Upload one part end to end through the production verb.
+#[allow(clippy::too_many_arguments)]
+async fn put_part(
+    meta: &MemMeta,
+    fleet: &MemFleet,
+    upload_id: &str,
+    part_number: u32,
+    body: &[u8],
+    tokens: &mut impl FnMut() -> String,
+    ids: &mut impl FnMut() -> ChunkId,
+    budget: &Budget,
+) -> UploadPartOutcome {
+    mpu::upload_part(
+        meta,
+        fleet,
+        upload_id,
+        part_number,
+        body,
+        CHUNK,
+        RS,
+        &topology(),
+        &mut || NOW,
+        "wall",
+        LEASE_TTL,
+        tokens,
+        ids,
+        budget,
+    )
+    .await
+    .unwrap()
+}
+
+/// The ETag oracle, computed **by the test** from the part bodies — independent of whatever
+/// the implementation chose (`0016:3064-3070`; the composition this slice settles).
+fn expected_etag(parts_in_order: &[&[u8]]) -> String {
+    let mut composed = Sha256::new();
+    for body in parts_in_order {
+        let mut part = Sha256::new();
+        part.update(body);
+        let digest: [u8; 32] = part.finalize().into();
+        composed.update(digest);
+    }
+    let out: [u8; 32] = composed.finalize().into();
+    let hex: String = out.iter().map(|b| format!("{b:02x}")).collect();
+    format!("{hex}-{}", parts_in_order.len())
+}
+
+fn part_digest(body: &[u8]) -> String {
+    let mut hasher = Sha256::new();
+    hasher.update(body);
+    let out: [u8; 32] = hasher.finalize().into();
+    out.iter().map(|b| format!("{b:02x}")).collect()
+}
+
+/// **Leg H2**, run after every scenario: every on-disk fragment is in **at least one** safe
+/// class, and in no genuinely incompatible combination.
+///
+/// "Exactly one" would be wrong and would fail on correct executions — the protocol
+/// deliberately overlaps protection across both handoffs (`0016:2906-2921`, X94).
+async fn assert_no_classification_gap(meta: &MemMeta, fleet: &MemFleet, at: u64) {
+    let report = mpu::classification_sweep(meta, &fleet.inventory(), at)
+        .await
+        .unwrap();
+    assert!(
+        report.is_sound(),
+        "classification gap: {} unclassified fragment(s) {:?}, {} unsafe pair(s) {:?}",
+        report.gaps.len(),
+        report.gaps,
+        report.unsafe_pairs.len(),
+        report.unsafe_pairs,
+    );
+}
+
+// ---------------------------------------------------------------------------
+// Leg A + B — the happy path is exact, and the ETag is the settled function
+// ---------------------------------------------------------------------------
+
+#[test]
+fn a_out_of_order_parts_publish_the_exact_concatenation_and_the_settled_etag() {
+    pollster::block_on(async {
+        let meta = MemMeta::default();
+        let fleet = MemFleet::default();
+        let budget = Budget::deployed();
+        let mut tokens = tokens_from(0x10);
+        let mut ids = ids_from(0x1_000);
+        create_bucket(&meta).await;
+        let upload_id = create(&meta, &mut tokens, &budget).await;
+
+        // Part 1 is deliberately NOT a whole multiple of the chunk size (5 chunks + 7 B), and
+        // it is not the final part — so a correct implementation's chunk boundaries follow
+        // PART boundaries and the map has a short chunk in the middle of the object.
+        let part1 = vec![b'a'; 5 * CHUNK + 7];
+        let part2 = vec![b'b'; 2 * CHUNK];
+        let part3 = vec![b'c'; 3];
+
+        // Staged OUT OF ORDER: 3, then 1, then 2.
+        for (number, body) in [(3u32, &part3), (1, &part1), (2, &part2)] {
+            let outcome = put_part(
+                &meta,
+                &fleet,
+                &upload_id,
+                number,
+                body,
+                &mut tokens,
+                &mut ids,
+                &budget,
+            )
+            .await;
+            assert!(
+                matches!(outcome, UploadPartOutcome::Committed { .. }),
+                "part {number}: {outcome:?}"
+            );
+        }
+        assert_no_classification_gap(&meta, &fleet, NOW).await;
+
+        let named = vec![
+            (1u32, part_digest(&part1)),
+            (2, part_digest(&part2)),
+            (3, part_digest(&part3)),
+        ];
+        let mut next_inode = || 7u64;
+        let published = match mpu::complete(
+            &meta,
+            &CompleteParams {
+                upload_id: &upload_id,
+                named: &named,
+                clock_source: "wall",
+                now_millis: NOW + 10,
+                budget: &budget,
+                resume: None,
+            },
+            &mut next_inode,
+        )
+        .await
+        .unwrap()
+        {
+            CompleteOutcome::Published(publication) => *publication,
+            other => panic!("complete did not publish: {other:?}"),
+        };
+
+        // (A) The BYTES, not a chunk count: the object is the parts concatenated in
+        // part-number order.
+        let mut expected = Vec::new();
+        expected.extend_from_slice(&part1);
+        expected.extend_from_slice(&part2);
+        expected.extend_from_slice(&part3);
+        let read_back = read::read_path(&meta, &fleet, ROOT, OBJECT).await.unwrap();
+        assert_eq!(
+            read_back.as_deref(),
+            Some(expected.as_slice()),
+            "published bytes must equal the parts concatenated in part-number order"
+        );
+
+        // The chunk count follows PART boundaries, which is why the criterion forbids
+        // asserting it against a plain PUT: 6 + 2 + 1, not ceil(total/CHUNK) = 8.
+        let inode = read::read_inode(&meta, published.inode)
+            .await
+            .unwrap()
+            .unwrap();
+        let chunks =
+            metadata::resolve_chunk_map(&meta, &metadata::inode_key(published.inode), &inode)
+                .await
+                .unwrap()
+                .chunks()
+                .unwrap()
+                .to_vec();
+        assert_eq!(chunks.len(), 6 + 2 + 1);
+        assert_eq!(inode.size, expected.len() as u64);
+
+        // (B) The ETag is the settled pure function, against an oracle the test computed.
+        assert_eq!(published.etag, expected_etag(&[&part1, &part2, &part3]));
+        assert_eq!(inode.etag.as_deref(), Some(published.etag.as_str()));
+        assert_eq!(published.version, 1);
+
+        assert_no_classification_gap(&meta, &fleet, NOW).await;
+    });
+}
+
+// ---------------------------------------------------------------------------
+// Leg B (subset) — BYTES and EVIDENCE, not just an ETag
+// ---------------------------------------------------------------------------
+
+#[test]
+fn b_subset_complete_publishes_only_named_parts_and_evidences_the_rest() {
+    pollster::block_on(async {
+        let meta = MemMeta::default();
+        let fleet = MemFleet::default();
+        let budget = Budget::deployed();
+        let mut tokens = tokens_from(0x20);
+        let mut ids = ids_from(0x2_000);
+        create_bucket(&meta).await;
+        let upload_id = create(&meta, &mut tokens, &budget).await;
+
+        let bodies: Vec<Vec<u8>> =
+            vec![vec![b'1'; CHUNK + 5], vec![b'2'; CHUNK * 2], vec![b'3'; 9]];
+        for (index, body) in bodies.iter().enumerate() {
+            put_part(
+                &meta,
+                &fleet,
+                &upload_id,
+                index as u32 + 1,
+                body,
+                &mut tokens,
+                &mut ids,
+                &budget,
+            )
+            .await;
+        }
+
+        // Which chunks belong to which part, read from the durable records BEFORE the
+        // publication — the drain deletes them, so the mapping must be captured first.
+        let parts = mpu::read_parts(&meta, &upload_id).await.unwrap();
+        let chunks_of =
+            |n: u32| -> Vec<ChunkId> { parts[&n].chunks.iter().map(|c| c.id).collect() };
+        let (published_chunks, unnamed_chunks) =
+            ([chunks_of(1), chunks_of(3)].concat(), chunks_of(2));
+
+        // Complete naming a STRICT SUBSET: 1 and 3 (0016's own oracle, `0016:1033`).
+        let named = vec![
+            (1u32, part_digest(&bodies[0])),
+            (3, part_digest(&bodies[2])),
+        ];
+        let mut next_inode = || 11u64;
+        let published = match mpu::complete(
+            &meta,
+            &CompleteParams {
+                upload_id: &upload_id,
+                named: &named,
+                clock_source: "wall",
+                now_millis: NOW + 10,
+                budget: &budget,
+                resume: None,
+            },
+            &mut next_inode,
+        )
+        .await
+        .unwrap()
+        {
+            CompleteOutcome::Published(p) => *p,
+            other => panic!("subset complete did not publish: {other:?}"),
+        };
+
+        // 1. The read-back bytes are EXACTLY the named parts in part-number order. An
+        //    implementation that digested the subset but published every staged part passes
+        //    an ETag-only assertion and fails here.
+        let mut expected = bodies[0].clone();
+        expected.extend_from_slice(&bodies[2]);
+        assert_eq!(
+            read::read_path(&meta, &fleet, ROOT, OBJECT)
+                .await
+                .unwrap()
+                .as_deref(),
+            Some(expected.as_slice())
+        );
+        assert_eq!(published.etag, expected_etag(&[&bodies[0], &bodies[2]]));
+
+        // 2. Every UNNAMED part's fragments carry `orphan:` evidence BEFORE the record naming
+        //    them disappears (X104, `0016:2633`): marks precede the deletion of the records
+        //    that name the bytes. Observed by driving the drain one step at a time.
+        let mut report = mpu::DrainReport::default();
+        let obligation = meta
+            .keys_with(&mpu::retire_session_range(
+                mpu::RetireMode::Bytes,
+                &upload_id,
+            ))
+            .into_iter()
+            .next()
+            .expect("the unnamed parts must ride a retire:bytes: obligation");
+        // ONE STEP AT A TIME, because the ordering is the property: at the instant the last
+        // mark lands, the `part:` record naming those bytes must still be present. Draining in
+        // one call would only show the end state, which an implementation that deleted first
+        // and marked second would also produce.
+        let mut marked_before_delete = false;
+        let mut steps = 0;
+        loop {
+            let progress =
+                mpu::drain_step(&meta, &obligation, NOW + 20, &tiny_budget(), &mut report)
+                    .await
+                    .unwrap();
+            let fully_evidenced = unnamed_chunks
+                .iter()
+                .all(|chunk| (0..9).all(|index| orphan_present(&meta, *chunk, index)));
+            let record_alive = !meta.keys_with(&mpu::part_key(&upload_id, 2)).is_empty();
+            if fully_evidenced && record_alive {
+                marked_before_delete = true;
+            }
+            steps += 1;
+            assert!(steps < 256, "the drain must converge");
+            if progress == mpu::DrainProgress::Finished {
+                break;
+            }
+        }
+        assert!(
+            steps > 1,
+            "the tiny envelope must force more than one batch"
+        );
+        assert!(
+            marked_before_delete,
+            "every unnamed part's fragments must be orphan-marked BEFORE the part record \
+             naming them is deleted"
+        );
+
+        // 3. No PUBLISHED fragment is orphan-marked.
+        for chunk in &published_chunks {
+            for index in 0..9u16 {
+                assert!(
+                    !orphan_present(&meta, *chunk, index),
+                    "published chunk {chunk} fragment {index} must not be orphan-marked"
+                );
+            }
+        }
+        // The unnamed part's records are gone once its obligation drained, and its bytes are
+        // evidenced — the orphan ledger, not a silent delete, is what GC acts on.
+        assert!(meta.keys_with(&mpu::part_key(&upload_id, 2)).is_empty());
+        assert!(
+            fleet.holds(unnamed_chunks[0]),
+            "GC, not the drain, frees bytes"
+        );
+
+        assert_no_classification_gap(&meta, &fleet, NOW).await;
+    });
+}
+
+/// A deliberately tiny envelope, so a drain that would otherwise fit in one batch is forced to
+/// take several and its intermediate states are observable.
+fn tiny_budget() -> DrainBudget {
+    DrainBudget {
+        max_batch_bytes: 4_000,
+        max_batch_ops: 64,
+    }
+}
+
+fn orphan_present(meta: &MemMeta, chunk: ChunkId, index: u16) -> bool {
+    // The mark is placement-keyed, so the position is looked up across the fleet's D servers.
+    (0u64..12).any(|dserver| {
+        !meta
+            .keys_with(&metadata::orphan_key(dserver, FragmentId { chunk, index }))
+            .is_empty()
+    })
+}
+
+// ---------------------------------------------------------------------------
+// Leg C — decision 3's answer table, cell by cell, as TYPED outcomes
+// ---------------------------------------------------------------------------
+
+#[test]
+fn c_verb_state_table_answers_are_typed_not_merely_errors() {
+    pollster::block_on(async {
+        let meta = MemMeta::default();
+        let fleet = MemFleet::default();
+        let budget = Budget::deployed();
+        let mut tokens = tokens_from(0x30);
+        let mut ids = ids_from(0x3_000);
+        create_bucket(&meta).await;
+
+        // --- after Abort: UploadPart / Complete / ListParts all answer NoSuchUpload -------
+        let aborted = create(&meta, &mut tokens, &budget).await;
+        let body = vec![b'x'; CHUNK];
+        put_part(
+            &meta,
+            &fleet,
+            &aborted,
+            1,
+            &body,
+            &mut tokens,
+            &mut ids,
+            &budget,
+        )
+        .await;
+        assert_eq!(
+            mpu::abort(&meta, &aborted, NOW + 1, "wall").await.unwrap(),
+            AbortOutcome::Fenced
+        );
+        assert_eq!(
+            put_part(
+                &meta,
+                &fleet,
+                &aborted,
+                2,
+                &body,
+                &mut tokens,
+                &mut ids,
+                &budget
+            )
+            .await,
+            UploadPartOutcome::Refused(Refusal::NoSuchUpload)
+        );
+        assert_eq!(
+            mpu::complete(
+                &meta,
+                &CompleteParams {
+                    upload_id: &aborted,
+                    named: &[(1, part_digest(&body))],
+                    clock_source: "wall",
+                    now_millis: NOW + 2,
+                    budget: &budget,
+                    resume: None,
+                },
+                &mut || 99u64,
+            )
+            .await
+            .unwrap(),
+            CompleteOutcome::Refused(Refusal::NoSuchUpload)
+        );
+        assert_eq!(
+            mpu::list_parts(&meta, &aborted).await.unwrap(),
+            Err(Refusal::NoSuchUpload)
+        );
+        // A second Abort is idempotent success, not an error.
+        assert_eq!(
+            mpu::abort(&meta, &aborted, NOW + 3, "wall").await.unwrap(),
+            AbortOutcome::AlreadyAborting
+        );
+        assert_no_classification_gap(&meta, &fleet, NOW).await;
+
+        // --- a wrong part list: the invalid-part outcome WITHOUT publishing --------------
+        let mut tokens = tokens_from(0x40);
+        let bad = create(&meta, &mut tokens, &budget).await;
+        put_part(
+            &meta,
+            &fleet,
+            &bad,
+            1,
+            &body,
+            &mut tokens,
+            &mut ids,
+            &budget,
+        )
+        .await;
+        let outcome = mpu::complete(
+            &meta,
+            &CompleteParams {
+                upload_id: &bad,
+                // Part 4 was never uploaded.
+                named: &[(1, part_digest(&body)), (4, part_digest(&body))],
+                clock_source: "wall",
+                now_millis: NOW + 4,
+                budget: &budget,
+                resume: None,
+            },
+            &mut || 21u64,
+        )
+        .await
+        .unwrap();
+        assert_eq!(
+            outcome,
+            CompleteOutcome::Refused(Refusal::InvalidPart {
+                part_number: 4,
+                reason: InvalidPart::Absent
+            })
+        );
+        assert!(
+            read::read_path(&meta, &fleet, ROOT, OBJECT)
+                .await
+                .unwrap()
+                .is_none(),
+            "a rejected Complete must publish nothing"
+        );
+        // The fence was RELEASED, so the session is usable and abortable — a client typo must
+        // not wedge an upload until the reaper's `W_completing` (`0016:1032`).
+        let session = mpu::read_session(&meta, &bad).await.unwrap().unwrap();
+        assert_eq!(session.state(), SessionState::Open);
+        // A digest mismatch is its own typed reason, distinct from an absent part.
+        assert_eq!(
+            mpu::complete(
+                &meta,
+                &CompleteParams {
+                    upload_id: &bad,
+                    named: &[(1, part_digest(b"not this body"))],
+                    clock_source: "wall",
+                    now_millis: NOW + 5,
+                    budget: &budget,
+                    resume: None,
+                },
+                &mut || 21u64,
+            )
+            .await
+            .unwrap(),
+            CompleteOutcome::Refused(Refusal::InvalidPart {
+                part_number: 1,
+                reason: InvalidPart::DigestMismatch
+            })
+        );
+        assert_eq!(
+            mpu::abort(&meta, &bad, NOW + 6, "wall").await.unwrap(),
+            AbortOutcome::Fenced,
+            "a session whose Complete was rejected must still be abortable"
+        );
+
+        // --- a part past MAX_PART_CHUNKS: the too-large refusal, session still usable ----
+        let mut tokens = tokens_from(0x50);
+        let big = create(&meta, &mut tokens, &budget).await;
+        let oversize = vec![b'o'; CHUNK * (mpu::MAX_PART_CHUNKS + 1)];
+        let outcome = put_part(
+            &meta,
+            &fleet,
+            &big,
+            1,
+            &oversize,
+            &mut tokens,
+            &mut ids,
+            &budget,
+        )
+        .await;
+        assert_eq!(
+            outcome,
+            UploadPartOutcome::Refused(Refusal::EntityTooLarge {
+                chunks: mpu::MAX_PART_CHUNKS as u64 + 1,
+                limit: mpu::MAX_PART_CHUNKS as u64,
+            })
+        );
+        // Nothing staged, no slot held: the session accepts an ordinary part immediately
+        // after, and is abortable (decision 4.4 — the refusal is a bounded event with an exit).
+        assert!(meta.keys_with(&mpu::sidx_range(&big)).is_empty());
+        assert!(meta.keys_with(&mpu::slot_range(&big)).is_empty());
+        assert!(matches!(
+            put_part(
+                &meta,
+                &fleet,
+                &big,
+                1,
+                &body,
+                &mut tokens,
+                &mut ids,
+                &budget
+            )
+            .await,
+            UploadPartOutcome::Committed { .. }
+        ));
+        assert_eq!(
+            mpu::abort(&meta, &big, NOW + 7, "wall").await.unwrap(),
+            AbortOutcome::Fenced
+        );
+
+        // --- the tombstone: an IDENTICAL retry succeeds with the RECORDED ETag ----------
+        let mut tokens = tokens_from(0x60);
+        let done = create(&meta, &mut tokens, &budget).await;
+        put_part(
+            &meta,
+            &fleet,
+            &done,
+            1,
+            &body,
+            &mut tokens,
+            &mut ids,
+            &budget,
+        )
+        .await;
+        let named = vec![(1u32, part_digest(&body))];
+        let first = mpu::complete(
+            &meta,
+            &CompleteParams {
+                upload_id: &done,
+                named: &named,
+                clock_source: "wall",
+                now_millis: NOW + 8,
+                budget: &budget,
+                resume: None,
+            },
+            &mut || 31u64,
+        )
+        .await
+        .unwrap();
+        let CompleteOutcome::Published(published) = first else {
+            panic!("expected a publication, got {first:?}");
+        };
+        let retry = mpu::complete(
+            &meta,
+            &CompleteParams {
+                upload_id: &done,
+                named: &named,
+                clock_source: "wall",
+                now_millis: NOW + 9,
+                budget: &budget,
+                resume: None,
+            },
+            &mut || 32u64,
+        )
+        .await
+        .unwrap();
+        assert_eq!(
+            retry,
+            CompleteOutcome::AlreadyCompleted(published.clone()),
+            "an identical retry inside the tombstone window answers with the RECORDED ETag"
+        );
+        // A DIFFERENT part list under the same upload id is `NoSuchUpload`, never "your
+        // assembly succeeded" over the earlier one (X81).
+        put_part(
+            &meta,
+            &fleet,
+            &done,
+            2,
+            &body,
+            &mut tokens,
+            &mut ids,
+            &budget,
+        )
+        .await;
+        assert_eq!(
+            mpu::complete(
+                &meta,
+                &CompleteParams {
+                    upload_id: &done,
+                    named: &[(1, part_digest(&body)), (2, part_digest(&body))],
+                    clock_source: "wall",
+                    now_millis: NOW + 10,
+                    budget: &budget,
+                    resume: None,
+                },
+                &mut || 33u64,
+            )
+            .await
+            .unwrap(),
+            CompleteOutcome::Refused(Refusal::NoSuchUpload)
+        );
+        // And the stored object is still the FIRST assembly.
+        let inode = read::read_inode(&meta, published.inode)
+            .await
+            .unwrap()
+            .unwrap();
+        assert_eq!(inode.etag.as_deref(), Some(published.etag.as_str()));
+        assert_eq!(inode.version, published.version);
+
+        // --- a Complete while `Completing` is `OperationAborted`, never a resume ---------
+        let mut tokens = tokens_from(0x70);
+        let fenced = create(&meta, &mut tokens, &budget).await;
+        put_part(
+            &meta,
+            &fleet,
+            &fenced,
+            1,
+            &body,
+            &mut tokens,
+            &mut ids,
+            &budget,
+        )
+        .await;
+        fence_into_completing(&meta, &fenced, NOW + 11).await;
+        assert_eq!(
+            mpu::complete(
+                &meta,
+                &CompleteParams {
+                    upload_id: &fenced,
+                    named: &[(1, part_digest(&body))],
+                    clock_source: "wall",
+                    now_millis: NOW + 12,
+                    budget: &budget,
+                    resume: None,
+                },
+                &mut || 41u64,
+            )
+            .await
+            .unwrap(),
+            CompleteOutcome::Refused(Refusal::OperationAborted)
+        );
+        assert_eq!(
+            mpu::abort(&meta, &fenced, NOW + 13, "wall").await.unwrap(),
+            AbortOutcome::Refused(Refusal::OperationAborted)
+        );
+        // `UploadPart` while `Completing` is `NoSuchUpload`: a part accepted after the fence
+        // would be invisible to the publication that already read the set (`0016:1030`).
+        assert_eq!(
+            put_part(
+                &meta,
+                &fleet,
+                &fenced,
+                2,
+                &body,
+                &mut tokens,
+                &mut ids,
+                &budget
+            )
+            .await,
+            UploadPartOutcome::Refused(Refusal::NoSuchUpload)
+        );
+        // `ListParts` on a `Completing` session answers the FROZEN part set.
+        assert_eq!(
+            mpu::list_parts(&meta, &fenced)
+                .await
+                .unwrap()
+                .unwrap()
+                .len(),
+            1
+        );
+
+        assert_no_classification_gap(&meta, &fleet, NOW).await;
+    });
+}
