+/// **A missing middle `seg:` record does not end a generation drain.**
+///
+/// The segment walk used to probe forward and stop at the first absent index, so a gap — a torn
+/// store, a partially rolled-back attempt, a concurrent drainer — finished the obligation while
+/// every *later* segment survived: its `seg:` record named by no root (the flip already replaced
+/// it) and its fragments evidenced by nothing. Outcome (a), installed by the reclamation path.
+#[test]
+fn a_missing_middle_segment_does_not_end_a_generation_drain() {
+    pollster::block_on(async {
+        let meta = MemMeta::default();
+        let mut ids = ids_from(0x5E90);
+        // A three-segment generation, the shape a Complete past the flat ceiling publishes.
+        // Built here rather than driven through Complete because what is under test is the
+        // *drain's* enumeration: the fixture needs a middle to remove, and the production
+        // publication's byte-budgeted split decides how many segments an object gets.
+        let group = metadata::SegmentGroup::new("d".repeat(32), 6).unwrap();
+        let mut per_segment: Vec<Vec<(ChunkId, u16)>> = Vec::new();
+        for index in 0u32..3 {
+            let chunk = metadata::ChunkRef {
+                id: ids(),
+                scheme: RS,
+                len: 512,
+                placement: vec![0, 1, 2, 3, 4, 5, 6, 7, 8],
+            };
+            per_segment.push(chunk.fragments().map(|(i, _)| (chunk.id, i)).collect());
+            meta.put_raw(
+                metadata::seg_key(&group, index),
+                metadata::encode(
+                    &metadata::SegmentRecord::new(vec![chunk], u64::from(index) * 512).unwrap(),
+                ),
+            );
+        }
+        meta.put_raw(
+            metadata::seggrp_key(group.nonce()),
+            Bytes::from_static(metadata::SEGGRP_MARKER),
+        );
+        let key = mpu::retire_key(
+            mpu::RetireMode::Bytes,
+            &mpu::RetireToken::Generation {
+                inode: 12,
+                version: 3,
+            },
+        );
+        meta.put_raw(
+            key.clone(),
+            metadata::encode(&mpu::RetireObligation::new(
+                mpu::RetirePayload::Generation {
+                    inode: 12,
+                    version: 3,
+                    chunks: Vec::new(),
+                    segments: Some(mpu::SegmentGeneration::of(&group)),
+                },
+            )),
+        );
+
+        // Tear the store: the middle segment record vanishes before the drain runs.
+        meta.remove_keys(&[metadata::seg_key(&group, 1)]);
+
+        let mut report = mpu::DrainReport::default();
+        mpu::drain_obligation(&meta, &key, NOW + 3, &tiny_budget(), &mut report)
+            .await
+            .unwrap();
+        for (chunk, index) in &per_segment[2] {
+            assert!(
+                orphan_present(&meta, *chunk, *index),
+                "a segment AFTER the gap must still be evidenced — the gap is not the end of \
+                 the range"
+            );
+        }
+        for (chunk, index) in &per_segment[0] {
+            assert!(
+                orphan_present(&meta, *chunk, *index),
+                "…as must one before it"
+            );
+        }
+        assert!(
+            meta.keys_with(&metadata::seg_range_prefix(&group))
+                .is_empty(),
+            "and every surviving seg: record is deleted: {:?}",
+            meta.keys_with(&metadata::seg_range_prefix(&group))
+        );
+        assert!(
+            meta.get(&key).await.unwrap().is_none(),
+            "…and only then does the obligation delete itself"
+        );
+        assert!(
+            meta.keys_with(b"seggrp:").is_empty(),
+            "the unadopted group marker goes with the last segment (0016:513-527 arm (b))"
+        );
+    });
+}
