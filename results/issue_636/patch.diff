+/// **A part that lands in the read-then-fence window of an Abort is still torn down.**
+///
+/// The window is real: a part commit only *reads* `mpu:` (`require(mpu == Open@E)`), so it and an
+/// Abort fence that requires the same bytes can both commit, in that order. An Abort that froze
+/// the part list it read **before** its fence therefore installs an obligation that does not name
+/// that part — and its `part:`/`psum:` records then outlive the session itself: a session-less
+/// part record protecting bytes nothing will ever reclaim (the leak a rejected attempt shipped).
+///
+/// The interleaving is injected at the exact instant it occurs — the commit immediately before
+/// the fence lands — and the state it leaves is the state that racing commit leaves. The
+/// classification sweep's session-ownership arm is what makes the leak visible at all.
+#[test]
+fn a_part_landing_in_the_abort_fence_window_is_still_reclaimed() {
+    pollster::block_on(async {
+        let meta = MemMeta::default();
+        let fleet = MemFleet::default();
+        create_bucket(&meta).await;
+        let mut tokens = tokens_from(0xC000);
+        let mut ids = ids_from(0xC000);
+        let budget = Budget::deployed();
+        let upload_id = create(&meta, &mut tokens, &budget).await;
+
+        // Part 1 commits normally.
+        put_part(
+            &meta,
+            &fleet,
+            &upload_id,
+            1,
+            b"part-one",
+            &mut tokens,
+            &mut ids,
+            &budget,
+        )
+        .await;
+        // Part 2 is staged and committed too — but its records are then *replayed* into the
+        // window: they are removed, and re-applied by the injection hook in the same instant the
+        // Abort fence commits. What the store holds afterwards is exactly what the racing
+        // commit leaves behind.
+        put_part(
+            &meta,
+            &fleet,
+            &upload_id,
+            2,
+            b"part-two",
+            &mut tokens,
+            &mut ids,
+            &budget,
+        )
+        .await;
+        let part2 = mpu::read_parts(&meta, &upload_id).await.unwrap()[&2].clone();
+        let racing: Vec<(Vec<u8>, Bytes)> = vec![
+            (
+                mpu::part_key(&upload_id, 2),
+                meta.get(&mpu::part_key(&upload_id, 2))
+                    .await
+                    .unwrap()
+                    .unwrap(),
+            ),
+            (
+                mpu::psum_key(&upload_id, 2),
+                meta.get(&mpu::psum_key(&upload_id, 2))
+                    .await
+                    .unwrap()
+                    .unwrap(),
+            ),
+        ];
+        meta.remove_keys(&[mpu::part_key(&upload_id, 2), mpu::psum_key(&upload_id, 2)]);
+        meta.inject_before_next_commit(racing);
+
+        assert_eq!(
+            mpu::abort(&meta, &upload_id, NOW + 1, "wall")
+                .await
+                .unwrap(),
+            AbortOutcome::Fenced
+        );
+        // The record is there, and no obligation could have named it: it did not exist when the
+        // Abort read anything.
+        assert!(
+            meta.get(&mpu::part_key(&upload_id, 2))
+                .await
+                .unwrap()
+                .is_some(),
+            "the racing part commit is durable"
+        );
+
+        let report = mpu::teardown_session(&meta, &upload_id, NOW + 2, &tiny_budget())
+            .await
+            .unwrap();
+        assert!(
+            report.terminal_deleted,
+            "the teardown must reach its terminal delete"
+        );
+        for chunk in &part2.chunks {
+            for (index, _) in chunk.fragments() {
+                assert!(
+                    orphan_present(&meta, chunk.id, index),
+                    "the racing part's bytes must be evidenced for reclamation"
+                );
+            }
+        }
+        assert!(
+            meta.keys_with(b"part:").is_empty() && meta.keys_with(b"psum:").is_empty(),
+            "no part record may outlive its session: {:?}",
+            meta.keys_with(b"part:")
+        );
+        assert_no_classification_gap(&meta, &fleet, NOW + 100).await;
+    });
+}
