+/// **A torn admission ledger is surfaced, never saturated.**
+///
+/// `count` counts every `mpu:` record in any state (`0016:348`,`:2029-2031`), so a zero count
+/// while this session's record still exists means a decrement has already run for it. A
+/// saturating "decrement" deletes the session, reports an event that never happened, and leaves
+/// the fleet's admission bound silently under-counting live sessions.
+#[test]
+fn a_torn_admission_ledger_is_surfaced_not_saturated() {
+    pollster::block_on(async {
+        let meta = MemMeta::default();
+        create_bucket(&meta).await;
+        let mut tokens = tokens_from(0x70A0);
+        let budget = Budget::deployed();
+        let upload_id = create(&meta, &mut tokens, &budget).await;
+        assert!(matches!(
+            mpu::abort(&meta, &upload_id, NOW + 1, "wall")
+                .await
+                .unwrap(),
+            AbortOutcome::Fenced
+        ));
+        // The torn state: the counter says nothing is admitted while the record is still there.
+        meta.put_raw(
+            mpu::MPUCTL_KEY.to_vec(),
+            metadata::encode(&mpu::AdmissionRecord {
+                count: 0,
+                max_sessions: budget.max_sessions(),
+                profile: budget.clone(),
+            }),
+        );
+        let err = mpu::teardown_session(&meta, &upload_id, NOW + 2, &tiny_budget())
+            .await
+            .expect_err("a torn ledger must not be papered over");
+        assert!(
+            err.to_string().contains("admission count is 0"),
+            "the operator signal names the tear: {err}"
+        );
+        assert!(
+            meta.get(&mpu::mpu_key(&upload_id)).await.unwrap().is_some(),
+            "…and the session is NOT deleted on the strength of a decrement that cannot happen"
+        );
+    });
+}
+
+/// **The no-gap oracle is exact about epoch, position and evidence.**
+///
+/// It is the helper every other leg leans on, so each way it can be too generous is a way an
+/// unprotected byte is reported safe:
+///
+/// * a segment group's nonce **outlives its generations** — one session republishes under the
+///   same reserved nonce at each fence epoch — so reading every epoch under the nonce lets a
+///   *stale* generation's segments vouch for fragments this obligation does not name;
+/// * an obligation protects the `(chunk, index, dserver)` positions its chunk-refs name, which
+///   is exactly the set its drain will mark; keyed by chunk id alone, a stray fragment on a
+///   server no record names counts as protected;
+/// * evidence is what the **production** collector acts on: `gc::orphan_leases` ignores an
+///   `orphan:` value it cannot parse as a `u64`, so a fragment carrying one is unevidenced in
+///   production while a "present means evidenced" oracle reports it safe.
+#[test]
+fn the_no_gap_oracle_is_epoch_position_and_evidence_exact() {
+    pollster::block_on(async {
+        let meta = MemMeta::default();
+        let nonce = "f".repeat(32);
+        let obligated_group = metadata::SegmentGroup::new(nonce.clone(), 2).unwrap();
+        let stale_group = metadata::SegmentGroup::new(nonce.clone(), 1).unwrap();
+        let placed = |id: ChunkId| metadata::ChunkRef {
+            id,
+            scheme: EcScheme::None,
+            len: 8,
+            placement: vec![0],
+        };
+        // The obligated generation (epoch 2) names chunk 10; a stale epoch-1 generation under
+        // the SAME nonce names chunk 20.
+        for (group, id) in [(&obligated_group, 10u128), (&stale_group, 20u128)] {
+            meta.put_raw(
+                metadata::seg_key(group, 0),
+                metadata::encode(&metadata::SegmentRecord::new(vec![placed(id)], 0).unwrap()),
+            );
+        }
+        let key = mpu::retire_key(
+            mpu::RetireMode::Bytes,
+            &mpu::RetireToken::Generation {
+                inode: 3,
+                version: 4,
+            },
+        );
+        meta.put_raw(
+            key,
+            metadata::encode(&mpu::RetireObligation::new(
+                mpu::RetirePayload::Generation {
+                    inode: 3,
+                    version: 4,
+                    chunks: Vec::new(),
+                    segments: Some(mpu::SegmentGeneration::of(&obligated_group)),
+                },
+            )),
+        );
+        // A fragment carrying an `orphan:` value production cannot parse.
+        meta.put_raw(
+            metadata::orphan_key(
+                0,
+                FragmentId {
+                    chunk: 30,
+                    index: 0,
+                },
+            ),
+            Bytes::from_static(b"not-a-timestamp"),
+        );
+
+        let frag = |chunk: ChunkId| FragmentId { chunk, index: 0 };
+        let inventory = vec![
+            // named by the obligated generation, at the position it names
+            (0u64, frag(10)),
+            // the stale generation's chunk: nothing names it any more
+            (0u64, frag(20)),
+            // the obligated chunk's id on a server no record names
+            (7u64, frag(10)),
+            // evidence production would ignore
+            (0u64, frag(30)),
+        ];
+        let report = mpu::classification_sweep(&meta, &inventory, NOW)
+            .await
+            .unwrap();
+        let classes = |dserver: DServerId, chunk: ChunkId, index: u16| {
+            report
+                .classes
+                .get(&(dserver, chunk, index))
+                .cloned()
+                .unwrap_or_default()
+        };
+        assert_eq!(
+            classes(0, 10, 0),
+            vec![mpu::FragmentClass::ObligatedForRetirement],
+            "the obligated generation's own position is protected"
+        );
+        assert!(
+            classes(0, 20, 0).is_empty() && classes(7, 10, 0).is_empty(),
+            "a stale epoch's segments and an unnamed position protect nothing: {:?} / {:?}",
+            classes(0, 20, 0),
+            classes(7, 10, 0),
+        );
+        assert!(
+            classes(0, 30, 0).is_empty(),
+            "an orphan value the collector ignores is not evidence: {:?}",
+            classes(0, 30, 0)
+        );
+        let gaps: BTreeSet<(DServerId, ChunkId, u16)> = report
+            .gaps
+            .iter()
+            .map(|(dserver, frag)| (*dserver, frag.chunk, frag.index))
+            .collect();
+        assert_eq!(
+            gaps,
+            BTreeSet::from([(0, 20, 0), (7, 10, 0), (0, 30, 0)]),
+            "all three are gaps the oracle must report, not classes it may invent"
+        );
+        assert!(!report.is_sound());
+    });
+}
