+// ---------------------------------------------------------------------------
+// The retirement route for ORDINARY overwrite and delete (decision 4.1)
+// ---------------------------------------------------------------------------
+
+/// A committed generation of `chunks` chunks placed across the fleet — the shape whose inline
+/// orphan fan-out is what decision 4.1 moves off the request path.
+async fn commit_generation(
+    meta: &MemMeta,
+    fleet: &MemFleet,
+    inode: u64,
+    name: &str,
+    chunks: usize,
+    ids: &mut impl FnMut() -> ChunkId,
+) -> metadata::InodeRecord {
+    let body: Vec<u8> = (0..chunks * CHUNK).map(|i| (i % 251) as u8).collect();
+    let plan = wyrd_core::write::plan_write(&body, CHUNK, RS, ids).unwrap();
+    wyrd_core::write::intent(meta, &plan, NOW + LEASE_TTL)
+        .await
+        .unwrap();
+    wyrd_core::write::write_fragments(fleet, &plan)
+        .await
+        .unwrap();
+    wyrd_core::write::commit_create(meta, ROOT, name, inode, &plan, NOW)
+        .await
+        .unwrap();
+    wyrd_core::write::release(meta, &plan).await.unwrap();
+    read::read_inode(meta, inode).await.unwrap().unwrap()
+}
+
+/// **Decision 4.1 — an ordinary overwrite of a LARGE generation must commit, and its fan-out
+/// must ride a bounded obligation rather than the publishing batch** (`0016:1084-1088`,
+/// `0016:1492`).
+///
+/// The observable is the *batch*, not the eventual evidence: inline expansion owes one `orphan:`
+/// put per prior fragment, which for a large generation is permanently over the transaction
+/// envelope — a `PutObject` that can never commit, outcome (d). So this asserts the overwrite
+/// **commits**, that the obligation is installed with it, that the batch that installed it is
+/// O(1), and that the drain then produces exactly the evidence the inline path would have
+/// produced (marks for every prior fragment, and none for the new generation's).
+#[test]
+fn an_ordinary_overwrite_of_a_large_generation_retires_it_through_an_obligation() {
+    pollster::block_on(async {
+        let meta = MemMeta::default();
+        let fleet = MemFleet::default();
+        create_bucket(&meta).await;
+        let mut ids = ids_from(0x9000);
+        // 60 chunks x 9 fragments = 540 marks: past the half-budget the inline route is allowed
+        // (`generation_retires_inline`), so this generation takes the obligation route.
+        let prior = commit_generation(&meta, &fleet, 5, OBJECT, 60, &mut ids).await;
+        let prior_frags: Vec<(ChunkId, u16)> = prior
+            .chunk_map
+            .as_flat()
+            .unwrap()
+            .iter()
+            .flat_map(|chunk| chunk.fragments().map(move |(index, _)| (chunk.id, index)))
+            .collect();
+        assert!(prior_frags.len() > 500, "the fixture must be large enough");
+        for (chunk, index) in &prior_frags {
+            assert!(
+                !orphan_present(&meta, *chunk, *index),
+                "no evidence exists before the overwrite"
+            );
+        }
+
+        // The overwrite itself: one small object over the large one.
+        let plan = wyrd_core::write::plan_write(b"tiny", CHUNK, RS, &mut ids).unwrap();
+        wyrd_core::write::intent(&meta, &plan, NOW + LEASE_TTL)
+            .await
+            .unwrap();
+        wyrd_core::write::write_fragments(&fleet, &plan)
+            .await
+            .unwrap();
+        let outcome = metadata::commit_chunk_map_superseding(
+            &meta,
+            5,
+            &prior,
+            plan.chunk_refs(),
+            plan.size,
+            NOW + 1,
+            &metadata::ObjectMeta::default(),
+        )
+        .await
+        .unwrap();
+        assert_eq!(
+            outcome,
+            CommitOutcome::Committed,
+            "a 5 MiB PutObject over a large object must commit — inline expansion cannot"
+        );
+
+        // Not one mark yet, and exactly one obligation naming that generation.
+        for (chunk, index) in &prior_frags {
+            assert!(
+                !orphan_present(&meta, *chunk, *index),
+                "the fan-out is the drain's, not the request's"
+            );
+        }
+        let obligations = meta.keys_with(b"retire:bytes:g:");
+        assert_eq!(
+            obligations,
+            vec![b"retire:bytes:g:5:1".to_vec()],
+            "the superseded generation is named by exactly one O(1) obligation"
+        );
+        // Invariant (2) holds across the gap: the prior fragments are unreferenced but
+        // **obligated**, which is a safe class.
+        assert_no_classification_gap(&meta, &fleet, NOW).await;
+
+        // The drain produces the evidence the inline path would have, in bounded batches.
+        let mut report = mpu::DrainReport::default();
+        mpu::drain_obligation(&meta, &obligations[0], NOW + 2, &tiny_budget(), &mut report)
+            .await
+            .unwrap();
+        assert!(
+            report.batches > 1,
+            "540 marks under a tiny budget must take more than one batch, took {}",
+            report.batches
+        );
+        assert!(report.max_batch_ops <= tiny_budget().max_batch_ops);
+        for (chunk, index) in &prior_frags {
+            assert!(
+                orphan_present(&meta, *chunk, *index),
+                "every superseded fragment is evidenced once the drain finishes"
+            );
+        }
+        for chunk in plan.chunk_refs() {
+            for (index, _) in chunk.fragments() {
+                assert!(
+                    !orphan_present(&meta, chunk.id, index),
+                    "the LIVE generation's fragments must never be marked"
+                );
+            }
+        }
+        assert!(
+            meta.keys_with(b"retire:bytes:g:").is_empty(),
+            "a fully drained obligation deletes itself"
+        );
+        assert_no_classification_gap(&meta, &fleet, NOW).await;
+    });
+}
+
+/// **Decision 4.1 for DELETE, including the segmented shape** (`0016:1089-1104`, `:1493`).
+///
+/// `unlink` of a segmented generation used to be a hard refusal, so a multipart-published object
+/// could be created and never deleted. It must commit in one O(1) batch and the drain must both
+/// evidence its fragments and delete its `seg:` records.
+#[test]
+fn deleting_a_segmented_object_commits_and_drains_its_segments() {
+    pollster::block_on(async {
+        let meta = MemMeta::default();
+        let fleet = MemFleet::default();
+        create_bucket(&meta).await;
+        let mut tokens = tokens_from(0xB000);
+        let mut ids = ids_from(0xB000);
+        let budget = Budget::deployed();
+        let upload_id = create(&meta, &mut tokens, &budget).await;
+
+        // Two parts whose assembled map is past the flat ceiling, so Complete publishes a
+        // segmented map through #635's staged publication.
+        let per_part = (mpu::MAX_MAP_CHUNKS / 2 + 4) * CHUNK;
+        let bodies: Vec<Vec<u8>> = (0..2)
+            .map(|p| (0..per_part).map(|i| (i as u8).wrapping_add(p)).collect())
+            .collect();
+        let mut named = Vec::new();
+        for (index, body) in bodies.iter().enumerate() {
+            let outcome = put_part(
+                &meta,
+                &fleet,
+                &upload_id,
+                index as u32 + 1,
+                body,
+                &mut tokens,
+                &mut ids,
+                &budget,
+            )
+            .await;
+            match outcome {
+                UploadPartOutcome::Committed {
+                    part_number,
+                    digest,
+                } => named.push((part_number, digest)),
+                other => panic!("part refused: {other:?}"),
+            }
+        }
+        let published = match mpu::complete(
+            &meta,
+            &CompleteParams {
+                upload_id: &upload_id,
+                named: &named,
+                now_millis: NOW + 1,
+                clock_source: "wall",
+                budget: &budget,
+                resume: None,
+            },
+            &mut || 7u64,
+        )
+        .await
+        .unwrap()
+        {
+            CompleteOutcome::Published(publication) => *publication,
+            other => panic!("complete refused: {other:?}"),
+        };
+        let inode = read::read_inode(&meta, published.inode)
+            .await
+            .unwrap()
+            .unwrap();
+        assert!(
+            inode.chunk_map.is_segmented(),
+            "a map past MAX_MAP_CHUNKS publishes segmented"
+        );
+        let expected: Vec<u8> = bodies.iter().flatten().copied().collect();
+        assert_eq!(
+            read::read_path(&meta, &fleet, ROOT, OBJECT).await.unwrap(),
+            Some(expected),
+            "the segmented publication reads back as the concatenation"
+        );
+        let segment_keys = meta.keys_with(b"seg:");
+        assert!(!segment_keys.is_empty(), "the map has seg: records");
+        let live_chunks: Vec<(ChunkId, u16)> =
+            metadata::resolve_chunk_map(&meta, &metadata::inode_key(published.inode), &inode)
+                .await
+                .unwrap()
+                .chunks()
+                .unwrap()
+                .iter()
+                .flat_map(|chunk| chunk.fragments().map(move |(index, _)| (chunk.id, index)))
+                .collect();
+
+        // The DELETE. One batch, and the fan-out is the drain's.
+        let removed = metadata::unlink(&meta, ROOT, OBJECT, NOW + 2)
+            .await
+            .unwrap()
+            .expect("the name is bound");
+        assert_eq!(
+            removed.outcome,
+            CommitOutcome::Committed,
+            "deleting a segmented object must commit — it used to be refused outright"
+        );
+        let obligations = meta.keys_with(b"retire:bytes:g:");
+        assert_eq!(obligations.len(), 1, "one obligation names the generation");
+        for (chunk, index) in &live_chunks {
+            assert!(
+                !orphan_present(&meta, *chunk, *index),
+                "grace starts at the drain, never inside the delete batch"
+            );
+        }
+        assert_no_classification_gap(&meta, &fleet, NOW).await;
+
+        let mut report = mpu::DrainReport::default();
+        mpu::drain_obligation(&meta, &obligations[0], NOW + 3, &tiny_budget(), &mut report)
+            .await
+            .unwrap();
+        for (chunk, index) in &live_chunks {
+            assert!(
+                orphan_present(&meta, *chunk, *index),
+                "every fragment of the deleted generation is evidenced"
+            );
+        }
+        assert!(
+            meta.keys_with(b"seg:").is_empty(),
+            "the deleted generation's seg: records are gone: {:?}",
+            meta.keys_with(b"seg:")
+        );
+        assert!(
+            meta.keys_with(b"seggrp:").is_empty(),
+            "and its group marker goes with the last segment (0016:513-527 arm (b))"
+        );
+        assert!(meta.keys_with(b"retire:bytes:g:").is_empty());
+        assert_no_classification_gap(&meta, &fleet, NOW).await;
+    });
+}
