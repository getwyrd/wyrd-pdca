+                UploadPartOutcome::Committed { .. } => {}
+                other => panic!("part refused: {other:?}"),
+            }
+        }
+        // …and two segment records of a rolled-back attempt's group.
+        let nonce = "e".repeat(32);
+        let group = metadata::SegmentGroup::new(nonce.clone(), 4).unwrap();
+        for index in 0u32..2 {
+            let record = metadata::SegmentRecord::new(
+                vec![metadata::ChunkRef {
