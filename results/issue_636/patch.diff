+        let obligation = mpu::RetireObligation::new(mpu::RetirePayload::Records {
+            parts: Some(mpu::PartNumberSet::from_iter_unsorted([1, 4, 9])),
+            segments: Some(mpu::SegmentGeneration::of(&group)),
