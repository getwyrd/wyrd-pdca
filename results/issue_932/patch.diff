+        let outcome = reserve_slot(&rig.store, &req, T0).await.unwrap();
+        assert_eq!(outcome, ReserveOutcome::Refused(Refusal::NoSuchUpload));
+        assert_eq!(snapshot(&rig.store.inner).await, before, "nothing written");
