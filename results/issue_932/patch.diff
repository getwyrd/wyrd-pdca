+        let staging = rig
+            .stage(|_| {}, stream_of(vec![Bytes::from(body_bytes(10))]))
+            .await;
+        assert!(
+            matches!(staging, Ok(StageOutcome::Refused(Refusal::NoSuchUpload))),
+            "{staging:?}"
+        );
+        let (absent, _) = identity(77);
+        let mut req = reserve_request(&rig, &rig.attempt);
