+
+    /// The entry's `sidx:<id>:<n>:<chunk>` key.
+    pub fn key(&self) -> &[u8] {
+        &self.key
+    }
+
+    /// The entry's current bytes: what the next batch of this attempt requires there.
+    pub fn bytes(&self) -> &Bytes {
+        &self.bytes
+    }
+
+    /// The entry, its placement included.
+    pub fn entry(&self) -> &OwnedEntry {
+        &self.entry
