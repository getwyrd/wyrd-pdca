+                    }
+                    Err(m) => {
+                        set.malformed.insert(chunk.id, m);
+                    }
+                }
+            }
+        }
+        Err(fault) => {
+            set.unresolvable.insert(key.to_vec(), fault.to_string());
+        }
+    }
