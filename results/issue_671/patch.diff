+async fn a_streamed_put_shorter_than_its_declared_length_is_refused() {
+    let fx = Fixture::start().await;
+    let path = "/wyrd-bucket/streamed-runs-short";
+    let (headers, signer) = streaming_headers(path, &fx.host(), Some(1_000));
