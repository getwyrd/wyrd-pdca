+        " 7",
+        "7 ",
+        "",
+        "7.0",
+        "0x7",
+        "18446744073709551616",
+    ] {
+        let page = page_with(size);
+        let mut endpoint = Endpoint::start(vec![Script::ended(ok_with_length(
+            "size",
+            page.len(),
+            page.as_bytes(),
