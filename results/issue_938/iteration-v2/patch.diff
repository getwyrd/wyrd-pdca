+/// The SDK's own endpoint resolution, with its S3 Express handling taken out.
+///
+/// The SDK's endpoint rules read a bucket name that ends in `--x-s3` or `--xa-s3` as an S3
+/// Express directory bucket or access point. For one they sign the request for the
+/// `s3express` service rather than `s3`, which an endpoint that checks the signing service
+/// refuses before it looks at the operation (the Wyrd gateway does), and, unless S3 Express
+/// session auth is off, they first send a `CreateSession` request of the SDK's own
+/// (`aws-sdk-s3` 1.152.0 `s3_express.rs`). The client treats no bucket name differently: what
+/// the rules resolve for one keeps its URL and headers, and loses the S3 Express auth schemes
+/// and properties. With no auth scheme named by the endpoint, the request is signed with
+/// SigV4 for `s3` in the configured region, under each operation's own signing options, with
+/// no double URI encoding (`aws-sdk-s3` 1.152.0 `config.rs:1628`, `config/auth.rs:58-70`,
+/// `operation/create_bucket.rs:107-109`): the signing every other name gets. Every other
+/// resolution, a refusal included, is the SDK's, unchanged: path-style, the rules refuse a
+/// name they read as an ARN (one that starts with `arn:`) before anything is sent.
+#[derive(Debug)]
+struct WithoutS3Express(DefaultResolver);
+
+impl ResolveEndpoint for WithoutS3Express {
+    fn resolve_endpoint<'a>(&'a self, params: &'a Params) -> EndpointFuture<'a> {
+        let resolved = self.0.resolve_endpoint(params);
+        EndpointFuture::new(Box::pin(async move {
+            let endpoint = resolved.await?;
+            // The mark the rules put on every S3 Express endpoint they resolve.
+            let s3_express = endpoint
+                .properties()
+                .get("backend")
+                .and_then(|backend| backend.as_string())
+                == Some("S3Express");
+            if !s3_express {
+                return Ok(endpoint);
+            }
+            let mut plain = Endpoint::builder().url(endpoint.url().to_owned());
+            for (name, values) in endpoint.headers() {
+                for value in values {
+                    plain = plain.header(name.to_owned(), value.to_owned());
+                }
+            }
+            Ok(plain.build())
+        }))
+    }
+}
