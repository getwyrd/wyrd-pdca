+// --- the relay -----------------------------------------------------------------------------
+
+/// A loopback forwarder in front of the gateway that records the head of every request it
+/// forwards (the client opens one connection per request), and counts the connections it
+/// accepts.
+struct Relay {
+    addr: SocketAddr,
+    heads: Arc<Mutex<Vec<String>>>,
+    accepted: Arc<AtomicUsize>,
+    _task: JoinSet<()>,
+}
+
+impl Relay {
+    async fn start(upstream: SocketAddr) -> Self {
+        let listener = TcpListener::bind("127.0.0.1:0").await.expect("relay bind");
+        let addr = listener.local_addr().expect("relay addr");
+        let heads = Arc::new(Mutex::new(Vec::new()));
+        let recorded = Arc::clone(&heads);
+        let accepted = Arc::new(AtomicUsize::new(0));
+        let counted = Arc::clone(&accepted);
+        let mut task = JoinSet::new();
+        task.spawn(async move {
+            // Owned by the accept loop, so every connection's task goes with the relay.
+            let mut connections = JoinSet::new();
+            while let Ok((client, _)) = listener.accept().await {
+                counted.fetch_add(1, Ordering::SeqCst);
+                connections.spawn(forward(client, upstream, Arc::clone(&recorded)));
+            }
+        });
+        Self {
+            addr,
+            heads,
+            accepted,
+            _task: task,
+        }
+    }
+
+    /// The heads recorded since the last call.
+    fn take(&self) -> Vec<String> {
+        std::mem::take(&mut *self.heads.lock().expect("relay lock"))
+    }
+
+    /// How many connections the relay has accepted.
+    fn accepted(&self) -> usize {
+        self.accepted.load(Ordering::SeqCst)
+    }
+}
+
+/// Forward one connection, recording its request head before any of it reaches the gateway.
+async fn forward(mut client: TcpStream, upstream: SocketAddr, heads: Arc<Mutex<Vec<String>>>) {
+    let Ok(mut server) = TcpStream::connect(upstream).await else {
+        return;
+    };
+    let mut buf = Vec::new();
+    let head_end = loop {
+        if let Some(i) = find(&buf, b"\r\n\r\n") {
+            break i;
+        }
+        if read_more(&mut client, &mut buf).await.is_err() {
+            return;
+        }
+    };
+    heads
+        .lock()
+        .expect("relay lock")
+        .push(String::from_utf8_lossy(&buf[..head_end]).into_owned());
+    if server.write_all(&buf).await.is_err() {
+        return;
+    }
+    let _ = tokio::io::copy_bidirectional(&mut client, &mut server).await;
+}
+
+/// A request head's method, path and query.
+fn request_line(head: &str) -> (&str, &str, &str) {
+    let line = head.split("\r\n").next().unwrap_or_default();
+    let mut parts = line.split(' ');
+    let method = parts.next().unwrap_or_default();
+    let target = parts.next().unwrap_or_default();
+    let (path, query) = target.split_once('?').unwrap_or((target, ""));
+    (method, path, query)
+}
+
+/// Whether a query names `name`, bare or with a value.
+fn query_has(query: &str, name: &str) -> bool {
+    query
+        .split('&')
+        .any(|pair| pair == name || pair.starts_with(&format!("{name}=")))
+}
+
+/// A request header's value, by name, from a recorded head.
+fn request_header<'a>(head: &'a str, name: &str) -> Option<&'a str> {
+    head.split("\r\n").skip(1).find_map(|line| {
+        let (field, value) = line.split_once(':')?;
+        field
+            .trim()
+            .eq_ignore_ascii_case(name)
+            .then(|| value.trim())
+    })
+}
+
+// --- (B) every unsupported operation reaches the gateway -----------------------------------
+
+/// How a probe must reach the gateway and what the gateway answers it.
+struct ProbeCase {
+    probe: Probe,
+    method: &'static str,
+    path: String,
+    /// A query parameter that names the operation, or `None` for an operation the path and
+    /// method name alone.
+    query: Option<&'static str>,
+    status: u16,
+    code: ErrorCode,
+}
+
+fn not_implemented() -> ErrorCode {
+    ErrorCode::Code("NotImplemented".to_string())
+}
+
+fn invalid_request() -> ErrorCode {
+    ErrorCode::Code("InvalidRequest".to_string())
+}
+
+fn probe_cases() -> Vec<ProbeCase> {
+    let key = "probe/object".to_string();
+    let upload_id = "wyrd-validate-probe-upload".to_string();
+    let object_path = format!("/{BUCKET}/probe/object");
+    // Path-style, a bucket-level request's path is the bucket and a slash.
+    let bucket_path = format!("/{BUCKET}/");
+    let case = |probe, method, path: &str, query, status, code| ProbeCase {
+        probe,
+        method,
+        path: path.to_string(),
+        query,
+        status,
+        code,
+    };
+    vec![
+        case(
+            Probe::CopyObject {
+                key: key.clone(),
+                source_key: "probe/source".to_string(),
+            },
+            "PUT",
+            &object_path,
+            None,
+            501,
+            not_implemented(),
+        ),
+        case(
+            Probe::CreateMultipartUpload { key: key.clone() },
+            "POST",
+            &object_path,
+            Some("uploads"),
+            501,
+            not_implemented(),
+        ),
+        case(
+            Probe::UploadPart {
+                key: key.clone(),
+                upload_id: upload_id.clone(),
+            },
+            "PUT",
+            &object_path,
+            Some("partNumber"),
+            501,
+            not_implemented(),
+        ),
+        case(
+            Probe::CompleteMultipartUpload {
+                key: key.clone(),
+                upload_id: upload_id.clone(),
+            },
+            "POST",
+            &object_path,
+            Some("uploadId"),
+            501,
+            not_implemented(),
+        ),
+        case(
+            Probe::AbortMultipartUpload {
+                key: key.clone(),
+                upload_id: upload_id.clone(),
+            },
+            "DELETE",
+            &object_path,
+            Some("uploadId"),
+            501,
+            not_implemented(),
+        ),
+        case(
+            Probe::ListParts {
+                key,
+                upload_id: upload_id.clone(),
+            },
+            "GET",
+            &object_path,
+            Some("uploadId"),
+            501,
+            not_implemented(),
+        ),
+        case(
+            Probe::ListMultipartUploads,
+            "GET",
+            &bucket_path,
+            Some("uploads"),
+            501,
+            not_implemented(),
+        ),
+        case(
+            Probe::GetBucketLocation,
+            "GET",
+            &bucket_path,
+            Some("location"),
+            501,
+            not_implemented(),
+        ),
+        case(
+            Probe::CreateBucket {
+                bucket: FORBIDDEN_BUCKET.to_string(),
+            },
+            "PUT",
+            &format!("/{FORBIDDEN_BUCKET}/"),
+            None,
+            400,
+            invalid_request(),
+        ),
+        case(
+            Probe::DeleteBucket {
+                bucket: FORBIDDEN_BUCKET.to_string(),
+            },
+            "DELETE",
+            &format!("/{FORBIDDEN_BUCKET}/"),
+            None,
+            400,
+            invalid_request(),
+        ),
+        case(Probe::ListBuckets, "GET", "/", None, 400, invalid_request()),
+        case(
+            Probe::HeadBucket,
+            "HEAD",
+            &bucket_path,
+            None,
+            400,
+            ErrorCode::NoBody,
+        ),
+    ]
+}
