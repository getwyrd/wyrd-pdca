+#[tokio::test]
+async fn a_ranged_get_is_206_with_its_content_range_and_exactly_those_bytes() {
+    let gateway = start_gateway().await;
+    let client = client(gateway.addr, deadlines());
+    let body = object(OBJECT_LEN);
