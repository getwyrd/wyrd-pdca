+//! The gateway's **S3-compatible HTTP wire surface** — the "Stateless S3 front door"
+//! that embeds the client library (m4-first-deployment-blueprint:59, §5 building-block
+//! `05-building-block-view.md:132`, §7.5 `07-deployment-view.md:72`). It serves
+//! **bucket-scoped object PUT / GET / DELETE** over HTTP, mapping each verb onto the
+//! existing in-process client path ([`Gateway::put_object`] / [`Gateway::get_object`] /
+//! [`Gateway::delete_object`]) so a wire round-trip is byte-identical to the in-process one
+//! (blueprint:698-699). Every request is **SigV4-verified** before any gateway work
+//! ([`sigv4`], §14 threat model `14-threat-model.md:86`): there is no anonymous access.
+//!
+//! # Layering (ADR-0010)
+//! This layer is generic over [`Gateway<M, C, Co>`] — it names **no** concrete backend.
+//! Concretes are picked only at the composition root (`cli::cmd_s3` / a server profile),
+//! exactly as [`Gateway`] itself is, so wiring stays in one place.
+//!
+//! # Scope boundary (brief §Out-of-scope)
+//! The floor is object PUT/GET/DELETE with SigV4 header auth. Multipart upload,
+//! `ListObjectsV2` + pagination, conditional requests, presigned URLs, and a full S3
+//! error-code conformance sweep are deferred (pre-M8). Bucket + key compose onto the M0
+//! **flat namespace** (`ROOT`) as the single object key `"{bucket}/{key}"` — no directory
+//! tree is invented.
+//!
+//! # TLS (§7.5 "TLS; S3 SigV4", two distinct identities)
+//! The public S3 TLS identity ([`TlsIdentity`]) is modelled **separately** from the
+//! internal step-ca mTLS fabric (blueprint:620-623, ADR-0036 req 5) so the two are never
+//! conflated. Binding a real public certificate into a listener is the first-deployment
+//! gate's job (#367, over a deployed host); at this milestone the listener is exercised
+//! over loopback (brief §Success-criterion DEFERRED), so [`S3Gateway::serve`] takes an
+//! already-bound [`tokio::net::TcpListener`] and the operator wraps it in the public-TLS
+//! terminator at deployment.
+
+pub mod crypto;
+pub mod sigv4;
+
+use std::sync::Arc;
+
+use axum::body::{to_bytes, Body};
+use axum::extract::{Request, State};
+use axum::http::{Method, StatusCode};
+use axum::response::Response;
+use axum::Router;
+use wyrd_traits::{Coordination, MetadataStore, PlacementChunkStore};
+
+use crate::{Gateway, GatewayError};
+use sigv4::Credentials;
+
+/// Upper bound on a single request body the gateway will admit into memory. The current
+/// in-process seam ([`Gateway::put_object`]) takes a `&[u8]`, so a PUT is materialised;
+/// this cap keeps a hostile `Content-Length` from driving the "everything into the heap"
+/// OOM cliff (0015:789) while true streaming bodies wait on a core write-path change
+/// (out of scope this issue — see build-notes).
+const MAX_BODY_BYTES: usize = 256 * 1024 * 1024;
+
+/// The public S3 TLS identity — deliberately a **distinct** type from any internal
+/// service-to-service mTLS material (blueprint:620-623, ADR-0036 req 5). Carried in
+/// [`S3Config`] as the seam the first-deployment gate (#367) binds to a real public
+/// certificate; not wired into a listener at this milestone (loopback at Check).
+#[derive(Debug, Clone)]
+pub struct TlsIdentity {
+    /// Path to the PEM-encoded public S3 server certificate chain.
+    pub cert_pem: std::path::PathBuf,
+    /// Path to the PEM-encoded private key for [`cert_pem`](TlsIdentity::cert_pem).
+    pub key_pem: std::path::PathBuf,
+}
+
+/// Configuration for the S3 wire surface: the accepted credentials, the SigV4 signing
+/// scope (`region`/`service`), and the optional public-TLS identity.
+#[derive(Debug, Clone)]
+pub struct S3Config {
+    /// The credential set the gateway will accept (a single static credential at M4).
+    pub credentials: Vec<Credentials>,
+    /// The SigV4 region the credential scope must name (e.g. `us-east-1`).
+    pub region: String,
+    /// The SigV4 service the credential scope must name (`s3`).
+    pub service: String,
+    /// The public S3 TLS identity, separate from internal mTLS (#367 binds it).
+    pub tls: Option<TlsIdentity>,
+}
+
+impl S3Config {
+    /// A config accepting exactly `credentials` in the default `s3` / `us-east-1` scope.
+    pub fn new(credentials: Vec<Credentials>) -> Self {
+        Self {
+            credentials,
+            region: "us-east-1".to_string(),
+            service: "s3".to_string(),
+            tls: None,
+        }
+    }
+}
+
+/// The S3 HTTP front door over a composed [`Gateway`].
+pub struct S3Gateway<M, C, Co> {
+    gateway: Arc<Gateway<M, C, Co>>,
+    config: Arc<S3Config>,
+}
+
+struct AppState<M, C, Co> {
+    gateway: Arc<Gateway<M, C, Co>>,
+    config: Arc<S3Config>,
+}
+
+// `Arc` makes the state cheap to clone regardless of the backend concretes, so avoid a
+// derive that would spuriously demand `M/C/Co: Clone`.
+impl<M, C, Co> Clone for AppState<M, C, Co> {
+    fn clone(&self) -> Self {
+        Self {
+            gateway: Arc::clone(&self.gateway),
+            config: Arc::clone(&self.config),
+        }
+    }
+}
+
+impl<M, C, Co> S3Gateway<M, C, Co>
+where
+    M: MetadataStore + 'static,
+    C: PlacementChunkStore + 'static,
+    Co: Coordination + 'static,
+{
+    /// Compose the front door over a gateway and its config.
+    pub fn new(gateway: Arc<Gateway<M, C, Co>>, config: S3Config) -> Self {
+        Self {
+            gateway,
+            config: Arc::new(config),
+        }
+    }
+
+    /// The axum router: every method/path routes through the `handle` dispatcher, which
+    /// verifies the SigV4 signature first and then dispatches by verb.
+    pub fn router(self) -> Router {
+        let state = AppState {
+            gateway: self.gateway,
+            config: self.config,
+        };
+        Router::new().fallback(handle::<M, C, Co>).with_state(state)
+    }
+
+    /// Serve on an already-bound listener until it stops (loopback at Check; a deployed
+    /// host wraps the listener in the public-TLS terminator, #367).
+    pub async fn serve(self, listener: tokio::net::TcpListener) -> std::io::Result<()> {
+        axum::serve(listener, self.router()).await
+    }
+}
+
+/// Split a request path `/{bucket}/{key}` into `(bucket, key)`. `key` may itself contain
+/// `/` (a nested key on the flat namespace). Returns `None` for a bucket-only or empty
+/// path — bucket-level operations are out of scope.
+fn split_bucket_key(path: &str) -> Option<(&str, &str)> {
+    let (bucket, key) = path.trim_start_matches('/').split_once('/')?;
+    if bucket.is_empty() || key.is_empty() {
+        return None;
+    }
+    Some((bucket, key))
+}
+
+async fn handle<M, C, Co>(State(state): State<AppState<M, C, Co>>, req: Request) -> Response
+where
+    M: MetadataStore + 'static,
+    C: PlacementChunkStore + 'static,
+    Co: Coordination + 'static,
+{
+    let (parts, body) = req.into_parts();
+    let method = parts.method;
+    let path = parts.uri.path().to_string();
+    let query = parts.uri.query().unwrap_or("").to_string();
+    let headers = parts.headers;
+
+    let body_bytes = match to_bytes(body, MAX_BODY_BYTES).await {
+        Ok(bytes) => bytes,
+        Err(_) => {
+            return error_response(
+                StatusCode::PAYLOAD_TOO_LARGE,
+                "EntityTooLarge",
+                "request body exceeds the gateway limit",
+            )
+        }
+    };
+
+    // Fail-closed auth: verify the signature before any gateway work (§14:86).
+    if let Err(err) = sigv4::verify(
+        method.as_str(),
+        &path,
+        &query,
+        &headers,
+        &body_bytes,
+        &state.config.credentials,
+        &state.config.region,
+        &state.config.service,
+    ) {
+        return error_response(StatusCode::FORBIDDEN, err.s3_code(), &err.to_string());
+    }
+
+    let Some((bucket, key)) = split_bucket_key(&path) else {
+        return error_response(
+            StatusCode::BAD_REQUEST,
+            "InvalidRequest",
+            "expected a bucket-scoped object path /{bucket}/{key}",
+        );
+    };
+    // Bucket-scoped key onto the M0 flat namespace (ROOT).
+    let object_key = format!("{bucket}/{key}");
+
+    match method {
+        Method::PUT => match state.gateway.put_object(&object_key, &body_bytes).await {
+            Ok(()) => empty_response(StatusCode::OK),
+            Err(err) => gateway_error_response(&err),
+        },
+        Method::GET => match state.gateway.get_object(&object_key).await {
+            Ok(Some(bytes)) => body_response(bytes),
+            Ok(None) => error_response(
+                StatusCode::NOT_FOUND,
+                "NoSuchKey",
+                "the specified key does not exist",
+            ),
+            Err(err) => gateway_error_response(&err),
+        },
+        Method::DELETE => match state.gateway.delete_object(&object_key).await {
+            // DELETE is idempotent: removing a present or an absent key both succeed.
+            Ok(_) => empty_response(StatusCode::NO_CONTENT),
+            Err(err) => gateway_error_response(&err),
+        },
+        _ => error_response(
+            StatusCode::METHOD_NOT_ALLOWED,
+            "MethodNotAllowed",
+            "only object PUT, GET, and DELETE are supported",
+        ),
+    }
+}
+
+fn empty_response(status: StatusCode) -> Response {
+    Response::builder()
+        .status(status)
+        .body(Body::empty())
+        .expect("static response is always valid")
+}
+
+fn body_response(bytes: Vec<u8>) -> Response {
+    Response::builder()
+        .status(StatusCode::OK)
+        .header("content-type", "application/octet-stream")
+        .body(Body::from(bytes))
+        .expect("static response is always valid")
+}
+
+fn error_response(status: StatusCode, code: &str, message: &str) -> Response {
+    let xml = format!(
+        "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\
+         <Error><Code>{code}</Code><Message>{message}</Message></Error>"
+    );
+    Response::builder()
+        .status(status)
+        .header("content-type", "application/xml")
+        .body(Body::from(xml))
+        .expect("static response is always valid")
+}
+
+/// Map a gateway error onto an S3-compatible HTTP response. A commit `Conflict`
+/// (a concurrent writer won) is 409; anything else is a 500.
+fn gateway_error_response(err: &wyrd_traits::BoxError) -> Response {
+    if let Some(GatewayError::Conflict) = err.downcast_ref::<GatewayError>() {
+        return error_response(
+            StatusCode::CONFLICT,
+            "OperationAborted",
+            "a concurrent writer won the commit",
+        );
+    }
+    error_response(
+        StatusCode::INTERNAL_SERVER_ERROR,
+        "InternalError",
+        "the gateway could not complete the request",
+    )
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn split_bucket_key_parses_object_paths() {
+        assert_eq!(split_bucket_key("/bucket/key"), Some(("bucket", "key")));
+        assert_eq!(
+            split_bucket_key("/bucket/nested/key"),
+            Some(("bucket", "nested/key"))
+        );
+        assert_eq!(split_bucket_key("/bucket/"), None);
+        assert_eq!(split_bucket_key("/bucket"), None);
+        assert_eq!(split_bucket_key("/"), None);
+    }
+}
