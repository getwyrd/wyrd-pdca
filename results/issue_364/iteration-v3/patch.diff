+                "PUT",
+                "/bucket/key",
+                "",
+                &headers,
+                std::slice::from_ref(&creds),
+                "us-east-1",
+                "s3",
+                fresh,
+            ),
+            Ok(PayloadHash::Streaming(streaming.to_string())),
+        );
+    }
+}
