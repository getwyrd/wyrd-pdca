+[dev-dependencies]
+tokio = { workspace = true, features = ["macros", "rt-multi-thread"] }
+
+# Inherit the workspace lint policy (single source of truth in the root
+# Cargo.toml [workspace.lints.*]).
+[lints]
+workspace = true
diff --git a/crates/gateway-s3/src/crypto.rs b/crates/gateway-s3/src/crypto.rs
