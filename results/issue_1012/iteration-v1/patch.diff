+/// One kind of **ordered work** a [`RetirePayload`] can owe, in the order the drain takes them
+/// ([`Self::ORDER`]) — the component a [`RetireCursor`] names.
+///
+/// Segments come before parts: a payload owing both (`retire:records:{parts, seg}`, `0016:356`)
+/// deletes the rolled-back attempt's segment records before the part records those segments'
+/// chunks are held by, the order the post-restore check of an attempt reads them in
+/// (`crates/custodian/src/restore.rs`, `check_attempt`). The `session` component is not one of
+/// these: it owes the session's owned `sidx:` residue, which the owned-staging walk drains by
+/// reference rather than through this cursor (`0016:672`).
+#[derive(Debug, Clone, Copy, PartialEq, Eq, PartialOrd, Ord, Hash, Serialize, Deserialize)]
+#[serde(rename_all = "lowercase")]
+pub enum RetireWork {
+    /// `seg`: one rolled-back attempt's `seg:` records, by segment index. Deleted, never marked.
+    Seg,
+    /// `parts`: part records, by part number — marked then deleted under `retire:bytes:`,
+    /// deleted under `retire:records:`.
+    Parts,
+    /// `chunks`: a per-part obligation's chunk list, by index. Marked; it names no record.
+    Chunks,
+    /// `generation`: a retired generation — a flat one's chunk list by index (marked), a
+    /// segmented one's `seg:` records by segment index (marked at each record's current
+    /// placement, then deleted, `0016:2417-2425`).
+    Generation,
+}
+
+impl RetireWork {
+    /// Every kind, in drain order.
+    pub const ORDER: [Self; 4] = [Self::Seg, Self::Parts, Self::Chunks, Self::Generation];
+
+    /// The payload field this kind of work is owed under, for an operator signal.
+    pub const fn name(self) -> &'static str {
+        match self {
+            Self::Seg => "seg",
+            Self::Parts => "parts",
+            Self::Chunks => "chunks",
+            Self::Generation => "generation",
+        }
     }
 }
 
+/// The retirement drain's **cursor**: one position in its obligation's own ordered work
+/// (`0016:613-619`, `:668`) — the next **entry** the drain owes and the next **mark** inside it,
+/// so an entry too large for one batch resumes mid-entry.
+///
+/// Spelled `{"component":<work>,"entry":<n>,"mark":<m>}`, every field present:
+///
+/// | `component` | `entry` | `mark` |
+/// |---|---|---|
+/// | `seg` | the next segment index of the attempt's range | always 0: segment records are deleted, not marked |
+/// | `parts` | the next part number owed | `retire:bytes:`: how many of that part's fragment positions — its chunks in order, each chunk's fragments in index order — are already marked; `retire:records:`: always 0 |
+/// | `chunks` | the next index into the chunk list | the next fragment index of that chunk |
+/// | `generation` | flat: the next index into the chunk list; segmented: the next segment index | flat: the next fragment index of that chunk; segmented: how many of that segment's fragment positions are already marked |
+///
+/// Its order (component in [`RetireWork::ORDER`], then entry, then mark) is the order of the
+/// work, so a drain's successive cursors compare strictly increasing.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, PartialOrd, Ord, Serialize)]
+pub struct RetireCursor {
+    component: RetireWork,
+    entry: u32,
+    mark: u32,
+}
+
+impl RetireCursor {
+    /// A cursor at `mark` inside `entry` of `component`. A plain position: whether it lies inside
+    /// a payload's work is [`RetirePayload::with_cursor`]'s check, and decode's.
+    pub const fn new(component: RetireWork, entry: u32, mark: u32) -> Self {
+        Self {
+            component,
+            entry,
+            mark,
+        }
+    }
+
+    /// The kind of work it is in.
+    pub const fn component(&self) -> RetireWork {
+        self.component
+    }
+
+    /// The entry it resumes at.
+    pub const fn entry(&self) -> u32 {
+        self.entry
+    }
+
+    /// The mark inside that entry it resumes at.
+    pub const fn mark(&self) -> u32 {
+        self.mark
+    }
+}
