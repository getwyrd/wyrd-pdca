 /// A fresh ChaCha RNG seeded from the madsim run seed, so the whole campaign — *which*
@@ -6628,6 +7043,18 @@ dst_campaign_test! {
     }
 }
 
+dst_campaign_test! {
+    async fn retirement_drain_restamp_never_overwrites_reclaiming() {
+        prop_retirement_drain_restamp_never_overwrites_reclaiming(&mut rand_seed()).await;
+    }
+}
+
+dst_campaign_test! {
+    async fn retirement_drain_race_reaches_both_winners() {
+        prop_retirement_drain_race_reaches_both_winners().await;
+    }
+}
+
 // ---- committed regression seeds (ADR-0009: a bug-finding seed is a permanent test) ----
 
 /// Seeds committed as **permanent regressions** (ADR-0009, `0005:374`): the campaign
@@ -6672,6 +7099,7 @@ dst_replay_test! {
             prop_restore_fence_settles_an_ambiguous_commit(&mut rng).await;
