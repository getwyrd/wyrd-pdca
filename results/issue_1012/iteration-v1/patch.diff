+// ---- property 21: the retirement drain's re-stamp races GC's reclaim intent on one mark (#1012) --
+//
+// A `retire:bytes:` drain meets a position whose mark names another event (here a legacy mark, long
+// past grace): stale evidence it re-stamps with its own event under the exact-value
+// `require(orphan == prior)` (arm (b), `0016:1220-1226`). GC meets the same mark, unreferenced and
+// past grace, and swaps it to `reclaiming` under the same exact-value precondition before it
+// deletes the fragment, then deletes the key blind. Both read the same stamped bytes, so exactly one
+// of the two commits may win. When GC wins, the drain must never write over the `reclaiming` mark
+// (arm (0)): GC's blind key delete would take that write with it, leaving this event with no
+// evidence. So the drain's re-read finds `reclaiming`, leaves it byte-identical, keeps its
+// obligation, and once GC's key delete lands writes the position fresh under `require_absent`.
+//
+// The record-level leg (`crates/custodian/tests/multipart_retirement_drain.rs`, C′) plants a
+// `reclaiming` mark by hand. Here the drain is a genuinely concurrent task over the simulated-TiKV
+// model, every read and commit a simulated hop, landing where the seed puts it; the coverage leg
+// proves both winners, and the interleaving this row exists for — both read the stamped bytes, GC's
+// swap wins, the drain's re-stamp loses and its re-read finds `reclaiming` — are reached.
+
+/// The retired generation's one chunk: one fragment, on server 1, referenced by nothing.
+const RACE_CHUNK: ChunkId = 0x8150;
+const RACE_GRACE: u64 = 50;
+const RACE_NOW: u64 = 10_000;
+/// How far into the run the drain starts, in simulated milliseconds: from before GC's first read
+/// of the mark to after its whole pass (a pass here is about ten hops).
+const RACE_SPAN: u32 = 16;
+/// The most passes either side makes before the run gives up.
+const RACE_MAX_PASSES: usize = 32;
+
+/// The obligation the drain works: `retire:bytes:g:9:2` owing the generation's flat chunk list.
+fn race_obligation() -> (Vec<u8>, Bytes) {
+    let token = RetireToken::Generation {
+        inode: 9,
+        version: 2,
+    };
+    let key = retire_key(RetireMode::Bytes, &token);
+    let value = format!(
+        r#"{{"generation":{{"inode":9,"version":2,"chunks":[{{"id":{RACE_CHUNK},"scheme":"None","len":5,"placement":[1]}}]}}}}"#
+    );
+    decode_retire_obligation(&key, value.as_bytes()).expect("an obligation a writer installs");
+    (key, Bytes::from(value))
+}
+
+fn race_mark_key() -> Vec<u8> {
+    metadata::orphan_key(1, frag_of(RACE_CHUNK))
+}
+
+/// The mark both sides read: a legacy stamp at 0, long past grace.
+const RACE_STAMPED: &[u8] = b"0";
+
+/// One observation at the store seam, in the order the simulation produced them.
+#[derive(Clone, Debug, PartialEq, Eq)]
+enum RaceEvent {
+    /// A GC pass began.
+    GcPass,
+    /// A ledger page handed GC the stamped mark.
+    GcReadStamped,
+    /// The drain read the mark's key and found the stamped bytes.
+    DrainReadStamped,
+    /// The drain read the mark's key and found it `reclaiming`.
+    DrainReadReclaiming,
+    /// GC's swap to `reclaiming` was answered.
+    Swap(CommitOutcome),
+    /// The drain's re-stamp, preconditioned on the stamped bytes, was answered.
+    Restamp(CommitOutcome),
+    /// A drain commit preconditioned on the `reclaiming` bytes was sent: arm (b) against arm (0).
+    RestampOverReclaiming,
+    /// A commit deleted the mark's key (GC, after destroying the fragment).
+    KeyDeleted,
+    /// The drain wrote the position under `require_absent`.
+    Fresh(CommitOutcome),
+}
+
+type RaceLog = Arc<Mutex<Vec<RaceEvent>>>;
+
+/// A recording tap over the simulated-TiKV store. Instance state only (ADR-0035).
+struct RaceMeta {
+    inner: SimTikvMetadataStore,
+    log: RaceLog,
+}
+
+impl RaceMeta {
+    fn record(&self, event: RaceEvent) {
+        self.log.lock().unwrap().push(event);
+    }
+}
+
+#[async_trait]
+impl MetadataStore for RaceMeta {
+    async fn get(&self, key: &[u8]) -> Result<Option<Bytes>> {
+        let value = self.inner.get(key).await?;
+        // GC reads marks only through its ledger pages; a keyed read of the mark is the drain's.
+        if key == race_mark_key() {
+            match value.as_deref() {
+                Some(RACE_STAMPED) => self.record(RaceEvent::DrainReadStamped),
+                Some(bytes)
+                    if metadata::decode_orphan_mark(bytes).is_ok_and(|m| m.is_reclaiming()) =>
+                {
+                    self.record(RaceEvent::DrainReadReclaiming)
+                }
+                _ => {}
+            }
+        }
+        Ok(value)
+    }
+
+    async fn scan(&self, prefix: &[u8]) -> Result<Vec<(Vec<u8>, Bytes)>> {
+        self.inner.scan(prefix).await
+    }
+
+    async fn scan_page(
+        &self,
+        prefix: &[u8],
+        after: Option<&[u8]>,
+        limit: usize,
+    ) -> Result<wyrd_traits::ScanPage> {
+        let (items, next) = self.inner.scan_page(prefix, after, limit).await?;
+        let stamped = items
+            .iter()
+            .any(|(k, v)| *k == race_mark_key() && v.as_ref() == RACE_STAMPED);
+        if prefix == metadata::ORPHAN_PREFIX && stamped {
+            self.record(RaceEvent::GcReadStamped);
+        }
+        Ok((items, next))
+    }
+
+    async fn commit(&self, batch: WriteBatch) -> Result<CommitOutcome> {
+        let key = race_mark_key();
+        let required = batch
+            .preconditions
+            .iter()
+            .find(|p| p.key == key)
+            .map(|p| p.expected.clone());
+        let puts_mark = batch
+            .puts
+            .iter()
+            .find(|(k, _)| *k == key)
+            .map(|(_, v)| v.clone());
+        let drain = batch
+            .preconditions
+            .first()
+            .is_some_and(|p| p.key.starts_with(b"retire:") && p.expected.is_some());
+        let reclaiming = |bytes: &Bytes| {
+            metadata::decode_orphan_mark(bytes).is_ok_and(|mark| mark.is_reclaiming())
+        };
+        if drain && matches!(&required, Some(Some(bytes)) if reclaiming(bytes)) {
+            self.record(RaceEvent::RestampOverReclaiming);
+        }
+        let deletes_mark = batch.deletes.contains(&key);
+        let outcome = self.inner.commit(batch).await?;
+        match (&required, &puts_mark) {
+            (Some(Some(prior)), Some(put)) if prior.as_ref() == RACE_STAMPED && reclaiming(put) => {
+                self.record(RaceEvent::Swap(outcome));
+            }
+            (Some(Some(prior)), Some(_)) if prior.as_ref() == RACE_STAMPED && drain => {
+                self.record(RaceEvent::Restamp(outcome));
+            }
+            (Some(None), Some(_)) if drain => self.record(RaceEvent::Fresh(outcome)),
+            _ => {}
+        }
+        if deletes_mark && outcome == CommitOutcome::Committed {
+            self.record(RaceEvent::KeyDeleted);
+        }
+        Ok(outcome)
+    }
+}
+
+/// A D server whose listing and delete each span a simulated hop.
+#[derive(Default)]
+struct RaceDServer {
+    inner: MemDServer,
+}
+
+#[async_trait]
+impl ChunkStore for RaceDServer {
+    async fn put_fragment(
+        &self,
+        id: FragmentId,
+        bytes: Bytes,
+        deadline: Option<u64>,
+    ) -> Result<()> {
+        self.inner.put_fragment(id, bytes, deadline).await
+    }
+
+    async fn get_fragment(&self, id: FragmentId) -> Result<Option<Bytes>> {
+        self.inner.get_fragment(id).await
+    }
+
+    async fn list_fragments(&self) -> Result<Vec<FragmentId>> {
+        madsim::time::sleep(Duration::from_millis(1)).await;
+        self.inner.list_fragments().await
+    }
+
+    async fn delete_fragment(&self, id: FragmentId) -> Result<()> {
+        madsim::time::sleep(Duration::from_millis(1)).await;
+        self.inner.delete_fragment(id).await
+    }
+
+    async fn health(&self) -> Result<Health> {
+        Ok(Health::Healthy)
+    }
+}
+
+/// What one run met, read off the log.
+struct RaceRun {
+    /// GC's swap to `reclaiming` committed.
+    gc_won: bool,
+    /// The drain's re-stamp committed.
+    drain_won: bool,
+    /// Both sides read the stamped bytes before either commit on them was answered.
+    both_read: bool,
+    /// The drain's re-stamp lost, and a later read of the drain's found the mark `reclaiming`.
+    reread_found_reclaiming: bool,
+}
+
+fn race_run(events: &[RaceEvent]) -> RaceRun {
+    let first = |wanted: fn(&RaceEvent) -> bool| events.iter().position(wanted);
+    let answered = first(|e| matches!(e, RaceEvent::Swap(_) | RaceEvent::Restamp(_)));
+    let read_before = |wanted: RaceEvent| {
+        let at = events.iter().position(|e| *e == wanted);
+        matches!((at, answered), (Some(at), Some(answered)) if at < answered)
+    };
+    let lost = first(|e| *e == RaceEvent::Restamp(CommitOutcome::Conflict));
+    let reread = lost.is_some_and(|lost| events[lost..].contains(&RaceEvent::DrainReadReclaiming));
+    RaceRun {
+        gc_won: events.contains(&RaceEvent::Swap(CommitOutcome::Committed)),
+        drain_won: events.contains(&RaceEvent::Restamp(CommitOutcome::Committed)),
+        both_read: read_before(RaceEvent::GcReadStamped)
+            && read_before(RaceEvent::DrainReadStamped),
+        reread_found_reclaiming: reread,
+    }
+}
+
+/// One run: GC passes back to back while the drain starts `delay_millis` into the run and drains
+/// its obligation through the reconstruction pass's `reconcile_step`. Asserts the property and
+/// returns what the run met.
+async fn drain_races_gc(delay_millis: u64) -> RaceRun {
+    let log: RaceLog = Arc::new(Mutex::new(Vec::new()));
+    let meta = Arc::new(RaceMeta {
+        inner: SimTikvMetadataStore::new(),
+        log: Arc::clone(&log),
+    });
+    let d: Arc<[RaceDServer; 4]> = Arc::new(Default::default());
+    let frag = frag_of(RACE_CHUNK);
+    d[1].put_fragment(frag, Bytes::from_static(b"retired"), None)
+        .await
+        .unwrap();
+    let (obligation_key, obligation) = race_obligation();
+    let seeded = WriteBatch::new()
+        .put(obligation_key.clone(), obligation)
+        .put(race_mark_key(), Bytes::from_static(RACE_STAMPED));
+    assert_eq!(meta.commit(seeded).await.unwrap(), CommitOutcome::Committed);
+    log.lock().unwrap().clear();
+
+    let coord = MemCoordination::new();
+    let elected = Arc::new(elect(&coord, "zone-retirement-race").await);
+    let done = Arc::new(AtomicBool::new(false));
+    let drainer = madsim::task::spawn({
+        let (meta, d, elected, done) = (
+            Arc::clone(&meta),
+            Arc::clone(&d),
+            Arc::clone(&elected),
+            Arc::clone(&done),
+        );
+        let obligation_key = obligation_key.clone();
+        async move {
+            if delay_millis > 0 {
+                madsim::time::sleep(Duration::from_millis(delay_millis)).await;
+            }
+            let fleet: Vec<(DServerId, &dyn ChunkStore)> = (0..4)
+                .map(|id| (id as DServerId, &d[id] as &dyn ChunkStore))
+                .collect();
+            let topology = four_domains();
+            let clock = wyrd_testkit::ManualClock::new(RACE_NOW);
+            for _ in 0..RACE_MAX_PASSES {
+                let ctx = ReconstructionContext {
+                    meta: &*meta,
+                    fleet: &fleet,
+                    topology: &topology,
+                    unreachable: &[],
+                    clock: &clock,
+                    staged_write_window_millis: 0,
+                };
+                let (zone, custodian) = &*elected;
+                let pass = reconcile_step(zone, custodian, None, None, Some(&ctx), None, RACE_NOW);
+                pass.await.expect("a drain pass");
+                if meta.inner.get(&obligation_key).await.unwrap().is_none() {
+                    break;
+                }
+                madsim::time::sleep(Duration::from_millis(1)).await;
+            }
+            done.store(true, Ordering::Relaxed);
+        }
+    });
+
+    let fleet: Vec<(DServerId, &dyn ChunkStore)> = (0..4)
+        .map(|id| (id as DServerId, &d[id] as &dyn ChunkStore))
+        .collect();
+    let mut passes = 0;
+    loop {
+        let finished = done.load(Ordering::Relaxed);
+        log.lock().unwrap().push(RaceEvent::GcPass);
+        let ctx = GcContext {
+            meta: &*meta,
+            fleet: &fleet,
+            grace_window_millis: RACE_GRACE,
+            expired_pending: ExpiredPendingPolicy::Defer,
+        };
+        let (zone, custodian) = &*elected;
+        let pass = reconcile_step(zone, custodian, Some(&ctx), None, None, None, RACE_NOW).await;
+        passes += 1;
+        assert!(
+            pass.is_ok(),
+            "GC pass {passes} (drain at {delay_millis} ms): {pass:?}"
+        );
+        if finished {
+            break;
+        }
+        assert!(
+            passes < RACE_MAX_PASSES,
+            "the drain never finished (at {delay_millis} ms)"
+        );
+    }
+    drainer.await.expect("the drainer ran to completion");
+    let events = log.lock().unwrap().clone();
+    let run = race_run(&events);
+
+    // EXACTLY ONE COMMIT ON THE STAMPED BYTES WINS.
+    assert!(
+        run.gc_won != run.drain_won,
+        "GC's swap and the drain's re-stamp both read the stamped mark; exactly one may win (drain \
+         at {delay_millis} ms): {events:?}"
+    );
+    // ARM (0): THE DRAIN NEVER WRITES OVER A `reclaiming` MARK.
+    assert!(
+        !events.contains(&RaceEvent::RestampOverReclaiming),
+        "the drain retried its re-stamp against GC's `reclaiming` mark (drain at {delay_millis} \
+         ms): {events:?}"
+    );
+    if let Some(at) = events
+        .iter()
+        .position(|e| *e == RaceEvent::Swap(CommitOutcome::Committed))
+    {
+        let next_write = events[at..].iter().find(|e| {
+            matches!(
+                e,
+                RaceEvent::KeyDeleted | RaceEvent::Fresh(CommitOutcome::Committed)
+            )
+        });
+        assert_eq!(
+            next_write,
+            Some(&RaceEvent::KeyDeleted),
+            "after GC's swap the mark changed by anything but GC's key delete (drain at \
+             {delay_millis} ms): {events:?}"
+        );
+    }
+    // THE OBLIGATION DRAINED, AND THE POSITION CARRIES THIS RETIREMENT'S EVIDENCE.
+    assert_eq!(
+        meta.inner.get(&obligation_key).await.unwrap(),
+        None,
+        "{events:?}"
+    );
+    let mark = meta
+        .inner
+        .get(&race_mark_key())
+        .await
+        .unwrap()
+        .expect("a mark");
+    let mark = metadata::decode_orphan_mark(&mark).unwrap();
+    assert_eq!(mark.event(), Some("g:9:2"), "{events:?}");
+    assert!(!mark.is_reclaiming(), "{events:?}");
+    // Whoever won owns the fragment's fate: GC deleted it, or the drain's fresh grace keeps it.
+    let held = d[1].get_fragment(frag).await.unwrap().is_some();
+    assert_eq!(
+        held, run.drain_won,
+        "the fragment and the winner disagree: {events:?}"
+    );
+    run
+}
+
+/// The campaign leg: the seed picks where the drain starts.
+async fn prop_retirement_drain_restamp_never_overwrites_reclaiming(rng: &mut ChaCha8Rng) {
+    let delay = u64::from(rng.next_u32() % (RACE_SPAN + 1));
+    drain_races_gc(delay).await;
+}
+
+/// **Both winners, and the interleaving between them, are genuinely REACHED.** Walks the drain's
+/// start across the span, asserting the property at every point, then asserts that the drain won
+/// in some run and GC in another, that both sides read the stamped bytes before either commit was
+/// answered in some run GC won, and that in some run the drain's re-stamp lost and its re-read
+/// found the mark `reclaiming` — the read arm (0) exists for.
+async fn prop_retirement_drain_race_reaches_both_winners() {
+    let (mut gc, mut drain, mut contested, mut reread) = (false, false, false, false);
+    for delay in 0..=u64::from(RACE_SPAN) {
+        let run = drain_races_gc(delay).await;
+        gc |= run.gc_won;
+        drain |= run.drain_won;
+        contested |= run.gc_won && run.both_read;
+        reread |= run.reread_found_reclaiming;
+    }
+    assert!(
+        drain,
+        "no start in 0..={RACE_SPAN} ms let the drain's re-stamp win"
+    );
+    assert!(gc, "no start in 0..={RACE_SPAN} ms let GC's swap win");
+    assert!(
+        contested,
+        "no start in 0..={RACE_SPAN} ms had both sides read the stamped mark before GC's swap won"
+    );
+    assert!(
+        reread,
+        "no start in 0..={RACE_SPAN} ms had the drain's re-stamp lose and its re-read find the \
+         mark `reclaiming` — the interleaving this property exists for was never exercised"
+    );
+}
+
