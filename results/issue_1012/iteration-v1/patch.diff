+/// The drain cursor ([`RetireCursor`], #1012): absent on every installed obligation and omitted
+/// when absent, so an installer's bytes are unchanged; written through
+/// [`RetirePayload::with_cursor`] and decoded back identically; refused, as a typed error, on a
+/// component the payload does not owe and past the end of the work it does.
+#[cfg(test)]
+mod drain_cursor {
+    use super::*;
+
+    fn token() -> RetireToken {
+        RetireToken::Session {
+            upload_id: UploadId::new("ab".repeat(16)).expect("an upload id"),
+            epoch: 3,
+            part: None,
+        }
+    }
+
+    fn decode(mode: RetireMode, value: &str) -> Result<RetirePayload, RecordError> {
+        let key = retire_key(mode, &token());
+        decode_retire_obligation(&key, value.as_bytes()).map(|(_, _, payload)| payload)
+    }
+
+    #[test]
+    fn an_installed_obligation_carries_no_cursor_and_its_bytes_are_unchanged() {
+        let parts = PartNumberSet::from_numbers([PartNumber::new(2).unwrap()]).unwrap();
+        let installed =
+            RetireObligation::unnamed_parts(&UploadId::new("ab".repeat(16)).unwrap(), 3, parts);
+        assert_eq!(installed.payload().cursor(), None);
+        assert_eq!(
+            metadata::encode(installed.payload()),
+            r#"{"parts":[[2,2]]}"#.as_bytes()
+        );
+    }
+
+    #[test]
+    fn a_cursor_round_trips_and_resumes_mid_entry() {
+        let payload = decode(RetireMode::Bytes, r#"{"parts":[[1,4],[9,9]]}"#).unwrap();
+        let cursor = RetireCursor::new(RetireWork::Parts, 9, 17);
+        let moved = payload.with_cursor(RetireMode::Bytes, cursor).unwrap();
+        let value = metadata::encode(&moved);
+        assert_eq!(
+            value,
+            r#"{"parts":[[1,4],[9,9]],"cursor":{"component":"parts","entry":9,"mark":17}}"#
+                .as_bytes()
+        );
+        let decoded = decode(RetireMode::Bytes, std::str::from_utf8(&value).unwrap()).unwrap();
+        assert_eq!(decoded, moved);
+        assert_eq!(decoded.cursor(), Some(&cursor));
+        assert!(
+            RetireCursor::new(RetireWork::Seg, 0, 0) < cursor,
+            "work order first"
+        );
+    }
+
+    #[test]
+    fn a_cursor_naming_work_the_payload_does_not_owe_is_a_typed_error() {
+        let refused = decode(
+            RetireMode::Bytes,
+            r#"{"parts":[[1,1]],"cursor":{"component":"chunks","entry":0,"mark":0}}"#,
+        );
+        assert_eq!(
+            refused,
+            Err(RecordError::RetireCursorNoWork {
+                component: "chunks"
+            })
+        );
+        let payload = decode(RetireMode::Bytes, r#"{"session":true,"parts":"all"}"#).unwrap();
+        let cursor = RetireCursor::new(RetireWork::Seg, 0, 0);
+        let refused = payload.with_cursor(RetireMode::Bytes, cursor);
+        assert_eq!(
+            refused,
+            Err(RecordError::RetireCursorNoWork { component: "seg" })
+        );
+    }
+
+    #[test]
+    fn a_cursor_past_its_work_is_a_typed_error() {
+        let chunk = r#"{"id":7,"scheme":"None","len":5,"placement":[1]}"#;
+        let past = |component: &'static str, entry, mark| {
+            Err(RecordError::RetireCursorOutOfRange {
+                component,
+                entry,
+                mark,
+            })
+        };
+        let flat = format!(
+            r#"{{"generation":{{"inode":9,"version":2,"chunks":[{chunk}]}},"cursor":{{"component":"generation","entry":1,"mark":0}}}}"#
+        );
+        let key = retire_key(
+            RetireMode::Bytes,
+            &RetireToken::Generation {
+                inode: 9,
+                version: 2,
+            },
+        );
+        let refused = decode_retire_obligation(&key, flat.as_bytes()).map(|(_, _, p)| p);
+        assert_eq!(
+            refused,
+            past("generation", 1, 0),
+            "a chunk index past the list"
+        );
+        let refused = decode(
+            RetireMode::Bytes,
+            r#"{"parts":[[1,4]],"cursor":{"component":"parts","entry":5,"mark":0}}"#,
+        );
+        assert_eq!(
+            refused,
+            past("parts", 5, 0),
+            "a part number outside the set"
+        );
+        let refused = decode(
+            RetireMode::Records,
+            r#"{"parts":[[1,4]],"cursor":{"component":"parts","entry":2,"mark":1}}"#,
+        );
+        assert_eq!(
+            refused,
+            past("parts", 2, 1),
+            "a records obligation never marks"
+        );
+        let seg = r#"{"seg":{"nonce":"0123456789abcdef0123456789abcdef","epoch":3},"cursor":{"component":"seg","entry":4,"mark":2}}"#;
+        assert_eq!(decode(RetireMode::Records, seg), past("seg", 4, 2));
+        let unknown = decode(
+            RetireMode::Bytes,
+            r#"{"parts":[[1,4]],"cursor":{"component":"parts","entry":2,"mark":0,"x":1}}"#,
+        );
+        assert!(matches!(
+            unknown,
+            Err(RecordError::MalformedRecordValue { .. })
+        ));
+    }
+}
