+// ─── the build identity, fourth surface (#736) ──────────────────────────────────
+
+/// The image build PASSES THE VERSION IN, and it is the same string the tarball's `VERSION`
+/// file carries.
+///
+/// `.dockerignore` excludes `.git/` (`:6`) and the default path compiles the binary inside
+/// the image build, so the binary's build script sees no repository: without
+/// `--build-arg WYRD_VERSION`, the shipped binary would advertise
+/// `Server: wyrd/0.0.0+git.unknown` while the `VERSION` file beside it named the real
+/// version — the issue's definition of done violated by construction on the shipping path.
+/// Asserted on the pure argument list rather than by grepping our own source, so it is a
+/// real assertion about what runs.
+#[test]
+fn the_image_build_bakes_the_same_version_the_tarball_records() {
+    let cfg = dist::DistConfig::default();
+    let version = "0.1.0+git.3.abc12de";
+    let args = dist::image_build_args(&cfg, version, "abc12de0000000000000000000000000000000f");
+
+    let build_args: Vec<&String> = args
+        .iter()
+        .zip(args.iter().skip(1))
+        .filter(|(flag, _)| flag.as_str() == "--build-arg")
+        .map(|(_, value)| value)
+        .collect();
+    assert!(
+        build_args.contains(&&format!("WYRD_VERSION={version}")),
+        "the image build must pass the derived version in — the build stage cannot ask git \
+         (.dockerignore excludes .git/): {args:?}"
+    );
+    // The tag the binary is EXTRACTED from (`docker create <tag>`) must name the same
+    // artifact this build produces, `+` sanitized for docker's tag grammar.
+    assert!(
+        args.contains(&format!("wyrd:0.1.0-git.3.abc12de-{}", cfg.flavor)),
+        "the versioned tag must name this artifact: {args:?}"
+    );
+    assert!(
+        args.contains(&format!("wyrd:{}", cfg.flavor)),
+        "the moving flavor tag must be pushed too: {args:?}"
+    );
+    // …and it is the SAME string the operator reads out of the tarball, which is the
+    // equality the release smoke step checks against the running gateway's `Server:` header.
+    assert!(
+        dist::version_file(version, &cfg.flavor, "7.3.77")
+            .contains(&format!("version: {version}\n")),
+        "VERSION must record the version the image build baked in"
+    );
+}
