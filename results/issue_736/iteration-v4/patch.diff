diff --git a/crates/server/src/version.rs b/crates/server/src/version.rs
new file mode 100644
index 0000000..0321867
--- /dev/null
+++ b/crates/server/src/version.rs
@@ -0,0 +1,563 @@
+//! The build-identity derivation — **one** implementation, compiled by every consumer
+//! (issue #736).
+//!
+//! Three places have to agree on the string that names a build: the binary's build script
+//! (`crates/server/build.rs`), which bakes it in so the S3 front door can advertise it as
+//! `Server: wyrd/<version>` and the `role started` event can record it; and
+//! `cargo xtask dist` (`xtask/src/dist.rs`), which writes it to the operator tarball's
+//! `VERSION` file. Two implementations of a normalizer is exactly the drift
+//! `xtask/tests/fdb_image.rs` exists to prevent for the FDB client pin, and here the failure
+//! is silent: the tarball would say `0.1.0+git.3.abc12de` while the wire said
+//! `v0.1.0-3-gabc12de`, and a version-keyed capability matrix (proposal 0017 §3) keyed on one
+//! could never match the other.
+//!
+//! So this file is the single source, and both consumers **compile it**:
+//!
+//! * `crates/server/build.rs` includes it with `#[path = "src/version.rs"] mod version;`
+//!   (the standard build-script pattern) and this crate's lib exposes it as
+//!   [`crate::version`](self);
+//! * `xtask/src/dist.rs` includes it with
+//!   `#[path = "../../crates/server/src/version.rs"] pub mod version;` and re-exports
+//!   `normalize_describe`, so `dist::normalize_describe` keeps its call site and its test.
+//!
+//! The direction matters: tooling reaches into the product, never the other way round. A
+//! `build-dependency` from `wyrd-server` onto `xtask` — or a normal dependency from `xtask`
+//! onto `wyrd-server` — would invert the ship boundary and pull the whole server graph into
+//! every `cargo xtask` invocation (ADR-0010).
+//!
+//! Everything here is **pure**: no process env is read, no command is run. The impure half
+//! (asking git, reading `WYRD_VERSION`) belongs to the two callers, so the ordering these
+//! functions encode is unit-testable over injected inputs inside `cargo xtask ci`.
+//!
+//! One postcondition ties this file to the wire: every identity [`resolve_version`] returns
+//! satisfies [`is_identity`], the narrow subset of RFC 9110 §5.6.2 `token` that
+//! `wyrd_gateway_s3::is_advertisable_version` accepts verbatim. A git *tag* is not a token
+//! (`archive/backup-premerge-signoff`, `release/1.2.0`), so that is a real constraint on the
+//! derivation rather than a formality — and it is met by **refusing** such a describe and
+//! naming the commit instead, never by rewriting the tag into something that could collide
+//! with another build's identity. See [`resolve_version`].
+//!
+//! Because this file is compiled into a build script as well as into the library, it must
+//! carry no inner attributes and name no item outside itself.
+
+/// The build environment's explicit override — the rung the packaging pipeline injects.
+/// Named ONCE: `crates/server/build.rs` reads it, `cargo xtask dist` sets it (as a
+/// `--build-arg` on the image build and in the `--host` build's environment), and
+/// `deploy/docker/wyrd/Dockerfile` re-declares it as an `ARG`/`ENV` — the two spellings
+/// that cannot import a Rust constant are pinned by `xtask/tests/dist_templates.rs`.
+pub const VERSION_ENV: &str = "WYRD_VERSION";
+
+/// The build environment's explicit override, and WHERE the resolved identity came from —
+/// emitted beside it by `crates/server/build.rs` as `cargo:rustc-env`, recorded on the
+/// `role started` event, and read by `crates/server/tests/s3_server_version_header.rs` so a
+/// build that was *handed* its version is told apart from one that *derived* it.
+///
+/// The distinction is operational, not cosmetic: rung 1 is used verbatim and can therefore
+/// say anything at all (the issue's own complaint about an operator-supplied
+/// `--server-version` that "can silently be wrong"), while rung 2 is a fact about this
+/// checkout. `wyrd/1.2.3` alone cannot tell those apart; `version_origin` can.
+pub const VERSION_ORIGIN_ENV: &str = "WYRD_VERSION_ORIGIN";
+
+/// The version base an artifact carries when no tag names it: the workspace's own
+/// `version = "0.0.0"` placeholder (root `Cargo.toml`). Single-sourced here because both the
+/// build script and `cargo xtask dist`'s `derive_version` pass it — two spellings could
+/// drift, and the drift would show up as a tarball whose `VERSION` disagrees with the binary
+/// inside it.
+pub const FALLBACK_VERSION: &str = "0.0.0";
+
+/// Where a resolved build identity came from — see [`VERSION_ORIGIN_ENV`].
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum VersionOrigin {
+    /// The build environment supplied it ([`VERSION_ENV`]) and it was used verbatim —
+    /// `cargo xtask dist` on both of its paths, or an operator's own build.
+    Explicit,
+    /// Derived from this checkout's `git describe`, normalized by [`normalize_describe`].
+    Git,
+    /// No override and no repository to ask (a source tarball, or an image build that was
+    /// passed no version): the identity names no commit and says so.
+    Unknown,
+}
+
+impl VersionOrigin {
+    /// The spelling that reaches the environment, the log field and the test's oracle.
+    pub const fn as_str(self) -> &'static str {
+        match self {
+            Self::Explicit => "explicit",
+            Self::Git => "git",
+            Self::Unknown => "unknown",
+        }
+    }
+}
+
+/// A resolved build identity: the string every surface advertises, and where it came from.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct BuildIdentity {
+    /// The version — `Server: wyrd/<version>`, the `role started` event's `version` field,
+    /// and the tarball's `VERSION` line, all byte-identical.
+    pub version: String,
+    /// Which rung produced [`version`](Self::version).
+    pub origin: VersionOrigin,
+}
+
+/// The characters a build identity may carry.
+///
+/// A deliberately NARROW subset of RFC 9110 §5.6.2 `tchar` (the grammar
+/// `wyrd_gateway_s3::is_advertisable_version` enforces on the wire): ASCII alphanumerics
+/// plus the four separators this crate's own grammar uses — `.` and `+` from
+/// [`normalize_describe`]'s shape, `-` and `_` from tag names. Narrow because the same
+/// string is also a docker tag (`xtask::dist::image_tag_version`, `[A-Za-z0-9_.-]` once `+`
+/// is sanitized) and part of a tarball filename; a `tchar` such as `|` or `` ` `` would be
+/// a valid header and an invalid tag.
+pub fn is_identity_byte(b: u8) -> bool {
+    b.is_ascii_alphanumeric() || matches!(b, b'.' | b'-' | b'_' | b'+')
+}
+
+/// True when `version` can be carried verbatim by every surface that must agree on it.
+pub fn is_identity(version: &str) -> bool {
+    !version.is_empty() && version.bytes().all(is_identity_byte)
+}
+
+/// Whether `describe` reports the working tree as dirty (`git describe --dirty`'s suffix).
+///
+/// Read separately from [`normalize_describe`] because the fail-closed path in
+/// [`resolve_version`] discards the tag half of a describe but must not discard *this*: a
+/// build made from an edited tree says so, whichever shape names it (the issue's decision 2).
+fn describe_is_dirty(describe: &str) -> bool {
+    describe.trim().ends_with("-dirty")
+}
+
+/// Normalize `git describe --tags --always --dirty` output into an artifact version.
+/// Pure — unit-tested in `ci`.
+///
+/// * no tags yet (`git describe --always` prints a bare short sha, optionally
+///   `-dirty`): `0.0.0+git.<sha>[.dirty]` — the workspace's own 0.0.0 stays the
+///   base, the sha disambiguates;
+/// * exactly on a tag `v0.1.0`: `0.1.0`;
+/// * past a tag `v0.1.0-3-gabc12de[-dirty]`: `0.1.0+git.3.abc12de[.dirty]`;
+/// * nothing at all (git could not be asked — no repository, no `git`):
+///   `0.0.0+git.unknown`, which says *that* rather than impersonating the bare
+///   workspace placeholder.
+///
+/// **The shape rules only** — the output is NOT guaranteed to satisfy [`is_identity`],
+/// because `git describe` interpolates the tag name verbatim and a tag may carry bytes an
+/// identity may not (`/`, a space, any UTF-8 at all: this repository's own only tag is
+/// `archive/backup-premerge-signoff`, and `release/1.2.0` is a common convention). Deciding
+/// what to advertise for such a checkout is [`resolve_version`]'s job, and it is a
+/// *decision* rather than a rewrite — see there. Kept exactly as `cargo xtask dist` has
+/// always spelled it so the packaging pipeline's `VERSION` and this build script cannot
+/// disagree about the ordinary shapes.
+pub fn normalize_describe(describe: &str, fallback: &str) -> String {
+    let d = describe.trim();
+    let (d, dirty) = match d.strip_suffix("-dirty") {
+        Some(clean) => (clean, true),
+        None => (d, false),
+    };
+    let dirty_suffix = if dirty { ".dirty" } else { "" };
+    if let Some(tagged) = d.strip_prefix('v') {
+        // `v0.1.0` or `v0.1.0-3-gabc12de`.
+        let mut parts = tagged.rsplitn(3, '-');
+        let (gsha, count) = (parts.next(), parts.next());
+        if let (Some(gsha), Some(count), Some(base)) = (gsha, count, parts.next()) {
+            if let Some(sha) = gsha.strip_prefix('g') {
+                if count.chars().all(|c| c.is_ascii_digit()) {
+                    return format!("{base}+git.{count}.{sha}{dirty_suffix}");
+                }
+            }
+        }
+        if dirty {
+            return format!("{tagged}+git.dirty");
+        }
+        return tagged.to_string();
+    }
+    if d.is_empty() {
+        return format!("{fallback}+git.unknown{dirty_suffix}");
+    }
+    // Bare short sha — no tag reachable.
+    format!("{fallback}+git.{d}{dirty_suffix}")
+}
+
+/// The build identity for a checkout, from the two inputs that can name one — in the order
+/// that makes the SHIPPING path correct. Pure: the caller does the asking, so the ordering
+/// is driven over injected values in `ci` rather than by mutating process env.
+///
+/// 1. `explicit` — [`VERSION_ENV`] from the build environment, used **verbatim**. This rung
+///    exists because `.dockerignore` excludes `.git/` (`:6`) and `cargo xtask dist`'s
+///    default path compiles the binary *inside* the production image build
+///    (`xtask/src/dist.rs:5-7`, "the tarball's `bin/wyrd` is bit-identical to the image's
+///    `/usr/local/bin/wyrd`"). A build script asking git in that stage sees no repository at
+///    all, while the tarball's `VERSION` beside it says `0.1.0+git.3.abc12de` — the shipped
+///    binary advertising the least informative value available. So the packaging pipeline
+///    passes the version it has already derived in, and it wins.
+/// 2. `describe` — `git describe --tags --always --dirty` for a checkout that HAS a
+///    repository, put through [`normalize_describe`], the same shape `dist` writes.
+///    `head_sha` (`git rev-parse --short HEAD`) accompanies it as the commit's own name,
+///    used only when the describe cannot be advertised — see below.
+///
+/// There is no third *derivation*: "git could not be asked at all" is both inputs `None`,
+/// which is spelled `<fallback>+git.unknown` — a build that cannot identify its source SAYS
+/// so, instead of advertising the bare `0.0.0` placeholder that every build ever made would
+/// share. (`dist` never reaches this state: `derive_version` fails if `git describe` does.)
+/// It is reported as [`VersionOrigin::Unknown`] rather than as [`VersionOrigin::Git`],
+/// because "derived from a checkout" and "there was no checkout" are different facts about
+/// the same string.
+///
+/// # A tag is not an identity — and this fails closed rather than rewriting it
+///
+/// `git describe` interpolates the tag name **verbatim**, and a tag may carry bytes an
+/// identity may not: this repository's own only tag is `archive/backup-premerge-signoff`,
+/// and `release/1.2.0` is a common convention. Forcing such a string into [`is_identity`]
+/// by replacing each offending byte (the obvious repair, and what an earlier revision of
+/// this module did) is **not injective**: `v1/2` and `v1.2` are distinct tags on distinct
+/// commits that would both advertise `1.2`, and two builds sharing one identity is worse
+/// than a build whose identity is coarse — a version-keyed capability matrix (proposal 0017
+/// §3) would key both onto one row, and the artifacts would collide by name.
+///
+/// So a describe that does not normalize to an advertisable identity is **not advertised**.
+/// The build is named by its COMMIT instead — `<fallback>+git.<head_sha>[.dirty]`, which is
+/// exactly the shape an untagged checkout already produces, is unique per commit, and is
+/// still a fact about this build rather than a rewrite of somebody's tag. With no `head_sha`
+/// to fall back to the identity is `<fallback>+git.unknown[.dirty]` and the origin is
+/// [`VersionOrigin::Unknown`]: nothing here can name the commit, and saying so is the honest
+/// answer. (A tag *deliberately* spelled to impersonate another build's identity —
+/// `v0.0.0+git.deadbee` — is out of this function's reach and is a signing/provenance
+/// concern, not a normalization one.)
+///
+/// # Whitespace
+///
+/// `describe` and `head_sha` are trimmed: they are a subprocess's stdout, which carries a
+/// trailing newline, and trimming *that* is parsing, not repair. `explicit` is **not**
+/// trimmed — see below.
+///
+/// # Errors
+///
+/// Rung 1 is the only input this crate does not compose itself, so it is the only one that
+/// can be malformed — and it is used **verbatim or rejected, never repaired**: a value that
+/// is not an [`is_identity`] string fails the build with a message naming it, and that
+/// includes one padded with whitespace (`" 1.2.3 "`). Trimming it would be the same silent
+/// repair as sanitizing: the build would bake `1.2.3` while `cargo xtask dist` wrote the
+/// operator's literal string into `VERSION`, and the release smoke's equality — the one
+/// mechanism that checks the wire against the tarball — would compare two different values.
+/// Empty (`""`) is not a malformed version but an ABSENT one, so the Dockerfile's unset-safe
+/// `ARG WYRD_VERSION=""` degrades to the next rung instead of failing a bare `docker build`.
+pub fn resolve_version(
+    explicit: Option<&str>,
+    describe: Option<&str>,
+    head_sha: Option<&str>,
+    fallback: &str,
+) -> Result<BuildIdentity, String> {
+    if let Some(explicit) = explicit.filter(|v| !v.is_empty()) {
+        if !is_identity(explicit) {
+            return Err(format!(
+                "{VERSION_ENV}={explicit:?} is not a usable build identity: a version is \
+                 advertised verbatim as `Server: wyrd/<version>`, recorded in the `role \
+                 started` event and written to the tarball's VERSION file, so it may carry \
+                 only ASCII letters, digits and `.`, `-`, `_`, `+` — and no surrounding \
+                 whitespace, because it is used exactly as given. Fix the value or unset it \
+                 to derive one from git."
+            ));
+        }
+        return Ok(BuildIdentity {
+            version: explicit.to_string(),
+            origin: VersionOrigin::Explicit,
+        });
+    }
+    let describe = describe.map(str::trim).filter(|d| !d.is_empty());
+    if let Some(describe) = describe {
+        let derived = normalize_describe(describe, fallback);
+        if is_identity(&derived) {
+            return Ok(BuildIdentity {
+                version: derived,
+                origin: VersionOrigin::Git,
+            });
+        }
+    }
+    // Either there was no describe at all, or it named a tag this identity grammar cannot
+    // carry. Name the COMMIT — and if even that is unavailable, say so.
+    let dirty = if describe.is_some_and(describe_is_dirty) {
+        ".dirty"
+    } else {
+        ""
+    };
+    match head_sha
+        .map(str::trim)
+        .filter(|sha| !sha.is_empty() && is_identity(sha))
+    {
+        Some(sha) => Ok(BuildIdentity {
+            version: format!("{fallback}+git.{sha}{dirty}"),
+            origin: VersionOrigin::Git,
+        }),
+        None => Ok(BuildIdentity {
+            version: format!("{fallback}+git.unknown{dirty}"),
+            origin: VersionOrigin::Unknown,
+        }),
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    /// Version normalization: the three `git describe` shapes an artifact build meets.
+    /// The same cases `xtask/tests/dist_templates.rs` pins on the packaging side — kept
+    /// here too, because this file is what a build script actually compiles.
+    #[test]
+    fn normalize_describe_covers_all_three_shapes() {
+        // No tags yet: bare short sha (git describe --always), optionally dirty.
+        assert_eq!(normalize_describe("abc12de", "0.0.0"), "0.0.0+git.abc12de");
+        assert_eq!(
+            normalize_describe("abc12de-dirty", "0.0.0"),
+            "0.0.0+git.abc12de.dirty"
+        );
+        // Exactly on a tag.
+        assert_eq!(normalize_describe("v0.1.0", "0.0.0"), "0.1.0");
+        // Past a tag.
+        assert_eq!(
+            normalize_describe("v0.1.0-3-gabc12de", "0.0.0"),
+            "0.1.0+git.3.abc12de"
+        );
+        assert_eq!(
+            normalize_describe("v0.1.0-3-gabc12de-dirty", "0.0.0"),
+            "0.1.0+git.3.abc12de.dirty"
+        );
+    }
+
+    /// **A tag is not an identity — so it is refused, and the COMMIT is named instead.**
+    ///
+    /// `git describe` interpolates the tag name verbatim and a tag may contain `/` (this
+    /// repository's only tag is `archive/backup-premerge-signoff`; `release/1.2.0` is a
+    /// common convention), a space, or arbitrary UTF-8. Every resolved identity must
+    /// nonetheless be one the S3 front door can advertise verbatim, or such a checkout would
+    /// advertise `wyrd/unknown` on the wire while the `role started` event and the tarball's
+    /// `VERSION` carried the real string — two spellings for one build.
+    ///
+    /// The answer is a decision, not a rewrite: `<fallback>+git.<sha>`, the same shape an
+    /// untagged checkout already produces, still derived from this checkout
+    /// ([`VersionOrigin::Git`]) and unique per commit. See
+    /// [`tag_normalization_never_collapses_two_builds_onto_one_identity`] for why rewriting
+    /// is not an option.
+    ///
+    /// The gateway's half of the contract is `wyrd_gateway_s3::is_advertisable_version`; the
+    /// two are pinned together over these same inputs in `crates/server/src/lib.rs` (this
+    /// file is compiled by a build script and by `xtask`, neither of which can see the
+    /// gateway crate).
+    #[test]
+    fn a_tag_that_is_not_an_identity_is_refused_and_the_commit_named_instead() {
+        for (describe, expected) in [
+            (
+                "archive/backup-premerge-signoff-1-g2ece2f1",
+                "0.0.0+git.2ece2f1",
+            ),
+            (
+                "archive/backup-premerge-signoff-1-g2ece2f1-dirty",
+                "0.0.0+git.2ece2f1.dirty",
+            ),
+            ("release/1.2.0-4-gabc12de", "0.0.0+git.2ece2f1"),
+            ("v1.0.0-rc 1-2-gabc12de", "0.0.0+git.2ece2f1"),
+            // A non-ASCII byte (an en dash) — a tag name is arbitrary text.
+            ("v1.0.0\u{2013}rc-1-gabc12de", "0.0.0+git.2ece2f1"),
+        ] {
+            // The sha git would report for HEAD in the same breath as that describe. Only
+            // the dirty case above pairs it with a different commit's expectation, so each
+            // row is read as "this describe, this HEAD ⇒ this identity".
+            let head = "2ece2f1";
+            let derived = resolve_version(None, Some(describe), Some(head), FALLBACK_VERSION)
+                .expect("a derived version is never rejected — only an override can be");
+            assert!(
+                is_identity(&derived.version),
+                "a tag name must not be able to produce an unadvertisable identity: \
+                 {describe:?} -> {:?}",
+                derived.version
+            );
+            assert_eq!(
+                derived.version, expected,
+                "an unadvertisable describe must name the commit, dirt included: {describe:?}"
+            );
+            assert_eq!(
+                derived.origin,
+                VersionOrigin::Git,
+                "the identity is still derived from this checkout"
+            );
+        }
+        // Spelled out once, so the branch's PREMISE is reviewable rather than merely
+        // asserted: the shape rules alone really do produce a string the wire cannot carry.
+        assert!(!is_identity(&normalize_describe(
+            "archive/backup-premerge-signoff-1-g2ece2f1",
+            FALLBACK_VERSION
+        )));
+        // …and with no commit name available either, it says so rather than guessing.
+        let blind = resolve_version(
+            None,
+            Some("release/1.2.0-4-gabc12de"),
+            None,
+            FALLBACK_VERSION,
+        )
+        .expect("a derived version is never rejected");
+        assert_eq!(blind.version, "0.0.0+git.unknown");
+        assert_eq!(blind.origin, VersionOrigin::Unknown);
+    }
+
+    /// **Rewriting a tag into the identity grammar is not injective, which is why this
+    /// module refuses instead.** Replacing each forbidden byte with `.` (what an earlier
+    /// revision did) maps the distinct tags `v1/2` and `v1.2` — distinct commits, distinct
+    /// releases — onto the one identity `1.2`. Two builds sharing an identity is worse than
+    /// a coarse identity: a version-keyed capability matrix (proposal 0017 §3) keys both onto
+    /// one row, and their artifacts collide by name.
+    #[test]
+    fn tag_normalization_never_collapses_two_builds_onto_one_identity() {
+        let slashed = resolve_version(None, Some("v1/2"), Some("aaa1111"), FALLBACK_VERSION)
+            .expect("a derived version is never rejected");
+        let dotted = resolve_version(None, Some("v1.2"), Some("bbb2222"), FALLBACK_VERSION)
+            .expect("a derived version is never rejected");
+        assert_ne!(
+            slashed.version, dotted.version,
+            "two distinct tags must never advertise as one build"
+        );
+        assert_eq!(
+            slashed.version, "0.0.0+git.aaa1111",
+            "the unrepresentable tag is refused and the commit named"
+        );
+        assert_eq!(dotted.version, "1.2", "a representable tag is used as-is");
+    }
+
+    /// The ordering, over injected inputs: the packaging pipeline's explicit value wins over
+    /// a repository that is *also* visible. Getting this backwards is the whole `0.0.0`
+    /// failure inverted — a host build would overwrite the version `dist` derived.
+    #[test]
+    fn an_explicit_version_wins_over_git() {
+        let resolved = resolve_version(
+            Some("0.1.0+git.3.abc12de"),
+            Some("v9.9.9"),
+            Some("9999999"),
+            FALLBACK_VERSION,
+        )
+        .expect("a well-formed override is accepted");
+        assert_eq!(
+            resolved.version, "0.1.0+git.3.abc12de",
+            "the packaging pipeline's value is used verbatim, not re-derived"
+        );
+        assert_eq!(
+            resolved.origin,
+            VersionOrigin::Explicit,
+            "a handed-in identity must be distinguishable from a derived one: it is used \
+             verbatim, so it can say anything at all"
+        );
+    }
+
+    /// **A malformed override fails the build** rather than being repaired or advertised.
+    /// It is the one input this crate does not compose itself, and both silent repairs are
+    /// worse than a build error: a rewritten value ships an identity nobody asked for and
+    /// breaks the equality the release smoke checks against `VERSION`, while an unrewritten
+    /// one degrades to `wyrd/unknown` on the wire — a build advertising nothing because of
+    /// a typo, found months later in a bug report.
+    #[test]
+    fn a_malformed_override_is_rejected_not_repaired() {
+        for hostile in [
+            "1.2.3 (build 7)",
+            "1.2.3\nX-Injected: 1",
+            "1.2.3\u{2013}rc1",
+            "1.2/3",
+        ] {
+            let err = resolve_version(
+                Some(hostile),
+                Some("abc12de"),
+                Some("abc12de"),
+                FALLBACK_VERSION,
+            )
+            .expect_err("a malformed override must fail the build");
+            assert!(
+                err.contains(VERSION_ENV),
+                "the error must name the variable to fix: {err}"
+            );
+        }
+    }
+
+    /// **A padded override is malformed, not trimmable.** `WYRD_VERSION=" 1.2.3 "` is
+    /// rejected rather than quietly resolved to `1.2.3`: rung 1 is used VERBATIM, and the
+    /// value that reaches the binary must be the value the operator (or the packaging
+    /// pipeline) supplied. Trimming would bake `1.2.3` while `cargo xtask dist` wrote the
+    /// literal string into the tarball's `VERSION`, and the release smoke's `Server:`-vs-
+    /// `VERSION` equality — the one mechanism that checks the wire against the tarball —
+    /// would compare two different strings and fail on a build nobody could see was wrong.
+    #[test]
+    fn an_override_padded_with_whitespace_is_rejected_not_trimmed() {
+        for padded in [" 1.2.3 ", "1.2.3\n", "\t1.2.3"] {
+            let err = resolve_version(Some(padded), None, None, FALLBACK_VERSION)
+                .expect_err("a padded override is malformed, not trimmable");
+            assert!(
+                err.contains(VERSION_ENV),
+                "the error must name the variable to fix: {err}"
+            );
+        }
+        // The same value without the padding is perfectly good — so the rejection above is
+        // about the bytes supplied, not about the version.
+        let clean = resolve_version(Some("1.2.3"), None, None, FALLBACK_VERSION)
+            .expect("a well-formed override is accepted");
+        assert_eq!(clean.version, "1.2.3");
+        assert_eq!(clean.origin, VersionOrigin::Explicit);
+    }
+
+    /// No override ⇒ the checkout's own `git describe`, NORMALIZED — never the raw
+    /// `v0.1.0-3-gabc12de` shape, which would put a second version spelling on the wire.
+    #[test]
+    fn without_an_override_the_normalized_describe_is_used() {
+        let tagged = resolve_version(
+            None,
+            Some("v0.1.0-3-gabc12de"),
+            Some("abc12de"),
+            FALLBACK_VERSION,
+        )
+        .expect("a derived version is never rejected");
+        assert_eq!(tagged.version, "0.1.0+git.3.abc12de");
+        assert_eq!(tagged.origin, VersionOrigin::Git);
+        let untagged = resolve_version(None, Some("abc12de"), Some("abc12de"), FALLBACK_VERSION)
+            .expect("a derived version is never rejected");
+        assert_eq!(
+            untagged.version, "0.0.0+git.abc12de",
+            "an untagged checkout is named by its commit, not by the bare placeholder"
+        );
+        assert_eq!(untagged.origin, VersionOrigin::Git);
+    }
+
+    /// **A build that cannot ask git says so.** Neither rung available — a source tarball, a
+    /// git-less machine, or the image build whose `.dockerignore` excludes `.git/` and whose
+    /// caller passed no override — yields `0.0.0+git.unknown`, NOT the bare `0.0.0`.
+    ///
+    /// That distinction is load-bearing on the wire (#736): `wyrd/0.0.0` is the workspace
+    /// placeholder every build ever made shares, so it identifies nothing and is what a
+    /// naive `CARGO_PKG_VERSION` implementation would advertise, while
+    /// `wyrd/0.0.0+git.unknown` states exactly which of those two situations produced it.
+    #[test]
+    fn a_build_that_cannot_ask_git_is_not_the_bare_placeholder() {
+        let resolved =
+            resolve_version(None, None, None, FALLBACK_VERSION).expect("no input is not an error");
+        assert_eq!(resolved.version, "0.0.0+git.unknown");
+        assert_ne!(resolved.version, "0.0.0");
+        assert_eq!(
+            resolved.origin,
+            VersionOrigin::Unknown,
+            "\"there was no checkout to ask\" is a different fact from \"derived from one\""
+        );
+    }
+
+    /// An empty input is ABSENT, not a version. `deploy/docker/wyrd/Dockerfile` declares
+    /// `ARG WYRD_VERSION=""` so a bare `docker build` still succeeds; that empty string must
+    /// fall through to the next rung rather than baking `wyrd/` with nothing after it.
+    #[test]
+    fn an_empty_override_falls_through_to_the_next_rung() {
+        let arg_unset =
+            resolve_version(Some(""), Some("abc12de"), Some("abc12de"), FALLBACK_VERSION)
+                .expect("an empty override is absent, not malformed");
+        assert_eq!(
+            arg_unset.version, "0.0.0+git.abc12de",
+            "an unset-safe empty build-arg must not win over a visible repository"
+        );
+        assert_eq!(arg_unset.origin, VersionOrigin::Git);
+        let nothing = resolve_version(Some(""), Some(""), Some(""), FALLBACK_VERSION)
+            .expect("an empty override is absent, not malformed");
+        assert_eq!(
+            nothing.version, "0.0.0+git.unknown",
+            "an empty describe is a git failure, not a version"
+        );
+        assert_eq!(nothing.origin, VersionOrigin::Unknown);
+    }
+}
