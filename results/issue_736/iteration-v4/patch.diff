+/// The tarball's `VERSION` file — what an operator reads to learn what they installed, and
+/// the string the release workflow compares the running gateway's `Server:` header against
+/// (#736). Pure — unit-tested in `ci` beside [`image_build_args`], so the two consumers of
+/// one `version` are pinned to the same string.
+pub fn version_file(version: &str, flavor: &str, fdb_version: &str) -> String {
+    format!("version: {version}\nflavor: {flavor}\nfoundationdb-clients: {fdb_version}\n")
+}
