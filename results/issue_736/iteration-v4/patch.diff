+/// The `docker buildx build` argument list for the image build. Pure — unit-tested in
+/// `ci`, which is what keeps the container half of the pipeline honest without a container
+/// (the module doc's "the pure decisions below … are unit-tested inside `ci`").
+///
+/// The coupling that most needs pinning is `WYRD_VERSION` (#736). `.dockerignore` excludes
+/// `.git/` (`:6`), and the default path compiles the binary INSIDE this image build, so the
+/// binary's build script sees no repository at all: without the version passed in, the
+/// shipped binary would advertise the repository-less `0.0.0+git.unknown` while the tarball's
+/// `VERSION` beside it named the real one — the issue's "the version matches what
+/// `cargo xtask dist` stamps into `VERSION`" violated by construction on the shipping path.
+/// It is the SAME `version` [`version_file`] writes, which is what makes that equality
+/// checkable rather than claimed.
+pub fn image_build_args(cfg: &DistConfig, version: &str, revision: &str) -> Vec<String> {
+    // `--platform linux/amd64`, PINNED: the tarball advertises
+    // `x86_64-unknown-linux-gnu` in its name, so the build must not silently
+    // follow an arm64 host's default platform and ship an aarch64 binary under
+    // an x86_64 filename (codex P1). An arm64 packaging host needs binfmt/qemu
+    // for this — a slow but honest build; release CI is amd64 anyway.
+    let mut args: Vec<String> = [
+        "buildx",
+        "build",
+        "--platform",
+        DIST_PLATFORM,
+        "--build-arg",
+        &format!("FEATURES={}", cfg.features),
+        // The build identity the binary BAKES IN (#736) — declared `ARG WYRD_VERSION` in
+        // the Dockerfile's build stage and exported to the `cargo build` there.
+        "--build-arg",
+        &format!("{}={version}", version::VERSION_ENV),
+        "--label",
+        &format!("org.opencontainers.image.version={version}"),
+        "--label",
+        &format!("org.opencontainers.image.revision={revision}"),
+        "-t",
+        &versioned_image_tag(version, &cfg.flavor),
+        "-t",
+        &flavor_image_tag(&cfg.flavor),
+        // The docker exporter loads the tagged image into the daemon (what the
+        // classic `docker build` did) — spelled explicitly because the OCI
+        // exporter below may join it.
+        "--output",
+        "type=docker",
+    ]
+    .map(str::to_string)
+    .to_vec();
+    if cfg.oci_archive {
+        // The OCI archive is a SECOND EXPORTER on the SAME build (buildx ≥0.13
+        // multi-output), never a separate build: a cache miss or any
+        // nondeterministic input in a re-build could otherwise ship an archive
+        // whose binary differs from the tarball's, silently breaking the
+        // "identical binary" guarantee (codex P1). `docker save` is no
+        // alternative — its output is Docker's legacy archive format, which
+        // OCI-only consumers (`skopeo copy oci-archive:…`) reject.
+        args.push("--output".into());
+        args.push(format!(
+            "type=oci,dest={DIST_DIR}/{}",
+            oci_archive_name(version, &cfg.flavor)
+        ));
+    }
+    args.extend(["-f", "deploy/docker/wyrd/Dockerfile", "."].map(str::to_string));
+    args
+}
