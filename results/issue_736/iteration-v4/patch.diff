+/// The Dockerfile's half of that coupling: the build stage DECLARES `ARG WYRD_VERSION` and
+/// exports it to the compile step. A build arg the Dockerfile never declares is silently
+/// dropped by docker — the binary would fall back and nothing would fail.
+#[test]
+fn the_dockerfile_declares_the_version_arg_in_the_build_stage() {
+    let dockerfile = read("deploy/docker/wyrd/Dockerfile");
+    let build_stage = dockerfile
+        .split_once("AS build")
+        .expect("the production Dockerfile has a named `build` stage")
+        .1
+        .split("\nFROM ")
+        .next()
+        .expect("the build stage runs until the next FROM")
+        .to_string();
+    assert!(
+        build_stage
+            .lines()
+            .any(|l| l.trim() == "ARG WYRD_VERSION" || l.trim().starts_with("ARG WYRD_VERSION=")),
+        "the build stage must re-declare ARG WYRD_VERSION, or docker drops the --build-arg"
+    );
+    assert!(
+        build_stage
+            .lines()
+            .any(|l| l.trim().starts_with("ENV WYRD_VERSION=")),
+        "the compile step reads WYRD_VERSION from its environment (crates/server/build.rs)"
+    );
+    // Unset-safe, exactly like FEATURES: a bare `docker build` with no --build-arg must
+    // still succeed, with the binary falling back to its own derivation.
+    assert!(
+        dockerfile.contains("ARG WYRD_VERSION=\"\""),
+        "the global ARG must default to empty so a plain `docker build` still builds"
+    );
+}
