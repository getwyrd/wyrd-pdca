new file mode 100644
index 0000000..0c3e177
--- /dev/null
+++ b/crates/server/build.rs
@@ -0,0 +1,218 @@
+//! Bake this build's identity into the binary (issue #736).
+//!
+//! Nothing on the S3 wire said what a client was talking to: no `Server` header, and no
+//! build identifier anywhere in the response path. A captured HTTP exchange did not identify
+//! the build that produced it, and `wyrd-validate`'s version-keyed capability matrix
+//! (proposal 0017 §3) had nothing to key on. The composition root is what can know the
+//! answer — a wire crate has no business shelling out to git (ADR-0010) — so it is resolved
+//! here, once, at compile time, and emitted as `WYRD_VERSION` for `env!` to read
+//! (`crates/server/src/lib.rs`, `BUILD_VERSION`).
+//!
+//! The DECISION (explicit override, else the normalized `git describe`, else the commit's
+//! own name) is [`version::resolve_version`] — pure, shared verbatim with `cargo xtask dist`
+//! (`crates/server/src/version.rs`), and unit-tested inside `cargo xtask ci`. This script
+//! owns only the impure half: asking the environment and asking git — including **which**
+//! repository may answer (see `main`'s `tracked_here`).
+//!
+//! `build.rs` is a `custom-build` crate root, so the #616 guard scans it for the crate-root
+//! attribute (`xtask/src/repo_guard.rs:148-161`, `xtask/tests/repo_hygiene_guards.rs:256-293`).
+
+#![forbid(unsafe_code)]
+
+use std::path::{Path, PathBuf};
+use std::process::Command;
+
+// The ONE version derivation, compiled rather than duplicated — see the module doc.
+#[path = "src/version.rs"]
+mod version;
+
+fn main() {
+    let manifest_dir = match std::env::var_os("CARGO_MANIFEST_DIR") {
+        Some(dir) => PathBuf::from(dir),
+        // Cargo always sets it; without it there is no checkout to ask, so fall back
+        // rather than fail a build over a missing convenience.
+        None => PathBuf::from("."),
+    };
+
+    let explicit = std::env::var(version::VERSION_ENV).ok();
+    // **Only a repository that actually tracks THIS source may name this build.** `git`
+    // walks up from its working directory, so a checkout unpacked inside an unrelated
+    // repository (a vendored copy, a source tarball extracted under someone's home repo)
+    // otherwise answers with a FOREIGN commit — and the binary would confidently advertise a
+    // sha that has nothing to do with the code in it, which is exactly the "an
+    // operator-supplied value that can silently be wrong" failure this header exists to
+    // remove. `git ls-files --error-unmatch` on this crate's own manifest is the cheap,
+    // decisive test: it succeeds only when the repository git found has this very file in
+    // its index. When it does not, both git answers below are dropped and the derivation
+    // falls to `0.0.0+git.unknown` / origin `unknown` — an honest "no repository named this
+    // build" rather than a confident lie.
+    let tracked_here = git(
+        &manifest_dir,
+        &["ls-files", "--error-unmatch", "Cargo.toml"],
+    )
+    .is_some();
+    emit_rerun_directives(&manifest_dir, tracked_here);
+    // `--dirty`, per the issue's decision 2: a binary built from an edited tree advertises
+    // `.dirty`, because an untagged dirty build in a deployment is precisely the thing worth
+    // catching, and suppressing it here would put a SECOND shape on the wire — `dist` derives
+    // with `--dirty` (`xtask/src/dist.rs:356-364`) and the two must agree. What cargo cannot
+    // do is invalidate on the working tree (see [`emit_rerun_directives`]), so the flag is a
+    // snapshot taken when this script last ran: it can go stale in the reassuring direction
+    // (a tree edited after the last re-run still says clean — exactly what omitting `--dirty`
+    // would say on every build) and in the conservative one (a build that says `.dirty` after
+    // the edits were reverted), never into naming a commit it was not built from.
+    let describe = if tracked_here {
+        git(
+            &manifest_dir,
+            &["describe", "--tags", "--always", "--dirty"],
+        )
+    } else {
+        None
+    };
+    // The commit's own name, used only when the describe carries a tag the identity grammar
+    // cannot represent — see `version::resolve_version`. Asked here, beside the describe, so
+    // both answers come from the same repository in the same moment.
+    let head_sha = if tracked_here {
+        git(&manifest_dir, &["rev-parse", "--short", "HEAD"])
+    } else {
+        None
+    };
+    // A malformed OVERRIDE fails the build, loudly, here — the only rung this crate does not
+    // compose itself. Everything the derivation produces is advertisable by construction
+    // (`version::resolve_version` refuses a describe it cannot carry), so this can never fire
+    // on a checkout's own git state.
+    let resolved = version::resolve_version(
+        explicit.as_deref(),
+        describe.as_deref(),
+        head_sha.as_deref(),
+        version::FALLBACK_VERSION,
+    )
+    .unwrap_or_else(|e| panic!("{e}"));
+    println!(
+        "cargo:rustc-env={}={}",
+        version::VERSION_ENV,
+        resolved.version
+    );
+    // ...and WHERE it came from, beside it. A verbatim override can say anything, so
+    // `wyrd/1.2.3` alone cannot tell a handed-in identity from a derived one — the `role
+    // started` event records this so an operator (and
+    // `crates/server/tests/s3_server_version_header.rs`) can.
+    println!(
+        "cargo:rustc-env={}={}",
+        version::VERSION_ORIGIN_ENV,
+        resolved.origin.as_str()
+    );
+}
+
+/// Tell cargo when to re-derive — and watch **every** input, because a partial watch set
+/// bakes a stale identity into the binary.
+///
+/// Emitting ANY `rerun-if-*` directive opts out of cargo's default "re-run when a file in the
+/// package changes" (measured: with only `rerun-if-env-changed` emitted, touching a source
+/// file does not re-run the script). So the set below is not a shortcut over that default —
+/// it replaces it, and it is complete only because the derivation reads exactly two things:
+///
+/// * `WYRD_VERSION` from the build environment ⇒ `rerun-if-env-changed`;
+/// * `git describe --tags --always --dirty` plus `git rev-parse --short HEAD`, which read
+///   **HEAD, the tag refs, and the index**. With git's default `files` ref backend those
+///   live in `HEAD` (per-worktree), the branch file `HEAD` names, `refs/heads` and
+///   `refs/tags` (loose refs) and `packed-refs`; with the `reftable` backend
+///   (`git init --ref-format=reftable`, and the default for some newer setups) none of those
+///   files exist and the whole ref store is the `reftable/` directory instead — watching only
+///   the `files` layout there leaves a repository whose new commits trigger NO re-run, so the
+///   binary ships a stale identity while still reporting `version_origin: git`. Both layouts
+///   are therefore watched, and each is resolved through `rev-parse --git-path` rather than
+///   guessed. Cargo scans a watched DIRECTORY recursively, so watching `refs/heads`,
+///   `refs/tags` and `reftable` covers a ref file that does not exist yet — creating the
+///   first tag on a repository that had none re-runs this script.
+///
+/// The `index` covers the `--dirty` half as far as anything can: git rewrites it on `add`,
+/// `checkout`, `stash`, `commit` and on any stat-cache refresh, so the common ways a tree
+/// becomes (or stops being) dirty re-derive. What cargo cannot express is "any tracked file
+/// in the workspace": that would mean re-running the script on **every** build, which marks
+/// the crate dirty and recompiles and relinks `wyrd-server` — the `wyrd` bin plus the ~40
+/// integration-test binaries — every time. So an unstaged edit that git has not yet noticed
+/// can leave `.dirty` unset until the next index write. That residual is bounded and
+/// one-directional: the identity always names the commit the source came from; only the
+/// "and it was edited" flag can lag.
+///
+/// A path that does not exist is skipped: cargo treats a missing `rerun-if-changed` target as
+/// always-changed (measured: `Dirty … the file 'nonexistent-sentinel' is missing`, then
+/// `Compiling`, on every build) — the rebuild-on-every-build cost above, taken by accident.
+fn emit_rerun_directives(dir: &Path, tracked_here: bool) {
+    println!("cargo:rerun-if-env-changed={}", version::VERSION_ENV);
+    // The script's own sources. Cargo re-runs a recompiled build script anyway; spelled out
+    // so the input list above is the whole input list.
+    println!("cargo:rerun-if-changed=build.rs");
+    println!("cargo:rerun-if-changed=src/version.rs");
+    // No repository names this source (see `main`) ⇒ nothing git holds is an input, and a
+    // FOREIGN repository's refs must not be watched: its commits are not this build's.
+    if !tracked_here {
+        return;
+    }
+
+    let mut watched = vec![
+        "HEAD".to_string(),
+        // The `files` ref backend's stores…
+        "packed-refs".to_string(),
+        "refs/heads".to_string(),
+        "refs/tags".to_string(),
+        // …and the `reftable` backend's, which replaces all three with one directory.
+        "reftable".to_string(),
+        // The working tree's proxy — see the doc above.
+        "index".to_string(),
+    ];
+    if let Some(head_ref) = git(dir, &["symbolic-ref", "-q", "HEAD"]) {
+        watched.push(head_ref);
+    }
+    let mut emitted: Vec<PathBuf> = Vec::new();
+    let mut watch = |path: PathBuf| {
+        // Cargo treats a missing target as always-changed, so only what exists is watched.
+        if path.exists() && !emitted.contains(&path) {
+            println!("cargo:rerun-if-changed={}", path.display());
+            emitted.push(path);
+        }
+    };
+    for path in watched {
+        // `rev-parse --git-path` rather than a `.git/…` join: in a linked worktree `.git` is
+        // a FILE, `HEAD` and `index` are private to the worktree, and the refs live in the
+        // common directory — which is the shape every gate here runs in.
+        let Some(resolved) = git(dir, &["rev-parse", "--git-path", &path]) else {
+            continue;
+        };
+        // `--git-path` answers relative to the directory git ran in.
+        watch(dir.join(resolved));
+    }
+    // The reftable stack in the COMMON directory. `--git-path` maps the paths git knows are
+    // shared (`packed-refs`, `refs/…`) to the common directory itself, but a name it does not
+    // know is answered against THIS worktree's git dir — where a linked worktree keeps only
+    // its own per-worktree refs. The tags `git describe` reads live in the common stack, so
+    // it is resolved explicitly rather than assumed to be the same directory.
+    if let Some(common) = git(dir, &["rev-parse", "--git-common-dir"]) {
+        watch(dir.join(common).join("reftable"));
+    }
+}
+
+/// Run `git` in `dir`, returning its trimmed stdout when it succeeds and `None` otherwise.
+///
+/// Every failure mode is the same answer — *this build cannot ask git*: no repository
+/// (the image build, whose `.dockerignore` excludes `.git/`), no `git` on PATH, a
+/// non-UTF-8 answer, or an empty one. The caller falls to the next rung; the build never
+/// fails because of it.
+fn git(dir: &Path, args: &[&str]) -> Option<String> {
+    let out = Command::new("git")
+        .args(args)
+        .current_dir(dir)
+        .output()
+        .ok()?;
+    if !out.status.success() {
+        return None;
+    }
+    let text = String::from_utf8(out.stdout).ok()?;
+    let text = text.trim().to_string();
+    if text.is_empty() {
+        None
+    } else {
+        Some(text)
+    }
+}
