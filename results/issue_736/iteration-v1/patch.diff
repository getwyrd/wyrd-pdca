new file mode 100644
index 0000000..cf5036a
--- /dev/null
+++ b/crates/server/build.rs
@@ -0,0 +1,114 @@
+//! Bake this build's identity into the binary (issue #736).
+//!
+//! Nothing on the S3 wire said what a client was talking to: no `Server` header, and no
+//! build identifier anywhere in the response path. A captured HTTP exchange did not identify
+//! the build that produced it, and `wyrd-validate`'s version-keyed capability matrix
+//! (proposal 0017 §3) had nothing to key on. The composition root is what can know the
+//! answer — a wire crate has no business shelling out to git (ADR-0010) — so it is resolved
+//! here, once, at compile time, and emitted as `WYRD_VERSION` for `env!` to read
+//! (`crates/server/src/lib.rs`, `BUILD_VERSION`).
+//!
+//! The DECISION (explicit override, then the normalized `git describe`, then the `0.0.0`
+//! placeholder) is [`version::resolve_version`] — pure, shared verbatim with
+//! `cargo xtask dist` (`crates/server/src/version.rs`), and unit-tested inside
+//! `cargo xtask ci`. This script owns only the impure half: asking the environment and
+//! asking git.
+//!
+//! `build.rs` is a `custom-build` crate root, so the #616 guard scans it for the crate-root
+//! attribute (`xtask/tests/repo_hygiene_guards.rs:256-293`).
+
+#![forbid(unsafe_code)]
+
+use std::path::{Path, PathBuf};
+use std::process::Command;
+
+// The ONE version derivation, compiled rather than duplicated — see the module doc.
+#[path = "src/version.rs"]
+mod version;
+
+/// The build environment's explicit override, set by the packaging pipeline
+/// (`cargo xtask dist` passes `--build-arg WYRD_VERSION=<v>`; the Dockerfile's build stage
+/// exports it). Named once here and once in `xtask/src/dist.rs`'s build-arg list, which
+/// `xtask/tests/dist_templates.rs` pins container-free.
+const VERSION_ENV: &str = "WYRD_VERSION";
+
+fn main() {
+    let manifest_dir = match std::env::var_os("CARGO_MANIFEST_DIR") {
+        Some(dir) => PathBuf::from(dir),
+        // Cargo always sets it; without it there is no checkout to ask, so fall back
+        // rather than fail a build over a missing convenience.
+        None => PathBuf::from("."),
+    };
+
+    // Re-derive when the override changes, when this script or the shared derivation
+    // changes, and when the checkout moves to another commit (below) — so a rebuild after a
+    // commit never serves a stale string. Emitting ANY `rerun-if-changed` opts out of
+    // cargo's "rerun on any package file" default, which is the point: the baked version
+    // depends on git and the environment, not on the crate's sources.
+    println!("cargo:rerun-if-env-changed={VERSION_ENV}");
+    println!("cargo:rerun-if-changed=build.rs");
+    println!("cargo:rerun-if-changed=src/version.rs");
+    emit_git_rerun_directives(&manifest_dir);
+
+    let explicit = std::env::var(VERSION_ENV).ok();
+    let describe = git(
+        &manifest_dir,
+        &["describe", "--tags", "--always", "--dirty"],
+    );
+    let resolved = version::resolve_version(
+        explicit.as_deref(),
+        describe.as_deref(),
+        version::FALLBACK_VERSION,
+    );
+    println!("cargo:rustc-env={VERSION_ENV}={resolved}");
+}
+
+/// Run `git` in `dir`, returning its trimmed stdout when it succeeds and `None` otherwise.
+///
+/// Every failure mode is the same answer — *this build cannot ask git*: no repository
+/// (the image build, whose `.dockerignore` excludes `.git/`), no `git` on PATH, a
+/// non-UTF-8 answer, or an empty one. The caller falls to the next rung; the build never
+/// fails because of it.
+fn git(dir: &Path, args: &[&str]) -> Option<String> {
+    let out = Command::new("git")
+        .args(args)
+        .current_dir(dir)
+        .output()
+        .ok()?;
+    if !out.status.success() {
+        return None;
+    }
+    let text = String::from_utf8(out.stdout).ok()?;
+    let text = text.trim().to_string();
+    if text.is_empty() {
+        None
+    } else {
+        Some(text)
+    }
+}
+
+/// Ask git for the files whose content decides `git describe`'s answer, and tell cargo to
+/// re-run this script when they change: `HEAD`, the ref `HEAD` points at, and
+/// `packed-refs` (where a tag may live). `rev-parse --git-path` is used rather than a
+/// `.git/…` join because in a linked worktree `.git` is a FILE and the refs live in the
+/// common directory — which is exactly the shape every gate here runs in.
+///
+/// A path that does not exist is skipped: cargo treats a missing `rerun-if-changed` target
+/// as always-changed, which would re-run this script (and relink the binary) on every
+/// build.
+fn emit_git_rerun_directives(dir: &Path) {
+    let mut watched = vec!["HEAD".to_string(), "packed-refs".to_string()];
+    if let Some(head_ref) = git(dir, &["symbolic-ref", "-q", "HEAD"]) {
+        watched.push(head_ref);
+    }
+    for path in watched {
+        let Some(resolved) = git(dir, &["rev-parse", "--git-path", &path]) else {
+            continue;
+        };
+        // `--git-path` answers relative to the directory git ran in.
+        let resolved = dir.join(resolved);
+        if resolved.exists() {
+            println!("cargo:rerun-if-changed={}", resolved.display());
+        }
+    }
+}
