+/// The profile of every build before `0.1.0`: every `wyrd` build so far (they report
+/// `0.0.0+git.<sha>`). Its bucket rows record what the gateway answers today, `400
+/// InvalidRequest`, not the `501 NotImplemented` S3 would send: #511 owns that answer, and
+/// changes the row when it changes the answer.
+pub const PRE_0_1: Profile = Profile {
+    name: "pre-0.1",
+    versions: Versions {
+        from: None,
+        below: Some(Version::release(0, 1, 0)),
+    },
+    rows: &PRE_0_1_ROWS,
+};
+
+/// The profiles this build of the validator ships, oldest first. Ranges never overlap.
+pub static PROFILES: [Profile; 1] = [PRE_0_1];
+
+/// A semantic version (semver.org 2.0.0), less its build metadata.
+#[derive(Debug, Clone, PartialEq, Eq, Hash)]
+pub struct Version {
+    pub major: u64,
+    pub minor: u64,
+    pub patch: u64,
+    /// The pre-release identifiers; empty for a release.
+    pub pre: Vec<Identifier>,
+}
+
+/// One pre-release identifier.
+#[derive(Debug, Clone, PartialEq, Eq, Hash)]
+pub enum Identifier {
+    /// Digits only.
+    Numeric(u64),
+    /// Anything else in `[0-9A-Za-z-]`.
+    Alphanumeric(String),
+}
+
+/// Why a string is not a semantic version.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct VersionError {
+    pub reason: &'static str,
+}
+
+impl fmt::Display for VersionError {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.write_str(self.reason)
+    }
+}
+
+impl std::error::Error for VersionError {}
+
+impl Version {
+    /// The release `major.minor.patch`.
+    pub const fn release(major: u64, minor: u64, patch: u64) -> Self {
+        Self {
+            major,
+            minor,
+            patch,
+            pre: Vec::new(),
+        }
+    }
+
+    /// Parse `text` by semver 2.0.0's grammar, every token checked: three numeric parts with no
+    /// leading zeros (no sign, no `v`); a pre-release of non-empty dot-separated identifiers in
+    /// `[0-9A-Za-z-]`, numeric ones with no leading zeros; build metadata of non-empty
+    /// dot-separated identifiers in `[0-9A-Za-z-]`, checked and then dropped. A number past
+    /// `u64` is refused.
+    pub fn parse(text: &str) -> Result<Self, VersionError> {
+        let error = |reason| Err(VersionError { reason });
+        let (rest, build) = match text.split_once('+') {
+            Some((rest, build)) => (rest, Some(build)),
+            None => (text, None),
+        };
+        if let Some(build) = build {
+            if !build
+                .split('.')
+                .all(|id| !id.is_empty() && is_identifier(id))
+            {
+                return error(
+                    "the build metadata is not dot-separated identifiers in [0-9A-Za-z-]",
+                );
+            }
+        }
+        let (core, pre) = match rest.split_once('-') {
+            Some((core, pre)) => (core, Some(pre)),
+            None => (rest, None),
+        };
+        let parts: Vec<&str> = core.split('.').collect();
+        let [major, minor, patch] = parts.as_slice() else {
+            return error("the version is not three dot-separated numbers");
+        };
+        let number = |part: &str| -> Result<u64, VersionError> {
+            if part.is_empty() || !part.bytes().all(|b| b.is_ascii_digit()) {
+                return Err(VersionError {
+                    reason: "a version number is not ASCII digits",
+                });
+            }
+            if part.len() > 1 && part.starts_with('0') {
+                return Err(VersionError {
+                    reason: "a version number has a leading zero",
+                });
+            }
+            part.parse().map_err(|_| VersionError {
+                reason: "a version number does not fit in 64 bits",
+            })
+        };
+        let mut version = Self::release(number(major)?, number(minor)?, number(patch)?);
+        if let Some(pre) = pre {
+            for id in pre.split('.') {
+                if id.is_empty() || !is_identifier(id) {
+                    return error(
+                        "the pre-release is not dot-separated identifiers in [0-9A-Za-z-]",
+                    );
+                }
+                version.pre.push(if id.bytes().all(|b| b.is_ascii_digit()) {
+                    Identifier::Numeric(number(id)?)
+                } else {
+                    Identifier::Alphanumeric(id.to_string())
+                });
+            }
+        }
+        Ok(version)
+    }
+}
+
+/// Every byte in `[0-9A-Za-z-]`.
+fn is_identifier(id: &str) -> bool {
+    id.bytes().all(|b| b.is_ascii_alphanumeric() || b == b'-')
+}
+
+impl Ord for Version {
+    /// Semver 2.0.0 §11 precedence: the three numbers in order; then a release outranks any of
+    /// its pre-releases; then pre-release identifiers left to right, numeric ones numerically
+    /// and below alphanumeric ones, which compare by ASCII, and a longer list outranks its own
+    /// prefix.
+    fn cmp(&self, other: &Self) -> Ordering {
+        (self.major, self.minor, self.patch)
+            .cmp(&(other.major, other.minor, other.patch))
+            .then_with(|| match (self.pre.is_empty(), other.pre.is_empty()) {
+                (true, true) => Ordering::Equal,
+                (true, false) => Ordering::Greater,
+                (false, true) => Ordering::Less,
+                (false, false) => self.pre.cmp(&other.pre),
+            })
+    }
+}
+
+impl PartialOrd for Version {
+    fn partial_cmp(&self, other: &Self) -> Option<Ordering> {
+        Some(self.cmp(other))
+    }
+}
+
+impl Ord for Identifier {
+    fn cmp(&self, other: &Self) -> Ordering {
+        match (self, other) {
+            (Self::Numeric(a), Self::Numeric(b)) => a.cmp(b),
+            (Self::Numeric(_), Self::Alphanumeric(_)) => Ordering::Less,
+            (Self::Alphanumeric(_), Self::Numeric(_)) => Ordering::Greater,
+            (Self::Alphanumeric(a), Self::Alphanumeric(b)) => a.as_bytes().cmp(b.as_bytes()),
+        }
+    }
+}
+
+impl PartialOrd for Identifier {
+    fn partial_cmp(&self, other: &Self) -> Option<Ordering> {
+        Some(self.cmp(other))
+    }
+}
+
+impl fmt::Display for Version {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        write!(f, "{}.{}.{}", self.major, self.minor, self.patch)?;
+        for (i, id) in self.pre.iter().enumerate() {
+            f.write_str(if i == 0 { "-" } else { "." })?;
+            match id {
+                Identifier::Numeric(n) => write!(f, "{n}")?,
+                Identifier::Alphanumeric(s) => f.write_str(s)?,
+            }
+        }
+        Ok(())
+    }
+}
+
+/// Why no profile was selected for a version.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum NoProfile {
+    /// The version is not a semantic version (`unknown` among them).
+    NotAVersion {
+        version: String,
+        error: VersionError,
+    },
+    /// No profile's range holds it.
+    Uncovered { version: String },
+    /// More than one profile's range holds it: the profile set is wrong, and no choice
+    /// between them would be honest.
+    Ambiguous {
+        version: String,
+        profiles: Vec<&'static str>,
+    },
+}
+
+impl fmt::Display for NoProfile {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            Self::NotAVersion { version, error } => write!(
+                f,
+                "server version `{version}` is not a semantic version ({error}), so no \
+                 capability profile can be chosen for it"
+            ),
+            Self::Uncovered { version } => write!(
+                f,
+                "no capability profile this build of wyrd-validate ships covers server version \
+                 `{version}`"
+            ),
+            Self::Ambiguous { version, profiles } => write!(
+                f,
+                "server version `{version}` falls in more than one capability profile ({})",
+                profiles.join(", ")
+            ),
+        }
+    }
+}
+
+/// The one profile of `profiles` whose range holds `version`.
+pub fn select<'p>(profiles: &'p [Profile], version: &str) -> Result<&'p Profile, NoProfile> {
+    let parsed = Version::parse(version).map_err(|error| NoProfile::NotAVersion {
+        version: version.to_string(),
+        error,
+    })?;
+    let mut holding = profiles.iter().filter(|p| p.versions.contains(&parsed));
+    match (holding.next(), holding.next()) {
+        (None, _) => Err(NoProfile::Uncovered {
+            version: version.to_string(),
+        }),
+        (Some(profile), None) => Ok(profile),
+        (Some(first), Some(second)) => Err(NoProfile::Ambiguous {
+            version: version.to_string(),
+            profiles: [first, second]
+                .into_iter()
+                .chain(holding)
+                .map(|p| p.name)
+                .collect(),
+        }),
+    }
+}
+
+/// The failure classes of proposal 0017 §7.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, PartialOrd, Ord, Hash)]
+pub enum Class {
+    /// Bytes, digest or size differ from what was written.
+    Integrity,
+    /// The server disagrees with what the run did: a deleted key still there, a listing that
+    /// is not the keys written.
+    Oracle,
+    /// An operation declared unsupported succeeded.
+    UnexpectedSupport,
+    /// A wrong status, error code, field or document shape.
+    Protocol,
+    /// No answer to judge: no response, a deadline, a `5xx` other than `501`, a body cut in
+    /// transit.
+    Availability,
+}
+
+impl Class {
+    /// The class's name in proposal 0017 §7.
+    pub fn name(self) -> &'static str {
+        match self {
+            Self::Integrity => "integrity",
+            Self::Oracle => "oracle",
+            Self::UnexpectedSupport => "unexpected-support",
+            Self::Protocol => "protocol",
+            Self::Availability => "availability",
+        }
+    }
+
+    /// Whether one failure of this class fails the run. Every class is, but `availability`,
+    /// which is counted against a budget instead.
+    pub fn is_fatal(self) -> bool {
+        self != Self::Availability
+    }
+}
+
+impl fmt::Display for Class {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.write_str(self.name())
+    }
+}
+
+/// What the judge made of one exchange.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum Verdict {
+    Pass,
+    Fail {
+        class: Class,
+        detail: String,
+    },
+    /// Nothing to judge it by: no row for the operation, a required row with no check of its
+    /// own, or an exchange that does not describe a request (a range outside the object it
+    /// names). Never a pass.
+    Unchecked {
+        detail: String,
+    },
+}
+
+/// The answer to one object request, its body read: empty for a PUT, a HEAD or a DELETE.
+pub type ObjectAnswer = Result<Answered<Vec<u8>>, S3Error>;
+
+/// One request and what was expected of it, from what the run had just done, with the answer
+/// it got.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum Exchange {
+    /// A PUT. Expected: `200` with an `ETag`.
+    PutObject { answer: ObjectAnswer },
+    /// A plain GET of an object written as `written`. Expected: `200` and exactly those bytes.
+    GetObject {
+        written: Vec<u8>,
+        answer: ObjectAnswer,
+    },
+    /// A GET with `Range: bytes=<first>-<last>` of an object written as `written`. Expected:
+    /// `206`, `Content-Range: bytes <first>-<last>/<size>` and exactly those bytes.
+    GetObjectRange {
+        written: Vec<u8>,
+        first: u64,
+        last: u64,
+        answer: ObjectAnswer,
+    },
+    /// A GET whose `If-None-Match` names the object's current `ETag`. Expected: `304`, no body.
+    GetObjectConditional { answer: ObjectAnswer },
+    /// A HEAD of an object written `size` bytes long, whose PUT answered `etag`. Expected:
+    /// `200` with that `Content-Length` and that `ETag`.
+    HeadObject {
+        size: u64,
+        etag: String,
+        answer: ObjectAnswer,
+    },
+    /// A DELETE, and a HEAD of the same key after it. Expected: `204`, then `404`.
+    DeleteObject {
+        answer: ObjectAnswer,
+        head_after: ObjectAnswer,
+    },
+    /// A bulk delete of `keys`. Expected: `200` with every key under `<Deleted>`, once, and no
+    /// `<Error>` row.
+    DeleteObjects {
+        keys: Vec<String>,
+        answer: Result<Answered<DeleteResult>, S3Error>,
+    },
+    /// ListObjectsV2 of a prefix under which the run wrote exactly `written` (key, size).
+    /// Expected: `200`, not truncated, no rollup, exactly those keys in key order with those
+    /// sizes.
+    ListObjectsV2 {
+        written: Vec<(String, u64)>,
+        answer: Result<Answered<Listing>, S3Error>,
+    },
+    /// The v1 ListObjects, expected as [`Exchange::ListObjectsV2`].
+    ListObjects {
+        written: Vec<(String, u64)>,
+        answer: Result<Answered<Listing>, S3Error>,
+    },
+    /// One request for `operation`, known only as a probe of an unsupported operation.
+    Probe {
+        operation: Operation,
+        answer: Result<Answered<()>, S3Error>,
+    },
+}
+
+impl Exchange {
+    /// The operation the exchange is a request for.
+    pub fn operation(&self) -> Operation {
+        match self {
+            Self::PutObject { .. } => Operation::PutObject,
+            Self::GetObject { .. } => Operation::GetObject,
+            Self::GetObjectRange { .. } => Operation::GetObjectRange,
+            Self::GetObjectConditional { .. } => Operation::GetObjectConditional,
+            Self::HeadObject { .. } => Operation::HeadObject,
+            Self::DeleteObject { .. } => Operation::DeleteObject,
+            Self::DeleteObjects { .. } => Operation::DeleteObjects,
+            Self::ListObjectsV2 { .. } => Operation::ListObjectsV2,
+            Self::ListObjects { .. } => Operation::ListObjects,
+            Self::Probe { operation, .. } => *operation,
+        }
+    }
+
+    /// What the endpoint answered the exchange's (first) request, as an unsupported row reads
+    /// it.
+    fn seen(&self) -> Seen<'_> {
+        match self {
+            Self::PutObject { answer }
+            | Self::GetObject { answer, .. }
+            | Self::GetObjectRange { answer, .. }
+            | Self::GetObjectConditional { answer }
+            | Self::HeadObject { answer, .. }
+            | Self::DeleteObject { answer, .. } => seen(answer),
+            Self::DeleteObjects { answer, .. } => seen(answer),
+            Self::ListObjectsV2 { answer, .. } | Self::ListObjects { answer, .. } => seen(answer),
+            Self::Probe { answer, .. } => seen(answer),
+        }
+    }
+}
+
+/// An answer as an unsupported row reads it.
+enum Seen<'a> {
+    /// A status, and the error code when the answer was an S3 error document (or no body).
+    Status {
+        status: u16,
+        code: Option<&'a ErrorCode>,
+    },
+    /// A success head arrived, and what followed it failed: its status was a success.
+    Success,
+    /// No answer to judge.
+    Nothing(&'a S3Error),
+}
+
+fn seen<T>(answer: &Result<Answered<T>, S3Error>) -> Seen<'_> {
+    match answer {
+        Ok(answered) => Seen::Status {
+            status: answered.head.status,
+            code: None,
+        },
+        Err(S3Error::Service { status, code, .. }) => Seen::Status {
+            status: *status,
+            code: Some(code),
+        },
+        Err(S3Error::Unreadable { status, .. }) => Seen::Status {
+            status: *status,
+            code: None,
+        },
+        // The caller's own source failed: the request was cut short, and nothing the endpoint
+        // said was read.
+        Err(e @ S3Error::Body(BodyError::SourceLength { .. } | BodyError::SourceFailed { .. })) => {
+            Seen::Nothing(e)
+        }
+        // Every other body error follows a success head: a PUT acknowledged before its body was
+        // sent, or a GET body that failed after a 2xx.
+        Err(S3Error::Body(_)) => Seen::Success,
+        Err(e @ (S3Error::NoResponse { .. } | S3Error::Timeout { .. })) => Seen::Nothing(e),
+        Err(e @ S3Error::RequestNotBuilt { .. }) => Seen::Nothing(e),
+    }
+}
+
+fn fail(class: Class, detail: String) -> Verdict {
+    Verdict::Fail { class, detail }
+}
+
+/// Judge `exchange` by `row` (module docs).
+pub fn judge(row: &Row, exchange: &Exchange) -> Verdict {
+    match &row.state {
+        State::Unsupported(refusal) => judge_refusal(row.operation, refusal, exchange.seen()),
+        State::Required => judge_required(exchange),
+    }
+}
+
+/// An unsupported row: its declared refusal exactly, or a failure.
+fn judge_refusal(operation: Operation, refusal: &Refusal, seen: Seen<'_>) -> Verdict {
+    let declared = format!(
+        "declared unsupported (#{}): it must answer {refusal}",
+        refusal.issue
+    );
+    match seen {
+        Seen::Status { status, .. } if (200..300).contains(&status) => fail(
+            Class::UnexpectedSupport,
+            format!("{operation} answered {status}, a success, but it is {declared}"),
+        ),
+        Seen::Success => fail(
+            Class::UnexpectedSupport,
+            format!("{operation} answered with a success, but it is {declared}"),
+        ),
+        Seen::Status {
+            status,
+            code: Some(code),
+        } if status == refusal.status && refusal.code.matches(code) => Verdict::Pass,
+        Seen::Status { status, code } => {
+            let code = code.map_or_else(|| "an unreadable body".to_string(), |c| c.to_string());
+            fail(
+                Class::Protocol,
+                format!("{operation} answered {status} with {code}; it is {declared}"),
+            )
+        }
+        Seen::Nothing(e) => fail(
+            Class::Availability,
+            format!("{operation} got no answer to judge: {e}"),
+        ),
+    }
+}
+
+/// A `5xx` that says the server could not serve, rather than that it does not implement: every
+/// `5xx` but `501 Not Implemented`.
+fn unavailable(status: u16) -> bool {
+    (500..600).contains(&status) && status != 501
+}
+
+/// A required row's failure for an answer that was not the success expected (`expected`
+/// describes it).
+fn failed(operation: Operation, e: &S3Error, expected: &str) -> Verdict {
+    let class = match e {
+        S3Error::Service { status, .. } | S3Error::Unreadable { status, .. }
+            if unavailable(*status) =>
+        {
+            Class::Availability
+        }
+        S3Error::Service { .. } | S3Error::Unreadable { .. } => Class::Protocol,
+        S3Error::NoResponse { .. } | S3Error::Timeout { .. } | S3Error::RequestNotBuilt { .. } => {
+            Class::Availability
+        }
+        S3Error::Body(
+            BodyError::SourceLength { .. }
+            | BodyError::SourceFailed { .. }
+            | BodyError::Transport { .. },
+        ) => Class::Availability,
+        S3Error::Body(
+            BodyError::AcknowledgedEarly { .. }
+            | BodyError::Length { .. }
+            | BodyError::Overrun { .. }
+            | BodyError::LengthUndeclared
+            | BodyError::Framing { .. },
+        ) => Class::Protocol,
+    };
+    fail(class, format!("{operation}: expected {expected}; got {e}"))
+}
+
+/// The success `answer` is, if its status is `want`; the failure it is otherwise.
+fn expect_status<'a, T>(
+    operation: Operation,
+    answer: &'a Result<Answered<T>, S3Error>,
+    want: u16,
+    expected: &str,
+) -> Result<&'a Answered<T>, Verdict> {
+    match answer {
+        Ok(answered) if answered.head.status == want => Ok(answered),
+        Ok(answered) => Err(fail(
+            Class::Protocol,
+            format!(
+                "{operation}: expected {expected}; got {}",
+                answered.head.status
+            ),
+        )),
+        Err(e) => Err(failed(operation, e, expected)),
+    }
+}
+
+/// `read` against `expected` byte for byte: a pass, or `integrity` naming where they part.
+fn same_bytes(operation: Operation, expected: &[u8], read: &[u8]) -> Verdict {
+    if expected == read {
+        return Verdict::Pass;
+    }
+    let differ = expected
+        .iter()
+        .zip(read)
+        .position(|(a, b)| a != b)
+        .unwrap_or(expected.len().min(read.len()));
+    fail(
+        Class::Integrity,
+        format!(
+            "{operation}: {} bytes were expected and {} came back, differing from byte {differ}",
+            expected.len(),
+            read.len()
+        ),
+    )
+}
+
+/// A decimal count as a header carries it: ASCII digits only, within `u64`.
+fn decimal(text: &str) -> Option<u64> {
+    if text.is_empty() || !text.bytes().all(|b| b.is_ascii_digit()) {
+        return None;
+    }
+    text.parse().ok()
+}
+
+/// A satisfied byte-range `Content-Range` (RFC 9110 §14.4): `bytes <first>-<last>/<size>`, as
+/// `(first, last, size)`. The unit is matched case-insensitively (§14.1), one space follows
+/// it, each number is `1*DIGIT` within `u64` (no sign, no whitespace), and the length is
+/// complete, not `*`. Anything else is `None`.
+fn byte_content_range(text: &str) -> Option<(u64, u64, u64)> {
+    let (unit, range) = text.split_once(' ')?;
+    if !unit.eq_ignore_ascii_case("bytes") {
+        return None;
+    }
+    let (span, size) = range.split_once('/')?;
+    let (first, last) = span.split_once('-')?;
+    Some((decimal(first)?, decimal(last)?, decimal(size)?))
+}
+
+/// A required row: the operation's own check (module docs).
+fn judge_required(exchange: &Exchange) -> Verdict {
+    let operation = exchange.operation();
+    let checked = match exchange {
+        Exchange::PutObject { answer } => check_put(answer),
+        Exchange::GetObject { written, answer } => {
+            expect_status(operation, answer, 200, "200 with the bytes written")
+                .map(|answered| same_bytes(operation, written, &answered.value))
+        }
+        Exchange::GetObjectRange {
+            written,
+            first,
+            last,
+            answer,
+        } => check_range(written, *first, *last, answer),
+        Exchange::GetObjectConditional { answer } => check_conditional(answer),
+        Exchange::HeadObject { size, etag, answer } => check_head(*size, etag, answer),
+        Exchange::DeleteObject { answer, head_after } => check_delete(answer, head_after),
+        Exchange::DeleteObjects { keys, answer } => check_delete_objects(keys, answer),
+        Exchange::ListObjectsV2 { written, answer } | Exchange::ListObjects { written, answer } => {
+            check_listing(operation, written, answer)
+        }
+        Exchange::Probe { operation, .. } => Ok(Verdict::Unchecked {
+            detail: format!(
+                "{operation} is declared required, but the validator has no check of its own for \
+                 it; a success alone is not a pass"
+            ),
+        }),
+    };
+    checked.unwrap_or_else(|failure| failure)
+}
+
+fn check_put(answer: &ObjectAnswer) -> Result<Verdict, Verdict> {
+    let operation = Operation::PutObject;
+    let answered = expect_status(operation, answer, 200, "200 with an ETag")?;
+    Ok(match ResponseHead::single(&answered.head.etag) {
+        Some(etag) if !etag.is_empty() => Verdict::Pass,
+        _ => fail(
+            Class::Protocol,
+            format!(
+                "{operation}: expected 200 with an ETag; the 200 carried {:?}",
+                answered.head.etag
+            ),
+        ),
+    })
+}
+
+fn check_range(
+    written: &[u8],
+    first: u64,
+    last: u64,
+    answer: &ObjectAnswer,
+) -> Result<Verdict, Verdict> {
+    let operation = Operation::GetObjectRange;
+    let range = usize::try_from(first)
+        .ok()
+        .zip(usize::try_from(last).ok())
+        .and_then(|(first, last)| written.get(first..=last));
+    let Some(expected) = range else {
+        return Ok(Verdict::Unchecked {
+            detail: format!(
+                "{operation}: the range {first}-{last} is not inside the {} bytes written",
+                written.len()
+            ),
+        });
+    };
+    let size = written.len() as u64;
+    let expecting = format!("206 with Content-Range: bytes {first}-{last}/{size}");
+    let answered = expect_status(operation, answer, 206, &expecting)?;
+    let said = ResponseHead::single(&answered.head.content_range).and_then(byte_content_range);
+    if said != Some((first, last, size)) {
+        return Ok(fail(
+            Class::Protocol,
+            format!(
+                "{operation}: expected {expecting}; the 206 carried Content-Range {:?}",
+                answered.head.content_range
+            ),
+        ));
+    }
+    Ok(same_bytes(operation, expected, &answered.value))
+}
+
+fn check_conditional(answer: &ObjectAnswer) -> Result<Verdict, Verdict> {
+    let operation = Operation::GetObjectConditional;
+    let expected = "304 with no body";
+    Ok(match answer {
+        Err(S3Error::Service {
+            status: 304,
+            code: ErrorCode::NoBody,
+            ..
+        }) => Verdict::Pass,
+        Ok(answered) => fail(
+            Class::Protocol,
+            format!(
+                "{operation}: expected {expected} to a GET whose If-None-Match names the object's \
+                 current ETag; got {} with {} bytes",
+                answered.head.status,
+                answered.value.len()
+            ),
+        ),
+        Err(e) => failed(operation, e, expected),
+    })
+}
+
+fn check_head(size: u64, etag: &str, answer: &ObjectAnswer) -> Result<Verdict, Verdict> {
+    let operation = Operation::HeadObject;
+    let answered = expect_status(
+        operation,
+        answer,
+        200,
+        "200 with the size and the PUT's ETag",
+    )?;
+    let head = &answered.head;
+    match ResponseHead::single(&head.content_length).and_then(decimal) {
+        None => {
+            return Ok(fail(
+                Class::Protocol,
+                format!(
+                    "{operation}: the 200 carried no one Content-Length ({:?})",
+                    head.content_length
+                ),
+            ))
+        }
+        Some(length) if length != size => {
+            return Ok(fail(
+                Class::Integrity,
+                format!("{operation}: the object is {length} bytes long; {size} were written"),
+            ))
+        }
+        Some(_) => {}
+    }
+    Ok(match ResponseHead::single(&head.etag) {
+        None => fail(
+            Class::Protocol,
+            format!("{operation}: the 200 carried no one ETag ({:?})", head.etag),
+        ),
+        Some(read) if read != etag => fail(
+            Class::Oracle,
+            format!(
+                "{operation}: the ETag is {read}; the PUT that wrote the object answered {etag}"
+            ),
+        ),
+        Some(_) => Verdict::Pass,
+    })
+}
+
+fn check_delete(answer: &ObjectAnswer, head_after: &ObjectAnswer) -> Result<Verdict, Verdict> {
+    let operation = Operation::DeleteObject;
+    expect_status(operation, answer, 204, "204")?;
+    Ok(match head_after {
+        Err(S3Error::Service { status: 404, .. }) => Verdict::Pass,
+        Ok(answered) => fail(
+            Class::Oracle,
+            format!(
+                "{operation}: the key is still there: a HEAD after the 204 answered {}",
+                answered.head.status
+            ),
+        ),
+        Err(e) => failed(operation, e, "a HEAD of the deleted key to answer 404"),
+    })
+}
+
+fn check_delete_objects(
+    keys: &[String],
+    answer: &Result<Answered<DeleteResult>, S3Error>,
+) -> Result<Verdict, Verdict> {
+    let operation = Operation::DeleteObjects;
+    let answered = expect_status(
+        operation,
+        answer,
+        200,
+        "200 naming every key under <Deleted>",
+    )?;
+    let result = &answered.value;
+    if !result.errors.is_empty() {
+        let rows: Vec<String> = result
+            .errors
+            .iter()
+            .map(|e| format!("`{}` ({})", e.key, e.code))
+            .collect();
+        return Ok(fail(
+            Class::Protocol,
+            format!(
+                "{operation}: the 200 carried {} <Error> row(s), so those keys were not \
+                 deleted: {}",
+                rows.len(),
+                rows.join(", ")
+            ),
+        ));
+    }
+    let mut asked = keys.to_vec();
+    asked.sort();
+    let mut deleted = result.deleted.clone();
+    deleted.sort();
+    Ok(if deleted == asked {
+        Verdict::Pass
+    } else {
+        fail(
+            Class::Protocol,
+            format!(
+                "{operation}: the <Deleted> rows name {deleted:?}; the request named {asked:?}, \
+                 each to be named once"
+            ),
+        )
+    })
+}
+
+fn check_listing(
+    operation: Operation,
+    written: &[(String, u64)],
+    answer: &Result<Answered<Listing>, S3Error>,
+) -> Result<Verdict, Verdict> {
+    let answered = expect_status(
+        operation,
+        answer,
+        200,
+        "200 naming exactly the keys written",
+    )?;
+    let listing = &answered.value;
+    if listing.is_truncated {
+        return Ok(fail(
+            Class::Oracle,
+            format!(
+                "{operation}: the page is truncated, so more keys lie under the prefix than the \
+                 {} this run wrote there",
+                written.len()
+            ),
+        ));
+    }
+    if !listing.common_prefixes.is_empty() {
+        return Ok(fail(
+            Class::Oracle,
+            format!(
+                "{operation}: an undelimited listing rolled keys up into {:?}",
+                listing.common_prefixes
+            ),
+        ));
+    }
+    let mut expected = written.to_vec();
+    expected.sort();
+    let listed: Vec<(String, u64)> = listing
+        .objects
+        .iter()
+        .map(|object| (object.key.clone(), object.size))
+        .collect();
+    if listed == expected {
+        return Ok(Verdict::Pass);
+    }
+    let missing: Vec<&(String, u64)> = expected.iter().filter(|e| !listed.contains(e)).collect();
+    let extra: Vec<&(String, u64)> = listed.iter().filter(|l| !expected.contains(l)).collect();
+    Ok(fail(
+        Class::Oracle,
+        format!(
+            "{operation}: the listing is not the keys this run wrote there, in key order: \
+             missing or changed {missing:?}, not written {extra:?}, listed {listed:?}"
+        ),
+    ))
+}
+
+/// One failure a run recorded.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Finding {
+    pub operation: Operation,
+    pub class: Class,
+    pub detail: String,
+}
+
+/// How many exchanges of one operation passed, and how many did not.
+#[derive(Debug, Clone, Copy, Default, PartialEq, Eq)]
+pub struct Counts {
+    pub passed: u64,
+    pub not_passed: u64,
