+//! The `smoke` scenario (proposal 0017 §8; #743): every operation of the capability matrix
+//! against a live endpoint, judged by the profile its version selects ([`crate::matrix`]).
+//!
+//! # The first request
+//!
+//! One ListObjectsV2 of `<run-id>/` with `max-keys=1` (0017 §15, "Refuse an occupied
+//! namespace"). Anything listed means the run prefix is occupied, and the run exits with the
+//! usage status before it writes a byte, naming the prefix and `--run-id`; nothing is claimed
+//! about the rest of the bucket. The same answer's `Server: wyrd/<version>` header (#736) names
+//! the version the endpoint is judged as, unless `--server-version` is given, which wins; the
+//! echo says which. With neither usable (no header, or `wyrd/unknown`, or a header that names no
+//! Wyrd version) the run is INCONCLUSIVE before any request that writes. So is a version no
+//! profile covers, and a profile with gaps ([`Profile::gaps`]). Any failure of this first
+//! request, an availability failure included, ends the run INCONCLUSIVE at once: there is no
+//! profile yet to judge it by.
+//!
+//! # One sweep
+//!
+//! Under `<run-id>/sweep-<n>/`: PUT one object at each size class up to 64 KiB (0 B, 1 B,
+//! 4 KiB, 64 KiB at every tuning, [`crate::sizes`]), each body derived ([`crate::payload`]);
+//! GET each whole; GET the largest as a range and conditionally (`If-None-Match` with its
+//! `ETag`); HEAD each; send one request for each operation the matrix knows only as unsupported;
+//! list the sweep's prefix with ListObjectsV2 and v1; DELETE the smallest object singly and
+//! HEAD it; bulk-delete the rest. Every answer is judged as it arrives, and the first that does
+//! not pass stops the run. The probes come after the PUTs, so CopyObject has a source, and
+//! before the listings, so a probe that wrote a key while refusing shows up as a key nobody
+//! wrote. Every request that could write names a key under the run prefix, or, for
+//! CreateBucket and DeleteBucket, a bucket named from the run id ([`scratch_bucket`]).
+//!
+//! # Ownership
+//!
+//! Every key the run writes, and the scratch bucket, is recorded in the run's ledger before the
+//! request that could create it is sent; a refusal answered as declared takes it out again,
+//! since it wrote nothing. Every delete is checked against that ledger, and refused for a key
+//! not in it: deletes are by membership, never by name shape and never from a listing
+//! (0017 §15, "Delete-time ownership verification"). A sweep deletes what it wrote; on PASS
+//! whatever is still recorded is deleted too; on FAIL or INCONCLUSIVE nothing more is deleted
+//! and the keys are printed (0017 §8, "retain on failure").
+//!
+//! # Scale
+//!
+//! The sweep repeats until `--duration` has elapsed: at least one whole sweep, and the sweep
+//! running at the deadline finishes (0017 §8, the vacuity gate's wall-clock floor). One worker
+//! only in this slice: a `--workers` other than `1` asks for a scale smoke cannot honour, so the
+//! run is INCONCLUSIVE before any request ([`preflight`]). Smoke's availability budget is zero:
+//! the first availability failure ends the run INCONCLUSIVE, with what it wrote left in place,
+//! since a mutation whose outcome is unknown needs 0017 §7's outcome resolution, which this
+//! slice does not have.
+
+use std::collections::BTreeSet;
+use std::io::Write;
+use std::time::Duration;
+
+use sha2::{Digest, Sha256};
+use tokio::time::Instant;
+
+use crate::matrix::{
+    self, Exchange, ObjectAnswer, Operation, Profile, RunVerdict, State, Tally, Verdict,
+};
+use crate::payload::Payload;
+use crate::s3::{
+    Answered, GetOptions, ListRequest, ListVersion, Listing, ObjectBody, Probe, PutSource,
+    ResponseHead, S3Client, S3Error, LIST_MAX_KEYS,
+};
+use crate::{ResolvedConfig, EXIT_FAIL, EXIT_INCONCLUSIVE, EXIT_IO, EXIT_OK, EXIT_USAGE};
+
+/// The scenarios this build runs. `--scenario` naming any other is refused by name.
+pub const SCENARIOS: [&str; 1] = ["smoke"];
+
+/// The largest object a sweep writes: the size classes up to here are written each sweep.
+pub const LARGEST_OBJECT: u64 = 64 * 1024;
+
+/// The upload id the multipart probes name: no upload has it.
+const PROBE_UPLOAD_ID: &str = "wyrd-validate-smoke-no-such-upload";
+
+/// The bucket CreateBucket and DeleteBucket name for `run_id`: `wyrd-validate-` and the first
+/// 16 hex digits of the SHA-256 of the run id. A valid S3 bucket name whatever the run id
+/// holds, and one no other run id names, short of a hash collision. Never the run's own
+/// `--bucket`, which a DeleteBucket that started working could remove.
+pub fn scratch_bucket(run_id: &str) -> String {
+    let digest = Sha256::digest(run_id.as_bytes());
+    let hex: String = digest.iter().take(8).map(|b| format!("{b:02x}")).collect();
+    format!("wyrd-validate-{hex}")
+}
+
+/// Why smoke cannot run the configuration at all, before any request: today, a worker count
+/// other than one.
+pub fn preflight(config: &ResolvedConfig) -> Result<(), String> {
+    if config.args.worker_count != 1 {
+        return Err(format!(
+            "smoke runs one worker in this release, and `--workers {}` asks for a scale it \
+             cannot honour; no request was sent and nothing was validated — INCONCLUSIVE",
+            config.args.workers
+        ));
+    }
+    Ok(())
+}
+
+/// Where the version a run is judged as came from.
+struct ServerVersion {
+    text: String,
+    /// How the echo names its source.
+    source: String,
+}
+
+/// The version to judge the endpoint as: `--server-version` when given, else the version the
+/// endpoint's one `Server: wyrd/<version>` header names. Why neither is usable, otherwise.
+fn server_version(given: Option<&str>, server: &[String]) -> Result<ServerVersion, String> {
+    if let Some(given) = given {
+        let header = match server {
+            [] => "no Server header".to_string(),
+            values => format!("the Server header says `{}`", values.join("`, `")),
+        };
+        return Ok(ServerVersion {
+            text: given.to_string(),
+            source: format!("given; {header}"),
+        });
+    }
+    let unusable = |why: String| {
+        Err(format!(
+            "{why}, and `--server-version` was not given, so no capability profile can be \
+             chosen; pass `--server-version <VERSION>` to name the release to judge it as"
+        ))
+    };
+    let header = match server {
+        [] => return unusable("the endpoint sent no Server header naming its version".into()),
+        [one] => one,
+        many => {
+            return unusable(format!(
+                "the endpoint sent {} Server headers (`{}`)",
+                many.len(),
+                many.join("`, `")
+            ))
+        }
+    };
+    // `Server: product *( RWS ( product / comment ) )` (RFC 9110 §10.2.4): the first product.
+    let first = header.split([' ', '\t']).next().unwrap_or_default();
+    match first.strip_prefix("wyrd/") {
+        Some("unknown") => unusable(format!(
+            "the endpoint's Server header is `{header}`: it does not know which version it runs"
+        )),
+        Some(version) if !version.is_empty() => Ok(ServerVersion {
+            text: version.to_string(),
+            source: "from Server header".to_string(),
+        }),
+        _ => unusable(format!(
+            "the endpoint's Server header `{header}` does not name a Wyrd version"
+        )),
+    }
+}
+
+/// Run smoke over `config`, judged by the profile of `profiles` the endpoint's version selects,
+/// and return the exit status. The echo continues on `out`; the summary goes to `err`.
+pub(crate) async fn run(
+    config: &ResolvedConfig,
+    profiles: &[Profile],
+    out: &mut dyn Write,
+    err: &mut dyn Write,
+) -> u8 {
+    let client = S3Client::new(config);
+    let run_prefix = format!("{}/", config.args.run_id);
+    // Clock: tokio's runtime clock (`tokio::time::Instant`), the one every client deadline
+    // sleeps on. It owns the run's duration alone: the start, the deadline and the elapsed time
+    // the summary reports are all read from it, and the run starts with its first request.
+    let started = Instant::now();
+
+    // The first request: is the run prefix empty, and which version answers.
+    let first = client
+        .list_objects(&ListRequest {
+            version: ListVersion::V2,
+            prefix: run_prefix.clone(),
+            max_keys: 1,
+        })
+        .await;
+    let first = match first {
+        Ok(first) => first,
+        Err(e) => {
+            return inconclusive(
+                err,
+                &format!(
+                    "the first request, a ListObjectsV2 of `{run_prefix}`, failed, so nothing \
+                     was written: {e}"
+                ),
+            )
+        }
+    };
+    if let Some(occupant) = occupant(&first.value) {
+        let _ = writeln!(
+            err,
+            "wyrd-validate: the run prefix `{run_prefix}` is occupied ({occupant}): smoke writes \
+             only under a prefix it has just seen empty, so it wrote nothing; choose a \
+             `--run-id` no other run has used"
+        );
+        return EXIT_USAGE;
+    }
+    let version = match server_version(config.args.server_version.as_deref(), &first.head.server) {
+        Ok(version) => version,
+        Err(why) => return inconclusive(err, &why),
+    };
+    let echoed = writeln!(
+        out,
+        "wyrd-validate: server\n  server-version = {} ({})",
+        version.text, version.source
+    )
+    .and_then(|()| out.flush());
+    if let Err(e) = echoed {
+        let _ = writeln!(err, "wyrd-validate: cannot write to stdout: {e}");
+        return EXIT_IO;
+    }
+    let profile = match matrix::select(profiles, &version.text) {
+        Ok(profile) => profile,
+        Err(no) => {
+            return inconclusive(
+                err,
+                &format!(
+                    "{no}; pass `--server-version <VERSION>` to name the release to judge it as"
+                ),
+            )
+        }
+    };
+    let echoed = writeln!(out, "  profile = {} ({})", profile.name, profile.versions)
+        .and_then(|()| out.flush());
+    if let Err(e) = echoed {
+        let _ = writeln!(err, "wyrd-validate: cannot write to stdout: {e}");
+        return EXIT_IO;
+    }
+    let gaps = profile.gaps();
+    if !gaps.is_empty() {
+        return inconclusive(
+            err,
+            &format!(
+                "capability profile `{}` cannot judge a sweep: {}",
+                profile.name,
+                gaps.join("; ")
+            ),
+        );
+    }
+    let sizes: Vec<u64> = match config.tuning.size_classes() {
+        Ok(classes) => classes
+            .iter()
+            .map(|class| class.size)
+            .filter(|&size| size <= LARGEST_OBJECT)
+            .collect(),
+        Err(e) => return inconclusive(err, &format!("no size table: {e}")),
+    };
+
+    let mut smoke = Smoke {
+        client: &client,
+        profile,
+        seed: &config.args.seed,
+        run_prefix,
+        scratch_bucket: scratch_bucket(&config.args.run_id),
+        sizes,
+        ledger: Ledger::default(),
+        tally: Tally::new(),
+    };
+    // The first request was a ListObjectsV2 of a prefix the run has written nothing under.
+    let first_judged = smoke.judge(Exchange::ListObjectsV2 {
+        written: Vec::new(),
+        answer: Ok(first),
+    });
+
+    // `None` only for a duration past what the clock can represent: the run then sweeps until
+    // an answer stops it.
+    let deadline = started.checked_add(config.args.run_length);
+    let mut sweeps = 0u64;
+    let stopped = match first_judged {
+        Err(Stopped) => true,
+        Ok(()) => loop {
+            let swept = smoke.sweep(sweeps).await;
+            if swept.is_err() {
+                break true;
+            }
+            sweeps += 1;
+            if deadline.is_some_and(|deadline| Instant::now() >= deadline) {
+                break false;
+            }
+        },
+    };
+    let elapsed = started.elapsed();
+
+    let mut verdict = smoke.tally.verdict(profile);
+    if verdict == RunVerdict::Pass {
+        smoke.clean_up().await;
+        if !smoke.ledger.is_empty() {
+            // Validation passed, but the run could not remove what it wrote.
+            verdict = RunVerdict::Inconclusive;
+        }
+    }
+    smoke.report(
+        err,
+        verdict,
+        &version.text,
+        Progress {
+            sweeps,
+            stopped,
+            elapsed,
+            duration: &config.args.duration,
+        },
+    );
+    match verdict {
+        RunVerdict::Pass => EXIT_OK,
+        RunVerdict::Fail => EXIT_FAIL,
+        RunVerdict::Inconclusive => EXIT_INCONCLUSIVE,
+    }
+}
+
+/// What the occupancy check found under the run prefix, in words; `None` when it is empty.
+fn occupant(listing: &Listing) -> Option<String> {
+    match (listing.objects.first(), listing.common_prefixes.first()) {
+        (Some(object), _) => Some(format!("`{}` is already there", object.key)),
+        (None, Some(prefix)) => Some(format!("`{prefix}` is already there")),
+        // Nothing on the page, but the page says more follows: something is there.
+        (None, None) if listing.is_truncated => Some("the listing says keys follow".into()),
+        (None, None) => None,
+    }
+}
+
+/// Report an INCONCLUSIVE end before any sweep and return its status.
+fn inconclusive(err: &mut dyn Write, why: &str) -> u8 {
+    let _ = writeln!(
+        err,
+        "wyrd-validate: {why}; no request that writes was sent and nothing was validated — \
+         INCONCLUSIVE"
+    );
+    EXIT_INCONCLUSIVE
+}
+
+/// The first answer that did not pass stopped the run.
+struct Stopped;
+
+/// How far a run got, for the summary.
+struct Progress<'a> {
+    sweeps: u64,
+    stopped: bool,
+    elapsed: Duration,
+    duration: &'a str,
+}
+
+/// What this run wrote and so may delete (module docs, "Ownership").
+#[derive(Debug, Default)]
+struct Ledger {
+    keys: BTreeSet<String>,
+    buckets: BTreeSet<String>,
+}
+
+impl Ledger {
+    fn is_empty(&self) -> bool {
+        self.keys.is_empty() && self.buckets.is_empty()
+    }
+}
+
+/// What a request might create: a key, or a bucket.
+enum Creates {
+    Key(String),
+    Bucket(String),
+}
+
+/// One object a sweep writes.
+struct Written {
+    key: String,
+    size: u64,
+    payload: Payload,
+    /// The `ETag` its PUT answered.
+    etag: Option<String>,
+}
+
+impl Written {
+    /// Its bytes, whole. Sweep objects are at most [`LARGEST_OBJECT`] long.
+    fn bytes(&self) -> Vec<u8> {
+        self.payload.pieces().flatten().collect()
+    }
+}
+
+struct Smoke<'a> {
+    client: &'a S3Client,
+    profile: &'a Profile,
+    seed: &'a str,
+    run_prefix: String,
+    scratch_bucket: String,
+    sizes: Vec<u64>,
+    ledger: Ledger,
+    tally: Tally,
+}
+
+impl Smoke<'_> {
+    /// Judge `exchange`, record the verdict, and stop the run unless it passed.
+    fn judge(&mut self, exchange: Exchange) -> Result<(), Stopped> {
+        let operation = exchange.operation();
+        let verdict = self.profile.judge(&exchange);
+        let passed = verdict == Verdict::Pass;
+        self.tally.record(operation, verdict);
+        if passed {
+            Ok(())
+        } else {
+            Err(Stopped)
+        }
+    }
+
+    /// Whether the profile declares `operation` unsupported.
+    fn unsupported(&self, operation: Operation) -> bool {
+        matches!(
+            self.profile.row(operation).map(|row| row.state),
+            Some(State::Unsupported(_))
+        )
+    }
+
+    async fn sweep(&mut self, n: u64) -> Result<(), Stopped> {
+        let prefix = format!("{}sweep-{n}/", self.run_prefix);
+        let mut objects: Vec<Written> = self
+            .sizes
+            .iter()
+            .map(|&size| {
+                let key = format!("{prefix}obj-{size}");
+                Written {
+                    payload: Payload::new(self.seed, &key, size, 1),
+                    key,
+                    size,
+                    etag: None,
+                }
+            })
+            .collect();
+        let copy_source = objects.last().map(|o| o.key.clone()).unwrap_or_default();
+
+        for object in &mut objects {
+            // Recorded before the request, so an answer that never arrives still leaves the key
+            // owned, and so kept and reported.
+            self.ledger.keys.insert(object.key.clone());
+            let source = PutSource::new(
+                object.size,
+                futures_util::stream::iter(
+                    object
+                        .payload
+                        .pieces()
+                        .map(|piece| Ok::<_, std::io::Error>(bytes::Bytes::from(piece))),
+                ),
+            );
+            let answer = self
+                .client
+                .put_object_answer(&object.key, source)
+                .await
+                .map(|answered| no_body(answered.head));
+            object.etag = answer
+                .as_ref()
+                .ok()
+                .and_then(|answered| ResponseHead::single(&answered.head.etag))
+                .map(str::to_owned);
+            self.judge(Exchange::PutObject { answer })?;
+            if self.unsupported(Operation::PutObject) {
+                // Refused as declared: nothing was written.
+                self.ledger.keys.remove(&object.key);
+            }
+        }
+        if self.unsupported(Operation::PutObject) {
+            // Nothing to read, list or delete; the rows that need an object stay unexercised,
+            // and the run cannot pass.
+            return self.probes(&prefix, &copy_source).await;
+        }
+
+        for object in &objects {
+            let answer = self
+                .get(&object.key, &GetOptions::default(), object.size)
+                .await;
+            self.judge(Exchange::GetObject {
+                written: object.bytes(),
+                answer,
+            })?;
+        }
+        if let Some(target) = objects.last() {
+            // An interior range, neither end of the object.
+            let (first, last) = (target.size / 4 + 1, target.size * 3 / 4);
+            let range = GetOptions {
+                range: Some((first, last)),
+                ..GetOptions::default()
+            };
+            let answer = self.get(&target.key, &range, last - first + 1).await;
+            self.judge(Exchange::GetObjectRange {
+                written: target.bytes(),
+                first,
+                last,
+                answer,
+            })?;
+            let conditional = GetOptions {
+                if_none_match: target.etag.clone(),
+                ..GetOptions::default()
+            };
+            let answer = self.get(&target.key, &conditional, target.size).await;
+            self.judge(Exchange::GetObjectConditional { answer })?;
+        }
+        for object in &objects {
+            let answer = self.head(&object.key).await;
+            self.judge(Exchange::HeadObject {
+                size: object.size,
+                etag: object.etag.clone().unwrap_or_default(),
+                answer,
+            })?;
+        }
+
+        self.probes(&prefix, &copy_source).await?;
+
+        let written: Vec<(String, u64)> = objects.iter().map(|o| (o.key.clone(), o.size)).collect();
+        for version in [ListVersion::V2, ListVersion::V1] {
+            let answer = self
+                .client
+                .list_objects(&ListRequest {
+                    version,
+                    prefix: prefix.clone(),
+                    max_keys: LIST_MAX_KEYS,
+                })
+                .await;
+            let written = written.clone();
+            self.judge(match version {
+                ListVersion::V2 => Exchange::ListObjectsV2 { written, answer },
+                ListVersion::V1 => Exchange::ListObjects { written, answer },
+            })?;
+        }
+
+        let Some((single, rest)) = objects.split_first() else {
+            return Ok(());
+        };
+        let answer = self.delete_owned(&single.key).await;
+        let head_after = self.head(&single.key).await;
+        self.judge(Exchange::DeleteObject { answer, head_after })?;
+        if !self.unsupported(Operation::DeleteObject) {
+            self.ledger.keys.remove(&single.key);
+        }
+        if !rest.is_empty() {
+            let keys: Vec<String> = rest.iter().map(|o| o.key.clone()).collect();
+            let answer = self.delete_objects_owned(&keys).await;
+            self.judge(Exchange::DeleteObjects {
+                keys: keys.clone(),
+                answer,
+            })?;
+            if !self.unsupported(Operation::DeleteObjects) {
+                for key in &keys {
+                    self.ledger.keys.remove(key);
+                }
+            }
+        }
+        Ok(())
+    }
+
+    /// One request for each operation the matrix knows only as unsupported.
+    async fn probes(&mut self, prefix: &str, copy_source: &str) -> Result<(), Stopped> {
+        let copy_target = format!("{prefix}copy-target");
+        let upload_target = format!("{prefix}multipart-target");
+        let upload = |key: &str| (key.to_string(), PROBE_UPLOAD_ID.to_string());
+        let probes = [
+            (
+                Operation::CopyObject,
+                Probe::CopyObject {
+                    source: copy_source.to_string(),
+                    key: copy_target.clone(),
+                },
+                Some(Creates::Key(copy_target)),
+            ),
+            (
+                Operation::CreateMultipartUpload,
+                Probe::CreateMultipartUpload {
+                    key: upload_target.clone(),
+                },
+                None,
+            ),
+            {
+                let (key, upload_id) = upload(&upload_target);
+                (
+                    Operation::UploadPart,
+                    Probe::UploadPart { key, upload_id },
+                    Some(Creates::Key(upload_target.clone())),
+                )
+            },
+            {
+                let (key, upload_id) = upload(&upload_target);
+                (
+                    Operation::CompleteMultipartUpload,
+                    Probe::CompleteMultipartUpload { key, upload_id },
+                    Some(Creates::Key(upload_target.clone())),
+                )
+            },
+            {
+                let (key, upload_id) = upload(&upload_target);
+                (
+                    Operation::AbortMultipartUpload,
+                    Probe::AbortMultipartUpload { key, upload_id },
+                    None,
+                )
+            },
+            {
+                let (key, upload_id) = upload(&upload_target);
+                (
+                    Operation::ListParts,
+                    Probe::ListParts { key, upload_id },
+                    None,
+                )
+            },
+            (
+                Operation::ListMultipartUploads,
+                Probe::ListMultipartUploads,
+                None,
+            ),
+            (Operation::GetBucketLocation, Probe::GetBucketLocation, None),
+            (
+                Operation::CreateBucket,
+                Probe::CreateBucket {
+                    bucket: self.scratch_bucket.clone(),
+                },
+                Some(Creates::Bucket(self.scratch_bucket.clone())),
+            ),
+            (
+                Operation::DeleteBucket,
+                Probe::DeleteBucket {
+                    bucket: self.scratch_bucket.clone(),
+                },
+                None,
+            ),
+            (Operation::ListBuckets, Probe::ListBuckets, None),
+            (Operation::HeadBucket, Probe::HeadBucket, None),
+        ];
+        for (operation, probe, creates) in probes {
+            match &creates {
+                Some(Creates::Key(key)) => {
+                    self.ledger.keys.insert(key.clone());
+                }
+                Some(Creates::Bucket(bucket)) => {
+                    self.ledger.buckets.insert(bucket.clone());
+                }
+                None => {}
+            }
+            let answer = self.client.probe(&probe).await.map(|answered| Answered {
+                head: answered.head,
+                value: (),
+            });
+            self.judge(Exchange::Probe { operation, answer })?;
+            // Passed, so refused as declared ([`Profile::gaps`] keeps a probe from being a
+            // required row): it created nothing.
+            match creates {
+                Some(Creates::Key(key)) => {
+                    self.ledger.keys.remove(&key);
+                }
+                Some(Creates::Bucket(bucket)) => {
+                    self.ledger.buckets.remove(&bucket);
+                }
+                None => {}
+            }
+        }
+        Ok(())
+    }
+
+    /// GET `key` in the form of `options` and read its body, up to one byte past the
+    /// `expected` length: a longer body is cut there, for the judge to see it is too long.
+    async fn get(&self, key: &str, options: &GetOptions, expected: u64) -> ObjectAnswer {
+        let answered = self.client.get_object_with(key, options).await?;
+        let cap = usize::try_from(expected.saturating_add(1)).unwrap_or(usize::MAX);
+        let value = read_up_to(answered.value, cap).await?;
+        Ok(Answered {
+            head: answered.head,
+            value,
+        })
+    }
+
+    async fn head(&self, key: &str) -> ObjectAnswer {
+        self.client
+            .head_object(key)
+            .await
+            .map(|answered| no_body(answered.head))
+    }
+
+    /// DELETE `key`, if this run wrote it; refused, with nothing sent, otherwise.
+    async fn delete_owned(&self, key: &str) -> ObjectAnswer {
+        if !self.ledger.keys.contains(key) {
+            return Err(not_owned(key));
+        }
+        self.client
+            .delete_object_answer(key)
+            .await
+            .map(|answered| no_body(answered.head))
+    }
+
+    /// Bulk-delete `keys`, if this run wrote every one; refused, with nothing sent, otherwise.
+    async fn delete_objects_owned(
+        &self,
+        keys: &[String],
+    ) -> Result<Answered<crate::s3::DeleteResult>, S3Error> {
+        if let Some(key) = keys.iter().find(|key| !self.ledger.keys.contains(*key)) {
+            return Err(not_owned(key));
+        }
+        self.client.delete_objects(keys).await
+    }
+
+    /// On PASS: delete what the ledger still holds, by DeleteObject, one key at a time. A sweep
+    /// deletes what it wrote, so this is normally nothing.
+    async fn clean_up(&mut self) {
+        let keys: Vec<String> = self.ledger.keys.iter().cloned().collect();
+        for key in keys {
+            if self.delete_owned(&key).await.is_ok() {
+                self.ledger.keys.remove(&key);
+            }
+        }
+    }
+
+    /// The summary, on `err`.
+    fn report(&self, err: &mut dyn Write, verdict: RunVerdict, version: &str, progress: Progress) {
+        let profile = self.profile;
+        let mut text = format!(
+            "wyrd-validate: smoke {verdict}\n  profile = {} ({}), server version {version}\n",
+            profile.name, profile.versions
+        );
+        if progress.stopped {
+            text.push_str(&format!(
+                "  sweeps = {} completed; stopped in sweep {} at the first answer that did not \
+                 pass\n",
+                progress.sweeps, progress.sweeps
+            ));
+        } else {
+            text.push_str(&format!("  sweeps = {}\n", progress.sweeps));
+        }
+        text.push_str(&format!(
+            "  elapsed = {:.3} s (--duration {})\n",
+            progress.elapsed.as_secs_f64(),
+            progress.duration
+        ));
+        for finding in self.tally.findings() {
+            text.push_str(&format!("  {}: {}\n", finding.class, finding.detail));
+        }
+        for (operation, detail) in self.tally.unchecked() {
+            text.push_str(&format!("  unchecked {operation}: {detail}\n"));
+        }
+        for row in profile.rows {
+            let counts = self.tally.counts(row.operation);
+            let state = match row.state {
+                State::Required => "required".to_string(),
+                State::Unsupported(refusal) => {
+                    format!("unsupported (#{}), must answer {refusal}", refusal.issue)
+                }
+            };
+            text.push_str(&format!(
+                "  {}: {state}; {} passed, {} did not\n",
+                row.operation, counts.passed, counts.not_passed
+            ));
+        }
+        let unexercised = self.tally.unexercised(profile);
+        if !unexercised.is_empty() && verdict != RunVerdict::Fail {
+            let names: Vec<&str> = unexercised.iter().map(|op| op.name()).collect();
+            text.push_str(&format!("  never passed: {}\n", names.join(", ")));
+        }
+        if self.ledger.is_empty() {
+            text.push_str("  left in place: nothing; every key this run wrote is deleted\n");
+        } else {
+            for key in &self.ledger.keys {
+                text.push_str(&format!(
+                    "  left in place (written, or possibly written, by this run): {key}\n"
+                ));
+            }
+            for bucket in &self.ledger.buckets {
+                text.push_str(&format!(
+                    "  left in place (possibly created by this run): bucket {bucket}\n"
+                ));
+            }
+        }
+        let _ = err.write_all(text.as_bytes());
+    }
+}
+
+/// A success with no body read.
+fn no_body(head: ResponseHead) -> Answered<Vec<u8>> {
+    Answered {
+        head,
+        value: Vec::new(),
+    }
+}
+
+/// The refusal of a delete for a key this run did not write.
+fn not_owned(key: &str) -> S3Error {
+    S3Error::RequestNotBuilt {
+        detail: format!("refusing to delete `{key}`: this run did not write it"),
+    }
+}
+
+/// `body` read to its end, or to `cap` bytes, whichever is first. Dropped at the cap, which
+/// closes its connection.
+async fn read_up_to(mut body: ObjectBody, cap: usize) -> Result<Vec<u8>, S3Error> {
+    let mut bytes = Vec::new();
+    while bytes.len() < cap {
+        let Some(piece) = body.next_piece().await? else {
+            break;
+        };
+        let room = cap - bytes.len();
+        bytes.extend_from_slice(&piece[..piece.len().min(room)]);
+    }
+    Ok(bytes)
+}
