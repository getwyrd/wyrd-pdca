+/// `--duration`'s grammar: one or more ASCII digits, then exactly one unit, `s` (seconds),
+/// `m` (minutes), `h` (hours) or `d` (days), lowercase, with nothing before, between or after.
+/// No sign, no fraction, no whitespace, no compound (`1h30m`). Zero is refused: a run of no
+/// length has no time to validate anything in. A length past `u64` seconds is refused rather
+/// than clamped. The reason is returned for the caller to name the flag.
+pub fn parse_duration(text: &str) -> Result<Duration, &'static str> {
+    let (digits, unit) = match text.char_indices().last() {
+        Some((at, unit)) => (&text[..at], unit),
+        None => return Err("it is empty"),
+    };
+    let seconds_per_unit: u64 = match unit {
+        's' => 1,
+        'm' => 60,
+        'h' => 60 * 60,
+        'd' => 24 * 60 * 60,
+        _ => return Err("it does not end in one of the units `s`, `m`, `h` or `d`"),
+    };
+    if digits.is_empty() || !digits.bytes().all(|byte| byte.is_ascii_digit()) {
+        return Err("the number before the unit is not a whole number of ASCII digits");
+    }
+    // Digits only and non-empty, so the one way left to fail is overflow.
+    let count: u64 = digits.parse().map_err(|_| "it does not fit in 64 bits")?;
+    if count == 0 {
+        return Err("a run of no length validates nothing");
+    }
+    let seconds = count
+        .checked_mul(seconds_per_unit)
+        .ok_or("it does not fit in 64 bits of seconds")?;
+    Ok(Duration::from_secs(seconds))
+}
