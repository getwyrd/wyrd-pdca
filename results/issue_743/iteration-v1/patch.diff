+//! The SDK's outputs do not carry what the capability matrix judges: the status line itself
+//! (a `206` and a `200` are both "success" to it), the `Server` header the server version is read
+//! from (#736), or the raw bytes of a listing or a bulk-delete result, which the client reads
+//! strictly itself (`super::document`) rather than through the SDK's reader. So a [`Capture`]
+//! sits on every call that needs them, at the hooks the SDK runs for every response it reads:
+//! before deserialization for the head, after it for the body, once the SDK has buffered it.
+
+use std::sync::{Arc, OnceLock};
+
+use aws_sdk_s3::config::http::HttpResponse;
+use aws_sdk_s3::config::interceptors::{
+    AfterDeserializationInterceptorContextRef, BeforeDeserializationInterceptorContextRef,
+};
+use aws_sdk_s3::config::{ConfigBag, Intercept, RuntimeComponents};
+use aws_sdk_s3::error::BoxError;
+use bytes::Bytes;
+
+/// The status of a response and the header fields a scenario reads, as the endpoint sent them.
+///
+/// Each field keeps every line it was sent on, in order: a field sent twice is two values,
+/// never one picked for the caller ([`ResponseHead::single`] answers only for a field sent
+/// once). A value that is not UTF-8 is kept with its bad bytes replaced, so it never compares
+/// equal to a value a check expects.
+#[derive(Debug, Clone, Default, PartialEq, Eq)]
+pub struct ResponseHead {
+    /// The HTTP status.
+    pub status: u16,
+    /// `Server`: the product the endpoint names itself as (`wyrd/<version>`, #736).
+    pub server: Vec<String>,
+    /// `ETag`.
+    pub etag: Vec<String>,
+    /// `Content-Length`.
+    pub content_length: Vec<String>,
+    /// `Content-Range`.
+    pub content_range: Vec<String>,
+    /// `x-amz-request-id`.
+    pub request_id: Vec<String>,
+}
+
+impl ResponseHead {
+    /// The head of `response`.
+    fn of(response: &HttpResponse) -> Self {
+        let values = |name: &str| -> Vec<String> {
+            response
+                .headers()
+                .get_all_bytes(name)
+                .map(|value| String::from_utf8_lossy(value).into_owned())
+                .collect()
+        };
+        Self {
+            status: response.status().as_u16(),
+            server: values("server"),
+            etag: values("etag"),
+            content_length: values("content-length"),
+            content_range: values("content-range"),
+            request_id: values("x-amz-request-id"),
+        }
+    }
+
+    /// The value of a field the response carried exactly once; `None` when it carried none, or
+    /// more than one.
+    pub fn single(values: &[String]) -> Option<&str> {
+        match values {
+            [one] => Some(one),
+            _ => None,
+        }
+    }
+}
+
+/// Records a call's response head and, for a call that answers with a document, the body the
+/// SDK buffered. Cloned into the call; the original keeps the record.
+#[derive(Debug, Clone)]
+pub(super) struct Capture {
+    head: Arc<OnceLock<ResponseHead>>,
+    /// `None` for a call whose body is not kept.
+    body: Option<Arc<OnceLock<Bytes>>>,
+}
+
+impl Capture {
+    /// The head only.
+    pub(super) fn head() -> Self {
+        Self {
+            head: Arc::new(OnceLock::new()),
+            body: None,
+        }
+    }
+
+    /// The head and a success's buffered body. Only for calls whose body the SDK buffers
+    /// whole under a [`super::response::ResponseGuard`] cap: a streamed body is the caller's.
+    pub(super) fn head_and_body() -> Self {
+        Self {
+            head: Arc::new(OnceLock::new()),
+            body: Some(Arc::new(OnceLock::new())),
+        }
+    }
+
+    /// The recorded head. The hook that records it runs for every response the SDK hands back
+    /// as a success, so a success always has one.
+    pub(super) fn recorded_head(&self) -> ResponseHead {
+        self.head
+            .get()
+            .cloned()
+            .expect("the capture hook records the head of every response the SDK reads")
+    }
+
+    /// The recorded success body, if one was kept: always, for a success of a call built with
+    /// [`Capture::head_and_body`], since the SDK has buffered it by the time it deserializes.
+    pub(super) fn recorded_body(&self) -> Option<Bytes> {
+        self.body.as_ref().and_then(|slot| slot.get().cloned())
+    }
+}
+
+impl Intercept for Capture {
+    fn name(&self) -> &'static str {
+        "wyrd-validate response capture"
+    }
+
+    fn read_before_deserialization(
+        &self,
+        context: &BeforeDeserializationInterceptorContextRef<'_>,
+        _runtime_components: &RuntimeComponents,
+        _cfg: &mut ConfigBag,
+    ) -> Result<(), BoxError> {
+        // One response per call (retries are off), so the slot is empty here.
+        let _ = self.head.set(ResponseHead::of(context.response()));
+        Ok(())
+    }
+
+    fn read_after_deserialization(
+        &self,
+        context: &AfterDeserializationInterceptorContextRef<'_>,
+        _runtime_components: &RuntimeComponents,
+        _cfg: &mut ConfigBag,
+    ) -> Result<(), BoxError> {
+        let response = context.response();
+        if let Some(slot) = self
+            .body
+            .as_ref()
+            .filter(|_| response.status().is_success())
+        {
+            // The SDK has read the body whole before it deserialized (`aws-smithy-runtime`
+            // 1.16.0 `client/orchestrator.rs:526-536`), already capped by the response guard.
+            if let Some(bytes) = response.body().bytes() {
+                let _ = slot.set(Bytes::copy_from_slice(bytes));
+            }
+        }
+        Ok(())
+    }
+}
