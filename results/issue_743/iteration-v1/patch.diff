+    pub fn unexercised(&self, profile: &Profile) -> Vec<Operation> {
+        profile
+            .rows
+            .iter()
+            .map(|row| row.operation)
+            .filter(|&operation| self.counts(operation).passed == 0)
+            .collect()
+    }
