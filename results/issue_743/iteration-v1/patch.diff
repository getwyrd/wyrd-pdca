+/// A listing answer of `objects`.
+fn listing(objects: &[(&str, u64)], is_truncated: bool) -> Result<Answered<Listing>, S3Error> {
+    Ok(Answered {
+        head: head(200),
+        value: Listing {
+            objects: objects
+                .iter()
+                .map(|(key, size)| ListedObject {
+                    key: (*key).to_string(),
+                    size: *size,
+                })
+                .collect(),
+            common_prefixes: Vec::new(),
+            is_truncated,
+        },
+    })
+}
