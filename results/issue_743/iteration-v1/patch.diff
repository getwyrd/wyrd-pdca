+    /// FAIL on any fatal failure, whatever else passed. Otherwise INCONCLUSIVE if anything went
+    /// unanswered or unjudged, or a row of `profile` never passed; PASS only when every row
+    /// passed at least once and nothing else happened.
+    pub fn verdict(&self, profile: &Profile) -> RunVerdict {
+        if self.findings.iter().any(|f| f.class.is_fatal()) {
+            RunVerdict::Fail
+        } else if !self.findings.is_empty()
+            || !self.unchecked.is_empty()
+            || !self.unexercised(profile).is_empty()
+        {
+            RunVerdict::Inconclusive
+        } else {
+            RunVerdict::Pass
+        }
+    }
