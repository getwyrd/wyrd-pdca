+++ b/crates/validate/src/s3/document.rs
@@ -0,0 +1,307 @@
+//! The strict reading of the two success documents the client reads (#743): a listing,
+//! `<ListBucketResult>` (ListObjectsV2 and the v1 ListObjects), and a bulk-delete result,
+//! `<DeleteResult>`.
+//!
+//! The SDK parses both too, and a document it cannot parse is already unreadable. Its reader is
+//! not trusted with the rest: like the error-document reader it replaces (#853), it accepts a
+//! document that is cut off or followed by junk. So the body the SDK buffered (capped at
+//! [`super::DOCUMENT_BODY_BUDGET`]) is read again here, by the rules `super::response`'s
+//! `error_document` holds an `<Error>` to: UTF-8, one well-formed XML document nested at most
+//! 16 elements deep, under the expected root, with nothing but the XML declaration, whitespace
+//! and comments around it. Every field read is text only and appears at most once in its row;
+//! a field the reading needs and does not find is an error, never a default.
+
+use roxmltree::{Document, Node};
+
+use super::response::{nests_deeper_than, MAX_ERROR_DOCUMENT_DEPTH};
+
+/// One `<Contents>` row of a listing.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct ListedObject {
+    /// `<Key>`, as the document spells it once its XML escapes are read.
+    pub key: String,
+    /// `<Size>`, in bytes.
+    pub size: u64,
+}
+
+/// What a listing page says.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Listing {
+    /// The `<Contents>` rows, in document order.
+    pub objects: Vec<ListedObject>,
+    /// The `<CommonPrefixes>` rollups, in document order.
+    pub common_prefixes: Vec<String>,
+    /// `<IsTruncated>`: whether more keys follow this page.
+    pub is_truncated: bool,
+}
+
+/// One `<Error>` row of a bulk-delete result: a key the server did not delete.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct DeleteError {
+    /// `<Key>`.
+    pub key: String,
+    /// `<Code>`.
+    pub code: String,
+}
+
+/// What a bulk-delete result says.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct DeleteResult {
+    /// The `<Key>` of every `<Deleted>` row, in document order.
+    pub deleted: Vec<String>,
+    /// Every `<Error>` row, in document order.
+    pub errors: Vec<DeleteError>,
+}
+
+/// A listing page, or why `body` is not one.
+///
+/// `<IsTruncated>` must be there, once, `true` or `false`; every `<Contents>` has one `<Key>`
+/// and one `<Size>` (ASCII digits, within `u64`); every `<CommonPrefixes>` one `<Prefix>`. A
+/// `<KeyCount>` (ListObjectsV2) must be digits and count exactly the rows the page holds,
+/// `<Contents>` and `<CommonPrefixes>` together: a page that disagrees with itself is not read
+/// as either of its two answers.
+pub(super) fn listing(body: &[u8]) -> Result<Listing, String> {
+    let text = utf8(body)?;
+    let document = parse(text, "ListBucketResult")?;
+    let root = document.root_element();
+    let mut objects = Vec::new();
+    let mut common_prefixes = Vec::new();
+    for row in elements(root) {
+        match row.tag_name().name() {
+            "Contents" => {
+                let key = required_text(row, "Key")?;
+                let size = required_text(row, "Size")?;
+                let size = decimal(&size).ok_or_else(|| {
+                    format!("the <Size> of `{key}` is not a byte count: `{size}`")
+                })?;
+                objects.push(ListedObject { key, size });
+            }
+            "CommonPrefixes" => common_prefixes.push(required_text(row, "Prefix")?),
+            _ => {}
+        }
+    }
+    let is_truncated = match required_text(root, "IsTruncated")?.as_str() {
+        "true" => true,
+        "false" => false,
+        other => return Err(format!("<IsTruncated> is `{other}`, not `true` or `false`")),
+    };
+    if let Some(count) = optional_text(root, "KeyCount")? {
+        let rows = objects.len() + common_prefixes.len();
+        if decimal(&count) != Some(rows as u64) {
+            return Err(format!(
+                "<KeyCount> is `{count}`, but the page holds {rows} rows (<Contents> and \
+                 <CommonPrefixes>)"
+            ));
+        }
+    }
+    Ok(Listing {
+        objects,
+        common_prefixes,
+        is_truncated,
+    })
+}
+
+/// A bulk-delete result, or why `body` is not one: every `<Deleted>` has one `<Key>`, and every
+/// `<Error>` one `<Key>` and one `<Code>`.
+pub(super) fn delete_result(body: &[u8]) -> Result<DeleteResult, String> {
+    let text = utf8(body)?;
+    let document = parse(text, "DeleteResult")?;
+    let mut deleted = Vec::new();
+    let mut errors = Vec::new();
+    for row in elements(document.root_element()) {
+        match row.tag_name().name() {
+            "Deleted" => deleted.push(required_text(row, "Key")?),
+            "Error" => errors.push(DeleteError {
+                key: required_text(row, "Key")?,
+                code: required_text(row, "Code")?,
+            }),
+            _ => {}
+        }
+    }
+    Ok(DeleteResult { deleted, errors })
+}
+
+fn utf8(body: &[u8]) -> Result<&str, String> {
+    std::str::from_utf8(body).map_err(|e| format!("the response body is not UTF-8: {e}"))
+}
+
+/// `text` as one whole XML document whose root element is `<root>`, with nothing but comments
+/// around it (the parser itself refuses text and elements there and keeps no whitespace).
+fn parse<'a>(text: &'a str, root: &str) -> Result<Document<'a>, String> {
+    // Before the parser, which recurses once per level with no limit of its own
+    // (`super::response::error_document` has the reasoning).
+    if nests_deeper_than(text.as_bytes(), MAX_ERROR_DOCUMENT_DEPTH) {
+        return Err(format!(
+            "the response body nests elements more than {MAX_ERROR_DOCUMENT_DEPTH} deep, and a \
+             <{root}> is three deep"
+        ));
+    }
+    let document = Document::parse(text)
+        .map_err(|e| format!("the response body is not a well-formed XML document: {e}"))?;
+    let found = document.root_element();
+    if found.tag_name().name() != root {
+        return Err(format!(
+            "the response body is an XML document whose root is <{}>, not <{root}>",
+            found.tag_name().name()
+        ));
+    }
+    if document
+        .root()
+        .children()
+        .any(|node| node != found && !node.is_comment())
+    {
+        return Err(format!(
+            "the <{root}> document has something other than whitespace or comments around it"
+        ));
+    }
+    Ok(document)
+}
+
+/// The element children of `node`.
+fn elements<'a, 'input>(node: Node<'a, 'input>) -> impl Iterator<Item = Node<'a, 'input>> {
+    node.children().filter(Node::is_element)
+}
+
+/// The text of `parent`'s one `<name>` child, or `None` when it has none. More than one, or one
+/// that holds anything but text (an element, a comment, a processing instruction), is an error.
+fn optional_text(parent: Node<'_, '_>, name: &str) -> Result<Option<String>, String> {
+    let mut found = None;
+    for child in elements(parent).filter(|child| child.tag_name().name() == name) {
+        let text = child
+            .children()
+            .map(|node| {
+                node.is_text()
+                    .then(|| node.text())
+                    .flatten()
+                    .ok_or_else(|| format!("a <{name}> holds markup, not only text"))
+            })
+            .collect::<Result<String, String>>()?;
+        if found.replace(text).is_some() {
+            return Err(format!(
+                "a <{}> has more than one <{name}>",
+                parent.tag_name().name()
+            ));
+        }
+    }
+    Ok(found)
+}
+
+/// As [`optional_text`], with the child required.
+fn required_text(parent: Node<'_, '_>, name: &str) -> Result<String, String> {
+    optional_text(parent, name)?
+        .ok_or_else(|| format!("a <{}> has no <{name}>", parent.tag_name().name()))
+}
+
+/// A decimal count: ASCII digits only (no sign, no whitespace, so not `u64::from_str`'s
+/// grammar, which takes a `+`), non-empty, within `u64`.
+fn decimal(text: &str) -> Option<u64> {
+    if text.is_empty() || !text.bytes().all(|byte| byte.is_ascii_digit()) {
+        return None;
+    }
+    text.parse().ok()
+}
+
+#[cfg(test)]
+mod tests {
+    //! The two readers over hand-written documents: what each accepts, and the shapes it refuses
+    //! rather than reads as an answer.
+
+    use super::*;
+
+    const NS: &str = "xmlns=\"http://s3.amazonaws.com/doc/2006-03-01/\"";
+
+    fn page(rows: &str, key_count: Option<usize>, truncated: &str) -> String {
+        let key_count = key_count
+            .map(|n| format!("<KeyCount>{n}</KeyCount>"))
+            .unwrap_or_default();
+        format!(
+            "<?xml version=\"1.0\" encoding=\"UTF-8\"?><ListBucketResult {NS}><Name>b</Name>\
+             <Prefix>p/</Prefix>{key_count}<MaxKeys>100</MaxKeys>\
+             <IsTruncated>{truncated}</IsTruncated>{rows}</ListBucketResult>"
+        )
+    }
+
+    const ROWS: &str = "<Contents><Key>p/a&amp;b</Key><ETag>&quot;x&quot;</ETag><Size>3</Size>\
+                        </Contents><Contents><Key>p/c</Key><Size>0</Size></Contents>";
+
+    #[test]
+    fn a_listing_reads_its_rows_in_order_with_escapes_resolved() {
+        let read = listing(page(ROWS, Some(2), "false").as_bytes()).expect("a listing");
+        assert_eq!(
+            read,
+            Listing {
+                objects: vec![
+                    ListedObject {
+                        key: "p/a&b".into(),
+                        size: 3
+                    },
+                    ListedObject {
+                        key: "p/c".into(),
+                        size: 0
+                    },
+                ],
+                common_prefixes: Vec::new(),
+                is_truncated: false,
+            }
+        );
+        // v1 carries no <KeyCount>.
+        assert!(listing(page(ROWS, None, "true").as_bytes()).is_ok_and(|l| l.is_truncated));
+    }
+
+    #[test]
+    fn a_listing_that_disagrees_with_itself_or_is_cut_is_refused() {
+        for (case, body) in [
+            ("key count", page(ROWS, Some(3), "false")),
+            ("truncation flag", page(ROWS, Some(2), "False")),
+            (
+                "missing flag",
+                page(ROWS, Some(2), "false").replace("<IsTruncated>false</IsTruncated>", ""),
+            ),
+            (
+                "signed size",
+                page(ROWS, Some(2), "false").replace(">3<", ">+3<"),
+            ),
+            (
+                "two keys in a row",
+                page(ROWS, Some(2), "false")
+                    .replace("<Key>p/c</Key>", "<Key>p/c</Key><Key>q</Key>"),
+            ),
+            (
+                "markup in a key",
+                page(ROWS, Some(2), "false").replace("p/c", "p/<!--x-->c"),
+            ),
+            ("cut off", {
+                let whole = page(ROWS, Some(2), "false");
+                whole[..whole.len() - 4].to_string()
+            }),
+            ("trailing junk", page(ROWS, Some(2), "false") + "junk"),
+            (
+                "another root",
+                page(ROWS, Some(2), "false").replace("ListBucketResult", "Error"),
+            ),
+        ] {
+            assert!(listing(body.as_bytes()).is_err(), "{case}: {body}");
+        }
+    }
+
+    #[test]
+    fn a_delete_result_reads_deleted_and_error_rows() {
+        let body = format!(
+            "<DeleteResult {NS}><Deleted><Key>a</Key></Deleted><Error><Key>b</Key>\
+             <Code>AccessDenied</Code><Message>no</Message></Error></DeleteResult>"
+        );
+        assert_eq!(
+            delete_result(body.as_bytes()).expect("a result"),
+            DeleteResult {
+                deleted: vec!["a".into()],
+                errors: vec![DeleteError {
+                    key: "b".into(),
+                    code: "AccessDenied".into()
+                }],
+            }
+        );
+        let codeless = body.replace("<Code>AccessDenied</Code>", "");
+        assert!(delete_result(codeless.as_bytes()).is_err());
+        assert!(delete_result(format!("{body}<x/>").as_bytes()).is_err());
+    }
+}
