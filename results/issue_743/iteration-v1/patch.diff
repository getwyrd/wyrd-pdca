+//! The capability matrix (proposal 0017 §3; #743): for every S3 operation the validator knows,
+//! what a Wyrd release is declared to answer, and the pure judge of an observed answer.
+//!
+//! # Rows and profiles
+//!
+//! A [`Row`] declares one [`Operation`] `required` — it must succeed, and its answer must pass
+//! that operation's own check — or `unsupported(#NNN)`, naming the issue that will implement it
+//! and the exact status and S3 error code (or "no body", for a `HEAD`) it must be refused with.
+//! Each row cites where its answer comes from. A [`Profile`] is the whole table for one range of
+//! server versions. Profiles are **immutable once a release ships and retained**: landing an
+//! operation adds a profile for the versions that have it and never edits the one before, so a
+//! newer validator still judges an older release by that release's table (0017 §3, "Profiles
+//! are versioned and retained"). [`PROFILES`] is the set this build ships; today it holds one,
+//! [`PRE_0_1`], for every version below `0.1.0`, which is every build so far.
+//!
+//! # Versions
+//!
+//! A profile covers a range of [`Version`]s, compared by semantic-versioning precedence on the
+//! release part (`MAJOR.MINOR.PATCH` with any pre-release). Build metadata (`+git.<sha>`) is
+//! checked and then ignored, so every build of one release selects one profile. The identity a
+//! `wyrd` build reports has the shape `normalize_describe` gives it
+//! (`crates/server/src/version/derivation.rs:30-41`): `0.0.0+git.<sha>[.dirty]` before any tag,
+//! `0.1.0` on a tag, `0.1.0+git.3.<sha>` past one. [`select`] picks the one profile whose range
+//! holds a version; a version no profile covers, or that does not parse (`unknown` among them),
+//! selects nothing.
+//!
+//! # The judge
+//!
+//! [`judge`] maps a row and an observed [`Exchange`] to a [`Verdict`], from the client's typed
+//! [`S3Error`] and the response head, never from a message string. An `unsupported` row passes
+//! only its declared refusal, exactly; **any success to it is a fatal `unexpected-support`**
+//! (#504's silent overwrite, generalised); any other answer is `protocol`. A `required` row
+//! passes only its own check, against what the run just did — the bytes it wrote, the range it
+//! asked for, the `ETag` its PUT got back, the keys it wrote — and fails in the class of
+//! proposal 0017 §7 its answer earns: `integrity` for bytes or a size that differ, `oracle` for
+//! a server that disagrees with what the run did (a deleted key still there, a listing that is
+//! not the keys written), `protocol` for a wrong status, field or document shape,
+//! `availability` for no answer, a `5xx` other than `501`, or a body cut in transit. A
+//! [`Tally`] of verdicts gives a run's [`RunVerdict`]: FAIL on any fatal failure, whatever else
+//! passed; otherwise INCONCLUSIVE unless every row passed at least once and nothing went
+//! unanswered.
+
+use std::cmp::Ordering;
+use std::collections::BTreeMap;
+use std::fmt;
+
+use crate::s3::{Answered, BodyError, DeleteResult, ErrorCode, Listing, ResponseHead, S3Error};
+
+/// Every S3 operation the validator knows. A ranged GET, a conditional GET and the v1 listing
+/// are rows of their own: each is a form a client relies on, and each has its own answer.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, PartialOrd, Ord, Hash)]
+pub enum Operation {
+    PutObject,
+    GetObject,
+    /// GetObject with `Range: bytes=<first>-<last>`.
+    GetObjectRange,
+    /// GetObject with `If-None-Match: <the object's ETag>`.
+    GetObjectConditional,
+    HeadObject,
+    DeleteObject,
+    /// Bulk delete, `POST /<bucket>?delete`.
+    DeleteObjects,
+    ListObjectsV2,
+    /// The v1 listing.
+    ListObjects,
+    CopyObject,
+    CreateMultipartUpload,
+    UploadPart,
+    CompleteMultipartUpload,
+    AbortMultipartUpload,
+    ListParts,
+    ListMultipartUploads,
+    GetBucketLocation,
+    CreateBucket,
+    DeleteBucket,
+    ListBuckets,
+    HeadBucket,
+}
+
+impl Operation {
+    /// Every operation, in the order the matrix lists them.
+    pub const ALL: [Self; 21] = [
+        Self::PutObject,
+        Self::GetObject,
+        Self::GetObjectRange,
+        Self::GetObjectConditional,
+        Self::HeadObject,
+        Self::DeleteObject,
+        Self::DeleteObjects,
+        Self::ListObjectsV2,
+        Self::ListObjects,
+        Self::CopyObject,
+        Self::CreateMultipartUpload,
+        Self::UploadPart,
+        Self::CompleteMultipartUpload,
+        Self::AbortMultipartUpload,
+        Self::ListParts,
+        Self::ListMultipartUploads,
+        Self::GetBucketLocation,
+        Self::CreateBucket,
+        Self::DeleteBucket,
+        Self::ListBuckets,
+        Self::HeadBucket,
+    ];
+
+    /// The operation's S3 name, with the form for the two GET forms.
+    pub fn name(self) -> &'static str {
+        match self {
+            Self::PutObject => "PutObject",
+            Self::GetObject => "GetObject",
+            Self::GetObjectRange => "GetObject(Range)",
+            Self::GetObjectConditional => "GetObject(If-None-Match)",
+            Self::HeadObject => "HeadObject",
+            Self::DeleteObject => "DeleteObject",
+            Self::DeleteObjects => "DeleteObjects",
+            Self::ListObjectsV2 => "ListObjectsV2",
+            Self::ListObjects => "ListObjects",
+            Self::CopyObject => "CopyObject",
+            Self::CreateMultipartUpload => "CreateMultipartUpload",
+            Self::UploadPart => "UploadPart",
+            Self::CompleteMultipartUpload => "CompleteMultipartUpload",
+            Self::AbortMultipartUpload => "AbortMultipartUpload",
+            Self::ListParts => "ListParts",
+            Self::ListMultipartUploads => "ListMultipartUploads",
+            Self::GetBucketLocation => "GetBucketLocation",
+            Self::CreateBucket => "CreateBucket",
+            Self::DeleteBucket => "DeleteBucket",
+            Self::ListBuckets => "ListBuckets",
+            Self::HeadBucket => "HeadBucket",
+        }
+    }
+
+    /// Whether [`judge`] has a check of its own for this operation as a `required` row. The
+    /// others are known only as probes of an unsupported operation, so a profile that declared
+    /// one required could never see it pass ([`Profile::gaps`]).
+    pub fn has_required_check(self) -> bool {
+        matches!(
+            self,
+            Self::PutObject
+                | Self::GetObject
+                | Self::GetObjectRange
+                | Self::GetObjectConditional
+                | Self::HeadObject
+                | Self::DeleteObject
+                | Self::DeleteObjects
+                | Self::ListObjectsV2
+                | Self::ListObjects
+        )
+    }
+}
+
+impl fmt::Display for Operation {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.write_str(self.name())
+    }
+}
+
+/// The S3 error code an unsupported operation is declared to be refused with.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum Declared {
+    /// The `<Code>` of the error document.
+    Code(&'static str),
+    /// No body at all: the refusal of a `HEAD`, which carries none.
+    NoBody,
+}
+
+impl Declared {
+    /// Whether `code`, as the client read it, is this one.
+    pub fn matches(self, code: &ErrorCode) -> bool {
+        match (self, code) {
+            (Self::Code(declared), ErrorCode::Code(read)) => declared == read,
+            (Self::NoBody, ErrorCode::NoBody) => true,
+            _ => false,
+        }
+    }
+}
+
+/// How an unsupported operation must be refused, and which issue will implement it.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct Refusal {
+    /// The issue that will implement the operation.
+    pub issue: u32,
+    /// The HTTP status of the refusal.
+    pub status: u16,
+    /// Its S3 error code.
+    pub code: Declared,
+}
+
+impl fmt::Display for Refusal {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self.code {
+            Declared::Code(code) => write!(f, "{} {code}", self.status),
+            Declared::NoBody => write!(f, "{} with no body", self.status),
+        }
+    }
+}
+
+/// A row's declared state.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum State {
+    /// Must succeed, and pass the operation's own check.
+    Required,
+    /// Must be refused exactly as declared.
+    Unsupported(Refusal),
+}
+
+/// One row of a profile.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct Row {
+    pub operation: Operation,
+    pub state: State,
+    /// Where the declared answer comes from: the issue, and the line of the gateway that
+    /// answers it.
+    pub citation: &'static str,
+}
+
+/// A range of server versions: from `from` (inclusive), below `below` (exclusive); an absent
+/// bound is open.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Versions {
+    pub from: Option<Version>,
+    pub below: Option<Version>,
+}
+
+impl Versions {
+    /// Whether `version` lies in the range, by semantic-versioning precedence.
+    pub fn contains(&self, version: &Version) -> bool {
+        self.from.as_ref().is_none_or(|from| version >= from)
+            && self.below.as_ref().is_none_or(|below| version < below)
+    }
+}
+
+impl fmt::Display for Versions {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match (&self.from, &self.below) {
+            (None, None) => write!(f, "every version"),
+            (Some(from), None) => write!(f, "versions {from} and later"),
+            (None, Some(below)) => write!(f, "versions below {below}"),
+            (Some(from), Some(below)) => write!(f, "versions {from} and later, below {below}"),
+        }
+    }
+}
+
+/// The capability table for one range of server versions. Immutable once a release in its
+/// range has shipped (module docs).
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Profile {
+    pub name: &'static str,
+    pub versions: Versions,
+    pub rows: &'static [Row],
+}
+
+impl Profile {
+    /// The row for `operation`: the first, if a profile were to declare one twice
+    /// ([`Profile::gaps`] reports that).
+    pub fn row(&self, operation: Operation) -> Option<&Row> {
+        self.rows.iter().find(|row| row.operation == operation)
+    }
+
+    /// Judge `exchange` by this profile's row for its operation.
+    pub fn judge(&self, exchange: &Exchange) -> Verdict {
+        match self.row(exchange.operation()) {
+            Some(row) => judge(row, exchange),
+            None => Verdict::Unchecked {
+                detail: format!(
+                    "profile `{}` has no row for {}",
+                    self.name,
+                    exchange.operation()
+                ),
+            },
+        }
+    }
+
+    /// Why this profile cannot judge a full sweep, each reason in words; empty when it can.
+    /// Every operation needs exactly one row, an unsupported row a citation like every other,
+    /// and a required row an operation [`judge`] has a check for
+    /// ([`Operation::has_required_check`]).
+    pub fn gaps(&self) -> Vec<String> {
+        let mut gaps = Vec::new();
+        for operation in Operation::ALL {
+            match self
+                .rows
+                .iter()
+                .filter(|r| r.operation == operation)
+                .count()
+            {
+                0 => gaps.push(format!("no row for {operation}")),
+                1 => {}
+                n => gaps.push(format!("{n} rows for {operation}")),
+            }
+        }
+        for row in self.rows {
+            if row.citation.trim().is_empty() {
+                gaps.push(format!("the row for {} cites nothing", row.operation));
+            }
+            if row.state == State::Required && !row.operation.has_required_check() {
+                gaps.push(format!(
+                    "{} is declared required, but the validator has no check of its own for it",
+                    row.operation
+                ));
+            }
+        }
+        gaps
+    }
+}
