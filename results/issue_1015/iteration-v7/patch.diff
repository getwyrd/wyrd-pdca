+/// A clock that answers its readings in turn, then the last one for good.
+struct Readings(Mutex<Vec<u64>>);
+
+impl Clock for Readings {
+    fn now_millis(&self) -> u64 {
+        let mut left = self.0.lock().unwrap();
+        if left.len() > 1 {
+            left.remove(0)
+        } else {
+            left[0]
+        }
+    }
