+/// One pass's tallies (`None` when refused), and what it emitted.
+async fn judge(store: &Store, policy: &ReaperPolicy) -> (Option<Pass>, String) {
+    traced(store, policy, async |ctx| {
+        pass(ctx).await.expect("mpuctl reads")
+    })
+    .await
+}
