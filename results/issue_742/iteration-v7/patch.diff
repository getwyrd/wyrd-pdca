+                    &t,
+                    "# ── install",
+                    "rm -f \"$BINDIR/wyrd-validate\"\n# ── install",
+                )
+            }),
+        ),
+        (
+            "install line deleted",
+            Box::new(|t| replaced(t, INSTALL, "")),
+        ),
+        (
+            "ROLES grows the validator",
+            Box::new(|t| {
+                replaced(
+                    t,
+                    "ROLES=\"d-server custodian s3\"",
+                    "ROLES=\"d-server custodian s3 wyrd-validate\"",
+                )
+            }),
+        ),
+    ];
+    for (case, edit) in cases {
