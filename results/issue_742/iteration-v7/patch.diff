+#[test]
+fn the_layout_checker_names_a_dockerfile_that_drops_a_binary() {
+    const COPY: &str =
+        "COPY --from=build /src/target/release/wyrd-validate /usr/local/bin/wyrd-validate";
+    let cases: [(&str, PlantedDrift); 4] = [
+        (
+            "--bin dropped from the build",
+            Box::new(|t| replaced(t, " --bin wyrd-validate", "")),
+        ),
+        ("COPY deleted", Box::new(|t| replaced(t, COPY, ""))),
+        (
+            "COPY commented out",
+            Box::new(|t| replaced(t, COPY, &format!("# {COPY}"))),
+        ),
+        (
+            "COPY lands somewhere else",
+            Box::new(|t| {
+                replaced(
+                    t,
+                    COPY,
+                    "COPY --from=build /src/target/release/wyrd-validate /opt/wyrd-validate",
+                )
+            }),
+        ),
+    ];
+    for (case, edit) in cases {
+        let out = with_planted_drift(layout::DOCKERFILE, |t| edit(t));
+        assert_named(case, &out, layout::DOCKERFILE, "wyrd-validate");
+    }
+}
