+/// `text` planted as a line of its own directly above `anchor` (a whole line of the real
+/// smoke script, indentation and newline included).
+fn planted_above(anchor: &'static str, text: &'static str) -> PlantedDrift {
+    Box::new(move |t| replaced(t, anchor, &format!("            {text}\n{anchor}")))
+}
+
+/// The real smoke script's line `anchor` swapped for the statement `text`.
+fn swapped_for(anchor: &'static str, text: &'static str) -> PlantedDrift {
+    Box::new(move |t| replaced(t, anchor, &format!("            {text}\n")))
+}
+
+/// Every case is one edit to the REAL workflow that takes one of the validator's checks
+/// away — most of them leave the step green in a real shell when the validator cannot run
+/// at all, or (the absence and uninstall cases) when an uninstall leaves it behind — and
+/// each must be named. The checks are PINNED as exact lines, not recognised: a silenced,
+/// inverted or re-pointed line is simply not the pinned line.
+#[test]
+fn the_layout_checker_names_a_release_smoke_that_stops_proving_a_binary() {
+    const IF: &str = "if /usr/local/bin/wyrd-validate >/tmp/validate-usage.txt 2>&1; then";
+    const BODY: &str = "echo 'wyrd-validate with no arguments must exit non-zero'; exit 1";
+    const GREP: &str = "            grep -q 'usage: wyrd-validate' /tmp/validate-usage.txt\n";
+    const ABSENT: &str = "            test ! -e /usr/local/bin/wyrd-validate\n";
+    const UNINSTALL: &str = "            ./install.sh --uninstall\n";
+    let cases: [(&str, PlantedDrift); 24] = [
+        (
+            "usage assertion suppressed by || true",
+            swapped_for(
+                GREP,
+                "grep -q 'usage: wyrd-validate' /tmp/validate-usage.txt || true",
+            ),
+        ),
+        (
+            "usage assertion inverted with -v",
+            swapped_for(
+                GREP,
+                "grep -qv 'usage: wyrd-validate' /tmp/validate-usage.txt",
+            ),
+        ),
+        (
+            "usage assertion negated",
+            swapped_for(
+                GREP,
+                "! grep -q 'usage: wyrd-validate' /tmp/validate-usage.txt",
+            ),
+        ),
+        (
+            "usage assertion piped",
+            swapped_for(
+                GREP,
+                "grep -q 'usage: wyrd-validate' /tmp/validate-usage.txt | cat",
+            ),
+        ),
+        (
+            "usage assertion backgrounded",
+            swapped_for(
+                GREP,
+                "grep -q 'usage: wyrd-validate' /tmp/validate-usage.txt &",
+            ),
+        ),
+        (
+            "usage assertion demoted to an if condition",
+            swapped_for(
+                GREP,
+                "if grep -q 'usage: wyrd-validate' /tmp/validate-usage.txt; then :; fi",
+            ),
+        ),
+        (
+            "usage assertion followed by a trailing comment that hides || true",
+            swapped_for(
+                GREP,
+                "grep -q 'usage: wyrd-validate' /tmp/validate-usage.txt || true # flaky",
+            ),
+        ),
+        (
+            "usage pattern emptied",
+            swapped_for(GREP, "grep -q '' /tmp/validate-usage.txt"),
+        ),
+        (
+            "usage assertion reads a file the binary did not write",
+            swapped_for(GREP, "grep -q 'usage: wyrd-validate' /tmp/README.md"),
+        ),
+        (
+            "capture file rewritten between the block and its usage assertion",
+            planted_above(GREP, "echo 'usage: wyrd-validate' >/tmp/validate-usage.txt"),
+        ),
+        (
+            "the if-body no longer exits",
+            Box::new(|t| {
+                replaced(
+                    t,
+                    BODY,
+                    "echo 'wyrd-validate with no arguments must exit non-zero'",
+                )
+            }),
+        ),
+        (
+            "the if-body exits 0",
+            Box::new(|t| {
+                replaced(
+                    t,
+                    BODY,
+                    "echo 'wyrd-validate with no arguments must exit non-zero'; exit 0",
+                )
+            }),
+        ),
+        (
+            "an exit smuggled into the block's own if line",
+            Box::new(|t| {
+                replaced(
+                    t,
+                    IF,
+                    "if /usr/local/bin/wyrd-validate >/tmp/validate-usage.txt; exit 0 # 2>&1; then",
+                )
+            }),
+        ),
+        (
+            "the block and its usage assertion moved after the uninstall",
+            Box::new(|t| {
+                let block =
+                    format!("            {IF}\n              {BODY}\n            fi\n{GREP}");
+                let t = replaced(t, &block, "");
+                replaced(&t, UNINSTALL, &format!("{UNINSTALL}{block}"))
+            }),
+        ),
+        (
+            "absence check suppressed by || true",
+            swapped_for(ABSENT, "test ! -e /usr/local/bin/wyrd-validate || true"),
+        ),
+        (
+            "absence check written as a negated command, which sh -e never fails on",
+            swapped_for(ABSENT, "! test -e /usr/local/bin/wyrd-validate"),
+        ),
+        (
+            "uninstall suppressed by || true",
+            swapped_for(UNINSTALL, "./install.sh --uninstall || true"),
+        ),
+        (
+            "invocation and its usage assertion commented out",
+            Box::new(|t| {
+                let t = replaced(t, IF, &format!("# {IF}"));
+                replaced(
+                    &t,
+                    GREP,
+                    "            # grep -q 'usage: wyrd-validate' /tmp/validate-usage.txt\n",
+                )
+            }),
+        ),
+        (
+            "absence check moved before --uninstall",
+            Box::new(|t| {
+                let t = replaced(t, ABSENT, "");
+                replaced(&t, UNINSTALL, &format!("{ABSENT}{UNINSTALL}"))
+            }),
+        ),
+        (
+            "usage assertion deleted",
+            Box::new(|t| replaced(t, GREP, "")),
+        ),
+        (
+            "invocation piped",
+            Box::new(|t| {
+                replaced(
+                    t,
+                    IF,
+                    "if /usr/local/bin/wyrd-validate 2>&1 | tee /tmp/validate-usage.txt; then",
+                )
+            }),
+        ),
+        (
+            "invocation backgrounded",
+            Box::new(|t| {
+                replaced(
+                    t,
+                    IF,
+                    "if /usr/local/bin/wyrd-validate >/tmp/validate-usage.txt 2>&1 & then",
+                )
+            }),
+        ),
+        (
+            "binary only as an argument",
+            Box::new(|t| {
+                replaced(
+                    t,
+                    IF,
+                    "if test -x /usr/local/bin/wyrd-validate >/tmp/validate-usage.txt 2>&1; then",
+                )
+            }),
+        ),
+        (
+            "exit status swallowed by || true",
+            Box::new(|t| {
+                replaced(
+                    t,
+                    IF,
+                    "if /usr/local/bin/wyrd-validate >/tmp/validate-usage.txt 2>&1 || true; then",
+                )
+            }),
+        ),
+    ];
+    for (case, edit) in cases {
+        let out = with_planted_drift(layout::RELEASE_WORKFLOW, |t| edit(t));
+        assert_named(case, &out, layout::RELEASE_WORKFLOW, "wyrd-validate");
+    }
+}
+
+/// Does some disagreement carry every one of `parts`?
+fn any_with(disagreements: &[String], parts: &[&str]) -> bool {
+    disagreements
+        .iter()
+        .any(|d| parts.iter().all(|p| d.contains(p)))
+}
+
+/// The 1-based line of the real release workflow, after `edit`, that contains `needle` —
+/// the first such line the edit PUT there, so text the real file already carries (a
+/// comment naming the same construct) is never mistaken for the planted line.
+fn planted_line(edit: impl Fn(&str) -> String, needle: &str) -> usize {
+    let original = read(layout::RELEASE_WORKFLOW);
+    let edited = edit(&original);
+    let already_there: Vec<&str> = original.lines().collect();
+    1 + edited
+        .lines()
+        .position(|l| l.contains(needle) && !already_there.contains(&l))
+        .unwrap_or_else(|| panic!("planted text {needle:?} not found after the edit"))
+}
+
+/// A pinned line only proves something if it RUNS and its failure FAILS the step, so the
+/// checker also holds the whole smoke step — its keys, its runner-shell lines and the
+/// in-container script — to a straight-line, fail-fast shape. Every case leaves each
+/// binary's pinned lines untouched and in place, and changes only whether they run or
+/// whether their failure counts: the forms a real shell passes with a validator that
+/// cannot load. Each must be named with the line that does it.
+#[test]
+fn the_layout_checker_holds_the_smoke_step_to_a_straight_line_fail_fast_shape() {
+    const IF_LINE: &str =
+        "            if /usr/local/bin/wyrd-validate >/tmp/validate-usage.txt 2>&1; then\n";
+    const GREP: &str = "            grep -q 'usage: wyrd-validate' /tmp/validate-usage.txt\n";
+
+    /// `opener` planted above `at` and `closer` below the real GREP line: whatever
+    /// construct the two form, every pinned line survives inside it.
+    fn wrapped(at: &'static str, opener: &'static str, closer: &'static str) -> PlantedDrift {
+        Box::new(move |t| {
+            let t = replaced(t, at, &format!("            {opener}\n{at}"));
+            replaced(&t, GREP, &format!("{GREP}            {closer}\n"))
+        })
+    }
+
+    // The runner-shell half of the step: its keys, and the lines above the script.
+    const STEP: &str = "      - name: smoke the installer in a bookworm container\n";
+    const RUN_KEY: &str =
+        "      - name: smoke the installer in a bookworm container\n        run: |\n";
+    const DOCKER_RUN: &str = "          docker run --rm -v ";
+    /// `text` planted as a runner-shell line of its own directly above `docker run`.
+    fn above_docker_run(text: &'static str) -> PlantedDrift {
+        Box::new(move |t| replaced(t, DOCKER_RUN, &format!("          {text}\n{DOCKER_RUN}")))
+    }
+
+    // (case, the planted line the finding must point at, a word of its reason, the edit)
+    let cases: [(&str, &str, &str, PlantedDrift); 35] = [
+        (
+            "the step skipped by an if: key",
+            "if: false",
+            "`if: false`",
+            Box::new(|t| replaced(t, STEP, &format!("{STEP}        if: false\n"))),
+        ),
+        (
+            "the step allowed to fail",
+            "continue-on-error: true",
+            "`continue-on-error: true`",
+            Box::new(|t| replaced(t, STEP, &format!("{STEP}        continue-on-error: true\n"))),
+        ),
+        (
+            "the script folded into one line, where its first comment swallows the rest",
+            "run: >",
+            "`run: >`",
+            Box::new(|t| replaced(t, RUN_KEY, &format!("{STEP}        run: >\n"))),
+        ),
+        (
+            "the runner shell exits before docker run",
+            "exit 0",
+            "`exit`",
+            above_docker_run("exit 0"),
+        ),
+        (
+            "docker run made the right-hand side of a list",
+            "true ||",
+            "continuation",
+            above_docker_run("true ||"),
+        ),
+        (
+            "docker run joined onto the line above it",
+            "true \\",
+            "backslash",
+            above_docker_run("true \\"),
+        ),
+        (
+            "docker run inside a runner-shell guard",
+            "if false; then",
+            "`if`",
+            above_docker_run("if false; then"),
+        ),
+        (
+            "the script printed instead of run",
+            "echo docker run --rm -v ",
+            "must be opened by exactly",
+            Box::new(|t| replaced(t, DOCKER_RUN, "          echo docker run --rm -v ")),
+        ),
+        (
+            "docker run's exit status dropped on its own line",
+            "true || docker run --rm -v ",
+            "must be opened by exactly",
+            Box::new(|t| replaced(t, DOCKER_RUN, "          true || docker run --rm -v ")),
+        ),
+        (
+            "the shell started without -e, so only the last line's status counts",
+            "debian:bookworm sh -u -c \"",
+            "must be opened by exactly",
+            Box::new(|t| {
+                replaced(
+                    t,
+                    "debian:bookworm sh -eu -c \"\n",
+                    "debian:bookworm sh -u -c \"\n",
+                )
+            }),
+        ),
+        (
+            "the container given another command, with the script as its arguments",
+            "debian:bookworm true sh -eu -c \"",
+            "must be opened by exactly",
+            Box::new(|t| {
+                replaced(
+                    t,
+                    "debian:bookworm sh -eu -c \"\n",
+                    "debian:bookworm true sh -eu -c \"\n",
+                )
+            }),
+        ),
+        (
+            "the container's entrypoint replaced",
+            "--entrypoint true",
+            "must be opened by exactly",
+            Box::new(|t| {
+                replaced(
+                    t,
+                    DOCKER_RUN,
+                    "          docker run --entrypoint true --rm -v ",
+                )
+            }),
+        ),
+        (
+            "the assertion inside an expansion that drops its text",
+            "echo ${unset:+",
+            "`${…}`",
+            wrapped(GREP, "echo ${unset:+", "}"),
+        ),
+        (
+            "an exit smuggled into the if line of a block for some other command",
+            "if /usr/bin/false; exit 0 >/tmp/false.txt 2>&1; then",
+            "`if`",
+            Box::new(|t| {
+                replaced(
+                    t,
+                    IF_LINE,
+                    &format!(
+                        "            if /usr/bin/false; exit 0 >/tmp/false.txt 2>&1; then\n              \
+                         echo 'false must exit non-zero'; exit 1\n            fi\n{IF_LINE}"
+                    ),
+                )
+            }),
+        ),
+        (
+            "an exit smuggled in behind the capture of a block for some other command",
+            "if /usr/bin/false >/tmp/false.txt; exit 0 # 2>&1; then",
+            "`if`",
+            Box::new(|t| {
+                replaced(
+                    t,
+                    IF_LINE,
+                    &format!(
+                        "            if /usr/bin/false >/tmp/false.txt; exit 0 # 2>&1; then\n              \
+                         echo 'false must exit non-zero'; exit 1\n            fi\n{IF_LINE}"
+                    ),
+                )
+            }),
+        ),
+        (
+            "an early exit as the body of a block for some other command",
+            "if /usr/bin/true >/tmp/true.txt 2>&1; then",
+            "not the three lines",
+            Box::new(|t| {
+                replaced(
+                    t,
+                    IF_LINE,
+                    &format!(
+                        "            if /usr/bin/true >/tmp/true.txt 2>&1; then\n              \
+                         exit 0\n            fi\n{IF_LINE}"
+                    ),
+                )
+            }),
+        ),
+        (
+            "an exit behind quotes, which still runs",
+            "'exit' 0",
+            "`exit`",
+            planted_above(IF_LINE, "'exit' 0"),
+        ),
+        (
+            "the block and its assertion wrapped in a guard that is false",
+            "if [ -x /usr/local/bin/wyrd-validate ]; then",
+            "`if`",
+            wrapped(
+                IF_LINE,
+                "if [ -x /usr/local/bin/wyrd-validate ]; then",
+                "fi",
+            ),
+        ),
+        (
+            "the assertion inside a loop that never runs",
+            "while false; do",
+            "`while`",
+            wrapped(GREP, "while false; do", "done"),
+        ),
+        (
+            "the assertion inside a brace group whose status is dropped",
+            "true || {",
+            "`{`",
+            wrapped(GREP, "true || {", "}"),
+        ),
+        (
+            "the assertion inside a subshell whose status is dropped",
+            "( cd /tmp",
+            "subshell",
+            wrapped(GREP, "( cd /tmp", ") || true"),
+        ),
+        (
+            "the assertion inside a function nobody calls",
+            "check() {",
+            "function",
+            wrapped(GREP, "check() {", "}"),
+        ),
+        (
+            "the assertion inside a here-document",
+            "cat <<EOF",
+            "here-document",
+            wrapped(GREP, "cat <<EOF", "EOF"),
+        ),
+        (
+            "the assertion inside a quote left open",
+            "echo 'note",
+            "quote",
+            wrapped(GREP, "echo 'note", "'"),
+        ),
+        (
+            "the assertion inside a substitution the runner's shell runs instead",
+            "echo $(",
+            "`$(…)`",
+            wrapped(GREP, "echo $(", ")"),
+        ),
+        (
+            "the assertion made the right-hand side of a list",
+            "true ||",
+            "continuation",
+            planted_above(GREP, "true ||"),
+        ),
+        (
+            "the assertion swallowed by a comment that ends in a backslash",
+            "# the grep below is what fails the smoke \\",
+            "backslash",
+            planted_above(GREP, "# the grep below is what fails the smoke \\"),
+        ),
+        (
+            "errexit turned off above the checks",
+            "set +e",
+            "`set +",
+            planted_above(IF_LINE, "set +e"),
+        ),
+        (
+            "an early exit above the checks",
+            "exit 0",
+            "`exit`",
+            planted_above(IF_LINE, "exit 0"),
+        ),
+        (
+            "an early exit behind a semicolon",
+            "cd /tmp; exit 0",
+            "`exit`",
+            planted_above(IF_LINE, "cd /tmp; exit 0"),
+        ),
+        (
+            "the shell replaced above the checks",
+            "exec true",
+            "`exec`",
+            planted_above(IF_LINE, "exec true"),
+        ),
+        (
+            "a return at the top level",
+            "return 0",
+            "`return`",
+            planted_above(IF_LINE, "return 0"),
+        ),
+        (
+            "an exit hidden in eval",
+            "eval 'exit 0'",
+            "`eval`",
+            planted_above(IF_LINE, "eval 'exit 0'"),
+        ),
+        (
+            "the exit status rewritten by a trap",
+            "trap 'exit 0' EXIT",
+            "`trap`",
+            planted_above(IF_LINE, "trap 'exit 0' EXIT"),
+        ),
+        (
+            "an exit hidden in a sourced file",
+            ". /tmp/hooks.sh",
+            "`.`",
+            planted_above(IF_LINE, ". /tmp/hooks.sh"),
+        ),
+    ];
+    for (case, needle, reason, edit) in cases {
+        let line = planted_line(|t| edit(t), needle);
+        let out = with_planted_drift(layout::RELEASE_WORKFLOW, |t| edit(t));
+        assert!(
+            any_with(
+                &out,
+                &[layout::RELEASE_WORKFLOW, &format!("line {line}:"), reason]
+            ),
+            "{case}: expected a disagreement naming line {line} and {reason}, got {out:?}"
+        );
+    }
+
+    // The shape is not a ban on editing the step: ordinary extra statements in either
+    // shell, compound-command WORDS inside a quoted message, a pipe in the middle of a
+    // line, and a further run-and-assert block are no disagreement.
+    let harmless: [(&str, PlantedDrift); 5] = [
+        (
+            "a plain extra statement in the script",
+            planted_above(IF_LINE, "ls -l /usr/local/bin | sort >/dev/null"),
+        ),
+        (
+            "a plain extra statement in the runner shell",
+            above_docker_run("echo \"smoking $tarball (done; fi)\""),
+        ),
+        (
+            "compound words inside quotes",
+            planted_above(IF_LINE, "echo 'if this is done; then fine (really)'"),
+        ),
+        (
+            "an escaped double-quoted string in the script",
+            planted_above(IF_LINE, "echo \\\"while this is done\\\""),
+        ),
+        (
+            "a second run-and-assert block for some other command",
+            Box::new(|t| {
+                replaced(
+                    t,
+                    IF_LINE,
+                    &format!(
+                        "            if /usr/bin/false >/tmp/false.txt 2>&1; then\n              \
+                         echo 'false must exit non-zero'; exit 1\n            fi\n{IF_LINE}"
+                    ),
+                )
+            }),
+        ),
+    ];
+    for (case, edit) in harmless {
+        let out = with_planted_drift(layout::RELEASE_WORKFLOW, |t| edit(t));
+        assert!(
+            out.is_empty(),
+            "{case}: must not be a disagreement, got {out:?}"
+        );
+    }
+}
+
+/// The release smoke's in-container script is ONE double-quoted word of the step's own
+/// shell, and the checker delimits it the way that shell does — comment lines included,
+/// because `#` is not a comment inside a quoted word. The first case is the defect this
+/// slice's own smoke once shipped: a script comment carrying a double-quoted phrase
+/// closed the script right there, so the validator smoke, the `wyrd` smoke and every
+/// uninstall assertion after it never ran, while the step — and the checker — stayed
+/// green.
+#[test]
+fn the_layout_checker_ends_the_smoke_script_at_an_unescaped_quote() {
+    const COMMENT: &str = "the if-branch alone would take that for a correct refusal.";
+    const VALIDATOR_IF: &str =
+        "            if /usr/local/bin/wyrd-validate >/tmp/validate-usage.txt 2>&1; then\n";
+    const TAIL: &str = "            test -d /etc/wyrd\n          \"\n";
+    const CLOSES: &str = "closes the smoke step's";
+    let installed: Vec<String> = dist::shipped_binaries()
+        .iter()
+        .map(|b| format!("/usr/local/bin/{}", b.name()))
+        .collect();
+
+    // The quotes the real script already carries sit inside a `$(…)`, where they are the
+    // substitution's own — the unplanted file must stay clean with them in it.
+    assert!(
+        read(layout::RELEASE_WORKFLOW).contains("$(basename \"$tarball\")"),
+        "the real smoke script no longer nests quotes in a `$(…)` — the clean case below \
+         stopped covering that"
+    );
+    let out = with_planted_drift(layout::RELEASE_WORKFLOW, str::to_string);
+    assert!(out.is_empty(), "unplanted workflow disagrees: {out:?}");
+
+    // (1) The shipped defect: a quoted PHRASE in a comment before the validator smoke.
+    // Every check after it is reported as never run, for every binary.
+    let phrase = "the if-branch alone would read as \"refused correctly\".";
+    let edit = |t: &str| replaced(t, COMMENT, phrase);
+    let line = planted_line(edit, phrase);
+    let out = with_planted_drift(layout::RELEASE_WORKFLOW, edit);
+    assert!(
+        any_with(
+            &out,
+            &[layout::RELEASE_WORKFLOW, &format!("line {line}:"), CLOSES]
+        ),
+        "a quoted phrase in a script comment: the early close on line {line} is not named: \
+         {out:?}"
+    );
+    for path in &installed {
+        assert!(
+            any_with(
+                &out,
+                &[
+                    layout::RELEASE_WORKFLOW,
+                    &format!("never runs `{path}` before")
+                ]
+            ),
+            "a quoted phrase in a script comment: `{path}` runs AFTER the early close and \
+             must be reported as never run: {out:?}"
+        );
+        assert!(
+            any_with(
+                &out,
+                &[
+                    layout::RELEASE_WORKFLOW,
+                    "never runs `./install.sh --uninstall`",
+                    &format!("`{path}` is gone")
+                ]
+            ),
+            "a quoted phrase in a script comment: the uninstall assertions for `{path}` sit \
+             AFTER the early close and must be reported as never run: {out:?}"
+        );
+    }
+
+    // (2) A single quoted WORD: the shell happens to carry on (the quotes just vanish),
+    // but nobody should have to count spaces to know — it is reported the same way.
+    let word = "            # some \"quoted\" words\n";
+    let edit = |t: &str| replaced(t, VALIDATOR_IF, &format!("{word}{VALIDATOR_IF}"));
+    let out = with_planted_drift(layout::RELEASE_WORKFLOW, edit);
+    assert!(
+        any_with(&out, &[layout::RELEASE_WORKFLOW, CLOSES]),
+        "a quoted word in a script comment is not named: {out:?}"
+    );
+    assert_named(
+        "a comment with \"quoted\" words before the validator invocation",
+        &out,
+        layout::RELEASE_WORKFLOW,
+        "wyrd-validate",
+    );
+
+    // (3) A quote AFTER every binary's checks loses no binary check, and is still a
+    // truncated smoke: the close is named, and nothing is reported as never run.
+    let late = "            # keeps \"config and\" data\n";
+    let edit = |t: &str| replaced(t, TAIL, &format!("{late}{TAIL}"));
+    let line = planted_line(edit, late.trim());
+    let out = with_planted_drift(layout::RELEASE_WORKFLOW, edit);
+    assert!(
+        any_with(
+            &out,
+            &[layout::RELEASE_WORKFLOW, &format!("line {line}:"), CLOSES]
+        ),
+        "a quote after every binary check: the early close on line {line} is not named: \
+         {out:?}"
+    );
+    assert_eq!(
+        out.len(),
+        1,
+        "a quote after every binary check: the early close is the ONLY disagreement — the \
+         checks before it did run: {out:?}"
+    );
+
+    // (4) Anything after the script's real closing quote — here the exit status of the
+    // whole `docker run` swallowed.
+    let swallowed = "            test -d /etc/wyrd\n          \" || true\n";
+    let out = with_planted_drift(layout::RELEASE_WORKFLOW, |t| replaced(t, TAIL, swallowed));
+    assert!(
+        any_with(
+            &out,
+            &[layout::RELEASE_WORKFLOW, CLOSES, "the rest of that line"]
+        ),
+        "text after the closing quote is not named: {out:?}"
+    );
+
+    // (5) A backtick in the script: the runner's shell would run it.
+    let backtick = "the if-branch alone would take `that` for a correct refusal.";
+    let edit = |t: &str| replaced(t, COMMENT, backtick);
+    let line = planted_line(edit, backtick);
+    let out = with_planted_drift(layout::RELEASE_WORKFLOW, edit);
+    assert!(
+        any_with(
+            &out,
+            &[
+                layout::RELEASE_WORKFLOW,
+                &format!("line {line} "),
+                "backtick"
+            ]
+        ),
+        "a backtick in a script comment is not named: {out:?}"
+    );
+    assert_named(
+        "a backtick before the validator invocation",
+        &out,
+        layout::RELEASE_WORKFLOW,
+        "wyrd-validate",
+    );
+
+    // (6) The closing quote gone altogether.
+    let unclosed = "            test -d /etc/wyrd\n";
+    let out = with_planted_drift(layout::RELEASE_WORKFLOW, |t| replaced(t, TAIL, unclosed));
+    assert!(
+        any_with(&out, &[layout::RELEASE_WORKFLOW, "never closed"]),
+        "an unclosed script is not named: {out:?}"
+    );
+
+    // (7) The same phrase with its quotes ESCAPED is part of the script: no disagreement —
+    // the model follows the shell, it does not just ban a character.
+    let escaped = "the if-branch alone would read as \\\"refused correctly\\\".";
+    let out = with_planted_drift(layout::RELEASE_WORKFLOW, |t| replaced(t, COMMENT, escaped));
+    assert!(
+        out.is_empty(),
+        "escaped quotes in a script comment are fine, got: {out:?}"
+    );
+}
+
+#[test]
+fn the_layout_checker_names_a_readme_that_drops_a_binary() {
+    let out = with_planted_drift(layout::README, |t| t.replace("wyrd-validate", "wyrd"));
+    assert_named(
+        "validator folded into wyrd",
+        &out,
+        layout::README,
+        "wyrd-validate",
+    );
+}
+
+/// The uninstall-time wording of the installer names both binaries, so an operator reads
+/// what was removed (install.sh's own contract test keeps its other promises).
+#[test]
+fn install_sh_reports_both_binaries_on_uninstall() {
+    let sh = read("deploy/dist/install.sh");
+    let summaries: Vec<&str> = sh
+        .lines()
+        .filter(|l| l.trim_start().starts_with("echo \"wyrd uninstalled"))
+        .collect();
+    assert!(
+        !summaries.is_empty(),
+        "install.sh prints no uninstall summary"
+    );
+    for b in dist::shipped_binaries() {
+        for line in &summaries {
+            assert!(
+                line.contains(&format!("$BINDIR/{}", b.name())),
+                "install.sh's uninstall summary must name $BINDIR/{}: {line}",
+                b.name()
+            );
+        }
+    }
+}
diff --git a/xtask/tests/fdb_image.rs b/xtask/tests/fdb_image.rs
index 9879aca..4759eff 100644
--- a/xtask/tests/fdb_image.rs
+++ b/xtask/tests/fdb_image.rs
@@ -316,19 +316,139 @@ fn workflow_exists_resolves_and_filters_the_fdb_surface() {
     // (c) The PR path filter must fire on every image build input the required gate does
     //     NOT already cover. `cargo xtask ci` default-compiles core/traits/chunkstore/…,
     //     so those are guarded there; what only THIS job builds is the OFF-by-default
-    //     feature surface the image bakes (`--features fdb,etcd`) plus the Docker context.
-    //     (Substring is enough — a `paths:` entry is the literal glob string.)
+    //     feature surface the image bakes (`--features fdb,etcd`) plus the Docker context —
+    //     and the image's second binary, whose in-image usage smoke only this job runs.
+    //     Matched against the REAL `paths:` entries: the workflow's comments name these
+    //     globs too, and a comment must not be able to stand in for a deleted entry.
+    let filters = pull_request_path_filters(&wf);
     for entry in [
         "crates/metadata-fdb/**",      // the fdb backend + its client version pin
         "deploy/docker/wyrd/**",       // the image home
         "crates/server/**",            // the baked bin: its fdb/etcd cfg arms + usage smoke
         "crates/coordination-etcd/**", // the etcd feature tree — no other CI builds it
         ".dockerignore",               // decides what `COPY . .` ships into the build
+        "crates/validate/**",          // the second baked bin (#742): its usage smoke
     ] {
         assert!(
-            wf.contains(entry),
+            filters.iter().any(|f| f == entry),
             "{WORKFLOW} path filter omits `{entry}` — a change there can break the \
-             `fdb,etcd` image with no other CI job catching it"
+             `fdb,etcd` image (or the smokes run inside it) with no other CI job catching \
+             it (entries: {filters:?})"
+        );
+    }
+
+    // The `crates/validate/**` entry exists FOR the validator's in-image smoke (it greps
+    // the usage line that crate prints): the entry and the smoke stand or fall together.
+    assert!(
+        wf.contains(VALIDATOR_SMOKE_STEP),
+        "{WORKFLOW} filters on `crates/validate/**` but no longer carries the validator's \
+         in-image smoke step exactly as pinned — the path filter has lost its reason, or \
+         the smoke no longer fails the job on a `wyrd-validate` that cannot run. Expected, \
+         followed by a blank line:\n{VALIDATOR_SMOKE_STEP}"
+    );
+}
+
+/// The validator's in-image smoke (#742), WHOLE — the step is pinned as exact text rather
+/// than recognised line by line, so a `|| true` after the grep, a `grep -v`, a guard
+/// around the check or a `continue-on-error:` under the step is simply not this step.
+/// The `if` lets the expected non-zero exit through; the `grep` on the line after `fi` is
+/// what fails the job when the binary cannot load at all (exit 127 skips the if-branch
+/// too). The blank line that ends it is part of the pin: nothing may be keyed onto the
+/// step after its script. A deliberate change to the step updates this text.
+const VALIDATOR_SMOKE_STEP: &str = "      - name: wyrd-validate usage smoke
+        run: |
+          set -eu
+          if docker run --rm --entrypoint wyrd-validate wyrd:fdb 2> validate-usage.txt; then
+            echo 'expected wyrd-validate with no arguments to exit non-zero' >&2
+            exit 1
+          fi
+          grep -q 'usage: wyrd-validate' validate-usage.txt
+
+";
+
+/// The globs under `on.pull_request.paths:` — the list items themselves, comments
+/// skipped, up to the first line that is neither.
+fn pull_request_path_filters(workflow: &str) -> Vec<String> {
+    workflow
+        .lines()
+        .skip_while(|l| l.trim() != "paths:")
+        .skip(1)
+        .map(str::trim)
+        .filter(|l| !l.is_empty() && !l.starts_with('#'))
+        .map_while(|l| l.strip_prefix("- "))
+        .map(|glob| glob.trim().trim_matches('"').to_string())
+        .collect()
+}
+
+/// A path filter that survives only as a comment is not a filter: the parser the check
+/// above relies on must not count it.
+#[test]
+fn a_commented_out_path_filter_is_not_a_filter() {
+    let wf = read(WORKFLOW);
+    const ENTRY: &str = "      - \"crates/validate/**\"\n";
+    assert!(
+        wf.contains(ENTRY),
+        "{WORKFLOW} lost its `crates/validate/**` entry — update this case"
+    );
+    assert!(pull_request_path_filters(&wf)
+        .iter()
+        .any(|f| f == "crates/validate/**"));
+
+    let commented = wf.replacen(ENTRY, "      # - \"crates/validate/**\"\n", 1);
+    let filters = pull_request_path_filters(&commented);
+    assert!(
+        !filters.iter().any(|f| f == "crates/validate/**"),
+        "a commented-out entry still counts as a filter: {filters:?}"
+    );
+    // Every other entry is still seen — the parser did not just stop early.
+    assert!(
+        filters.iter().any(|f| f == ".dockerignore"),
+        "the parser lost the entries around the comment: {filters:?}"
+    );
+}
+
+/// The pin above is what stops the validator's smoke from being quietly weakened: each
+/// of these one-line edits to the REAL workflow keeps the job green in a real shell when
+/// `wyrd-validate` cannot load, and none of them is the pinned step any more.
+#[test]
+fn a_weakened_validator_smoke_is_not_the_pinned_step() {
+    let wf = read(WORKFLOW);
+    assert!(wf.contains(VALIDATOR_SMOKE_STEP));
+    const GREP: &str = "          grep -q 'usage: wyrd-validate' validate-usage.txt\n";
+    const NAME: &str = "      - name: wyrd-validate usage smoke\n";
+    let grep_as = |line: &str| wf.replacen(GREP, &format!("          {line}\n"), 1);
+    let cases = [
+        (
+            "usage grep suppressed by || true",
+            grep_as("grep -q 'usage: wyrd-validate' validate-usage.txt || true"),
+        ),
+        (
+            "usage grep inverted with -v",
+            grep_as("grep -qv 'usage: wyrd-validate' validate-usage.txt"),
+        ),
+        (
+            "usage grep negated",
+            grep_as("! grep -q 'usage: wyrd-validate' validate-usage.txt"),
+        ),
+        ("usage grep deleted", wf.replacen(GREP, "", 1)),
+        (
+            "errexit turned off above the grep",
+            wf.replacen(GREP, &format!("          set +e\n{GREP}"), 1),
+        ),
+        (
+            "the step allowed to fail, keyed on after its script",
+            wf.replacen(GREP, &format!("{GREP}        continue-on-error: true\n"), 1),
+        ),
+        (
+            "the step skipped by an if: key",
+            wf.replacen(NAME, &format!("{NAME}        if: false\n"), 1),
+        ),
+    ];
+    for (case, edited) in cases {
+        assert_ne!(edited, wf, "{case}: the planted edit changed nothing");
+        assert!(
+            !edited.contains(VALIDATOR_SMOKE_STEP),
+            "{case}: still counts as the pinned validator smoke step"
         );
     }
 }
diff --git a/xtask/tests/dist_two_binary_layout.rs b/xtask/tests/dist_two_binary_layout.rs
new file mode 100644
index 0000000..6542a67
--- /dev/null
+++ b/xtask/tests/dist_two_binary_layout.rs
@@ -0,0 +1,1004 @@
+//! The two-binary layout contract (#742): every stage of the distribution pipeline names
+//! the SAME shipped-binary set. The production Dockerfile builds and copies each binary,
+//! `install.sh` installs each and removes each on `--uninstall`, the release smoke step
+//! runs each installed binary (and asserts on its usage output) and asserts each is gone
+//! after uninstall — each check pinned as an exact line, inside its `sh -c "…"` script
+//! as the runner's shell delimits it, in a script held to a straight-line, fail-fast
+//! shape so that a pinned line can only run and can only be fatal — and the tarball
+//! README describes each. Declared once
+//! (`xtask::dist::shipped_binaries()`), duplication checked by the gate: Docker, POSIX
+//! sh, YAML and Markdown cannot read a Rust function, so what this buys is the
+//! `FDB_VERSION` shape of `xtask/tests/fdb_image.rs` — one declaration, and a gate that
+//! names every file that drifts from it.
+//!
+//! Container-free, and deliberately FILE-TEXT ONLY, naming no `xtask::dist` symbol: this
+//! file must compile — and fail — against a tree with the production change reverted, so
+//! it carries its own copy of the expected set ([`EXPECTED_BINARIES`]) and holds the
+//! checker as a plain function of a binary set ([`pipeline_disagreements`]).
+//! `xtask/tests/dist_templates.rs` includes this file as a module, runs the SAME checker
+//! over the production table, and pins the local copy equal to it. So a third entry in
+//! the table fails there naming every pipeline file that lacks it, and the equality
+//! assertion says to update the local copy here — two files, one checker, one declaration.
+
+#![forbid(unsafe_code)]
+
+use std::path::{Path, PathBuf};
+
+/// The expected set as `(in-image path, tarball destination)` — the shape of the
+/// production table, spelled locally (see the module docs for why it is not imported).
+pub const EXPECTED_BINARIES: [(&str, &str); 2] = [
+    ("/usr/local/bin/wyrd", "bin/wyrd"),
+    ("/usr/local/bin/wyrd-validate", "bin/wyrd-validate"),
+];
+
+pub const DOCKERFILE: &str = "deploy/docker/wyrd/Dockerfile";
+pub const INSTALL_SH: &str = "deploy/dist/install.sh";
+pub const README: &str = "deploy/dist/README.md";
+pub const RELEASE_WORKFLOW: &str = ".github/workflows/release.yml";
+/// The four files the checker reads, relative to the workspace root.
+pub const PIPELINE_FILES: [&str; 4] = [DOCKERFILE, INSTALL_SH, README, RELEASE_WORKFLOW];
+
+/// The workspace root (`<root>/xtask` is this crate's manifest dir).
+pub fn workspace_root() -> PathBuf {
+    Path::new(env!("CARGO_MANIFEST_DIR"))
+        .parent()
+        .expect("xtask crate is nested under the workspace root")
+        .to_path_buf()
+}
+
+/// The file name of a tarball destination (`bin/wyrd-validate` → `wyrd-validate`): the
+/// cargo `--bin` name, the installed name, and the name the smoke step runs.
+pub fn binary_name(dest: &str) -> &str {
+    dest.rsplit('/').next().unwrap_or(dest)
+}
+
+/// Every way a pipeline file disagrees with `binaries`, as `<file>: <what is missing>`
+/// lines — empty when every stage names every binary. A plain function of the set, so the
+/// same checker runs over the local copy here and over the production table in
+/// `dist_templates.rs`. `root` is the tree to read (the workspace, or a planted fixture).
+pub fn pipeline_disagreements(root: &Path, binaries: &[(&str, &str)]) -> Vec<String> {
+    let mut out = Vec::new();
+    let mut load = |rel: &str| -> String {
+        std::fs::read_to_string(root.join(rel)).unwrap_or_else(|e| {
+            out.push(format!("{rel}: unreadable: {e}"));
+            String::new()
+        })
+    };
+    let dockerfile = load(DOCKERFILE);
+    let install = load(INSTALL_SH);
+    let readme = load(README);
+    let workflow = load(RELEASE_WORKFLOW);
+
+    // The release smoke installs with no `--prefix`, so it finds the binaries under the
+    // installer's DEFAULT prefix — read off install.sh, not assumed.
+    let prefix = default_prefix(&install).unwrap_or_else(|| {
+        out.push(format!(
+            "{INSTALL_SH}: no default `PREFIX=/…` line — the smoke step's installed paths \
+             have no source of truth"
+        ));
+        "/usr/local".to_string()
+    });
+    let names: Vec<&str> = binaries.iter().map(|(_, dest)| binary_name(dest)).collect();
+
+    // The smoke step's in-container script is delimited ONCE, the way the runner's shell
+    // delimits it; a boundary problem is the file's, not any one binary's.
+    let smoke = smoke_script(&workflow);
+    out.extend(smoke.problems.iter().cloned());
+
+    for (image_path, dest) in binaries {
+        let name = binary_name(dest);
+        let others: Vec<&str> = names.iter().copied().filter(|n| *n != name).collect();
+        out.extend(dockerfile_disagreements(&dockerfile, name, image_path));
+        out.extend(install_sh_disagreements(&install, name));
+        out.extend(release_smoke_disagreements(
+            &smoke,
+            name,
+            &format!("{prefix}/bin/{name}"),
+        ));
+        out.extend(readme_disagreements(&readme, name, dest, &others));
+    }
+    out
+}
+
+// ─── per-file checks ───────────────────────────────────────────────────────────
+
+/// (1) The Dockerfile builds `name` and copies it into the runtime stage at `image_path`.
+fn dockerfile_disagreements(text: &str, name: &str, image_path: &str) -> Vec<String> {
+    let mut out = Vec::new();
+    let instructions = dockerfile_instructions(text);
+    let built = instructions
+        .iter()
+        .filter(|i| i.starts_with("RUN cargo build"))
+        .any(|i| {
+            let toks: Vec<&str> = i.split_whitespace().collect();
+            toks.windows(2).any(|w| w[0] == "--bin" && w[1] == name)
+        });
+    if !built {
+        out.push(format!(
+            "{DOCKERFILE}: no `RUN cargo build … --bin {name}` — the image build never \
+             compiles `{name}`"
+        ));
+    }
+    let suffix = format!("/{name}");
+    let copied = instructions
+        .iter()
+        .filter_map(|i| i.strip_prefix("COPY --from=build "))
+        .any(|rest| {
+            let toks: Vec<&str> = rest.split_whitespace().collect();
+            let Some((dest, sources)) = toks.split_last() else {
+                return false;
+            };
+            let names_source = sources.iter().any(|s| s.ends_with(&suffix));
+            let lands_at = *dest == image_path
+                || (dest.ends_with('/') && format!("{dest}{name}") == image_path);
+            names_source && lands_at
+        });
+    if !copied {
+        out.push(format!(
+            "{DOCKERFILE}: no `COPY --from=build …/{name} {image_path}` — the runtime stage \
+             does not carry `{name}` where `cargo xtask dist` extracts it from"
+        ));
+    }
+    out
+}
+
+/// A Dockerfile's instructions with `\` continuations joined and comment lines dropped.
+fn dockerfile_instructions(text: &str) -> Vec<String> {
+    let mut out = Vec::new();
+    let mut current = String::new();
+    for line in text.lines() {
+        let t = line.trim();
+        if t.is_empty() || t.starts_with('#') {
+            continue;
+        }
+        if let Some(body) = t.strip_suffix('\\') {
+            current.push_str(body);
+            current.push(' ');
+        } else {
+            current.push_str(t);
+            out.push(std::mem::take(&mut current));
+        }
+    }
+    if !current.is_empty() {
+        out.push(current);
+    }
+    out
+}
+
+/// (2) `install.sh` installs `name` from `bin/<name>` on the install path, removes
+/// `$BINDIR/<name>` on the `--uninstall` path, and does not list it as a role.
+fn install_sh_disagreements(text: &str, name: &str) -> Vec<String> {
+    let mut out = Vec::new();
+    let lines: Vec<&str> = text.lines().collect();
+    fn is_code(line: &&str) -> bool {
+        !line.trim_start().starts_with('#')
+    }
+
+    if let Some(roles) = lines.iter().find_map(|l| l.strip_prefix("ROLES=")) {
+        if roles
+            .trim()
+            .trim_matches('"')
+            .split_whitespace()
+            .any(|r| r == name)
+        {
+            out.push(format!(
+                "{INSTALL_SH}: ROLES lists `{name}` — a shipped binary is not a role (it \
+                 gets no unit, no /etc/wyrd env file and no systemctl)"
+            ));
+        }
+    }
+
+    // The uninstall path is what runs between `if [ "$UNINSTALL" = 1 ]` and its
+    // `exit 0` — positional, so a removal placed outside it does not count.
+    let Some(start) = lines
+        .iter()
+        .position(|l| l.trim_start().starts_with("if [ \"$UNINSTALL\" = 1 ]"))
+    else {
+        out.push(format!(
+            "{INSTALL_SH}: no `if [ \"$UNINSTALL\" = 1 ]` uninstall path"
+        ));
+        return out;
+    };
+    let Some(end) = lines[start..]
+        .iter()
+        .position(|l| l.trim() == "exit 0")
+        .map(|p| start + p)
+    else {
+        out.push(format!(
+            "{INSTALL_SH}: the uninstall path never reaches `exit 0`"
+        ));
+        return out;
+    };
+
+    let bindir = format!("\"$BINDIR/{name}\"");
+    let removes = lines[start..end].iter().copied().filter(is_code).any(|l| {
+        let toks: Vec<&str> = l.split_whitespace().collect();
+        toks.first() == Some(&"rm") && toks.contains(&"-f") && toks.iter().any(|t| *t == bindir)
+    });
+    if !removes {
+        out.push(format!(
+            "{INSTALL_SH}: the --uninstall path (lines {}-{}) never runs `rm -f {bindir}` — \
+             uninstall would leave `{name}` behind",
+            start + 1,
+            end + 1
+        ));
+    }
+
+    let here = format!("\"$HERE/bin/{name}\"");
+    let installs = lines[end..].iter().copied().filter(is_code).any(|l| {
+        let toks: Vec<&str> = l.split_whitespace().collect();
+        toks.first() == Some(&"install")
+            && toks.contains(&"0755")
+            && toks.iter().any(|t| *t == here)
+            && toks.iter().any(|t| *t == bindir)
+    });
+    if !installs {
+        out.push(format!(
+            "{INSTALL_SH}: the install path (after line {}) never runs `install -m 0755 \
+             {here} {bindir}` — the tarball's `bin/{name}` would not be placed",
+            end + 1
+        ));
+    }
+    out
+}
+
+/// `install.sh`'s default `PREFIX=` (the first unindented absolute assignment).
+fn default_prefix(install: &str) -> Option<String> {
+    install
+        .lines()
+        .find_map(|l| l.strip_prefix("PREFIX="))
+        .filter(|v| v.starts_with('/'))
+        .map(|v| v.trim().to_string())
+}
+
+/// The release smoke step, read the way its two shells read it: where the in-container
+/// script starts and ends, and whether each line is a statement that runs and counts.
+///
+/// **Where the script ends.** The step runs `docker run … sh -eu -c "<script>"`: the whole
+/// script is ONE double-quoted word of the step's own shell, and to that shell a `#`
+/// inside a quoted word is just a character — so an unescaped `"` in one of the script's
+/// comment lines closes the word like any other. With any space before the next quote,
+/// everything from there on stops being the script: every later check silently never runs
+/// in the container and the step stays green (the defect the first version of this smoke
+/// shipped with). So the checks in [`release_smoke_disagreements`] read only what this
+/// delimits.
+///
+/// **What shape the step has.** [`release_smoke_disagreements`] PINS each check as an
+/// exact line; it does not try to recognise every way a shell line can be written,
+/// silenced or inverted. A pinned line proves something only if it runs and its failure
+/// fails the step, so the step is held to the one shape where that follows from the text
+/// alone — straight-line and fail-fast, from its `run: |` down to the script's closing
+/// quote:
+///
+/// * the step has no key but `name` and `run: |` (an `if:` skips it, a
+///   `continue-on-error:` lets it fail quietly, a folded `run: >` re-joins its lines);
+/// * the runner-shell lines above the script are plain statements, and the script is
+///   opened by exactly [`SMOKE_OPENING`] (`docker run … sh -eu -c "`);
+/// * every line of the script is a plain statement or part of a run-and-assert block
+///   ([`RunBlock`]), the only compound command there is.
+///
+/// A plain statement ([`not_plain`]) is one whole line that cannot stop a LATER line from
+/// running or from counting: no second `if`, loop, `{…}`/`(…)` group or function, no
+/// here-document, no quote, `$(…)` or `${…}` left open, no trailing continuation, no
+/// `set +…`, and no built-in that ends the script or runs text this checker cannot see.
+///
+/// **What this is not.** An interpreter. It models which statements run and whether a
+/// failing one stops the step — never what a command DOES, and it follows no expansion.
+/// An edit that changes the meaning of an untouched line (an `alias`, another `PATH`, a
+/// file put in the binary's place, a command spelled through a variable) is out of its
+/// reach, and so is anything above the step (the job's own `if:`, the workflow's
+/// triggers); that is what reviewing a `release.yml` diff is for.
+struct SmokeScript<'a> {
+    /// `(0-based workflow line, text)` of every line the in-container shell runs — the
+    /// script's own `#` comment lines dropped.
+    code: Vec<(usize, &'a str)>,
+    /// The run-and-assert blocks among `code`.
+    blocks: Vec<RunBlock<'a>>,
+    /// What is wrong with the script's boundary or shape, if anything — once per file.
+    problems: Vec<String>,
+}
+
+/// The one compound command the smoke script may hold: run a command with no arguments,
+/// capture both its streams, and fail the script if it exits 0.
+///
+/// ```text
+/// if <command> ><capture> 2>&1; then
+///   echo '<message>'; exit 1
+/// fi
+/// ```
+///
+/// Exactly these three lines — only the indentation, the two paths and the message are
+/// free. The `if` is what lets the expected non-zero exit through under `sh -e`; it lets
+/// a binary that cannot load at all through as well (exit 127), which is why the
+/// statement right after `fi` must assert on the captured usage text.
+struct RunBlock<'a> {
+    /// Index into [`SmokeScript::code`] of the `if` line; its `fi` is two after it.
+    at: usize,
+    command: &'a str,
+    capture: &'a str,
+}
+
+/// What every shape finding ends with: the rule, and what breaking it costs.
+const STRAIGHT_LINE: &str = "The smoke step must stay straight-line and fail-fast, in its \
+    runner-shell lines and its in-container script alike — every statement one whole line, \
+    run in order, stopping the step when it fails; its only compound command the script's \
+    run-and-assert block (`if <binary> ><file> 2>&1; then` / `echo '<message>'; exit 1` / \
+    `fi`). Otherwise a check further down can stop running, or stop failing the step, \
+    while the step stays green";
+
+/// The statement that opens the smoke script, exactly: `docker run` in command position
+/// and `sh -eu -c` as the container's command, so the script is what runs in the
+/// container, and runs fail-fast. Pinned whole rather than parsed — telling the image
+/// from an option's argument (`--entrypoint true`) or from a command put in front of `sh`
+/// takes docker's own option table. A deliberate change to the invocation updates this.
+const SMOKE_OPENING: &str =
+    "docker run --rm -v \"$PWD/target/dist:/dist:ro\" debian:bookworm sh -eu -c \"";
+
+/// Which shell reads a line of the step. They differ in one thing this checker needs: to
+/// the runner's shell (the `run:` lines above the script) a bare `"` is a quote; inside
+/// the script a bare `"` would have closed it ([`smoke_script`]), so the in-container
+/// shell only ever sees one written as `\"`.
+#[derive(Clone, Copy, PartialEq)]
+enum Shell {
+    Runner,
+    Container,
+}
+
+/// Delimit the smoke step's script (see [`SmokeScript`]). The script opens at the step
+/// line ending in `-c "` and is counted as ENDING at the first `"` after it that the
+/// runner's shell does not read as escaped or as nested inside a `$(…)` / `${…}`:
+/// whether the shell then keeps going (quotes around one word merely vanish) or stops
+/// (any space before the next quote) hangs on a detail no reader of the workflow should
+/// have to check, so anything but blank lines after that point is a disagreement. A backtick
+/// inside the script is one too: the runner's shell runs it as a command substitution
+/// before the container starts, and this scan does not model where it ends.
+fn smoke_script(workflow: &str) -> SmokeScript<'_> {
+    let mut script = SmokeScript {
+        code: Vec::new(),
+        blocks: Vec::new(),
+        problems: Vec::new(),
+    };
+    let lines: Vec<&str> = workflow.lines().collect();
+    let Some(step) = lines
+        .iter()
+        .position(|l| l.contains("- name: smoke the installer"))
+    else {
+        script
+            .problems
+            .push(format!("{RELEASE_WORKFLOW}: no `smoke the installer` step"));
+        return script;
+    };
+    let step_end = lines[step + 1..]
+        .iter()
+        .position(|l| {
+            let t = l.trim_start();
+            t.starts_with("- name:") || t.starts_with("- uses:")
+        })
+        .map_or(lines.len(), |p| step + 1 + p);
+    let Some(open) = (step..step_end).find(|&i| lines[i].trim_end().ends_with("-c \"")) else {
+        script.problems.push(format!(
+            "{RELEASE_WORKFLOW}: the smoke step has no line ending in `-c \"` — it no longer \
+             runs its checks as a `sh -c \"…\"` script this checker can delimit, so none of \
+             them count as run"
+        ));
+        return script;
+    };
+    script.problems.extend(prelude_problems(&lines, step, open));
+
+    // (line, byte offset of the closing quote) — or the line the scan gave up on.
+    let (script_end, close) = match quoted_word_end(&lines[..step_end], open) {
+        WordEnd::Closed { line, at } => (line, Some(at)),
+        WordEnd::Backtick { line } => {
+            script.problems.push(format!(
+                "{RELEASE_WORKFLOW}: line {} has an unescaped backtick inside the smoke \
+                 step's `sh -c \"…\"` script — the RUNNER's shell runs it as a command \
+                 substitution before the container starts, and nothing from that line on \
+                 counts as run; escape it or reword",
+                line + 1
+            ));
+            (line, None)
+        }
+        WordEnd::NotOpened => {
+            script.problems.push(format!(
+                "{RELEASE_WORKFLOW}: line {} ends in `-c \"` but that quote does not open a \
+                 string (the quotes before it on the line are unbalanced) — no smoke check \
+                 counts as run",
+                open + 1
+            ));
+            return script;
+        }
+        WordEnd::Unterminated => {
+            script.problems.push(format!(
+                "{RELEASE_WORKFLOW}: the smoke step's `sh -c \"…\"` script (opened on line \
+                 {}) is never closed inside the step",
+                open + 1
+            ));
+            (step_end, None)
+        }
+    };
+
+    for (i, line) in lines.iter().enumerate().take(script_end).skip(open + 1) {
+        script.code.push((i, *line));
+    }
+    if let Some(at) = close {
+        // `at` is the closing quote's byte offset: the script's share of its line is
+        // what precedes it, and everything after it — the rest of that line and of the
+        // step — must be blank.
+        let (inside, after) = lines[script_end].split_at(at);
+        if !inside.trim().is_empty() {
+            script.code.push((script_end, inside));
+        }
+        let rest_of_line = !after.strip_prefix('"').unwrap_or(after).trim().is_empty();
+        let later_lines = lines[script_end + 1..step_end]
+            .iter()
+            .filter(|l| !l.trim().is_empty())
+            .count();
+        let follows = match (rest_of_line, later_lines) {
+            (false, 0) => None,
+            (true, 0) => Some("the rest of that line".to_string()),
+            (false, n) => Some(format!("{n} more non-blank line(s)")),
+            (true, n) => Some(format!(
+                "the rest of that line and {n} more non-blank line(s)"
+            )),
+        };
+        if let Some(follows) = follows {
+            script.problems.push(format!(
+                "{RELEASE_WORKFLOW}: line {}: an unescaped `\"` closes the smoke step's \
+                 `sh -c \"…\"` script here, but {follows} of the step come after it, and \
+                 none of that counts as run. The runner's shell does not read `#` as a \
+                 comment inside a quoted word, so a `\"` in a script comment closes the \
+                 script too: at best the quotes silently vanish, at worst (any space \
+                 before the next quote) every later check never runs in the container \
+                 while the step stays green. Escape it (`\\\"`) or drop the quotes — the \
+                 script's closing quote must be the last thing in the step",
+                script_end + 1
+            ));
+        }
+    }
+    // A backslash-newline inside the runner's quoted word joins the two lines before the
+    // container's shell ever sees them — `#` lines included, so a comment that ends in a
+    // backslash swallows the statement under it.
+    for (i, line) in &script.code {
+        if line.trim_end().ends_with('\\') {
+            script.problems.push(format!(
+                "{RELEASE_WORKFLOW}: line {}: ends in a backslash, which joins the next \
+                 line onto this one (a comment swallows it whole). {STRAIGHT_LINE}",
+                i + 1
+            ));
+        }
+    }
+    script
+        .code
+        .retain(|(_, l)| !l.trim_start().starts_with('#'));
+    read_shape(&mut script);
+    script
+}
+
+/// The step from its `- name:` line down to the line that opens the script (see
+/// [`SmokeScript`]): its keys, the runner-shell lines above the script, and the opening
+/// `docker run` itself.
+fn prelude_problems(lines: &[&str], step: usize, open: usize) -> Vec<String> {
+    let mut out = Vec::new();
+    let indent = |l: &str| l.len() - l.trim_start().len();
+    // The step's keys sit two columns in from the `-` of its `- name:` line.
+    let key_indent = indent(lines[step]) + 2;
+    let mut runs = false;
+    for (i, line) in lines.iter().enumerate().take(open).skip(step + 1) {
+        let text = line.trim();
+        if text.is_empty() || text.starts_with('#') {
+            continue;
+        }
+        if indent(line) <= key_indent {
+            if text == "run: |" && !runs {
+                runs = true;
+            } else {
+                out.push(format!(
+                    "{RELEASE_WORKFLOW}: line {}: the smoke step carries `{text}` — besides \
+                     its name it may hold only `run: |`. An `if:` can skip the smoke, a \
+                     `continue-on-error:` lets it fail without failing the release, and any \
+                     other `run:` style re-joins the script's lines",
+                    i + 1
+                ));
+            }
+            continue;
+        }
+        let why = if line.trim_end().ends_with('\\') {
+            Some("ends in a backslash, which joins the next line onto this one".to_string())
+        } else {
+            not_plain(line, Shell::Runner)
+        };
+        if let Some(why) = why {
+            out.push(format!(
+                "{RELEASE_WORKFLOW}: line {}: {why}. {STRAIGHT_LINE}",
+                i + 1
+            ));
+        }
+    }
+    if !runs {
+        out.push(format!(
+            "{RELEASE_WORKFLOW}: the smoke step has no `run: |` key above its script"
+        ));
+    }
+
+    let opening = lines[open].trim();
+    if opening != SMOKE_OPENING {
+        out.push(format!(
+            "{RELEASE_WORKFLOW}: line {}: the smoke script must be opened by exactly \
+             `{SMOKE_OPENING}`, found `{opening}`. As an argument (`echo docker run …`), \
+             behind a `||`, with another container command or entrypoint, or without \
+             `sh -e`, the script is printed, skipped, or no longer stops at a failing \
+             check. If the container invocation changed on purpose, update \
+             `SMOKE_OPENING` in xtask/tests/dist_two_binary_layout.rs",
+            open + 1
+        ));
+    }
+    out
+}
+
+/// Sort the script's lines into run-and-assert blocks and plain statements, reporting
+/// every line that is neither (see [`SmokeScript`] for why the shape is the contract).
+fn read_shape(script: &mut SmokeScript<'_>) {
+    let SmokeScript {
+        code,
+        blocks,
+        problems,
+    } = script;
+    let mut i = 0;
+    while i < code.len() {
+        let (at, line) = code[i];
+        if let Some((command, capture)) = run_block_opener(line) {
+            let whole = code.get(i + 1).is_some_and(|(_, l)| is_fatal_body(l))
+                && code.get(i + 2).is_some_and(|(_, l)| l.trim() == "fi");
+            if whole {
+                blocks.push(RunBlock {
+                    at: i,
+                    command,
+                    capture,
+                });
+                i += 3;
+            } else {
+                problems.push(format!(
+                    "{RELEASE_WORKFLOW}: line {}: the block opened by `if {command} …` is not \
+                     the three lines a run-and-assert block must be — this `if`, then \
+                     exactly `echo '<message>'; exit 1`, then `fi`. With any other body a \
+                     `{command}` that exits 0 no longer fails the smoke. {STRAIGHT_LINE}",
+                    at + 1
+                ));
+                // Judged as a whole: carry on after its `fi`.
+                i = code[i..]
+                    .iter()
+                    .position(|(_, l)| l.trim() == "fi")
+                    .map_or(code.len(), |p| i + p + 1);
+            }
+            continue;
+        }
+        if let Some(why) = not_plain(line, Shell::Container) {
+            problems.push(format!(
+                "{RELEASE_WORKFLOW}: line {}: {why}. {STRAIGHT_LINE}",
+                at + 1
+            ));
+        }
+        i += 1;
+    }
+}
+
+/// `if <command> ><capture> 2>&1; then` → `(command, capture)`, both plain absolute
+/// paths: the command in command position with no arguments, its exit status observed by
+/// the `if` itself, and both its streams captured into one file.
+fn run_block_opener(line: &str) -> Option<(&str, &str)> {
+    let rest = line
+        .trim()
+        .strip_prefix("if ")?
+        .strip_suffix(" 2>&1; then")?;
+    let (command, capture) = rest.split_once(" >")?;
+    (is_plain_path(command) && is_plain_path(capture)).then_some((command, capture))
+}
+
+/// An absolute path spelled with nothing a shell would expand, split or redirect.
+fn is_plain_path(s: &str) -> bool {
+    s.starts_with('/')
+        && s.chars()
+            .all(|c| c.is_ascii_alphanumeric() || "/._-".contains(c))
+}
+
+/// `echo '<message>'; exit 1` — the only body a run-and-assert block may have.
+fn is_fatal_body(line: &str) -> bool {
+    line.trim()
+        .strip_prefix("echo '")
+        .and_then(|rest| rest.strip_suffix("'; exit 1"))
+        .is_some_and(|message| !message.contains(['\'', '\\', '$', '`', '"']))
+}
+
+/// Words that open, continue or close a compound command.
+const COMPOUND_WORDS: [&str; 14] = [
+    "if", "then", "elif", "else", "fi", "for", "while", "until", "do", "done", "case", "esac", "{",
+    "}",
+];
+/// Built-ins that end the script, change its exit status, or run text this checker
+/// cannot see (which may do either).
+const SCRIPT_ENDERS: [&str; 7] = ["exit", "exec", "return", "eval", "trap", ".", "source"];
+
+/// A statement's words: split at blanks and at the shell's operator characters.
+fn words(text: &str) -> Vec<&str> {
+    text.split(|c: char| c.is_whitespace() || ";&|()<>".contains(c))
+        .filter(|w| !w.is_empty())
+        .collect()
+}
+
+/// Why `line` is not a plain statement of a straight-line, fail-fast step — `None` when
+/// it is one. Syntax (compound words, operators, parentheses) is judged on the text
+/// OUTSIDE quotes, where alone it is syntax; built-ins are looked for with the quoting
+/// merely removed, because a quoted or escaped command name still runs.
+fn not_plain(line: &str, shell: Shell) -> Option<String> {
+    let Some(bare) = unquoted(line, shell) else {
+        return Some(
+            "leaves a quote open, so the lines after it are text inside a string, not \
+             statements"
+                .to_string(),
+        );
+    };
+    let bare = bare.trim_end();
+    if bare.ends_with('|') || bare.ends_with("&&") {
+        return Some(
+            "ends in a continuation (`|`, `||`, `&&`), so the next line is the rest of this \
+             statement and never a check of its own"
+                .to_string(),
+        );
+    }
+    if bare.contains("<<") {
+        return Some(
+            "starts a here-document (`<<`): the lines after it are its text, not statements"
+                .to_string(),
+        );
+    }
+    let (mut previous, mut parens, mut braces) = (' ', 0i32, 0i32);
+    for c in bare.chars() {
+        match c {
+            '(' if previous != '$' => {
+                return Some(
+                    "has a `(` that is not a `$(…)` — a subshell or a function definition, \
+                     whose lines do not run (or do not count) as statements of the script"
+                        .to_string(),
+                );
+            }
+            '(' => parens += 1,
+            ')' => parens -= 1,
+            '{' if previous == '$' => braces += 1,
+            '}' if braces > 0 => braces -= 1,
+            _ => {}
+        }
+        previous = c;
+    }
+    if parens != 0 || braces != 0 {
+        return Some(
+            "has a `$(…)` or `${…}` that does not open and close on this line: the lines \
+             inside one are its own text — run by the substitution, or dropped by the \
+             expansion — not statements of the script"
+                .to_string(),
+        );
+    }
+    if let Some(word) = words(bare).into_iter().find(|w| COMPOUND_WORDS.contains(w)) {
+        return Some(format!(
+            "`{word}` is a compound-command word outside a run-and-assert block"
+        ));
+    }
+    let spoken: String = line
+        .chars()
+        .filter(|c| !matches!(c, '\'' | '"' | '\\'))
+        .collect();
+    let spoken = words(&spoken);
+    if let Some(word) = spoken.iter().find(|w| SCRIPT_ENDERS.contains(w)) {
+        return Some(format!(
+            "`{word}` ends the script, rewrites its exit status, or runs text this checker \
+             cannot see (quoting does not stop a built-in from running; if it is only a \
+             word of a message, reword the message)"
+        ));
+    }
+    if spoken
+        .windows(2)
+        .any(|w| w[0] == "set" && w[1].starts_with('+'))
+    {
+        return Some("`set +…` turns a shell option off".to_string());
+    }
+    None
+}
+
+/// `line` with everything `shell` reads as QUOTED removed — `None` when a quote is still
+/// open at the end of the line. Single quotes are the same to both shells; see [`Shell`]
+/// for the double quote; any other backslash pair is an escaped character.
+fn unquoted(line: &str, shell: Shell) -> Option<String> {
+    let mut out = String::new();
+    let (mut single, mut double) = (false, false);
+    let mut chars = line.chars();
+    while let Some(c) = chars.next() {
+        match c {
+            '\'' if !double => single = !single,
+            _ if single => {}
+            '"' if shell == Shell::Runner => double = !double,
+            '\\' => {
+                if chars.next() == Some('"') && shell == Shell::Container {
+                    double = !double;
+                }
+            }
+            _ if double => {}
+            _ => out.push(c),
+        }
+    }
+    (!single && !double).then_some(out)
+}
+
+/// Where the double-quoted shell word opened by the LAST `"` of `lines[open]` ends.
+enum WordEnd {
+    /// The first `"` after the opening line that closes it: `(line, byte offset)`.
+    Closed { line: usize, at: usize },
+    /// An unescaped backtick came first (old-style command substitution — not modelled).
+    Backtick { line: usize },
+    /// `lines[open]` does not end inside exactly one open double-quoted string.
+    NotOpened,
+    /// The lines ran out first.
+    Unterminated,
+}
+
+/// The shell quoting contexts that decide whether a `"` closes the script's word.
+#[derive(Clone, Copy, PartialEq)]
+enum Quoting {
+    /// Unquoted text (the opening line, before the script's own quote).
+    Plain,
+    /// `"…"` — `\` escapes; `$(…)` and `${…}` nest.
+    Double,
+    /// `'…'` — nothing is special until the closing `'`.
+    Single,
+    /// `$(…)` with its open-parenthesis depth: quotes inside it are its own.
+    Substitution(u32),
+    /// `${…}`.
+    Braces,
+}
+
+/// Scan `lines` from the start of `lines[open]` as the shell reads them, and say where
+/// the double-quoted word that line leaves open is closed. Models exactly what decides
+/// that: backslash escapes, single quotes outside double quotes, and `$(…)` / `${…}`
+/// nesting (parentheses counted). Anything else is ordinary text.
+fn quoted_word_end(lines: &[&str], open: usize) -> WordEnd {
+    let mut stack = vec![Quoting::Plain];
+    for (idx, line) in lines.iter().enumerate().skip(open) {
+        let mut chars = line.char_indices().peekable();
+        while let Some((at, c)) = chars.next() {
+            let top = *stack.last().unwrap_or(&Quoting::Plain);
+            if top == Quoting::Single {
+                if c == '\'' {
+                    stack.pop();
+                }
+                continue;
+            }
+            match c {
+                '\\' => {
+                    chars.next();
+                }
+                '`' => return WordEnd::Backtick { line: idx },
+                '"' if top == Quoting::Double => {
+                    stack.pop();
+                    if idx > open && stack.len() == 1 {
+                        return WordEnd::Closed { line: idx, at };
+                    }
+                }
+                '"' => stack.push(Quoting::Double),
+                '\'' if matches!(top, Quoting::Plain | Quoting::Substitution(_)) => {
+                    stack.push(Quoting::Single);
+                }
+                '$' => match chars.peek() {
+                    Some((_, '(')) => {
+                        chars.next();
+                        stack.push(Quoting::Substitution(1));
+                    }
+                    Some((_, '{')) => {
+                        chars.next();
+                        stack.push(Quoting::Braces);
+                    }
+                    _ => {}
+                },
+                '(' | ')' => {
+                    if let Some(Quoting::Substitution(depth)) = stack.last_mut() {
+                        if c == '(' {
+                            *depth += 1;
+                        } else if *depth == 1 {
+                            stack.pop();
+                        } else {
+                            *depth -= 1;
+                        }
+                    }
+                }
+                '}' if top == Quoting::Braces => {
+                    stack.pop();
+                }
+                _ => {}
+            }
+        }
+        if idx == open && stack != [Quoting::Plain, Quoting::Double] {
+            return WordEnd::NotOpened;
+        }
+    }
+    WordEnd::Unterminated
+}
+
+/// The statement that uninstalls, exactly: any suffix (`|| true`, a pipe) would let a
+/// failed uninstall through.
+const UNINSTALL: &str = "./install.sh --uninstall";
+
+/// (3) The release smoke script runs `installed` in a run-and-assert block, asserts on
+/// the usage text that block captured in the very next statement, and after
+/// `./install.sh --uninstall` asserts the path is gone.
+///
+/// Each of the three is PINNED as an exact line (indentation aside), not recognised: the
+/// block by [`run_block_opener`] / [`is_fatal_body`], the two assertions here. Whatever
+/// is not the pinned line — commented out, negated, inverted, piped, backgrounded,
+/// followed by `|| …`, used as a condition, pointed at another file — is simply absent.
+/// That the pinned lines then really run, and really fail the step, is the script's
+/// shape ([`SmokeScript`]), judged once for the whole script.
+fn release_smoke_disagreements(
+    script: &SmokeScript<'_>,
+    name: &str,
+    installed: &str,
+) -> Vec<String> {
+    let mut out = Vec::new();
+    let code = &script.code;
+    let uninstall = code.iter().position(|(_, l)| l.trim() == UNINSTALL);
+    // With no uninstall statement, every statement is "before it": the block is still
+    // looked for, and the absence check is reported with its cause.
+    let before = uninstall.unwrap_or(code.len());
+
+    match script
+        .blocks
+        .iter()
+        .find(|b| b.command == installed && b.at < before)
+    {
+        None => out.push(format!(
+            "{RELEASE_WORKFLOW}: the smoke script never runs `{installed}` before \
+             `{UNINSTALL}` — it has no run-and-assert block for it (`if {installed} ><file> \
+             2>&1; then` / `echo '<message>'; exit 1` / `fi`, each a whole line of the \
+             `sh -c \"…\"` script; a comment, the path as an argument, a pipeline, a \
+             `||`/`&&` list or a background job does not count), so the installed `{name}` \
+             is never exercised"
+        )),
+        Some(block) => {
+            // The block is `if` / body / `fi`; the assertion is the statement after `fi`.
+            let fi = block.at + 2;
+            let capture = block.capture;
+            let wanted = [
+                format!("grep -q 'usage: {name}' {capture}"),
+                format!("grep -q 'usage:' {capture}"),
+            ];
+            let next = code.get(fi + 1);
+            if !next.is_some_and(|(_, l)| wanted.iter().any(|w| l.trim() == w)) {
+                let (at, found) = next.map_or((code[fi].0, "nothing".to_string()), |(i, l)| {
+                    (*i, format!("`{}`", l.trim()))
+                });
+                out.push(format!(
+                    "{RELEASE_WORKFLOW}: line {}: the statement right after the \
+                     `{installed}` block's `fi` must be exactly `{}` (or `{}`), found \
+                     {found}. Nothing else counts as asserting on the usage text: a grep \
+                     that is negated, inverted (`-v`), piped, backgrounded, followed by \
+                     `|| …`, used as an `if` condition, given another pattern or file, or \
+                     kept apart from the block by a statement that could rewrite `{capture}` \
+                     lets a `{name}` that cannot load at all pass the smoke (a loader error \
+                     exits 127, which skips the if-branch)",
+                    at + 1,
+                    wanted[0],
+                    wanted[1],
+                ));
+            }
+        }
+    }
+
+    let Some(uninstall) = uninstall else {
+        out.push(format!(
+            "{RELEASE_WORKFLOW}: the smoke script never runs `{UNINSTALL}` as a statement \
+             of its own, so nothing shows `{installed}` is gone after it — the smoke would \
+             not notice an uninstall that leaves `{name}` behind"
+        ));
+        return out;
+    };
+    let gone = format!("test ! -e {installed}");
+    if !code[uninstall + 1..].iter().any(|(_, l)| l.trim() == gone) {
+        out.push(format!(
+            "{RELEASE_WORKFLOW}: no statement after `{UNINSTALL}` is exactly `{gone}` (a \
+             `|| …` suffix or a leading `!` never fails under `sh -e`) — the smoke would \
+             not notice an uninstall that leaves `{name}` behind"
+        ));
+    }
+    out
+}
+
+/// (4) The README names `dest` and describes `name` on a line of its own — distinguishing
+/// what each binary is for rather than listing them together.
+fn readme_disagreements(text: &str, name: &str, dest: &str, others: &[&str]) -> Vec<String> {
+    let mut out = Vec::new();
+    if !has_token(text, dest) {
+        out.push(format!(
+            "{README}: never names `{dest}` — an operator reading the README cannot know the \
+             tarball carries `{name}`"
+        ));
+    }
+    let own_line = text
+        .lines()
+        .any(|l| has_token(l, name) && others.iter().all(|o| !has_token(l, o)));
+    if !own_line {
+        out.push(format!(
+            "{README}: no line describes `{name}` on its own (every mention sits beside \
+             another shipped binary) — the README must distinguish what each binary is for"
+        ));
+    }
+    out
+}
+
+fn is_name_char(c: char) -> bool {
+    c.is_ascii_alphanumeric() || c == '_' || c == '-'
+}
+
+/// Does `text` contain `needle` as a whole name — not as a prefix or suffix of a longer
+/// one (`bin/wyrd` is not satisfied by `bin/wyrd-validate`)?
+fn has_token(text: &str, needle: &str) -> bool {
+    let mut from = 0;
+    while let Some(i) = text[from..].find(needle) {
+        let start = from + i;
+        let end = start + needle.len();
+        let before_ok = text[..start]
+            .chars()
+            .next_back()
+            .is_none_or(|c| !is_name_char(c));
+        let after_ok = text[end..].chars().next().is_none_or(|c| !is_name_char(c));
+        if before_ok && after_ok {
+            return true;
+        }
+        from = start + needle.len();
+    }
+    false
+}
+
+// ─── the contract ──────────────────────────────────────────────────────────────
+
+/// The local expected set is itself well-formed: distinct names, each destination under
+/// `bin/`, each in-image path naming the same file — so the per-file checks above can
+/// derive one name per entry.
+#[test]
+fn the_expected_set_is_well_formed() {
+    let mut names = Vec::new();
+    for (image_path, dest) in EXPECTED_BINARIES {
+        let name = binary_name(dest);
+        assert!(
+            !name.is_empty() && name.chars().all(is_name_char),
+            "bad name in `{dest}`"
+        );
+        assert_eq!(
+            dest,
+            format!("bin/{name}"),
+            "tarball destination must be bin/<name>"
+        );
+        assert!(
+            image_path.starts_with('/') && image_path.ends_with(&format!("/{name}")),
+            "in-image path `{image_path}` must be absolute and name `{name}`"
+        );
+        assert!(!names.contains(&name), "duplicate binary name `{name}`");
+        names.push(name);
+    }
+}
+
+/// Every one of the four pipeline files names every expected binary — the Dockerfile
+/// builds and copies it, install.sh installs and removes it, the release smoke runs it
+/// and asserts its absence after uninstall, the README describes it. Red on a tree whose
+/// pipeline still ships one binary.
+#[test]
+fn every_pipeline_file_names_every_expected_binary() {
+    let root = workspace_root();
+    for file in PIPELINE_FILES {
+        assert!(
+            root.join(file).is_file(),
+            "pipeline file `{file}` is missing"
+        );
+    }
+    let disagreements = pipeline_disagreements(&root, &EXPECTED_BINARIES);
+    assert!(
+        disagreements.is_empty(),
+        "the distribution pipeline disagrees with the shipped-binary set {EXPECTED_BINARIES:?}:\n  {}",
+        disagreements.join("\n  ")
+    );
+}
