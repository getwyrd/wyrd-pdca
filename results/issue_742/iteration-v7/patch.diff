+/// A planted drift: the real file's text in, the drifted text out.
+type PlantedDrift = Box<dyn Fn(&str) -> String>;
+
+/// One occurrence of `from` replaced by `to` — asserting the needle is still in the real
+/// file, so a later edit of that file cannot turn a negative case vacuous.
+fn replaced(text: &str, from: &str, to: &str) -> String {
+    assert!(
+        text.contains(from),
+        "planted-drift needle no longer in the real file — update the case: {from:?}"
+    );
+    text.replacen(from, to, 1)
+}
+
+fn assert_named(case: &str, disagreements: &[String], file: &str, name: &str) {
+    assert!(
+        disagreements
+            .iter()
+            .any(|d| d.contains(file) && d.contains(name)),
+        "{case}: the checker stayed silent — expected a disagreement naming {file} and \
+         `{name}`, got {disagreements:?}"
+    );
+}
+
+/// The fixture mechanism itself: an unedited copy of the real files yields no
+/// disagreement, so every finding below is the planted drift and nothing else.
+#[test]
+fn the_layout_fixture_is_clean_when_nothing_is_planted() {
+    let out = with_planted_drift(layout::README, str::to_string);
+    assert!(out.is_empty(), "unplanted fixture disagrees: {out:?}");
+}
