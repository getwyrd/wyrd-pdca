+    let cases: [(&str, PlantedDrift); 5] = [
+        ("uninstall rm deleted", Box::new(|t| replaced(t, RM, ""))),
+        (
+            "uninstall rm commented out",
+            Box::new(|t| replaced(t, RM, "    # rm -f \"$BINDIR/wyrd-validate\"\n")),
+        ),
+        (
+            "uninstall rm moved onto the install path",
+            Box::new(|t| {
+                let t = replaced(t, RM, "");
