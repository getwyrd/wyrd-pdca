+                    IF,
+                    "if /usr/local/bin/wyrd-validate >/tmp/validate-usage.txt 2>&1 & then",
+                )
+            }),
+        ),
+        (
+            "binary only as an argument",
+            Box::new(|t| {
+                replaced(
+                    t,
+                    IF,
+                    "if test -x /usr/local/bin/wyrd-validate >/tmp/validate-usage.txt 2>&1; then",
+                )
+            }),
+        ),
+        (
+            "exit status swallowed by || true",
+            Box::new(|t| {
+                replaced(
+                    t,
+                    IF,
+                    "if /usr/local/bin/wyrd-validate >/tmp/validate-usage.txt 2>&1 || true; then",
+                )
+            }),
+        ),
+    ];
+    for (case, edit) in cases {
+        let out = with_planted_drift(layout::RELEASE_WORKFLOW, |t| edit(t));
+        assert_named(case, &out, layout::RELEASE_WORKFLOW, "wyrd-validate");
+    }
+}
+
+#[test]
+fn the_layout_checker_names_a_readme_that_drops_a_binary() {
+    let out = with_planted_drift(layout::README, |t| t.replace("wyrd-validate", "wyrd"));
+    assert_named(
+        "validator folded into wyrd",
+        &out,
+        layout::README,
+        "wyrd-validate",
+    );
+}
+
+/// The uninstall-time wording of the installer names both binaries, so an operator reads
+/// what was removed (install.sh's own contract test keeps its other promises).
+#[test]
+fn install_sh_reports_both_binaries_on_uninstall() {
+    let sh = read("deploy/dist/install.sh");
+    let summaries: Vec<&str> = sh
+        .lines()
+        .filter(|l| l.trim_start().starts_with("echo \"wyrd uninstalled"))
+        .collect();
+    assert!(
+        !summaries.is_empty(),
+        "install.sh prints no uninstall summary"
+    );
+    for b in dist::shipped_binaries() {
+        for line in &summaries {
+            assert!(
+                line.contains(&format!("$BINDIR/{}", b.name())),
+                "install.sh's uninstall summary must name $BINDIR/{}: {line}",
+                b.name()
+            );
+        }
+    }
+}
