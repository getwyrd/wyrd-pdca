+/// One binary the distribution ships: its cargo `--bin` name, where the production
+/// image build puts it, and where the tarball stages it.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct ShippedBinary {
+    /// The cargo `--bin` target, and the file name in every location below.
+    pub bin: &'static str,
+    /// The path inside the production image (`deploy/docker/wyrd/Dockerfile`'s
+    /// `COPY --from=build` destination), which `docker cp` extracts.
+    pub image_path: &'static str,
+    /// The staging-relative destination inside the tarball.
+    pub tarball_dest: &'static str,
+}
+
+/// The binaries the distribution ships — the single declaration every stage of the
+/// pipeline must agree with. Pure — `xtask/tests/dist_templates.rs` pins its shape and
+/// runs the pipeline-file checker of `xtask/tests/dist_two_binary_layout.rs` over it.
+///
+/// * `wyrd` — the roles binary: every long-running role and CLI role as a subcommand.
+/// * `wyrd-validate` — the blackbox validation tool (proposal 0017 §2): a separate
+///   binary by design (it must not share the roles' dependency closure), not a role,
+///   so it gets no systemd unit and no `/etc/wyrd/<role>.env`.
+pub fn shipped_binaries() -> Vec<ShippedBinary> {
+    vec![
+        ShippedBinary {
+            bin: "wyrd",
+            image_path: "/usr/local/bin/wyrd",
+            tarball_dest: "bin/wyrd",
+        },
+        ShippedBinary {
+            bin: "wyrd-validate",
+            image_path: "/usr/local/bin/wyrd-validate",
+            tarball_dest: "bin/wyrd-validate",
+        },
+    ]
+}
+
+/// Where a shipped binary sits inside a source directory on the packaging host — the
+/// `docker cp` extraction target for the image build, `target/release` for `--host`.
+/// [`stage_binaries`] reads from exactly this path, so extraction and staging cannot
+/// disagree about it. Pure.
+pub fn binary_source_path(source_dir: &Path, binary: &ShippedBinary) -> PathBuf {
+    source_dir.join(binary.bin)
+}
+
+/// The host `cargo` argv for `--host`: ONE build naming every shipped binary, so a
+/// `--host` tarball carries the same binaries as an image-built one. Pure.
+pub fn host_build_args(binaries: &[ShippedBinary], features: &str) -> Vec<String> {
+    let mut args: Vec<String> = ["build", "--release", "--locked"]
+        .map(str::to_string)
+        .to_vec();
+    for binary in binaries {
+        args.push("--bin".into());
+        args.push(binary.bin.into());
+    }
+    args.push("--features".into());
+    args.push(features.into());
+    args
+}
+
+/// Copy every shipped binary from `source_dir` (at [`binary_source_path`]) into the
+/// staging tree `stage` at its `tarball_dest`, mode `0755`. A missing source is an
+/// error, never a silently smaller tarball.
+pub fn stage_binaries(
+    binaries: &[ShippedBinary],
+    source_dir: &Path,
+    stage: &Path,
+) -> Result<(), String> {
+    use std::os::unix::fs::PermissionsExt;
+
+    for binary in binaries {
+        let source = binary_source_path(source_dir, binary);
+        let dest = stage.join(binary.tarball_dest);
+        if let Some(parent) = dest.parent() {
+            std::fs::create_dir_all(parent)
+                .map_err(|e| format!("dist: mkdir {}: {e}", parent.display()))?;
+        }
+        std::fs::copy(&source, &dest)
+            .map_err(|e| format!("dist: copy binary {}: {e}", source.display()))?;
+        std::fs::set_permissions(&dest, std::fs::Permissions::from_mode(0o755))
+            .map_err(|e| format!("dist: chmod {}: {e}", binary.tarball_dest))?;
+    }
+    Ok(())
+}
