+++ b/xtask/tests/dist_two_binary_layout.rs
@@ -0,0 +1,271 @@
+//! The distribution ships TWO binaries (#742, proposal 0017 §2): the `wyrd` roles
+//! binary and the `wyrd-validate` blackbox validation tool. The set is declared once,
+//! in `xtask::dist::shipped_binaries()`; the Dockerfile, `install.sh`, the tarball
+//! README and the release smoke step cannot read Rust, so each spells the set out
+//! itself, and this file is the gate that compares those spellings.
+//!
+//! [`pipeline_disagreements`] is ONE checker over a binary set, not assertions written
+//! out per binary. It runs twice: here over [`EXPECTED_BINARIES`], and in
+//! `dist_templates.rs` (which includes this file as a module) over the production
+//! table, which also pins the two sets equal. Adding a binary to the table therefore
+//! makes the gate name every pipeline file that does not ship it yet.
+//!
+//! Deliberately text-only and free of any `xtask::dist` API, so it compiles and fails
+//! against a tree whose pipeline still ships one binary. Container-free (ADR-0016),
+//! like `fdb_image.rs`: the real build and install are the release workflow's.
+
+#![forbid(unsafe_code)]
+
+use std::path::{Path, PathBuf};
+
+/// The binaries the pipeline must ship, as `(in-image path, tarball destination)`.
+/// Must equal `xtask::dist::shipped_binaries()` (pinned in `dist_templates.rs`).
+pub const EXPECTED_BINARIES: [(&str, &str); 2] = [
+    ("/usr/local/bin/wyrd", "bin/wyrd"),
+    ("/usr/local/bin/wyrd-validate", "bin/wyrd-validate"),
+];
+
+pub const DOCKERFILE: &str = "deploy/docker/wyrd/Dockerfile";
+pub const INSTALL_SH: &str = "deploy/dist/install.sh";
+pub const README: &str = "deploy/dist/README.md";
+pub const RELEASE_YML: &str = ".github/workflows/release.yml";
+
+fn workspace_root() -> PathBuf {
+    Path::new(env!("CARGO_MANIFEST_DIR"))
+        .parent()
+        .expect("xtask crate is nested under the workspace root")
+        .to_path_buf()
+}
+
+fn read(rel: &str) -> String {
+    let path = workspace_root().join(rel);
+    std::fs::read_to_string(&path).unwrap_or_else(|e| panic!("read {}: {e}", path.display()))
+}
+
+/// The file name a binary carries everywhere (its cargo `--bin` name).
+fn name_of(tarball_dest: &str) -> &str {
+    tarball_dest.rsplit('/').next().unwrap_or(tarball_dest)
+}
+
+/// Every place the pipeline files disagree with `binaries` (`(in-image path, tarball
+/// destination)` pairs), each message prefixed with the repo-relative file at fault.
+/// Empty means every stage ships exactly this set. A binary a stage lacks AND a
+/// binary a stage ships beyond the set are both disagreements.
+pub fn pipeline_disagreements(binaries: &[(&str, &str)]) -> Vec<String> {
+    let names: Vec<&str> = binaries.iter().map(|(_, dest)| name_of(dest)).collect();
+    let mut out = Vec::new();
+    dockerfile_disagreements(binaries, &names, &mut out);
+    install_sh_disagreements(binaries, &names, &mut out);
+    release_yml_disagreements(&names, &mut out);
+    readme_disagreements(binaries, &names, &mut out);
+    out
+}
+
+/// 1. The build stage builds each binary and the runtime stage copies each to its
+///    in-image path.
+fn dockerfile_disagreements(binaries: &[(&str, &str)], names: &[&str], out: &mut Vec<String>) {
+    let text = read(DOCKERFILE);
+    let built: Vec<&str> = text
+        .lines()
+        .map(str::trim)
+        .filter(|l| l.starts_with("RUN cargo build"))
+        .flat_map(|l| {
+            let tokens: Vec<&str> = l.split_whitespace().collect();
+            tokens
+                .windows(2)
+                .filter(|w| w[0] == "--bin")
+                .map(|w| w[1])
+                .collect::<Vec<_>>()
+        })
+        .collect();
+    let copies: Vec<Vec<&str>> = text
+        .lines()
+        .map(|l| l.split_whitespace().collect::<Vec<_>>())
+        .filter(|t| t.len() == 4 && t[0] == "COPY" && t[1] == "--from=build")
+        .collect();
+    for (image_path, dest) in binaries {
+        let name = name_of(dest);
+        if !built.contains(&name) {
+            out.push(format!(
+                "{DOCKERFILE}: the `RUN cargo build` line does not build `--bin {name}`"
+            ));
+        }
+        let source = format!("/src/target/release/{name}");
+        if !copies.iter().any(|t| t[2] == source && t[3] == *image_path) {
+            out.push(format!(
+                "{DOCKERFILE}: no `COPY --from=build {source} {image_path}` into the runtime stage"
+            ));
+        }
+    }
+    for extra in built.iter().filter(|b| !names.contains(b)) {
+        out.push(format!(
+            "{DOCKERFILE}: builds `--bin {extra}`, which is not a shipped binary"
+        ));
+    }
+    for t in &copies {
+        if let Some(extra) = t[2].strip_prefix("/src/target/release/") {
+            if !names.contains(&extra) {
+                out.push(format!(
+                    "{DOCKERFILE}: copies `{extra}` into the image, which is not a shipped binary"
+                ));
+            }
+        }
+    }
+}
+
+/// 2. `install.sh` installs each binary from `bin/<name>` in its install path, removes
+///    each in its `--uninstall` path, and never makes one a systemd role.
+fn install_sh_disagreements(binaries: &[(&str, &str)], names: &[&str], out: &mut Vec<String>) {
+    let text = read(INSTALL_SH);
+    // The uninstall branch precedes the install section's banner and ends in `exit 0`.
+    let Some(split) = text.find("# ── install") else {
+        out.push(format!(
+            "{INSTALL_SH}: lost its `# ── install` section banner"
+        ));
+        return;
+    };
+    let (uninstall, install) = text.split_at(split);
+    let install_lines: Vec<&str> = install.lines().map(str::trim).collect();
+    let uninstall_lines: Vec<&str> = uninstall.lines().map(str::trim).collect();
+    for (_, dest) in binaries {
+        let name = name_of(dest);
+        let install_line = format!("install -m 0755 \"$HERE/{dest}\" \"$BINDIR/{name}\"");
+        if !install_lines.contains(&install_line.as_str()) {
+            out.push(format!(
+                "{INSTALL_SH}: the install path lacks `{install_line}`"
+            ));
+        }
+        let remove_line = format!("rm -f \"$BINDIR/{name}\"");
+        if !uninstall_lines.contains(&remove_line.as_str()) {
+            out.push(format!(
+                "{INSTALL_SH}: the --uninstall path lacks `{remove_line}`"
+            ));
+        }
+    }
+    for line in install_lines.iter().chain(&uninstall_lines) {
+        let shipped = line
+            .strip_prefix("install -m 0755 \"$HERE/bin/")
+            .or_else(|| line.strip_prefix("rm -f \"$BINDIR/"))
+            .and_then(|rest| rest.split('"').next());
+        if let Some(extra) = shipped {
+            if !names.contains(&extra) {
+                out.push(format!(
+                    "{INSTALL_SH}: installs or removes `{extra}`, which is not a shipped binary"
+                ));
+            }
+        }
+    }
+    // A shipped binary is never a role: ROLES drives units, /etc/wyrd/<role>.env and
+    // `systemctl disable`.
+    for line in text.lines().map(str::trim) {
+        if let Some(roles) = line.strip_prefix("ROLES=") {
+            for name in names {
+                if roles
+                    .trim_matches('"')
+                    .split_whitespace()
+                    .any(|r| r == *name)
+                {
+                    out.push(format!(
+                        "{INSTALL_SH}: `{name}` is in ROLES — a shipped binary is not a role"
+                    ));
+                }
+            }
+        }
+    }
+}
+
+/// 3. The release workflow's installer smoke step exercises each installed binary and
+///    asserts each is gone after `--uninstall`.
+fn release_yml_disagreements(names: &[&str], out: &mut Vec<String>) {
+    let text = read(RELEASE_YML);
+    let Some(start) = text.find("name: smoke the installer") else {
+        out.push(format!(
+            "{RELEASE_YML}: lost its `smoke the installer` step"
+        ));
+        return;
+    };
+    let step = &text[start..];
+    // The step ends where the next step of the job begins.
+    let step = step.find("\n      - ").map_or(step, |end| &step[..end]);
+    let lines: Vec<&str> = step.lines().map(str::trim).collect();
+    for name in names {
+        let installed = format!("/usr/local/bin/{name}");
+        let absent = format!("test ! -e {installed}");
+        let exercised = lines
+            .iter()
+            .any(|l| l.split_whitespace().any(|w| w == installed) && !l.starts_with("test ! -e"));
+        if !exercised {
+            out.push(format!(
+                "{RELEASE_YML}: the smoke step never runs `{installed}`"
+            ));
+        }
+        if !lines.contains(&absent.as_str()) {
+            out.push(format!(
+                "{RELEASE_YML}: the smoke step lacks `{absent}` after --uninstall"
+            ));
+        }
+    }
+}
+
+/// 4. The tarball README's binaries table gives each binary its own row with a
+///    description of its role, and the install section names each installed path.
+fn readme_disagreements(binaries: &[(&str, &str)], names: &[&str], out: &mut Vec<String>) {
+    let text = read(README);
+    let rows: Vec<(&str, &str)> = text
+        .lines()
+        .filter_map(|l| l.trim().strip_prefix("| `bin/"))
+        .filter_map(|rest| rest.split_once("` |"))
+        .map(|(name, desc)| (name, desc.trim().trim_end_matches('|').trim()))
+        .collect();
+    for (_, dest) in binaries {
+        let name = name_of(dest);
+        match rows.iter().find(|(n, _)| *n == name) {
+            None => out.push(format!(
+                "{README}: the binaries table has no row for `{dest}`"
+            )),
+            Some((_, "")) => out.push(format!(
+                "{README}: the `{dest}` row does not say what the binary is for"
+            )),
+            Some(_) => {}
+        }
+        let installed = format!("`<prefix>/{dest}`");
+        if !text.contains(&installed) {
+            out.push(format!(
+                "{README}: the install section does not name {installed}"
+            ));
+        }
+    }
+    for (extra, _) in rows.iter().filter(|(n, _)| !names.contains(n)) {
+        out.push(format!(
+            "{README}: the binaries table lists `bin/{extra}`, which is not a shipped binary"
+        ));
+    }
+}
+
+/// Every pipeline stage ships exactly the expected binary set.
+#[test]
+fn every_pipeline_stage_ships_the_expected_binaries() {
+    let disagreements = pipeline_disagreements(&EXPECTED_BINARIES);
+    assert!(
+        disagreements.is_empty(),
+        "the distribution pipeline disagrees with the shipped binary set {EXPECTED_BINARIES:?}:\n  {}",
+        disagreements.join("\n  ")
+    );
+}
+
+/// The README keeps its roles sentence (the validator is not a role, so it is added
+/// beside that sentence, not folded into it) and introduces the validator as a
+/// separate, non-role binary.
+#[test]
+fn the_readme_keeps_the_roles_binary_apart_from_the_validator() {
+    let text = read(README);
+    assert!(
+        text.contains("One `wyrd` binary serves every role as a")
+            && text.contains("subcommand: `d-server`, `custodian`, `s3`"),
+        "{README} must keep `One `wyrd` binary serves every role as a subcommand`"
+    );
+    assert!(
+        text.contains("`wyrd-validate`, the blackbox validation tool"),
+        "{README} must introduce `wyrd-validate` as the blackbox validation tool"
+    );
+}
