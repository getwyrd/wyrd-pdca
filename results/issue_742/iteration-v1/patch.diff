+/// The real staging step, over two dummy binaries with DIFFERENT contents: each lands
+/// at its own tarball destination, mode 0755, byte-for-byte equal to its own source —
+/// so copying one source to both destinations, or swapping them, fails.
+#[test]
+fn stage_binaries_copies_each_binary_to_its_own_destination() {
+    use std::os::unix::fs::PermissionsExt;
+
+    let scratch = Path::new(env!("CARGO_TARGET_TMPDIR")).join("dist_stage_binaries");
+    if scratch.exists() {
+        std::fs::remove_dir_all(&scratch).expect("clear scratch");
+    }
+    let source_dir = scratch.join("extracted");
+    let stage = scratch.join("stage");
+    std::fs::create_dir_all(&source_dir).expect("mkdir source");
+
+    let table = dist::shipped_binaries();
+    let contents = |bin: &str| match bin {
+        "wyrd" => b"roles-binary".to_vec(),
+        "wyrd-validate" => b"validator-binary".to_vec(),
+        other => panic!("no dummy contents for `{other}`"),
+    };
+    for b in &table {
+        std::fs::write(dist::binary_source_path(&source_dir, b), contents(b.bin))
+            .expect("write dummy binary");
+    }
+
+    dist::stage_binaries(&table, &source_dir, &stage).expect("staging succeeds");
+
+    for (dest, expected) in [
+        ("bin/wyrd", b"roles-binary".as_slice()),
+        ("bin/wyrd-validate", b"validator-binary".as_slice()),
+    ] {
+        let staged = stage.join(dest);
+        assert_eq!(
+            std::fs::read(&staged).unwrap_or_else(|e| panic!("read {dest}: {e}")),
+            expected,
+            "{dest} is not byte-for-byte its own source"
+        );
+        let mode = std::fs::metadata(&staged)
+            .expect("stat")
+            .permissions()
+            .mode()
+            & 0o777;
+        assert_eq!(mode, 0o755, "{dest} must stage 0755, got {mode:o}");
+    }
+
+    // A missing source is an error, never a silently smaller tarball.
+    std::fs::remove_file(source_dir.join("wyrd-validate")).expect("remove one source");
+    let err = dist::stage_binaries(&table, &source_dir, &scratch.join("stage-missing"))
+        .expect_err("a missing binary must fail staging");
+    assert!(err.contains("wyrd-validate"), "unexpected error: {err}");
+}
