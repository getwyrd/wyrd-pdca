+        // The invocation moved after `./install.sh --uninstall`.
+        let text = edit_lines(&real, |l| invokes(l).then(String::new));
+        let text = edit_lines(&text, |l| {
+            (l.trim() == "./install.sh --uninstall")
+                .then(|| format!("{l}\n{}{installed}", indent_of(l)))
+        });
+        assert!(reports(&check(&text), layout::RELEASE_YML, &never_runs));
+
+        // The absence check commented out.
+        let text = edit_lines(&real, |l| {
+            (l.trim() == absent).then(|| format!("{}# {absent}", indent_of(l)))
+        });
+        assert!(reports(&check(&text), layout::RELEASE_YML, &never_gone));
+
+        // The absence check moved before the install, where it proves nothing.
+        let text = edit_lines(&real, |l| (l.trim() == absent).then(String::new));
+        let text = edit_lines(&text, |l| {
+            (l.trim() == "cd /tmp/wyrd-*").then(|| format!("{l}\n{}{absent}", indent_of(l)))
