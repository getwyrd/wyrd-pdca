+/// `text` with each line `edit` maps to `Some` replaced by that text (which may span
+/// lines). Panics when no line matched, so a mutation that drifts from the real file
+/// fails loudly instead of testing nothing.
+fn edit_lines(text: &str, edit: impl Fn(&str) -> Option<String>) -> String {
+    let mut edited = false;
+    let out: Vec<String> = text
+        .lines()
+        .map(|line| match edit(line) {
+            Some(new) => {
+                edited = true;
+                new
+            }
+            None => line.to_string(),
+        })
+        .collect();
+    assert!(edited, "the mutation matched no line of the real file");
+    out.join("\n")
+}
