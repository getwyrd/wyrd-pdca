+
+/// A fresh scratch directory under the test target dir.
+fn scratch(name: &str) -> PathBuf {
+    let dir = Path::new(env!("CARGO_TARGET_TMPDIR")).join(name);
+    if dir.exists() {
+        std::fs::remove_dir_all(&dir).expect("clear scratch");
+    }
+    std::fs::create_dir_all(&dir).expect("mkdir scratch");
+    dir
+}
+
+/// One dummy "binary" per shipped binary, each with DIFFERENT bytes, written where
+/// staging reads it. Returns each entry with its bytes.
+fn write_dummy_binaries(source_dir: &Path) -> Vec<(dist::ShippedBinary, Vec<u8>)> {
+    std::fs::create_dir_all(source_dir).expect("mkdir source");
+    dist::shipped_binaries()
+        .into_iter()
+        .map(|b| {
+            let bytes = format!("{}-binary-bytes", b.bin).into_bytes();
+            std::fs::write(dist::binary_source_path(source_dir, &b), &bytes)
+                .expect("write dummy binary");
+            (b, bytes)
+        })
+        .collect()
+}
+
+/// Every staged binary is byte-for-byte ITS OWN source and mode 0755 — so copying one
+/// source to every destination, or swapping two, fails.
+fn assert_each_binary_staged_from_its_own_source(
+    stage: &Path,
+    dummies: &[(dist::ShippedBinary, Vec<u8>)],
+) {
+    use std::os::unix::fs::PermissionsExt;
+
+    for (binary, bytes) in dummies {
+        let staged = stage.join(binary.tarball_dest);
+        assert_eq!(
+            &std::fs::read(&staged).unwrap_or_else(|e| panic!("read {}: {e}", staged.display())),
+            bytes,
+            "{} is not byte-for-byte its own source",
+            binary.tarball_dest
+        );
+        let mode = std::fs::metadata(&staged)
+            .expect("stat staged binary")
+            .permissions()
+            .mode()
+            & 0o777;
+        assert_eq!(
+            mode, 0o755,
+            "{} must stage 0755, got {mode:o}",
+            binary.tarball_dest
+        );
+    }
+}
+
+/// Every file under `root`, relative and sorted.
+fn files_under(root: &Path) -> Vec<String> {
+    fn walk(root: &Path, dir: &Path, out: &mut Vec<String>) {
+        for entry in std::fs::read_dir(dir).expect("read_dir") {
+            let path = entry.expect("dir entry").path();
+            if path.is_dir() {
+                walk(root, &path, out);
+            } else {
+                let rel = path.strip_prefix(root).expect("under root");
+                out.push(rel.to_string_lossy().into_owned());
+            }
+        }
+    }
+    let mut out = Vec::new();
+    walk(root, root, &mut out);
+    out.sort();
+    out
+}
+
+/// The binary-staging step, over two dummy binaries with different contents: the
+/// staging tree ends up with exactly `bin/wyrd` and `bin/wyrd-validate`, each its own
+/// source's bytes at 0755. A missing source is an error naming it.
+#[test]
+fn stage_binaries_copies_each_binary_to_its_own_destination() {
+    let scratch = scratch("dist_stage_binaries");
+    let source_dir = scratch.join("extracted");
+    let stage = scratch.join("stage");
+    let dummies = write_dummy_binaries(&source_dir);
+    let table = dist::shipped_binaries();
+
+    dist::stage_binaries(&table, &source_dir, &stage).expect("staging succeeds");
+
+    assert_eq!(files_under(&stage), ["bin/wyrd", "bin/wyrd-validate"]);
+    assert_each_binary_staged_from_its_own_source(&stage, &dummies);
+
+    std::fs::remove_file(dist::binary_source_path(&source_dir, &table[1]))
+        .expect("remove one source");
+    let err = dist::stage_binaries(&table, &source_dir, &scratch.join("stage-missing"))
+        .expect_err("a missing binary must fail staging");
+    assert!(err.contains(table[1].bin), "unexpected error: {err}");
+}
+
+/// The whole tarball staging `assemble` runs (everything but the `tar`), over the real
+/// templates and dummy binaries: the tree holds exactly the staging plan, every
+/// shipped binary (each its own bytes, 0755) and `VERSION`.
+#[test]
+fn the_tarball_tree_stages_the_plan_and_every_shipped_binary() {
+    let scratch = scratch("dist_stage_tarball_tree");
+    let source_dir = scratch.join("extracted");
+    let stage = scratch.join("wyrd-1.2.3-x86_64-unknown-linux-gnu");
+    let dummies = write_dummy_binaries(&source_dir);
+
+    dist::stage_tarball_tree(
+        &workspace_root(),
+        &stage,
+        "1.2.3",
+        "fdb",
+        "7.3.77",
+        &source_dir,
+    )
+    .expect("staging succeeds");
+
+    let mut expected: Vec<String> = dist::staging_plan()
+        .iter()
+        .map(|f| f.dest.to_string())
+        .chain(
+            dist::shipped_binaries()
+                .iter()
+                .map(|b| b.tarball_dest.to_string()),
+        )
+        .chain(["VERSION".to_string()])
+        .collect();
+    expected.sort();
+    assert_eq!(files_under(&stage), expected);
+    assert_each_binary_staged_from_its_own_source(&stage, &dummies);
+    assert_eq!(
+        std::fs::read_to_string(stage.join("VERSION")).expect("read VERSION"),
+        "version: 1.2.3\nflavor: fdb\nfoundationdb-clients: 7.3.77\n"
+    );
+}
diff --git a/xtask/tests/dist_two_binary_layout.rs b/xtask/tests/dist_two_binary_layout.rs
new file mode 100644
index 0000000..82721b6
--- /dev/null
+++ b/xtask/tests/dist_two_binary_layout.rs
@@ -0,0 +1,407 @@
+//! The distribution ships TWO binaries (#742, proposal 0017 §2): the `wyrd` roles
+//! binary and the `wyrd-validate` blackbox validation tool. The set is declared once,
+//! in `xtask::dist::shipped_binaries()`. The Dockerfile, `install.sh`, the tarball
+//! README and the release smoke step cannot read Rust, so each spells the set out
+//! itself, and this file is the check that compares those spellings to a binary set.
+//!
+//! [`pipeline_disagreements`] is ONE checker over a binary set, not assertions written
+//! out per binary. It runs twice: here over [`EXPECTED_BINARIES`], and in
+//! `dist_templates.rs` (which includes this file as a module) over the production
+//! table, where the two sets are also pinned equal. So adding a binary to the table
+//! makes the gate name every pipeline file that does not ship it yet.
+//!
+//! The checks read commands, not mentions: comment lines never count, a binary is
+//! "run" only in command position, and each check is tied to the part of the file
+//! where it means something (the install vs `--uninstall` branch of `install.sh`, the
+//! build vs runtime stage of the Dockerfile, before vs after `./install.sh
+//! --uninstall` in the smoke step).
+//!
+//! Text-only and free of any `xtask::dist` API, so it compiles (and fails) against a
+//! tree whose pipeline still ships one binary. Container-free (ADR-0016), like
+//! `fdb_image.rs`: the real build and install are the release workflow's to prove.
+
+#![forbid(unsafe_code)]
+
+use std::path::{Path, PathBuf};
+
+/// The binaries the pipeline must ship, as `(in-image path, tarball destination)`.
+/// Must equal `xtask::dist::shipped_binaries()` (pinned in `dist_templates.rs`).
+pub const EXPECTED_BINARIES: [(&str, &str); 2] = [
+    ("/usr/local/bin/wyrd", "bin/wyrd"),
+    ("/usr/local/bin/wyrd-validate", "bin/wyrd-validate"),
+];
+
+pub const DOCKERFILE: &str = "deploy/docker/wyrd/Dockerfile";
+pub const INSTALL_SH: &str = "deploy/dist/install.sh";
+pub const README: &str = "deploy/dist/README.md";
+pub const RELEASE_YML: &str = ".github/workflows/release.yml";
+
+/// Where `install.sh` puts a binary under its default `--prefix /usr/local`, which is
+/// where the release smoke step looks for it.
+const DEFAULT_BINDIR: &str = "/usr/local/bin";
+
+fn workspace_root() -> PathBuf {
+    Path::new(env!("CARGO_MANIFEST_DIR"))
+        .parent()
+        .expect("xtask crate is nested under the workspace root")
+        .to_path_buf()
+}
+
+/// A repo file's text, by repo-relative path.
+pub fn read_repo_file(rel: &str) -> String {
+    let path = workspace_root().join(rel);
+    std::fs::read_to_string(&path).unwrap_or_else(|e| panic!("read {}: {e}", path.display()))
+}
+
+/// A binary's file name — its cargo `--bin` name — from its tarball destination.
+fn name_of(tarball_dest: &str) -> &str {
+    tarball_dest.rsplit('/').next().unwrap_or(tarball_dest)
+}
+
+/// The shell (or Dockerfile) words of `line`, stopping at a `#` comment. A blank or
+/// comment line has none, so nothing in a comment ever counts as a command.
+fn words(line: &str) -> Vec<&str> {
+    line.split_whitespace()
+        .take_while(|w| !w.starts_with('#'))
+        .collect()
+}
+
+/// `words` without the leading shell keywords, so the first word is the command the
+/// line runs (`if /usr/local/bin/wyrd …; then` runs `/usr/local/bin/wyrd`).
+fn command<'a>(words: &[&'a str]) -> Vec<&'a str> {
+    words
+        .iter()
+        .skip_while(|w| {
+            matches!(
+                **w,
+                "if" | "elif" | "then" | "else" | "do" | "while" | "until" | "!" | "time"
+            )
+        })
+        .copied()
+        .collect()
+}
+
+/// Every place the four pipeline files disagree with `binaries` (`(in-image path,
+/// tarball destination)` pairs), each message prefixed with the repo-relative file at
+/// fault. Empty means every stage ships exactly this set: a binary a stage lacks and a
+/// binary a stage ships beyond the set are both disagreements.
+pub fn pipeline_disagreements(binaries: &[(&str, &str)]) -> Vec<String> {
+    let mut out = dockerfile_disagreements(&read_repo_file(DOCKERFILE), binaries);
+    out.extend(install_sh_disagreements(
+        &read_repo_file(INSTALL_SH),
+        binaries,
+    ));
+    out.extend(release_yml_disagreements(
+        &read_repo_file(RELEASE_YML),
+        binaries,
+    ));
+    out.extend(readme_disagreements(&read_repo_file(README), binaries));
+    out
+}
+
+/// 1. The build stage (`FROM … AS build`) builds each binary with `RUN cargo build …
+///    --bin <name>`, and the runtime stage (the last `FROM`) copies each with `COPY
+///    --from=build /src/target/release/<name> <in-image path>`.
+pub fn dockerfile_disagreements(text: &str, binaries: &[(&str, &str)]) -> Vec<String> {
+    // Instructions, with `\` continuations joined, comments dropped, each tagged with
+    // the stage it belongs to (its index among the `FROM`s and whether it is `AS build`).
+    let mut instructions: Vec<(usize, bool, Vec<&str>)> = Vec::new();
+    let (mut stage, mut is_build) = (0usize, false);
+    let mut pending: Vec<&str> = Vec::new();
+    for line in text.lines() {
+        // A comment line is dropped before continuations are joined, as Docker does.
+        if line.trim_start().starts_with('#') {
+            continue;
+        }
+        let trimmed = line.trim_end();
+        let continued = trimmed.ends_with('\\');
+        pending.extend(words(trimmed.trim_end_matches('\\')));
+        if continued {
+            continue;
+        }
+        let instruction = std::mem::take(&mut pending);
+        if instruction
+            .first()
+            .is_some_and(|w| w.eq_ignore_ascii_case("FROM"))
+        {
+            stage += 1;
+            is_build = instruction
+                .windows(2)
+                .any(|w| w[0].eq_ignore_ascii_case("AS") && w[1] == "build");
+        }
+        if !instruction.is_empty() {
+            instructions.push((stage, is_build, instruction));
+        }
+    }
+    let runtime_stage = stage;
+
+    let built: Vec<&str> = instructions
+        .iter()
+        .filter(|(_, build, i)| *build && i.starts_with(&["RUN", "cargo", "build"]))
+        .flat_map(|(_, _, i)| i.windows(2).filter(|w| w[0] == "--bin").map(|w| w[1]))
+        .collect();
+    let copied: Vec<(&str, &str)> = instructions
+        .iter()
+        .filter(|(s, _, i)| *s == runtime_stage && i.len() == 4)
+        .filter(|(_, _, i)| i[0] == "COPY" && i[1] == "--from=build")
+        .filter_map(|(_, _, i)| {
+            i[2].strip_prefix("/src/target/release/")
+                .map(|name| (name, i[3]))
+        })
+        .collect();
+
+    let names: Vec<&str> = binaries.iter().map(|(_, dest)| name_of(dest)).collect();
+    let mut out = Vec::new();
+    for (image_path, dest) in binaries {
+        let name = name_of(dest);
+        if !built.contains(&name) {
+            out.push(format!(
+                "{DOCKERFILE}: the build stage's `RUN cargo build` does not build `--bin {name}`"
+            ));
+        }
+        if !copied.contains(&(name, *image_path)) {
+            out.push(format!(
+                "{DOCKERFILE}: the runtime stage has no \
+                 `COPY --from=build /src/target/release/{name} {image_path}`"
+            ));
+        }
+    }
+    for extra in built.iter().filter(|b| !names.contains(b)) {
+        out.push(format!(
+            "{DOCKERFILE}: builds `--bin {extra}`, which is not in the shipped binary set"
+        ));
+    }
+    for (name, image_path) in &copied {
+        if !binaries
+            .iter()
+            .any(|(path, dest)| path == image_path && name_of(dest) == *name)
+        {
+            out.push(format!(
+                "{DOCKERFILE}: copies `{name}` to `{image_path}`, which is not in the shipped \
+                 binary set"
+            ));
+        }
+    }
+    out
+}
+
+/// 2. `install.sh` installs each binary from `bin/<name>` after its `--uninstall`
+///    branch, removes each inside that branch, and never makes one a role (`ROLES`
+///    drives systemd units, `/etc/wyrd/<role>.env` and `systemctl disable`).
+pub fn install_sh_disagreements(text: &str, binaries: &[(&str, &str)]) -> Vec<String> {
+    const UNINSTALL_IF: &str = "if [ \"$UNINSTALL\" = 1 ]; then";
+    let lines: Vec<&str> = text.lines().collect();
+    // The `--uninstall` branch runs from its `if` to the first unindented `fi`; the
+    // install path is everything after it.
+    let branch = lines
+        .iter()
+        .position(|l| l.trim() == UNINSTALL_IF)
+        .and_then(|start| {
+            lines[start..]
+                .iter()
+                .position(|l| *l == "fi")
+                .map(|len| (start, start + len))
+        });
+    let Some((start, end)) = branch else {
+        return vec![format!(
+            "{INSTALL_SH}: lost its `{UNINSTALL_IF}` … `fi` branch, so no removal can be \
+             checked"
+        )];
+    };
+    let commands =
+        |range: &[&str]| -> Vec<String> { range.iter().map(|l| words(l).join(" ")).collect() };
+    let uninstall = commands(&lines[start + 1..end]);
+    let install = commands(&lines[end + 1..]);
+
+    let names: Vec<&str> = binaries.iter().map(|(_, dest)| name_of(dest)).collect();
+    let mut out = Vec::new();
+    for (_, dest) in binaries {
+        let name = name_of(dest);
+        let install_cmd = format!("install -m 0755 \"$HERE/{dest}\" \"$BINDIR/{name}\"");
+        if !install.contains(&install_cmd) {
+            out.push(format!(
+                "{INSTALL_SH}: the install path never runs `{install_cmd}`"
+            ));
+        }
+        let remove_cmd = format!("rm -f \"$BINDIR/{name}\"");
+        if !uninstall.contains(&remove_cmd) {
+            out.push(format!(
+                "{INSTALL_SH}: the --uninstall branch never runs `{remove_cmd}`"
+            ));
+        }
+    }
+    let shipped = |cmd: &str, prefix: &str| -> Option<String> {
+        cmd.strip_prefix(prefix)
+            .and_then(|rest| rest.split('"').next())
+            .map(str::to_string)
+    };
+    for extra in install
+        .iter()
+        .filter_map(|c| shipped(c.as_str(), "install -m 0755 \"$HERE/bin/"))
+        .chain(
+            uninstall
+                .iter()
+                .filter_map(|c| shipped(c.as_str(), "rm -f \"$BINDIR/")),
+        )
+        .filter(|n| !names.contains(&n.as_str()))
+    {
+        out.push(format!(
+            "{INSTALL_SH}: installs or removes `{extra}`, which is not in the shipped binary set"
+        ));
+    }
+    for line in &lines {
+        let Some(roles) = line.trim().strip_prefix("ROLES=") else {
+            continue;
+        };
+        for role in roles.trim_matches('"').split_whitespace() {
+            let unit_name = format!("wyrd-{role}");
+            if names.contains(&role) || names.contains(&unit_name.as_str()) {
+                out.push(format!(
+                    "{INSTALL_SH}: ROLES names `{role}`, which makes a shipped binary a role \
+                     (a unit, a config file, a `systemctl disable`)"
+                ));
+            }
+        }
+    }
+    out
+}
+
+/// 3. The release workflow's installer smoke step RUNS each installed binary (in
+///    command position, between `./install.sh` and `./install.sh --uninstall`) and
+///    asserts `test ! -e` on each AFTER `./install.sh --uninstall`.
+pub fn release_yml_disagreements(text: &str, binaries: &[(&str, &str)]) -> Vec<String> {
+    let lines: Vec<&str> = text.lines().collect();
+    let Some(start) = lines
+        .iter()
+        .position(|l| l.trim_start().starts_with("- name: smoke the installer"))
+    else {
+        return vec![format!(
+            "{RELEASE_YML}: lost its `smoke the installer` step"
+        )];
+    };
+    // The step ends where the next step of the job begins (same indentation, `- `).
+    let indent = lines[start].len() - lines[start].trim_start().len();
+    let end = lines[start + 1..]
+        .iter()
+        .position(|l| l.len() - l.trim_start().len() == indent && l.trim_start().starts_with("- "))
+        .map_or(lines.len(), |n| start + 1 + n);
+    let step: Vec<Vec<&str>> = lines[start..end].iter().map(|l| words(l)).collect();
+
+    let install = step.iter().position(|w| *w == ["./install.sh"]);
+    let uninstall = step
+        .iter()
+        .position(|w| *w == ["./install.sh", "--uninstall"]);
+    let (Some(install), Some(uninstall)) = (install, uninstall) else {
+        return vec![format!(
+            "{RELEASE_YML}: the smoke step no longer runs both `./install.sh` and \
+             `./install.sh --uninstall`, so nothing it asserts about binaries can be placed"
+        )];
+    };
+    if uninstall < install {
+        return vec![format!(
+            "{RELEASE_YML}: the smoke step runs `./install.sh --uninstall` before `./install.sh`"
+        )];
+    }
+
+    let names: Vec<&str> = binaries.iter().map(|(_, dest)| name_of(dest)).collect();
+    let mut out = Vec::new();
+    for name in &names {
+        let installed = format!("{DEFAULT_BINDIR}/{name}");
+        let runs = step[install + 1..uninstall]
+            .iter()
+            .any(|w| command(w).first() == Some(&installed.as_str()));
+        if !runs {
+            out.push(format!(
+                "{RELEASE_YML}: the smoke step never runs `{installed}` between `./install.sh` \
+                 and `./install.sh --uninstall`"
+            ));
+        }
+        let gone = step[uninstall + 1..]
+            .iter()
+            .any(|w| *w == ["test", "!", "-e", installed.as_str()]);
+        if !gone {
+            out.push(format!(
+                "{RELEASE_YML}: the smoke step never asserts `test ! -e {installed}` after \
+                 `./install.sh --uninstall`"
+            ));
+        }
+    }
+    let bindir = format!("{DEFAULT_BINDIR}/");
+    for w in &step {
+        let cmd = command(w);
+        let ran = cmd.first().and_then(|c| c.strip_prefix(&bindir));
+        let tested = match cmd.as_slice() {
+            ["test", "!", "-e", path] => path.strip_prefix(&bindir),
+            _ => None,
+        };
+        if let Some(extra) = ran.or(tested).filter(|n| !names.contains(n)) {
+            out.push(format!(
+                "{RELEASE_YML}: the smoke step exercises `{bindir}{extra}`, which is not in the \
+                 shipped binary set"
+            ));
+        }
+    }
+    out
+}
+
+/// 4. The tarball README keeps its roles sentence (the validator is not a role, so it
+///    is introduced beside that sentence, not folded into it), gives each binary its
+///    own row in the binaries table with its own description of what it is for, and
+///    names each installed path in the install section.
+pub fn readme_disagreements(text: &str, binaries: &[(&str, &str)]) -> Vec<String> {
+    const ROLES_SENTENCE: &str = "One `wyrd` binary serves every role as a subcommand";
+    let mut out = Vec::new();
+    let flowed = text.split_whitespace().collect::<Vec<_>>().join(" ");
+    if !flowed.contains(ROLES_SENTENCE) {
+        out.push(format!("{README}: lost the sentence `{ROLES_SENTENCE}`"));
+    }
+    let rows: Vec<(&str, &str)> = text
+        .lines()
+        .filter_map(|l| l.trim().strip_prefix("| `bin/"))
+        .filter_map(|rest| rest.split_once("` |"))
+        .map(|(name, desc)| (name, desc.trim().trim_end_matches('|').trim()))
+        .collect();
+    let names: Vec<&str> = binaries.iter().map(|(_, dest)| name_of(dest)).collect();
+    for (_, dest) in binaries {
+        let name = name_of(dest);
+        match rows.iter().find(|(n, _)| *n == name) {
+            None => out.push(format!(
+                "{README}: the binaries table has no `| `{dest}` | … |` row"
+            )),
+            Some((_, "")) => out.push(format!(
+                "{README}: the `{dest}` row does not say what the binary is for"
+            )),
+            Some((_, desc)) => {
+                if rows.iter().any(|(n, d)| n != &name && d == desc) {
+                    out.push(format!(
+                        "{README}: the `{dest}` row repeats another binary's description"
+                    ));
+                }
+            }
+        }
+        let installed = format!("`<prefix>/{dest}`");
+        if !text.contains(&installed) {
+            out.push(format!(
+                "{README}: the install section does not name {installed}"
+            ));
+        }
+    }
+    for (extra, _) in rows.iter().filter(|(n, _)| !names.contains(n)) {
+        out.push(format!(
+            "{README}: the binaries table lists `bin/{extra}`, which is not in the shipped \
+             binary set"
+        ));
+    }
+    out
+}
+
+/// Every pipeline stage ships exactly the expected binary set.
+#[test]
+fn every_pipeline_stage_ships_the_expected_binaries() {
+    let disagreements = pipeline_disagreements(&EXPECTED_BINARIES);
+    assert!(
+        disagreements.is_empty(),
+        "the distribution pipeline disagrees with the shipped binary set {EXPECTED_BINARIES:?}:\n  {}",
+        disagreements.join("\n  ")
+    );
+}
