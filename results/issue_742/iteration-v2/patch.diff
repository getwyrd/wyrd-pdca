+/// Where a shipped binary sits in a source directory on the packaging host: the
+/// `docker cp` target under the extraction directory, or `target/release/<bin>` for
+/// `--host`. [`stage_binaries`] reads exactly this path, so extraction and staging
+/// cannot disagree about it. Pure.
+pub fn binary_source_path(source_dir: &Path, binary: &ShippedBinary) -> PathBuf {
+    source_dir.join(binary.bin)
+}
+
+/// The host `cargo` argv for `--host`: ONE build naming every [`shipped_binaries`]
+/// entry, so a `--host` tarball carries the same binaries as an image-built one.
+/// Pure.
+pub fn host_build_args(features: &str) -> Vec<String> {
+    let mut args: Vec<String> = ["build", "--release", "--locked"]
+        .map(str::to_string)
+        .to_vec();
+    for binary in shipped_binaries() {
+        args.push("--bin".into());
+        args.push(binary.bin.into());
+    }
+    args.push("--features".into());
+    args.push(features.into());
+    args
+}
+
+/// The `docker` argv that extracts each [`shipped_binaries`] entry out of container
+/// `cid` into `extracted`: `cp <cid>:<image_path> <binary_source_path>`, one per
+/// binary. Pure — the runner executes exactly these.
+pub fn image_extraction_args(cid: &str, extracted: &Path) -> Vec<Vec<String>> {
+    shipped_binaries()
+        .iter()
+        .map(|binary| {
+            vec![
+                "cp".to_string(),
+                format!("{cid}:{}", binary.image_path),
+                binary_source_path(extracted, binary)
+                    .to_string_lossy()
+                    .into_owned(),
+            ]
+        })
+        .collect()
+}
+
+/// Copy each of `binaries` from `source_dir` (at [`binary_source_path`]) into the
+/// staging tree `stage` at its `tarball_dest`, mode `0755`. A missing source is an
+/// error, never a silently smaller tarball.
+pub fn stage_binaries(
+    binaries: &[ShippedBinary],
+    source_dir: &Path,
+    stage: &Path,
+) -> Result<(), String> {
+    use std::os::unix::fs::PermissionsExt;
+
+    for binary in binaries {
+        let source = binary_source_path(source_dir, binary);
+        let dest = stage.join(binary.tarball_dest);
+        if let Some(parent) = dest.parent() {
+            std::fs::create_dir_all(parent)
+                .map_err(|e| format!("dist: mkdir {}: {e}", parent.display()))?;
+        }
+        std::fs::copy(&source, &dest)
+            .map_err(|e| format!("dist: copy binary {}: {e}", source.display()))?;
+        std::fs::set_permissions(&dest, std::fs::Permissions::from_mode(0o755))
+            .map_err(|e| format!("dist: chmod {}: {e}", binary.tarball_dest))?;
+    }
+    Ok(())
+}
