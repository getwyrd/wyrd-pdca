+    for binary in dist::shipped_binaries() {
+        let installed = format!("/usr/local/bin/{}", binary.bin);
+        let absent = format!("test ! -e {installed}");
+        let invokes =
+            |line: &str| line.split_whitespace().any(|w| w == installed) && line.trim() != absent;
+        let never_runs = format!("never runs `{installed}`");
+        let never_gone = format!("never asserts `{absent}`");
+
+        // The invocation commented out.
+        let text = edit_lines(&real, |l| {
+            invokes(l).then(|| format!("{}# {}", indent_of(l), l.trim_start()))
+        });
+        assert!(reports(&check(&text), layout::RELEASE_YML, &never_runs));
+
+        // The invocation replaced by a comment that names it.
+        let text = edit_lines(&real, |l| {
+            invokes(l).then(|| format!("{}# TODO smoke {installed} later", indent_of(l)))
