+///   binary by design (it must not share the roles' dependency closure) and not a
+///   role, so it gets no systemd unit and no `/etc/wyrd/<role>.env`.
+pub fn shipped_binaries() -> Vec<ShippedBinary> {
+    vec![
+        ShippedBinary {
+            bin: "wyrd",
+            image_path: "/usr/local/bin/wyrd",
+            tarball_dest: "bin/wyrd",
+        },
+        ShippedBinary {
+            bin: "wyrd-validate",
+            image_path: "/usr/local/bin/wyrd-validate",
+            tarball_dest: "bin/wyrd-validate",
