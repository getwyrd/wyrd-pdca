+/// The resolve-retry rule's arbiter (`0016:2463-2471`): re-read the root and decide
+/// whether an absent segment means a concurrent retirement (`Ok(None)` — restart or drop)
+/// or an invariant violation (`Err` — fail closed, never a torn map).
+async fn retired_or_fail(
+    store: &dyn MetadataStore,
+    root_key: &[u8],
+    group: &SegmentGroup,
+    index: u32,
+) -> Result<Option<Vec<ReadSegment>>> {
+    let Some(bytes) = store.get(root_key).await? else {
+        // The root is gone: the object was deleted and its segments are being reclaimed.
+        return Ok(None);
+    };
+    let current: InodeRecord = decode(&bytes)?;
+    match current.chunk_map.group() {
+        // The root still names THIS generation, yet one of its segments is missing. A
+        // live generation never loses a segment, so this is corruption or a protocol
+        // violation — fail closed.
+        Some(current_group) if current_group == group => Err(ChunkMapError::SegmentAbsent {
+            nonce: group.nonce().to_string(),
+            epoch: group.epoch(),
+            index,
+        }
+        .into()),
+        // The root moved on (a different group, or back to a flat map): superseded.
+        _ => Ok(None),
+    }
+}
