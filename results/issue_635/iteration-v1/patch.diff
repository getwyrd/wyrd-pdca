+/// Read a segmented map's segments through the **bounded per-object range**
+/// `scan("seg:<nonce>:<epoch>:")` (≤ [`MAX_ROOT_SEGMENTS`], `0016:2463-2469`) — never a
+/// global `seg:` scan, and never another group's or another epoch's records.
+///
+/// The result is ordered by the **parsed `index`**, not by the order the store returned:
+/// [`MetadataStore::scan`] states "Order is unspecified" (`crates/traits/src/lib.rs:770-775`),
+/// so the fixed-width key is a debuggability property, not a licence to concatenate in
+/// arrival order. `Ok(None)` is the retired arm of the resolve-retry rule.
+async fn read_segments(
+    store: &dyn MetadataStore,
+    root_key: &[u8],
+    map: &SegmentedMap,
+) -> Result<Option<Vec<ReadSegment>>> {
+    let group = map.group();
+    let mut found: BTreeMap<u32, ReadSegment> = BTreeMap::new();
+    for (key, value) in store.scan(&seg_range_prefix(group)).await? {
+        let (nonce, epoch, index) = parse_seg_key(&key)?;
+        // The range prefix already pins both, so a mismatch here would mean a key that
+        // starts with the prefix without being a key of this group — reject it rather
+        // than fold a stranger's chunks into this object's map.
+        if nonce != group.nonce() || epoch != group.epoch() {
+            return Err(ChunkMapError::SegmentKeyMalformed {
+                key: String::from_utf8_lossy(&key).into_owned(),
+            }
+            .into());
+        }
+        let record: SegmentRecord = decode(&value)?;
+        found.insert(
+            index,
+            ReadSegment {
+                key,
+                prior: value,
+                record,
+            },
+        );
+    }
+
+    for segment in map.segments() {
+        let Some(read) = found.get(&segment.index) else {
+            // A segment the live root names is absent — the resolve-retry rule decides
+            // whether that is a concurrent retirement or an invariant violation.
+            return retired_or_fail(store, root_key, group, segment.index).await;
+        };
+        if read.record.byte_offset != segment.byte_offset
+            || read.record.byte_len != segment.byte_len
+        {
+            return Err(ChunkMapError::SegmentBoundsMismatch {
+                index: segment.index,
+                root: (segment.byte_offset, segment.byte_len),
+                segment: (read.record.byte_offset, read.record.byte_len),
+            }
+            .into());
+        }
+    }
+    // Every index the root names is present (the loop above), and the keys are unique, so
+    // the only way the range can hold MORE than the root names is an index past the table:
+    // a record from an attempt that wrote further than the published root. Fail closed
+    // rather than fold a stranger's chunks into this object's map.
+    if let Some(&unknown) = found.keys().find(|index| **index >= map.segment_count()) {
+        return Err(ChunkMapError::SegmentUnknown {
+            nonce: group.nonce().to_string(),
+            epoch: group.epoch(),
+            index: unknown,
+        }
+        .into());
+    }
+    Ok(Some(found.into_values().collect()))
+}
