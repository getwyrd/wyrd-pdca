+        group.clone(),
+        vec![
+            SegmentRef {
+                index: 0,
+                byte_offset: 0,
+                byte_len: chunk_len,
+            },
+            SegmentRef {
+                index: 1,
+                byte_offset: chunk_len,
+                byte_len: chunk_len,
