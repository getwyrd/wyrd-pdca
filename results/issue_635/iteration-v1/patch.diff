+/// Whether any `seg:` record names `nonce` — the predicate the `seggrp:` marker's
+/// two-arm lifetime rule needs (`0016:513-527`): a group that was never **adopted** has
+/// its marker removed by the session's terminal delete, an adopted one keeps it until the
+/// last segment naming it is gone. One bounded range read, exactly as the terminal delete
+/// already gates on the `sidx:` range being empty. The arms themselves are the session
+/// slice's (#636); this slice ships the predicate they gate on.
+pub async fn segment_group_adopted(store: &impl MetadataStore, nonce: &str) -> Result<bool> {
+    Ok(!store.scan(&seg_group_prefix(nonce)).await?.is_empty())
