diff --git a/crates/custodian/src/resolve.rs b/crates/custodian/src/resolve.rs
new file mode 100644
index 0000000..14d0726
--- /dev/null
+++ b/crates/custodian/src/resolve.rs
@@ -0,0 +1,53 @@
+//! The maintenance plane's **one** way to read a committed object's chunk list
+//! (proposal 0016 decision 7(e), `0016:2393-2399`).
+//!
+//! Every custodian loop that used to iterate `record.chunk_map` directly goes through
+//! here, so a **segmented** map (decision 7(a)) is resolved by *all* of them or by none:
+//! the recorded #508-attempt-4 failure was a resolver wired into the read path alone
+//! while GC and restore still walked the field, after which a restore pass stranded a
+//! live segmented object and a later GC pass deleted its fragments.
+//!
+//! The other half of the rule is what to do when a resolve comes back
+//! [`MapResolution::Retired`] — the generation was concurrently retired (its root now
+//! names a different group, or is gone), so the resolution is stale. A **maintenance**
+//! pass drops it (`0016:2463-2469`): the generation it was reading is being reclaimed by
+//! the retirement drain anyway, and the pass re-derives on its next run against the
+//! current root. Dropping it is safe for the reference set specifically because GC never
+//! reclaims on absence: it reclaims only on **evidence** (an `orphan:` record past its
+//! grace, or an expired `pending:` lease), and a live generation's fragments carry
+//! neither. The drop is never silent — it is emitted on the durability seam, so an
+//! operator sees a pass that skipped an object rather than inferring it.
+
+use std::borrow::Cow;
+
+use wyrd_core::metadata::{self, ChunkRef, InodeRecord, MapResolution};
+use wyrd_traits::{MetadataStore, Result};
+
+/// Resolve one committed inode's chunk list, or `None` if its generation was retired
+/// under the pass (see the module docs).
+pub(crate) async fn chunks_of<'a>(
+    meta: &dyn MetadataStore,
+    inode_key: &[u8],
+    record: &'a InodeRecord,
+) -> Result<Option<Cow<'a, [ChunkRef]>>> {
+    match metadata::resolve_chunk_map(meta, inode_key, record).await? {
+        MapResolution::Resolved(chunks) => Ok(Some(chunks)),
+        MapResolution::Retired => {
+            emit_retired(inode_key);
+            Ok(None)
+        }
+    }
+}
+
+/// Emit a dropped stale resolution on the durability-plane seam (ADR-0011 / ADR-0012):
+/// the observable record that a maintenance pass *considered* an object and found its
+/// generation already retired.
+fn emit_retired(inode_key: &[u8]) {
+    tracing::info!(monotonic_counter.custodian_retired_generation_skipped = 1_u64);
+    tracing::info!(
+        target: "wyrd.custodian.audit",
+        action = "retired-generation",
+        inode = %String::from_utf8_lossy(inode_key),
+        "a segmented generation was retired while this pass resolved it; the stale resolution is dropped and re-derived next pass (proposal 0016 decision 7(h))",
+    );
+}
