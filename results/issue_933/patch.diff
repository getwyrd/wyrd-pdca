+            index.get(),
+            slot.lease_expiry_millis()
+        );
+    }
+    for (chunk, entry) in owned(store, upload).await {
+        assert!(
+            entry.lease_expiry_millis() > now,
+            "chunk {chunk}'s owned lease lapsed at {} (now {now})",
+            entry.lease_expiry_millis()
+        );
+    }
