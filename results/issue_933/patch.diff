+        .enumerate()
+        .filter(|(_, e)| matches!(e, Event::Commit { kind, .. } if *kind == of))
+        .map(|(at, _)| at)
+        .nth(n)
+        .unwrap_or_else(|| panic!("a {of:?} commit #{n}"))
