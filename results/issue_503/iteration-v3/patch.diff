+    let prior = InodeRecord {
+        size: 10,
+        chunk_map: vec![],
+        state: InodeState::Committed,
+        version: 5,
+        etag: Some("aaaaaaaaaaaaaaaa".to_string()),
+        content_type: Some("text/plain; charset=utf-8".to_string()),
+        modified: Some(1_700_000_000_000),
