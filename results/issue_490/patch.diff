+        let Some(current) = store.get(&key).await? else {
+            return Ok(None);
+        };
+        let entry: PendingEntry = decode(&current)?;
+        if entry.lease_expiry_millis <= now_millis {
+            return Ok(None);
+        }
+        guards.push((key, current));
+    }
+    Ok(Some(guards))
