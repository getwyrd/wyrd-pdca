+// ===========================================================================
+// Leg 2 — byte-lexicographic order equals numeric order, across every digit-width
+// boundary the fixed width can reach.
+// ===========================================================================
+
+const WIDTH_BOUNDARY_SERIES: [u32; 12] = [
+    1, 9, 10, 99, 100, 999, 1_000, 9_999, 10_000, 99_999, 100_000, 999_999,
+];
+
+#[test]
+fn slot_index_byte_order_matches_numeric_order() {
+    let uid = upload("0123456789abcdef");
+    let keys: Vec<Vec<u8>> = WIDTH_BOUNDARY_SERIES
+        .iter()
+        .map(|&n| slot_key(&uid, SlotIndex::new(n).unwrap()))
+        .collect();
+    for pair in keys.windows(2) {
+        assert!(
+            pair[0] < pair[1],
+            "slot: byte order diverges from numeric order across a digit-width boundary"
+        );
+    }
+}
+
+#[test]
+fn part_number_byte_order_matches_numeric_order() {
+    let uid = upload("0123456789abcdef");
+    let keys: Vec<Vec<u8>> = WIDTH_BOUNDARY_SERIES
+        .iter()
+        .map(|&n| part_key(&uid, part(n)))
+        .collect();
+    for pair in keys.windows(2) {
+        assert!(
+            pair[0] < pair[1],
+            "part: byte order diverges from numeric order across a digit-width boundary"
+        );
+    }
+}
