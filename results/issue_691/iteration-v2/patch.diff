+// ===========================================================================
+// Leg 1 — round-trip + canonical rejection, per keyed class
+// ===========================================================================
+
+#[test]
+fn mpu_key_round_trips() {
+    for uid in [
+        upload("0123456789abcdef"),
+        upload("fedcba9876543210"),
+        upload("0"),
+    ] {
+        let key = mpu_key(&uid);
+        assert_eq!(key, format!("mpu:{uid}").into_bytes());
+        assert_eq!(parse_mpu_key(&key).unwrap(), uid);
+    }
+}
+
+#[test]
+fn mpu_key_rejects_noncanonical_and_malformed() {
+    let id = hex_token("0123456789abcdef");
+    let cases: Vec<(&str, Vec<u8>)> = vec![
+        ("empty upload id", b"mpu:".to_vec()),
+        // A single-field key (`splitn(1, ':')`) folds "trailing component" and "id
+        // containing ':'" into the same shape: the whole remainder becomes one field,
+        // which then fails the token grammar.
+        (
+            "upload id containing ':' / trailing component",
+            format!("mpu:{id}:extra").into_bytes(),
+        ),
+        ("malformed key (no separator)", b"mpu".to_vec()),
+        ("malformed key (wrong prefix)", b"mp:x".to_vec()),
+        ("non-UTF-8 bytes", {
+            let mut v = b"mpu:".to_vec();
+            v.push(0xFF);
+            v
+        }),
+    ];
+    for (label, key) in cases {
+        assert_rejected(label, &key, parse_mpu_key(&key));
+    }
+}
+
+/// Leg 1's other half: a rejection is a **typed** error that names the violation, never a
+/// bare "something was wrong" — the signal an operator diagnoses a refused key from.
+/// Each case is asserted twice: the **variant** (the typed part) and the exact `Display`
+/// text, which carries the payload the variant holds (the namespace, the token, the number
+/// refused). `is_err()` alone would hold just as well if every parser returned one anonymous
+/// error carrying nothing.
+#[test]
+fn every_rejection_is_a_typed_error_that_names_the_violation() {
+    let id = hex_token("0123456789abcdef");
+
+    let key = format!("slot:{id}:0000007");
+    let err = parse_slot_key(key.as_bytes()).expect_err("an over-wide slot index");
+    assert!(matches!(
+        err,
+        RecordError::MalformedKey {
+            namespace: "slot:",
+            ..
+        }
+    ));
+    assert_eq!(err.to_string(), format!("malformed slot: key {key:?}"));
+
+    let err = parse_mpu_key(b"mpu:nothex").expect_err("a non-token upload id");
+    assert!(matches!(err, RecordError::TokenNotHex { .. }));
+    assert_eq!(
+        err.to_string(),
+        format!("\"nothex\" is not {TOKEN_HEX_LEN} lowercase-hex characters (a 128-bit token)")
+    );
+
+    let err = PartNumber::new(0).expect_err("zero is not a part");
+    assert!(matches!(err, RecordError::PartNumberOutOfRange { .. }));
+    assert_eq!(
+        err.to_string(),
+        format!("part number 0 is outside the format bound [1, {MAX_PART_NUMBER}]")
+    );
+
+    let err = SlotIndex::new(MAX_SLOT_INDEX + 1).expect_err("past the slot key space");
+    assert!(matches!(err, RecordError::SlotIndexOutOfRange { .. }));
+    assert_eq!(
+        err.to_string(),
+        format!(
+            "slot index {} is outside the format bound [0, {MAX_SLOT_INDEX}]",
+            u64::from(MAX_SLOT_INDEX) + 1
+        )
+    );
+
+    let err = parse_retire_mode(format!("retire:sideways:s:{id}:1").as_bytes())
+        .expect_err("a third retire mode");
+    assert!(matches!(err, RecordError::UnknownRetireMode { .. }));
+    assert_eq!(
+        err.to_string(),
+        "retire: key mode \"sideways\" is neither `bytes` nor `records`"
+    );
+
+    // Boxed as `std::error::Error`, the way a caller propagates it — the text survives.
+    let err: Box<dyn std::error::Error> =
+        Box::new(Digest::from_hex("nope").expect_err("a non-digest"));
+    assert_eq!(
+        err.to_string(),
+        "\"nope\" is not 64 lowercase-hex characters (a SHA-256 digest)"
+    );
+}
