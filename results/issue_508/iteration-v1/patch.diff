+/// ListMultipartUploads (`GET /b?uploads`): answer a `<ListMultipartUploadsResult>` of the
+/// bucket's in-progress uploads.
+async fn list_multipart_uploads<G>(
+    state: &AppState<G>,
+    request_id: RequestId,
+    bucket: &str,
+) -> Response
+where
+    G: MultipartGateway,
+{
+    match state.gateway.list_multipart_uploads(bucket).await {
+        Ok(uploads) => list_response(render_list_uploads_result(bucket, &uploads)),
+        Err(err) => gateway_error_response(request_id, &err),
