+/// Render `<InitiateMultipartUploadResult>` (CreateMultipartUpload), string-built with
+/// [`xml_escape`] like the listing renderers.
+fn render_initiate_result(bucket: &str, key: &str, upload_id: &str) -> String {
+    format!(
+        "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\
+         <InitiateMultipartUploadResult xmlns=\"{ns}\">\
+         <Bucket>{bucket}</Bucket><Key>{key}</Key><UploadId>{upload}</UploadId>\
+         </InitiateMultipartUploadResult>",
+        ns = S3_XMLNS,
+        bucket = xml_escape(bucket),
+        key = xml_escape(key),
+        upload = xml_escape(upload_id),
+    )
+}
+
+/// Render `<CompleteMultipartUploadResult>`. The composed ETag is S3-quoted, like every other
+/// ETag on the wire ([`quote_etag`]).
+fn render_complete_result(bucket: &str, key: &str, etag: &str) -> String {
+    format!(
+        "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\
+         <CompleteMultipartUploadResult xmlns=\"{ns}\">\
+         <Location>/{bucket}/{key}</Location><Bucket>{bucket}</Bucket><Key>{key}</Key>\
+         <ETag>{etag}</ETag></CompleteMultipartUploadResult>",
+        ns = S3_XMLNS,
+        bucket = xml_escape(bucket),
+        key = xml_escape(key),
+        etag = xml_escape(&quote_etag(etag)),
+    )
+}
+
+/// Render `<ListPartsResult>` — one `<Part>` per staged part (ascending), each with its
+/// number, S3-quoted ETag (MD5), and byte size.
+fn render_list_parts_result(
+    bucket: &str,
+    key: &str,
+    upload_id: &str,
+    parts: &[wyrd_gateway_core::StagedPart],
+) -> String {
+    let mut out = String::with_capacity(256 + parts.len() * 96);
+    out.push_str("<?xml version=\"1.0\" encoding=\"UTF-8\"?>");
+    out.push_str(&format!(
+        "<ListPartsResult xmlns=\"{ns}\"><Bucket>{bucket}</Bucket><Key>{key}</Key>\
+         <UploadId>{upload}</UploadId><StorageClass>STANDARD</StorageClass>\
+         <IsTruncated>false</IsTruncated>",
+        ns = S3_XMLNS,
+        bucket = xml_escape(bucket),
+        key = xml_escape(key),
+        upload = xml_escape(upload_id),
+    ));
+    for part in parts {
+        out.push_str(&format!(
+            "<Part><PartNumber>{n}</PartNumber><ETag>{etag}</ETag><Size>{size}</Size></Part>",
+            n = part.part_number,
+            etag = xml_escape(&quote_etag(&part.etag)),
+            size = part.size,
+        ));
+    }
+    out.push_str("</ListPartsResult>");
+    out
+}
+
+/// Render `<ListMultipartUploadsResult>` — one `<Upload>` per in-progress upload (key +
+/// upload id).
+fn render_list_uploads_result(
+    bucket: &str,
+    uploads: &[wyrd_gateway_core::MultipartUpload],
+) -> String {
+    let mut out = String::with_capacity(256 + uploads.len() * 96);
+    out.push_str("<?xml version=\"1.0\" encoding=\"UTF-8\"?>");
+    out.push_str(&format!(
+        "<ListMultipartUploadsResult xmlns=\"{ns}\"><Bucket>{bucket}</Bucket>\
+         <IsTruncated>false</IsTruncated>",
+        ns = S3_XMLNS,
+        bucket = xml_escape(bucket),
+    ));
+    for upload in uploads {
+        out.push_str(&format!(
+            "<Upload><Key>{key}</Key><UploadId>{upload}</UploadId></Upload>",
+            key = xml_escape(&upload.key),
+            upload = xml_escape(&upload.upload_id),
+        ));
+    }
+    out.push_str("</ListMultipartUploadsResult>");
+    out
+}
