+//! S3 **multipart upload** end-to-end over the loopback gateway (issue #508), driven by a
+//! stock `aws-sdk-s3` client — the same in-process redb + fs-tempdir + `MemCoordination`
+//! stack `s3_object_metadata.rs` drives, plus the `FsChunkStore` **tempdir the test owns** so
+//! it can count the fragment files that land on disk (the only staged-fragment observable the
+//! harness has — the gateway's store is moved into `Gateway::new` and its metadata field is
+//! private; see the brief's success criterion).
+//!
+//! The binding criterion, proven red→green:
+//!
+//! * `create_multipart_upload` → `upload_part` × N (**out of order**, over the streaming wire
+//!   path, ≥5 MiB non-final parts) → `complete_multipart_upload` yields an object a subsequent
+//!   `GET` returns **byte-identical** to the concatenated parts, and the Complete ETag is in S3
+//!   multipart form `"<md5-of-part-md5s>-N"` (checked against an INDEPENDENT RustCrypto `md-5`
+//!   oracle — the server's own MD5 is never trusted to check the server);
+//! * `list_parts` reflects the staged parts;
+//! * completing with a **wrong part list** fails (`InvalidPart`) **without publishing** (the GET
+//!   afterwards is `NoSuchKey`);
+//! * `abort_multipart_upload` ends the session — subsequent UploadPart/Complete/ListParts are
+//!   `NoSuchUpload` — and abort + a custodian **GC pass** leave **no unreferenced staged
+//!   fragments**: the `FsChunkStore` tempdir's `.frag` count, non-zero after staging, returns
+//!   to its pre-upload **baseline**;
+//! * `list_multipart_uploads` reflects the in-progress uploads.
+//!
+//! RED on the wave base: every object-scoped multipart form is refused `501 NotImplemented` by
+//! the subresource denylist, and `GET /b?uploads` reds through 507's bucket routing (its brief
+//! preserves the denylist for bucket paths). So each leg fails by ASSERTION on the wire — the
+//! test imports **no new production symbol** (only `wyrd_server::Gateway`, already public) and
+//! drives everything through the SDK/HTTP.
+
+use std::net::SocketAddr;
+use std::path::Path;
+use std::sync::Arc;
+
+use aws_sdk_s3::config::{Credentials as SdkCredentials, Region};
+use aws_sdk_s3::error::ProvideErrorMetadata;
+use aws_sdk_s3::primitives::ByteStream;
+use aws_sdk_s3::types::{CompletedMultipartUpload, CompletedPart};
+use aws_sdk_s3::Client;
+use md5::{Digest, Md5};
+use tokio::net::TcpListener;
+use wyrd_chunkstore_fs::FsChunkStore;
+use wyrd_coordination_mem::MemCoordination;
+use wyrd_gateway_s3::sigv4::Credentials;
+use wyrd_gateway_s3::{S3Config, S3Gateway};
+use wyrd_metadata_redb::RedbMetadataStore;
+use wyrd_server::Gateway;
+
+const ACCESS_KEY: &str = "AKIAIOSFODNN7EXAMPLE";
+const SECRET_KEY: &str = "wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY";
+const REGION: &str = "us-east-1";
+const BUCKET: &str = "wyrd-bucket";
+/// S3's 5 MiB minimum part size — every non-final part meets it (the floor is enforced at
+/// Complete, so a smaller non-final part would be `EntityTooSmall`).
+const FIVE_MIB: usize = 5 * 1024 * 1024;
+
+type Backend = Gateway<RedbMetadataStore, FsChunkStore, MemCoordination>;
+
+/// Start the S3 gateway over the in-process stack on an ephemeral loopback port. Returns the
+/// address, a handle to the composed gateway (so the test can drive a custodian GC pass over
+/// the SAME stores), and the `FsChunkStore` tempdir (so the test can count fragment files).
+///
+/// The 1 MiB chunk size makes a 5 MiB part span several chunks over the streaming write path
+/// (multi-chunk staging) while keeping the on-disk fragment count small enough to count.
+async fn start_gateway() -> (SocketAddr, Arc<Backend>, tempfile::TempDir) {
+    let dir = tempfile::tempdir().expect("temp dir");
+    let gateway = Arc::new(
+        Gateway::new(
+            RedbMetadataStore::in_memory().expect("redb"),
+            FsChunkStore::open(dir.path()).expect("fs store"),
+            MemCoordination::new(),
+        )
+        .with_chunk_size(1 << 20),
+    );
+    let config = S3Config::new(vec![Credentials {
+        access_key_id: ACCESS_KEY.to_string(),
+        secret_access_key: SECRET_KEY.to_string(),
+    }]);
+    let listener = TcpListener::bind("127.0.0.1:0").await.expect("bind");
+    let addr = listener.local_addr().expect("addr");
+    let server = S3Gateway::new(Arc::clone(&gateway), config);
+    tokio::spawn(async move {
+        server.serve(listener).await.expect("serve");
+    });
+    (addr, gateway, dir)
+}
