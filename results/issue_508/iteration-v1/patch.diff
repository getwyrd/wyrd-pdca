+/// A stock `aws-sdk-s3` client pointed at the loopback gateway — mirrors
+/// `s3_gateway_cluster.rs::sdk_client` (custom endpoint, path-style, static creds, plaintext).
+fn sdk_client(addr: SocketAddr) -> Client {
+    let http_client = aws_smithy_http_client::Builder::new().build_http();
+    let config = aws_sdk_s3::Config::builder()
+        .behavior_version_latest()
+        .region(Region::new(REGION))
+        .endpoint_url(format!("http://{addr}"))
+        .credentials_provider(SdkCredentials::new(
+            ACCESS_KEY, SECRET_KEY, None, None, "static",
+        ))
+        .http_client(http_client)
+        .force_path_style(true)
+        .retry_config(aws_sdk_s3::config::retry::RetryConfig::disabled())
+        .stalled_stream_protection(aws_sdk_s3::config::StalledStreamProtectionConfig::disabled())
+        .build();
+    Client::from_conf(config)
+}
+
+/// Count `.frag` fragment files under a chunk-store root (`<root>/<32-hex chunk>/<05-index>.frag`,
+/// `chunkstore-fs`) — mirrors `s3_gateway_cluster.rs::count_fragments`. Non-zero ⇒ fragments
+/// landed on disk; zero ⇒ none remain.
+fn count_fragments(root: &Path) -> usize {
+    let mut n = 0;
+    let Ok(chunk_dirs) = std::fs::read_dir(root) else {
+        return 0;
+    };
+    for chunk_dir in chunk_dirs.flatten() {
+        let path = chunk_dir.path();
+        if !path.is_dir() {
+            continue;
+        }
+        if let Ok(frags) = std::fs::read_dir(&path) {
+            for frag in frags.flatten() {
+                if frag.path().extension().and_then(|e| e.to_str()) == Some("frag") {
+                    n += 1;
+                }
+            }
+        }
+    }
+    n
+}
+
+/// A deterministic body of `len` bytes seeded from `seed` — a distinct-per-part pattern so a
+/// mis-ordered assembly is caught, not masked by identical bytes.
+fn body(len: usize, seed: u8) -> Vec<u8> {
+    (0..len)
+        .map(|i| ((i as u64 + u64::from(seed) * 97) % 251) as u8)
+        .collect()
+}
+
+/// The raw 16-byte MD5 of `bytes` — the INDEPENDENT (RustCrypto) oracle, never the server's own.
+fn md5_raw(bytes: &[u8]) -> [u8; 16] {
+    Md5::digest(bytes).into()
+}
+
+/// Lowercase-hex MD5 of `bytes` — the S3 part-ETag form.
+fn md5_hex(bytes: &[u8]) -> String {
+    hex(&md5_raw(bytes))
+}
+
+/// The S3 multipart composite ETag oracle: `md5(concat(raw part-md5s))-<count>`.
+fn expected_composite(parts: &[&[u8]]) -> String {
+    let mut concat = Vec::with_capacity(parts.len() * 16);
+    for p in parts {
+        concat.extend_from_slice(&md5_raw(p));
+    }
+    format!("{}-{}", md5_hex(&concat), parts.len())
+}
+
+fn hex(bytes: &[u8]) -> String {
+    let mut s = String::with_capacity(bytes.len() * 2);
+    for b in bytes {
+        s.push_str(&format!("{b:02x}"));
+    }
+    s
+}
+
+/// Strip the surrounding double quotes S3 wraps an ETag in.
+fn unquote(etag: &str) -> String {
+    etag.trim().trim_matches('"').to_string()
+}
