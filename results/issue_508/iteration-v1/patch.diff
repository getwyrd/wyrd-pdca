+/// part numbers, and neutral digests. Implemented by `wyrd-server`'s `Gateway` at the
+/// composition root; the S3 crate alone projects these onto SigV4/XML/`?uploadId` wire forms.
+///
+/// Each part streams (UploadPart RS-encodes the part to chunks as its bytes arrive, never
+/// buffering it), so the "stream, don't buffer" invariant (0015:789) holds at the seam.
+pub trait MultipartGateway: Send + Sync + 'static {
+    /// Begin a multipart upload for `key`, returning the opaque, server-minted upload id.
+    fn create_multipart_upload(
+        &self,
+        key: &str,
+        content_type: Option<String>,
+    ) -> impl Future<Output = Result<String>> + Send;
+
+    /// Stage part `part_number` of `upload_id`, streaming its bytes from `source` (never
+    /// buffered whole). Returns the staged part's digest + size. A re-upload of the same
+    /// part number replaces the prior staged part. Errors [`GatewayError::NoSuchUpload`] if
+    /// the session is gone.
+    fn upload_part<S>(
+        &self,
+        key: &str,
+        upload_id: &str,
+        part_number: u32,
+        source: S,
+    ) -> impl Future<Output = Result<StagedPart>> + Send
