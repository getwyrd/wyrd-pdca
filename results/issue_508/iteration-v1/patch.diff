+/// CreateMultipartUpload (`POST /b/k?uploads`): begin a session and answer an
+/// `<InitiateMultipartUploadResult>` carrying the server-minted upload id.
+async fn create_multipart<G>(
+    state: &AppState<G>,
+    request_id: RequestId,
+    object_key: &str,
+    bucket: &str,
+    key: &str,
+    content_type: Option<String>,
+) -> Response
+where
+    G: MultipartGateway,
+{
+    match state
+        .gateway
+        .create_multipart_upload(object_key, content_type)
+        .await
+    {
+        Ok(upload_id) => list_response(render_initiate_result(bucket, key, &upload_id)),
+        Err(err) => gateway_error_response(request_id, &err),
+    }
+}
+
+/// UploadPart (`PUT /b/k?partNumber=N&uploadId=U`): stage the part over the SAME streaming
+/// write path an object PUT uses (the `aws-chunked` streaming body is de-framed and verified
+/// exactly as the PUT arm does, `:1613`), so a part never resides whole in the gateway heap.
+/// Answers `200` with the part's `ETag` (its MD5, S3-quoted) header.
+async fn upload_part<G>(
+    state: &AppState<G>,
+    request_id: RequestId,
+    object_key: &str,
+    upload_id: &str,
+    part_number: u32,
+    payload: sigv4::PayloadHash,
+    body: Body,
+) -> Response
+where
+    G: MultipartGateway,
+{
+    let raw = Box::pin(
+        body.into_data_stream()
+            .map(|item| item.map_err(|e| Box::new(e) as BoxError)),
+    );
+    let result = match payload {
+        // An `aws-chunked` streaming-signature upload — de-frame + verify each chunk as it
+        // streams, then stage the raw part bytes (the same handling as the PUT arm).
+        sigv4::PayloadHash::Streaming(ctx) => {
+            let decoded = streaming::decode(raw, ctx);
+            state
+                .gateway
+                .upload_part(object_key, upload_id, part_number, decoded)
+                .await
+        }
+        // A single-shot signed or a deliberately-unsigned body: stage it straight in. Per-part
+        // Content-MD5 verification beyond the streaming path is out of scope (brief §Out-of-scope).
+        sigv4::PayloadHash::Signed(_) | sigv4::PayloadHash::Unsigned => {
+            state
+                .gateway
+                .upload_part(object_key, upload_id, part_number, raw)
+                .await
+        }
+    };
+    match result {
+        // `put_object_response` sets the `ETag` header (S3-quoted) + a body-less `200` — exactly
+        // what UploadPart answers, with the part MD5 as the ETag.
+        Ok(part) => put_object_response(&part.etag),
+        Err(err) => gateway_error_response(request_id, &err),
+    }
+}
+
+/// CompleteMultipartUpload (`POST /b/k?uploadId=U`): parse the `<CompleteMultipartUpload>` part
+/// list, assemble the object, and answer a `<CompleteMultipartUploadResult>` with the composed
+/// ETag. A malformed body is `400 MalformedXML` (nothing assembled); a wrong part list is the
+/// gateway's `InvalidPart`/`InvalidPartOrder`/`EntityTooSmall` (nothing published).
+#[allow(clippy::too_many_arguments)]
+async fn complete_multipart<G>(
+    state: &AppState<G>,
+    request_id: RequestId,
+    object_key: &str,
+    bucket: &str,
+    key: &str,
+    upload_id: &str,
+    payload: sigv4::PayloadHash,
+    body: Body,
+) -> Response
+where
+    G: MultipartGateway,
+{
+    // Buffer the small signed body under the cap (refused AS READ), then validate its digest
+    // exactly as DeleteObjects does (`:1851`) before it drives any commit.
+    let bytes = match buffer_capped(body, MAX_COMPLETE_BODY_BYTES).await {
+        Ok(bytes) => bytes,
+        Err(_) => return malformed_xml(request_id),
+    };
+    if let sigv4::PayloadHash::Signed(expected) = &payload {
+        let actual = crypto::hex(&crypto::sha256(&bytes));
+        if !crypto::constant_time_eq(actual.as_bytes(), expected.as_bytes()) {
+            return error_response(
+                request_id,
+                StatusCode::BAD_REQUEST,
+                "XAmzContentSHA256Mismatch",
+                "the delivered body does not match the signed x-amz-content-sha256",
+            );
+        }
+    }
+    let Ok(text) = std::str::from_utf8(&bytes) else {
+        return malformed_xml(request_id);
+    };
+    let parts = match parse_complete_request(text) {
+        Ok(parts) => parts,
+        Err(()) => return malformed_xml(request_id),
+    };
+    match state
+        .gateway
+        .complete_multipart_upload(object_key, upload_id, &parts)
+        .await
+    {
+        Ok(done) => list_response(render_complete_result(bucket, key, &done.etag)),
+        Err(err) => gateway_error_response(request_id, &err),
+    }
+}
+
+/// AbortMultipartUpload (`DELETE /b/k?uploadId=U`): end the session (its staged chunks are
+/// routed into the GC path by the seam) and answer `204 No Content`.
+async fn abort_multipart<G>(
+    state: &AppState<G>,
+    request_id: RequestId,
+    object_key: &str,
+    upload_id: &str,
+) -> Response
+where
+    G: MultipartGateway,
+{
+    match state
+        .gateway
+        .abort_multipart_upload(object_key, upload_id)
+        .await
+    {
+        Ok(()) => empty_response(StatusCode::NO_CONTENT),
+        Err(err) => gateway_error_response(request_id, &err),
+    }
+}
