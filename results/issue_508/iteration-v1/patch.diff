+/// The full happy path: create → out-of-order upload → list_parts → complete → GET, with the
+/// composite ETag checked against the independent oracle and the round trip byte-identical.
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn multipart_round_trip_assembles_byte_identical_object_with_composite_etag() {
+    let (addr, _gateway, _dir) = start_gateway().await;
+    let client = sdk_client(addr);
+    let key = "big/multipart-object";
+
+    // Two parts: a ≥5 MiB non-final part (spans several 1 MiB chunks) and a small last part.
+    let part1 = body(FIVE_MIB, 1);
+    let part2 = body(4096, 2);
+
+    let created = client
+        .create_multipart_upload()
+        .bucket(BUCKET)
+        .key(key)
+        .content_type("application/octet-stream")
+        .send()
+        .await
+        .expect("CreateMultipartUpload must be accepted (pre-fix: 501 NotImplemented)");
+    let upload_id = created
+        .upload_id()
+        .expect("a create response carries an upload id");
+
+    // Upload OUT OF ORDER — part 2 before part 1 — over the streaming wire path.
+    let up2 = client
+        .upload_part()
+        .bucket(BUCKET)
+        .key(key)
+        .upload_id(upload_id)
+        .part_number(2)
+        .body(ByteStream::from(part2.clone()))
+        .send()
+        .await
+        .expect("UploadPart(2) must be accepted");
+    let etag2 = up2
+        .e_tag()
+        .expect("UploadPart(2) returns an ETag")
+        .to_string();
+    let up1 = client
+        .upload_part()
+        .bucket(BUCKET)
+        .key(key)
+        .upload_id(upload_id)
+        .part_number(1)
+        .body(ByteStream::from(part1.clone()))
+        .send()
+        .await
+        .expect("UploadPart(1) must be accepted");
+    let etag1 = up1
+        .e_tag()
+        .expect("UploadPart(1) returns an ETag")
+        .to_string();
+
+    // A part ETag is the (quoted) MD5 of the part bytes — the independent oracle.
+    assert_eq!(
+        unquote(&etag1),
+        md5_hex(&part1),
+        "part 1 ETag must be its MD5"
+    );
+    assert_eq!(
+        unquote(&etag2),
+        md5_hex(&part2),
+        "part 2 ETag must be its MD5"
+    );
+
+    // ListParts reflects the staged parts, ascending, with their sizes and ETags.
+    let listed = client
+        .list_parts()
+        .bucket(BUCKET)
+        .key(key)
+        .upload_id(upload_id)
+        .send()
+        .await
+        .expect("ListParts must be accepted");
+    let parts = listed.parts();
+    assert_eq!(parts.len(), 2, "ListParts must reflect both staged parts");
+    assert_eq!(parts[0].part_number(), Some(1));
+    assert_eq!(parts[0].size(), Some(part1.len() as i64));
+    assert_eq!(unquote(parts[0].e_tag().unwrap_or("")), md5_hex(&part1));
+    assert_eq!(parts[1].part_number(), Some(2));
+    assert_eq!(parts[1].size(), Some(part2.len() as i64));
+
+    // Complete with the parts in ascending order.
+    let multipart = CompletedMultipartUpload::builder()
+        .parts(
+            CompletedPart::builder()
+                .part_number(1)
+                .e_tag(&etag1)
+                .build(),
+        )
+        .parts(
+            CompletedPart::builder()
+                .part_number(2)
+                .e_tag(&etag2)
+                .build(),
+        )
+        .build();
+    let done = client
+        .complete_multipart_upload()
+        .bucket(BUCKET)
+        .key(key)
+        .upload_id(upload_id)
+        .multipart_upload(multipart)
+        .send()
+        .await
+        .expect("CompleteMultipartUpload must be accepted");
+    let composite = done
+        .e_tag()
+        .expect("Complete returns the composed ETag")
+        .to_string();
+
+    // The composed ETag is `"<md5-of-part-md5s>-2"` — checked against the independent oracle.
+    assert_eq!(
+        unquote(&composite),
+        expected_composite(&[&part1, &part2]),
+        "the Complete ETag must be the S3 multipart composite md5(concat(part-md5s))-N"
+    );
+    assert!(
+        composite.trim_matches('"').ends_with("-2"),
+        "the composite ETag must carry the -N part count, got {composite}"
+    );
+
+    // GET returns the assembled object byte-identical to part1 ++ part2, with the composite ETag.
+    let got = client
+        .get_object()
+        .bucket(BUCKET)
+        .key(key)
+        .send()
+        .await
+        .expect("GET of the completed object must succeed");
+    let get_etag = got.e_tag().expect("GET carries an ETag").to_string();
+    let bytes = got
+        .body
+        .collect()
+        .await
+        .expect("collect the GET body")
+        .into_bytes();
+    let mut expected = part1.clone();
+    expected.extend_from_slice(&part2);
+    assert_eq!(
+        bytes.as_ref(),
+        expected.as_slice(),
+        "the assembled object must be byte-identical to the concatenated parts"
+    );
+    assert_eq!(
+        get_etag, composite,
+        "GET must return the composite ETag the Complete committed"
+    );
+}
