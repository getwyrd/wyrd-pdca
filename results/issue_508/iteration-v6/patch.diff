+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn lengthless_streaming_put_uses_the_size_independent_selection() {
+    let (addr, meta, _dir) = start(512).await;
+    let key = "lengthless.bin";
+    let payload = body(41, 64 * 1024);
