+    /// Compensate a part attempt that staged bytes and then could not commit: install
+    /// `retire:bytes:{chunks}` naming exactly those bytes, release the slot with its keyed
+    /// CAS, and delete this attempt's owned `sidx:` entries — all in one batch under
+    /// `require(mpu == Open@E)`.
+    ///
+    /// Best-effort by construction: if the session has already left `Open@E` the batch is a
+    /// no-op, and the session-wide teardown obligation the fence installed covers the same
+    /// bytes. Either way the bytes are evidenced.
+    async fn compensate(&self, attempt: &Abandonment<'_>) {
