+        let first = block_on(drain_step(&store, 7)).expect("step");
+        assert!(first.records_deleted > 0, "a step makes durable progress");
+        assert!(
+            first.records_deleted <= DRAIN_BATCHES_PER_PASS * B_OPS,
+            "…and no more than one pass's operation budget ({} deletions observed)",
