+        .expect("decode");
+        assert_eq!(
+            held.attempt_id, "attempt-a",
+            "the adopted slot is THIS attempt's — the re-read distinguishes it from another \
+             reserver's by `attempt_id`"
+        );
+    }
+
+    /// A **published** session gives its staged-reference admission slot back as soon as its
+    /// obligations have drained, while keeping its `mpu:` tombstone — and the slot is released
+    /// **exactly once**.
+    ///
+    /// Without this, `mpuctl.staged` never fell for a successful upload (a tombstone's terminal
+    /// delete is #625's `W_tombstone` exit, which this wave does not ship), so a store accepted
+    /// only `max_sessions` ≈ 70 *lifetime* uploads and then refused every `CreateMultipartUpload`
+    /// for ever — a permanent, service-wide failure of the verb this slice exists to add.
+    #[test]
+    fn a_published_session_returns_its_admission_slot_and_keeps_its_tombstone() {
+        let store = RedbMetadataStore::in_memory().expect("redb");
+        let upload_id = "u-done";
+        let session = SessionRecord {
+            bucket: "b".into(),
+            key: "k".into(),
+            content_type: None,
+            created_at_millis: 0,
+            clock_source: "test".into(),
+            state: SessionState::Completed,
+            epoch: 2,
+            attempts: 1,
+            group_nonce: "n".into(),
+            fenced_at_millis: None,
+            segments_written: None,
+            publish_target: None,
+            published: Some(Published {
+                inode: 1,
+                version: 1,
+                etag: format!("{}-1", "00".repeat(32)),
+                completed_at_millis: 0,
+            }),
+            admission_released: None,
+            complete_fingerprint: Some("fp".into()),
+        };
+        let control = MpuControl {
+            count: 1,
+            staged: 1,
+            max_sessions: max_sessions(),
+            max_records: max_records(),
+            profile: BudgetProfile::deployed(),
+        };
+        assert_eq!(
+            block_on(
+                store.commit(
+                    WriteBatch::new()
+                        .put(mpu_key(upload_id), encode(&session))
+                        .put(MPUCTL_KEY.to_vec(), encode(&control))
+                )
+            )
+            .expect("seed"),
+            CommitOutcome::Committed
+        );
+
+        let first = block_on(drain_step(&store, 5)).expect("step");
+        assert_eq!(first.admissions_released, 1, "the slot comes back");
+        let (after, _) = block_on(read_control(&store)).expect("control");
+        assert_eq!(after.staged, 0, "the staged-reference budget is freed");
+        assert_eq!(
+            after.count, 1,
+            "…but the record population is NOT: the tombstone still occupies an `mpu:` key, which \
+             is what `max_records` bounds and what #625's `W_tombstone` exit releases"
+        );
+        let (tombstone, _) = block_on(read_session(&store, upload_id))
+            .expect("read")
+            .expect("the tombstone survives so a retried Complete still answers 200");
+        assert_eq!(tombstone.state, SessionState::Completed);
+        assert_eq!(tombstone.admission_released, Some(true));
+
+        // Exactly once: a second pass must not decrement again.
+        let second = block_on(drain_step(&store, 6)).expect("step");
+        assert_eq!(second.admissions_released, 0);
+        let (again, _) = block_on(read_control(&store)).expect("control");
+        assert_eq!(again.staged, 0, "no double release");
+        // …and the terminal delete that eventually runs (#625's) reads the marker and does not
+        // decrement a slot this session no longer holds.
+        let (control_now, control_bytes) = block_on(read_control(&store)).expect("control");
+        let (session_now, session_bytes) = block_on(read_session(&store, upload_id))
+            .expect("read")
+            .expect("present");
+        assert_eq!(
+            block_on(store.commit(terminal_delete_batch(
+                upload_id,
+                &session_now,
+                &session_bytes,
+                &session_now.group_nonce,
+                false,
+                &[],
+                &control_now,
+                &control_bytes.expect("present"),
+            )))
+            .expect("terminal delete"),
+            CommitOutcome::Committed
+        );
+        let (final_control, _) = block_on(read_control(&store)).expect("control");
+        assert_eq!(final_control.count, 0, "the record population falls");
+        assert_eq!(
+            final_control.staged, 0,
+            "and `staged` stays at zero — never below it, which would over-admit"
+        );
+    }
+
+    /// A single part whose chunks expand to **more orphan marks than `B_OPS`** still drains.
+    ///
+    /// The batch budget counts *mutations*, and one chunk position expands to one mark per
+    /// fragment: a 156-chunk RS(6,3) part is 1,404 marks, past `B_OPS` (1,000) on its own. Treating
+    /// a retirement unit as indivisible made that part's teardown a single over-budget batch —
+    /// permanently un-committable against a backend that enforces the envelope, i.e. an
+    /// undrainable obligation and a leak of the whole part.
+    #[test]
+    fn a_part_whose_marks_exceed_one_batch_still_drains() {
+        // Enforced envelope, plus the batch's own `require(retire:… == prior)`: `B_OPS`
+        // mutations + 1 precondition is the most a conforming batch may carry.
+        let store = EnvelopeStore {
+            inner: RedbMetadataStore::in_memory().expect("redb"),
+            limit: B_OPS + 1,
+        };
+        let upload_id = "u-wide";
+        let chunks: Vec<ChunkRef> = (0..MAX_PART_CHUNKS)
+            .map(|i| ChunkRef {
+                id: u128::from(i as u64 + 1),
+                scheme: crate::metadata::EcScheme::ReedSolomon { k: 6, m: 3 },
+                len: 1,
+                placement: (0..9u64).collect(),
+            })
+            .collect();
+        let expected_marks = chunks.len() * 9;
+        assert!(
+            expected_marks > B_OPS,
+            "the fixture must exceed one batch's operation budget, or it proves nothing"
+        );
+        let record = PartRecord {
+            chunks,
+            len: MAX_PART_CHUNKS as u64,
+            digest: "00".repeat(32),
+            committed_at_millis: 0,
+            session_epoch: 0,
+        };
+        let token = session_token(upload_id, 0);
+        assert_eq!(
+            block_on(
+                store.commit(
+                    WriteBatch::new()
+                        .put(part_key(upload_id, 1), encode(&record))
+                        .put(
+                            psum_key(upload_id, 1),
+                            encode(&PartSummary {
+                                chunks: record.chunks.len() as u64,
+                                len: record.len,
+                                digest: record.digest.clone(),
+                                committed_at_millis: 0,
+                            })
+                        )
+                        .put(
+                            retire_bytes_key(&token),
+                            encode(&RetireBytes::Session {
+                                upload_id: upload_id.to_string(),
+                                epoch: 0,
+                                parts: true,
+                            })
+                        )
+                )
+            )
+            .expect("seed"),
+            CommitOutcome::Committed
+        );
+
+        let _ = block_on(drain(&store, 99, 32)).expect("drain");
+        assert_eq!(
+            block_on(store.scan(crate::metadata::ORPHAN_PREFIX))
+                .expect("scan")
+                .len(),
+            expected_marks,
+            "every fragment position of every chunk carries evidence"
+        );
+        assert!(
+            block_on(store.scan(&part_prefix(upload_id)))
+                .expect("scan")
+                .is_empty(),
+            "and the part record is released once its bytes are evidenced"
+        );
+        assert!(
+            block_on(store.get(&retire_bytes_key(&token)))
+                .expect("get")
+                .is_none(),
+            "an obligation whose marks exceed one batch is still drainable, not permanently stuck"
+        );
+    }
+}
