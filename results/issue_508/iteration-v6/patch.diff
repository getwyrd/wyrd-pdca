+    /// Seed a session with `parts` committed `part:`/`psum:` records, each naming one chunk.
+    fn seed_session(store: &RedbMetadataStore, upload_id: &str, parts: u32) {
+        let mut batch = WriteBatch::new();
+        for number in 1..=parts {
+            let record = PartRecord {
+                chunks: vec![ChunkRef {
+                    id: u128::from(number),
+                    scheme: crate::metadata::EcScheme::None,
+                    len: 1,
+                    placement: vec![0],
+                }],
+                len: 1,
+                digest: "00".repeat(32),
+                committed_at_millis: 0,
+                session_epoch: 0,
+            };
+            let summary = PartSummary {
+                chunks: 1,
+                len: 1,
+                digest: record.digest.clone(),
+                committed_at_millis: 0,
+            };
+            batch = batch
+                .put(part_key(upload_id, number), encode(&record))
+                .put(psum_key(upload_id, number), encode(&summary));
+        }
+        assert_eq!(
+            block_on(store.commit(batch)).expect("seed"),
+            CommitOutcome::Committed
+        );
+    }
+
+    /// A `retire:records:{parts}` obligation naming **more keys than one batch may carry**
+    /// drains to completion.
+    ///
+    /// This is the convergence property the paged branch used to lack: it derived its key list
+    /// from the immutable payload, so every pass recomputed the identical list and re-deleted the
+    /// same first `B_OPS` (already-absent) keys — forever. Any Complete naming ≥ 501 parts (two
+    /// keys per part) reached it, i.e. the headline `aws s3 cp` of a multi-GB file at the AWS
+    /// CLI's default part size. The fix derives the list from **live** state, so each pass sees
+    /// strictly fewer named keys than the last.
+    #[test]
+    fn a_records_obligation_larger_than_one_batch_drains_to_completion() {
+        let store = RedbMetadataStore::in_memory().expect("redb");
+        let upload_id = "u-big";
+        // 700 parts ⇒ 1,400 record keys, comfortably past `B_OPS` (1,000).
+        let parts = 700u32;
+        seed_session(&store, upload_id, parts);
+
+        let token = session_token(upload_id, 0);
+        let payload = RetireRecords::Parts {
+            upload_id: upload_id.to_string(),
+            parts: encode_part_ranges(&(1..=parts).collect::<Vec<_>>()),
+        };
+        assert_eq!(
+            block_on(
+                store.commit(WriteBatch::new().put(retire_records_key(&token), encode(&payload)))
+            )
+            .expect("install"),
+            CommitOutcome::Committed
+        );
+
+        let report = block_on(drain(&store, 0, 32)).expect("drain");
+        assert_eq!(
+            block_on(store.scan(&part_prefix(upload_id)))
+                .expect("scan")
+                .len(),
+            0,
+            "every named `part:` record must be deleted — a payload-derived key list re-deletes \
+             the same first {B_OPS} keys on every pass and never converges"
+        );
+        assert!(
+            block_on(store.get(&retire_records_key(&token)))
+                .expect("get")
+                .is_none(),
+            "and the obligation itself is retired once its last named key is gone"
+        );
+        assert_eq!(
+            report.records_deleted,
+            (parts as usize) * 2,
+            "the report counts the records actually deleted, not `B_OPS` per futile pass"
