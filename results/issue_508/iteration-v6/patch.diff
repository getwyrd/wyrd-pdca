+/// The payload of a `retire:bytes:` obligation — bytes to orphan-mark, then the naming
+/// records to delete.
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+pub enum RetireBytes {
+    /// A torn-down session's owned residue and, optionally, its committed parts.
+    Session {
+        /// The session whose `sidx:` range and `part:` records this obligation clears.
+        upload_id: String,
+        /// The fence epoch that installed it — the obligation's **event identity**.
+        epoch: u64,
+        /// Whether the committed `part:`/`psum:` records go with it.
+        parts: bool,
+    },
+    /// The staged parts a Complete did **not** name. Their bytes are orphan-marked and
+    /// *then* their records deleted, in one obligation — never split across a
+    /// `retire:records:` that could delete the record (the only source of the placements)
+    /// first (`0016:909-924`).
+    UnnamedParts {
+        /// The session those parts belong to.
+        upload_id: String,
+        /// The fence epoch.
+        epoch: u64,
+        /// The part numbers, range-encoded.
+        parts: Vec<(u32, u32)>,
+    },
+    /// A losing writer's, or a post-staging refusal's, staged chunks.
+    Chunks {
+        /// The chunks' recorded placements, so the drain can compute every `orphan:` key
+        /// without re-reading a record that may already be gone.
+        placements: Vec<StagedChunk>,
+    },
+    /// A superseded or deleted object generation.
+    Generation {
+        /// The inode.
+        inode: InodeId,
+        /// The version being retired.
+        version: u64,
+        /// The generation's chunks (a flat map).
+        chunks: Vec<ChunkRef>,
+        /// The generation's segment group, when it was segmented — the drain re-reads each
+        /// `seg:` record's **current** placement at drain time, never a frozen one.
+        #[serde(default, skip_serializing_if = "Option::is_none")]
+        segments: Option<SegmentGroup>,
+    },
+}
