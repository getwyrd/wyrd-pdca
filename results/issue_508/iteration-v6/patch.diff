+/// `GET /{bucket}?uploads` — the container's open sessions.
+async fn list_multipart_uploads<G>(
+    state: &AppState<G>,
+    request_id: RequestId,
+    bucket: &str,
+    query: &str,
+) -> Response
+where
+    G: ObjectGateway + ContainerGateway + MultipartGateway,
+{
+    // Decoded **once**: `decoded_query_key` matches a percent-encoded key spelling and returns
+    // the decoded value, where the old `query_param(..).map(percent_decode_utf8)` matched only
+    // the raw key and then decoded the value a second time — so a client filtering on a literal
+    // `%2F` had it turned into `/` and got a different listing than it asked for.
+    let prefix = decoded_query_key(query, "prefix");
+    match state
+        .gateway
+        .list_multipart_uploads(bucket, prefix.as_deref())
+        .await
+    {
+        Ok(uploads) => {
+            let mut xml = format!(
+                "<ListMultipartUploadsResult><Bucket>{}</Bucket><IsTruncated>false</IsTruncated>",
+                xml_escape(bucket)
+            );
+            if let Some(prefix) = &prefix {
+                xml.push_str(&format!("<Prefix>{}</Prefix>", xml_escape(prefix)));
+            }
+            for upload in &uploads {
+                xml.push_str(&format!(
+                    "<Upload><Key>{}</Key><UploadId>{}</UploadId>{}</Upload>",
+                    xml_escape(&upload.key),
+                    xml_escape(&upload.upload_id),
+                    upload
+                        .initiated
+                        .and_then(iso8601)
+                        .map(|when| format!("<Initiated>{}</Initiated>", xml_escape(&when)))
+                        .unwrap_or_default()
+                ));
+            }
+            xml.push_str("</ListMultipartUploadsResult>");
+            xml_response(StatusCode::OK, &xml)
+        }
+        Err(err) => multipart_fault_response(request_id, &err),
+    }
