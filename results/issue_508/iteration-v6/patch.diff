+async fn prop_staged_replace_losing_to_a_fence_leaves_its_premark(rng: &mut ChaCha8Rng) {
+    let meta = MemMeta::default();
+    let fleet: Vec<(DServerId, MemDServer)> = (0..(N + 1) as DServerId)
+        .map(|id| (id, MemDServer::default()))
+        .collect();
+    let fx = seed_mpu_session(&meta, &fleet, rng).await;
+
+    // A repoint reads the session and the part record, pre-marks its destination, writes the
+    // destination fragment…
+    let (session, session_bytes) = multipart::read_session(&meta, &fx.upload_id)
+        .await
+        .expect("read")
+        .expect("session");
+    let part_key = multipart::part_key(&fx.upload_id, 1);
+    let part_bytes = meta.get(&part_key).await.expect("get").expect("part");
+    let mut record: multipart::PartRecord = metadata::decode(&part_bytes).expect("decode");
+    let target = N as DServerId; // the spare domain
+    let moved = FragmentId {
+        chunk: fx.chunk.id,
+        index: 0,
+    };
+    let premark = metadata::orphan_key(target, moved);
+    assert_eq!(
+        meta.commit(WriteBatch::new().put(premark.clone(), b"5000".to_vec()))
+            .await
+            .expect("pre-mark"),
+        CommitOutcome::Committed
+    );
+    fleet[target as usize]
+        .1
+        .put_fragment(
+            moved,
+            Bytes::from(vec![0u8; usize::from(CORE_HEADER_LEN) + 8]),
+        )
+        .await
+        .expect("write the destination");
+
+    // …but a Complete/Abort/reap fences the session in the write→CAS window.
+    let (abort, _) = multipart::abort_fence_batch(&fx.upload_id, &session, &session_bytes);
+    assert_eq!(
+        meta.commit(abort).await.expect("fence"),
+        CommitOutcome::Committed
+    );
+
+    // The repoint's CAS now loses — and it must be a NO-OP, not a partially applied move.
+    record.chunks[0].placement[0] = target;
+    let outcome = meta
+        .commit(
+            WriteBatch::new()
+                .require(multipart::mpu_key(&fx.upload_id), session_bytes.clone())
+                .require(part_key.clone(), part_bytes.clone())
+                .put(part_key.clone(), metadata::encode(&record))
+                .delete(premark.clone()),
+        )
+        .await
+        .expect("repoint");
+    assert_eq!(
+        outcome,
+        CommitOutcome::Conflict,
+        "a repoint whose session left `Open@E` in the window must LOSE its fenced CAS"
+    );
+    assert!(
+        meta.get(&premark).await.expect("get").is_some(),
+        "and its destination pre-mark must STAND, so GC reclaims the pre-written fragment — a \
+         repoint that wrote the destination without pre-marking strands it unreferenced AND \
+         unevidenced, which GC retains for ever"
+    );
+}
+
+/// A store that lands a **publication** the first time a maintenance pass scans the *committed*
+/// class, so the pass observes the handoff mid-flight. This is the X67 window in its exact shape:
+/// a chunk moves from the staged class (`part:`) to the committed one (`inode:`) at the flip, so a
+/// consumer that reads the **destination before the source** can see it in *neither* — the staged
+/// scan runs after the publication deleted the `part:` records, and the committed scan ran before
+/// the inode existed.
+struct HandoffMeta {
+    inner: MemMeta,
+    /// Applied (once) when the **staged** class (`mpu:`) is scanned — the second of the two class
+    /// reads under the broken destination-first order, and the first under the correct one. That
+    /// single injection point therefore exercises both: a destination-first pass has already
+    /// missed the not-yet-published inode and now finds the session `Completed` and its `part:`
+    /// records gone (the chunk in neither class); a source-first pass sees the publication land
+    /// before it reads anything, so its later committed scan finds the chunk.
+    publish: Mutex<Option<WriteBatch>>,
+}
+
+#[async_trait]
+impl MetadataStore for HandoffMeta {
+    async fn get(&self, key: &[u8]) -> Result<Option<Bytes>> {
+        self.inner.get(key).await
+    }
+
+    async fn scan(&self, prefix: &[u8]) -> Result<Vec<(Vec<u8>, Bytes)>> {
+        if prefix == multipart::MPU_PREFIX {
+            let batch = self.publish.lock().unwrap().take();
+            if let Some(batch) = batch {
+                assert_eq!(
+                    self.inner.commit(batch).await?,
+                    CommitOutcome::Committed,
+                    "the interposed publication must land"
+                );
+            }
+        }
+        self.inner.scan(prefix).await
+    }
+
+    async fn commit(&self, batch: WriteBatch) -> Result<CommitOutcome> {
+        self.inner.commit(batch).await
+    }
+}
+
+/// **X67** — the inode-before-`part:` publication handoff (decision 2's *source before
+/// destination* rule, `0016:820-890`).
+///
+/// A damaged chunk of a session that publishes **while a maintenance pass is walking** must never
+/// have its repair obligation silently dropped. The pass resolves two classes; the publication
+/// moves the chunk from the first to the second. Read the destination first and there is a window
+/// in which the chunk is in neither — the obligation resolves to "referenced by nothing", is
+/// drained, and a *referenced, damaged* fragment of a freshly-published object is left
+/// unrepaired with nothing to re-enqueue it. Reading the source first cannot lose it.
+///
+/// The interposition is the store's, not the test's: [`HandoffMeta`] lands the real publication
+/// batch at the instant the pass scans `inode:`, so the interleaving is the production one rather
+/// than a re-enacted sketch.
+async fn prop_publication_handoff_never_drops_a_repair(rng: &mut ChaCha8Rng) {
+    let fleet: Vec<(DServerId, MemDServer)> = (0..(N + 1) as DServerId)
+        .map(|id| (id, MemDServer::default()))
+        .collect();
+    let meta = HandoffMeta {
+        inner: MemMeta::default(),
+        publish: Mutex::new(None),
+    };
+    let fx = seed_mpu_session(&meta.inner, &fleet, rng).await;
+
+    // Kill one fragment of the staged chunk and enqueue its repair — the obligation whose fate
+    // this property is about.
+    let victim = (rng.next_u32() % N as u32) as u16;
+    fleet[victim as usize]
+        .1
+        .delete_fragment(FragmentId {
+            chunk: fx.chunk.id,
+            index: victim,
+        })
+        .await
+        .expect("kill a staged fragment");
+    repair::enqueue_repair(&meta.inner, fx.chunk.id, "health")
+        .await
+        .expect("enqueue");
+
+    // Arm the handoff: the real publication batch (root flip + session → `Completed`) plus the
+    // `part:`/`psum:` deletions its `retire:records:{parts}` obligation performs — i.e. the whole
+    // handoff, collapsed to the instant the pass reads the committed class.
+    let (session, session_bytes) = multipart::read_session(&meta.inner, &fx.upload_id)
+        .await
+        .expect("read")
+        .expect("session");
+    let (fenced_batch, fenced) = multipart::fence_complete_batch(
+        &fx.upload_id,
+        &session,
+        &session_bytes,
+        multipart::PublishTarget {
+            parent: 0,
+            name: "b/k".to_string(),
+            epoch: session.epoch + 1,
+        },
+        1_000,
+    );
+    assert_eq!(
+        meta.inner.commit(fenced_batch).await.expect("fence"),
+        CommitOutcome::Committed
+    );
+    let fenced_bytes = metadata::encode(&fenced);
+    let (publish, _) = multipart::publish_batch(
+        &fx.upload_id,
+        &fenced,
+        &fenced_bytes,
+        0,
+        "b/k",
+        &multipart::FlipBinding::Fresh { inode: INODE },
+        &multipart::PublishedMap::Flat(vec![fx.chunk.clone()]),
+        8,
+        &multipart::published_object_meta(&format!("{}-1", "00".repeat(32)), None, 1_000),
+        &[1],
+        &[],
+        "fp",
+        &format!("{}-1", "00".repeat(32)),
+        1_000,
+    );
+    *meta.publish.lock().unwrap() = Some(
+        publish
+            .delete(multipart::part_key(&fx.upload_id, 1))
+            .delete(multipart::psum_key(&fx.upload_id, 1)),
+    );
+
+    // One reconstruction pass through the real fenced control point, over the healthy fleet (the
+    // victim's server is gone from both the topology and the fleet view, as a killed server is).
+    let mut topo = Topology::default();
+    let mut healthy: Vec<(DServerId, &dyn ChunkStore)> = Vec::new();
+    for (id, store) in &fleet {
+        if *id as u16 == victim {
+            continue;
+        }
+        topo.register(*id, domain_letter(*id));
+        healthy.push((*id, store as &dyn ChunkStore));
+    }
+    let ctx = ReconstructionContext {
+        meta: &meta,
+        fleet: &healthy,
+        topology: &topo,
+        unreachable: &[],
+    };
+    let coord = MemCoordination::new();
+    let (zone, custodian) = elect(&coord, "zone-handoff").await;
+    let _ = reconcile_step(&zone, &custodian, None, None, Some(&ctx), None, 2_000)
+        .await
+        .expect("reconstruction pass");
+
+    // The binding assertion: the obligation may be drained ONLY if the chunk was actually
+    // repaired. "Drained and still damaged" is the silent loss.
+    let drained = repair::queued_repairs(&meta.inner)
+        .await
+        .expect("queue")
+        .is_empty();
+    let repaired = fleet_holds_all_fragments(&fleet, &fx.chunk).await;
+    assert!(
+        !drained || repaired,
+        "a referenced chunk's repair obligation was dropped while the chunk was still damaged — \
+         the publication handoff moved it between the two class scans, which is exactly what \
+         reading the SOURCE (staged `part:`) before the DESTINATION (`inode:`) prevents"
+    );
+    assert_no_classification_gap(&meta.inner, &fleet).await;
+}
+
+/// Whether every fragment position `chunk`'s scheme names is present somewhere on the fleet.
+async fn fleet_holds_all_fragments(fleet: &[(DServerId, MemDServer)], chunk: &ChunkRef) -> bool {
+    for index in 0..chunk.fragment_count() {
+        let frag = FragmentId {
+            chunk: chunk.id,
+            index,
+        };
+        let mut found = false;
+        for (_, store) in fleet {
+            if store.get_fragment(frag).await.expect("get").is_some() {
+                found = true;
+                break;
+            }
+        }
+        if !found {
+            return false;
+        }
+    }
+    true
+}
+
+/// **X59** — the drain-request-versus-intent fence race (`0016:884-889`).
+///
+/// A staging intent records a placement; an operator drain request records
+/// `desired:dserver:<S>`. Exactly **two** outcomes are admissible, and the third is the F6 wipe
+/// trace: the intent commits first (so the staged set counts those fragments as held and the
+/// server reports `Pending`), or the drain record commits first (so the intent's
+/// `require_absent(desired:dserver:<S>)` fails and the write path re-plans). What must never
+/// happen is *both* — an intent landing on a server already recorded as draining, which a
+/// filtered selector alone permits because selection reads a topology snapshot while the intent
+/// commits later.
+///
+/// The seed chooses the order, so the campaign covers both interleavings across runs.
+async fn prop_drain_request_versus_intent_admits_exactly_one(rng: &mut ChaCha8Rng) {
+    let fleet: Vec<(DServerId, MemDServer)> = (0..(N + 1) as DServerId)
+        .map(|id| (id, MemDServer::default()))
+        .collect();
+    let meta = MemMeta::default();
+    let fx = seed_mpu_session(&meta, &fleet, rng).await;
+    let (_, session_bytes) = multipart::read_session(&meta, &fx.upload_id)
+        .await
+        .expect("read")
+        .expect("session");
+
+    // The slot the intent renews, and the intent itself: a fresh chunk placed on server 0.
+    let slot = multipart::SlotRecord {
+        part_number: 2,
+        attempt_id: "a".to_string(),
+        reserved_at_millis: 0,
+        lease_expiry_millis: 1_000,
+    };
+    let slot_index = multipart::reserve_slot(&meta, &fx.upload_id, &session_bytes, &slot)
+        .await
+        .expect("reserve")
+        .expect("a free slot");
+    let slot_bytes = metadata::encode(&slot);
+    let draining: DServerId = 0;
+    let chunk_id = fx.chunk.id + 1;
+    let entry = PendingEntry::owned(
+        1_000,
+        &fx.upload_id,
+        metadata::StagedPlacement {
+            scheme: EcScheme::ReedSolomon {
+                k: K as u8,
+                m: M as u8,
+            },
+            placement: (0..N as DServerId).collect(),
+        },
+    );
+    let intent = multipart::stage_chunk_batch(
+        &fx.upload_id,
+        &session_bytes,
+        slot_index,
+        &slot_bytes,
+        &slot,
+        2,
+        chunk_id,
+        &entry,
+        &(0..N as DServerId).collect::<Vec<_>>(),
+    );
+    let drain_request = WriteBatch::new().put(
+        multipart::desired_dserver_key(draining),
+        Bytes::from_static(b"{\"state\":\"Draining\"}"),
+    );
+
+    // The seed picks which of the two racers commits first.
+    let intent_first = rng.next_u32().is_multiple_of(2);
+    let (intent_outcome, _) = if intent_first {
+        let a = meta.commit(intent).await.expect("intent");
+        let b = meta.commit(drain_request).await.expect("drain request");
+        (a, b)
+    } else {
+        let b = meta.commit(drain_request).await.expect("drain request");
+        let a = meta.commit(intent).await.expect("intent");
+        (a, b)
+    };
+    let staged_exists = meta
+        .get(&multipart::sidx_key(&fx.upload_id, 2, chunk_id))
+        .await
+        .expect("get")
+        .is_some();
+
+    if intent_first {
+        assert_eq!(
+            intent_outcome,
+            CommitOutcome::Committed,
+            "an intent that wins the race commits"
+        );
+        assert!(staged_exists, "…and its owned staging entry exists");
+        // …and because it exists, the drain is observably NOT satisfied: the staged protection
+        // class names those fragments on that server, and the F6 wipe trace is precisely a drain
+        // answering `Satisfied` over exactly these bytes.
+        assert_eq!(
+            wyrd_custodian::reconciliation_status(&meta, draining)
+                .await
+                .expect("status"),
+            wyrd_custodian::ReconciliationStatus::Pending,
+            "a drain must report `Pending` while a still-streaming part's fragments sit on the \
+             server — reporting `Satisfied` invites the operator to wipe live bytes"
+        );
+    } else {
+        assert_eq!(
+            intent_outcome,
+            CommitOutcome::Conflict,
+            "an intent that loses to a recorded drain request MUST fail its \
+             `require_absent(desired:dserver:<S>)` fence — a filtered selector alone would let it \
+             land on a server already reported as draining"
+        );
+        assert!(
+            !staged_exists,
+            "…and it leaves no staging entry behind, so the write path re-plans against the \
+             fresh topology"
+        );
+    }
+    assert_no_classification_gap(&meta, &fleet).await;
+}
