         SCAN_CAP
     );
 }
+
+/// **The paged walk escapes the cap the whole `scan` cannot** (proposal 0016 decision 4,
+/// issue #508) — the property that makes `scan_page` a native implementation rather than a
+/// default over `scan`.
+///
+/// This is the discriminating assertion: the trait's *default* `scan_page` pages a complete
+/// `scan`, so it inherits the cap and fails here on **every** call. A `retire:` namespace grown
+/// past the cap would then be unenumerable for ever, and every obligation in it — bytes and
+/// records — retained for ever, which is the exact failure the seam exists to prevent.
+#[test]
+fn scan_page_walks_a_population_past_the_cap_that_scan_refuses_whole() {
+    let store = store_with_cap(LOWERED_CAP);
+    let total = LOWERED_CAP * 3 + 1;
+    seed(&store, total);
+
+    // `scan` fails loud on this population — the premise of the test.
+    assert!(
+        block_on(store.scan(b"p:")).is_err(),
+        "the whole-range scan must fail loud past the cap, or this test proves nothing"
+    );
+
+    // The paged walk enumerates all of it, in order, one bounded page at a time.
+    let mut walked: Vec<Vec<u8>> = Vec::new();
+    let mut cursor: Option<Vec<u8>> = None;
+    loop {
+        let page = block_on(store.scan_page(b"p:", cursor.as_deref(), LOWERED_CAP / 2))
+            .expect("a bounded page never exceeds the cap");
+        assert!(page.entries.len() <= LOWERED_CAP / 2);
+        walked.extend(page.entries.iter().map(|(k, _)| k.clone()));
+        match page.next {
+            Some(next) => cursor = Some(next),
+            None => break,
+        }
+    }
+    assert_eq!(
+        walked.len(),
+        total,
+        "every key of the range is walked exactly once"
+    );
+    let mut sorted = walked.clone();
+    sorted.sort();
+    assert_eq!(walked, sorted, "the walk is byte-lexicographically ordered");
+}
