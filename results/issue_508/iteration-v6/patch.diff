+/// The **classification sweep**: after a scenario, every durable fragment must still be in at
+/// least one safe class. A restore pass is the public observable — it orphan-marks exactly the
+/// positions it can classify as referenced by nothing, so `stranded_marked == 0` is the no-gaps
+/// claim, and any gap the protocol opened shows up here as a mark on a live byte.
+async fn assert_no_classification_gap(meta: &MemMeta, fleet: &[(DServerId, MemDServer)]) {
+    let stores: Vec<(DServerId, &dyn ChunkStore)> = fleet
+        .iter()
+        .map(|(id, store)| (*id, store as &dyn ChunkStore))
+        .collect();
+    let ctx = GcContext {
+        meta,
+        fleet: &stores,
+        grace_window_millis: 1_000,
+        expired_pending: ExpiredPendingPolicy::Defer,
+    };
+    let report = wyrd_custodian::reconcile_after_restore(&ctx, 10_000)
+        .await
+        .expect("reconcile_after_restore");
+    assert_eq!(
+        report.stranded_marked, 0,
+        "classification sweep: every durable fragment must be in at least one safe class — a \
+         position in NONE of them is invariant (2) failing, and the restore pass is what turns \
+         that gap into an orphan mark on a live byte"
+    );
