+/// Route one object-scoped multipart form to its verb.
+#[allow(clippy::too_many_arguments)]
+async fn dispatch_multipart<G>(
+    state: &AppState<G>,
+    request_id: RequestId,
+    bucket: &str,
+    key: &str,
+    form: MultipartForm,
+    payload: sigv4::PayloadHash,
+    content_type: Option<String>,
+    body: Body,
