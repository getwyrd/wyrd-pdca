+/// This is the clause that makes the seam a contract rather than a signature. Today's `scan`
+/// leaves ordering *unspecified*, so a `scan_page` that inherited that freedom could return
+/// pages whose continuation silently **skips** a key — and a skipped `retire:` obligation is
+/// bytes and records retained forever, the exact failure the paginated walk exists to prevent.
+pub async fn contract_scan_page_orders_and_pages(store: &impl MetadataStore) {
+    // Keys chosen so insertion order is NOT sorted order, and so a naive `starts_with` walk
+    // that ignored ordering would be observable: `pg:1` .. `pg:9` plus two foreign keys that
+    // bracket the range on BOTH sides (`pf:` sorts before, `ph:` after).
+    let mut batch = WriteBatch::new()
+        .put(b"pf:z".to_vec(), "before")
+        .put(b"ph:a".to_vec(), "after");
+    for n in [5u32, 1, 9, 3, 7] {
+        batch = batch.put(format!("pg:{n}").into_bytes(), format!("v{n}"));
+    }
+    store.commit(batch).await.unwrap();
+
+    // Rule 1 — one page of the whole range comes back in byte-lexicographic order.
+    let page = store.scan_page(b"pg:", None, 10).await.unwrap();
+    let keys: Vec<Vec<u8>> = page.entries.iter().map(|(k, _)| k.clone()).collect();
+    let mut sorted = keys.clone();
+    sorted.sort();
+    assert_eq!(
+        keys, sorted,
+        "a page must be ordered by raw byte-lexicographic key"
+    );
+    assert_eq!(keys.len(), 5, "the page must hold exactly the prefix range");
+    // Rule 3 — the prefix was exhausted, so `next` is `None`.
+    assert!(
+        page.next.is_none(),
+        "`next` is None ONLY when the prefix is exhausted — a caller that stops on None has \
+         walked the whole range"
+    );
+
+    // Rules 2 + 4 — page through it two at a time: the cursor is exclusive and the walk
+    // returns every key exactly once, in order.
+    let mut walked: Vec<Vec<u8>> = Vec::new();
+    let mut cursor: Option<Vec<u8>> = None;
+    let mut pages = 0;
