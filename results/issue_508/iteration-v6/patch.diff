+/// The payload of a `retire:records:` obligation — records to delete whose bytes are
+/// protected by something else. It orphan-marks nothing.
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+pub enum RetireRecords {
+    /// The **published** parts' `part:` + `psum:` records — never the parts Complete left
+    /// unnamed, whose records ride their own `retire:bytes:` obligation so that marking
+    /// always precedes deletion.
+    Parts {
+        /// The session.
+        upload_id: String,
+        /// The published part numbers, range-encoded.
+        parts: Vec<(u32, u32)>,
+    },
+    /// One rolled-back `Completing` attempt's dangling segments, naming **exactly** that
+    /// epoch's keys.
+    Segments {
+        /// The segment group.
+        group: SegmentGroup,
+    },
+}
