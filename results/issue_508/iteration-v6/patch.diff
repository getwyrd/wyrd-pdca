+/// A segmented root's segment table: the group its `seg:` records live under, how many
+/// there are, and each one's byte span.
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+pub struct SegmentedMap {
+    /// The segment group — the independent nonce plus the `Completing` fence epoch that
+    /// wrote the segments.
+    pub group: SegmentGroup,
+    /// How many segments the group holds; a root whose count exceeds the **format**
+    /// segment maximum is a decode error, never a silently-corrected default.
+    pub segment_count: u32,
+    /// The segment table, in object order.
+    pub segments: Vec<SegmentRef>,
+}
+
+/// Resolve an inode's chunk map — flat inline, or by reading the bounded per-object
+/// `seg:<group-nonce>:<epoch>:` range (≤ [`MAX_ROOT_SEGMENTS`]), **never** a global `seg:`
+/// scan.
+///
+/// **Reader safety (`0016:2452-2474`, the resolve-retry rule).** Retiring a superseded or
+/// deleted generation deletes its `seg:` records, which could tear a consumer that has read
+/// the root and is midway through its segments. Rather than a second grace clock, resolution
+/// is made retry-tolerant using an ordering the protocol already guarantees — the root is
+/// flipped away from a generation *before* that generation's `seg:` records are ever
+/// deleted. So: a segment read that comes back **absent** re-reads the root; a root now
+/// naming a **different** group (superseded) or **absent** (deleted) means the generation
+/// was concurrently retired and the caller restarts or answers "no such object", while a
+/// root **unchanged** with a segment **absent** is an invariant violation — a live
+/// generation never loses a segment — and is **fail-closed**, an error, never a torn
+/// success.
+pub async fn resolve_chunk_map<S: MetadataStore + ?Sized>(
+    store: &S,
+    inode_id: InodeId,
+    inode: &crate::metadata::InodeRecord,
+) -> Result<Option<Vec<ChunkRef>>> {
+    let Some(map) = &inode.segments else {
+        return Ok(Some(inode.chunk_map.clone()));
+    };
+    // **Structural validation at the decode boundary** (ADR-0045): the segmented root's own
+    // shape is checked BEFORE any segment is read, and every violation is an *error* rather
+    // than a value — a count-only check would accept a root whose table is inconsistent with
+    // its own segments (duplicated or non-contiguous indices, a byte span that does not tile
+    // the object, a map that is flat *and* segmented at once) and then serve a wrong body,
+    // which is worse than a refusal.
+    validate_segmented_root(inode_id, inode, map)?;
+    let prefix = seg_prefix(&map.group.nonce, map.group.epoch);
+    let count = map.segment_count as usize;
+    let mut slots: Vec<Option<SegmentRecord>> = vec![None; count];
+    let mut present = 0usize;
+    for (key, value) in store.scan(&prefix).await? {
+        // A key under this group's prefix that does not parse as an index, or names an index
+        // outside the root's table, or repeats one, is a structural violation of a namespace
+        // only this protocol writes — fail closed rather than skip it silently, since a
+        // skipped segment is a silently short map.
+        let Some(index) = parse_scoped_number(&key, &prefix) else {
+            return Err(MultipartError::InvalidArgument(format!(
+                "segment key `{}` under group `{}` does not name a segment index",
+                String::from_utf8_lossy(&key),
+                String::from_utf8_lossy(&prefix)
+            ))
+            .into());
+        };
+        let Some(slot) = slots.get_mut(index as usize) else {
+            return Err(MultipartError::InvalidArgument(format!(
+                "segment index {index} is outside the {count} segments inode {inode_id}'s root \
+                 names"
+            ))
+            .into());
+        };
+        if slot.is_some() {
+            return Err(MultipartError::InvalidArgument(format!(
+                "segment index {index} of group `{}` is present twice",
+                String::from_utf8_lossy(&prefix)
+            ))
+            .into());
+        }
+        *slot = Some(decode::<SegmentRecord>(&value)?);
+        present += 1;
+    }
+    if present != count {
+        // A segment is missing. Re-read the root: a generation that was concurrently
+        // retired is not an error for the reader, it is a restart.
+        let current = store.get(&metadata::inode_key(inode_id)).await?;
+        let still_current = match &current {
+            None => false,
+            Some(bytes) => decode::<crate::metadata::InodeRecord>(bytes)?
+                .segments
+                .as_ref()
+                .map(|s| s.group == map.group)
+                .unwrap_or(false),
+        };
+        if !still_current {
+            return Ok(None);
+        }
+        return Err(MultipartError::InvalidArgument(format!(
+            "segmented object {inode_id} names {} segments but only {present} are present under \
+             `{}` while its root still points at that group — a live generation never loses \
+             a segment",
+            map.segment_count,
+            String::from_utf8_lossy(&prefix)
+        ))
+        .into());
+    }
+    let mut out = Vec::new();
+    for (index, slot) in slots.into_iter().enumerate() {
+        let record = slot.expect("every slot is filled once `present == count`");
+        // The record's own byte span must be the one the root's table promised: a segment
+        // whose chunks do not tile the advertised span would assemble an object of a
+        // different length than the root declares.
+        let span: u64 = record.chunks.iter().map(|c| c.len).sum();
+        if span != map.segments[index].byte_len {
+            return Err(MultipartError::InvalidArgument(format!(
+                "segment {index} of inode {inode_id} holds {span} bytes but its root's table \
+                 declares {}",
+                map.segments[index].byte_len
+            ))
+            .into());
+        }
+        out.extend(record.chunks);
+    }
+    Ok(Some(out))
+}
+
+/// Validate a segmented root's own shape — the structural half of [`resolve_chunk_map`],
+/// separated so the record-reading half stays readable and so the rules are testable without
+/// a store.
+///
+/// Every rule here is an invariant the publication path establishes in one fenced batch, so a
+/// violation means corruption or a foreign writer, never a legal state: flat and segmented are
+/// **exclusive**, the table's length is its own `segment_count`, the count is inside the format
+/// maximum, indices are exactly `0..count` in order, and the spans tile `[0, size)` without gap
+/// or overlap.
+fn validate_segmented_root(
+    inode_id: InodeId,
+    inode: &crate::metadata::InodeRecord,
+    map: &SegmentedMap,
+) -> Result<()> {
+    let bad =
+        |what: String| -> wyrd_traits::BoxError { MultipartError::InvalidArgument(what).into() };
+    if !inode.chunk_map.is_empty() {
+        return Err(bad(format!(
+            "inode {inode_id} carries both an inline chunk map ({} chunks) and a segmented root \
+             — the two forms are exclusive",
+            inode.chunk_map.len()
+        )));
+    }
+    if map.segments.len() != map.segment_count as usize {
+        return Err(bad(format!(
+            "inode {inode_id}'s segment table holds {} entries but declares {}",
+            map.segments.len(),
+            map.segment_count
+        )));
+    }
+    if map.segment_count == 0 || map.segment_count as usize > MAX_ROOT_SEGMENTS {
+        return Err(bad(format!(
+            "inode {inode_id} declares {} segments, outside 1..={MAX_ROOT_SEGMENTS}",
+            map.segment_count
+        )));
+    }
+    let mut offset = 0u64;
+    for (position, seg) in map.segments.iter().enumerate() {
+        if seg.index != position as u32 {
+            return Err(bad(format!(
+                "inode {inode_id}'s segment table entry {position} names index {} — a root's \
+                 table is ordered and contiguous",
+                seg.index
+            )));
+        }
+        if seg.byte_offset != offset {
+            return Err(bad(format!(
+                "inode {inode_id}'s segment {position} starts at byte {} but the prior segments \
+                 end at {offset} — the spans must tile the object",
+                seg.byte_offset
+            )));
+        }
+        offset = offset.saturating_add(seg.byte_len);
+    }
+    if offset != inode.size {
+        return Err(bad(format!(
+            "inode {inode_id}'s segment table spans {offset} bytes but the root declares a size \
+             of {}",
+            inode.size
+        )));
+    }
+    Ok(())
+}
+
+/// One entry of a segmented root's segment table.
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+pub struct SegmentRef {
+    /// The segment index within the group.
+    pub index: u32,
+    /// The segment's first byte offset within the object.
+    pub byte_offset: u64,
+    /// The segment's byte length.
+    pub byte_len: u64,
+}
+
+/// Errors this protocol raises. They are *protocol* answers, not wire answers — the S3
+/// crate maps each onto a status + code.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum MultipartError {
+    /// No session with that id exists in a state that could serve the request.
+    NoSuchUpload,
+    /// The session is fenced by another Complete.
+    OperationAborted,
+    /// Too many open sessions, or too many parts in flight for this session.
+    SlowDown,
+    /// A named part is absent, or its digest does not match.
+    InvalidPart,
+    /// The named parts are not in ascending part-number order.
+    InvalidPartOrder,
+    /// A non-final part is below S3's 5 MiB minimum.
+    EntityTooSmall,
+    /// A part's chunk count exceeds `MAX_PART_CHUNKS`, or the session's staged total would
+    /// exceed `MAX_STAGED_CHUNKS`, or a single PUT cannot fit `MAX_MAP_CHUNKS` even at
+    /// `chunk_size_max`.
+    EntityTooLarge,
+    /// A part number outside `1..=MAX_PARTS_PER_SESSION`, or another malformed argument.
+    InvalidArgument(String),
+    /// The target container has no record.
+    NoSuchBucket,
+    /// The publication CAS lost `R_publish` times; the fence is released and the session
+    /// stays usable.
+    PublishContended,
+}
+
+impl std::fmt::Display for MultipartError {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        match self {
+            MultipartError::NoSuchUpload => write!(f, "the specified upload does not exist"),
+            MultipartError::OperationAborted => {
+                write!(f, "a conflicting operation is in progress on this upload")
+            }
+            MultipartError::SlowDown => write!(f, "too many in-flight parts or open uploads"),
+            MultipartError::InvalidPart => write!(
+                f,
+                "one or more of the specified parts could not be found, or its entity tag did \
+                 not match"
+            ),
+            MultipartError::InvalidPartOrder => {
+                write!(f, "the list of parts was not in ascending order")
+            }
+            MultipartError::EntityTooSmall => write!(
+                f,
+                "a non-final part is smaller than the minimum allowed object size"
+            ),
+            MultipartError::EntityTooLarge => {
+                write!(f, "the proposed upload exceeds the maximum allowed size")
+            }
+            MultipartError::InvalidArgument(what) => write!(f, "invalid argument: {what}"),
+            MultipartError::NoSuchBucket => write!(f, "the specified bucket does not exist"),
+            MultipartError::PublishContended => write!(
+                f,
+                "the upload could not be published because of concurrent writes to the target \
+                 key; retry"
+            ),
+        }
+    }
+}
