+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    /// The knob values this slice owns each sit inside the range 0016 settles.
+    ///
+    /// `const` blocks, so a knob moved outside its range is a **compile** error rather than a
+    /// test failure: a value outside a settled range can break an invariant, and the check
+    /// should not depend on anyone running the tests.
+    #[test]
+    fn knobs_are_inside_their_settled_ranges() {
+        const _: () = assert!(
+            MAX_MAP_CHUNKS > 0 && MAX_CHUNKREF_BYTES * MAX_MAP_CHUNKS <= VALUE_CEILING_BYTES / 2
+        );
+        const _: () = assert!(
+            MAX_PART_CHUNKS <= B_OPS,
+            "X110: an unsplittable part commit deletes up to MAX_PART_CHUNKS `sidx:` entries, \
+             so a value above the operation budget would time out permanently"
+        );
+        const _: () = assert!(MAX_SEGREF_BYTES * MAX_ROOT_SEGMENTS <= VALUE_CEILING_BYTES / 2);
+        const _: () = assert!(MAX_STAGED_CHUNKS >= MAX_PART_CHUNKS);
+        const _: () = assert!(MAX_INFLIGHT_PARTS as u64 <= MAX_PARTS_PER_SESSION as u64);
+        const _: () = assert!(MAX_INFLIGHT_PARTS as usize <= B_OPS);
+        const _: () = assert!((MAX_INFLIGHT_PARTS as usize) <= SCAN_CAP / (2 * MAX_PART_CHUNKS));
+        assert!(max_sessions() > 0 && max_sessions() <= (SCAN_CAP / 2) as u64);
+    }
+
+    /// The chunk-reference byte budget is **measured against the type**, not estimated.
+    ///
+    /// Every ceiling in this module divides `V/2` by [`chunkref_bytes`], so an under-counted
+    /// base silently makes the flat-map, segment and part ceilings unsound — a full record
+    /// would exceed the value the backend accepts and the object would be permanently
+    /// unpublishable. This encodes the worst case (a `u128` id at maximum width, the widest
+    /// scheme tag, a `u64` length, and `u64::MAX` D-server ids) and asserts the budget covers
+    /// it, so a change to `ChunkRef`'s shape reds here rather than in production.
+    #[test]
+    fn the_chunkref_byte_budget_covers_the_worst_case_encoding() {
+        let worst = ChunkRef {
+            id: u128::MAX,
+            scheme: crate::metadata::EcScheme::ReedSolomon { k: 255, m: 255 },
+            len: u64::MAX,
+            placement: vec![u64::MAX; MAX_FRAGMENTS_PER_CHUNK as usize],
+        };
+        let encoded = encode(&worst).len();
+        assert!(
+            encoded <= MAX_CHUNKREF_BYTES,
+            "a worst-case ChunkRef encodes to {encoded} B, above the {MAX_CHUNKREF_BYTES} B \
+             budget every map/segment/part ceiling is derived from"
+        );
+        // And the base half of the derivation, on its own: an empty placement vector.
+        let base = encode(&ChunkRef {
+            placement: Vec::new(),
+            ..worst
+        })
+        .len();
+        assert!(
+            base <= CHUNKREF_BASE_BYTES,
+            "the placement-free base encodes to {base} B, above the {CHUNKREF_BASE_BYTES} B \
+             `chunkref_bytes` charges"
+        );
+        // A wider scheme than the derivation assumes is admitted only while a FULL record still
+        // fits the value ceiling, and refused past it — never silently unpublishable.
+        check_durability_config(MAX_FRAGMENTS_PER_CHUNK).expect("the deployed scheme is legal");
+        assert!(check_durability_config(u16::MAX).is_err());
+    }
+
+    /// The same measurement for the segment table's [`SegmentRef`], whose budget bounds
+    /// `MAX_ROOT_SEGMENTS`.
+    #[test]
+    fn the_segref_byte_budget_covers_the_worst_case_encoding() {
+        let worst = SegmentRef {
+            index: u32::MAX,
+            byte_offset: u64::MAX,
+            byte_len: u64::MAX,
+        };
+        let encoded = encode(&worst).len();
+        assert!(
+            encoded <= MAX_SEGREF_BYTES,
+            "a worst-case SegmentRef encodes to {encoded} B, above the {MAX_SEGREF_BYTES} B \
+             budget MAX_ROOT_SEGMENTS is derived from"
+        );
+    }
+
+    /// The lengthless sizing rule is satisfiable at this build's `chunk_size_max`.
+    #[test]
+    fn chunk_size_max_satisfies_the_lengthless_precondition() {
+        check_chunk_size_config(CHUNK_SIZE_MAX).expect("deployed chunk_size_max must be legal");
+        assert!(check_chunk_size_config(DEFAULT_CHUNK_SIZE).is_err());
+    }
+
+    /// A declared-length PUT picks a chunk size that keeps the map inside `MAX_MAP_CHUNKS`.
+    #[test]
+    fn declared_length_put_stays_flat() {
+        let size = 512 * 1024 * 1024;
+        let chosen = chunk_size_for_put(size, DEFAULT_CHUNK_SIZE, CHUNK_SIZE_MAX).unwrap();
+        assert!(size.div_ceil(chosen as u64) as usize <= MAX_MAP_CHUNKS);
+        // A small object keeps the default.
+        assert_eq!(
+            chunk_size_for_put(1024, DEFAULT_CHUNK_SIZE, CHUNK_SIZE_MAX).unwrap(),
+            DEFAULT_CHUNK_SIZE
+        );
+        // Past `chunk_size_max` it is refused, never silently segmented.
+        assert_eq!(
+            chunk_size_for_put(
+                (CHUNK_SIZE_MAX as u64) * (MAX_MAP_CHUNKS as u64) + 1,
+                DEFAULT_CHUNK_SIZE,
+                CHUNK_SIZE_MAX
+            ),
+            Err(MultipartError::EntityTooLarge)
+        );
+    }
+
+    /// The ETag is a pure function of the digests and their order, and changes with either.
+    #[test]
+    fn multipart_etag_is_order_sensitive_and_pure() {
+        let a = "00".repeat(32);
+        let b = "ff".repeat(32);
+        let one = multipart_etag(&[a.clone(), b.clone()]).expect("well-formed digests");
+        assert_eq!(
+            one,
+            multipart_etag(&[a.clone(), b.clone()]).expect("well-formed digests")
+        );
+        assert_ne!(
+            one,
+            multipart_etag(&[b.clone(), a.clone()]).expect("well-formed digests")
+        );
+        assert!(one.ends_with("-2"));
+        // A digest that is not 32 lowercase-hex bytes fails CLOSED rather than composing an
+        // ETag over a silently-shortened value — two different corrupt digests could otherwise
+        // yield the same published change-token.
+        assert!(multipart_etag(&["nothex".to_string()]).is_err());
+        assert!(multipart_etag(&[a[..62].to_string()]).is_err());
+        // **Uppercase hex is not the record contract** (ADR-0047: lowercase hex). Accepting it
+        // would make `…AB` and `…ab` — two textually distinct stored digests, one of them
+        // malformed — compose the SAME published ETag, so a corrupt record would be indis-
+        // tinguishable from a valid one at the change-token the client caches on.
+        assert!(
+            multipart_etag(&["AB".repeat(32)]).is_err(),
+            "an uppercase digest is malformed by the record contract and must fail closed"
+        );
+    }
+
+    /// Range encoding round-trips, and a contiguous run collapses to one range.
+    #[test]
+    fn part_ranges_round_trip() {
+        let set = vec![1, 2, 3, 7, 8, 12];
+        let encoded = encode_part_ranges(&set);
+        assert_eq!(encoded, vec![(1, 3), (7, 8), (12, 12)]);
+        assert_eq!(expand_part_ranges(&encoded), set);
+    }
+
+    /// A legacy bare-decimal `orphan:` value decodes, and re-encodes as the same legacy
+    /// value until an event replaces it.
+    #[test]
+    fn legacy_orphan_marks_decode_and_take_the_replace_arm() {
+        let legacy = Bytes::from_static(b"1700000000000");
+        let mark = decode_orphan_mark(&legacy).expect("legacy mark decodes");
+        assert_eq!(mark.orphaned_at_millis, 1_700_000_000_000);
+        assert_eq!(mark.event, None);
+        // Different identity ⇒ replaced under an exact-value require, not require_absent.
+        let batch = guard_orphan_mark(
+            WriteBatch::new(),
+            b"orphan:1:2:0".to_vec(),
+            Some(&legacy),
+            "s:u:1",
+            5,
+        );
+        assert_eq!(batch.preconditions.len(), 1);
+        assert_eq!(batch.preconditions[0].expected, Some(legacy));
+        // Same identity ⇒ skipped entirely, original stamp intact.
+        let structured = encode_orphan_mark(&OrphanMark {
+            orphaned_at_millis: 1,
+            event: Some("s:u:1".into()),
+        });
+        let batch = guard_orphan_mark(
+            WriteBatch::new(),
+            b"orphan:1:2:0".to_vec(),
+            Some(&structured),
+            "s:u:1",
+            5,
+        );
+        assert!(batch.puts.is_empty() && batch.preconditions.is_empty());
+    }
+
+    /// A map above `MAX_MAP_CHUNKS` segments; one at or below it stays flat.
+    #[test]
+    fn segmentation_triggers_only_above_the_flat_ceiling() {
+        let chunk = ChunkRef {
+            id: 1,
+            scheme: crate::metadata::EcScheme::None,
+            len: 4,
+            placement: vec![0],
+        };
+        assert!(plan_segments(&vec![chunk.clone(); MAX_MAP_CHUNKS]).is_none());
+        let segments = plan_segments(&vec![chunk; MAX_MAP_CHUNKS + 1]).expect("segments");
+        assert_eq!(segments.len(), 2);
+        assert!(segments.len() <= MAX_ROOT_SEGMENTS);
+        assert_eq!(segments[0].byte_offset, 0);
+        assert_eq!(segments[1].byte_offset, segments[0].byte_len);
+    }
+}
