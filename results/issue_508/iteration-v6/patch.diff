+    /// Abandon a part attempt: compensate for whatever it staged, then map `err` onto the
+    /// neutral seam fault. The single exit every post-staging refusal and fault takes, so
+    /// "evidence precedes the lifting of protection" cannot be forgotten on one arm.
+    async fn abandon(
+        &self,
+        attempt: &Abandonment<'_>,
+        err: wyrd_traits::BoxError,
+    ) -> wyrd_traits::BoxError {
+        self.compensate(attempt).await;
+        fault(err)
+    }
+}
+
+/// A fenced session record plus the **exact bytes** every fenced CAS preconditions on, carried
+/// by reference through the publication so each batch that rewrites the record advances both
+/// halves together. Splitting them is how a fence release ends up CASing against bytes the
+/// store no longer holds.
+struct FencedSession {
+    record: mp::SessionRecord,
+    bytes: Bytes,
+}
+
+/// Everything a compensation needs about one part attempt, gathered once so every exit
+/// compensates with the *same* — and correct — slot bytes and staged set.
+struct Abandonment<'a> {
+    upload_id: &'a str,
+    session_bytes: &'a Bytes,
+    epoch: u64,
+    slot_index: u32,
+    /// The slot record's **current** bytes (advanced by every lease renewal the stream made),
+    /// which is what the compensation's keyed CAS must precondition on.
+    slot_bytes: &'a Bytes,
+    part_number: u32,
+    attempt_id: &'a str,
+    staged: &'a [(ChunkId, Vec<u64>)],
+}
+
+impl<M, C, Co> MultipartGateway for Gateway<M, C, Co>
+where
+    M: MetadataStore + Send + Sync + 'static,
+    C: PlacementChunkStore + Send + Sync + 'static,
+    Co: Coordination + Send + Sync + 'static,
+{
+    /// **CreateMultipartUpload** — the admission reservation plus the session and
+    /// segment-group records, in one batch.
+    async fn create_multipart_upload(
+        &self,
+        container: &str,
+        key: &str,
+        content_type: Option<String>,
+    ) -> Result<String> {
+        self.require_container(container).await.map_err(fault)?;
+        let mut last: Option<wyrd_traits::BoxError> = None;
+        for _ in 0..MINT_ATTEMPTS {
+            let upload_id = self.mint_token();
+            let group_nonce = self.mint_token();
+            let session = mp::SessionRecord {
+                bucket: container.to_string(),
+                key: key.to_string(),
+                content_type: content_type.clone(),
+                created_at_millis: now_millis(),
+                clock_source: CLOCK_SOURCE.to_string(),
+                state: mp::SessionState::Open,
+                epoch: 0,
+                attempts: 0,
+                group_nonce,
+                fenced_at_millis: None,
+                segments_written: None,
+                publish_target: None,
+                published: None,
+                admission_released: None,
+                complete_fingerprint: None,
+            };
+            match mp::create_session(&*self.meta, &upload_id, &session).await {
+                Ok(CommitOutcome::Committed) => {
+                    // Multipart depends on a running custodian reaper for every window-driven
+                    // exit (#625). A deployment exposing this verb without one is
+                    // misconfigured by construction, so the state is made operator-visible
+                    // rather than silent.
+                    self.warn_if_reaper_absent();
+                    return Ok(upload_id);
+                }
+                // `require_absent(mpu:<id>)` / `require_absent(seggrp:<nonce>)` turned a
+                // collision into a Conflict rather than a shared session or an overwritten
+                // segment group; mint again.
+                Ok(CommitOutcome::Conflict) => continue,
+                Err(err) => {
+                    // **An indeterminate create is settled by a re-read before anything is
+                    // retried.** Minting a fresh id and trying again after a
+                    // `CommitUnknownResult` can leave the FIRST session committed — holding an
+                    // admission slot, a `seggrp:` reservation and an `mpu:` record — with an id
+                    // the client is never told, so it is unreachable by Abort and only the reaper
+                    // can ever clear it. The session record names its own bucket/key, so a
+                    // re-read tells "mine, it landed" from "not there".
+                    match mp::read_session(&*self.meta, &upload_id).await {
+                        Ok(Some((found, _))) if found.bucket == container && found.key == key => {
+                            self.warn_if_reaper_absent();
+                            return Ok(upload_id);
+                        }
+                        // Provably absent: nothing landed, so a fresh mint is safe.
+                        Ok(_) => last = Some(err),
+                        // The re-read itself failed: refuse rather than mint a second session
+                        // whose predecessor's fate is unknown.
+                        Err(read_err) => return Err(fault(read_err)),
+                    }
+                }
+            }
+        }
+        Err(fault(
+            last.unwrap_or_else(|| MultipartError::SlowDown.into()),
+        ))
+    }
+
+    /// **UploadPart** — reserve a slot, stage the body under the session fence, then hand
+    /// the bytes from their owned staging entries to a `part:` record in one batch.
+    ///
+    /// Every exit **after** the first chunk is staged compensates — a lost fence, a refusal, a
+    /// metadata fault, a digest that does not match what the client signed. A path that merely
+    /// returned would strand that attempt's bytes, its `sidx:` records **and its slot** in a
+    /// still-`Open` session, and a client repeating the refusal would fill every slot and turn
+    /// a usable session into a permanent `SlowDown`.
+    async fn upload_part<S>(
+        &self,
+        container: &str,
+        key: &str,
+        upload_id: &str,
+        part_number: u32,
+        expected: ContentHash,
+        source: S,
+    ) -> Result<String>
+    where
+        S: Stream<Item = Result<Bytes>> + Send + Unpin + 'static,
+    {
+        if part_number == 0 || part_number > mp::MAX_PARTS_PER_SESSION {
+            return Err(fault(
+                MultipartError::InvalidArgument(format!(
+                    "part number {part_number} is outside 1..={}",
+                    mp::MAX_PARTS_PER_SESSION
+                ))
+                .into(),
+            ));
+        }
+        let (session, session_bytes) = self
+            .session_for(container, key, upload_id)
+            .await
+            .map_err(fault)?;
+        // The verb × state table: `UploadPart` is accepted only while `Open`; every other
+        // state — including the tombstone — answers "no such upload". A part accepted after
+        // the Complete fence would be invisible to the publication that already read the
+        // set: a silently lost part.
+        if !session.is_open() {
+            return Err(fault(MultipartError::NoSuchUpload.into()));
+        }
+        let attempt_id = self.mint_token();
+        let now = now_millis();
+        let slot = mp::SlotRecord {
+            part_number,
+            attempt_id: attempt_id.clone(),
+            reserved_at_millis: now,
+            lease_expiry_millis: now + self.lease_ttl_millis,
+        };
+        let Some(slot_index) = mp::reserve_slot(&*self.meta, upload_id, &session_bytes, &slot)
+            .await
+            .map_err(fault)?
+        else {
+            // Every index is taken. `503 SlowDown` is a normal, expected S3 answer, and it
+            // is what stops one client leaving unbounded half-finished debris behind.
+            return Err(fault(MultipartError::SlowDown.into()));
+        };
+        let slot_bytes = metadata::encode(&slot);
+
+        let mut hashing = HashingSource {
+            inner: source,
+            hasher: Sha256::new(),
+        };
+        let fence = write::StagingFence {
+            upload_id: upload_id.to_string(),
+            part_number,
+            slot_index,
+            session_bytes: session_bytes.clone(),
+        };
+        // `stream_staged_data` never throws its partial progress away: it returns the staged
+        // set and the slot bytes it advanced on EVERY path, which is exactly what a
+        // compensation must name and precondition on.
+        let write::StagedPart {
+            plan,
+            slot_bytes: advanced_slot_bytes,
+            staged: staged_chunks,
+            outcome,
+        } = write::stream_staged_data(
+            &*self.meta,
+            &self.chunks,
+            &mut hashing,
+            self.chunk_size,
+            self.durability,
+            now_millis,
+            self.lease_ttl_millis,
+            || self.mint_chunk_id(),
+            &fence,
+            &slot,
+            slot_bytes.clone(),
+            mp::MAX_PART_CHUNKS,
+        )
+        .await;
+
+        // --- From here on EVERY exit compensates against the ADVANCED slot bytes -----------
+        //
+        // The *advanced* slot bytes, not the pre-stream `slot_bytes`: each staging batch rewrites
+        // the slot record in the same commit as the lease it renews, so a compensation
+        // preconditioned on the bytes reserved *before* the stream would lose its CAS the
+        // moment any chunk landed — leaving the slot and the owned entries stranded.
+        let attempt = Abandonment {
+            upload_id,
+            session_bytes: &session_bytes,
+            epoch: session.epoch,
+            slot_index,
+            slot_bytes: &advanced_slot_bytes,
+            part_number,
+            attempt_id: &attempt_id,
+            staged: &staged_chunks,
+        };
+        match outcome {
+            write::StagingOutcome::Complete => {}
+            // The ceiling stopped the stream at `MAX_PART_CHUNKS`, so the refusal is surfaced
+            // rather than hit at the backend as an over-`V` `part:` commit.
+            write::StagingOutcome::OverLimit => {
+                return Err(self
+                    .abandon(&attempt, MultipartError::EntityTooLarge.into())
+                    .await)
+            }
+            // A fence loss or a store/fragment fault mid-stream.
+            //
+            // **Only a client-attributable cause becomes a 4xx.** A lost fence is the client's
+            // answer (`404 NoSuchUpload` — its upload is gone) and a body-stream error is the
+            // client's too, but a metadata-store fault, an encoding failure or a D-server write
+            // that would not land are *server* faults: reporting them as `400 InvalidArgument`
+            // told the client its request was invalid and invited it to stop retrying a request
+            // that a retry would have completed, and it buried real gateway faults in the
+            // client-error bucket the access log separates for exactly this reason. The error is
+            // therefore passed through unwrapped, so `classify` maps it (a `CommitUnknownResult`
+            // keeps its own arm) — after compensating, which every post-staging exit must do.
+            write::StagingOutcome::Failed(err) => {
+                let mapped: wyrd_traits::BoxError = match err.downcast_ref::<write::WriteError>() {
+                    Some(write::WriteError::StagingFenced { .. }) => {
+                        MultipartError::NoSuchUpload.into()
+                    }
+                    // The part's body needed more chunks than a `part:` record may hold.
+                    Some(write::WriteError::MapCeiling { .. }) => {
+                        MultipartError::EntityTooLarge.into()
+                    }
+                    // Everything else keeps its own type and its own classification.
+                    _ => err,
+                };
+                return Err(self.abandon(&attempt, mapped).await);
+            }
+        }
+        let digest = crate::hex(&hashing.hasher.finalize());
+        // **The signed payload digest is checked before the part can be named.** The client
+        // authenticated *these* bytes; a body that hashes to something else is not the payload
+        // the signature covers, and accepting it would let authenticated metadata for one
+        // payload authorize different bytes into the assembly.
+        if let ContentHash::Expected(claimed) = &expected {
+            if !crate::constant_time_eq(claimed.as_bytes(), digest.as_bytes()) {
+                return Err(self
+                    .abandon(&attempt, GatewayError::PayloadMismatch.into())
+                    .await);
+            }
+        }
+        let chunk_refs = plan.chunk_refs();
+
+        // The cumulative staged-chunk check, read over the bounded `psum:` range of
+        // SUMMARIES (never the fat chunk lists). Concurrent commits can race it, and that
+        // race is bounded: at most `MAX_INFLIGHT_PARTS` commits are in flight, each adding
+        // at most `MAX_PART_CHUNKS`, so the true staged total never exceeds
+        // `MAX_STAGED_CHUNKS + MAX_INFLIGHT_PARTS × MAX_PART_CHUNKS` — the headroom `U_ref`
+        // charges.
+        let summaries = match mp::list_part_summaries(&*self.meta, upload_id).await {
+            Ok(summaries) => summaries,
+            // A metadata fault after staging is still a post-staging exit: it compensates.
+            Err(err) => return Err(self.abandon(&attempt, err).await),
+        };
+        let existing: u64 = summaries
+            .iter()
+            .filter(|(n, _)| *n != part_number)
+            .map(|(_, s)| s.chunks)
+            .sum();
+        if existing + chunk_refs.len() as u64 > mp::MAX_STAGED_CHUNKS as u64 {
+            return Err(self
+                .abandon(&attempt, MultipartError::EntityTooLarge.into())
+                .await);
+        }
+
+        let record = mp::PartRecord {
+            chunks: chunk_refs,
+            len: plan.size,
+            digest: digest.clone(),
+            committed_at_millis: now_millis(),
+            session_epoch: session.epoch,
+        };
+        let prior = match self.meta.get(&mp::part_key(upload_id, part_number)).await {
+            Ok(prior) => prior,
+            Err(err) => return Err(self.abandon(&attempt, err).await),
+        };
+        let prior_decoded = match &prior {
+            Some(bytes) => match metadata::decode::<mp::PartRecord>(bytes) {
+                Ok(record) => Some((record, bytes.clone())),
+                Err(err) => return Err(self.abandon(&attempt, err).await),
+            },
+            None => None,
+        };
+        let batch = mp::commit_part_batch(
+            upload_id,
+            &session_bytes,
+            session.epoch,
+            slot_index,
+            &advanced_slot_bytes,
+            part_number,
+            &attempt_id,
+            &record,
+            prior_decoded.as_ref().map(|(r, b)| (r, b.clone())),
+            &staged_chunks.iter().map(|(id, _)| *id).collect::<Vec<_>>(),
+        );
+        let outcome = match self.meta.commit(batch).await {
+            Ok(outcome) => outcome,
+            Err(err) => return Err(self.abandon(&attempt, err).await),
+        };
+        match outcome {
+            CommitOutcome::Committed => {
+                // A re-upload installed a `retire:bytes:{chunks}` obligation for the superseded
+                // attempt. Drain **that obligation**, by key, and only when there was one:
+                // running the whole-namespace drain here coupled every `UploadPart`'s latency to
+                // the store's *global* retirement backlog — up to `INLINE_DRAIN_PASSES` passes
+                // over the deliberately unbounded `retire:` namespace, on the request path, for a
+                // part that installed nothing. The obligation names exactly this attempt's
+                // superseded chunks, so a targeted drain is O(that part) and independent of every
+                // other upload in the store; whatever it cannot finish stays durable for the
+                // off-request drain and the reaper.
+                if prior_decoded.is_some() {
+                    let token =
+                        mp::part_attempt_token(upload_id, session.epoch, part_number, &attempt_id);
+                    if let Err(err) = mp::drain_one(
+                        &*self.meta,
+                        &mp::retire_bytes_key(&token),
+                        now_millis(),
+                        INLINE_DRAIN_PASSES,
+                    )
+                    .await
+                    {
+                        tracing::warn!(
+                            error = %err,
+                            upload_id,
+                            part_number,
+                            "a re-uploaded part's superseded chunks did not finish draining; the \
+                             obligation is durable and the next drain re-derives the remainder"
+                        );
+                    }
+                }
+                Ok(digest)
+            }
+            CommitOutcome::Conflict => Err(self
+                .abandon(&attempt, MultipartError::NoSuchUpload.into())
+                .await),
+        }
+    }
+
+    /// **CompleteMultipartUpload** — fence, validate, (segment,) flip.
+    async fn complete_multipart_upload(
+        &self,
+        container: &str,
+        key: &str,
+        upload_id: &str,
+        named: &[NamedPart],
+    ) -> Result<String> {
+        let (session, session_bytes) = self
+            .session_for(container, key, upload_id)
+            .await
+            .map_err(fault)?;
+        match session.state {
+            // The tombstone answers a RETRY, not any request. Idempotence is keyed on
+            // request identity, never on the upload id alone: a client that reused the id
+            // with a different part list would otherwise be told ITS assembly succeeded
+            // while the stored object holds the earlier one — a silent wrong answer, worse
+            // than any error.
+            mp::SessionState::Completed => {
+                let incoming = mp::complete_fingerprint(
+                    &named
+                        .iter()
+                        .map(|p| (p.part_number, p.etag.clone()))
+                        .collect::<Vec<_>>(),
+                );
+                let matches = session.complete_fingerprint.as_deref() == Some(incoming.as_str());
+                return match (matches, &session.published) {
+                    (true, Some(published)) => Ok(published.etag.clone()),
+                    _ => Err(fault(MultipartError::NoSuchUpload.into())),
+                };
+            }
+            // There is NO client path that resumes a `Completing` session — the only resume
+            // is the owning gateway recovering its own unknown result at the same epoch.
+            // This guarantees at most one publisher at a time.
+            mp::SessionState::Completing => {
+                return Err(fault(MultipartError::OperationAborted.into()))
+            }
+            mp::SessionState::Aborting => return Err(fault(MultipartError::NoSuchUpload.into())),
+            mp::SessionState::Open => {}
+        }
+        if session.attempts >= mp::MAX_COMPLETE_ATTEMPTS {
+            // At the cap the fence is refused and the session's only exit is Abort, so a
+            // rollback→re-Complete cycle cannot mint `seg:` epochs or obligations without
+            // bound.
+            return Err(fault(MultipartError::OperationAborted.into()));
+        }
+        self.require_container(container).await.map_err(fault)?;
+
+        let name = Self::object_name(container, key);
+        let (fence_batch, fenced) = mp::fence_complete_batch(
+            upload_id,
+            &session,
+            &session_bytes,
+            mp::PublishTarget {
+                parent: ROOT,
+                name: name.clone(),
+                epoch: session.epoch + 1,
+            },
+            now_millis(),
+        );
+        if self.meta.commit(fence_batch).await? != CommitOutcome::Committed {
+            // Two concurrent Completes: exactly one fences, the other is a conflict.
+            return Err(fault(MultipartError::OperationAborted.into()));
+        }
+        // The fenced session record advances as the publication writes segments (each segment
+        // batch rewrites `segments_written` inside the record it preconditions on), so the
+        // release below must CAS against the **current** bytes. Releasing against the original
+        // fenced bytes would lose that CAS after any segment batch and leave the upload stuck
+        // in `Completing` with dangling segments until the reaper's `W_completing`.
+        let mut fenced = FencedSession {
+            bytes: metadata::encode(&fenced),
+            record: fenced,
+        };
+        let outcome = self
+            .publish_fenced(upload_id, &mut fenced, &name, named)
+            .await;
+        match outcome {
+            Ok(etag) => {
+                self.drain_off_request_path();
+                Ok(etag)
+            }
+            Err(err) => {
+                // A rejected request may never leave the session fenced: that would make a
+                // client typo indistinguishable from a crashed completer and wedge the
+                // upload until the reaper's `W_completing`. The release also installs
+                // `retire:records:{seg:<g>:<E>}` for any segments this attempt wrote, so a
+                // rolled-back attempt's segment records have a deleter (`0016:2371-2381`).
+                let (release, _) =
+                    mp::release_fence_batch(upload_id, &fenced.record, &fenced.bytes);
+                let _ = self.meta.commit(release).await;
+                self.drain_off_request_path();
+                Err(fault(err))
+            }
+        }
+    }
+
+    /// **AbortMultipartUpload** — the fence commit *is* the response.
+    async fn abort_multipart_upload(
+        &self,
+        container: &str,
+        key: &str,
+        upload_id: &str,
+    ) -> Result<()> {
+        let (session, session_bytes) = self
+            .session_for(container, key, upload_id)
+            .await
+            .map_err(fault)?;
+        match session.state {
+            // Idempotent: a second Abort of a session already tearing down succeeds.
+            mp::SessionState::Aborting => {
+                self.drain_off_request_path();
+                return Ok(());
+            }
+            mp::SessionState::Completing => {
+                return Err(fault(MultipartError::OperationAborted.into()))
+            }
+            mp::SessionState::Completed => return Err(fault(MultipartError::NoSuchUpload.into())),
+            mp::SessionState::Open => {}
+        }
+        let (batch, _) = mp::abort_fence_batch(upload_id, &session, &session_bytes);
+        if self.meta.commit(batch).await? != CommitOutcome::Committed {
+            return Err(fault(MultipartError::OperationAborted.into()));
+        }
+        // Byte reclamation is the drain's, asynchronously and in bounded batches: teardown
+        // of a 10,000-part session never rides inside one request. The drain below is the
+        // gateway's best-effort half; #625 is the crash-safe backstop.
+        self.drain_off_request_path();
+        Ok(())
+    }
+
+    /// **ListParts** — the staged part set, with genuinely computed truncation.
+    async fn list_parts(
+        &self,
+        container: &str,
+        key: &str,
+        upload_id: &str,
+        after: Option<u32>,
+        max: usize,
+    ) -> Result<PartListing> {
+        let (session, _) = self
+            .session_for(container, key, upload_id)
+            .await
+            .map_err(fault)?;
+        match session.state {
+            // `Open` lists the part set; `Completing` lists the FROZEN part set.
+            mp::SessionState::Open | mp::SessionState::Completing => {}
+            _ => return Err(fault(MultipartError::NoSuchUpload.into())),
+        }
+        let summaries = mp::list_part_summaries(&*self.meta, upload_id)
+            .await
+            .map_err(fault)?;
+        let remaining: Vec<(u32, mp::PartSummary)> = summaries
+            .into_iter()
+            .filter(|(n, _)| after.map(|marker| *n > marker).unwrap_or(true))
+            .collect();
+        let max = max.max(1);
+        let truncated = remaining.len() > max;
+        let page: Vec<StagedPart> = remaining
+            .into_iter()
+            .take(max)
+            .map(|(part_number, summary)| StagedPart {
+                part_number,
+                etag: summary.digest,
+                size: summary.len,
+                modified: Some(summary.committed_at_millis),
+            })
+            .collect();
+        let next_marker = if truncated {
+            page.last().map(|p| p.part_number)
+        } else {
+            None
+        };
+        Ok(PartListing {
+            parts: page,
+            next_marker,
+        })
+    }
+
+    /// **ListMultipartUploads** — sessions still accepting or publishing work. A cancelled
+    /// or completed session is not listed: `Aborting` and `Completed` are terminal to a
+    /// client.
+    async fn list_multipart_uploads(
+        &self,
+        container: &str,
+        prefix: Option<&str>,
+    ) -> Result<Vec<OpenUpload>> {
+        self.require_container(container).await.map_err(fault)?;
+        let mut out = Vec::new();
+        for (upload_id, session) in mp::list_sessions(&*self.meta).await.map_err(fault)? {
+            if session.bucket != container {
+                continue;
+            }
+            if !matches!(
+                session.state,
+                mp::SessionState::Open | mp::SessionState::Completing
+            ) {
+                continue;
+            }
+            if let Some(prefix) = prefix {
+                if !session.key.starts_with(prefix) {
+                    continue;
+                }
+            }
+            out.push(OpenUpload {
+                key: session.key,
+                upload_id,
+                initiated: Some(session.created_at_millis),
+            });
+        }
+        out.sort_by(|a, b| (a.key.as_str(), a.upload_id.as_str()).cmp(&(&b.key, &b.upload_id)));
+        Ok(out)
+    }
+}
+
+impl<M, C, Co> Gateway<M, C, Co>
+where
+    M: MetadataStore + Send + Sync + 'static,
+    C: PlacementChunkStore + Send + Sync + 'static,
+    Co: Coordination + Send + Sync + 'static,
+{
+    /// Everything a Complete does **after** its fence lands: read the frozen part set,
+    /// validate the client's named list against it, write any segments, and flip the root.
+    ///
+    /// `fenced` is the fenced session record **and its exact bytes**, advanced in place as the
+    /// segment-write phase rewrites it, so the caller's fence release CASes against what the
+    /// store actually holds.
+    ///
+    /// Every early return here is an error the caller turns into a fence release, so the
+    /// session goes back to `Open` and stays abortable and retriable.
+    async fn publish_fenced(
+        &self,
+        upload_id: &str,
+        fenced: &mut FencedSession,
+        name: &str,
+        named: &[NamedPart],
+    ) -> Result<String> {
+        if named.is_empty() {
+            return Err(MultipartError::InvalidPart.into());
+        }
+        // The part set is frozen by the fence, so this read is authoritative: no `part:`
+        // record can be created, replaced or deleted while `Completing@E` stands.
+        let staged = mp::list_part_records(&*self.meta, upload_id).await?;
+        let by_number: std::collections::BTreeMap<u32, mp::PartRecord> =
+            staged.into_iter().collect();
+
+        let mut last_number = 0u32;
+        for part in named {
+            if part.part_number <= last_number {
+                return Err(MultipartError::InvalidPartOrder.into());
+            }
+            last_number = part.part_number;
+        }
+        let mut chunks: Vec<metadata::ChunkRef> = Vec::new();
+        let mut digests: Vec<String> = Vec::new();
+        let mut size = 0u64;
+        for (position, part) in named.iter().enumerate() {
+            let Some(record) = by_number.get(&part.part_number) else {
+                return Err(MultipartError::InvalidPart.into());
+            };
+            if record.digest != part.etag.trim_matches('"') {
+                return Err(MultipartError::InvalidPart.into());
+            }
+            // Every part but the last must be at least S3's minimum, so a client cannot
+            // assemble an object out of thousands of tiny parts.
+            if position + 1 < named.len() && record.len < mp::MIN_PART_BYTES {
+                return Err(MultipartError::EntityTooSmall.into());
+            }
+            chunks.extend(record.chunks.iter().cloned());
+            digests.push(record.digest.clone());
+            size += record.len;
+        }
+        let etag = mp::multipart_etag(&digests)?;
+        let fingerprint = mp::complete_fingerprint(
+            &named
+                .iter()
+                .map(|p| (p.part_number, p.etag.trim_matches('"').to_string()))
+                .collect::<Vec<_>>(),
+        );
+
+        // Decision 7: a map above the flat ceiling is published as a SEGMENTED root, its
+        // segments written first in byte-budgeted batches and the root flipped afterwards.
+        // The flip is then O(1) and cannot exceed the transaction envelope.
+        let map = match mp::plan_segments(&chunks) {
+            None => mp::PublishedMap::Flat(chunks.clone()),
+            Some(segments) => {
+                if segments.len() > mp::MAX_ROOT_SEGMENTS {
+                    return Err(MultipartError::EntityTooLarge.into());
+                }
+                let group = mp::SegmentGroup {
+                    nonce: fenced.record.group_nonce.clone(),
+                    epoch: fenced.record.epoch,
+                };
+                let mut from = 0usize;
+                while from < segments.len() {
+                    let (batch, next, end) = mp::segment_write_batch(
+                        upload_id,
+                        &fenced.record,
+                        &fenced.bytes,
+                        &group,
+                        &segments,
+                        from,
+                    );
+                    if self.meta.commit(batch).await? != CommitOutcome::Committed {
+                        return Err(MultipartError::OperationAborted.into());
+                    }
+                    // Advance the SHARED fenced state, not a local copy: the caller's fence
+                    // release preconditions on these bytes.
+                    fenced.bytes = metadata::encode(&next);
+                    fenced.record = next;
+                    from = end;
+                }
+                mp::PublishedMap::Segmented {
+                    group,
+                    segments: segments
+                        .iter()
+                        .enumerate()
+                        .map(|(index, record)| mp::SegmentRef {
+                            index: index as u32,
+                            byte_offset: record.byte_offset,
+                            byte_len: record.byte_len,
+                        })
+                        .collect(),
+                }
+            }
+        };
+
+        let published_parts: Vec<u32> = named.iter().map(|p| p.part_number).collect();
+        let unnamed_parts: Vec<u32> = by_number
+            .keys()
+            .copied()
+            .filter(|n| !published_parts.contains(n))
+            .collect();
+        let object_meta =
+            mp::published_object_meta(&etag, fenced.record.content_type.clone(), now_millis());
+
+        // The flip, retried within this ONE attempt (the fence stays at `Completing@E`, so
+        // a publish-CAS-loss retry reuses the same epoch's segments — no per-retry churn).
+        // Each retry re-resolves the dirent and recomputes the version from the RE-READ
+        // prior, so a retry against a prior a concurrent `PutObject` just advanced records
+        // the correct next version rather than a stale one.
+        for _ in 0..mp::R_PUBLISH {
+            let binding = self.resolve_flip_binding(name).await?;
+            let (batch, _) = mp::publish_batch(
+                upload_id,
+                &fenced.record,
+                &fenced.bytes,
+                ROOT,
+                name,
+                &binding,
+                &map,
+                size,
+                &object_meta,
+                &published_parts,
+                &unnamed_parts,
+                &fingerprint,
+                &etag,
+                now_millis(),
+            );
+            if self.meta.commit(batch).await? == CommitOutcome::Committed {
+                return Ok(etag);
+            }
+        }
+        // Exhausted: release the fence (the caller does it) and answer a retryable conflict.
+        // The session stays usable and the client may retry Complete without re-uploading a
+        // part — never a stranded session.
+        Err(MultipartError::PublishContended.into())
+    }
+
+    /// Re-resolve the target dirent for one flip attempt.
+    async fn resolve_flip_binding(&self, name: &str) -> Result<mp::FlipBinding> {
+        let dirent_key = metadata::dirent_key(ROOT, name);
+        let Some(dirent_bytes) = self.meta.get(&dirent_key).await? else {
+            let inode = crate::cli::alloc_inode(&*self.meta).await?;
+            return Ok(mp::FlipBinding::Fresh { inode });
+        };
+        let dirent: metadata::DirentRecord = metadata::decode(&dirent_bytes)?;
+        let inode_key = metadata::inode_key(dirent.inode);
+        let Some(inode_bytes) = self.meta.get(&inode_key).await? else {
+            // A dangling dirent: treat the key as free but keep the dirent CAS, so the flip
+            // fails closed rather than publishing over a binding that moved.
+            let inode = crate::cli::alloc_inode(&*self.meta).await?;
+            return Ok(mp::FlipBinding::Fresh { inode });
+        };
+        let prior: InodeRecord = metadata::decode(&inode_bytes)?;
+        Ok(mp::FlipBinding::Existing {
+            inode: dirent.inode,
+            dirent_bytes,
+            inode_bytes,
+            prior: Box::new(prior),
+        })
+    }
+
+    /// Read a published object's chunk map, resolving a segmented root through its bounded
+    /// per-object `seg:` range. The one entry point the read path and every maintenance
+    /// consumer share, so a segmented object is never mistaken for an empty one.
+    pub async fn resolved_chunk_map(
+        &self,
+        inode_id: metadata::InodeId,
+        inode: &InodeRecord,
+    ) -> Result<Option<Vec<metadata::ChunkRef>>> {
+        mp::resolve_chunk_map(&*self.meta, inode_id, inode).await
+    }
+}
+
+/// Resolve `key`'s committed inode **and** its full chunk map, flat or segmented — the
+/// shared resolve every read entry point funnels through (issue #508 decision 7e).
+pub async fn committed_map(
+    meta: &impl MetadataStore,
+    parent: metadata::InodeId,
+    key: &str,
+) -> Result<Option<(InodeRecord, Vec<metadata::ChunkRef>)>> {
+    let Some(inode_id) = read::resolve(meta, parent, key).await? else {
+        return Ok(None);
+    };
+    let Some(inode) = read::read_inode(meta, inode_id).await? else {
+        return Ok(None);
+    };
+    if inode.state != metadata::InodeState::Committed {
+        return Ok(None);
+    }
+    let Some(map) = mp::resolve_chunk_map(meta, inode_id, &inode).await? else {
+        // The generation was concurrently retired: the reader restarts against the current
+        // root, which for a GET means "no such object".
+        return Ok(None);
+    };
+    Ok(Some((inode, map)))
+}
+
+/// Hold an `Arc<Gateway>` so the S3 wire layer can name one value implementing all three
+/// seams. Purely a type alias for readability at the composition root.
+pub type SharedGateway<M, C, Co> = Arc<Gateway<M, C, Co>>;
