+// ---------------------------------------------------------------------------------------
+// Chunk-size selection for a single `PutObject` (decision 7's carve-out).
+// ---------------------------------------------------------------------------------------
+
+/// The chunk size a **single `PutObject`** of `content_length` bytes publishes at.
+///
+/// Segmentation is multipart-only — staged publication needs an upload id, a fenced
+/// `Completing@E` state and a fence epoch, none of which a single PUT has — so a single PUT
+/// stays **flat** and reaches large sizes by choosing a chunk size that fits its declared
+/// length inside [`MAX_MAP_CHUNKS`]:
+/// `chunk_size_effective = max(DEFAULT_CHUNK_SIZE, ⌈Content-Length / MAX_MAP_CHUNKS⌉)`.
+///
+/// `Err(EntityTooLarge)` when the object cannot fit even at [`CHUNK_SIZE_MAX`] — the client
+/// must use multipart. In the S3 range (`Content-Length ≤ 5 GiB`) a sane `chunk_size_max`
+/// always fits, so the refusal is a guard, not a routine path.
+pub fn chunk_size_for_put(
+    content_length: u64,
+    default_chunk_size: usize,
+    chunk_size_max: usize,
+) -> std::result::Result<usize, MultipartError> {
+    // **S3's own single-PUT maximum comes first.** A declared length above
+    // [`SINGLE_PUT_MAX_BYTES`] is refused whatever the configured ceilings allow: the protocol
+    // maximum is a contract with the client (a stock SDK switches to multipart above it), not a
+    // consequence of this deployment's flat-map arithmetic. Checking only the map ceiling
+    // accepted a 6 GiB single PUT on a generously-configured deployment and rejected the same
+    // request elsewhere.
+    if content_length > SINGLE_PUT_MAX_BYTES {
+        return Err(MultipartError::EntityTooLarge);
+    }
+    let needed = content_length.div_ceil(MAX_MAP_CHUNKS as u64);
+    let selected = (needed as usize).max(default_chunk_size);
+    if selected > chunk_size_max {
+        return Err(MultipartError::EntityTooLarge);
+    }
+    Ok(selected)
+}
+
+/// The chunk size a **lengthless** `aws-chunked` PUT publishes at.
+///
+/// A lengthless stream cannot evaluate the formula at all (`x-amz-decoded-content-length` is
+/// optional by design), so it uses the **size-independent** `⌈5 GiB / MAX_MAP_CHUNKS⌉` —
+/// which is exactly the configuration precondition [`check_chunk_size_config`] enforces at
+/// load, so this can never exceed `chunk_size_max` on a conforming deployment.
+pub fn chunk_size_for_lengthless(default_chunk_size: usize) -> usize {
+    let needed = SINGLE_PUT_MAX_BYTES.div_ceil(MAX_MAP_CHUNKS as u64) as usize;
+    needed.max(default_chunk_size)
+}
+
+/// The **configuration-load** precondition of decision 7: `chunk_size_max ≥ ⌈5 GiB /
+/// MAX_MAP_CHUNKS⌉`.
+///
+/// Checked at configuration load and refused at header time (never mid-stream) when a
+/// deployment does not meet it: a lengthless stream that discovered the shortfall halfway
+/// through would have already staged bytes it can never publish.
+pub fn check_chunk_size_config(chunk_size_max: usize) -> std::result::Result<(), MultipartError> {
+    let required = SINGLE_PUT_MAX_BYTES.div_ceil(MAX_MAP_CHUNKS as u64) as usize;
+    if chunk_size_max < required {
+        return Err(MultipartError::InvalidArgument(format!(
+            "chunk_size_max ({chunk_size_max}) is below the {required} bytes a lengthless \
+             aws-chunked PutObject needs to fit MAX_MAP_CHUNKS ({MAX_MAP_CHUNKS})"
+        )));
+    }
+    Ok(())
+}
+
+/// The **durability-scheme configuration precondition** (see [`chunkref_bytes`]): the map,
+/// segment and part ceilings are derived against [`MAX_FRAGMENTS_PER_CHUNK`] placements per
+/// chunk, so a **wider** configured scheme spends more bytes per chunk reference than the
+/// derivation assumed.
+///
+/// The refusal is drawn where it is a *correctness* boundary rather than where the headroom
+/// ends: a scheme whose full `MAX_MAP_CHUNKS`-chunk record would exceed the backend's **value
+/// ceiling** is refused, because such a deployment could publish objects until an inode value
+/// crossed the ceiling and the write became permanently, silently unpublishable. A scheme
+/// merely wider than the default spends part of 0016's 2× headroom and is admitted — refusing
+/// it would reject deployments the base tree runs today (RS(10,4), say) over a bound this slice
+/// introduced.
+///
+/// Checked at **configuration load**, beside [`check_chunk_size_config`], so the answer is a
+/// stated startup error rather than a mid-publication commit failure.
+pub fn check_durability_config(
+    fragments_per_chunk: u16,
+) -> std::result::Result<(), MultipartError> {
+    let widest = chunkref_bytes(fragments_per_chunk).saturating_mul(MAX_MAP_CHUNKS);
+    if widest > VALUE_CEILING_BYTES {
+        return Err(MultipartError::InvalidArgument(format!(
+            "the configured durability scheme places {fragments_per_chunk} fragments per chunk, \
+             so a full {MAX_MAP_CHUNKS}-chunk map/segment/part record encodes to {widest} bytes \
+             — past the {VALUE_CEILING_BYTES}-byte backend value ceiling, which would make such \
+             an object permanently unpublishable"
+        )));
+    }
+    Ok(())
+}
+
+/// Split an ordered chunk list into the segments a segmented publication writes, or `None`
+/// when the map fits flat.
+pub fn plan_segments(chunks: &[ChunkRef]) -> Option<Vec<SegmentRecord>> {
+    if chunks.len() <= MAX_MAP_CHUNKS {
+        return None;
+    }
+    let mut out = Vec::new();
+    let mut offset = 0u64;
+    for window in chunks.chunks(MAX_SEG_CHUNKS) {
+        let byte_len: u64 = window.iter().map(|c| c.len).sum();
+        out.push(SegmentRecord {
+            chunks: window.to_vec(),
+            byte_offset: offset,
+            byte_len,
+        });
+        offset += byte_len;
+    }
+    Some(out)
+}
+
+/// The published object metadata a Complete stamps (ADR-0047): the multipart ETag, the
+/// session's declared content type, and the Complete instant — publication time is the
+/// instant the object became atomically visible.
+pub fn published_object_meta(
+    etag: &str,
+    content_type: Option<String>,
+    now_millis: u64,
+) -> ObjectMeta {
+    ObjectMeta {
+        etag: Some(etag.to_string()),
+        content_type,
+        modified: Some(now_millis),
+    }
+}
