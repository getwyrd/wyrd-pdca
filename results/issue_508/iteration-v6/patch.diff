+//! The composition root's **assembled-write** driver — `Gateway`'s implementation of the
+//! [`MultipartGateway`] seam over the commit protocol of proposal 0016 (issue #508).
+//!
+//! `wyrd-core::multipart` owns the record model and the batches; this module owns the
+//! *sequencing*: which batch runs when, what it reads first, and what it compensates with
+//! when a fence moves under it. Nothing here names S3 — the verbs, status codes and XML are
+//! `wyrd-gateway-s3`'s.
+//!
+//! The one rule every path obeys: **evidence precedes the lifting of protection**. Every
+//! exit from a staged part — a commit, a refusal, a lost fence — either hands the bytes to a
+//! record that names them or installs a `retire:` obligation that will orphan-mark them.
+//! There is no path that merely returns.
+
+use std::sync::Arc;
+
+use bytes::Bytes;
+use futures_util::Stream;
+use sha2::{Digest, Sha256};
+use wyrd_core::metadata::{self, InodeRecord};
+use wyrd_core::multipart::{self as mp, MultipartError};
+use wyrd_core::{read, write};
+use wyrd_gateway_core::{
+    ContentHash, GatewayError, MultipartFault, MultipartGateway, NamedPart, OpenUpload,
+    PartListing, StagedPart,
+};
+use wyrd_traits::{
+    ChunkId, CommitOutcome, Coordination, MetadataStore, PlacementChunkStore, Result,
+};
+
+use crate::{now_millis, Gateway, ROOT};
+
+/// The clock this deployment stamps session timestamps with. Written into every session
+/// record so a reaper that does not recognise the source **skips** the session rather than
+/// judging it — declining to judge is the safe direction, and the operator verb (#633) is
+/// then that session's only exit.
+pub const CLOCK_SOURCE: &str = "deployment-wall-clock";
+
+/// How many passes the gateway's own inline drain runs after a fence. The crash-safe
+/// backstop for a drain that never finishes is **#625**, not this slice: this is the
+/// best-effort half, deliberately bounded so a teardown cannot ride inside a request.
+const INLINE_DRAIN_PASSES: usize = 8;
+
+/// How many upload ids to try before giving up on a collision. `require_absent(mpu:<id>)`
+/// turns the (2^-128) collision into a `Conflict` rather than a shared session, so this loop
+/// exists only so the answer is a retry rather than an error.
+const MINT_ATTEMPTS: usize = 4;
+
+/// Map the protocol's own error onto the neutral seam fault the wire layer downcasts.
+fn fault(err: wyrd_traits::BoxError) -> wyrd_traits::BoxError {
+    let Some(e) = err.downcast_ref::<MultipartError>() else {
+        return err;
+    };
+    let mapped = match e {
+        MultipartError::NoSuchUpload => MultipartFault::UnknownUpload,
+        MultipartError::OperationAborted => MultipartFault::UploadBusy,
+        MultipartError::SlowDown => MultipartFault::Overloaded,
+        MultipartError::InvalidPart => MultipartFault::PartMissingOrMismatched,
+        MultipartError::InvalidPartOrder => MultipartFault::PartsOutOfOrder,
+        MultipartError::EntityTooSmall => MultipartFault::PartTooSmall,
+        MultipartError::EntityTooLarge => MultipartFault::TooLarge,
+        MultipartError::InvalidArgument(what) => MultipartFault::InvalidArgument(what.clone()),
+        MultipartError::NoSuchBucket => MultipartFault::NoSuchContainer,
+        MultipartError::PublishContended => MultipartFault::PublishContended,
+    };
+    mapped.into()
+}
+
+/// A body stream that computes the running SHA-256 of the bytes flowing through it, so a
+/// part's digest — its ETag, and the value Complete validates the client's named list
+/// against — is the hash the write path already streamed. Never a second read of the body,
+/// and never a buffered part.
+struct HashingSource<S> {
+    inner: S,
+    hasher: Sha256,
+}
+
+impl<S> Stream for HashingSource<S>
+where
+    S: Stream<Item = Result<Bytes>> + Unpin,
+{
+    type Item = Result<Bytes>;
+
+    fn poll_next(
+        self: std::pin::Pin<&mut Self>,
+        cx: &mut std::task::Context<'_>,
+    ) -> std::task::Poll<Option<Self::Item>> {
+        let this = self.get_mut();
+        match std::pin::Pin::new(&mut this.inner).poll_next(cx) {
+            std::task::Poll::Ready(Some(Ok(bytes))) => {
+                this.hasher.update(bytes.as_ref());
+                std::task::Poll::Ready(Some(Ok(bytes)))
+            }
+            other => other,
+        }
+    }
+}
