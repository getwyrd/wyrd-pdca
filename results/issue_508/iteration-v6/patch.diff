+fn seed_bucket(meta: &MemMeta, name: &str) {
+    meta.data.lock().expect("meta lock").insert(
+        format!("bucket:{name}").into_bytes(),
+        Bytes::from(format!("{{\"name\":\"{name}\",\"created_millis\":0}}")),
+    );
+}
