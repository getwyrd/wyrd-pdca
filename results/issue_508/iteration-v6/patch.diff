+/// Parse a `<CompleteMultipartUpload>` body into the ordered part list it names.
+///
+/// Well-formedness is delegated WHOLE to [`roxmltree`] — the same rule the bulk-delete body
+/// follows — so this writes no hand-rolled grammar production and there is no next production
+/// to miss. Anything that is not a well-formed document naming at least one `<Part>` with both
+/// a numeric `<PartNumber>` and an `<ETag>` is `400 MalformedXML`, and nothing is published.
+fn parse_complete_body(bytes: &[u8]) -> Result<Vec<NamedPart>, ()> {
+    let text = std::str::from_utf8(bytes).map_err(|_| ())?;
+    let doc = roxmltree::Document::parse(text).map_err(|_| ())?;
+    let root = doc.root_element();
+    if root.tag_name().name() != "CompleteMultipartUpload" {
+        return Err(());
+    }
+    let mut named = Vec::new();
+    for part in root.children().filter(|n| n.is_element()) {
+        if part.tag_name().name() != "Part" {
+            return Err(());
+        }
+        let mut number: Option<u32> = None;
+        let mut etag: Option<String> = None;
+        for field in part.children().filter(|n| n.is_element()) {
+            match field.tag_name().name() {
+                "PartNumber" => {
+                    number = Some(field.text().unwrap_or("").trim().parse().map_err(|_| ())?)
+                }
+                // The quotes S3 wraps an ETag in are stripped here, so the comparison against
+                // the recorded digest is against the digest, not its quoting.
+                "ETag" => {
+                    etag = Some(
+                        field
+                            .text()
+                            .unwrap_or("")
+                            .trim()
+                            .trim_matches('"')
+                            .to_string(),
+                    )
+                }
+                // A child that states an integrity CONDITION this floor does not verify is
+                // refused, never ignored: silently dropping it would publish an assembly the
+                // client asked to have checked, and answer 200 as though it had been. Any
+                // OTHER unknown child is informational and tolerated, as S3 tolerates one.
+                name if name.starts_with("Checksum") => return Err(()),
+                _ => {}
+            }
+        }
+        match (number, etag) {
+            (Some(number), Some(etag)) if !etag.is_empty() => named.push(NamedPart {
+                part_number: number,
+                etag,
+            }),
+            _ => return Err(()),
+        }
+    }
+    if named.is_empty() {
+        return Err(());
+    }
+    Ok(named)
+}
