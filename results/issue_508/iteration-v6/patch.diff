+{
+    /// The composed `{container}/{key}` name on the flat namespace — the same encoding the
+    /// object path uses, so a multipart publication and a plain PUT address the identical
+    /// dirent.
+    fn object_name(container: &str, key: &str) -> String {
+        format!("{container}/{key}")
+    }
+
+    /// Read a session and check it belongs to this `(container, key)`. A session id
+    /// presented against a different key is not this upload — `UnknownUpload`, never a
+    /// publication to the wrong object.
+    async fn session_for(
+        &self,
+        container: &str,
+        key: &str,
+        upload_id: &str,
+    ) -> Result<(mp::SessionRecord, Bytes)> {
+        let Some((session, bytes)) = mp::read_session(&*self.meta, upload_id).await? else {
+            return Err(MultipartError::NoSuchUpload.into());
+        };
+        if session.bucket != container || session.key != key {
+            return Err(MultipartError::NoSuchUpload.into());
+        }
+        Ok((session, bytes))
+    }
+
+    /// The container-existence read ADR-0046 decision 4 requires before any operation that
+    /// would otherwise strand state in a bucket that does not exist.
+    async fn require_container(&self, container: &str) -> Result<()> {
+        if self
+            .meta
+            .get(&metadata::bucket_key(container))
+            .await?
+            .is_none()
+        {
+            return Err(MultipartError::NoSuchBucket.into());
+        }
+        Ok(())
+    }
+
+    /// Run the gateway's own bounded, re-entrant drain **off the request path**.
+    ///
+    /// Abort and Complete answer from their fence/flip commit alone (proposal 0016 F9), so
+    /// their obligations drain *after* the response: teardown of a 10,000-part session never
+    /// rides inside one request, and Abort's latency does not scale with session size. That
+    /// is not a nicety — a client Abort of a large upload would otherwise time out, and the
+    /// second Abort inside the teardown window would answer `404` instead of the idempotent
+    /// `204` the protocol promises.
+    ///
+    /// The task is **bounded on both axes and owned**, which is what the await-discipline rule
+    /// asks of a spawned helper: at most [`INLINE_DRAIN_PASSES`] passes, each visiting at most
+    /// `DRAIN_PAGES_PER_STEP` pages of the (deliberately unbounded) `retire:` namespace and
+    /// spending at most `DRAIN_BATCHES_PER_PASS` batches per obligation — and its `JoinHandle`
+    /// is retained by the gateway and **aborted on drop**, so a shutdown never leaves a helper
+    /// running against a store the process is finished with.
+    ///
+    /// Every obligation it walks is durable and its work re-derivable, so an aborted or lost
+    /// task loses nothing — whichever party runs next (a later request's drain, or the reaper)
+    /// re-derives the remaining work from the records. With no runtime to spawn onto, the drain
+    /// is simply left to #625.
+    pub(crate) fn drain_off_request_path(&self) {
+        let Ok(runtime) = tokio::runtime::Handle::try_current() else {
+            return;
+        };
+        let meta = Arc::clone(&self.meta);
+        let handle = runtime.spawn(async move {
+            if let Err(err) = mp::drain(&*meta, now_millis(), INLINE_DRAIN_PASSES).await {
+                tracing::warn!(
+                    error = %err,
+                    "the multipart retirement drain did not finish this pass; the obligations \
+                     are durable and the next drain — a later request's, or the reaper's \
+                     (#625) — re-derives the remaining work"
+                );
+            }
+        });
+        self.drain_tasks.retain(handle);
+    }
