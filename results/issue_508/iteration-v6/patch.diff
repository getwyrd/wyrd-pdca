@@ -0,0 +1,3853 @@
+//! The **multipart commit protocol** — the record model and the fenced batches that
+//! publish, protect and reclaim an *assembled write* (proposal 0016, issue #508).
+//!
+//! An assembled write is a write whose durable staging outlives any single request or
+//! lease window. Everything the ordinary streaming write path relies on breaks for it:
+//! publication is proved today by *lease liveness* (`metadata::live_lease_guards`), the
+//! maintenance planes gate on committed inode state only, records are assumed small, and
+//! batches are explicitly non-idempotent. This module replaces each of those with the
+//! mechanism 0016 settles:
+//!
+//! * **publication proof** — a *fence* on the session record, not a timer (decision 1);
+//! * **protection class** — durable-but-unpublished bytes are named by `part:` records
+//!   and in-flight owned `sidx:` staging entries, both members of the custodian's staged
+//!   reference set (decision 2);
+//! * **lifecycle** — a state machine no state of which is absorbing (decision 3);
+//! * **bounded work** — a `retire:` ledger drained in byte- and operation-budgeted
+//!   batches, never an inline fan-out (decision 4);
+//! * **reclamation evidence** — every release path *writes* the `orphan:` evidence GC
+//!   needs before it lifts protection (decision 5);
+//! * **admission** — a serialized `mpuctl` reservation (decision 6, protocol half).
+//!
+//! The one invariant every routine here exists to hold: **every durable byte written by
+//! an assembled write is, at every instant, either protected by a record that names it or
+//! evidenced for reclamation, and no state of an upload session is absorbing.** Both
+//! directions bind — retaining unconditionally leaks forever, and unprotecting without
+//! evidence leaks forever *silently*, because GC conservatively retains an unevidenced
+//! fragment (`crates/custodian/src/gc.rs:158-190`) rather than reclaiming it.
+//!
+//! This module names no S3 vocabulary: it is the protocol underneath the verbs, and the
+//! S3 wire surface (status codes, XML, routing) is `wyrd-gateway-s3`'s.
+
+use bytes::Bytes;
+use serde::{Deserialize, Serialize};
+use wyrd_traits::{
+    ChunkId, CommitOutcome, DServerId, FragmentId, MetadataStore, Result, WriteBatch, SCAN_CAP,
+};
+
+use crate::metadata::{self, decode, encode, ChunkRef, InodeId, ObjectMeta, PendingEntry};
+
+// ---------------------------------------------------------------------------------------
+// Budget profile — the knob values this slice owns (0016 decision 4's knob table,
+// `0016:1462-1479`). Each value is INSIDE the range 0016 settles and the range is cited at
+// its definition, so a later reader can check it without re-deriving the arithmetic.
+// ---------------------------------------------------------------------------------------
+
+/// The backend **value** ceiling the store envelope inherits (FoundationDB's, the tightest
+/// in play — `crates/traits/src/lib.rs:744-758`). Every `MAX_*_CHUNKS` below is derived
+/// against `VALUE_CEILING_BYTES / 2`, the 2× headroom 0016 requires.
+pub const VALUE_CEILING_BYTES: usize = 100_000;
+
+/// The per-**transaction** byte ceiling (10 MB, same envelope). Batches are budgeted at
+/// `E_tx / 2` (`0016:621-652`).
+pub const TX_CEILING_BYTES: usize = 10_000_000;
+
+/// The encoded bytes of a `ChunkRef` **without** its placement vector — **measured**, not
+/// estimated: the worst case is `{"id":<39 digits>,"scheme":{"ReedSolomon":{"k":255,"m":255}},
+/// "len":<20 digits>,"placement":[]}`, which is 131 bytes (`ChunkId` is a `u128`, `len` a
+/// `u64`, and the `ReedSolomon` variant is the widest scheme tag). The measurement is pinned
+/// by [`tests::the_chunkref_byte_budget_covers_the_worst_case_encoding`], so the number cannot
+/// drift from the type: 0016's own ~302 B figure (`0016:1051`) implied a 113-byte base, which
+/// under-counts by 18 bytes and made a 9-fragment RS(6,3) chunk (the deployed default) encode
+/// to 319 B while every derived ceiling claimed 302 — the ceilings were unsound by one
+/// fragment.
+const CHUNKREF_BASE_BYTES: usize = 131;
+
+/// The encoded bytes one placement entry adds (a `u64` at its widest, plus a separator).
+const CHUNKREF_PLACEMENT_BYTES: usize = 21;
+
+/// Worst-case encoded bytes of a [`ChunkRef`] whose chunk has `fragments` placements —
+/// **derived** from the two measured constants above rather than quoted, so raising one
+/// re-derives every ceiling instead of silently invalidating it.
+pub const fn chunkref_bytes(fragments: u16) -> usize {
+    CHUNKREF_BASE_BYTES + (fragments as usize) * CHUNKREF_PLACEMENT_BYTES
+}
+
+/// The fragment count per chunk every ceiling below is derived against: 9, the deployed
+/// default RS(6,3) ([`crate::write`]'s scheme, `crates/server/src/lib.rs:53`).
+///
+/// A wider scheme is not silently unsound: [`check_durability_config`] refuses at
+/// **configuration load** any scheme whose chunk references could push a full map, segment or
+/// part record past the backend's value ceiling — resolved before any request, exactly as the
+/// lengthless-stream chunk-size precondition is (`0016:X107`), never discovered as a
+/// mid-publication commit failure.
+pub const MAX_FRAGMENTS_PER_CHUNK: u16 = 9;
+
+/// Worst-case encoded size of one [`ChunkRef`] at [`MAX_FRAGMENTS_PER_CHUNK`] (320 B) — the
+/// budget `MAX_MAP_CHUNKS` and its siblings divide `V/2` by.
+const MAX_CHUNKREF_BYTES: usize = chunkref_bytes(MAX_FRAGMENTS_PER_CHUNK);
+
+// The derived budget must leave the 2× headroom 0016 requires for the record classes whose
+// values are whole maps. Checked at COMPILE time rather than trusted, the
+// `MAX_DELETE_BODY_BYTES` pattern (`crates/gateway-s3/src/lib.rs:439-457`).
+const _: () = assert!(MAX_CHUNKREF_BYTES * MAX_MAP_CHUNKS <= VALUE_CEILING_BYTES / 2);
+
+/// Worst-case encoded size of one [`SegmentRef`] (~160 B, `0016:2432`).
+const MAX_SEGREF_BYTES: usize = 160;
+
+/// Chunks a **flat** inode map may hold. Range (`0016:1464`): `> 0` and
+/// `max_chunkref_bytes × MAX_MAP_CHUNKS ≤ V/2`. 0016 quotes 165–381 off its own ~302 B
+/// chunk-reference estimate; the **measured** worst case at the deployed scheme is 320 B
+/// ([`chunkref_bytes`]), so the sound value is 156 — inside the rule 0016 states, below the
+/// arithmetic it printed, which is the safe direction (the printed range assumed a base that
+/// under-counted by 18 bytes).
+pub const MAX_MAP_CHUNKS: usize = (VALUE_CEILING_BYTES / 2) / MAX_CHUNKREF_BYTES; // 156
+
+/// Chunks one `seg:` record may hold — the identical rule one record class down
+/// (`0016:1465`).
+pub const MAX_SEG_CHUNKS: usize = MAX_MAP_CHUNKS;
+
+/// Chunks one `part:` record may hold. Range (`0016:1466`): identical to
+/// [`MAX_MAP_CHUNKS`] (a `part:` record is one value), **and** `≤ B_OPS` — a part commit is
+/// an *unsplittable* batch deleting up to this many `sidx:` entries, so a value above the
+/// operation budget would make a valid part's commit *and* its compensation time out
+/// permanently (X110).
+pub const MAX_PART_CHUNKS: usize = MAX_MAP_CHUNKS;
+
+/// Segments a segmented root may name. Range (`0016:1467`): `> 0` and
+/// `max_segref_bytes × MAX_ROOT_SEGMENTS ≤ V/2` ⇒ 312–520; worst-case end again.
+pub const MAX_ROOT_SEGMENTS: usize = (VALUE_CEILING_BYTES / 2) / MAX_SEGREF_BYTES; // 312
+
+/// Chunk-refs one session may hold in committed `part:` records. Range (`0016:1468`):
+/// `[MAX_PART_CHUNKS, MAX_ROOT_SEGMENTS × MAX_SEG_CHUNKS]`, settled value the upper end —
+/// the publishable segmented ceiling, so a session cannot stage more than it could publish.
+pub const MAX_STAGED_CHUNKS: usize = MAX_ROOT_SEGMENTS * MAX_SEG_CHUNKS; // 51_480
+
+/// S3's part-number ceiling (`0016:2446`).
+pub const MAX_PARTS_PER_SESSION: u32 = 10_000;
+
+/// The operation-count half of the batch budget `B = min(B_bytes, B_ops)` (`0016:1475`) —
+/// calibrated so a batch's sequential in-transaction round trips fit the 5-second half of
+/// the envelope on the slowest supported backend. This is the value #625 consumes
+/// unchanged; see the module note on split budget authority.
+pub const B_OPS: usize = 1_000;
+
+/// The byte half of the batch budget: `⌊(E_tx/2) / (bytes per mutation)⌋` for a *small*
+/// mutation (an `orphan:` mark). `B` for a larger mutation is recomputed per call site.
+pub const B_BYTES_SMALL: usize = (TX_CEILING_BYTES / 2) / 5_000;
+
+/// Parts one session may have in flight. Range (`0016:1471`): `[1, min(
+/// MAX_PARTS_PER_SESSION, ⌊SCAN_CAP/(2·MAX_PART_CHUNKS)⌋, ⌊(E_tx/2)/(slot key bytes)⌋,
+/// B_ops )]` — four clamps, all satisfied by 16 (the value defines the `slot:` key space,
+/// so the per-session in-flight bound is *structural*).
+pub const MAX_INFLIGHT_PARTS: u32 = 16;
+
+/// The reconcile pass's staged-reference **memory** budget in chunk-refs. 0016's worked
+/// example (`0016:2129`) and the value #625 consumes unchanged.
+pub const W_REF: u64 = 4_000_000;
+
+/// Publication-CAS retries inside one Complete attempt. Range (`0016:1476`): `[1, small]`.
+pub const R_PUBLISH: usize = 4;
+
+/// Complete fences one session may take. Range (`0016:1477`): `[1, small]` — each fence
+/// mints a `Completing@E` epoch whose rolled-back segments become one obligation, so an
+/// unbounded fence/rollback cycle would install obligations without bound.
+pub const MAX_COMPLETE_ATTEMPTS: u32 = 8;
+
+/// S3's minimum size for a **non-final** part.
+pub const MIN_PART_BYTES: u64 = 5 * 1024 * 1024;
+
+/// The gateway's default chunk size, mirrored here so the sizing formulas of decision 7
+/// (`0016:2299-2309`) have one definition. Matches `crates/server/src/lib.rs:51`.
+pub const DEFAULT_CHUNK_SIZE: usize = 1 << 20;
+
+/// The largest chunk size a deployment will select. Decision 7's configuration
+/// precondition (`0016:2300-2309`) requires `chunk_size_max ≥ ⌈5 GiB / MAX_MAP_CHUNKS⌉`
+/// ≈ 31.03 MiB; 64 MiB satisfies it with margin and stays inside the gateway memory budget
+/// (`chunk_size × max_concurrent_encodes`).
+pub const CHUNK_SIZE_MAX: usize = 64 << 20;
+
+/// S3's single-`PutObject` maximum — the size the lengthless-stream sizing rule assumes
+/// (`0016:2304`).
+pub const SINGLE_PUT_MAX_BYTES: u64 = 5 * 1024 * 1024 * 1024;
+
+/// The worst-case per-session staged-reference footprint, in chunk-refs. **Derived**
+/// (`0016:1469`), never chosen: `min( (MAX_PARTS_PER_SESSION + MAX_INFLIGHT_PARTS) ×
+/// MAX_PART_CHUNKS , MAX_STAGED_CHUNKS + 2 × MAX_INFLIGHT_PARTS × MAX_PART_CHUNKS )`.
+pub const fn u_ref() -> u64 {
+    let raw = (MAX_PARTS_PER_SESSION as u64 + MAX_INFLIGHT_PARTS as u64) * MAX_PART_CHUNKS as u64;
+    let ceiling = MAX_STAGED_CHUNKS as u64 + 2 * MAX_INFLIGHT_PARTS as u64 * MAX_PART_CHUNKS as u64;
+    if raw < ceiling {
+        raw
+    } else {
+        ceiling
+    }
+}
+
+/// Concurrent sessions **holding staged references** that the deployment admits. **Derived,
+/// never chosen** (`0016:1470`): `min( ⌊W_ref / U_ref⌋ , SCAN_CAP/2 )`. The `SCAN_CAP/2` term
+/// is a clamp the implementation applies (a large `W_ref` with small parts could otherwise
+/// break the reaper's `scan("mpu:")`).
+pub const fn max_sessions() -> u64 {
+    let derived = W_REF / u_ref();
+    let clamp = (SCAN_CAP / 2) as u64;
+    if derived < clamp {
+        derived
+    } else {
+        clamp
+    }
+}
+
+/// The **session-record** population budget, in records: what one bounded `scan("mpu:")` — the
+/// reaper's, `ListMultipartUploads`', the drain's teardown walk — may enumerate.
+///
+/// This is a *second, weaker* bound than [`max_sessions`] and it exists because the two
+/// resources `mpuctl` protects are different sizes. `max_sessions` bounds the **staged-reference
+/// memory** a reconcile pass builds (`⌊W_ref / U_ref⌋` ≈ 70 sessions at the worked example),
+/// and only a session that still owns `part:`/`sidx:` records spends it. A **`Completed`
+/// tombstone** spends none of it — its records are gone by the time it becomes one — but it does
+/// still occupy an `mpu:` key that every bounded session scan must enumerate, so it is charged
+/// here instead. 65,536 records is ≈ 20 MB at the worst-case record size and well inside
+/// `SCAN_CAP`, so no session scan can fail.
+pub const W_SESSIONS: u64 = 65_536;
+
+/// `mpu:` records the store admits **in any state**, tombstones included. Derived from
+/// [`W_SESSIONS`] and clamped by `SCAN_CAP/2` for the same reason [`max_sessions`] is.
+pub const fn max_records() -> u64 {
+    let clamp = (SCAN_CAP / 2) as u64;
+    if W_SESSIONS < clamp {
+        W_SESSIONS
+    } else {
+        clamp
+    }
+}
+
+/// The budget tuple `mpuctl` stores so a rolling configuration change cannot leave two
+/// gateways enforcing different bounds (`0016:348`, X64/X76). Equal quotients can hide
+/// unequal footprints, so admission compares the **profile**, not the derived quotient.
+///
+/// **One value set, landed in wave 0.** 0016's *Open questions* assigns `W_ref` and
+/// `B = min(B_bytes, B_ops)` to #625, but `mpuctl.profile` is written by `Create` — in
+/// *this* slice — and *contains* them; `MAX_PART_CHUNKS` and `MAX_INFLIGHT_PARTS` are
+/// legally clamped by `B_ops`; and #625's reaper must fail closed when its local profile
+/// disagrees with the ledger's. Two independently chosen `B_ops` values would be actively
+/// unsafe: a session admitted under this slice's clamp could need more sequential
+/// operations than #625 permits in its **unsplittable** reap fence, which then times out
+/// forever — a permanent, data-retaining failure mode. So there is one value set and one
+/// configuration seam, landed here, and #625 consumes it unchanged.
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+pub struct BudgetProfile {
+    /// The reconcile pass's staged-reference memory budget, in chunk-refs.
+    pub w_ref: u64,
+    /// Chunk-refs one `part:` record may hold.
+    pub max_part_chunks: u64,
+    /// S3's part-number ceiling.
+    pub max_parts_per_session: u64,
+    /// Parts one session may have in flight (the `slot:` key space).
+    pub max_inflight_parts: u64,
+    /// Chunk-refs one session may hold in committed `part:` records.
+    pub max_staged_chunks: u64,
+    /// The operation-count half of the batch budget, which clamps the two knobs above.
+    pub b_ops: u64,
+}
+
+impl BudgetProfile {
+    /// This build's profile — the single value set both this slice and #625 enforce.
+    pub fn deployed() -> Self {
+        Self {
+            w_ref: W_REF,
+            max_part_chunks: MAX_PART_CHUNKS as u64,
+            max_parts_per_session: MAX_PARTS_PER_SESSION as u64,
+            max_inflight_parts: MAX_INFLIGHT_PARTS as u64,
+            max_staged_chunks: MAX_STAGED_CHUNKS as u64,
+            b_ops: B_OPS as u64,
+        }
+    }
+}
+
+// ---------------------------------------------------------------------------------------
+// Key space (0016 §1, `0016:346-356`). Every prefix is disjoint from every other and from
+// `inode:` / `dirent:` / `pending:` / `bucket:` / `orphan:` / `desired:dserver:`, and no
+// prefix is a prefix of another — so no `scan` returns a neighbour's records.
+// ---------------------------------------------------------------------------------------
+
+/// The singleton **admission** record. Absent reads as `{ count: 0 }`; the first Create on
+/// a fresh or upgraded store initializes it under `require_absent`, so there is no
+/// migration step.
+pub const MPUCTL_KEY: &[u8] = b"mpuctl";
+
+/// Key prefix of the session records.
+pub const MPU_PREFIX: &[u8] = b"mpu:";
+/// Key prefix of the in-flight part **slots**.
+pub const SLOT_PREFIX: &[u8] = b"slot:";
+/// Key prefix of the committed **part** records.
+pub const PART_PREFIX: &[u8] = b"part:";
+/// Key prefix of the committed part **summaries**.
+pub const PSUM_PREFIX: &[u8] = b"psum:";
+/// Key prefix of the **owned staging** entries — deliberately disjoint from `pending:` so
+/// no global `scan("pending:")` (the restore pass, the expiry sweep) ever enumerates one.
+pub const SIDX_PREFIX: &[u8] = b"sidx:";
+/// Key prefix of the published-map **segment** records.
+pub const SEG_PREFIX: &[u8] = b"seg:";
+/// Key prefix of the **segment-group** reservation markers.
+pub const SEGGRP_PREFIX: &[u8] = b"seggrp:";
+/// Key prefix of the **retirement ledger**.
+pub const RETIRE_PREFIX: &[u8] = b"retire:";
+
+/// `mpu:<upload-id>` — the session record.
+pub fn mpu_key(upload_id: &str) -> Vec<u8> {
+    format!("mpu:{upload_id}").into_bytes()
+}
+
+/// `slot:<upload-id>:<index>`, the index a **fixed-width** decimal so the key range sorts
+/// numerically and `<index>` is structurally checkable at decode (`0016:404-405`).
+pub fn slot_key(upload_id: &str, index: u32) -> Vec<u8> {
+    format!("slot:{upload_id}:{index:05}").into_bytes()
+}
+
+/// The bounded per-session `slot:` range (≤ `MAX_INFLIGHT_PARTS` records).
+pub fn slot_prefix(upload_id: &str) -> Vec<u8> {
+    format!("slot:{upload_id}:").into_bytes()
+}
+
+/// `part:<upload-id>:<part-number>`, fixed-width so the range sorts by part number.
+pub fn part_key(upload_id: &str, part_number: u32) -> Vec<u8> {
+    format!("part:{upload_id}:{part_number:05}").into_bytes()
+}
+
+/// The bounded per-session `part:` range (≤ `MAX_PARTS_PER_SESSION` records).
+pub fn part_prefix(upload_id: &str) -> Vec<u8> {
+    format!("part:{upload_id}:").into_bytes()
+}
+
+/// `psum:<upload-id>:<part-number>` — the part's few-tens-of-bytes summary, written in the
+/// **same batch** as the `part:` record it summarizes.
+pub fn psum_key(upload_id: &str, part_number: u32) -> Vec<u8> {
+    format!("psum:{upload_id}:{part_number:05}").into_bytes()
+}
+
+/// The bounded per-session `psum:` range — what the cumulative staged-chunk check and
+/// `ListParts` read, so neither ever pulls the fat chunk lists.
+pub fn psum_prefix(upload_id: &str) -> Vec<u8> {
+    format!("psum:{upload_id}:").into_bytes()
+}
+
+/// `sidx:<upload-id>:<part-number>:<chunk-id>` — the owned staging entry. The
+/// `<part-number>` lets a reaper attribute residue to the part attempt that staged it.
+pub fn sidx_key(upload_id: &str, part_number: u32, chunk: ChunkId) -> Vec<u8> {
+    format!("sidx:{upload_id}:{part_number:05}:{chunk}").into_bytes()
+}
+
+/// The bounded per-session `sidx:` range (≤ `MAX_INFLIGHT_PARTS × MAX_PART_CHUNKS`).
+pub fn sidx_prefix(upload_id: &str) -> Vec<u8> {
+    format!("sidx:{upload_id}:").into_bytes()
+}
+
+/// `seg:<group-nonce>:<epoch>:<index>` — one segment of a published map.
+///
+/// Keyed by the session's independent **segment-group nonce**, *not* by the upload id:
+/// segment records outlive the `mpu:` tombstone that would otherwise be their only reuse
+/// guard, so an upload id reused after its tombstone expired would find the session key
+/// free and its segment-write phase would **overwrite a live object's segments**
+/// (`0016:499-526`, iteration-14 finding 2 / iteration-15 finding 1). The `<epoch>` is the
+/// `Completing` fence epoch that wrote it, so a rolled-back attempt's stale segments live
+/// in a key range disjoint from any later attempt's (F18).
+pub fn seg_key(group_nonce: &str, epoch: u64, index: u32) -> Vec<u8> {
+    format!("seg:{group_nonce}:{epoch}:{index:05}").into_bytes()
+}
+
+/// The bounded per-generation `seg:` range (≤ `MAX_ROOT_SEGMENTS`).
+pub fn seg_prefix(group_nonce: &str, epoch: u64) -> Vec<u8> {
+    format!("seg:{group_nonce}:{epoch}:").into_bytes()
+}
+
+/// `seggrp:<group-nonce>` — the segment-group reservation marker, taken under
+/// `require_absent` in the Create batch, so nonce reuse is structurally impossible rather
+/// than merely improbable.
+pub fn seggrp_key(group_nonce: &str) -> Vec<u8> {
+    format!("seggrp:{group_nonce}").into_bytes()
+}
+
+/// `retire:bytes:<token>` — bytes to orphan-mark, **then** the naming records to delete.
+pub fn retire_bytes_key(token: &str) -> Vec<u8> {
+    format!("retire:bytes:{token}").into_bytes()
+}
+
+/// `retire:records:<token>` — staging records to delete whose bytes are protected by
+/// something else. It must **never** orphan anything; the mode lives in the key, not in a
+/// field, because a boolean misread once is silent data loss while a malformed key prefix
+/// is an error at decode (`0016:434-440`).
+pub fn retire_records_key(token: &str) -> Vec<u8> {
+    format!("retire:records:{token}").into_bytes()
+}
+
+/// The session-scoped `retire:bytes:` range — the two bounded emptiness reads the terminal
+/// delete gates on (`0016:374-380`).
+pub fn retire_bytes_session_prefix(upload_id: &str) -> Vec<u8> {
+    format!("retire:bytes:s:{upload_id}:").into_bytes()
+}
+
+/// The session-scoped `retire:records:` range.
+pub fn retire_records_session_prefix(upload_id: &str) -> Vec<u8> {
+    format!("retire:records:s:{upload_id}:").into_bytes()
+}
+
+/// A **session-scoped** retirement token: `s:<upload-id>:<epoch>[:<part>:<attempt>]`.
+/// Every component is minted once, so a token can never be reused and installation under
+/// `require_absent` turns a collision into a `Conflict` the installer classifies — never a
+/// silent overwrite, which would permanently lose one obligation's reclamation evidence.
+pub fn session_token(upload_id: &str, epoch: u64) -> String {
+    format!("s:{upload_id}:{epoch}")
+}
+
+/// A **per-part-attempt** retirement token.
+pub fn part_attempt_token(upload_id: &str, epoch: u64, part_number: u32, attempt: &str) -> String {
+    format!("s:{upload_id}:{epoch}:{part_number}:{attempt}")
+}
+
+/// A **generation** retirement token: `g:<inode-id>:<version>`. An `(inode, version)` pair
+/// is produced by exactly one publication, so this too is minted once.
+pub fn generation_token(inode: InodeId, version: u64) -> String {
+    format!("g:{inode}:{version}")
+}
+
+/// Parse `part:<id>:<n>` / `psum:<id>:<n>` back to its part number.
+pub fn parse_part_number(key: &[u8], prefix: &[u8]) -> Option<u32> {
+    let rest = key.strip_prefix(prefix)?;
+    let text = std::str::from_utf8(rest).ok()?;
+    let (_, number) = text.rsplit_once(':')?;
+    number.parse().ok()
+}
+
+/// Parse the trailing fixed-width number of a `part:`/`psum:` key already scoped to one
+/// session by its own prefix.
+pub fn parse_scoped_number(key: &[u8], prefix: &[u8]) -> Option<u32> {
+    let rest = key.strip_prefix(prefix)?;
+    std::str::from_utf8(rest).ok()?.parse().ok()
+}
+
+// ---------------------------------------------------------------------------------------
+// Records
+// ---------------------------------------------------------------------------------------
+
+/// The admission record — the counts **and** the limits they were admitted against, in **one**
+/// value, so a count and its limit can never be read apart. Every mutation CASes it whole.
+///
+/// **Two counts, because `mpuctl` guards two different resources** (the wave-0 correction to
+/// 0016's single `count`, `0016:348`/`:964-968`). 0016 charges a `Completed` tombstone against
+/// the one counter and bounds its retention by `W_tombstone` — which is #625's window, and this
+/// slice is wave 0. With a single counter a store would therefore accept only `max_sessions`
+/// (≈ 70) *lifetime* successful uploads before `CreateMultipartUpload` refused everything, since
+/// a tombstone never releases and nothing in this slice deletes one: a permanent, service-wide
+/// refusal, which invariant C-1 puts off the table. Splitting the count along the resources it
+/// protects removes the failure mode without weakening either bound:
+///
+/// * [`staged`](Self::staged) — sessions that still own `part:`/`psum:`/`sidx:` records, the
+///   only ones that spend the reconcile pass's `W_ref` staged-reference memory. Released the
+///   moment a session's obligations finish draining (`Completed`), or with its terminal delete
+///   (`Aborting`).
+/// * [`count`](Self::count) — `mpu:` records in **any** state, tombstones included, exactly as
+///   0016 defines it: the population every bounded `scan("mpu:")` enumerates. Released only by
+///   the terminal delete, which for a tombstone is #625's `W_tombstone` exit.
+///
+/// A tombstone therefore holds an `mpu:` key (bounded by [`max_records`], ≈ 65 K) but not a
+/// staged-reference slot (bounded by [`max_sessions`], ≈ 70).
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+pub struct MpuControl {
+    /// The number of `mpu:` records that exist in **any** state (tombstones included).
+    pub count: u64,
+    /// Sessions still holding staged references — the count the `W_ref` budget bounds.
+    #[serde(default)]
+    pub staged: u64,
+    /// The governing staged-reference limit those increments were admitted against.
+    pub max_sessions: u64,
+    /// The governing session-record limit — how many `mpu:` records may exist at once.
+    #[serde(default)]
+    pub max_records: u64,
+    /// The budget tuple that *establishes* those limits.
+    pub profile: BudgetProfile,
+}
+
+/// The lifecycle states of §2's machine. No state is absorbing: every one has an exit and a
+/// driver (`0016:567-579`).
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]
+pub enum SessionState {
+    /// Accepting parts.
+    Open,
+    /// Fenced by a Complete: the part set is frozen and no part may be added, replaced or
+    /// removed.
+    Completing,
+    /// Fenced by an Abort, a reap, a restore or the residency ceiling; draining.
+    Aborting,
+    /// Published. A **tombstone** until its window elapses, so a client retry inside the
+    /// window gets the recorded ETag rather than `404`.
+    Completed,
+}
+
+/// The dirent identity a Complete publishes to — the parent inode and the object name,
+/// **never a frozen inode id**: an inode id is minted per `create` and both keys are
+/// `require_absent`-guarded, so a concurrent delete-and-recreate of the same key rebinds it
+/// to a *different* inode and a flip that reused a frozen id would address a deleted
+/// generation (`0016:350`).
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+pub struct PublishTarget {
+    /// The parent inode the object name is bound under.
+    pub parent: InodeId,
+    /// The object name (the composed `{bucket}/{key}` on the flat namespace).
+    pub name: String,
+    /// The `Completing` fence epoch, so a resumed completer writes the same deterministic
+    /// segment keys.
+    pub epoch: u64,
+}
+
+/// What a winning flip recorded, so the tombstone can answer an identical retry.
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+pub struct Published {
+    /// The inode the object was published to.
+    pub inode: InodeId,
+    /// The version the flip recorded — `prior.version + 1` from the **re-read** prior at
+    /// that flip attempt, never a value frozen at fence time.
+    pub version: u64,
+    /// The published multipart ETag.
+    pub etag: String,
+    /// The publication instant.
+    pub completed_at_millis: u64,
+}
+
+/// One multipart upload, from create to its terminal state.
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+pub struct SessionRecord {
+    /// The target container.
+    pub bucket: String,
+    /// The target object key, relative to the container.
+    pub key: String,
+    /// The `Content-Type` the initiating client declared.
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub content_type: Option<String>,
+    /// When the session was created — the instant `W_session` residency is measured from.
+    pub created_at_millis: u64,
+    /// Which clock stamped this session's timestamps. A reaper that does not recognise the
+    /// source **skips** the session rather than judging it (declining to judge is the safe
+    /// direction); the operator verb is then its only exit, which is why FU-6 ships with
+    /// #625.
+    pub clock_source: String,
+    /// The lifecycle state.
+    pub state: SessionState,
+    /// The fence epoch. Bumped by every transition, so two successive states are textually
+    /// distinct even when nothing else changes and every operation preconditioned on the
+    /// old bytes fails closed.
+    pub epoch: u64,
+    /// Complete fences taken so far, capped at [`MAX_COMPLETE_ATTEMPTS`].
+    pub attempts: u32,
+    /// The segment-group nonce reserved with the session — independent of the upload id
+    /// because segment records outlive the session's tombstone.
+    pub group_nonce: String,
+    /// Stamped at the `Completing` fence, so `W_completing` is measured from the fence
+    /// instant and not from last part progress (F16).
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub fenced_at_millis: Option<u64>,
+    /// The segment-write cursor — a field *inside* the record the phase already
+    /// preconditions on, so segmentation introduces no cursor record class.
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub segments_written: Option<u32>,
+    /// The dirent identity + fence epoch this attempt publishes to.
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub publish_target: Option<PublishTarget>,
+    /// What a winning flip recorded.
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub published: Option<Published>,
+    /// `Some(true)` once this session's **staged-reference admission slot** has been released —
+    /// set by the batch that observes its obligations drained and its `sidx:` range empty
+    /// ([`release_admission_batch`]). The flag is what makes that release **exactly once**: the
+    /// terminal delete reads it off the very bytes it preconditions on and decrements
+    /// `mpuctl.staged` only if it is absent, so a gateway drain and #625's reaper cannot both
+    /// release the same slot (and a tombstone that already released one is not double-counted
+    /// when its record is finally deleted).
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub admission_released: Option<bool>,
+    /// A digest over the *ordered* `(part_number, digest)` list the winning Complete named,
+    /// so the tombstone can tell an **identical retry** from a **different assembly**
+    /// reusing the upload id. A client that reused the id with a different part list would
+    /// otherwise be told *its* assembly succeeded while the stored object holds the earlier
+    /// one — a silent wrong answer, worse than any error (`0016:898-908`).
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub complete_fingerprint: Option<String>,
+}
+
+impl SessionRecord {
+    /// Is the session still accepting parts?
