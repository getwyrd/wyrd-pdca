+    /// The two halves are the invariant: every fragment position carries `orphan:` evidence, and
+    /// no naming record is deleted without it — a release without evidence leaves the bytes
+    /// unreferenced *and* unevidenced, which GC conservatively retains for ever (a silent leak).
+    #[test]
+    fn a_bytes_obligation_marks_every_position_before_deleting_its_records() {
+        let store = RedbMetadataStore::in_memory().expect("redb");
