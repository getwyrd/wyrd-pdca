+                // Per-chunk streaming signatures already authenticated the body chunk by
+                // chunk, so there is no separate post-stream digest to re-check.
+                sigv4::PayloadHash::Streaming(ctx) => (
+                    Box::pin(streaming::decode(raw, ctx)),
+                    ContentHash::Unverified,
+                ),
