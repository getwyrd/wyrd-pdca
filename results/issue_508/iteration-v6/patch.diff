+/// One session's worth of fixture: the ids and the chunk the part record names.
+struct MpuFixture {
+    upload_id: String,
+    group_nonce: String,
+    chunk: ChunkRef,
+}
+
+/// Create a session and commit one part naming a placed chunk, with the fragments actually
+/// written to the fleet — so every position the properties reason about is a durable byte.
+async fn seed_mpu_session(
+    meta: &MemMeta,
+    fleet: &[(DServerId, MemDServer)],
+    rng: &mut ChaCha8Rng,
+) -> MpuFixture {
+    // Seed-derived ids, so a bug-finding seed replays the exact same key space (ADR-0009).
+    let upload_id = format!("u-{:08x}{:08x}", rng.next_u32(), rng.next_u32());
+    let group_nonce = format!("g-{:08x}{:08x}", rng.next_u32(), rng.next_u32());
+    let session = multipart::SessionRecord {
+        bucket: "b".to_string(),
+        key: "k".to_string(),
+        content_type: None,
+        created_at_millis: 0,
+        clock_source: "dst".to_string(),
+        state: multipart::SessionState::Open,
+        epoch: 0,
+        attempts: 0,
+        group_nonce: group_nonce.clone(),
+        fenced_at_millis: None,
+        segments_written: None,
+        publish_target: None,
+        published: None,
+        admission_released: None,
+        complete_fingerprint: None,
+    };
+    assert_eq!(
+        multipart::create_session(meta, &upload_id, &session)
+            .await
+            .expect("create_session"),
+        CommitOutcome::Committed
+    );
+    let chunk = ChunkRef {
+        id: CHUNK,
+        scheme: EcScheme::ReedSolomon {
+            k: K as u8,
+            m: M as u8,
+        },
+        len: 8,
+        placement: (0..N as DServerId).collect(),
+    };
+    for (index, dserver) in chunk.fragments() {
+        let bytes = Bytes::from(vec![index as u8; usize::from(CORE_HEADER_LEN) + 8]);
+        fleet[dserver as usize]
+            .1
+            .put_fragment(
+                FragmentId {
+                    chunk: chunk.id,
+                    index,
+                },
+                bytes,
+            )
+            .await
+            .expect("stage a fragment");
+    }
+    let record = multipart::PartRecord {
+        chunks: vec![chunk.clone()],
+        len: 8,
+        digest: "00".repeat(32),
+        committed_at_millis: 0,
+        session_epoch: 0,
+    };
+    let summary = multipart::PartSummary {
+        chunks: 1,
+        len: 8,
+        digest: record.digest.clone(),
+        committed_at_millis: 0,
+    };
