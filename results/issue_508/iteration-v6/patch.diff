+                body.into_data_stream()
+                    .map(|item| item.map_err(|e| Box::new(e) as BoxError)),
+            );
+            // The payload arms are EXHAUSTIVE so a mode can never be added that silently skips
+            // the integrity check, exactly as the bulk-delete body check is (`:2528-2536`).
