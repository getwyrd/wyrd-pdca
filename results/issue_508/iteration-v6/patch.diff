+                    StatusCode::OK,
+                    &format!(
+                        "<InitiateMultipartUploadResult><Bucket>{}</Bucket><Key>{}</Key>\
+                         <UploadId>{}</UploadId></InitiateMultipartUploadResult>",
+                        xml_escape(bucket),
+                        xml_escape(key),
+                        xml_escape(&upload_id)
