+// ---------------------------------------------------------------------------------------
+// The multipart ETag composition (this slice's, constrained by 0016 to one property: a
+// pure function of the part records' recorded digests and their order).
+// ---------------------------------------------------------------------------------------
+
+/// The published multipart ETag:
+/// `lowercase_hex( SHA-256( d_1 ‖ d_2 ‖ … ‖ d_N ) ) + "-" + N`, where `d_i` is the **raw 32
+/// binary digest bytes** of the *i*-th part in ascending part-number order over exactly the
+/// parts the client named, and `N` is that count.
+///
+/// It is a **pure function of the recorded digests and their order**, so a retried Complete
+/// re-derives the identical value with no stored state. Never MD5 — ADR-0047 closed the
+/// basis, and a true S3 `md5-of-part-md5s` ETag would add a dependency for a digest the
+/// project has rejected.
+pub fn multipart_etag(part_digests_hex: &[String]) -> Result<String> {
+    use sha2::{Digest, Sha256};
+    let mut hasher = Sha256::new();
+    for hex in part_digests_hex {
+        // The raw digest bytes, not their hex text: an implementation that concatenated the
+        // hex would produce a different (also "SHA-256-based, pure") value, which is why the
+        // composition is spelled out to the byte.
+        //
+        // A digest that is not 32 lowercase-hex bytes is a **structural** fault in a record
+        // only this module writes, so it fails closed: a lenient decode that dropped a
+        // malformed pair would let two different corrupt digests compose the same published
+        // ETag, and the ETag is the change-token every client caches on.
+        hasher.update(unhex(hex)?);
+    }
+    Ok(format!(
+        "{}-{}",
+        hex_lower(&hasher.finalize()),
+        part_digests_hex.len()
+    ))
+}
+
+/// The `complete_fingerprint` — a digest over the *ordered* `(part_number, digest)` pairs
+/// the winning Complete named, so a tombstone answers an identical retry with `200` and a
+/// **different** assembly with `404 NoSuchUpload`.
+pub fn complete_fingerprint(named: &[(u32, String)]) -> String {
+    use sha2::{Digest, Sha256};
+    let mut hasher = Sha256::new();
+    for (number, digest) in named {
+        hasher.update(number.to_be_bytes());
+        hasher.update(digest.as_bytes());
+        hasher.update(b";");
+    }
+    hex_lower(&hasher.finalize())
+}
+
+/// Lowercase-hex encode.
+pub fn hex_lower(bytes: &[u8]) -> String {
+    let mut s = String::with_capacity(bytes.len() * 2);
+    for b in bytes {
+        s.push(char::from_digit((b >> 4) as u32, 16).unwrap_or('0'));
+        s.push(char::from_digit((b & 0x0f) as u32, 16).unwrap_or('0'));
+    }
+    s
+}
+
+/// Decode a **complete** lowercase-hex SHA-256 digest back to its 32 bytes.
+///
+/// Fail-closed on anything else (odd length, a non-hex nibble, the wrong width): these are
+/// digests *this* module wrote into `part:` records, so a malformed one means corruption, and
+/// silently dropping a bad pair would let two distinct corrupt digests compose one ETag
+/// (the rubric's *Absent or unsupported entries* rule — never a silent skip).
+fn unhex(text: &str) -> Result<Vec<u8>> {
+    let bad = || -> wyrd_traits::BoxError {
+        MultipartError::InvalidArgument(format!(
+            "`{text}` is not a 32-byte lowercase-hex SHA-256 digest"
+        ))
+        .into()
+    };
+    let raw = text.as_bytes();
+    if raw.len() != 64 {
+        return Err(bad());
+    }
+    let mut out = Vec::with_capacity(32);
+    // **Lowercase only.** `to_digit(16)` accepts `A`–`F` too, which would make `…AB` and `…ab`
+    // decode to the same bytes: two textually different stored digests would then compose the
+    // *same* published ETag, and a digest whose case the record contract forbids would be
+    // accepted rather than surfaced. The record contract is lowercase hex (ADR-0047), so this
+    // fails closed on anything else.
+    let digit = |b: u8| -> Option<u32> {
+        match b {
+            b'0'..=b'9' => Some(u32::from(b - b'0')),
+            b'a'..=b'f' => Some(u32::from(b - b'a') + 10),
+            _ => None,
+        }
+    };
+    for pair in raw.chunks(2) {
+        let hi = digit(pair[0]).ok_or_else(bad)?;
+        let lo = digit(pair[1]).ok_or_else(bad)?;
+        out.push(((hi << 4) | lo) as u8);
+    }
+    Ok(out)
+}
+
+// ---------------------------------------------------------------------------------------
+// Range encoding for part-number sets (`0016:382-388`): `[[1, 400]]` for a contiguous run,
+// so the common "every staged part was published" case is a few bytes and the worst case —
+// 10,000 alternating numbers — stays inside one value.
+// ---------------------------------------------------------------------------------------
+
+/// Range-encode a sorted, deduplicated part-number set.
+pub fn encode_part_ranges(sorted: &[u32]) -> Vec<(u32, u32)> {
+    let mut out: Vec<(u32, u32)> = Vec::new();
+    for &n in sorted {
+        match out.last_mut() {
+            Some(last) if last.1 + 1 == n => last.1 = n,
+            Some(last) if last.1 == n => {}
+            _ => out.push((n, n)),
+        }
+    }
+    out
+}
+
+/// Expand a range-encoded part-number set.
+pub fn expand_part_ranges(ranges: &[(u32, u32)]) -> Vec<u32> {
+    let mut out = Vec::new();
+    for &(lo, hi) in ranges {
+        for n in lo..=hi {
+            out.push(n);
+        }
+    }
+    out
+}
+
+// ---------------------------------------------------------------------------------------
+// Reads
+// ---------------------------------------------------------------------------------------
+
+/// Read a session record and the exact bytes it decoded from — the bytes every fenced CAS
+/// preconditions on.
+pub async fn read_session<S: MetadataStore + ?Sized>(
+    store: &S,
+    upload_id: &str,
+) -> Result<Option<(SessionRecord, Bytes)>> {
+    let key = mpu_key(upload_id);
+    let Some(bytes) = store.get(&key).await? else {
+        return Ok(None);
+    };
+    let record: SessionRecord = decode(&bytes)?;
+    Ok(Some((record, bytes)))
+}
+
+/// Read the admission record, or the `{ count: 0 }` an absent one reads as.
+pub async fn read_control<S: MetadataStore + ?Sized>(
+    store: &S,
+) -> Result<(MpuControl, Option<Bytes>)> {
+    match store.get(MPUCTL_KEY).await? {
+        Some(bytes) => {
+            let record: MpuControl = decode(&bytes)?;
+            Ok((record, Some(bytes)))
+        }
+        None => Ok((
+            MpuControl {
+                count: 0,
+                staged: 0,
+                max_sessions: max_sessions(),
+                max_records: max_records(),
+                profile: BudgetProfile::deployed(),
+            },
+            None,
+        )),
+    }
+}
+
+/// Every committed part **summary** of one session, ascending by part number — the bounded
+/// per-session range the cumulative staged check and `ListParts` read.
+pub async fn list_part_summaries<S: MetadataStore + ?Sized>(
+    store: &S,
+    upload_id: &str,
+) -> Result<Vec<(u32, PartSummary)>> {
+    let prefix = psum_prefix(upload_id);
+    let mut out = Vec::new();
+    for (key, value) in store.scan(&prefix).await? {
+        let number = require_scoped_number(&key, &prefix)?;
+        out.push((number, decode::<PartSummary>(&value)?));
+    }
+    out.sort_by_key(|(n, _)| *n);
+    Ok(out)
+}
+
+/// [`parse_scoped_number`], **fail-closed**: a key under one of this protocol's own prefixes
+/// that does not carry its trailing number is corruption or a foreign writer, never a record
+/// to skip.
+///
+/// Skipping it silently is the defect class this helper exists to remove: teardown would
+/// observe an empty staging set and delete a session whose byte-bearing residue is still
+/// there, and a retirement would delete a naming record it never orphan-marked from — durable
+/// bytes left unreferenced *and* unevidenced, which GC then retains forever (the rubric's
+/// *Absent or unsupported entries* rule).
+fn require_scoped_number(key: &[u8], prefix: &[u8]) -> Result<u32> {
+    parse_scoped_number(key, prefix).ok_or_else(|| {
+        MultipartError::InvalidArgument(format!(
+            "key `{}` under `{}` does not end in the number its record class requires",
+            String::from_utf8_lossy(key),
+            String::from_utf8_lossy(prefix)
+        ))
+        .into()
+    })
+}
+
+/// Every committed part **record** of one session, ascending by part number — the bounded
+/// per-session range Complete assembles from.
+pub async fn list_part_records<S: MetadataStore + ?Sized>(
+    store: &S,
+    upload_id: &str,
+) -> Result<Vec<(u32, PartRecord)>> {
+    let prefix = part_prefix(upload_id);
+    let mut out = Vec::new();
+    for (key, value) in store.scan(&prefix).await? {
+        let number = require_scoped_number(&key, &prefix)?;
+        out.push((number, decode::<PartRecord>(&value)?));
+    }
+    out.sort_by_key(|(n, _)| *n);
+    Ok(out)
+}
+
+/// Every session record in the store, by upload id — the reaper's and the staged reference
+/// build's one bounded scan (≤ `MAX_SESSIONS`).
+pub async fn list_sessions<S: MetadataStore + ?Sized>(
+    store: &S,
+) -> Result<Vec<(String, SessionRecord)>> {
+    let mut out = Vec::new();
+    for (key, value) in store.scan(MPU_PREFIX).await? {
+        // Fail closed on a key this protocol cannot have written: a skipped session is a
+        // session whose staged bytes leave the protection class while its records remain.
+        let id = std::str::from_utf8(key.strip_prefix(MPU_PREFIX).unwrap_or_default()).map_err(
+            |_| -> wyrd_traits::BoxError {
+                MultipartError::InvalidArgument(format!(
+                    "session key `{}` is not valid UTF-8",
+                    String::from_utf8_lossy(&key)
+                ))
+                .into()
+            },
+        )?;
+        out.push((id.to_string(), decode::<SessionRecord>(&value)?));
+    }
+    out.sort_by(|a, b| a.0.cmp(&b.0));
+    Ok(out)
+}
+
+/// One session's in-flight owned staging entries, each with its part number, chunk id and
+/// recorded placement — the bounded per-session `sidx:` range.
+pub async fn list_owned_staging<S: MetadataStore + ?Sized>(
+    store: &S,
+    upload_id: &str,
+) -> Result<Vec<(u32, ChunkId, PendingEntry)>> {
+    let prefix = sidx_prefix(upload_id);
+    let mut out = Vec::new();
+    for (key, value) in store.scan(&prefix).await? {
+        // **Fail closed, never skip.** This range is the exact set of byte-bearing residue,
+        // and it gates the terminal session delete: an entry silently skipped here lets
+        // teardown observe an empty set, delete the session, and leave those fragments with
+        // no record naming them and no obligation evidencing them.
+        let (part, chunk) = parse_sidx_suffix(&key, &prefix)?;
+        let entry = decode::<PendingEntry>(&value)?;
+        // The same rule for the **value**: an owned entry MUST carry its `staged` placement
+        // (`0016:353`, and `PendingEntry::owned` is the only writer). Without it the entry names
+        // no fragment position, so every consumer that resolves positions — the staged protection
+        // class the restore pass gates on, drain's held-fragment count, the retirement drain's
+        // orphan marks — would have to skip it, and a skipped entry's live fragments get
+        // orphan-marked by the next restore pass and deleted by the GC pass after it. Surfacing
+        // the malformed record is the only direction that cannot lose bytes.
+        if entry.staged.is_none() {
+            return Err(MultipartError::InvalidArgument(format!(
+                "owned staging entry `{}` carries no `staged` placement, so its fragment \
+                 positions cannot be resolved; refusing to treat it as absent",
+                String::from_utf8_lossy(&key)
+            ))
+            .into());
+        }
+        out.push((part, chunk, entry));
+    }
+    out.sort_by_key(|a| (a.0, a.1));
+    Ok(out)
+}
+
+/// Split a `sidx:<id>:<part>:<chunk>` key's `<part>:<chunk>` suffix, fail-closed.
+fn parse_sidx_suffix(key: &[u8], prefix: &[u8]) -> Result<(u32, ChunkId)> {
+    let bad = || -> wyrd_traits::BoxError {
+        MultipartError::InvalidArgument(format!(
+            "owned staging key `{}` does not have the `sidx:<id>:<part>:<chunk>` shape",
+            String::from_utf8_lossy(key)
+        ))
+        .into()
+    };
+    let rest = key.strip_prefix(prefix).ok_or_else(bad)?;
+    let text = std::str::from_utf8(rest).map_err(|_| bad())?;
+    let (part, chunk) = text.split_once(':').ok_or_else(bad)?;
+    let part = part.parse::<u32>().map_err(|_| bad())?;
+    let chunk = chunk.parse::<ChunkId>().map_err(|_| bad())?;
+    Ok((part, chunk))
+}
+
+/// One session's in-flight slots, by index.
+pub async fn list_slots<S: MetadataStore + ?Sized>(
+    store: &S,
+    upload_id: &str,
+) -> Result<Vec<(u32, SlotRecord, Bytes)>> {
+    let prefix = slot_prefix(upload_id);
+    let mut out = Vec::new();
+    for (key, value) in store.scan(&prefix).await? {
+        let index = require_scoped_number(&key, &prefix)?;
+        out.push((index, decode::<SlotRecord>(&value)?, value));
+    }
+    out.sort_by_key(|(i, _, _)| *i);
+    Ok(out)
+}
+
+// ---------------------------------------------------------------------------------------
+// Batches — §3's inventory. Each is O(1) in object size, byte- and operation-budgeted, and
+// carries the preconditions that make its replay a no-op rather than a double-apply.
+// ---------------------------------------------------------------------------------------
+
+/// **Create session.** One batch: the admission reservation (`require(mpuctl == prior)`
+/// with `prior.count < prior.max_sessions`, or `require_absent(mpuctl)` on a fresh store),
+/// `require_absent(mpu:<id>)`, and the **independent segment-group reservation**
+/// `require_absent(seggrp:<nonce>)` with its marker.
+///
+/// Admission is a *serialized reservation*, not a scan-then-create: ADR-0046 flagged the
+/// scan-then-commit emptiness check as race-prone, and a counter that concurrent creates
+/// could both read below the limit would admit past it.
+///
+/// A gateway whose local **profile** differs from the stored one refuses to admit and
+/// alarms: equal quotients can hide unequal footprints, so admission compares the profile,
+/// never the derived `max_sessions`.
+pub async fn create_session<S: MetadataStore + ?Sized>(
+    store: &S,
+    upload_id: &str,
+    session: &SessionRecord,
+) -> Result<CommitOutcome> {
+    let (control, prior_bytes) = read_control(store).await?;
+    let profile = BudgetProfile::deployed();
+    if let Some(bytes) = &prior_bytes {
+        if control.profile != profile {
+            tracing::warn!(
+                monotonic_counter.s3_multipart_admission_profile_mismatch = 1_u64,
+                "refusing to admit a multipart session: this gateway's budget profile differs \
+                 from the one recorded in `mpuctl`; a rolling configuration change must drain \
+                 the live population first"
+            );
+            return Err(MultipartError::SlowDown.into());
+        }
+        // **Both** bounds, each against the limit stored beside its count: the staged-reference
+        // memory budget, and the session-record population every bounded `scan("mpu:")` walks.
+        // Refusing on either is a retryable `503 SlowDown`, never a permanent state — the first
+        // clears as uploads finish, the second as #625's `W_tombstone` exit retires tombstones.
+        if control.staged >= control.max_sessions || control.count >= control.max_records {
+            tracing::warn!(
+                monotonic_counter.s3_multipart_admission_refused = 1_u64,
+                staged = control.staged,
+                max_sessions = control.max_sessions,
+                records = control.count,
+                max_records = control.max_records,
+                "refusing to admit a multipart session: the store is at an admission bound"
+            );
+            return Err(MultipartError::SlowDown.into());
+        }
+        let next = MpuControl {
+            count: control.count + 1,
+            staged: control.staged + 1,
+            ..control
+        };
+        let batch = WriteBatch::new()
+            .require(MPUCTL_KEY.to_vec(), bytes.clone())
+            .require_absent(mpu_key(upload_id))
+            .require_absent(seggrp_key(&session.group_nonce))
+            .put(MPUCTL_KEY.to_vec(), encode(&next))
+            .put(mpu_key(upload_id), encode(session))
+            .put(seggrp_key(&session.group_nonce), Bytes::from_static(b"1"));
+        return store.commit(batch).await;
+    }
+    // Bootstrap: a fresh or upgraded store adopts the first admitting gateway's derivation,
+    // and every later gateway is checked against it. No migration step.
+    let next = MpuControl {
+        count: 1,
+        staged: 1,
+        max_sessions: max_sessions(),
+        max_records: max_records(),
+        profile,
+    };
+    let batch = WriteBatch::new()
+        .require_absent(MPUCTL_KEY.to_vec())
+        .require_absent(mpu_key(upload_id))
+        .require_absent(seggrp_key(&session.group_nonce))
+        .put(MPUCTL_KEY.to_vec(), encode(&next))
+        .put(mpu_key(upload_id), encode(session))
+        .put(seggrp_key(&session.group_nonce), Bytes::from_static(b"1"));
+    store.commit(batch).await
+}
+
+/// **Part slot reserve.** `require(mpu == Open@E)` **and** `require_absent(slot:<id>:<k>)`
+/// for the chosen index. The authorization is the per-key `require_absent`, not the
+/// population read — concurrent reservers therefore cannot overshoot the cap, and a
+/// reserver that loses an index retries the next free one (≤ `MAX_INFLIGHT_PARTS` probes,
+/// a bound on probes rather than a retry loop against a contended key).
+///
+/// `Ok(None)` means every index is taken — the caller answers `SlowDown`. No slot can be
+/// reserved once the session leaves `Open`.
+pub async fn reserve_slot<S: MetadataStore + ?Sized>(
+    store: &S,
+    upload_id: &str,
+    session_bytes: &Bytes,
+    record: &SlotRecord,
+) -> Result<Option<u32>> {
+    let taken: Vec<u32> = list_slots(store, upload_id)
+        .await?
+        .into_iter()
+        .map(|(i, _, _)| i)
+        .collect();
+    for index in 0..MAX_INFLIGHT_PARTS {
+        if taken.contains(&index) {
+            continue;
+        }
+        let batch = WriteBatch::new()
+            .require(mpu_key(upload_id), session_bytes.clone())
+            .require_absent(slot_key(upload_id, index))
+            .put(slot_key(upload_id, index), encode(record));
+        match store.commit(batch).await {
+            Ok(CommitOutcome::Committed) => return Ok(Some(index)),
+            // Either the session left `Open@E` (the caller re-reads and answers by state) or
+            // another reserver won this index; try the next free one.
+            Ok(CommitOutcome::Conflict) => {
+                if read_session(store, upload_id)
+                    .await?
+                    .map(|(s, _)| !s.is_open())
+                    .unwrap_or(true)
+                {
+                    return Err(MultipartError::NoSuchUpload.into());
+                }
+            }
+            // **An indeterminate commit is settled by a re-read, never propagated blind**
+            // (`CommitUnknownResult`, `traits/src/lib.rs:730-745`). The reservation may have
+            // landed; returning the error would leak a slot this attempt owns — and a client
+            // retrying the refusal would consume every index and turn a usable session into a
+            // permanent `SlowDown`. The slot record names its own `attempt_id`, so the read
+            // distinguishes "mine, it landed" from "another attempt's".
+            Err(err) => {
+                let observed = store.get(&slot_key(upload_id, index)).await;
+                match observed {
+                    Ok(Some(bytes)) => match decode::<SlotRecord>(&bytes) {
+                        // Our own reservation did land: adopt it rather than leak it.
+                        Ok(found) if found.attempt_id == record.attempt_id => {
+                            return Ok(Some(index))
+                        }
+                        // Somebody else's — this index is taken, try the next free one.
+                        Ok(_) => continue,
+                        Err(decode_err) => return Err(decode_err),
+                    },
+                    // Provably absent: the commit did not land, so the original fault is the
+                    // truthful answer (the caller compensates nothing — nothing was written).
+                    Ok(None) => return Err(err),
+                    // The re-read itself failed: the store is unhealthy, surface the first fault.
+                    Err(_) => return Err(err),
+                }
+            }
+        }
+    }
+    Ok(None)
+}
+
+/// **Part intent** — the owned staging entry for one chunk. Preconditioned
+/// `require(mpu == Open@E)` so **none can be created after the session leaves `Open`**
+/// (which is what makes the teardown's `sidx:`-walked-empty gate a statement about a frozen
+/// set), `require(slot == prior)` on its own slot, and `require_absent(desired:dserver:<S>)`
+/// for every server in the placement it records — the **drain fence**.
+///
+/// The drain fence is a keyed precondition rather than a filtered selector because
+/// selection reads a topology *snapshot* while the intent that makes the placement
+/// observable commits later: a drain recorded inside that window escapes a filter entirely,
+/// the status reads `Satisfied`, the operator wipes the server, and only then does the
+/// intent land. With the precondition there are exactly two outcomes — the intent commits
+/// first (so the staged set counts those fragments as held and the status is `Pending`), or
+/// the drain record commits first (so the intent fails and the write path re-plans against
+/// the fresh topology). There is no third.
+///
+/// The owning slot is rewritten in the **same batch** as the lease it renews: creating a
+/// fresh live lease without touching the slot would let a reap fence that pinned the slot's
+/// bytes abort a progressing part.
+#[allow(clippy::too_many_arguments)]
+pub fn stage_chunk_batch(
+    upload_id: &str,
+    session_bytes: &Bytes,
+    slot_index: u32,
+    slot_bytes: &Bytes,
+    slot_next: &SlotRecord,
+    part_number: u32,
+    chunk: ChunkId,
+    entry: &PendingEntry,
+    placement: &[DServerId],
+) -> WriteBatch {
+    let mut batch = WriteBatch::new()
+        .require(mpu_key(upload_id), session_bytes.clone())
+        .require(slot_key(upload_id, slot_index), slot_bytes.clone())
+        .put(slot_key(upload_id, slot_index), encode(slot_next))
+        .put(sidx_key(upload_id, part_number, chunk), encode(entry));
+    for server in placement {
+        batch = batch.require_absent(crate::multipart::desired_dserver_key(*server));
+    }
+    batch
+}
+
+/// The desired-state ledger key a drain request writes
+/// (`crates/custodian/src/desired_state.rs:33-38`), mirrored here so the intent's drain
+/// fence names exactly the key the custodian writes. Duplicating the *format* rather than
+/// the *ownership* keeps the dependency direction right (`core` must not depend on
+/// `custodian`); the conformance of the two spellings is pinned by a test in the custodian
+/// crate.
+pub fn desired_dserver_key(server: DServerId) -> Vec<u8> {
+    format!("desired:dserver:{server}").into_bytes()
+}
+
+/// **Part commit** — the handoff that makes protection continuous. In *one* batch:
+/// `require(mpu == Open@E)`, the part record and its `psum:` summary, the keyed slot
+/// release, every owned `sidx:` delete for this attempt's chunks, and — on a **re-upload**
+/// of the same part number — a `retire:bytes:{chunks}` obligation naming the superseded
+/// attempt's chunks.
+///
+/// The `sidx:` deletes and the `part:` write ride together deliberately: the entry that
+/// protects the bytes is replaced by a record that protects the same bytes in the same
+/// batch, so there is never an instant at which a staged fragment is named by neither.
+/// Splitting them is the classic way to reopen the invariant.
+///
+/// A re-upload's superseded chunks route through `retire:bytes:` rather than being deleted:
+/// dropping the prior `part:` record without evidence would leave its fragments
+/// unreferenced **and** unevidenced, which GC conservatively retains forever — a silent
+/// leak, not a loud one.
+#[allow(clippy::too_many_arguments)]
+pub fn commit_part_batch(
+    upload_id: &str,
+    session_bytes: &Bytes,
+    epoch: u64,
+    slot_index: u32,
+    slot_bytes: &Bytes,
+    part_number: u32,
+    attempt_id: &str,
+    record: &PartRecord,
+    prior_part: Option<(&PartRecord, Bytes)>,
+    staged_chunks: &[ChunkId],
+) -> WriteBatch {
+    let summary = PartSummary {
+        chunks: record.chunks.len() as u64,
+        len: record.len,
+        digest: record.digest.clone(),
+        committed_at_millis: record.committed_at_millis,
+    };
+    let mut batch = WriteBatch::new()
+        .require(mpu_key(upload_id), session_bytes.clone())
+        .require(slot_key(upload_id, slot_index), slot_bytes.clone())
+        .delete(slot_key(upload_id, slot_index))
+        .put(part_key(upload_id, part_number), encode(record))
+        .put(psum_key(upload_id, part_number), encode(&summary));
+    match prior_part {
+        Some((prior, prior_bytes)) => {
+            batch = batch.require(part_key(upload_id, part_number), prior_bytes);
+            // The superseded attempt's bytes leave with EVIDENCE, never merely unreferenced.
+            let token = part_attempt_token(upload_id, epoch, part_number, attempt_id);
+            let obligation = RetireBytes::Chunks {
+                placements: prior
+                    .chunks
+                    .iter()
+                    .map(|c| StagedChunk {
+                        id: c.id,
+                        placement: c.placement.clone(),
+                    })
+                    .collect(),
+            };
+            batch = batch
+                .require_absent(retire_bytes_key(&token))
+                .put(retire_bytes_key(&token), encode(&obligation));
+        }
+        None => {
+            batch = batch.require_absent(part_key(upload_id, part_number));
+        }
+    }
+    for &chunk in staged_chunks {
+        batch = batch.delete(sidx_key(upload_id, part_number, chunk));
+    }
+    batch
+}
+
+/// **Live-session compensation** — a same-part losing writer *or* **any post-staging local
+/// refusal**. `retire:bytes:{chunks}` for the staged bytes, the keyed slot release, and this
+/// attempt's owned `sidx:` deletes, all under `require(mpu == Open@E)`.
+///
+/// Every refusal that happens *after* chunks are staged must compensate, not just return:
+/// returning `EntityTooLarge` and stopping strands the bytes, the `sidx:` records **and the
+/// slot** until the whole session is aborted — and a client that repeats the refusal (which
+/// "the session stays usable" positively invites) fills `MAX_INFLIGHT_PARTS` and turns a
+/// usable session into a permanent `SlowDown`.
+#[allow(clippy::too_many_arguments)]
+pub fn compensate_part_batch(
+    upload_id: &str,
+    session_bytes: &Bytes,
+    epoch: u64,
+    slot_index: u32,
+    slot_bytes: &Bytes,
+    part_number: u32,
+    attempt_id: &str,
+    staged: &[(ChunkId, Vec<DServerId>)],
+) -> WriteBatch {
+    let token = part_attempt_token(upload_id, epoch, part_number, attempt_id);
+    let obligation = RetireBytes::Chunks {
+        placements: staged
+            .iter()
+            .map(|(id, placement)| StagedChunk {
+                id: *id,
+                placement: placement.clone(),
+            })
+            .collect(),
+    };
+    let mut batch = WriteBatch::new()
+        .require(mpu_key(upload_id), session_bytes.clone())
+        .require(slot_key(upload_id, slot_index), slot_bytes.clone())
+        .delete(slot_key(upload_id, slot_index))
+        .require_absent(retire_bytes_key(&token))
+        .put(retire_bytes_key(&token), encode(&obligation));
+    for (chunk, _) in staged {
+        batch = batch.delete(sidx_key(upload_id, part_number, *chunk));
+    }
+    batch
+}
+
+/// **Complete fence** — `Open@E → Completing@E+1`, stamping `fenced_at_millis` and
+/// `publish_target`, under `require(mpu == Open@E)` and `attempts < MAX_COMPLETE_ATTEMPTS`.
+///
+/// Fencing **first**, before the part set is read, is what makes the single session
+/// precondition prove *the entire part set is exactly what Complete read*: every part
+/// commit carries `require(mpu == Open@E)`, so after the fence no `part:` record can be
+/// created, replaced or deleted. That is the same guarantee per-part preconditions would
+/// give, at O(1) batch size and with no serialization of concurrent part uploads — a read
+/// precondition does not write, so N concurrent part commits sharing one session
+/// precondition never conflict with each other.
+pub fn fence_complete_batch(
+    upload_id: &str,
+    session: &SessionRecord,
+    session_bytes: &Bytes,
+    target: PublishTarget,
+    now_millis: u64,
+) -> (WriteBatch, SessionRecord) {
+    let next = SessionRecord {
+        state: SessionState::Completing,
+        epoch: session.epoch + 1,
+        attempts: session.attempts + 1,
+        fenced_at_millis: Some(now_millis),
+        segments_written: Some(0),
+        publish_target: Some(target),
+        ..session.clone()
+    };
+    let batch = WriteBatch::new()
+        .require(mpu_key(upload_id), session_bytes.clone())
+        .put(mpu_key(upload_id), encode(&next));
+    (batch, next)
+}
+
+/// **Fence release** — `Completing@E → Open@E+1` for a lost publication CAS or a rejected
+/// request, installing `retire:records:{seg:<g>:<E>}` for any segments this attempt wrote.
+///
+/// A rejected request may never leave the session fenced: that would make a client typo
+/// indistinguishable from a crashed completer and wedge the upload until the reaper's
+/// `W_completing`.
+pub fn release_fence_batch(
+    upload_id: &str,
+    session: &SessionRecord,
+    session_bytes: &Bytes,
+) -> (WriteBatch, SessionRecord) {
+    let next = SessionRecord {
+        state: SessionState::Open,
+        epoch: session.epoch + 1,
+        fenced_at_millis: None,
+        segments_written: None,
+        publish_target: None,
+        ..session.clone()
+    };
+    let mut batch = WriteBatch::new()
+        .require(mpu_key(upload_id), session_bytes.clone())
+        .put(mpu_key(upload_id), encode(&next));
+    if session.segments_written.unwrap_or(0) > 0 {
+        let group = SegmentGroup {
+            nonce: session.group_nonce.clone(),
+            epoch: session.epoch,
+        };
+        let token = session_token(upload_id, session.epoch);
+        batch = batch.require_absent(retire_records_key(&token)).put(
+            retire_records_key(&token),
+            encode(&RetireRecords::Segments { group }),
+        );
+    }
+    (batch, next)
+}
+
+/// **Abort / reap fence** — `Open@E → Aborting@E+1` (or `Completing@E → Aborting@E+1` for
+/// the restore / residency / operator doors), installing `retire:bytes:{session, parts}` and,
+/// from `Completing`, `retire:records:{seg:<g>:<E>}` in the **same** batch.
+///
+/// One batch for all three `Completing` doors is deliberate: a restore-fenced attempt never
+/// flips a root, so nothing would ever adopt or retire its segments, and fencing it as if it
+/// were `Open` would leave those `seg:` records with **no deleter in the whole design**.
+///
+/// Abort's HTTP response is *this commit* — teardown is not on the request path, so Abort's
+/// latency does not scale with session size.
+pub fn abort_fence_batch(
+    upload_id: &str,
+    session: &SessionRecord,
+    session_bytes: &Bytes,
+) -> (WriteBatch, SessionRecord) {
+    let next = SessionRecord {
+        state: SessionState::Aborting,
+        epoch: session.epoch + 1,
+        ..session.clone()
+    };
+    let token = session_token(upload_id, session.epoch);
+    let mut batch = WriteBatch::new()
+        .require(mpu_key(upload_id), session_bytes.clone())
+        .put(mpu_key(upload_id), encode(&next))
+        .require_absent(retire_bytes_key(&token))
+        .put(
+            retire_bytes_key(&token),
+            encode(&RetireBytes::Session {
+                upload_id: upload_id.to_string(),
+                epoch: session.epoch,
+                parts: true,
+            }),
+        );
+    if session.state == SessionState::Completing && session.segments_written.unwrap_or(0) > 0 {
+        let group = SegmentGroup {
+            nonce: session.group_nonce.clone(),
+            epoch: session.epoch,
+        };
+        batch = batch.require_absent(retire_records_key(&token)).put(
+            retire_records_key(&token),
+            encode(&RetireRecords::Segments { group }),
+        );
+    }
+    (batch, next)
+}
+
+/// What the target key currently binds to, resolved fresh at **each** flip attempt.
+///
+/// `publish_target` names the *dirent identity*, never a frozen inode id: an inode id is
+/// minted per `create` and both keys are `require_absent`-guarded, so a concurrent
+/// delete-and-recreate of the same key rebinds it to a different inode, and a flip that
+/// reused a frozen id would recreate an unlinked inode and CAS a dirent that now names
+/// another one.
+pub enum FlipBinding {
+    /// The key is free: create a fresh inode under `require_absent` on **both** keys.
+    Fresh {
+        /// The freshly minted inode id.
+        inode: InodeId,
+    },
+    /// The key is bound: CAS the inode it names, with `version = prior.version + 1` from
+    /// **this** re-read prior. Both bindings are pinned — guarding only the inode would let
+    /// a `metadata::rename` move the dirent after Complete resolved it, and the flip would
+    /// then overwrite an inode now bound at another name while the client is told the
+    /// Complete succeeded.
+    Existing {
+        /// The inode the dirent names, re-read now.
+        inode: InodeId,
+        /// The dirent's exact current bytes.
+        dirent_bytes: Bytes,
+        /// The inode's exact current bytes.
+        inode_bytes: Bytes,
+        /// The prior record, whose `version + 1` this flip publishes and whose chunks the
+        /// generation obligation retires. Boxed so the `Fresh` arm — the common case, one
+        /// `InodeId` — does not carry a whole inode record's worth of padding.
+        prior: Box<crate::metadata::InodeRecord>,
+    },
+}
+
+/// The published map: flat, or a segmented root naming an already-durable segment group.
+pub enum PublishedMap {
+    /// A map that fits one value — today's shape, unchanged.
+    Flat(Vec<ChunkRef>),
+    /// A map too large for one value. The segments are **already committed** when the flip
+    /// runs, so the flip stays O(1) and cannot exceed the transaction envelope.
+    Segmented {
+        /// The segment group the root names.
+        group: SegmentGroup,
+        /// The root's segment table.
+        segments: Vec<SegmentRef>,
+    },
+}
+
+/// **Root flip (publication)** — the single fenced batch that makes the object visible.
+///
+/// `require(mpu == Completing@E)` rides in the *same* batch as the inode create/CAS and the
+/// session→`Completed` transition, so there is no state in which the object is published and
+/// the session is not `Completed`, or the reverse — which is what makes Complete idempotent
+/// over a batch primitive that is explicitly not.
+///
+/// The fence, not per-part preconditions, is what proves the part set did not move: N part
+/// values in one batch would exceed the envelope for a 10,000-part upload, and the fence
+/// gives the identical guarantee at O(1).
+///
+/// Two obligations may ride along, and they must not be able to race each other:
+/// `retire:records:{parts}` names **only the published parts**, while any staged part the
+/// client did *not* name goes wholly into `retire:bytes:{parts}` — which marks *then*
+/// deletes, one obligation with no cross-obligation dependency to get wrong. Naming all the
+/// parts in the records obligation would let it delete an unnamed part's record first, and
+/// that record is both the only thing protecting those chunks and the only source of their
+/// placements — so the byte obligation would have nothing to orphan-mark from: durable bytes
+/// left unreferenced **and** unevidenced, installed by the publication path itself.
+#[allow(clippy::too_many_arguments)]
+pub fn publish_batch(
+    upload_id: &str,
+    session: &SessionRecord,
+    session_bytes: &Bytes,
+    parent: InodeId,
+    name: &str,
+    binding: &FlipBinding,
+    map: &PublishedMap,
+    size: u64,
+    object_meta: &ObjectMeta,
+    published_parts: &[u32],
+    unnamed_parts: &[u32],
+    fingerprint: &str,
+    etag: &str,
+    now_millis: u64,
+) -> (WriteBatch, SessionRecord) {
+    let (chunk_map, segments) = match map {
+        PublishedMap::Flat(chunks) => (chunks.clone(), None),
+        PublishedMap::Segmented { group, segments } => {
+            (Vec::new(), Some((group.clone(), segments.clone())))
+        }
+    };
+    let (inode_id, version, mut batch) = match binding {
+        FlipBinding::Fresh { inode } => (
+            *inode,
+            1,
+            WriteBatch::new()
+                .require_absent(metadata::inode_key(*inode))
+                .require_absent(metadata::dirent_key(parent, name))
+                .put(
+                    metadata::dirent_key(parent, name),
+                    encode(&crate::metadata::DirentRecord { inode: *inode }),
+                ),
+        ),
+        FlipBinding::Existing {
+            inode,
+            dirent_bytes,
+            inode_bytes,
+            prior,
+        } => (
+            *inode,
+            prior.version + 1,
+            WriteBatch::new()
+                .require(metadata::dirent_key(parent, name), dirent_bytes.clone())
+                .require(metadata::inode_key(*inode), inode_bytes.clone()),
+        ),
+    };
+    let record = crate::metadata::InodeRecord {
+        size,
+        chunk_map,
+        state: crate::metadata::InodeState::Committed,
+        version,
+        etag: object_meta.etag.clone(),
+        content_type: object_meta.content_type.clone(),
+        modified: object_meta.modified,
+        segments: segments.map(|(group, segments)| SegmentedMap {
+            group,
+            segment_count: segments.len() as u32,
+            segments,
+        }),
+    };
+    batch = batch.put(metadata::inode_key(inode_id), encode(&record));
+
+    let next_session = SessionRecord {
+        state: SessionState::Completed,
+        epoch: session.epoch + 1,
+        published: Some(Published {
+            inode: inode_id,
+            version,
+            etag: etag.to_string(),
+            completed_at_millis: now_millis,
+        }),
+        complete_fingerprint: Some(fingerprint.to_string()),
+        ..session.clone()
+    };
+    batch = batch
+        .require(mpu_key(upload_id), session_bytes.clone())
+        .put(mpu_key(upload_id), encode(&next_session));
+
+    let token = session_token(upload_id, session.epoch);
+    if !published_parts.is_empty() {
+        batch = batch.require_absent(retire_records_key(&token)).put(
+            retire_records_key(&token),
+            encode(&RetireRecords::Parts {
+                upload_id: upload_id.to_string(),
+                parts: encode_part_ranges(published_parts),
+            }),
+        );
+    }
+    if !unnamed_parts.is_empty() {
+        batch = batch.require_absent(retire_bytes_key(&token)).put(
+            retire_bytes_key(&token),
+            encode(&RetireBytes::UnnamedParts {
+                upload_id: upload_id.to_string(),
+                epoch: session.epoch,
+                parts: encode_part_ranges(unnamed_parts),
+            }),
+        );
+    }
+    // The superseded generation's fan-out — up to ~1.78 M fragment orphans for a max
+    // segmented object — is installed as ONE small obligation atomically with the
+    // supersede, never expanded inline: expanding it would be a *permanent* failure to
+    // publish over a large object, not a slow one.
+    if let FlipBinding::Existing { inode, prior, .. } = binding {
+        let gen_token = generation_token(*inode, prior.version);
+        batch = batch.require_absent(retire_bytes_key(&gen_token)).put(
+            retire_bytes_key(&gen_token),
+            encode(&RetireBytes::Generation {
+                inode: *inode,
+                version: prior.version,
+                chunks: prior.chunk_map.clone(),
+                segments: prior.segments.as_ref().map(|s| s.group.clone()),
+            }),
+        );
+    }
+    (batch, next_session)
+}
+
+/// Add the **superseded-generation retirement** for `prior` to a batch that is removing or
+/// overwriting inode `inode` — the O(1) obligation form decision 4 requires for a generation
+/// whose map is not inline.
+///
+/// Returns `(batch, installed)`. `installed == true` means the caller must **not** expand the
+/// prior generation's orphans inline: this obligation now owns both halves of its reclamation
+/// (orphan-marking its fragments, at their *current* placement re-read at drain time, and
+/// deleting its `seg:` records in byte-budgeted batches). `installed == false` means the prior
+/// generation is an ordinary inline (flat) map, whose orphan expansion the caller writes into
+/// the same batch exactly as it always has.
+///
+/// **Why the split, and what it does not claim.** A *segmented* generation carries an
+/// intentionally **empty** `chunk_map`, so the inline expansion every delete/overwrite path
+/// does — walk `prior.chunk_map`, orphan each fragment — writes *no evidence at all* for it and
+/// leaves both its fragments and its `seg:` records with no deleter anywhere in the design: a
+/// permanent, silent leak of a whole object's bytes (`0016:2420-2431` §f). That is the failure
+/// this closes. A *flat* prior keeps the inline expansion: its fan-out is bounded by the
+/// published-map ceiling ([`MAX_MAP_CHUNKS`]), and routing it through the ledger would also
+/// defer every existing overwrite's reclamation by a drain pass — a behaviour change with no
+/// invariant to earn it.
+pub fn retire_prior_generation(
+    batch: WriteBatch,
+    inode: InodeId,
+    prior: &crate::metadata::InodeRecord,
+    _orphaned_at_millis: u64,
+) -> (WriteBatch, bool) {
+    let Some(map) = &prior.segments else {
+        return (batch, false);
+    };
+    let token = generation_token(inode, prior.version);
+    let obligation = RetireBytes::Generation {
+        inode,
+        version: prior.version,
+        // The segmented generation's chunks are named by its `seg:` records, not frozen here:
+        // the drain re-reads each record's CURRENT placement so a fragment a repoint moved
+        // before this batch won the inode CAS is orphaned where it actually is.
+        chunks: Vec::new(),
+        segments: Some(map.group.clone()),
+    };
+    let key = retire_bytes_key(&token);
+    // `require_absent` makes a retried delete/overwrite of the same generation idempotent
+    // rather than a second obligation.
+    (
+        batch
+            .require_absent(key.clone())
+            .put(key, encode(&obligation)),
+        true,
+    )
+}
+
+/// **Segment write** — one byte-budgeted batch of a segmented publication, under
+/// `require(mpu == Completing@E)`, advancing the segment-write cursor **inside** the session
+/// record the batch already preconditions on (so segmentation introduces no cursor record).
+///
+/// `B_seg = ⌊(E_tx/2)/V⌋` puts per batch, byte-derived and **not** a fixed count: a count of
+/// 1,000 applied to `V`-sized segment values would put 100 MB in one batch — 10× the
+/// envelope, a permanent commit failure.
+pub const B_SEG: usize = (TX_CEILING_BYTES / 2) / VALUE_CEILING_BYTES; // 50
+
+/// Build one segment-write batch covering `segments[from .. from + B_SEG]`.
+pub fn segment_write_batch(
+    upload_id: &str,
+    session: &SessionRecord,
+    session_bytes: &Bytes,
+    group: &SegmentGroup,
+    segments: &[SegmentRecord],
+    from: usize,
+) -> (WriteBatch, SessionRecord, usize) {
+    let end = (from + B_SEG).min(segments.len());
+    let next = SessionRecord {
+        segments_written: Some(end as u32),
+        ..session.clone()
+    };
+    let mut batch = WriteBatch::new()
+        .require(mpu_key(upload_id), session_bytes.clone())
+        .put(mpu_key(upload_id), encode(&next));
+    for (offset, record) in segments[from..end].iter().enumerate() {
+        batch = batch.put(
+            seg_key(&group.nonce, group.epoch, (from + offset) as u32),
+            encode(record),
+        );
+    }
+    (batch, next, end)
+}
+
+/// **Terminal session delete** — the exactly-once `mpuctl.count` decrement point.
+///
+/// Preconditioned on the session record's **exact prior bytes**, so a gateway draining
+/// inline and the reaper may both reach it but exactly one CAS succeeds and the loser's
+/// whole batch is a no-op: the counter can neither under-count a live session nor
+/// double-decrement a torn-down one.
+///
+/// The gate is the **empty `sidx:` range**, *not* an empty `slot:` range: a slot is held by
+/// a part that crashed mid-stream and never released it (residue is deliberately kept
+/// counted against the cap), so gating on slots would deadlock teardown. The `sidx:` range
+/// is the exact set of byte-bearing residue, and it is a *frozen* set — every intent carries
+/// `require(mpu == Open@E)`, so nothing can refill it after the fence.
+///
+/// The `seggrp:` marker is deleted **iff** the nonce's `seg:` range is empty (the group was
+/// never adopted). An adopted group's marker outlives the session, because its segments must
+/// survive for as long as the object they map.
+#[allow(clippy::too_many_arguments)]
+pub fn terminal_delete_batch(
+    upload_id: &str,
+    session: &SessionRecord,
+    session_bytes: &Bytes,
+    group_nonce: &str,
+    group_adopted: bool,
+    surviving_slots: &[u32],
+    control: &MpuControl,
+    control_bytes: &Bytes,
+) -> WriteBatch {
+    let next = MpuControl {
+        count: control.count.saturating_sub(1),
+        // The staged-reference slot goes only if this session still holds one: a `Completed`
+        // tombstone released it when its obligations drained ([`release_admission_batch`]), and
+        // decrementing again here would under-count and admit sessions past the `W_ref` budget.
+        // Read off the record's own bytes — the same bytes this batch preconditions on — so the
+        // decision cannot race the release.
+        staged: if session.admission_released == Some(true) {
+            control.staged
+        } else {
+            control.staged.saturating_sub(1)
+        },
+        ..control.clone()
+    };
+    let mut batch = WriteBatch::new()
+        .require(mpu_key(upload_id), session_bytes.clone())
+        .require(MPUCTL_KEY.to_vec(), control_bytes.clone())
+        .delete(mpu_key(upload_id))
+        .put(MPUCTL_KEY.to_vec(), encode(&next));
+    for &index in surviving_slots {
+        batch = batch.delete(slot_key(upload_id, index));
+    }
+    if !group_adopted {
+        batch = batch.delete(seggrp_key(group_nonce));
+    }
+    batch
+}
+
+/// **Staged-admission release** — the batch that returns a *tombstone's* `mpuctl.staged` slot
+/// once its obligations have drained and its `sidx:` range is observed empty, while leaving the
+/// `mpu:` record standing as the retry tombstone.
+///
+/// This is the wave-0 half of the decrement 0016 puts wholly in the terminal delete
+/// (`0016:673`). The terminal delete of a `Completed` session is #625's `W_tombstone` exit, so
+/// without this release a successful upload's staged-reference slot would never come back and a
+/// store would refuse every `CreateMultipartUpload` after ≈ `max_sessions` lifetime uploads. A
+/// tombstone owns no `part:`, `psum:` or `sidx:` record — nothing that spends `W_ref` — so
+/// releasing here charges the budget for exactly what it protects.
+///
+/// Exactly-once by the same construction as the terminal delete: `require(mpu == prior)` plus
+/// the `admission_released` marker written in the *same* batch, so a second releaser's
+/// precondition fails and the terminal delete that eventually runs reads the marker and does not
+/// decrement again. The epoch is bumped so the tombstone's two images are textually distinct.
+pub fn release_admission_batch(
+    upload_id: &str,
+    session: &SessionRecord,
+    session_bytes: &Bytes,
+    control: &MpuControl,
+    control_bytes: &Bytes,
+) -> WriteBatch {
+    let next_session = SessionRecord {
+        epoch: session.epoch + 1,
+        admission_released: Some(true),
+        ..session.clone()
+    };
+    let next_control = MpuControl {
+        staged: control.staged.saturating_sub(1),
+        ..control.clone()
+    };
+    WriteBatch::new()
+        .require(mpu_key(upload_id), session_bytes.clone())
+        .require(MPUCTL_KEY.to_vec(), control_bytes.clone())
+        .put(mpu_key(upload_id), encode(&next_session))
+        .put(MPUCTL_KEY.to_vec(), encode(&next_control))
+}
+
+// ---------------------------------------------------------------------------------------
+// Orphan evidence — decision 4.2's three-arm per-position guard.
+// ---------------------------------------------------------------------------------------
+
+/// The value of an `orphan:` mark. Three variants, because the deployed value is a **bare
+/// decimal** `orphaned_at_millis` (`crates/custodian/src/gc.rs:110-122`) and adding an event
+/// identity is a value-schema change with legacy data in the field.
+///
+/// Decoding is dual-format: a bare decimal is a **legacy** mark carrying no event identity;
+/// a structured value carries both. A legacy mark therefore takes the "different identity"
+/// arm and converts on contact, with no migration pass — the safe direction, since a fresh
+/// reader-grace window is strictly better than reclaiming against an ancient stamp.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct OrphanMark {
+    /// The grace clock GC evaluates.
+    pub orphaned_at_millis: u64,
+    /// The identity of the unreference event that wrote this mark. `None` for a legacy
+    /// bare-decimal mark.
+    pub event: Option<String>,
+}
+
+#[derive(Serialize, Deserialize)]
+struct OrphanMarkWire {
+    orphaned_at_millis: u64,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    event: Option<String>,
+}
+
+/// Decode an `orphan:` value in **both** formats. A value that parses as a bare decimal is a
+/// legacy mark and re-encodes as the *same* legacy value until an event replaces it, so an
+/// upgraded custodian that merely reads the ledger never restarts a grace clock.
+pub fn decode_orphan_mark(bytes: &[u8]) -> Option<OrphanMark> {
+    if let Ok(text) = std::str::from_utf8(bytes) {
+        if let Ok(millis) = text.trim().parse::<u64>() {
+            return Some(OrphanMark {
+                orphaned_at_millis: millis,
+                event: None,
+            });
+        }
+    }
+    let wire: OrphanMarkWire = serde_json::from_slice(bytes).ok()?;
+    Some(OrphanMark {
+        orphaned_at_millis: wire.orphaned_at_millis,
+        event: wire.event,
+    })
+}
+
+/// Encode a structured `orphan:` mark.
+pub fn encode_orphan_mark(mark: &OrphanMark) -> Bytes {
+    encode(&OrphanMarkWire {
+        orphaned_at_millis: mark.orphaned_at_millis,
+        event: mark.event.clone(),
+    })
+}
+
+/// Add the decision-4.2 per-position guard and mutation for one fragment position to
+/// `batch`, given what the writer **read** at that position.
+///
+/// * absent ⇒ write it under `require_absent`, stamped now;
+/// * present with the **same** event identity ⇒ a duplicate of *this* retirement (the
+///   second concurrent drainer) ⇒ **skip**, original stamp intact — re-stamping would push
+///   reclamation out by a full grace window per collision, unbounded under a persistent
+///   racer;
+/// * present with a **different** identity ⇒ stale evidence predating the reference this
+///   event just removed ⇒ **replace** under an exact-value `require`, starting a full grace
+///   window for the deletion that is actually happening now. `require_absent` would make the
+///   very replacement the stale-evidence rule demands impossible.
+///
+/// Conflating the two properties is what made the earlier blanket rule wrong in one
+/// direction while fixing it in the other.
+pub fn guard_orphan_mark(
+    batch: WriteBatch,
+    key: Vec<u8>,
+    observed: Option<&Bytes>,
+    event: &str,
+    now_millis: u64,
+) -> WriteBatch {
+    let next = encode_orphan_mark(&OrphanMark {
+        orphaned_at_millis: now_millis,
+        event: Some(event.to_string()),
+    });
+    match observed {
+        None => batch.require_absent(key.clone()).put(key, next),
+        Some(bytes) => match decode_orphan_mark(bytes) {
+            Some(mark) if mark.event.as_deref() == Some(event) => batch,
+            _ => batch.require(key.clone(), bytes.clone()).put(key, next),
+        },
+    }
+}
+
+// ---------------------------------------------------------------------------------------
+// The retirement drain — bounded, re-entrant, convergent.
+// ---------------------------------------------------------------------------------------
+
+/// What one [`drain_step`] did, so a caller can poll to a deadline rather than sleep.
+#[derive(Debug, Clone, Copy, Default, PartialEq, Eq)]
+pub struct DrainReport {
+    /// Obligations fully drained and removed this pass.
+    pub obligations_drained: usize,
+    /// `orphan:` marks written.
+    pub marks_written: usize,
+    /// Staging records deleted.
+    pub records_deleted: usize,
+    /// Sessions torn down (their terminal delete committed).
+    pub sessions_deleted: usize,
+    /// Tombstones whose staged-reference admission slot this pass returned.
+    pub admissions_released: usize,
+    /// Obligations still pending after this pass.
+    pub obligations_pending: usize,
+}
+
+/// Run the retirement drain to a bounded number of passes, returning the aggregate report.
+///
+/// The drain is **re-entrant and convergent without the reaper**: obligations are durable,
+/// orphan marking is guarded per position, and whichever party runs next re-derives the
+/// remaining work from the durable records. #625 supplies the crash-safe, out-of-band drain
+/// and every window-driven exit; this is the gateway's own inline, best-effort half.
+pub async fn drain<S: MetadataStore + ?Sized>(
+    store: &S,
+    now_millis: u64,
+    max_passes: usize,
+) -> Result<DrainReport> {
+    let mut total = DrainReport::default();
+    for _ in 0..max_passes {
+        let report = drain_step(store, now_millis).await?;
+        total.obligations_drained += report.obligations_drained;
+        total.marks_written += report.marks_written;
+        total.records_deleted += report.records_deleted;
+        total.sessions_deleted += report.sessions_deleted;
+        total.admissions_released += report.admissions_released;
+        total.obligations_pending = report.obligations_pending;
+        if report.obligations_drained == 0
+            && report.marks_written == 0
+            && report.records_deleted == 0
+            && report.sessions_deleted == 0
+            && report.admissions_released == 0
+        {
+            break;
+        }
+    }
+    Ok(total)
+}
+
+/// Drain **one named obligation**, to a bounded number of passes.
+///
+/// The whole-namespace [`drain`] is the right shape for a fence's teardown, where the work
+/// genuinely is "everything outstanding". It is the wrong shape for a caller that installed one
+/// obligation and needs *that* one gone before it answers: walking the (deliberately unbounded)
+/// `retire:` namespace couples that request's latency to every unrelated upload's backlog. This
+/// drains the single key and nothing else, so the cost is proportional to what the caller itself
+/// created. An obligation already gone reads as `Ok(default)` — a retry of a finished drain is a
+/// no-op, not an error.
+pub async fn drain_one<S: MetadataStore + ?Sized>(
+    store: &S,
+    key: &[u8],
+    now_millis: u64,
+    max_passes: usize,
+) -> Result<DrainReport> {
+    let mut total = DrainReport::default();
+    for _ in 0..max_passes {
+        let Some(value) = store.get(key).await? else {
+            return Ok(total);
+        };
+        let mut pass = DrainReport::default();
+        let drained = drain_obligation(store, key, &value, now_millis, &mut pass).await?;
+        total.obligations_drained += pass.obligations_drained;
+        total.marks_written += pass.marks_written;
+        total.records_deleted += pass.records_deleted;
+        if drained {
+            return Ok(total);
+        }
+        // No progress and not drained: a racing drainer holds it, or a guard needs re-reading.
+        // Leave it durable rather than spinning — the off-request drain and #625 re-derive it.
+        if pass.marks_written == 0 && pass.records_deleted == 0 {
+            total.obligations_pending += 1;
+            return Ok(total);
+        }
+    }
+    total.obligations_pending += 1;
+    Ok(total)
+}
+
+/// One bounded drain pass: walk the `retire:` namespace in cursor-keyed pages, drain each
+/// obligation in `B`-batches, then attempt every eligible session's terminal delete.
+pub async fn drain_step<S: MetadataStore + ?Sized>(
+    store: &S,
+    now_millis: u64,
+) -> Result<DrainReport> {
+    let mut report = DrainReport::default();
+    let mut cursor: Option<Vec<u8>> = None;
+    for _ in 0..DRAIN_PAGES_PER_STEP {
+        // `scan_page`, not `scan`: the `retire:` namespace is deliberately not
+        // cardinality-bounded, so a population grown past `SCAN_CAP` under sustained
+        // overwrites could not be enumerated by any single `scan` — and a skipped obligation
+        // retains its bytes and records forever.
+        let page = store
+            .scan_page(RETIRE_PREFIX, cursor.as_deref(), B_OPS)
+            .await?;
+        for (key, value) in &page.entries {
+            let progressed = drain_obligation(store, key, value, now_millis, &mut report).await?;
+            if !progressed {
+                report.obligations_pending += 1;
+            }
+        }
+        match page.next {
+            Some(next) => cursor = Some(next),
+            None => break,
+        }
+    }
+    let teardown = teardown_sessions(store).await?;
+    report.sessions_deleted += teardown.sessions_deleted;
+    report.admissions_released += teardown.admissions_released;
+    Ok(report)
+}
+
+/// Drain one obligation. Returns whether the obligation was fully drained and removed.
+async fn drain_obligation<S: MetadataStore + ?Sized>(
+    store: &S,
+    key: &[u8],
+    value: &Bytes,
+    now_millis: u64,
+    report: &mut DrainReport,
+) -> Result<bool> {
+    // The drain dispatches on the KEY prefix and treats a `retire:` key it cannot parse as
+    // an error, never as a default: `retire:bytes:` orphan-marks fragments while
+    // `retire:records:` must never orphan anything, so a mode misread once is silent data
+    // loss.
+    if let Some(rest) = key.strip_prefix(b"retire:bytes:".as_slice()) {
+        let token = String::from_utf8_lossy(rest).into_owned();
+        let payload: RetireBytes = decode(value)?;
+        return drain_bytes(store, key, value, &token, &payload, now_millis, report).await;
+    }
+    if let Some(rest) = key.strip_prefix(b"retire:records:".as_slice()) {
+        let token = String::from_utf8_lossy(rest).into_owned();
+        let payload: RetireRecords = decode(value)?;
+        return drain_records(store, key, value, &token, &payload, report).await;
+    }
+    Err(MultipartError::InvalidArgument(format!(
+        "unparsable retirement key `{}`",
+        String::from_utf8_lossy(key)
+    ))
+    .into())
+}
+
+/// One indivisible unit of retirement: the fragment positions to **evidence** and the naming
+/// records that may be deleted **once those positions carry evidence**.
+///
+/// Mark and delete ride in the *same* batch, which is what makes the drain both safe and
+/// re-entrant: there is no instant at which a durable byte is unprotected and unevidenced, and
+/// a unit whose record is already absent is provably one this obligation already evidenced (no
+/// other writer deletes these keys), so "absent" is a completed unit rather than a silent skip.
+struct RetirementUnit {
+    /// `(chunk, placement, fragment_count)` triples this unit's bytes live at.
+    positions: Vec<(ChunkId, Vec<DServerId>, u16)>,
+    /// The record keys this unit's evidence releases.
+    records: Vec<Vec<u8>>,
+}
+
+/// One mutation of a retirement, in the order safety requires: a chunk's fragment positions
+/// (each expanding to `fragment_count` `orphan:` marks) before the record deletions those marks
+/// authorize. [`commit_units`] fills batches from this stream, so a unit larger than one batch is
+/// split at a *safe* point rather than committed over budget.
+enum DrainOp {
+    /// Orphan-mark every fragment position of one chunk.
+    Mark((ChunkId, Vec<DServerId>, u16)),
+    /// Delete one naming record, authorized by the marks already committed before it.
+    Delete(Vec<u8>),
+}
+
+/// How many `B`-sized batches one obligation may spend in a single [`drain_step`].
+///
+/// The bound is what keeps a *pass* bounded rather than merely each batch: a maximum segmented
+/// generation names ~1.78 M fragment positions, and expanding all of them in one step is
+/// object-sized work inside one call (T4 review, `crates/core/src/multipart.rs:1977`). Each
+/// batch makes durable progress against **live** state, so the next pass resumes from a
+/// strictly smaller remainder — bounded work per pass *and* convergence, not one or the other.
+pub const DRAIN_BATCHES_PER_PASS: usize = 8;
+
+/// How many `retire:` pages one [`drain_step`] visits.
+///
+/// The `retire:` namespace is deliberately **not** cardinality-bounded, so "walk it to
+/// exhaustion in one pass" is unbounded work inside a single call — a spawned drain could then
+/// run arbitrarily long and `max_passes` would bound passes without bounding *work*. Each page
+/// is `B_OPS` obligations and each obligation's work is itself capped, so one step is bounded on
+/// both axes; the cursor is re-derived from live state next pass, so nothing is skipped.
+pub const DRAIN_PAGES_PER_STEP: usize = 8;
+
+/// Resolve one chunk reference's fragment positions, **strictly** (ADR-0045: liberal on read,
+/// strict in maintenance). An empty placement takes the authoritative identity fallback; a
+/// non-empty vector of the wrong length is corruption, and fabricating its missing tail here
+/// would orphan-mark — and then let GC delete — a fragment at a position no record names.
+fn strict_positions(
+    chunk: ChunkId,
+    placement: &[DServerId],
+    fragments: u16,
+) -> Result<(ChunkId, Vec<DServerId>, u16)> {
+    if !placement.is_empty() && placement.len() != fragments as usize {
+        return Err(MultipartError::InvalidArgument(format!(
+            "chunk {chunk} names {} placements for a {fragments}-fragment scheme; refusing to \
+             retire it against a fabricated placement",
+            placement.len()
+        ))
+        .into());
+    }
+    Ok((chunk, placement.to_vec(), fragments))
+}
+
+/// Collect the `(orphan-key, observed-value)` pairs for one unit's chunk placements.
+async fn observe_positions<S: MetadataStore + ?Sized>(
+    store: &S,
+    positions: &[(ChunkId, Vec<DServerId>, u16)],
+) -> Result<Vec<(Vec<u8>, Option<Bytes>)>> {
+    let mut out = Vec::new();
+    for (chunk, placement, fragments) in positions {
+        for index in 0..*fragments {
+            // The identity fallback applies only to an EMPTY vector, which
+            // `strict_positions` has already established.
+            let server = placement
+                .get(index as usize)
+                .copied()
+                .unwrap_or_else(|| DServerId::from(index));
+            let key = metadata::orphan_key(
+                server,
+                FragmentId {
+                    chunk: *chunk,
+                    index,
+                },
+            );
+            let observed = store.get(&key).await?;
+            out.push((key, observed));
+        }
+    }
+    Ok(out)
+}
+
+/// Drain a `retire:bytes:` obligation: **mark and release, atomically, unit by unit**.
+///
+/// Every unit's `orphan:` evidence and the record deletions it authorizes commit in ONE batch
+/// under `require(retire:… == prior)`, so protection is never lifted without evidence and a
+/// crash mid-drain loses nothing. Units are re-derived from **live** state each pass, so a
+/// pass that spends its budget leaves strictly less work than it found (the convergence
+/// property the paged branch used to lack).
+async fn drain_bytes<S: MetadataStore + ?Sized>(
+    store: &S,
+    key: &[u8],
+    value: &Bytes,
+    token: &str,
+    payload: &RetireBytes,
+    now_millis: u64,
+    report: &mut DrainReport,
+) -> Result<bool> {
+    let mut units: Vec<RetirementUnit> = Vec::new();
+    // A payload-derived unit whose positions must all be evidenced before the obligation may
+    // go: it does not shrink as the drain progresses, so it is walked (idempotently) each pass
+    // until it fits inside one pass's budget. Bounded by the 100 KB value ceiling — a few
+    // hundred chunks — so it always does.
+    let mut trailing_marker: Option<Vec<u8>> = None;
+    match payload {
+        RetireBytes::Session {
+            upload_id, parts, ..
+        } => {
+            for (part, chunk, entry) in list_owned_staging(store, upload_id).await? {
+                let (placement, fragments) = match entry.staged.as_ref() {
+                    Some(staged) => (staged.placement.clone(), staged.scheme.fragment_count()),
+                    // An owned entry with no recorded placement cannot be evidenced by
+                    // position at all. Refusing is the safe direction: the entry stays, the
+                    // obligation stays, and the state is visible rather than swallowed.
+                    None => {
+                        return Err(MultipartError::InvalidArgument(format!(
+                            "owned staging entry `{}` carries no placement, so its fragments \
+                             cannot be orphan-marked",
+                            String::from_utf8_lossy(&sidx_key(upload_id, part, chunk))
+                        ))
+                        .into())
+                    }
+                };
+                units.push(RetirementUnit {
+                    positions: vec![strict_positions(chunk, &placement, fragments)?],
+                    records: vec![sidx_key(upload_id, part, chunk)],
+                });
+            }
+            if *parts {
+                for (number, record) in list_part_records(store, upload_id).await? {
+                    units.push(part_unit(upload_id, number, &record)?);
+                }
+            }
+        }
+        RetireBytes::UnnamedParts {
+            upload_id, parts, ..
+        } => {
+            for number in expand_part_ranges(parts) {
+                // Absent means **already retired by this very obligation** — its mark and its
+                // record deletion committed together, and nothing else deletes an unnamed
+                // part's records (the published set rides `retire:records:{parts}`, disjoint
+                // by construction, `0016:X104`). So this is a finished unit, not a skipped one.
+                let Some(bytes) = store.get(&part_key(upload_id, number)).await? else {
+                    continue;
+                };
+                let record: PartRecord = decode(&bytes)?;
+                units.push(part_unit(upload_id, number, &record)?);
+            }
+        }
+        RetireBytes::Chunks { placements } => {
+            let mut positions = Vec::new();
+            for staged in placements {
+                let fragments = staged.placement.len().max(1) as u16;
+                positions.push(strict_positions(staged.id, &staged.placement, fragments)?);
+            }
+            units.push(RetirementUnit {
+                positions,
+                records: Vec::new(),
+            });
+        }
+        RetireBytes::Generation {
+            chunks, segments, ..
+        } => {
+            let mut positions = Vec::new();
+            for chunk in chunks {
+                positions.push(strict_positions(
+                    chunk.id,
+                    &chunk.placement,
+                    chunk.fragment_count(),
+                )?);
+            }
+            if !positions.is_empty() {
+                units.push(RetirementUnit {
+                    positions,
+                    records: Vec::new(),
+                });
+            }
+            if let Some(group) = segments {
+                // Re-read each `seg:` record's CURRENT placement at drain time, never a frozen
+                // one, so a fragment a repoint moved before the supersede won the inode CAS is
+                // orphaned at its current position. The range is bounded by
+                // `MAX_ROOT_SEGMENTS`, and it SHRINKS as segments are deleted, so this arm
+                // converges from live state.
+                let prefix = seg_prefix(&group.nonce, group.epoch);
+                for (seg_key_bytes, seg_value) in store.scan(&prefix).await? {
+                    let record: SegmentRecord = decode(&seg_value)?;
+                    let mut positions = Vec::new();
+                    for chunk in &record.chunks {
+                        positions.push(strict_positions(
+                            chunk.id,
+                            &chunk.placement,
+                            chunk.fragment_count(),
+                        )?);
+                    }
+                    units.push(RetirementUnit {
+                        positions,
+                        records: vec![seg_key_bytes],
+                    });
+                }
+                // The group marker goes with the LAST batch, once its `seg:` range is empty —
+                // an adopted group's marker must outlive its session, but a retired
+                // generation's must not outlive its segments (`0016:X109`).
+                trailing_marker = Some(seggrp_key(&group.nonce));
+            }
+        }
+    }
+    commit_units(
+        store,
+        key,
+        value,
+        Some(token),
+        units,
+        trailing_marker,
+        now_millis,
+        // Every arm above enumerates its whole (bounded, live) source range, so the derivation is
+        // complete by construction; the per-pass bound is `commit_units`' batch budget.
+        true,
+        report,
+    )
+    .await
+}
+
+/// The retirement unit for one committed `part:` record: its chunks' positions, and the
+/// `part:`/`psum:` pair its evidence releases.
+fn part_unit(upload_id: &str, number: u32, record: &PartRecord) -> Result<RetirementUnit> {
+    let mut positions = Vec::new();
+    for chunk in &record.chunks {
+        positions.push(strict_positions(
+            chunk.id,
+            &chunk.placement,
+            chunk.fragment_count(),
+        )?);
+    }
+    Ok(RetirementUnit {
+        positions,
+        records: vec![part_key(upload_id, number), psum_key(upload_id, number)],
+    })
+}
+
+/// Drain a `retire:records:` obligation — record deletions only, never an orphan mark.
+///
+/// The key list is derived from **live** state (the records that are still there), never from
+/// the immutable payload: a payload-derived list does not shrink as keys are deleted, so a
+/// paged branch over it would recompute and re-delete the same first `B` keys on every pass and
+/// never converge — the defect the sibling arms avoided by construction.
+async fn drain_records<S: MetadataStore + ?Sized>(
+    store: &S,
+    key: &[u8],
+    value: &Bytes,
+    _token: &str,
+    payload: &RetireRecords,
+    report: &mut DrainReport,
+) -> Result<bool> {
+    let mut units: Vec<RetirementUnit> = Vec::new();
+    // Whether this pass's derivation reached the end of the range it names. A `false` here
+    // forbids deleting the obligation, however much of the work commits.
+    let mut complete = true;
+    match payload {
+        RetireRecords::Parts { upload_id, parts } => {
+            // Walk the session's OWN `part:` range in cursor-keyed pages and keep the keys this
+            // obligation names. Deletion shrinks that range, so every pass observes strictly
+            // fewer named keys than the last and the walk terminates. `psum:` rides with its
+            // `part:` sibling, exactly as the publication wrote them.
+            let named: std::collections::BTreeSet<u32> =
+                expand_part_ranges(parts).into_iter().collect();
+            let prefix = part_prefix(upload_id);
+            let mut cursor: Option<Vec<u8>> = None;
+            'pages: loop {
+                let page = store.scan_page(&prefix, cursor.as_deref(), B_OPS).await?;
+                for (part_key_bytes, _) in &page.entries {
+                    let number = require_scoped_number(part_key_bytes, &prefix)?;
+                    if !named.contains(&number) {
+                        continue;
+                    }
+                    units.push(RetirementUnit {
+                        positions: Vec::new(),
+                        records: vec![part_key_bytes.clone(), psum_key(upload_id, number)],
+                    });
+                    // Enough work for one pass: stop paging rather than materializing a
+                    // 10,000-part range in memory to delete a bounded slice of it.
+                    //
+                    // **`complete = false` is load-bearing.** Truncating the derivation and then
+                    // letting `commit_units` believe it had seen every unit deleted the
+                    // obligation while the parts past the cut were still there — permanently
+                    // leaking every `part:`/`psum:` record of any Complete naming more parts
+                    // than one pass can delete (the ≥ 4,001-part case, i.e. the headline
+                    // `aws s3 cp` shape at the default chunk size). The flag makes the pass
+                    // *partial*: the remaining keys are re-derived, from a strictly smaller live
+                    // range, next pass.
+                    //
+                    // The cut is deliberately **below** what one pass can commit
+                    // (`DRAIN_BATCHES_PER_PASS` batches × ~`B_OPS/2` two-key units ≈ 4,000), so
+                    // the partial-derivation path is taken by every large drain rather than
+                    // being an unreachable branch that rots — and so the flag's absence is a
+                    // *test-visible* leak rather than one masked by whichever bound happens to
+                    // trip first.
+                    if units.len() >= DRAIN_BATCHES_PER_PASS * B_OPS / 4 {
+                        complete = false;
+                        break 'pages;
+                    }
+                }
+                match page.next {
+                    Some(next) => cursor = Some(next),
+                    None => break,
+                }
+            }
+        }
+        RetireRecords::Segments { group } => {
+            let prefix = seg_prefix(&group.nonce, group.epoch);
+            for (seg_key_bytes, _) in store.scan(&prefix).await? {
+                units.push(RetirementUnit {
+                    positions: Vec::new(),
+                    records: vec![seg_key_bytes],
+                });
+            }
+        }
+    }
+    commit_units(store, key, value, None, units, None, 0, complete, report).await
+}
+
+/// Commit a set of [`RetirementUnit`]s in `B`-bounded batches under
+/// `require(retire:… == prior)`, deleting the obligation itself in the final batch **iff** the
+/// derivation was complete *and* every unit it produced was committed.
+///
+/// `event` is `Some(token)` for a `retire:bytes:` obligation (whose units carry orphan marks)
+/// and `None` for a `retire:records:` one, which must never write an orphan mark: the
+/// distinction is a parameter rather than a convention so the two modes cannot drift.
+///
+/// `derivation_complete` is `false` when the caller stopped enumerating early (a bounded page
+/// walk over a range larger than one pass may delete). The obligation may then **not** be
+/// deleted whatever this pass commits — deleting it would drop every record the derivation never
+/// reached, with nothing left naming them.
+///
+/// **The budget is counted in mutations, not units.** One position expands to one `orphan:` mark
+/// per *fragment*, so a 156-chunk RS(6,3) part is 1,404 marks — past `B_OPS` on its own. Units
+/// are therefore **splittable across batches**, with the rule that a unit's record deletions ride
+/// in the batch that completes its marks: batches commit in order and a failed commit stops the
+/// walk, so a record is never deleted before the evidence authorizing it is durable. Treating a
+/// unit as indivisible instead made a legal maximal part's teardown a single over-budget batch
+/// that could never commit — an undrainable obligation, i.e. a permanent leak.
+#[allow(clippy::too_many_arguments)]
+async fn commit_units<S: MetadataStore + ?Sized>(
+    store: &S,
+    key: &[u8],
+    value: &Bytes,
+    event: Option<&str>,
+    units: Vec<RetirementUnit>,
+    trailing_marker: Option<Vec<u8>>,
+    now_millis: u64,
+    derivation_complete: bool,
+    report: &mut DrainReport,
+) -> Result<bool> {
+    // Flatten the units into an ordered mutation stream: every position of a unit, then that
+    // unit's record deletions. Order is what makes a split safe.
+    let mut queued: std::collections::VecDeque<DrainOp> = std::collections::VecDeque::new();
+    for unit in units {
+        for position in unit.positions {
+            queued.push_back(DrainOp::Mark(position));
+        }
+        for record in unit.records {
+            queued.push_back(DrainOp::Delete(record));
+        }
+    }
+    let mut batches = 0usize;
+    let mut progressed = false;
+    let mut exhausted = derivation_complete;
+    while !queued.is_empty() {
+        if batches == DRAIN_BATCHES_PER_PASS {
+            // Budget spent. The remaining work is re-derived (smaller) next pass.
+            exhausted = false;
+            break;
+        }
+        let mut batch = WriteBatch::new().require(key.to_vec(), value.clone());
+        // The obligation's own precondition is an operation too: `B_ops` is calibrated against a
+        // batch's **sequential in-transaction round trips**, and FoundationDB awaits every
+        // precondition read while TiKV awaits each `get_for_update` (`0016:1475`) — so a
+        // precondition costs exactly what a mutation costs.
+        let mut mutations = 1usize;
+        let mut marks = 0usize;
+        let mut deletes = 0usize;
+        // Fill this batch to the **operation** budget, counting each fragment position it will
+        // mark (not each chunk) and each position's guard alongside its put: `guard_orphan_mark`
+        // adds a `require`/`require_absent` per position, so a mark is two operations, and
+        // counting only the puts let a "1,000-operation" batch carry 2,001.
+        while let Some(op) = queued.front() {
+            let cost = match op {
+                DrainOp::Mark((_, _, fragments)) => 2 * (*fragments as usize),
+                DrainOp::Delete(_) => 1,
+            };
+            if mutations > 1 && mutations + cost > B_OPS {
+                break;
+            }
+            match queued.pop_front().expect("peeked") {
+                DrainOp::Mark(position) => {
+                    if let Some(event) = event {
+                        for (key, current) in
+                            observe_positions(store, std::slice::from_ref(&position)).await?
+                        {
+                            let before = batch.puts.len();
+                            batch =
+                                guard_orphan_mark(batch, key, current.as_ref(), event, now_millis);
+                            if batch.puts.len() != before {
+                                marks += 1;
+                            }
+                        }
+                    }
+                }
+                DrainOp::Delete(record) => {
+                    batch = batch.delete(record);
+                    deletes += 1;
+                }
+            }
+            mutations += cost;
+        }
+        let last = queued.is_empty() && exhausted;
+        if last {
+            if let Some(marker) = &trailing_marker {
+                batch = batch.delete(marker.clone());
+            }
+            batch = batch.delete(key.to_vec());
+        }
+        if store.commit(batch).await? != CommitOutcome::Committed {
+            // A guard loss (a racing drainer, or a mark this pass observed stale): re-derive
+            // and re-split next pass, marking strictly fewer positions each round.
+            return Ok(false);
+        }
+        report.marks_written += marks;
+        report.records_deleted += deletes;
+        progressed = progressed || marks > 0 || deletes > 0;
+        batches += 1;
+        if last {
+            report.obligations_drained += 1;
+            return Ok(true);
+        }
+    }
+    if !exhausted {
+        return Ok(progressed);
+    }
+    // Nothing left to release **and** the derivation saw everything: retire the obligation itself
+    // (with the group marker, if this generation owned one) in one final O(1) batch.
+    let mut batch = WriteBatch::new()
+        .require(key.to_vec(), value.clone())
+        .delete(key.to_vec());
+    if let Some(marker) = trailing_marker {
+        batch = batch.delete(marker);
+    }
+    if store.commit(batch).await? == CommitOutcome::Committed {
+        report.obligations_drained += 1;
+        return Ok(true);
+    }
+    Ok(progressed)
+}
+
+/// Attempt the terminal delete of every session whose obligations have drained and whose
+/// `sidx:` range is observed empty **in this pass**.
+async fn teardown_sessions<S: MetadataStore + ?Sized>(store: &S) -> Result<TeardownReport> {
+    let mut report = TeardownReport::default();
+    for (upload_id, session) in list_sessions(store).await? {
+        match session.state {
+            // Fenced and draining: this pass may reach its terminal delete.
+            SessionState::Aborting => {}
+            // A `Completed` session survives as a tombstone until `W_tombstone` elapses (#625's
+            // exit), but its **staged-admission slot** must come back as soon as it stops owning
+            // staged records — otherwise a store admits only `max_sessions` lifetime uploads.
+            SessionState::Completed if session.admission_released != Some(true) => {}
+            // Already released, or `Open`/`Completing` (not fenced): nothing to do.
+            _ => continue,
+        }
+        // Two bounded emptiness reads over the session's OWN obligation ranges — never a
+        // walk of the whole `retire:` namespace. A `g:` obligation belongs to the
+        // generation, not the session, so the gate ignores it.
+        if !store
+            .scan(&retire_bytes_session_prefix(&upload_id))
+            .await?
+            .is_empty()
+            || !store
+                .scan(&retire_records_session_prefix(&upload_id))
+                .await?
+                .is_empty()
+        {
+            continue;
+        }
+        if !list_owned_staging(store, &upload_id).await?.is_empty() {
+            continue;
+        }
+        // Re-read the session: the gates above were evaluated against the scan's image, and the
+        // batch below preconditions on *these* bytes — and, for the tombstone arm, decides on
+        // this record's own `admission_released` marker.
+        let Some((session, session_bytes)) = read_session(store, &upload_id).await? else {
+            continue;
+        };
+        let (control, control_bytes) = read_control(store).await?;
+        let Some(control_bytes) = control_bytes else {
+            continue;
+        };
+        if session.state == SessionState::Completed {
+            // The tombstone keeps its `mpu:` record (a retry inside `W_tombstone` must still
+            // answer `200` with the recorded ETag) and gives back only its staged-reference slot.
+            if session.admission_released == Some(true) {
+                continue;
+            }
+            let batch = release_admission_batch(
+                &upload_id,
+                &session,
+                &session_bytes,
+                &control,
+                &control_bytes,
+            );
+            if store.commit(batch).await? == CommitOutcome::Committed {
+                report.admissions_released += 1;
+            }
+            continue;
+        }
+        let surviving: Vec<u32> = list_slots(store, &upload_id)
+            .await?
+            .into_iter()
+            .map(|(i, _, _)| i)
+            .collect();
+        let adopted = !store
+            .scan(&format!("seg:{}:", session.group_nonce).into_bytes())
+            .await?
+            .is_empty();
+        let batch = terminal_delete_batch(
+            &upload_id,
+            &session,
+            &session_bytes,
+            &session.group_nonce,
+            adopted,
+            &surviving,
+            &control,
+            &control_bytes,
+        );
+        if store.commit(batch).await? == CommitOutcome::Committed {
+            report.sessions_deleted += 1;
+        }
+    }
+    Ok(report)
+}
