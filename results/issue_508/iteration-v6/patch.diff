+/// What one [`teardown_sessions`] walk committed — the two terminal actions a fenced or
+/// published session's records reach, counted separately so a caller polling for either sees
+/// progress.
+#[derive(Debug, Default, Clone, Copy)]
+struct TeardownReport {
+    sessions_deleted: usize,
+    admissions_released: usize,
+}
