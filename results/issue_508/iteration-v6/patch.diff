+        let page = store.scan_page(b"pg:", cursor.as_deref(), 2).await.unwrap();
+        pages += 1;
+        assert!(pages <= 8, "the paged walk must terminate");
+        for (key, _) in &page.entries {
+            if let Some(cursor) = &cursor {
+                assert!(
+                    key > cursor,
+                    "`after` is EXCLUSIVE: a page starts strictly after that key"
+                );
+            }
+            walked.push(key.clone());
+        }
