+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+pub struct StagedChunk {
+    /// The chunk id.
+    pub id: ChunkId,
+    /// The planned EC placement, one D-server id per fragment index.
+    pub placement: Vec<DServerId>,
+}
