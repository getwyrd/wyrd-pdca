+    /// When the slot was claimed — a progress instant the reaper reads.
+    pub reserved_at_millis: u64,
+    /// Liveness for a part that has reserved but not yet written its first chunk, renewed
+    /// in flight by the same half-TTL loop that renews the owned `sidx:` leases.
+    pub lease_expiry_millis: u64,
+}
