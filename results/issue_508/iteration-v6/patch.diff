+    /// A drain **step** is bounded — one pass leaves work behind rather than walking an
+    /// arbitrarily large obligation to exhaustion — and repeated passes converge.
+    ///
+    /// The bound is asserted where it is actually reachable: the *per-obligation* batch budget
+    /// (`DRAIN_BATCHES_PER_PASS`), not the page budget. A previous version of this test seeded 64
+    /// obligations against an 8,000-obligation page budget and asserted only "some progress", so it
+    /// would have passed against an unbounded step — the property was never exercised.
+    #[test]
+    fn one_drain_step_is_bounded_and_repeated_steps_converge() {
+        let store = RedbMetadataStore::in_memory().expect("redb");
+        // One obligation whose live population needs MORE than one pass's batches:
+        // `DRAIN_BATCHES_PER_PASS × B_OPS` mutations is the per-pass ceiling, and each part costs
+        // two record deletions, so 2 × `DRAIN_BATCHES_PER_PASS` × `B_OPS` parts is comfortably past
+        // it while staying inside S3's 10,000-part limit.
