+    // `?uploads` is the session-creation marker and combines with nothing else.
+    if uploads.is_some() {
+        if upload_id.is_some() || part_number.is_some() {
+            return MultipartForm::Invalid(
+                "`uploads` cannot be combined with `uploadId` or `partNumber`",
+            );
+        }
+        return match *method {
+            Method::POST => MultipartForm::Create,
+            _ => MultipartForm::Invalid("`?uploads` on an object path is a POST"),
+        };
+    }
+    let Some(id) = upload_id else {
+        // A `partNumber` with no `uploadId` names no upload at all.
+        return MultipartForm::Invalid("`partNumber` requires `uploadId`");
+    };
+    if !well_formed_upload_id(&id) {
+        return MultipartForm::Invalid("`uploadId` is not a well-formed upload id");
+    }
+    match part_number {
+        Some(raw) => {
+            let Ok(number) = raw.parse::<u32>() else {
+                return MultipartForm::Invalid("`partNumber` is not a number");
+            };
+            match *method {
+                Method::PUT => MultipartForm::UploadPart {
+                    part_number: number,
+                    upload_id: id,
+                },
+                _ => MultipartForm::Invalid("`partNumber` with `uploadId` is a PUT (UploadPart)"),
+            }
+        }
+        None => match *method {
+            Method::POST => MultipartForm::Complete { upload_id: id },
+            Method::DELETE => MultipartForm::Abort { upload_id: id },
+            Method::GET | Method::HEAD => {
+                let after = match query_param(query, "part-number-marker") {
+                    Some(raw) => match percent_decode_utf8(&raw).parse::<u32>() {
+                        Ok(n) => Some(n),
+                        Err(_) => {
+                            return MultipartForm::Invalid("`part-number-marker` is not a number")
+                        }
+                    },
+                    None => None,
+                };
+                let max = match query_param(query, "max-parts") {
+                    Some(raw) => match percent_decode_utf8(&raw).parse::<usize>() {
+                        Ok(n) => n.clamp(1, 1000),
+                        Err(_) => return MultipartForm::Invalid("`max-parts` is not a number"),
+                    },
+                    None => 1000,
+                };
