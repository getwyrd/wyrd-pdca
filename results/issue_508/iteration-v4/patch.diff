index 0000000..fb8baad
--- /dev/null
+++ b/crates/core/src/multipart.rs
@@ -0,0 +1,2357 @@
+//! The **multipart commit protocol** — the record model and the fenced batches that
+//! publish, protect and reclaim an *assembled write* (proposal 0016, issue #508).
+//!
+//! An assembled write is a write whose durable staging outlives any single request or
+//! lease window. Everything the ordinary streaming write path relies on breaks for it:
+//! publication is proved today by *lease liveness* (`metadata::live_lease_guards`), the
+//! maintenance planes gate on committed inode state only, records are assumed small, and
+//! batches are explicitly non-idempotent. This module replaces each of those with the
+//! mechanism 0016 settles:
+//!
+//! * **publication proof** — a *fence* on the session record, not a timer (decision 1);
+//! * **protection class** — durable-but-unpublished bytes are named by `part:` records
+//!   and in-flight owned `sidx:` staging entries, both members of the custodian's staged
+//!   reference set (decision 2);
+//! * **lifecycle** — a state machine no state of which is absorbing (decision 3);
+//! * **bounded work** — a `retire:` ledger drained in byte- and operation-budgeted
+//!   batches, never an inline fan-out (decision 4);
+//! * **reclamation evidence** — every release path *writes* the `orphan:` evidence GC
+//!   needs before it lifts protection (decision 5);
+//! * **admission** — a serialized `mpuctl` reservation (decision 6, protocol half).
+//!
+//! The one invariant every routine here exists to hold: **every durable byte written by
+//! an assembled write is, at every instant, either protected by a record that names it or
+//! evidenced for reclamation, and no state of an upload session is absorbing.** Both
+//! directions bind — retaining unconditionally leaks forever, and unprotecting without
+//! evidence leaks forever *silently*, because GC conservatively retains an unevidenced
+//! fragment (`crates/custodian/src/gc.rs:158-190`) rather than reclaiming it.
+//!
+//! This module names no S3 vocabulary: it is the protocol underneath the verbs, and the
+//! S3 wire surface (status codes, XML, routing) is `wyrd-gateway-s3`'s.
+
+use bytes::Bytes;
+use serde::{Deserialize, Serialize};
+use wyrd_traits::{
+    ChunkId, CommitOutcome, DServerId, FragmentId, MetadataStore, Result, WriteBatch, SCAN_CAP,
+};
+
+use crate::metadata::{self, decode, encode, ChunkRef, InodeId, ObjectMeta, PendingEntry};
+
+// ---------------------------------------------------------------------------------------
+// Budget profile — the knob values this slice owns (0016 decision 4's knob table,
+// `0016:1462-1479`). Each value is INSIDE the range 0016 settles and the range is cited at
+// its definition, so a later reader can check it without re-deriving the arithmetic.
+// ---------------------------------------------------------------------------------------
+
+/// The backend **value** ceiling the store envelope inherits (FoundationDB's, the tightest
+/// in play — `crates/traits/src/lib.rs:744-758`). Every `MAX_*_CHUNKS` below is derived
+/// against `VALUE_CEILING_BYTES / 2`, the 2× headroom 0016 requires.
+pub const VALUE_CEILING_BYTES: usize = 100_000;
+
+/// The per-**transaction** byte ceiling (10 MB, same envelope). Batches are budgeted at
+/// `E_tx / 2` (`0016:621-652`).
+pub const TX_CEILING_BYTES: usize = 10_000_000;
+
+/// Worst-case encoded size of one [`ChunkRef`] (~302 B at `u64` D-server ids, `0016:1051`).
+const MAX_CHUNKREF_BYTES: usize = 302;
+
+/// Worst-case encoded size of one [`SegmentRef`] (~160 B, `0016:2432`).
+const MAX_SEGREF_BYTES: usize = 160;
+
+/// Chunks a **flat** inode map may hold. Range (`0016:1464`): `> 0` and
+/// `max_chunkref_bytes × MAX_MAP_CHUNKS ≤ V/2` ⇒ 165–381; this slice takes the
+/// worst-case-encoding end (165) so the bound holds for *every* D-server id width.
+pub const MAX_MAP_CHUNKS: usize = (VALUE_CEILING_BYTES / 2) / MAX_CHUNKREF_BYTES; // 165
+
+/// Chunks one `seg:` record may hold — the identical rule one record class down
+/// (`0016:1465`).
+pub const MAX_SEG_CHUNKS: usize = MAX_MAP_CHUNKS;
+
+/// Chunks one `part:` record may hold. Range (`0016:1466`): identical to
+/// [`MAX_MAP_CHUNKS`] (a `part:` record is one value), **and** `≤ B_OPS` — a part commit is
+/// an *unsplittable* batch deleting up to this many `sidx:` entries, so a value above the
+/// operation budget would make a valid part's commit *and* its compensation time out
+/// permanently (X110).
+pub const MAX_PART_CHUNKS: usize = MAX_MAP_CHUNKS;
+
+/// Segments a segmented root may name. Range (`0016:1467`): `> 0` and
+/// `max_segref_bytes × MAX_ROOT_SEGMENTS ≤ V/2` ⇒ 312–520; worst-case end again.
+pub const MAX_ROOT_SEGMENTS: usize = (VALUE_CEILING_BYTES / 2) / MAX_SEGREF_BYTES; // 312
+
+/// Chunk-refs one session may hold in committed `part:` records. Range (`0016:1468`):
+/// `[MAX_PART_CHUNKS, MAX_ROOT_SEGMENTS × MAX_SEG_CHUNKS]`, settled value the upper end —
+/// the publishable segmented ceiling, so a session cannot stage more than it could publish.
+pub const MAX_STAGED_CHUNKS: usize = MAX_ROOT_SEGMENTS * MAX_SEG_CHUNKS; // 51_480
+
+/// S3's part-number ceiling (`0016:2446`).
+pub const MAX_PARTS_PER_SESSION: u32 = 10_000;
+
+/// The operation-count half of the batch budget `B = min(B_bytes, B_ops)` (`0016:1475`) —
+/// calibrated so a batch's sequential in-transaction round trips fit the 5-second half of
+/// the envelope on the slowest supported backend. This is the value #625 consumes
+/// unchanged; see the module note on split budget authority.
+pub const B_OPS: usize = 1_000;
+
+/// The byte half of the batch budget: `⌊(E_tx/2) / (bytes per mutation)⌋` for a *small*
+/// mutation (an `orphan:` mark). `B` for a larger mutation is recomputed per call site.
+pub const B_BYTES_SMALL: usize = (TX_CEILING_BYTES / 2) / 5_000;
+
+/// Parts one session may have in flight. Range (`0016:1471`): `[1, min(
+/// MAX_PARTS_PER_SESSION, ⌊SCAN_CAP/(2·MAX_PART_CHUNKS)⌋, ⌊(E_tx/2)/(slot key bytes)⌋,
+/// B_ops )]` — four clamps, all satisfied by 16 (the value defines the `slot:` key space,
+/// so the per-session in-flight bound is *structural*).
+pub const MAX_INFLIGHT_PARTS: u32 = 16;
+
+/// The reconcile pass's staged-reference **memory** budget in chunk-refs. 0016's worked
+/// example (`0016:2129`) and the value #625 consumes unchanged.
+pub const W_REF: u64 = 4_000_000;
+
+/// Publication-CAS retries inside one Complete attempt. Range (`0016:1476`): `[1, small]`.
+pub const R_PUBLISH: usize = 4;
+
+/// Complete fences one session may take. Range (`0016:1477`): `[1, small]` — each fence
+/// mints a `Completing@E` epoch whose rolled-back segments become one obligation, so an
+/// unbounded fence/rollback cycle would install obligations without bound.
+pub const MAX_COMPLETE_ATTEMPTS: u32 = 8;
+
+/// S3's minimum size for a **non-final** part.
+pub const MIN_PART_BYTES: u64 = 5 * 1024 * 1024;
+
+/// The gateway's default chunk size, mirrored here so the sizing formulas of decision 7
+/// (`0016:2299-2309`) have one definition. Matches `crates/server/src/lib.rs:51`.
+pub const DEFAULT_CHUNK_SIZE: usize = 1 << 20;
+
+/// The largest chunk size a deployment will select. Decision 7's configuration
+/// precondition (`0016:2300-2309`) requires `chunk_size_max ≥ ⌈5 GiB / MAX_MAP_CHUNKS⌉`
+/// ≈ 31.03 MiB; 64 MiB satisfies it with margin and stays inside the gateway memory budget
+/// (`chunk_size × max_concurrent_encodes`).
+pub const CHUNK_SIZE_MAX: usize = 64 << 20;
+
+/// S3's single-`PutObject` maximum — the size the lengthless-stream sizing rule assumes
+/// (`0016:2304`).
+pub const SINGLE_PUT_MAX_BYTES: u64 = 5 * 1024 * 1024 * 1024;
+
+/// The worst-case per-session staged-reference footprint, in chunk-refs. **Derived**
+/// (`0016:1469`), never chosen: `min( (MAX_PARTS_PER_SESSION + MAX_INFLIGHT_PARTS) ×
+/// MAX_PART_CHUNKS , MAX_STAGED_CHUNKS + 2 × MAX_INFLIGHT_PARTS × MAX_PART_CHUNKS )`.
+pub const fn u_ref() -> u64 {
+    let raw = (MAX_PARTS_PER_SESSION as u64 + MAX_INFLIGHT_PARTS as u64) * MAX_PART_CHUNKS as u64;
+    let ceiling = MAX_STAGED_CHUNKS as u64 + 2 * MAX_INFLIGHT_PARTS as u64 * MAX_PART_CHUNKS as u64;
+    if raw < ceiling {
+        raw
+    } else {
+        ceiling
+    }
+}
+
+/// Concurrent sessions the deployment admits. **Derived, never chosen** (`0016:1470`):
+/// `min( ⌊W_ref / U_ref⌋ , SCAN_CAP/2 )`. The `SCAN_CAP/2` term is a clamp the
+/// implementation applies (a large `W_ref` with small parts could otherwise break the
+/// reaper's `scan("mpu:")`).
+pub const fn max_sessions() -> u64 {
+    let derived = W_REF / u_ref();
+    let clamp = (SCAN_CAP / 2) as u64;
+    if derived < clamp {
+        derived
+    } else {
+        clamp
+    }
+}
+
+/// The budget tuple `mpuctl` stores so a rolling configuration change cannot leave two
+/// gateways enforcing different bounds (`0016:348`, X64/X76). Equal quotients can hide
+/// unequal footprints, so admission compares the **profile**, not the derived quotient.
+///
+/// **One value set, landed in wave 0.** 0016's *Open questions* assigns `W_ref` and
+/// `B = min(B_bytes, B_ops)` to #625, but `mpuctl.profile` is written by `Create` — in
+/// *this* slice — and *contains* them; `MAX_PART_CHUNKS` and `MAX_INFLIGHT_PARTS` are
+/// legally clamped by `B_ops`; and #625's reaper must fail closed when its local profile
+/// disagrees with the ledger's. Two independently chosen `B_ops` values would be actively
+/// unsafe: a session admitted under this slice's clamp could need more sequential
+/// operations than #625 permits in its **unsplittable** reap fence, which then times out
+/// forever — a permanent, data-retaining failure mode. So there is one value set and one
+/// configuration seam, landed here, and #625 consumes it unchanged.
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+pub struct BudgetProfile {
+    /// The reconcile pass's staged-reference memory budget, in chunk-refs.
+    pub w_ref: u64,
+    /// Chunk-refs one `part:` record may hold.
+    pub max_part_chunks: u64,
+    /// S3's part-number ceiling.
+    pub max_parts_per_session: u64,
+    /// Parts one session may have in flight (the `slot:` key space).
+    pub max_inflight_parts: u64,
+    /// Chunk-refs one session may hold in committed `part:` records.
+    pub max_staged_chunks: u64,
+    /// The operation-count half of the batch budget, which clamps the two knobs above.
+    pub b_ops: u64,
+}
+
+impl BudgetProfile {
+    /// This build's profile — the single value set both this slice and #625 enforce.
+    pub fn deployed() -> Self {
+        Self {
+            w_ref: W_REF,
+            max_part_chunks: MAX_PART_CHUNKS as u64,
+            max_parts_per_session: MAX_PARTS_PER_SESSION as u64,
+            max_inflight_parts: MAX_INFLIGHT_PARTS as u64,
+            max_staged_chunks: MAX_STAGED_CHUNKS as u64,
+            b_ops: B_OPS as u64,
+        }
+    }
+}
+
+// ---------------------------------------------------------------------------------------
+// Key space (0016 §1, `0016:346-356`). Every prefix is disjoint from every other and from
+// `inode:` / `dirent:` / `pending:` / `bucket:` / `orphan:` / `desired:dserver:`, and no
+// prefix is a prefix of another — so no `scan` returns a neighbour's records.
+// ---------------------------------------------------------------------------------------
+
+/// The singleton **admission** record. Absent reads as `{ count: 0 }`; the first Create on
+/// a fresh or upgraded store initializes it under `require_absent`, so there is no
+/// migration step.
+pub const MPUCTL_KEY: &[u8] = b"mpuctl";
+
+/// Key prefix of the session records.
+pub const MPU_PREFIX: &[u8] = b"mpu:";
+/// Key prefix of the in-flight part **slots**.
+pub const SLOT_PREFIX: &[u8] = b"slot:";
+/// Key prefix of the committed **part** records.
+pub const PART_PREFIX: &[u8] = b"part:";
+/// Key prefix of the committed part **summaries**.
+pub const PSUM_PREFIX: &[u8] = b"psum:";
+/// Key prefix of the **owned staging** entries — deliberately disjoint from `pending:` so
+/// no global `scan("pending:")` (the restore pass, the expiry sweep) ever enumerates one.
+pub const SIDX_PREFIX: &[u8] = b"sidx:";
+/// Key prefix of the published-map **segment** records.
+pub const SEG_PREFIX: &[u8] = b"seg:";
+/// Key prefix of the **segment-group** reservation markers.
+pub const SEGGRP_PREFIX: &[u8] = b"seggrp:";
+/// Key prefix of the **retirement ledger**.
+pub const RETIRE_PREFIX: &[u8] = b"retire:";
+
+/// `mpu:<upload-id>` — the session record.
+pub fn mpu_key(upload_id: &str) -> Vec<u8> {
+    format!("mpu:{upload_id}").into_bytes()
+}
+
+/// `slot:<upload-id>:<index>`, the index a **fixed-width** decimal so the key range sorts
+/// numerically and `<index>` is structurally checkable at decode (`0016:404-405`).
+pub fn slot_key(upload_id: &str, index: u32) -> Vec<u8> {
+    format!("slot:{upload_id}:{index:05}").into_bytes()
+}
+
+/// The bounded per-session `slot:` range (≤ `MAX_INFLIGHT_PARTS` records).
+pub fn slot_prefix(upload_id: &str) -> Vec<u8> {
+    format!("slot:{upload_id}:").into_bytes()
+}
+
+/// `part:<upload-id>:<part-number>`, fixed-width so the range sorts by part number.
+pub fn part_key(upload_id: &str, part_number: u32) -> Vec<u8> {
+    format!("part:{upload_id}:{part_number:05}").into_bytes()
+}
+
+/// The bounded per-session `part:` range (≤ `MAX_PARTS_PER_SESSION` records).
+pub fn part_prefix(upload_id: &str) -> Vec<u8> {
+    format!("part:{upload_id}:").into_bytes()
+}
+
+/// `psum:<upload-id>:<part-number>` — the part's few-tens-of-bytes summary, written in the
+/// **same batch** as the `part:` record it summarizes.
+pub fn psum_key(upload_id: &str, part_number: u32) -> Vec<u8> {
+    format!("psum:{upload_id}:{part_number:05}").into_bytes()
+}
+
+/// The bounded per-session `psum:` range — what the cumulative staged-chunk check and
+/// `ListParts` read, so neither ever pulls the fat chunk lists.
+pub fn psum_prefix(upload_id: &str) -> Vec<u8> {
+    format!("psum:{upload_id}:").into_bytes()
+}
+
+/// `sidx:<upload-id>:<part-number>:<chunk-id>` — the owned staging entry. The
+/// `<part-number>` lets a reaper attribute residue to the part attempt that staged it.
+pub fn sidx_key(upload_id: &str, part_number: u32, chunk: ChunkId) -> Vec<u8> {
+    format!("sidx:{upload_id}:{part_number:05}:{chunk}").into_bytes()
+}
+
+/// The bounded per-session `sidx:` range (≤ `MAX_INFLIGHT_PARTS × MAX_PART_CHUNKS`).
+pub fn sidx_prefix(upload_id: &str) -> Vec<u8> {
+    format!("sidx:{upload_id}:").into_bytes()
+}
+
+/// `seg:<group-nonce>:<epoch>:<index>` — one segment of a published map.
+///
+/// Keyed by the session's independent **segment-group nonce**, *not* by the upload id:
+/// segment records outlive the `mpu:` tombstone that would otherwise be their only reuse
+/// guard, so an upload id reused after its tombstone expired would find the session key
+/// free and its segment-write phase would **overwrite a live object's segments**
+/// (`0016:499-526`, iteration-14 finding 2 / iteration-15 finding 1). The `<epoch>` is the
+/// `Completing` fence epoch that wrote it, so a rolled-back attempt's stale segments live
+/// in a key range disjoint from any later attempt's (F18).
+pub fn seg_key(group_nonce: &str, epoch: u64, index: u32) -> Vec<u8> {
+    format!("seg:{group_nonce}:{epoch}:{index:05}").into_bytes()
+}
+
+/// The bounded per-generation `seg:` range (≤ `MAX_ROOT_SEGMENTS`).
+pub fn seg_prefix(group_nonce: &str, epoch: u64) -> Vec<u8> {
+    format!("seg:{group_nonce}:{epoch}:").into_bytes()
+}
+
+/// `seggrp:<group-nonce>` — the segment-group reservation marker, taken under
+/// `require_absent` in the Create batch, so nonce reuse is structurally impossible rather
+/// than merely improbable.
+pub fn seggrp_key(group_nonce: &str) -> Vec<u8> {
+    format!("seggrp:{group_nonce}").into_bytes()
+}
+
+/// `retire:bytes:<token>` — bytes to orphan-mark, **then** the naming records to delete.
+pub fn retire_bytes_key(token: &str) -> Vec<u8> {
+    format!("retire:bytes:{token}").into_bytes()
+}
+
+/// `retire:records:<token>` — staging records to delete whose bytes are protected by
+/// something else. It must **never** orphan anything; the mode lives in the key, not in a
+/// field, because a boolean misread once is silent data loss while a malformed key prefix
+/// is an error at decode (`0016:434-440`).
+pub fn retire_records_key(token: &str) -> Vec<u8> {
+    format!("retire:records:{token}").into_bytes()
+}
+
+/// The session-scoped `retire:bytes:` range — the two bounded emptiness reads the terminal
+/// delete gates on (`0016:374-380`).
+pub fn retire_bytes_session_prefix(upload_id: &str) -> Vec<u8> {
+    format!("retire:bytes:s:{upload_id}:").into_bytes()
+}
+
+/// The session-scoped `retire:records:` range.
+pub fn retire_records_session_prefix(upload_id: &str) -> Vec<u8> {
+    format!("retire:records:s:{upload_id}:").into_bytes()
+}
+
+/// A **session-scoped** retirement token: `s:<upload-id>:<epoch>[:<part>:<attempt>]`.
+/// Every component is minted once, so a token can never be reused and installation under
+/// `require_absent` turns a collision into a `Conflict` the installer classifies — never a
+/// silent overwrite, which would permanently lose one obligation's reclamation evidence.
+pub fn session_token(upload_id: &str, epoch: u64) -> String {
+    format!("s:{upload_id}:{epoch}")
+}
+
+/// A **per-part-attempt** retirement token.
+pub fn part_attempt_token(upload_id: &str, epoch: u64, part_number: u32, attempt: &str) -> String {
+    format!("s:{upload_id}:{epoch}:{part_number}:{attempt}")
+}
+
+/// A **generation** retirement token: `g:<inode-id>:<version>`. An `(inode, version)` pair
+/// is produced by exactly one publication, so this too is minted once.
+pub fn generation_token(inode: InodeId, version: u64) -> String {
+    format!("g:{inode}:{version}")
+}
+
+/// Parse `part:<id>:<n>` / `psum:<id>:<n>` back to its part number.
+pub fn parse_part_number(key: &[u8], prefix: &[u8]) -> Option<u32> {
+    let rest = key.strip_prefix(prefix)?;
+    let text = std::str::from_utf8(rest).ok()?;
+    let (_, number) = text.rsplit_once(':')?;
+    number.parse().ok()
+}
+
+/// Parse the trailing fixed-width number of a `part:`/`psum:` key already scoped to one
+/// session by its own prefix.
+pub fn parse_scoped_number(key: &[u8], prefix: &[u8]) -> Option<u32> {
+    let rest = key.strip_prefix(prefix)?;
+    std::str::from_utf8(rest).ok()?.parse().ok()
+}
+
+// ---------------------------------------------------------------------------------------
+// Records
+// ---------------------------------------------------------------------------------------
+
+/// The admission record — `{ count, max_sessions, profile }` in **one** value, so the count
+/// and the limit it was checked against can never be read apart. Every mutation CASes it
+/// whole.
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+pub struct MpuControl {
+    /// The number of `mpu:` records that exist in **any** state (tombstones included).
+    pub count: u64,
+    /// The governing limit those increments were admitted against.
+    pub max_sessions: u64,
+    /// The budget tuple that *establishes* that limit.
+    pub profile: BudgetProfile,
+}
+
+/// The lifecycle states of §2's machine. No state is absorbing: every one has an exit and a
+/// driver (`0016:567-579`).
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]
+pub enum SessionState {
+    /// Accepting parts.
+    Open,
+    /// Fenced by a Complete: the part set is frozen and no part may be added, replaced or
+    /// removed.
+    Completing,
+    /// Fenced by an Abort, a reap, a restore or the residency ceiling; draining.
+    Aborting,
+    /// Published. A **tombstone** until its window elapses, so a client retry inside the
+    /// window gets the recorded ETag rather than `404`.
+    Completed,
+}
+
+/// The dirent identity a Complete publishes to — the parent inode and the object name,
+/// **never a frozen inode id**: an inode id is minted per `create` and both keys are
+/// `require_absent`-guarded, so a concurrent delete-and-recreate of the same key rebinds it
+/// to a *different* inode and a flip that reused a frozen id would address a deleted
+/// generation (`0016:350`).
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+pub struct PublishTarget {
+    /// The parent inode the object name is bound under.
+    pub parent: InodeId,
+    /// The object name (the composed `{bucket}/{key}` on the flat namespace).
+    pub name: String,
+    /// The `Completing` fence epoch, so a resumed completer writes the same deterministic
+    /// segment keys.
+    pub epoch: u64,
+}
+
+/// What a winning flip recorded, so the tombstone can answer an identical retry.
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+pub struct Published {
+    /// The inode the object was published to.
+    pub inode: InodeId,
+    /// The version the flip recorded — `prior.version + 1` from the **re-read** prior at
+    /// that flip attempt, never a value frozen at fence time.
+    pub version: u64,
+    /// The published multipart ETag.
+    pub etag: String,
+    /// The publication instant.
+    pub completed_at_millis: u64,
+}
+
+/// One multipart upload, from create to its terminal state.
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+pub struct SessionRecord {
+    /// The target container.
+    pub bucket: String,
+    /// The target object key, relative to the container.
+    pub key: String,
+    /// The `Content-Type` the initiating client declared.
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub content_type: Option<String>,
+    /// When the session was created — the instant `W_session` residency is measured from.
+    pub created_at_millis: u64,
+    /// Which clock stamped this session's timestamps. A reaper that does not recognise the
+    /// source **skips** the session rather than judging it (declining to judge is the safe
+    /// direction); the operator verb is then its only exit, which is why FU-6 ships with
+    /// #625.
+    pub clock_source: String,
+    /// The lifecycle state.
+    pub state: SessionState,
+    /// The fence epoch. Bumped by every transition, so two successive states are textually
+    /// distinct even when nothing else changes and every operation preconditioned on the
+    /// old bytes fails closed.
+    pub epoch: u64,
+    /// Complete fences taken so far, capped at [`MAX_COMPLETE_ATTEMPTS`].
+    pub attempts: u32,
+    /// The segment-group nonce reserved with the session — independent of the upload id
+    /// because segment records outlive the session's tombstone.
+    pub group_nonce: String,
+    /// Stamped at the `Completing` fence, so `W_completing` is measured from the fence
+    /// instant and not from last part progress (F16).
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub fenced_at_millis: Option<u64>,
+    /// The segment-write cursor — a field *inside* the record the phase already
+    /// preconditions on, so segmentation introduces no cursor record class.
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub segments_written: Option<u32>,
+    /// The dirent identity + fence epoch this attempt publishes to.
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub publish_target: Option<PublishTarget>,
+    /// What a winning flip recorded.
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub published: Option<Published>,
+    /// A digest over the *ordered* `(part_number, digest)` list the winning Complete named,
+    /// so the tombstone can tell an **identical retry** from a **different assembly**
+    /// reusing the upload id. A client that reused the id with a different part list would
+    /// otherwise be told *its* assembly succeeded while the stored object holds the earlier
+    /// one — a silent wrong answer, worse than any error (`0016:898-908`).
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub complete_fingerprint: Option<String>,
+}
+
+impl SessionRecord {
+    /// Is the session still accepting parts?
+    pub fn is_open(&self) -> bool {
+        self.state == SessionState::Open
+    }
+}
+
+/// One in-flight part **slot**. `<index>` runs over `[0, MAX_INFLIGHT_PARTS)`, so **the key
+/// space *is* the cap** — the admission bound is structural, enforced by which keys can
+/// exist, not by an integer every writer must CAS correctly.
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+pub struct SlotRecord {
+    /// The part number this attempt is uploading.
+    pub part_number: u32,
+    /// The attempt's own id, so a compensation names exactly its own residue.
+    pub attempt_id: String,
+    /// When the slot was claimed — a progress instant the reaper reads.
+    pub reserved_at_millis: u64,
+    /// Liveness for a part that has reserved but not yet written its first chunk, renewed
+    /// in flight by the same half-TTL loop that renews the owned `sidx:` leases.
+    pub lease_expiry_millis: u64,
+}
+
+/// A committed part.
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+pub struct PartRecord {
+    /// The part's chunks, in object order.
+    pub chunks: Vec<ChunkRef>,
+    /// The part's byte length.
+    pub len: u64,
+    /// The part's content digest — lowercase-hex SHA-256 (ADR-0047 closed the basis; MD5
+    /// is rejected). This is the per-part ETag `UploadPart` answers.
+    pub digest: String,
+    /// When the part committed.
+    pub committed_at_millis: u64,
+    /// The session epoch the commit was fenced against.
+    pub session_epoch: u64,
+}
+
+/// A committed part's **summary** — everything about it except its chunk list, so the
+/// cumulative staged-chunk check and `ListParts` read tens of bytes per part instead of the
+/// fat chunk lists.
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+pub struct PartSummary {
+    /// How many chunks the part's record holds.
+    pub chunks: u64,
+    /// The part's byte length.
+    pub len: u64,
+    /// The part's content digest.
+    pub digest: String,
+    /// When the part committed.
+    pub committed_at_millis: u64,
+}
+
+/// One segment of a published map.
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+pub struct SegmentRecord {
+    /// The segment's chunks, in object order.
+    pub chunks: Vec<ChunkRef>,
+    /// The segment's first byte offset within the object.
+    pub byte_offset: u64,
+    /// The segment's byte length.
+    pub byte_len: u64,
+}
+
+/// The payload of a `retire:bytes:` obligation — bytes to orphan-mark, then the naming
+/// records to delete.
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+pub enum RetireBytes {
+    /// A torn-down session's owned residue and, optionally, its committed parts.
+    Session {
+        /// The session whose `sidx:` range and `part:` records this obligation clears.
+        upload_id: String,
+        /// The fence epoch that installed it — the obligation's **event identity**.
+        epoch: u64,
+        /// Whether the committed `part:`/`psum:` records go with it.
+        parts: bool,
+    },
+    /// The staged parts a Complete did **not** name. Their bytes are orphan-marked and
+    /// *then* their records deleted, in one obligation — never split across a
+    /// `retire:records:` that could delete the record (the only source of the placements)
+    /// first (`0016:909-924`).
+    UnnamedParts {
+        /// The session those parts belong to.
+        upload_id: String,
+        /// The fence epoch.
+        epoch: u64,
+        /// The part numbers, range-encoded.
+        parts: Vec<(u32, u32)>,
+    },
+    /// A losing writer's, or a post-staging refusal's, staged chunks.
+    Chunks {
+        /// The chunks' recorded placements, so the drain can compute every `orphan:` key
+        /// without re-reading a record that may already be gone.
+        placements: Vec<StagedChunk>,
+    },
+    /// A superseded or deleted object generation.
+    Generation {
+        /// The inode.
+        inode: InodeId,
+        /// The version being retired.
+        version: u64,
+        /// The generation's chunks (a flat map).
+        chunks: Vec<ChunkRef>,
+        /// The generation's segment group, when it was segmented — the drain re-reads each
+        /// `seg:` record's **current** placement at drain time, never a frozen one.
+        #[serde(default, skip_serializing_if = "Option::is_none")]
+        segments: Option<SegmentGroup>,
+    },
+}
+
+/// A staged chunk named by an obligation: its id and the placement its `sidx:` entry
+/// recorded, so a record-only drain can compute `orphan:<dserver>:<chunk>:<index>` for
+/// every fragment position without the chunk's own record.
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+pub struct StagedChunk {
+    /// The chunk id.
+    pub id: ChunkId,
+    /// The planned EC placement, one D-server id per fragment index.
+    pub placement: Vec<DServerId>,
+}
+
+/// The payload of a `retire:records:` obligation — records to delete whose bytes are
+/// protected by something else. It orphan-marks nothing.
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+pub enum RetireRecords {
+    /// The **published** parts' `part:` + `psum:` records — never the parts Complete left
+    /// unnamed, whose records ride their own `retire:bytes:` obligation so that marking
+    /// always precedes deletion.
+    Parts {
+        /// The session.
+        upload_id: String,
+        /// The published part numbers, range-encoded.
+        parts: Vec<(u32, u32)>,
+    },
+    /// One rolled-back `Completing` attempt's dangling segments, naming **exactly** that
+    /// epoch's keys.
+    Segments {
+        /// The segment group.
+        group: SegmentGroup,
+    },
+}
+
+/// The nonce + fence epoch that names a published map's segment records.
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+pub struct SegmentGroup {
+    /// The independent segment-group nonce reserved at Create.
+    pub nonce: String,
+    /// The `Completing` fence epoch of the attempt that wrote the segments.
+    pub epoch: u64,
+}
+
+/// A segmented root's segment table: the group its `seg:` records live under, how many
+/// there are, and each one's byte span.
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+pub struct SegmentedMap {
+    /// The segment group — the independent nonce plus the `Completing` fence epoch that
+    /// wrote the segments.
+    pub group: SegmentGroup,
+    /// How many segments the group holds; a root whose count exceeds the **format**
+    /// segment maximum is a decode error, never a silently-corrected default.
+    pub segment_count: u32,
+    /// The segment table, in object order.
+    pub segments: Vec<SegmentRef>,
+}
+
+/// Resolve an inode's chunk map — flat inline, or by reading the bounded per-object
+/// `seg:<group-nonce>:<epoch>:` range (≤ [`MAX_ROOT_SEGMENTS`]), **never** a global `seg:`
+/// scan.
+///
+/// **Reader safety (`0016:2452-2474`, the resolve-retry rule).** Retiring a superseded or
+/// deleted generation deletes its `seg:` records, which could tear a consumer that has read
+/// the root and is midway through its segments. Rather than a second grace clock, resolution
+/// is made retry-tolerant using an ordering the protocol already guarantees — the root is
+/// flipped away from a generation *before* that generation's `seg:` records are ever
+/// deleted. So: a segment read that comes back **absent** re-reads the root; a root now
+/// naming a **different** group (superseded) or **absent** (deleted) means the generation
+/// was concurrently retired and the caller restarts or answers "no such object", while a
+/// root **unchanged** with a segment **absent** is an invariant violation — a live
+/// generation never loses a segment — and is **fail-closed**, an error, never a torn
+/// success.
+pub async fn resolve_chunk_map<S: MetadataStore + ?Sized>(
+    store: &S,
+    inode_id: InodeId,
+    inode: &crate::metadata::InodeRecord,
+) -> Result<Option<Vec<ChunkRef>>> {
+    let Some(map) = &inode.segments else {
+        return Ok(Some(inode.chunk_map.clone()));
+    };
+    let prefix = seg_prefix(&map.group.nonce, map.group.epoch);
+    let mut by_index: Vec<(u32, SegmentRecord)> = Vec::new();
+    for (key, value) in store.scan(&prefix).await? {
+        let Some(index) = parse_scoped_number(&key, &prefix) else {
+            continue;
+        };
+        by_index.push((index, decode::<SegmentRecord>(&value)?));
+    }
+    by_index.sort_by_key(|(i, _)| *i);
+    if by_index.len() != map.segment_count as usize {
+        // A segment is missing. Re-read the root: a generation that was concurrently
+        // retired is not an error for the reader, it is a restart.
+        let current = store.get(&metadata::inode_key(inode_id)).await?;
+        let still_current = match &current {
+            None => false,
+            Some(bytes) => decode::<crate::metadata::InodeRecord>(bytes)?
+                .segments
+                .as_ref()
+                .map(|s| s.group == map.group)
+                .unwrap_or(false),
+        };
+        if !still_current {
+            return Ok(None);
+        }
+        return Err(MultipartError::InvalidArgument(format!(
+            "segmented object {inode_id} names {} segments but only {} are present under \
+             `{}` while its root still points at that group — a live generation never loses \
+             a segment",
+            map.segment_count,
+            by_index.len(),
+            String::from_utf8_lossy(&prefix)
+        ))
+        .into());
+    }
+    let mut out = Vec::new();
+    for (_, record) in by_index {
+        out.extend(record.chunks);
+    }
+    Ok(Some(out))
+}
+
+/// One entry of a segmented root's segment table.
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+pub struct SegmentRef {
+    /// The segment index within the group.
+    pub index: u32,
+    /// The segment's first byte offset within the object.
+    pub byte_offset: u64,
+    /// The segment's byte length.
+    pub byte_len: u64,
+}
+
+/// Errors this protocol raises. They are *protocol* answers, not wire answers — the S3
+/// crate maps each onto a status + code.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum MultipartError {
+    /// No session with that id exists in a state that could serve the request.
+    NoSuchUpload,
+    /// The session is fenced by another Complete.
+    OperationAborted,
+    /// Too many open sessions, or too many parts in flight for this session.
+    SlowDown,
+    /// A named part is absent, or its digest does not match.
+    InvalidPart,
+    /// The named parts are not in ascending part-number order.
+    InvalidPartOrder,
+    /// A non-final part is below S3's 5 MiB minimum.
+    EntityTooSmall,
+    /// A part's chunk count exceeds `MAX_PART_CHUNKS`, or the session's staged total would
+    /// exceed `MAX_STAGED_CHUNKS`, or a single PUT cannot fit `MAX_MAP_CHUNKS` even at
+    /// `chunk_size_max`.
+    EntityTooLarge,
+    /// A part number outside `1..=MAX_PARTS_PER_SESSION`, or another malformed argument.
+    InvalidArgument(String),
+    /// The target container has no record.
+    NoSuchBucket,
+    /// The publication CAS lost `R_publish` times; the fence is released and the session
+    /// stays usable.
+    PublishContended,
+}
+
+impl std::fmt::Display for MultipartError {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        match self {
+            MultipartError::NoSuchUpload => write!(f, "the specified upload does not exist"),
+            MultipartError::OperationAborted => {
+                write!(f, "a conflicting operation is in progress on this upload")
+            }
+            MultipartError::SlowDown => write!(f, "too many in-flight parts or open uploads"),
+            MultipartError::InvalidPart => write!(
+                f,
+                "one or more of the specified parts could not be found, or its entity tag did \
+                 not match"
+            ),
+            MultipartError::InvalidPartOrder => {
+                write!(f, "the list of parts was not in ascending order")
+            }
+            MultipartError::EntityTooSmall => write!(
+                f,
+                "a non-final part is smaller than the minimum allowed object size"
+            ),
+            MultipartError::EntityTooLarge => {
+                write!(f, "the proposed upload exceeds the maximum allowed size")
+            }
+            MultipartError::InvalidArgument(what) => write!(f, "invalid argument: {what}"),
+            MultipartError::NoSuchBucket => write!(f, "the specified bucket does not exist"),
+            MultipartError::PublishContended => write!(
+                f,
+                "the upload could not be published because of concurrent writes to the target \
+                 key; retry"
+            ),
+        }
+    }
+}
+
+impl std::error::Error for MultipartError {}
+
+// ---------------------------------------------------------------------------------------
+// The multipart ETag composition (this slice's, constrained by 0016 to one property: a
+// pure function of the part records' recorded digests and their order).
+// ---------------------------------------------------------------------------------------
+
+/// The published multipart ETag:
+/// `lowercase_hex( SHA-256( d_1 ‖ d_2 ‖ … ‖ d_N ) ) + "-" + N`, where `d_i` is the **raw 32
+/// binary digest bytes** of the *i*-th part in ascending part-number order over exactly the
+/// parts the client named, and `N` is that count.
+///
+/// It is a **pure function of the recorded digests and their order**, so a retried Complete
+/// re-derives the identical value with no stored state. Never MD5 — ADR-0047 closed the
+/// basis, and a true S3 `md5-of-part-md5s` ETag would add a dependency for a digest the
+/// project has rejected.
+pub fn multipart_etag(part_digests_hex: &[String]) -> String {
+    use sha2::{Digest, Sha256};
+    let mut hasher = Sha256::new();
+    for hex in part_digests_hex {
+        // The raw digest bytes, not their hex text: an implementation that concatenated the
+        // hex would produce a different (also "SHA-256-based, pure") value, which is why the
+        // composition is spelled out to the byte.
+        hasher.update(unhex(hex));
+    }
+    format!(
+        "{}-{}",
+        hex_lower(&hasher.finalize()),
+        part_digests_hex.len()
+    )
+}
+
+/// The `complete_fingerprint` — a digest over the *ordered* `(part_number, digest)` pairs
+/// the winning Complete named, so a tombstone answers an identical retry with `200` and a
+/// **different** assembly with `404 NoSuchUpload`.
+pub fn complete_fingerprint(named: &[(u32, String)]) -> String {
+    use sha2::{Digest, Sha256};
+    let mut hasher = Sha256::new();
+    for (number, digest) in named {
+        hasher.update(number.to_be_bytes());
+        hasher.update(digest.as_bytes());
+        hasher.update(b";");
+    }
+    hex_lower(&hasher.finalize())
+}
+
+/// Lowercase-hex encode.
+pub fn hex_lower(bytes: &[u8]) -> String {
+    let mut s = String::with_capacity(bytes.len() * 2);
+    for b in bytes {
+        s.push(char::from_digit((b >> 4) as u32, 16).unwrap_or('0'));
+        s.push(char::from_digit((b & 0x0f) as u32, 16).unwrap_or('0'));
+    }
+    s
+}
+
+/// Decode lowercase hex back to bytes; a malformed pair contributes nothing, which can only
+/// happen for a digest this module did not write.
+fn unhex(text: &str) -> Vec<u8> {
+    let raw: Vec<u8> = text.bytes().collect();
+    raw.chunks(2)
+        .filter_map(|pair| {
+            let hi = (pair.first()? as &u8).to_ascii_lowercase();
+            let lo = (pair.get(1)? as &u8).to_ascii_lowercase();
+            let hi = (hi as char).to_digit(16)?;
+            let lo = (lo as char).to_digit(16)?;
+            Some(((hi << 4) | lo) as u8)
+        })
+        .collect()
+}
+
+// ---------------------------------------------------------------------------------------
+// Range encoding for part-number sets (`0016:382-388`): `[[1, 400]]` for a contiguous run,
+// so the common "every staged part was published" case is a few bytes and the worst case —
+// 10,000 alternating numbers — stays inside one value.
+// ---------------------------------------------------------------------------------------
+
+/// Range-encode a sorted, deduplicated part-number set.
+pub fn encode_part_ranges(sorted: &[u32]) -> Vec<(u32, u32)> {
+    let mut out: Vec<(u32, u32)> = Vec::new();
+    for &n in sorted {
+        match out.last_mut() {
+            Some(last) if last.1 + 1 == n => last.1 = n,
+            Some(last) if last.1 == n => {}
+            _ => out.push((n, n)),
+        }
+    }
+    out
+}
+
+/// Expand a range-encoded part-number set.
+pub fn expand_part_ranges(ranges: &[(u32, u32)]) -> Vec<u32> {
+    let mut out = Vec::new();
+    for &(lo, hi) in ranges {
+        for n in lo..=hi {
+            out.push(n);
+        }
+    }
+    out
+}
+
+// ---------------------------------------------------------------------------------------
+// Reads
+// ---------------------------------------------------------------------------------------
+
+/// Read a session record and the exact bytes it decoded from — the bytes every fenced CAS
+/// preconditions on.
+pub async fn read_session<S: MetadataStore + ?Sized>(
+    store: &S,
+    upload_id: &str,
+) -> Result<Option<(SessionRecord, Bytes)>> {
+    let key = mpu_key(upload_id);
+    let Some(bytes) = store.get(&key).await? else {
+        return Ok(None);
+    };
+    let record: SessionRecord = decode(&bytes)?;
+    Ok(Some((record, bytes)))
+}
+
+/// Read the admission record, or the `{ count: 0 }` an absent one reads as.
+pub async fn read_control<S: MetadataStore + ?Sized>(
+    store: &S,
+) -> Result<(MpuControl, Option<Bytes>)> {
+    match store.get(MPUCTL_KEY).await? {
+        Some(bytes) => {
+            let record: MpuControl = decode(&bytes)?;
+            Ok((record, Some(bytes)))
+        }
+        None => Ok((
+            MpuControl {
+                count: 0,
+                max_sessions: max_sessions(),
+                profile: BudgetProfile::deployed(),
+            },
+            None,
+        )),
+    }
+}
+
+/// Every committed part **summary** of one session, ascending by part number — the bounded
+/// per-session range the cumulative staged check and `ListParts` read.
+pub async fn list_part_summaries<S: MetadataStore + ?Sized>(
+    store: &S,
+    upload_id: &str,
+) -> Result<Vec<(u32, PartSummary)>> {
+    let prefix = psum_prefix(upload_id);
+    let mut out = Vec::new();
+    for (key, value) in store.scan(&prefix).await? {
+        let Some(number) = parse_scoped_number(&key, &prefix) else {
+            continue;
+        };
+        out.push((number, decode::<PartSummary>(&value)?));
+    }
+    out.sort_by_key(|(n, _)| *n);
+    Ok(out)
+}
+
+/// Every committed part **record** of one session, ascending by part number — the bounded
+/// per-session range Complete assembles from.
+pub async fn list_part_records<S: MetadataStore + ?Sized>(
+    store: &S,
+    upload_id: &str,
+) -> Result<Vec<(u32, PartRecord)>> {
+    let prefix = part_prefix(upload_id);
+    let mut out = Vec::new();
+    for (key, value) in store.scan(&prefix).await? {
+        let Some(number) = parse_scoped_number(&key, &prefix) else {
+            continue;
+        };
+        out.push((number, decode::<PartRecord>(&value)?));
+    }
+    out.sort_by_key(|(n, _)| *n);
+    Ok(out)
+}
+
+/// Every session record in the store, by upload id — the reaper's and the staged reference
+/// build's one bounded scan (≤ `MAX_SESSIONS`).
+pub async fn list_sessions<S: MetadataStore + ?Sized>(
+    store: &S,
+) -> Result<Vec<(String, SessionRecord)>> {
+    let mut out = Vec::new();
+    for (key, value) in store.scan(MPU_PREFIX).await? {
+        let Some(rest) = key.strip_prefix(MPU_PREFIX) else {
+            continue;
+        };
+        let Ok(id) = std::str::from_utf8(rest) else {
+            continue;
+        };
+        out.push((id.to_string(), decode::<SessionRecord>(&value)?));
+    }
+    out.sort_by(|a, b| a.0.cmp(&b.0));
+    Ok(out)
+}
+
+/// One session's in-flight owned staging entries, each with its part number, chunk id and
+/// recorded placement — the bounded per-session `sidx:` range.
+pub async fn list_owned_staging<S: MetadataStore + ?Sized>(
+    store: &S,
+    upload_id: &str,
+) -> Result<Vec<(u32, ChunkId, PendingEntry)>> {
+    let prefix = sidx_prefix(upload_id);
+    let mut out = Vec::new();
+    for (key, value) in store.scan(&prefix).await? {
+        let Some(rest) = key.strip_prefix(prefix.as_slice()) else {
+            continue;
+        };
+        let Ok(text) = std::str::from_utf8(rest) else {
+            continue;
+        };
+        let Some((part, chunk)) = text.split_once(':') else {
+            continue;
+        };
+        let (Ok(part), Ok(chunk)) = (part.parse::<u32>(), chunk.parse::<ChunkId>()) else {
+            continue;
+        };
+        out.push((part, chunk, decode::<PendingEntry>(&value)?));
+    }
+    out.sort_by_key(|a| (a.0, a.1));
+    Ok(out)
+}
+
+/// One session's in-flight slots, by index.
+pub async fn list_slots<S: MetadataStore + ?Sized>(
+    store: &S,
+    upload_id: &str,
+) -> Result<Vec<(u32, SlotRecord, Bytes)>> {
+    let prefix = slot_prefix(upload_id);
+    let mut out = Vec::new();
+    for (key, value) in store.scan(&prefix).await? {
+        let Some(index) = parse_scoped_number(&key, &prefix) else {
+            continue;
+        };
+        out.push((index, decode::<SlotRecord>(&value)?, value));
+    }
+    out.sort_by_key(|(i, _, _)| *i);
+    Ok(out)
+}
+
+// ---------------------------------------------------------------------------------------
+// Batches — §3's inventory. Each is O(1) in object size, byte- and operation-budgeted, and
+// carries the preconditions that make its replay a no-op rather than a double-apply.
+// ---------------------------------------------------------------------------------------
+
+/// **Create session.** One batch: the admission reservation (`require(mpuctl == prior)`
+/// with `prior.count < prior.max_sessions`, or `require_absent(mpuctl)` on a fresh store),
+/// `require_absent(mpu:<id>)`, and the **independent segment-group reservation**
+/// `require_absent(seggrp:<nonce>)` with its marker.
+///
+/// Admission is a *serialized reservation*, not a scan-then-create: ADR-0046 flagged the
+/// scan-then-commit emptiness check as race-prone, and a counter that concurrent creates
+/// could both read below the limit would admit past it.
+///
+/// A gateway whose local **profile** differs from the stored one refuses to admit and
+/// alarms: equal quotients can hide unequal footprints, so admission compares the profile,
+/// never the derived `max_sessions`.
+pub async fn create_session<S: MetadataStore + ?Sized>(
+    store: &S,
+    upload_id: &str,
+    session: &SessionRecord,
+) -> Result<CommitOutcome> {
+    let (control, prior_bytes) = read_control(store).await?;
+    let profile = BudgetProfile::deployed();
+    if let Some(bytes) = &prior_bytes {
+        if control.profile != profile {
+            tracing::warn!(
+                monotonic_counter.s3_multipart_admission_profile_mismatch = 1_u64,
+                "refusing to admit a multipart session: this gateway's budget profile differs \
+                 from the one recorded in `mpuctl`; a rolling configuration change must drain \
+                 the live population first"
+            );
+            return Err(MultipartError::SlowDown.into());
+        }
+        if control.count >= control.max_sessions {
+            return Err(MultipartError::SlowDown.into());
+        }
+        let next = MpuControl {
+            count: control.count + 1,
+            ..control
+        };
+        let batch = WriteBatch::new()
+            .require(MPUCTL_KEY.to_vec(), bytes.clone())
+            .require_absent(mpu_key(upload_id))
+            .require_absent(seggrp_key(&session.group_nonce))
+            .put(MPUCTL_KEY.to_vec(), encode(&next))
+            .put(mpu_key(upload_id), encode(session))
+            .put(seggrp_key(&session.group_nonce), Bytes::from_static(b"1"));
+        return store.commit(batch).await;
+    }
+    // Bootstrap: a fresh or upgraded store adopts the first admitting gateway's derivation,
+    // and every later gateway is checked against it. No migration step.
+    let next = MpuControl {
+        count: 1,
+        max_sessions: max_sessions(),
+        profile,
+    };
+    let batch = WriteBatch::new()
+        .require_absent(MPUCTL_KEY.to_vec())
+        .require_absent(mpu_key(upload_id))
+        .require_absent(seggrp_key(&session.group_nonce))
+        .put(MPUCTL_KEY.to_vec(), encode(&next))
+        .put(mpu_key(upload_id), encode(session))
+        .put(seggrp_key(&session.group_nonce), Bytes::from_static(b"1"));
+    store.commit(batch).await
+}
+
+/// **Part slot reserve.** `require(mpu == Open@E)` **and** `require_absent(slot:<id>:<k>)`
+/// for the chosen index. The authorization is the per-key `require_absent`, not the
+/// population read — concurrent reservers therefore cannot overshoot the cap, and a
+/// reserver that loses an index retries the next free one (≤ `MAX_INFLIGHT_PARTS` probes,
+/// a bound on probes rather than a retry loop against a contended key).
+///
+/// `Ok(None)` means every index is taken — the caller answers `SlowDown`. No slot can be
+/// reserved once the session leaves `Open`.
+pub async fn reserve_slot<S: MetadataStore + ?Sized>(
+    store: &S,
+    upload_id: &str,
+    session_bytes: &Bytes,
+    record: &SlotRecord,
+) -> Result<Option<u32>> {
+    let taken: Vec<u32> = list_slots(store, upload_id)
+        .await?
+        .into_iter()
+        .map(|(i, _, _)| i)
+        .collect();
+    for index in 0..MAX_INFLIGHT_PARTS {
+        if taken.contains(&index) {
+            continue;
+        }
+        let batch = WriteBatch::new()
+            .require(mpu_key(upload_id), session_bytes.clone())
+            .require_absent(slot_key(upload_id, index))
+            .put(slot_key(upload_id, index), encode(record));
+        match store.commit(batch).await? {
+            CommitOutcome::Committed => return Ok(Some(index)),
+            // Either the session left `Open@E` (the caller re-reads and answers by state) or
+            // another reserver won this index; try the next free one.
+            CommitOutcome::Conflict => {
+                if read_session(store, upload_id)
+                    .await?
+                    .map(|(s, _)| !s.is_open())
+                    .unwrap_or(true)
+                {
+                    return Err(MultipartError::NoSuchUpload.into());
+                }
+            }
+        }
+    }
+    Ok(None)
+}
+
+/// **Part intent** — the owned staging entry for one chunk. Preconditioned
+/// `require(mpu == Open@E)` so **none can be created after the session leaves `Open`**
+/// (which is what makes the teardown's `sidx:`-walked-empty gate a statement about a frozen
+/// set), `require(slot == prior)` on its own slot, and `require_absent(desired:dserver:<S>)`
+/// for every server in the placement it records — the **drain fence**.
+///
+/// The drain fence is a keyed precondition rather than a filtered selector because
+/// selection reads a topology *snapshot* while the intent that makes the placement
+/// observable commits later: a drain recorded inside that window escapes a filter entirely,
+/// the status reads `Satisfied`, the operator wipes the server, and only then does the
+/// intent land. With the precondition there are exactly two outcomes — the intent commits
+/// first (so the staged set counts those fragments as held and the status is `Pending`), or
+/// the drain record commits first (so the intent fails and the write path re-plans against
+/// the fresh topology). There is no third.
+///
+/// The owning slot is rewritten in the **same batch** as the lease it renews: creating a
+/// fresh live lease without touching the slot would let a reap fence that pinned the slot's
+/// bytes abort a progressing part.
+#[allow(clippy::too_many_arguments)]
+pub fn stage_chunk_batch(
+    upload_id: &str,
+    session_bytes: &Bytes,
+    slot_index: u32,
+    slot_bytes: &Bytes,
+    slot_next: &SlotRecord,
+    part_number: u32,
+    chunk: ChunkId,
+    entry: &PendingEntry,
+    placement: &[DServerId],
+) -> WriteBatch {
+    let mut batch = WriteBatch::new()
+        .require(mpu_key(upload_id), session_bytes.clone())
+        .require(slot_key(upload_id, slot_index), slot_bytes.clone())
+        .put(slot_key(upload_id, slot_index), encode(slot_next))
+        .put(sidx_key(upload_id, part_number, chunk), encode(entry));
+    for server in placement {
+        batch = batch.require_absent(crate::multipart::desired_dserver_key(*server));
+    }
+    batch
+}
+
+/// The desired-state ledger key a drain request writes
+/// (`crates/custodian/src/desired_state.rs:33-38`), mirrored here so the intent's drain
+/// fence names exactly the key the custodian writes. Duplicating the *format* rather than
+/// the *ownership* keeps the dependency direction right (`core` must not depend on
+/// `custodian`); the conformance of the two spellings is pinned by a test in the custodian
+/// crate.
+pub fn desired_dserver_key(server: DServerId) -> Vec<u8> {
+    format!("desired:dserver:{server}").into_bytes()
+}
+
+/// **Part commit** — the handoff that makes protection continuous. In *one* batch:
+/// `require(mpu == Open@E)`, the part record and its `psum:` summary, the keyed slot
+/// release, every owned `sidx:` delete for this attempt's chunks, and — on a **re-upload**
+/// of the same part number — a `retire:bytes:{chunks}` obligation naming the superseded
+/// attempt's chunks.
+///
+/// The `sidx:` deletes and the `part:` write ride together deliberately: the entry that
+/// protects the bytes is replaced by a record that protects the same bytes in the same
+/// batch, so there is never an instant at which a staged fragment is named by neither.
+/// Splitting them is the classic way to reopen the invariant.
+///
+/// A re-upload's superseded chunks route through `retire:bytes:` rather than being deleted:
+/// dropping the prior `part:` record without evidence would leave its fragments
+/// unreferenced **and** unevidenced, which GC conservatively retains forever — a silent
+/// leak, not a loud one.
+#[allow(clippy::too_many_arguments)]
+pub fn commit_part_batch(
+    upload_id: &str,
+    session_bytes: &Bytes,
+    epoch: u64,
+    slot_index: u32,
+    slot_bytes: &Bytes,
+    part_number: u32,
+    attempt_id: &str,
+    record: &PartRecord,
+    prior_part: Option<(&PartRecord, Bytes)>,
+    staged_chunks: &[ChunkId],
+) -> WriteBatch {
+    let summary = PartSummary {
+        chunks: record.chunks.len() as u64,
+        len: record.len,
+        digest: record.digest.clone(),
+        committed_at_millis: record.committed_at_millis,
+    };
+    let mut batch = WriteBatch::new()
+        .require(mpu_key(upload_id), session_bytes.clone())
+        .require(slot_key(upload_id, slot_index), slot_bytes.clone())
+        .delete(slot_key(upload_id, slot_index))
+        .put(part_key(upload_id, part_number), encode(record))
+        .put(psum_key(upload_id, part_number), encode(&summary));
+    match prior_part {
+        Some((prior, prior_bytes)) => {
+            batch = batch.require(part_key(upload_id, part_number), prior_bytes);
+            // The superseded attempt's bytes leave with EVIDENCE, never merely unreferenced.
+            let token = part_attempt_token(upload_id, epoch, part_number, attempt_id);
+            let obligation = RetireBytes::Chunks {
+                placements: prior
+                    .chunks
+                    .iter()
+                    .map(|c| StagedChunk {
+                        id: c.id,
+                        placement: c.placement.clone(),
+                    })
+                    .collect(),
+            };
+            batch = batch
+                .require_absent(retire_bytes_key(&token))
+                .put(retire_bytes_key(&token), encode(&obligation));
+        }
+        None => {
+            batch = batch.require_absent(part_key(upload_id, part_number));
+        }
+    }
+    for &chunk in staged_chunks {
+        batch = batch.delete(sidx_key(upload_id, part_number, chunk));
+    }
+    batch
+}
+
+/// **Live-session compensation** — a same-part losing writer *or* **any post-staging local
+/// refusal**. `retire:bytes:{chunks}` for the staged bytes, the keyed slot release, and this
+/// attempt's owned `sidx:` deletes, all under `require(mpu == Open@E)`.
+///
+/// Every refusal that happens *after* chunks are staged must compensate, not just return:
+/// returning `EntityTooLarge` and stopping strands the bytes, the `sidx:` records **and the
+/// slot** until the whole session is aborted — and a client that repeats the refusal (which
+/// "the session stays usable" positively invites) fills `MAX_INFLIGHT_PARTS` and turns a
+/// usable session into a permanent `SlowDown`.
+#[allow(clippy::too_many_arguments)]
+pub fn compensate_part_batch(
+    upload_id: &str,
+    session_bytes: &Bytes,
+    epoch: u64,
+    slot_index: u32,
+    slot_bytes: &Bytes,
+    part_number: u32,
+    attempt_id: &str,
+    staged: &[(ChunkId, Vec<DServerId>)],
+) -> WriteBatch {
+    let token = part_attempt_token(upload_id, epoch, part_number, attempt_id);
+    let obligation = RetireBytes::Chunks {
+        placements: staged
+            .iter()
+            .map(|(id, placement)| StagedChunk {
+                id: *id,
+                placement: placement.clone(),
+            })
+            .collect(),
+    };
+    let mut batch = WriteBatch::new()
+        .require(mpu_key(upload_id), session_bytes.clone())
+        .require(slot_key(upload_id, slot_index), slot_bytes.clone())
+        .delete(slot_key(upload_id, slot_index))
+        .require_absent(retire_bytes_key(&token))
+        .put(retire_bytes_key(&token), encode(&obligation));
+    for (chunk, _) in staged {
+        batch = batch.delete(sidx_key(upload_id, part_number, *chunk));
+    }
+    batch
+}
+
+/// **Complete fence** — `Open@E → Completing@E+1`, stamping `fenced_at_millis` and
+/// `publish_target`, under `require(mpu == Open@E)` and `attempts < MAX_COMPLETE_ATTEMPTS`.
+///
+/// Fencing **first**, before the part set is read, is what makes the single session
+/// precondition prove *the entire part set is exactly what Complete read*: every part
+/// commit carries `require(mpu == Open@E)`, so after the fence no `part:` record can be
+/// created, replaced or deleted. That is the same guarantee per-part preconditions would
+/// give, at O(1) batch size and with no serialization of concurrent part uploads — a read
+/// precondition does not write, so N concurrent part commits sharing one session
+/// precondition never conflict with each other.
+pub fn fence_complete_batch(
+    upload_id: &str,
+    session: &SessionRecord,
+    session_bytes: &Bytes,
+    target: PublishTarget,
+    now_millis: u64,
+) -> (WriteBatch, SessionRecord) {
+    let next = SessionRecord {
+        state: SessionState::Completing,
+        epoch: session.epoch + 1,
+        attempts: session.attempts + 1,
+        fenced_at_millis: Some(now_millis),
+        segments_written: Some(0),
+        publish_target: Some(target),
+        ..session.clone()
+    };
+    let batch = WriteBatch::new()
+        .require(mpu_key(upload_id), session_bytes.clone())
+        .put(mpu_key(upload_id), encode(&next));
+    (batch, next)
+}
+
+/// **Fence release** — `Completing@E → Open@E+1` for a lost publication CAS or a rejected
+/// request, installing `retire:records:{seg:<g>:<E>}` for any segments this attempt wrote.
+///
+/// A rejected request may never leave the session fenced: that would make a client typo
+/// indistinguishable from a crashed completer and wedge the upload until the reaper's
+/// `W_completing`.
+pub fn release_fence_batch(
+    upload_id: &str,
+    session: &SessionRecord,
+    session_bytes: &Bytes,
+) -> (WriteBatch, SessionRecord) {
+    let next = SessionRecord {
+        state: SessionState::Open,
+        epoch: session.epoch + 1,
+        fenced_at_millis: None,
+        segments_written: None,
+        publish_target: None,
+        ..session.clone()
+    };
+    let mut batch = WriteBatch::new()
+        .require(mpu_key(upload_id), session_bytes.clone())
+        .put(mpu_key(upload_id), encode(&next));
+    if session.segments_written.unwrap_or(0) > 0 {
+        let group = SegmentGroup {
+            nonce: session.group_nonce.clone(),
+            epoch: session.epoch,
+        };
+        let token = session_token(upload_id, session.epoch);
+        batch = batch.require_absent(retire_records_key(&token)).put(
+            retire_records_key(&token),
+            encode(&RetireRecords::Segments { group }),
+        );
+    }
+    (batch, next)
+}
+
+/// **Abort / reap fence** — `Open@E → Aborting@E+1` (or `Completing@E → Aborting@E+1` for
+/// the restore / residency / operator doors), installing `retire:bytes:{session, parts}` and,
+/// from `Completing`, `retire:records:{seg:<g>:<E>}` in the **same** batch.
+///
+/// One batch for all three `Completing` doors is deliberate: a restore-fenced attempt never
+/// flips a root, so nothing would ever adopt or retire its segments, and fencing it as if it
+/// were `Open` would leave those `seg:` records with **no deleter in the whole design**.
+///
+/// Abort's HTTP response is *this commit* — teardown is not on the request path, so Abort's
+/// latency does not scale with session size.
+pub fn abort_fence_batch(
+    upload_id: &str,
+    session: &SessionRecord,
+    session_bytes: &Bytes,
+) -> (WriteBatch, SessionRecord) {
+    let next = SessionRecord {
+        state: SessionState::Aborting,
+        epoch: session.epoch + 1,
+        ..session.clone()
+    };
+    let token = session_token(upload_id, session.epoch);
+    let mut batch = WriteBatch::new()
+        .require(mpu_key(upload_id), session_bytes.clone())
+        .put(mpu_key(upload_id), encode(&next))
+        .require_absent(retire_bytes_key(&token))
+        .put(
+            retire_bytes_key(&token),
+            encode(&RetireBytes::Session {
+                upload_id: upload_id.to_string(),
+                epoch: session.epoch,
+                parts: true,
+            }),
+        );
+    if session.state == SessionState::Completing && session.segments_written.unwrap_or(0) > 0 {
+        let group = SegmentGroup {
+            nonce: session.group_nonce.clone(),
+            epoch: session.epoch,
+        };
+        batch = batch.require_absent(retire_records_key(&token)).put(
+            retire_records_key(&token),
+            encode(&RetireRecords::Segments { group }),
+        );
+    }
+    (batch, next)
+}
+
+/// What the target key currently binds to, resolved fresh at **each** flip attempt.
+///
+/// `publish_target` names the *dirent identity*, never a frozen inode id: an inode id is
+/// minted per `create` and both keys are `require_absent`-guarded, so a concurrent
+/// delete-and-recreate of the same key rebinds it to a different inode, and a flip that
+/// reused a frozen id would recreate an unlinked inode and CAS a dirent that now names
+/// another one.
+pub enum FlipBinding {
+    /// The key is free: create a fresh inode under `require_absent` on **both** keys.
+    Fresh {
+        /// The freshly minted inode id.
+        inode: InodeId,
+    },
+    /// The key is bound: CAS the inode it names, with `version = prior.version + 1` from
+    /// **this** re-read prior. Both bindings are pinned — guarding only the inode would let
+    /// a `metadata::rename` move the dirent after Complete resolved it, and the flip would
+    /// then overwrite an inode now bound at another name while the client is told the
+    /// Complete succeeded.
+    Existing {
+        /// The inode the dirent names, re-read now.
+        inode: InodeId,
+        /// The dirent's exact current bytes.
+        dirent_bytes: Bytes,
+        /// The inode's exact current bytes.
+        inode_bytes: Bytes,
+        /// The prior record, whose `version + 1` this flip publishes and whose chunks the
+        /// generation obligation retires. Boxed so the `Fresh` arm — the common case, one
+        /// `InodeId` — does not carry a whole inode record's worth of padding.
+        prior: Box<crate::metadata::InodeRecord>,
+    },
+}
+
+/// The published map: flat, or a segmented root naming an already-durable segment group.
+pub enum PublishedMap {
+    /// A map that fits one value — today's shape, unchanged.
+    Flat(Vec<ChunkRef>),
+    /// A map too large for one value. The segments are **already committed** when the flip
+    /// runs, so the flip stays O(1) and cannot exceed the transaction envelope.
+    Segmented {
+        /// The segment group the root names.
+        group: SegmentGroup,
+        /// The root's segment table.
+        segments: Vec<SegmentRef>,
+    },
+}
+
+/// **Root flip (publication)** — the single fenced batch that makes the object visible.
+///
+/// `require(mpu == Completing@E)` rides in the *same* batch as the inode create/CAS and the
+/// session→`Completed` transition, so there is no state in which the object is published and
+/// the session is not `Completed`, or the reverse — which is what makes Complete idempotent
+/// over a batch primitive that is explicitly not.
+///
+/// The fence, not per-part preconditions, is what proves the part set did not move: N part
+/// values in one batch would exceed the envelope for a 10,000-part upload, and the fence
+/// gives the identical guarantee at O(1).
+///
+/// Two obligations may ride along, and they must not be able to race each other:
+/// `retire:records:{parts}` names **only the published parts**, while any staged part the
+/// client did *not* name goes wholly into `retire:bytes:{parts}` — which marks *then*
+/// deletes, one obligation with no cross-obligation dependency to get wrong. Naming all the
+/// parts in the records obligation would let it delete an unnamed part's record first, and
+/// that record is both the only thing protecting those chunks and the only source of their
+/// placements — so the byte obligation would have nothing to orphan-mark from: durable bytes
+/// left unreferenced **and** unevidenced, installed by the publication path itself.
+#[allow(clippy::too_many_arguments)]
+pub fn publish_batch(
+    upload_id: &str,
+    session: &SessionRecord,
+    session_bytes: &Bytes,
+    parent: InodeId,
+    name: &str,
+    binding: &FlipBinding,
+    map: &PublishedMap,
+    size: u64,
+    object_meta: &ObjectMeta,
+    published_parts: &[u32],
+    unnamed_parts: &[u32],
+    fingerprint: &str,
+    etag: &str,
+    now_millis: u64,
+) -> (WriteBatch, SessionRecord) {
+    let (chunk_map, segments) = match map {
+        PublishedMap::Flat(chunks) => (chunks.clone(), None),
+        PublishedMap::Segmented { group, segments } => {
+            (Vec::new(), Some((group.clone(), segments.clone())))
+        }
+    };
+    let (inode_id, version, mut batch) = match binding {
+        FlipBinding::Fresh { inode } => (
+            *inode,
+            1,
+            WriteBatch::new()
+                .require_absent(metadata::inode_key(*inode))
+                .require_absent(metadata::dirent_key(parent, name))
+                .put(
+                    metadata::dirent_key(parent, name),
+                    encode(&crate::metadata::DirentRecord { inode: *inode }),
+                ),
+        ),
+        FlipBinding::Existing {
+            inode,
+            dirent_bytes,
+            inode_bytes,
+            prior,
+        } => (
+            *inode,
+            prior.version + 1,
+            WriteBatch::new()
+                .require(metadata::dirent_key(parent, name), dirent_bytes.clone())
+                .require(metadata::inode_key(*inode), inode_bytes.clone()),
+        ),
+    };
+    let record = crate::metadata::InodeRecord {
+        size,
+        chunk_map,
+        state: crate::metadata::InodeState::Committed,
+        version,
+        etag: object_meta.etag.clone(),
+        content_type: object_meta.content_type.clone(),
+        modified: object_meta.modified,
+        segments: segments.map(|(group, segments)| SegmentedMap {
+            group,
+            segment_count: segments.len() as u32,
+            segments,
+        }),
+    };
+    batch = batch.put(metadata::inode_key(inode_id), encode(&record));
+
+    let next_session = SessionRecord {
+        state: SessionState::Completed,
+        epoch: session.epoch + 1,
+        published: Some(Published {
+            inode: inode_id,
+            version,
+            etag: etag.to_string(),
+            completed_at_millis: now_millis,
+        }),
+        complete_fingerprint: Some(fingerprint.to_string()),
+        ..session.clone()
+    };
+    batch = batch
+        .require(mpu_key(upload_id), session_bytes.clone())
+        .put(mpu_key(upload_id), encode(&next_session));
+
+    let token = session_token(upload_id, session.epoch);
+    if !published_parts.is_empty() {
+        batch = batch.require_absent(retire_records_key(&token)).put(
+            retire_records_key(&token),
+            encode(&RetireRecords::Parts {
+                upload_id: upload_id.to_string(),
+                parts: encode_part_ranges(published_parts),
+            }),
+        );
+    }
+    if !unnamed_parts.is_empty() {
+        batch = batch.require_absent(retire_bytes_key(&token)).put(
+            retire_bytes_key(&token),
+            encode(&RetireBytes::UnnamedParts {
+                upload_id: upload_id.to_string(),
+                epoch: session.epoch,
+                parts: encode_part_ranges(unnamed_parts),
+            }),
+        );
+    }
+    // The superseded generation's fan-out — up to ~1.78 M fragment orphans for a max
+    // segmented object — is installed as ONE small obligation atomically with the
+    // supersede, never expanded inline: expanding it would be a *permanent* failure to
+    // publish over a large object, not a slow one.
+    if let FlipBinding::Existing { inode, prior, .. } = binding {
+        let gen_token = generation_token(*inode, prior.version);
+        batch = batch.require_absent(retire_bytes_key(&gen_token)).put(
+            retire_bytes_key(&gen_token),
+            encode(&RetireBytes::Generation {
+                inode: *inode,
+                version: prior.version,
+                chunks: prior.chunk_map.clone(),
+                segments: prior.segments.as_ref().map(|s| s.group.clone()),
+            }),
+        );
+    }
+    (batch, next_session)
+}
+
+/// **Segment write** — one byte-budgeted batch of a segmented publication, under
+/// `require(mpu == Completing@E)`, advancing the segment-write cursor **inside** the session
+/// record the batch already preconditions on (so segmentation introduces no cursor record).
+///
+/// `B_seg = ⌊(E_tx/2)/V⌋` puts per batch, byte-derived and **not** a fixed count: a count of
+/// 1,000 applied to `V`-sized segment values would put 100 MB in one batch — 10× the
+/// envelope, a permanent commit failure.
+pub const B_SEG: usize = (TX_CEILING_BYTES / 2) / VALUE_CEILING_BYTES; // 50
+
+/// Build one segment-write batch covering `segments[from .. from + B_SEG]`.
+pub fn segment_write_batch(
+    upload_id: &str,
+    session: &SessionRecord,
+    session_bytes: &Bytes,
+    group: &SegmentGroup,
+    segments: &[SegmentRecord],
+    from: usize,
+) -> (WriteBatch, SessionRecord, usize) {
+    let end = (from + B_SEG).min(segments.len());
+    let next = SessionRecord {
+        segments_written: Some(end as u32),
+        ..session.clone()
+    };
+    let mut batch = WriteBatch::new()
+        .require(mpu_key(upload_id), session_bytes.clone())
+        .put(mpu_key(upload_id), encode(&next));
+    for (offset, record) in segments[from..end].iter().enumerate() {
+        batch = batch.put(
+            seg_key(&group.nonce, group.epoch, (from + offset) as u32),
+            encode(record),
+        );
+    }
+    (batch, next, end)
+}
+
+/// **Terminal session delete** — the exactly-once `mpuctl.count` decrement point.
+///
+/// Preconditioned on the session record's **exact prior bytes**, so a gateway draining
+/// inline and the reaper may both reach it but exactly one CAS succeeds and the loser's
+/// whole batch is a no-op: the counter can neither under-count a live session nor
+/// double-decrement a torn-down one.
+///
+/// The gate is the **empty `sidx:` range**, *not* an empty `slot:` range: a slot is held by
+/// a part that crashed mid-stream and never released it (residue is deliberately kept
+/// counted against the cap), so gating on slots would deadlock teardown. The `sidx:` range
+/// is the exact set of byte-bearing residue, and it is a *frozen* set — every intent carries
+/// `require(mpu == Open@E)`, so nothing can refill it after the fence.
+///
+/// The `seggrp:` marker is deleted **iff** the nonce's `seg:` range is empty (the group was
+/// never adopted). An adopted group's marker outlives the session, because its segments must
+/// survive for as long as the object they map.
+pub fn terminal_delete_batch(
+    upload_id: &str,
+    session_bytes: &Bytes,
+    group_nonce: &str,
+    group_adopted: bool,
+    surviving_slots: &[u32],
+    control: &MpuControl,
+    control_bytes: &Bytes,
+) -> WriteBatch {
+    let next = MpuControl {
+        count: control.count.saturating_sub(1),
+        ..control.clone()
+    };
+    let mut batch = WriteBatch::new()
+        .require(mpu_key(upload_id), session_bytes.clone())
+        .require(MPUCTL_KEY.to_vec(), control_bytes.clone())
+        .delete(mpu_key(upload_id))
+        .put(MPUCTL_KEY.to_vec(), encode(&next));
+    for &index in surviving_slots {
+        batch = batch.delete(slot_key(upload_id, index));
+    }
+    if !group_adopted {
+        batch = batch.delete(seggrp_key(group_nonce));
+    }
+    batch
+}
+
+// ---------------------------------------------------------------------------------------
+// Orphan evidence — decision 4.2's three-arm per-position guard.
+// ---------------------------------------------------------------------------------------
+
+/// The value of an `orphan:` mark. Three variants, because the deployed value is a **bare
+/// decimal** `orphaned_at_millis` (`crates/custodian/src/gc.rs:110-122`) and adding an event
+/// identity is a value-schema change with legacy data in the field.
+///
+/// Decoding is dual-format: a bare decimal is a **legacy** mark carrying no event identity;
+/// a structured value carries both. A legacy mark therefore takes the "different identity"
+/// arm and converts on contact, with no migration pass — the safe direction, since a fresh
+/// reader-grace window is strictly better than reclaiming against an ancient stamp.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct OrphanMark {
+    /// The grace clock GC evaluates.
+    pub orphaned_at_millis: u64,
+    /// The identity of the unreference event that wrote this mark. `None` for a legacy
+    /// bare-decimal mark.
+    pub event: Option<String>,
+}
+
+#[derive(Serialize, Deserialize)]
+struct OrphanMarkWire {
+    orphaned_at_millis: u64,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    event: Option<String>,
+}
+
+/// Decode an `orphan:` value in **both** formats. A value that parses as a bare decimal is a
+/// legacy mark and re-encodes as the *same* legacy value until an event replaces it, so an
+/// upgraded custodian that merely reads the ledger never restarts a grace clock.
+pub fn decode_orphan_mark(bytes: &[u8]) -> Option<OrphanMark> {
+    if let Ok(text) = std::str::from_utf8(bytes) {
+        if let Ok(millis) = text.trim().parse::<u64>() {
+            return Some(OrphanMark {
+                orphaned_at_millis: millis,
+                event: None,
+            });
+        }
+    }
+    let wire: OrphanMarkWire = serde_json::from_slice(bytes).ok()?;
+    Some(OrphanMark {
+        orphaned_at_millis: wire.orphaned_at_millis,
+        event: wire.event,
+    })
+}
+
+/// Encode a structured `orphan:` mark.
+pub fn encode_orphan_mark(mark: &OrphanMark) -> Bytes {
+    encode(&OrphanMarkWire {
+        orphaned_at_millis: mark.orphaned_at_millis,
+        event: mark.event.clone(),
+    })
+}
+
+/// Add the decision-4.2 per-position guard and mutation for one fragment position to
+/// `batch`, given what the writer **read** at that position.
+///
+/// * absent ⇒ write it under `require_absent`, stamped now;
+/// * present with the **same** event identity ⇒ a duplicate of *this* retirement (the
+///   second concurrent drainer) ⇒ **skip**, original stamp intact — re-stamping would push
+///   reclamation out by a full grace window per collision, unbounded under a persistent
+///   racer;
+/// * present with a **different** identity ⇒ stale evidence predating the reference this
+///   event just removed ⇒ **replace** under an exact-value `require`, starting a full grace
+///   window for the deletion that is actually happening now. `require_absent` would make the
+///   very replacement the stale-evidence rule demands impossible.
+///
+/// Conflating the two properties is what made the earlier blanket rule wrong in one
+/// direction while fixing it in the other.
+pub fn guard_orphan_mark(
+    batch: WriteBatch,
+    key: Vec<u8>,
+    observed: Option<&Bytes>,
+    event: &str,
+    now_millis: u64,
+) -> WriteBatch {
+    let next = encode_orphan_mark(&OrphanMark {
+        orphaned_at_millis: now_millis,
+        event: Some(event.to_string()),
+    });
+    match observed {
+        None => batch.require_absent(key.clone()).put(key, next),
+        Some(bytes) => match decode_orphan_mark(bytes) {
+            Some(mark) if mark.event.as_deref() == Some(event) => batch,
+            _ => batch.require(key.clone(), bytes.clone()).put(key, next),
+        },
+    }
+}
+
+// ---------------------------------------------------------------------------------------
+// The retirement drain — bounded, re-entrant, convergent.
+// ---------------------------------------------------------------------------------------
+
+/// What one [`drain_step`] did, so a caller can poll to a deadline rather than sleep.
+#[derive(Debug, Clone, Copy, Default, PartialEq, Eq)]
+pub struct DrainReport {
+    /// Obligations fully drained and removed this pass.
+    pub obligations_drained: usize,
+    /// `orphan:` marks written.
+    pub marks_written: usize,
+    /// Staging records deleted.
+    pub records_deleted: usize,
+    /// Sessions torn down (their terminal delete committed).
+    pub sessions_deleted: usize,
+    /// Obligations still pending after this pass.
+    pub obligations_pending: usize,
+}
+
+/// Run the retirement drain to a bounded number of passes, returning the aggregate report.
+///
+/// The drain is **re-entrant and convergent without the reaper**: obligations are durable,
+/// orphan marking is guarded per position, and whichever party runs next re-derives the
+/// remaining work from the durable records. #625 supplies the crash-safe, out-of-band drain
+/// and every window-driven exit; this is the gateway's own inline, best-effort half.
+pub async fn drain<S: MetadataStore + ?Sized>(
+    store: &S,
+    now_millis: u64,
+    max_passes: usize,
+) -> Result<DrainReport> {
+    let mut total = DrainReport::default();
+    for _ in 0..max_passes {
+        let report = drain_step(store, now_millis).await?;
+        total.obligations_drained += report.obligations_drained;
+        total.marks_written += report.marks_written;
+        total.records_deleted += report.records_deleted;
+        total.sessions_deleted += report.sessions_deleted;
+        total.obligations_pending = report.obligations_pending;
+        if report.obligations_drained == 0
+            && report.marks_written == 0
+            && report.records_deleted == 0
+            && report.sessions_deleted == 0
+        {
+            break;
+        }
+    }
+    Ok(total)
+}
+
+/// One bounded drain pass: walk the `retire:` namespace in cursor-keyed pages, drain each
+/// obligation in `B`-batches, then attempt every eligible session's terminal delete.
+pub async fn drain_step<S: MetadataStore + ?Sized>(
+    store: &S,
+    now_millis: u64,
+) -> Result<DrainReport> {
+    let mut report = DrainReport::default();
+    let mut cursor: Option<Vec<u8>> = None;
+    loop {
+        // `scan_page`, not `scan`: the `retire:` namespace is deliberately not
+        // cardinality-bounded, so a population grown past `SCAN_CAP` under sustained
+        // overwrites could not be enumerated by any single `scan` — and a skipped obligation
+        // retains its bytes and records forever.
+        let page = store
+            .scan_page(RETIRE_PREFIX, cursor.as_deref(), B_OPS)
+            .await?;
+        for (key, value) in &page.entries {
+            let progressed = drain_obligation(store, key, value, now_millis, &mut report).await?;
+            if !progressed {
+                report.obligations_pending += 1;
+            }
+        }
+        match page.next {
+            Some(next) => cursor = Some(next),
+            None => break,
+        }
+    }
+    report.sessions_deleted += teardown_sessions(store).await?;
+    Ok(report)
+}
+
+/// Drain one obligation. Returns whether the obligation was fully drained and removed.
+async fn drain_obligation<S: MetadataStore + ?Sized>(
+    store: &S,
+    key: &[u8],
+    value: &Bytes,
+    now_millis: u64,
+    report: &mut DrainReport,
+) -> Result<bool> {
+    // The drain dispatches on the KEY prefix and treats a `retire:` key it cannot parse as
+    // an error, never as a default: `retire:bytes:` orphan-marks fragments while
+    // `retire:records:` must never orphan anything, so a mode misread once is silent data
+    // loss.
+    if let Some(rest) = key.strip_prefix(b"retire:bytes:".as_slice()) {
+        let token = String::from_utf8_lossy(rest).into_owned();
+        let payload: RetireBytes = decode(value)?;
+        return drain_bytes(store, key, value, &token, &payload, now_millis, report).await;
+    }
+    if let Some(rest) = key.strip_prefix(b"retire:records:".as_slice()) {
+        let token = String::from_utf8_lossy(rest).into_owned();
+        let payload: RetireRecords = decode(value)?;
+        return drain_records(store, key, value, &token, &payload, report).await;
+    }
+    Err(MultipartError::InvalidArgument(format!(
+        "unparsable retirement key `{}`",
+        String::from_utf8_lossy(key)
+    ))
+    .into())
+}
+
+/// Collect the `(orphan-key, observed-value)` pairs for a set of chunk placements.
+async fn observe_positions<S: MetadataStore + ?Sized>(
+    store: &S,
+    positions: impl IntoIterator<Item = (ChunkId, Vec<DServerId>, u16)>,
+) -> Result<Vec<(Vec<u8>, Option<Bytes>)>> {
+    let mut out = Vec::new();
+    for (chunk, placement, fragments) in positions {
+        for index in 0..fragments {
+            let server = placement
+                .get(index as usize)
+                .copied()
+                .unwrap_or_else(|| DServerId::from(index));
+            let key = metadata::orphan_key(server, FragmentId { chunk, index });
+            let observed = store.get(&key).await?;
+            out.push((key, observed));
+        }
+    }
+    Ok(out)
+}
+
+/// Drain a `retire:bytes:` obligation: **mark, then delete**. Evidence precedes the lifting
+/// of protection, always — so there is no instant at which a durable byte is both
+/// unprotected and unevidenced.
+async fn drain_bytes<S: MetadataStore + ?Sized>(
+    store: &S,
+    key: &[u8],
+    value: &Bytes,
+    token: &str,
+    payload: &RetireBytes,
+    now_millis: u64,
+    report: &mut DrainReport,
+) -> Result<bool> {
+    // Gather the positions this obligation names, plus the records it may then delete.
+    let mut positions: Vec<(ChunkId, Vec<DServerId>, u16)> = Vec::new();
+    let mut record_keys: Vec<Vec<u8>> = Vec::new();
+    match payload {
+        RetireBytes::Session {
+            upload_id, parts, ..
+        } => {
+            for (part, chunk, entry) in list_owned_staging(store, upload_id).await? {
+                let placement = entry
+                    .staged
+                    .as_ref()
+                    .map(|s| s.placement.clone())
+                    .unwrap_or_default();
+                let fragments = entry
+                    .staged
+                    .as_ref()
+                    .map(|s| s.scheme.fragment_count())
+                    .unwrap_or(placement.len() as u16);
+                positions.push((chunk, placement, fragments));
+                record_keys.push(sidx_key(upload_id, part, chunk));
+            }
+            if *parts {
+                for (number, record) in list_part_records(store, upload_id).await? {
+                    for chunk in &record.chunks {
+                        positions.push((chunk.id, chunk.placement.clone(), chunk.fragment_count()));
+                    }
+                    record_keys.push(part_key(upload_id, number));
+                    record_keys.push(psum_key(upload_id, number));
+                }
+            }
+        }
+        RetireBytes::UnnamedParts {
+            upload_id, parts, ..
+        } => {
+            for number in expand_part_ranges(parts) {
+                let Some(bytes) = store.get(&part_key(upload_id, number)).await? else {
+                    continue;
+                };
+                let record: PartRecord = decode(&bytes)?;
+                for chunk in &record.chunks {
+                    positions.push((chunk.id, chunk.placement.clone(), chunk.fragment_count()));
+                }
+                record_keys.push(part_key(upload_id, number));
+                record_keys.push(psum_key(upload_id, number));
+            }
+        }
+        RetireBytes::Chunks { placements } => {
+            for staged in placements {
+                let fragments = staged.placement.len().max(1) as u16;
+                positions.push((staged.id, staged.placement.clone(), fragments));
+            }
+        }
+        RetireBytes::Generation {
+            chunks, segments, ..
+        } => {
+            for chunk in chunks {
+                positions.push((chunk.id, chunk.placement.clone(), chunk.fragment_count()));
+            }
+            if let Some(group) = segments {
+                // Re-read each `seg:` record's CURRENT placement at drain time, never a
+                // frozen one, so a fragment a repoint moved before the supersede won the
+                // inode CAS is orphaned at its current position.
+                let prefix = seg_prefix(&group.nonce, group.epoch);
+                for (seg_key_bytes, seg_value) in store.scan(&prefix).await? {
+                    let record: SegmentRecord = decode(&seg_value)?;
+                    for chunk in &record.chunks {
+                        positions.push((chunk.id, chunk.placement.clone(), chunk.fragment_count()));
+                    }
+                    record_keys.push(seg_key_bytes);
+                }
+                record_keys.push(seggrp_key(&group.nonce));
+            }
+        }
+    }
+
+    let observed = observe_positions(store, positions).await?;
+    // Phase 1 — MARK, in `B`-batches. Nothing is deleted until every position this
+    // obligation names carries evidence.
+    let mut wrote_any = false;
+    for window in observed.chunks(B_OPS.min(B_BYTES_SMALL)) {
+        let mut batch = WriteBatch::new().require(key.to_vec(), value.clone());
+        let mut mutations = 0usize;
+        for (position, current) in window {
+            let before = batch.puts.len();
+            batch = guard_orphan_mark(batch, position.clone(), current.as_ref(), token, now_millis);
+            if batch.puts.len() != before {
+                mutations += 1;
+            }
+        }
+        if mutations == 0 {
+            continue;
+        }
+        // A guard loss re-reads and re-splits, marking strictly fewer positions each round,
+        // so it converges.
+        if store.commit(batch).await? == CommitOutcome::Committed {
+            report.marks_written += mutations;
+            wrote_any = true;
+        } else {
+            return Ok(false);
+        }
+    }
+
+    // Phase 2 — DELETE the naming records, then the obligation itself, single-winner on
+    // `require(retire:… == prior)`.
+    let mut batch = WriteBatch::new()
+        .require(key.to_vec(), value.clone())
+        .delete(key.to_vec());
+    let mut deletes = 0usize;
+    for record_key in record_keys.iter().take(B_OPS) {
+        batch = batch.delete(record_key.clone());
+        deletes += 1;
+    }
+    if record_keys.len() > B_OPS {
+        // More records than one batch may carry: delete a bounded page and leave the
+        // obligation standing so the next pass resumes.
+        let mut page = WriteBatch::new().require(key.to_vec(), value.clone());
+        for record_key in record_keys.iter().take(B_OPS) {
+            page = page.delete(record_key.clone());
+        }
+        if store.commit(page).await? == CommitOutcome::Committed {
+            report.records_deleted += B_OPS;
+        }
+        return Ok(false);
+    }
+    if store.commit(batch).await? == CommitOutcome::Committed {
+        report.records_deleted += deletes;
+        report.obligations_drained += 1;
+        return Ok(true);
+    }
+    Ok(wrote_any)
+}
+
+/// Drain a `retire:records:` obligation — record deletions only, never an orphan mark.
+async fn drain_records<S: MetadataStore + ?Sized>(
+    store: &S,
+    key: &[u8],
+    value: &Bytes,
+    _token: &str,
+    payload: &RetireRecords,
+    report: &mut DrainReport,
+) -> Result<bool> {
+    let mut record_keys: Vec<Vec<u8>> = Vec::new();
+    match payload {
+        RetireRecords::Parts { upload_id, parts } => {
+            for number in expand_part_ranges(parts) {
+                record_keys.push(part_key(upload_id, number));
+                record_keys.push(psum_key(upload_id, number));
+            }
+        }
+        RetireRecords::Segments { group } => {
+            let prefix = seg_prefix(&group.nonce, group.epoch);
+            for (seg_key_bytes, _) in store.scan(&prefix).await? {
+                record_keys.push(seg_key_bytes);
+            }
+        }
+    }
+    if record_keys.len() > B_OPS {
+        let mut page = WriteBatch::new().require(key.to_vec(), value.clone());
+        for record_key in record_keys.iter().take(B_OPS) {
+            page = page.delete(record_key.clone());
+        }
+        if store.commit(page).await? == CommitOutcome::Committed {
+            report.records_deleted += B_OPS;
+        }
+        return Ok(false);
+    }
+    let mut batch = WriteBatch::new()
+        .require(key.to_vec(), value.clone())
+        .delete(key.to_vec());
+    for record_key in &record_keys {
+        batch = batch.delete(record_key.clone());
+    }
+    if store.commit(batch).await? == CommitOutcome::Committed {
+        report.records_deleted += record_keys.len();
+        report.obligations_drained += 1;
+        return Ok(true);
+    }
+    Ok(false)
+}
+
+/// Attempt the terminal delete of every session whose obligations have drained and whose
+/// `sidx:` range is observed empty **in this pass**.
+async fn teardown_sessions<S: MetadataStore + ?Sized>(store: &S) -> Result<usize> {
+    let mut deleted = 0usize;
+    for (upload_id, session) in list_sessions(store).await? {
+        if session.state != SessionState::Aborting {
+            // A `Completed` session survives as a tombstone until its window elapses; the
+            // window-driven exit is #625's. An `Open`/`Completing` one has not been fenced.
+            continue;
+        }
+        // Two bounded emptiness reads over the session's OWN obligation ranges — never a
+        // walk of the whole `retire:` namespace. A `g:` obligation belongs to the
+        // generation, not the session, so the gate ignores it.
+        if !store
+            .scan(&retire_bytes_session_prefix(&upload_id))
+            .await?
+            .is_empty()
+            || !store
+                .scan(&retire_records_session_prefix(&upload_id))
+                .await?
+                .is_empty()
+        {
+            continue;
+        }
+        if !list_owned_staging(store, &upload_id).await?.is_empty() {
+            continue;
+        }
+        let Some((_, session_bytes)) = read_session(store, &upload_id).await? else {
+            continue;
+        };
+        let (control, control_bytes) = read_control(store).await?;
+        let Some(control_bytes) = control_bytes else {
+            continue;
+        };
+        let surviving: Vec<u32> = list_slots(store, &upload_id)
+            .await?
+            .into_iter()
+            .map(|(i, _, _)| i)
+            .collect();
+        let adopted = !store
+            .scan(&format!("seg:{}:", session.group_nonce).into_bytes())
+            .await?
+            .is_empty();
+        let batch = terminal_delete_batch(
+            &upload_id,
+            &session_bytes,
+            &session.group_nonce,
+            adopted,
+            &surviving,
+            &control,
+            &control_bytes,
+        );
+        if store.commit(batch).await? == CommitOutcome::Committed {
+            deleted += 1;
+        }
+    }
+    Ok(deleted)
+}
+
+// ---------------------------------------------------------------------------------------
+// Chunk-size selection for a single `PutObject` (decision 7's carve-out).
+// ---------------------------------------------------------------------------------------
+
+/// The chunk size a **single `PutObject`** of `content_length` bytes publishes at.
+///
+/// Segmentation is multipart-only — staged publication needs an upload id, a fenced
+/// `Completing@E` state and a fence epoch, none of which a single PUT has — so a single PUT
+/// stays **flat** and reaches large sizes by choosing a chunk size that fits its declared
+/// length inside [`MAX_MAP_CHUNKS`]:
+/// `chunk_size_effective = max(DEFAULT_CHUNK_SIZE, ⌈Content-Length / MAX_MAP_CHUNKS⌉)`.
+///
+/// `Err(EntityTooLarge)` when the object cannot fit even at [`CHUNK_SIZE_MAX`] — the client
+/// must use multipart. In the S3 range (`Content-Length ≤ 5 GiB`) a sane `chunk_size_max`
+/// always fits, so the refusal is a guard, not a routine path.
+pub fn chunk_size_for_put(
+    content_length: u64,
+    default_chunk_size: usize,
+    chunk_size_max: usize,
+) -> std::result::Result<usize, MultipartError> {
+    let needed = content_length.div_ceil(MAX_MAP_CHUNKS as u64);
+    let selected = (needed as usize).max(default_chunk_size);
+    if selected > chunk_size_max {
+        return Err(MultipartError::EntityTooLarge);
+    }
+    Ok(selected)
+}
+
+/// The chunk size a **lengthless** `aws-chunked` PUT publishes at.
+///
+/// A lengthless stream cannot evaluate the formula at all (`x-amz-decoded-content-length` is
+/// optional by design), so it uses the **size-independent** `⌈5 GiB / MAX_MAP_CHUNKS⌉` —
+/// which is exactly the configuration precondition [`check_chunk_size_config`] enforces at
+/// load, so this can never exceed `chunk_size_max` on a conforming deployment.
+pub fn chunk_size_for_lengthless(default_chunk_size: usize) -> usize {
+    let needed = SINGLE_PUT_MAX_BYTES.div_ceil(MAX_MAP_CHUNKS as u64) as usize;
+    needed.max(default_chunk_size)
+}
+
+/// The **configuration-load** precondition of decision 7: `chunk_size_max ≥ ⌈5 GiB /
+/// MAX_MAP_CHUNKS⌉`.
+///
+/// Checked at configuration load and refused at header time (never mid-stream) when a
+/// deployment does not meet it: a lengthless stream that discovered the shortfall halfway
+/// through would have already staged bytes it can never publish.
+pub fn check_chunk_size_config(chunk_size_max: usize) -> std::result::Result<(), MultipartError> {
+    let required = SINGLE_PUT_MAX_BYTES.div_ceil(MAX_MAP_CHUNKS as u64) as usize;
+    if chunk_size_max < required {
+        return Err(MultipartError::InvalidArgument(format!(
+            "chunk_size_max ({chunk_size_max}) is below the {required} bytes a lengthless \
+             aws-chunked PutObject needs to fit MAX_MAP_CHUNKS ({MAX_MAP_CHUNKS})"
+        )));
+    }
+    Ok(())
+}
+
+/// Split an ordered chunk list into the segments a segmented publication writes, or `None`
+/// when the map fits flat.
+pub fn plan_segments(chunks: &[ChunkRef]) -> Option<Vec<SegmentRecord>> {
+    if chunks.len() <= MAX_MAP_CHUNKS {
+        return None;
+    }
+    let mut out = Vec::new();
+    let mut offset = 0u64;
+    for window in chunks.chunks(MAX_SEG_CHUNKS) {
+        let byte_len: u64 = window.iter().map(|c| c.len).sum();
+        out.push(SegmentRecord {
+            chunks: window.to_vec(),
+            byte_offset: offset,
+            byte_len,
+        });
+        offset += byte_len;
+    }
+    Some(out)
+}
+
+/// The published object metadata a Complete stamps (ADR-0047): the multipart ETag, the
+/// session's declared content type, and the Complete instant — publication time is the
+/// instant the object became atomically visible.
+pub fn published_object_meta(
+    etag: &str,
+    content_type: Option<String>,
+    now_millis: u64,
+) -> ObjectMeta {
+    ObjectMeta {
+        etag: Some(etag.to_string()),
+        content_type,
+        modified: Some(now_millis),
+    }
+}
