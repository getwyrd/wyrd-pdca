+/// One open upload session in a session listing.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct OpenUpload {
+    /// The object key the session will publish to, relative to the container.
+    pub key: String,
+    /// The session's id.
+    pub upload_id: String,
