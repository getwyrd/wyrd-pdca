+/// Classify an object-path multipart form over **percent-decoded** query keys.
+fn multipart_form(method: &Method, query: &str) -> MultipartForm {
+    let uploads = decoded_query_key(query, "uploads");
+    let upload_id = decoded_query_key(query, "uploadId");
+    let part_number = decoded_query_key(query, "partNumber");
