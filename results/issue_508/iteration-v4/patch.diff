+/// The fence one **assembled write**'s staged chunks are committed under: the session and
+/// slot bytes every staging batch preconditions on, plus the identity of the part attempt.
+///
+/// Everything here is a *precondition*, never a write to shared state: `require(mpu ==
+/// Open@E)` is what makes the session's `sidx:` range a frozen set after the Complete fence,
+/// and — because a read precondition does not write — N concurrent part uploads sharing one
+/// session precondition never conflict with each other (proposal 0016 decision 1.3).
+#[derive(Debug, Clone)]
+pub struct StagingFence {
+    /// The owning upload id.
+    pub upload_id: String,
+    /// The part number being staged.
+    pub part_number: u32,
+    /// The in-flight slot index this attempt holds.
+    pub slot_index: u32,
+    /// The session record's exact bytes — the `Open@E` fence.
+    pub session_bytes: Bytes,
+}
+
+/// What one [`stream_staged_data`] call left behind, so its caller can commit the part or
+/// compensate for it without re-reading anything.
+#[derive(Debug)]
+pub struct StagedPart {
+    /// The staged chunk map (no fragment bytes retained).
+    pub plan: WritePlan,
+    /// The slot record's current bytes — rewritten in the SAME batch as each chunk's owned
+    /// lease, so the reaper's fence, which pins the slot, cannot abort a progressing part.
+    pub slot_bytes: Bytes,
+    /// Every staged chunk with the placement its owned entry recorded, so a compensation
+    /// can name the exact bytes to orphan-mark without reading records it is about to
+    /// delete.
+    pub staged: Vec<(ChunkId, Vec<DServerId>)>,
+}
+
+/// Phases 1–2 for one **part** of an assembled write: re-chunk `source`, and for each chunk
+/// commit an **owned staging entry** `sidx:<upload>:<part>:<chunk>` and then fan its
+/// fragments out.
+///
+/// This is [`stream_write_data`] with the protection record swapped. The differences are all
+/// invariant-bearing:
+///
+/// * the entry lives under the **disjoint `sidx:` prefix**, never `pending:` — so no global
+///   `scan("pending:")` (the restore pass, the expiry sweep) ever enumerates an owned entry,
+///   and the fleet-wide owned population cannot inflate a scan past `SCAN_CAP` and stall the
+///   restore command;
+/// * it carries the chunk's **planned placement**, because `orphan:` records are
+///   placement-keyed and a record-only reaper holding only a chunk id could not compute
+///   those keys, nor could drain count an in-flight owned fragment as held on a *specific*
+///   draining server;
+/// * the batch is preconditioned `require(mpu == Open@E)`, so no owned entry can be created
+///   after the session leaves `Open` — which is what makes the teardown's "sidx: range
+///   observed empty" gate a statement about a set nothing can refill;
+/// * the batch carries `require_absent(desired:dserver:<S>)` for every server in the
+///   placement — the **drain fence**. Filtering the selector is not enough on its own:
+///   selection reads a topology snapshot while the intent that makes the placement
+///   observable commits later, so a drain recorded inside that window escapes a filter
+///   entirely and the server can be reported `Satisfied` and wiped before the intent lands;
+/// * the owning `slot:` record is rewritten in the **same** batch, so the liveness the reap
+///   fence pins moves with the part's progress.
+///
+/// A `Conflict` on any staging batch means the fence moved (the session was completed,
+/// aborted or reaped) or the placement raced a drain request; the caller compensates rather
+/// than retrying blind.
+#[allow(clippy::too_many_arguments)]
+pub async fn stream_staged_data<S>(
+    meta: &impl MetadataStore,
+    chunks: &impl PlacementChunkStore,
+    mut source: S,
+    chunk_size: usize,
+    scheme: EcScheme,
+    mut now_fn: impl FnMut() -> u64,
+    lease_ttl_millis: u64,
+    mut next_id: impl FnMut() -> ChunkId,
+    fence: &StagingFence,
+    slot: &crate::multipart::SlotRecord,
+    slot_bytes: Bytes,
+    max_chunks: usize,
+) -> Result<StagedPart>
+where
+    S: futures_util::Stream<Item = Result<Bytes>> + Unpin,
+{
+    use futures_util::StreamExt;
+
+    let chunk_size = chunk_size.max(1);
+    let mut planned: Vec<PlannedChunk> = Vec::new();
+    let mut staged: Vec<(ChunkId, Vec<DServerId>)> = Vec::new();
+    let mut slot_bytes = slot_bytes;
+    let mut size: u64 = 0;
+    let mut buf: Vec<u8> = Vec::with_capacity(chunk_size);
+
+    let mut pending_piece: Option<(ChunkId, Vec<u8>)> = None;
+    loop {
+        if let Some((id, piece)) = pending_piece.take() {
+            let (chunk, entry_placement, next_slot_bytes) = stage_one_chunk(
+                meta,
+                chunks,
+                scheme,
+                id,
+                &piece,
+                now_fn(),
+                lease_ttl_millis,
+                fence,
+                slot,
+                &slot_bytes,
+            )
+            .await?;
+            size += piece.len() as u64;
+            slot_bytes = next_slot_bytes;
+            staged.push((id, entry_placement));
+            planned.push(chunk);
+            if planned.len() > max_chunks {
+                // Refused **after** staging, so the caller must compensate rather than
+                // merely return: the bytes, the `sidx:` records and the slot would
+                // otherwise be stranded until the whole session is torn down, and a client
+                // that repeats the refusal fills every slot and turns a usable session into
+                // a permanent refusal.
+                return Ok(StagedPart {
+                    plan: WritePlan {
+                        chunks: planned,
+                        size,
+                        object_meta: ObjectMeta::default(),
+                    },
+                    slot_bytes,
+                    staged,
+                });
+            }
+            continue;
+        }
+        let Some(item) = source.next().await else {
+            break;
+        };
+        let bytes = item?;
+        let mut rest = &bytes[..];
+        while !rest.is_empty() {
+            let take = (chunk_size - buf.len()).min(rest.len());
+            buf.extend_from_slice(&rest[..take]);
+            rest = &rest[take..];
+            if buf.len() == chunk_size {
+                let id = next_id();
+                let piece = std::mem::take(&mut buf);
+                let (chunk, entry_placement, next_slot_bytes) = stage_one_chunk(
+                    meta,
+                    chunks,
+                    scheme,
+                    id,
+                    &piece,
+                    now_fn(),
+                    lease_ttl_millis,
+                    fence,
+                    slot,
+                    &slot_bytes,
+                )
+                .await?;
+                size += piece.len() as u64;
+                slot_bytes = next_slot_bytes;
+                staged.push((id, entry_placement));
+                planned.push(chunk);
+                buf = Vec::with_capacity(chunk_size);
+            }
+        }
+    }
+    if !buf.is_empty() {
+        pending_piece = Some((next_id(), std::mem::take(&mut buf)));
+    }
+    if let Some((id, piece)) = pending_piece {
+        let (chunk, entry_placement, next_slot_bytes) = stage_one_chunk(
+            meta,
+            chunks,
+            scheme,
+            id,
+            &piece,
+            now_fn(),
+            lease_ttl_millis,
+            fence,
+            slot,
+            &slot_bytes,
+        )
+        .await?;
+        size += piece.len() as u64;
+        slot_bytes = next_slot_bytes;
+        staged.push((id, entry_placement));
+        planned.push(chunk);
+    }
+
+    Ok(StagedPart {
