+/// `NoSuchUpload` / `EntityTooSmall` / `SlowDown` spellings, so a second front-door
+/// (`gateway-nfs`, a management verb) maps the same faults onto its own answers.
+#[derive(Debug, PartialEq, Eq)]
+pub enum MultipartFault {
+    /// No upload session with that id exists in a state that could serve the request —
+    /// it was never created, was cancelled, or its tombstone answered a *different*
+    /// assembly.
+    UnknownUpload,
+    /// The session is fenced by a publication already in progress. At most one publisher
+    /// at a time is a guarantee, not an accident: a second concurrent completer is a
+    /// conflict, never a parallel resume.
+    UploadBusy,
+    /// An admission ceiling refused the request — too many parts in flight for this
+    /// upload, or too many uploads open across the deployment. Backpressure, not an error.
+    Overloaded,
+    /// A named part is absent, or its recorded digest does not match the one named.
+    PartMissingOrMismatched,
+    /// The named parts were not in ascending part-number order.
+    PartsOutOfOrder,
+    /// A non-final part is below the minimum a part may be.
+    PartTooSmall,
+    /// A part, or the assembled object, exceeds what this deployment is configured to
+    /// publish. Surfaced rather than hit at the backend: a refusal, never an
+    /// over-envelope commit.
+    TooLarge,
+    /// A malformed argument (a part number outside the legal range, an unparsable id).
+    InvalidArgument(String),
+    /// The target container has no record.
+    NoSuchContainer,
+    /// The publication compare-and-set lost to concurrent writes on the target key more
+    /// times than the bound allows. The session is left usable and the client may retry
+    /// without re-uploading a part.
+    PublishContended,
+}
+
+impl std::fmt::Display for MultipartFault {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        match self {
+            MultipartFault::UnknownUpload => write!(f, "the specified upload does not exist"),
+            MultipartFault::UploadBusy => {
+                write!(f, "a conflicting operation is in progress on this upload")
+            }
+            MultipartFault::Overloaded => {
+                write!(f, "too many in-flight parts or open uploads; retry")
+            }
+            MultipartFault::PartMissingOrMismatched => write!(
+                f,
+                "one or more of the specified parts could not be found, or its entity tag did \
+                 not match"
+            ),
+            MultipartFault::PartsOutOfOrder => {
+                write!(f, "the list of parts was not in ascending order")
+            }
+            MultipartFault::PartTooSmall => write!(
+                f,
+                "a non-final part is smaller than the minimum allowed object size"
+            ),
+            MultipartFault::TooLarge => {
+                write!(f, "the proposed upload exceeds the maximum allowed size")
+            }
+            MultipartFault::InvalidArgument(what) => write!(f, "invalid argument: {what}"),
+            MultipartFault::NoSuchContainer => {
+                write!(f, "the specified container does not exist")
+            }
+            MultipartFault::PublishContended => write!(
+                f,
+                "the upload could not be published because of concurrent writes to the target \
+                 key; retry"
+            ),
+        }
+    }
+}
