+/// The **assembled-write** side of the gateway seam (proposal 0016, issue #508): a write
+/// whose durable staging outlives any single request or lease window.
+///
+/// It is a companion trait rather than more methods on [`ObjectGateway`] for the same
+/// reason [`ContainerGateway`] is: an object-only front-door implements neither, and the
+/// seam stays narrow (ADR-0010, ADR-0046 decision 6). No S3 vocabulary crosses it —
+/// "upload", "part" and "container" are the neutral nouns of the class, and the status
+/// codes, XML and routing stay in the S3 crate.
+///
+/// Every method streams: a part body is a byte stream, never a buffered whole part, so the
+/// "stream, don't buffer" invariant holds at the seam and a 5 GiB part cannot be an OOM.
+/// Every method carries a **refusing default**, exactly as
+/// [`ContainerGateway::list_container`] does: a front-door with no assembled-write surface —
+/// and this crate's own object-focused test doubles — then need no bespoke impl, and answer
+/// "no such upload" rather than mishandling the verb. The composition root's real gateway
+/// overrides all six.
+pub trait MultipartGateway: Send + Sync + 'static {
+    /// Begin an assembled write to `key` in `container`, returning the session id. Fails
+    /// with [`MultipartFault::NoSuchContainer`] when the container has no record and
+    /// [`MultipartFault::Overloaded`] when the admission ceiling refuses.
+    fn create_multipart_upload(
+        &self,
+        container: &str,
+        key: &str,
+        content_type: Option<String>,
+    ) -> impl Future<Output = Result<String>> + Send {
+        let _ = (container, key, content_type);
+        std::future::ready(Err(MultipartFault::UnknownUpload.into()))
+    }
+
+    /// Stage one numbered part of `upload_id` from `source`, returning the part's entity
+    /// tag. The bytes are durable and *protected by a record that names them* when this
+    /// returns — never by a timer.
+    fn upload_part<S>(
+        &self,
+        container: &str,
+        key: &str,
+        upload_id: &str,
+        part_number: u32,
+        source: S,
+    ) -> impl Future<Output = Result<String>> + Send
+    where
+        S: Stream<Item = Result<Bytes>> + Send + Unpin + 'static,
+    {
+        let _ = (container, key, upload_id, part_number, source);
+        std::future::ready(Err(MultipartFault::UnknownUpload.into()))
+    }
+
+    /// Assemble exactly the parts `named`, in the order given, into the object at `key`
+    /// and publish it, returning the published entity tag. Idempotent across a client
+    /// retry of the *same* assembly; a *different* assembly reusing a consumed id is
+    /// [`MultipartFault::UnknownUpload`], never a silent wrong answer.
+    fn complete_multipart_upload(
+        &self,
+        container: &str,
+        key: &str,
+        upload_id: &str,
+        named: &[NamedPart],
+    ) -> impl Future<Output = Result<String>> + Send {
+        let _ = (container, key, upload_id, named);
+        std::future::ready(Err(MultipartFault::UnknownUpload.into()))
+    }
+
+    /// Cancel `upload_id`. Idempotent while the session is being torn down. Returns from
+    /// the fence commit alone — teardown is **not** on the request path, so latency does
+    /// not scale with session size.
+    fn abort_multipart_upload(
+        &self,
+        container: &str,
+        key: &str,
+        upload_id: &str,
+    ) -> impl Future<Output = Result<()>> + Send {
+        let _ = (container, key, upload_id);
+        std::future::ready(Err(MultipartFault::UnknownUpload.into()))
+    }
+
+    /// List the parts staged under `upload_id`, one page at a time.
+    fn list_parts(
+        &self,
+        container: &str,
+        key: &str,
+        upload_id: &str,
+        after: Option<u32>,
+        max: usize,
+    ) -> impl Future<Output = Result<PartListing>> + Send {
+        let _ = (container, key, upload_id, after, max);
+        std::future::ready(Err(MultipartFault::UnknownUpload.into()))
+    }
+
+    /// List the container's sessions that are still accepting or publishing work. A
+    /// cancelled or completed session is **not** listed.
+    fn list_multipart_uploads(
+        &self,
+        container: &str,
+        prefix: Option<&str>,
+    ) -> impl Future<Output = Result<Vec<OpenUpload>>> + Send {
+        let _ = (container, prefix);
+        std::future::ready(Ok(Vec::new()))
+    }
+}
