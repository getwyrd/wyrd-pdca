+// ---- multipart (issue #508) --------------------------------------------------------------
+
+/// Map a neutral [`MultipartFault`] onto its S3 status + code.
+///
+/// The mapping is exhaustive by construction: a fault variant added later fails to compile
+/// here rather than falling into a catch-all 500, which is what kept a `NoSuchUpload` from
+/// ever being reported as an internal error.
+fn multipart_fault_response(request_id: RequestId, err: &BoxError) -> Response {
+    let Some(fault) = err.downcast_ref::<MultipartFault>() else {
+        return gateway_error_response(request_id, err);
+    };
+    let (status, code) = match fault {
+        MultipartFault::UnknownUpload => (StatusCode::NOT_FOUND, "NoSuchUpload"),
+        // The `Completing` cell of the verb × state table is `409` for EVERY client verb,
+        // including a client's own timeout retry of Complete: there is no client path that
+        // resumes a fenced session.
+        MultipartFault::UploadBusy | MultipartFault::PublishContended => {
+            (StatusCode::CONFLICT, "OperationAborted")
+        }
+        // A normal, expected S3 answer rather than an error in the usual sense — it is the
+        // backpressure that stops one client parking unbounded half-finished debris.
+        MultipartFault::Overloaded => (StatusCode::SERVICE_UNAVAILABLE, "SlowDown"),
+        MultipartFault::PartMissingOrMismatched => (StatusCode::BAD_REQUEST, "InvalidPart"),
+        MultipartFault::PartsOutOfOrder => (StatusCode::BAD_REQUEST, "InvalidPartOrder"),
+        MultipartFault::PartTooSmall => (StatusCode::BAD_REQUEST, "EntityTooSmall"),
+        MultipartFault::TooLarge => (StatusCode::BAD_REQUEST, "EntityTooLarge"),
+        MultipartFault::InvalidArgument(_) => (StatusCode::BAD_REQUEST, "InvalidArgument"),
+        MultipartFault::NoSuchContainer => (StatusCode::NOT_FOUND, "NoSuchBucket"),
+    };
+    error_response(request_id, status, code, &fault.to_string())
+}
