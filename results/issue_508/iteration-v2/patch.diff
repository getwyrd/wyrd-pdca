+/// Abort ends the session (subsequent verbs are `NoSuchUpload`), and abort + a custodian GC
+/// pass leave **no unreferenced staged fragments**: the tempdir's `.frag` count, non-zero after
+/// staging, returns to its pre-upload baseline.
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn abort_ends_the_session_and_gc_reclaims_staged_fragments() {
+    let (addr, meta, dir) = start_gateway().await;
+    let client = sdk_client(addr);
+    let key = "big/aborted-object";
+
+    let baseline = count_fragments(dir.path());
+
+    let part1 = body(FIVE_MIB, 5);
+    let part2 = body(FIVE_MIB, 6);
+
+    let created = client
+        .create_multipart_upload()
+        .bucket(BUCKET)
+        .key(key)
+        .send()
+        .await
+        .expect("create");
+    let upload_id = created.upload_id().expect("upload id").to_string();
+
+    for (n, part) in [(1u32, &part1), (2u32, &part2)] {
+        client
+            .upload_part()
+            .bucket(BUCKET)
+            .key(key)
+            .upload_id(&upload_id)
+            .part_number(n as i32)
+            .body(ByteStream::from(part.clone()))
+            .send()
+            .await
+            .expect("upload part");
+    }
+
+    // Staging actually wrote fragments to the store.
+    let after_upload = count_fragments(dir.path());
+    assert!(
+        after_upload > baseline,
+        "staging must write fragments to the store (baseline {baseline}, after {after_upload})"
+    );
+
+    // A GC pass while the upload is LIVE must reclaim nothing: the staged fragments are
+    // referenced by the `uploadpart:` records, so the custodian's reference set protects them.
+    run_gc_pass(&meta, dir.path()).await;
+    assert_eq!(
+        count_fragments(dir.path()),
+        after_upload,
+        "a GC pass must never reclaim a LIVE upload's staged fragments"
+    );
+
+    // Abort ends the session.
+    client
+        .abort_multipart_upload()
+        .bucket(BUCKET)
+        .key(key)
+        .upload_id(&upload_id)
+        .send()
+        .await
+        .expect("AbortMultipartUpload must be accepted");
+
+    // Every subsequent multipart verb on the aborted upload is NoSuchUpload.
+    let list_err = client
+        .list_parts()
+        .bucket(BUCKET)
+        .key(key)
+        .upload_id(&upload_id)
+        .send()
+        .await
+        .expect_err("ListParts on an aborted upload must fail");
+    assert_eq!(
+        list_err.into_service_error().code(),
+        Some("NoSuchUpload"),
+        "ListParts after Abort must be NoSuchUpload"
+    );
+    let up_err = client
+        .upload_part()
+        .bucket(BUCKET)
+        .key(key)
+        .upload_id(&upload_id)
+        .part_number(3)
+        .body(ByteStream::from(body(4096, 7)))
+        .send()
+        .await
+        .expect_err("UploadPart on an aborted upload must fail");
+    assert_eq!(
+        up_err.into_service_error().code(),
+        Some("NoSuchUpload"),
+        "UploadPart after Abort must be NoSuchUpload"
+    );
+    let complete_err = client
+        .complete_multipart_upload()
+        .bucket(BUCKET)
+        .key(key)
+        .upload_id(&upload_id)
+        .multipart_upload(
+            CompletedMultipartUpload::builder()
+                .parts(
+                    CompletedPart::builder()
+                        .part_number(1)
+                        .e_tag("\"x\"")
+                        .build(),
+                )
+                .build(),
+        )
+        .send()
+        .await
+        .expect_err("Complete on an aborted upload must fail");
+    assert_eq!(
+        complete_err.into_service_error().code(),
+        Some("NoSuchUpload"),
+        "Complete after Abort must be NoSuchUpload"
+    );
+
+    // Abort orphaned the staged chunks but did NOT delete their bytes eagerly — they are still
+    // on disk, awaiting the reader-safe GC window.
+    let after_abort = count_fragments(dir.path());
+    assert!(
+        after_abort > baseline,
+        "abort routes staged chunks into the GC path; it must not eagerly delete their bytes \
+         (after abort {after_abort}, baseline {baseline})"
+    );
+
+    // A custodian GC pass over the SAME stores (grace window 0, a far-future clock so the orphan
+    // grace has elapsed) reclaims the orphaned staged fragments.
+    assert_eq!(
+        run_gc_pass(&meta, dir.path()).await,
+        Reconciled::Changed,
+        "the GC pass must reclaim the aborted upload's fragments"
+    );
+
+    let after_gc = count_fragments(dir.path());
+    assert_eq!(
+        after_gc, baseline,
+        "abort + the custodian GC pass must leave no unreferenced staged fragments: the \
+         fragment-file count must return to its pre-upload baseline (baseline {baseline}, \
+         after GC {after_gc})"
+    );
+}
+
+/// A custodian pass must never strand a **live** upload's staged parts. The post-restore
+/// reconciliation pass marks every fragment no live reference points at as an orphan — the
+/// evidence GC reclaims on — so without the custodian's staged-part reference hook an
+/// in-progress multipart upload is marked stranded, reclaimed by the next GC pass, and its
+/// Complete then publishes an object over missing bytes. The whole flow is driven here: stage →
+/// restore pass → GC pass → Complete → GET byte-identical.
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn a_custodian_pass_never_strands_a_live_uploads_staged_parts() {
+    let (addr, meta, dir) = start_gateway().await;
+    let client = sdk_client(addr);
+    let key = "big/live-during-maintenance";
+
+    let part1 = body(FIVE_MIB, 12);
+    let part2 = body(4096, 13);
+
+    let created = client
+        .create_multipart_upload()
+        .bucket(BUCKET)
+        .key(key)
+        .send()
+        .await
+        .expect("create");
+    let upload_id = created.upload_id().expect("upload id").to_string();
+
+    let mut etags = Vec::new();
+    for (n, part) in [(1u32, &part1), (2u32, &part2)] {
+        let up = client
+            .upload_part()
+            .bucket(BUCKET)
+            .key(key)
+            .upload_id(&upload_id)
+            .part_number(n as i32)
+            .body(ByteStream::from(part.clone()))
+            .send()
+            .await
+            .expect("upload part");
+        etags.push(up.e_tag().expect("part ETag").to_string());
+    }
+    let staged_fragments = count_fragments(dir.path());
+
+    // The maintenance plane runs while the upload is still open.
+    let report = run_restore_pass(&meta, dir.path()).await;
+    assert_eq!(
+        report.stranded_marked, 0,
+        "a live upload's staged fragments are REFERENCED — a custodian pass must not mark \
+         them stranded (marked {}, staged fragments {staged_fragments})",
+        report.stranded_marked
+    );
+    run_gc_pass(&meta, dir.path()).await;
+    assert_eq!(
+        count_fragments(dir.path()),
+        staged_fragments,
+        "a custodian GC pass must not reclaim a live upload's staged fragments"
+    );
+
+    // …and the upload still completes, byte-identical.
+    let multipart = CompletedMultipartUpload::builder()
+        .parts(
+            CompletedPart::builder()
+                .part_number(1)
+                .e_tag(&etags[0])
+                .build(),
+        )
+        .parts(
+            CompletedPart::builder()
+                .part_number(2)
+                .e_tag(&etags[1])
+                .build(),
+        )
+        .build();
+    client
+        .complete_multipart_upload()
+        .bucket(BUCKET)
+        .key(key)
+        .upload_id(&upload_id)
+        .multipart_upload(multipart)
+        .send()
+        .await
+        .expect("Complete must still succeed after a maintenance pass");
+    let got = client
+        .get_object()
+        .bucket(BUCKET)
+        .key(key)
+        .send()
+        .await
+        .expect("GET of the completed object must succeed");
+    let bytes = got.body.collect().await.expect("body").into_bytes();
+    let mut expected = part1.clone();
+    expected.extend_from_slice(&part2);
+    assert_eq!(
+        bytes.as_ref(),
+        expected.as_slice(),
+        "an upload that survived a maintenance pass must still assemble byte-identically"
+    );
+}
