+/// Completing with a **wrong part list** fails without publishing: a bad ETag is `InvalidPart`,
+/// and the object is never created (a subsequent GET is `NoSuchKey`).
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn completing_with_a_wrong_part_list_fails_without_publishing() {
+    let (addr, _meta, _dir) = start_gateway().await;
+    let client = sdk_client(addr);
+    let key = "big/never-published";
+
+    let part1 = body(FIVE_MIB, 3);
+    let part2 = body(4096, 4);
+
+    let created = client
+        .create_multipart_upload()
+        .bucket(BUCKET)
+        .key(key)
+        .send()
+        .await
+        .expect("create");
+    let upload_id = created.upload_id().expect("upload id");
+
+    let mut staged_etags = Vec::new();
+    for (n, part) in [(1u32, &part1), (2u32, &part2)] {
+        let up = client
+            .upload_part()
+            .bucket(BUCKET)
+            .key(key)
+            .upload_id(upload_id)
+            .part_number(n as i32)
+            .body(ByteStream::from(part.clone()))
+            .send()
+            .await
+            .expect("upload part");
+        staged_etags.push(
+            up.e_tag()
+                .expect("a staged part carries an ETag")
+                .to_string(),
+        );
+    }
+
+    // Complete with a WRONG ETag for part 1 (a valid-shaped but non-matching MD5) and the
+    // RIGHT one for part 2 (echoed from its UploadPart response), so the refusal can only be
+    // about part 1's mismatch.
+    let multipart = CompletedMultipartUpload::builder()
+        .parts(
+            CompletedPart::builder()
+                .part_number(1)
+                .e_tag("\"00000000000000000000000000000000\"")
+                .build(),
+        )
+        .parts(
+            CompletedPart::builder()
+                .part_number(2)
+                .e_tag(&staged_etags[1])
+                .build(),
+        )
+        .build();
+    let err = client
+        .complete_multipart_upload()
+        .bucket(BUCKET)
+        .key(key)
+        .upload_id(upload_id)
+        .multipart_upload(multipart)
+        .send()
+        .await
+        .expect_err("a wrong part list must be refused, not published");
+    let svc = err.into_service_error();
+    assert_eq!(
+        svc.code(),
+        Some("InvalidPart"),
+        "a non-matching part ETag must be InvalidPart, got {svc:?}"
+    );
+
+    // Nothing was published — the object does not exist.
+    let get = client.get_object().bucket(BUCKET).key(key).send().await;
+    let code = get
+        .err()
+        .map(|e| e.into_service_error().code().map(str::to_string));
+    assert_eq!(
+        code,
+        Some(Some("NoSuchKey".to_string())),
+        "a failed Complete must publish nothing (GET is NoSuchKey)"
+    );
+}
