+/// ListMultipartUploads reflects the in-progress uploads under the bucket, and paginates.
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn list_multipart_uploads_reflects_in_progress_uploads() {
+    let (addr, _meta, _dir) = start_gateway().await;
+    let client = sdk_client(addr);
+
+    let mut expected = Vec::new();
+    for key in ["a/one", "b/two"] {
+        let created = client
+            .create_multipart_upload()
+            .bucket(BUCKET)
+            .key(key)
+            .send()
+            .await
+            .expect("create");
+        expected.push((
+            key.to_string(),
+            created.upload_id().expect("upload id").to_string(),
+        ));
+    }
+
+    let listed = client
+        .list_multipart_uploads()
+        .bucket(BUCKET)
+        .send()
+        .await
+        .expect("ListMultipartUploads must be accepted (pre-fix: 501 through the bucket route)");
+    let uploads = listed.uploads();
+    let mut got: Vec<(String, String)> = uploads
+        .iter()
+        .map(|u| {
+            (
+                u.key().unwrap_or("").to_string(),
+                u.upload_id().unwrap_or("").to_string(),
+            )
+        })
+        .collect();
+    got.sort();
+    let mut want = expected.clone();
+    want.sort();
+    assert_eq!(
+        got, want,
+        "ListMultipartUploads must reflect exactly the in-progress uploads"
+    );
+    assert_eq!(
+        listed.is_truncated(),
+        Some(false),
+        "a complete ListMultipartUploads page is not truncated"
+    );
+
+    // Paginated: one upload per page, truncation reported honestly, and the marker resumes.
+    let page1 = client
+        .list_multipart_uploads()
+        .bucket(BUCKET)
+        .max_uploads(1)
+        .send()
+        .await
+        .expect("ListMultipartUploads(max-uploads=1) must be accepted");
+    assert_eq!(page1.uploads().len(), 1);
+    assert_eq!(
+        page1.is_truncated(),
+        Some(true),
+        "a page cut at max-uploads must report IsTruncated=true"
+    );
+    assert_eq!(
+        page1.uploads()[0].key(),
+        Some("a/one"),
+        "uploads page in (key, upload-id) order"
+    );
+    let page2 = client
+        .list_multipart_uploads()
+        .bucket(BUCKET)
+        .max_uploads(1)
+        .key_marker(page1.next_key_marker().expect("a resume key marker"))
+        .upload_id_marker(
+            page1
+                .next_upload_id_marker()
+                .expect("a resume upload-id marker"),
+        )
+        .send()
+        .await
+        .expect("the second ListMultipartUploads page must be accepted");
+    assert_eq!(
+        page2.uploads().first().and_then(|u| u.key()),
+        Some("b/two"),
+        "the second page resumes after the marker"
+    );
+    assert_eq!(page2.is_truncated(), Some(false));
+}
