+/// CreateMultipartUpload (`POST /b/k?uploads`): begin a session and answer an
+/// `<InitiateMultipartUploadResult>` carrying the server-minted upload id.
+async fn create_multipart<G>(
+    state: &AppState<G>,
+    request_id: RequestId,
+    object_key: &str,
+    bucket: &str,
+    key: &str,
+    content_type: Option<String>,
+) -> Response
+where
+    G: MultipartGateway,
+{
+    match state
+        .gateway
+        .create_multipart_upload(object_key, content_type)
+        .await
+    {
+        Ok(upload_id) => list_response(render_initiate_result(bucket, key, &upload_id)),
+        Err(err) => gateway_error_response(request_id, &err),
+    }
+}
