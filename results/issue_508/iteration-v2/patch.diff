+/// A **malformed** multipart query must never fall through to the plain verb: each of these
+/// forms was a safe `501` while `uploads`/`uploadId`/`partNumber` sat on the subresource
+/// denylist, and the plain arms they would otherwise reach are destructive — `PUT` streams the
+/// request body over the WHOLE object, `DELETE` deletes it.
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn a_malformed_multipart_query_never_destroys_the_object() {
+    let (addr, _meta, _dir) = start_gateway().await;
+    let client = sdk_client(addr);
+    let key = "victim";
+    let path = format!("/{BUCKET}/{key}");
+    let original = body(64 * 1024, 9);
+
+    client
+        .put_object()
+        .bucket(BUCKET)
+        .key(key)
+        .body(ByteStream::from(original.clone()))
+        .send()
+        .await
+        .expect("the victim object must be stored");
+
+    // Each of these carries a multipart query key in a form the gateway does not implement.
+    let attacks: [(&str, &str); 9] = [
+        // UploadPart missing its other half — the plain PUT would overwrite the whole object.
+        ("PUT", "partNumber=1"),
+        ("PUT", "uploadId=nonexistent"),
+        ("PUT", "uploads"),
+        // A part number that is not a number / outside S3's 1..=10000.
+        ("PUT", "partNumber=abc&uploadId=nonexistent"),
+        ("PUT", "partNumber=0&uploadId=nonexistent"),
+        ("PUT", "partNumber=10001&uploadId=nonexistent"),
+        // Abort missing its upload id — the plain DELETE would delete the object.
+        ("DELETE", "partNumber=1"),
+        ("DELETE", "uploads"),
+        // #491: the percent-encoded spelling must not dodge the guard either.
+        ("PUT", "part%4Eumber=1"),
+    ];
+    let attack_body = b"pwned".to_vec();
+    for (method, query) in attacks {
+        let payload: &[u8] = if method == "PUT" { &attack_body } else { b"" };
+        let headers = signed_headers(method, &path, query, &addr.to_string(), payload);
+        let (status, response) = send(addr, method, &path, query, &headers, payload).await;
+        assert!(
+            (400..500).contains(&status) || status == 501,
+            "`{method} {path}?{query}` must be refused, got {status}: {}",
+            String::from_utf8_lossy(&response)
+        );
+        // …and the object is untouched: still present, still byte-identical.
+        let got = client
+            .get_object()
+            .bucket(BUCKET)
+            .key(key)
+            .send()
+            .await
+            .unwrap_or_else(|e| panic!("`{method} ?{query}` must not delete the object: {e}"));
+        let bytes = got.body.collect().await.expect("body").into_bytes();
+        assert_eq!(
+            bytes.as_ref(),
+            original.as_slice(),
+            "`{method} ?{query}` must not overwrite the object"
+        );
+    }
+}
