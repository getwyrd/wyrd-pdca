@@ -0,0 +1,675 @@
+//! The **S3 multipart-upload** state machine, layered on the narrow [`MetadataStore`]
+//! primitive exactly as the object model in [`crate::metadata`] is (issue #508).
+//!
+//! Multipart state lives in the **metadata keyspace** under two new **disjoint** prefixes
+//! (ADR-0046 record pattern, decisions 1–2), keyed **collision-safely** by the
+//! server-minted opaque `upload-id` — never by the bucket/key, which carry arbitrary bytes
+//! including the dirent delimiter:
+//!
+//! * `upload:{upload-id}` — the **session record** ([`SessionRecord`]): it STORES the
+//!   object key inside the JSON, never in the key.
+//! * `uploadpart:{upload-id}:{part-number}` — one **staged-part record** ([`PartRecord`]):
+//!   the part's committed chunk map, byte size, and MD5 (the S3 part ETag). The part
+//!   number is **fixed-width** so a prefix scan returns parts in numeric order.
+//!
+//! Both prefixes are disjoint from `inode:`/`dirent:`/`pending:`/`orphan:`/`bucket:`, so
+//! they are invisible **by construction** to the custodian's existing scans — until the GC
+//! loop is *explicitly wired* to treat a staged part's chunks as referenced
+//! (`custodian::gc::referenced_fragments` scans [`PART_PREFIX`]).
+//!
+//! The store's atomic conditional `commit` is exactly what Complete needs: assemble N part
+//! chunk maps into the object's inode in **one** CAS commit, precondition on the session
+//! record still existing — so a racing Abort or a duplicate Complete loses cleanly with
+//! [`CommitOutcome::Conflict`] rather than double-publishing or tearing.
+
+use bytes::Bytes;
+use serde::{Deserialize, Serialize};
+use wyrd_traits::{ChunkId, CommitOutcome, FragmentId, MetadataStore, Result, WriteBatch};
+
+use crate::md5::Md5;
+use crate::metadata::{
+    self, decode, encode, orphan_key, ChunkRef, DirentRecord, InodeId, InodeRecord, InodeState,
+    ObjectMeta,
+};
+
+/// The prefix of the per-upload **session** record key (`upload:{upload-id}`).
+pub const SESSION_PREFIX: &[u8] = b"upload:";
+/// The prefix of a per-upload **staged-part** record key (`uploadpart:{upload-id}:{part}`).
+///
+/// It does **not** collide with [`SESSION_PREFIX`]: `uploadpart:…` does not begin with
+/// `upload:` (the 7th byte is `p`, not `:`), so a `scan(b"upload:")` returns only session
+/// records and never a part record.
+pub const PART_PREFIX: &[u8] = b"uploadpart:";
+
+/// S3's minimum size (5 MiB) for **every part except the last** — enforced at Complete
+/// (`EntityTooSmall`). Not weakened for tests; the shipped test uses ≥5 MiB parts.
+pub const MIN_PART_SIZE: u64 = 5 * 1024 * 1024;
+
+/// Key for a multipart **session** record: `upload:{upload-id}`.
+pub fn session_key(upload_id: &str) -> Vec<u8> {
+    let mut k = SESSION_PREFIX.to_vec();
+    k.extend_from_slice(upload_id.as_bytes());
+    k
+}
+
+/// Key for a staged-**part** record: `uploadpart:{upload-id}:{part:010}`. The part number
+/// is zero-padded to a fixed width so a prefix scan of one upload's parts returns them in
+/// **numeric** order (S3 part numbers are `1..=10_000`; 10 digits covers the whole `u32`).
+pub fn part_key(upload_id: &str, part_number: u32) -> Vec<u8> {
+    format!("uploadpart:{upload_id}:{part_number:010}").into_bytes()
+}
+
+/// The scan prefix for **all** of one upload's staged parts: `uploadpart:{upload-id}:`. The
+/// trailing `:` fences upload `a` off from upload `ab` — a prefix without it would spill.
+pub fn parts_prefix(upload_id: &str) -> Vec<u8> {
+    format!("uploadpart:{upload_id}:").into_bytes()
+}
+
+/// A multipart **session** record. Stores the object key **inside** the JSON (the key of
+/// the record is the opaque upload id alone), so an object key containing arbitrary bytes —
+/// including `/` or `:` — never confuses the keyspace.
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+pub struct SessionRecord {
+    /// The composed object key the completed object binds to — `{bucket}/{key}`, the same
+    /// flat-namespace dirent name an ordinary object PUT uses.
+    pub object_key: String,
+    /// The `Content-Type` the client declared at CreateMultipartUpload, stamped onto the
+    /// completed object's inode (ADR-0047). `None` if none was declared.
+    #[serde(default)]
+    pub content_type: Option<String>,
+    /// Session creation time (epoch millis) — surfaced as `Initiated` in a listing.
+    pub created_millis: u64,
+}
+
+/// A staged-**part** record: the part's committed chunk map, its byte size, and its MD5
+/// (the S3 part ETag, lowercase hex — **not** the sha256 single-PUT ETag, ADR-0047).
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+pub struct PartRecord {
+    /// The chunk map the part's bytes were RS-encoded into over the streaming write path —
+    /// the same [`ChunkRef`] shape an object inode carries, so Complete assembles the object
+    /// map by concatenating these.
+    pub chunk_map: Vec<ChunkRef>,
+    /// The part's logical byte length (its floor is enforced at Complete, [`MIN_PART_SIZE`]).
+    pub size: u64,
+    /// The part's MD5 as lowercase hex — returned as the S3 UploadPart `ETag` and folded
+    /// into the composed object ETag (`md5(concat(part-md5s))-N`).
+    pub md5_hex: String,
+}
+
+/// Create a session: `require_absent(upload:{id})` then write the [`SessionRecord`]. A
+/// [`CommitOutcome::Conflict`] means the (astronomically unlikely) upload-id collided.
+pub async fn create_session(
+    store: &impl MetadataStore,
+    upload_id: &str,
+    object_key: &str,
+    content_type: Option<String>,
+    created_millis: u64,
+) -> Result<CommitOutcome> {
+    let record = SessionRecord {
+        object_key: object_key.to_string(),
+        content_type,
+        created_millis,
+    };
+    let key = session_key(upload_id);
+    store
+        .commit(
+            WriteBatch::new()
+                .require_absent(key.clone())
+                .put(key, encode(&record)),
+        )
+        .await
+}
+
+/// Read a session record, or `None` if the upload id is unknown (the wire layer maps that
+/// to S3's `NoSuchUpload`). Returns the raw bytes too, so a follow-up conditional commit
+/// can CAS on the exact record it read.
+pub async fn get_session(
+    store: &impl MetadataStore,
+    upload_id: &str,
+) -> Result<Option<(SessionRecord, Bytes)>> {
+    match store.get(&session_key(upload_id)).await? {
+        None => Ok(None),
+        Some(bytes) => Ok(Some((decode(&bytes)?, bytes))),
+    }
+}
+
+/// Read one staged part, or `None` if that part number has not been uploaded.
+pub async fn get_part(
+    store: &impl MetadataStore,
+    upload_id: &str,
+    part_number: u32,
+) -> Result<Option<(PartRecord, Bytes)>> {
+    match store.get(&part_key(upload_id, part_number)).await? {
+        None => Ok(None),
+        Some(bytes) => Ok(Some((decode(&bytes)?, bytes))),
+    }
+}
+
+/// All of one upload's staged parts, **sorted ascending by part number** — the fixed-width
+/// key already scans numerically, but the sort makes the order explicit and independent of
+/// the store's unspecified scan order.
+pub async fn list_parts(
+    store: &impl MetadataStore,
+    upload_id: &str,
+) -> Result<Vec<(u32, PartRecord)>> {
+    let mut out = Vec::new();
+    for (key, value) in store.scan(&parts_prefix(upload_id)).await? {
+        if let Some(num) = parse_part_number(&key, upload_id) {
+            out.push((num, decode(&value)?));
+        }
+    }
+    out.sort_by_key(|(n, _)| *n);
+    Ok(out)
+}
+
+/// Every live multipart **session**, each with its record — the wire layer filters by
+/// bucket (`object_key` starts with `{bucket}/`) for ListMultipartUploads.
+pub async fn list_sessions(store: &impl MetadataStore) -> Result<Vec<(String, SessionRecord)>> {
+    let mut out = Vec::new();
+    for (key, value) in store.scan(SESSION_PREFIX).await? {
+        if let Some(id) = std::str::from_utf8(&key)
+            .ok()
+            .and_then(|s| s.strip_prefix("upload:"))
+        {
+            let record: SessionRecord = decode(&value)?;
+            out.push((id.to_string(), record));
+        }
+    }
+    out.sort_by(|a, b| a.1.object_key.cmp(&b.1.object_key).then(a.0.cmp(&b.0)));
+    Ok(out)
+}
+
+/// Commit a **staged part** record atomically (issue #508, UploadPart phase 3):
+///
+/// * `require(upload:{id} == session_bytes)` — refuse if the session was aborted/completed
+///   out from under the part (the part's bytes then get GC'd as leased garbage; nothing is
+///   published);
+/// * replace-or-create the part record — a re-upload of the same part number CAS-replaces
+///   the prior record and **orphans its chunks** into the GC path (so the superseded bytes
+///   are reclaimed after the reader-safe window), a first upload `require_absent`s it;
+/// * and, in the **same** batch, **release** the pending lease of every freshly-staged chunk
+///   (`require(pending:{id} == live) + delete`), so the chunks stop being leased garbage the
+///   instant the part record — which the GC reference-set hook now treats as referenced —
+///   is durable. A lease that lapsed mid-upload turns the precondition false and the whole
+///   commit is [`CommitOutcome::Conflict`], so a part is never published over bytes the GC
+///   is already free to reclaim (issue #490 discipline).
+#[allow(clippy::too_many_arguments)]
+pub async fn commit_part(
+    store: &impl MetadataStore,
+    upload_id: &str,
+    part_number: u32,
+    session_bytes: &Bytes,
+    record: &PartRecord,
+    prior_part: Option<&(PartRecord, Bytes)>,
+    pending_chunks: &[ChunkId],
+    now_millis: u64,
+) -> Result<CommitOutcome> {
+    let key = part_key(upload_id, part_number);
+    let mut batch = WriteBatch::new().require(session_key(upload_id), session_bytes.clone());
+    match prior_part {
+        Some((prior, prior_bytes)) => {
+            batch = batch.require(key.clone(), prior_bytes.clone());
+            batch = orphan_chunk_fragments(batch, &prior.chunk_map, now_millis);
+        }
+        None => {
+            batch = batch.require_absent(key.clone());
+        }
+    }
+    batch = batch.put(key, encode(record));
+    // Release the freshly-staged chunks' pending leases, conditional on them still being live.
+    for &chunk in pending_chunks {
+        let pkey = metadata::pending_key(chunk);
+        let Some(current) = store.get(&pkey).await? else {
+            // Already reaped from under the upload — refuse rather than publish a part over
+            // reclaimable bytes.
+            return Ok(CommitOutcome::Conflict);
+        };
+        let entry: metadata::PendingEntry = decode(&current)?;
+        if entry.lease_expiry_millis <= now_millis {
+            return Ok(CommitOutcome::Conflict);
+        }
+        batch = batch.require(pkey.clone(), current).delete(pkey);
+    }
+    store.commit(batch).await
+}
+
+/// The outcome of [`abort`].
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum AbortOutcome {
+    /// No such session — the wire layer answers `NoSuchUpload`.
+    NoSession,
+    /// The session (and its parts) were removed and the staged chunks orphaned.
+    Aborted,
+    /// A racing Complete/Abort won the session CAS — treated as an idempotent success.
+    Conflict,
+}
+
+/// Abort a session (issue #508): delete the session record **and** every staged-part record
+/// in one batch, and route each staged chunk into the **orphan/GC path** (a grace record per
+/// fragment, keyed by its placed D-server) so nothing is permanently stranded — the custodian
+/// GC reclaims the bytes after the reader-safe window. CAS on the session so a racing
+/// Complete loses cleanly.
+pub async fn abort(
+    store: &impl MetadataStore,
+    upload_id: &str,
+    now_millis: u64,
+) -> Result<AbortOutcome> {
+    let Some((_session, session_bytes)) = get_session(store, upload_id).await? else {
+        return Ok(AbortOutcome::NoSession);
+    };
+    let parts = list_parts(store, upload_id).await?;
+    let mut batch = WriteBatch::new()
+        .require(session_key(upload_id), session_bytes)
+        .delete(session_key(upload_id));
+    for (num, rec) in &parts {
+        batch = batch.delete(part_key(upload_id, *num));
+        batch = orphan_chunk_fragments(batch, &rec.chunk_map, now_millis);
+    }
+    Ok(match store.commit(batch).await? {
+        CommitOutcome::Committed => AbortOutcome::Aborted,
+        CommitOutcome::Conflict => AbortOutcome::Conflict,
+    })
+}
+
+/// Where a completed multipart object lands: a brand-new key, or an overwrite of an existing
+/// one (CAS on the prior inode, prior chunks orphaned).
+pub enum CompleteTarget {
+    /// A new object under `inode_id` — `require_absent` on both the inode and the dirent.
+    Create {
+        /// The freshly-allocated inode id for the new object.
+        inode_id: InodeId,
+    },
+    /// Overwrite the object already bound at the dirent — CAS the `prior` inode and orphan
+    /// its chunks.
+    Overwrite {
+        /// The inode the dirent already resolves to.
+        inode_id: InodeId,
+        /// The prior inode record the CAS pins the overwrite to.
+        prior: InodeRecord,
+    },
+}
+
+/// Complete a multipart upload (issue #508, one CAS commit). Assembles the ordered part
+/// chunk maps into the object's inode, binds the dirent, **deletes the session and every
+/// staged-part record**, and — atomically — orphans the chunks of any staged part *not*
+/// included in the assembled object (and, on an overwrite, the prior object's chunks). The
+/// whole thing is one [`WriteBatch`] precondition-guarded on the session record still
+/// existing, so a racing Abort or duplicate Complete loses with [`CommitOutcome::Conflict`]
+/// and never double-publishes.
+#[allow(clippy::too_many_arguments)]
+pub async fn complete(
+    store: &impl MetadataStore,
+    upload_id: &str,
+    session_bytes: &Bytes,
+    parent: InodeId,
+    name: &str,
+    target: CompleteTarget,
+    chunk_map: Vec<ChunkRef>,
+    size: u64,
+    meta: &ObjectMeta,
+    all_part_numbers: &[u32],
+    orphan_chunks: &[ChunkRef],
+    orphaned_at_millis: u64,
+) -> Result<CommitOutcome> {
+    let mut batch = WriteBatch::new().require(session_key(upload_id), session_bytes.clone());
+    match &target {
+        CompleteTarget::Create { inode_id } => {
+            let record = InodeRecord {
+                size,
+                chunk_map,
+                state: InodeState::Committed,
+                version: 1,
+                etag: meta.etag.clone(),
+                content_type: meta.content_type.clone(),
+                modified: meta.modified,
+            };
+            batch = batch
+                .require_absent(metadata::inode_key(*inode_id))
+                .require_absent(metadata::dirent_key(parent, name))
+                .put(metadata::inode_key(*inode_id), encode(&record))
+                .put(
+                    metadata::dirent_key(parent, name),
+                    encode(&DirentRecord { inode: *inode_id }),
+                );
+        }
+        CompleteTarget::Overwrite { inode_id, prior } => {
+            let next = InodeRecord {
+                size,
+                chunk_map,
+                state: InodeState::Committed,
+                version: prior.version + 1,
+                etag: meta.etag.clone(),
+                content_type: meta.content_type.clone(),
+                modified: meta.modified,
+            };
+            batch = batch
+                .require(metadata::inode_key(*inode_id), encode(prior))
+                .put(metadata::inode_key(*inode_id), encode(&next));
+        }
+    }
+    // Retire the session and every staged-part record.
+    batch = batch.delete(session_key(upload_id));
+    for &num in all_part_numbers {
+        batch = batch.delete(part_key(upload_id, num));
+    }
+    // Orphan the bytes that do NOT become part of the completed object (omitted staged parts
+    // and, on an overwrite, the prior object's chunks) so the GC reclaims them.
+    batch = orphan_chunk_fragments(batch, orphan_chunks, orphaned_at_millis);
+    store.commit(batch).await
+}
+
+/// Add an `orphan:` grace record for **every** fragment of every chunk in `chunks`, keyed by
+/// the D-server the placement record put it on ([`ChunkRef::fragments`]) — the same
+/// address the custodian GC reclaims from. Shared by re-upload, Abort, and Complete's
+/// omitted/superseded-chunk handling so the grace-record shape never drifts.
+fn orphan_chunk_fragments(
+    mut batch: WriteBatch,
+    chunks: &[ChunkRef],
+    at_millis: u64,
+) -> WriteBatch {
+    for chunk in chunks {
+        for (index, dserver) in chunk.fragments() {
+            batch = batch.put(
+                orphan_key(
+                    dserver,
+                    FragmentId {
+                        chunk: chunk.id,
+                        index,
+                    },
+                ),
+                at_millis.to_string().into_bytes(),
+            );
+        }
+    }
+    batch
+}
+
+/// Parse the part number out of a `uploadpart:{upload-id}:{part}` key for `upload_id`, or
+/// `None` if it does not belong to this upload / is malformed.
+fn parse_part_number(key: &[u8], upload_id: &str) -> Option<u32> {
+    let s = std::str::from_utf8(key).ok()?;
+    let rest = s.strip_prefix("uploadpart:")?;
+    let (id, part) = rest.rsplit_once(':')?;
+    if id != upload_id {
+        return None;
+    }
+    part.parse().ok()
+}
+
+// ---- Complete validation + assembly (pure) ----
+
+/// One part the client named in its CompleteMultipartUpload body: the part number and the
+/// ETag it expects that part to still carry.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct RequestedPart {
+    /// The 1-based part number.
+    pub part_number: u32,
+    /// The part ETag the client echoes back (quotes tolerated) — must match the staged MD5.
+    pub etag: String,
+}
+
+/// The assembled object: the concatenated chunk map, total size, and the **composed S3
+/// ETag** (`md5(concat(part-md5s))-N`).
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Assembled {
+    /// The object's chunk map — the requested parts' maps concatenated in order.
+    pub chunk_map: Vec<ChunkRef>,
+    /// The object's total byte length.
+    pub size: u64,
+    /// The S3 multipart ETag: `"<md5-of-part-md5s>-<part-count>"` (unquoted here).
+    pub etag: String,
+    /// The chunk ids that become part of the object (so Complete can orphan the rest).
+    pub kept_chunks: Vec<ChunkId>,
+}
+
+/// Why a CompleteMultipartUpload was refused **before** anything was published (S3 codes).
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum AssembleError {
+    /// The requested part list is empty, or its part numbers are not strictly ascending.
+    InvalidPartOrder,
+    /// A requested part is not staged, or its ETag does not match the staged part's MD5.
+    InvalidPart {
+        /// The offending part number.
+        part_number: u32,
+    },
+    /// A non-final requested part is smaller than [`MIN_PART_SIZE`].
+    EntityTooSmall {
+        /// The offending part number.
+        part_number: u32,
+    },
+}
+
+/// Validate the client's requested part list against the staged parts and assemble the
+/// object (pure). Enforced, in order: non-empty and **strictly ascending** part numbers
+/// (else [`AssembleError::InvalidPartOrder`]); every requested part staged with a **matching
+/// ETag** (else [`AssembleError::InvalidPart`]); every requested part **except the last** at
+/// least `min_part_size` (else [`AssembleError::EntityTooSmall`]). On success the chunk maps
+/// are concatenated in request order and the composed ETag computed.
+pub fn assemble(
+    staged: &[(u32, PartRecord)],
+    requested: &[RequestedPart],
+    min_part_size: u64,
+) -> std::result::Result<Assembled, AssembleError> {
+    if requested.is_empty() {
+        return Err(AssembleError::InvalidPartOrder);
+    }
+    // Strictly ascending, ≥ 1.
+    let mut last = 0u32;
+    for r in requested {
+        if r.part_number <= last {
+            return Err(AssembleError::InvalidPartOrder);
+        }
+        last = r.part_number;
+    }
+
+    let mut chunk_map = Vec::new();
+    let mut kept_chunks = Vec::new();
+    let mut size = 0u64;
+    let mut md5_concat = Vec::with_capacity(requested.len() * 16);
+    for (i, r) in requested.iter().enumerate() {
+        let Some((_, part)) = staged.iter().find(|(n, _)| *n == r.part_number) else {
+            return Err(AssembleError::InvalidPart {
+                part_number: r.part_number,
+            });
+        };
+        if !etag_matches(&r.etag, &part.md5_hex) {
+            return Err(AssembleError::InvalidPart {
+                part_number: r.part_number,
+            });
+        }
+        // Every part except the last must meet the size floor.
+        if i + 1 < requested.len() && part.size < min_part_size {
+            return Err(AssembleError::EntityTooSmall {
+                part_number: r.part_number,
+            });
+        }
+        for chunk in &part.chunk_map {
+            kept_chunks.push(chunk.id);
+            chunk_map.push(chunk.clone());
+        }
+        size += part.size;
+        match parse_md5_hex(&part.md5_hex) {
+            Some(raw) => md5_concat.extend_from_slice(&raw),
+            // A staged part always carries a well-formed 32-hex MD5; a corrupt record is
+            // treated as a part mismatch rather than silently composing a wrong ETag.
+            None => {
+                return Err(AssembleError::InvalidPart {
+                    part_number: r.part_number,
+                })
+            }
+        }
+    }
+
+    let mut hasher = Md5::new();
+    hasher.update(&md5_concat);
+    let etag = format!("{}-{}", hasher.finalize_hex(), requested.len());
+
+    Ok(Assembled {
+        chunk_map,
+        size,
+        etag,
+        kept_chunks,
+    })
+}
+
+/// Whether a client-echoed ETag matches a staged part's MD5 — surrounding double quotes are
+/// tolerated (the SDK sends the quoted form UploadPart returned) and the compare is
+/// case-insensitive over the hex.
+fn etag_matches(requested: &str, staged_md5_hex: &str) -> bool {
+    let trimmed = requested.trim().trim_matches('"');
+    trimmed.eq_ignore_ascii_case(staged_md5_hex)
+}
+
+/// Parse a 32-char lowercase/upper hex MD5 into its 16 raw bytes.
+fn parse_md5_hex(hex: &str) -> Option<[u8; 16]> {
+    if hex.len() != 32 {
+        return None;
+    }
+    let mut out = [0u8; 16];
+    let bytes = hex.as_bytes();
+    for (i, slot) in out.iter_mut().enumerate() {
+        let hi = (bytes[i * 2] as char).to_digit(16)?;
+        let lo = (bytes[i * 2 + 1] as char).to_digit(16)?;
+        *slot = (hi * 16 + lo) as u8;
+    }
+    Some(out)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::metadata::EcScheme;
+
+    fn part(num_md5: &str, size: u64, chunk_id: ChunkId) -> PartRecord {
+        PartRecord {
+            chunk_map: vec![ChunkRef {
+                id: chunk_id,
+                scheme: EcScheme::None,
+                len: size,
+                placement: vec![],
+            }],
+            size,
+            md5_hex: num_md5.to_string(),
+        }
+    }
+
+    /// The composed ETag is `md5(concat(raw part-md5 bytes))-N` — computed independently
+    /// here so a wrong composition (hashing the hex text instead of the raw bytes, or the
+    /// wrong count) fails.
+    #[test]
+    fn composed_etag_is_md5_of_raw_part_md5s_dash_count() {
+        let m1 = crate::md5::md5_hex(b"part-one-bytes");
+        let m2 = crate::md5::md5_hex(b"part-two-bytes");
+        let staged = vec![
+            (1u32, part(&m1, MIN_PART_SIZE, 0xA1)),
+            (2u32, part(&m2, 10, 0xB2)),
+        ];
+        let requested = vec![
+            RequestedPart {
+                part_number: 1,
+                etag: format!("\"{m1}\""),
+            },
+            RequestedPart {
+                part_number: 2,
+                etag: m2.clone(),
+            },
+        ];
+        let assembled = assemble(&staged, &requested, MIN_PART_SIZE).unwrap();
+
+        let mut raw = parse_md5_hex(&m1).unwrap().to_vec();
+        raw.extend_from_slice(&parse_md5_hex(&m2).unwrap());
+        let expected = format!("{}-2", crate::md5::md5_hex(&raw));
+        assert_eq!(assembled.etag, expected);
+        assert_eq!(assembled.size, MIN_PART_SIZE + 10);
+        assert_eq!(assembled.chunk_map.len(), 2);
+    }
+
+    /// A non-final part below the floor is `EntityTooSmall`; the last part is exempt.
+    #[test]
+    fn part_size_floor_is_enforced_except_on_the_last_part() {
+        let m1 = crate::md5::md5_hex(b"x");
+        let m2 = crate::md5::md5_hex(b"y");
+        let staged = vec![(1u32, part(&m1, 10, 1)), (2u32, part(&m2, 10, 2))];
+        let requested = vec![
+            RequestedPart {
+                part_number: 1,
+                etag: m1.clone(),
+            },
+            RequestedPart {
+                part_number: 2,
+                etag: m2.clone(),
+            },
+        ];
+        assert_eq!(
+            assemble(&staged, &requested, MIN_PART_SIZE),
+            Err(AssembleError::EntityTooSmall { part_number: 1 })
+        );
+        // A single small part is fine (it is the last).
+        let single = vec![RequestedPart {
+            part_number: 1,
+            etag: m1,
+        }];
+        assert!(assemble(&staged, &single, MIN_PART_SIZE).is_ok());
+    }
+
+    /// A wrong ETag or an unstaged part is `InvalidPart`; a descending list is
+    /// `InvalidPartOrder` — the "no publish" guards.
+    #[test]
+    fn bad_part_lists_are_rejected() {
+        let m1 = crate::md5::md5_hex(b"x");
+        let staged = vec![
+            (1u32, part(&m1, MIN_PART_SIZE, 1)),
+            (2u32, part(&m1, 10, 2)),
+        ];
+        // Wrong ETag.
+        assert_eq!(
+            assemble(
+                &staged,
+                &[RequestedPart {
+                    part_number: 1,
+                    etag: "\"deadbeef\"".into()
+                }],
+                MIN_PART_SIZE
+            ),
+            Err(AssembleError::InvalidPart { part_number: 1 })
+        );
+        // Unstaged part.
+        assert_eq!(
+            assemble(
+                &staged,
+                &[RequestedPart {
+                    part_number: 9,
+                    etag: m1.clone()
+                }],
+                MIN_PART_SIZE
+            ),
+            Err(AssembleError::InvalidPart { part_number: 9 })
+        );
+        // Descending / non-ascending.
+        assert_eq!(
+            assemble(
+                &staged,
+                &[
+                    RequestedPart {
+                        part_number: 2,
+                        etag: m1.clone()
+                    },
+                    RequestedPart {
+                        part_number: 1,
+                        etag: m1
+                    },
+                ],
+                MIN_PART_SIZE
+            ),
+            Err(AssembleError::InvalidPartOrder)
+        );
+    }
+
+    #[test]
+    fn part_key_scans_in_numeric_order_and_prefixes_are_disjoint() {
+        // `upload:` scan must not catch `uploadpart:` keys.
+        assert!(!part_key("abc", 1).starts_with(SESSION_PREFIX));
+        // Zero-padded so 2 sorts before 10 lexicographically.
+        assert!(part_key("abc", 2) < part_key("abc", 10));
+    }
+}
