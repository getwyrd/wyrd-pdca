+/// A larger `max-parts` / `max-uploads` clamps to it, exactly as `max-keys` does on the object
+/// listing route (`:723-724`).
+const MAX_LIST_PAGE: usize = 1000;
+
+/// The effective page size for `name` (`max-parts` / `max-uploads`): the client's value clamped
+/// to [`MAX_LIST_PAGE`], that maximum when the parameter is absent, or `Err(())` for a
+/// non-numeric value (S3's `InvalidArgument`). Matched on the DECODED key like every other new
+/// multipart parameter (#491).
+fn list_page_size(query: &str, name: &str) -> Result<usize, ()> {
+    match decoded_query_value(query, name) {
+        None => Ok(MAX_LIST_PAGE),
+        Some(raw) => raw
+            .trim()
+            .parse::<usize>()
+            .map(|n| n.min(MAX_LIST_PAGE))
+            .map_err(|_| ()),
+    }
+}
+
+/// ListParts (`GET /b/k?uploadId=U`): answer a `<ListPartsResult>` reflecting the staged parts,
+/// **paginated** — the seam materializes the complete ascending part list (ADR-0046, the
+/// materialize-sort-slice pattern 507 established), and the slice + truncation markers are
+/// computed here, in the one place that speaks S3.
+async fn list_parts_op<G>(
+    state: &AppState<G>,
+    request_id: RequestId,
+    object_key: &str,
+    bucket: &str,
+    key: &str,
+    upload_id: &str,
+    query: &str,
+) -> Response
+where
+    G: MultipartGateway,
+{
+    let Ok(max_parts) = list_page_size(query, "max-parts") else {
+        return error_response(
+            request_id,
+            StatusCode::BAD_REQUEST,
+            "InvalidArgument",
+            "max-parts is not a valid non-negative integer",
+        );
+    };
+    // The resume point: only parts with a number GREATER than the marker are returned.
+    let marker = match decoded_query_value(query, "part-number-marker") {
+        None => 0u32,
+        Some(raw) => match raw.trim().parse::<u32>() {
+            Ok(n) => n,
+            Err(_) => {
+                return error_response(
+                    request_id,
+                    StatusCode::BAD_REQUEST,
+                    "InvalidArgument",
+                    "part-number-marker is not a valid part number",
+                )
+            }
+        },
+    };
+    match state.gateway.list_parts(object_key, upload_id).await {
+        Ok(parts) => {
+            let after: Vec<wyrd_gateway_core::StagedPart> = parts
+                .into_iter()
+                .filter(|p| p.part_number > marker)
+                .collect();
+            let page = &after[..after.len().min(max_parts)];
+            // A `max-parts=0` request is valid and answers an EMPTY, non-truncated page — the
+            // rule the object listing applies to `max-keys=0` (`:556-561`) for the same reason:
+            // a truncated page must carry a resume marker, an empty page has none, and a
+            // conforming paginator that re-sends while `IsTruncated` with nothing to advance on
+            // never terminates.
+            let is_truncated = !page.is_empty() && after.len() > page.len();
+            list_response(render_list_parts_result(
+                bucket,
+                key,
+                upload_id,
+                page,
+                marker,
+                max_parts,
+                is_truncated,
+            ))
+        }
+        Err(err) => gateway_error_response(request_id, &err),
+    }
+}
+
+/// ListMultipartUploads (`GET /b?uploads`): answer a `<ListMultipartUploadsResult>` of the
+/// bucket's in-progress uploads, **sorted and paginated** here (the same materialize-sort-slice
+/// split as the object listing): the seam returns the complete set in unspecified order, and
+/// this layer orders it by `(key, upload-id)` — the order S3's `key-marker` /
+/// `upload-id-marker` resume against — before slicing `max-uploads`.
+async fn list_multipart_uploads<G>(
+    state: &AppState<G>,
+    request_id: RequestId,
+    bucket: &str,
+    query: &str,
+) -> Response
+where
+    G: MultipartGateway,
+{
+    let Ok(max_uploads) = list_page_size(query, "max-uploads") else {
+        return error_response(
+            request_id,
+            StatusCode::BAD_REQUEST,
+            "InvalidArgument",
+            "max-uploads is not a valid non-negative integer",
+        );
+    };
+    let key_marker = decoded_query_value(query, "key-marker");
+    let upload_id_marker = decoded_query_value(query, "upload-id-marker");
+    match state.gateway.list_multipart_uploads(bucket).await {
+        Ok(mut uploads) => {
+            uploads.sort_by(|a, b| {
+                a.key
+                    .cmp(&b.key)
+                    .then_with(|| a.upload_id.cmp(&b.upload_id))
+            });
+            // Strictly after the `(key-marker, upload-id-marker)` resume point: a key past the
+            // marker, or the same key with an upload id past the id marker (S3's rule — the id
+            // marker is only meaningful together with the key marker).
+            let after: Vec<wyrd_gateway_core::MultipartUpload> = uploads
+                .into_iter()
+                .filter(|u| match (&key_marker, &upload_id_marker) {
+                    (None, _) => true,
+                    (Some(k), None) => u.key.as_str() > k.as_str(),
+                    (Some(k), Some(id)) => {
+                        u.key.as_str() > k.as_str()
+                            || (u.key.as_str() == k.as_str() && u.upload_id.as_str() > id.as_str())
+                    }
+                })
+                .collect();
+            let page = &after[..after.len().min(max_uploads)];
+            // Same zero-page rule as ListParts above: an empty page is never truncated.
+            let is_truncated = !page.is_empty() && after.len() > page.len();
+            list_response(render_list_uploads_result(
+                bucket,
+                page,
+                key_marker.as_deref().unwrap_or(""),
+                upload_id_marker.as_deref().unwrap_or(""),
+                max_uploads,
+                is_truncated,
+            ))
+        }
+        Err(err) => gateway_error_response(request_id, &err),
+    }
+}
+
+/// Parse a `<CompleteMultipartUpload>` request body into the ordered part list, or `Err(())`
+/// (⇒ `400 MalformedXML`) on any parse error, a wrong root, a `<Part>` missing its
+/// `<PartNumber>`/`<ETag>`, or an empty list. Whole-grammar well-formedness is delegated to
+/// [`roxmltree`] and element content extracted fail-closed via [`char_data`], exactly as
+/// DeleteObjects does — no hand-rolled grammar. Elements match by local name
+/// (namespace-insensitive), so the SDK's default-namespaced body is accepted.
+fn parse_complete_request(text: &str) -> Result<Vec<CompletePart>, ()> {
+    let doc = roxmltree::Document::parse(text).map_err(|_| ())?;
+    let root = doc.root_element();
+    if root.tag_name().name() != "CompleteMultipartUpload" {
+        return Err(());
+    }
+    let mut parts = Vec::new();
+    for part in root
+        .children()
+        .filter(|n| n.is_element() && n.tag_name().name() == "Part")
+    {
+        let mut part_number: Option<u32> = None;
+        let mut etag: Option<String> = None;
+        for field in part.children().filter(|n| n.is_element()) {
+            match field.tag_name().name() {
+                "PartNumber" => part_number = char_data(&field)?.trim().parse().ok(),
+                "ETag" => etag = Some(char_data(&field)?),
+                // Unknown children (`<ChecksumCRC32>`, …) are ignored — out of scope.
+                _ => {}
+            }
+        }
+        let (Some(part_number), Some(etag)) = (part_number, etag) else {
+            return Err(());
+        };
+        parts.push(CompletePart { part_number, etag });
+    }
+    if parts.is_empty() {
+        return Err(());
+    }
+    Ok(parts)
+}
