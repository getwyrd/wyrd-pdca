+const ACCESS_KEY: &str = "AKIAIOSFODNN7EXAMPLE";
+const SECRET_KEY: &str = "wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY";
+const REGION: &str = "us-east-1";
+const BUCKET: &str = "wyrd-bucket";
+/// S3's 5 MiB minimum part size — every non-final part meets it (the floor is enforced at
+/// Complete, so a smaller non-final part would be `EntityTooSmall`).
+const FIVE_MIB: usize = 5 * 1024 * 1024;
+
+// ---- the ETag oracle: KNOWN ANSWERS, computed outside this codebase -------------------
+//
+// S3 part ETags are MD5s and the completed-object ETag is `md5(concat(raw part-md5s))-N`, so
+// the test needs an MD5 oracle — and it must not be the server's own `wyrd_core::md5`, or a
+// shared bug would pass silently. These are pinned known answers for the EXACT part bodies
+// below, computed with an independent implementation (CPython `hashlib`, which links
+// OpenSSL's MD5), so the oracle costs the test no dependency at all — which is what keeps
+// this file compiling **unchanged** against the pre-fix base, where the red is an assertion
+// on the wire (`501 NotImplemented`) rather than a missing crate. Re-derive with:
+//
+//     python3 -c 'import hashlib
+//     b=lambda n,s: bytes(((i+s*97)%251) for i in range(n))
+//     m1=hashlib.md5(b(5*1024*1024,1)).digest(); m2=hashlib.md5(b(4096,2)).digest()
+//     print(m1.hex(), m2.hex(), hashlib.md5(m1+m2).hexdigest()+"-2")'
+//
+/// `md5(body(FIVE_MIB, 1))` — part 1's S3 ETag.
+const PART1_MD5: &str = "385ecb122bf720d009b11a98f33be9bb";
+/// `md5(body(4096, 2))` — part 2's S3 ETag.
+const PART2_MD5: &str = "e4f84ac6f6d9d9258f6881bdb0a9fb98";
+/// `md5(md5(part1) ++ md5(part2)) + "-2"` — the composed multipart ETag of the two parts.
+const COMPOSITE_ETAG: &str = "d8e4dbd11a96e53481ae3292b734503c-2";
+
+/// A cheap, cloneable **handle** to one `RedbMetadataStore`: every method forwards to the real
+/// store, adding nothing. It exists only because `Gateway::new` takes its metadata store **by
+/// value** (and redb's in-memory backend cannot be reopened), so the test needs a second handle
+/// on the SAME store to run a custodian GC pass over what the gateway wrote — the deployment
+/// shape, where the gateway and the `wyrd custodian` role both address one shared store. It is
+/// not a double: no behaviour is re-implemented here.
+#[derive(Clone)]
+struct SharedMeta(Arc<RedbMetadataStore>);
+
+#[async_trait]
+impl MetadataStore for SharedMeta {
+    async fn get(&self, key: &[u8]) -> Result<Option<Bytes>> {
+        self.0.get(key).await
+    }
+    async fn scan(&self, prefix: &[u8]) -> Result<Vec<(Vec<u8>, Bytes)>> {
+        self.0.scan(prefix).await
+    }
+    async fn commit(&self, batch: WriteBatch) -> Result<CommitOutcome> {
+        self.0.commit(batch).await
+    }
+}
+
+type Backend = Gateway<SharedMeta, FsChunkStore, MemCoordination>;
+
+/// One D server's **view** of the single-authority chunk store the co-located gateway writes
+/// to — the placement-aware fleet the custodian's passes expect, mirroring the `Fleet` view
+/// `crates/server/tests/custodian_gc.rs` builds over its per-server stores.
+///
+/// The streaming write path places fragment `i` of every chunk on D server `i` (the identity
+/// placement `PlacementChunkStore::placement` defines) and a single-authority store holds all
+/// of them in one directory, so D server `d` holds exactly the fragments whose index is `d`.
+/// Enumerating that subset per id is what makes the fleet FAITHFUL: presenting the same root
+/// under every id would show each fragment nine times, eight of them under a server that never
+/// held it — where a maintenance pass would rightly call it unreferenced.
+struct DServerView<'a> {
+    id: DServerId,
+    inner: &'a FsChunkStore,
+}
+
+impl DServerView<'_> {
+    fn holds(&self, id: FragmentId) -> bool {
+        DServerId::from(id.index) == self.id
+    }
+}
+
+#[async_trait]
+impl ChunkStore for DServerView<'_> {
+    async fn put_fragment(&self, id: FragmentId, fragment: Bytes) -> Result<()> {
+        self.inner.put_fragment(id, fragment).await
+    }
+    async fn get_fragment(&self, id: FragmentId) -> Result<Option<Bytes>> {
+        if self.holds(id) {
+            self.inner.get_fragment(id).await
+        } else {
+            Ok(None)
+        }
+    }
+    async fn list_fragments(&self) -> Result<Vec<FragmentId>> {
+        Ok(self
+            .inner
+            .list_fragments()
+            .await?
+            .into_iter()
+            .filter(|f| self.holds(*f))
+            .collect())
+    }
+    async fn delete_fragment(&self, id: FragmentId) -> Result<()> {
+        self.inner.delete_fragment(id).await
+    }
+    async fn health(&self) -> Result<Health> {
+        self.inner.health().await
+    }
+}
+
+/// The complete D-server fleet over one chunk-store root: one [`DServerView`] per identity id
+/// the write path places on (`0..k+m` for the gateway's default RS scheme).
+fn fleet_views(store: &FsChunkStore) -> Vec<DServerView<'_>> {
+    let n = match DEFAULT_DURABILITY {
+        EcScheme::None => 1u64,
+        EcScheme::ReedSolomon { k, m } => u64::from(k) + u64::from(m),
+    };
+    (0..n).map(|id| DServerView { id, inner: store }).collect()
+}
+
+/// Start the S3 gateway over the in-process stack on an ephemeral loopback port. Returns the
+/// address, a handle to the gateway's metadata store (so the test can run a custodian GC pass
+/// over the same state), and the `FsChunkStore` tempdir (so it can count fragment files).
+///
+/// The 1 MiB chunk size makes a 5 MiB part span several chunks over the streaming write path
+/// (multi-chunk staging) while keeping the on-disk fragment count small enough to count.
+async fn start_gateway() -> (SocketAddr, SharedMeta, tempfile::TempDir) {
+    let dir = tempfile::tempdir().expect("temp dir");
+    let meta = SharedMeta(Arc::new(RedbMetadataStore::in_memory().expect("redb")));
+    let gateway: Arc<Backend> = Arc::new(
+        Gateway::new(
+            meta.clone(),
+            FsChunkStore::open(dir.path()).expect("fs store"),
+            MemCoordination::new(),
+        )
+        .with_chunk_size(1 << 20),
+    );
+    let config = S3Config::new(vec![Credentials {
+        access_key_id: ACCESS_KEY.to_string(),
+        secret_access_key: SECRET_KEY.to_string(),
+    }]);
+    let listener = TcpListener::bind("127.0.0.1:0").await.expect("bind");
+    let addr = listener.local_addr().expect("addr");
+    let server = S3Gateway::new(gateway, config);
+    tokio::spawn(async move {
+        server.serve(listener).await.expect("serve");
+    });
+    (addr, meta, dir)
+}
+
+/// Run **one custodian GC pass** over the gateway's own state — the production fenced control
+/// point (`wyrd_custodian::reconcile_step`), wired exactly as the deployable custodian role
+/// wires it (`crates/server/src/custodian.rs`): the shared metadata store plus the D-server
+/// fleet whose stores hold the fragments.
+///
+/// The chunk store is a **second `FsChunkStore` handle on the same root** — how a custodian
+/// process actually reaches a D-server's store (its own client over that server's directory),
+/// not a stand-in. The streaming write path places a chunk's RS(k,m) fragments on the identity
+/// D-servers `0..k+m`, and this single-authority root holds all of them, so the store is
+/// presented under each of those ids and the placement-aware reference check matches every
+/// fragment against its placed id.
+///
+/// `expired_pending: Defer` — reclamation must ride the **orphan ledger** Abort writes, never a
+/// bare expired lease, so this pass cannot pass by sweeping leased-but-uncommitted bytes.
+async fn run_gc_pass(meta: &SharedMeta, chunk_root: &Path) -> Reconciled {
+    let store = FsChunkStore::open(chunk_root).expect("fs store");
+    let views = fleet_views(&store);
+    let fleet: Vec<(DServerId, &dyn ChunkStore)> =
+        views.iter().map(|v| (v.id, v as &dyn ChunkStore)).collect();
+    let coord = MemCoordination::new();
+    let leader = Custodian::elect(&coord, "zone-multipart-gc")
+        .await
+        .expect("elect a custodian");
+    let mut zone = FencedZone::new();
+    zone.install(leader.leadership());
+    let ctx = GcContext {
+        meta: meta as &dyn MetadataStore,
+        fleet: &fleet,
+        grace_window_millis: 0,
+        expired_pending: ExpiredPendingPolicy::Defer,
+    };
+    // A far-future logical clock, so every orphan grace deadline the abort stamped has elapsed.
+    reconcile_step(&zone, &leader, Some(&ctx), None, None, None, u64::MAX / 2)
+        .await
+        .expect("a custodian GC pass must run over the gateway's stores")
+}
+
+/// Run one **post-restore reconciliation** pass (`wyrd_custodian::reconcile_after_restore`) —
+/// the operator pass that MARKS every fragment no live reference points at as an orphan, which
+/// is the evidence GC needs before it will reclaim anything. Same fleet wiring as
+/// [`run_gc_pass`]; the fleet is complete (one store holds every fragment), as that pass
+/// requires.
+async fn run_restore_pass(meta: &SharedMeta, chunk_root: &Path) -> RestoreReport {
+    let store = FsChunkStore::open(chunk_root).expect("fs store");
+    let views = fleet_views(&store);
+    let fleet: Vec<(DServerId, &dyn ChunkStore)> =
+        views.iter().map(|v| (v.id, v as &dyn ChunkStore)).collect();
+    let ctx = GcContext {
+        meta: meta as &dyn MetadataStore,
+        fleet: &fleet,
+        grace_window_millis: 0,
+        expired_pending: ExpiredPendingPolicy::Defer,
+    };
+    reconcile_after_restore(&ctx, u64::MAX / 2)
+        .await
+        .expect("a post-restore reconciliation pass must run")
+}
+
+/// A stock `aws-sdk-s3` client pointed at the loopback gateway — mirrors
+/// `s3_gateway_cluster.rs::sdk_client` (custom endpoint, path-style, static creds, plaintext).
+fn sdk_client(addr: SocketAddr) -> Client {
+    let http_client = aws_smithy_http_client::Builder::new().build_http();
+    let config = aws_sdk_s3::Config::builder()
+        .behavior_version_latest()
+        .region(Region::new(REGION))
+        .endpoint_url(format!("http://{addr}"))
+        .credentials_provider(SdkCredentials::new(
+            ACCESS_KEY, SECRET_KEY, None, None, "static",
+        ))
+        .http_client(http_client)
+        .force_path_style(true)
+        .retry_config(aws_sdk_s3::config::retry::RetryConfig::disabled())
+        .stalled_stream_protection(aws_sdk_s3::config::StalledStreamProtectionConfig::disabled())
+        .build();
+    Client::from_conf(config)
+}
+
+/// Count `.frag` fragment files under a chunk-store root (`<root>/<32-hex chunk>/<05-index>.frag`,
+/// `chunkstore-fs`) — mirrors `s3_gateway_cluster.rs::count_fragments`. Non-zero ⇒ fragments
+/// landed on disk; zero ⇒ none remain.
+fn count_fragments(root: &Path) -> usize {
+    let mut n = 0;
+    let Ok(chunk_dirs) = std::fs::read_dir(root) else {
+        return 0;
+    };
+    for chunk_dir in chunk_dirs.flatten() {
+        let path = chunk_dir.path();
+        if !path.is_dir() {
+            continue;
+        }
+        if let Ok(frags) = std::fs::read_dir(&path) {
+            for frag in frags.flatten() {
+                if frag.path().extension().and_then(|e| e.to_str()) == Some("frag") {
+                    n += 1;
+                }
+            }
+        }
+    }
+    n
+}
+
+/// A deterministic body of `len` bytes seeded from `seed` — a distinct-per-part pattern so an
+/// out-of-order assembly is caught, not masked by identical bytes.
+fn body(len: usize, seed: u8) -> Vec<u8> {
+    (0..len)
+        .map(|i| ((i as u64 + u64::from(seed) * 97) % 251) as u8)
+        .collect()
+}
+
+fn hex(bytes: &[u8]) -> String {
+    let mut s = String::with_capacity(bytes.len() * 2);
+    for b in bytes {
+        s.push_str(&format!("{b:02x}"));
+    }
+    s
+}
+
+/// Lowercase-hex SHA-256 — the `x-amz-content-sha256` form a signed single-shot body carries.
+fn sha256_hex(bytes: &[u8]) -> String {
+    use sha2::Digest as _;
+    hex(sha2::Sha256::digest(bytes).as_slice())
+}
+
+/// Strip the surrounding double quotes S3 wraps an ETag in.
+fn unquote(etag: &str) -> String {
+    etag.trim().trim_matches('"').to_string()
+}
+
+/// SigV4-sign a request over `body`, returning the headers to send (mirrors
+/// `s3_copy_object_guard.rs::signed_headers`, extended with the query string the malformed-form
+/// legs need — the query is part of the canonical request).
+fn signed_headers(
+    method: &str,
+    path: &str,
+    query: &str,
+    host: &str,
+    body: &[u8],
+) -> Vec<(String, String)> {
+    let creds = Credentials {
+        access_key_id: ACCESS_KEY.to_string(),
+        secret_access_key: SECRET_KEY.to_string(),
+    };
+    let amz_date = format_amz_date(std::time::SystemTime::now());
+    let signed = sign(
+        method, path, query, host, &amz_date, body, &creds, REGION, "s3",
+    );
+    vec![
+        ("authorization".to_string(), signed.authorization),
+        ("x-amz-date".to_string(), signed.amz_date),
+        ("x-amz-content-sha256".to_string(), signed.content_sha256),
+    ]
+}
+
+/// Send one HTTP/1.1 request over a fresh connection and return `(status, body)` (mirrors
+/// `s3_copy_object_guard.rs::send`). `query` is appended to the request target verbatim.
+async fn send(
+    addr: SocketAddr,
+    method: &str,
+    path: &str,
+    query: &str,
+    headers: &[(String, String)],
+    body: &[u8],
+) -> (u16, Vec<u8>) {
+    let host = addr.to_string();
+    let target = if query.is_empty() {
+        path.to_string()
+    } else {
+        format!("{path}?{query}")
+    };
+    let mut request = format!("{method} {target} HTTP/1.1\r\n");
+    request.push_str(&format!("host: {host}\r\n"));
+    for (name, value) in headers {
+        request.push_str(&format!("{name}: {value}\r\n"));
+    }
+    request.push_str(&format!("content-length: {}\r\n", body.len()));
+    request.push_str("connection: close\r\n\r\n");
+
+    let mut stream = TcpStream::connect(addr).await.expect("connect");
+    stream
+        .write_all(request.as_bytes())
+        .await
+        .expect("write head");
+    stream.write_all(body).await.expect("write body");
+    stream.flush().await.expect("flush");
+
+    let mut raw = Vec::new();
+    stream.read_to_end(&mut raw).await.expect("read response");
+    parse_response(&raw)
+}
+
+fn parse_response(raw: &[u8]) -> (u16, Vec<u8>) {
+    let split = raw
+        .windows(4)
+        .position(|w| w == b"\r\n\r\n")
+        .expect("response has a header/body split");
+    let head = String::from_utf8_lossy(&raw[..split]).to_string();
+    let status = head
+        .lines()
+        .next()
+        .and_then(|line| line.split_whitespace().nth(1))
+        .and_then(|code| code.parse::<u16>().ok())
+        .expect("status line");
+    let body = raw[split + 4..].to_vec();
+    // The gateway answers these requests with `connection: close` and no chunked framing for
+    // errors, so the remainder is the body (possibly chunk-framed for a streamed 200 — the legs
+    // below only read error bodies and small documents).
+    (status, body)
+}
+
+/// The full happy path: create → out-of-order upload → list_parts → complete → GET, with the
+/// composite ETag checked against the independent oracle and the round trip byte-identical.
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn multipart_round_trip_assembles_byte_identical_object_with_composite_etag() {
+    let (addr, _meta, _dir) = start_gateway().await;
+    let client = sdk_client(addr);
+    let key = "big/multipart-object";
+
+    // Two parts: a ≥5 MiB non-final part (spans several 1 MiB chunks) and a small last part.
+    let part1 = body(FIVE_MIB, 1);
+    let part2 = body(4096, 2);
+
+    let created = client
+        .create_multipart_upload()
+        .bucket(BUCKET)
+        .key(key)
+        .content_type("application/octet-stream")
+        .send()
+        .await
+        .expect("CreateMultipartUpload must be accepted (pre-fix: 501 NotImplemented)");
+    let upload_id = created
+        .upload_id()
+        .expect("a create response carries an upload id");
+
+    // Upload OUT OF ORDER — part 2 before part 1 — over the streaming wire path.
+    let up2 = client
+        .upload_part()
+        .bucket(BUCKET)
+        .key(key)
+        .upload_id(upload_id)
+        .part_number(2)
+        .body(ByteStream::from(part2.clone()))
+        .send()
+        .await
+        .expect("UploadPart(2) must be accepted");
+    let etag2 = up2
+        .e_tag()
+        .expect("UploadPart(2) returns an ETag")
+        .to_string();
+    let up1 = client
+        .upload_part()
+        .bucket(BUCKET)
+        .key(key)
+        .upload_id(upload_id)
+        .part_number(1)
+        .body(ByteStream::from(part1.clone()))
+        .send()
+        .await
+        .expect("UploadPart(1) must be accepted");
+    let etag1 = up1
+        .e_tag()
+        .expect("UploadPart(1) returns an ETag")
+        .to_string();
+
+    // A part ETag is the (quoted) MD5 of the part bytes — the known-answer oracle above.
+    assert_eq!(unquote(&etag1), PART1_MD5, "part 1 ETag must be its MD5");
+    assert_eq!(unquote(&etag2), PART2_MD5, "part 2 ETag must be its MD5");
+
+    // ListParts reflects the staged parts, ascending, with their sizes and ETags.
+    let listed = client
+        .list_parts()
+        .bucket(BUCKET)
+        .key(key)
+        .upload_id(upload_id)
+        .send()
+        .await
+        .expect("ListParts must be accepted");
+    let parts = listed.parts();
+    assert_eq!(parts.len(), 2, "ListParts must reflect both staged parts");
+    assert_eq!(parts[0].part_number(), Some(1));
+    assert_eq!(parts[0].size(), Some(part1.len() as i64));
+    assert_eq!(unquote(parts[0].e_tag().unwrap_or("")), PART1_MD5);
+    assert_eq!(parts[1].part_number(), Some(2));
+    assert_eq!(parts[1].size(), Some(part2.len() as i64));
+    assert_eq!(
+        listed.is_truncated(),
+        Some(false),
+        "a complete ListParts page is not truncated"
+    );
+
+    // Paginated ListParts: one part per page, with a real truncation flag and resume marker —
+    // a hard-coded `IsTruncated=false` would tell a paginator the listing was complete.
+    let page1 = client
+        .list_parts()
+        .bucket(BUCKET)
+        .key(key)
+        .upload_id(upload_id)
+        .max_parts(1)
+        .send()
+        .await
+        .expect("ListParts(max-parts=1) must be accepted");
+    assert_eq!(page1.parts().len(), 1, "a max-parts=1 page holds one part");
+    assert_eq!(
+        page1.is_truncated(),
+        Some(true),
+        "a page cut at max-parts must report IsTruncated=true"
+    );
+    assert_eq!(
+        page1.next_part_number_marker(),
+        Some("1"),
+        "a truncated page must carry the resume marker"
+    );
+    let page2 = client
+        .list_parts()
+        .bucket(BUCKET)
+        .key(key)
+        .upload_id(upload_id)
+        .max_parts(1)
+        .part_number_marker("1")
+        .send()
+        .await
+        .expect("the second ListParts page must be accepted");
+    assert_eq!(
+        page2.parts().first().and_then(|p| p.part_number()),
+        Some(2),
+        "the second page resumes after the marker"
+    );
+    // `max-parts=0` is a legal request for an empty page — and an empty page must NOT claim
+    // truncation: it carries no resume marker, so a conforming paginator that re-sends while
+    // `IsTruncated` would never terminate.
+    let empty = client
+        .list_parts()
+        .bucket(BUCKET)
+        .key(key)
+        .upload_id(upload_id)
+        .max_parts(0)
+        .send()
+        .await
+        .expect("ListParts(max-parts=0) must be accepted");
+    assert!(empty.parts().is_empty(), "max-parts=0 returns no parts");
+    assert_eq!(
+        empty.is_truncated(),
+        Some(false),
+        "an empty page must not claim truncation (it has no marker to resume from)"
+    );
+    assert_eq!(
+        page2.is_truncated(),
+        Some(false),
+        "the last page is not truncated"
+    );
+
+    // Complete with the parts in ascending order.
+    let multipart = CompletedMultipartUpload::builder()
+        .parts(
+            CompletedPart::builder()
+                .part_number(1)
+                .e_tag(&etag1)
+                .build(),
+        )
+        .parts(
+            CompletedPart::builder()
+                .part_number(2)
+                .e_tag(&etag2)
+                .build(),
+        )
+        .build();
+    let done = client
+        .complete_multipart_upload()
+        .bucket(BUCKET)
+        .key(key)
+        .upload_id(upload_id)
+        .multipart_upload(multipart)
+        .send()
+        .await
+        .expect("CompleteMultipartUpload must be accepted");
+    let composite = done
+        .e_tag()
+        .expect("Complete returns the composed ETag")
+        .to_string();
+
+    // The composed ETag is `"<md5-of-part-md5s>-2"` — checked against the independent oracle.
+    assert_eq!(
+        unquote(&composite),
+        COMPOSITE_ETAG,
+        "the Complete ETag must be the S3 multipart composite md5(concat(part-md5s))-N"
+    );
+    assert!(
+        composite.trim_matches('"').ends_with("-2"),
+        "the composite ETag must carry the -N part count, got {composite}"
+    );
+
+    // GET returns the assembled object byte-identical to part1 ++ part2, with the composite ETag.
+    let got = client
+        .get_object()
+        .bucket(BUCKET)
+        .key(key)
+        .send()
+        .await
+        .expect("GET of the completed object must succeed");
+    let get_etag = got.e_tag().expect("GET carries an ETag").to_string();
+    let bytes = got
+        .body
+        .collect()
+        .await
+        .expect("collect the GET body")
+        .into_bytes();
+    let mut expected = part1.clone();
+    expected.extend_from_slice(&part2);
+    assert_eq!(
+        bytes.as_ref(),
+        expected.as_slice(),
+        "the assembled object must be byte-identical to the concatenated parts"
+    );
+    assert_eq!(
+        get_etag, composite,
+        "GET must return the composite ETag the Complete committed"
+    );
+}
