@@ -0,0 +1,217 @@
+//! A small, dependency-free **MD5** (RFC 1321) hasher.
+//!
+//! MD5 is the hash S3 uses for a multipart upload's **part ETags** and the composed
+//! object ETag (`md5(concat(part-md5s))-N`), distinct from the sha256-flavoured
+//! single-PUT ETag (ADR-0047). The multipart path (`crate::multipart`) needs it in two
+//! places — the per-part digest computed *while the part streams* and the md5-of-md5s
+//! composition at Complete — so it lives here as a neutral primitive rather than pulling
+//! in the `md-5` crate: adding a new dependency is a human-only sign-off item (ADR-0003
+//! audit + `deny.toml`), and MD5's mixing is small and fully specified. It is used
+//! **only** for the S3 ETag change-token, never for integrity (the chunk-format checksums
+//! and the SHA-256 content hash are the integrity primitives).
+
+/// Per-round left-rotation amounts (RFC 1321).
+const S: [u32; 64] = [
+    7, 12, 17, 22, 7, 12, 17, 22, 7, 12, 17, 22, 7, 12, 17, 22, //
+    5, 9, 14, 20, 5, 9, 14, 20, 5, 9, 14, 20, 5, 9, 14, 20, //
+    4, 11, 16, 23, 4, 11, 16, 23, 4, 11, 16, 23, 4, 11, 16, 23, //
+    6, 10, 15, 21, 6, 10, 15, 21, 6, 10, 15, 21, 6, 10, 15, 21,
+];
+
+/// Per-round additive constants `floor(2^32 * abs(sin(i+1)))` (RFC 1321).
+const K: [u32; 64] = [
+    0xd76aa478, 0xe8c7b756, 0x242070db, 0xc1bdceee, 0xf57c0faf, 0x4787c62a, 0xa8304613, 0xfd469501,
+    0x698098d8, 0x8b44f7af, 0xffff5bb1, 0x895cd7be, 0x6b901122, 0xfd987193, 0xa679438e, 0x49b40821,
+    0xf61e2562, 0xc040b340, 0x265e5a51, 0xe9b6c7aa, 0xd62f105d, 0x02441453, 0xd8a1e681, 0xe7d3fbc8,
+    0x21e1cde6, 0xc33707d6, 0xf4d50d87, 0x455a14ed, 0xa9e3e905, 0xfcefa3f8, 0x676f02d9, 0x8d2a4c8a,
+    0xfffa3942, 0x8771f681, 0x6d9d6122, 0xfde5380c, 0xa4beea44, 0x4bdecfa9, 0xf6bb4b60, 0xbebfbc70,
+    0x289b7ec6, 0xeaa127fa, 0xd4ef3085, 0x04881d05, 0xd9d4d039, 0xe6db99e5, 0x1fa27cf8, 0xc4ac5665,
+    0xf4292244, 0x432aff97, 0xab9423a7, 0xfc93a039, 0x655b59c3, 0x8f0ccc92, 0xffeff47d, 0x85845dd1,
+    0x6fa87e4f, 0xfe2ce6e0, 0xa3014314, 0x4e0811a1, 0xf7537e82, 0xbd3af235, 0x2ad7d2bb, 0xeb86d391,
+];
+
+/// An incremental MD5 hasher: feed it bytes with [`update`](Md5::update) and finish with
+/// [`finalize`](Md5::finalize). Used by the multipart path to digest a **part** as its
+/// bytes stream, so a part is never buffered whole to be hashed.
+#[derive(Clone)]
+pub struct Md5 {
+    state: [u32; 4],
+    /// Total message length in bytes (mod 2^64), for the length padding.
+    len: u64,
+    /// A partial 64-byte block awaiting more bytes.
+    buffer: [u8; 64],
+    buffer_len: usize,
+}
+
+impl Default for Md5 {
+    fn default() -> Self {
+        Self::new()
+    }
+}
+
+impl Md5 {
+    /// A fresh hasher seeded with the RFC 1321 initial state.
+    pub fn new() -> Self {
+        Self {
+            state: [0x6745_2301, 0xefcd_ab89, 0x98ba_dcfe, 0x1032_5476],
+            len: 0,
+            buffer: [0u8; 64],
+            buffer_len: 0,
+        }
+    }
+
+    /// Feed `data` into the running digest.
+    pub fn update(&mut self, mut data: &[u8]) {
+        self.len = self.len.wrapping_add(data.len() as u64);
+        // Top up a partial buffered block first.
+        if self.buffer_len > 0 {
+            let take = (64 - self.buffer_len).min(data.len());
+            self.buffer[self.buffer_len..self.buffer_len + take].copy_from_slice(&data[..take]);
+            self.buffer_len += take;
+            data = &data[take..];
+            if self.buffer_len == 64 {
+                let block = self.buffer;
+                self.process(&block);
+                self.buffer_len = 0;
+            }
+        }
+        // Process whole blocks straight from the input.
+        while data.len() >= 64 {
+            let mut block = [0u8; 64];
+            block.copy_from_slice(&data[..64]);
+            self.process(&block);
+            data = &data[64..];
+        }
+        // Retain the tail.
+        if !data.is_empty() {
+            self.buffer[..data.len()].copy_from_slice(data);
+            self.buffer_len = data.len();
+        }
+    }
+
+    /// Finish the digest, returning the 16 raw MD5 bytes.
+    pub fn finalize(mut self) -> [u8; 16] {
+        let bit_len = self.len.wrapping_mul(8);
+        // Append the `0x80` terminator then zero-pad to 56 mod 64, then the 64-bit length.
+        let mut pad = [0u8; 72];
+        pad[0] = 0x80;
+        let rem = (self.len % 64) as usize;
+        let pad_len = if rem < 56 { 56 - rem } else { 120 - rem };
+        self.update(&pad[..pad_len]);
+        self.update(&bit_len.to_le_bytes());
+        debug_assert_eq!(
+            self.buffer_len, 0,
+            "the digest is block-aligned after padding"
+        );
+        let mut out = [0u8; 16];
+        for (i, word) in self.state.iter().enumerate() {
+            out[i * 4..i * 4 + 4].copy_from_slice(&word.to_le_bytes());
+        }
+        out
+    }
+
+    /// The lowercase-hex rendering of the finished digest (the S3 part-ETag form).
+    pub fn finalize_hex(self) -> String {
+        hex16(&self.finalize())
+    }
+
+    /// Mix one 64-byte block into the state (RFC 1321 §3.4).
+    fn process(&mut self, block: &[u8; 64]) {
+        let mut m = [0u32; 16];
+        for (i, word) in m.iter_mut().enumerate() {
+            *word = u32::from_le_bytes([
+                block[i * 4],
+                block[i * 4 + 1],
+                block[i * 4 + 2],
+                block[i * 4 + 3],
+            ]);
+        }
+        let [mut a, mut b, mut c, mut d] = self.state;
+        for i in 0..64 {
+            let (f, g) = match i {
+                0..=15 => ((b & c) | (!b & d), i),
+                16..=31 => ((d & b) | (!d & c), (5 * i + 1) % 16),
+                32..=47 => (b ^ c ^ d, (3 * i + 5) % 16),
+                _ => (c ^ (b | !d), (7 * i) % 16),
+            };
+            let tmp = d;
+            d = c;
+            c = b;
+            let sum = a.wrapping_add(f).wrapping_add(K[i]).wrapping_add(m[g]);
+            b = b.wrapping_add(sum.rotate_left(S[i]));
+            a = tmp;
+        }
+        self.state[0] = self.state[0].wrapping_add(a);
+        self.state[1] = self.state[1].wrapping_add(b);
+        self.state[2] = self.state[2].wrapping_add(c);
+        self.state[3] = self.state[3].wrapping_add(d);
+    }
+}
+
+/// The lowercase-hex MD5 of `bytes` in one shot — the composed-ETag primitive
+/// (`md5(concat(part-md5s))`).
+pub fn md5_hex(bytes: &[u8]) -> String {
+    let mut h = Md5::new();
+    h.update(bytes);
+    h.finalize_hex()
+}
+
+/// Lowercase-hex of a 16-byte digest.
+fn hex16(bytes: &[u8; 16]) -> String {
+    let mut s = String::with_capacity(32);
+    for b in bytes {
+        s.push(char::from_digit((b >> 4) as u32, 16).unwrap_or('0'));
+        s.push(char::from_digit((b & 0x0f) as u32, 16).unwrap_or('0'));
+    }
+    s
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    /// RFC 1321 §A.5 test vectors — the digest must match the published MD5 outputs, so a
+    /// mixing bug in the S3 part-ETag primitive cannot pass silently.
+    #[test]
+    fn rfc1321_test_vectors() {
+        assert_eq!(md5_hex(b""), "d41d8cd98f00b204e9800998ecf8427e");
+        assert_eq!(md5_hex(b"a"), "0cc175b9c0f1b6a831c399e269772661");
+        assert_eq!(md5_hex(b"abc"), "900150983cd24fb0d6963f7d28e17f72");
+        assert_eq!(
+            md5_hex(b"message digest"),
+            "f96b697d7cb7938d525a2f31aaf161d0"
+        );
+        assert_eq!(
+            md5_hex(b"abcdefghijklmnopqrstuvwxyz"),
+            "c3fcd3d76192e4007dfb496cca67e13b"
+        );
+        assert_eq!(
+            md5_hex(
+                b"12345678901234567890123456789012345678901234567890123456789012345678901234567890"
+            ),
+            "57edf4a22be3c955ac49da2e2107b67a"
+        );
+    }
+
+    /// Incremental feeding across arbitrary split points must equal a one-shot digest — the
+    /// property the streaming per-part hash relies on (a part arrives in many buffers).
+    #[test]
+    fn incremental_matches_one_shot() {
+        let data: Vec<u8> = (0..1000u32).map(|i| (i % 251) as u8).collect();
+        let one_shot = md5_hex(&data);
+        for split in [1usize, 63, 64, 65, 127, 128, 200, 999] {
+            let mut h = Md5::new();
+            h.update(&data[..split]);
+            h.update(&data[split..]);
+            assert_eq!(h.finalize_hex(), one_shot, "split at {split}");
+        }
+    }
+
+    /// A message that spans several 64-byte blocks (the multi-block padding path).
+    #[test]
+    fn multi_block_message() {
+        let data = vec![0x61u8; 130]; // 130 'a's
+                                      // Independently known: md5 of 130 'a' bytes.
+        assert_eq!(md5_hex(&data), "e016e4ccc7fdaea56fc377600b58c4cb");
+    }
+}
