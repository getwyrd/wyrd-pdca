+/// UploadPart enforces the SAME signed-payload integrity check a plain PutObject enforces: a
+/// body that does not hash to the signed `x-amz-content-sha256` is refused and nothing is
+/// staged. Without it, a part altered in transit would be folded into the completed object
+/// undetected — the composite ETag digests what was *received*, so it cannot catch it.
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn upload_part_refuses_a_body_that_does_not_match_the_signed_hash() {
+    let (addr, _meta, _dir) = start_gateway().await;
+    let client = sdk_client(addr);
+    let key = "big/tampered";
+    let path = format!("/{BUCKET}/{key}");
+
+    let created = client
+        .create_multipart_upload()
+        .bucket(BUCKET)
+        .key(key)
+        .send()
+        .await
+        .expect("create");
+    let upload_id = created.upload_id().expect("upload id").to_string();
+
+    // Sign the digest of the bytes the client MEANT to send, then deliver different bytes —
+    // exactly what an in-transit alteration looks like to the gateway.
+    let signed_bytes = body(4096, 10);
+    let delivered = body(4096, 11);
+    let query = format!("partNumber=1&uploadId={upload_id}");
+    let creds = Credentials {
+        access_key_id: ACCESS_KEY.to_string(),
+        secret_access_key: SECRET_KEY.to_string(),
+    };
+    let amz_date = format_amz_date(std::time::SystemTime::now());
+    let payload_hash = sha256_hex(&signed_bytes);
+    let signed = sign_with_payload_hash(
+        "PUT",
+        &path,
+        &query,
+        &addr.to_string(),
+        &amz_date,
+        &payload_hash,
+        &creds,
+        REGION,
+        "s3",
+    );
+    let headers = vec![
+        ("authorization".to_string(), signed.authorization),
+        ("x-amz-date".to_string(), signed.amz_date),
+        ("x-amz-content-sha256".to_string(), signed.content_sha256),
+    ];
+    let (status, response) = send(addr, "PUT", &path, &query, &headers, &delivered).await;
+    assert_eq!(
+        status,
+        400,
+        "a part whose bytes do not match the signed x-amz-content-sha256 must be refused: {}",
+        String::from_utf8_lossy(&response)
+    );
+    assert!(
+        String::from_utf8_lossy(&response).contains("XAmzContentSHA256Mismatch"),
+        "the refusal must name the content-hash mismatch, got {}",
+        String::from_utf8_lossy(&response)
+    );
+
+    // Nothing was staged: the session has no parts.
+    let listed = client
+        .list_parts()
+        .bucket(BUCKET)
+        .key(key)
+        .upload_id(&upload_id)
+        .send()
+        .await
+        .expect("ListParts must be accepted");
+    assert!(
+        listed.parts().is_empty(),
+        "a refused part must not be staged, got {:?}",
+        listed.parts()
+    );
+}
