+/// Render `<InitiateMultipartUploadResult>` (CreateMultipartUpload), string-built with
+/// [`xml_escape`] like the listing renderers.
+fn render_initiate_result(bucket: &str, key: &str, upload_id: &str) -> String {
+    format!(
+        "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\
+         <InitiateMultipartUploadResult xmlns=\"{ns}\">\
+         <Bucket>{bucket}</Bucket><Key>{key}</Key><UploadId>{upload}</UploadId>\
+         </InitiateMultipartUploadResult>",
+        ns = S3_XMLNS,
+        bucket = xml_escape(bucket),
+        key = xml_escape(key),
+        upload = xml_escape(upload_id),
+    )
+}
+
+/// Render `<CompleteMultipartUploadResult>`. The composed ETag is S3-quoted, like every other
+/// ETag on the wire ([`quote_etag`]).
+fn render_complete_result(bucket: &str, key: &str, etag: &str) -> String {
+    format!(
+        "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\
+         <CompleteMultipartUploadResult xmlns=\"{ns}\">\
+         <Location>/{bucket}/{key}</Location><Bucket>{bucket}</Bucket><Key>{key}</Key>\
+         <ETag>{etag}</ETag></CompleteMultipartUploadResult>",
+        ns = S3_XMLNS,
+        bucket = xml_escape(bucket),
+        key = xml_escape(key),
+        etag = xml_escape(&quote_etag(etag)),
+    )
+}
+
+/// Render `<ListPartsResult>` — one `<Part>` per staged part on this page (ascending), each with
+/// its number, S3-quoted ETag (MD5), and byte size, plus the pagination frame: the echoed
+/// `PartNumberMarker`/`MaxParts`, the real `IsTruncated`, and — only when truncated —
+/// `NextPartNumberMarker`, the last part number of the page (S3: a paginator resumes from it).
+///
+/// `IsTruncated` is COMPUTED, never hard-coded: a page cut at `max-parts` that claimed
+/// `false` would tell a conforming paginator the listing was complete and silently hide the
+/// remaining parts.
+fn render_list_parts_result(
+    bucket: &str,
+    key: &str,
+    upload_id: &str,
+    parts: &[wyrd_gateway_core::StagedPart],
+    part_number_marker: u32,
+    max_parts: usize,
+    is_truncated: bool,
+) -> String {
+    let mut out = String::with_capacity(256 + parts.len() * 96);
+    out.push_str("<?xml version=\"1.0\" encoding=\"UTF-8\"?>");
+    out.push_str(&format!(
+        "<ListPartsResult xmlns=\"{ns}\"><Bucket>{bucket}</Bucket><Key>{key}</Key>\
+         <UploadId>{upload}</UploadId><StorageClass>STANDARD</StorageClass>\
+         <PartNumberMarker>{marker}</PartNumberMarker><MaxParts>{max_parts}</MaxParts>",
+        ns = S3_XMLNS,
+        bucket = xml_escape(bucket),
+        key = xml_escape(key),
+        upload = xml_escape(upload_id),
+        marker = part_number_marker,
+    ));
+    if is_truncated {
+        if let Some(last) = parts.last() {
+            out.push_str(&format!(
+                "<NextPartNumberMarker>{}</NextPartNumberMarker>",
+                last.part_number
+            ));
+        }
+    }
+    out.push_str(&format!("<IsTruncated>{is_truncated}</IsTruncated>"));
+    for part in parts {
+        out.push_str(&format!(
+            "<Part><PartNumber>{n}</PartNumber><ETag>{etag}</ETag><Size>{size}</Size></Part>",
+            n = part.part_number,
+            etag = xml_escape(&quote_etag(&part.etag)),
+            size = part.size,
+        ));
+    }
+    out.push_str("</ListPartsResult>");
+    out
+}
+
+/// Render `<ListMultipartUploadsResult>` — one `<Upload>` per in-progress upload on this page
+/// (key + upload id), with the same computed pagination frame [`render_list_parts_result`]
+/// carries: the echoed `KeyMarker`/`UploadIdMarker`/`MaxUploads`, the real `IsTruncated`, and —
+/// only when truncated — the `NextKeyMarker`/`NextUploadIdMarker` a paginator resumes from.
+fn render_list_uploads_result(
+    bucket: &str,
+    uploads: &[wyrd_gateway_core::MultipartUpload],
+    key_marker: &str,
+    upload_id_marker: &str,
+    max_uploads: usize,
+    is_truncated: bool,
+) -> String {
+    let mut out = String::with_capacity(256 + uploads.len() * 96);
+    out.push_str("<?xml version=\"1.0\" encoding=\"UTF-8\"?>");
+    out.push_str(&format!(
+        "<ListMultipartUploadsResult xmlns=\"{ns}\"><Bucket>{bucket}</Bucket>\
+         <KeyMarker>{key_marker}</KeyMarker><UploadIdMarker>{id_marker}</UploadIdMarker>\
+         <MaxUploads>{max_uploads}</MaxUploads>",
+        ns = S3_XMLNS,
+        bucket = xml_escape(bucket),
+        key_marker = xml_escape(key_marker),
+        id_marker = xml_escape(upload_id_marker),
+    ));
+    if is_truncated {
+        if let Some(last) = uploads.last() {
+            out.push_str(&format!(
+                "<NextKeyMarker>{key}</NextKeyMarker>\
+                 <NextUploadIdMarker>{upload}</NextUploadIdMarker>",
+                key = xml_escape(&last.key),
+                upload = xml_escape(&last.upload_id),
+            ));
+        }
+    }
+    out.push_str(&format!("<IsTruncated>{is_truncated}</IsTruncated>"));
+    for upload in uploads {
+        out.push_str(&format!(
+            "<Upload><Key>{key}</Key><UploadId>{upload}</UploadId></Upload>",
+            key = xml_escape(&upload.key),
+            upload = xml_escape(&upload.upload_id),
+        ));
+    }
+    out.push_str("</ListMultipartUploadsResult>");
+    out
+}
