+// ---- Multipart upload (issue #508) ----
+
+/// The S3 XML document namespace every multipart response echoes (the SDK is
+/// namespace-lenient, but AWS emits it, so we match).
+const S3_XMLNS: &str = "http://s3.amazonaws.com/doc/2006-03-01/";
+
+/// The buffered-byte cap for a **CompleteMultipartUpload** request body. The body is a small
+/// signed `<CompleteMultipartUpload>` part list (≤10 000 `<Part>`), so — like a bulk-delete
+/// body — it is buffered whole; an over-cap body is refused as `MalformedXML` before any commit.
+const MAX_COMPLETE_BODY_BYTES: usize = 4 * 1024 * 1024;
+
+/// A classified multipart **object** operation (issue #508) — the typed op the query forms
+/// parse into so `dispatch` routes them without re-matching query strings inline.
+enum MultipartObjectOp {
+    /// `POST /b/k?uploads` — CreateMultipartUpload.
+    Create,
+    /// `PUT /b/k?partNumber=N&uploadId=U` — UploadPart.
+    UploadPart {
+        /// The 1-based part number.
+        part_number: u32,
+        /// The upload id the part is staged under.
+        upload_id: String,
+    },
+    /// `POST /b/k?uploadId=U` — CompleteMultipartUpload.
+    Complete {
+        /// The upload id being completed.
+        upload_id: String,
+    },
+    /// `DELETE /b/k?uploadId=U` — AbortMultipartUpload.
+    Abort {
+        /// The upload id being aborted.
+        upload_id: String,
+    },
+    /// `GET /b/k?uploadId=U` — ListParts.
+    ListParts {
+        /// The upload id whose parts are listed.
+        upload_id: String,
+    },
+}
+
+/// S3's valid part-number range (`1..=10_000`, S3 API reference / UploadPart): a request
+/// outside it is `InvalidArgument`, refused at the routing boundary before anything is staged.
+/// `partNumber=0` in particular must not be staged: [`assemble`](wyrd_core::multipart::assemble)
+/// requires strictly-ascending numbers `> 0`, so a part 0 could never be completed and its
+/// chunks would sit staged until Abort.
+const MIN_PART_NUMBER: u32 = 1;
+const MAX_PART_NUMBER: u32 = 10_000;
+
+/// The classification of an OBJECT-path request against the multipart query forms — the
+/// **three-way**, fail-closed result [`classify_multipart_object`] returns.
+///
+/// The three-way shape is load-bearing, not stylistic. A two-way `Option` let every *malformed*
+/// multipart query (`PUT ?partNumber=1` with no `uploadId`, a non-numeric `partNumber`,
+/// `DELETE ?uploads`) fall through to the plain-verb dispatch, where a `PUT` overwrote the whole
+/// object with the part body and a `DELETE` deleted it — the exact destructive fall-through the
+/// denylist used to prevent with its `501` (issue #508 adversarial review). A request carrying
+/// ANY multipart query key now leaves this classifier as either a routed op or a refusal; it can
+/// never reach the plain verb.
+enum MultipartRoute {
+    /// A well-formed multipart form: route it to the verb.
+    Op(MultipartObjectOp),
+    /// A multipart query key is present but the form is not one this floor implements (or its
+    /// part number is out of range) — refuse with this `(status, code, message)` rather than
+    /// letting the plain verb mishandle it.
+    Refuse(StatusCode, &'static str, String),
+    /// No multipart query key at all: an ordinary object request.
+    Plain,
+}
+
+/// Classify an OBJECT-path request against the multipart query forms, matching query keys in
+/// their **decoded** form so a percent-encoded key (`?upload%73`, `?part%4Eumber`) cannot dodge
+/// the routing (#491 — the bug class this floor must not extend to the new routes).
+///
+/// Fail-closed by construction: [`MultipartRoute::Plain`] is returned **only** when none of the
+/// three multipart keys is present, so a malformed multipart query is refused
+/// ([`MultipartRoute::Refuse`]) instead of falling through to the plain PUT/DELETE/GET.
+fn classify_multipart_object(method: &Method, query: &str) -> MultipartRoute {
+    let uploads = has_decoded_query_flag(query, "uploads");
+    let has_upload_id = has_decoded_query_flag(query, "uploadId");
+    let has_part_number = has_decoded_query_flag(query, "partNumber");
+    if !uploads && !has_upload_id && !has_part_number {
+        return MultipartRoute::Plain;
+    }
+    // A valueless or empty `?uploadId` / `?partNumber` is malformed, never a plain request.
+    let upload_id = decoded_query_value(query, "uploadId").filter(|v| !v.is_empty());
+    let part_number = decoded_query_value(query, "partNumber").filter(|v| !v.is_empty());
+
+    // `?uploads` names Create, which takes no upload id / part number. A query mixing them is
+    // ambiguous — refuse rather than guess which verb the client meant.
+    if uploads && (has_upload_id || has_part_number) {
+        return refuse_multipart("`uploads` may not be combined with `uploadId` or `partNumber`");
+    }
+    if uploads {
+        return match *method {
+            Method::POST => MultipartRoute::Op(MultipartObjectOp::Create),
+            // `PUT /b/k?uploads`, `DELETE /b/k?uploads`, … are not S3 operations. They were
+            // `501` on the base and stay `501` — never a plain PUT that overwrites the object.
+            _ => unsupported_multipart_form("uploads"),
+        };
+    }
+    if *method == Method::PUT {
+        let (Some(upload_id), Some(part_number)) = (upload_id, part_number) else {
+            // UploadPart needs BOTH. A PUT carrying only one of them is refused, NOT streamed
+            // into the object as a plain PUT (which would destroy it).
+            return unsupported_multipart_form(if has_part_number {
+                "partNumber"
+            } else {
+                "uploadId"
+            });
+        };
+        return match part_number.parse::<u32>() {
+            Ok(part_number) if (MIN_PART_NUMBER..=MAX_PART_NUMBER).contains(&part_number) => {
+                MultipartRoute::Op(MultipartObjectOp::UploadPart {
+                    part_number,
+                    upload_id,
+                })
+            }
+            // Non-numeric, negative, 0, or > 10 000: S3's `InvalidArgument`, refused before the
+            // body is read — and, crucially, never falling through to a plain object PUT.
+            _ => refuse_multipart("part number must be an integer between 1 and 10000, inclusive"),
+        };
+    }
+    // The remaining verbs are distinguished by `?uploadId` alone; a `partNumber` without one
+    // (`DELETE /b/k?partNumber=1`) is malformed and must not reach the plain verb.
+    let Some(upload_id) = upload_id else {
+        return unsupported_multipart_form("uploadId");
+    };
+    match *method {
+        Method::POST => MultipartRoute::Op(MultipartObjectOp::Complete { upload_id }),
+        Method::DELETE => MultipartRoute::Op(MultipartObjectOp::Abort { upload_id }),
+        Method::GET => MultipartRoute::Op(MultipartObjectOp::ListParts { upload_id }),
+        // HEAD and the rest carry no multipart operation: refuse, don't fall through.
+        _ => unsupported_multipart_form("uploadId"),
+    }
+}
+
+/// Refuse a multipart query form this floor does not implement — the same `501 NotImplemented`
+/// the subresource denylist answered before these keys became live routes, so a form that is not
+/// a real multipart operation is still never mishandled by a plain verb.
+fn unsupported_multipart_form(key: &'static str) -> MultipartRoute {
+    MultipartRoute::Refuse(
+        StatusCode::NOT_IMPLEMENTED,
+        "NotImplemented",
+        format!("the `{key}` S3 subresource/operation is not supported in this form"),
+    )
+}
+
+/// Refuse a malformed multipart request argument (S3's `InvalidArgument`, `400`).
+fn refuse_multipart(message: &str) -> MultipartRoute {
+    MultipartRoute::Refuse(
+        StatusCode::BAD_REQUEST,
+        "InvalidArgument",
+        message.to_string(),
+    )
+}
+
+/// Whether `query` carries the flag `name` as a **decoded** key (present with or without a
+/// value) — the #491-safe counterpart of [`is_delete_subresource`]'s bare-key match.
+fn has_decoded_query_flag(query: &str, name: &str) -> bool {
+    query
+        .split('&')
+        .filter(|p| !p.is_empty())
+        .map(|p| p.split_once('=').map(|(k, _)| k).unwrap_or(p))
+        .any(|k| percent_decode_utf8(k) == name)
+}
+
+/// The **decoded** value of query parameter `name` matched on its **decoded** key (first
+/// occurrence) — the #491-safe counterpart of [`query_param`], which matches the raw key.
+fn decoded_query_value(query: &str, name: &str) -> Option<String> {
+    query
+        .split('&')
+        .filter(|p| !p.is_empty())
+        .filter_map(|p| p.split_once('='))
+        .find(|(k, _)| percent_decode_utf8(k) == name)
+        .map(|(_, v)| percent_decode_utf8(v))
+}
