+/// UploadPart (`PUT /b/k?partNumber=N&uploadId=U`): stage the part over the SAME streaming
+/// write path an object PUT uses (the `aws-chunked` streaming body is de-framed and verified
+/// exactly as the PUT arm does, `:1613`), so a part never resides whole in the gateway heap.
+/// Answers `200` with the part's `ETag` (its MD5, S3-quoted) header.
+async fn upload_part<G>(
+    state: &AppState<G>,
+    request_id: RequestId,
+    object_key: &str,
+    upload_id: &str,
+    part_number: u32,
+    payload: sigv4::PayloadHash,
+    body: Body,
+) -> Response
+where
+    G: MultipartGateway,
+{
+    let raw = Box::pin(
+        body.into_data_stream()
+            .map(|item| item.map_err(|e| Box::new(e) as BoxError)),
+    );
+    // The payload-integrity contract is EXACTLY the plain PUT arm's (`:1707-1744`): a part is
+    // staged under the same content-hash check an object PUT is stored under, so a signed part
+    // altered in transit is refused instead of being folded into the completed object (the
+    // composed multipart ETag digests what was *received*, so it could not catch it). Per-part
+    // `Content-MD5` / checksum trailers beyond this remain out of scope (brief §Out-of-scope).
+    let result = match payload {
+        // An `aws-chunked` streaming-signature upload — de-frame + verify each chunk as it
+        // streams, then stage the raw part bytes (the same handling as the PUT arm). The
+        // per-chunk signatures already authenticated the body, so there is no separate
+        // post-stream content hash to re-check.
+        sigv4::PayloadHash::Streaming(ctx) => {
+            let decoded = streaming::decode(raw, ctx);
+            state
+                .gateway
+                .upload_part(
+                    object_key,
+                    upload_id,
+                    part_number,
+                    decoded,
+                    ContentHash::Unverified,
+                )
+                .await
+        }
+        // A single-shot **signed** body: stream it straight in; the running hash is checked
+        // against the signed `x-amz-content-sha256` before the part record commits.
+        sigv4::PayloadHash::Signed(hex) => {
+            state
+                .gateway
+                .upload_part(
+                    object_key,
+                    upload_id,
+                    part_number,
+                    raw,
+                    ContentHash::Expected(hex),
+                )
+                .await
+        }
+        // A deliberately-unsigned body: stage it with no post-stream hash check.
+        sigv4::PayloadHash::Unsigned => {
+            state
+                .gateway
+                .upload_part(
+                    object_key,
+                    upload_id,
+                    part_number,
+                    raw,
+                    ContentHash::Unverified,
+                )
+                .await
+        }
+    };
+    match result {
+        // `put_object_response` sets the `ETag` header (S3-quoted) + a body-less `200` — exactly
+        // what UploadPart answers, with the part MD5 as the ETag.
+        Ok(part) => put_object_response(&part.etag),
+        Err(err) => gateway_error_response(request_id, &err),
+    }
+}
