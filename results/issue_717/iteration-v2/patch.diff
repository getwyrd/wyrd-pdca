+++ b/crates/core/tests/multipart_staging_retire.rs
@@ -0,0 +1,901 @@
+//! Issue #717 — the multipart **staging and retirement** records: the two record classes
+//! whose identity lives partly **in the key**, plus the two ownership fields the shared
+//! `PendingEntry` gains for the first of them (proposal 0016 §1, `:333-356`, `:442-491`, the
+//! retirement-token grammar at `:357-378`).
+//!
+//! `wyrd_core::multipart::{OwnedEntry, StagedPlacement, PartNumberSet, RetirePayload,
+//! decode_owned_entry, decode_retire_obligation}` and
+//! `wyrd_core::metadata::PendingEntry`'s `owner`/`staged`. **Pure**: no store, no async, no
+//! fixture beyond hand-authored JSON bytes and the production codec — mirroring
+//! `multipart_session_records.rs` (#716) and `multipart_budget_admission.rs` (#715) for the
+//! record values this child adds beside them.
+//!
+//! **Why both decoders take the key.** A `sidx:` entry's owner and a `retire:` obligation's
+//! mode, scope and part attempt are *relations between the key and the value*: a decode that
+//! cannot see the key cannot check them, so [`decode_owned_entry`] and
+//! [`decode_retire_obligation`] are key-taking entry points over the store-wide codec rather
+//! than `bytes`-only arms of a dispatching envelope (there is none, and none is coming).
+//! Every leg below that names a mismatch is therefore keyed with a **hand-built production
+//! key** (`sidx_key`, `retire_key`), never a synthetic one.
+//!
+//! Every witness is **decoded, never constructed** where the type has no writer — and where
+//! one does ([`StagedPlacement`], [`PartNumberSet`]), the constructor's output is decoded
+//! back, so the writer and the reader are pinned to one another rather than to this file.
+//!
+//! **Serialization identity is asserted on every accepted witness**: the `decode_*_both`
+//! helpers re-encode whatever they decoded and compare byte-for-byte against the input, so
+//! `encode(decode(bytes)) == bytes` is a property of the whole file's accepted set. For the
+//! `pending:` half that is the load-bearing one (`0016:475-485`): `renew_pending`
+//! preconditions on the **raw bytes it read** and puts the re-encoded entry
+//! (`renew_pending`, `metadata.rs:2090`), so a non-identity re-encode does not conflict — it
+//! lets the CAS
+//! **succeed** and silently rewrite the record's shape.
+//!
+//! The legs (Falsifiability, brief #717): **nine** isolating negations — 1b (owner vs key),
+//! 1d (retirement token identity/scope), 1h-session-under-part, 1h-part-under-session,
+//! 1h-records-under-part, 1i (`StagedPlacement`'s `EcScheme`), 1e (the torn `PendingEntry`,
+//! under both a `pending:` and a `sidx:` reading), 1n (a generation naming both sources), 1p
+//! (a structurally invalid nested `ChunkRef`) — plus **leg 2** (a legacy `pending:` value
+//! re-encodes byte-identically) and **the leg-3 corollary** (a length-mismatched `staged`
+//! placement *decodes*, the standing contextual-check example). Eleven demonstrations. The
+//! remaining tests (round trips, the mode rule, the whole-payload emptiness rule, the closed
+//! wire shapes and the canonical-bytes gate) are additional evidence, not part of that count —
+//! each is negated in `build-notes.md` the same way, and the two that guard this round's fixes
+//! (`a_records_obligation_owing_only_segments_decodes`, the `PendingEntry` half of
+//! `an_unknown_field_is_refused`) are load-bearing for review findings, not decoration.
+//!
+//! No `#![cfg(...)]` here — this file always compiles and always runs.
+
+#![forbid(unsafe_code)]
+
+use wyrd_core::metadata::{self, EcScheme, PendingEntry, SegmentGroup};
+use wyrd_core::multipart::{
+    decode_owned_entry, decode_retire_obligation, retire_key, sidx_key, AttemptId, OwnedEntry,
+    PartNumber, PartNumberSet, RecordError, RetireMode, RetirePayload, RetireToken,
+    StagedPlacement, UploadId,
+};
+
+/// The session every witness is staged under, unless a leg deliberately perturbs it.
+const OWNER_HEX: &str = "1a";
+/// A *different* session, for the legs that misfile a value under another session's key.
+const OTHER_HEX: &str = "2b";
+/// The attempt id a per-part retirement token names.
+const ATTEMPT_HEX: &str = "3c";
+/// The chunk a `sidx:` entry protects. Deliberately not `0` or `1`: a witness that only ever
+/// observes an id's zero value cannot tell a decoder that reads it from one that defaults it.
+const CHUNK: u128 = 77;
+/// The part number the staging key and the per-part token name.
+const PART: u32 = 4;
+/// A lease expiry, non-zero for the reason [`CHUNK`] is.
+const LEASE: u64 = 9_000;
+/// The session epoch a retirement token carries.
+const EPOCH: u64 = 3;
+/// The published generation a `g:` token names.
+const INODE: u64 = 42;
+const VERSION: u64 = 5;
+
+/// 32 lowercase-hex characters from a 2-character pair — the token length `UploadId` /
+/// `AttemptId` demand, without fencepost counting by hand.
+fn hex32(pair: &str) -> String {
+    pair.repeat(16)
+}
+
+fn upload_id(pair: &str) -> UploadId {
+    UploadId::new(hex32(pair)).expect("a 32-hex-character upload id")
+}
+
+fn part(number: u32) -> PartNumber {
+    PartNumber::new(number).expect("an in-range part number")
+}
+
+// ===========================================================================
+// Hand-authored bytes — field names and order exactly as the production types declare them,
+// so a byte-identity assertion after re-encoding is a claim about this codec's own spelling.
+// ===========================================================================
+
+/// The `staged` placement every owned witness carries: a supported scheme and a placement
+/// naming one position per fragment — `rs(2,1)` has three, so the length-mismatch leg below
+/// is the only witness in this file that carries a short one.
+const STAGED_JSON: &str = r#"{"scheme":{"ReedSolomon":{"k":2,"m":1}},"placement":[7,8,9]}"#;
+
+/// A `sidx:` value: a [`PendingEntry`] with both ownership fields present.
+fn owned_json(owner_hex: &str, staged_json: &str) -> Vec<u8> {
+    format!(
+        "{{\"lease_expiry_millis\":{LEASE},\"owner\":\"{}\",\"staged\":{staged_json}}}",
+        hex32(owner_hex)
+    )
+    .into_bytes()
+}
+
+/// The `sidx:` key naming [`OWNER_HEX`]'s session, part [`PART`], chunk [`CHUNK`].
+fn owned_key(owner_hex: &str) -> Vec<u8> {
+    sidx_key(&upload_id(owner_hex), part(PART), CHUNK)
+}
+
+/// A nested chunk of a retirement payload, spelled exactly as `ChunkRef` serializes.
+fn chunk_json(scheme_json: &str) -> String {
+    format!(r#"{{"id":{CHUNK},"scheme":{scheme_json},"len":12,"placement":[7]}}"#)
+}
+
+/// The session-wide token every whole-session obligation is filed under.
+fn session_token() -> RetireToken {
+    RetireToken::Session {
+        upload_id: upload_id(OWNER_HEX),
+        epoch: EPOCH,
+        part: None,
+    }
+}
+
+/// The same session's token with the optional `:<part-number>:<attempt-id>` suffix — the
+/// per-part obligation's token (`0016:357-366`).
+fn part_token() -> RetireToken {
+    RetireToken::Session {
+        upload_id: upload_id(OWNER_HEX),
+        epoch: EPOCH,
+        part: Some((
+            part(PART),
+            AttemptId::new(hex32(ATTEMPT_HEX)).expect("a 32-hex-character attempt id"),
+        )),
+    }
+}
+
+fn generation_token(inode: u64, version: u64) -> RetireToken {
+    RetireToken::Generation { inode, version }
+}
+
+// ===========================================================================
+// S1/S2 agreement + serialization identity, once per record class — the shape
+// `multipart_session_records.rs:168` uses, adapted to the two key-taking decoders.
+// ===========================================================================
+
+/// Decode a `sidx:` value through the key-taking [`decode_owned_entry`] (S2) **and** through
+/// the store-wide `metadata::decode::<PendingEntry>` + [`OwnedEntry::from_pending`] (S1, what
+/// a reaper holding the shared record sees), assert the two agree, and assert that
+/// re-encoding an accepted value reproduces the bytes it was read from.
+///
+/// Only for witnesses whose key names the value's **own** owner: the key cross-check is
+/// exactly the rule S1 cannot make, so leg 1b calls the decoder directly.
+fn decode_owned_both(key: &[u8], bytes: &[u8]) -> Result<OwnedEntry, RecordError> {
+    let typed = decode_owned_entry(key, bytes);
+    let shared = metadata::decode::<PendingEntry>(bytes)
+        .ok()
+        .map(|entry| OwnedEntry::from_pending(&entry));
+    assert_eq!(
+        typed.as_ref().ok(),
+        shared.as_ref().and_then(|result| result.as_ref().ok()),
+        "the sidx: decoder and the shared-record view disagree on {}",
+        String::from_utf8_lossy(bytes)
+    );
+    if let Ok(entry) = &typed {
+        assert_eq!(
+            String::from_utf8_lossy(metadata::encode(&entry.to_pending()).as_ref()),
+            String::from_utf8_lossy(bytes),
+            "decode->encode is not byte-identical for {entry:?}"
+        );
+    }
+    typed
+}
+
+/// Decode a `retire:` obligation through [`decode_retire_obligation`], assert the token the
+/// key names comes back, and assert the byte identity every accepted payload must hold.
+fn decode_retire_both(
+    mode: RetireMode,
+    token: &RetireToken,
+    value: &[u8],
+) -> Result<RetirePayload, RecordError> {
+    let key = retire_key(mode, token);
+    let decoded = decode_retire_obligation(&key, value);
+    if let Ok((decoded_token, payload)) = &decoded {
+        assert_eq!(decoded_token, token, "the key's token did not round-trip");
+        assert_eq!(
+            String::from_utf8_lossy(metadata::encode(payload).as_ref()),
+            String::from_utf8_lossy(value),
+            "decode->encode is not byte-identical for {payload:?}"
+        );
+        let untyped: RetirePayload =
+            metadata::decode(value).expect("S1 accepts what the key-taking decoder accepted");
+        assert_eq!(&untyped, payload, "S1 and S2 disagree on the payload");
+    }
+    decoded.map(|(_, payload)| payload)
+}
+
+// ===========================================================================
+// Round trips — every type this child lands decodes, and re-encoding what this codec decoded
+// is byte-identical to what it read.
+// ===========================================================================
+
+#[test]
+fn owned_entry_round_trips() {
+    let entry = decode_owned_both(&owned_key(OWNER_HEX), &owned_json(OWNER_HEX, STAGED_JSON))
+        .expect("an owned staging entry decodes");
+    assert_eq!(entry.owner(), &upload_id(OWNER_HEX));
+    assert_eq!(entry.lease_expiry_millis(), LEASE);
+    assert_eq!(
+        entry.staged().scheme(),
+        EcScheme::ReedSolomon { k: 2, m: 1 }
+    );
+    assert_eq!(entry.staged().placement(), [7, 8, 9]);
+}
+
+/// [`StagedPlacement`] decodes on its own, independent of any entry wrapping it — and its
+/// validating constructor mints exactly what its own decode accepts.
+#[test]
+fn staged_placement_round_trips_standalone() {
+    let placement: StagedPlacement =
+        metadata::decode(STAGED_JSON.as_bytes()).expect("a bare StagedPlacement decodes");
+    assert_eq!(
+        metadata::encode(&placement).as_ref(),
+        STAGED_JSON.as_bytes()
+    );
+    let minted = StagedPlacement::new(EcScheme::ReedSolomon { k: 2, m: 1 }, vec![7, 8, 9])
+        .expect("a supported scheme is constructible");
+    assert_eq!(minted, placement);
+    let unfragmented: StagedPlacement = metadata::decode(br#"{"scheme":"None","placement":[3]}"#)
+        .expect("an unfragmented placement decodes");
+    assert_eq!(unfragmented.scheme(), EcScheme::None);
+}
+
+/// **Leg 2 (BINDING)** — a **legacy** `pending:` value, written before either ownership field
+/// existed, decodes to the absent shape and re-encodes **byte-identically**.
+///
+/// The mechanism this protects is not a conflict: `renew_pending` preconditions on the raw
+/// bytes it read and puts the re-encoded entry (`require(key, current)` + `put(key,
+/// encode(entry))`, `metadata.rs:2090`), and `live_lease_guards` pins those same raw bytes
+/// (`:2114`). A decode→encode that emitted `"owner":null` would therefore let the CAS
+/// **succeed** and durably rewrite every legacy entry's shape, with no error anywhere.
+#[test]
+fn legacy_pending_entry_re_encodes_byte_identically() {
+    let bytes = br#"{"lease_expiry_millis":9000}"#;
+    let entry: PendingEntry = metadata::decode(bytes).expect("a legacy pending entry decodes");
+    assert_eq!(entry.lease_expiry_millis, LEASE);
+    assert_eq!(entry.owner, None);
+    assert_eq!(entry.staged, None);
+    let re_encoded = metadata::encode(&entry);
+    assert_eq!(
+        String::from_utf8_lossy(re_encoded.as_ref()),
+        String::from_utf8_lossy(bytes),
+        "a legacy pending entry must re-encode byte-identically"
+    );
+    assert!(
+        !String::from_utf8_lossy(re_encoded.as_ref()).contains("null"),
+        "an absent ownership field must be omitted, never emitted as null"
+    );
+}
+
+/// The owned half of the same identity: an owned entry's renewal re-encodes the record it
+/// read, so both fields present must survive a decode→encode unchanged (`0016:475-485`).
+#[test]
+fn owned_pending_entry_re_encodes_byte_identically() {
+    let bytes = owned_json(OWNER_HEX, STAGED_JSON);
+    let entry: PendingEntry = metadata::decode(&bytes).expect("an owned pending entry decodes");
+    assert_eq!(entry.owner.as_ref(), Some(&upload_id(OWNER_HEX)));
+    assert_eq!(
+        String::from_utf8_lossy(metadata::encode(&entry).as_ref()),
+        String::from_utf8_lossy(&bytes)
+    );
+}
+
+#[test]
+fn part_number_set_round_trips() {
+    let bytes = b"[[1,2],[5,5]]";
+    let set: PartNumberSet = metadata::decode(bytes).expect("a coalesced run list decodes");
+    assert_eq!(set.len(), 3);
+    assert!(!set.is_empty());
+    assert_eq!(set.iter().collect::<Vec<_>>(), vec![1, 2, 5]);
+    assert_eq!(metadata::encode(&set).as_ref(), bytes.as_slice());
+    // The writer-side constructor mints exactly the encoding the decode accepts: adjacent
+    // numbers coalesce into one run, so `[1, 2, 5]` is the set above and not `[[1,1],[2,2],…]`.
+    assert_eq!(
+        PartNumberSet::from_numbers([part(2), part(1), part(5)]),
+        set
+    );
+    assert!(PartNumberSet::from_runs(vec![(1, 2), (5, 5)]).is_ok());
+}
+
+/// Every payload shape decodes under the token it belongs to — the positive side of the
+/// mode, scope and part-scope cross-checks the negations below drive.
+#[test]
+fn retire_payload_shapes_round_trip() {
+    let session = decode_retire_both(RetireMode::Bytes, &session_token(), br#"{"Session":{}}"#)
+        .expect("a session teardown obligation decodes");
+    assert_eq!(session, RetirePayload::Session {});
+
+    let parts = decode_retire_both(
+        RetireMode::Bytes,
+        &session_token(),
+        br#"{"Parts":{"parts":[[1,2]]}}"#,
+    )
+    .expect("an unnamed-parts obligation decodes");
+    let RetirePayload::Parts { parts } = parts else {
+        panic!("expected Parts, got {parts:?}");
+    };
+    assert_eq!(parts.iter().collect::<Vec<_>>(), vec![1, 2]);
+
+    let chunks = decode_retire_both(
+        RetireMode::Bytes,
+        &part_token(),
+        format!(
+            "{{\"Chunks\":{{\"chunks\":[{}]}}}}",
+            chunk_json(r#""None""#)
+        )
+        .as_bytes(),
+    )
+    .expect("a per-part compensation obligation decodes");
+    let RetirePayload::Chunks { chunks } = chunks else {
+        panic!("expected Chunks, got {chunks:?}");
+    };
+    assert_eq!(chunks.len(), 1);
+    assert_eq!(chunks[0].id, CHUNK);
+
+    let generation = decode_retire_both(
+        RetireMode::Bytes,
+        &generation_token(INODE, VERSION),
+        format!(
+            "{{\"Generation\":{{\"inode\":{INODE},\"version\":{VERSION},\"chunks\":[{}]}}}}",
+            chunk_json(r#""None""#)
+        )
+        .as_bytes(),
+    )
+    .expect("a superseded-generation obligation decodes");
+    assert!(matches!(
+        generation,
+        RetirePayload::Generation { inode, version, .. } if inode == INODE && version == VERSION
+    ));
+
+    let records = decode_retire_both(
+        RetireMode::Records,
+        &session_token(),
+        br#"{"Records":{"parts":[[3,3]]}}"#,
+    )
+    .expect("a published-records obligation decodes");
+    assert!(matches!(records, RetirePayload::Records { .. }));
+}
+
+/// A generation obligation may name its `seg:` generation instead of a flat chunk list — the
+/// other of the two alternatives leg 1n holds apart.
+#[test]
+fn retire_generation_by_segments_round_trips() {
+    let nonce = "ab".repeat(16);
+    let value = format!(
+        "{{\"Generation\":{{\"inode\":{INODE},\"version\":{VERSION},\"segments\":{{\"nonce\":\"{nonce}\",\"epoch\":{EPOCH}}}}}}}"
+    );
+    let payload = decode_retire_both(
+        RetireMode::Bytes,
+        &generation_token(INODE, VERSION),
+        value.as_bytes(),
+    )
+    .expect("a segmented generation obligation decodes");
+    let RetirePayload::Generation { segments, .. } = payload else {
+        panic!("expected Generation, got {payload:?}");
+    };
+    assert_eq!(
+        segments,
+        Some(SegmentGroup::new(nonce, EPOCH).expect("a 32-hex-character nonce"))
+    );
+}
+
+// ===========================================================================
+// The binding negations — one per rule, each isolating its own.
+// ===========================================================================
+
+/// **Leg 1b (BINDING)** — [`decode_owned_entry`] takes the `sidx:` key and rejects a payload
+/// whose `owner` is not the upload id the key names. The same bytes under their **honest**
+/// key decode, so the leg turns on the key/value relation and not on the value alone.
+#[test]
+fn owned_entry_owner_must_agree_with_its_key() {
+    let bytes = owned_json(OWNER_HEX, STAGED_JSON);
+    match decode_owned_entry(&owned_key(OTHER_HEX), &bytes) {
+        Err(RecordError::OwnedEntryOwnerMismatch {
+            key_owner,
+            entry_owner,
+        }) => {
+            assert_eq!(key_owner, upload_id(OTHER_HEX));
+            assert_eq!(entry_owner, upload_id(OWNER_HEX));
+        }
+        other => panic!("expected OwnedEntryOwnerMismatch, got {other:?}"),
+    }
+    assert!(decode_owned_entry(&owned_key(OWNER_HEX), &bytes).is_ok());
+}
+
+/// **Leg 1e (BINDING)** — a `PendingEntry` carrying exactly one of `owner`/`staged` is torn
+/// and rejected under **both** readings: the store-wide `metadata::decode::<PendingEntry>`
+/// (the `pending:` reading, where the rejection is raised by the record's own `Deserialize`)
+/// and [`decode_owned_entry`] (the `sidx:` reading, where it is attributed).
+///
+/// Both-absent (legacy) and both-present (owned) are the only valid **shapes**, and this is a
+/// shape check on the value alone: a both-present value stored under a `pending:` key still
+/// decodes, because the live `pending:` readers decode bytes without the key
+/// (`renew_pending`, `metadata.rs:2085`; `live_lease_guards`, `:2121`) — making *that* an
+/// error would mean teaching those readers
+/// to be key-aware, which is a change to live readers rather than a record rule.
+#[test]
+fn torn_pending_entry_is_rejected_under_both_readings() {
+    let owner_only = format!(
+        "{{\"lease_expiry_millis\":{LEASE},\"owner\":\"{}\"}}",
+        hex32(OWNER_HEX)
+    );
+    let staged_only = format!("{{\"lease_expiry_millis\":{LEASE},\"staged\":{STAGED_JSON}}}");
+    for (torn, present, absent) in [
+        (owner_only, "owner", "staged"),
+        (staged_only, "staged", "owner"),
+    ] {
+        assert!(
+            metadata::decode::<PendingEntry>(torn.as_bytes()).is_err(),
+            "the pending: reading must refuse the torn shape {torn}"
+        );
+        match decode_owned_entry(&owned_key(OWNER_HEX), torn.as_bytes()) {
+            Err(RecordError::TornOwnedEntry {
+                present: got_present,
+                absent: got_absent,
+            }) => {
+                assert_eq!(got_present, present);
+                assert_eq!(got_absent, absent);
+            }
+            other => panic!("expected TornOwnedEntry for {torn}, got {other:?}"),
+        }
+    }
+    // The two valid shapes, both readings.
+    assert!(metadata::decode::<PendingEntry>(br#"{"lease_expiry_millis":9000}"#).is_ok());
+    assert!(metadata::decode::<PendingEntry>(&owned_json(OWNER_HEX, STAGED_JSON)).is_ok());
+}
+
+/// **Leg 1i (BINDING, `EcScheme` half)** — a `StagedPlacement` whose stored
+/// `EcScheme::ReedSolomon` is not `erasure::supported(k, m)` is a typed error at decode, not
+/// geometry the reaper's fragment arithmetic later indexes with (`erasure.rs:120`; the #285
+/// class). Refused at every seam that can reach it: the bare type, the shared record, and the
+/// key-taking decoder.
+#[test]
+fn staged_placement_scheme_must_be_supported() {
+    let unsupported = r#"{"scheme":{"ReedSolomon":{"k":0,"m":1}},"placement":[7]}"#;
+    assert!(metadata::decode::<StagedPlacement>(unsupported.as_bytes()).is_err());
+    let bytes = owned_json(OWNER_HEX, unsupported);
+    assert!(metadata::decode::<PendingEntry>(&bytes).is_err());
+    match decode_owned_entry(&owned_key(OWNER_HEX), &bytes) {
+        Err(RecordError::StagedSchemeUnsupported { k, m }) => {
+            assert_eq!((k, m), (0, 1));
+        }
+        other => panic!("expected StagedSchemeUnsupported, got {other:?}"),
+    }
+    assert!(StagedPlacement::new(EcScheme::ReedSolomon { k: 0, m: 1 }, vec![7]).is_err());
+}
+
+/// **The leg-3 corollary (BINDING, negated the other way)** — a `sidx:` value whose `staged`
+/// placement **length** does not match its scheme's fragment count **decodes successfully**.
+///
+/// Placement length is the standing *contextual*-check example (ADR-0045 `:69-74`,
+/// `AGENTS.md:146-149`, `0016:416-429`): liberal on read, strict in the maintenance passes
+/// that will read these entries, rather than an error that would abort a whole reconcile
+/// step. Leg 1i validates the scheme's **geometry**, never the placement's **length**.
+///
+/// What this file can observe is the decode boundary alone, and that is all it asserts:
+/// nothing in this tree reads a `sidx:` key yet (the expiry sweep scans `pending:`,
+/// `crates/custodian/src/gc.rs:482-496`), so how such a value is treated downstream is the
+/// consumers' to prove, not this test's.
+#[test]
+fn owned_entry_with_length_mismatched_placement_decodes() {
+    // `rs(2,1)` has three fragments; this placement names one.
+    let short = r#"{"scheme":{"ReedSolomon":{"k":2,"m":1}},"placement":[7]}"#;
+    let entry = decode_owned_both(&owned_key(OWNER_HEX), &owned_json(OWNER_HEX, short))
+        .expect("a length-mismatched placement is not a decode error");
+    assert_eq!(entry.staged().placement(), [7]);
+}
+
+/// A `sidx:` key over a value carrying **neither** ownership field: an ordinary `pending:`
+/// entry is not an owned staging entry, whichever key it is found under.
+#[test]
+fn legacy_entry_under_a_sidx_key_is_not_an_owned_entry() {
+    assert!(matches!(
+        decode_owned_entry(&owned_key(OWNER_HEX), br#"{"lease_expiry_millis":9000}"#),
+        Err(RecordError::NotAnOwnedEntry)
+    ));
+}
+
+/// **Leg 1d (BINDING)** — [`decode_retire_obligation`] takes the `retire:` key and rejects a
+/// payload whose **generation identity** disagrees with the key's token: a generation-scoped
+/// payload under a session token, a session-scoped payload under a generation token, and a
+/// generation payload under a `g:` token naming a *different* `(inode, version)`.
+#[test]
+fn retire_payload_scope_must_agree_with_its_token() {
+    let generation = format!(
+        "{{\"Generation\":{{\"inode\":{INODE},\"version\":{VERSION},\"chunks\":[{}]}}}}",
+        chunk_json(r#""None""#)
+    );
+    // A generation-scoped payload under a session-scoped token.
+    match decode_retire_obligation(
+        &retire_key(RetireMode::Bytes, &session_token()),
+        generation.as_bytes(),
+    ) {
+        Err(RecordError::RetireTokenScopeMismatch { token, payload }) => {
+            assert_eq!((token, payload), ("s:", "generation"));
+        }
+        other => panic!("expected RetireTokenScopeMismatch, got {other:?}"),
+    }
+    // A session-scoped payload under a generation token.
+    match decode_retire_obligation(
+        &retire_key(RetireMode::Bytes, &generation_token(INODE, VERSION)),
+        br#"{"Session":{}}"#,
+    ) {
+        Err(RecordError::RetireTokenScopeMismatch { token, payload }) => {
+            assert_eq!((token, payload), ("g:", "session"));
+        }
+        other => panic!("expected RetireTokenScopeMismatch, got {other:?}"),
+    }
+    // The right *kind* of token, naming another generation.
+    match decode_retire_obligation(
+        &retire_key(RetireMode::Bytes, &generation_token(INODE, VERSION + 1)),
+        generation.as_bytes(),
+    ) {
+        Err(RecordError::RetireGenerationIdentityMismatch {
+            key_version,
+            payload_version,
+            ..
+        }) => {
+            assert_eq!((key_version, payload_version), (VERSION + 1, VERSION));
+        }
+        other => panic!("expected RetireGenerationIdentityMismatch, got {other:?}"),
+    }
+}
+
+/// **Leg 1h (BINDING), whole-session obligations under a per-part token** — the token's
+/// optional `:<part-number>:<attempt-id>` suffix exists for the per-part obligations only
+/// (`0016:357-366`). A `Session` or `Parts` obligation filed under one part attempt's token
+/// would be cleared by that part's drain and never enumerated by the session's own emptiness
+/// gate.
+#[test]
+fn whole_session_obligations_are_rejected_under_a_per_part_token() {
+    for (value, shape) in [
+        (br#"{"Session":{}}"#.to_vec(), "session"),
+        (br#"{"Parts":{"parts":[[1,2]]}}"#.to_vec(), "parts"),
+    ] {
+        match decode_retire_obligation(&retire_key(RetireMode::Bytes, &part_token()), &value) {
+            Err(RecordError::RetireTokenSuffixMismatch {
+                payload,
+                token_names_part,
+            }) => {
+                assert_eq!(payload, shape);
+                assert!(token_names_part);
+            }
+            other => panic!("expected RetireTokenSuffixMismatch for {shape}, got {other:?}"),
+        }
+        // The same payload under the session-wide token is exactly what the fence installs.
+        assert!(
+            decode_retire_obligation(&retire_key(RetireMode::Bytes, &session_token()), &value)
+                .is_ok()
+        );
+    }
+}
+
+/// **Leg 1h (BINDING), the per-part obligation under a session-wide token** — a `Chunks`
+/// obligation is a re-uploaded part's superseded chunks or a losing writer's compensation, so
+/// its token must name the part attempt it compensates; filed session-wide it names an
+/// attempt nothing can attribute.
+#[test]
+fn per_part_obligation_is_rejected_under_a_session_wide_token() {
+    let value = format!(
+        "{{\"Chunks\":{{\"chunks\":[{}]}}}}",
+        chunk_json(r#""None""#)
+    );
+    match decode_retire_obligation(
+        &retire_key(RetireMode::Bytes, &session_token()),
+        value.as_bytes(),
+    ) {
+        Err(RecordError::RetireTokenSuffixMismatch {
+            payload,
+            token_names_part,
+        }) => {
+            assert_eq!(payload, "chunks");
+            assert!(!token_names_part);
+        }
+        other => panic!("expected RetireTokenSuffixMismatch, got {other:?}"),
+    }
+    assert!(decode_retire_obligation(
+        &retire_key(RetireMode::Bytes, &part_token()),
+        value.as_bytes()
+    )
+    .is_ok());
+}
+
+/// **Leg 1h (BINDING), a `Records` obligation under a per-part token** — `retire:records:` is
+/// written by a publication or a `Completing` rollback (`0016:356`, `:662-665`), both
+/// session-wide, so a per-part token misfiles it exactly as it does the other two
+/// whole-session shapes. This case is the one the archived attempt's broken arm accepted.
+#[test]
+fn records_obligation_is_rejected_under_a_per_part_token() {
+    let value = br#"{"Records":{"parts":[[3,3]]}}"#;
+    match decode_retire_obligation(&retire_key(RetireMode::Records, &part_token()), value) {
+        Err(RecordError::RetireTokenSuffixMismatch {
+            payload,
+            token_names_part,
+        }) => {
+            assert_eq!(payload, "records");
+            assert!(token_names_part);
+        }
+        other => panic!("expected RetireTokenSuffixMismatch, got {other:?}"),
+    }
+    assert!(
+        decode_retire_obligation(&retire_key(RetireMode::Records, &session_token()), value).is_ok()
+    );
+}
+
+/// **Leg 1n (BINDING)** — a `Generation` obligation naming **both** a chunk source and a
+/// segment source is a structural contradiction (a drain that picked one arm would evidence
+/// half the payload and then delete the obligation), and one naming **neither** owes nothing
+/// at all. A generation payload is defined over its reclamation evidence (`0016:355`).
+#[test]
+fn generation_obligation_names_exactly_one_source() {
+    let nonce = "ab".repeat(16);
+    let both = format!(
+        "{{\"Generation\":{{\"inode\":{INODE},\"version\":{VERSION},\"chunks\":[{}],\"segments\":{{\"nonce\":\"{nonce}\",\"epoch\":{EPOCH}}}}}}}",
+        chunk_json(r#""None""#)
+    );
+    let key = retire_key(RetireMode::Bytes, &generation_token(INODE, VERSION));
+    assert!(matches!(
+        decode_retire_obligation(&key, both.as_bytes()),
+        Err(RecordError::RetireGenerationSourcesConflict { chunks: 1 })
+    ));
+    let neither = format!("{{\"Generation\":{{\"inode\":{INODE},\"version\":{VERSION}}}}}");
+    assert!(matches!(
+        decode_retire_obligation(&key, neither.as_bytes()),
+        Err(RecordError::RetireObligationOwesNothing {
+            payload: "generation"
+        })
+    ));
+}
+
+/// **Leg 1p (BINDING)** — a payload carrying a structurally invalid nested `ChunkRef` is
+/// rejected on the same `erasure::supported(k, m)` rule as leg 1i, in the `Chunks` arm **and**
+/// in the `Generation` arm. A retirement payload's chunk list is precisely the untrusted
+/// stored geometry a drain fans its orphan marks out over.
+#[test]
+fn retire_payload_nested_chunk_scheme_must_be_supported() {
+    let bad = chunk_json(r#"{"ReedSolomon":{"k":0,"m":1}}"#);
+    let chunks = format!("{{\"Chunks\":{{\"chunks\":[{bad}]}}}}");
+    assert!(matches!(
+        decode_retire_obligation(
+            &retire_key(RetireMode::Bytes, &part_token()),
+            chunks.as_bytes()
+        ),
+        Err(RecordError::ChunkSchemeUnsupported { k: 0, m: 1, .. })
+    ));
+    let generation = format!(
+        "{{\"Generation\":{{\"inode\":{INODE},\"version\":{VERSION},\"chunks\":[{bad}]}}}}"
+    );
+    assert!(matches!(
+        decode_retire_obligation(
+            &retire_key(RetireMode::Bytes, &generation_token(INODE, VERSION)),
+            generation.as_bytes()
+        ),
+        Err(RecordError::ChunkSchemeUnsupported { k: 0, m: 1, .. })
+    ));
+}
+
+// ===========================================================================
+// The remaining record rules — evidence beyond the eleven demonstrations.
+// ===========================================================================
+
+/// The mode lives in the key (`0016:434-440`): a record-mode payload under `retire:bytes:`
+/// would orphan-mark bytes a live object still names, and a byte-mode payload under
+/// `retire:records:` would delete the only records naming durable bytes.
+#[test]
+fn retire_payload_mode_must_agree_with_its_key() {
+    match decode_retire_obligation(
+        &retire_key(RetireMode::Bytes, &session_token()),
+        br#"{"Records":{"parts":[[3,3]]}}"#,
+    ) {
+        Err(RecordError::RetireModeMismatch {
+            key_mode,
+            payload_mode,
+        }) => assert_eq!(
+            (key_mode, payload_mode),
+            (RetireMode::Bytes, RetireMode::Records)
+        ),
+        other => panic!("expected RetireModeMismatch, got {other:?}"),
+    }
+    match decode_retire_obligation(
+        &retire_key(RetireMode::Records, &session_token()),
+        br#"{"Session":{}}"#,
+    ) {
+        Err(RecordError::RetireModeMismatch {
+            key_mode,
+            payload_mode,
+        }) => assert_eq!(
+            (key_mode, payload_mode),
+            (RetireMode::Records, RetireMode::Bytes)
+        ),
+        other => panic!("expected RetireModeMismatch, got {other:?}"),
+    }
+}
+
+/// An obligation that owes nothing is a producer bug, and admitting it would let that bug
+/// look like completed work. `Session {}` is the one payload that legitimately names nothing:
+/// its part list is enumerated at drain time from the fenced `part:<id>:` range.
+#[test]
+fn an_obligation_that_owes_nothing_is_refused() {
+    let session_key = retire_key(RetireMode::Bytes, &session_token());
+    let part_key = retire_key(RetireMode::Bytes, &part_token());
+    let records_key = retire_key(RetireMode::Records, &session_token());
+    assert!(matches!(
+        decode_retire_obligation(&session_key, br#"{"Parts":{"parts":[]}}"#),
+        Err(RecordError::RetireObligationOwesNothing { payload: "parts" })
+    ));
+    assert!(matches!(
+        decode_retire_obligation(&part_key, br#"{"Chunks":{"chunks":[]}}"#),
+        Err(RecordError::RetireObligationOwesNothing { payload: "chunks" })
+    ));
+    assert!(matches!(
+        decode_retire_obligation(&records_key, br#"{"Records":{}}"#),
+        Err(RecordError::RetireObligationOwesNothing { payload: "records" })
+    ));
+    assert!(matches!(
+        decode_retire_obligation(&records_key, br#"{"Records":{"parts":[]}}"#),
+        Err(RecordError::RetireObligationOwesNothing { payload: "records" })
+    ));
+    assert!(decode_retire_obligation(&session_key, br#"{"Session":{}}"#).is_ok());
+}
+
+/// …and "owes nothing" is judged over the payload as a **whole**, never per field: a
+/// `Records` obligation carrying an explicitly empty part set beside a `seg:` generation
+/// still owes that generation's records (`0016:356`), so it decodes.
+///
+/// Rejecting it would strand the obligation: its record is installed atomically with the
+/// batch that superseded those records, and a drain that cannot decode it can neither act on
+/// it nor delete it — the dangling segments would be owed forever, by a key nothing can read
+/// back. The empty part set is a producer wart; the segments are real work.
+#[test]
+fn a_records_obligation_owing_only_segments_decodes() {
+    let nonce = "cd".repeat(16);
+    let value = format!(
+        "{{\"Records\":{{\"parts\":[],\"segments\":{{\"nonce\":\"{nonce}\",\"epoch\":{EPOCH}}}}}}}"
+    );
+    let payload = decode_retire_both(RetireMode::Records, &session_token(), value.as_bytes())
+        .expect("a records obligation that owes its segments decodes");
+    let RetirePayload::Records { parts, segments } = payload else {
+        panic!("expected Records, got {payload:?}");
+    };
+    assert!(parts
+        .expect("the empty part set survives the round trip")
+        .is_empty());
+    assert_eq!(
+        segments,
+        Some(SegmentGroup::new(nonce, EPOCH).expect("a 32-hex-character nonce"))
+    );
+}
+
+/// The same structural rules are reachable by a **writer**. A [`RetirePayload`]'s variants are
+/// constructible — the store round trips (#656–#659) must build one to store it — so decode is
+/// the boundary, and the check that boundary applies is public: a writer refuses its own
+/// malformed payload before making it durable, the way `InodeRecord::checked_for_publication`
+/// serves the commit path. Without it a producer could store an obligation its own drain would
+/// then refuse to decode forever.
+#[test]
+fn a_writer_can_check_its_own_payload_before_storing_it() {
+    assert!(matches!(
+        RetirePayload::Parts {
+            parts: PartNumberSet::default(),
+        }
+        .checked_shape(),
+        Err(RecordError::RetireObligationOwesNothing { payload: "parts" })
+    ));
+    assert!(RetirePayload::Parts {
+        parts: PartNumberSet::from_numbers([part(1), part(2)]),
+    }
+    .checked_shape()
+    .is_ok());
+}
+
+/// Every wire shape this child lands is **closed**, one level down included: an unknown field
+/// is a decode error, never a field dropped on the way in and missing from the re-encode a
+/// drain or a lease renewal stores.
+///
+/// The shared [`PendingEntry`] is closed too, and that is the load-bearing one: its CAS
+/// preconditions on the **raw bytes read** and puts a freshly encoded entry (`renew_pending`,
+/// `metadata.rs:2085-2090`), so an accepted-but-unknown field is not a `Conflict` the way it
+/// would be on the `inode:` path — it is a durable field deletion no error reports. Missing
+/// fields still decode: that is what keeps every legacy record readable.
+#[test]
+fn an_unknown_field_is_refused() {
+    assert!(decode_retire_obligation(
+        &retire_key(RetireMode::Bytes, &session_token()),
+        br#"{"Parts":{"parts":[[1,2]],"extra":1}}"#
+    )
+    .is_err());
+    assert!(
+        metadata::decode::<StagedPlacement>(br#"{"scheme":"None","placement":[3],"x":1}"#).is_err()
+    );
+    // The shared record, under a `pending:` reading — the live path, where a dropped field
+    // would be CAS'd away in silence.
+    assert!(
+        metadata::decode::<PendingEntry>(br#"{"lease_expiry_millis":9000,"future":1}"#).is_err(),
+        "an unknown field on a pending: value must not decode: renewal would delete it"
+    );
+    // …and under a `sidx:` reading, through the key-taking decoder.
+    let extra = format!(
+        "{{\"lease_expiry_millis\":{LEASE},\"owner\":\"{}\",\"staged\":{STAGED_JSON},\"x\":1}}",
+        hex32(OWNER_HEX)
+    );
+    assert!(matches!(
+        decode_owned_entry(&owned_key(OWNER_HEX), extra.as_bytes()),
+        Err(RecordError::MalformedRecordValue {
+            namespace: "sidx:",
+            ..
+        })
+    ));
+}
+
+/// The part-number set's own encoding rules: in-range, non-reversed, coalesced and strictly
+/// ascending runs — one spelling per set, so a `require_absent` guard and an ascending drain
+/// cursor can both be trusted.
+#[test]
+fn part_number_set_encoding_is_canonical() {
+    assert!(matches!(
+        PartNumberSet::from_runs(vec![(4, 2)]),
+        Err(RecordError::PartNumberRunReversed { lo: 4, hi: 2 })
+    ));
+    assert!(matches!(
+        PartNumberSet::from_runs(vec![(1, 3), (4, 5)]),
+        Err(RecordError::PartNumberRunsNotCoalesced {
+            lo: 4,
+            previous_hi: 3
+        })
+    ));
+    assert!(matches!(
+        PartNumberSet::from_runs(vec![(3, 4), (1, 2)]),
+        Err(RecordError::PartNumberRunsNotCoalesced { lo: 1, .. })
+    ));
+    assert!(matches!(
+        PartNumberSet::from_runs(vec![(0, 2)]),
+        Err(RecordError::PartNumberOutOfRange { part_number: 0 })
+    ));
+    // …and the rules hold through the record that carries the set.
+    assert!(decode_retire_obligation(
+        &retire_key(RetireMode::Bytes, &session_token()),
+        br#"{"Parts":{"parts":[[2,1]]}}"#
+    )
+    .is_err());
+}
+
+/// The canonical-bytes gate both key-taking decoders close with: a foreign spelling of an
+/// accepted value — fields reordered, whitespace inserted — is refused, because a lease
+/// renewal puts a freshly encoded entry under a precondition on the **raw bytes it read**
+/// (`renew_pending`, `metadata.rs:2085-2090`) and a drain CASes the obligation it read: a
+/// second spelling of one value is bytes such a put would rewrite without conflicting.
+#[test]
+fn a_foreign_spelling_of_an_accepted_value_is_refused() {
+    let reordered = format!(
+        "{{\"owner\":\"{}\",\"lease_expiry_millis\":{LEASE},\"staged\":{STAGED_JSON}}}",
+        hex32(OWNER_HEX)
+    );
+    assert!(matches!(
+        decode_owned_entry(&owned_key(OWNER_HEX), reordered.as_bytes()),
+        Err(RecordError::NoncanonicalRecordValue { namespace: "sidx:" })
+    ));
+    assert!(matches!(
+        decode_retire_obligation(
+            &retire_key(RetireMode::Bytes, &session_token()),
+            br#"{"Session": {}}"#
+        ),
+        Err(RecordError::NoncanonicalRecordValue {
+            namespace: "retire:"
+        })
+    ));
+}
+
+/// A key neither decoder can parse is a [`RecordError::MalformedKey`] before the value is
+/// even read — the fail-closed half of taking the key (`0016:438-440`).
+#[test]
+fn a_key_that_does_not_parse_is_refused_before_the_value() {
+    assert!(matches!(
+        decode_owned_entry(b"pending:77", &owned_json(OWNER_HEX, STAGED_JSON)),
+        Err(RecordError::MalformedKey {
+            namespace: "sidx:",
+            ..
+        })
+    ));
+    assert!(matches!(
+        decode_retire_obligation(b"retire:bytes:", br#"{"Session":{}}"#),
+        Err(RecordError::MalformedKey {
+            namespace: "retire:",
+            ..
+        })
+    ));
+}
