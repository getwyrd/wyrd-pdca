+        if !erasure::supported(k as usize, m as usize) {
+            return Err(RecordError::StagedSchemeUnsupported { k, m });
+        }
+    }
+    Ok(())
+}
+
+impl TryFrom<StagedPlacementWire> for StagedPlacement {
+    type Error = RecordError;
+
+    fn try_from(wire: StagedPlacementWire) -> Result<Self, RecordError> {
+        Self::new(wire.scheme.into(), wire.placement)
+    }
+}
+
+/// The wire shape of the `sidx:` value — [`crate::metadata::PendingEntry`]'s own fields, read
+/// here so [`decode_owned_entry`] can attribute each rule to its own [`RecordError`] variant
+/// instead of the `serde_json` string a `try_from` conversion funnels through
+/// [`crate::metadata::decode`] (the reason [`decode_admission_record`] reaches its own wire
+/// struct too). Only the *shape* is mirrored: the pairing rule is
+/// [`checked_ownership_pairing`] and the geometry rule is [`StagedPlacement`]'s own
+/// conversion, both **shared** with the record's own `Deserialize`, so the two seams cannot
+/// disagree about what they reject. Closed for the reason the shared record is
+/// (`PendingEntry`'s doc): an unknown field must be an error, not a field dropped on the way
+/// in and missing from the re-encode a renewal stores. The one remaining difference between
+/// the seams is that this decoder additionally demands the *canonical spelling*
+/// ([`require_canonical`]) — a reordered but otherwise equal value decodes through the shared
+/// record and is refused here.
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct OwnedEntryWire {
+    lease_expiry_millis: u64,
+    #[serde(default)]
+    owner: Option<UploadId>,
+    #[serde(default)]
+    staged: Option<StagedPlacementWire>,
+}
+
+/// The value under a `sidx:` key, with its two owned fields present **by type** rather than
+/// by convention (`0016:353`, `:442-457`).
+///
+/// 0016 makes that value *be* a [`crate::metadata::PendingEntry`] rather than a parallel
+/// type, so the same half-TTL renewal loop and the same lease guards serve an owned entry and
+/// an ordinary one; `owner`/`staged` are therefore `Option`s on the shared record, and this
+/// is the view in which they are not optional. The **legacy** shape (both absent) is refused
+/// here rather than trusted, since this type's whole contract is "this is an owned entry" —
+/// and a `sidx:` key that decoded an ordinary entry would attribute unowned residue to a
+/// session.
+///
+/// No writer-side constructor beyond [`Self::new`], which is total: the entry's own
+/// invariants are its components' ([`UploadId`], [`StagedPlacement`]) and its **key**
+/// agreement, which only [`decode_owned_entry`] can judge because only it holds the key.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct OwnedEntry {
+    owner: UploadId,
+    lease_expiry_millis: u64,
+    staged: StagedPlacement,
+}
+
+impl OwnedEntry {
+    /// The owned entry `write::intent` stages for one chunk. Total: both components are
+    /// already validated types, and the key agreement is [`decode_owned_entry`]'s.
+    pub const fn new(owner: UploadId, lease_expiry_millis: u64, staged: StagedPlacement) -> Self {
+        Self {
+            owner,
+            lease_expiry_millis,
+            staged,
+        }
+    }
+
+    /// The owning session.
+    pub const fn owner(&self) -> &UploadId {
+        &self.owner
+    }
+
+    /// When the lease expires (logical milliseconds).
+    pub const fn lease_expiry_millis(&self) -> u64 {
+        self.lease_expiry_millis
+    }
+
+    /// The chunk's planned EC placement.
+    pub const fn staged(&self) -> &StagedPlacement {
+        &self.staged
+    }
+
+    /// The shared-record form this entry is **stored** as — the value a `sidx:` put writes
+    /// and the half-TTL renewal loop re-encodes.
+    pub fn to_pending(&self) -> metadata::PendingEntry {
+        metadata::PendingEntry {
+            lease_expiry_millis: self.lease_expiry_millis,
+            owner: Some(self.owner.clone()),
+            staged: Some(self.staged.clone()),
+        }
+    }
+
+    /// The validating view of an already-decoded [`crate::metadata::PendingEntry`], for a
+    /// caller that read the shared record rather than the bytes (a reaper walking
+    /// `sidx:<upload-id>:`). An owned entry carries **both** optional fields — the pairing is
+    /// already enforced by the record's own decode — and an ordinary entry carries neither,
+    /// which is [`RecordError::NotAnOwnedEntry`] rather than a silently accepted value.
+    ///
+    /// It cannot check the key agreement (it has no key): a caller holding the bytes wants
+    /// [`decode_owned_entry`].
+    pub fn from_pending(entry: &metadata::PendingEntry) -> Result<Self, RecordError> {
+        checked_ownership_pairing(entry.owner.is_some(), entry.staged.is_some())?;
+        match (&entry.owner, &entry.staged) {
+            (Some(owner), Some(staged)) => Ok(Self {
+                owner: owner.clone(),
+                lease_expiry_millis: entry.lease_expiry_millis,
+                staged: staged.clone(),
+            }),
+            _ => Err(RecordError::NotAnOwnedEntry),
+        }
+    }
+}
+
+/// Decode a `sidx:` owned staging entry from **both halves of the record** — its key
+/// ([`sidx_key`]) and its value.
+///
+/// The cross-check the key is taken for: the entry's own `owner` must be the upload id the
+/// key names. A decode that cannot see the key cannot validate against it, and an entry
+/// attributed to the wrong session is staged data renewed — or reclaimed — under the wrong
+/// identity, through a per-session range (`sidx:<upload-id>:`) that is the *only* way any
+/// pass enumerates owned entries (`0016:475-491`).
+///
+/// Its other rejections are the shared record's own, reached through this module's wire shape
+/// so each arrives as its own variant: a torn pairing (`checked_ownership_pairing`), an
+/// ordinary `pending:` entry read under an owned key, and a staged geometry the erasure coder
+/// would refuse ([`StagedPlacement`]). It closes with the canonical-bytes gate every decoder
+/// in this module closes with (`require_canonical`): an owned entry is stored as the shared
+/// record, and the lease CAS that renewal shape uses preconditions on the **raw bytes read**
+/// and puts a freshly encoded entry (`renew_pending`, `crates/core/src/metadata.rs:2085-2090`
+/// — `pending:`-keyed today; the owned renewal is #657's), so a foreign spelling of an equal
+/// value is bytes such a put would silently rewrite rather than conflict on.
+pub fn decode_owned_entry(key: &[u8], value: &[u8]) -> Result<OwnedEntry, RecordError> {
+    let (key_owner, _part_number, _chunk_id) = parse_sidx_key(key)?;
+    let wire: OwnedEntryWire =
+        metadata::decode(value).map_err(|err| RecordError::MalformedRecordValue {
+            namespace: "sidx:",
+            detail: err.to_string(),
+        })?;
+    checked_ownership_pairing(wire.owner.is_some(), wire.staged.is_some())?;
+    let (Some(owner), Some(staged)) = (wire.owner, wire.staged) else {
+        return Err(RecordError::NotAnOwnedEntry);
+    };
+    // The value's own rules first, the key relation after — the order
+    // `decode_admission_record` and `decode_session_record` apply, so a torn value is
+    // attributed to the rule it broke rather than to the key it happens to sit under.
+    let staged = StagedPlacement::try_from(staged)?;
+    if owner != key_owner {
+        return Err(RecordError::OwnedEntryOwnerMismatch {
+            key_owner,
+            entry_owner: owner,
+        });
+    }
+    let entry = OwnedEntry::new(owner, wire.lease_expiry_millis, staged);
+    require_canonical(entry.to_pending(), value, "sidx:")?;
+    Ok(entry)
+}
+
+// ===========================================================================
+// 10. The retirement obligation — the `retire:<mode>:<token>` value (`0016:355-388`)
+// ===========================================================================
+
+/// A **range-encoded** part-number set (`0016:382-388`): `[[1, 400]]` for a contiguous run,
+/// so the common "every staged part was published" case is a few bytes and the worst case —
+/// alternating part numbers across the whole session — still fits inside one value.
+///
+/// The encoding is **canonical and validated at decode**: coalesced, strictly ascending,
+/// non-adjacent runs of in-range part numbers. A derived `Deserialize` would admit reversed,
+/// overlapping and out-of-range runs, and each is a live defect rather than an aesthetic one
+/// — a reversed run underflows [`Self::len`], an unordered one makes [`Self::iter`] and a
+/// drain cursor's resume query skip members, and a number past the key grammar names a
+/// `part:` record no parser can read back.
+#[derive(Debug, Clone, Default, PartialEq, Eq, Serialize)]
+#[serde(transparent)]
+pub struct PartNumberSet(Vec<(u32, u32)>);
+
+impl PartNumberSet {
+    /// The validating constructor every decode routes through — the one home of the
+    /// coalesced-ascending rule.
+    pub fn from_runs(runs: Vec<(u32, u32)>) -> Result<Self, RecordError> {
+        let mut previous_hi: Option<u32> = None;
+        for &(lo, hi) in &runs {
+            PartNumber::new(lo)?;
+            PartNumber::new(hi)?;
+            if lo > hi {
+                return Err(RecordError::PartNumberRunReversed { lo, hi });
+            }
+            if let Some(previous_hi) = previous_hi {
+                if lo <= previous_hi + 1 {
+                    return Err(RecordError::PartNumberRunsNotCoalesced { lo, previous_hi });
+                }
+            }
+            previous_hi = Some(hi);
+        }
+        Ok(Self(runs))
+    }
+
+    /// Build the set from any iterator of part numbers, coalescing contiguous runs — the
+    /// writer-side counterpart of [`Self::from_runs`], and total by construction: it can
+    /// only mint the canonical encoding its own decode accepts.
+    pub fn from_numbers(numbers: impl IntoIterator<Item = PartNumber>) -> Self {
+        let sorted: std::collections::BTreeSet<u32> =
+            numbers.into_iter().map(PartNumber::get).collect();
+        let mut runs: Vec<(u32, u32)> = Vec::new();
+        for number in sorted {
+            match runs.last_mut() {
+                Some(last) if last.1 + 1 == number => last.1 = number,
+                _ => runs.push((number, number)),
+            }
+        }
+        Self(runs)
+    }
+
+    /// Whether the set names no part.
+    pub fn is_empty(&self) -> bool {
+        self.0.is_empty()
+    }
+
+    /// How many part numbers the set holds. Total in `u64`: the runs are ascending and
+    /// in-range, so the sum cannot exceed [`MAX_PART_NUMBER`].
+    pub fn len(&self) -> u64 {
+        self.0
+            .iter()
+            .map(|(lo, hi)| u64::from(*hi) - u64::from(*lo) + 1)
+            .sum()
+    }
+
+    /// Every part number in the set, ascending.
+    pub fn iter(&self) -> impl Iterator<Item = u32> + '_ {
+        self.0.iter().flat_map(|(lo, hi)| *lo..=*hi)
+    }
+}
+
+impl<'de> Deserialize<'de> for PartNumberSet {
+    fn deserialize<D: Deserializer<'de>>(deserializer: D) -> Result<Self, D::Error> {
+        Self::from_runs(Vec::<(u32, u32)>::deserialize(deserializer)?).map_err(DeError::custom)
+    }
+}
+
+/// The wire shape of [`RetirePayload`] — closed (`deny_unknown_fields`) and reading its
+/// chunk lists through this module's own [`ChunkRefWire`], for the reasons that type records:
+/// an obligation is CAS'd whole by the drain that owns it (`0016:355`), so a field silently
+/// dropped or defaulted on the way in is a value whose re-encode is not the bytes read.
+///
+/// **Externally tagged** — serde's default, and load-bearing rather than a style choice: an
+/// internally tagged enum buffers its content before dispatching, and that buffer cannot
+/// carry the 128-bit [`wyrd_traits::ChunkId`] a [`crate::metadata::ChunkRef`] is keyed by.
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+enum RetirePayloadWire {
+    Session {},
+    Parts {
+        parts: PartNumberSet,
+    },
+    Chunks {
+        chunks: Vec<ChunkRefWire>,
+    },
+    Generation {
+        inode: InodeId,
+        version: u64,
+        #[serde(default)]
+        chunks: Vec<ChunkRefWire>,
+        #[serde(default)]
+        segments: Option<metadata::SegmentGroup>,
+    },
+    Records {
+        #[serde(default)]
+        parts: Option<PartNumberSet>,
+        #[serde(default)]
+        segments: Option<metadata::SegmentGroup>,
+    },
+}
+
+/// What one retirement obligation owes (`0016:355-356`). The **mode lives in the key**, not
+/// in a field, and so does the obligation's **identity** — which session or generation, and
+/// which part attempt — so a payload is cross-checked against its key at decode rather than
+/// trusted ([`decode_retire_obligation`]).
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(try_from = "RetirePayloadWire")]
+pub enum RetirePayload {
+    /// `retire:bytes:` — a **session teardown**: orphan-mark every part the session still
+    /// holds, then delete the `part:`/`psum:` pairs that name them.
+    ///
+    /// **It carries no part list, deliberately.** A list frozen by the aborting caller is
+    /// read *before* its fence lands, so a part commit that won the read-then-fence window
+    /// would be absent from it; the fence makes the session's own `part:<id>:` range
+    /// immutable, so the drain enumerates it at drain time from that bounded range.
+    Session {},
+    /// `retire:bytes:` — the staged parts a Complete did **not** name, frozen under the fence
+    /// that already holds the part set immutable.
+    Parts {
+        /// The unnamed staged parts.
+        parts: PartNumberSet,
+    },
+    /// `retire:bytes:` — a specific chunk list with no naming record left: a re-uploaded
+    /// part's superseded chunks, a losing writer's compensation, or a post-staging local
+    /// refusal. The **per-part** obligation, so its token carries the `:<part>:<attempt>`
+    /// suffix (`0016:358-366`).
+    Chunks {
+        /// The chunks to orphan-mark.
+        chunks: Vec<ChunkRef>,
+    },
+    /// `retire:bytes:` — a superseded or deleted object **generation**, which lives only
+    /// under a [`RetireToken::Generation`] naming the same `(inode, version)`.
+    Generation {
+        /// The inode the generation belonged to.
+        inode: InodeId,
+        /// Its version.
+        version: u64,
+        /// Its flat chunk list, when it had one.
+        #[serde(default, skip_serializing_if = "Vec::is_empty")]
+        chunks: Vec<ChunkRef>,
+        /// Its `seg:` generation, when it was segmented — resolved page-wise at drain time,
+        /// never frozen here.
+        #[serde(default, skip_serializing_if = "Option::is_none")]
+        segments: Option<metadata::SegmentGroup>,
+    },
+    /// `retire:records:` — records to delete whose bytes are protected by something else: the
+    /// **published** parts (never the unnamed ones, whose records ride their own
+    /// `retire:bytes:` obligation so marking always precedes deletion) and/or one rolled-back
+    /// `Completing` attempt's dangling segments (`0016:356`, `:662-665`).
+    Records {
+        /// The published parts whose records the publication superseded.
+        #[serde(default, skip_serializing_if = "Option::is_none")]
+        parts: Option<PartNumberSet>,
+        /// One attempt's dangling `seg:` generation.
+        #[serde(default, skip_serializing_if = "Option::is_none")]
+        segments: Option<metadata::SegmentGroup>,
+    },
+}
+
+impl RetirePayload {
+    /// The payload shape's name, for the rejections that report which shape was found.
+    const fn shape(&self) -> &'static str {
+        match self {
+            Self::Session {} => "session",
+            Self::Parts { .. } => "parts",
+            Self::Chunks { .. } => "chunks",
+            Self::Generation { .. } => "generation",
+            Self::Records { .. } => "records",
+        }
+    }
+
+    /// The mode this payload may live under — the cross-check that makes "the mode lives in
+    /// the key" a checked boundary rather than a convention (`0016:434-440`).
+    pub const fn mode(&self) -> RetireMode {
+        match self {
+            Self::Records { .. } => RetireMode::Records,
+            Self::Session {}
+            | Self::Parts { .. }
+            | Self::Chunks { .. }
+            | Self::Generation { .. } => RetireMode::Bytes,
+        }
+    }
+
+    /// The **structural** rules a payload must satisfy to be actionable at all, checked at
+    /// decode rather than discovered by a drain that owes nothing:
+    ///
+    /// * every nested [`crate::metadata::ChunkRef`]'s stored `EcScheme` is one the erasure
+    ///   coder can encode/decode — the same rule a `part:` record's chunks pass
+    ///   ([`checked_chunk_scheme`]), applied to the `Chunks` **and** `Generation` arms,
+    ///   because an obligation's chunk list is exactly the untrusted stored geometry the
+    ///   drain fans its orphan marks out over;
+    /// * a `Generation` names **either** a flat chunk list **or** a `seg:` generation, never
+    ///   both (a drain that picked one arm would evidence half the payload and then delete
+    ///   the obligation) and never neither (a superseded generation always owed the bytes it
+    ///   held);
+    /// * a payload that owes **nothing at all** is a producer bug that admitting would let
+    ///   look like completed work. Emptiness is judged over the payload as a **whole**, never
+    ///   per field: a `Records` obligation carrying an explicitly empty part set beside a
+    ///   `seg:` generation still owes that generation's records (`0016:356`), and refusing it
+    ///   would strand an obligation no drain could read back, act on, or clear.
+    ///
+    /// `Session {}` is the one payload that legitimately names nothing — see its doc.
+    ///
+    /// Public so a **writer** can refuse its own malformed payload before making it durable,
+    /// the way [`crate::metadata::InodeRecord::checked_for_publication`] serves the commit
+    /// path: the variants are constructible (the write paths of #656–#659 must build them),
+    /// so decode is the boundary and this is the check that boundary applies.
+    pub fn checked_shape(&self) -> Result<(), RecordError> {
+        let owes_nothing = || RecordError::RetireObligationOwesNothing {
+            payload: self.shape(),
+        };
+        match self {
+            Self::Session {} => Ok(()),
+            Self::Parts { parts } if parts.is_empty() => Err(owes_nothing()),
+            Self::Parts { .. } => Ok(()),
+            Self::Chunks { chunks } if chunks.is_empty() => Err(owes_nothing()),
+            Self::Chunks { chunks } => chunks.iter().try_for_each(checked_chunk_scheme),
+            Self::Generation {
+                chunks, segments, ..
+            } => {
+                chunks.iter().try_for_each(checked_chunk_scheme)?;
+                if !chunks.is_empty() && segments.is_some() {
+                    return Err(RecordError::RetireGenerationSourcesConflict {
+                        chunks: chunks.len(),
+                    });
+                }
+                if chunks.is_empty() && segments.is_none() {
+                    return Err(owes_nothing());
+                }
+                Ok(())
+            }
+            Self::Records { parts, segments } => {
+                let owes_parts = parts.as_ref().is_some_and(|parts| !parts.is_empty());
+                if owes_parts || segments.is_some() {
+                    Ok(())
+                } else {
+                    Err(owes_nothing())
+                }
+            }
+        }
+    }
+
+    /// The payload's **identity** rules against the token its key names — the checks a decode
+    /// that could not see the key could not make:
+    ///
+    /// * **scope**: a `Generation` payload lives only under a [`RetireToken::Generation`]
+    ///   naming the *same* `(inode, version)`, and every other shape is session-scoped and
+    ///   lives only under a [`RetireToken::Session`]. Either mismatch would let a drain
+    ///   reclaim one identity's data while clearing another identity's obligation;
+    /// * **part scope**: the session token's optional `:<part-number>:<attempt-id>` suffix
+    ///   (`0016:357-366`) is present for the **per-part** obligations and absent for the
+    ///   whole-session ones. `Chunks` is the per-part shape (a re-uploaded part's superseded
+    ///   chunks, a losing writer's compensation); `Session` and `Parts` are installed by a
+    ///   fence over the whole session, and `Records` by a publication or a `Completing`
+    ///   rollback (`0016:356`, `:662-665`). A whole-session obligation filed under one part's
+    ///   token would be cleared by that part's drain and never enumerated by the session's
+    ///   own emptiness gate; a per-part obligation filed session-wide names an attempt
+    ///   nothing can attribute.
+    fn checked_against_token(&self, token: &RetireToken) -> Result<(), RecordError> {
+        let scope_mismatch = |token: &'static str| RecordError::RetireTokenScopeMismatch {
+            token,
+            payload: self.shape(),
+        };
+        let part = match (token, self) {
+            (
+                RetireToken::Generation { inode, version },
+                Self::Generation {
+                    inode: payload_inode,
+                    version: payload_version,
+                    ..
+                },
+            ) => {
+                if payload_inode != inode || payload_version != version {
+                    return Err(RecordError::RetireGenerationIdentityMismatch {
+                        key_inode: *inode,
+                        key_version: *version,
+                        payload_inode: *payload_inode,
+                        payload_version: *payload_version,
+                    });
+                }
+                return Ok(());
+            }
+            (RetireToken::Generation { .. }, _) => return Err(scope_mismatch("g:")),
+            (RetireToken::Session { .. }, Self::Generation { .. }) => {
+                return Err(scope_mismatch("s:"))
+            }
+            (RetireToken::Session { part, .. }, _) => part,
+        };
+        let suffix_mismatch = || RecordError::RetireTokenSuffixMismatch {
+            payload: self.shape(),
+            token_names_part: part.is_some(),
+        };
+        match (self, part) {
+            // Whole-session obligations: installed once per session (or per fence), so a
+            // per-part token would misfile them.
+            (Self::Session {}, Some(_)) => Err(suffix_mismatch()),
+            (Self::Parts { .. }, Some(_)) => Err(suffix_mismatch()),
+            (Self::Records { .. }, Some(_)) => Err(suffix_mismatch()),
+            // The per-part obligation: the suffix is what names the attempt it compensates.
+            (Self::Chunks { .. }, None) => Err(suffix_mismatch()),
+            _ => Ok(()),
+        }
+    }
+}
+
+impl TryFrom<RetirePayloadWire> for RetirePayload {
+    type Error = RecordError;
+
+    fn try_from(wire: RetirePayloadWire) -> Result<Self, RecordError> {
+        let payload = match wire {
+            RetirePayloadWire::Session {} => Self::Session {},
+            RetirePayloadWire::Parts { parts } => Self::Parts { parts },
+            RetirePayloadWire::Chunks { chunks } => Self::Chunks {
+                chunks: chunks.into_iter().map(ChunkRef::from).collect(),
+            },
+            RetirePayloadWire::Generation {
+                inode,
+                version,
+                chunks,
+                segments,
+            } => Self::Generation {
+                inode,
+                version,
+                chunks: chunks.into_iter().map(ChunkRef::from).collect(),
+                segments,
+            },
+            RetirePayloadWire::Records { parts, segments } => Self::Records { parts, segments },
+        };
+        payload.checked_shape()?;
+        Ok(payload)
+    }
+}
+
+/// Decode a retirement obligation from **both halves of the record** — its key
+/// ([`retire_key`]) and its value — returning the token the key names and the payload the
+/// value carries.
+///
+/// The key is taken because three of this record class's rules are relations between the two
+/// halves, and a decode that cannot see the key cannot check any of them:
+///
+/// 1. the **mode** cross-check — `retire:bytes:` orphan-marks fragments and
+///    `retire:records:` must never orphan anything, so a payload under the wrong prefix is an
+///    error (`0016:434-440`);
+/// 2. the **scope** cross-check — a generation payload belongs to a `g:` token naming the
+///    same `(inode, version)`, every other shape to an `s:` token;
+/// 3. the **part-scope** cross-check — the session token's optional
+///    `:<part-number>:<attempt-id>` suffix (`0016:357-366`) is present exactly for the
+///    per-part obligation shape.
+///
+/// The value's own rules (a payload that owes nothing, a generation naming both or neither
+/// source, an unsupported nested chunk geometry) are `RetirePayload::checked_shape`'s and
+/// hold wherever the value is decoded; this entry point adds the key and the canonical-bytes
+/// gate (`require_canonical`) that every decoder in this module closes with.
+pub fn decode_retire_obligation(
+    key: &[u8],
+    value: &[u8],
+) -> Result<(RetireToken, RetirePayload), RecordError> {
+    let (mode, token) = parse_retire_key(key)?;
+    let wire: RetirePayloadWire =
+        metadata::decode(value).map_err(|err| RecordError::MalformedRecordValue {
+            namespace: "retire:",
+            detail: err.to_string(),
+        })?;
+    let payload = RetirePayload::try_from(wire)?;
+    let payload_mode = payload.mode();
+    if payload_mode != mode {
+        return Err(RecordError::RetireModeMismatch {
+            key_mode: mode,
+            payload_mode,
+        });
+    }
+    payload.checked_against_token(&token)?;
+    Ok((token, require_canonical(payload, value, "retire:")?))
+}
