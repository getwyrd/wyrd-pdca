+fn invalid_bucket_name(request_id: RequestId) -> Response {
+    error_response(
+        request_id,
+        StatusCode::BAD_REQUEST,
+        "InvalidBucketName",
+        "the specified bucket is not valid: a bucket name cannot contain `/`",
+    )
