+const WIDE_SERVER_BASE: DServerId = u64::MAX - WIDE_SERVERS;
+/// Where its chunk-id sequence starts, so every chunk id renders 19 digits.
+const WIDE_CHUNK_BASE: u64 = 1_000_000_000_000_000_000;
