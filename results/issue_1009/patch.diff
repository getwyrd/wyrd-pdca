+    let len = u64::from(MAX_PART_CHUNKS) * CHUNK as u64;
+    let record = format!(
+        "{{\"chunks\":[{}],\"len\":{len},\"digest\":\"{digest}\",\
+         \"committed_at_millis\":{COMMITTED_AT},\"session_epoch\":0}}",
+        chunks.join(",")
