+/// Serve an object `GET`, honouring the `Range` header (206 partial content, 416 unsatisfiable)
+/// and the `If-Match`/`If-None-Match`/`If-Modified-Since`/`If-Unmodified-Since` preconditions
+/// (304/412) — issue #510. The precondition and range gates run BEFORE any body work, off a
+/// metadata-only [`ObjectGateway::head_object`] resolve (no chunk read), so a 304/412/416 costs no
+/// data read and a satisfiable ranged read fetches only the covering chunks (never the whole
+/// object, then discarded wire-side). A plain GET — no conditional and no honoured range — keeps
+/// the original single-lookup streaming path, now advertising `Accept-Ranges: bytes`.
+async fn serve_get<G>(
+    state: &AppState<G>,
+    headers: &axum::http::HeaderMap,
+    object_key: &str,
+    request_id: RequestId,
+) -> Response
+where
+    G: ObjectGateway,
+{
+    let cond = Conditionals::from_headers(headers);
+    // A multi-range, non-`bytes`, or syntactically malformed `Range` parses to `None` and is
+    // IGNORED — S3 serves the full 200 for anything it cannot honour (brief out-of-scope:
+    // multi-range and malformed values answer the full 200 exactly as real S3 does).
+    let range = headers
+        .get("range")
+        .and_then(|v| v.to_str().ok())
+        .and_then(parse_range);
+
+    if !cond.is_present() && range.is_none() {
+        // Hot path — a plain GET: one streaming lookup, unchanged but for `Accept-Ranges`.
+        return match Arc::clone(&state.gateway)
+            .get_object_streaming(object_key)
+            .await
+        {
+            Ok(Some(read)) => full_object_response(read),
+            Ok(None) => no_such_key(request_id),
+            Err(err) => gateway_error_response(request_id, &err),
+        };
+    }
+
+    // A conditional or a range is in play: resolve the metadata FIRST (cheap — a metadata-only
+    // `head_object`, no chunk read, no reader task), run the gates, then do the minimal body
+    // work the surviving request needs.
+    let meta = match state.gateway.head_object(object_key).await {
+        Ok(Some(meta)) => meta,
+        Ok(None) => return no_such_key(request_id),
+        Err(err) => return gateway_error_response(request_id, &err),
+    };
+
+    // Conditionals first (RFC 9110 §13.2.2 precedence, S3 comparison semantics — see
+    // `evaluate_conditionals`). A 304/412 answers with no body read at all.
+    if let Some(outcome) = evaluate_conditionals(&cond, meta.etag.as_deref(), meta.modified) {
+        return match outcome {
+            Precondition::NotModified => not_modified_response(meta.etag.as_deref(), meta.modified),
+            Precondition::Failed => precondition_failed(request_id),
+        };
+    }
+
+    // Then range resolution.
+    let Some(spec) = range else {
+        // A conditional passed and there is no range: serve the full object (200). This costs a
+        // second lookup (the `head_object` above plus the stream), which only a conditional GET
+        // that PASSES pays — the plain-GET hot path above never reaches here.
+        return match Arc::clone(&state.gateway)
+            .get_object_streaming(object_key)
+            .await
+        {
+            Ok(Some(read)) => full_object_response(read),
+            Ok(None) => no_such_key(request_id),
+            Err(err) => gateway_error_response(request_id, &err),
+        };
+    };
+    match resolve_range(&spec, meta.size) {
+        ResolvedRange::Unsatisfiable => range_not_satisfiable(request_id, meta.size),
+        ResolvedRange::Satisfiable { offset, len } => {
+            match Arc::clone(&state.gateway)
+                .get_object_range(object_key, offset, len)
+                .await
+            {
+                Ok(Some(stream)) => partial_content_response(&meta, offset, len, stream),
+                // The object vanished between the `head_object` resolve and the ranged read (a
+                // raced DELETE/overwrite): answer `NoSuchKey`, exactly as the streaming path does.
+                Ok(None) => no_such_key(request_id),
+                Err(err) => gateway_error_response(request_id, &err),
+            }
+        }
+    }
+}
