+/// The `404 NoSuchKey` an absent object answers with, shared by the GET/HEAD paths.
+fn no_such_key(request_id: RequestId) -> Response {
+    error_response(
+        request_id,
+        StatusCode::NOT_FOUND,
+        "NoSuchKey",
+        "the specified key does not exist",
+    )
+}
