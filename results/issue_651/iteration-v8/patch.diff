+            verdict.lines.len(),
+            1,
+            "no findings, no paragraphs: {printed}"
+        );
+    }
+
+    /// A large damaged range must not bury the summary: the names are capped inline, the
+    /// remainder is counted, and NOTHING is silently dropped — the count is the operator's
+    /// signal that the audit log holds the rest.
+    #[test]
+    fn a_flood_of_unreadable_objects_is_capped_inline_and_the_rest_counted() {
+        let report = RestoreReport {
+            unresolvable: (0..NAMED_UNREADABLE_OBJECTS + 3)
+                .map(|i| format!("inode:{i}"))
+                .collect(),
+            ..Default::default()
+        };
+        let printed = restore_verdict(&report).lines.join("\n");
+        assert!(
+            printed.contains(&format!("inode:{}", NAMED_UNREADABLE_OBJECTS - 1)),
+            "the first {NAMED_UNREADABLE_OBJECTS} are named inline: {printed}"
+        );
+        assert!(
+            !printed.contains(&format!("inode:{NAMED_UNREADABLE_OBJECTS}")),
+            "...and the cap holds: {printed}"
+        );
+        assert!(
+            printed.contains("and 3 more"),
+            "the remainder must be counted, not dropped: {printed}"
+        );
+    }
 }
