+        ));
+        // A segment index the root's table does not name at all.
+        assert!(matches!(
+            chunk_map_error(repoint_chunk(
+                1,
+                &root,
+                &home_of(seg_key(&group, 5).unwrap(), 0),
+                vec![0, 1, 3]
+            )),
