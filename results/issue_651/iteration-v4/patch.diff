+                // ceiling discipline — `commit_chunk_map` puts a map of any size, and redb,
+                // TiKV and etcd store it — so an already-oversize root exists on stores that
+                // were never on the tightest backend. Charging the ceiling absolutely would
+                // refuse to repair such an object AT ALL, including the shrinking move that
+                // is the only direction which can ever fix it.
+                let oversize = InodeRecord {
+                    chunk_map: ChunkMap::Flat(
+                        std::iter::once(rs_chunk_at(vec![u64::MAX, u64::MAX - 1, u64::MAX - 2]))
