+    #[test]
+    fn a_repoint_is_charged_on_growth_and_refused_at_the_value_ceiling() {
+        // A root just inside the ceiling, moved onto WIDER server ids: the rewrite grows it
+        // past `MAX_VALUE_BYTES`, and a record over the ceiling is one no compare-and-swap
+        // could ever overwrite again — so it is refused before anything is written.
+        let wide: Vec<DServerId> = vec![u64::MAX, u64::MAX - 1, u64::MAX - 2];
+        let narrow = vec![0, 1, 2];
+        let mut chunks = vec![rs_chunk_at(narrow.clone())];
+        let growth = 3 * ("18446744073709551615".len() - "0".len());
+        loop {
+            let root = InodeRecord {
+                chunk_map: ChunkMap::Flat(chunks.clone()),
+                ..flat_root(narrow.clone())
+            };
+            let size = encode(&root).len();
+            if size + growth > MAX_VALUE_BYTES {
+                assert!(size <= MAX_VALUE_BYTES, "the fixture root starts LEGAL");
+                let err = chunk_map_error(repoint_chunk(
+                    1,
+                    &generation(&root),
+                    &ChunkHome::Root { position: 0 },
+                    wide,
+                ));
+                assert!(
+                    matches!(err, ChunkMapError::ValueOverCeiling { ceiling, bytes, .. }
+                             if ceiling == MAX_VALUE_BYTES && bytes > MAX_VALUE_BYTES),
+                    "the refusal names the ceiling it crossed: {err:?}"
+                );
+                // ...and the same record still accepts a move that does NOT grow it, so the
+                // check is charged on growth rather than refusing every repair of a big root.
+                let same_width = repoint_chunk(
+                    1,
+                    &generation(&root),
+                    &ChunkHome::Root { position: 0 },
+                    vec![2, 1, 0],
