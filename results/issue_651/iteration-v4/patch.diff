+    // ---- the repoint compare-and-swap (issue #651, proposal 0016 decision 7(f)) ----
+
+    /// A flat root carrying one RS(2,1) chunk (three fragments) at `placement`.
+    fn flat_root(placement: Vec<DServerId>) -> InodeRecord {
+        InodeRecord {
+            size: 5,
+            chunk_map: ChunkMap::Flat(vec![ChunkRef {
+                id: 0xC0,
+                scheme: EcScheme::ReedSolomon { k: 2, m: 1 },
+                len: 5,
+                placement,
+            }]),
+            state: InodeState::Committed,
+            version: 3,
+            ..Default::default()
+        }
+    }
+
+    /// A segmented root naming one segment of `group`, and that segment's record + home.
+    fn segmented_home(group: &SegmentGroup, chunk: ChunkRef) -> (InodeRecord, ChunkHome) {
+        let record = SegmentRecord::new(vec![chunk], 0).unwrap();
+        let map = SegmentedMap::new(
+            group.clone(),
+            vec![SegmentRef {
+                index: 0,
+                byte_offset: 0,
+                byte_len: record.byte_len(),
+            }],
+        )
+        .unwrap();
+        let root = InodeRecord {
+            size: map.span(),
+            chunk_map: ChunkMap::Segmented(map),
+            state: InodeState::Committed,
+            version: 3,
+            ..Default::default()
+        };
+        let home = ChunkHome::Segment {
+            segment: Arc::new(SegmentHome {
+                key: seg_key(group, 0).unwrap(),
+                prior: encode(&record),
+            }),
+            position: 0,
+        };
+        (root, home)
+    }
+
+    fn rs_chunk_at(placement: Vec<DServerId>) -> ChunkRef {
+        ChunkRef {
+            id: 0xC0,
+            scheme: EcScheme::ReedSolomon { k: 2, m: 1 },
+            len: 5,
+            placement,
+        }
+    }
+
+    /// `record` as a resolve would hand it to a repoint: decoded from bytes, carrying them.
+    fn generation(record: &InodeRecord) -> RootGeneration {
+        RootGeneration::decode(encode(record)).expect("a root this module encoded decodes")
+    }
+
+    #[test]
+    fn a_repoint_refuses_a_placement_that_is_not_the_chunks_own_width() {
+        // Maintenance writes are strict (ADR-0040 decisions 3-4): a short or long vector
+        // committed here is the malformed placement every other pass then refuses to act on.
+        let mut record = SegmentRecord::new(vec![rs_chunk_at(vec![0, 1, 2])], 0).unwrap();
+        assert_eq!(
+            record.repoint(0, vec![7, 8]),
+            Err(ChunkMapError::RepointPlacementMalformed {
+                position: 0,
+                expected: 3,
+                actual: 2,
+            })
+        );
+        assert_eq!(
+            record.chunks()[0].placement,
+            vec![0, 1, 2],
+            "a refused repoint leaves the record untouched"
+        );
