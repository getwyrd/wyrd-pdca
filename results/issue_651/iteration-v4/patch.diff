+    #[test]
+    fn a_segmented_repoint_cas_names_the_segment_and_pins_the_root() {
+        let group = SegmentGroup::new(NONCE, 1).unwrap();
+        let (root, home) = segmented_home(&group, rs_chunk_at(vec![0, 1, 2]));
+        let batch =
+            repoint_chunk(1, &generation(&root), &home, vec![0, 1, 3]).expect("a well-formed move");
+        let seg = seg_key(&group, 0).unwrap();
+        // BOTH preconditions: the segment's exact prior bytes AND the root that names this
+        // generation — the second is what makes the move lose to a concurrent supersede
+        // instead of writing into a record no consumer will ever read (`0016:354`).
+        assert_eq!(batch.preconditions.len(), 2);
+        assert_eq!(batch.preconditions[0].key, seg);
+        assert_eq!(batch.preconditions[1].key, inode_key(1));
+        assert_eq!(
