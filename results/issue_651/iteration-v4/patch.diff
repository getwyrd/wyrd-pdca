+        // precondition would hold too — the repair would report `Committed` into a record
+        // nothing reads.
+        let stale = SegmentGroup::new(NONCE, 2).unwrap();
+        assert!(matches!(
+            chunk_map_error(repoint_chunk(
+                1,
+                &root,
+                &home_of(seg_key(&stale, 0).unwrap(), 0),
+                vec![0, 1, 3]
+            )),
