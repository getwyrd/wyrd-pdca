+        assert_eq!(record.chunks()[0].placement, vec![7, 8, 9]);
+        // ...and the chunk's identity, framing and extent are carried over, never respelled.
+        assert_eq!(record.chunks()[0].id, 0xC0);
+        assert_eq!(record.chunks()[0].len, 5);
+    }
