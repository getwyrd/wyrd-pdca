@@ -1714,6 +1719,208 @@ async fn prop_gc_over_a_segmented_map_never_reclaims_it_and_never_over_certifies
     }
 }
 
+// ---- property 11: a segmented REPOINT versus a concurrent SUPERSEDE (issue #651,
+//      proposal 0016 decision 7(f), the `0016:354` writer rule) ----
+//
+// A maintenance repoint of a segmented map rewrites the chunk's `seg:` record, not the
+// root — so its `require(seg == prior)` says nothing about whether that generation is still
+// the live one. The rule is that it pins BOTH: `require(inode == prior_root)` as well, so a
+// repoint racing a publication LOSES instead of writing into a retired record no consumer
+// will ever read and reporting the repair done. Seeded over both arms, since it is a race.
+//
+// Shipped in THIS slice and exercised by the gating `cargo xtask ci` / `dst` tier over the
+// whole madsim seed sweep — deliberately NOT by the per-fix `C4-verify` check, which would
+// have to build the `--cfg madsim` tree and sweep 50 seeds to see it. Built and run this
+// cycle; not deferred work.
+
+/// A store that supersedes the root in the window between a pass's **resolve** and its
+/// **repoint commit**: the scripted flip is applied immediately before the first commit that
+/// compare-and-swaps a `seg:` record, exactly as a racing publication would have left it.
+///
+/// The race is *driven*, not simulated — the production repoint decides the outcome.
+struct SupersedeMidRepoint {
+    inner: MemMeta,
+    pending: Mutex<Option<WriteBatch>>,
+}
+
+#[async_trait]
+impl MetadataStore for SupersedeMidRepoint {
+    async fn get(&self, key: &[u8]) -> Result<Option<Bytes>> {
+        self.inner.get(key).await
+    }
+
+    async fn scan(&self, prefix: &[u8]) -> Result<Vec<(Vec<u8>, Bytes)>> {
+        self.inner.scan(prefix).await
+    }
+
+    async fn scan_page(
+        &self,
+        prefix: &[u8],
+        after: Option<&[u8]>,
+        limit: usize,
+    ) -> Result<wyrd_traits::ScanPage> {
+        self.inner.scan_page(prefix, after, limit).await
+    }
+
+    async fn commit(&self, batch: WriteBatch) -> Result<CommitOutcome> {
+        let flip = if batch
+            .preconditions
+            .iter()
+            .any(|pre| pre.key.starts_with(b"seg:"))
+        {
+            // Taken and the guard dropped BEFORE the await: a lock held across one would make
+            // this future non-`Send`, which the trait's boxed signature refuses.
+            self.pending.lock().unwrap().take()
+        } else {
+            None
+        };
+        if let Some(flip) = flip {
+            assert_eq!(
+                self.inner.commit(flip).await.unwrap(),
+                CommitOutcome::Committed
+            );
+        }
+        self.inner.commit(batch).await
+    }
+}
+
+async fn prop_segmented_repoint_loses_to_a_concurrent_supersede(rng: &mut ChaCha8Rng) {
+    let d = servers();
+    let fleet = fleet_of(&d);
+    let meta = MemMeta::default();
+    let data: Vec<u8> = (0..32u16).map(|i| i as u8).collect();
+    let group = seed_segmented(&meta, &fleet, &data).await;
+    let root_key = metadata::inode_key(INODE);
+    let seeded: Vec<Bytes> = {
+        let mut rows = Vec::new();
+        for index in 0..2 {
+            rows.push(
+                meta.get(&seg_row(&group, index))
+                    .await
+                    .unwrap()
+                    .expect("the seeded generation's segment records are present"),
+            );
+        }
+        rows
+    };
+
+    // The operator drains server 0 — where the seeded generation's fragments resolve — so the
+    // rebalance pass has a genuine evacuation to repoint.
+    wyrd_custodian::set_lifecycle(&meta, 0, wyrd_custodian::DServerLifecycle::Draining)
+        .await
+        .unwrap();
+
+    // The seed picks the arm: on half of them a publication retires the generation inside the
+    // repoint's own window.
+    let raced = rng.next_u32().is_multiple_of(2);
+    let mut flip = WriteBatch::new();
+    let mut superseding = None;
+    if raced {
+        let mut next = 0x2000u128;
+        let plan = write::plan_write(&data, 4, EcScheme::None, || {
+            next += 1;
+            next
+        })
+        .unwrap();
+        write::write_fragments(&fleet, &plan).await.unwrap();
+        let new_root = InodeRecord {
+            size: plan.size,
+            chunk_map: plan.chunk_refs().into(),
+            state: InodeState::Committed,
+            version: 2,
+            ..Default::default()
+        };
+        flip = flip.put(root_key.clone(), metadata::encode(&new_root));
+        superseding = Some(plan);
+    }
+
+    let store = SupersedeMidRepoint {
+        inner: meta,
+        pending: Mutex::new(Some(flip)),
+    };
+    let coord = MemCoordination::new();
+    let (zone, custodian) = elect(&coord, "zone-repoint-supersede").await;
+    let dyn_fleet: [(DServerId, &dyn ChunkStore); 4] =
+        [(0, &d[0]), (1, &d[1]), (2, &d[2]), (3, &d[3])];
+    let topology = four_domains();
+    let ctx = wyrd_custodian::RebalanceContext {
+        meta: &store,
+        fleet: &dyn_fleet,
+        topology: &topology,
+    };
+    reconcile_step(&zone, &custodian, None, None, None, Some(&ctx), 4_000)
+        .await
+        .expect("a repoint that loses its race is a conflict, never an error that ends the pass");
+
+    let live = read_inode(&store).await;
+    if let Some(plan) = superseding {
+        // The publication won: the live generation is the one it installed, untouched by a
+        // repoint that resolved the generation before it.
+        assert_eq!(
+            live.chunk_map.as_flat().unwrap(),
+            plan.chunk_refs().as_slice(),
+            "the supersede stands: a repoint may not overwrite the generation that replaced \
+             the one it planned against"
+        );
+        // ...and the RETIRED generation's records are byte-identical. Rewriting one would be
+        // a repair reported `Committed` into a record no consumer will ever read — the repair
+        // silently lost, which is what pinning the root in the same batch prevents.
+        for (index, before) in seeded.iter().enumerate() {
+            assert_eq!(
+                store
+                    .get(&seg_row(&group, index as u32))
+                    .await
+                    .unwrap()
+                    .as_ref(),
+                Some(before),
+                "segment {index} of the retired generation must be byte-identical after a \
+                 repoint that lost its race"
+            );
+        }
+        return;
+    }
+
+    // Unraced: the repoint WINS. The drain converges over repeated passes — every chunk of a
+    // segment shares that record, so the second one in a pass loses its compare-and-swap and
+    // is retried, exactly as two chunks of one flat root always have.
+    for _ in 0..16 {
+        if reconcile_step(&zone, &custodian, None, None, None, Some(&ctx), 4_000)
+            .await
+            .expect("a drain pass over a segmented object never ends in an error")
+            == Reconciled::Satisfied
+        {
+            break;
+        }
+    }
+    let moved = metadata::resolve_current_chunk_map(&store, &root_key)
+        .await
+        .expect("the segmented generation still resolves")
+        .expect("the object is live");
+    assert!(
+        moved
+            .chunks
+            .iter()
+            .all(|chunk| chunk.fragments().all(|(_, dserver)| dserver != 0)),
+        "with no race the evacuation lands: no chunk of the segmented object may still resolve \
+         onto the draining server"
+    );
+    let mut rewritten = false;
+    for (index, before) in seeded.iter().enumerate() {
+        let now = store.get(&seg_row(&group, index as u32)).await.unwrap();
+        rewritten |= now.as_ref() != Some(before);
+    }
+    assert!(
+        rewritten,
+        "the repoint rewrote the `seg:` record that carries the moved chunk — so the losing \
+         arm's byte-identity is a real loss, not a pass that never repointed"
+    );
+    assert_eq!(
+        read_inode(&store).await.version,
+        live.version,
+        "a segmented repoint pins the root but does not rewrite it: its version does not move"
+    );
+}
