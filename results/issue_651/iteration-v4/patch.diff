+/// Parse the inode id out of an `inode:<id>` key — the **exact** inverse of
+/// [`inode_key`]: `None` for every spelling `inode_key` would not have produced.
+///
+/// The id is CANONICAL decimal ([`parse_canonical_u64`]), not `u64::from_str`, for the
+/// reason [`parse_seg_key`]'s epoch is: `from_str` accepts `+7` and `007`, so one record
+/// could be addressed by keys that differ in bytes but agree in value. That is not a
+/// cosmetic difference here — every mutation this module builds names the key it
+/// *re-renders* from the parsed id (`require(inode_key(id), …)`), so a caller that
+/// accepted `inode:007` would plan against the record it read and then compare-and-swap a
+/// **different**, usually absent, key: a repair that reports success while rewriting
+/// nothing, or one that writes a second record for an object that already has one.
+/// Refusing here leaves such a key for its caller to CONTAIN (`custodian::resolve`) — the
+/// one answer that neither rewrites it nor pretends the record is not there.
+pub fn parse_inode_key(key: &[u8]) -> Option<InodeId> {
+    parse_canonical_u64(std::str::from_utf8(key).ok()?.strip_prefix("inode:")?)
 }
 
