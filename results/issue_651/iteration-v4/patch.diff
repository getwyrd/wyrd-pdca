+        let group = SegmentGroup::new(NONCE, 1).unwrap();
+        let (seg_root, home) = segmented_home(&group, rs_chunk_at(vec![0, 1, 2]));
+        let stored_root = respelled(&seg_root);
+        let root = RootGeneration::decode(stored_root.clone()).expect("a decodable root");
+        let batch = repoint_chunk(1, &root, &home, vec![0, 1, 3]).expect("a well-formed move");
+        assert_eq!(
+            batch.preconditions[1].expected.as_deref(),
+            Some(&stored_root[..]),
+            "and so does the segmented arm, whose root is pinned but never rewritten"
+        );
+    }
+
+    #[test]
+    fn a_segmented_repoint_refuses_a_home_the_root_does_not_name() {
+        let group = SegmentGroup::new(NONCE, 1).unwrap();
+        let (root, _) = segmented_home(&group, rs_chunk_at(vec![0, 1, 2]));
+        let root = generation(&root);
