+        ));
+        // A position past the end of the record the home carries.
+        assert_eq!(
+            chunk_map_error(repoint_chunk(
+                1,
+                &root,
+                &home_of(seg_key(&group, 0).unwrap(), 4),
+                vec![0, 1, 3]
+            )),
+            ChunkMapError::ChunkPositionOutOfRange { position: 4 }
+        );
+    }
