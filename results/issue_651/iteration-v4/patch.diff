+/// The `seg:` record one segmented generation's chunks were resolved out of: its key and
+/// the **exact bytes** the resolve read.
+///
+/// Held behind one [`Arc`] per segment and shared by every chunk that segment carries — a
+/// segment holds many chunks, and a per-chunk copy of its bytes would make resolving an
+/// object quadratic in the very shape segmentation exists to make cheap.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct SegmentHome {
+    key: Vec<u8>,
+    prior: Bytes,
+}
+
+impl SegmentHome {
+    /// The record's key, `seg:<nonce>:<epoch>:<index>`.
+    pub fn key(&self) -> &[u8] {
+        &self.key
+    }
+
+    /// The exact bytes the resolve read — the value a repoint's `require(key, …)`
+    /// precondition names, never a re-encoding of the decoded record.
+    pub fn prior(&self) -> &Bytes {
+        &self.prior
+    }
+}
+
+/// Which record carries a resolved chunk's [`ChunkRef`] — the record a maintenance
+/// **repoint** must compare-and-swap (proposal 0016 decision 7(f)).
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum ChunkHome {
+    /// A flat map's chunk: the inode root itself, at this position in its chunk list.
+    Root {
+        /// The chunk's index in the root's chunk list.
+        position: usize,
+    },
+    /// A segmented map's chunk: one `seg:` record, at this position in that record's own
+    /// chunk list — **not** the object-wide index, which is not where the bytes live.
+    Segment {
+        /// The `seg:` record that carries the chunk.
+        segment: Arc<SegmentHome>,
+        /// The chunk's index within that segment record.
+        position: usize,
+    },
+}
+
+/// One resolved chunk together with the record that carries it.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct HomedChunk {
+    /// The chunk itself, exactly as the record spells it.
+    pub chunk: ChunkRef,
+    /// The record a repoint of this chunk must compare-and-swap.
+    pub home: ChunkHome,
+}
+
+/// One root generation as a maintenance mutation must hold it: the decoded record **and
+/// the exact bytes it was decoded from**.
+///
+/// The two travel together, and only [`RootGeneration::decode`] builds one, because every
+/// compare-and-swap over a root is `require(inode:<id>, <its prior value>)` and the only
+/// value that is certainly the store's is the one that was **read**. Re-encoding the
+/// decoded record to rebuild that precondition would make each such mutation depend on
+/// decode→encode being byte-identical — the rubric's *Serialization identity* class — and
+/// the failure mode is silent rather than loud: an accepted alternate or forward-compatible
+/// encoding makes the CAS mismatch forever, so the repair reports a conflict every pass and
+/// the fragment never moves.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct RootGeneration {
+    record: InodeRecord,
+    prior: Bytes,
+}
+
+impl RootGeneration {
+    /// Decode a root record, keeping the bytes it came from. Failures are typed
+    /// ([`decode_root_record`]), so a maintenance consumer contains an unreadable record to
+    /// its own object instead of reading it as a store outage.
+    pub fn decode(prior: Bytes) -> std::result::Result<Self, ChunkMapError> {
+        Ok(Self {
+            record: decode_root_record(&prior)?,
+            prior,
+        })
+    }
+
+    /// The decoded record.
+    pub fn record(&self) -> &InodeRecord {
+        &self.record
+    }
+
+    /// The exact bytes it was decoded from — the value a mutation's `require(key, …)`
+    /// precondition names, never a re-encoding of [`Self::record`].
+    pub fn prior(&self) -> &Bytes {
+        &self.prior
+    }
+}
+
+/// A chunk map resolved for the passes that **move** fragments: the ordered chunks, each
+/// carrying its home, plus the root generation they came from.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct ResolvedChunkHomes {
+    /// The generation the homes were resolved from — the caller's own snapshot, or the
+    /// live root a retired resolution restarted onto — with the bytes it was read as. This
+    /// is the record a repoint must name in `require(inode:<id>, …)`; a repoint planned
+    /// against the caller's stale snapshot could only ever lose the CAS, which is a
+    /// maintenance pass that silently repairs nothing.
+    pub root: RootGeneration,
+    /// That generation's ordered chunks, each with the record that carries it.
+    pub chunks: Vec<HomedChunk>,
+}
+
+/// [`resolve_chunk_map`] for the passes that repair, evacuate or otherwise **move** a
+/// fragment: same resolution, same retirement arms, but each chunk carries the record its
+/// `ChunkRef` lives in, so the repoint compare-and-swaps *that* record
+/// ([`repoint_chunk`]) rather than assuming the root holds the chunk list.
+///
+/// `Ok(None)` means the object has no live committed generation (deleted, or retired to a
+/// state no longer `Committed`) — the same answer [`resolve_chunk_map`] gives, and the
+/// same one every consumer already reads as "no such object".
+pub async fn resolve_chunk_homes(
+    store: &dyn MetadataStore,
+    root_key: &[u8],
+    root: &RootGeneration,
+) -> Result<Option<ResolvedChunkHomes>> {
+    match homes_of(store, root_key, root.record()).await? {
+        Resolution::Answer(chunks) => {
+            return Ok(Some(ResolvedChunkHomes {
+                root: root.clone(),
+                chunks,
+            }))
+        }
+        Resolution::Gone => return Ok(None),
+        // Superseded mid-resolve: re-read the root and plan against the generation that
+        // replaced it — an overwrite is not a deletion (decision 7(h)).
+        Resolution::Superseded => {}
+    }
+    for _ in 0..MAX_RESOLVE_RESTARTS {
+        let Some(bytes) = store.get(root_key).await? else {
+            return Ok(None);
+        };
+        let current = RootGeneration::decode(bytes)?;
+        // The generation that replaced it is not necessarily one a mutation may be planned
+        // against: an object mid-publication (or mid-delete) has no *committed* map, and
+        // resolving one would hand a maintenance pass chunks no reader is entitled to see
+        // yet — chunks whose fragments it could then move, or whose repair it could drain.
+        // `None` is the same "no live committed generation" answer the caller's own scan
+        // filter gives, and it is what keeps this door as narrow as that one.
+        if current.record().state != InodeState::Committed {
+            return Ok(None);
+        }
+        match homes_of(store, root_key, current.record()).await? {
+            Resolution::Answer(chunks) => {
+                return Ok(Some(ResolvedChunkHomes {
+                    root: current,
+                    chunks,
+                }))
+            }
+            Resolution::Gone => return Ok(None),
+            Resolution::Superseded => {}
+        }
+    }
+    Err(ChunkMapError::MapResolutionUnstable {
+        attempts: MAX_RESOLVE_RESTARTS,
+    }
+    .into())
+}
+
+/// [`resolve_snapshot`] carrying homes: one generation's chunks, each paired with the
+/// record that holds it.
+async fn homes_of(
+    store: &dyn MetadataStore,
+    root_key: &[u8],
+    record: &InodeRecord,
+) -> Result<Resolution<Vec<HomedChunk>>> {
+    let map = match &record.chunk_map {
+        ChunkMap::Flat(chunks) => {
+            return Ok(Resolution::Answer(
+                chunks
+                    .iter()
+                    .enumerate()
+                    .map(|(position, chunk)| HomedChunk {
+                        chunk: chunk.clone(),
+                        home: ChunkHome::Root { position },
+                    })
+                    .collect(),
+            ))
+        }
+        ChunkMap::Segmented(map) => map,
+    };
+    let segments = match read_segments(store, root_key, map).await? {
+        Resolution::Answer(segments) => segments,
+        Resolution::Superseded => return Ok(Resolution::Superseded),
+        Resolution::Gone => return Ok(Resolution::Gone),
+    };
+    let group = map.group();
+    let mut homed = Vec::new();
+    for (index, (bytes, segment)) in segments {
+        // Keyed from the group and the row's own **parsed** index rather than kept from
+        // the scan, so a home carries the one canonical spelling of its key
+        // ([`parse_seg_key`] is strict, so the two agree) — the same key the repoint's
+        // precondition and put both name.
+        let home = Arc::new(SegmentHome {
+            key: seg_key(group, index)?,
+            prior: bytes,
+        });
+        for (position, chunk) in segment.into_chunks().into_iter().enumerate() {
+            homed.push(HomedChunk {
+                chunk,
+                home: ChunkHome::Segment {
+                    segment: Arc::clone(&home),
+                    position,
+                },
+            });
+        }
+    }
+    Ok(Resolution::Answer(homed))
+}
