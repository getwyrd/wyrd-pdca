@@ -0,0 +1,151 @@
+//! The **maintenance walk**: every committed object's chunk map, resolved once per pass,
+//! with one damaged object contained to itself (proposal 0016 decision 7(e)/7(f);
+//! `docs/principles.md` §5 C-1).
+//!
+//! The passes that repair, move or rewrite an object's chunks — reconstruction, rebalance,
+//! backfill, post-restore reconciliation — all need the same two things, and getting either
+//! wrong is a data-loss shape rather than an inconvenience:
+//!
+//! * **Resolve, don't peek.** A segmented object's chunks live in its own `seg:` records
+//!   ([`metadata::resolve_chunk_homes`]), so a pass reading the inline list off the root
+//!   sees an object that owns nothing — and then drains its repair obligations as
+//!   unreferenced, or rewrites a map it never read. Every walk here goes through the ONE
+//!   resolver every consumer shares, and carries each chunk's **home**: the record whose
+//!   compare-and-swap moves it.
+//! * **Resolve ONCE per object per pass.** The walk is built once and indexed by the
+//!   caller, so a queue of `Q` obligations over `N` objects costs `N` resolutions, not
+//!   `Q × N`. A repair loop whose cost is (obligations × objects) is an availability
+//!   failure the fleet inflicts on itself — correct, and unusable at fleet scale.
+//!
+//! **Containment is per object, and the walk goes on.** A record that will not decode, a
+//! generation the resolver cannot read on a root that still names it, or a committed record
+//! under a key no mutation could ever name, is recorded in
+//! [`MaintenanceWalk::unresolvable`] and the walk continues: every *other* object is still
+//! assessed, evacuated and filled. What the caller owes in exchange is honesty — an
+//! incomplete walk may not certify anything ([`Reconciled::Blocked`](crate::Reconciled)),
+//! and an obligation it could not place may not be retired. That is the containment shape
+//! this repo already uses for a record it cannot trust
+//! (`ReconciliationStatus::PendingMalformed`, `crate::desired_state`): attribute the
+//! blocker, name it, keep answering.
+//!
+//! A fault that is **not** one object's — a store access failing underneath the resolver,
+//! which the resolver itself does not describe as a chunk-map anomaly — still propagates:
+//! a walk that cannot read the metadata store has no picture at all, and containing that as
+//! "one object is unreadable" would be the wrong answer for every object in it.
+
+use std::collections::BTreeMap;
+
+use wyrd_core::metadata::{self, ChunkMapError, HomedChunk, InodeId, InodeState, RootGeneration};
+use wyrd_traits::{MetadataStore, Result};
+
+/// One committed object the walk **could** read: its id, the generation the chunks were
+/// resolved from, and those chunks with their homes.
+pub(crate) struct HomedObject {
+    /// The object's inode id, parsed from the **canonical** `inode:<id>` key
+    /// ([`metadata::parse_inode_key`]) — so the key every mutation re-renders from it is
+    /// byte-for-byte the key this record was read under.
+    pub inode_id: InodeId,
+    /// The generation the chunks came from, with the exact bytes it was read as — the
+    /// record a repoint must compare-and-swap against ([`metadata::repoint_chunk`]), which
+    /// is the **live** root when this object's generation was retired under the resolve,
+    /// not this scan's snapshot.
+    pub root: RootGeneration,
+    /// Its ordered chunks, each carrying the record that holds it.
+    pub chunks: Vec<HomedChunk>,
+}
+
+/// What one pass's walk over every committed object found.
+pub(crate) struct MaintenanceWalk {
+    /// The objects the walk read, in the store's own key order.
+    pub objects: Vec<HomedObject>,
+    /// The committed objects it could **not** read, keyed by the `inode:` key exactly as
+    /// the store spells it — **the raw bytes** — and valued by the fault that stopped it.
+    ///
+    /// Keyed by bytes rather than by a rendered name for the reason
+    /// [`crate::gc::ReferenceSet::unresolvable`] is: a rendering need not be injective, so
+    /// two damaged records could collapse into one entry and one of them would go
+    /// unreported. Named for the operator at the point of emission instead
+    /// ([`crate::gc::object_name`]).
+    ///
+    /// **While this is non-empty the walk is incomplete, and every consumer must say so in
+    /// its own answer**: neither "nothing left to do" nor "this chunk belongs to no object"
+    /// is a claim any of them can make about a store they could only partly read.
+    pub unresolvable: BTreeMap<Vec<u8>, String>,
+}
+
+/// Walk every **committed** object once, resolving each one's chunk map through the shared
+/// resolver ([`metadata::resolve_chunk_homes`]) and containing per object whatever it
+/// cannot read.
+///
+/// An object that is not committed contributes nothing and blocks nothing: it protects no
+/// bytes, carries no repair obligation and holds no drain back. An object whose *bytes*
+/// will not decode is contained rather than read as uncommitted — deciding "was it
+/// committed?" out of bytes that will not parse needs a lenient peek this loop owns no
+/// decoder for (the ADR-0010 seam boundary), and the other direction — assume uncommitted,
+/// carry on reclaiming — is the silent-corruption one. Same rule, same reason, as the
+/// reference build (`crate::gc::referenced_fragments`).
+pub(crate) async fn homed_objects(meta: &dyn MetadataStore) -> Result<MaintenanceWalk> {
+    let mut objects = Vec::new();
+    let mut unresolvable = BTreeMap::new();
+    for (key, value) in meta.scan(b"inode:").await? {
+        let root = match RootGeneration::decode(value) {
+            Ok(root) => root,
+            Err(fault) => {
+                unresolvable.insert(key.clone(), fault.to_string());
+                continue;
+            }
+        };
+        if root.record().state != InodeState::Committed {
+            continue;
+        }
+        // A COMMITTED record under a key this store's own grammar does not produce
+        // (`inode:007`, `inode:+7`, `inode:x`) is **contained**, never skipped. Skipping it
+        // is the silent-corruption direction: the object drops out of the walk entirely, so
+        // reconstruction reads its chunks as referenced by no committed map and drains
+        // their repair obligations, and every pass reports a store it never fully read as
+        // converged. It cannot be *acted on* either — every mutation names the key
+        // re-rendered from the parsed id ([`metadata::inode_key`]), which for these keys is
+        // a different, absent key — so the one honest answer is the same one an undecodable
+        // record gets: name it, keep walking, and let every consumer say its picture has a
+        // hole in it.
+        let Some(inode_id) = metadata::parse_inode_key(&key) else {
+            unresolvable.insert(
+                key.clone(),
+                "committed record under a non-canonical `inode:<id>` key: no maintenance \
+                 mutation can name this key, so the record can be neither repaired nor \
+                 rewritten until it is re-keyed"
+                    .to_string(),
+            );
+            continue;
+        };
+        // `Ok(None)` means no live committed generation is left under this key (deleted or
+        // retired since the scan read it): nothing to repair, move or fill, skipped exactly
+        // as an already-uncommitted record is above.
+        //
+        // The network bound on this await is the `MetadataStore` IMPLEMENTATION's, not this
+        // caller's (#508/#636, three times over) — the same rule the `meta.scan` above has
+        // always followed, and no await in any custodian loop carries a caller-side timeout.
+        match metadata::resolve_chunk_homes(meta, &key, &root).await {
+            Ok(Some(resolved)) => objects.push(HomedObject {
+                inode_id,
+                root: resolved.root,
+                chunks: resolved.chunks,
+            }),
+            Ok(None) => continue,
+            Err(err) => match err.downcast::<ChunkMapError>() {
+                // The resolver's own typed verdict that THIS generation cannot be read —
+                // recovered by downcast because the trait seam boxes every error. Contained.
+                Ok(fault) => {
+                    unresolvable.insert(key.clone(), fault.to_string());
+                }
+                // Not a chunk-map anomaly: a store fault under the read. Not this object's
+                // fault, so it is not folded into "this object is unreadable".
+                Err(err) => return Err(err),
+            },
+        }
+    }
+    Ok(MaintenanceWalk {
+        objects,
+        unresolvable,
+    })
+}
