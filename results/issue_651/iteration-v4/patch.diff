+/// **A repoint's resolve restarts onto the live generation — and only while it is
+/// COMMITTED.** [`resolve_chunk_homes`] is the maintenance-side twin of the read resolver:
+/// it answers the record a repair's compare-and-swap must name, so what it does with a
+/// generation retired under it decides whether a repair lands on the live object or writes
+/// into a record nothing reads. Two arms on the same interleaving, both restarts:
+///
+/// * the live root is **committed** — the resolve answers ITS chunks and ITS exact bytes,
+///   so the repair is planned against the generation that is actually live;
+/// * the live root is **not committed** (an object mid-publication) — the resolve answers
+///   "no live generation" rather than handing a maintenance pass chunks no reader may see
+///   yet, whose fragments it could then move and whose repair it could drain.
+#[tokio::test]
+async fn resolving_homes_restarts_onto_the_live_root_only_while_it_is_committed() {
+    let (chunks, _dir) = chunk_store();
+    let group = SegmentGroup::new(NONCE, EPOCH).unwrap();
+    let old_plan = fragments_for(&chunks, &payload(32, 11), 0xd00).await;
+    let new_plan = fragments_for(&chunks, &payload(20, 200), 0xe00).await;
+    let (first_row, _) = row(&group, 0, &split(&old_plan, 2).1[0]);
+
+    for (case, state, resolves) in [
+        ("committed", InodeState::Committed, true),
+        ("mid-publication", InodeState::Pending, false),
+    ] {
+        let store = FakeStore::default();
+        seed_segmented(&store, 1, &old_plan, &group, 2).await;
+        let held = store
+            .get(&inode_key(1))
+            .await
+            .unwrap()
+            .expect("the seeded root");
