+            Ok(())
+        );
+        assert_eq!(
+            check_value_ceiling(&key, &vec![b'x'; MAX_VALUE_BYTES + 1]),
+            Err(ChunkMapError::ValueOverCeiling {
+                key: String::from_utf8_lossy(&key).into_owned(),
+                bytes: MAX_VALUE_BYTES + 1,
+                ceiling: MAX_VALUE_BYTES,
+            })
+        );
+    }
