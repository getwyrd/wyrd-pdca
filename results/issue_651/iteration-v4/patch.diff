+
+    /// The same record in a spelling [`encode`] does not produce: the identical JSON object,
+    /// pretty-printed. This format accepts it, nothing forbids a writer — or a later version
+    /// of this encoder — from having produced it, and it is the one shape that tells a
+    /// precondition built from *read* bytes apart from one rebuilt with `encode`.
+    fn respelled(record: &InodeRecord) -> Bytes {
+        let value: serde_json::Value =
+            serde_json::from_slice(&encode(record)).expect("a record this module encoded");
+        Bytes::from(serde_json::to_vec_pretty(&value).expect("a value that just parsed"))
+    }
+
+    #[test]
+    fn a_repoint_pins_the_bytes_the_store_holds_not_a_re_encoding() {
+        // Both arms' ROOT precondition must name the bytes the resolve read. Rebuilt with
+        // `encode(prior)` it would name a value this store does not hold, and the failure is
+        // silent and permanent: the CAS mismatches on every pass, so the repair reports a
+        // conflict forever, the fragment never moves, and nothing anywhere says why.
+        let prior = flat_root(vec![0, 1, 2]);
