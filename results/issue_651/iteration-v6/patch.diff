+        meta: &meta,
+        fleet: &fleet,
+        grace_window_millis: 1_000,
+        expired_pending: ExpiredPendingPolicy::Reclaim,
+    };
+
+    let report = reconcile_after_restore(&ctx, NOW)
+        .await
+        .expect("one unreadable record must not blank the whole post-restore report");
+
+    assert_eq!(
+        report.unresolvable,
+        vec!["inode:2".to_owned()],
+        "the pass must NAME the record it could not read — by the `inode:` key as the store \
+         spells it, which is what an operator repairs. An unattributed refusal is a stall with \
+         no way out: {report:?}"
+    );
+    assert!(
+        !report.is_clean(),
+        "'clean' is a claim about a reading that FINISHED. The CLI exits on this, so certifying \
+         a partial reading tells a restore script the run was healthy: {report:?}"
+    );
+    assert_eq!(
+        report.stranded_marked, 0,
+        "the stray would be marked on a complete reference set — but an unreadable map hides \
+         WHICH chunks its object owns, so no fragment in the fleet can be shown not to be one \
+         of them. The containment is fleet-wide, not scoped to the damaged object: {report:?}"
+    );
+    assert!(
+        meta.get(&metadata::orphan_key(0, frag(7, 0)))
+            .await
+            .unwrap()
+            .is_none(),
+        "...and no `orphan:` record may be written for it either — that record IS the mark"
+    );
+    // The report over the objects it COULD read is still made: the healthy chunk is judged, and
+    // judged correctly. Blanking it over one damaged record was the defect.
+    assert!(
+        report.dangling.is_empty()
+            && report.misplaced.is_empty()
+            && report.under_replicated.is_empty(),
+        "{report:?}"
+    );
+}
