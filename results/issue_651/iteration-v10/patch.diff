+async fn one_object_s_healthy_copy_does_not_answer_for_another_object_s_missing_one() {
+    let meta = MemMeta::default();
+    let (d0, d1) = (MemDServer::default(), MemDServer::default());
+
+    // The same chunk id in two committed objects, each placing it on its own D server...
+    commit_single_chunk(&meta, 1, 61, 0).await;
+    commit_single_chunk(&meta, 2, 61, 1).await;
+    // ...and only one copy is actually there, at object 1's placement.
+    d0.put(frag(61, 0)).await;
+
+    let fleet: Vec<(DServerId, &dyn ChunkStore)> = vec![(0, &d0), (1, &d1)];
+    let ctx = GcContext {
+        meta: &meta,
+        fleet: &fleet,
+        grace_window_millis: 1_000,
+        expired_pending: ExpiredPendingPolicy::Reclaim,
+    };
+
+    let report = reconcile_after_restore(&ctx, NOW).await.unwrap();
+
+    assert_eq!(
+        report.dangling,
+        vec![61, 61],
+        "one entry per committed reference, and both are lost: neither object can claim the one \
+         surviving copy, since nothing on those bytes says which of the two wrote them. Reporting \
+         the copy as one claimant's evidence is the conflation this rule exists to refuse — and \
+         merging the two references into a single verdict would have exited 0 over an object \
+         nobody can read: {report:?}"
+    );
+    assert!(
+        report.misplaced.is_empty(),
+        "MISPLACED says the data is safe and the PLACEMENT is what needs fixing — it is the \
+         verdict a repair acts on, and the restage it invites would copy one object's fragment \
+         into the other's placement: same id, different data: {report:?}"
+    );
+    assert_eq!(
+        report.stranded_marked, 0,
+        "d0's fragment is referenced by object 1's placement; marking it would hand a live \
+         fragment to GC: {report:?}"
+    );
+    assert!(
+        !report.is_clean() && report.needs_human(),
+        "and the run is not a clean bill: the operator has to untangle the id (#652) before any \
+         of this can be judged: {report:?}"
+    );
+}
+
+/// A claimant whose own placement is **malformed** still claims the id.
+///
+/// The reference count that decides ambiguity is taken over every committed `ChunkRef` the walk
+/// reaches, BEFORE the fail-safe skip that drops a placement of the wrong length (ADR-0040
+/// decision 4) — because a placement that cannot be trusted cannot be trusted to say where its
+/// fragments are NOT. Counting after the skip would read this store as singly-claimed and hand
+/// the surviving copy to object 1 as `misplaced`: *"restage it onto d0"*, over bytes that may be
+/// the malformed object's.
+///
+/// The mark half needs no leg of its own here — `gc::ReferenceSet::protection` already treats
+/// every fragment of a malformed chunk as referenced, so nothing bearing this id is markable at
+/// all. This is the reporting side of that same refusal.
+#[tokio::test]
+async fn a_malformed_placement_still_claims_its_chunk_id() {
+    let meta = MemMeta::default();
+    let (d0, moved) = (MemDServer::default(), MemDServer::default());
+
+    // Object 1 places chunk 62 validly on d0; object 2 claims the same id under a placement of
+    // the wrong length for its scheme (k=1,m=1 needs 2 entries, this has 3) — malformed.
+    commit_single_chunk(&meta, 1, 62, 0).await;
+    commit_chunk(&meta, 2, 62, 1, 1, vec![0, 1, 0]).await;
+    // The only copy is on a server no VALID placement names — and which the malformed one might.
+    moved.put(frag(62, 0)).await;
+
+    let fleet: Vec<(DServerId, &dyn ChunkStore)> = vec![(0, &d0), (9, &moved)];
+    let ctx = GcContext {
+        meta: &meta,
+        fleet: &fleet,
+        grace_window_millis: 1_000,
+        expired_pending: ExpiredPendingPolicy::Reclaim,
+    };
+
+    let report = reconcile_after_restore(&ctx, NOW).await.unwrap();
+
+    assert_eq!(
+        (report.misplaced.as_slice(), report.dangling.as_slice()),
+        (&[][..], &[62][..]),
+        "object 1 has nothing at its own placement and cannot claim the one surviving copy — and \
+         MISPLACED, the verdict a repair acts on, would restage what may be the malformed \
+         object's only copy onto object 1's placement: {report:?}"
+    );
+}
