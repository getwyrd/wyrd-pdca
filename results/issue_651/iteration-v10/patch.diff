+    /// flip the status. One finding at a time, because a chain of `||`s is green for the wrong
+    /// reason whenever a sibling finding is also set — and "the exit code ignores this one class"
+    /// is exactly what a restore script would file as a healthy run.
+    ///
+    /// Pinned on the report alone: no backend, no fleet, no store.
+    #[test]
+    fn restore_needs_human_agrees_with_every_paragraph_it_prints() {
+        let dangling = RestoreReport {
+            dangling: vec![1],
+            ..Default::default()
+        };
+        let misplaced = RestoreReport {
+            misplaced: vec![2],
+            ..Default::default()
+        };
+        let unreadable = RestoreReport {
+            unresolvable: vec!["inode:7".to_owned()],
+            ..Default::default()
+        };
+        // ...and the findings that are NOT a human's: this pass marking strays is it doing its
+        // job, under-replication is the reconstruction loop's. Failing a restore script on either
+        // would train an operator to ignore the status. It is also what stops the rule above
+        // being satisfiable by failing every run.
+        let routine = RestoreReport {
+            stranded_marked: 4,
+            under_replicated: vec![3],
+            ..Default::default()
+        };
+        for (report, human) in [
+            (&dangling, true),
+            (&misplaced, true),
+            (&unreadable, true),
+            (&routine, false),
+        ] {
+            let verdict = restore_verdict(report);
+            let printed = verdict.lines.join("\n");
+            assert_eq!(
+                verdict.needs_human, human,
+                "exit status disagrees with the finding: {report:?} / {printed}"
+            );
+            assert_eq!(
+                printed.contains("NEEDS-HUMAN"),
+                human,
+                "a paragraph printed without the status behind it, or the reverse: {report:?} / \
+                 {printed}"
+            );
+            assert_eq!(
+                report.needs_human(),
+                verdict.needs_human,
+                "the command must exit on the REPORT's predicate, not a second one re-derived \
+                 here — a field added to one and not the other is how a loss stops reaching the \
+                 exit code: {report:?}"
+            );
+            // `is_clean` is the strict superset: nothing that needs a human is ever clean.
+            assert!(!(human && report.is_clean()), "{report:?}");
+            // "complete" is a claim about a reading that FINISHED, and an operator greps this
+            // line for exactly that word — so it appears iff nothing was unreadable, and the
+            // blocking record is NAMED where they read it rather than left to a log.
+            assert_eq!(
+                printed.contains("post-restore reconciliation complete"),
+                report.unresolvable.is_empty(),
+                "{printed}"
+            );
+            assert_eq!(
+                printed.contains("inode:7"),
+                !report.unresolvable.is_empty(),
+                "an unattributed refusal is a stall with no way out: {printed}"
+            );
+        }
+    }
+
+    /// A large damaged range must not bury the summary: the names are capped inline, the
+    /// remainder is counted, and NOTHING is silently dropped — the count is the operator's
+    /// signal that the audit log holds the rest.
+    #[test]
+    fn a_flood_of_unreadable_objects_is_capped_inline_and_the_rest_counted() {
+        let report = RestoreReport {
+            unresolvable: (0..NAMED_UNREADABLE_OBJECTS + 3)
+                .map(|i| format!("inode:{i}"))
+                .collect(),
+            ..Default::default()
+        };
+        let printed = restore_verdict(&report).lines.join("\n");
+        assert!(
+            printed.contains(&format!("inode:{}", NAMED_UNREADABLE_OBJECTS - 1)),
+            "the first {NAMED_UNREADABLE_OBJECTS} are named inline: {printed}"
+        );
+        assert!(
+            !printed.contains(&format!("inode:{NAMED_UNREADABLE_OBJECTS}")),
+            "...and the cap holds: {printed}"
+        );
+        assert!(
+            printed.contains("and 3 more"),
+            "the remainder must be counted, not dropped: {printed}"
+        );
+    }
+
+    /// Neither loss paragraph may assert a cause — or an instruction — this pass cannot stand
+    /// behind (#651).
+    ///
+    /// DANGLING: a chunk id more than one committed object claims lands there too, and *there* the
+    /// bytes may be present and restaging them actively harmful, so the text hedges the cause and
+    /// points at the audit event that tells the two apart. MISPLACED: a restore rewinds
+    /// `meta:next_inode`, so where chunk ids derive from the inode (`chunk_id_minter`) a fragment
+    /// bearing the id can belong to a file created *after* the restore point — one committed
+    /// claimant, so the pass cannot tell it from a displaced fragment and must not pretend to
+    /// (#652 removes the reuse; this says so out loud).
+    #[test]
+    fn the_loss_paragraphs_do_not_assert_causes_they_cannot_know() {
+        let printed = restore_verdict(&RestoreReport {
+            dangling: vec![1],
+            misplaced: vec![2],
+            ..Default::default()
+        })
+        .lines
+        .join("\n");
+        assert!(
+            printed.contains("ambiguous-chunk-id"),
+            "the operator must be told how to tell the two DANGLING causes apart, and where: \
+             {printed}"
+        );
+        assert!(
+            !printed.contains("Restoring past a delete resurrects"),
+            "the unconditional 'GC took the bytes, nothing can rebuild them' story is false for \
+             the ambiguous case, where the bytes are on disk: {printed}"
+        );
+        // ...and neither does the SUMMARY line, which is the one an operator (and a log collector)
+        // reads first. Hedging only the paragraph below it leaves the false cause printed anyway.
+        assert!(
+            !printed.contains("whose bytes were already reclaimed"),
+            "the summary line asserts the same cause the paragraph is careful not to: {printed}"
+        );
+        assert!(
+            printed.contains("#652"),
+            "and the restage MISPLACED asks for must name the one thing that makes it unsafe, \
+             plus the issue that removes it: {printed}"
+        );
+    }
+
+    /// The UNREADABLE paragraph must not assert a fleet-wide fact the report cannot carry.
+    /// `unresolvable` is the UNION of the reference build and the verdict walk, while marking is
+    /// gated on the build alone — so "nothing anywhere in the fleet was marked" is true only when
+    /// the run actually marked nothing, and must be DERIVED from that count rather than stated
+    /// (#651).
+    #[test]
+    fn the_unreadable_paragraph_derives_its_marking_claim_from_the_run() {
+        let quiet = RestoreReport {
+            unresolvable: vec!["inode:7".to_owned()],
+            ..Default::default()
+        };
+        let marked = RestoreReport {
+            stranded_marked: 3,
+            unresolvable: vec!["inode:7".to_owned()],
+            ..Default::default()
+        };
+        let quiet_printed = restore_verdict(&quiet).lines.join("\n");
+        assert!(
+            quiet_printed.contains("nothing anywhere in the fleet was"),
+            "with nothing marked, the containment IS fleet-wide and saying so is the operator's \
+             assurance that no stray was handed to GC: {quiet_printed}"
+        );
+        let marked_printed = restore_verdict(&marked).lines.join("\n");
+        assert!(
+            !marked_printed.contains("nothing anywhere in the fleet was"),
+            "printing 'nothing anywhere was marked' one line under a non-zero marked count is a \
+             contradiction the operator has to resolve for us: {marked_printed}"
+        );
+        assert!(
+            marked_printed.contains("Treat those marks as suspect"),
+            "...and the marks that DID land while a record was unreadable are exactly the ones an \
+             operator must re-check: {marked_printed}"
+        );
+    }
 }
