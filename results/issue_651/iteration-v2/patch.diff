+// ---- property 11: a repoint over a SEGMENTED map — it wins and the object still reads,
+//      or it loses to a supersede and strands nothing (issue #651, proposal 0016
+//      decision 7(f), `0016:669`) ----
+//
+// The destructive one: a repoint REWRITES a `seg:` record's `ChunkRef.placement` in place.
+// Both outcomes have to be safe, and the interleaving that decides which is a race — a
+// supersede advancing the inode inside the repoint's write→CAS window — so it is seeded, and
+// the arm is drawn from the run seed.
+//
+// Shipped in THIS slice and exercised by the gating `cargo xtask ci` / `dst` tier over the
+// whole madsim seed sweep — deliberately NOT by the per-fix `C4-verify` check, which would
+// have to build the `--cfg madsim` tree and sweep 50 seeds to see it.
+
+/// A store that lands a scripted supersede in the repoint's **write→CAS window**: the
+/// trigger is the destination **pre-mark** — the one commit a repoint makes between
+/// resolving the record it will CAS and issuing that CAS (a single `orphan:` put with no
+/// preconditions, `0016:354` writer (2), step (i)). Committing the flip there puts the
+/// supersede exactly where the race is, rather than wherever a timer happened to fall.
+struct SupersedeMidRepoint {
+    inner: MemMeta,
+    pending: Mutex<Option<WriteBatch>>,
+}
+
+impl SupersedeMidRepoint {
+    /// Whether `batch` is a repoint's destination pre-mark.
+    fn is_pre_mark(batch: &WriteBatch) -> bool {
+        batch.preconditions.is_empty()
+            && batch.deletes.is_empty()
+            && batch.puts.len() == 1
+            && batch.puts[0].0.starts_with(b"orphan:")
+    }
+}
+
+#[async_trait]
+impl MetadataStore for SupersedeMidRepoint {
+    async fn get(&self, key: &[u8]) -> Result<Option<Bytes>> {
+        self.inner.get(key).await
+    }
+
+    async fn scan(&self, prefix: &[u8]) -> Result<Vec<(Vec<u8>, Bytes)>> {
+        self.inner.scan(prefix).await
+    }
+
+    async fn scan_page(
+        &self,
+        prefix: &[u8],
+        after: Option<&[u8]>,
+        limit: usize,
+    ) -> Result<wyrd_traits::ScanPage> {
+        self.inner.scan_page(prefix, after, limit).await
+    }
+
+    async fn commit(&self, batch: WriteBatch) -> Result<CommitOutcome> {
+        let fire = Self::is_pre_mark(&batch);
+        let outcome = self.inner.commit(batch).await?;
+        if fire {
+            // Taken out of the lock before the await: a guard held across one would be a
+            // determinism hazard under the madsim scheduler.
+            let pending = self.pending.lock().unwrap().take();
+            if let Some(flip) = pending {
+                assert_eq!(
+                    self.inner.commit(flip).await.unwrap(),
+                    CommitOutcome::Committed,
+                    "the scripted supersede lands inside the repoint's write→CAS window"
+                );
+            }
+        }
+        Ok(outcome)
+    }
+}
+
+async fn prop_segmented_repoint_wins_or_loses_but_never_strands(rng: &mut ChaCha8Rng) {
+    let d = servers();
+    let fleet = fleet_of(&d);
+    let meta = MemMeta::default();
+    let data: Vec<u8> = (0..32u16).map(|i| i as u8).collect();
+    let group = seed_segmented(&meta, &fleet, &data).await;
+
+    // Every chunk of the seeded generation places its single fragment on server 0 (the
+    // identity placement of an `EcScheme::None` chunk), so draining server 0 makes EVERY
+    // chunk a candidate move — the repoint path is entered for real, over the `seg:` records
+    // that carry them.
+    let root_key = metadata::inode_key(INODE);
+    let seeded = live_fragments(&meta, &root_key)
+        .await
+        .expect("the seeded segmented generation resolves before any arm disturbs it");
+    assert!(
+        seeded.iter().all(|&(dserver, _)| dserver == 0),
+        "fixture: every fragment starts on the server this property drains"
+    );
+    let seg_before: Vec<Bytes> = vec![
+        meta.get(&seg_row(&group, 0)).await.unwrap().unwrap(),
+        meta.get(&seg_row(&group, 1)).await.unwrap().unwrap(),
+    ];
+    set_lifecycle(&meta, 0, DServerLifecycle::Draining)
+        .await
+        .unwrap();
+
+    // The seed picks the interleaving: does a supersede land inside the repoint's window?
+    let superseded = rng.next_u32().is_multiple_of(2);
+    let mut flip = WriteBatch::new();
+    let mut new_data = Vec::new();
+    if superseded {
+        // A fresh flat generation published over the segmented one — the root moves first
+        // (`0016:2452-2462`), exactly as a real supersede does.
+        new_data = (0..24usize).map(|_| rng.next_u32() as u8).collect();
+        let mut next = 0x2000u128;
+        let plan = write::plan_write(&new_data, 4, EcScheme::None, || {
+            next += 1;
+            next
+        })
+        .unwrap();
+        write::write_fragments(&fleet, &plan).await.unwrap();
+        let new_root = InodeRecord {
+            size: plan.size,
+            chunk_map: plan.chunk_refs().into(),
+            state: InodeState::Committed,
+            version: 2,
+            ..Default::default()
+        };
+        flip = flip.put(root_key.clone(), metadata::encode(&new_root));
+    }
+
+    // Everything on disk BEFORE the pass, so the assertion below can be about exactly what
+    // the repoint itself created: the copies it wrote at its destinations. Bytes an earlier
+    // generation left behind are the retirement drain's to evidence (#653), not this pass's.
+    let mut before: HashSet<(DServerId, FragmentId)> = HashSet::new();
+    for (id, server) in d.iter().enumerate() {
+        for frag in server.list_fragments().await.unwrap() {
+            before.insert((id as DServerId, frag));
+        }
+    }
+
+    let store = SupersedeMidRepoint {
+        inner: meta,
+        pending: Mutex::new(Some(flip)),
+    };
+    let coord = MemCoordination::new();
+    let (zone, custodian) = elect(&coord, "zone-repoint").await;
+    let dyn_fleet: [(DServerId, &dyn ChunkStore); 4] =
+        [(0, &d[0]), (1, &d[1]), (2, &d[2]), (3, &d[3])];
+    let topo = four_domains();
+    let ctx = RebalanceContext {
+        meta: &store,
+        fleet: &dyn_fleet,
+        topology: &topo,
+    };
+    // Reconciliation is a LOOP: several chunks share one `seg:` record, so the first repoint
+    // to land invalidates the others' preconditions and they lose their CAS — retried on the
+    // next pass, exactly as a racing writer's conflict is. Bounded, and the bound is asserted:
+    // a drain that cannot converge in a fixed number of passes is a defect, not patience.
+    let mut passes = 0usize;
+    loop {
+        passes += 1;
+        assert!(
+            passes <= 16,
+            "the drain must converge in a bounded number of passes"
+        );
+        let outcome = reconcile_step(&zone, &custodian, None, None, None, Some(&ctx), 5_000)
+            .await
+            .expect(
+                "a repoint over a segmented map is resolved or declined — never a pass-ending error",
+            );
+        if outcome == Reconciled::Satisfied {
+            break;
+        }
+    }
+
+    // Whatever happened, EVERY copy this pass wrote that the live map does not name must be
+    // reclaimable — it carries the pre-mark the repoint wrote before the bytes. That is the
+    // whole point of pre-marking: GC reclaims only on evidence, so an unevidenced,
+    // unreferenced copy is a permanent leak, and neither outcome of a repoint may leave one.
+    let live = live_fragments(&store.inner, &root_key)
+        .await
+        .expect("the live generation resolves after the pass");
+    let orphans: HashSet<Vec<u8>> = store
+        .inner
+        .scan(b"orphan:")
+        .await
+        .unwrap()
+        .into_iter()
+        .map(|(key, _)| key)
+        .collect();
+    let live_set: HashSet<(DServerId, FragmentId)> = live.iter().copied().collect();
+    let mut written_by_the_pass = 0usize;
+    for (id, server) in d.iter().enumerate() {
+        let dserver = id as DServerId;
+        for frag in server.list_fragments().await.unwrap() {
+            if before.contains(&(dserver, frag)) {
+                continue;
+            }
+            written_by_the_pass += 1;
+            if live_set.contains(&(dserver, frag)) {
+                assert!(
+                    !orphans.contains(&metadata::orphan_key(dserver, frag)),
+                    "a copy the live map NAMES must not be left carrying a grace record — \
+                     the winning CAS deletes the pre-mark it adopts (server {dserver}, \
+                     superseded {superseded})"
+                );
+                continue;
+            }
+            assert!(
+                orphans.contains(&metadata::orphan_key(dserver, frag)),
+                "a copy this pass wrote and nothing references must carry the evidence GC \
+                 needs to reclaim it — a repoint outcome that leaves one unevidenced is a \
+                 permanent leak (server {dserver}, superseded {superseded})"
+            );
+        }
+    }
+    assert!(
+        written_by_the_pass > 0,
+        "the pass must actually have copied fragments to their destinations, or the \
+         evidence assertions above are vacuous (superseded {superseded})"
+    );
+
+    if superseded {
+        // LOST: the retired generation's `seg:` records are byte-identical — a repoint that
+        // lost its CAS wrote nothing into a generation nothing live names any more — and the
+        // live (new) generation reads back whole.
+        for (index, before) in seg_before.iter().enumerate() {
+            assert_eq!(
+                store
+                    .inner
+                    .get(&seg_row(&group, index as u32))
+                    .await
+                    .unwrap()
+                    .unwrap(),
+                *before,
+                "a repoint racing a supersede must lose, never rewrite the retired \
+                 generation's segment {index}"
+            );
+        }
+        assert_eq!(
+            read_object(&store.inner, &fleet, INODE).await.unwrap(),
+            Some(new_data),
+            "the generation that won the root reads back whole"
+        );
+    } else {
+        // WON: the `seg:` records really were rewritten in place — the destructive path —
+        // every fragment moved off the draining server, and the object still reads.
+        let mut changed = 0usize;
+        for (index, before) in seg_before.iter().enumerate() {
+            if store
+                .inner
+                .get(&seg_row(&group, index as u32))
+                .await
+                .unwrap()
+                .unwrap()
+                != *before
+            {
+                changed += 1;
+            }
+        }
+        assert_eq!(
+            changed,
+            seg_before.len(),
+            "every segment record carrying a fragment on the draining server was repointed"
+        );
+        assert!(
+            live.iter().all(|&(dserver, _)| dserver != 0),
+            "the drain converged: no live fragment is left on the draining server"
+        );
+        assert_eq!(
+            read_object(&store.inner, &fleet, INODE).await.unwrap(),
+            Some(data),
+            "the object still reads whole after its segment records were rewritten in place"
+        );
+    }
+}
+
