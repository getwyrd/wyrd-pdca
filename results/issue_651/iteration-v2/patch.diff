+
+// ---- in-memory trait stores (the loops are proven over the seams, backend-agnostic) ----
+
+/// A trivial in-memory metadata store, plus the two counters criterion (4) is measured on:
+/// how many `inode:` scans a pass takes, and how many bounded `seg:` range reads it spends.
+/// Both are read back by the test — a *counted* number of resolutions, never the presence of
+/// a cache.
+#[derive(Default)]
+struct MemMeta {
+    kv: Mutex<std::collections::BTreeMap<Vec<u8>, Bytes>>,
+    inode_scans: AtomicUsize,
+    seg_range_reads: AtomicUsize,
+}
+
+#[async_trait]
+impl MetadataStore for MemMeta {
+    async fn get(&self, key: &[u8]) -> Result<Option<Bytes>> {
+        Ok(self.kv.lock().unwrap().get(key).cloned())
+    }
+
+    async fn scan(&self, prefix: &[u8]) -> Result<Vec<(Vec<u8>, Bytes)>> {
+        if prefix == b"inode:" {
+            self.inode_scans.fetch_add(1, Ordering::Relaxed);
+        }
+        Ok(self
+            .kv
+            .lock()
+            .unwrap()
+            .iter()
+            .filter(|(k, _)| k.starts_with(prefix))
+            .map(|(k, v)| (k.clone(), v.clone()))
+            .collect())
+    }
+
+    async fn scan_page(
+        &self,
+        prefix: &[u8],
+        after: Option<&[u8]>,
+        limit: usize,
+    ) -> Result<ScanPage> {
+        if prefix.starts_with(b"seg:") {
+            self.seg_range_reads.fetch_add(1, Ordering::Relaxed);
+        }
+        wyrd_testkit::test_double_scan_page(self, prefix, after, limit).await
+    }
+
+    async fn commit(&self, batch: WriteBatch) -> Result<CommitOutcome> {
+        let mut kv = self.kv.lock().unwrap();
+        for pre in &batch.preconditions {
+            if kv.get(&pre.key).cloned() != pre.expected {
+                return Ok(CommitOutcome::Conflict);
+            }
+        }
+        for (k, v) in batch.puts {
+            kv.insert(k, v);
+        }
+        for k in batch.deletes {
+            kv.remove(&k);
+        }
+        Ok(CommitOutcome::Committed)
+    }
+}
+
+/// One D server's fragment bytes.
+#[derive(Default)]
+struct MemDServer {
+    frags: Mutex<HashMap<FragmentId, Bytes>>,
+}
+
+#[async_trait]
+impl ChunkStore for MemDServer {
+    async fn put_fragment(&self, id: FragmentId, fragment: Bytes) -> Result<()> {
+        self.frags.lock().unwrap().insert(id, fragment);
+        Ok(())
+    }
+
+    async fn get_fragment(&self, id: FragmentId) -> Result<Option<Bytes>> {
+        Ok(self.frags.lock().unwrap().get(&id).cloned())
+    }
+
+    async fn list_fragments(&self) -> Result<Vec<FragmentId>> {
+        Ok(self.frags.lock().unwrap().keys().copied().collect())
+    }
+
+    async fn delete_fragment(&self, id: FragmentId) -> Result<()> {
+        self.frags.lock().unwrap().remove(&id);
+        Ok(())
+    }
+
+    async fn health(&self) -> Result<Health> {
+        Ok(Health::Healthy)
+    }
+}
+
+// ---- fixture ----
+
+fn frag(chunk: ChunkId, index: u16) -> FragmentId {
+    FragmentId { chunk, index }
+}
+
+async fn commit(meta: &MemMeta, batch: WriteBatch) {
+    assert_eq!(meta.commit(batch).await.unwrap(), CommitOutcome::Committed);
+}
+
+async fn elect(coord: &MemCoordination, zone_name: &str) -> (FencedZone, Custodian) {
+    let leader = Custodian::elect(coord, zone_name).await.unwrap();
+    let mut zone = FencedZone::new();
+    zone.install(leader.leadership());
+    (zone, leader)
+}
+
+/// Seed a committed **segmented** root at `inode` whose table names `segments.len()`
+/// segments, writing the first `written` of their `seg:` records. `written ==
+/// segments.len()` is the healthy shape; a smaller `written` is a genuinely unreadable
+/// object (`ChunkMapError::SegmentAbsent`) — the damaged fixture the containment legs need.
+async fn seed_segmented(
+    meta: &MemMeta,
+    inode: InodeId,
+    group: &SegmentGroup,
+    segments: Vec<Vec<ChunkRef>>,
+    written: usize,
+) {
+    let mut table = Vec::new();
+    let mut offset = 0u64;
+    for (index, chunks) in segments.into_iter().enumerate() {
+        let byte_len: u64 = chunks.iter().map(|c| c.len).sum();
+        table.push(SegmentRef {
+            index: index as u32,
+            byte_offset: offset,
+            byte_len,
+        });
+        if index < written {
+            let record = SegmentRecord::new(chunks, offset).unwrap();
+            let key = metadata::seg_key(group, index as u32).unwrap();
+            commit(meta, WriteBatch::new().put(key, metadata::encode(&record))).await;
+        }
+        offset += byte_len;
+    }
+    let map = SegmentedMap::new(group.clone(), table).unwrap();
+    let root = InodeRecord {
+        size: offset,
+        chunk_map: ChunkMap::Segmented(map),
+        state: InodeState::Committed,
+        version: 1,
+        ..Default::default()
+    };
+    commit(
+        meta,
+        WriteBatch::new().put(metadata::inode_key(inode), metadata::encode(&root)),
+    )
+    .await;
+}
+
+/// A single-fragment (`EcScheme::None`) chunk placed on `dserver`.
+fn none_chunk(id: ChunkId, dserver: DServerId, len: u64) -> ChunkRef {
+    ChunkRef {
+        id,
+        scheme: EcScheme::None,
+        len,
+        placement: vec![dserver],
+    }
+}
+
+/// A real, self-describing v1 fragment for a single-fragment (`EcScheme::None`) chunk — it
+/// verifies through [`repair::fragment_intact`] exactly as a genuine write's would, so an
+/// evacuation actually copies it instead of declining it as corrupt.
+fn none_fragment_bytes(id: ChunkId, payload: &[u8]) -> Bytes {
+    let header = wyrd_chunk_format::FragmentHeader::new_v1(id, payload.len() as u64);
+    Bytes::from(wyrd_chunk_format::encode(&header, payload))
+}
+
+/// The group a damaged (unreadable) object is seeded under: its table names two segments,
+/// only the first is ever written.
+const DAMAGED_NONCE: &str = "fedcba9876543210fedcba9876543210";
+const DAMAGED_EPOCH: u64 = 11;
+
+/// Seed the damaged object at `inode`: two segments named, one written, so resolving it
+/// fails with the resolver's own typed verdict. Asserts the fixture really is unreadable, so
+/// no leg can pass because the fault it was built around stopped being one.
+async fn seed_damaged(meta: &MemMeta, inode: InodeId, a: ChunkId, b: ChunkId) {
+    let group = SegmentGroup::new(DAMAGED_NONCE, DAMAGED_EPOCH).unwrap();
+    seed_segmented(
+        meta,
+        inode,
+        &group,
+        vec![vec![none_chunk(a, 0, 5)], vec![none_chunk(b, 0, 5)]],
+        1,
+    )
+    .await;
+    let root_key = metadata::inode_key(inode);
+    let root: InodeRecord = metadata::decode(&meta.get(&root_key).await.unwrap().unwrap()).unwrap();
+    assert!(
+        metadata::resolve_chunk_map(meta, &root_key, &root)
+            .await
+            .is_err(),
+        "fixture: the seeded root's map must genuinely fail to resolve"
+    );
+}
+
+/// Every `orphan:` key the store holds, in the store's own order.
+async fn orphan_keys(meta: &MemMeta) -> Vec<Vec<u8>> {
+    meta.scan(b"orphan:")
+        .await
+        .unwrap()
+        .into_iter()
+        .map(|(key, _)| key)
+        .collect()
+}
+
+// ---- criterion (1): post-restore reconciliation never strands a segmented object ----
+
+#[tokio::test]
+async fn stranded_marked_is_zero_over_segmented_objects_while_real_garbage_is_still_marked() {
+    let meta = MemMeta::default();
+    let d0 = MemDServer::default();
+    let d1 = MemDServer::default();
+
+    let chunk_a: ChunkId = 0xA1;
+    let chunk_b: ChunkId = 0xA2;
+    let payload_a = b"segment chunk a's real bytes";
+    let payload_b = b"segment chunk b's real bytes, a little longer";
+    d0.put_fragment(frag(chunk_a, 0), none_fragment_bytes(chunk_a, payload_a))
+        .await
+        .unwrap();
+    d1.put_fragment(frag(chunk_b, 0), none_fragment_bytes(chunk_b, payload_b))
+        .await
+        .unwrap();
+    let group = SegmentGroup::new("0123456789abcdef0123456789abcdef", 1).unwrap();
+    seed_segmented(
+        &meta,
+        1,
+        &group,
+        vec![
+            vec![none_chunk(chunk_a, 0, payload_a.len() as u64)],
+            vec![none_chunk(chunk_b, 1, payload_b.len() as u64)],
+        ],
+        2,
+    )
+    .await;
+
+    let fleet: [(DServerId, &dyn ChunkStore); 2] = [(0, &d0), (1, &d1)];
+    let gc_ctx = GcContext {
+        meta: &meta,
+        fleet: &fleet,
+        grace_window_millis: 1_000,
+        expired_pending: ExpiredPendingPolicy::Reclaim,
+    };
+
+    let report: RestoreReport = reconcile_after_restore(&gc_ctx, 10_000)
+        .await
+        .expect("a segmented object must be RESOLVED here, not error out the whole pass");
+    assert_eq!(
+        report.stranded_marked, 0,
+        "no fragment a segmented object owns may be marked stranded; got {report:?}"
+    );
+    assert!(
+        report.is_clean(),
+        "every chunk resolves and every fragment is where the map says: a clean bill; got {report:?}"
+    );
+    assert!(
+        orphan_keys(&meta).await.is_empty(),
+        "nothing was marked, so the orphan ledger is empty"
+    );
+
+    // ...and `0` is a VERDICT, not silence: a genuinely unreferenced fragment in the SAME
+    // store is marked on the very next pass, while the segmented object's two are not.
+    let stray: ChunkId = 0xDEAD;
+    d0.put_fragment(
+        frag(stray, 0),
+        none_fragment_bytes(stray, b"nobody's bytes"),
+    )
+    .await
+    .unwrap();
+    let report = reconcile_after_restore(&gc_ctx, 20_000).await.unwrap();
+    assert_eq!(
+        report.stranded_marked, 1,
+        "the unreferenced stray IS marked — the pass marks what nothing references; got {report:?}"
+    );
+    assert_eq!(
+        orphan_keys(&meta).await,
+        vec![metadata::orphan_key(0, frag(stray, 0))],
+        "exactly the stray is marked; the segmented object's fragments are untouched"
+    );
+
+    // The same containment through the real GC loop: past the grace window, with evidence
+    // now on the stray, the segmented object's fragments survive and the stray is reclaimed.
+    let coord = MemCoordination::new();
+    let (zone, custodian) = elect(&coord, "zone-restore").await;
+    let outcome = reconcile_step(&zone, &custodian, Some(&gc_ctx), None, None, None, 30_000)
+        .await
+        .unwrap();
+    assert_eq!(
+        outcome,
+        Reconciled::Changed,
+        "the stray was reclaimed; the reference set is complete, so nothing is blocked"
+    );
+    assert!(
+        d0.get_fragment(frag(chunk_a, 0)).await.unwrap().is_some()
+            && d1.get_fragment(frag(chunk_b, 0)).await.unwrap().is_some(),
+        "both of the segmented object's fragments must still be present"
+    );
+    assert!(
+        d0.get_fragment(frag(stray, 0)).await.unwrap().is_none(),
+        "the marked stray was reclaimed after its grace window"
+    );
+}
+
+// ---- criterion (2), repair half ----
+
+#[tokio::test]
+async fn reconstruction_repairs_a_chunk_whose_chunkref_lives_in_a_segmented_record() {
+    let meta = MemMeta::default();
+    let d0 = MemDServer::default();
+    let d2 = MemDServer::default();
+    let d3 = MemDServer::default();
+
+    let chunk: ChunkId = 0xB1;
+    let data = b"reconstruct this erasure-coded chunk living in a seg: record".to_vec();
+    let shards = erasure::encode(2, 1, &data).unwrap();
+    // Placed on 0,1,2 (domains A,B,C). Server 1 (domain B) is LOST: its fragment is never
+    // written and its store is absent from the fleet — the fault is IN the fixture.
+    d0.put_fragment(
+        frag(chunk, 0),
+        encode_ec_fragment(chunk, 0, 2, 1, &shards[0]),
+    )
+    .await
+    .unwrap();
+    d2.put_fragment(
+        frag(chunk, 2),
+        encode_ec_fragment(chunk, 2, 2, 1, &shards[2]),
+    )
+    .await
+    .unwrap();
+
+    let group = SegmentGroup::new("fedcba9876543210fedcba9876543211", 3).unwrap();
+    seed_segmented(
+        &meta,
+        1,
+        &group,
+        vec![vec![ChunkRef {
+            id: chunk,
+            scheme: EcScheme::ReedSolomon { k: 2, m: 1 },
+            len: data.len() as u64,
+            placement: vec![0, 1, 2],
+        }]],
+        1,
+    )
+    .await;
+    repair::enqueue_repair(&meta, chunk, "test").await.unwrap();
+
+    let mut topo = Topology::default();
+    topo.register(0, "A").register(2, "C").register(3, "D");
+    let fleet: [(DServerId, &dyn ChunkStore); 3] = [(0, &d0), (2, &d2), (3, &d3)];
+    let ctx = ReconstructionContext {
+        meta: &meta,
+        fleet: &fleet,
+        topology: &topo,
+        unreachable: &[],
+    };
+
+    let coord = MemCoordination::new();
+    let (zone, custodian) = elect(&coord, "zone-repair").await;
+    let root_before = meta.get(&metadata::inode_key(1)).await.unwrap().unwrap();
+
+    let outcome = reconcile_step(&zone, &custodian, None, None, Some(&ctx), None, 500)
+        .await
+        .expect("a segmented object's under-replicated chunk must be repaired, not fail the pass");
+    assert_eq!(
+        outcome,
+        Reconciled::Changed,
+        "the under-replicated chunk inside the seg: record was reconstructed"
+    );
+
+    // The obligation is DRAINED BY THE REPAIR — never dropped as "referenced by no committed
+    // chunk map", which is the acute defect this criterion binds.
+    assert!(
+        repair::queued_repairs(&meta).await.unwrap().is_empty(),
+        "the repair obligation must be drained by the reconstruction commit"
+    );
+
+    // The repoint targets exactly the record that CARRIES the chunk: the `seg:` record moves,
+    // the root does not.
+    let root_after = meta.get(&metadata::inode_key(1)).await.unwrap().unwrap();
+    assert_eq!(
+        root_before, root_after,
+        "a segmented repoint must not rewrite the inode root"
+    );
+    let seg_key = metadata::seg_key(&group, 0).unwrap();
+    let seg: SegmentRecord = metadata::decode(&meta.get(&seg_key).await.unwrap().unwrap()).unwrap();
+    assert_eq!(
+        seg.chunks()[0].placement,
+        vec![0, 3, 2],
+        "the rebuilt fragment was re-placed on the free distinct domain (server 3)"
+    );
+    let rebuilt = d3
+        .get_fragment(frag(chunk, 1))
+        .await
+        .unwrap()
+        .expect("the rebuilt fragment is on its new home");
+    assert!(
+        repair::fragment_intact(
+            &rebuilt,
+            frag(chunk, 1),
+            EcScheme::ReedSolomon { k: 2, m: 1 }
+        ),
+        "the rebuilt fragment verifies its checksum and its full identity"
+    );
+
+    // The move's evidence: the destination was ADOPTED (its pre-mark deleted in the winning
+    // commit, so GC will not reclaim the fragment the map now names) and the vacated source
+    // position is EVIDENCED (so a copy left behind there is collectable).
+    assert_eq!(
+        orphan_keys(&meta).await,
+        vec![metadata::orphan_key(1, frag(chunk, 1))],
+        "exactly one orphan record: the vacated source. The destination's pre-mark was \
+         deleted by the commit that adopted it — a live, referenced fragment must not be \
+         left carrying a grace record"
+    );
+}
+
+// ---- criterion (2), evacuation half ----
+
+#[tokio::test]
+async fn rebalance_evacuates_a_segmented_chunk_off_a_draining_server() {
+    let meta = MemMeta::default();
+    let d0 = MemDServer::default();
+    let d1 = MemDServer::default();
+
+    let chunk: ChunkId = 0xC1;
+    let payload = b"evacuate this segmented chunk's only fragment";
+    d0.put_fragment(frag(chunk, 0), none_fragment_bytes(chunk, payload))
+        .await
+        .unwrap();
+    let group = SegmentGroup::new("11112222333344445555666677778888", 1).unwrap();
+    seed_segmented(
+        &meta,
+        1,
+        &group,
+        vec![vec![none_chunk(chunk, 0, payload.len() as u64)]],
+        1,
+    )
+    .await;
+    set_lifecycle(&meta, 0, DServerLifecycle::Draining)
+        .await
+        .unwrap();
+
+    let mut topo = Topology::default();
+    topo.register(0, "A").register(1, "B");
+    let fleet: [(DServerId, &dyn ChunkStore); 2] = [(0, &d0), (1, &d1)];
+    let ctx = RebalanceContext {
+        meta: &meta,
+        fleet: &fleet,
+        topology: &topo,
+    };
+
+    let coord = MemCoordination::new();
+    let (zone, custodian) = elect(&coord, "zone-evac").await;
+    let outcome = reconcile_step(&zone, &custodian, None, None, None, Some(&ctx), 700)
+        .await
+        .expect("a segmented chunk on a draining server must be evacuated, not fail the pass");
+    assert_eq!(
+        outcome,
+        Reconciled::Changed,
+        "the segmented chunk was evacuated off the draining server"
+    );
+
+    let seg_key = metadata::seg_key(&group, 0).unwrap();
+    let seg: SegmentRecord = metadata::decode(&meta.get(&seg_key).await.unwrap().unwrap()).unwrap();
+    assert_eq!(
+        seg.chunks()[0].placement,
+        vec![1],
+        "the placement moved off the draining server (0) onto the free domain (1)"
+    );
+    assert!(
+        d1.get_fragment(frag(chunk, 0)).await.unwrap().is_some(),
+        "the evacuated copy exists at its new home"
+    );
+    assert!(
+        d0.get_fragment(frag(chunk, 0)).await.unwrap().is_some(),
+        "this pass deletes nothing: the draining server's copy is orphaned, and GC reclaims \
+         it after the grace window"
+    );
+    assert_eq!(
+        orphan_keys(&meta).await,
+        vec![metadata::orphan_key(0, frag(chunk, 0))],
+        "exactly one orphan record: the vacated copy on the draining server. The \
+         destination's pre-mark was deleted by the commit that adopted it"
+    );
+}
