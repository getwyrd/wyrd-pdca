+// ---- containment: per object, and the walk goes on ----
+
+#[tokio::test]
+async fn a_damaged_object_does_not_starve_the_healthy_ones_and_its_obligation_stays_queued() {
+    let meta = MemMeta::default();
+    let d0 = MemDServer::default();
+    let d2 = MemDServer::default();
+    let d3 = MemDServer::default();
+
+    // `inode:1` sorts BEFORE `inode:2`, so the damaged object is the one the walk meets
+    // FIRST: "the healthy object was still handled" cannot pass on a build that abandons the
+    // walk at the first blocker.
+    let hidden_a: ChunkId = 0xF1;
+    let hidden_b: ChunkId = 0xF2;
+    seed_damaged(&meta, 1, hidden_a, hidden_b).await;
+
+    // A healthy segmented object whose chunk is genuinely under-replicated: RS(2,1) on
+    // 0,1,2 with server 1's fragment never written and its store out of the fleet.
+    let healthy: ChunkId = 0xF3;
+    let data = b"the healthy object's chunk, repaired while its neighbour is unreadable".to_vec();
+    let shards = erasure::encode(2, 1, &data).unwrap();
+    d0.put_fragment(
+        frag(healthy, 0),
+        encode_ec_fragment(healthy, 0, 2, 1, &shards[0]),
+    )
+    .await
+    .unwrap();
+    d2.put_fragment(
+        frag(healthy, 2),
+        encode_ec_fragment(healthy, 2, 2, 1, &shards[2]),
+    )
+    .await
+    .unwrap();
+    let group = SegmentGroup::new("99998888777766665555444433332222", 4).unwrap();
+    seed_segmented(
+        &meta,
+        2,
+        &group,
+        vec![vec![ChunkRef {
+            id: healthy,
+            scheme: EcScheme::ReedSolomon { k: 2, m: 1 },
+            len: data.len() as u64,
+            placement: vec![0, 1, 2],
+        }]],
+        1,
+    )
+    .await;
+
+    // TWO obligations: one for the healthy object's chunk, one for a chunk that lives in the
+    // record nobody can read.
+    repair::enqueue_repair(&meta, healthy, "test")
+        .await
+        .unwrap();
+    repair::enqueue_repair(&meta, hidden_b, "test")
+        .await
+        .unwrap();
+
+    let mut topo = Topology::default();
+    topo.register(0, "A").register(2, "C").register(3, "D");
+    let fleet: [(DServerId, &dyn ChunkStore); 3] = [(0, &d0), (2, &d2), (3, &d3)];
+    let ctx = ReconstructionContext {
+        meta: &meta,
+        fleet: &fleet,
+        topology: &topo,
+        unreachable: &[],
+    };
+
+    let coord = MemCoordination::new();
+    let (zone, custodian) = elect(&coord, "zone-contain").await;
+    let outcome = reconcile_step(&zone, &custodian, None, None, Some(&ctx), None, 400)
+        .await
+        .expect("one unreadable record must not end the pass for every healthy object");
+
+    // NOT CERTIFIED: the pass reasoned over an index it knows is incomplete.
+    assert_eq!(
+        outcome,
+        Reconciled::Blocked,
+        "a repair pass that could not enumerate every committed object's chunks must not \
+         report the store converged"
+    );
+
+    // The healthy object WAS repaired — a damaged neighbour starves nothing.
+    let seg: SegmentRecord = metadata::decode(
+        &meta
+            .get(&metadata::seg_key(&group, 0).unwrap())
+            .await
+            .unwrap()
+            .unwrap(),
+    )
+    .unwrap();
+    assert_eq!(
+        seg.chunks()[0].placement,
+        vec![0, 3, 2],
+        "the healthy object's under-replicated chunk was repaired on the same pass"
+    );
+    assert!(
+        d3.get_fragment(frag(healthy, 1)).await.unwrap().is_some(),
+        "its rebuilt fragment landed on the free distinct domain"
+    );
+
+    // ...and the damaged object's obligation is STILL QUEUED — never retired as "referenced
+    // by no committed chunk map" on a reading that could not see the record it lives in.
+    let still_queued = repair::queued_repairs(&meta).await.unwrap();
+    assert_eq!(
+        still_queued,
+        vec![hidden_b],
+        "the obligation for a chunk that may live in the unreadable record stays queued; \
+         draining it would retire a repair nothing would ever re-raise"
+    );
+}
