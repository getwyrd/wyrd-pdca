+    #[test]
+    fn the_value_ceiling_admits_a_record_at_it_and_refuses_one_a_byte_over() {
+        // The boundary is the ceiling itself: a record OF exactly `MAX_VALUE_BYTES` is one
+        // the tightest backend stores, so refusing it would reject a legal repair; one byte
+        // more is a record no later `require(key, encode(prior))` could overwrite.
+        assert!(check_value_ceiling(b"k", &vec![0u8; MAX_VALUE_BYTES]).is_ok());
+        assert_eq!(
+            check_value_ceiling(b"k", &vec![0u8; MAX_VALUE_BYTES + 1]),
+            Err(ChunkMapError::ValueOverCeiling {
+                key: "k".to_owned(),
+                bytes: MAX_VALUE_BYTES + 1,
+                ceiling: MAX_VALUE_BYTES,
+            })
+        );
+    }
+
+    #[test]
+    fn a_repoint_over_the_ceiling_is_refused_before_anything_is_written() {
+        // A segment record just under the ceiling whose repoint crosses it: refused, and the
+        // refusal names the record so an operator knows which one to shrink. The moving
+        // chunk is a 6-fragment RS(4,2) one, so repointing it onto 20-digit server ids grows
+        // the record by 6 x 19 bytes — wider than one filler chunk, which is what lets the
+        // coarse fill below land inside the window instead of stepping over it.
+        let wide_chunk = ChunkRef {
+            id: CHUNK,
+            scheme: EcScheme::ReedSolomon { k: 4, m: 2 },
+            len: 4,
+            placement: vec![0, 1, 2, 3, 4, 5],
+        };
+        let mut chunks = vec![wide_chunk];
+        let one = encode(&SegmentRecord::new(chunks.clone(), 0).unwrap()).len();
+        let filler = ChunkRef {
+            id: 1,
+            scheme: EcScheme::None,
+            len: 1,
+            placement: vec![7],
+        };
+        let per = encode(&SegmentRecord::new(vec![chunks[0].clone(), filler.clone()], 0).unwrap())
+            .len()
+            - one;
+        for _ in 0..(MAX_VALUE_BYTES - one) / per {
+            chunks.push(filler.clone());
+        }
+        let record = SegmentRecord::new(chunks, 0).unwrap();
+        assert!(
+            encode(&record).len() <= MAX_VALUE_BYTES,
+            "legal before the move"
+        );
+        let map = SegmentedMap::new(
+            group(),
+            vec![SegmentRef {
+                index: 0,
+                byte_offset: 0,
+                byte_len: record.byte_len(),
+            }],
+        )
+        .unwrap();
+        let root = InodeRecord {
+            size: record.byte_len(),
+            chunk_map: ChunkMap::Segmented(map),
+            state: InodeState::Committed,
+            version: 1,
+            ..Default::default()
+        };
+        let home = ChunkHome::Segment {
+            segment: std::sync::Arc::new(SegmentHome {
+                key: seg_key(&group(), 0).unwrap(),
+                record,
+            }),
+            position: 0,
+        };
+        // Six 20-digit destinations: 114 bytes of growth on a record that was legal.
+        let wide = vec![u64::MAX; 6];
+        match reason(repoint(&root, &home, wide, &[]).unwrap_err()) {
+            ChunkMapError::ValueOverCeiling {
+                key,
+                bytes,
+                ceiling,
+            } => {
+                assert_eq!(key, String::from_utf8_lossy(&seg_key(&group(), 0).unwrap()));
+                assert!(bytes > ceiling);
+                assert_eq!(ceiling, MAX_VALUE_BYTES);
+            }
+            other => panic!("the ceiling must refuse the growth; got {other:?}"),
+        }
+    }
+}
