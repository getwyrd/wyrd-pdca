+// ---- criterion (2), ceiling half: LEGAL before the move, over the ceiling because of it ----
+
+/// The destination the evacuation below will pick: a 20-digit id, so repointing one
+/// placement entry off a 1-digit server grows the carrying record by 19 bytes. The window
+/// the fixture has to land in is exactly that growth.
+const WIDE_DESTINATION: DServerId = 18_446_744_073_709_551_615;
+
+/// `metadata::encode`d length of the segment record `chunks` would form.
+fn encoded_len(chunks: &[ChunkRef]) -> usize {
+    metadata::encode(&SegmentRecord::new(chunks.to_vec(), 0).unwrap()).len()
+}
+
+/// A filler chunk nothing in these legs evacuates (its placed server is never draining),
+/// whose ENCODED size grows by exactly one byte per `pad`: the padding rides in the decimal
+/// width of that server id (`7`, `77`, `777`, …), which is how the fixture below can be
+/// tuned to land inside a 19-byte window.
+fn padded_filler(id: ChunkId, pad: usize) -> ChunkRef {
+    let mut server: DServerId = 7;
+    for _ in 0..pad {
+        server = server * 10 + 7;
+    }
+    none_chunk(id, server, 1)
+}
+
+#[tokio::test]
+async fn a_repoint_that_would_grow_a_record_past_the_value_ceiling_is_refused_not_persisted() {
+    let meta = MemMeta::default();
+    let d0 = MemDServer::default();
+    let wide = MemDServer::default();
+
+    let target: ChunkId = 0xD1;
+    let payload = b"the chunk this pass tries (and must refuse) to repoint";
+    d0.put_fragment(frag(target, 0), none_fragment_bytes(target, payload))
+        .await
+        .unwrap();
+
+    // Build a segment record that is LEGAL — at or under the value ceiling, so a conforming
+    // backend stores it and every CAS on it can hold — but so close to the ceiling that
+    // repointing `target`'s single placement entry from server `0` (1 digit) to
+    // `WIDE_DESTINATION` (20 digits) would push it over. That transition, legal → oversize,
+    // is the whole property: a fixture seeded already-oversize would only prove the resolver
+    // refuses to read one.
+    let growth = WIDE_DESTINATION.to_string().len() - 1;
+    let mut chunks = vec![none_chunk(target, 0, payload.len() as u64)];
+    // Coarse: minimal fillers, priced once (every filler id below is 5 decimal digits, so
+    // they encode identically) and then added in one step, so the fixture costs one pass over
+    // the record rather than one per filler.
+    const FIRST_FILLER_ID: ChunkId = 0x1_0000;
+    let per_filler = encoded_len(&[chunks[0].clone(), padded_filler(FIRST_FILLER_ID, 0)])
+        - encoded_len(&chunks[..1]);
+    let room = (MAX_VALUE_BYTES - encoded_len(&chunks)) / per_filler;
+    for filler_id in FIRST_FILLER_ID..FIRST_FILLER_ID + room as ChunkId {
+        chunks.push(padded_filler(filler_id, 0));
+    }
+    while encoded_len(&chunks) > MAX_VALUE_BYTES {
+        chunks.pop();
+    }
+    // Fine: widen filler placements one decimal digit at a time (+1 encoded byte each) until
+    // the record sits inside the last `growth` bytes below the ceiling.
+    let mut slot = 1usize;
+    let mut pad = 1usize;
+    while encoded_len(&chunks) + growth <= MAX_VALUE_BYTES {
+        assert!(slot < chunks.len(), "ran out of fillers to pad with");
+        chunks[slot] = padded_filler(chunks[slot].id, pad);
+        if pad >= 18 {
+            slot += 1;
+            pad = 1;
+        } else {
+            pad += 1;
+        }
+    }
+    let before_len = encoded_len(&chunks);
+    assert!(
+        before_len <= MAX_VALUE_BYTES,
+        "fixture: the record must be LEGAL before the move ({before_len} bytes)"
+    );
+
+    // ...and the repointed record — the same chunks with `target` moved to the wide
+    // destination — must be over it. Computed here, so the leg proves the move is what
+    // crosses the ceiling rather than assuming it.
+    let mut after_move = chunks.clone();
+    after_move[0].placement = vec![WIDE_DESTINATION];
+    assert!(
+        encoded_len(&after_move) > MAX_VALUE_BYTES,
+        "fixture: repointing `target` onto the wide destination must CROSS the ceiling \
+         ({} bytes)",
+        encoded_len(&after_move)
+    );
+
+    let group = SegmentGroup::new("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", 9).unwrap();
+    seed_segmented(&meta, 1, &group, vec![chunks], 1).await;
+    set_lifecycle(&meta, 0, DServerLifecycle::Draining)
+        .await
+        .unwrap();
+
+    let seg_key = metadata::seg_key(&group, 0).unwrap();
+    let seg_before = meta.get(&seg_key).await.unwrap().unwrap();
+
+    let mut topo = Topology::default();
+    topo.register(0, "A").register(WIDE_DESTINATION, "D");
+    let fleet: [(DServerId, &dyn ChunkStore); 2] = [(0, &d0), (WIDE_DESTINATION, &wide)];
+    let ctx = RebalanceContext {
+        meta: &meta,
+        fleet: &fleet,
+        topology: &topo,
+    };
+
+    let coord = MemCoordination::new();
+    let (zone, custodian) = elect(&coord, "zone-ceiling").await;
+    let outcome = reconcile_step(&zone, &custodian, None, None, None, Some(&ctx), 900)
+        .await
+        .expect("a refused repoint must not fail the whole pass");
+    assert_eq!(
+        outcome,
+        Reconciled::Satisfied,
+        "nothing converged and nothing is unreadable: the one candidate move was refused"
+    );
+
+    // REFUSED, NOT PERSISTED — and the record is still one the system can overwrite.
+    let seg_after = meta.get(&seg_key).await.unwrap().unwrap();
+    assert_eq!(
+        seg_before, seg_after,
+        "a repoint that would push a record past the value ceiling must never be persisted"
+    );
+    assert!(
+        seg_after.len() <= MAX_VALUE_BYTES,
+        "the record the store holds is still inside the ceiling, so a later repair's \
+         require(key, encode(prior)) can still overwrite it"
+    );
+    let seg: SegmentRecord = metadata::decode(&seg_after).unwrap();
+    assert_eq!(
+        seg.chunks()[0].placement,
+        vec![0],
+        "the placement was never repointed — still the original (draining) server"
+    );
+
+    // The refusal strands nothing either: the copy already written to the destination
+    // carries the pre-mark written BEFORE it, so GC reclaims it after the grace window.
+    assert!(
+        wide.get_fragment(frag(target, 0)).await.unwrap().is_some(),
+        "the destination copy was written before the refusal"
+    );
+    assert_eq!(
+        orphan_keys(&meta).await,
+        vec![metadata::orphan_key(WIDE_DESTINATION, frag(target, 0))],
+        "the abandoned destination copy keeps its pre-mark — a refused repoint leaves \
+         collectable bytes, never a permanent leak"
+    );
+}
