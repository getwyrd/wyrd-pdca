+                let mut record: InodeRecord = metadata::decode(&bytes).unwrap();
+                record.version += 1;
+                self.inner
+                    .commit(WriteBatch::new().put(key, metadata::encode(&record)))
+                    .await?;
+            }
+        }
+        self.inner.commit(batch).await
+    }
+}
