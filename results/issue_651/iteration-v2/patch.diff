+    #[test]
+    fn only_a_committed_root_resolves_to_homes() {
+        // A root that is not `Committed` owns no live generation to repoint: the homed
+        // resolver answers "no such object" for it, exactly as `resolve_current_chunk_map`
+        // does — a maintenance pass must never plan a move against an uncommitted record.
+        let store = wyrd_metadata_redb::RedbMetadataStore::in_memory().unwrap();
+        let key = inode_key(INODE);
+        let mut record = InodeRecord {
+            size: 4,
+            chunk_map: ChunkMap::Flat(vec![chunk(vec![0])]),
+            state: InodeState::Pending,
+            version: 1,
+            ..Default::default()
+        };
+        pollster::block_on(store.commit(WriteBatch::new().put(key.clone(), encode(&record))))
+            .unwrap();
+        assert_eq!(
+            pollster::block_on(resolve_current_chunk_homes(&store, &key)).unwrap(),
+            None,
+            "a pending root has no live committed generation"
+        );
+
+        record.state = InodeState::Committed;
+        pollster::block_on(store.commit(WriteBatch::new().put(key.clone(), encode(&record))))
+            .unwrap();
+        let resolved = pollster::block_on(resolve_current_chunk_homes(&store, &key))
+            .unwrap()
+            .expect("a committed root resolves");
+        assert_eq!(resolved.record, record);
+        assert_eq!(resolved.chunks.len(), 1);
+        assert_eq!(resolved.chunks[0].home, ChunkHome::Root { position: 0 });
+    }
