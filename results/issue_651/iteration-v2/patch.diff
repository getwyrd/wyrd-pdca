+// ---------------------------------------------------------------------------
+// Chunk repoint — the maintenance move (proposal 0016 decision 7(f), `0016:669`)
+// ---------------------------------------------------------------------------
+//
+// A repair (reconstruction's rebuild, rebalance's evacuation) moves a chunk's FRAGMENTS,
+// never its content — so what it rewrites is the ONE record that carries that chunk's
+// `ChunkRef`: the inode root for a flat map, or the chunk's own
+// `seg:<nonce>:<epoch>:<index>` record for a segmented one (`0016:354`, the `seg:` row's
+// writer (2)). [`ChunkHome`] is that record's identity, resolved once per pass beside the
+// chunk itself ([`resolve_chunk_homes`]); [`repoint_chunk`] builds the exact-bytes CAS that
+// writes the new placement back into it.
+
+/// The `seg:` record one resolved chunk lives in — **shared** by every chunk that segment
+/// carries.
+///
+/// Shared (behind an [`Arc`] in [`ChunkHome::Segment`]) rather than cloned per chunk because
+/// a segment record is bounded by the value ceiling, not by one chunk: a per-chunk copy
+/// would make resolving one object cost `chunks × record` bytes — quadratic in a legal,
+/// near-ceiling map, and an out-of-memory on the reconcile host rather than a repair.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct SegmentHome {
+    /// The segment record's key (`seg:<nonce>:<epoch>:<index>`) — the CAS's key.
+    pub key: Vec<u8>,
+    /// The segment record exactly as this resolve read it: re-encoding it is the CAS's
+    /// precondition, the same decode-then-`encode(&prior)` shape every other custodian
+    /// CAS in this module already uses.
+    pub record: SegmentRecord,
+}
+
+/// The record that carries one resolved chunk's `ChunkRef` — what a maintenance repoint
+/// compare-and-swaps when it moves that chunk's fragments (`0016:354`, decision 7(f)).
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum ChunkHome {
+    /// A flat map's chunk: the inode root itself carries the `ChunkRef`, at `position`.
+    Root {
+        /// The chunk's position in the flat map.
+        position: usize,
+    },
+    /// A segmented map's chunk: a `seg:` record carries it, at `position` within that
+    /// segment's own chunk list.
+    Segment {
+        /// The segment record that carries it, shared by all of its chunks.
+        segment: std::sync::Arc<SegmentHome>,
+        /// The chunk's position inside that segment's own chunk list.
+        position: usize,
+    },
+}
+
+/// One resolved chunk together with the record that carries it.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct HomedChunk {
+    /// The chunk itself.
+    pub chunk: ChunkRef,
+    /// Where its `ChunkRef` lives.
+    pub home: ChunkHome,
+}
+
+/// [`resolve_snapshot`]'s twin for a maintenance repoint: not just the ordered chunks, but
+/// which record carries each one. Built over the SAME segment read ([`read_segments`]) and
+/// settled by the SAME resolve-retry rule (decision 7(h)) as the read path's resolver, so
+/// the two can never disagree about which generation a chunk came from.
+async fn resolve_snapshot_homes(
+    store: &dyn MetadataStore,
+    root_key: &[u8],
+    record: &InodeRecord,
+) -> Result<Resolution<Vec<HomedChunk>>> {
+    let map = match &record.chunk_map {
+        ChunkMap::Flat(chunks) => {
+            return Ok(Resolution::Answer(
+                chunks
+                    .iter()
+                    .enumerate()
+                    .map(|(position, chunk)| HomedChunk {
+                        chunk: chunk.clone(),
+                        home: ChunkHome::Root { position },
+                    })
+                    .collect(),
+            ))
+        }
+        ChunkMap::Segmented(map) => map,
+    };
+    let group = map.group();
+    Ok(read_segments(store, root_key, map).await?.map(|segments| {
+        let mut homed = Vec::new();
+        // Ordered by the segment's own parsed index (`BTreeMap` iteration order), exactly
+        // as [`resolve_snapshot`] orders the flat list it hands the read path.
+        for (index, seg_record) in segments {
+            // Every index here came from the root's own validated table, which
+            // `SegmentedMap::new` already bounded to the addressable key space
+            // (`checked_segment_index`), so `seg_key` cannot fail on it.
+            let key = seg_key(group, index).unwrap_or_default();
+            let count = seg_record.chunks().len();
+            // ONE allocation per segment, shared by its chunks — see [`SegmentHome`].
+            let shared = std::sync::Arc::new(SegmentHome {
+                key,
+                record: seg_record,
+            });
+            for position in 0..count {
+                homed.push(HomedChunk {
+                    chunk: shared.record.chunks()[position].clone(),
+                    home: ChunkHome::Segment {
+                        segment: std::sync::Arc::clone(&shared),
+                        position,
+                    },
+                });
+            }
+        }
+        homed
+    }))
+}
+
+/// One resolved map with homes: the generation it was resolved from, and its ordered
+/// chunks-with-homes. The [`ResolvedChunkMap`] a maintenance repoint needs — it carries the
+/// record because a resolve that restarted onto the live root (decision 7(h)) answers a
+/// generation the caller's own snapshot does not describe, and the repoint's root
+/// precondition must be *that* generation's bytes, never the stale snapshot's.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct ResolvedChunkHomes {
+    /// The generation the chunks came from.
+    pub record: InodeRecord,
+    /// That generation's ordered chunks, each with the record that carries it.
+    pub chunks: Vec<HomedChunk>,
+}
+
+/// Resolve a caller's own committed snapshot to its chunks-with-homes — the
+/// [`resolve_chunk_map`] twin a maintenance repoint needs. A generation superseded
+/// mid-resolve restarts onto the live root ([`resolve_current_chunk_homes`]); one found
+/// **gone** answers `Ok(None)`, the same "no live committed generation" every consumer
+/// already reads.
+pub async fn resolve_chunk_homes(
+    store: &dyn MetadataStore,
+    root_key: &[u8],
+    record: &InodeRecord,
+) -> Result<Option<ResolvedChunkHomes>> {
+    match resolve_snapshot_homes(store, root_key, record).await? {
+        Resolution::Answer(chunks) => Ok(Some(ResolvedChunkHomes {
+            record: record.clone(),
+            chunks,
+        })),
+        Resolution::Superseded => resolve_current_chunk_homes(store, root_key).await,
+        Resolution::Gone => Ok(None),
+    }
+}
+
+/// [`resolve_current_chunk_map`]'s twin: resolve the chunk map of the root the store holds
+/// **now**, with homes, for a caller whose own snapshot may already be stale.
+pub async fn resolve_current_chunk_homes(
+    store: &dyn MetadataStore,
+    root_key: &[u8],
+) -> Result<Option<ResolvedChunkHomes>> {
+    for _ in 0..MAX_RESOLVE_RESTARTS {
+        let Some(bytes) = store.get(root_key).await? else {
+            return Ok(None);
+        };
+        // Typed, not raw — see [`decode_root_record`]: a root that will not parse is this
+        // object's fault, so a maintenance pass contains it instead of reading a store
+        // outage.
+        let record = decode_root_record(&bytes)?;
+        if record.state != InodeState::Committed {
+            return Ok(None);
+        }
+        match resolve_snapshot_homes(store, root_key, &record).await? {
+            Resolution::Answer(chunks) => return Ok(Some(ResolvedChunkHomes { record, chunks })),
+            Resolution::Gone => return Ok(None),
+            Resolution::Superseded => {}
+        }
+    }
+    Err(ChunkMapError::MapResolutionUnstable {
+        attempts: MAX_RESOLVE_RESTARTS,
+    }
+    .into())
+}
+
+/// One fragment a repoint moves: the slot, where it came from, and where it went.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct MovedFragment {
+    /// The fragment being moved.
+    pub frag: FragmentId,
+    /// The D server the committed placement named before the move — the **source**,
+    /// whose copy the winning CAS evidences as an orphan.
+    pub from: DServerId,
+    /// The D server the fragment was written to — the **destination**, whose pre-mark the
+    /// winning CAS deletes (adopting the bytes) and whose drain it fences against.
+    pub to: DServerId,
+}
+
+/// One chunk's repoint, as [`repoint_chunk`] compare-and-swaps it (`0016:669`).
+pub struct ChunkRepoint<'a> {
+    /// The object whose chunk is moving.
+    pub inode_id: InodeId,
+    /// The committed generation the [`ChunkHome`] was resolved from — the CAS's root
+    /// precondition.
+    pub prior_root: &'a InodeRecord,
+    /// The record that carries the chunk.
+    pub home: &'a ChunkHome,
+    /// The chunk's FULL new placement vector (length `fragment_count()`).
+    pub placement: Vec<DServerId>,
+    /// Every fragment this repoint moved, each already **pre-marked at its destination and
+    /// written there** by the caller.
+    pub moved: &'a [MovedFragment],
+    /// The exact bytes of each destination pre-mark ([`orphan_evidence`]), required back by
+    /// the CAS so a pre-mark GC has already consumed cannot be adopted.
+    pub pre_mark: Vec<u8>,
+    /// The logical instant the vacated source copies become orphans.
+    pub now_millis: u64,
+}
+
+/// The compare-and-swap that **repoints** one chunk: rewrite the `placement` of the
+/// `ChunkRef` [`ChunkHome`] names, in whichever record carries it, and nothing else — the
+/// chunk's id, scheme and length are carried over unchanged from the record this CAS is
+/// preconditioned on, so a repoint can only ever be a *move*, never a republication of
+/// different content under a committed chunk id.
+///
+/// The batch (`0016:669`, the `seg:` row's writer (2) at `0016:354`), for both shapes:
+///
+/// * `require(<carrying record> == prior)` — a flat map's inode root (rewritten at
+///   `version + 1`, exactly the shape every repair CAS used before the segmented shape
+///   existed), or the chunk's `seg:` record;
+/// * `require(inode == prior_root)` for a segmented chunk **as well**: the root is not
+///   rewritten (its version does not move), but a repoint racing a supersede/retirement
+///   that swept the generation out from under it must lose rather than resurrect a
+///   generation nothing live names any more (decision 7(f));
+/// * `require(orphan:<P_new> == pre_mark)` per moved fragment — **the pre-mark must still
+///   stand**. The caller pre-marks the destination *before* writing the fragment there, so
+///   a CAS that loses is a no-op that leaves the pre-mark standing and GC reclaims the
+///   abandoned copy; requiring it back means a destination GC has already reclaimed (the
+///   repair outlived the grace window) can never be adopted;
+/// * `require_absent(desired:dserver:<S_new>)` per destination — the **drain fence**: a
+///   repoint must not adopt a destination whose drain was recorded while its fragment was
+///   in flight, or a server certified safe to decommission would end up holding a
+///   referenced fragment (`0016:669`, X59);
+/// * `delete(orphan:<P_new>)` per moved fragment — adopting the destination bytes; and
+/// * `put(orphan:<P_old>)` per moved fragment — evidencing the vacated source, so GC
+///   reclaims it after the reader-safe grace window.
+///
+/// **Refuses rather than persists a record the move would push past the value ceiling**
+/// ([`ChunkMapError::ValueOverCeiling`], `docs/principles.md` §5 C-1). A `DServerId` renders
+/// in 1 to 20 decimal digits, so moving a chunk's fragments onto higher-numbered servers
+/// grows the record that carries them even though the placement vector's *length* never
+/// changes — and a record grown past the ceiling is one no later
+/// `require(key, encode(prior))` could overwrite: its placement could never be repaired
+/// again. Refusing here turns that into one chunk's move declining to proceed.
+///
+/// The caller adds its own mutations (reconstruction's repair-queue drain) to the returned
+/// batch and commits it.
+pub fn repoint_chunk(repoint: &ChunkRepoint<'_>) -> Result<WriteBatch> {
+    let ChunkRepoint {
+        inode_id,
+        prior_root,
+        home,
+        placement,
+        moved,
+        pre_mark,
+        now_millis,
+    } = repoint;
+    let root_key = inode_key(*inode_id);
+    let mut batch = match home {
+        ChunkHome::Root { position } => {
+            let mut chunks = prior_root
+                .chunk_map
+                .as_flat()
+                .ok_or(ChunkMapError::MapShapeChanged)?
+                .to_vec();
+            let slot = chunks
+                .get_mut(*position)
+                .ok_or(ChunkMapError::ChunkPositionOutOfRange {
+                    position: *position,
+                })?;
+            slot.placement = placement.clone();
+            let next_root = InodeRecord {
+                chunk_map: ChunkMap::Flat(chunks),
+                version: prior_root.version + 1,
+                // A repoint re-places the SAME content, so it PRESERVES the object metadata
+                // (ADR-0047): a placement-maintenance commit must not move `Last-Modified`
+                // or drop the content type.
+                ..(*prior_root).clone()
+            };
+            WriteBatch::new()
+                .require(root_key.clone(), encode(prior_root))
+                .put(root_key, encode(&next_root))
+        }
+        ChunkHome::Segment { segment, position } => {
+            // The home and the (possibly restarted) root must still describe one another:
+            // a home resolved from a generation the root has since moved off would
+            // otherwise satisfy `require(seg == prior)` against a record no live consumer
+            // reads any more, while `require(inode == prior_root)` held against a root that
+            // never named it — the repoint would report success into a retired generation.
+            let table = prior_root
+                .chunk_map
+                .segmented()
+                .ok_or(ChunkMapError::MapShapeChanged)?;
+            let (nonce, epoch, index) = parse_seg_key(&segment.key)?;
+            if nonce != *table.group().nonce()
+                || epoch != table.group().epoch()
+                || !table.segments().iter().any(|s| s.index == index)
+            {
+                return Err(ChunkMapError::MapShapeChanged.into());
+            }
+            let mut chunks = segment.record.chunks().to_vec();
+            let slot = chunks
+                .get_mut(*position)
+                .ok_or(ChunkMapError::ChunkPositionOutOfRange {
+                    position: *position,
+                })?;
+            slot.placement = placement.clone();
+            let next_record = SegmentRecord::new(chunks, segment.record.byte_offset())?;
+            WriteBatch::new()
+                .require(segment.key.clone(), encode(&segment.record))
+                .require(root_key, encode(prior_root))
+                .put(segment.key.clone(), encode(&next_record))
+        }
+    };
+    for moved in *moved {
+        let destination = orphan_key(moved.to, moved.frag);
+        batch = batch
+            // The pre-mark must still stand (and be OURS), or the bytes it evidenced may
+            // already be reclaimed.
+            .require(destination.clone(), pre_mark.clone())
+            // The drain fence: the destination must not have been recorded draining while
+            // its fragment was in flight.
+            .require_absent(desired_key(moved.to))
+            // Adopt the destination: it is referenced from this commit on.
+            .delete(destination)
+            // Evidence the vacated source, so GC reclaims it after the grace window.
+            .put(
+                orphan_key(moved.from, moved.frag),
+                orphan_evidence(*now_millis),
+            );
+    }
+    check_record_ceilings(&batch)?;
+    Ok(batch)
+}
+
+/// Refuse a batch carrying any **put** whose value is over the value ceiling every backend
+/// inherits ([`MAX_VALUE_BYTES`]) — the whole-batch guard [`repoint_chunk`] runs before
+/// returning: a repair must never commit a record the tightest backend would reject, and a
+/// record it did accept but that exceeds the ceiling is one no future
+/// `require(key, encode(prior))` could ever overwrite again (`docs/principles.md` §5 C-1).
+fn check_record_ceilings(batch: &WriteBatch) -> std::result::Result<(), ChunkMapError> {
+    for (key, value) in &batch.puts {
+        check_value_ceiling(key, value)?;
+    }
+    Ok(())
+}
+
+/// One record's encoded value against [`MAX_VALUE_BYTES`] — [`check_record_ceilings`]'s
+/// per-record primitive.
+fn check_value_ceiling(key: &[u8], value: &[u8]) -> std::result::Result<(), ChunkMapError> {
+    if value.len() > MAX_VALUE_BYTES {
+        return Err(ChunkMapError::ValueOverCeiling {
+            key: String::from_utf8_lossy(key).into_owned(),
+            bytes: value.len(),
+            ceiling: MAX_VALUE_BYTES,
+        });
+    }
+    Ok(())
+}
+
+/// The [`repoint_chunk`] rules the custodian's own pass-level tests cannot reach — the
+/// shape of the batch it builds, and **which** typed reason refuses one. Co-located
+/// because both need patch-added symbols (`ChunkRepoint`, `ChunkHome`, the new
+/// `ChunkMapError` variants) that the per-fix discriminator deliberately does not name, and
+/// because a boxed trait error only yields its reason on downcast. `C4-ci` runs them.
+#[cfg(test)]
+mod repoint_tests {
+    use super::*;
+
+    const NONCE: &str = "0123456789abcdef0123456789abcdef";
+    const EPOCH: u64 = 7;
+    const INODE: InodeId = 3;
+    const CHUNK: ChunkId = 0xC0FFEE;
+
+    fn chunk(placement: Vec<DServerId>) -> ChunkRef {
+        ChunkRef {
+            id: CHUNK,
+            scheme: EcScheme::None,
+            len: 4,
+            placement,
+        }
+    }
+
+    fn group() -> SegmentGroup {
+        SegmentGroup::new(NONCE, EPOCH).unwrap()
+    }
+
+    /// A committed root over ONE segment carrying `chunk(vec![0])`, plus the home that
+    /// segment forms — the pair a resolve hands a repoint.
+    fn segmented_fixture() -> (InodeRecord, ChunkHome, SegmentRecord) {
+        let record = SegmentRecord::new(vec![chunk(vec![0])], 0).unwrap();
+        let map = SegmentedMap::new(
+            group(),
+            vec![SegmentRef {
+                index: 0,
+                byte_offset: 0,
+                byte_len: record.byte_len(),
+            }],
+        )
+        .unwrap();
+        let root = InodeRecord {
+            size: record.byte_len(),
+            chunk_map: ChunkMap::Segmented(map),
+            state: InodeState::Committed,
+            version: 1,
+            ..Default::default()
+        };
+        let home = ChunkHome::Segment {
+            segment: std::sync::Arc::new(SegmentHome {
+                key: seg_key(&group(), 0).unwrap(),
+                record: record.clone(),
+            }),
+            position: 0,
+        };
+        (root, home, record)
+    }
+
+    fn moved(from: DServerId, to: DServerId) -> MovedFragment {
+        MovedFragment {
+            frag: FragmentId {
+                chunk: CHUNK,
+                index: 0,
+            },
+            from,
+            to,
+        }
+    }
+
+    fn repoint<'a>(
+        prior_root: &'a InodeRecord,
+        home: &'a ChunkHome,
+        placement: Vec<DServerId>,
+        moved: &'a [MovedFragment],
+    ) -> Result<WriteBatch> {
+        repoint_chunk(&ChunkRepoint {
+            inode_id: INODE,
+            prior_root,
+            home,
+            placement,
+            moved,
+            pre_mark: orphan_evidence(500),
+            now_millis: 900,
+        })
+    }
+
+    fn reason(err: wyrd_traits::BoxError) -> ChunkMapError {
+        *err.downcast::<ChunkMapError>().expect("a typed refusal")
+    }
+
+    #[test]
+    fn a_flat_repoint_rewrites_only_the_placement_and_bumps_the_version() {
+        let prior = InodeRecord {
+            size: 4,
+            chunk_map: ChunkMap::Flat(vec![chunk(vec![0])]),
+            state: InodeState::Committed,
+            version: 4,
+            ..Default::default()
+        };
+        let home = ChunkHome::Root { position: 0 };
+        let batch = repoint(&prior, &home, vec![3], &[moved(0, 3)]).unwrap();
+
+        // The CAS is on the root's exact prior bytes, and the record it writes back differs
+        // in EXACTLY two ways: the placement, and `version + 1`.
+        assert_eq!(
+            batch.preconditions[0].expected.as_deref(),
+            Some(encode(&prior).as_ref())
+        );
+        let (key, value) = &batch.puts[0];
+        assert_eq!(key.as_slice(), inode_key(INODE).as_slice());
+        let next: InodeRecord = decode(value).unwrap();
+        assert_eq!(next.version, prior.version + 1, "one version forward");
+        assert_eq!(
