+    let damaged_before = meta.get(&damaged_seg).await.unwrap().unwrap();
+
+    // A healthy segmented object with its fragment on the server being drained.
+    let chunk: ChunkId = 0xB7;
+    let payload = b"the healthy object's fragment, evacuated past a damaged neighbour";
+    d0.put_fragment(frag(chunk, 0), none_fragment_bytes(chunk, payload))
+        .await
+        .unwrap();
+    let group = SegmentGroup::new("33334444555566667777888899990000", 2).unwrap();
+    seed_segmented(
+        &meta,
+        2,
+        &group,
+        vec![vec![none_chunk(chunk, 0, payload.len() as u64)]],
+        1,
+    )
+    .await;
+    set_lifecycle(&meta, 0, DServerLifecycle::Draining)
+        .await
+        .unwrap();
+
+    let mut topo = Topology::default();
+    topo.register(0, "A").register(1, "B");
+    let fleet: [(DServerId, &dyn ChunkStore); 2] = [(0, &d0), (1, &d1)];
+    let ctx = RebalanceContext {
+        meta: &meta,
+        fleet: &fleet,
+        topology: &topo,
+    };
+
+    let coord = MemCoordination::new();
+    let (zone, custodian) = elect(&coord, "zone-drain").await;
+    let outcome = reconcile_step(&zone, &custodian, None, None, None, Some(&ctx), 800)
+        .await
+        .expect("one unreadable record must not blank the whole drain");
+
+    assert_eq!(
+        outcome,
+        Reconciled::Blocked,
+        "an evacuation walk that skipped a record it could not read has NOT shown the drain \
+         converged — `Satisfied` here is read as 'you may decommission this box'"
+    );
+
+    // The healthy object was evacuated anyway...
+    let seg: SegmentRecord = metadata::decode(
+        &meta
+            .get(&metadata::seg_key(&group, 0).unwrap())
+            .await
+            .unwrap()
+            .unwrap(),
+    )
+    .unwrap();
+    assert_eq!(
+        seg.chunks()[0].placement,
+        vec![1],
+        "the healthy object's fragment moved off the draining server despite the damaged \
+         record met first in the walk"
+    );
+    assert!(
+        d1.get_fragment(frag(chunk, 0)).await.unwrap().is_some(),
+        "its copy is at the new home"
+    );
+
+    // ...and nothing of the unreadable object was moved, filled or rewritten on the way past.
+    assert_eq!(
+        meta.get(&damaged_seg).await.unwrap().unwrap(),
+        damaged_before,
+        "the record the pass could not read is byte-identical: never rewritten blind"
+    );
+}
