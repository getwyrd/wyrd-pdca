+// ---- criterion (4): O(N) resolutions per pass, not O(Q x N) ----
+
+#[tokio::test]
+async fn reconstruction_resolves_each_objects_root_once_per_pass_not_once_per_queued_chunk() {
+    let meta = MemMeta::default();
+    let d0 = MemDServer::default();
+    let d1 = MemDServer::default();
+    let d2 = MemDServer::default();
+
+    // N objects, each carrying CHUNKS_PER_OBJECT chunks that are ALREADY at full redundancy
+    // (every RS(2,1) fragment present and intact), and each chunk queued for repair — so
+    // Q = N x CHUNKS_PER_OBJECT obligations resolve over N objects with no rebuild in the
+    // way. The property under test is how many bounded `seg:` range reads that costs.
+    const N: usize = 3;
+    const CHUNKS_PER_OBJECT: usize = 2;
+    for object in 0..N {
+        let group = SegmentGroup::new(format!("{:032x}", object + 1), 5).unwrap();
+        let mut chunks = Vec::new();
+        for slot in 0..CHUNKS_PER_OBJECT {
+            let id: ChunkId = (object * CHUNKS_PER_OBJECT + slot + 1) as ChunkId;
+            let data =
+                format!("object {object} slot {slot}: this chunk is already healthy").into_bytes();
+            let shards = erasure::encode(2, 1, &data).unwrap();
+            for (index, store) in [(0u16, &d0), (1, &d1), (2, &d2)] {
+                store
+                    .put_fragment(
+                        frag(id, index),
+                        encode_ec_fragment(id, index, 2, 1, &shards[index as usize]),
+                    )
+                    .await
+                    .unwrap();
+            }
+            chunks.push(ChunkRef {
+                id,
+                scheme: EcScheme::ReedSolomon { k: 2, m: 1 },
+                len: data.len() as u64,
+                placement: vec![0, 1, 2],
+            });
+            repair::enqueue_repair(&meta, id, "test").await.unwrap();
+        }
+        seed_segmented(&meta, object as InodeId + 1, &group, vec![chunks], 1).await;
+    }
+    let queued = repair::queued_repairs(&meta).await.unwrap().len();
+    assert_eq!(
+        queued,
+        N * CHUNKS_PER_OBJECT,
+        "fixture: Q must exceed N, or O(N) and O(Q x N) are the same number"
+    );
+
+    let mut topo = Topology::default();
+    topo.register(0, "A").register(1, "B").register(2, "C");
+    let fleet: [(DServerId, &dyn ChunkStore); 3] = [(0, &d0), (1, &d1), (2, &d2)];
+    let ctx = ReconstructionContext {
+        meta: &meta,
+        fleet: &fleet,
+        topology: &topo,
+        unreachable: &[],
+    };
+
+    let coord = MemCoordination::new();
+    let (zone, custodian) = elect(&coord, "zone-cost").await;
+    let inode_scans_before = meta.inode_scans.load(Ordering::Relaxed);
+    let seg_reads_before = meta.seg_range_reads.load(Ordering::Relaxed);
+
+    reconcile_step(&zone, &custodian, None, None, Some(&ctx), None, 100)
+        .await
+        .expect("segmented objects must be resolvable by the repair loop");
+
+    let inode_scans = meta.inode_scans.load(Ordering::Relaxed) - inode_scans_before;
+    let seg_reads = meta.seg_range_reads.load(Ordering::Relaxed) - seg_reads_before;
+    // Each object's `seg:` range is read ONCE for the pass — O(N) — never once per queued
+    // chunk, which is O(Q x N) and what turns a repair loop into an availability failure at
+    // fleet scale. A bounded range costs one page here (its rows fit `SEGMENT_PAGE_LIMIT`),
+    // so N objects cost N reads.
+    assert_eq!(
+        seg_reads, N,
+        "each object's segment range must be read ONCE per pass: {N} objects, {queued} \
+         queued obligations, got {seg_reads} range reads"
+    );
+    assert_eq!(
+        inode_scans, 1,
+        "the committed namespace is scanned ONCE per pass, not once per queued obligation; \
+         got {inode_scans} scans for {queued} obligations"
+    );
+
+    // And the pass really did the work the count is about: every obligation was assessed and
+    // drained (each chunk is already at full redundancy), never left queued by a resolver
+    // that quietly failed.
+    assert!(
+        repair::queued_repairs(&meta).await.unwrap().is_empty(),
+        "every obligation was assessed — the cheap answer must also be the right one"
+    );
+}
