+            .map(|p| (p.key.clone(), p.expected.as_ref().map(|v| v.to_vec())))
+            .collect();
+        assert!(required.contains(&(seg.clone(), Some(encode(&record).to_vec()))));
+        assert!(required.contains(&(inode_key(INODE), Some(encode(&root).to_vec()))));
