+        Reconciled::Satisfied,
+        "nothing was filled (the only fill lost its CAS) and nothing was declined"
+    );
+
+    telemetry.flush().unwrap();
+    let exposed = telemetry
+        .gather_prometheus()
+        .expect("Prometheus surface configured");
+    assert_eq!(
+        gauge_value(&exposed, "backfill_placement_remaining"),
+        Some(2.0),
+        "both empty placements are still there after the lost CAS, and the gauge counts \
+         them; got:\n{exposed}"
+    );
+    assert_eq!(
+        gauge_value(&exposed, "backfill_records_unassessed"),
+        Some(0.0),
+        "the record was assessed — it simply lost its commit; got:\n{exposed}"
+    );
+}
