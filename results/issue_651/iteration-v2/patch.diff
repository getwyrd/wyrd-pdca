+// ---- criterion (3): backfill declines a segmented record, fills a flat one ----
+
+#[tokio::test]
+async fn backfill_leaves_a_segmented_record_byte_identical_while_filling_a_flat_one() {
+    let meta = MemMeta::default();
+
+    // The segmented object: a chunk with an EMPTY placement — exactly the shape backfill
+    // fills on a FLAT record, so nothing but the map's shape decides the outcome.
+    let seg_chunk: ChunkId = 0xE1;
+    let group = SegmentGroup::new("22223333444455556666777788889999", 1).unwrap();
+    seed_segmented(
+        &meta,
+        1,
+        &group,
+        vec![vec![ChunkRef {
+            id: seg_chunk,
+            scheme: EcScheme::None,
+            len: 5,
+            placement: vec![],
+        }]],
+        1,
+    )
+    .await;
+    let seg_key = metadata::seg_key(&group, 0).unwrap();
+    let seg_before = meta.get(&seg_key).await.unwrap().unwrap();
+    let root_key = metadata::inode_key(1);
+    let root_before = meta.get(&root_key).await.unwrap().unwrap();
+
+    // A FILLABLE flat object in the SAME store — the shape backfill has always filled.
+    let flat_chunk: ChunkId = 0xE2;
+    let flat_root = InodeRecord {
+        size: 7,
+        chunk_map: vec![ChunkRef {
+            id: flat_chunk,
+            scheme: EcScheme::None,
+            len: 7,
+            placement: vec![],
+        }]
+        .into(),
+        state: InodeState::Committed,
+        version: 1,
+        ..Default::default()
+    };
+    commit(
+        &meta,
+        WriteBatch::new().put(metadata::inode_key(2), metadata::encode(&flat_root)),
+    )
+    .await;
+
+    let ctx = BackfillContext { meta: &meta };
+    let outcome = backfill_reconcile(&ctx)
+        .await
+        .expect("a segmented record must be DECLINED with a stated reason, never propagate");
+    assert_eq!(
+        outcome,
+        Reconciled::Blocked,
+        "the pass declined a record it will not rewrite, so it must not certify the \
+         empty-placement population drained — an operator reads that gauge's zero as the \
+         precondition for removing the identity fallback"
+    );
+
+    // DECLINED, never rewritten blind: byte-identical, root included.
+    assert_eq!(
+        meta.get(&seg_key).await.unwrap().unwrap(),
+        seg_before,
+        "backfill must never rewrite a segmented record it did not read"
+    );
+    assert_eq!(
+        meta.get(&root_key).await.unwrap().unwrap(),
+        root_before,
+        "the segmented object's ROOT is untouched too"
+    );
+
+    // ...and the walk went on: the flat record beside it WAS filled in the same pass.
+    let flat_after: InodeRecord =
+        metadata::decode(&meta.get(&metadata::inode_key(2)).await.unwrap().unwrap()).unwrap();
+    assert_eq!(
+        flat_after.chunk_map.as_flat().unwrap()[0].placement,
+        vec![0],
+        "the fillable flat record's identity placement was materialized despite the \
+         declined record beside it"
+    );
+}
