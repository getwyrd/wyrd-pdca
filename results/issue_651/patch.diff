+        .await
+        .unwrap();
+    d[1].put_fragment(late, Bytes::from_static(b"late"))
+        .await
+        .unwrap();
+    d[2].put_fragment(stray, Bytes::from_static(b"stray"))
+        .await
+        .unwrap();
