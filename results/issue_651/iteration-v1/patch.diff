+// ---- criterion (4): reconstruction resolves each object's root ONCE per pass ----
+
+#[tokio::test]
+async fn reconstruction_resolves_each_objects_root_once_per_pass_not_once_per_queued_chunk() {
+    let inner = MemMeta::default();
+
+    // N=3 segmented objects, each ALREADY fully redundant (its one chunk's single
+    // fragment is present and intact) — nothing here needs an actual rebuild; the
+    // property under test is how many times each object's `seg:` range is READ while Q=6
+    // obligations (2 per object — a duplicate/stale finding apiece) are assessed.
+    const N: usize = 3;
+    const CHUNKS_PER_OBJECT: usize = 2;
+    let d0 = MemDServer::default();
+    let mut chunk_ids = Vec::new();
+    for object in 0..N {
+        let nonce = format!("{:032x}", object + 1);
+        let mut chunks = Vec::new();
+        for slot in 0..CHUNKS_PER_OBJECT {
+            let id: ChunkId = ((object * CHUNKS_PER_OBJECT + slot) as ChunkId) + 1;
+            let payload = format!("payload for object {object} slot {slot}");
+            d0.put_fragment(frag(id, 0), none_fragment_bytes(id, payload.as_bytes()))
+                .await
+                .unwrap();
+            chunks.push(none_chunk(id, 0, payload.len() as u64));
+            chunk_ids.push(id);
+        }
+        seed_one_segment(&inner, (object + 1) as InodeId, &nonce, 1, chunks).await;
+    }
+    for &id in &chunk_ids {
+        repair::enqueue_repair(&inner, id, "test").await.unwrap();
+    }
+    assert_eq!(
+        chunk_ids.len(),
+        N * CHUNKS_PER_OBJECT,
+        "Q = N * chunks-per-object obligations"
+    );
+
+    let meta = CountingMeta::new(inner);
+    let mut topo = Topology::default();
+    topo.register(0, "A");
+    let fleet: [(DServerId, &dyn ChunkStore); 1] = [(0, &d0)];
+    let ctx = ReconstructionContext {
+        meta: &meta,
+        fleet: &fleet,
+        topology: &topo,
+        unreachable: &[],
+    };
+
+    let coord = MemCoordination::new();
+    let (zone, custodian) = elect(&coord, "zone-5").await;
+    reconcile_step(&zone, &custodian, None, None, Some(&ctx), None, 1_000)
+        .await
+        .expect("every chunk is already fully redundant; nothing here should fail the pass");
+
+    // Q=6 obligations over N=3 objects: O(N), never O(Q x N) — the perf finding still open
+    // at #647's close. A per-queued-chunk resolver would read each object's `seg:` range
+    // once per OBLIGATION touching it (6 here, since every object has 2 of the 6 queued
+    // chunks) — 3 objects x 6 obligations checked-against would be a much larger count;
+    // this pass must cost exactly N=3 reads, one per object, regardless of Q.
+    assert_eq!(
+        meta.seg_range_reads(),
+        N,
+        "reconstruction must resolve each object's chunk map ONCE per pass, not once per \
+         queued chunk"
+    );
+}
