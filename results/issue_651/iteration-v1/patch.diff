+// ---- property 10: a repoint loses to a concurrent supersede (issue #651, proposal 0016
+//      decision 7(f), the `seg:` row's writer (2), `0016:354`) ----
+//
+// Shipped in THIS slice and exercised by the gating `cargo xtask ci` / `dst` tier over the
+// whole madsim seed sweep — deliberately NOT by the per-fix `C4-verify` check, which would
+// have to build the `--cfg madsim` tree and sweep 50 seeds to see it (brief `Verification
+// posture`). Built and run this cycle; not deferred work.
+//
+// `prop_segmented_resolve_never_tears` (property 9) proves the READ side of decision 7(h):
+// a resolve that meets a retired generation mid-range-read restarts onto the live root. This
+// property proves the WRITE side a maintenance repoint adds (decision 7(f)): a repoint that
+// resolved a clean home BEFORE a concurrent supersede, and only reaches its own commit
+// AFTER it, must not silently land in (or corrupt) the generation that replaced it. The
+// second precondition `repoint_chunk` carries — `require(inode_key, encode(prior_root))`,
+// beside the segment's own `require(seg_key, encode(prior_segment))` — is what makes that
+// repoint LOSE the compare-and-swap rather than overwrite a retired generation's record or
+// resurrect it as live.
+
+/// A [`ChunkStore`] that, the FIRST time it is asked for ANY fragment, commits a pending
+/// metadata mutation before answering — the exact window a maintenance repoint's OWN commit
+/// races: `plan_evacuations` has already resolved a clean home over the OLD generation, and
+/// `evacuate_chunk`'s very next store call (gathering the fragment to copy) is the last point
+/// before its commit where a concurrent writer can still get in first.
+struct SupersedeOnFetch<'a> {
+    inner: &'a MemDServer,
+    meta: &'a MemMeta,
+    pending: Mutex<Option<WriteBatch>>,
+}
+
+#[async_trait]
+impl ChunkStore for SupersedeOnFetch<'_> {
+    async fn put_fragment(&self, id: FragmentId, fragment: Bytes) -> Result<()> {
+        self.inner.put_fragment(id, fragment).await
+    }
+
+    async fn get_fragment(&self, id: FragmentId) -> Result<Option<Bytes>> {
+        let pending = self.pending.lock().unwrap().take();
+        if let Some(batch) = pending {
+            assert_eq!(
+                self.meta.commit(batch).await.unwrap(),
+                CommitOutcome::Committed
+            );
+        }
+        self.inner.get_fragment(id).await
+    }
+
+    async fn list_fragments(&self) -> Result<Vec<FragmentId>> {
+        self.inner.list_fragments().await
+    }
+
+    async fn delete_fragment(&self, id: FragmentId) -> Result<()> {
+        self.inner.delete_fragment(id).await
+    }
+
+    async fn health(&self) -> Result<Health> {
+        Ok(Health::Healthy)
+    }
+}
+
+/// A segment-group nonce for this property's fixture, distinct from every other property's.
+const REPOINT_SUPERSEDE_NONCE: &str = "99999999999999999999999999999999";
+
+async fn prop_repoint_loses_to_a_concurrent_supersede(rng: &mut ChaCha8Rng) {
+    let d = servers();
+    let fleet = fleet_of(&d);
+    let meta = MemMeta::default();
+
+    // A segmented object over TWO chunks (so the pass plans two independent evacuations),
+    // both of whose fragments land on server 0 (`EcScheme::None`'s identity route, since
+    // this fixture assigns no explicit placement — the same shape `seed_segmented` always
+    // produces): draining server 0 evacuates both.
+    let old_len = 8 + (rng.next_u32() as usize % 8) * 2;
+    let old_data: Vec<u8> = (0..old_len as u16).map(|i| i as u8).collect();
+    let group = metadata::SegmentGroup::new(REPOINT_SUPERSEDE_NONCE, 1).unwrap();
+    // Reuses `seed_segmented`'s own group/nonce shape is not an option (it hard-codes
+    // `RESOLVE_TEAR_NONCE`), so this fixture is built the same way, inline, under its own
+    // nonce — every other property's fixture stays untouched.
+    let mut next = 0u128;
+    let old_plan = write::plan_write(&old_data, 4, EcScheme::None, || {
+        next += 1;
+        next
+    })
+    .unwrap();
+    write::intent(&meta, &old_plan, 1_000).await.unwrap();
+    write::write_fragments(&fleet, &old_plan).await.unwrap();
+    assert_eq!(
+        write::commit_create(&meta, ROOT, "obj", INODE, &old_plan, 0)
+            .await
+            .unwrap(),
+        CommitOutcome::Committed
+    );
+    write::release(&meta, &old_plan).await.unwrap();
+    let old_chunks = old_plan.chunk_refs();
+    let half = old_chunks.len() / 2;
+    let first = metadata::SegmentRecord::new(old_chunks[..half].to_vec(), 0).unwrap();
+    let second =
+        metadata::SegmentRecord::new(old_chunks[half..].to_vec(), first.byte_len()).unwrap();
+    let seg_ref = |index: u32, byte_offset: u64, byte_len: u64| metadata::SegmentRef {
+        index,
+        byte_offset,
+        byte_len,
+    };
+    let table = metadata::SegmentedMap::new(
+        group.clone(),
+        vec![
+            seg_ref(0, 0, first.byte_len()),
+            seg_ref(1, first.byte_len(), second.byte_len()),
+        ],
+    )
+    .unwrap();
+    let old_root = InodeRecord {
+        size: table.span(),
+        chunk_map: metadata::ChunkMap::Segmented(table),
+        state: InodeState::Committed,
+        version: 1,
+        ..Default::default()
+    };
+    let seed_batch = WriteBatch::new()
+        .put(seg_row(&group, 0), metadata::encode(&first))
+        .put(seg_row(&group, 1), metadata::encode(&second))
+        .put(metadata::inode_key(INODE), metadata::encode(&old_root));
+    assert_eq!(
+        meta.commit(seed_batch).await.unwrap(),
+        CommitOutcome::Committed
+    );
+    let seg0_before = meta.get(&seg_row(&group, 0)).await.unwrap().unwrap();
+    let seg1_before = meta.get(&seg_row(&group, 1)).await.unwrap().unwrap();
+
+    // The generation that SUPERSEDES it: a brand-new flat object, its fragment already
+    // durable (the write protocol's own fragments-before-metadata order) — only the root
+    // flip is deferred to race the repoint's own commit.
+    let new_len = 4 + (rng.next_u32() as usize % 16);
+    let new_data: Vec<u8> = (0..new_len).map(|_| rng.next_u32() as u8).collect();
+    let mut next_new = 0x9000u128;
+    let new_plan = write::plan_write(&new_data, new_data.len().max(1), EcScheme::None, || {
+        next_new += 1;
+        next_new
+    })
+    .unwrap();
+    write::write_fragments(&fleet, &new_plan).await.unwrap();
+    let new_root = InodeRecord {
+        size: new_plan.size,
+        chunk_map: new_plan.chunk_refs().into(),
+        state: InodeState::Committed,
+        version: 2,
+        ..Default::default()
+    };
+    let supersede = WriteBatch::new().put(metadata::inode_key(INODE), metadata::encode(&new_root));
+
+    set_lifecycle(&meta, 0, DServerLifecycle::Draining)
+        .await
+        .unwrap();
+
+    let source = SupersedeOnFetch {
+        inner: &d[0],
+        meta: &meta,
+        pending: Mutex::new(Some(supersede)),
+    };
+    let topo = four_domains();
+    let dyn_fleet: [(DServerId, &dyn ChunkStore); 4] =
+        [(0, &source), (1, &d[1]), (2, &d[2]), (3, &d[3])];
+    let ctx = RebalanceContext {
+        meta: &meta,
+        fleet: &dyn_fleet,
+        topology: &topo,
+    };
+
+    let coord = MemCoordination::new();
+    let (zone, custodian) = elect(&coord, "zone-repoint-supersede").await;
+    let outcome = reconcile_step(&zone, &custodian, None, None, None, Some(&ctx), 500)
+        .await
+        .expect("a repoint racing a supersede must lose the CAS, never fail the whole pass");
+
+    // NOTHING was actually persisted by the drain: both evacuations were planned against
+    // the OLD generation and lost their commit to the supersede's version bump.
+    assert_ne!(
+        outcome,
+        Reconciled::Changed,
+        "a repoint that raced a supersede must never report a persisted move"
+    );
+
+    // The LIVE generation is exactly the one that superseded it — intact, never torn or
+    // clobbered by the losing repoint.
+    assert_eq!(
+        read_inode(&meta).await.chunk_map.as_flat().unwrap(),
+        new_plan.chunk_refs().as_slice(),
+        "the live generation after the supersede must be exactly the new one"
+    );
+    assert_eq!(
+        read_object(&meta, &fleet, INODE).await.unwrap(),
+        Some(new_data),
+        "the live generation reads back correctly after the race"
+    );
+
+    // The RETIRED generation's own `seg:` records are untouched: a losing repoint refuses,
+    // it never persists into (or corrupts) a generation nothing live names any more.
+    assert_eq!(
+        meta.get(&seg_row(&group, 0)).await.unwrap().unwrap(),
+        seg0_before,
+        "segment 0 of the retired generation must be byte-identical after the losing repoint"
+    );
+    assert_eq!(
+        meta.get(&seg_row(&group, 1)).await.unwrap().unwrap(),
+        seg1_before,
+        "segment 1 of the retired generation must be byte-identical after the losing repoint"
+    );
+}
