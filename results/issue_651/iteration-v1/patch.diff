+// ---------------------------------------------------------------------------
+// Chunk repoint (proposal 0016 decision 7(f), issue #651)
+// ---------------------------------------------------------------------------
+//
+// A repair (reconstruction / rebalance) moves a chunk's FRAGMENTS, never its content —
+// so what it repoints is the ONE record that carries the chunk's `ChunkRef`: the inode
+// root for a flat map, or the chunk's own `seg:<nonce>:<epoch>:<index>` record for a
+// segmented one (`0016:354`, the `seg:` row's writer (2)). [`ChunkHome`] is that
+// record's identity, resolved once per pass alongside the chunk itself
+// ([`resolve_chunk_homes`]); [`repoint_chunk`] is the exact-bytes CAS that writes the
+// new placement back into it, refusing rather than persisting a record the ceiling
+// would then make permanently un-overwritable (`docs/principles.md` §5 C-1 — every CAS
+// here is `require(key, encode(prior))`, so a record grown past the ceiling could never
+// be repointed again).
+
+/// The record that carries one resolved chunk's `ChunkRef` — what a maintenance repoint
+/// (reconstruction's rebuild, rebalance's evacuation) compare-and-swaps when it moves
+/// the chunk's fragments (`0016:354`, decision 7(f)).
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum ChunkHome {
+    /// A flat map's chunk: the inode root itself carries the `ChunkRef`, at `position`.
+    Root {
+        /// The chunk's position in the flat map.
+        position: usize,
+    },
+    /// A segmented map's chunk: segment record `key` carries it, at `position` within
+    /// that segment's own chunk list. `record` is the segment as this resolve read it —
+    /// re-encoding it is the CAS precondition, the same decode-then-`encode(&prior)`
+    /// pattern every other custodian CAS in this module already uses.
+    Segment {
+        /// The segment record's key (`seg:<nonce>:<epoch>:<index>`).
+        key: Vec<u8>,
+        /// The segment record as resolved.
+        record: SegmentRecord,
+        /// The chunk's position inside that segment's own chunk list.
+        position: usize,
+    },
+}
+
+/// One resolved chunk together with the record that carries it.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct HomedChunk {
+    /// The chunk itself.
+    pub chunk: ChunkRef,
+    /// Where its `ChunkRef` lives.
+    pub home: ChunkHome,
+}
+
+/// [`resolve_snapshot`]'s twin for a maintenance repoint: not just the ordered chunks,
+/// but which record carries each one. Built over the SAME segment read
+/// ([`read_segments`]) and the SAME resolve-retry rule (decision 7(h)) as the read
+/// path's resolver, so the two can never disagree about which generation a chunk came
+/// from.
+async fn resolve_snapshot_homes(
+    store: &dyn MetadataStore,
+    root_key: &[u8],
+    record: &InodeRecord,
+) -> Result<Resolution<Vec<HomedChunk>>> {
+    let map = match &record.chunk_map {
+        ChunkMap::Flat(chunks) => {
+            return Ok(Resolution::Answer(
+                chunks
+                    .iter()
+                    .enumerate()
+                    .map(|(position, chunk)| HomedChunk {
+                        chunk: chunk.clone(),
+                        home: ChunkHome::Root { position },
+                    })
+                    .collect(),
+            ))
+        }
+        ChunkMap::Segmented(map) => map,
+    };
+    let group = map.group();
+    Ok(read_segments(store, root_key, map).await?.map(|segments| {
+        let mut homed = Vec::new();
+        for (index, seg_record) in segments {
+            // Every index here came from the root's own validated table, which
+            // `SegmentedMap::new` already bounded to the addressable key space
+            // (`checked_segment_index`), so `seg_key` cannot fail on it.
+            let key = seg_key(group, index).unwrap_or_default();
+            for (position, chunk) in seg_record.chunks().iter().enumerate() {
+                homed.push(HomedChunk {
+                    chunk: chunk.clone(),
+                    home: ChunkHome::Segment {
+                        key: key.clone(),
+                        record: seg_record.clone(),
+                        position,
+                    },
+                });
+            }
+        }
+        homed
+    }))
+}
+
+/// Resolve a caller's own committed snapshot to its chunks-with-homes — the
+/// [`resolve_chunk_map`] twin a maintenance repoint needs. A generation superseded
+/// mid-resolve restarts onto the live root ([`resolve_current_chunk_homes`]); one found
+/// **gone** answers `Ok(None)`, the same "no such object" every consumer already reads.
+pub async fn resolve_chunk_homes(
+    store: &dyn MetadataStore,
+    root_key: &[u8],
+    record: &InodeRecord,
+) -> Result<Option<(InodeRecord, Vec<HomedChunk>)>> {
+    match resolve_snapshot_homes(store, root_key, record).await? {
+        Resolution::Answer(homed) => Ok(Some((record.clone(), homed))),
+        Resolution::Superseded => resolve_current_chunk_homes(store, root_key).await,
+        Resolution::Gone => Ok(None),
+    }
+}
+
+/// [`resolve_current_chunk_map`]'s twin: resolve the chunk map of the root the store
+/// holds **now**, with homes, for a caller whose own snapshot may already be stale.
+pub async fn resolve_current_chunk_homes(
+    store: &dyn MetadataStore,
+    root_key: &[u8],
+) -> Result<Option<(InodeRecord, Vec<HomedChunk>)>> {
+    for _ in 0..MAX_RESOLVE_RESTARTS {
+        let Some(bytes) = store.get(root_key).await? else {
+            return Ok(None);
+        };
+        let record = decode_root_record(&bytes)?;
+        if record.state != InodeState::Committed {
+            return Ok(None);
+        }
+        match resolve_snapshot_homes(store, root_key, &record).await? {
+            Resolution::Answer(homed) => return Ok(Some((record, homed))),
+            Resolution::Gone => return Ok(None),
+            Resolution::Superseded => {}
+        }
+    }
+    Err(ChunkMapError::MapResolutionUnstable {
+        attempts: MAX_RESOLVE_RESTARTS,
+    }
+    .into())
+}
+
+/// The compare-and-swap that **repoints** one chunk: rewrite the `placement` of the
+/// `ChunkRef` [`ChunkHome`] names, in whichever record carries it, and nothing else —
+/// the chunk's id, scheme and length are carried over unchanged from the record this
+/// CAS is preconditioned on, so a repoint can only ever be a *move*, never a
+/// republication of different content under a committed chunk id.
+///
+/// * a flat map's chunk: `require(inode_key == prior_root)` + the rewritten root at
+///   `version + 1` — exactly the shape every repair/rebalance CAS already used before
+///   the segmented shape existed;
+/// * a segmented map's chunk: `require(seg_key == prior_segment)` **and**
+///   `require(inode_key == prior_root)` — the second precondition is what makes the
+///   repoint lose to a concurrent supersede/delete of the generation (decision 7(f)):
+///   the root is not rewritten (its version does not move), but a repoint racing a
+///   retirement that swept the segment record out from under it must not resurrect a
+///   generation nothing live names any more.
+///
+/// **Refuses rather than persists a record the move would push past the value
+/// ceiling** (`docs/principles.md` §5 C-1): every CAS in this module is
+/// `require(key, encode(prior))`, so a record that grew past what the backend accepts
+/// could never be repointed again — a permanent, not merely costly, failure. A
+/// `DServerId` renders in 1 to 20 decimal digits, so moving a chunk's fragments onto
+/// high-numbered servers can grow the record that carries it even though the
+/// placement vector's *length* never changes; refusing here, before anything is
+/// written, turns that into a typed, attributed refusal of one chunk's move rather than
+/// a write the backend rejects permanently from a layer that cannot say which record
+/// was too big.
+///
+/// The caller adds its own mutations (the repair-queue drain, the `orphan:` evidence
+/// for the vacated position) to the returned batch and commits it.
+pub fn repoint_chunk(
+    inode_id: InodeId,
+    prior_root: &InodeRecord,
+    home: &ChunkHome,
+    placement: Vec<DServerId>,
+) -> Result<WriteBatch> {
+    let root_key = inode_key(inode_id);
+    match home {
+        ChunkHome::Root { position } => {
+            let mut chunks = prior_root
+                .chunk_map
+                .as_flat()
+                .ok_or(ChunkMapError::MapShapeChanged)?
+                .to_vec();
+            let slot = chunks
+                .get_mut(*position)
+                .ok_or(ChunkMapError::ChunkPositionOutOfRange {
+                    position: *position,
+                })?;
+            slot.placement = placement;
+            let next_root = InodeRecord {
+                chunk_map: ChunkMap::Flat(chunks),
+                version: prior_root.version + 1,
+                ..prior_root.clone()
+            };
+            let batch = WriteBatch::new()
+                .require(root_key.clone(), encode(prior_root))
+                .put(root_key, encode(&next_root));
+            check_record_ceilings(&batch)?;
+            Ok(batch)
+        }
+        ChunkHome::Segment {
+            key,
+            record,
+            position,
+        } => {
+            // The home and the (possibly-restarted) root must still agree: a home
+            // resolved from a generation the root has since moved off would otherwise
+            // satisfy `require(seg == prior)` against a record no live consumer reads
+            // any more while `require(inode == prior_root)` holds against a root that
+            // never named it — the repoint would report success while writing into a
+            // retired generation.
+            let table = prior_root
+                .chunk_map
+                .segmented()
+                .ok_or(ChunkMapError::MapShapeChanged)?;
+            let (nonce, epoch, index) = parse_seg_key(key)?;
+            if nonce != *table.group().nonce()
+                || epoch != table.group().epoch()
+                || !table.segments().iter().any(|s| s.index == index)
+            {
+                return Err(ChunkMapError::MapShapeChanged.into());
+            }
+            let mut chunks = record.chunks().to_vec();
+            let slot = chunks
+                .get_mut(*position)
+                .ok_or(ChunkMapError::ChunkPositionOutOfRange {
+                    position: *position,
+                })?;
+            slot.placement = placement;
+            let next_record = SegmentRecord::new(chunks, record.byte_offset())?;
+            let batch = WriteBatch::new()
+                .require(key.clone(), encode(record))
+                .require(root_key, encode(prior_root))
+                .put(key.clone(), encode(&next_record));
+            check_record_ceilings(&batch)?;
+            Ok(batch)
+        }
+    }
+}
+
+/// Refuse a batch carrying any single **put** whose value is over the value ceiling
+/// every backend inherits ([`MAX_VALUE_BYTES`]) — the whole-batch guard
+/// [`repoint_chunk`] runs before returning: a repair/rebalance repoint must never
+/// commit a record the backend would then reject, and a record it did accept but that
+/// exceeds the ceiling is one no future `require(key, encode(prior))` could ever
+/// overwrite again (`docs/principles.md` §5 C-1).
+fn check_record_ceilings(batch: &WriteBatch) -> std::result::Result<(), ChunkMapError> {
+    for (key, value) in &batch.puts {
+        check_value_ceiling(key, value)?;
+    }
+    Ok(())
+}
+
+/// One record's encoded value against [`MAX_VALUE_BYTES`] — [`check_record_ceilings`]'s
+/// per-record primitive.
+fn check_value_ceiling(key: &[u8], value: &[u8]) -> std::result::Result<(), ChunkMapError> {
+    if value.len() > MAX_VALUE_BYTES {
+        return Err(ChunkMapError::ValueOverCeiling {
+            key: String::from_utf8_lossy(key).into_owned(),
+            bytes: value.len(),
+            ceiling: MAX_VALUE_BYTES,
+        });
+    }
+    Ok(())
+}
