+// ---- criterion (2), ceiling half: a repoint over the value ceiling is refused ----
+
+#[tokio::test]
+async fn a_repoint_over_the_value_ceiling_is_refused_not_persisted() {
+    let meta = MemMeta::default();
+    let d0 = MemDServer::default();
+    let d3 = MemDServer::default();
+
+    let target: ChunkId = 0xD1;
+    let payload = b"the chunk this pass tries (and must refuse) to repoint";
+    d0.put_fragment(frag(target, 0), none_fragment_bytes(target, payload))
+        .await
+        .unwrap();
+
+    // Inflate the SAME segment record with filler chunks — real, valid, and placed on a
+    // server that is never draining, so rebalance never even builds a plan for them (an
+    // empty `evac` set is a fast `continue`, not an I/O-costing evacuation attempt) — until
+    // the record's own encoded size passes the value ceiling every backend inherits. Only
+    // `target`'s placement is on the draining server; only it is evacuated, and doing so
+    // must rewrite this WHOLE (now oversized) record.
+    let mut chunks = vec![none_chunk(target, 0, payload.len() as u64)];
+    let mut filler_id: ChunkId = 1;
+    loop {
+        let probe = SegmentRecord::new(chunks.clone(), 0).unwrap();
+        if metadata::encode(&probe).len() > MAX_VALUE_BYTES {
+            break;
+        }
+        chunks.push(none_chunk(filler_id, 99, 1));
+        filler_id += 1;
+    }
+    assert!(
+        chunks.len() > 1,
+        "the fixture must actually grow the record past the ceiling"
+    );
+
+    seed_one_segment(&meta, 1, "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", 9, chunks).await;
+    set_lifecycle(&meta, 0, DServerLifecycle::Draining)
+        .await
+        .unwrap();
+
+    let group = SegmentGroup::new("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", 9).unwrap();
+    let seg_key = metadata::seg_key(&group, 0).unwrap();
+    let seg_bytes_before = meta.get(&seg_key).await.unwrap().unwrap();
+    assert!(
+        seg_bytes_before.len() > MAX_VALUE_BYTES,
+        "fixture sanity: the seeded record must already be over the ceiling"
+    );
+
+    let mut topo = Topology::default();
+    topo.register(0, "A").register(3, "D");
+    let fleet: [(DServerId, &dyn ChunkStore); 2] = [(0, &d0), (3, &d3)];
+    let ctx = RebalanceContext {
+        meta: &meta,
+        fleet: &fleet,
+        topology: &topo,
+    };
+
+    let coord = MemCoordination::new();
+    let (zone, custodian) = elect(&coord, "zone-4").await;
+    // Refused, not a hard error: the pass still answers, it just could not persist this
+    // one chunk's move.
+    let outcome = reconcile_step(&zone, &custodian, None, None, None, Some(&ctx), 900)
+        .await
+        .expect("a refused repoint must not fail the whole pass");
+    assert_ne!(
+        outcome,
+        Reconciled::Changed,
+        "nothing was actually persisted — the refused repoint commits nothing"
+    );
+
+    // REFUSED, NOT PERSISTED: the record is byte-identical to what it was before the pass.
+    let seg_bytes_after = meta.get(&seg_key).await.unwrap().unwrap();
+    assert_eq!(
+        seg_bytes_before, seg_bytes_after,
+        "a repoint that would push a record past the value ceiling must never be persisted"
+    );
+    let seg_record: SegmentRecord = metadata::decode(&seg_bytes_after).unwrap();
+    assert_eq!(
+        seg_record.chunks()[0].placement,
+        vec![0],
+        "the placement was never repointed — still the ORIGINAL (draining) server"
+    );
+}
