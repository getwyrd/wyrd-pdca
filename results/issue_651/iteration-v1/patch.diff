+// ---- criterion (2), repair half: reconstruction resolves a chunk inside a `seg:` record ----
+
+#[tokio::test]
+async fn reconstruction_repairs_a_chunk_whose_chunkref_lives_in_a_segmented_record() {
+    let meta = MemMeta::default();
+    let d0 = MemDServer::default();
+    let d2 = MemDServer::default();
+    let d3 = MemDServer::default();
+
+    let chunk: ChunkId = 0xB1;
+    let data = b"reconstruct this erasure-coded chunk living in a seg: record".to_vec();
+    let shards = erasure::encode(2, 1, &data).unwrap();
+    // Placed on servers 0,1,2 (domains A,B,C) — server 1 (domain B) is LOST: its
+    // fragment is never written and its store is excluded from the fleet below.
+    d0.put_fragment(
+        frag(chunk, 0),
+        encode_ec_fragment(chunk, 0, 2, 1, &shards[0]),
+    )
+    .await
+    .unwrap();
+    d2.put_fragment(
+        frag(chunk, 2),
+        encode_ec_fragment(chunk, 2, 2, 1, &shards[2]),
+    )
+    .await
+    .unwrap();
+
+    seed_one_segment(
+        &meta,
+        1,
+        "fedcba9876543210fedcba9876543210",
+        3,
+        vec![ChunkRef {
+            id: chunk,
+            scheme: EcScheme::ReedSolomon { k: 2, m: 1 },
+            len: data.len() as u64,
+            placement: vec![0, 1, 2],
+        }],
+    )
+    .await;
+    repair::enqueue_repair(&meta, chunk, "test").await.unwrap();
+
+    let mut topo = Topology::default();
+    topo.register(0, "A").register(3, "D");
+    let healthy_fleet: [(DServerId, &dyn ChunkStore); 2] = [(0, &d0), (3, &d3)];
+    // d2 must still be reachable so its survivor fragment can be gathered.
+    let full_fleet: [(DServerId, &dyn ChunkStore); 3] = [(0, &d0), (2, &d2), (3, &d3)];
+    let _ = healthy_fleet; // documents the "server 1 excluded" framing above
+    let ctx = ReconstructionContext {
+        meta: &meta,
+        fleet: &full_fleet,
+        topology: &topo,
+        unreachable: &[],
+    };
+
+    let coord = MemCoordination::new();
+    let (zone, custodian) = elect(&coord, "zone-2").await;
+    let root_before = meta.get(&metadata::inode_key(1)).await.unwrap().unwrap();
+
+    let outcome = reconcile_step(&zone, &custodian, None, None, Some(&ctx), None, 500)
+        .await
+        .expect(
+            "a segmented object's under-replicated chunk must be reconstructed, not fail the \
+             whole pass",
+        );
+    assert_eq!(
+        outcome,
+        Reconciled::Changed,
+        "the under-replicated chunk inside the seg: record was reconstructed"
+    );
+
+    // The obligation is DRAINED — never silently dropped as "referenced by no committed
+    // chunk map" (the acute defect this criterion binds).
+    assert!(
+        repair::queued_repairs(&meta).await.unwrap().is_empty(),
+        "the repair obligation must be drained by the reconstruction commit"
+    );
+
+    // The root itself is UNCHANGED (a segmented repoint targets the `seg:` record, never
+    // rewrites the root) — the walk repoints exactly the record that carries the chunk.
+    let root_after = meta.get(&metadata::inode_key(1)).await.unwrap().unwrap();
+    assert_eq!(
+        root_before, root_after,
+        "a segmented repoint must not rewrite the inode root"
+    );
+
+    // The `seg:` record's placement now names the rebuilt fragment's new home: the only
+    // free distinct domain, D (server 3).
+    let group = SegmentGroup::new("fedcba9876543210fedcba9876543210", 3).unwrap();
+    let seg_bytes = meta
+        .get(&metadata::seg_key(&group, 0).unwrap())
+        .await
+        .unwrap()
+        .unwrap();
+    let seg_record: SegmentRecord = metadata::decode(&seg_bytes).unwrap();
+    assert_eq!(
+        seg_record.chunks()[0].placement,
+        vec![0, 3, 2],
+        "the rebuilt fragment was re-placed on a healthy D server in a distinct domain"
+    );
+    let rebuilt = d3
+        .get_fragment(frag(chunk, 1))
+        .await
+        .unwrap()
+        .expect("fragment present after repair");
+    assert!(
+        repair::fragment_intact(
+            &rebuilt,
+            frag(chunk, 1),
+            EcScheme::ReedSolomon { k: 2, m: 1 }
+        ),
+        "the rebuilt fragment verifies its checksum and belongs to the chunk"
+    );
+}
