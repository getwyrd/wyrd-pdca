+// ---- criterion (3): backfill declines a segmented record, fills a flat one ----
+
+#[tokio::test]
+async fn backfill_leaves_a_segmented_record_byte_identical_while_filling_a_flat_one_in_the_same_pass(
+) {
+    let meta = MemMeta::default();
+
+    // The segmented object: a chunk with an EMPTY placement — exactly the shape backfill
+    // fills on a FLAT record. Seeded raw, never through a committer.
+    let seg_chunk: ChunkId = 0xE1;
+    seed_one_segment(
+        &meta,
+        1,
+        "22223333444455556666777788889999",
+        1,
+        vec![ChunkRef {
+            id: seg_chunk,
+            scheme: EcScheme::None,
+            len: 5,
+            placement: vec![],
+        }],
+    )
+    .await;
+    let group = SegmentGroup::new("22223333444455556666777788889999", 1).unwrap();
+    let seg_key = metadata::seg_key(&group, 0).unwrap();
+    let seg_bytes_before = meta.get(&seg_key).await.unwrap().unwrap();
+    let root_key = metadata::inode_key(1);
+    let root_bytes_before = meta.get(&root_key).await.unwrap().unwrap();
+
+    // A FILLABLE flat object in the SAME store — an empty-placement committed chunk,
+    // exactly the shape backfill has always filled.
+    let flat_chunk: ChunkId = 0xE2;
+    let flat_root = InodeRecord {
+        size: 7,
+        chunk_map: vec![ChunkRef {
+            id: flat_chunk,
+            scheme: EcScheme::None,
+            len: 7,
+            placement: vec![],
+        }]
+        .into(),
+        state: InodeState::Committed,
+        version: 1,
+        ..Default::default()
+    };
+    commit(
+        &meta,
+        WriteBatch::new().put(metadata::inode_key(2), metadata::encode(&flat_root)),
+    )
+    .await;
+
+    let ctx = BackfillContext { meta: &meta };
+    let outcome = backfill_reconcile(&ctx)
+        .await
+        .expect("a segmented record must be declined with a stated reason, never propagate");
+    assert_eq!(
+        outcome,
+        Reconciled::Changed,
+        "the fillable FLAT record must still be filled in the SAME pass"
+    );
+
+    // The segmented record is BYTE-IDENTICAL — declined, never rewritten blind.
+    let seg_bytes_after = meta.get(&seg_key).await.unwrap().unwrap();
+    assert_eq!(
+        seg_bytes_before, seg_bytes_after,
+        "backfill must never rewrite a segmented record it did not read"
+    );
+    let root_bytes_after = meta.get(&root_key).await.unwrap().unwrap();
+    assert_eq!(
+        root_bytes_before, root_bytes_after,
+        "the segmented object's ROOT is untouched too"
+    );
+
+    // The flat record's empty placement WAS materialized.
+    let flat_after: InodeRecord =
+        metadata::decode(&meta.get(&metadata::inode_key(2)).await.unwrap().unwrap()).unwrap();
+    assert_eq!(
+        flat_after.chunk_map.as_flat().unwrap()[0].placement,
+        vec![0],
+        "the flat record's identity placement was filled in despite the segmented record \
+         beside it"
+    );
+}
