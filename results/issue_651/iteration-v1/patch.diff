+//! Issue #651 (slice 4 of 6 of the #635 re-slicing, 0016 decision 7(e)/(f)): **the
+//! remaining maintenance consumers — restore, reconstruction, backfill, rebalance — route
+//! through the resolver under the same per-object containment [`segmented_map_consumers.rs`]
+//! (#650) proves for GC/scrub, and a repoint never persists a record past the value ceiling.**
+//!
+//! A **NEW** file — deliberately, not an addition to `segmented_map_consumers.rs`: that file
+//! is unmodified (its own module doc says so) so THIS file is the sole `ADDED_TEST`
+//! discriminator the falsifiability check keys on. Every fixture here is a raw `seg:` record
+//! plus a segmented root, seeded directly — this slice ships no producer of a segmented map
+//! (that is #653's staged-publication committer); only base-visible symbols are imported (the
+//! `crates/custodian/tests/gc.rs:33-40` set, plus `reconcile_after_restore`/`RestoreReport`),
+//! so the file still COMPILES with this patch reverted and the RED leg is an assertion
+//! failure, never a build error.
+//!
+//! Every criterion is driven through the real fenced control point
+//! ([`reconcile_step`](wyrd_custodian::reconcile_step)) or the real operator entry point
+//! ([`reconcile_after_restore`](wyrd_custodian::reconcile_after_restore)) — never a
+//! parallel/stand-in entry — over in-memory trait doubles (Option A, `0005:524-527`).
+//!
+//! 1. `stranded_marked_is_zero_across_a_full_reconcile_over_segmented_objects` — criterion
+//!    (1): post-restore reconciliation never strands a segmented object's fragments.
+//! 2. `reconstruction_repairs_a_chunk_whose_chunkref_lives_in_a_segmented_record` — criterion
+//!    (2), the repair half: an under-replicated chunk inside a `seg:` record is rebuilt, not
+//!    silently drained as "referenced by no committed chunk map".
+//! 3. `rebalance_evacuates_a_segmented_chunk_off_a_draining_server` — criterion (2), the
+//!    evacuation half.
+//! 4. `a_repoint_over_the_value_ceiling_is_refused_not_persisted` — criterion (2), the
+//!    ceiling half: observed through a rebalance pass over an oversized `seg:` record (this
+//!    file never calls the ceiling helper or `repoint_chunk` directly — both are patch-added,
+//!    not base-visible).
+//! 5. `backfill_leaves_a_segmented_record_byte_identical_while_filling_a_flat_one_in_the_same_pass`
+//!    — criterion (3).
+//! 6. `reconstruction_resolves_each_objects_root_once_per_pass_not_once_per_queued_chunk` —
+//!    criterion (4), counted on an instrumented store double: Q=6 obligations over N=3
+//!    segmented objects cost N=3 segment-range resolutions, never Q\*N=18.
+
+#![forbid(unsafe_code)]
+
+use std::collections::HashMap;
+use std::sync::atomic::{AtomicUsize, Ordering};
+use std::sync::Mutex;
+
+use async_trait::async_trait;
+use bytes::Bytes;
+use wyrd_coordination_mem::MemCoordination;
+use wyrd_core::erasure;
+use wyrd_core::metadata::{
+    self, ChunkMap, ChunkRef, EcScheme, InodeId, InodeRecord, InodeState, SegmentGroup,
+    SegmentRecord, SegmentRef, SegmentedMap, MAX_VALUE_BYTES,
+};
+use wyrd_core::placement::Topology;
+use wyrd_core::repair;
+use wyrd_core::write::encode_ec_fragment;
+use wyrd_custodian::backfill::{reconcile as backfill_reconcile, BackfillContext};
+use wyrd_custodian::desired_state::{set_lifecycle, DServerLifecycle};
+use wyrd_custodian::{
+    reconcile_after_restore, reconcile_step, Custodian, ExpiredPendingPolicy, FencedZone,
+    GcContext, RebalanceContext, Reconciled, ReconstructionContext, RestoreReport,
+};
+use wyrd_traits::{
+    ChunkId, ChunkStore, CommitOutcome, DServerId, FragmentId, Health, MetadataStore, Result,
+    WriteBatch,
+};
+
+// ---- in-memory trait stores (the loops are proven over the seams, backend-agnostic) ----
+
+/// A trivial in-memory metadata store.
+#[derive(Default)]
+struct MemMeta {
+    kv: Mutex<HashMap<Vec<u8>, Bytes>>,
+}
+
+#[async_trait]
+impl MetadataStore for MemMeta {
+    async fn get(&self, key: &[u8]) -> Result<Option<Bytes>> {
+        Ok(self.kv.lock().unwrap().get(key).cloned())
+    }
+
+    async fn scan(&self, prefix: &[u8]) -> Result<Vec<(Vec<u8>, Bytes)>> {
+        Ok(self
+            .kv
+            .lock()
+            .unwrap()
+            .iter()
+            .filter(|(k, _)| k.starts_with(prefix))
+            .map(|(k, v)| (k.clone(), v.clone()))
+            .collect())
+    }
+
+    // The required paginated read (#634): a test double needs *a* body, not a backend's —
+    // the dev-only testkit helper pages over this store's own `scan`.
+    async fn scan_page(
+        &self,
+        prefix: &[u8],
+        after: Option<&[u8]>,
+        limit: usize,
+    ) -> Result<wyrd_traits::ScanPage> {
+        wyrd_testkit::test_double_scan_page(self, prefix, after, limit).await
+    }
+
+    async fn commit(&self, batch: WriteBatch) -> Result<CommitOutcome> {
+        let mut kv = self.kv.lock().unwrap();
+        for pre in &batch.preconditions {
+            if kv.get(&pre.key).cloned() != pre.expected {
+                return Ok(CommitOutcome::Conflict);
+            }
+        }
+        for (k, v) in batch.puts {
+            kv.insert(k, v);
+        }
+        for k in batch.deletes {
+            kv.remove(&k);
+        }
+        Ok(CommitOutcome::Committed)
+    }
+}
+
+/// A [`MetadataStore`] wrapper counting every `scan_page` call over a segment-group's own
+/// `seg:` range — the per-pass instrumented double criterion (4) counts resolutions on.
+/// Delegates everything else unchanged.
+struct CountingMeta {
+    inner: MemMeta,
+    seg_range_reads: AtomicUsize,
+}
+
+impl CountingMeta {
+    fn new(inner: MemMeta) -> Self {
+        Self {
+            inner,
+            seg_range_reads: AtomicUsize::new(0),
+        }
+    }
+
+    /// How many times a `seg:<nonce>:<epoch>:` range was read this pass — one **object**
+    /// resolution each (`metadata::resolve_chunk_homes`'s bounded per-group range read),
+    /// never one per queued chunk.
+    fn seg_range_reads(&self) -> usize {
+        self.seg_range_reads.load(Ordering::SeqCst)
+    }
+}
+
+#[async_trait]
+impl MetadataStore for CountingMeta {
+    async fn get(&self, key: &[u8]) -> Result<Option<Bytes>> {
+        self.inner.get(key).await
+    }
+
+    async fn scan(&self, prefix: &[u8]) -> Result<Vec<(Vec<u8>, Bytes)>> {
+        self.inner.scan(prefix).await
+    }
+
+    async fn scan_page(
+        &self,
+        prefix: &[u8],
+        after: Option<&[u8]>,
+        limit: usize,
+    ) -> Result<wyrd_traits::ScanPage> {
+        if prefix.starts_with(b"seg:") {
+            self.seg_range_reads.fetch_add(1, Ordering::SeqCst);
+        }
+        self.inner.scan_page(prefix, after, limit).await
+    }
+
+    async fn commit(&self, batch: WriteBatch) -> Result<CommitOutcome> {
+        self.inner.commit(batch).await
+    }
+}
+
+/// One D server's fragment bytes — a deliberately dumb `ChunkStore` holding the **real**
+/// stored fragment bytes, so checksums verify and a rebuilt shard round-trips.
+#[derive(Default)]
+struct MemDServer {
+    frags: Mutex<HashMap<FragmentId, Bytes>>,
+}
+
+#[async_trait]
+impl ChunkStore for MemDServer {
+    async fn put_fragment(&self, id: FragmentId, fragment: Bytes) -> Result<()> {
+        self.frags.lock().unwrap().insert(id, fragment);
+        Ok(())
+    }
+
+    async fn get_fragment(&self, id: FragmentId) -> Result<Option<Bytes>> {
+        Ok(self.frags.lock().unwrap().get(&id).cloned())
+    }
+
+    async fn list_fragments(&self) -> Result<Vec<FragmentId>> {
+        Ok(self.frags.lock().unwrap().keys().copied().collect())
+    }
+
+    async fn delete_fragment(&self, id: FragmentId) -> Result<()> {
+        self.frags.lock().unwrap().remove(&id);
+        Ok(())
+    }
+
+    async fn health(&self) -> Result<Health> {
+        Ok(Health::Healthy)
+    }
+}
+
+// ---- fixture: raw `seg:` + root seeding (this slice lands no producer of segmented maps;
+// #653 owns the real staged-publication committer) ----
+
+fn frag(chunk: ChunkId, index: u16) -> FragmentId {
+    FragmentId { chunk, index }
+}
+
+async fn commit(meta: &(impl MetadataStore + ?Sized), batch: WriteBatch) {
+    assert_eq!(meta.commit(batch).await.unwrap(), CommitOutcome::Committed);
+}
+
+async fn elect(coord: &MemCoordination, zone_name: &str) -> (FencedZone, Custodian) {
+    let leader = Custodian::elect(coord, zone_name).await.unwrap();
+    let mut zone = FencedZone::new();
+    zone.install(leader.leadership());
+    (zone, leader)
+}
+
+/// Seed a committed **segmented** root at `inode`, naming exactly ONE segment that carries
+/// `chunks` (built with the real validating constructors, never hand-typed JSON) — a raw
+/// `WriteBatch` put, never a publish path.
+async fn seed_one_segment(
+    meta: &(impl MetadataStore + ?Sized),
+    inode: InodeId,
+    nonce: &str,
+    epoch: u64,
+    chunks: Vec<ChunkRef>,
+) {
+    let byte_len: u64 = chunks.iter().map(|c| c.len).sum();
+    let group = SegmentGroup::new(nonce, epoch).unwrap();
+    let record = SegmentRecord::new(chunks, 0).unwrap();
+    let key = metadata::seg_key(&group, 0).unwrap();
+    commit(meta, WriteBatch::new().put(key, metadata::encode(&record))).await;
+    let map = SegmentedMap::new(
+        group,
+        vec![SegmentRef {
+            index: 0,
+            byte_offset: 0,
+            byte_len,
+        }],
+    )
+    .unwrap();
+    let root = InodeRecord {
+        size: byte_len,
+        chunk_map: ChunkMap::Segmented(map),
+        state: InodeState::Committed,
+        version: 1,
+        ..Default::default()
+    };
+    commit(
+        meta,
+        WriteBatch::new().put(metadata::inode_key(inode), metadata::encode(&root)),
+    )
+    .await;
+}
+
+/// A single-fragment (`EcScheme::None`) chunk, placed on `dserver`.
+fn none_chunk(id: ChunkId, dserver: DServerId, len: u64) -> ChunkRef {
+    ChunkRef {
+        id,
+        scheme: EcScheme::None,
+        len,
+        placement: vec![dserver],
+    }
+}
+
+/// A real, self-describing v1 fragment for a single-fragment (`EcScheme::None`) chunk —
+/// verifies via [`repair::fragment_intact`] / [`repair::intact_shard`] exactly like a
+/// genuine write's would.
+fn none_fragment_bytes(id: ChunkId, payload: &[u8]) -> Bytes {
+    let header = wyrd_chunk_format::FragmentHeader::new_v1(id, payload.len() as u64);
+    Bytes::from(wyrd_chunk_format::encode(&header, payload))
+}
