+/// Property 6 (issue #638) — 0016's own failure-mode row (`0016:1784`): "authorize a
+/// fragment write, park it in the D server's accept queue past `W_write` (the caller has
+/// long since timed out), fence and reap the session, and let the parked write proceed. The
+/// D server MUST refuse it as past its deadline."
+///
+/// This is the leg a caller-side timeout **cannot** produce. The client dials with no
+/// request timeout at all and its only bound is a 60 s watchdog — 30× the deadline it
+/// authorizes — so nothing on the client side can manufacture the refusal or cancel the
+/// parked write; the write is already accepted by the D server, which then applies it two
+/// simulated seconds later. A design that bounds only the caller's wait (the status quo
+/// 0016 rejects at `:1557-1564`) lets that accepted write land long after its authorization
+/// elapsed: outcome (a), the unreferenced *and* unevidenced fragment.
+#[madsim::test]
+async fn a_write_parked_past_its_deadline_is_refused_over_the_simulated_network() {
+    // Every D server sits on an accepted write for 2 s of simulated time before applying
+    // it — the accept queue, with a session being fenced and reaped around it.
+    let cluster =
+        Cluster::start_with_apply_delay([StoreFault::None; N], Duration::from_secs(2)).await;
+    let endpoint = cluster.endpoints[0].clone();
+
+    on_client(&cluster, move || async move {
+        let client = GrpcChunkStore::connect(endpoint).await.expect("connect");
+        let id = FragmentId {
+            chunk: 0x0016_0638,
+            index: 0,
+        };
+        let mut header = FragmentHeader::new_v1(id.chunk, 4);
+        header.ec_fragment_index = id.index;
+        let fragment = Bytes::from(encode(&header, b"park"));
+
+        // Authorized now, 200 ms of headroom: live when the D server accepts the write,
+        // elapsed by the time it applies it. madsim virtualises `SystemTime`, so this
+        // reads the simulator's clock — the same one the D server judges against
+        // (`DStore::now_millis`), and seed-deterministic (ADR-0009, #619).
+        #[allow(clippy::disallowed_methods)]
+        let now = std::time::SystemTime::now();
+        let deadline_millis = now
+            .duration_since(std::time::UNIX_EPOCH)
+            .unwrap()
+            .as_millis() as u64
+            + 200;
+
+        // Bounded, fail-closed await (the rubric's await discipline, `AGENTS.md:181-183`):
+        // a D server that hung instead of refusing must fail this test, not stall the
+        // campaign. Deliberately far past both the deadline and the park.
+        let refused = timeout(
+            Duration::from_secs(60),
+            client.put_fragment(id, fragment, Some(deadline_millis)),
+        )
+        .await
+        .expect("the parked write must be answered, not hang the caller")
+        .expect_err(
+            "a write parked past its deadline must be refused once the D server finally \
+             applies it — nothing here bounds the caller's own wait, so only server-side \
+             enforcement at the point of application can produce this",
+        );
+        assert!(
+            wyrd_traits::is_write_deadline_expired(refused.as_ref()),
+            "the refusal must classify as WriteDeadlineExpired across the wire, not as a \
+             generic or transient fault: {refused}"
+        );
+
+        let got = timeout(Duration::from_secs(60), client.get_fragment(id))
+            .await
+            .expect("the read-back must be answered")
+            .unwrap();
+        assert!(
+            got.is_none(),
+            "the parked-then-refused write must never be observable — asserting only the \
+             error would pass an implementation that stores the bytes and refuses the \
+             caller afterwards (0016 outcome (a))"
+        );
+    })
+    .await;
+}
