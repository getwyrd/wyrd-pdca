+
+/// **The bound itself** (issue #638, the enforcement claim of 0016 decision 5): a write
+/// that is live when the store *accepts* it and expired by the time the store *publishes*
+/// it must be refused — because the guarantee is about when the write **takes effect**, and
+/// everything between acceptance and the rename (the blocking pool's queue, the scratch
+/// write, a stalled disk) can consume arbitrary time.
+///
+/// The scripted clock puts that elapsing *inside* the production call: reading 1 (the
+/// admission check) is 500 ms before the deadline, reading 2 — taken immediately before
+/// `fs::rename`, the store's only publish point — is 500 ms after it. A store that checks
+/// the deadline only on entry publishes this write and the test goes **red**; one that
+/// re-checks at the publish point refuses it, stores nothing, and leaves no scratch.
+///
+/// The script assumes exactly the two reads the trait contract describes (admission, then
+/// publication); `remaining()` below is what says so out loud, so a future store that drops
+/// the admission fast path re-scripts this deliberately instead of failing mysteriously.
+#[test]
+fn a_write_that_expires_between_acceptance_and_publication_is_refused() {
+    block_on(async {
+        let clock = wyrd_testkit::SteppedClock::new([9_500, 10_500]);
+        let (s, dir) = store_with_clock(clock.clone());
+        let id = fid(0xf00d_0000_0000_0000_0000_0000_0000_0003, 0);
+        let frag = fragment(id, b"live on arrival, late at the rename");
+
+        let err = s.put_fragment(id, frag, Some(10_000)).await.expect_err(
+            "a write whose deadline elapses between acceptance and the publishing rename \
+                 must be refused — an entry-only check lets it land after W_write",
+        );
+        assert!(
+            wyrd_traits::is_write_deadline_expired(err.as_ref()),
+            "the refusal must be the typed deadline class, not an I/O error: {err}"
+        );
+        assert_eq!(
+            clock.remaining(),
+            0,
+            "both clock reads must happen — the second one, at the publish point, is the \
+             bound; an unconsumed reading means the store never re-checked"
+        );
+        assert!(
+            s.get_fragment(id).await.unwrap().is_none(),
+            "the write must not be observable: refusing the caller AFTER the rename is \
+             precisely the leak (0016 outcome (a)) the deadline exists to prevent"
+        );
+        assert!(
+            scratch_files(dir.path()).is_empty(),
+            "and it must leave no scratch litter: {:?}",
+            scratch_files(dir.path())
+        );
+    });
+}
+
+/// The control for the leg above (issue #638 leg F, the "genuine backend fault" half): a
+/// **real** I/O failure from the same production store — the chunk directory's path is
+/// occupied by a *file*, so the scratch write fails `ENOTDIR` — must NOT read as a deadline
+/// refusal. Without this control, "the refusal is classifiable" would rest on the deadline
+/// side alone, and a store that reported every failure as a deadline refusal would pass.
+#[test]
+fn a_genuine_backend_fault_is_not_a_deadline_refusal() {
+    block_on(async {
+        let (s, dir) = store_with_clock(wyrd_testkit::ManualClock::new(10_000));
+        let id = fid(0xf00d_0000_0000_0000_0000_0000_0000_0004, 0);
+        // Occupy the chunk directory's path with a file: every write beneath it now fails
+        // with a real `ENOTDIR` from the filesystem, on any platform and as any user.
+        std::fs::write(
+            dir.path().join(format!("{:032x}", id.chunk)),
+            b"not a directory",
+        )
+        .expect("plant the obstruction");
+
+        let err = s
+            .put_fragment(id, fragment(id, b"doomed by the disk"), Some(70_000))
+            .await
+            .expect_err("a genuine I/O failure must surface as an error");
+        assert!(
+            !wyrd_traits::is_write_deadline_expired(err.as_ref()),
+            "a broken backend must never be reported as 'refused, too late' — a caller \
+             would stop re-authorizing and start ignoring a real fault: {err}"
+        );
+        assert!(
+            err.downcast_ref::<std::io::Error>().is_some(),
+            "it stays the backend's own I/O error: {err}"
+        );
+        // And the deadline refusal is not an I/O error either — the two are disjoint.
+        let refusal = s
+            .put_fragment(id, fragment(id, b"too late"), Some(9_000))
+            .await
+            .expect_err("an expired deadline is refused");
+        assert!(wyrd_traits::is_write_deadline_expired(refusal.as_ref()));
+        assert!(
+            refusal.downcast_ref::<std::io::Error>().is_none(),
+            "a deadline refusal is an expected outcome, not a backend fault: {refusal}"
+        );
+    });
+}
