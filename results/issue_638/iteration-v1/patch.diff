+        // accept-queue delay guarantees the deadline has elapsed by the time it
+        // actually attempts to apply the write.
+        #[allow(clippy::disallowed_methods)] // wall-clock exempt: madsim virtualises it (#619)
+        let now = std::time::SystemTime::now();
+        let now_millis = now
+            .duration_since(std::time::UNIX_EPOCH)
+            .unwrap()
+            .as_millis() as u64;
+        let deadline_millis = now_millis + 200;
+
+        let err = client
+            .put_fragment(id, fragment, Some(deadline_millis))
+            .await
