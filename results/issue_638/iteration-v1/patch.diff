+/// Issue #638 — the **production** `GrpcChunkStore::put_fragment` sends an expired
+/// authorization deadline, and the D server's refusal reconstructs client-side as a
+/// `wyrd_traits::WriteDeadlineExpired`, the same way `IntegrityFault`/`BlockReadFault`
+/// already reconstruct (`client.rs::classify_put_status`). The wire-level red→green
+/// proof (a raw hand-encoded deadline field against the base seam, where this Rust
+/// API cannot even express a deadline) lives in `tests/write_deadline.rs`; this test
+/// exercises the actual shipped client type end to end, which that file deliberately
+/// does not (see its module doc's Falsifiability note).
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn put_with_an_expired_deadline_is_refused_and_reconstructs_as_write_deadline_expired() {
+    let (client, _dir, server) = connected().await;
+
+    let id = fid(0xdead_beef_0000_0000_0000_0000_0000_0001, 0);
+    // wall-clock exempt (test crate): compared against the D server's own real-time
+    // read (`FsChunkStore::put_fragment`), which owns this lifecycle (#619).
+    #[allow(clippy::disallowed_methods)]
+    let now = std::time::SystemTime::now();
+    let past_millis = now
+        .duration_since(std::time::UNIX_EPOCH)
+        .unwrap()
+        .as_millis() as u64
+        - 60_000;
+
+    let err = client
+        .put_fragment(
+            id,
+            fragment(id, b"authorized too long ago"),
+            Some(past_millis),
+        )
+        .await
+        .expect_err("an expired deadline must be refused by the production client path too");
+    assert!(
+        wyrd_traits::is_write_deadline_expired(err.as_ref()),
+        "the production client must reconstruct WriteDeadlineExpired: {err}"
+    );
+    assert!(
+        client.get_fragment(id).await.unwrap().is_none(),
+        "a refused write must not be stored"
+    );
+
+    server.abort();
+}
