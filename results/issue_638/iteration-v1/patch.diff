+/// A [`ChunkStore::put_fragment`] refused because its authorization deadline had
+/// already elapsed when the store attempted to apply it — proposal 0016 decision
+/// 5's server-enforced `W_write` bound (issue #638,
+/// `docs/design/proposals/draft/0016-multipart-commit-protocol.md:1551-1576`).
+///
+/// A caller-side `await` timeout alone bounds only how long the *writer* waits, not
+/// when an already-accepted write *takes effect* — a write parked in a D server's
+/// accept path (queued behind other work, or between acceptance and the actual
+/// disk write) could otherwise land arbitrarily late: after the reaper's `orphan:`
+/// grace has elapsed and the evidence protecting it is gone (0016 outcome (a), the
+/// leak `G_orphan > W_write + δ_clock` (`0016:1478`) exists to prevent). So every
+/// [`ChunkStore::put_fragment`] deadline is enforced **here, at the point the write
+/// is actually applied**, never merely awaited by the caller — 0016's own
+/// failure-mode row (`0016:1784`).
+///
+/// This is an **expected, non-fault** outcome — the write was refused because it
+/// arrived (or was finally applied) too late, not because the backend is unhealthy
+/// — so, like [`IntegrityFault`] / [`BlockReadFault`] / [`ScanCapExceeded`], it
+/// lives in the seam crate: every backend raises the *same* type, and a caller
+/// distinguishes "refused, too late" from a genuine backend fault the same way on
+/// any of them ([`is_write_deadline_expired`]).
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct WriteDeadlineExpired {
+    /// The fragment write that was refused.
+    pub id: FragmentId,
+    /// Backend detail for the durability audit trail (the deadline and the store's
+    /// own clock reading at refusal time).
+    pub detail: String,
+}
+
+impl fmt::Display for WriteDeadlineExpired {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        write!(
+            f,
+            "fragment write refused (chunk {:032x} index {}): authorization deadline \
+             already elapsed: {}",
+            self.id.chunk, self.id.index, self.detail
+        )
+    }
+}
+
+impl std::error::Error for WriteDeadlineExpired {}
+
+/// Whether `err` is a [`WriteDeadlineExpired`] refusal anywhere in its source chain —
+/// the seam-level classifier a caller uses to tell "refused, too late" apart from a
+/// genuine backend fault, mirroring [`is_integrity_fault`].
+pub fn is_write_deadline_expired(err: &(dyn std::error::Error + 'static)) -> bool {
+    let mut next = Some(err);
+    while let Some(e) = next {
+        if e.is::<WriteDeadlineExpired>() {
+            return true;
+        }
+        next = e.source();
+    }
+    false
