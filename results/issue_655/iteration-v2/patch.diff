+// ===========================================================================
+// Leg 2 — every clamp: a set on its bound passes, one step past it is refused by name.
+// ===========================================================================
+
+/// The binding leg. Each refused set is a passing set moved one unit past one bound — re-derived
+/// where the step moves a derived member, so the clamp named is the one the step broke. A few
+/// steps cannot help breaking a second clamp: a zero cap, a `W_ref` below one footprint, an
+/// in-flight cap above the part cap, and one past `SCAN_CAP/2` (which at any legal `B_ops` also
+/// overruns the idle fence). `knob_clamps_hold` names the first it checks; that is the one
+/// asserted.
+#[test]
+fn leg2_each_clamp_passes_its_bound_and_names_itself_one_step_past_it() {
+    let cap = capacity(SIZING_SCHEME);
+    let ceiling = |knob, chunks| C::ValueCeiling {
+        knob,
+        chunks,
+        capacity: cap,
+    };
+    let wide = EcScheme::ReedSolomon { k: 10, m: 4 };
+    let slot_bytes = u64::from(MAX_INFLIGHT_PARTS) * slot_pin_bytes();
+    let part_ops = MAX_PART_CHUNKS + PART_COMMIT_FIXED_OPS;
+    let fence_edge = MAX_BATCH_OPS - FENCE_FIXED_OPS;
+    let scan_inflight = u32::try_from(SCAN_CAP).unwrap() / (2 * MAX_PART_CHUNKS) + 1;
+    let at_scan_half = derived(with(TINY, |k| k.w_ref = 2 * (SCAN_HALF + 1)));
+    let fleet_at_half = derived(with(TINY, |k| k.w_ref = 2_000));
+    let past_scan_half = SCAN_HALF + 1;
+
+    let on_bound = [
+        // Every chunk cap at capacity, staging at the publishable ceiling, `B_bytes` at `E_tx/2`,
+        // `B_ops` at its half-deadline ceiling, the contention budget at `MAX_SESSIONS`.
+        D,
+        with(D, |k| k.batch_ops = part_ops),
+        with(D, |k| k.batch_bytes = slot_bytes),
+        derived(with(D, |k| k.max_inflight_parts = fence_edge)),
+        with(D, |k| k.w_ref = MAX_SESSIONS * U_REF),
+        at_scan_half,
+        fleet_at_half,
+        with(D, |k| {
+            (
+                k.r_publish,
+                k.max_complete_attempts,
+                k.max_upload_id_attempts,
+            ) = (1, 1, 1);
+        }),
+    ];
+    for set in on_bound {
+        assert_eq!(knob_clamps_hold(&set), Ok(()), "{set:?} sits on a bound");
+    }
+
+    let one_step_past = [
+        // Sized for a scheme the erasure coder cannot run (ADR-0045's `EcScheme` row).
+        (
+            with(D, |k| k.scheme = EcScheme::ReedSolomon { k: 6, m: 0 }),
+            C::SchemeUnsupported { k: 6, m: 0 },
+        ),
+        // The one-value ceilings (`0016:1464-1466`): one past capacity, and zero.
+        (
+            with(D, |k| k.max_map_chunks += 1),
+            ceiling("MAX_MAP_CHUNKS", MAX_MAP_CHUNKS + 1),
+        ),
+        (
+            with(D, |k| k.max_map_chunks = 0),
+            ceiling("MAX_MAP_CHUNKS", 0),
+        ),
+        (
+            with(D, |k| k.max_seg_chunks += 1),
+            ceiling("MAX_SEG_CHUNKS", MAX_SEG_CHUNKS + 1),
+        ),
+        (
+            with(D, |k| k.max_seg_chunks = 0),
+            ceiling("MAX_SEG_CHUNKS", 0),
+        ),
+        (
+            derived(with(D, |k| k.max_part_chunks += 1)),
+            ceiling("MAX_PART_CHUNKS", MAX_PART_CHUNKS + 1),
+        ),
+        (
+            with(D, |k| k.max_part_chunks = 0),
+            ceiling("MAX_PART_CHUNKS", 0),
+        ),
+        // The chunk ref grew under the caps: the shipped caps at a wider scheme.
+        (
+            with(D, |k| k.scheme = wide),
+            C::ValueCeiling {
+                knob: "MAX_MAP_CHUNKS",
+                chunks: MAX_MAP_CHUNKS,
+                capacity: capacity(wide),
+            },
+        ),
+        // `MAX_INFLIGHT_PARTS > MAX_PARTS_PER_SESSION` (`0016:1471`, clamp 1).
+        (
+            with(D, |k| k.max_parts_per_session = MAX_INFLIGHT_PARTS - 1),
+            C::Profile(RecordError::InflightPartsExceedParts {
+                max_inflight_parts: MAX_INFLIGHT_PARTS,
+                max_parts_per_session: MAX_INFLIGHT_PARTS - 1,
+            }),
+        ),
+        // `MAX_INFLIGHT_PARTS > ⌊SCAN_CAP / (2 × MAX_PART_CHUNKS)⌋` (`0016:1471`, clamp 2).
+        (
+            derived(with(D, |k| k.max_inflight_parts = scan_inflight)),
+            C::Profile(RecordError::StagingRangeUnscannable {
+                owned_sidx: u128::from(scan_inflight) * u128::from(MAX_PART_CHUNKS),
+            }),
+        ),
+        // `MAX_STAGED_CHUNKS` below `MAX_PART_CHUNKS` (`0016:1468`, the lower end).
+        (
+            derived(with(D, |k| k.max_staged_chunks = MAX_PART_CHUNKS - 1)),
+            C::Profile(RecordError::StagedChunksBelowPart {
+                max_staged_chunks: MAX_PART_CHUNKS - 1,
+                max_part_chunks: MAX_PART_CHUNKS,
+            }),
+        ),
+        // `W_ref` below one session's footprint (`0016:1473`): no session could be admitted.
+        (
+            with(D, |k| k.w_ref = U_REF - 1),
+            C::Profile(RecordError::BudgetBelowFootprint {
+                w_ref: U_REF - 1,
+                u_ref: u128::from(U_REF),
+            }),
+        ),
+        // `MAX_STAGED_CHUNKS` above `MAX_ROOT_SEGMENTS × MAX_SEG_CHUNKS` (`0016:1468`).
+        (
+            derived(with(D, |k| k.max_staged_chunks += 1)),
+            C::StagedAbovePublishable {
+                max_staged_chunks: MAX_STAGED_CHUNKS + 1,
+                publishable: MAX_ROOT_SEGMENTS as u64 * u64::from(MAX_SEG_CHUNKS),
+            },
+        ),
+        // `B_bytes` past `E_tx/2`, and `B_ops` past the half-deadline ceiling the shipped value
+        // sits on (`0016:1475`).
+        (
+            with(D, |k| k.batch_bytes = E_TX_BYTES / 2 + 1),
+            C::BatchBytesAboveHalfEnvelope {
+                batch_bytes: E_TX_BYTES / 2 + 1,
+            },
+        ),
+        (
+            with(D, |k| k.batch_ops += 1),
+            C::BatchOpsAboveHalfDeadline {
+                batch_ops: MAX_BATCH_OPS + 1,
+            },
+        ),
+        // The whole part commit one operation over `B_ops`, and `MAX_PART_CHUNKS > B_ops`
+        // itself (`0016:1466`).
+        (
+            with(D, |k| k.batch_ops = part_ops - 1),
+            C::PartCommitOverOps {
+                ops: u64::from(part_ops),
+                batch_ops: part_ops - 1,
+            },
+        ),
+        (
+            with(D, |k| k.batch_ops = MAX_PART_CHUNKS - 1),
+            C::PartCommitOverOps {
+                ops: u64::from(part_ops),
+                batch_ops: MAX_PART_CHUNKS - 1,
+            },
+        ),
+        // The whole-range fence one byte over the mutation-byte budget (`0016:1471`, X77).
+        (
+            with(D, |k| k.batch_bytes = slot_bytes - 1),
+            C::SlotRangeOverBytes {
+                bytes: slot_bytes,
+                batch_bytes: slot_bytes - 1,
+            },
+        ),
+        // The whole-range fence one operation over `B_ops`, and `MAX_INFLIGHT_PARTS > B_ops`
+        // itself (`0016:1471`, clamp 4).
+        (
+            derived(with(D, |k| k.max_inflight_parts = fence_edge + 1)),
+            C::SlotRangeOverOps {
+                ops: u64::from(MAX_BATCH_OPS) + 1,
+                batch_ops: MAX_BATCH_OPS,
+            },
+        ),
+        (
+            derived(with(D, |k| k.max_inflight_parts = MAX_BATCH_OPS + 1)),
+            C::SlotRangeOverOps {
+                ops: u64::from(MAX_BATCH_OPS + 1 + FENCE_FIXED_OPS),
+                batch_ops: MAX_BATCH_OPS,
+            },
+        ),
+        // `MAX_SESSIONS × U_ref > W_ref` (`0016:1470`).
+        (
+            with(D, |k| k.max_sessions += 1),
+            C::SessionsOverFootprint {
+                max_sessions: MAX_SESSIONS + 1,
+                u_ref: U_REF,
+                w_ref: W_REF,
+            },
+        ),
+        // `MAX_SESSIONS > SCAN_CAP/2`, with its footprint exactly on `W_ref` (`0016:1470`).
+        (
+            with(at_scan_half, |k| {
+                (k.max_sessions, k.max_owned_fleet) = (past_scan_half, past_scan_half);
