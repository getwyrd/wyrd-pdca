+#[test]
+fn leg3_u_ref_and_the_session_limit_follow_the_formulas_under_either_arm() {
+    // The shipped profile: the staged-ceiling arm of `U_ref` binds (`0016:1469`).
+    let parts = u64::from(MAX_PARTS_PER_SESSION);
+    let inflight = u64::from(MAX_INFLIGHT_PARTS);
+    let chunks = u64::from(MAX_PART_CHUNKS);
+    let ceiling = u64::from(MAX_STAGED_CHUNKS) + 2 * inflight * chunks;
+    assert!(ceiling < (parts + inflight) * chunks);
+    assert_eq!(U_REF, ceiling);
+    assert_eq!(MAX_SESSIONS, (W_REF / U_REF).min(SCAN_HALF));
+    assert_eq!(MAX_OWNED_FLEET, MAX_SESSIONS * inflight * chunks);
+    assert_eq!(u64::from(MAX_ADMISSION_CAS_ATTEMPTS), MAX_SESSIONS);
+    assert_eq!(KnobSet::DEPLOYED, derived(KnobSet::DEPLOYED));
+
+    // The raw arm, through the production derivation: `0016`'s own small-part example
+    // (`0016:2847` — `MAX_PART_CHUNKS = 5`, `MAX_INFLIGHT_PARTS = 16` ⇒ `U_ref = 50,080`, the raw
+    // term binding, ⇒ `MAX_SESSIONS` 79 at `W_ref = 4,000,000`). The production must accept a set
+    // carrying 79 and, handed 78, name 79 as the derived value.
+    let small = derived(with(D, |k| k.max_part_chunks = 5));
+    assert_eq!((u_ref(&small), small.max_sessions), (50_080, 79));
+    assert_eq!(knob_clamps_hold(&small), Ok(()));
+    assert_eq!(
+        knob_clamps_hold(&with(small, |k| k.max_sessions = 78)),
+        Err(C::SessionsNotDerived {
+            stored: 78,
+            derived: 79
+        })
+    );
+
+    // The `SCAN_CAP/2` term, when a large `W_ref` meets a small `U_ref` (`0016:1470`).
+    let clamped = derived(with(TINY, |k| k.w_ref = 10 * SCAN_CAP as u64));
+    assert_eq!(clamped.max_sessions, SCAN_HALF);
+    assert_eq!(knob_clamps_hold(&clamped), Ok(()));
+    assert_eq!(
+        knob_clamps_hold(&with(clamped, |k| k.max_sessions = 0)),
+        Err(C::SessionsNotDerived {
+            stored: 0,
+            derived: SCAN_HALF
+        })
+    );
+}
