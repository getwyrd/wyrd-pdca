+// ===========================================================================
+// Leg 1 — the shipped set passes every clamp.
+// ===========================================================================
+
+#[test]
+fn leg1_the_shipped_set_passes_every_clamp() {
+    assert_eq!(knob_clamps_hold(&KnobSet::DEPLOYED), Ok(()));
+}
