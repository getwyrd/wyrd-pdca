+        ),
+        // A chosen `MAX_SESSIONS` below its derivation: one short, and none at all.
+        (
+            with(D, |k| k.max_sessions -= 1),
+            C::SessionsNotDerived {
+                stored: MAX_SESSIONS - 1,
+                derived: MAX_SESSIONS,
+            },
+        ),
+        (
+            with(D, |k| k.max_sessions = 0),
+            C::SessionsNotDerived {
+                stored: 0,
+                derived: MAX_SESSIONS,
+            },
+        ),
+        // `MAX_OWNED_FLEET > W_ref / 2` (`0016:1472`).
+        (
+            with(fleet_at_half, |k| k.max_owned_fleet += 1),
