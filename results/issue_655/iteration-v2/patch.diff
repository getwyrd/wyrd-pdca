+// ===========================================================================
+// Leg 5 — the admission backoff is bounded and grows; its two retry budgets are separate.
+// ===========================================================================
+
+#[test]
+fn leg5_the_backoff_is_bounded_jittered_and_grows_with_the_attempt() {
+    // Both ends of the jitter range, every power of two, and a few irregular values.
+    let jitters: Vec<u64> = (0..64)
+        .map(|shift| 1u64 << shift)
+        .chain([0, 3, 1_000_003, u64::MAX / 3, u64::MAX - 1, u64::MAX])
+        .collect();
+    let mut previous_top = 0;
+    for attempt in 0..12 {
+        // The window the backoff states: `BASE × 2^(attempt+1)`, capped.
+        let window = (BASE << (attempt + 1)).min(CAP);
+        let delays: Vec<u64> = jitters
+            .iter()
+            .map(|&jitter| admission_backoff_millis(attempt, jitter))
+            .collect();
+        assert!(delays.iter().all(|delay| (BASE..=window).contains(delay)));
+        assert_eq!(admission_backoff_millis(attempt, 0), BASE);
+        assert_eq!(admission_backoff_millis(attempt, u64::MAX), window);
+        let mut distinct = delays.clone();
+        distinct.sort_unstable();
+        distinct.dedup();
+        assert!(distinct.len() > 2, "attempt {attempt}: {distinct:?}");
+        // For every jitter the delay never shrinks as the attempt grows…
+        for (&jitter, &delay) in jitters.iter().zip(&delays) {
+            assert!(admission_backoff_millis(attempt + 1, jitter) >= delay);
+        }
+        // …and the window itself grows until it reaches the cap.
+        assert!(window > previous_top || window == CAP);
+        previous_top = window;
+    }
+    assert_eq!(admission_backoff_millis(u32::MAX, u64::MAX), CAP);
+}
+
+#[test]
+fn leg5_the_two_retry_budgets_are_separate_and_contention_outlasts_the_room() {
+    // One budget for both was the carried-forward `503 SlowDown` defect.
+    assert_ne!(MAX_UPLOAD_ID_ATTEMPTS, MAX_ADMISSION_CAS_ATTEMPTS);
+    // That defect as arithmetic: `MAX_SESSIONS` creators race an empty ledger through its one
+    // serialized CAS; each round admits one, so the last admitted lost `MAX_SESSIONS - 1` times
+    // and needed `MAX_SESSIONS` attempts. The contention budget covers it…
+    let storm = MAX_SESSIONS;
+    assert!(u64::from(MAX_ADMISSION_CAS_ATTEMPTS) >= storm);
+    // …and the collision budget, sized for a 2^-128 event, does not: sharing it would refuse
+    // that storm on an empty store.
+    assert!(u64::from(MAX_UPLOAD_ID_ATTEMPTS) < storm);
+    // Every retry and fence budget allows its first attempt.
+    for bound in [
+        R_PUBLISH,
+        MAX_COMPLETE_ATTEMPTS,
+        MAX_UPLOAD_ID_ATTEMPTS,
+        MAX_ADMISSION_CAS_ATTEMPTS,
+    ] {
+        assert!(bound >= 1);
+    }
+}
