+// ===========================================================================
+// Leg 4 — every capacity fits the key space #691 gave it, in byte order at the cap.
+// ===========================================================================
+
+#[test]
+fn leg4_every_capacity_fits_its_key_space_in_byte_order_at_the_cap() {
+    let id = UploadId::new("0123456789abcdef0123456789abcdef").unwrap();
+
+    // Every slot index the in-flight cap opens has a canonical key, and key order is index order
+    // through the cap — the property that makes the `slot:` key space the bound (`0016:349`).
+    let slots: Vec<Vec<u8>> = (0..MAX_INFLIGHT_PARTS)
+        .map(|index| slot_key(&id, SlotIndex::new(index).unwrap()))
+        .collect();
+    assert!(slots.windows(2).all(|pair| pair[0] < pair[1]));
+    let top = parse_slot_key(slots.last().unwrap()).unwrap().1;
+    assert_eq!(top.get(), MAX_INFLIGHT_PARTS - 1);
+
+    // The same for every part number the session cap admits.
+    let parts: Vec<Vec<u8>> = (1..=MAX_PARTS_PER_SESSION)
+        .map(|number| part_key(&id, PartNumber::new(number).unwrap()))
+        .collect();
+    assert!(parts.windows(2).all(|pair| pair[0] < pair[1]));
+    let last = parse_part_key(parts.last().unwrap()).unwrap().1;
+    assert_eq!(last.get(), MAX_PARTS_PER_SESSION);
+
+    // A part cap past the part-number width is refused.
+    assert_eq!(
+        knob_clamps_hold(&with(D, |k| k.max_parts_per_session = MAX_PART_NUMBER + 1)),
+        Err(C::Profile(RecordError::PartsPerSessionUnaddressable {
+            max_parts_per_session: MAX_PART_NUMBER + 1
+        }))
+    );
+    // So is an in-flight cap past the slot-index width — by the in-flight ≤ parts clamp, which
+    // always binds first: the widest legal part cap opens no index the slot grammar cannot spell.
+    const { assert!(MAX_PART_NUMBER <= MAX_SLOT_INDEX + 1) };
+    assert_eq!(
+        knob_clamps_hold(&with(D, |k| {
+            (k.max_parts_per_session, k.max_inflight_parts) = (MAX_PART_NUMBER, MAX_SLOT_INDEX + 2);
+        })),
+        Err(C::Profile(RecordError::InflightPartsExceedParts {
+            max_inflight_parts: MAX_SLOT_INDEX + 2,
+            max_parts_per_session: MAX_PART_NUMBER
+        }))
+    );
+}
