+        (
+            with(D, |k| k.max_owned_fleet = 0),
+            C::OwnedFleetNotDerived {
+                stored: 0,
+                derived: u128::from(MAX_OWNED_FLEET),
+            },
+        ),
+        (
+            with(D, |k| k.max_owned_fleet += 1),
+            C::OwnedFleetNotDerived {
+                stored: MAX_OWNED_FLEET + 1,
+                derived: u128::from(MAX_OWNED_FLEET),
+            },
+        ),
+        // A retry bound of zero, each one.
+        (
+            with(D, |k| k.r_publish = 0),
+            C::RetryBoundZero { knob: "R_PUBLISH" },
+        ),
+        (
+            with(D, |k| k.max_complete_attempts = 0),
+            C::RetryBoundZero {
+                knob: "MAX_COMPLETE_ATTEMPTS",
+            },
+        ),
+        (
+            with(D, |k| k.max_upload_id_attempts = 0),
