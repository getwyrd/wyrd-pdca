+#[test]
+fn leg3_each_budget_takes_the_half_0016_states() {
+    // `E_tx/2` (`0016:1475`): half of FoundationDB's 10 MB, not a quarter and not all of it.
+    assert_eq!(MAX_BATCH_BYTES, E_TX_BYTES / 2);
+    // `W_ref/2` (`0016:1472`): a set whose owned fleet is exactly half its `W_ref` passes, and
+    // leg 2 refuses the same set one entry over — so the production bound is neither a quarter
+    // (this would fail) nor the whole `W_ref` (leg 2 would name another clamp).
+    let half = derived(with(TINY, |k| k.w_ref = 2_000));
+    assert_eq!(half.max_owned_fleet, half.w_ref / 2);
+    assert_eq!(knob_clamps_hold(&half), Ok(()));
+    // The shipped fleet is inside its half.
+    const { assert!(MAX_OWNED_FLEET <= W_REF / 2) };
+}
