+// ===========================================================================
+// 14. The admission arithmetic — knob constants, derivations and clamps
+//     (issue #655, 0016 decision 4, the knob table `0016:1463-1480`)
+// ===========================================================================
+//
+// 0016 settles each knob's valid RANGE and its BOUNDING INVARIANT
+// (`0016:1463-1480`) and leaves the VALUE to the implementing slice
+// (`0016:3072-3080`); this section is that slice. Every constant below carries
+// its derivation in its own doc comment (never a restatement of its value),
+// and [`knob_clamps_hold`] asserts the inequalities *between* them so the whole
+// set is checked as one, not eyeballed knob by knob.
+//
+// **Not the same type as [`Budget`] above.** `Budget` (`:1543`) is the
+// *persisted* `mpuctl` profile tuple — five fields, validated once at decode
+// against FORMAT-only relations (G1-G7) through a sealed `TryFrom`, so an
+// invalid `Budget` cannot exist in a running process. [`KnobSet`] is this
+// seam's wider, unsealed aggregate: every settled knob, INCLUDING the ones
+// 0016 marks "derived, never chosen" (`MAX_SESSIONS`, `MAX_OWNED_FLEET`), with
+// plain `pub` fields so a test can construct a deliberately-wrong value and
+// assert [`knob_clamps_hold`] rejects it (leg 2's rejection table). The two
+// names collide on "the thing the clamps are checked over" is why this one is
+// spelled differently rather than reusing `Budget` — reusing it was not
+// available: its fields are private and its only constructor already enforces
+// a *different*, narrower rule set than 0016's full knob table states.
+
+/// The worst-case encoded size of one [`ChunkRef`] under the deployment's settled durability
+/// scheme, Reed-Solomon(6,3) (`crates/server/src/lib.rs:49`, `DEFAULT_DURABILITY`; `core` does
+/// not depend on `server`, so the scheme is restated here as a literal rather than imported —
+/// ADR-0010's dependency direction) — `b_ref` in 0016's arithmetic (`0016:1050-1053`).
+///
+/// **Measured, not the prose estimate.** 0016 states "~302 B (worst-case `u64` ids)"; that
+/// figure undercounts the chunk id, which is a `u128` (`crates/traits/src/lib.rs:26`) always
+/// `>= 2^127` (the minted epoch's top bit is set, `crates/server/src/lib.rs:255-257`), hence
+/// always 39 decimal digits — not the 20 a `u64` worst case would render. The genuine worst
+/// case, `ChunkId::MAX`/`u64::MAX` len/9 `DServerId::MAX` placement entries encoded through
+/// [`metadata::encode`], is **315 B**; [`crates/core/tests/multipart_knobs.rs`] performs that
+/// measurement independently (leg 3) and this constant is caught against it — this is the
+/// "no drift from the encoded reality" leg the module header promises.
+///
+/// The **worst** case, deliberately: every ceiling below divides a value budget by it, and
+/// sizing from the typical case would admit a record that fits until a fleet renumbers its D
+/// servers — a *permanent* over-`V` commit, the one failure a publication cannot retry out of.
+pub const MAX_CHUNKREF_BYTES: usize = 315;
+
+/// The worst-case encoded bytes of one [`ChunkRef`] under `scheme` — [`MAX_CHUNKREF_BYTES`]'s
+/// per-scheme companion (`0016:1050-1053`). Every field is at its maximum, so a plan this
+/// admits can never encode larger than it predicted; a wider EC scheme (more fragments, hence
+/// a longer `placement`) legitimately gets a larger number.
+pub fn max_chunkref_bytes_for(scheme: EcScheme) -> usize {
+    let fanout = match scheme {
+        EcScheme::None => 1usize,
+        EcScheme::ReedSolomon { k, m } => usize::from(k) + usize::from(m),
+    };
+    metadata::encode(&ChunkRef {
+        id: ChunkId::MAX,
+        scheme,
+        len: u64::MAX,
+        placement: vec![DServerId::MAX; fanout],
+    })
+    .len()
+}
+
+/// The chunk-ref count one JSON value holds at 0016's 2x headroom: `⌊(V/2) / b_ref⌋`
+/// (`0016:1050-1053`). `V/2` is [`MAX_ROOT_VALUE_BYTES`] (`metadata.rs:352`) — **consumed, not
+/// re-derived**: it is already the named half of [`MAX_VALUE_BYTES`] the peer capacity constant
+/// there ties with a `const` assertion (`metadata.rs:354`), so writing `MAX_VALUE_BYTES / 2`
+/// again here would be the second spelling this module's header (`:57-61`) forbids.
+///
+/// **The same rule binds three records** — the flat inode map, a `seg:` record, and a `part:`
+/// record — because each is one JSON value (`0016:1044`), which is why [`MAX_MAP_CHUNKS`],
+/// [`MAX_SEG_CHUNKS`] and [`MAX_PART_CHUNKS`] are all this number rather than three
+/// independently chosen ones.
+const VALUE_CHUNK_CAPACITY: usize = MAX_ROOT_VALUE_BYTES / MAX_CHUNKREF_BYTES;
+
+// The compile-time tie `metadata.rs:354` uses for its own V/2 relation, applied to this
+// seam's: no retune of `MAX_CHUNKREF_BYTES` can silently push the chunk-count families over
+// the raw value ceiling without failing the BUILD, not just a test run later.
+const _: () = assert!(VALUE_CHUNK_CAPACITY * MAX_CHUNKREF_BYTES * 2 <= MAX_VALUE_BYTES);
+
+/// The most chunks a **flat** inode chunk map may name (`0016:1464`). Past it, a publication
+/// segments (decision 7) instead of committing an over-`V` value.
+pub const MAX_MAP_CHUNKS: usize = VALUE_CHUNK_CAPACITY;
+
+/// The most chunks one `seg:` record may name (`0016:1465`) — identical rule to
+/// [`MAX_MAP_CHUNKS`], one record class down.
+pub const MAX_SEG_CHUNKS: usize = VALUE_CHUNK_CAPACITY;
+
+/// The most chunks one `part:` record may name (`0016:1466`) — identical rule again, because a
+/// `part:` record is *also* one JSON value. Two bounds meet on this knob and both are asserted
+/// by [`knob_clamps_hold`]: the value ceiling above, and `MAX_PART_CHUNKS <= B_ops`
+/// ([`MAX_BATCH_OPS`]) — a part commit is an **unsplittable** batch (deletes up to
+/// `MAX_PART_CHUNKS` owned `sidx:` entries plus its reads and puts), and its compensation is
+/// the same shape, so past the operation budget a *valid* part's commit and its compensation
+/// would both time out on the slowest backend, permanently, leaving the slot and the staged
+/// residue with no path that ever clears them (`0016:1466`, X110).
+pub const MAX_PART_CHUNKS: usize = VALUE_CHUNK_CAPACITY;
+
+/// The most chunks a part may hold **under `scheme`** — [`MAX_PART_CHUNKS`] is this quantity
+/// for the settled RS(6,3) shape; a wider scheme legitimately gets a smaller number, by the
+/// same reasoning [`max_chunkref_bytes_for`] states.
+pub fn max_part_chunks_for(scheme: EcScheme) -> usize {
+    (MAX_ROOT_VALUE_BYTES / max_chunkref_bytes_for(scheme)).max(1)
+}
+
+/// The refusal threshold `UploadPart` enforces (`0016:1061-1075`): `MAX_PART_CHUNKS *
+/// chunk_size`. `chunk_size` is not this seam's knob (`#508`'s, `0016:1474`), so it is a
+/// parameter rather than baked into a constant.
+pub const fn max_part_bytes(chunk_size: u64) -> u64 {
+    MAX_PART_CHUNKS as u64 * chunk_size
+}
+
+/// The most part numbers one session may hold — S3's own limit (`0016:1469`). Well inside
+/// [`MAX_PART_NUMBER`]'s `999_999`-wide key space, so every legal part number the S3 surface
+/// can mint has a `part:`/`psum:`/`sidx:` key its own parser reads back (leg 4).
+pub const MAX_PARTS_PER_SESSION: u32 = 10_000;
+
+/// The most parts one session may have **in flight**, and therefore the size of its
+/// `slot:<id>:[0, MAX_INFLIGHT_PARTS)` key space (`0016:1471`, `:349`) — **the key space IS
+/// the cap**, enforced by `require_absent` rather than by an integer every writer must CAS
+/// correctly.
+///
+/// Four clamps bound the value, all asserted by [`knob_clamps_hold`]: `<= MAX_PARTS_PER_SESSION`
+/// (a session cannot have more parts in flight than it may ever hold); `<= SCAN_CAP / (2 *
+/// MAX_PART_CHUNKS)` (the per-session `sidx:` range can never itself cross the scan cap); the
+/// whole-range slot batch's bytes `<= MAX_BATCH_BYTES` and its operations (plus the terminal
+/// delete's own fixed overhead) `<= MAX_BATCH_OPS` — the reaper's idle fence pins one
+/// precondition per index and the terminal delete removes every surviving slot, both in ONE
+/// unsplittable batch (X77/X98).
+///
+/// 16 matches the concurrency `aws s3 cp` defaults to, so the everyday client never meets the
+/// backpressure.
+pub const MAX_INFLIGHT_PARTS: u32 = 16;
+
+/// The chunk-refs one session may hold in **committed** `part:` records — the *publishable*
+/// segmented ceiling `MAX_ROOT_SEGMENTS * MAX_SEG_CHUNKS` (`0016:1468`), settled at the upper
+/// end of its stated range.
+///
+/// Not a free knob: a session that could stage more than it could ever publish charges `U_ref`
+/// the raw part-number space (≈19x more than Complete would let that session publish,
+/// `0016:1431-1456`) and the derived [`KnobSet::max_sessions`] collapses toward 1. Enforced by
+/// an `EntityTooLarge` refusal at **part commit**, read from the bounded `psum:` summary range.
+pub const MAX_STAGED_CHUNKS: u32 = (MAX_ROOT_SEGMENTS * MAX_SEG_CHUNKS) as u32;
+
+/// The transaction byte/time envelope every backend inherits — FoundationDB's, the tightest in
+/// play: 10 MB, 5 s (`crates/traits/src/lib.rs:1330`; `E_tx` in 0016's arithmetic).
+const TRANSACTION_BYTE_ENVELOPE: usize = 10_000_000;
+
+/// The mutation-and-precondition BYTE half of one drain/segment/admission batch — `E_tx / 2`
+/// (`0016:1475`, `B_bytes`). One axis of `B = min(B_bytes, B_ops)`; bytes alone do not prove
+/// termination (see [`MAX_BATCH_OPS`]).
+pub const MAX_BATCH_BYTES: usize = TRANSACTION_BYTE_ENVELOPE / 2;
+
+/// The OPERATION-COUNT half of one drain/segment/admission batch — `B_ops` (`0016:1475`,
+/// `:640-648`). Both backends this trait ships apply a batch's preconditions and mutations
+/// **sequentially inside the transaction** (`metadata-tikv/src/lib.rs:1063-1095`,
+/// `metadata-fdb/src/lib.rs:1425-1438`), so ~1,000 tiny marks can exceed the 5 s deadline while
+/// far under 5 MB — and a batch that always times out is stuck, not slow.
+///
+/// **Uncalibrated — 0016's own open question (`0016:1475`: "calibrated to keep a batch's
+/// sequential in-transaction round trips inside the 5-second half of the envelope on the
+/// slowest supported backend").** This slice cannot run that calibration (no backend, no
+/// runtime — pure arithmetic over constants, per its own Verification posture). 1,000
+/// sequential round trips is 0016's own illustrative scale for where the byte budget alone
+/// stops protecting (`0016:1475`, X98); it is used here as a deliberately conservative
+/// first-cut value, not a measured one. **`#625` MUST re-check this against a measured backend
+/// before relying on it** — recorded as a Check §6 item, not silently trusted.
+pub const MAX_BATCH_OPS: usize = 1_000;
+
+/// The fixed operations a terminal-delete batch spends besides its per-slot deletes: the
+/// session record's own `require` + `delete`, and the admission counter's `require` + `put`,
+/// plus one margin op for the reaper's own session-state read. An upper-bound estimate, not a
+/// literal op-by-op trace — [`knob_clamps_hold`]'s [`InflightPartsOperationBudget`
+/// clamp](KnobClamp::InflightPartsOperationBudget) is conservative rather than exact.
+const TERMINAL_DELETE_FIXED_OPS: usize = 5;
+
+/// A generous upper bound on one `slot:` record's encoded key+value bytes (an upload id, a
+/// zero-padded index, a 32-hex attempt id and two millisecond stamps), used by
+/// [`knob_clamps_hold`]'s whole-range-batch clamp.
+const MAX_SLOT_RECORD_BYTES: usize = 256;
+
+/// The reconcile pass's staged-reference **memory** budget, in chunk-refs — `W_ref`
+/// (`0016:1473`).
+///
+/// **This value is `#625`'s by 0016's own assignment (`0016:3072-3080`) and is defined here
+/// only because [`KnobSet::max_sessions`] cannot be derived without it.** `#625` CONSUMES this
+/// constant and MUST NOT re-derive it — a split budget authority is exactly the failure
+/// `docs/principles.md:138-143` records (the 2026-07-25 multipart batch: a legally-admitted
+/// session whose unsplittable reap fence could never commit).
+///
+/// 4,000,000 chunk-refs is 0016's own worked example (`0016:2846-2860`): ≈36 M
+/// `(server, fragment)` pairs at RS(6,3), a few GB of set on a reconcile host.
+pub const W_REF: u64 = 4_000_000;
+
+/// How many times Complete re-reads the target and retries the root flip before releasing its
+/// fence — `R_publish` (`0016:1476`). Bounded so Complete terminates; exceeding it releases the
+/// fence back to `Open` rather than looping.
+pub const R_PUBLISH: u32 = 3;
+
+/// How many Complete **fences** one session may spend — `MAX_COMPLETE_ATTEMPTS`
+/// (`0016:1477`). Each fence mints a new `Completing@E` epoch whose rolled-back segments
+/// become one `retire:records:{seg}` obligation, so an unbounded fence/rollback cycle would let
+/// one session install obligations and `seg:` generations without bound. At the cap the fence
+/// is refused and the session's only exit is Abort.
+pub const MAX_COMPLETE_ATTEMPTS: u32 = 3;
+
+/// Attempts a create spends on an **upload-id collision** — a 2^-128 event (`0016:493-497`).
+///
+/// **Separate from [`MAX_ADMISSION_CAS_ATTEMPTS`], and that separation is this slice's fix for
+/// the carried-forward defect: one shared budget served both this and the *globally
+/// serialized* admission CAS, so the k-th concurrent creator needed O(k) attempts and ordinary
+/// client concurrency (`aws-cli` defaults to 10) answered a false `503 SlowDown` on an empty
+/// store.** Two retries, two concerns, two bounds — asserted distinct by
+/// `crates/core/tests/multipart_knobs.rs` (leg 5).
+pub const MAX_UPLOAD_ID_ATTEMPTS: u32 = 2;
+
+/// Attempts a create spends losing the **admission CAS** to another creator (`0016:2004`,
+/// `:2031-2034`).
+///
+/// Contention here is expected, not exceptional: `mpuctl` is one record every create CASes
+/// whole, so N simultaneous creators serialize through it and the last one legitimately needs
+/// N attempts. Sized against the concurrency a fleet can present, not "a retry or two" —
+/// exhausting it is genuine backpressure, a `503 SlowDown`.
+pub const MAX_ADMISSION_CAS_ATTEMPTS: u32 = 64;
+
+/// The floor of the jittered admission-CAS backoff, in milliseconds.
+pub const ADMISSION_BACKOFF_BASE_MILLIS: u64 = 2;
+
+/// The ceiling the backoff is capped at, in milliseconds.
+pub const ADMISSION_BACKOFF_CAP_MILLIS: u64 = 50;
+
+/// The delay a creator waits after losing its `attempt`-th admission CAS: an **equal-jitter**
+/// schedule — `[ADMISSION_BACKOFF_BASE_MILLIS, window]` where `window` doubles with `attempt`
+/// up to [`ADMISSION_BACKOFF_CAP_MILLIS`] — never a **full**-jitter schedule down to zero.
+///
+/// The floor is deliberate: a full-jitter schedule (uniform over `[0, window]`) can answer
+/// `0` at any attempt, which is indistinguishable from no backoff at all and re-collides a
+/// storm in lockstep at low attempt counts; equal jitter keeps every wait bounded away from
+/// zero while still de-synchronizing colliding creators (`crates/core/tests/multipart_knobs.rs`
+/// leg 5 asserts the floor).
+///
+/// Pure — no clock read, no sleep, so `core` stays runtime-agnostic (ADR-0009); the caller
+/// supplies `jitter` (any value; only its remainder is used) and does the waiting.
+pub fn admission_backoff_millis(attempt: u32, jitter: u64) -> u64 {
+    let window = ADMISSION_BACKOFF_BASE_MILLIS
+        .saturating_mul(1u64 << attempt.min(8))
+        .min(ADMISSION_BACKOFF_CAP_MILLIS);
+    let span = window - ADMISSION_BACKOFF_BASE_MILLIS;
+    ADMISSION_BACKOFF_BASE_MILLIS + jitter % (span + 1)
+}
+
+/// Every settled knob this seam owns, as one aggregate — the value [`knob_clamps_hold`] checks
+/// (`0016:1463-1480`). Plain `pub` fields, deliberately unsealed (contrast [`Budget`], `:1543`):
+/// a test constructs a hypothetical, possibly-invalid set to prove the clamp that should reject
+/// it actually does (leg 2), which a validating constructor would make impossible to reach.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct KnobSet {
+    /// `b_ref` — [`MAX_CHUNKREF_BYTES`].
+    pub max_chunkref_bytes: usize,
+    /// [`MAX_MAP_CHUNKS`].
+    pub max_map_chunks: usize,
+    /// [`MAX_SEG_CHUNKS`].
+    pub max_seg_chunks: usize,
+    /// [`MAX_PART_CHUNKS`].
+    pub max_part_chunks: usize,
+    /// [`MAX_STAGED_CHUNKS`].
+    pub max_staged_chunks: u64,
+    /// [`MAX_PARTS_PER_SESSION`].
+    pub max_parts_per_session: u32,
+    /// [`MAX_INFLIGHT_PARTS`].
+    pub max_inflight_parts: u32,
+    /// `MAX_SESSIONS` — derived (`0016:1470`), never chosen; a raw field only so leg 2 can
+    /// inject a value that disagrees with its own derivation.
+    pub max_sessions: u64,
+    /// `MAX_OWNED_FLEET` — derived (`0016:1472`), same reason.
+    pub max_owned_fleet: u64,
+    /// `W_ref` — [`W_REF`].
+    pub w_ref: u64,
+    /// `B_bytes` — [`MAX_BATCH_BYTES`].
+    pub b_bytes: usize,
+    /// `B_ops` — [`MAX_BATCH_OPS`].
+    pub b_ops: usize,
+    /// [`R_PUBLISH`].
+    pub r_publish: u32,
+    /// [`MAX_COMPLETE_ATTEMPTS`].
+    pub max_complete_attempts: u32,
+    /// [`MAX_UPLOAD_ID_ATTEMPTS`].
+    pub max_upload_id_attempts: u32,
+    /// [`MAX_ADMISSION_CAS_ATTEMPTS`].
+    pub max_admission_cas_attempts: u32,
+}
+
+impl KnobSet {
+    /// The settled deployment value set — every field at the constant of its own name above,
+    /// with `max_sessions` and `max_owned_fleet` computed by their derivations rather than
+    /// hardcoded, exactly as `0016:1469-1472` requires.
+    pub fn deployed() -> Self {
+        let mut set = Self {
+            max_chunkref_bytes: MAX_CHUNKREF_BYTES,
+            max_map_chunks: MAX_MAP_CHUNKS,
+            max_seg_chunks: MAX_SEG_CHUNKS,
+            max_part_chunks: MAX_PART_CHUNKS,
+            max_staged_chunks: u64::from(MAX_STAGED_CHUNKS),
+            max_parts_per_session: MAX_PARTS_PER_SESSION,
+            max_inflight_parts: MAX_INFLIGHT_PARTS,
+            max_sessions: 0,
+            max_owned_fleet: 0,
+            w_ref: W_REF,
+            b_bytes: MAX_BATCH_BYTES,
+            b_ops: MAX_BATCH_OPS,
+            r_publish: R_PUBLISH,
+            max_complete_attempts: MAX_COMPLETE_ATTEMPTS,
+            max_upload_id_attempts: MAX_UPLOAD_ID_ATTEMPTS,
+            max_admission_cas_attempts: MAX_ADMISSION_CAS_ATTEMPTS,
+        };
+        set.max_sessions = set.derive_max_sessions();
+        set.max_owned_fleet =
+            set.max_sessions * u64::from(set.max_inflight_parts) * set.max_part_chunks as u64;
+        set
+    }
+
+    /// `U_ref` — this set's worst-case per-session staged-reference footprint, verbatim
+    /// `0016:1469`:
+    ///
+    /// ```text
+    /// U_ref = min( (MAX_PARTS_PER_SESSION + MAX_INFLIGHT_PARTS) x MAX_PART_CHUNKS,
+    ///              MAX_STAGED_CHUNKS + 2 x MAX_INFLIGHT_PARTS x MAX_PART_CHUNKS )
+    /// ```
+    ///
+    /// The first term is the raw part-number space; the second is the enforced staged ceiling
+    /// plus the bounded commit overshoot plus the in-flight owned entries, each committed part
+    /// charged its **full** `max_part_chunks` (`0016:1469`, the iteration-4 fix).
+    pub fn u_ref(&self) -> u64 {
+        let part_chunks = self.max_part_chunks as u64;
+        let inflight = u64::from(self.max_inflight_parts);
+        let raw = (u64::from(self.max_parts_per_session) + inflight) * part_chunks;
+        let ceiling = self.max_staged_chunks + 2 * inflight * part_chunks;
+        raw.min(ceiling)
+    }
+
+    /// `MAX_SESSIONS = min(⌊W_ref / U_ref⌋, SCAN_CAP/2)` — **derived, never chosen**
+    /// (`0016:1470`). The `SCAN_CAP/2` term is a clamp the implementation applies, not an
+    /// operator range check: a legal pairing (large `W_ref`, small parts) can make the
+    /// quotient exceed `SCAN_CAP` and break the reaper's one `scan("mpu:")`.
+    pub fn derive_max_sessions(&self) -> u64 {
+        let u_ref = self.u_ref();
+        if u_ref == 0 {
+            return 0;
+        }
+        (self.w_ref / u_ref).min((SCAN_CAP / 2) as u64)
+    }
+}
+
+/// Which inequality of `0016`'s knob table (`0016:1463-1480`) a [`KnobSet`] violated —
+/// [`knob_clamps_hold`]'s return names the clamp rather than a bare `bool`, so a future retune
+/// that breaks one fails with an actionable name instead of a silent `false`.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum KnobClamp {
+    /// `max_chunkref_bytes * MAX_MAP_CHUNKS > V/2` (`0016:1464`).
+    MapChunksValueCeiling,
+    /// `max_chunkref_bytes * MAX_SEG_CHUNKS > V/2` (`0016:1465`).
+    SegChunksValueCeiling,
+    /// `max_chunkref_bytes * MAX_PART_CHUNKS > V/2` (`0016:1466`).
+    PartChunksValueCeiling,
+    /// `MAX_PART_CHUNKS > B_ops` (`0016:1466`, X110): an unsplittable part commit (and its
+    /// compensation) would time out permanently.
+    PartChunksOperationBudget,
+    /// `MAX_PARTS_PER_SESSION` outside `[1, MAX_PART_NUMBER]`: a part number the fixed-width
+    /// key grammar cannot spell (leg 4).
+    PartsPerSessionExceedsFormatWidth,
+    /// `MAX_INFLIGHT_PARTS` outside `[1, MAX_SLOT_INDEX + 1]`: a slot index the fixed-width key
+    /// grammar cannot spell (leg 4).
+    InflightPartsExceedsFormatWidth,
+    /// `MAX_STAGED_CHUNKS < MAX_PART_CHUNKS` (`0016:1468`): at least one maximal part must
+    /// remain stageable.
+    StagedChunksBelowPart,
+    /// `MAX_STAGED_CHUNKS > MAX_ROOT_SEGMENTS * MAX_SEG_CHUNKS` (`0016:1468`): a session cannot
+    /// stage more than it could ever publish.
+    StagedChunksAbovePublishable,
+    /// `MAX_INFLIGHT_PARTS > MAX_PARTS_PER_SESSION` (`0016:1471`, iteration-13 finding 2).
+    InflightPartsAboveParts,
+    /// `MAX_INFLIGHT_PARTS > floor(SCAN_CAP / (2 * MAX_PART_CHUNKS))` (`0016:1471`): the
+    /// per-session `sidx:` range would itself cross the scan cap.
+    InflightPartsAboveScanHalf,
+    /// The whole-range slot batch's bytes exceed `B_bytes` (`0016:1471`, X77/X98).
+    InflightPartsWholeRangeBatchBytes,
+    /// The terminal-delete batch's operations (`MAX_INFLIGHT_PARTS` plus the fixed overhead)
+    /// exceed `B_ops` (`0016:1471`, X98).
+    InflightPartsOperationBudget,
+    /// `MAX_SESSIONS * U_ref > W_ref` (`0016:1470`): the aggregate staged-reference footprint
+    /// would exceed the reconcile pass's memory budget.
+    SessionsFootprintExceedsWRef,
+    /// `MAX_SESSIONS > SCAN_CAP/2` (`0016:1470`): the reaper's `scan("mpu:")` would fail.
+    SessionsAboveScanHalf,
+    /// `MAX_OWNED_FLEET > W_ref/2` (`0016:1472`).
+    OwnedFleetAboveHalfWRef,
+    /// One of the four retry/fence budgets (`R_PUBLISH`, `MAX_COMPLETE_ATTEMPTS`,
+    /// `MAX_UPLOAD_ID_ATTEMPTS`, `MAX_ADMISSION_CAS_ATTEMPTS`) is zero — an unbounded loop, not
+    /// a bound. Names the constant.
+    RetryBoundZero(&'static str),
+}
+
+/// Whether `set` satisfies every clamp `0016`'s knob table states (`0016:1463-1480`) — the
+/// bounding invariants, CHECKED rather than commented. A free function, not a test, so the
+/// property is part of the API `#656`-`#660` and `#625` inherit: they take these values rather
+/// than re-choosing them, and a deployment that retunes one can assert the set is still legal.
+/// Returns the FIRST violation, so leg 2's rejection table can construct a `KnobSet` that
+/// breaks exactly one clamp and assert this names that one.
+pub fn knob_clamps_hold(set: &KnobSet) -> std::result::Result<(), KnobClamp> {
+    let headroom = MAX_ROOT_VALUE_BYTES; // V/2, `0016:1464-1466`.
+    if set.max_chunkref_bytes.saturating_mul(set.max_map_chunks) > headroom {
+        return Err(KnobClamp::MapChunksValueCeiling);
+    }
+    if set.max_chunkref_bytes.saturating_mul(set.max_seg_chunks) > headroom {
+        return Err(KnobClamp::SegChunksValueCeiling);
+    }
+    if set.max_chunkref_bytes.saturating_mul(set.max_part_chunks) > headroom {
+        return Err(KnobClamp::PartChunksValueCeiling);
+    }
+    if set.max_part_chunks > set.b_ops {
+        return Err(KnobClamp::PartChunksOperationBudget);
+    }
+    if set.max_parts_per_session == 0 || set.max_parts_per_session > MAX_PART_NUMBER {
+        return Err(KnobClamp::PartsPerSessionExceedsFormatWidth);
+    }
+    if set.max_inflight_parts == 0
+        || u64::from(set.max_inflight_parts) > u64::from(MAX_SLOT_INDEX) + 1
+    {
+        return Err(KnobClamp::InflightPartsExceedsFormatWidth);
+    }
+    if set.max_staged_chunks < set.max_part_chunks as u64 {
+        return Err(KnobClamp::StagedChunksBelowPart);
+    }
+    let publishable = MAX_ROOT_SEGMENTS as u64 * set.max_seg_chunks as u64;
+    if set.max_staged_chunks > publishable {
+        return Err(KnobClamp::StagedChunksAbovePublishable);
+    }
+    if set.max_inflight_parts > set.max_parts_per_session {
+        return Err(KnobClamp::InflightPartsAboveParts);
+    }
+    let scan_half_parts = SCAN_CAP / (2 * set.max_part_chunks.max(1));
+    if set.max_inflight_parts as usize > scan_half_parts {
+        return Err(KnobClamp::InflightPartsAboveScanHalf);
+    }
+    let whole_range_bytes = (set.max_inflight_parts as usize).saturating_mul(MAX_SLOT_RECORD_BYTES);
+    if whole_range_bytes > set.b_bytes {
+        return Err(KnobClamp::InflightPartsWholeRangeBatchBytes);
+    }
+    let terminal_ops = set.max_inflight_parts as usize + TERMINAL_DELETE_FIXED_OPS;
+    if terminal_ops > set.b_ops {
+        return Err(KnobClamp::InflightPartsOperationBudget);
+    }
+    let u_ref = set.u_ref();
+    if u_ref != 0 && set.max_sessions.saturating_mul(u_ref) > set.w_ref {
+        return Err(KnobClamp::SessionsFootprintExceedsWRef);
+    }
+    if set.max_sessions > (SCAN_CAP / 2) as u64 {
+        return Err(KnobClamp::SessionsAboveScanHalf);
+    }
+    if set.max_owned_fleet > set.w_ref / 2 {
+        return Err(KnobClamp::OwnedFleetAboveHalfWRef);
+    }
+    if set.r_publish == 0 {
+        return Err(KnobClamp::RetryBoundZero("R_PUBLISH"));
+    }
+    if set.max_complete_attempts == 0 {
+        return Err(KnobClamp::RetryBoundZero("MAX_COMPLETE_ATTEMPTS"));
+    }
+    if set.max_upload_id_attempts == 0 {
+        return Err(KnobClamp::RetryBoundZero("MAX_UPLOAD_ID_ATTEMPTS"));
+    }
+    if set.max_admission_cas_attempts == 0 {
+        return Err(KnobClamp::RetryBoundZero("MAX_ADMISSION_CAS_ATTEMPTS"));
+    }
+    Ok(())
+}
diff --git a/crates/core/tests/multipart_knobs.rs b/crates/core/tests/multipart_knobs.rs
