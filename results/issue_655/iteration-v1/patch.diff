index 0000000..b78bd10
--- /dev/null
+++ b/crates/core/tests/multipart_knobs.rs
@@ -0,0 +1,379 @@
+//! Issue #655, slice 2/7 of #636's re-split (0016 decision 4, the knob table
+//! `0016:1463-1480`): the multipart seam's **numbers**, and the one function that asserts
+//! they are mutually consistent. Five legs, all pure — no store, no runtime, no fixture
+//! beyond literals (this slice's own Verification posture: "born-at-tier").
+//!
+//! Every symbol this file names is ADDED by this patch — `crates/core/src/multipart.rs`
+//! carries no multipart knob today (the #654 chain lands the module and the record family,
+//! not the numbers). So on a revert of this slice alone, this file does not compile: RED is
+//! criterion-ABSENCE, exactly as the brief's Falsifiability section states, and the
+//! discriminator reports it as `UNVERIFIABLE`, not a verdict. That is expected and does not
+//! need a workaround here — unlike `segmented_map_record.rs` (which binds against
+//! `metadata.rs` symbols already merged on `origin/main`), nothing in this module pre-exists
+//! for this file to fall back to.
+
+#![forbid(unsafe_code)]
+
+use std::collections::BTreeSet;
+
+use wyrd_core::metadata::{MAX_ROOT_SEGMENTS, MAX_ROOT_VALUE_BYTES, MAX_VALUE_BYTES};
+use wyrd_core::multipart::{
+    self, admission_backoff_millis, knob_clamps_hold, max_chunkref_bytes_for, max_part_chunks_for,
+    part_key, slot_key, KnobClamp, KnobSet, PartNumber, SlotIndex, UploadId,
+    ADMISSION_BACKOFF_BASE_MILLIS, ADMISSION_BACKOFF_CAP_MILLIS, MAX_ADMISSION_CAS_ATTEMPTS,
+    MAX_BATCH_BYTES, MAX_BATCH_OPS, MAX_CHUNKREF_BYTES, MAX_COMPLETE_ATTEMPTS, MAX_INFLIGHT_PARTS,
+    MAX_MAP_CHUNKS, MAX_PARTS_PER_SESSION, MAX_PART_CHUNKS, MAX_PART_NUMBER, MAX_SEG_CHUNKS,
+    MAX_SLOT_INDEX, MAX_STAGED_CHUNKS, MAX_UPLOAD_ID_ATTEMPTS, R_PUBLISH, W_REF,
+};
+use wyrd_traits::SCAN_CAP;
+
+const UPLOAD_ID: &str = "0123456789abcdef0123456789abcdef";
+
+// ===========================================================================
+// Leg 1 — the shipped value set satisfies every clamp.
+// ===========================================================================
+
+#[test]
+fn leg1_deployed_set_satisfies_every_clamp() {
+    let deployed = KnobSet::deployed();
+    assert_eq!(
+        knob_clamps_hold(&deployed),
+        Ok(()),
+        "the deployment's own KnobSet must satisfy 0016's whole knob table: {deployed:?}"
+    );
+}
+
+// ===========================================================================
+// Leg 2 — knob_clamps_hold is not vacuous: it rejects each violation, one leg per
+// clamp, and names the clamp it broke. A `knob_clamps_hold` that returns success
+// unconditionally passes leg 1 and proves nothing — THIS leg is the binding one.
+// ===========================================================================
+
+#[test]
+fn leg2_rejects_each_violation_by_name() {
+    let base = KnobSet::deployed();
+    let cases: Vec<(&str, KnobSet, KnobClamp)> = vec![
+        (
+            "max_chunkref_bytes x MAX_MAP_CHUNKS > V/2",
+            KnobSet {
+                max_map_chunks: 1_000,
+                ..base
+            },
+            KnobClamp::MapChunksValueCeiling,
+        ),
+        (
+            "max_chunkref_bytes x MAX_SEG_CHUNKS > V/2",
+            KnobSet {
+                max_seg_chunks: 1_000,
+                ..base
+            },
+            KnobClamp::SegChunksValueCeiling,
+        ),
+        (
+            "max_chunkref_bytes x MAX_PART_CHUNKS > V/2",
+            KnobSet {
+                max_part_chunks: 1_000,
+                ..base
+            },
+            KnobClamp::PartChunksValueCeiling,
+        ),
+        (
+            "MAX_PART_CHUNKS > B_ops",
+            KnobSet { b_ops: 100, ..base },
+            KnobClamp::PartChunksOperationBudget,
+        ),
+        (
+            "MAX_PARTS_PER_SESSION overflows the part-number format width",
+            KnobSet {
+                max_parts_per_session: 1_000_000,
+                ..base
+            },
+            KnobClamp::PartsPerSessionExceedsFormatWidth,
+        ),
+        (
+            "MAX_INFLIGHT_PARTS overflows the slot-index format width",
+            KnobSet {
+                max_inflight_parts: 1_000_001,
+                ..base
+            },
+            KnobClamp::InflightPartsExceedsFormatWidth,
+        ),
+        (
+            "MAX_STAGED_CHUNKS below MAX_PART_CHUNKS",
+            KnobSet {
+                max_staged_chunks: 100,
+                ..base
+            },
+            KnobClamp::StagedChunksBelowPart,
+        ),
+        (
+            "MAX_STAGED_CHUNKS above MAX_ROOT_SEGMENTS x MAX_SEG_CHUNKS",
+            KnobSet {
+                max_staged_chunks: 100_000,
+                ..base
+            },
+            KnobClamp::StagedChunksAbovePublishable,
+        ),
+        (
+            "MAX_INFLIGHT_PARTS > MAX_PARTS_PER_SESSION",
+            KnobSet {
+                max_inflight_parts: 10_001,
+                ..base
+            },
+            KnobClamp::InflightPartsAboveParts,
+        ),
+        (
+            "MAX_INFLIGHT_PARTS > floor(SCAN_CAP / (2 x MAX_PART_CHUNKS))",
+            KnobSet {
+                max_inflight_parts: 4_000,
+                ..base
+            },
+            KnobClamp::InflightPartsAboveScanHalf,
+        ),
+        (
+            "the whole-range fence/terminal-delete batch exceeds the mutation-byte budget",
+            KnobSet {
+                max_part_chunks: 1,
+                max_parts_per_session: 25_000,
+                max_inflight_parts: 20_000,
+                ..base
+            },
+            KnobClamp::InflightPartsWholeRangeBatchBytes,
+        ),
+        (
+            "MAX_INFLIGHT_PARTS > B_ops",
+            KnobSet {
+                max_inflight_parts: 996,
+                ..base
+            },
+            KnobClamp::InflightPartsOperationBudget,
+        ),
+        (
+            "MAX_SESSIONS x U_ref > W_ref",
+            KnobSet {
+                max_sessions: 10_000_000,
+                ..base
+            },
+            KnobClamp::SessionsFootprintExceedsWRef,
+        ),
+        (
+            "MAX_SESSIONS > SCAN_CAP/2",
+            KnobSet {
+                max_sessions: 600_000,
+                w_ref: 100_000_000_000,
+                ..base
+            },
+            KnobClamp::SessionsAboveScanHalf,
+        ),
+        (
+            "MAX_OWNED_FLEET > W_ref/2",
+            KnobSet {
+                max_owned_fleet: 3_000_000,
+                ..base
+            },
+            KnobClamp::OwnedFleetAboveHalfWRef,
+        ),
+        (
+            "a retry bound of 0",
+            KnobSet {
+                r_publish: 0,
+                ..base
+            },
+            KnobClamp::RetryBoundZero("R_PUBLISH"),
+        ),
+    ];
+
+    for (label, candidate, expected) in cases {
+        let got = knob_clamps_hold(&candidate);
+        assert_eq!(
+            got,
+            Err(expected),
+            "violating exactly one clamp ({label}) must be rejected and must name that clamp; \
+             got {got:?} for {candidate:?}"
+        );
+    }
+}
+
+// ===========================================================================
+// Leg 3 — the derivations are recomputed independently (never via the production
+// helper) and asserted equal to the shipped constants: "no /2-vs-/4 drift", mechanical.
+// ===========================================================================
+
+#[test]
+fn leg3_value_chunk_capacity_recomputed_independently() {
+    // The shared rule for all three "one JSON value" ceilings: floor((V/2) / b_ref).
+    // Recomputed from MAX_VALUE_BYTES / 2 directly (not via MAX_ROOT_VALUE_BYTES, and not by
+    // calling anything in `multipart`), so a formula that drifted to V/4 or whole-V fails here.
+    let half_v = MAX_VALUE_BYTES / 2;
+    assert_eq!(
+        half_v, MAX_ROOT_VALUE_BYTES,
+        "V/2 must be the HALVING 0016 states, not V/4 or V"
+    );
+    let capacity = half_v / MAX_CHUNKREF_BYTES;
+    assert_eq!(capacity, MAX_MAP_CHUNKS);
+    assert_eq!(capacity, MAX_SEG_CHUNKS);
+    assert_eq!(capacity, MAX_PART_CHUNKS);
+}
+
+#[test]
+fn leg3_b_ref_extremes_land_in_0016s_stated_range() {
+    // 0016:1050-1053's own two extremes for b_ref: "~131 B (small D-server ids) to ~302 B
+    // (worst-case u64 ids)" — plugged into the SAME formula, independent of whatever this
+    // module's own MAX_CHUNKREF_BYTES is, so the formula's shape (not this slice's specific
+    // measurement) is what is checked here.
+    for b_ref in [131usize, 302usize] {
+        let capacity = (MAX_VALUE_BYTES / 2) / b_ref;
+        assert!(
+            (165..=381).contains(&capacity),
+            "floor((V/2)/{b_ref}) = {capacity} must land in 0016's stated 165-381"
+        );
+    }
+}
+
+#[test]
+fn leg3_max_chunkref_bytes_matches_the_encoded_reality() {
+    // The genuine worst case, measured against the production ChunkRef/encode() — a
+    // max_chunkref_bytes that drifted from the encoded reality (e.g. a stale 302 after a field
+    // widens) is caught here, not merely trusted from a doc comment.
+    let scheme = wyrd_core::metadata::EcScheme::ReedSolomon { k: 6, m: 3 };
+    let measured = max_chunkref_bytes_for(scheme);
+    assert_eq!(measured, MAX_CHUNKREF_BYTES);
+    // The per-scheme companion agrees with MAX_PART_CHUNKS for the settled scheme.
+    assert_eq!(max_part_chunks_for(scheme), MAX_PART_CHUNKS);
+}
+
+#[test]
+fn leg3_staged_chunks_and_derived_pair_recomputed_independently() {
+    let staged = MAX_ROOT_SEGMENTS as u64 * MAX_SEG_CHUNKS as u64;
+    assert_eq!(staged, u64::from(MAX_STAGED_CHUNKS));
+
+    let part_chunks = MAX_PART_CHUNKS as u64;
+    let inflight = u64::from(MAX_INFLIGHT_PARTS);
+    let raw = (u64::from(MAX_PARTS_PER_SESSION) + inflight) * part_chunks;
+    let ceiling = staged + 2 * inflight * part_chunks;
+    let u_ref = raw.min(ceiling);
+    let deployed = KnobSet::deployed();
+    assert_eq!(u_ref, deployed.u_ref());
+
+    let scan_half = (SCAN_CAP / 2) as u64;
+    let max_sessions = (W_REF / u_ref).min(scan_half);
+    assert_eq!(max_sessions, deployed.max_sessions);
+
+    let max_owned_fleet = max_sessions * inflight * part_chunks;
+    assert_eq!(max_owned_fleet, deployed.max_owned_fleet);
+    assert!(max_owned_fleet <= W_REF / 2, "0016:1472's own bound");
+}
+
+#[test]
+fn leg3_max_part_bytes_and_batch_bytes_use_0016s_stated_halving() {
+    // max_part_bytes = MAX_PART_CHUNKS x chunk_size, for a couple of concrete chunk sizes
+    // (DEFAULT_CHUNK_SIZE = 1 MiB, `crates/server/src/lib.rs:51` — cited, not imported: `core`
+    // does not depend on `server`).
+    for chunk_size in [1u64 << 20, 4 << 20] {
+        assert_eq!(
+            multipart::max_part_bytes(chunk_size),
+            MAX_PART_CHUNKS as u64 * chunk_size
+        );
+    }
+    // B_bytes = E_tx/2, E_tx = 10 MB (`crates/traits/src/lib.rs:1330`) — the halving, not a
+    // quarter or the whole envelope.
+    assert_eq!(MAX_BATCH_BYTES, 10_000_000 / 2);
+}
+
+// ===========================================================================
+// Leg 4 — every capacity knob fits the key space #691 gave it: MAX_INFLIGHT_PARTS by
+// the slot-index width, MAX_PARTS_PER_SESSION by the part-number width, with
+// byte-lexicographic order still equal to numeric order at the cap.
+// ===========================================================================
+
+// Both format-width facts are properties of the shipped constants alone, so they are checked
+// at compile time — the shape `crates/core/src/metadata.rs:354` uses for its own V/2 tie.
+const _: () = assert!(MAX_INFLIGHT_PARTS as u64 <= MAX_SLOT_INDEX as u64 + 1);
+const _: () = assert!(MAX_PARTS_PER_SESSION <= MAX_PART_NUMBER);
+// The CAS-contention budget is sized against fleet concurrency, not "a retry or two" — it must
+// stay well above the 2^-128 upload-id-collision budget it is separate from.
+const _: () = assert!(MAX_ADMISSION_CAS_ATTEMPTS > MAX_UPLOAD_ID_ATTEMPTS);
+
+#[test]
+fn leg4_inflight_and_parts_per_session_fit_their_key_widths() {
+    let id = UploadId::new(UPLOAD_ID).unwrap();
+
+    // Byte-lexicographic slot-key order equals numeric index order up to and at the cap —
+    // the property that makes the `slot:` key space *be* the in-flight bound (`0016:349`).
+    let last_valid_index = MAX_INFLIGHT_PARTS - 1;
+    for (lo, hi) in [(0u32, 1u32), (last_valid_index - 1, last_valid_index)] {
+        let lo_key = slot_key(&id, SlotIndex::new(lo).unwrap());
+        let hi_key = slot_key(&id, SlotIndex::new(hi).unwrap());
+        assert!(
+            lo < hi && lo_key < hi_key,
+            "numeric order {lo} < {hi} must equal byte order"
+        );
+    }
+
+    // Same property for the `part:` key space at MAX_PARTS_PER_SESSION.
+    let lo_part = part_key(&id, PartNumber::new(1).unwrap());
+    let hi_part = part_key(&id, PartNumber::new(MAX_PARTS_PER_SESSION).unwrap());
+    assert!(lo_part < hi_part);
+}
+
+#[test]
+fn leg4_overflowing_width_is_rejected_by_knob_clamps_hold() {
+    let over_width = KnobSet {
+        max_inflight_parts: u64::from(MAX_SLOT_INDEX) as u32 + 2,
+        ..KnobSet::deployed()
+    };
+    assert!(knob_clamps_hold(&over_width).is_err());
+}
+
+// ===========================================================================
+// Leg 5 — the admission backoff is bounded, and its two retry budgets are separate.
+// ===========================================================================
+
+#[test]
+fn leg5_backoff_is_bounded_and_grows_with_attempt() {
+    for attempt in 0..12u32 {
+        let mut max_seen = 0u64;
+        for jitter in [0u64, 1, 7, 199, 1_000, u64::MAX / 3, u64::MAX] {
+            let delay = admission_backoff_millis(attempt, jitter);
+            assert!(
+                (ADMISSION_BACKOFF_BASE_MILLIS..=ADMISSION_BACKOFF_CAP_MILLIS).contains(&delay),
+                "attempt={attempt} jitter={jitter} delay={delay} must be in \
+                 [BASE, CAP] = [{ADMISSION_BACKOFF_BASE_MILLIS}, {ADMISSION_BACKOFF_CAP_MILLIS}]"
+            );
+            max_seen = max_seen.max(delay);
+        }
+        // The per-attempt achievable ceiling is non-decreasing across a sweep dense enough to
+        // reach it, up to the point it is capped.
+        if attempt > 0 {
+            assert!(max_seen >= ADMISSION_BACKOFF_BASE_MILLIS);
+        }
+    }
+    // At the cap the achievable range still respects both ends for a wide spread of jitter.
+    let spread: BTreeSet<u64> = (0..200).map(|j| admission_backoff_millis(9, j)).collect();
+    assert!(spread.iter().all(|&d| d >= ADMISSION_BACKOFF_BASE_MILLIS));
+    assert!(spread.iter().all(|&d| d <= ADMISSION_BACKOFF_CAP_MILLIS));
+    assert!(
+        spread.len() > 1,
+        "the schedule must actually jitter, not return one constant"
+    );
+}
+
+#[test]
+fn leg5_the_two_retry_budgets_are_distinct_constants() {
+    // The carried-forward defect (#636 findings): one shared budget serves both the
+    // 2^-128 upload-id collision and the globally-serialized admission CAS, so ordinary
+    // client concurrency answers a false 503 SlowDown on an empty store. This slice's fix is
+    // the numbers: two named constants, asserted separate here.
+    assert_ne!(MAX_UPLOAD_ID_ATTEMPTS, MAX_ADMISSION_CAS_ATTEMPTS);
+    // And every retry/fence bound this slice ships is at least 1 — the "no permanent failure
+    // mode" invariant applied to this seam's own numbers.
+    for bound in [
+        R_PUBLISH,
+        MAX_COMPLETE_ATTEMPTS,
+        MAX_UPLOAD_ID_ATTEMPTS,
+        MAX_ADMISSION_CAS_ATTEMPTS,
+        MAX_BATCH_OPS as u32,
+    ] {
+        assert!(bound >= 1);
+    }
+}
