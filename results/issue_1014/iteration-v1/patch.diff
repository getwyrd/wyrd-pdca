+/// and writes the orphan-identity marker for the new restore-fence generation (#1014), without
+/// which GC treats every mark as protecting.
+async fn repair_pass(
+    zone: &FencedZone,
+    leader: &Custodian,
+    meta: &MemMeta,
+    fleet: &[(DServerId, &dyn ChunkStore)],
+    now: u64,
+) {
+    let topology = Topology::default();
+    let clock = ManualClock::new(now);
+    let ctx = ReconstructionContext {
+        meta,
+        fleet,
+        topology: &topology,
+        unreachable: &[],
+        clock: &clock,
+        staged_write_window_millis: wyrd_custodian::gc::W_WRITE_MILLIS,
+        operator_fleet_size: fleet.len(),
+        tombstone: Tombstone::Retain,
+    };
+    reconcile_step(zone, leader, None, None, Some(&ctx), None, now)
+        .await
+        .unwrap();
+}
+
 /// THE COUNTERFACTUAL, and the reason this issue exists. Without the pass, a post-restore
 /// stray survives GC **forever** — not for a grace window, forever — because GC has no
 /// evidence a deadline ever started. Run GC a year later and the bytes are still there.
@@ -604,6 +658,11 @@ async fn after_the_pass_gc_reclaims_the_stranded_fragment() {
 
