+/// Take the orphan-identity cleanup as done under the restore-fence generation now current
+/// (#1014): plant its marker. A post-restore pass opens a new generation, after which GC treats
+/// every mark as protecting until the repair loop's cleanup has walked the restored ledger; a
+/// repair pass would also drain the sessions that pass fenced, which these legs keep.
+fn cleanup_done(meta: &Meta) {
+    let fence = meta
+        .kv
+        .lock()
+        .unwrap()
+        .get(wyrd_core::multipart::MPUFENCE_KEY)
+        .map(|value| wyrd_core::multipart::decode_fence_generation(value).unwrap());
+    let marker = wyrd_core::orphan_identity::CleanupMarker::for_fence(fence.as_ref());
+    meta.seed(
+        wyrd_core::orphan_identity::ORPHAN_IDENTITY_KEY,
+        wyrd_core::orphan_identity::encode_cleanup_marker(&marker),
+    );
