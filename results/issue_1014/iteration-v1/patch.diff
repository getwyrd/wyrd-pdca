+/// drain's decode would refuse too. The caller keeps its inline batch then, as before the
+/// routing existed. A segmented generation names a group, never a chunk, so it is refused by
+/// neither.
+fn retiring(
+    base: WriteBatch,
+    gate: &crate::orphan_identity::OpenGate,
+    id: InodeId,
+    version: u64,
+    retired: crate::multipart::RetiredMap,
+) -> Option<WriteBatch> {
+    let obligation =
+        crate::multipart::RetireObligation::superseded_generation(id, version, retired).ok()?;
+    let value = obligation.value();
