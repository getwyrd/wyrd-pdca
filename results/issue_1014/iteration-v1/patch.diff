@@ -0,0 +1,482 @@
+//! The **orphan-identity migration gate** (proposal 0016 decision 4 rule 2, `0016:1251-1281`).
+//!
+//! GC's keyed protection (`retire:bytes:<token>` present ⇒ the mark's retirement is still
+//! draining) is sound only once **a fragment's mark names its most recent unreference event**.
+//! Two bounded populations break that: marks an older custodian wrote on fragments that were
+//! still referenced (the rollout skew), and marks a metadata restore brought back (`0016:1251-1259`).
+//! A one-time custodian walk of the `orphan:` ledger clears them, and this record is its durable
+//! completion **marker**: until a valid marker is observed, the identity-keyed retirement paths
+//! stay off — the routing of [`crate::metadata::unlink`] and the superseding commits through one
+//! `retire:bytes:g:<inode>:<version>` obligation, and GC's reliance on the keyed lookup.
+//!
+//! # The record (ADR-0046)
+//!
+//! | | |
+//! |---|---|
+//! | Key | [`ORPHAN_IDENTITY_KEY`], `migration:orphan-identity`: one singleton, no trailing `:` |
+//! | Value | [`CleanupMarker`]: `{"fence_generation":N}`, or `{}` when no restore-fence generation existed |
+//! | Writer | the custodian's cleanup walk (`wyrd_custodian`, `orphan_identity`), once a lap of the whole ledger completed clean — the only writer |
+//! | Deleter | none: a restore that rewinds it is answered by the generation it names, never by a delete |
+//! | Scans that see it | none: no namespace any pass scans (`inode:`, `pending:`, `orphan:`, `mpu:`, `retire:`, `seg:`, `repair:`, `desired:dserver:`, …) is a prefix of it |
+//! | Readers | this module's [`read_gate`]: the routing in [`crate::metadata`] and the custodian's GC pass |
+//!
+//! # Valid only for the restore-fence generation it was completed under
+//!
+//! A marker records the restore-fence generation ([`crate::multipart::MPUFENCE_KEY`]) that was
+//! current when its walk began — an absent record is a value too — and reads as complete only
+//! while that generation is still the current one ([`CleanupMarker::is_current`]). Every
+//! post-restore pass opens a new generation as its first write
+//! (`wyrd_custodian::restore`, `open_generation`), so a marker an image brings back stops reading
+//! as complete the moment that pass runs, and the walk runs again over the restored ledger. A
+//! restore whose post-restore pass never runs is outside the marker's reach: the runbook requires
+//! that pass before any gateway returns (`crates/server/src/cli.rs`, the restore runbook).
+//!
+//! # Serialization identity
+//!
+//! Closed (`deny_unknown_fields`) and canonical, as every record a compare-and-set reads is: an
+//! absent generation is **omitted**, never spelled `null` or `0`, and [`decode_cleanup_marker`]
+//! refuses any spelling but the encoder's own.
+
+use std::num::NonZeroU64;
+
+use bytes::Bytes;
+use serde::{Deserialize, Serialize};
+use wyrd_traits::{MetadataStore, Result, WriteBatch};
+
+use crate::metadata;
+use crate::multipart::{decode_fence_generation, FenceGeneration, RecordError, MPUFENCE_KEY};
+
+/// The singleton key of the orphan-identity cleanup marker (module doc, *The record*).
+pub const ORPHAN_IDENTITY_KEY: &[u8] = b"migration:orphan-identity";
+
+/// The orphan-identity cleanup marker: the walk of the whole `orphan:` ledger completed, every
+/// mark judged against a complete reference set, under the restore-fence generation it names.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct CleanupMarker {
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    fence_generation: Option<NonZeroU64>,
+}
+
+impl CleanupMarker {
+    /// The marker a walk that began under restore-fence generation `fence` writes — `None` when
+    /// the store held no [`MPUFENCE_KEY`] record then.
+    pub fn for_fence(fence: Option<&FenceGeneration>) -> Self {
+        Self {
+            fence_generation: fence.and_then(|fence| NonZeroU64::new(fence.generation())),
+        }
+    }
+
+    /// The restore-fence generation the walk began under, or `None` for an absent record.
+    pub fn fence_generation(&self) -> Option<u64> {
+        self.fence_generation.map(NonZeroU64::get)
+    }
+
+    /// Whether this marker reads as complete under the current restore-fence generation
+    /// `current`: the same generation number (whether or not that generation's pass completed —
+    /// its completion rewrites the record without opening a new one), or both absent.
+    pub fn is_current(&self, current: Option<&FenceGeneration>) -> bool {
+        self.fence_generation() == current.map(FenceGeneration::generation)
+    }
+}
+
+/// Encode a [`CleanupMarker`]: `{"fence_generation":N}`, or `{}`.
+pub fn encode_cleanup_marker(marker: &CleanupMarker) -> Bytes {
+    metadata::encode(marker)
+}
+
+/// Decode the [`ORPHAN_IDENTITY_KEY`] value, accepting exactly the bytes
+/// [`encode_cleanup_marker`] writes: a value that is not a marker is
+/// [`RecordError::MalformedRecordValue`], another spelling of one is
+/// [`RecordError::NoncanonicalRecordValue`].
+pub fn decode_cleanup_marker(value: &[u8]) -> std::result::Result<CleanupMarker, RecordError> {
+    let marker: CleanupMarker =
+        metadata::decode(value).map_err(|err| RecordError::MalformedRecordValue {
+            namespace: "migration:orphan-identity",
+            detail: err.to_string(),
+        })?;
+    if encode_cleanup_marker(&marker).as_ref() != value {
+        return Err(RecordError::NoncanonicalRecordValue {
+            namespace: "migration:orphan-identity",
+        });
+    }
+    Ok(marker)
+}
+
+/// The singleton key of the cleanup walk's own progress record ([`CleanupWalk`]): written and
+/// deleted by the custodian's walk alone, read by it and by its progress query. Under the
+/// custodian's own `custodian:` namespace, which no pass scans.
+pub const CLEANUP_WALK_KEY: &[u8] = b"custodian:orphan-identity-walk";
+
+/// The longest record name a [`CleanupWalk`] keeps for the record that blocked its lap, in
+/// bytes: a name past it is cut, so the progress record stays a small value whatever key the
+/// damaged record has.
+pub const MAX_BLOCKER_NAME_LEN: usize = 512;
+
+/// Where the cleanup walk stands: one **lap** of the `orphan:` ledger, from its head to its end,
+/// begun under one restore-fence generation and walked a window per custodian pass.
+///
+/// A position and a verdict, never evidence: whatever it holds, the walk only judges marks from
+/// there, and a record that will not decode starts a fresh lap. It carries:
+///
+/// * `fence_generation` — the restore-fence generation the lap began under (omitted for an
+///   absent record). A lap whose generation is no longer current is discarded: a restore
+///   since may have brought back marks it already passed.
+/// * `after` — the last `orphan:` key the lap judged, in lowercase hex (a ledger key need not be
+///   UTF-8); omitted at the head.
+/// * `blocked` — the first record the lap met that it could not read (an inode, a `seg:`, a
+///   `part:`, …), by its escaped name; a lap that met one never writes the marker.
+/// * `unsettled` — the lap met a mark whose drop it could neither commit nor find moot; it
+///   writes no marker either, and the next lap judges that mark again.
+/// * `ended` — the lap reached the end of the ledger and could not write the marker; the next
+///   pass begins a fresh lap. Kept until then so the verdict can be read.
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct CleanupWalk {
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    fence_generation: Option<NonZeroU64>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    after: Option<String>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    blocked: Option<String>,
+    #[serde(default, skip_serializing_if = "std::ops::Not::not")]
+    unsettled: bool,
+    #[serde(default, skip_serializing_if = "std::ops::Not::not")]
+    ended: bool,
+}
+
+impl CleanupWalk {
+    /// A fresh lap at the head of the ledger, begun under restore-fence generation `fence`.
+    pub fn begin(fence: Option<&FenceGeneration>) -> Self {
+        Self {
+            fence_generation: fence.and_then(|fence| NonZeroU64::new(fence.generation())),
+            after: None,
+            blocked: None,
+            unsettled: false,
+            ended: false,
+        }
+    }
+
+    /// The restore-fence generation the lap began under (`None`: an absent record).
+    pub fn fence_generation(&self) -> Option<u64> {
+        self.fence_generation.map(NonZeroU64::get)
+    }
+
+    /// Whether the lap began under the generation that is current now.
+    pub fn is_current(&self, current: Option<&FenceGeneration>) -> bool {
+        self.fence_generation() == current.map(FenceGeneration::generation)
+    }
+
+    /// The last `orphan:` key the lap judged, or `None` at the head.
+    pub fn after(&self) -> Option<Vec<u8>> {
+        self.after.as_deref().and_then(from_hex)
+    }
+
+    /// The record that blocked the lap, by its escaped name.
+    pub fn blocked(&self) -> Option<&str> {
+        self.blocked.as_deref()
+    }
+
+    /// Whether the lap met a drop it could not settle.
+    pub fn is_unsettled(&self) -> bool {
+        self.unsettled
+    }
+
+    /// Whether the lap reached the end of the ledger without writing the marker.
+    pub fn is_ended(&self) -> bool {
+        self.ended
+    }
+
+    /// The lap moved on past `key`.
+    pub fn advanced(self, key: &[u8]) -> Self {
+        Self {
+            after: Some(to_hex(key)),
+            ..self
+        }
+    }
+
+    /// The lap met `record` it could not read. The first blocker is kept; a name longer than
+    /// [`MAX_BLOCKER_NAME_LEN`] is cut at a character boundary.
+    pub fn with_blocker(self, record: &str) -> Self {
+        if self.blocked.is_some() {
+            return self;
+        }
+        let mut cut = record.len().min(MAX_BLOCKER_NAME_LEN);
+        while !record.is_char_boundary(cut) {
+            cut -= 1;
+        }
+        Self {
+            blocked: Some(record[..cut].to_owned()),
+            ..self
+        }
+    }
+
+    /// The lap met a drop it could not settle.
+    pub fn with_unsettled(self) -> Self {
+        Self {
+            unsettled: true,
+            ..self
+        }
+    }
+
+    /// The lap reached the end of the ledger and cannot write the marker: back at the head,
+    /// its verdict kept for reading until the next pass begins a fresh lap.
+    pub fn ended(self) -> Self {
+        Self {
+            after: None,
+            ended: true,
+            ..self
+        }
+    }
+}
+
+/// Encode a [`CleanupWalk`].
+pub fn encode_cleanup_walk(walk: &CleanupWalk) -> Bytes {
+    metadata::encode(walk)
+}
+
+/// Decode the [`CLEANUP_WALK_KEY`] value, accepting exactly the bytes [`encode_cleanup_walk`]
+/// writes: `after` must be lowercase hex of a non-empty key, and `blocked` within
+/// [`MAX_BLOCKER_NAME_LEN`].
+pub fn decode_cleanup_walk(value: &[u8]) -> std::result::Result<CleanupWalk, RecordError> {
+    let malformed = |detail: String| RecordError::MalformedRecordValue {
+        namespace: "custodian:orphan-identity-walk",
+        detail,
+    };
+    let walk: CleanupWalk = metadata::decode(value).map_err(|err| malformed(err.to_string()))?;
+    if let Some(after) = &walk.after {
+        if after.is_empty() || from_hex(after).is_none() {
+            return Err(malformed(format!("`after` {after:?} is not lowercase hex")));
+        }
+    }
+    if walk
+        .blocked
+        .as_ref()
+        .is_some_and(|name| name.len() > MAX_BLOCKER_NAME_LEN)
+    {
+        return Err(malformed("`blocked` is past its bound".to_owned()));
+    }
+    if encode_cleanup_walk(&walk).as_ref() != value {
+        return Err(RecordError::NoncanonicalRecordValue {
+            namespace: "custodian:orphan-identity-walk",
+        });
+    }
+    Ok(walk)
+}
+
+/// Lowercase hex of `bytes`.
+fn to_hex(bytes: &[u8]) -> String {
+    crate::multipart::hex_lower(bytes)
+}
+
+/// The bytes lowercase hex `text` spells, or `None` for anything else.
+fn from_hex(text: &str) -> Option<Vec<u8>> {
+    let digit = |c: u8| match c {
+        b'0'..=b'9' => Some(c - b'0'),
+        b'a'..=b'f' => Some(c - b'a' + 10),
+        _ => None,
+    };
+    let text = text.as_bytes();
+    if !text.len().is_multiple_of(2) {
+        return None;
+    }
+    text.chunks(2)
+        .map(|pair| Some(digit(pair[0])? << 4 | digit(pair[1])?))
+        .collect()
+}
+
+/// Why the gate is closed: the identity-keyed retirement paths stay off.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum Closed {
+    /// No marker: the cleanup walk has not completed on this store.
+    NoMarker,
+    /// A marker whose value is not one [`decode_cleanup_marker`] accepts.
+    MarkerUnreadable(String),
+    /// A restore-fence record whose value is not one
+    /// [`crate::multipart::decode_fence_generation`] accepts: no marker can be judged current.
+    FenceUnreadable(String),
+    /// A marker completed under another restore-fence generation than the current one — a
+    /// metadata restore since, whose post-restore pass opened a new generation.
+    StaleGeneration {
+        /// The generation the marker names (`None`: an absent record).
+        marker: Option<u64>,
+        /// The current generation (`None`: an absent record).
+        current: Option<u64>,
+    },
+}
+
+impl Closed {
+    /// The reason as an audit event spells it.
+    pub fn as_str(&self) -> &'static str {
+        match self {
+            Self::NoMarker => "no-marker",
+            Self::MarkerUnreadable(_) => "marker-unreadable",
+            Self::FenceUnreadable(_) => "fence-unreadable",
+            Self::StaleGeneration { .. } => "stale-generation",
+        }
+    }
+}
+
+/// The exact bytes a reader found the gate open on: the marker and the restore-fence record
+/// (`None` for an absent one). A writer that acts on the open gate pins both in its own batch
+/// ([`Self::pinned`]), so a restore's new generation landing between its read and its commit
+/// fails the commit rather than letting it route on a gate that has since closed.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct OpenGate {
+    marker: Bytes,
+    fence: Option<Bytes>,
+}
+
+impl OpenGate {
+    /// `batch` with the two preconditions the open gate rests on: the marker's exact bytes, and
+    /// the restore-fence record's exact bytes or its absence.
+    pub fn pinned(&self, batch: WriteBatch) -> WriteBatch {
+        let batch = batch.require(ORPHAN_IDENTITY_KEY, self.marker.clone());
+        match &self.fence {
+            Some(fence) => batch.require(MPUFENCE_KEY, fence.clone()),
+            None => batch.require_absent(MPUFENCE_KEY),
+        }
+    }
+
+    /// How many preconditions [`Self::pinned`] adds: two.
+    pub const PRECONDITIONS: usize = 2;
+}
+
+/// The gate as one reading of the store found it.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum Gate {
+    /// A valid marker: the identity-keyed retirement paths are on.
+    Open(OpenGate),
+    /// No valid marker: every path behaves as before the migration, and GC treats every
+    /// `orphan:` mark as protecting.
+    Closed(Closed),
+}
+
+impl Gate {
+    /// Whether the gate is open.
+    pub fn is_open(&self) -> bool {
+        matches!(self, Self::Open(_))
+    }
+}
+
+/// Read the gate: the marker and the current restore-fence generation, two keyed reads. Open
+/// only for a marker that decodes and names the generation that is current now; every other
+/// reading is [`Gate::Closed`], fail-closed — an unreadable record is never read as complete.
+/// Each read's await is bounded by the `MetadataStore` implementation's own network bound, as
+/// every metadata read is (#508/#636).
+pub async fn read_gate<S: MetadataStore + ?Sized>(store: &S) -> Result<Gate> {
+    let Some(marker_bytes) = store.get(ORPHAN_IDENTITY_KEY).await? else {
+        return Ok(Gate::Closed(Closed::NoMarker));
+    };
+    let marker = match decode_cleanup_marker(&marker_bytes) {
+        Ok(marker) => marker,
+        Err(fault) => return Ok(Gate::Closed(Closed::MarkerUnreadable(fault.to_string()))),
+    };
+    let fence_bytes = store.get(MPUFENCE_KEY).await?;
+    let fence = match fence_bytes
+        .as_deref()
+        .map(decode_fence_generation)
+        .transpose()
+    {
+        Ok(fence) => fence,
+        Err(fault) => return Ok(Gate::Closed(Closed::FenceUnreadable(fault.to_string()))),
+    };
+    if !marker.is_current(fence.as_ref()) {
+        return Ok(Gate::Closed(Closed::StaleGeneration {
+            marker: marker.fence_generation(),
+            current: fence.as_ref().map(FenceGeneration::generation),
+        }));
+    }
+    Ok(Gate::Open(OpenGate {
+        marker: marker_bytes,
+        fence: fence_bytes,
+    }))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn the_marker_round_trips_byte_for_byte_and_refuses_every_other_spelling() {
+        let absent = CleanupMarker::for_fence(None);
+        assert_eq!(encode_cleanup_marker(&absent).as_ref(), b"{}");
+        assert_eq!(decode_cleanup_marker(b"{}"), Ok(absent));
+
+        let fence = FenceGeneration::next(None).expect("generation 1");
+        let one = CleanupMarker::for_fence(Some(&fence));
+        assert_eq!(
+            encode_cleanup_marker(&one).as_ref(),
+            br#"{"fence_generation":1}"#
+        );
+        assert_eq!(decode_cleanup_marker(br#"{"fence_generation":1}"#), Ok(one));
+
+        for refused in [
+            &br#"{"fence_generation":null}"#[..],
+            br#"{"fence_generation":0}"#,
+            br#"{ "fence_generation":1}"#,
+            br#"{"fence_generation":1,"x":2}"#,
+            b"1",
+            b"",
+        ] {
+            assert!(
+                decode_cleanup_marker(refused).is_err(),
+                "{:?} must be refused",
+                String::from_utf8_lossy(refused)
+            );
+        }
+    }
+
+    #[test]
+    fn the_walk_record_round_trips_and_keeps_its_first_blocker() {
+        let fence = FenceGeneration::next(None).expect("generation 1");
+        let walk = CleanupWalk::begin(Some(&fence));
+        assert_eq!(
+            encode_cleanup_walk(&walk).as_ref(),
+            br#"{"fence_generation":1}"#
+        );
+        let key = b"orphan:3:7:\xff";
+        let walk = walk
+            .advanced(key)
+            .with_blocker("inode:9")
+            .with_blocker("part:x")
+            .with_unsettled();
+        assert_eq!(walk.after().as_deref(), Some(&key[..]));
+        assert_eq!(walk.blocked(), Some("inode:9"));
+        let bytes = encode_cleanup_walk(&walk);
+        assert_eq!(decode_cleanup_walk(&bytes), Ok(walk.clone()));
+        let ended = walk.ended();
+        assert!(ended.is_ended() && ended.after().is_none());
+        assert_eq!(decode_cleanup_walk(&encode_cleanup_walk(&ended)), Ok(ended));
+
+        for refused in [
+            &br#"{"after":"6F"}"#[..],
+            br#"{"after":"6"}"#,
+            br#"{"after":""}"#,
+            br#"{"unsettled":false}"#,
+            br#"{"blocked":null}"#,
+        ] {
+            assert!(decode_cleanup_walk(refused).is_err());
+        }
+        let long = "x".repeat(MAX_BLOCKER_NAME_LEN + 9);
+        let cut = CleanupWalk::begin(None).with_blocker(&long);
+        assert_eq!(cut.blocked().map(str::len), Some(MAX_BLOCKER_NAME_LEN));
+    }
+
+    #[test]
+    fn a_marker_is_current_only_under_the_generation_it_names() {
+        let first = FenceGeneration::next(None).expect("generation 1");
+        let second = FenceGeneration::next(Some(&first)).expect("generation 2");
+        let under_absent = CleanupMarker::for_fence(None);
+        let under_first = CleanupMarker::for_fence(Some(&first));
+        assert!(under_absent.is_current(None));
+        assert!(!under_absent.is_current(Some(&first)));
+        assert!(under_first.is_current(Some(&first)));
+        assert!(
+            under_first.is_current(Some(&first.completed())),
+            "a generation's completion is the same generation"
+        );
+        assert!(!under_first.is_current(Some(&second)));
+        assert!(!under_first.is_current(None));
+    }
+}
