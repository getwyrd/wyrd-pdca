     let (zone, leader) = elect(&coord).await;
+    // The pass opened a new restore-fence generation, so the orphan-identity marker the store
+    // held no longer reads as complete and GC treats every mark as protecting (#1014) until the
+    // repair loop's cleanup has walked the restored ledger — which the deployed loop does before
+    // its GC pass.
+    repair_pass(&zone, &leader, &meta, &fleet, NOW).await;
 
     // Still inside the grace window: GC must STILL decline. The reader-safety window is not
     // shortened by the pass — it is started by it.
