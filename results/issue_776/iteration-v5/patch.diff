+        // The object deleted outright: likewise.
+        let deleted = WriteBatch::new().delete(inode_key(INODE));
+        assert_eq!(commit(&store, deleted), CommitOutcome::Committed);
+        assert!(matches!(
+            repoint(&store, &root, 8, &c(), vec![99]),
+            Ok(Repoint::Conflict)
+        ));
+    }
