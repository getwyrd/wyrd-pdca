diff --git a/crates/server/tests/s3_last_modified_agreement.rs b/crates/server/tests/s3_last_modified_agreement.rs
new file mode 100644
index 0000000..1bac272
--- /dev/null
+++ b/crates/server/tests/s3_last_modified_agreement.rs
@@ -0,0 +1,424 @@
+//! A listing and a HEAD/GET report the **same instant** for one object's modification time
+//! (issue #767), over the shipping S3 wire surface of the in-process gateway.
+//!
+//! The store keeps `modified` in epoch **milliseconds** (ADR-0047). The `Last-Modified`
+//! header is an RFC-7231 IMF-fixdate, which has one-second resolution, so it drops the
+//! millisecond part. Before #767 the listing's `<LastModified>` kept it as a `.mmm` fraction,
+//! so for any stored value not on a whole second (about 999 in 1000) the two surfaces named
+//! different instants — a sync tool that caches a listing's `LastModified` and revalidates
+//! with HEAD saw a mismatch on every object, every pass. Real S3 listings are second-granular
+//! (`.000Z`) and agree with HEAD; this test pins that rule:
+//!
+//! * an object stored at `1_700_000_000_750` lists as exactly `2023-11-14T22:13:20.000Z`
+//!   under ListObjectsV2 **and** v1 ListObjects;
+//! * HEAD **and** GET carry `Last-Modified: Tue, 14 Nov 2023 22:13:20 GMT`;
+//! * the listing value and the header value, each parsed by an independent parser below,
+//!   name the same instant;
+//! * an object stored exactly on a second (`1_700_000_000_000`) renders the same as before.
+//!
+//! Harness: the bucket marker and both objects are seeded on the store BEFORE it moves into
+//! `Gateway::new` (the `s3_list_objects.rs` `seed_bucket` + `start_gateway` pattern); each
+//! object is a genuine flat write through `wyrd_core::write` (the `segmented_object_read.rs`
+//! `write_flat` pattern) with the plan's `object_meta.modified` set — the field the gateway
+//! itself stamps on PUT — under the dirent name `"{bucket}/{key}"` beneath `ROOT`. Requests
+//! are raw signed HTTP so the exact wire bytes are asserted with no SDK date decoding in
+//! between. Every symbol used here predates #767, so on the pre-fix base this file compiles
+//! and fails by assertion (`.750Z` against `:20 GMT`).
+
+#![forbid(unsafe_code)]
+// wall-clock exempt (test crate): SigV4 request dates against a live in-process server use
+// real wall time; the asserted `modified` values are fixed constants seeded on the store, so
+// nothing here mixes clock sources within one asserted lifecycle (#619).
+#![allow(clippy::disallowed_methods)]
+
+use std::net::SocketAddr;
+use std::sync::Arc;
+use std::time::SystemTime;
+
+use tokio::io::{AsyncReadExt, AsyncWriteExt};
+use tokio::net::{TcpListener, TcpStream};
+use wyrd_chunkstore_fs::FsChunkStore;
+use wyrd_coordination_mem::MemCoordination;
+use wyrd_core::metadata::{EcScheme, ObjectMeta};
+use wyrd_core::write;
+use wyrd_gateway_s3::sigv4::{format_amz_date, sign, Credentials as GatewayCredentials};
+use wyrd_gateway_s3::{S3Config, S3Gateway};
+use wyrd_metadata_redb::RedbMetadataStore;
+use wyrd_server::Gateway;
+use wyrd_traits::{CommitOutcome, MetadataStore, WriteBatch};
+
+const ACCESS_KEY: &str = "AKIAIOSFODNN7EXAMPLE";
+const SECRET_KEY: &str = "wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY";
+const REGION: &str = "us-east-1";
+
+const ROOT: u64 = 0;
+const NOW: u64 = 1_000;
+const TTL: u64 = 5_000;
+const CHUNK: usize = 4;
+
+const BUCKET: &str = "stamps";
+/// Stored off a second boundary: the case that disagreed before #767.
+const OFF_KEY: &str = "off-second";
+const OFF_MODIFIED: u64 = 1_700_000_000_750;
+/// Stored exactly on a second: must render as it always did.
+const ON_KEY: &str = "on-second";
+const ON_MODIFIED: u64 = 1_700_000_000_000;
+
+const EXPECTED_ISO: &str = "2023-11-14T22:13:20.000Z";
+const EXPECTED_IMF: &str = "Tue, 14 Nov 2023 22:13:20 GMT";
+
+/// Seed a `bucket:{name}` existence marker as raw key/value bytes (listing only reads it for
+/// presence), as `s3_list_objects.rs::seed_bucket` does.
+async fn seed_bucket(meta: &RedbMetadataStore, name: &str) {
+    let key = format!("bucket:{name}").into_bytes();
+    let value = format!("{{\"name\":\"{name}\",\"created_millis\":0}}").into_bytes();
+    meta.commit(WriteBatch::new().put(key, value))
+        .await
+        .expect("commit bucket marker");
+}
+
+/// Write a genuine flat object through the ordinary write path (real fragments, the dirent the
+/// gateway resolves the key through), stamping `modified` on the plan exactly where the
+/// gateway's own PUT stamps it.
+async fn write_flat(
+    meta: &RedbMetadataStore,
+    chunks: &FsChunkStore,
+    inode_id: u64,
+    name: &str,
+    data: &[u8],
+    modified: u64,
+    id_base: u128,
+) {
+    let mut next = id_base;
+    let mut plan = write::plan_write(data, CHUNK, EcScheme::None, || {
+        next += 1;
+        next
+    })
+    .expect("plan");
+    plan.object_meta = ObjectMeta {
+        etag: None,
+        content_type: None,
+        modified: Some(modified),
+    };
+    write::intent(meta, &plan, NOW + TTL).await.expect("intent");
+    write::write_fragments(chunks, &plan)
+        .await
+        .expect("fan out");
+    assert_eq!(
+        write::commit_create(meta, ROOT, name, inode_id, &plan, NOW)
+            .await
+            .expect("commit"),
+        CommitOutcome::Committed
+    );
+    write::release(meta, &plan).await.expect("release");
+}
+
+/// Seed the bucket and both objects, then start the S3 gateway on an ephemeral loopback port.
+/// The `TempDir` is returned so the caller keeps the chunk store alive.
+async fn start_gateway() -> (SocketAddr, tempfile::TempDir) {
+    let dir = tempfile::tempdir().expect("temp dir");
+    let meta = RedbMetadataStore::in_memory().expect("redb");
+    let chunks = FsChunkStore::open(dir.path()).expect("fs store");
+    seed_bucket(&meta, BUCKET).await;
+    write_flat(
+        &meta,
+        &chunks,
+        1_001,
+        &format!("{BUCKET}/{OFF_KEY}"),
+        b"off-second body",
+        OFF_MODIFIED,
+        10_000,
+    )
+    .await;
+    write_flat(
+        &meta,
+        &chunks,
+        1_002,
+        &format!("{BUCKET}/{ON_KEY}"),
+        b"on-second body",
+        ON_MODIFIED,
+        20_000,
+    )
+    .await;
+    let gateway = Arc::new(Gateway::new(meta, chunks, MemCoordination::new()).with_chunk_size(8));
+    let config = S3Config::new(vec![GatewayCredentials {
+        access_key_id: ACCESS_KEY.to_string(),
+        secret_access_key: SECRET_KEY.to_string(),
+    }]);
+    let listener = TcpListener::bind("127.0.0.1:0").await.expect("bind");
+    let addr = listener.local_addr().expect("addr");
+    let server = S3Gateway::new(gateway, config);
+    tokio::spawn(async move {
+        server.serve(listener).await.expect("serve");
+    });
+    (addr, dir)
+}
+
+/// A raw response: status, the header block (lowercased names), and the de-framed body.
+struct Response {
+    status: u16,
+    headers: Vec<(String, String)>,
+    body: String,
+}
+
+impl Response {
+    fn header(&self, name: &str) -> Option<&str> {
+        self.headers
+            .iter()
+            .find(|(n, _)| n == name)
+            .map(|(_, v)| v.as_str())
+    }
+}
+
+/// Send a raw SigV4-signed `{method} {path}[?{query}]`. A listing request carries a query, so
+/// the canonical query is signed (an empty-query signature would 403 —
+/// `s3_list_objects.rs::signed_headers_q`).
+async fn send(addr: SocketAddr, method: &str, path: &str, query: &str) -> Response {
+    let host = addr.to_string();
+    let creds = GatewayCredentials {
+        access_key_id: ACCESS_KEY.to_string(),
+        secret_access_key: SECRET_KEY.to_string(),
+    };
+    let amz_date = format_amz_date(SystemTime::now());
+    let signed = sign(
+        method, path, query, &host, &amz_date, b"", &creds, REGION, "s3",
+    );
+    let target = if query.is_empty() {
+        path.to_string()
+    } else {
+        format!("{path}?{query}")
+    };
+    let mut request = format!("{method} {target} HTTP/1.1\r\n");
+    request.push_str(&format!("host: {host}\r\n"));
+    request.push_str(&format!("authorization: {}\r\n", signed.authorization));
+    request.push_str(&format!("x-amz-date: {}\r\n", signed.amz_date));
+    request.push_str(&format!(
+        "x-amz-content-sha256: {}\r\n",
+        signed.content_sha256
+    ));
+    request.push_str("content-length: 0\r\n");
+    request.push_str("connection: close\r\n\r\n");
+
+    let mut stream = TcpStream::connect(addr).await.expect("connect");
+    stream
+        .write_all(request.as_bytes())
+        .await
+        .expect("write head");
+    stream.flush().await.expect("flush");
+    let mut raw = Vec::new();
+    stream.read_to_end(&mut raw).await.expect("read response");
+
+    let split = raw
+        .windows(4)
+        .position(|w| w == b"\r\n\r\n")
+        .expect("response has a header terminator");
+    let head = String::from_utf8_lossy(&raw[..split]).into_owned();
+    let mut lines = head.lines();
+    let status: u16 = lines
+        .next()
+        .expect("status line")
+        .split_whitespace()
+        .nth(1)
+        .expect("status code")
+        .parse()
+        .expect("numeric status");
+    let headers: Vec<(String, String)> = lines
+        .filter_map(|l| l.split_once(':'))
+        .map(|(n, v)| (n.trim().to_ascii_lowercase(), v.trim().to_string()))
+        .collect();
+    let body_raw = &raw[split + 4..];
+    let chunked = headers
+        .iter()
+        .any(|(n, v)| n == "transfer-encoding" && v.to_ascii_lowercase().contains("chunked"));
+    let body = if chunked {
+        String::from_utf8_lossy(&dechunk(body_raw)).into_owned()
+    } else {
+        String::from_utf8_lossy(body_raw).into_owned()
+    };
+    Response {
+        status,
+        headers,
+        body,
+    }
+}
+
+/// Decode an HTTP/1.1 chunked-transfer-encoded body.
+fn dechunk(mut raw: &[u8]) -> Vec<u8> {
+    let mut out = Vec::new();
+    while let Some(line_end) = raw.windows(2).position(|w| w == b"\r\n") {
+        let size_str = String::from_utf8_lossy(&raw[..line_end]);
+        let size = usize::from_str_radix(size_str.trim(), 16).unwrap_or(0);
+        raw = &raw[line_end + 2..];
+        if size == 0 || size > raw.len() {
+            break;
+        }
+        out.extend_from_slice(&raw[..size]);
+        raw = &raw[size + 2..];
+    }
+    out
+}
+
+/// The `<LastModified>` of the `<Contents>` row whose `<Key>` is `key`, failing loudly if the
+/// row or the element is missing (an omitted element must not pass as "agreement").
+fn listed_last_modified(body: &str, key: &str) -> String {
+    let row = body
+        .split("<Contents>")
+        .skip(1)
+        .find(|row| row.contains(&format!("<Key>{key}</Key>")))
+        .unwrap_or_else(|| panic!("no <Contents> row for {key} in listing: {body}"));
+    let start = row
+        .find("<LastModified>")
+        .unwrap_or_else(|| panic!("row for {key} has no <LastModified>: {body}"))
+        + "<LastModified>".len();
+    let end = row[start..]
+        .find("</LastModified>")
+        .expect("closed <LastModified>")
+        + start;
+    row[start..end].to_string()
+}
+
+/// Days since 1970-01-01 for a proleptic-Gregorian civil date (Howard Hinnant's
+/// `days_from_civil`) — the inverse of the gateway's formatter, written independently here so
+/// the instant comparison is not self-referential.
+fn days_from_civil(year: i64, month: i64, day: i64) -> i64 {
+    let y = if month <= 2 { year - 1 } else { year };
+    let era = y.div_euclid(400);
+    let yoe = y - era * 400;
+    let mp = (month + 9) % 12;
+    let doy = (153 * mp + 2) / 5 + day - 1;
+    let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;
+    era * 146_097 + doe - 719_468
+}
+
+fn num(s: &str) -> i64 {
+    assert!(s.bytes().all(|b| b.is_ascii_digit()), "not digits: {s:?}");
+    s.parse().expect("digits")
+}
+
+/// Parse a listing's `YYYY-MM-DDTHH:MM:SS.mmmZ` into epoch milliseconds, keeping the fraction.
+fn parse_iso_millis(s: &str) -> i64 {
+    assert_eq!(s.len(), 24, "ISO-8601 instant shape: {s:?}");
+    let b = s.as_bytes();
+    assert_eq!(
+        (b[4], b[7], b[10], b[13], b[16], b[19], b[23]),
+        (b'-', b'-', b'T', b':', b':', b'.', b'Z'),
+        "ISO-8601 separators: {s:?}"
+    );
+    let days = days_from_civil(num(&s[0..4]), num(&s[5..7]), num(&s[8..10]));
+    let secs = days * 86_400 + num(&s[11..13]) * 3_600 + num(&s[14..16]) * 60 + num(&s[17..19]);
+    secs * 1_000 + num(&s[20..23])
+}
+
+/// Parse an IMF-fixdate `Www, DD Mon YYYY HH:MM:SS GMT` into epoch milliseconds (whole seconds).
+fn parse_imf_millis(s: &str) -> i64 {
+    const MONTHS: [&str; 12] = [
+        "Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec",
+    ];
+    let parts: Vec<&str> = s.split(' ').collect();
+    assert_eq!(parts.len(), 6, "IMF-fixdate shape: {s:?}");
+    assert_eq!(parts[5], "GMT", "IMF-fixdate zone: {s:?}");
+    let month = MONTHS
+        .iter()
+        .position(|m| *m == parts[2])
+        .unwrap_or_else(|| panic!("IMF-fixdate month: {s:?}")) as i64
+        + 1;
+    let days = days_from_civil(num(parts[3]), month, num(parts[1]));
+    let hms: Vec<&str> = parts[4].split(':').collect();
+    assert_eq!(hms.len(), 3, "IMF-fixdate time: {s:?}");
+    (days * 86_400 + num(hms[0]) * 3_600 + num(hms[1]) * 60 + num(hms[2])) * 1_000
+}
+
+#[test]
+fn the_independent_parsers_are_sound() {
+    // The oracle the agreement assertions lean on: both parsers recover the known instant.
+    assert_eq!(
+        parse_iso_millis("2023-11-14T22:13:20.750Z"),
+        OFF_MODIFIED as i64
+    );
+    assert_eq!(parse_iso_millis(EXPECTED_ISO), ON_MODIFIED as i64);
+    assert_eq!(parse_imf_millis(EXPECTED_IMF), ON_MODIFIED as i64);
+}
+
+/// One object's modification time as every S3 surface reports it.
+struct Surfaces {
+    list_v2: String,
+    list_v1: String,
+    head: String,
+    get: String,
+}
+
+async fn surfaces(addr: SocketAddr, key: &str) -> Surfaces {
+    let bucket_path = format!("/{BUCKET}");
+    let v2 = send(addr, "GET", &bucket_path, "list-type=2").await;
+    assert_eq!(v2.status, 200, "ListObjectsV2: {}", v2.body);
+    let v1 = send(addr, "GET", &bucket_path, "").await;
+    assert_eq!(v1.status, 200, "v1 ListObjects: {}", v1.body);
+    assert!(
+        !v1.body.contains("<KeyCount>"),
+        "the bare bucket GET must be the v1 listing, not v2: {}",
+        v1.body
+    );
+
+    let object_path = format!("/{BUCKET}/{key}");
+    let head = send(addr, "HEAD", &object_path, "").await;
+    assert_eq!(head.status, 200, "HEAD {key}");
+    let get = send(addr, "GET", &object_path, "").await;
+    assert_eq!(get.status, 200, "GET {key}: {}", get.body);
+
+    Surfaces {
+        list_v2: listed_last_modified(&v2.body, key),
+        list_v1: listed_last_modified(&v1.body, key),
+        head: head
+            .header("last-modified")
+            .unwrap_or_else(|| panic!("HEAD {key} carries no Last-Modified"))
+            .to_string(),
+        get: get
+            .header("last-modified")
+            .unwrap_or_else(|| panic!("GET {key} carries no Last-Modified"))
+            .to_string(),
+    }
+}
+
+fn assert_agreement(key: &str, s: &Surfaces) {
+    // (1) Both listing forms render the whole second.
+    assert_eq!(
+        s.list_v2, EXPECTED_ISO,
+        "ListObjectsV2 <LastModified> of {key}"
+    );
+    assert_eq!(
+        s.list_v1, EXPECTED_ISO,
+        "v1 ListObjects <LastModified> of {key}"
+    );
+    // (2) HEAD and GET carry the IMF-fixdate of that second.
+    assert_eq!(s.head, EXPECTED_IMF, "HEAD Last-Modified of {key}");
+    assert_eq!(s.get, EXPECTED_IMF, "GET Last-Modified of {key}");
+    // (3) Parsed independently, every surface names the same instant.
+    let header_instant = parse_imf_millis(&s.head);
+    for (surface, listed) in [("v2", &s.list_v2), ("v1", &s.list_v1)] {
+        assert_eq!(
+            parse_iso_millis(listed),
+            header_instant,
+            "{surface} listing ({listed}) and HEAD ({}) disagree on {key}'s instant",
+            s.head
+        );
+    }
+    assert_eq!(
+        parse_imf_millis(&s.get),
+        header_instant,
+        "GET vs HEAD for {key}"
+    );
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn off_second_modified_lists_and_heads_as_the_same_instant() {
+    let (addr, _dir) = start_gateway().await;
+    let s = surfaces(addr, OFF_KEY).await;
+    assert_agreement(OFF_KEY, &s);
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn on_second_modified_renders_unchanged_on_both_surfaces() {
+    let (addr, _dir) = start_gateway().await;
+    let s = surfaces(addr, ON_KEY).await;
+    assert_agreement(ON_KEY, &s);
