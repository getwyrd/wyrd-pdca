+/// A composed **multipart ETag**: `<64 lowercase hex>-<N>`, a validated type so a stored
+/// [`Completion`] can never carry a spelling a client comparison would treat as a different
+/// object.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
+pub struct MultipartEtag {
+    composed: Digest,
+    parts: u32,
+}
+
+impl MultipartEtag {
+    /// The validating parser — the inverse of [`fmt::Display`]: 64 lowercase-hex characters,
+    /// a `-`, then a **canonical** decimal part count — non-zero and at most
+    /// [`MAX_PART_NUMBER`] (the count-vs-keyspace check the v2 review found missing).
+    pub fn parse(text: &str) -> Result<Self, RecordError> {
+        let malformed = || RecordError::MultipartEtagMalformed {
+            etag: text.to_string(),
+        };
+        let (hex, count_text) = text.rsplit_once('-').ok_or_else(malformed)?;
+        let composed = Digest::from_hex(hex)?;
+        let parts: u32 = canonical_decimal(count_text).ok_or_else(malformed)?;
+        if parts == 0 {
+            return Err(RecordError::NoPartsNamed);
+        }
+        if parts > MAX_PART_NUMBER {
+            return Err(RecordError::EtagPartCountOutOfRange {
+                parts: u64::from(parts),
+            });
+        }
+        Ok(Self { composed, parts })
+    }
+
+    /// The SHA-256 over the concatenated raw part digests.
+    pub const fn composed(&self) -> Digest {
+        self.composed
+    }
+
+    /// How many parts the object was assembled from — the `-N` suffix.
+    pub const fn parts(&self) -> u32 {
+        self.parts
+    }
+}
+
+impl fmt::Display for MultipartEtag {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        write!(f, "{}-{}", self.composed, self.parts)
+    }
+}
+
+impl Serialize for MultipartEtag {
+    fn serialize<S: serde::Serializer>(&self, serializer: S) -> Result<S::Ok, S::Error> {
+        serializer.serialize_str(&self.to_string())
+    }
+}
+
+impl<'de> Deserialize<'de> for MultipartEtag {
+    fn deserialize<D: Deserializer<'de>>(deserializer: D) -> Result<Self, D::Error> {
+        Self::parse(&String::deserialize(deserializer)?).map_err(DeError::custom)
+    }
+}
+
+/// The **multipart ETag** — the composition this slice settles on top of ADR-0047's basis,
+/// which closed the digest algorithm and deferred only the composition
+/// (`docs/design/adr/0047-object-metadata-model.md:73-89`, `:112`; `0016:3064-3070`):
+///
+/// ```text
+/// etag = lowercase_hex( SHA-256( d_1 || d_2 || ... || d_N ) ) + "-" + N
+/// ```
+///
+/// `d_i` is the **raw 32 binary digest bytes** — never hex text, no separators, no part
+/// numbers mixed in — of the *i*-th part in ascending part-number order over exactly the
+/// parts the caller named, and `N` is that count. **Never MD5**: S3's own multipart ETag is
+/// an MD5-of-MD5s, but ADR-0047 rejected re-opening the dependency wall for a legacy
+/// equality S3 itself does not guarantee, and the value is opaque to clients regardless.
+pub fn multipart_etag(named: &[(PartNumber, Digest)]) -> Result<MultipartEtag, RecordError> {
+    let ordered = canonical_named_parts(named)?;
+    let mut concatenated = Vec::with_capacity(ordered.len() * 32);
+    for (_, digest) in &ordered {
+        concatenated.extend_from_slice(digest.as_bytes());
+    }
+    Ok(MultipartEtag {
+        composed: Digest::of(&concatenated),
+        parts: ordered.len() as u32,
+    })
+}
+
+/// The **request identity** a `Completed` tombstone answers a retry on — a digest over the
+/// ordered `(part_number, digest)` pairs the winning Complete named (`0016:898-908`).
+///
+/// Separate from [`multipart_etag`] deliberately: the ETag is a function of the digests
+/// alone, so two different part *numberings* of the same bodies would collide in it here the
+/// numbers are mixed in, so a client reusing an upload id with a **different assembly** is
+/// answered `NoSuchUpload` rather than told *its* assembly succeeded while the store holds
+/// an earlier one. Fixed-width fields and a length-first hash make the encoding injective.
+pub fn complete_fingerprint(named: &[(PartNumber, Digest)]) -> Result<Digest, RecordError> {
+    let ordered = canonical_named_parts(named)?;
+    let mut bytes = Vec::with_capacity(8 + ordered.len() * (4 + 32));
+    bytes.extend_from_slice(&(ordered.len() as u64).to_be_bytes());
+    for (part_number, digest) in &ordered {
+        bytes.extend_from_slice(&part_number.to_be_bytes());
+        bytes.extend_from_slice(digest.as_bytes());
+    }
+    Ok(Digest::of(&bytes))
+}
