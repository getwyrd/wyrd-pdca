+// ===========================================================================
+// 11. The multipart ETag and the Complete request-identity fingerprint
+//     (`0016:894-1037`; the deferral `0016:3064-3070`; ADR-0047:73-89,`:112`)
+// ===========================================================================
+
+/// The parts a Complete named, canonicalised to the **one** order both digests below are
+/// defined over: strictly ascending part number, each number named once.
+///
+/// **Refuses rather than sorts** ([`RecordError::PartsOutOfOrder`] /
+/// [`RecordError::DuplicatePart`]) — the carried-forward v2 review finding: a prior revision
+/// coalesced and sorted via a `BTreeMap`, silently accepting a request the client never
+/// made. 0016 makes ascending part numbers a Complete *validation* (`0016:707`, `:994`), so
+/// this function receives an already-ascending, duplicate-free list or refuses it.
+///
+/// One definition, shared by [`multipart_etag`] and [`complete_fingerprint`], so "the parts
+/// the client named" cannot mean two different orders to the two digests.
+fn canonical_named_parts(
+    named: &[(PartNumber, Digest)],
+) -> Result<Vec<(u32, Digest)>, RecordError> {
+    if named.is_empty() {
+        return Err(RecordError::NoPartsNamed);
+    }
+    let mut ordered = Vec::with_capacity(named.len());
+    let mut previous: Option<u32> = None;
+    for (part_number, digest) in named {
+        let number = part_number.get();
+        if let Some(previous) = previous {
+            if number == previous {
+                return Err(RecordError::DuplicatePart {
+                    part_number: number,
+                });
+            }
+            if number < previous {
+                return Err(RecordError::PartsOutOfOrder {
+                    part_number: number,
+                    previous,
+                });
+            }
+        }
+        previous = Some(number);
+        ordered.push((number, *digest));
+    }
+    Ok(ordered)
+}
