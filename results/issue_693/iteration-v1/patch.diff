+pub enum ListPartsAnswer {
+    /// The session is `Open`: the still-growing part set.
+    OpenSet,
+    /// The session is `Completing`: the frozen part set the fence read.
+    FrozenSet,
+    /// A typed refusal.
+    Refused(Refusal),
+}
+
+/// Whether `ListMultipartUploads` lists this session (`0016:975`).
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum ListUploadsAnswer {
+    /// In progress: listed.
+    Listed,
+    /// Tearing down or torn down: not listed.
+    NotListed,
+}
+
+/// One cell of decision 3's table, so the whole verb x state product can be enumerated
+/// through a single entry point ([`answer`]) and asserted **total**.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum Answer {
+    /// `UploadPart`'s answer.
+    UploadPart(UploadPartAnswer),
+    /// `CompleteMultipartUpload`'s answer.
+    Complete(CompleteAnswer),
+    /// `AbortMultipartUpload`'s answer.
+    Abort(AbortAnswer),
+    /// `ListParts`' answer.
+    ListParts(ListPartsAnswer),
+    /// `ListMultipartUploads`'s answer.
+    ListUploads(ListUploadsAnswer),
+}
+
+/// What `UploadPart` answers against `state` (`None` = the record is absent).
+///
+/// A part accepted after the fence would be invisible to the publication that already read
+/// the set — a silently lost part — so every state but `Open` refuses (`0016:1029`).
+pub fn upload_part_answer(state: Option<&SessionState>) -> UploadPartAnswer {
+    match state {
+        Some(SessionState::Open {}) => UploadPartAnswer::Accepted,
+        Some(
+            SessionState::Completing { .. }
+            | SessionState::Aborting {}
+            | SessionState::Completed { .. },
+        )
+        | None => UploadPartAnswer::Refused(Refusal::NoSuchUpload),
+    }
+}
+
+/// What `CompleteMultipartUpload` answers against `state` (`None` = the record is absent),
+/// for a request whose named parts fingerprint to `request_fingerprint` (`None` for a
+/// caller — [`answer`]'s own no-fingerprint callers — that has none to offer, which cannot
+/// match any recorded fingerprint and so is the honest input for every non-conditional
+/// cell).
+///
+/// The tombstone cell is the one 0016 spends most words on, and the **only** cell with a
+/// condition: within its window a `Completed` session answers the recorded publication when
+/// the request's [`complete_fingerprint`] matches the recorded one, and `NoSuchUpload`
+/// otherwise — the honest answer, since the upload id is consumed and no session exists
+/// that could publish the assembly being asked for (`0016:898-908`).
+///
+/// **The one function [`answer`] delegates to for this verb**, never a second inline copy
+/// of the same table: a duplicate would let a fix to one copy leave the other's cell
+/// silently wrong, exactly the risk this module's typed vocabulary exists to close.
+pub fn complete_answer(
+    state: Option<&SessionState>,
+    request_fingerprint: Option<&Digest>,
+) -> CompleteAnswer {
+    match state {
+        None => CompleteAnswer::Refused(Refusal::NoSuchUpload),
+        Some(SessionState::Open {}) => CompleteAnswer::Fences,
+        Some(SessionState::Completing { .. }) => CompleteAnswer::Refused(Refusal::OperationAborted),
+        Some(SessionState::Aborting {}) => CompleteAnswer::Refused(Refusal::NoSuchUpload),
+        Some(SessionState::Completed { completion }) => match request_fingerprint {
+            Some(fingerprint) if completion.complete_fingerprint == *fingerprint => {
+                CompleteAnswer::AlreadyCompleted(Box::new(Publication::of(completion)))
+            }
+            _ => CompleteAnswer::Refused(Refusal::NoSuchUpload),
+        },
+    }
+}
+
+/// What `AbortMultipartUpload` answers against `state` (`None` = the record is absent).
+///
+/// `Completing` is `409` for **every** client verb including this one: an Abort that could
+/// preempt a live publisher would race the flip it is fencing against (`0016:980-986`).
+pub fn abort_answer(state: Option<&SessionState>) -> AbortAnswer {
+    match state {
+        Some(SessionState::Open {}) => AbortAnswer::Fences,
+        Some(SessionState::Completing { .. }) => AbortAnswer::Refused(Refusal::OperationAborted),
+        Some(SessionState::Aborting {}) => AbortAnswer::AlreadyAborting,
+        Some(SessionState::Completed { .. }) | None => AbortAnswer::Refused(Refusal::NoSuchUpload),
+    }
+}
+
+/// What `ListParts` answers against `state` (`None` = the record is absent).
+pub fn list_parts_answer(state: Option<&SessionState>) -> ListPartsAnswer {
+    match state {
+        Some(SessionState::Open {}) => ListPartsAnswer::OpenSet,
+        Some(SessionState::Completing { .. }) => ListPartsAnswer::FrozenSet,
+        Some(SessionState::Aborting {} | SessionState::Completed { .. }) | None => {
+            ListPartsAnswer::Refused(Refusal::NoSuchUpload)
+        }
+    }
+}
+
+/// Whether `ListMultipartUploads` lists a session in `state` (`None` = the record is
+/// absent). A session the reaper fenced at `W_session` is `Aborting`, so it drops out of the
+/// listing — the S3-visible signal that the upload expired.
+pub fn list_uploads_answer(state: Option<&SessionState>) -> ListUploadsAnswer {
+    match state {
+        Some(SessionState::Open {} | SessionState::Completing { .. }) => ListUploadsAnswer::Listed,
+        Some(SessionState::Aborting {} | SessionState::Completed { .. }) | None => {
+            ListUploadsAnswer::NotListed
+        }
+    }
+}
+
+/// Decision 3's answer table (`0016:969-978`) as **one total pure function** over the 5-verb
+/// x 5-state product — `Open`/`Completing`/`Aborting`/`Completed`/absent.
+///
+/// `request_fingerprint` is consulted **only** for the one conditional cell
+/// (`CompleteMultipartUpload` against a `Completed` tombstone) and ignored everywhere else,
+/// so the function can be called uniformly over the whole product; an absent one cannot
+/// match any recorded fingerprint, which is the honest answer for a Complete that named no
+/// parts at all.
+///
+/// Every match below is exhaustive, so answering a new (verb, state) cell is a compile-time
+/// obligation rather than a silent gap; [`Verb::ALL`] makes the verb half of that obligation
+/// visible to the table test.
+pub fn answer(
+    verb: Verb,
+    state: Option<&SessionState>,
+    request_fingerprint: Option<&Digest>,
+) -> Answer {
+    match verb {
+        Verb::UploadPart => Answer::UploadPart(upload_part_answer(state)),
+        Verb::CompleteMultipartUpload => {
+            Answer::Complete(complete_answer(state, request_fingerprint))
+        }
+        Verb::AbortMultipartUpload => Answer::Abort(abort_answer(state)),
+        Verb::ListParts => Answer::ListParts(list_parts_answer(state)),
+        Verb::ListMultipartUploads => Answer::ListUploads(list_uploads_answer(state)),
+    }
+}
diff --git a/crates/core/tests/multipart_state_machine.rs b/crates/core/tests/multipart_state_machine.rs
new file mode 100644
index 0000000..2ebe648
--- /dev/null
+++ b/crates/core/tests/multipart_state_machine.rs
@@ -0,0 +1,662 @@
+//! Issue #693 (654 split 3/3) — decision 3's **verb x state answer table** as pure, total
+//! functions (`wyrd_core::multipart::{answer, Verb, *Answer, *Outcome, Refusal, InvalidPart,
+//! Backpressure, Publication}`) and the two digests, `multipart_etag` and
+//! `complete_fingerprint` (proposal 0016 decision 3, `:894-1037`; the deferral
+//! `:3064-3070`; ADR-0047:73-89, `:112`). **Pure**: no store, no async, no fixture beyond
+//! literals and the production functions under test.
+//!
+//! The five legs (Success criterion, brief #693):
+//!
+//! * **leg 1** — every reachable (verb, state) cell of the 5x5 product
+//!   (`{UploadPart, CompleteMultipartUpload, AbortMultipartUpload, ListParts,
+//!   ListMultipartUploads} x {Open, Completing, Aborting, Completed, absent}`) is answered by
+//!   its typed outcome, asserted through one exhaustive helper so an unanswered cell fails
+//!   loudly rather than falling through a wildcard; the `Complete x Completed` cell's two
+//!   branches (fingerprint match / mismatch) both get their own assertion;
+//! * **leg 2** — `multipart_etag` matches an independent oracle (a hand-rolled concatenation
+//!   and a second, direct `sha2` call, never through `canonical_named_parts` or
+//!   `Digest::of`), and its discriminating cases;
+//! * **leg 3** — `complete_fingerprint` tells an identical retry from a different assembly;
+//! * **leg 4** — `MultipartEtag::parse` validates its grammar, not just its shape;
+//! * **leg 5** — every public outcome enum is matched without a wildcard arm, so a
+//!   `#[non_exhaustive]` marker (or one added later) would fail this file to compile.
+//!
+//! No `#![cfg(...)]` here — this file always compiles and always runs.
+
+#![forbid(unsafe_code)]
+
+use sha2::{Digest as _, Sha256};
+use wyrd_core::multipart::{
+    abort_answer, answer, complete_answer, complete_fingerprint, list_parts_answer,
+    list_uploads_answer, multipart_etag, upload_part_answer, AbortAnswer, AbortOutcome, Answer,
+    Backpressure, CompleteAnswer, CompleteOutcome, Completion, CreateOutcome, Digest, InvalidPart,
+    ListPartsAnswer, ListUploadsAnswer, MultipartEtag, PartNumber, Publication, PublishTarget,
+    RecordError, Refusal, ReserveOutcome, SessionState, UploadPartAnswer, UploadPartOutcome, Verb,
+};
+
+// ===========================================================================
+// Shared fixtures
+// ===========================================================================
+
+fn part(n: u32) -> PartNumber {
+    PartNumber::new(n).expect("test part number in range")
+}
+
+/// A digest derived from a label, so every fixture below is visibly distinct (never the
+/// all-zero digest a copy-paste mistake could produce unnoticed).
+fn digest(label: &str) -> Digest {
+    let padded = format!("{:0<64}", hex(label.as_bytes()));
+    Digest::from_hex(&padded).expect("test label is short enough to pad to 64 hex chars")
+}
+
+/// Independent hex rendering — deliberately **not** `wyrd_core::multipart::hex_lower` — so
+/// leg 2's oracle shares no code with the production rendering path it is checking.
+fn hex(bytes: &[u8]) -> String {
+    bytes.iter().map(|b| format!("{b:02x}")).collect()
+}
+
+/// The five states decision 3's table answers against: the four live [`SessionState`]s plus
+/// "absent" (`None`). Fixed field values throughout — decision 3's table does not vary by
+/// them — except `complete_fingerprint`, which is the one field the conditional cell reads.
+fn open() -> SessionState {
+    SessionState::Open {}
+}
+
+fn completing() -> SessionState {
+    SessionState::Completing {
+        fenced_at_millis: 1,
+        segments_written: 0,
+        publish_target: PublishTarget {
+            parent: 7,
+            name: "object".to_string(),
+            epoch: 1,
+        },
+    }
+}
+
+fn aborting() -> SessionState {
+    SessionState::Aborting {}
+}
+
+fn completed(complete_fingerprint: Digest) -> SessionState {
+    SessionState::Completed {
+        completion: Completion {
+            inode: 9,
+            version: 3,
+            etag: digest("published-etag"),
+            completed_at_millis: 42,
+            complete_fingerprint,
+        },
+    }
+}
+
+/// The fingerprint [`completed`] below is stamped with — the "winning Complete's" identity.
+fn recorded_fingerprint() -> Digest {
+    complete_fingerprint(&[(part(1), digest("one")), (part(2), digest("two"))])
+        .expect("a two-part ascending list fingerprints")
+}
+
+// ===========================================================================
+// Leg 1 — every reachable decision-3 cell (0016:969-978)
+// ===========================================================================
+
+/// One cell's expected [`Answer`], keyed by verb and state — the oracle leg 1's helper
+/// checks every produced [`Answer`] against.
+fn expected(verb: Verb, state: Option<&SessionState>) -> Answer {
+    match (verb, state) {
+        (Verb::UploadPart, Some(SessionState::Open {})) => {
+            Answer::UploadPart(UploadPartAnswer::Accepted)
+        }
+        (Verb::UploadPart, _) => {
+            Answer::UploadPart(UploadPartAnswer::Refused(Refusal::NoSuchUpload))
+        }
+        (Verb::CompleteMultipartUpload, Some(SessionState::Open {})) => {
+            Answer::Complete(CompleteAnswer::Fences)
+        }
+        (Verb::CompleteMultipartUpload, Some(SessionState::Completing { .. })) => {
+            Answer::Complete(CompleteAnswer::Refused(Refusal::OperationAborted))
+        }
+        (Verb::CompleteMultipartUpload, Some(SessionState::Aborting {})) => {
+            Answer::Complete(CompleteAnswer::Refused(Refusal::NoSuchUpload))
+        }
+        (Verb::CompleteMultipartUpload, Some(SessionState::Completed { .. })) => {
+            // The conditional cell: `answer()` is called with the RECORDED fingerprint
+            // below, so this is the match branch. The mismatch branch is its own
+            // assertion, `complete_tombstone_mismatch_is_refused`.
+            Answer::Complete(CompleteAnswer::AlreadyCompleted(Box::new(Publication {
+                inode: 9,
+                version: 3,
+                etag: digest("published-etag"),
+                completed_at_millis: 42,
+            })))
+        }
+        (Verb::CompleteMultipartUpload, None) => {
+            Answer::Complete(CompleteAnswer::Refused(Refusal::NoSuchUpload))
+        }
+        (Verb::AbortMultipartUpload, Some(SessionState::Open {})) => {
+            Answer::Abort(AbortAnswer::Fences)
+        }
+        (Verb::AbortMultipartUpload, Some(SessionState::Completing { .. })) => {
+            Answer::Abort(AbortAnswer::Refused(Refusal::OperationAborted))
+        }
+        (Verb::AbortMultipartUpload, Some(SessionState::Aborting {})) => {
+            Answer::Abort(AbortAnswer::AlreadyAborting)
+        }
+        (Verb::AbortMultipartUpload, _) => {
+            Answer::Abort(AbortAnswer::Refused(Refusal::NoSuchUpload))
+        }
+        (Verb::ListParts, Some(SessionState::Open {})) => {
+            Answer::ListParts(ListPartsAnswer::OpenSet)
+        }
+        (Verb::ListParts, Some(SessionState::Completing { .. })) => {
+            Answer::ListParts(ListPartsAnswer::FrozenSet)
+        }
+        (Verb::ListParts, _) => Answer::ListParts(ListPartsAnswer::Refused(Refusal::NoSuchUpload)),
+        (
+            Verb::ListMultipartUploads,
+            Some(SessionState::Open {} | SessionState::Completing { .. }),
+        ) => Answer::ListUploads(ListUploadsAnswer::Listed),
+        (Verb::ListMultipartUploads, _) => Answer::ListUploads(ListUploadsAnswer::NotListed),
+    }
+}
+
+/// Leg 1's helper: enumerates the full `Verb::ALL` x 5-state product, calls [`answer`] on
+/// every cell, and asserts it against [`expected`] — 25 cells, none skipped. A verb or state
+/// added later without a matching arm above fails to *compile* ([`answer`]'s own exhaustive
+/// match), and a mismatch here fails the assertion, so neither can slip in silently.
+#[test]
+fn every_decision_3_cell_is_answered() {
+    let fingerprint = recorded_fingerprint();
+    let live_states = [open(), completing(), aborting(), completed(fingerprint)];
+    let mut cells = 0usize;
+    for verb in Verb::ALL {
+        // The absent cell.
+        cells += 1;
+        assert_eq!(
+            answer(verb, None, None),
+            expected(verb, None),
+            "{verb:?} x absent"
+        );
+
+        for state in &live_states {
+            cells += 1;
+            let request_fingerprint =
+                matches!(state, SessionState::Completed { .. }).then_some(&fingerprint);
+            assert_eq!(
+                answer(verb, Some(state), request_fingerprint),
+                expected(verb, Some(state)),
+                "{verb:?} x {state:?}"
+            );
+        }
+    }
+    assert_eq!(cells, 25, "the product must be exactly 5 verbs x 5 states");
+}
+
+/// The conditional cell's **other** branch: a `Completed` tombstone answers a request whose
+/// fingerprint does **not** match the recorded one with `NoSuchUpload`, never the recorded
+/// publication (`0016:898-908`).
+#[test]
+fn complete_tombstone_mismatch_is_refused() {
+    let recorded = recorded_fingerprint();
+    let different = complete_fingerprint(&[(part(1), digest("one"))]).unwrap();
+    assert_ne!(recorded, different);
+
+    let state = completed(recorded);
+    assert_eq!(
+        complete_answer(Some(&state), Some(&different)),
+        CompleteAnswer::Refused(Refusal::NoSuchUpload)
+    );
+    assert_eq!(
+        answer(
+            Verb::CompleteMultipartUpload,
+            Some(&state),
+            Some(&different)
+        ),
+        Answer::Complete(CompleteAnswer::Refused(Refusal::NoSuchUpload))
+    );
+}
+
+/// [`answer`]'s per-verb helpers agree with the dispatcher — each is independently callable
+/// (the shape #508/#656-#659 need), not merely reachable through [`answer`].
+#[test]
+fn per_verb_helpers_agree_with_the_dispatcher() {
+    let state = open();
+    assert_eq!(
+        Answer::UploadPart(upload_part_answer(Some(&state))),
+        answer(Verb::UploadPart, Some(&state), None)
+    );
+    assert_eq!(
+        Answer::Abort(abort_answer(Some(&state))),
+        answer(Verb::AbortMultipartUpload, Some(&state), None)
+    );
+    assert_eq!(
+        Answer::ListParts(list_parts_answer(Some(&state))),
+        answer(Verb::ListParts, Some(&state), None)
+    );
+    assert_eq!(
+        Answer::ListUploads(list_uploads_answer(Some(&state))),
+        answer(Verb::ListMultipartUploads, Some(&state), None)
+    );
+}
+
+// ===========================================================================
+// Leg 2 — `multipart_etag` against an independent oracle
+// ===========================================================================
+
+/// The oracle: concatenates the **raw** digest bytes in the order given (the caller sorts,
+/// this helper does not) and hashes with `sha2` directly — no call into
+/// `canonical_named_parts` or `Digest::of`, so this is genuinely a second implementation of
+/// the composition, not a restatement of the first.
+fn oracle_etag(ordered_raw: &[[u8; 32]]) -> String {
+    let mut hasher = Sha256::new();
+    for bytes in ordered_raw {
+        hasher.update(bytes);
+    }
+    format!("{}-{}", hex(&hasher.finalize()), ordered_raw.len())
+}
+
+#[test]
+fn multipart_etag_matches_the_oracle_for_one_part() {
+    let d1 = digest("solo");
+    let etag = multipart_etag(&[(part(1), d1)]).unwrap();
+    assert_eq!(etag.to_string(), oracle_etag(&[*d1.as_bytes()]));
+    assert_eq!(etag.parts(), 1);
+}
+
+#[test]
+fn multipart_etag_strict_subset_differs_from_full_set() {
+    let d1 = digest("one");
+    let d2 = digest("two");
+    let full = multipart_etag(&[(part(1), d1), (part(2), d2)]).unwrap();
+    let subset = multipart_etag(&[(part(1), d1)]).unwrap();
+    assert_ne!(full, subset);
+    assert_eq!(full.parts(), 2);
+    assert_eq!(subset.parts(), 1);
+}
+
+#[test]
+fn multipart_etag_is_over_raw_bytes_not_hex_text() {
+    let d1 = digest("one");
+    let d2 = digest("two");
+    let etag = multipart_etag(&[(part(1), d1), (part(2), d2)]).unwrap();
+
+    // The wrong composition: hash the ordered digests' HEX TEXT instead of their raw bytes.
+    let mut hasher = Sha256::new();
+    hasher.update(d1.to_hex().as_bytes());
+    hasher.update(d2.to_hex().as_bytes());
+    let hex_text_etag = format!("{}-{}", hex(&hasher.finalize()), 2);
+
+    assert_ne!(etag.to_string(), hex_text_etag);
+    assert_eq!(
+        etag.to_string(),
+        oracle_etag(&[*d1.as_bytes(), *d2.as_bytes()])
+    );
+}
+
+#[test]
+fn multipart_etag_suffix_is_the_named_count() {
+    let named: Vec<(PartNumber, Digest)> =
+        (1..=5).map(|n| (part(n), digest(&n.to_string()))).collect();
+    let etag = multipart_etag(&named).unwrap();
+    assert_eq!(etag.parts(), 5);
+    assert!(etag.to_string().ends_with("-5"));
+}
+
+#[test]
+fn multipart_etag_refuses_a_duplicate_part_number() {
+    let d1 = digest("one");
+    let d2 = digest("two");
+    let err = multipart_etag(&[(part(1), d1), (part(1), d2)]).unwrap_err();
+    assert_eq!(err, RecordError::DuplicatePart { part_number: 1 });
+}
+
+#[test]
+fn multipart_etag_refuses_a_non_ascending_list_rather_than_sorting_it() {
+    let d1 = digest("one");
+    let d2 = digest("two");
+    let d3 = digest("three");
+
+    // Deliberately out of order: 3, 1, 2.
+    let out_of_order = [(part(3), d3), (part(1), d1), (part(2), d2)];
+    let err = multipart_etag(&out_of_order).unwrap_err();
+    assert_eq!(
+        err,
+        RecordError::PartsOutOfOrder {
+            part_number: 1,
+            previous: 3
+        }
+    );
+
+    // Never silently sorted: the ascending list with the SAME parts is a completely
+    // different value from a hypothetical "sort the input" composition, so the mere
+    // presence of an ascending oracle equal to the sorted-order etag would not, by
+    // itself, prove refusal — the assertion above (`unwrap_err`) is what proves it. This
+    // second check pins that the ascending composition remains reachable through its own
+    // (already-ascending) call, not through the refused one.
+    let ascending = multipart_etag(&[(part(1), d1), (part(2), d2), (part(3), d3)]).unwrap();
+    assert_eq!(
+        ascending.to_string(),
+        oracle_etag(&[*d1.as_bytes(), *d2.as_bytes(), *d3.as_bytes()])
+    );
+}
+
+// ===========================================================================
+// Leg 3 — `complete_fingerprint` tells an identical retry from a different assembly
+// ===========================================================================
+
+#[test]
+fn complete_fingerprint_agrees_on_an_identical_ascending_retry() {
+    let named = [(part(1), digest("one")), (part(2), digest("two"))];
+    let first = complete_fingerprint(&named).unwrap();
+    let retry = complete_fingerprint(&named).unwrap();
+    assert_eq!(first, retry);
+}
+
+#[test]
+fn complete_fingerprint_disagrees_on_one_changed_digest() {
+    let original =
+        complete_fingerprint(&[(part(1), digest("one")), (part(2), digest("two"))]).unwrap();
+    let changed =
+        complete_fingerprint(&[(part(1), digest("one")), (part(2), digest("TWO-DIFFERENT"))])
+            .unwrap();
+    assert_ne!(original, changed);
+}
+
+/// Same digests, in the same relative order, named under **different literal part
+/// numbers** (`2` vs `5` for the second part) — deliberately a case where sorting by
+/// ascending part number leaves the digest *sequence* identical (`d1` then `d2` either
+/// way), so this can only disagree if the part numbers themselves are hashed in, not just
+/// used to order the digests. A composition that dropped the numbers from the hash (and
+/// used them only to sort) would wrongly agree here.
+#[test]
+fn complete_fingerprint_disagrees_on_the_same_digests_under_different_numbering() {
+    let d1 = digest("one");
+    let d2 = digest("two");
+    let original = complete_fingerprint(&[(part(1), d1), (part(2), d2)]).unwrap();
+    let renumbered = complete_fingerprint(&[(part(1), d1), (part(5), d2)]).unwrap();
+    assert_ne!(original, renumbered);
+}
+
+#[test]
+fn complete_fingerprint_disagrees_on_a_strict_subset() {
+    let full = complete_fingerprint(&[
+        (part(1), digest("one")),
+        (part(2), digest("two")),
+        (part(3), digest("three")),
+    ])
+    .unwrap();
+    let subset =
+        complete_fingerprint(&[(part(1), digest("one")), (part(2), digest("two"))]).unwrap();
+    assert_ne!(full, subset);
+}
+
+#[test]
+fn complete_fingerprint_refuses_the_same_malformed_lists_as_multipart_etag() {
+    let duplicate = [(part(1), digest("one")), (part(1), digest("two"))];
+    assert_eq!(
+        multipart_etag(&duplicate).unwrap_err(),
+        complete_fingerprint(&duplicate).unwrap_err()
+    );
+
+    let out_of_order = [(part(2), digest("two")), (part(1), digest("one"))];
+    assert_eq!(
+        multipart_etag(&out_of_order).unwrap_err(),
+        complete_fingerprint(&out_of_order).unwrap_err()
+    );
+}
+
+// ===========================================================================
+// Leg 4 — `MultipartEtag` decode is validating
+// ===========================================================================
+
+#[test]
+fn multipart_etag_parse_round_trips_a_composed_value() {
+    let etag = multipart_etag(&[(part(1), digest("one")), (part(2), digest("two"))]).unwrap();
+    let text = etag.to_string();
+    let parsed = MultipartEtag::parse(&text).unwrap();
+    assert_eq!(parsed, etag);
+    assert_eq!(parsed.composed(), etag.composed());
+    assert_eq!(parsed.parts(), 2);
+}
+
+#[test]
+fn multipart_etag_parse_rejects_a_zero_part_count() {
+    let hex64 = hex(digest("valid").as_bytes());
+    let err = MultipartEtag::parse(&format!("{hex64}-0")).unwrap_err();
+    assert_eq!(err, RecordError::NoPartsNamed);
+}
+
+#[test]
+fn multipart_etag_parse_rejects_a_count_past_the_keyspace() {
+    let hex64 = hex(digest("valid").as_bytes());
+    let err = MultipartEtag::parse(&format!("{hex64}-1000000")).unwrap_err();
+    assert_eq!(
+        err,
+        RecordError::EtagPartCountOutOfRange { parts: 1_000_000 }
+    );
+}
+
+#[test]
+fn multipart_etag_parse_rejects_malformed_hex() {
+    let hex64 = hex(digest("valid").as_bytes());
+    let uppercase = hex64.to_uppercase();
+    assert!(matches!(
+        MultipartEtag::parse(&format!("{uppercase}-1")),
+        Err(RecordError::DigestNotHex { .. })
+    ));
+
+    let short = &hex64[..63];
+    assert!(matches!(
+        MultipartEtag::parse(&format!("{short}-1")),
+        Err(RecordError::DigestNotHex { .. })
+    ));
+}
+
+#[test]
+fn multipart_etag_parse_rejects_a_malformed_suffix() {
+    let hex64 = hex(digest("valid").as_bytes());
+    for suffix in ["", "+1", "01", "1x", "-1"] {
+        let text = format!("{hex64}-{suffix}");
+        assert!(
+            MultipartEtag::parse(&text).is_err(),
+            "expected {text:?} to be refused"
+        );
+    }
+}
+
+#[test]
+fn multipart_etag_parse_rejects_a_missing_separator() {
+    let hex64 = hex(digest("valid").as_bytes());
+    assert!(matches!(
+        MultipartEtag::parse(&hex64),
+        Err(RecordError::MultipartEtagMalformed { .. })
+    ));
+}
