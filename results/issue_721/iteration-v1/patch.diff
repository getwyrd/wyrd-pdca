+    fn tile(id: ChunkId, len: u64, placement: Vec<DServerId>) -> ChunkRef {
+        ChunkRef {
+            id,
+            scheme: EcScheme::ReedSolomon { k: 1, m: 1 },
+            len,
+            placement,
+        }
+    }
+
+    fn segment(byte_offset: u64, byte_len: u64) -> SegmentRef {
