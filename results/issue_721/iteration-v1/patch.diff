+// ---------------------------------------------------------------------------
+// The placement move — the maintenance WRITE side of a resolved chunk map
+// (proposal 0016 decision 7(f), `0016:669`)
+// ---------------------------------------------------------------------------
+
+/// What preparing a placement move produced ([`repoint_chunk`]).
+///
+/// **No arm has written anything.** The move reads, weighs and builds; only the caller's own
+/// [`MetadataStore::commit`] of a [`Self::Prepared`] batch mutates the store, so a refusal and
+/// a conflict alike leave every record byte-identical.
+#[derive(Debug)]
+pub enum Repoint {
+    /// The move, as ONE compare-and-swap batch: the record that holds the chunk's
+    /// [`ChunkRef`] repointed, conditioned on the bytes the move weighed.
+    ///
+    /// Handed back rather than committed here so the caller can add **its own evidence for
+    /// the same move** — a repair obligation's delete, an orphan mark per displaced position —
+    /// and land all of it in ONE atomic mutation (`0005:277`, ADR-0015). A caller that
+    /// committed the placement and the evidence separately would leave a window in which a
+    /// fragment has moved and nothing records where it went.
+    Prepared(WriteBatch),
+    /// The record the move would leave behind crosses the byte ceiling its shape is written
+    /// under ([`flat_value_ceiling_crossed`] for a flat record,
+    /// [`segment_value_ceiling_crossed`] for a segment record): refused **before anything at
+    /// all was written**.
+    ///
+    /// Distinct from [`Self::Conflict`] precisely because that one is transient: this shape
+    /// fails again every pass until the record shrinks, so it is the object's own defect and
+    /// an operator signal rather than a retry.
+    Refused {
+        /// The re-encoded record's own length.
+        bytes: usize,
+        /// The ceiling it crossed.
+        ceiling: usize,
+    },
+    /// The bytes this move was planned from are not the bytes that hold the chunk now: the
+    /// generation was retired, or the chunk at that offset is no longer the reference the
+    /// caller planned from.
+    ///
+    /// Nothing is written and — the whole point — nothing is **overwritten**: a stale plan
+    /// never lands its placement over a newer one. The caller keeps its obligation and
+    /// re-plans next pass, exactly as it does for a lost CAS at commit time.
+    Conflict,
+}
+
+/// Move ONE chunk's fragment `placement` in the record that actually holds its [`ChunkRef`] —
+/// the flat inode record, or the one `seg:` record of a segmented map (`0016:669`) — and hand
+/// back the compare-and-swap batch that lands it.
+///
+/// This is the write counterpart of [`resolve_chunk_map`]: a maintenance pass resolves an
+/// object's chunks through the one shared resolver, and moves one of them back through this one
+/// primitive, whichever shape the object has. Without it a chunk that lives in a `seg:` record
+/// can be *read* by every consumer and *repaired* by none — its redundancy decays untended,
+/// with no actor that exits the state (`docs/principles.md` §5 C-1).
+///
+/// # Addressing: a byte offset plus the reference itself
+///
+/// `byte_offset` is the first byte of the object the chunk covers — its address in the map's
+/// own byte tiling — and `prior` is the reference the caller resolved and planned from. The
+/// chunk moved is the one that **begins at that offset and equals that reference**; anything
+/// else is a [`Repoint::Conflict`]. That rule is the same in both shapes (a resolved chunk list
+/// is a byte tiling either way), it is stable across a segment boundary the caller cannot see,
+/// and it is unambiguous when one object names the same [`ChunkId`] twice.
+///
+/// # What it pins — THREE things, and deliberately not the resolve's whole read
+///
+/// 1. **The root generation's bytes.** A supersede always flips the root first
+///    (`0016:2452-2462`), so a repoint racing one loses its CAS instead of repointing a
+///    generation nothing references any more.
+/// 2. **The segment record's own FRESHLY-READ bytes** — the ones this call `get`s and weighs,
+///    not the ones the resolve saw. [`ResolvedChunkMap`] carries only the root record plus the
+///    flattened chunk list (`:2294-2300`); it cannot hand back per-segment bytes, so "pin the
+///    exact bytes the resolve read" is not implementable for the segmented arm and is not
+///    claimed here.
+/// 3. **The [`ChunkRef`] itself** — see the addressing rule above.
+///
+/// The consequence is deliberate and is the point of (3): **a concurrent edit to a *sibling*
+/// chunk in the same segment record is MERGED**, because the move re-reads the record and
+/// rewrites only the one entry it planned — two repairs inside one multipart object must not
+/// serialise on the whole record — **while an edit to the planned chunk itself is a conflict**,
+/// because the reference no longer equals `prior`. Pinning the whole resolved record instead
+/// would turn the first case into a permanent stall on a busy object, and dropping (3) would
+/// silently revert the other writer's placement onto bytes this call had just re-read.
+///
+/// A segmented move **never rewrites the root**: the placement lives in the segment, so the
+/// root is a precondition and never a `put` — the root's own size (and its
+/// [`MAX_ROOT_VALUE_BYTES`] budget) is untouched by maintenance.
+///
+/// # Bounded
+///
+/// The segmented arm reads **one** segment record: the covering segment is found in the root's
+/// own table (the tiling is contiguous and checked at decode, [`SegmentedMap::new`]), so no
+/// `seg:` range is walked, no other segment is decoded, and nothing is retained beyond the one
+/// record whose bytes the move pins.
+pub async fn repoint_chunk(
+    store: &dyn MetadataStore,
+    inode: InodeId,
+    generation: &InodeRecord,
+    byte_offset: u64,
+    prior: &ChunkRef,
+    placement: Vec<DServerId>,
+) -> Result<Repoint> {
+    let root_key = inode_key(inode);
+    let root_bytes = encode(generation);
+    let map = match &generation.chunk_map {
+        // The flat arm is `commit_chunk_map`'s CAS idiom (`:1769-1797`): `version + 1` and
+        // `..generation.clone()`, so the ADR-0047 object metadata a placement move must never
+        // touch is preserved rather than re-stamped. Unlike that commit point this one does
+        // NOT set `state`: moving a fragment says nothing about an object's lifecycle, so a
+        // record arrives at the same state it left in and a repoint can never publish one.
+        ChunkMap::Flat(chunks) => {
+            let Some(at) = chunk_at(chunks, byte_offset, prior) else {
+                return Ok(Repoint::Conflict);
+            };
+            let mut next_chunks = chunks.clone();
+            next_chunks[at].placement = placement;
+            let next = InodeRecord {
+                chunk_map: ChunkMap::Flat(next_chunks),
+                version: generation.version + 1,
+                ..generation.clone()
+            };
+            let next_bytes = encode(&next);
+            if let Some(ceiling) = flat_value_ceiling_crossed(&next_bytes) {
+                return Ok(Repoint::Refused {
+                    bytes: next_bytes.len(),
+                    ceiling,
+                });
+            }
+            return Ok(Repoint::Prepared(
+                WriteBatch::new()
+                    .require(root_key.clone(), root_bytes)
+                    .put(root_key, next_bytes),
+            ));
+        }
+        ChunkMap::Segmented(map) => map,
+    };
+
+    // The segment covering this chunk, from the root's OWN table: the tiling is contiguous
+    // from 0 and checked at decode ([`SegmentedMap::new`]), so at most one segment covers an
+    // offset and finding it costs no read at all.
+    let Some(segment) = map
+        .segments()
+        .iter()
+        .find(|segment| covers(segment, byte_offset))
+    else {
+        return Ok(Repoint::Conflict);
+    };
+    // Fallible only for an index past the addressable key space, which this table's own decode
+    // already refused — so a root that reached a value has no index this can reject.
+    let key = seg_key(map.group(), segment.index)?;
+    // Every anomaly below is answered `Conflict`, never an error: a generation retired under a
+    // plan is the ordinary race (its records are deleted after the root moves,
+    // `0016:2452-2462`), and raising it would end the whole pass for one object — the fault
+    // containment `gc`, `restore`, `rebalance` and `reconstruction` all share. A store fault
+    // under the read still propagates: that is nobody's object.
+    let Some(bytes) = store.get(&key).await? else {
+        return Ok(Repoint::Conflict);
+    };
+    let Ok(record) = decode_segment_record(segment.index, &bytes) else {
+        return Ok(Repoint::Conflict);
+    };
+    let Some(within) = byte_offset.checked_sub(record.byte_offset()) else {
+        return Ok(Repoint::Conflict);
+    };
+    let Some(at) = chunk_at(record.chunks(), within, prior) else {
+        return Ok(Repoint::Conflict);
+    };
+    let mut chunks = record.chunks().to_vec();
+    chunks[at].placement = placement;
+    // Through the validating constructor: only a placement moved, so the span it re-derives is
+    // the one the root's table already agrees with, and a record that could not be built could
+    // not have decoded either.
+    let next = SegmentRecord::new(chunks, record.byte_offset())?;
+    let next_bytes = encode(&next);
+    if let Some(ceiling) = segment_value_ceiling_crossed(&next_bytes) {
+        return Ok(Repoint::Refused {
+            bytes: next_bytes.len(),
+            ceiling,
+        });
+    }
+    Ok(Repoint::Prepared(
+        WriteBatch::new()
+            .require(root_key, root_bytes)
+            .require(key.clone(), bytes)
+            .put(key, next_bytes),
+    ))
+}
+
+/// Whether `segment` covers the object byte at `byte_offset`. Total: the table's spans are
+/// checked at decode, so no arithmetic here can overflow a `u64`.
+fn covers(segment: &SegmentRef, byte_offset: u64) -> bool {
+    byte_offset >= segment.byte_offset && byte_offset - segment.byte_offset < segment.byte_len
+}
+
+/// The position in `chunks` of the chunk that **begins at `byte_offset`** and **is** `prior` —
+/// the whole addressing rule of a placement move, in one place so both shapes read it the same
+/// way.
+///
+/// Both halves are load-bearing. The offset is the address a caller can carry across a segment
+/// boundary it never saw; the equality is the pin that turns a record rewritten under the plan
+/// into a [`Repoint::Conflict`] instead of a silent overwrite of somebody else's newer
+/// placement — while leaving an edit to any OTHER chunk of the same record alone, which is what
+/// keeps two repairs inside one multipart object from serialising. The walk stops at the first
+/// chunk starting past the offset, so it is linear in the record it searches and never in the
+/// object.
+fn chunk_at(chunks: &[ChunkRef], byte_offset: u64, prior: &ChunkRef) -> Option<usize> {
+    let mut at = 0u64;
+    for (index, chunk) in chunks.iter().enumerate() {
+        if at > byte_offset {
+            break;
+        }
+        if at == byte_offset && chunk == prior {
+            return Some(index);
+        }
+        at = at.checked_add(chunk.len)?;
+    }
+    None
+}
