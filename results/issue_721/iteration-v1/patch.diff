+    #[test]
+    fn a_segment_covers_its_own_span_and_neither_neighbour() {
+        // Half-open, and the ends are what a placement move addresses a record by: covering
+        // one byte too many claims the next segment's first chunk (whose record this move
+        // would then never read), one too few refuses a repair for a chunk that exists.
+        let seg = segment(10, 5);
+        assert!(covers(&seg, 10), "its first byte");
+        assert!(covers(&seg, 14), "its last byte");
+        assert!(!covers(&seg, 15), "one past the end is the NEXT segment's");
+        assert!(
+            !covers(&seg, 9),
+            "one before the start is the previous one's"
+        );
+        // A segment starting at 0 must not answer for an offset it cannot hold.
+        assert!(covers(&segment(0, 1), 0));
+        assert!(!covers(&segment(0, 1), 1));
+    }
+
+    #[test]
+    fn a_chunk_is_addressed_by_its_offset_and_pinned_by_its_reference() {
+        let first = tile(0xA1, 8, vec![0, 1]);
+        let second = tile(0xA2, 8, vec![0, 3]);
+        let chunks = [first.clone(), second.clone()];
+
+        // The offset is the address: each chunk is found at the byte it BEGINS at, and the
+        // second one only through the first one's length (a position-indexed move would
+        // repoint a neighbour).
+        assert_eq!(chunk_at(&chunks, 0, &first), Some(0));
+        assert_eq!(chunk_at(&chunks, 8, &second), Some(1));
+
+        // The reference is the pin. A record rewritten under the plan — the SAME chunk at the
+        // SAME offset, moved by somebody else — is not a match, so the caller conflicts
+        // instead of reverting that writer's newer placement onto freshly-read bytes.
+        let moved = tile(0xA1, 8, vec![0, 9]);
+        assert_eq!(chunk_at(&chunks, 0, &moved), None);
+        // But a match is decided per CHUNK, not per record: the sibling's own edit leaves
+        // this one addressable, which is what keeps two repairs in one record from
+        // serialising.
+        let sibling_moved = [first.clone(), tile(0xA2, 8, vec![0, 9])];
+        assert_eq!(chunk_at(&sibling_moved, 0, &first), Some(0));
+
+        // An offset that is not a chunk BOUNDARY addresses nothing, and neither does one past
+        // the tiling — never the chunk that merely contains it.
+        assert_eq!(chunk_at(&chunks, 4, &first), None);
+        assert_eq!(chunk_at(&chunks, 16, &second), None);
+
+        // One object naming the same id twice is unambiguous: the offset tells them apart.
+        let twice = [first.clone(), first.clone()];
+        assert_eq!(chunk_at(&twice, 0, &first), Some(0));
+        assert_eq!(chunk_at(&twice, 8, &first), Some(1));
+
+        // A tiling whose lengths cannot be summed addresses nothing — CHECKED, so a stored
+        // record no publication could have written ends this search instead of aborting the
+        // maintenance pass on an arithmetic overflow.
+        let overflowing = [tile(0xB1, u64::MAX, vec![]), tile(0xB2, u64::MAX, vec![])];
+        assert_eq!(chunk_at(&overflowing, u64::MAX, &second), None);
+    }
