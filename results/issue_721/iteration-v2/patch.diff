+    fn pins(batch: &WriteBatch) -> Vec<(Vec<u8>, Option<Bytes>)> {
+        batch
+            .preconditions
+            .iter()
+            .map(|pre| (pre.key.clone(), pre.expected.clone()))
+            .collect()
+    }
