+// ---- the placement move: the maintenance WRITE side of a resolved chunk map (`0016:669`) ----
+
+/// What preparing a placement move produced ([`repoint_chunk`]). **No arm has written
+/// anything**: only the caller's own [`MetadataStore::commit`] of a [`Self::Prepared`] batch
+/// mutates the store, so a refusal and a conflict alike leave every record byte-identical.
+#[derive(Debug)]
+pub enum Repoint {
+    /// The move, as ONE compare-and-swap batch: the record that holds the chunk's [`ChunkRef`]
+    /// repointed, conditioned on the bytes the move weighed. Handed back rather than committed
+    /// here so the caller can add **its own evidence for the same move** — the obligation's
+    /// delete, an orphan mark per displaced position — and land all of it in ONE atomic mutation
+    /// (`0005:277`, ADR-0015); committed separately there is a window in which a fragment has
+    /// moved and nothing records where it went.
+    Prepared(WriteBatch),
+    /// The record the move would leave behind crosses the byte ceiling its shape is written
+    /// under ([`flat_value_ceiling_crossed`] for a flat record,
+    /// [`segment_value_ceiling_crossed`] for a segment record): refused **before anything at all
+    /// was written**. Not transient, unlike [`Self::Conflict`] — it fails again every pass until
+    /// the record shrinks, so it is an operator signal rather than a retry.
+    Refused {
+        /// The re-encoded record's own length.
+        bytes: usize,
+        /// The ceiling it crossed.
+        ceiling: usize,
+    },
+    /// The bytes this move was planned from are not the bytes that hold the chunk now: the
+    /// generation was retired, the record no longer covers the span its root's table gives it, or
+    /// the chunk at that offset is no longer the reference the caller planned from. Nothing is
+    /// **overwritten** — a stale plan never lands its placement over a newer one — so the caller
+    /// keeps its obligation and re-plans next pass.
+    Conflict,
+}
+
+/// Move ONE chunk's fragment `placement` in the record that actually holds its [`ChunkRef`] —
+/// the flat inode record, or the one `seg:` record of a segmented map (`0016:669`) — and hand
+/// back the compare-and-swap batch that lands it. The write counterpart of
+/// [`resolve_chunk_map`]: without it a chunk in a `seg:` record is *read* by every consumer and
+/// *repaired* by none, its redundancy decaying with no actor that exits the state
+/// (`docs/principles.md` §5).
+///
+/// **Addressed by a byte offset plus the reference itself:** the chunk moved is the one that
+/// **begins at `byte_offset`** — its address in the map's own byte tiling — **and equals
+/// `prior`**, the reference the caller planned from; anything else is a [`Repoint::Conflict`].
+/// Both shapes are byte tilings, so one rule addresses either, across a segment boundary the
+/// caller cannot see and when one object names the same [`ChunkId`] twice.
+///
+/// **It pins THREE things, and deliberately not the resolve's whole read:** the **root
+/// generation's bytes** (a supersede flips the root first, `0016:2452-2462`, so a repoint racing
+/// one loses its CAS); the segment record's own **freshly-read** bytes, not the resolve's
+/// ([`ResolvedChunkMap`] carries only the root plus the flattened chunk list, `:2294-2300`, so
+/// "the exact bytes the resolve read" is not available to pin and is not claimed); and the
+/// **[`ChunkRef`] itself**. That last one is why **a concurrent edit to a *sibling* chunk of the
+/// same segment record MERGES** — two repairs inside one multipart object must not serialise on
+/// the whole record — **while an edit to the planned chunk itself conflicts** instead of
+/// silently reverting that writer's placement onto bytes this call had just re-read.
+///
+/// A segmented move **never rewrites the root**: the placement lives in the segment, so the root
+/// is a precondition and never a `put`. And the record it re-reads must still be the one that
+/// root's table describes — `byte_offset` and `byte_len` against the selected [`SegmentRef`], the
+/// resolver's own check ([`read_segments`], `:2582-2589`) — or the move conflicts rather than
+/// rewrites. **Bounded:** the segmented arm reads **one** segment record, found in the root's own
+/// table, so no `seg:` range is walked and no other segment is decoded.
+///
+/// # Errors
+///
+/// A store fault under the read, and the two faults that are **this object's own**: a present
+/// `seg:` record that will not decode ([`ChunkMapError::SegmentRecordUndecodable`]) and a
+/// generation counter with no successor ([`ChunkMapError::VersionExhausted`]). Both are typed so
+/// a maintenance caller contains them to the object instead of ending its pass, and neither is a
+/// race — answering either as one would re-plan the same broken record every pass, forever.
+pub async fn repoint_chunk(
+    store: &dyn MetadataStore,
+    inode: InodeId,
+    generation: &InodeRecord,
+    byte_offset: u64,
+    prior: &ChunkRef,
+    placement: Vec<DServerId>,
+) -> Result<Repoint> {
+    let root_key = inode_key(inode);
+    let root_bytes = encode(generation);
+    let map = match &generation.chunk_map {
+        // The flat arm is `commit_chunk_map`'s CAS idiom (`:1769-1797`): a next version and
+        // `..generation.clone()`, so the ADR-0047 object metadata is preserved rather than
+        // re-stamped. Unlike that commit point it does NOT set `state`: moving a fragment says
+        // nothing about an object's lifecycle.
+        ChunkMap::Flat(chunks) => {
+            let Some(at) = chunk_at(chunks, byte_offset, prior) else {
+                return Ok(Repoint::Conflict);
+            };
+            // CHECKED: a plain `+ 1` panics in a debug build and wraps in a release one at
+            // `u64::MAX`, and the wrap is the worse half — it re-mints bytes an older writer
+            // may still hold as its CAS precondition.
+            let Some(version) = generation.version.checked_add(1) else {
+                return Err(ChunkMapError::VersionExhausted {
+                    version: generation.version,
+                }
+                .into());
+            };
+            let mut next_chunks = chunks.clone();
+            next_chunks[at].placement = placement;
+            let next = InodeRecord {
+                chunk_map: ChunkMap::Flat(next_chunks),
+                version,
+                ..generation.clone()
+            };
+            let next_bytes = encode(&next);
+            if let Some(ceiling) = flat_value_ceiling_crossed(&next_bytes) {
+                return Ok(Repoint::Refused {
+                    bytes: next_bytes.len(),
+                    ceiling,
+                });
+            }
+            return Ok(Repoint::Prepared(
+                WriteBatch::new()
+                    .require(root_key.clone(), root_bytes)
+                    .put(root_key, next_bytes),
+            ));
+        }
+        ChunkMap::Segmented(map) => map,
+    };
+
+    // The covering segment, from the root's OWN table: the tiling is contiguous and checked at
+    // decode, so at most one covers an offset and finding it costs no read.
+    let Some(segment) = map
+        .segments()
+        .iter()
+        .find(|segment| covers(segment, byte_offset))
+    else {
+        return Ok(Repoint::Conflict);
+    };
+    let key = seg_key(map.group(), segment.index)?;
+    // An ABSENT row is the ordinary race, answered `Conflict`: a generation retired under a plan
+    // has its records deleted (`0016:2452-2462`). A store fault under the read still propagates.
+    let Some(bytes) = store.get(&key).await? else {
+        return Ok(Repoint::Conflict);
+    };
+    // A row that is PRESENT and will not decode is not that race: a retirement deletes records,
+    // it never scribbles over them. So this is the object's own corruption and it surfaces as a
+    // typed ERROR, not a value (ADR-0045 decision 1) — collapsed into `Conflict` it would
+    // silently re-plan the same damaged record forever, where typed the caller contains it.
+    let record = decode_segment_record(segment.index, &bytes)?;
+    // The row must also still be the one the pinned root's table DESCRIBES. That is *contextual*
+    // (the record decodes; only its relation to this generation is wrong), so it sits at this
+    // boundary rather than at decode, and strict because maintenance never rewrites a record it
+    // cannot trust (ADR-0045 decisions 1 and 3): rewriting one would CAS a fresh generation of a
+    // row no consumer can resolve. The comparison is the resolver's own (`:2582-2589`).
+    if record.byte_offset() != segment.byte_offset || record.byte_len() != segment.byte_len {
+        return Ok(Repoint::Conflict);
+    }
+    // Total: `covers` put the offset inside the span and the record just agreed it owns it.
+    let within = byte_offset - segment.byte_offset;
+    let Some(at) = chunk_at(record.chunks(), within, prior) else {
+        return Ok(Repoint::Conflict);
+    };
+    let mut chunks = record.chunks().to_vec();
+    chunks[at].placement = placement;
+    // Through the validating constructor; only a placement moved, so the span it re-derives is
+    // the one the root's table agrees with.
+    let next = SegmentRecord::new(chunks, record.byte_offset())?;
+    let next_bytes = encode(&next);
+    if let Some(ceiling) = segment_value_ceiling_crossed(&next_bytes) {
+        return Ok(Repoint::Refused {
+            bytes: next_bytes.len(),
+            ceiling,
+        });
+    }
+    Ok(Repoint::Prepared(
+        WriteBatch::new()
+            .require(root_key, root_bytes)
+            .require(key.clone(), bytes)
+            .put(key, next_bytes),
+    ))
+}
+
+/// Whether `segment` covers the object byte at `byte_offset`. Total: spans are checked at
+/// decode, so no arithmetic here can overflow a `u64`.
+fn covers(segment: &SegmentRef, byte_offset: u64) -> bool {
+    byte_offset >= segment.byte_offset && byte_offset - segment.byte_offset < segment.byte_len
+}
+
+/// The position in `chunks` of the chunk that **begins at `byte_offset`** and **is** `prior` —
+/// a placement move's whole addressing rule, in one place so both shapes read it the same way.
+/// Both halves are load-bearing: the offset is an address a caller can carry across a segment
+/// boundary it never saw, and the equality turns a record rewritten under the plan into a
+/// [`Repoint::Conflict`] instead of a silent overwrite of a newer placement — while leaving an
+/// edit to any OTHER chunk alone.
+fn chunk_at(chunks: &[ChunkRef], byte_offset: u64, prior: &ChunkRef) -> Option<usize> {
+    let mut at = 0u64;
+    for (index, chunk) in chunks.iter().enumerate() {
+        if at > byte_offset {
+            break;
+        }
+        if at == byte_offset && chunk == prior {
+            return Some(index);
+        }
+        at = at.checked_add(chunk.len)?;
+    }
+    None
+}
