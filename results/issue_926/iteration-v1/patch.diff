+    session_key: Vec<u8>,
+    session: Bytes,
+    slot_key: Vec<u8>,
+    slot: Bytes,
+    record: SlotRecord,
+    owned: Vec<OwnedChunk>,
+}
+
+/// A staged part attempt, handed to the part commit: everything it builds its batch, or its
+/// compensation, from, without re-reading the body or re-deriving anything (`0016:660`, `:673`).
