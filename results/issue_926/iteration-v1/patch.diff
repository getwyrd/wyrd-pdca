+    upload_part_answer, AttemptId, Backpressure, Digest, DigestHasher, OwnedEntry, PartNumber,
+    RecordError, Refusal, ReserveOutcome, SlotIndex, SlotRecord, StagedPlacement, UploadId,
+    UploadPartAnswer,
