+pub struct StagedAttempt {
+    footprint: Footprint,
+    part_number: PartNumber,
+    attempt_id: AttemptId,
+    index: SlotIndex,
+    chunks: Vec<ChunkRef>,
+    len: u64,
+    digest: Digest,
+    chunk_bound_exceeded: bool,
+}
+
+impl StagedAttempt {
