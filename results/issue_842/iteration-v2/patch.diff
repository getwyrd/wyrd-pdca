+/// the records obligation would delete with nothing accounting for what it names.
+async fn check_attempt(
+    meta: &dyn MetadataStore,
+    session: &str,
+    upload: &UploadId,
+    group: &SegmentGroup,
+    report: &mut RestoreReport,
+) -> Result<()> {
+    let range = seg_range_prefix(group);
