+/// What is wrong with one record under the attempt's range, if anything.
+fn segment_fault(
+    key: &[u8],
+    value: &[u8],
+    group: &SegmentGroup,
+    held: &HashSet<ChunkId>,
+) -> Option<SegmentFault> {
+    match parse_seg_key(key) {
