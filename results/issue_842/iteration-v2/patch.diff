+async fn part_chunks(meta: &dyn MetadataStore, upload: &UploadId) -> Result<HashSet<ChunkId>> {
+    let (range, mut held) = (part_range(upload), HashSet::new());
+    let mut after: Option<Vec<u8>> = None;
